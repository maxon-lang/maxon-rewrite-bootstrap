		return true
	end 'childExited'

	// abandonChild ends a child that is created and not yet running and undoes its run: it closes the child's handles and the
	// ends of the pipes that the run uses, and frees the frame.
	function abandonChild(child Count, thread Count, wait Count, frame Count)
		killChild(child)
		closeHandle(thread)
		closeHandle(child)
		closeOurEnds(wait)
		free(frame)
	end 'abandonChild'

	// runChild runs the child of osRun and osRunIn, in directory unless it is empty, and of osRunInput when hasInput is set.
	function runChild(executable String, arguments Count, directory String, hasInput bool, input String, deadlineMs Count, stdout Count, stderr Count, errorAddress Count) returns Count
		if holdsNul(executable, arguments: arguments, directory: directory) 'nul'
			failWith(errorAddress, errorCase: spawnFailed)
			return 0
		end 'nul'
		let frame = alloc(frameBytes)
		let wait = fieldAt(frame, offset: frameWaitOffset)
		waitNew(wait)
		let output = fieldAt(frame, offset: frameOutputEndsOffset)
		let errors = fieldAt(frame, offset: frameErrorEndsOffset)
		let inputEnds = fieldAt(frame, offset: frameInputEndsOffset)
		let command = commandLineOf(executable, arguments: arguments)
		if not openRunPipes(wait, output: output, errors: errors, input: inputEnds, hasInput: hasInput) 'pipes'
			free(command)
			free(frame)
			failWith(errorAddress, errorCase: ioFailed)
			return 0
		end 'pipes'
		var childInput = __Raw.callImport1("GetStdHandle", arg1: stdInputHandle)
		if hasInput 'input'
			childInput = endOf(inputEnds, writeEnd: false)
		end 'input'
		let startup = fieldAt(frame, offset: frameStartupOffset)
		__Raw.storeWord32(startup, offset: startupSizeOffset, value: startupBytes)
		__Raw.storeWord32(startup, offset: startupFlagsOffset, value: startfUseStdHandles)
		__Raw.storeWord(startup, offset: startupInputOffset, value: childInput)
		__Raw.storeWord(startup, offset: startupOutputOffset, value: endOf(output, writeEnd: true))
		__Raw.storeWord(startup, offset: startupErrorOffset, value: endOf(errors, writeEnd: true))
		let inherited = fieldAt(frame, offset: frameInheritedOffset)
		var inheritedCount = listInherited(inherited, count: 0, handle: wordAt(startup, offset: startupInputOffset))
		inheritedCount = listInherited(inherited, count: inheritedCount, handle: wordAt(startup, offset: startupOutputOffset))
		inheritedCount = listInherited(inherited, count: inheritedCount, handle: wordAt(startup, offset: startupErrorOffset))
		let process = fieldAt(frame, offset: frameProcessOffset)
		var wideDirectory = noCurrentDirectory as Count
		if __Raw.stringLength(directory) != 0 'directory'
			wideDirectory = wideOf(directory)
		end 'directory'
		let win32 = createChild(command, startup: startup, inherited: inherited, inheritedCount: inheritedCount, process: process, flags: extendedStartupInfoPresent or createSuspended, directory: wideDirectory)
		if wideDirectory != noCurrentDirectory 'wide'
			free(wideDirectory)
		end 'wide'
		closeChildEnds(output, errors: errors, input: inputEnds, hasInput: hasInput)
		free(command)
		if win32 != 0 'spawn'
			closeOurEnds(wait)
			free(frame)
			endWithError(errorAddress, osError: win32, table: spawnFailures())
			return 0
		end 'spawn'
		let child = wordAt(process, offset: processHandleOffset)
		let thread = wordAt(process, offset: processThreadOffset)
		let watch = eventProcessNew(child)
		if watch == noEntry 'unwatched'
			abandonChild(child, thread: thread, wait: wait, frame: frame)
			failWith(errorAddress, errorCase: ioFailed)
			return 0
		end 'unwatched'
		if dword(__Raw.callImport1("ResumeThread", arg1: thread)) == resumeFailed 'unresumed'
			eventProcessFree(watch)
			abandonChild(child, thread: thread, wait: wait, frame: frame)
			failWith(errorAddress, errorCase: ioFailed)
			return 0
		end 'unresumed'
		closeHandle(thread)
		__Raw.storeWord(wait, offset: waitChildOffset, value: child)
		__Raw.storeWord(wait, offset: waitProcessOffset, value: watch)
		let expired = awaitChild(wait, input: input, deadlineMs: deadlineMs)
		closeHandle(child)
		if expired 'late'
			freeStream(fieldAt(wait, offset: waitOutputOffset))
			freeStream(fieldAt(wait, offset: waitErrorOffset))
			free(frame)
			failWith(errorAddress, errorCase: timedOut)
			return 0
		end 'late'
		storeStream(stdout, stream: fieldAt(wait, offset: waitOutputOffset))
		storeStream(stderr, stream: fieldAt(wait, offset: waitErrorOffset))
		free(frame)
		succeed(errorAddress)
		return wordAt(wait, offset: waitStatusOffset)
	end 'runChild'
#endif
