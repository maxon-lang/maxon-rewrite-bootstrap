	function endTree(wait Count) returns Count
		let pid = wordAt(wait, offset: waitPidOffset)
		let bound = __Raw.wrappingAdd(osClockMillis(), right: treeEndBoundMs)
		var leaderEnded = false
		while true 'ending'
			let refused = killChild(pid)
			if leaderEnded and refused == 0 'ended'
				return 0
			end 'ended'
			if not leaderEnded and (isReaped(wait) or childWaited(wait, child: pid, options: waitNoHang)) 'leader'
				// The kill after the leader's end reaches everything it was starting as the earlier ones went out.
				leaderEnded = true
				continue 'ending'
			end 'leader'
			if osClockMillis() >= bound 'late'
				return refused
			end 'late'
			sleepMs(treePollMs)
		end 'ending'
		return 0
	end 'endTree'

	// endAndReap ends a child that no wait has taken where the caller may block, and waits for it: the kill, the wait for the leader,
	// which the kill ends, and the kill again, for what the leader was starting as the first went out (endTree).
	function endAndReap(run Count, pid Count)
		_ = killChild(pid)
		if not isReaped(waitOf(run)) 'unreaped'
			_ = reapChild(run, pid: pid)
			_ = killChild(pid)
		end 'unreaped'
	end 'endAndReap'

	// treeEnded waits, as long as treeEndBoundMs, until the child has been waited for and its group has no member, and says whether it
	// came to: a group outlives its leader, and a member that has ended stays in it until its parent has waited for it.
	function treeEnded(wait Count) returns bool
		let pid = wordAt(wait, offset: waitPidOffset)
		let bound = __Raw.wrappingAdd(osClockMillis(), right: treeEndBoundMs)
		while true 'poll'
			if (isReaped(wait) or childWaited(wait, child: pid, options: waitNoHang)) and noSuchGroup(signalGroup(pid, signal: noSignal)) 'gone'
				return true
			end 'gone'
			if osClockMillis() >= bound 'late'
				return false
			end 'late'
			sleepMs(treePollMs)
		end 'poll'
		return false
	end 'treeEnded'
#endif
