// Running a program over pipes for the child's standard output and error, read by the run while the child goes on, so
// that a child that fills one pipe cannot block waiting for the run to read the other: CreateProcessW on Windows, and on
// Linux a clone and an execve (linux_subprocess.maxon) and on macOS posix_spawn (macos_subprocess.maxon). The child's standard
// input is the run's own, or in a run with input a pipe that holds the input and then ends.
//
// Nothing in a run waits in the system or polls. Each pipe's end that the run uses is registered with the event queue, and the
// child's exit is an event entry of its own (eventProcessNew), so a run is a few green threads each parked on one entry: one
// reads each of the two output pipes to its end, one writes the input, and one waits for the child's exit, all until the run's
// deadline, which ends the child at the exit's wait and ends the others where they wait. The run's own green thread parks until
// those have finished, and a child that has exited is waited for (reaped) once.

#if os(Windows)
	// The Win32 values the run uses.
	let infinite = 0xFFFFFFFF

	let stdInputHandle = 0xFFFFFFF6

	let startfUseStdHandles = 0x100

	let noApplication = 0

	let noThreadSecurity = 0

	let inheritHandles = 1

	let noEnvironment = 0

	let noCurrentDirectory = 0

	let noName = 0

	// SECURITY_ATTRIBUTES: the child's end of a pipe is made with it so that the child can inherit it.
	let securityBytes = 24

	let securityLengthOffset = 0

	let securityInheritOffset = 16

	// STARTUPINFOEXW: STARTUPINFOW, of which the run sets the size, the flag that says the standard handles are given and the three
	// handles, and then the list of attributes the child is created with.
	let startupBytes = 112

	let startupSizeOffset = 0

	let startupFlagsOffset = 60

	let startupInputOffset = 80

	let startupOutputOffset = 88

	let startupErrorOffset = 96

	let startupAttributeListOffset = 104

	// The child inherits only the handles that PROC_THREAD_ATTRIBUTE_HANDLE_LIST names: bInheritHandles alone hands it every
	// inheritable handle of the process, the pipe ends of a run that is going on at the same time among them, and a reader
	// then waits for that other child's end of the pipe as well.
	let extendedStartupInfoPresent = 0x80000

	let attributeHandleList = 0x20002

	let attributeCount = 1

	let noAttributeFlags = 0

	let noAttributeList = 0

	let noPreviousValue = 0

	let noReturnSize = 0

	// The array of the handles the child inherits has room for a word each of its standard input, output and error.
	let inheritedHandlesBytes = 24

	// PROCESS_INFORMATION: the handles of the child and of its first thread.
	let processBytes = 24

	let processHandleOffset = 0

	let processThreadOffset = 8

	// The child is created suspended, to be watched before it runs, and resumed.
	let createSuspended = 4

	let resumeFailed = 0xFFFFFFFF

	// The run's frame, one allocation: the startup record, the array of the handles the child inherits (which the attribute
	// list points into until the child is created), the process record, the ends of the three pipes (a word for each of
	// the read end and the write end), the handles opened for the streams that are not pipes, and the run's wait.
	let frameStartupOffset = 0

	let frameInheritedOffset = frameStartupOffset + startupBytes

	let frameProcessOffset = frameInheritedOffset + inheritedHandlesBytes

	let frameOutputEndsOffset = frameProcessOffset + processBytes

	let frameErrorEndsOffset = (frameOutputEndsOffset + pipeEndBytes) as Count

	let frameInputEndsOffset = (frameErrorEndsOffset + pipeEndBytes) as Count

	let frameStreamHandlesOffset = (frameInputEndsOffset + pipeEndBytes) as Count

	let frameWaitOffset = (frameStreamHandlesOffset + streamHandlesBytes) as Count

	let frameBytes = (frameWaitOffset + waitBytes) as Count
#endif

// The cases of SubprocessError that the run fails with besides the ones the system's error gives.
let executableNotFound = 0

let spawnFailed = 1

let spawnBusy = 2

let ioFailed = 3

let timedOut = 4

let treeNotEnded = 5

// inputChunkBytes is the most of a run's input that one write offers the pipe of the child's standard input.
let inputChunkBytes = 65536

// noDeadline is the deadline of a run that is never ended for taking long.
let noDeadline = 0

// killedExitCode is the exit code of a child that a run ended at its deadline.
let killedExitCode = 1

// treeEndBoundMs is how long the end of a child's tree is given to leave no process of it running, and treePollMs how often it
// is looked at meanwhile: a green sleep, so that the scheduler runs on.
let treeEndBoundMs = 5000

let treePollMs = 1

function spawnFailures() returns Count
	return failureCases(executableNotFound, accessDenied: spawnFailed, busy: spawnBusy, alreadyExists: spawnFailed, other: spawnFailed)
end 'spawnFailures'

function fieldAt(base Count, offset Count) returns Count
	return __Raw.wrappingAdd(base, right: offset)
end 'fieldAt'

function wordAt(base Count, offset Count) returns Count
	return __Raw.loadWord(base, offset: offset)
end 'wordAt'

// A run's wait is a record of words that the green threads serving the run share: the event entry of the child's exit, the
// child (its pid, or its process handle on Windows) for killChild, the run's deadline (eventNoDeadline for none) as the event
// queue's clock reads it, whether the deadline ended a wait, what the child ended with (its wait status, or on Windows its
// exit code), the child's process id and when it started (the event queue's clock, in nanoseconds), whether the tree of the child
// was ended, whether part of it was still running after that, whether a POSIX child has been waited for (its status kept), and a
// record for each of the two output streams and for the input.
let waitProcessOffset = 0

let waitChildOffset = 8

let waitDeadlineOffset = 16

let waitExpiredOffset = 24

let waitStatusOffset = 32

let waitPidOffset = 40

let waitStartedOffset = 48

let waitKilledOffset = 56

let waitSurvivedOffset = 64

let waitReapedOffset = 72

let waitOutputOffset = 80

let waitErrorOffset = waitOutputOffset + streamBytes

let waitInputOffset = waitErrorOffset + streamBytes

let waitBytes = waitInputOffset + inputRecordBytes

// A stream and the input each hold, first, the event entry of the end of its pipe that the run uses, noEntry for a stream that is
// not collected, for the input of a run without and once the end is closed. A stream then holds the room of the string read so
// far (__Raw.stringRoom) with its length and its capacity, the run's wait and the most it keeps (0 for no cap), and the input the
// bytes and the length of the text it writes, and whether it is held open and not written. Both hold the run's wait.
let endEntryOffset = 0

let streamTextOffset = 8

let streamLengthOffset = 16

let streamCapacityOffset = 24

let streamWaitOffset = 32

let streamLimitOffset = 40

// A stream that is read on demand (a streaming child's) holds the bytes of its text that were given already (its read position), what
// a read of it found (streamOpen, streamAtEof or streamReadFailed) and whether a read is in progress.
let streamReadOffset = 48

let streamStateOffset = 56

let streamBusyOffset = 64

let streamBytes = 72

let streamOpen = 0 as Count

let streamAtEof = 1 as Count

let streamReadFailed = 2 as Count

let streamNoSuchChild = 3 as Count

// noLimit is the limit of a stream that keeps all it reads.
let noLimit = 0

let inputTextOffset = 8

let inputLengthOffset = 16

let inputWaitOffset = 24

// inputHoldOffset says whether the input is held open and never written (InputSource.hold).
let inputHoldOffset = 32

// The input of a streaming child holds also how many of the bytes of the payload queued for it are written, whether a payload is
// queued and not written out, how many bytes of a write that is in flight on Windows are not counted yet, and whether the last turn
// of the payload met a pipe that takes no more, which a wait for the input waits to change.
let inputDoneOffset = 40

let inputQueuedOffset = 48

let inputInflightOffset = 56

let inputBlockedOffset = 64

let inputRecordBytes = 72

// readChunkBytes is the least room a stream's text has past its length before a read, and readMostBytes the most one read asks
// for, which the system's counts of 32 bits hold.
let readChunkBytes = 4096

let readMostBytes = 0x100000

// waitNew makes a run's wait with no entries, so that a run whose pipes are not all made holds only what it has.
function waitNew(wait Count)
	zeroRange(wait, from: 0, to: waitBytes)
end 'waitNew'

// endOf is the handle of the read end or the write end of the pipe that eventChildPipe made into ends.
function endOf(ends Count, writeEnd bool) returns Count
	return wordAt(ends, offset: wordBytes if writeEnd else 0)
end 'endOf'

// openRunPipe makes the pipe of a stream or of the input into ends, registers the end that this process uses with the event
// queue, keeps its entry in the record, and says whether it did; the child writes the pipe where childWrites is set.
function openRunPipe(ends Count, childWrites bool, record Count) returns bool
	if not eventChildPipe(ends, childWrites: childWrites) 'refused'
		return false
	end 'refused'
	let entry = eventRegister(endOf(ends, writeEnd: not childWrites))
	if entry == noEntry 'unregistered'
		eventPipeClose(endOf(ends, writeEnd: false))
		eventPipeClose(endOf(ends, writeEnd: true))
		return false
	end 'unregistered'
	__Raw.storeWord(record, offset: endEntryOffset, value: entry)
	return true
end 'openRunPipe'

// A run's pipes: which of the child's output, error and input are pipes of the run's, each one the child writes, or reads in a run
// with input. A stream that is not collected, and an input that is not written, has none.
let pipeOutput = 1

let pipeErrors = 2

let pipeInput = 4

// pipesOf are the pipes that a request makes: the two streams that are collected, and the input that is written, which a
// child with none and one that is given bytes have.
function pipesOf(request Count) returns Count
	var pipes = 0 as Count
	if wordAt(request, offset: requestOutputKindOffset) == spawnOutputCollect 'output'
		pipes = pipes or pipeOutput
	end 'output'
	if wordAt(request, offset: requestErrorKindOffset) == spawnOutputCollect 'errors'
		pipes = pipes or pipeErrors
	end 'errors'
	if wordAt(request, offset: requestInputKindOffset) == spawnStdinBytes 'input'
		pipes = pipes or pipeInput
	end 'input'
	return pipes
end 'pipesOf'

// openRunPipes makes the pipes of a run that the set of pipes names. A pipe that cannot be made leaves the ones before it closed.
function openRunPipes(wait Count, output Count, errors Count, input Count, pipes Count) returns bool
	let outputRecord = fieldAt(wait, offset: waitOutputOffset)
	let errorRecord = fieldAt(wait, offset: waitErrorOffset)
	let inputRecord = fieldAt(wait, offset: waitInputOffset)
	if (pipes and pipeOutput) != 0 and not openRunPipe(output, childWrites: true, record: outputRecord) 'output'
		return false
	end 'output'
	if (pipes and pipeErrors) != 0 and not openRunPipe(errors, childWrites: true, record: errorRecord) 'errors'
		if (pipes and pipeOutput) != 0 'closeOutput'
			closeRunPipe(output, childWrites: true, record: outputRecord)
		end 'closeOutput'
		return false
	end 'errors'
	if (pipes and pipeInput) != 0 and not openRunPipe(input, childWrites: false, record: inputRecord) 'input'
		if (pipes and pipeOutput) != 0 'closeOutput'
			closeRunPipe(output, childWrites: true, record: outputRecord)
		end 'closeOutput'
		if (pipes and pipeErrors) != 0 'closeErrors'
			closeRunPipe(errors, childWrites: true, record: errorRecord)
		end 'closeErrors'
		return false
	end 'input'
	return true
end 'openRunPipes'

// closeRunPipe closes both ends of a pipe that openRunPipe made, which the child has not been given.
function closeRunPipe(ends Count, childWrites bool, record Count)
	eventPipeClose(endOf(ends, writeEnd: childWrites))
	releaseEnd(wordAt(record, offset: endEntryOffset))
	__Raw.storeWord(record, offset: endEntryOffset, value: noEntry)
end 'closeRunPipe'

// closeChildEnds closes the ends of a run's pipes that the child was to have, once it has them or will never have them.
function closeChildEnds(output Count, errors Count, input Count, pipes Count)
	if (pipes and pipeOutput) != 0 'output'
		eventPipeClose(endOf(output, writeEnd: true))
	end 'output'
	if (pipes and pipeErrors) != 0 'errors'
		eventPipeClose(endOf(errors, writeEnd: true))
	end 'errors'
	if (pipes and pipeInput) != 0 'input'
		eventPipeClose(endOf(input, writeEnd: false))
	end 'input'
end 'closeChildEnds'

// closeOurEnds closes the ends of a run's pipes that this process uses, for a run that ends before its wait.
function closeOurEnds(wait Count)
	releaseOurEnd(fieldAt(wait, offset: waitOutputOffset))
	releaseOurEnd(fieldAt(wait, offset: waitErrorOffset))
	releaseOurEnd(fieldAt(wait, offset: waitInputOffset))
end 'closeOurEnds'

// releaseOurEnd closes the end of a record's entry, unless it has none or it is closed, which one of the calls that race for it does.
function releaseOurEnd(record Count)
	let entry = __Raw.atomicExchange(record, offset: endEntryOffset, value: noEntry)
	if entry != noEntry 'open'
		releaseEnd(entry)
	end 'open'
end 'releaseOurEnd'

// releaseEnd takes an entry off the event queue and closes its handle, once no wait on it is in progress.
function releaseEnd(entry Count)
	let handle = wordAt(entry, offset: entryHandleOffset)
	eventForget(entry)
	eventPipeClose(handle)
end 'releaseEnd'

// runDeadline is the deadline of a run as the event queue's clock reads it, eventNoDeadline for a run that is never ended for
// taking long.
function runDeadline(deadlineMs Count) returns Count
	if deadlineMs == noDeadline 'none'
		return eventNoDeadline
	end 'none'
	let asked = try deadlineMs * nanosPerMilli otherwise longestSleepNanos
	return eventDeadline(asked if asked < longestSleepNanos else longestSleepNanos)
end 'runDeadline'

// startStream makes a stream of its record, with an empty text.
function startStream(stream Count, wait Count)
	__Raw.storeWord(stream, offset: streamTextOffset, value: __Raw.stringRoom(0))
	__Raw.storeWord(stream, offset: streamLengthOffset, value: 0)
	__Raw.storeWord(stream, offset: streamCapacityOffset, value: 0)
	__Raw.storeWord(stream, offset: streamWaitOffset, value: wait)
	__Raw.storeWord(stream, offset: streamReadOffset, value: 0)
	__Raw.storeWord(stream, offset: streamStateOffset, value: streamOpen)
	__Raw.storeWord(stream, offset: streamBusyOffset, value: 0)
end 'startStream'

// streamRoom makes room for a read past a stream's text, which grows by doubling, and gives how much there is.
function streamRoom(stream Count) returns Count
	let text = wordAt(stream, offset: streamTextOffset)
	let length = wordAt(stream, offset: streamLengthOffset)
	let capacity = wordAt(stream, offset: streamCapacityOffset)
	if __Raw.wrappingSub(capacity, right: length) < readChunkBytes 'grow'
		let doubled = __Raw.wrappingAdd(capacity, right: capacity)
		let needed = __Raw.wrappingAdd(length, right: readChunkBytes)
		let grown = doubled if doubled > needed else needed
		let room = __Raw.stringRoom(grown)
		if length != 0 'kept'
			copyBytes(text, target: room, count: length)
		end 'kept'
		__Raw.freeStringRoom(text)
		__Raw.storeWord(stream, offset: streamTextOffset, value: room)
		__Raw.storeWord(stream, offset: streamCapacityOffset, value: grown)
	end 'grow'
	return __Raw.wrappingSub(wordAt(stream, offset: streamCapacityOffset), right: length)
end 'streamRoom'

// storeStream stores the text a stream read as a string at an address, which owns its room from then on.
function storeStream(at Count, stream Count)
	storeOwnedString(at, offset: 0, bytes: wordAt(stream, offset: streamTextOffset), length: wordAt(stream, offset: streamLengthOffset), ascii: false)
end 'storeStream'

// freeStream frees the text of a stream that no string took.
function freeStream(stream Count)
	__Raw.freeStringRoom(wordAt(stream, offset: streamTextOffset))
end 'freeStream'

// markExpired says in a run's wait that its deadline ended a wait.
function markExpired(wait Count)
	__Raw.storeWord(wait, offset: waitExpiredOffset, value: set)
end 'markExpired'

// startHelper makes the green thread that runs code with an argument, and readies it.
function startHelper(code Count, argument Count) returns Count
	let helper = greenSpawn(code)
	greenSetArgument(helper, index: 0, value: argument)
	greenReady(helper)
	return helper
end 'startHelper'

// killTree ends the child's tree, which the deadline of a run does, and says in the wait that it has.
function killTree(wait Count)
	_ = endTree(wait)
	__Raw.storeWord(wait, offset: waitKilledOffset, value: set)
end 'killTree'

// waitForExit parks the running green thread until the child of a wait has exited, which it says, until the wait's deadline, which
// ends the child's tree (killTree) and is waited on, or until the entry of the child's exit is evicted or the green thread is
// cancelled, which it says too. An entry may hold an event of its last owner, and one that was taken by an earlier wait is not
// there again, so a wake says nothing of the child (childExited does), which is asked before every wait.
function waitForExit(wait Count) returns bool
	let process = wordAt(wait, offset: waitProcessOffset)
	let child = wordAt(wait, offset: waitChildOffset)
	var deadline = wordAt(wait, offset: waitDeadlineOffset)
	while true 'exit'
		if childExited(wait, child: child) 'exited'
			return true
		end 'exited'
		let status = eventWait(process, mode: eventRead, deadline: deadline)
		if status == eventReady 'ready'
			continue 'exit'
		end 'ready'
		if status != eventExpired 'ended'
			return false
		end 'ended'
		markExpired(wait)
		killTree(wait)
		deadline = eventNoDeadline
	end 'exit'
	return false
end 'waitForExit'

// exitWaiterMain waits for the child of a run to exit, in the run's wait that is its green thread's argument (waitForExit), until
// the run's deadline.
function exitWaiterMain(g Count) returns Count
	let wait = greenArgument(g, index: 0)
	if not waitForExit(wait) 'unexpected'
		panic("the wait for a child's exit ended otherwise than by its exit or the run's deadline")
	end 'unexpected'
	return 0
end 'exitWaiterMain'

// streamReaderMain reads a stream's pipe to its end, in the stream record that is its green thread's argument, until the
// run's deadline, and closes the end. A read that fails ends the stream, as the end of the data does.
function streamReaderMain(g Count) returns Count
	let stream = greenArgument(g, index: 0)
	let wait = wordAt(stream, offset: streamWaitOffset)
	let entry = wordAt(stream, offset: endEntryOffset)
	let deadline = wordAt(wait, offset: waitDeadlineOffset)
	while true 'read'
		let room = streamRoom(stream)
		let asked = room if room < readMostBytes else readMostBytes
		let length = wordAt(stream, offset: streamLengthOffset)
		let got = eventTransfer(entry, mode: eventRead, buffer: __Raw.wrappingAdd(wordAt(stream, offset: streamTextOffset), right: length), length: asked, deadline: deadline)
		if got == 0 'ended'
			break 'read'
		end 'ended'
		if got > asked 'stopped'
			if got == transferExpired 'late'
				markExpired(wait)
			end 'late'
			break 'read'
		end 'stopped'
		__Raw.storeWord(stream, offset: streamLengthOffset, value: __Raw.wrappingAdd(length, right: keptOf(stream, length: length, got: got)))
	end 'read'
	releaseOurEnd(stream)
	return 0
end 'streamReaderMain'

// keptOf is how many of the got bytes that a read added after a stream's length it keeps: all of them, or the ones up to the
// stream's limit. A limit caps what is kept and never what is read, since a child that fills a pipe that nothing reads waits for ever.
function keptOf(stream Count, length Count, got Count) returns Count
	let limit = wordAt(stream, offset: streamLimitOffset)
	if limit == noLimit 'uncapped'
		return got
	end 'uncapped'
	if length >= limit 'full'
		return 0
	end 'full'
	let room = __Raw.wrappingSub(limit, right: length)
	return got if got < room else room
end 'keptOf'

// inputWriterMain writes the input of a run to its pipe, in the input record that is its green thread's argument, until the
// run's deadline, and closes the end, which ends the child's input. A write that fails is a child that stopped reading, which
// is no failure of the run, and an end that a caller closed is the end of what is written.
function inputWriterMain(g Count) returns Count
	let input = greenArgument(g, index: 0)
	let wait = wordAt(input, offset: inputWaitOffset)
	let deadline = wordAt(wait, offset: waitDeadlineOffset)
	let bytes = wordAt(input, offset: inputTextOffset)
	let length = wordAt(input, offset: inputLengthOffset)
	var done = 0 as Count
	while done < length 'write'
		// An input that a caller closed meanwhile has no entry: the end of what is written.
		let entry = wordAt(input, offset: endEntryOffset)
		if entry == noEntry 'closed'
			break 'write'
		end 'closed'
		let left = __Raw.wrappingSub(length, right: done)
		let asked = left if left < inputChunkBytes else inputChunkBytes
		let wrote = eventTransfer(entry, mode: eventWrite, buffer: __Raw.wrappingAdd(bytes, right: done), length: asked, deadline: deadline)
		if wrote > asked 'stopped'
			if wrote == transferExpired 'late'
				markExpired(wait)
			end 'late'
			break 'write'
		end 'stopped'
		done = __Raw.wrappingAdd(done, right: wrote)
	end 'write'
	releaseOurEnd(input)
	return 0
end 'inputWriterMain'

// awaitChild serves a run whose child has started, until the child has exited, its output has ended and its input is written
// or refused, and says whether the run's deadline ended a wait: it ends the child's tree then, and says in the wait whether part of
// the tree was still running (waitSurvivedOffset). The caller has put in the run's wait the child, the entry of its
// exit, the entries of the ends of its pipes that the run uses, and the bytes and the length of the input that is written. The
// run's own green thread parks until the green threads that read, write and wait have finished: one for each pipe the run has, so
// that a stream that is not collected has none; the ends and the exit's entry are closed and given back by then, and the
// streams' texts are the caller's to store or free.
function awaitChild(wait Count, deadlineMs Count) returns bool
	__Raw.storeWord(wait, offset: waitDeadlineOffset, value: runDeadline(deadlineMs))
	let outputRecord = fieldAt(wait, offset: waitOutputOffset)
	let errorRecord = fieldAt(wait, offset: waitErrorOffset)
	let inputRecord = fieldAt(wait, offset: waitInputOffset)
	startStream(outputRecord, wait: wait)
	startStream(errorRecord, wait: wait)
	let exitWaiter = startHelper(__Raw.codeAddress("exitWaiterMain"), argument: wait)
	var outputReader = noGreen
	if wordAt(outputRecord, offset: endEntryOffset) != noEntry 'output'
		outputReader = startHelper(__Raw.codeAddress("streamReaderMain"), argument: outputRecord)
	end 'output'
	var errorReader = noGreen
	if wordAt(errorRecord, offset: endEntryOffset) != noEntry 'errors'
		errorReader = startHelper(__Raw.codeAddress("streamReaderMain"), argument: errorRecord)
	end 'errors'
	var inputWriter = noGreen
	let held = wordAt(inputRecord, offset: inputHoldOffset) != 0
	if wordAt(inputRecord, offset: endEntryOffset) != noEntry and not held 'input'
		__Raw.storeWord(inputRecord, offset: inputWaitOffset, value: wait)
		inputWriter = startHelper(__Raw.codeAddress("inputWriterMain"), argument: inputRecord)
	end 'input'
	_ = greenAwait(exitWaiter)
	if held 'unheld'
		releaseOurEnd(inputRecord)
	end 'unheld'
	if outputReader != noGreen 'outputEnded'
		_ = greenAwait(outputReader)
	end 'outputEnded'
	if errorReader != noGreen 'errorsEnded'
		_ = greenAwait(errorReader)
	end 'errorsEnded'
	if inputWriter != noGreen 'written'
		_ = greenAwait(inputWriter)
	end 'written'
	let expired = wordAt(wait, offset: waitExpiredOffset) != 0
	if expired 'late'
		endDeadlineTree(wait)
	end 'late'
	eventProcessFree(wordAt(wait, offset: waitProcessOffset))
	return expired
end 'awaitChild'

// endDeadlineTree is what a deadline that ended a wait leaves to do once the wait has: a child that exited before the deadline left
// processes that hold its pipes, which the deadline ends too, and the wait says whether part of the tree was still running after.
function endDeadlineTree(wait Count)
	if wordAt(wait, offset: waitKilledOffset) == 0 'unended'
		killTree(wait)
	end 'unended'
	if not treeEnded(wait) 'survived'
		__Raw.storeWord(wait, offset: waitSurvivedOffset, value: set)
	end 'survived'
end 'endDeadlineTree'

// argumentAt is the address of the argument at an index of an array of strings, which stays there: its bytes are
// __Raw.stringBytesAt and its length __Raw.stringLengthAt of it at 0.
function argumentAt(arguments Count, index Count) returns Count
	if index >= osArrayLimit 'outside'
		panic("too many arguments to quote")
	end 'outside'
	return __Raw.wrappingAdd(__Raw.loadWord(arguments, offset: osArrayDataOffset), right: collectionBytes(index, elementBytes: __Raw.stringSize()))
end 'argumentAt'

// holdsNul is whether the executable, an argument or the working directory of a run holds a NUL byte, which names no program and no argument: the
// systems' calls end their texts at it, so the spawn would run what the bytes before it name, without the arguments after.
// The run is refused as spawnFailed before anything starts, as maxon's is.
function holdsNul(executable String, arguments Count, directory String) returns bool
	if bytesHoldNul(__Raw.stringBytes(executable), length: __Raw.stringLength(executable)) or bytesHoldNul(__Raw.stringBytes(directory), length: __Raw.stringLength(directory)) 'texts'
		return true
	end 'texts'
	let count = wordAt(arguments, offset: osArrayLengthOffset)
	for i in 0 upto count 'arguments'
		let argument = argumentAt(arguments, index: i)
		if bytesHoldNul(__Raw.stringBytesAt(argument, offset: 0), length: __Raw.stringLengthAt(argument, offset: 0)) 'argument'
			return true
		end 'argument'
	end 'arguments'
	return false
end 'holdsNul'

function bytesHoldNul(bytes Count, length Count) returns bool
	var i = 0 as Count
	while i < length 'bytes'
		if __Raw.loadByte(bytes, offset: i) == 0 'nul'
			return true
		end 'nul'
		i = __Raw.wrappingAdd(i, right: 1)
	end 'bytes'
	return false
end 'bytesHoldNul'

// runChild runs the child of osRun, osRunIn and osRunInput: it makes the request of the executable and its arguments (their blob),
// the directory unless it is empty and the standard input, which is the caller's own, or in a run with input a pipe that holds the
// input and then ends, collects the output and the error whole, starts the child (startChild, each system's), waits for it
