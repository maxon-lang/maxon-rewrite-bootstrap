// Running a program on Linux, which has no call that spawns one: the run clones the process as vfork does, and the child
// puts the write ends of two pipes in place of its standard output and error and executes the program (execve), as
// maxon's runtime builds a child out of clone, pipe2, dup3 and execve. The child runs in the run's memory, on its stack,
// while the run's thread waits in the clone until the child has executed the program or exited (CLONE_VM | CLONE_VFORK, as
// glibc's posix_spawn and Go's forkExec make a child), so a start copies no page tables and costs the same however large
// the run's process is; what the child may do in that time is execChild's. The clone holds the fork lock (linux.maxon), so that
// the child never gets a copy of a file that a write has open and makes the run of that file fail as busy. A third pipe, closed on exec, tells the run whether
// the execve failed and with what errno: a child that executed the program closes it unwritten. The run reads both
// output pipes as the child goes on, through the event queue, so that a child that fills one cannot block waiting for the run to
// read the other, and watches for the child's exit through the pidfd of the child (eventProcessNew), which epoll reports
// readable once it has ended; the child is then waited for, which returns at once. The child's environment is the run's own, or a
// block of the caller's. It leads a process group of its own, which ends the tree it starts (subprocess.maxon: endTree). Its
// standard input is the run's, none (the null device), a file or a fourth pipe, which the run writes the input into as the child
// reads it, through the event queue too, and its output and error are pipes, the null device, files or the run's own
// (subprocess.maxon).

#if os(Linux)
	// The run's record, one allocation: the ends of the three pipes as eventChildPipe makes them (the read end then the write
	// end, a word each), the status pipe as pipe2 writes it (the read end then the write end, 32 bits each), the errno a failed
	// execve wrote, the run's wait (subprocess.maxon), and what the clone reads: every signal as a
	// set, the thread's mask from before the clone blocked them, a struct sigaction of SIG_DFL, all zero, which the child gives
	// the preemption signal, the fds the child puts at its standard streams, and the fds opened for the streams that are files.
	let runOutputPipeOffset = 0 as Count

	let runErrorPipeOffset = (runOutputPipeOffset + pipeEndBytes) as Count

	let runInputPipeOffset = (runErrorPipeOffset + pipeEndBytes) as Count

	let runStatusPipeOffset = (runInputPipeOffset + pipeEndBytes) as Count

	let runExecErrnoOffset = (runStatusPipeOffset + pipeFdsBytes) as Count

	let runAllSignalsOffset = (runExecErrnoOffset + wordBytes) as Count

	let runCloneMaskOffset = (runAllSignalsOffset + wordBytes) as Count

	let runDefaultActionOffset = (runCloneMaskOffset + wordBytes) as Count

	// The fds that the child puts in place of its standard input, output and error, or noFd for a stream it keeps as it is.
	let runInputFdOffset = (runDefaultActionOffset + linuxSigactionBytes) as Count

	let runOutputFdOffset = (runInputFdOffset + wordBytes) as Count

	let runErrorFdOffset = (runOutputFdOffset + wordBytes) as Count

	// Whether the child leads a session of its own (a detached one) and not only a process group.
	let runSessionOffset = (runErrorFdOffset + wordBytes) as Count

	let runStreamFilesOffset = (runSessionOffset + wordBytes) as Count

	let runWaitOffset = (runStreamFilesOffset + streamFilesBytes) as Count

	let runRecordBytes = (runWaitOffset + waitBytes) as Count

	let pipeFdsBytes = 8

	let pipeWriteEndOffset = 4

	let stdoutFd = 1

	let stderrFd = 2

	// nullDeviceFlags is O_RDWR | O_CLOEXEC, which the null device is opened with: a stream of the child's that is none or
	// discarded is dup3's copy of it, which stays open on exec.
	let nullDeviceFlags = linuxOpenCloseOnExec or 2

	let nullDevicePath = "/dev/null"

	// The errnos that a failed spawn gives besides those of linux.maxon, which maxon's runtime tells apart in Win32's words: a
	// file or a directory that is not there, access that is refused and a table of files that is full are the codes of Windows
	// that say so; any other errno is ERROR_GEN_FAILURE.
	let errnoTooManyFiles = 24

	let errnoFileTableOverflow = 23

	// execFailedExitCode is what a child whose execve failed exits with, as a shell's does.
	let execFailedExitCode = 127

	let noUsage = 0

	// The separator of the directories of PATH, which a program named without a directory is looked for in.
	let searchPathVariable = "PATH"

	let searchPathSeparator = 0x3A as Byte

	function pipeFd(pipes Count, writeEnd bool) returns Count
		return __Raw.loadWord32(pipes, offset: pipeWriteEndOffset if writeEnd else 0)
	end 'pipeFd'

	// isProgramAt is whether a zero-terminated path names a file that is not a directory.
	function isProgramAt(cPath Count) returns bool
		let stat = alloc(linuxStatBytes)
		let result = statCString(cPath, stat: stat)
		let mode = __Raw.loadWord32(stat, offset: linuxStatModeOffset)
		free(stat)
		return not failed(result) and (mode and linuxModeTypeMask) != linuxModeDirectory
	end 'isProgramAt'

	// joinedPath is a new zero-terminated path of the bytes of a directory, a separator and a name.
	function joinedPath(directory Count, directoryLength Count, name Count, nameLength Count) returns Count
		let path = alloc(__Raw.wrappingAdd(__Raw.wrappingAdd(directoryLength, right: nameLength), right: 2))
		if directoryLength != 0 'directory'
			copyBytes(directory, target: path, count: directoryLength)
		end 'directory'
		let at = storeNextByte(path, offset: directoryLength, value: slashByte)
		if nameLength != 0 'name'
			copyBytes(name, target: __Raw.wrappingAdd(path, right: at), count: nameLength)
		end 'name'
		return path
	end 'joinedPath'

	// programPath is a new zero-terminated path of the program that an executable names, its bytes and length: the name itself
	// when it holds a separator, and otherwise the first directory of PATH that holds a program of the name, as execvp looks; 0
	// when there is none.
	function programPath(name Count, nameLength Count) returns Count
		for i in 0 upto nameLength 'separator'
			if __Raw.loadByte(name, offset: i) == slashByte 'path'
				return cStringOfBytes(name, length: nameLength)
			end 'path'
		end 'separator'
		var unset = 0 as Count
		let search = osEnvironmentVariable(searchPathVariable, errorAddress: __Raw.addressOf(unset))
		if unset != 0 'noSearch'
			return 0
		end 'noSearch'
		let searchBytes = __Raw.stringBytes(search)
		let searchLength = __Raw.stringLength(search)
		var start = 0 as Count
		while start <= searchLength 'directories'
			var stop = start
			while stop < searchLength and __Raw.loadByte(searchBytes, offset: stop) != searchPathSeparator 'directory'
				stop = stop + 1
			end 'directory'
			let candidate = joinedPath(__Raw.wrappingAdd(searchBytes, right: start), directoryLength: __Raw.wrappingSub(stop, right: start), name: name, nameLength: nameLength)
			if isProgramAt(candidate) 'found'
				return candidate
			end 'found'
			free(candidate)
			start = __Raw.wrappingAdd(stop, right: 1)
		end 'directories'
		return 0
	end 'programPath'

	// closePipe closes both ends of the status pipe, which pipe2 made.
	function closePipe(pipes Count)
		closeFd(pipeFd(pipes, writeEnd: false))
		closeFd(pipeFd(pipes, writeEnd: true))
	end 'closePipe'

	// openPipes makes the pipes of a run that the set of pipes names, each end closed on exec, and the status pipe, and gives
	// whether it made them all; a pipe it could not make leaves those before it closed.
	function openPipes(run Count, pipes Count) returns bool
		let wait = fieldAt(run, offset: runWaitOffset)
		let output = fieldAt(run, offset: runOutputPipeOffset)
		let errors = fieldAt(run, offset: runErrorPipeOffset)
		let input = fieldAt(run, offset: runInputPipeOffset)
		if not openRunPipes(wait, output: output, errors: errors, input: input, pipes: pipes) 'streams'
			return false
		end 'streams'
		if failed(__Raw.syscall2(linuxSysPipe2, arg1: fieldAt(run, offset: runStatusPipeOffset), arg2: linuxOpenCloseOnExec)) 'status'
			closeChildEnds(output, errors: errors, input: input, pipes: pipes)
			closeOurEnds(wait)
			return false
		end 'status'
		return true
	end 'openPipes'

	// execChild is the child of a run: it leads a process group of its own (a session of its own for a detached child), puts the fds that the run names (an end of a pipe, a
	// file or the null device) in place of its standard input, output and error, which dup3 leaves open on exec, moves to the
	// zero-terminated directory unless that is noDirectory, and executes the program with the environment that the vector of its
	// entries is. When a step fails it writes the errno down the status pipe and exits.
	//
	// The child shares the run's memory and runs on the run's stack below the frame of runChild, while the run's thread
	// waits in the clone, as Go's forkAndExecInChild1 does. So it makes only raw system calls and reads what the run made
	// for it before the clone: it allocates nothing, takes no lock, touches no state of the scheduler, and returns from
	// nothing (execve or exit_group ends it), so no frame of the run's is used again. The words it writes to the run's frame
	// past the clone are the ones the run writes itself when it resumes (the compiler takes the call of execChild for one
	// that returns, so a value the run holds across the clone keeps its place on the child's path too), and its own frames are
	// below the run's stack pointer. Every signal is blocked from before the clone, so that no handler runs on the shared
	// memory: the child gives the preemption signal, the one signal with a handler, its default action, in its own table of
	// actions, which clone without CLONE_SIGHAND copies, and gives itself the run's mask back just before the execve, which
	// keeps the mask, as a forked child had it. qemu-user, which runs arm64-linux under WSL, makes such a clone a fork, in
	// which the same steps are as safe as they were.
	function execChild(run Count, path Count, vector Count, directory Count, envp Count)
		failChildUnless(run, result: __Raw.syscall4(linuxSysRtSigaction, arg1: linuxSigurg, arg2: fieldAt(run, offset: runDefaultActionOffset), arg3: 0, arg4: linuxSignalMaskBytes))
		if wordAt(run, offset: runSessionOffset) != 0 'session'
			failChildUnless(run, result: __Raw.syscall0(linuxSysSetsid))
		end 'session' else 'group'
			failChildUnless(run, result: __Raw.syscall2(linuxSysSetpgid, arg1: 0, arg2: 0))
		end 'group'
		if wordAt(run, offset: runInputFdOffset) != noFd 'input'
			failChildUnless(run, result: placeFd(wordAt(run, offset: runInputFdOffset), at: stdinFd))
		end 'input'
		if wordAt(run, offset: runOutputFdOffset) != noFd 'output'
			failChildUnless(run, result: placeFd(wordAt(run, offset: runOutputFdOffset), at: stdoutFd))
		end 'output'
		if wordAt(run, offset: runErrorFdOffset) != noFd 'errors'
			failChildUnless(run, result: placeFd(wordAt(run, offset: runErrorFdOffset), at: stderrFd))
		end 'errors'
		if directory != noDirectory 'directory'
			let moved = __Raw.syscall1(linuxSysChdir, arg1: directory)
			if failed(moved) 'unmoved'
				failChild(run, errno: errnoOf(moved) or unmovedMark)
			end 'unmoved'
		end 'directory'
		failChildUnless(run, result: __Raw.syscall4(linuxSysRtSigprocmask, arg1: linuxSigSetMask, arg2: fieldAt(run, offset: runCloneMaskOffset), arg3: 0, arg4: linuxSignalMaskBytes))
		let result = __Raw.syscall3(linuxSysExecve, arg1: path, arg2: vector, arg3: envp)
		failChild(run, errno: errnoOf(result))
	end 'execChild'

	// placeFd makes an fd the one at a standard stream that an execve keeps, and gives 0 or -errno. dup3 refuses an fd that is the
	// stream already (the run's own standard stream was closed, so that the fd it opened took the number), whose close-on-exec flag
	// is cleared instead.
	function placeFd(fd Count, at Count) returns Count
		if fd == at 'placed'
			return __Raw.syscall3(linuxSysFcntl, arg1: fd, arg2: linuxFcntlSetDescriptorFlags, arg3: 0)
		end 'placed'
		return __Raw.syscall3(linuxSysDup3, arg1: fd, arg2: at, arg3: noFlags)
	end 'placeFd'

	// failChildUnless is failChild for the result of a system call of the child that failed, which is -errno.
	function failChildUnless(run Count, result Count)
		if failed(result) 'failed'
			failChild(run, errno: errnoOf(result))
		end 'failed'
	end 'failChildUnless'

	// failChild writes the errno of the step of the child that failed down the status pipe and exits.
	function failChild(run Count, errno Count)
		__Raw.storeWord(run, offset: runExecErrnoOffset, value: errno)
		_ = writeAll(pipeFd(fieldAt(run, offset: runStatusPipeOffset), writeEnd: true), data: fieldAt(run, offset: runExecErrnoOffset), length: wordBytes)
		exitProcess(execFailedExitCode)
	end 'failChild'

	// noDirectory is the directory of a child that starts in the run's working directory.
	let noDirectory = 0

	// unmovedMark is set in what a child writes down the status pipe when it could not move to its directory, which fails
	// the spawn whatever the errno, as CreateProcessW fails it on Windows, rather than saying the program was not found.
	let unmovedMark = 0x100000000

	// execErrno is the errno that the child of a run wrote down the status pipe, or 0 when the pipe closed unwritten, as an
	// execve that succeeded closes it.
	function execErrno(run Count) returns Count
		let status = pipeFd(fieldAt(run, offset: runStatusPipeOffset), writeEnd: false)
		while true 'read'
			let got = __Raw.syscall3(linuxSysRead, arg1: status, arg2: fieldAt(run, offset: runExecErrnoOffset), arg3: wordBytes)
			if failed(got) and errnoOf(got) == linuxEintr 'again'
				continue 'read'
			end 'again'
			closeFd(status)
			if got == wordBytes 'written'
				return __Raw.loadWord(run, offset: runExecErrnoOffset)
			end 'written'
			return 0
		end 'read'
		return 0
	end 'execErrno'

	// reap waits for the child to end and gives its wait status.
	function reap(run Count, pid Count) returns Count
		let status = fieldAt(fieldAt(run, offset: runWaitOffset), offset: waitStatusOffset)
		while true 'wait'
			let result = __Raw.syscall4(linuxSysWait4, arg1: pid, arg2: status, arg3: noWaitOptions, arg4: noUsage)
			if not (failed(result) and errnoOf(result) == linuxEintr) 'done'
				return __Raw.loadWord32(status, offset: 0)
			end 'done'
		end 'wait'
		return 0
	end 'reap'

	// childWaited waits for the child with the options of wait4, its wait status kept in the wait, and gives whether it had ended
	// (and it is waited for then): a child that has not been waited for may always be.
	function childWaited(wait Count, child Count, options Count) returns bool
		let status = fieldAt(wait, offset: waitStatusOffset)
		while true 'wait'
			let result = __Raw.syscall4(linuxSysWait4, arg1: child, arg2: status, arg3: options, arg4: noUsage)
			if failed(result) and errnoOf(result) == linuxEintr 'again'
				continue 'wait'
			end 'again'
			if failed(result) 'refused'
				panic("cannot wait for a child that has not been waited for")
			end 'refused'
			if result == child 'ended'
				markReaped(wait)
			end 'ended'
			return result == child
		end 'wait'
		return false
	end 'childWaited'

	// orphanEnded is whether a child that nothing waits for has ended, which it waits for if so: without waiting for one that has
	// not, and a pid that is not a child of this process, one that something else waited for, is gone.
	function orphanEnded(pid Count) returns bool
		let result = __Raw.syscall4(linuxSysWait4, arg1: pid, arg2: 0, arg3: waitNoHang, arg4: noUsage)
		if failed(result) 'refused'
			return errnoOf(result) != linuxEintr
		end 'refused'
		return result == pid
	end 'orphanEnded'

	// orphanReap waits for a child that nothing waits for, which its pidfd says has ended, and ends with it, or with the wait's
	// failure where it is no child of this process.
	function orphanReap(pid Count)
		while true 'wait'
			let result = __Raw.syscall4(linuxSysWait4, arg1: pid, arg2: 0, arg3: noWaitOptions, arg4: noUsage)
			if not (failed(result) and errnoOf(result) == linuxEintr) 'done'
				return
			end 'done'
		end 'wait'
	end 'orphanReap'

	// orphanArmed is whether the event queue watches the process of an orphan's entry, which a pidfd always does.
	function orphanArmed(entry Count) returns bool
		return true
	end 'orphanArmed'

	// orphanClose closes the pidfd of an orphan's entry, which takes it off the event queue.
	function orphanClose(scheduler Count, entry Count)
		closeFd(__Raw.loadWord(entry, offset: entryHandleOffset))
	end 'orphanClose'

	// childExited is whether the child has exited, which it waits for if so, its wait status kept in the wait then. It never waits
	// otherwise: the entry that its pidfd is may hold an event of its last owner, so a wake of the entry is no proof.
	function childExited(wait Count, child Count) returns bool
		return isReaped(wait) or childWaited(wait, child: child, options: waitNoHang)
	end 'childExited'

	// signalGroup sends a signal to the process group that the child leads, which the child's pid names, and gives 0 or -errno.
	function signalGroup(pid Count, signal Count) returns Count
		return __Raw.syscall2(linuxSysKill, arg1: __Raw.wrappingSub(0, right: pid), arg2: signal)
	end 'signalGroup'

	// noSuchGroup is whether the result of signalGroup says that the group has no member.
	function noSuchGroup(result Count) returns bool
		return failed(result) and errnoOf(result) == linuxEsrch
	end 'noSuchGroup'

	// openStreamFile is the fd of the file that the bytes of a path name, open to read an existing file, or made or emptied for
	// writing, closed on exec, or -errno.
	function openStreamFile(path Count, length Count, forWrite bool) returns Count
		if forWrite 'write'
			return openPathBytes(path, length: length, flags: linuxOpenReplace, mode: linuxFileMode)
		end 'write'
		return openPathBytes(path, length: length, flags: linuxOpenReadOnly, mode: 0)
	end 'openStreamFile'

	// prepareClone fills what the clone and its child read of the run's record: the set of every signal, and SIG_DFL's
	// struct sigaction.
	function prepareClone(run Count)
		__Raw.storeWord(run, offset: runAllSignalsOffset, value: 0xFFFFFFFFFFFFFFFF as Count)
		for at in 0 upto linuxSigactionBytes / wordBytes 'action'
			__Raw.storeWord(fieldAt(run, offset: runDefaultActionOffset), offset: try at * wordBytes otherwise panic("a sigaction past the run's record"), value: 0)
		end 'action'
	end 'prepareClone'

	// reapChild waits for a child that has not run, or that is ended, and gives its wait status.
	function reapChild(run Count, pid Count) returns Count
		enterBlocking()
		let status = reap(run, pid: pid)
		exitBlocking()
		return status
	end 'reapChild'

	// newRun is a new run: a record whose wait has no entries and whose streams keep their fds.
	function newRun() returns Count
		let run = alloc(runRecordBytes)
		waitNew(fieldAt(run, offset: runWaitOffset))
		return run
	end 'newRun'

	// waitOf is the wait of a run, which awaitChild serves.
	function waitOf(run Count) returns Count
		return fieldAt(run, offset: runWaitOffset)
	end 'waitOf'

	// openNullDevice is an fd of the null device, closed on exec, or -errno.
	function openNullDevice() returns Count
		let path = cStringOf(nullDevicePath)
		let fd = __Raw.syscall4(linuxSysOpenat, arg1: atCwd(), arg2: path, arg3: nullDeviceFlags, arg4: 0)
		free(path)
		return fd
	end 'openNullDevice'

	// streamFd is the fd that the child puts at a stream whose kind is given: an end of the run's pipe for a collected stream, the
	// fd of the file of one that is a file, the null device for one that is none or discarded, and noFd for one that the child
	// inherits.
	function streamFd(kind Count, collected Count, pipeEnd Count, nullFd Count, inherited Count, file Count, fileFd Count) returns Count
		if kind == collected 'collected'
			return pipeEnd
		end 'collected'
		if kind == inherited 'inherited'
			return noFd
		end 'inherited'
		if kind == file 'file'
			return fileFd
		end 'file'
		return nullFd
	end 'streamFd'

	// startChild starts the child that a request describes in the run, and gives 0, or the failure of the step that failed, with
	// every pipe and fd it made closed. The zero-terminated copy of the directory and the vector of the environment are freed
	// before it returns, on every way out.
	function startChild(request Count, run Count) returns Count
		let wait = fieldAt(run, offset: runWaitOffset)
		let blob = wordAt(request, offset: requestArgvOffset)
		let program = programPath(blob, nameLength: terminatedLength(blob))
		if program == 0 'missing'
			return systemFailure(failureStepProgram, code: linuxEnoent)
		end 'missing'
		let pipes = pipesOf(request)
		let inputKind = wordAt(request, offset: requestInputKindOffset)
		let outputKind = wordAt(request, offset: requestOutputKindOffset)
		let errorKind = wordAt(request, offset: requestErrorKindOffset)
		prepareRun(wait, request: request)
		if not openPipes(run, pipes: pipes) 'pipes'
			free(program)
			return setupFailure()
		end 'pipes'
		let files = fieldAt(run, offset: runStreamFilesOffset)
		let unfiled = openStreamFiles(request, files: files)
		if unfiled != 0 'unfiled'
			closePipe(fieldAt(run, offset: runStatusPipeOffset))
			closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
			closeOurEnds(wait)
			free(program)
			return unfiled
		end 'unfiled'
		var nullFd = noFd
		if inputKind == spawnStdinNone or outputKind == spawnOutputDiscard or errorKind == spawnOutputDiscard 'nulled'
			nullFd = openNullDevice()
			if failed(nullFd) 'unopened'
				let failure = systemFailure(failureStepStream, code: errnoOf(nullFd))
				closeStreamFiles(files)
				closePipe(fieldAt(run, offset: runStatusPipeOffset))
				closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
				closeOurEnds(wait)
				free(program)
				return failure
			end 'unopened'
		end 'nulled'
		__Raw.storeWord(run, offset: runInputFdOffset, value: streamFd(inputKind, collected: spawnStdinBytes, pipeEnd: endOf(fieldAt(run, offset: runInputPipeOffset), writeEnd: false), nullFd: nullFd, inherited: spawnStdinInherit, file: spawnStdinFile, fileFd: wordAt(files, offset: streamInputFileOffset)))
		__Raw.storeWord(run, offset: runOutputFdOffset, value: streamFd(outputKind, collected: spawnOutputCollect, pipeEnd: endOf(fieldAt(run, offset: runOutputPipeOffset), writeEnd: true), nullFd: nullFd, inherited: spawnOutputInherit, file: spawnOutputFile, fileFd: wordAt(files, offset: streamOutputFileOffset)))
		__Raw.storeWord(run, offset: runErrorFdOffset, value: streamFd(errorKind, collected: spawnOutputCollect, pipeEnd: endOf(fieldAt(run, offset: runErrorPipeOffset), writeEnd: true), nullFd: nullFd, inherited: spawnOutputInherit, file: spawnOutputFile, fileFd: wordAt(files, offset: streamErrorFileOffset)))
		let detached = isDetached(request)
		__Raw.storeWord(run, offset: runSessionOffset, value: set if detached else unset)
		let vector = argumentVector(blob, argc: wordAt(request, offset: requestArgcOffset))
		let own = ownEnvironment(request)
		var envp = environment()
		if own != 0 'ownBlock'
			envp = own
		end 'ownBlock'
		var start = noDirectory as Count
		let directoryLength = wordAt(request, offset: requestDirectoryLengthOffset)
		if directoryLength != 0 'directory'
			start = cStringOfBytes(wordAt(request, offset: requestDirectoryOffset), length: directoryLength)
		end 'directory'
		prepareClone(run)
		let lock = forkLock()
		enterBlocking()
		holdForkAlone(lock)
		_ = __Raw.syscall4(linuxSysRtSigprocmask, arg1: linuxSigSetMask, arg2: fieldAt(run, offset: runAllSignalsOffset), arg3: fieldAt(run, offset: runCloneMaskOffset), arg4: linuxSignalMaskBytes)
		let pid = __Raw.syscall5(linuxSysClone, arg1: linuxCloneChildFlags, arg2: 0, arg3: 0, arg4: 0, arg5: 0)
		if pid == 0 'child'
			execChild(run, path: program, vector: vector, directory: start, envp: envp)
		end 'child'
		_ = __Raw.syscall4(linuxSysRtSigprocmask, arg1: linuxSigSetMask, arg2: fieldAt(run, offset: runCloneMaskOffset), arg3: 0, arg4: linuxSignalMaskBytes)
		releaseForkAlone(lock)
		exitBlocking()
		if start != noDirectory 'started'
			free(start)
		end 'started'
		if own != 0 'freeBlock'
			free(own)
		end 'freeBlock'
		free(vector)
		free(program)
		closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
		closeStreamFiles(files)
		if nullFd != noFd 'closeNull'
			closeFd(nullFd)
		end 'closeNull'
		closeFd(pipeFd(fieldAt(run, offset: runStatusPipeOffset), writeEnd: true))
		if failed(pid) 'spawn'
			closeFd(pipeFd(fieldAt(run, offset: runStatusPipeOffset), writeEnd: false))
			closeOurEnds(wait)
			return systemFailure(failureStepProgram, code: errnoOf(pid))
		end 'spawn'
		let unexecuted = execErrno(run)
		if unexecuted != 0 'unexecuted'
			_ = reapChild(run, pid: pid)
			closeOurEnds(wait)
			if (unexecuted and unmovedMark) != 0 'unmoved'
				return systemFailure(failureStepDirectory, code: unexecuted and failureCodeMask)
			end 'unmoved'
			return systemFailure(failureStepProgram, code: unexecuted)
		end 'unexecuted'
		if detached 'left'
			__Raw.storeWord(wait, offset: waitPidOffset, value: pid)
			return 0
		end 'left'
		let watch = eventProcessNew(pid)
		if watch == noEntry 'unwatched'
			endAndReap(run, pid: pid)
			closeOurEnds(wait)
			return setupFailure()
		end 'unwatched'
		__Raw.storeWord(wait, offset: waitChildOffset, value: pid)
		__Raw.storeWord(wait, offset: waitProcessOffset, value: watch)
		__Raw.storeWord(wait, offset: waitPidOffset, value: pid)
		return 0
	end 'startChild'

	// abandonRun ends a child that no wait has taken, with the processes of its group, and gives up what the run holds of it: its
	// exit's entry, its pid, which is waited for unless a kill of its tree did, and the ends of its pipes.
	function abandonRun(run Count)
		let wait = waitOf(run)
		let pid = wordAt(wait, offset: waitChildOffset)
		eventProcessFree(wordAt(wait, offset: waitProcessOffset))
		endAndReap(run, pid: pid)
		closeOurEnds(wait)
	end 'abandonRun'

	// finishRun gives back what a child holds once its wait has ended, which on Linux is nothing: the pid was waited for.
	function finishRun(run Count)
	end 'finishRun'

	// win32CodeOf is an errno in the words of Win32 that maxon's runtime uses on every system.
	function win32CodeOf(errno Count) returns Count
		if errno == linuxEnoent 'missing'
			return codeFileNotFound
		end 'missing'
		if errno == linuxEnotdir 'notDirectory'
			return codePathNotFound
		end 'notDirectory'
		if errno == linuxEacces or errno == linuxEperm 'denied'
			return codeAccessDenied
		end 'denied'
		if errno == errnoTooManyFiles or errno == errnoFileTableOverflow 'full'
			return codeTooManyOpenFiles
		end 'full'
		return codeGeneralFailure
	end 'win32CodeOf'

	// resolveProgram is the program that a name asks for, as a new zero-terminated path, or 0 when there is none: the name's own
	// lookup (programPath), as execvp does.
	function resolveProgram(name Count, length Count) returns Count
		return programPath(name, nameLength: length)
	end 'resolveProgram'
#endif
