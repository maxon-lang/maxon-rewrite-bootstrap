// The hash entries, which run the fold of hashfold.maxon, and the ordered words of maxon's library. The process's hash
// state, its secret and the fold of no bytes under it, is made by the first hash of the process that needs it, as maxon's
// __hash_init is: the secret is the one MAXON_HASH_SEED pins, 16 hexadecimal digits, or 8 bytes of the system's entropy.
// A pin that is not 16 hexadecimal digits ends the process with maxon's message and exit code 1. The state hangs off the
// main thread's context, which every thread reaches, so every thread hashes alike, and a program that never asks for the
// seed never reads the environment or the system's entropy.

// HashInput is a span the fold reads (hashfold.maxon): the address of its first byte.
typealias HashInput = int(0 to u64.max)

// hashMulHigh is the fold's high word of the 128-bit product of two words (hashfold.maxon).
function hashMulHigh(left HashWord, right HashWord) returns HashWord
	return __Raw.mulHigh(left as Count, right: right as Count) as HashWord
end 'hashMulHigh'

// arrayIndexOutOfBounds is the case of ArrayError that a read of an ordered word past the end fails with.
let arrayIndexOutOfBounds = 0 as Count

let hashSeedVariable = "MAXON_HASH_SEED"

let hashSeedRefusalPrefix = "MAXON_HASH_SEED="

let hashSeedRefusalTail = " is not a hash seed: expected 16 hexadecimal digits\n"

// hashSeedShownBytes is the most of a refused pin that the message shows, as maxon's buffer of 32 bytes, one its end, does.
let hashSeedShownBytes = 31 as Count

// hashPinBytes is how much of a pin is read: the message shows hashSeedShownBytes of it, and one more tells a pin that is
// longer than that.
let hashPinBytes = 32 as Count

let hashSeedRefusalExitCode = 1 as Count

// hashSecretBytes is the size of a secret drawn from the system.
let hashSecretBytes = 8 as Count

let hashPinned = 1 as Count

#if os(Windows)
	// The system's entropy is ProcessPrng's, as maxon's runtime draws it, in a library that the import table does not
	// name, so that a program that never draws loads no more than it did.
	let entropyLibrary = "bcryptprimitives.dll"

	let entropyFunction = "ProcessPrng"

	// The two names are zero-terminated in one block of the runtime's own memory, which a draw makes and gives back, so that
	// it allocates nothing from the program's heap: the library's at its start, the function's at entropyFunctionOffset.
	let entropyNamesBytes = 64 as Count

	let entropyFunctionOffset = 32 as Count
#endif

// hashSeed is __Builtins.hashSeed: the fold of no bytes under the process's secret.
function hashSeed() returns Count
	return __Raw.loadWord(processHashState(), offset: hashSeedOffset)
end 'hashSeed'

// drawHashSeed is __Builtins.drawHashSeed: 8 fresh bytes of the system's entropy, or in a process whose secret is pinned
// the next of the seeds the secret draws, so that a pinned run draws the same ones.
function drawHashSeed() returns Count
	let state = processHashState()
	if __Raw.loadWord(state, offset: hashPinnedOffset) == hashPinned 'pinned'
		let index = __Raw.atomicAdd(state, offset: hashDrawsOffset, value: 1)
		return hashDrawn(index as HashWord, secret: __Raw.loadWord(state, offset: hashSecretOffset) as HashWord) as Count
	end 'pinned'
	return drawEntropy()
end 'drawHashSeed'

// processHashState is the process's hash state, which the first call makes. A thread reads it from its own context once
// it has found it (processHashStateFirst), so a hash reads one word for it rather than walking to the main thread's
// context through the scheduler; the read is an acquire, so a thread that finds the address finds the state's words.
function processHashState() returns Count
	let context = __Raw.threadContext()
	let state = __Raw.loadAcquire(context, offset: contextHashOffset)
	if state != noBox 'found'
		return state
	end 'found'
	return processHashStateFirst(context)
end 'processHashState'

// processHashStateFirst is the hash state for a thread whose context does not hold it yet: the main thread's, made by
// the first call of the process. Two threads may make it at once: the first to publish it wins, and the other gives its
// own back. The pointer is read as an acquire, so a thread that finds it published finds the state's words written, and
// a thread other than the main one keeps it in its own context for its next hash.
function processHashStateFirst(context Count) returns Count
	let main = mainContext(context)
	var state = __Raw.loadAcquire(main, offset: contextHashOffset)
	if state == noBox 'make'
		let made = makeHashState()
		let found = __Raw.compareExchange(main, offset: contextHashOffset, expected: noBox, desired: made)
		if found != noBox 'lost'
			unkeep(made, bytes: hashStateBytes)
			state = found
		end 'lost' else 'won'
			state = made
		end 'won'
	end 'make'
	if context != main 'cache'
		__Raw.storeRelease(context, offset: contextHashOffset, value: state)
	end 'cache'
	return state
end 'processHashStateFirst'

// mainContext is the main thread's context: a thread's own while the scheduler is not made, since only the main thread
// runs then.
function mainContext(context Count) returns Count
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	if scheduler == noBox 'main'
		return context
	end 'main'
	return __Raw.loadWord(scheduler, offset: schedMainThreadOffset)
end 'mainContext'

// makeHashState is a new hash state, of the pinned secret or a drawn one. An empty pin is no pin, as in maxon. Nothing of it
// comes from the program's heap, whose counts a program reads (HeapStats), which the first hash of the program would move:
// the pin is read into a block of the runtime's own memory, and parsed from there as two words.
function makeHashState() returns Count
	let state = keep(hashStateBytes)
	let room = keep(hashPinBytes)
	let length = osEnvironmentBytes(hashSeedVariable, room: room, capacity: hashPinBytes)
	var secret = 0 as Count
	if length != 0 'pinned'
		let low = __Raw.loadWord(room, offset: 0) as HashWord
		let high = __Raw.loadWord(room, offset: wordBytes) as HashWord
		if length != hashSecretDigits or not hashIsSecretWords(low, high: high) 'malformed'
			refuseHashSeed(room, length: length)
		end 'malformed'
		secret = hashSecretOfWords(low, high: high) as Count
		__Raw.storeWord(state, offset: hashPinnedOffset, value: hashPinned)
	end 'pinned' else 'drawn'
		secret = drawEntropy()
	end 'drawn'
	unkeep(room, bytes: hashPinBytes)
	__Raw.storeWord(state, offset: hashSecretOffset, value: secret)
	__Raw.storeWord(state, offset: hashSeedOffset, value: hashEmptyFold(secret as HashWord) as Count)
	return state
end 'makeHashState'

// refuseHashSeed ends the process over a pin of length bytes at an address that is not a secret, with maxon's message.
function refuseHashSeed(pin Count, length Count)
	let handle = standardError()
	writeHandle(handle, text: hashSeedRefusalPrefix)
	var shown = length
	if shown > hashSeedShownBytes 'long'
		shown = hashSeedShownBytes
	end 'long'
	writeHandle(handle, text: stringOfBytes(pin, length: shown))
	writeHandle(handle, text: hashSeedRefusalTail)
	exitProcess(hashSeedRefusalExitCode)
end 'refuseHashSeed'

#if os(Windows)
	// fillEntropy overwrites count bytes at an address with the system's entropy, from ProcessPrng, which is found by name and
	// asked once for all of them.
	function fillEntropy(at Count, count Count)
		let names = keep(entropyNamesBytes)
		copyBytes(__Raw.stringBytes(entropyLibrary), target: names, count: __Raw.stringLength(entropyLibrary))
		copyBytes(__Raw.stringBytes(entropyFunction), target: __Raw.wrappingAdd(names, right: entropyFunctionOffset), count: __Raw.stringLength(entropyFunction))
		let module = __Raw.callImport1("LoadLibraryA", arg1: names)
		if module == 0 'noLibrary'
			panic("the operating system refused to supply the entropy for a hash seed")
		end 'noLibrary'
		let prng = __Raw.callImport2("GetProcAddress", arg1: module, arg2: __Raw.wrappingAdd(names, right: entropyFunctionOffset))
		unkeep(names, bytes: entropyNamesBytes)
		if prng == 0 'noFunction'
			panic("the operating system refused to supply the entropy for a hash seed")
		end 'noFunction'
		if dword(__Raw.callHost2(prng, arg1: at, arg2: count)) == 0 'refused'
			panic("the operating system refused to supply the entropy for a hash seed")
		end 'refused'
	end 'fillEntropy'
#endif

#if os(Linux)
	// fillEntropy overwrites count bytes at an address with the system's entropy, from getrandom, made again when a signal
	// breaks it off or it gives fewer than were asked for.
	function fillEntropy(at Count, count Count)
		var filled = 0 as Count
		while filled < count 'fill'
			let got = __Raw.syscall3(linuxSysGetrandom, arg1: __Raw.wrappingAdd(at, right: filled), arg2: __Raw.wrappingSub(count, right: filled), arg3: 0)
			if failed(got) 'failed'
				if errnoOf(got) != linuxEintr 'refused'
					panic("the operating system refused to supply the entropy for a hash seed")
				end 'refused'
			end 'failed' else 'got'
				filled = __Raw.wrappingAdd(filled, right: got)
			end 'got'
		end 'fill'
	end 'fillEntropy'
#endif

// drawEntropy is 8 bytes of the system's entropy.
function drawEntropy() returns Count
	var word = 0 as Count
	fillEntropy(__Raw.addressOf(word), count: hashSecretBytes)
	return word
end 'drawEntropy'

// randomFill is __Builtins.fillRandom: it overwrites every byte of a byte array with the system's entropy, in one request
// of the system's, and gives 0.
function randomFill(array Count) returns Count
	let length = collectionLength(array)
	if length != 0 'bytes'
		fillEntropy(collectionPlace(array, index: 0, elementBytes: byteBytes), count: length)
	end 'bytes'
	return 0
end 'randomFill'

// hashWord is __Builtins.hashWord: the fold of a word under a seed.
function hashWord(word Count, seed Count) returns Count
	return hashWordFold(word as HashWord, seed: seed as HashWord) as Count
end 'hashWord'

// hashBytes is __Builtins.hashBytes: the fold of the count bytes of a byte array from an index under a seed.
function hashBytes(array Count, at Count, count Count, seed Count) returns Count
	let length = collectionLength(array)
	if at > length or count > length - at 'outside'
		panic("a hashed span reaches past the end of its array")
	end 'outside'
	if count == 0 'empty'
		return hashSpan(0, count: 0, seed: seed as HashWord) as Count
	end 'empty'
	return hashSpan(collectionPlace(array, index: at, elementBytes: byteBytes) as HashInput, count: count, seed: seed as HashWord) as Count
end 'hashBytes'

// hashStringBytes is __Builtins.hashBytes of a string: the fold of the count bytes of the string from an index under a
// seed. A string's bytes are where __Raw.stringBytes says, where an array's box points at its buffer, so it has its own
// entry to the same fold. All the bytes of a String that holds them in its words are hashed as its words (hashShortFold).
function hashStringBytes(text String, at Count, count Count, seed Count) returns Count
	let length = stringLength(text)
	if at > length or count > length - at 'outside'
		panic("a hashed span reaches past the end of its string")
	end 'outside'
	if count == 0 'empty'
		return hashSpan(0, count: 0, seed: seed as HashWord) as Count
	end 'empty'
	if at == 0 and count == length and isInline(text) 'inline'
		return hashShortFold(__Raw.stringFirstWord(text) as HashWord, rest: inlineRest(text) as HashWord, count: count, seed: seed as HashWord) as Count
	end 'inline'
	return hashSpan(__Raw.wrappingAdd(__Raw.stringBytes(text), right: at) as HashInput, count: count, seed: seed as HashWord) as Count
end 'hashStringBytes'

function hashLoadWord(input HashInput, at Count) returns HashWord
	return __Raw.loadWord(input as Count, offset: at) as HashWord
end 'hashLoadWord'

function hashLoadHalf(input HashInput, at Count) returns HashWord
	return __Raw.loadWord32(input as Count, offset: at) as HashWord
end 'hashLoadHalf'

function hashLoadByte(input HashInput, at Count) returns HashWord
	return __Raw.loadByte(input as Count, offset: at) as HashWord
end 'hashLoadByte'

// bytesReadWord is a read of an ordered word: the width bytes of a byte array from an index, the first the most
// significant where bigEndian, which fails with indexOutOfBounds when they are not all inside it.
function bytesReadWord(array Count, at Count, width Count, bigEndian bool, errorAddress Count) returns Count
	let length = collectionLength(array)
	if at >= length or length - at < width 'outside'
		failWith(errorAddress, errorCase: arrayIndexOutOfBounds)
		return 0
	end 'outside'
	succeed(errorAddress)
	let data = collectionPlace(array, index: at, elementBytes: byteBytes)
	var word = 0 as HashWord
	for i in 0 upto width 'bytes'
		word = word or ((__Raw.loadByte(data, offset: i) as HashWord) shl orderedWordShift(i, width: width, bigEndian: bigEndian))
	end 'bytes'
	return word as Count
end 'bytesReadWord'

// bytesAppendWord appends the width low bytes of a word to a byte array, the most significant first where bigEndian.
function bytesAppendWord(array Count, word Count, width Count, bigEndian bool)
	for i in 0 upto width 'bytes'
		bytesInsert(array, index: collectionLength(array), value: orderedWordByte(word as HashWord, index: i, width: width, bigEndian: bigEndian))
	end 'bytes'
end 'bytesAppendWord'
