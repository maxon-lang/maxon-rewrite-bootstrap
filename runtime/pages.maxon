		return
	end 'early'
	lockPages(pages)
	scavengeIfDue(pages, now: now)
	unlockPages(pages)
end 'pagesTick'

// pagesClock is the monotonic clock in nanoseconds, read under the lock with no allocation, since a free into the page
// heap may come from the heap's own paths: on Linux through the timespec in the page heap's header.
function pagesClock(pages Count) returns Count
	#if os(Linux)
		return clockNanosInto(__Raw.wrappingAdd(pages, right: pagesClockOffset))
	#else
		return osClockNanos()
	#endif
end 'pagesClock'

function lockPages(pages Count)
	spinLock(pages, offset: pagesLockOffset)
end 'lockPages'

function unlockPages(pages Count)
	spinUnlock(pages, offset: pagesLockOffset)
end 'unlockPages'

// newArena reserves an arena that has a free run of count pages after its header, arenaPages or a multiple of it, commits
// its header and marks every other page free and released.
function newArena(count Count) returns Count
