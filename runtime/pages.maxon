	var page = first
	while not bitAt(arena, bitmap: bitmap, page: page) 'pages'
		page = __Raw.wrappingAdd(page, right: 1)
	end 'pages'
	return page
end 'firstBit'

// endBit is just past the last of count pages from first whose bit is set in one of an arena's bitmaps; one is.
function endBit(arena Count, bitmap Count, first Count, count Count) returns Count
	var page = __Raw.wrappingAdd(first, right: count)
	while not bitAt(arena, bitmap: bitmap, page: __Raw.wrappingSub(page, right: 1)) 'pages'
		page = __Raw.wrappingSub(page, right: 1)
	end 'pages'
	return page
end 'endBit'

// clearBitmap clears one of an arena's bitmaps.
function clearBitmap(arena Count, bitmap Count)
	let words = bitmapOf(arena, bitmap: bitmap)
	let bytes = __Raw.loadWord(arena, offset: arenaPagesOffset) shr bitsPerByteShift
	var at = 0 as Count
	while at < bytes 'words'
		__Raw.storeWord(words, offset: at, value: 0)
		at = __Raw.wrappingAdd(at, right: wordBytes)
	end 'words'
end 'clearBitmap'

// The system's part, Go's sysReserve, sysMap and sysUnused, on Windows; the Linux and macOS ones are in their files.
// reservePages reserves address space for a number of bytes, committing none of it; commitPages commits pages of it, which
// read zero until written; releasePagesToSystem gives the memory of committed pages back, which read zero when committed
// again.
#if os(Windows)
	// The Win32 values of VirtualAlloc and VirtualFree.
	let memReserve = 0x2000 as Count

	let memCommit = 0x1000 as Count

	let memDecommit = 0x4000 as Count

	let memRelease = 0x8000 as Count

	let pageReadWrite = 4 as Count

	let pageGuard = 0x100 as Count

	function reservePages(bytes Count) returns Count
		let block = __Raw.callImport4("VirtualAlloc", arg1: 0, arg2: bytes, arg3: memReserve, arg4: pageReadWrite)
		if block == 0 'refused'
			panic("out of memory: the system reserves no more address space")
		end 'refused'
		return block
	end 'reservePages'

	function commitPages(block Count, bytes Count)
		if __Raw.callImport4("VirtualAlloc", arg1: block, arg2: bytes, arg3: memCommit, arg4: pageReadWrite) == 0 'refused'
			panic("out of memory: the system commits no more pages")
		end 'refused'
	end 'commitPages'

	function releasePagesToSystem(block Count, bytes Count)
		if __Raw.callImport3("VirtualFree", arg1: block, arg2: bytes, arg3: memDecommit) == 0 'failed'
			panic("the page heap's pages cannot be given back to the system")
		end 'failed'
	end 'releasePagesToSystem'
#endif
