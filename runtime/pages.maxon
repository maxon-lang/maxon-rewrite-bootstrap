	let arena = arenaOf(pages, address: run)
	let at = __Raw.wrappingAdd(pageIndex(arena, address: run), right: count)
	let past = __Raw.wrappingAdd(at, right: more)
	if past > __Raw.loadWord(arena, offset: arenaPagesOffset) or countBits(arena, bitmap: bitmapUsed, first: at, count: more) != 0 'taken'
