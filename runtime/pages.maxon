	let now = pagesClock(pages)
	let arena = arenaOf(pages, address: run)
	let first = pageIndex(arena, address: run)
	setBits(arena, bitmap: bitmapUsed, first: first, count: count, value: false)
	setBits(arena, bitmap: bitmapRecent, first: first, count: count, value: true)
	addPagesWord(pages, offset: pagesInUseOffset, change: __Raw.wrappingSub(0, right: count))
	addPagesWord(pages, offset: pagesRetainedOffset, change: count)
	if first < __Raw.loadWord(arena, offset: arenaHintOffset) 'lower'
		__Raw.storeWord(arena, offset: arenaHintOffset, value: first)
	end 'lower'
	scavengeIfDue(pages, now: now)
	unlockPages(pages)
end 'pageFree'

// pageExtend grows a run of count pages by more pages in place, when the pages after it are free, zeroing the bytes of the
// added pages from zeroFrom to zeroTo, offsets in the run, that were written; it says whether it grew the run.
