		return false
	end 'taken'
	let first = pageIndex(arena, address: run)
	var from = runBytes(count)
	if zeroFrom > from 'later'
		from = zeroFrom
	end 'later'
	let zeroStart = dirtyStart(arena, first: first, from: from, to: zeroTo)
	let zeroEnd = dirtyEnd(arena, first: first, from: from, to: zeroTo)
	takeRun(pages, arena: arena, first: at, count: more)
	unlockPages(pages)
	zeroRange(run, from: zeroStart, to: zeroEnd)
	return true
end 'pageExtend'

// newPageHeap is the page heap of the process, its first arena, which holds the page heap's own words in its header.
function newPageHeap() returns Count
	return newArena(0)
end 'newPageHeap'

// pagesTick is the monitor's part of the page heap: a release pass when one is due, read first without the lock, since a
// round that finds none due is the common one.
function pagesTick(pages Count, now Count)
