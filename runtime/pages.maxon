		first = findRun(arena, count: count)
	end 'arenas'
	let zeroStart = dirtyStart(arena, first: first, from: zeroFrom, to: zeroTo)
	let zeroEnd = dirtyEnd(arena, first: first, from: zeroFrom, to: zeroTo)
	takeRun(pages, arena: arena, first: first, count: count)
	unlockPages(pages)
	let run = pageAddress(arena, page: first)
	zeroRange(run, from: zeroStart, to: zeroEnd)
	return run
