// The Linux part of green threads and the scheduler, by system calls: a green thread's stack, the clock and the
// monitor's sleep through the thread's block, the thread id the monitor signals, the preemption signal's action and its
// handler's code, and the event queue, epoll with an eventfd that breaks its wait and an eventfd for each user event's event
// entry.

#if os(Linux)
	// stackGuardBytes is the guard page at the bottom of a stack's reserve.
	let stackGuardBytes = linuxPageBytes

	// eventWaitForeverMillis is epoll_wait's timeout of a wait with no end, -1.
	let eventWaitForeverMillis = 0xFFFFFFFFFFFFFFFF as Count

	// eventfdWordBytes is what a read or a write of an eventfd moves, its 64-bit count.
	let eventfdWordBytes = 8 as Count

	let noRemaining = 0 as Count

	let microsPerSecond = 1000000 as Count

	// noSignalMask is the mask of a wait that leaves the thread's signals as they are.
	let noSignalMask = 0 as Count

	// newStack maps a stack whose pages the kernel commits as they are touched, its lowest page the guard, as a worker
	// thread's (startThread).
	function newStack() returns Count
		let low = __Raw.syscall6(linuxSysMmap, arg1: 0, arg2: stackReserveBytes, arg3: linuxProtReadWrite, arg4: linuxMapAnonPrivate or linuxMapNoReserve, arg5: noFd, arg6: noMappingOffset)
		if failed(low) 'unmapped'
			panic("out of memory: no address space for a green thread's stack")
		end 'unmapped'
		if failed(__Raw.syscall3(linuxSysMprotect, arg1: low, arg2: stackGuardBytes, arg3: linuxProtNone)) 'unguarded'
			panic("cannot guard a green thread's stack")
		end 'unguarded'
		return stackRecord(low, high: __Raw.wrappingAdd(low, right: stackReserveBytes), limit: low)
	end 'newStack'

	// releaseStack unmaps a stack's reserve, its record with it.
	function releaseStack(stack Count)
		if failed(__Raw.syscall2(linuxSysMunmap, arg1: __Raw.loadWord(stack, offset: pooledStackLowOffset), arg2: stackReserveBytes)) 'failed'
			panic("a green thread's stack cannot be given back to the system")
		end 'failed'
	end 'releaseStack'

	// stackGrew is false: the kernel commits a stack's pages as they are touched and does not say how many were, so a
	// pooled stack keeps what its green threads touched, and only the cap on the pools bounds it.
	function stackGrew(stack Count) returns bool
		return false
	end 'stackGrew'

	// nanotime is the monotonic clock in nanoseconds, read into the thread's block, so it allocates nothing.
	function nanotime(context Count) returns Count
		return clockNanosInto(__Raw.wrappingAdd(threadBlockSwitch(context), right: threadBlockClockOffset))
	end 'nanotime'

	// sleepMicros sleeps the monitor for a number of microseconds, through the timespec of its block; a signal that ends the
	// sleep early only shortens the round.
	function sleepMicros(context Count, micros Count)
		let time = __Raw.wrappingAdd(threadBlockSwitch(context), right: threadBlockClockOffset)
		__Raw.storeWord(time, offset: 0, value: micros / microsPerSecond)
		__Raw.storeWord(time, offset: wordBytes, value: try (micros mod microsPerSecond) * nanosPerMicro otherwise panic("a sleep past a word of nanoseconds"))
		_ = __Raw.syscall2(linuxSysNanosleep, arg1: time, arg2: noRemaining)
	end 'sleepMicros'

	// setThreadIdentity keeps what the monitor signals the running thread by, its thread id, and lets the signal through,
	// as Go's minitSignalMask does: a thread starts with its creator's mask, and the main thread with the one its process
	// was started with, either of which may block the signal. Under qemu-user, which runs arm64-linux under WSL, a thread
	// made while the emulator held its creator's signals blocked to take one starts with every signal blocked, and only a
	// mask the thread sets itself undoes that; a thread that never took the signal would never be stopped, and would keep
	// its processor and what waits in its run queue for as long as its green thread runs.
	function setThreadIdentity(context Count)
		__Raw.storeWord(context, offset: contextThreadOffset, value: __Raw.syscall0(linuxSysGettid))
		var preemption = (1 as Count) shl (linuxSigurg - 1)
		if failed(__Raw.syscall4(linuxSysRtSigprocmask, arg1: linuxSigUnblock, arg2: __Raw.addressOf(preemption), arg3: 0, arg4: linuxSignalMaskBytes)) 'refused'
			panic("cannot let the preemption signal through to a thread")
		end 'refused'
	end 'setThreadIdentity'

	// initPreemption makes rt.preemptHandler the action of the preemption signal for every thread, on the thread's signal
	// stack, with the system calls it breaks off made again where the kernel can.
	function initPreemption()
		let action = alloc(linuxSigactionBytes)
		__Raw.storeWord(action, offset: linuxSigactionHandlerOffset, value: __Raw.preemptHandlerAddress())
		__Raw.storeWord(action, offset: linuxSigactionFlagsOffset, value: linuxPreemptActionFlags)
		__Raw.storeWord(action, offset: linuxSigactionRestorerOffset, value: __Raw.signalReturnAddress())
		if failed(__Raw.syscall4(linuxSysRtSigaction, arg1: linuxSigurg, arg2: action, arg3: 0, arg4: linuxSignalMaskBytes)) 'refused'
			panic("cannot set the preemption signal's action")
		end 'refused'
		free(action)
	end 'initPreemption'

	// preemptThread stops a thread on Linux: it sends it the preemption signal, unless one is not yet answered, as Go's
	// preemptM does.
	function preemptThread(scheduler Count, context Count, g Count)
		if __Raw.compareExchange(context, offset: contextSignalPendingOffset, expected: unset, desired: set) != unset 'pending'
			return
		end 'pending'
		countMonitorWord(scheduler, offset: schedPreemptStopsOffset)
		_ = __Raw.syscall3(linuxSysTgkill, arg1: __Raw.syscall0(linuxSysGetpid), arg2: __Raw.loadWord(context, offset: contextThreadOffset), arg3: linuxSigurg)
	end 'preemptThread'

	// preemptSignal is the code the preemption signal's handler calls (contextSignalCodeOffset) with the signal's context,
	// on the thread's signal stack: Go's doSigPreempt, which makes the stopped code return into rt.asyncPreempt when it may
	// be stopped there, and answers the signal.
	function preemptSignal(signalContext Count)
		let context = __Raw.threadContext()
		let rip = __Raw.loadWord(signalContext, offset: linuxUcontextPcOffset)
		let rsp = __Raw.loadWord(signalContext, offset: linuxUcontextSpOffset)
		let g = __Raw.loadWord(context, offset: contextGreenOffset)
		if stoppable(context, g: g, instruction: rip, stackPointer: rsp) 'stop'
			// x64's rt.asyncPreempt returns through the word below the stack pointer, which the stop moves to it; arm64's,
			// which keeps that word below the stack pointer it was stopped at, branches through it.
			#if arch(arm64)
				_ = resumeAt(g, instruction: rip, stackPointer: rsp)
			#else
				__Raw.storeWord(signalContext, offset: linuxUcontextSpOffset, value: resumeAt(g, instruction: rip, stackPointer: rsp))
			#endif
			__Raw.storeWord(signalContext, offset: linuxUcontextPcOffset, value: __Raw.asyncPreemptAddress())
		end 'stop'
		_ = __Raw.atomicExchange(context, offset: contextSignalPendingOffset, value: unset)
	end 'preemptSignal'

	// The calls that tests/runtime's programs stop a thread and sleep through, which name the thread's signal and its
	// context as the runtime's preemption does on every system that signals: signalThread sends the preemption signal to
	// the thread of an id, signalPcAddress and signalSpAddress are where a signal's context holds the stopped code's
	// program counter and stack pointer, and sysNanosleep sleeps for a timespec and gives 0, or -errno with what is left
	// of the sleep in the timespec at remaining.
	function signalThread(thread Count)
		_ = __Raw.syscall3(linuxSysTgkill, arg1: __Raw.syscall0(linuxSysGetpid), arg2: thread, arg3: linuxSigurg)
	end 'signalThread'

	function signalPcAddress(signalContext Count) returns Count
		return __Raw.wrappingAdd(signalContext, right: linuxUcontextPcOffset)
	end 'signalPcAddress'

	function signalSpAddress(signalContext Count) returns Count
		return __Raw.wrappingAdd(signalContext, right: linuxUcontextSpOffset)
	end 'signalSpAddress'

	function sysNanosleep(time Count, remaining Count) returns Count
		return __Raw.syscall2(linuxSysNanosleep, arg1: time, arg2: remaining)
	end 'sysNanosleep'

	// initEventQueue makes the epoll fd and the eventfd that breaks its wait.
	function initEventQueue(scheduler Count)
		let eventQueue = __Raw.syscall1(linuxSysEpollCreate1, arg1: linuxEpollCloexec)
		if failed(eventQueue) 'eventQueue'
			panic("cannot make the event queue")
		end 'eventQueue'
		__Raw.storeWord(scheduler, offset: schedEventQueueOffset, value: eventQueue)
		let breaker = newEventfd()
		__Raw.storeWord(scheduler, offset: schedEventBreakOffset, value: breaker)
		registerEventfd(scheduler, fd: breaker, key: eventBreakKey)
	end 'initEventQueue'

	function newEventfd() returns Count
		let fd = __Raw.syscall2(linuxSysEventfd2, arg1: 0, arg2: linuxEventfdFlags)
		if failed(fd) 'refused'
			panic("cannot make an eventfd")
		end 'refused'
		return fd
	end 'newEventfd'

	// register has the event queue report an fd with a key, for events of a mask, through an event in the running thread's
	// block, and says whether it took the fd.
	function register(scheduler Count, fd Count, key Count, events Count) returns bool
		let event = __Raw.wrappingAdd(threadBlockSwitch(__Raw.threadContext()), right: threadBlockClockOffset)
		__Raw.storeWord32(event, offset: 0, value: events)
		__Raw.storeWord(event, offset: linuxEpollEventDataOffset, value: key)
		return not failed(__Raw.syscall4(linuxSysEpollCtl, arg1: __Raw.loadWord(scheduler, offset: schedEventQueueOffset), arg2: linuxEpollCtlAdd, arg3: fd, arg4: event))
	end 'register'

	// registerEventfd has the event queue report an eventfd of its own readable with a key, for as long as it is readable.
	function registerEventfd(scheduler Count, fd Count, key Count)
		if not register(scheduler, fd: fd, key: key, events: linuxEpollIn) 'refused'
			panic("cannot register an eventfd with the event queue")
		end 'refused'
	end 'registerEventfd'

	// takeEvents takes what is ready, waiting up to delay nanoseconds for something when nothing is, into the thread's block,
	// and gives the list of the green threads it readied. A user event's eventfd that was readable is read, so it is not
	// reported again; a handle's event readies a wait to read, to write, or both, an error or a hang-up both.
	function takeEvents(context Count, delay Count) returns Count
		let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
		let events = __Raw.wrappingAdd(threadBlockSwitch(context), right: threadBlockEventsOffset)
		#if arch(arm64)
			let got = __Raw.syscall6(linuxSysEpollPwait, arg1: __Raw.loadWord(scheduler, offset: schedEventQueueOffset), arg2: events, arg3: eventSlots, arg4: eventWaitMillis(delay, forever: eventWaitForeverMillis), arg5: noSignalMask, arg6: linuxSignalMaskBytes)
		#else
			let got = __Raw.syscall4(linuxSysEpollWait, arg1: __Raw.loadWord(scheduler, offset: schedEventQueueOffset), arg2: events, arg3: eventSlots, arg4: eventWaitMillis(delay, forever: eventWaitForeverMillis))
		#endif
		if failed(got) 'failed'
			if errnoOf(got) == linuxEintr 'interrupted'
				return noGreen
			end 'interrupted'
			panic("the event queue's wait failed")
		end 'failed'
		var list = noGreen
		var event = events
		for i in 0 upto got 'events'
			let key = __Raw.loadWord(event, offset: linuxEpollEventDataOffset)
			if key == eventBreakKey 'break'
				drainEventfd(context, fd: __Raw.loadWord(scheduler, offset: schedEventBreakOffset))
				tookBreak(scheduler, delay: delay)
			end 'break' else 'entry'
				let kind = __Raw.loadAcquire(key, offset: entryKindOffset)
				if kind == entryKindUser 'user'
					drainEventfd(context, fd: __Raw.loadWord(key, offset: entryHandleOffset))
					list = eventQueuedInto(key, mode: eventRead, list: list)
				end 'user' else if kind == entryKindHandle 'handle'
					let mask = __Raw.loadWord32(event, offset: 0)
					if (mask and (linuxEpollIn or linuxEpollRdhup or linuxEpollHup or linuxEpollErr)) != 0 'readable'
						list = eventQueuedInto(key, mode: eventRead, list: list)
					end 'readable'
					if (mask and (linuxEpollOut or linuxEpollHup or linuxEpollErr)) != 0 'writable'
						list = eventQueuedInto(key, mode: eventWrite, list: list)
					end 'writable'
				end 'handle'
			end 'entry'
			event = __Raw.wrappingAdd(event, right: linuxEpollEventBytes)
		end 'events'
		return list
	end 'takeEvents'

	// drainEventfd reads an eventfd's count to 0, into the thread's block.
	function drainEventfd(context Count, fd Count)
		_ = __Raw.syscall3(linuxSysRead, arg1: fd, arg2: __Raw.wrappingAdd(threadBlockSwitch(context), right: threadBlockClockOffset), arg3: eventfdWordBytes)
	end 'drainEventfd'

	// signalEventfd adds 1 to an eventfd's count, which makes it readable.
	function signalEventfd(fd Count)
		var one = 1 as Count
		_ = __Raw.syscall3(linuxSysWrite, arg1: fd, arg2: __Raw.addressOf(one), arg3: eventfdWordBytes)
	end 'signalEventfd'

	// sendBreak breaks the wait of the thread in the event queue.
	function sendBreak(scheduler Count)
		signalEventfd(__Raw.loadWord(scheduler, offset: schedEventBreakOffset))
	end 'sendBreak'

	// entryRegister has the event queue report a handle's fd edge-triggered, as it becomes readable or writable or hangs up; the
	// kernel refuses an fd that cannot be waited on, such as a regular file's.
	function entryRegister(scheduler Count, entry Count) returns bool
		return register(scheduler, fd: __Raw.loadWord(entry, offset: entryHandleOffset), key: entry, events: linuxEpollIn or linuxEpollOut or linuxEpollRdhup or linuxEpollEt)
	end 'entryRegister'

	// entryUnregister takes a handle's fd off the event queue, which its close does too unless it was duplicated.
	function entryUnregister(scheduler Count, entry Count)
		_ = __Raw.syscall4(linuxSysEpollCtl, arg1: __Raw.loadWord(scheduler, offset: schedEventQueueOffset), arg2: linuxEpollCtlDel, arg3: __Raw.loadWord(entry, offset: entryHandleOffset), arg4: 0)
	end 'entryUnregister'

	// entryUserNew gives a user event's entry an eventfd of its own, registered with the event queue, which entryUserFree
	// closes.
	function entryUserNew(scheduler Count, entry Count)
		let fd = newEventfd()
		__Raw.storeWord(entry, offset: entryHandleOffset, value: fd)
		registerEventfd(scheduler, fd: fd, key: entry)
	end 'entryUserNew'

	function entryUserFree(scheduler Count, entry Count)
		closeFd(__Raw.loadWord(entry, offset: entryHandleOffset))
	end 'entryUserFree'

	// eventSignal signals a user event's entry through its eventfd, from any thread.
	function eventSignal(entry Count)
		signalEventfd(__Raw.loadWord(entry, offset: entryHandleOffset))
	end 'eventSignal'

	// processWatch opens the pidfd of a process, which the kernel makes readable once the process has ended, and registers it
	// as a handle; the pid names a child that has not been waited for, so no other process has its number. Without the system
	// call the program stops: a wait that polled instead would be a different wait.
	function processWatch(scheduler Count, process Count) returns Count
		let pidfd = __Raw.syscall2(linuxSysPidfdOpen, arg1: process, arg2: 0)
		if failed(pidfd) 'refused'
			if errnoOf(pidfd) == linuxEnosys 'missing'
				panic("waiting for a child process needs pidfd_open, which Linux 5.3 and later has")
			end 'missing'
			return noEntry
		end 'refused'
		let entry = eventRegister(pidfd)
		if entry == noEntry 'unregistered'
			closeFd(pidfd)
		end 'unregistered'
		return entry
	end 'processWatch'

	// processWatchClose closes the pidfd of a process's entry.
	function processWatchClose(pidfd Count)
		closeFd(pidfd)
	end 'processWatchClose'
#endif
