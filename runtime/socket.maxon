	// The readiness of a socket (eventqueue.maxon, "Readiness as a message") comes with Windows's sockets: no record is ever
	// armed on one, so a posted record's start finds no socket, and the end of a service none to give back.
	function socketNotify(socket Count, mode Count, record Count)
		panic("sockets are not written for x64-windows yet (concurrency plan step 2, Windows half)")
	end 'socketNotify'

	function socketTryRead(socket Count, buffer Count, most Count, errorAddress Count) returns Count
		panic("sockets are not written for x64-windows yet (concurrency plan step 2, Windows half)")
	end 'socketTryRead'

	function socketTrySend(socket Count, buffer Count, at Count, count Count, errorAddress Count) returns Count
		panic("sockets are not written for x64-windows yet (concurrency plan step 2, Windows half)")
	end 'socketTrySend'

	function socketTryAccept(socket Count, errorAddress Count) returns Count
		panic("sockets are not written for x64-windows yet (concurrency plan step 2, Windows half)")
	end 'socketTryAccept'

	function postedSocketStarts(record Count) returns bool
		return false
	end 'postedSocketStarts'

	function postedSocketDisarmed(record Count)
		return
	end 'postedSocketDisarmed'
#endif

#if os(Linux) or os(Windows)
	// socketResolve is macOS's alone: the library resolves a name on Linux itself (stdlib/net/resolver.maxon), and Windows has
	// no sockets yet.
	function socketResolve(host Count, errorAddress Count) returns Count
		panic("the runtime resolves a host's name on macOS alone")
	end 'socketResolve'
#endif

#if os(macOS)
	// eaiNoError is what getaddrinfo gives when it found the name.
	let eaiNoError = 0 as Count

	// socketResolve is the IPv4 address that the system's resolver gives first for a host's name, the bytes of a byte array,
	// as a word whose low 32 bits are its bytes, the first the most significant; or 0 with the error word set to resolveFailed.
	// getaddrinfo may wait on the network, so it is called in the blocking bracket, as Go's darwin resolver asks libSystem.
	function socketResolve(host Count, errorAddress Count) returns Count
		let name = cStringOfBytes(collectionData(host), length: collectionLength(host))
		let hints = alloc(addrinfoBytes)
		zeroRange(hints, from: 0, to: addrinfoBytes)
		__Raw.storeWord32(hints, offset: addrinfoFamilyOffset, value: afInet)
		__Raw.storeWord32(hints, offset: addrinfoSocktypeOffset, value: sockStream)
		var found = 0 as Count
		enterBlocking()
		let status = resolveCall(name, hints: hints, found: __Raw.addressOf(found))
		exitBlocking()
		free(hints)
		free(name)
		if status != eaiNoError or found == 0 'unresolved'
			failWith(errorAddress, errorCase: socketResolveFailed)
			return 0
		end 'unresolved'
		let sockaddr = __Raw.loadWord(found, offset: addrinfoAddrOffset)
		var address = 0 as Count
		for i in 0 upto ipv4AddressBytes 'bytes'
			address = ((address and 0xFFFFFF) shl 8) or (__Raw.loadByte(sockaddr, offset: __Raw.wrappingAdd(sockaddrIn4AddressOffset, right: i)) as Count)
		end 'bytes'
		resolveFree(found)
		succeed(errorAddress)
		return address
	end 'socketResolve'
#endif
