// The poller, Go's netpoll: one per process, an I/O completion port on Windows (GetQueuedCompletionStatusEx), epoll
// with an eventfd to break its wait on Linux (linux_green.maxon) and a kqueue with a user event on macOS
// (macos_green.maxon). At most one thread waits in it at a time, the one that took schedLastPollOffset to 0, until the
// earliest timer; others poll it without waiting. A completion's key names what it completes: the break of a wait, or a
// poll descriptor, which readies the green thread that waits on it.
//
// A poll descriptor (Go's pollDesc) is what a green thread waits on, a word of state for each way it is waited on (its
// mode: pollRead or pollWrite, the offset of the state word). It is one of two kinds:
//
// - A handle's (pollOpen), an fd or a HANDLE registered with the poller once, for good, until pollClose: on Linux and
//   macOS edge-triggered for both modes (EPOLLET, EV_CLEAR), so a wait's return says the handle may be ready and the
//   caller makes its call again, waiting again on EAGAIN; on Windows each operation is overlapped, through the
//   descriptor's OVERLAPPED of its mode (pollOverlapped), and a wait follows an operation that is pending: its return
//   says the operation completed, its OVERLAPPED holding the status and the count. An operation that completes at once
//   posts no completion (FILE_SKIP_COMPLETION_PORT_ON_SUCCESS) and is not waited for. A handle the poller refuses, such
//   as a regular file on Linux, has no descriptor (noDescriptor), and its caller makes its calls blocking.
// - A user event's (pollNew), which pollSignal signals from any thread, as a completion of the system's reaches a green
//   thread: a packet posted to the port, an eventfd of its own, a user event of the kqueue. Its mode is pollRead.
//
// An event that comes while no green thread waits is kept in the state word (pollSignalled), and the next wait takes it
// at once. A wait (pollWait) ends with a status: pollReady, or, its wake claimed in the state word before an event's,
// pollExpired at its deadline (a timer of the scheduler's heap, so a wait allocates nothing), pollClosed once the
// descriptor is evicted (pollEvict, which pollClose does first), or pollCancelled once its coroutine is cancelled (as
// its sleeps end). On Windows a wait that ends otherwise than by the completion cancels its operation and waits on for
// the completion, so no operation of a descriptor is pending once its wait has returned; one that completed before the
// cancel took hold makes the wait's status pollReady. A close waits until no wait is in progress, then takes the handle
// off the poller and gives the descriptor back: a descriptor is never given back to the system, so an event the poller
// took for one before it was given back finds a descriptor still, free or reused, and is at worst a wake whose call
// finds nothing. The caller starts no operation, and no wait, of a descriptor it is closing.

// netpollForever and netpollNoWait are the delays of a poll that waits until something comes and of one that does not wait.
let netpollForever = 0xFFFFFFFFFFFFFFFF as Count

let netpollNoWait = 0 as Count

// pollBreakKey is the key of a break of the poller's wait: no descriptor's address.
let pollBreakKey = 1 as Count

// noDescriptor is pollOpen's result for a handle that the poller refuses.
let noDescriptor = 0 as Count

// The modes of a wait, each the offset of its state word.
let pollRead = pollStateOffset

let pollWrite = pollWriteStateOffset

// A state word holds a green thread's address while it waits, or one of these, below any address: nobody, an event not
// yet taken, and what claimed the wake of a waiter.
let pollNobody = 0 as Count

let pollSignalled = 1 as Count

let pollClaimedByDeadline = 2 as Count

let pollClaimedByClose = 3 as Count

let pollClaimedByCancel = 4 as Count

// The statuses of a wait.
let pollReady = 0 as Count

let pollExpired = 1 as Count

let pollClosed = 2 as Count

let pollCancelled = 3 as Count

// pollNoDeadline is a wait's deadline when it has none.
let pollNoDeadline = 0 as Count

// A descriptor's kind (pollKindOffset).
let pollKindFree = 0 as Count

let pollKindUser = 1 as Count

let pollKindHandle = 2 as Count

let nanosPerMilli = 1000000 as Count

// pollOpen registers a handle with the poller and gives its poll descriptor, or noDescriptor when the poller refuses
// it.
function pollOpen(handle Count) returns Count
	let scheduler = schedulerOf(__Raw.threadContext())
	let descriptor = pollTake(scheduler, kind: pollKindHandle, handle: handle)
	if not pollRegister(scheduler, descriptor: descriptor) 'refused'
		pollGive(scheduler, descriptor: descriptor)
		return noDescriptor
	end 'refused'
	return descriptor
end 'pollOpen'

// pollClose evicts a handle's descriptor, waits until no wait on it is in progress, takes the handle off the poller and
// gives the descriptor back. The handle is the caller's to close after.
function pollClose(descriptor Count)
	pollEvict(descriptor)
	while __Raw.atomicAdd(descriptor, offset: pollWaitingOffset, value: 0) != 0 'waits'
		greenYield()
	end 'waits'
	let scheduler = schedulerOf(__Raw.threadContext())
	pollUnregister(scheduler, descriptor: descriptor)
	pollGive(scheduler, descriptor: descriptor)
end 'pollClose'

// pollEvict ends the waits on a descriptor with pollClosed, and every wait after it at once (Go's pollUnblock).
function pollEvict(descriptor Count)
	_ = __Raw.atomicExchange(descriptor, offset: pollClosingOffset, value: set)
	let context = __Raw.threadContext()
	claimWaiter(context, slot: __Raw.wrappingAdd(descriptor, right: pollRead), claim: pollClaimedByClose)
	claimWaiter(context, slot: __Raw.wrappingAdd(descriptor, right: pollWrite), claim: pollClaimedByClose)
end 'pollEvict'

// pollDeadline is the deadline of a wait a number of nanoseconds from now.
function pollDeadline(nanoseconds Count) returns Count
	return try nanotime(__Raw.threadContext()) + nanoseconds otherwise panic("a deadline past the end of the clock")
end 'pollDeadline'

// pollNew is a user event's poll descriptor, which pollFree gives back.
function pollNew() returns Count
	let scheduler = schedulerOf(__Raw.threadContext())
	let descriptor = pollTake(scheduler, kind: pollKindUser, handle: 0)
	pollUserNew(scheduler, descriptor: descriptor)
	return descriptor
end 'pollNew'

function pollFree(descriptor Count)
	let scheduler = schedulerOf(__Raw.threadContext())
	pollUserFree(scheduler, descriptor: descriptor)
	pollGive(scheduler, descriptor: descriptor)
end 'pollFree'

// pollWait parks the running green thread until an event of a mode of the descriptor, its deadline (pollNoDeadline for
// none), its eviction or its coroutine's cancel, and gives which.
function pollWait(descriptor Count, mode Count, deadline Count) returns Count
	let context = __Raw.threadContext()
	let g = greenCurrent()
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	_ = __Raw.atomicAdd(descriptor, offset: pollWaitingOffset, value: 1)
	_ = __Raw.atomicAdd(scheduler, offset: schedPollWaitersOffset, value: 1)
	var status = pollWaitOnce(scheduler, g: g, descriptor: descriptor, mode: mode, deadline: deadline, ending: true)
	#if os(Windows)
		if status != pollReady and __Raw.loadWord(descriptor, offset: pollKindOffset) == pollKindHandle 'pending'
			status = cancelPending(scheduler, g: g, descriptor: descriptor, mode: mode, status: status)
		end 'pending'
	#endif
	_ = __Raw.atomicAdd(scheduler, offset: schedPollWaitersOffset, value: stepDown)
	_ = __Raw.atomicAdd(descriptor, offset: pollWaitingOffset, value: stepDown)
	return status
end 'pollWait'

// pollWaitOnce is one wait of pollWait: an event already kept is taken at once; otherwise the green thread is the state
// word's, with a timer for its deadline, until an event readies it or a claim of its wake does. Where ending, an
// eviction and a cancel end it too, as they do before it parks; the wait for a cancelled operation's completion is not
// ended so.
function pollWaitOnce(scheduler Count, g Count, descriptor Count, mode Count, deadline Count, ending bool) returns Count
	let context = __Raw.threadContext()
	if ending 'early'
		if __Raw.loadAcquire(descriptor, offset: pollClosingOffset) == set 'closing'
			return pollClosed
		end 'closing'
		if isCancelled(g) 'cancelled'
			return pollCancelled
		end 'cancelled'
	end 'early'
	if __Raw.compareExchange(descriptor, offset: mode, expected: pollSignalled, desired: pollNobody) == pollSignalled 'kept'
		return pollReady
	end 'kept'
	if deadline != pollNoDeadline and deadline <= nanotime(context) 'past'
		return pollExpired
	end 'past'
	_ = __Raw.atomicExchange(g, offset: greenPollOffset, value: __Raw.wrappingAdd(descriptor, right: mode))
	if deadline != pollNoDeadline 'timer'
		lockScheduler(scheduler)
		__Raw.storeWord(g, offset: greenWhenOffset, value: deadline)
		timerPush(scheduler, g: g)
		let earliest = __Raw.loadWord(scheduler, offset: schedTimerNextOffset) == deadline
		unlockScheduler(scheduler)
		if earliest 'earliest'
			wakePoller(scheduler, at: deadline)
		end 'earliest'
	end 'timer'
	if __Raw.compareExchange(descriptor, offset: mode, expected: pollNobody, desired: g) == pollNobody 'wait'
		// An eviction or a cancel that came before the state word was the green thread's found no waiter to ready, and is
		// seen now: the green thread claims its own wake, or parks for the ready of the claim that came first.
		if ending and (__Raw.loadAcquire(descriptor, offset: pollClosingOffset) == set or isCancelled(g)) 'late'
			if __Raw.compareExchange(descriptor, offset: mode, expected: g, desired: pollClaimedByClose) != g 'claimed'
				park(context)
			end 'claimed'
		end 'late' else 'park'
			park(context)
		end 'park'
		if __Raw.loadAcquire(descriptor, offset: mode) == g 'early'
			panic("a green thread that waits on a poll descriptor was readied before its wake")
		end 'early'
	end 'wait'
	if deadline != pollNoDeadline 'untimer'
		lockScheduler(scheduler)
		if __Raw.loadWord(g, offset: greenWhenOffset) != noTimer 'onHeap'
			timerRemove(scheduler, g: g)
			__Raw.storeWord(g, offset: greenWhenOffset, value: noTimer)
		end 'onHeap'
		__Raw.storeWord(g, offset: greenPollOffset, value: 0)
		unlockScheduler(scheduler)
	end 'untimer' else 'untimed'
		__Raw.storeRelease(g, offset: greenPollOffset, value: 0)
	end 'untimed'
	let state = __Raw.atomicExchange(descriptor, offset: mode, value: pollNobody)
	if ending and isCancelled(g) 'cancelledWait'
		return pollCancelled
	end 'cancelledWait'
	if state == pollClaimedByDeadline 'expired'
		return pollExpired
	end 'expired'
	if state == pollClaimedByClose 'closed'
		return pollClosed
	end 'closed'
	if state == pollClaimedByCancel 'cancelled'
		return pollCancelled
	end 'cancelled'
	return pollReady
end 'pollWaitOnce'

// claimPollWake is whether a timer that fell due may ready its green thread, under the scheduler's lock: a sleeper may,
// and a waiter on a poll descriptor may once the claim is in its state word, before an event's ready or another claim.
// Its state word's address is read plainly: a waiter with a deadline writes it before its timer is pushed and clears it
// after its timer is taken off, under the lock both times.
function claimPollWake(g Count, claim Count) returns bool
	let slot = __Raw.loadWord(g, offset: greenPollOffset)
	if slot == 0 'none'
		return true
	end 'none'
	return __Raw.compareExchange(slot, offset: 0, expected: g, desired: claim) == g
end 'claimPollWake'

// claimWaiter readies the green thread that waits in a state word, once the claim of its wake is in it.
function claimWaiter(context Count, slot Count, claim Count)
	let waiter = __Raw.atomicAdd(slot, offset: 0, value: 0)
	if waiter <= pollClaimedByCancel 'nobody'
		return
	end 'nobody'
	if __Raw.compareExchange(slot, offset: 0, expected: waiter, desired: claim) == waiter 'claimed'
		ready(context, g: waiter)
	end 'claimed'
end 'claimWaiter'

// cancelPollWait ends the wait of a cancelled coroutine on a poll descriptor, if it waits on one (asyncCancel).
function cancelPollWait(context Count, g Count)
	let slot = __Raw.atomicAdd(g, offset: greenPollOffset, value: 0)
	if slot == 0 'none'
		return
	end 'none'
	if __Raw.compareExchange(slot, offset: 0, expected: g, desired: pollClaimedByCancel) == g 'claimed'
		ready(context, g: g)
	end 'claimed'
end 'cancelPollWait'

// pollSignalledInto is what an event of a mode of a descriptor does: the state word is signalled, and the green thread
// that waits in it, when one does and it was parked, joins the list of what the poll readied, which it gives back. A
// descriptor given back has no waiter, and the event is kept for nobody, or for its next owner, whose call finds
// nothing.
function pollSignalledInto(descriptor Count, mode Count, list Count) returns Count
	let waiter = __Raw.atomicExchange(descriptor, offset: mode, value: pollSignalled)
	if waiter <= pollClaimedByCancel 'nobody'
		return list
	end 'nobody'
	if not markReady(waiter) 'running'
		return list
	end 'running'
	__Raw.storeWord(waiter, offset: greenLinkOffset, value: list)
	return waiter
end 'pollSignalledInto'

// pollTake is a descriptor of a kind from the free list, or a new one, carved for good.
function pollTake(scheduler Count, kind Count, handle Count) returns Count
	lockScheduler(scheduler)
	var descriptor = __Raw.loadWord(scheduler, offset: schedPollFreeOffset)
	if descriptor != noDescriptor 'reused'
		__Raw.storeWord(scheduler, offset: schedPollFreeOffset, value: __Raw.loadWord(descriptor, offset: pollLinkOffset))
	end 'reused'
	unlockScheduler(scheduler)
	if descriptor == noDescriptor 'carved'
		descriptor = carve(scheduler, bytes: pollDescriptorBytes)
	end 'carved'
	__Raw.storeWord(descriptor, offset: pollFdOffset, value: handle)
	__Raw.storeWord(descriptor, offset: pollClosingOffset, value: unset)
	__Raw.storeWord(descriptor, offset: pollWaitingOffset, value: 0)
	__Raw.storeWord(descriptor, offset: pollLinkOffset, value: noDescriptor)
	__Raw.storeRelease(descriptor, offset: pollKindOffset, value: kind)
	return descriptor
end 'pollTake'

// pollGive puts a descriptor on the free list. Its state words keep what came: a wait of its next owner may take an
// event of its last as a wake whose call finds nothing.
function pollGive(scheduler Count, descriptor Count)
	__Raw.storeRelease(descriptor, offset: pollKindOffset, value: pollKindFree)
	lockScheduler(scheduler)
	__Raw.storeWord(descriptor, offset: pollLinkOffset, value: __Raw.loadWord(scheduler, offset: schedPollFreeOffset))
	__Raw.storeWord(scheduler, offset: schedPollFreeOffset, value: descriptor)
	unlockScheduler(scheduler)
end 'pollGive'

// pollWaitMillis is a poll's delay in nanoseconds as the milliseconds the system waits, rounded up so that a timer is never
// woken for early, below the system's forever.
function pollWaitMillis(delay Count, forever Count) returns Count
	if delay == netpollForever 'forever'
		return forever
	end 'forever'
	let millis = __Raw.wrappingAdd(delay, right: nanosPerMilli - 1) / nanosPerMilli
	if millis >= forever 'long'
		return __Raw.wrappingSub(forever, right: 1)
	end 'long'
	return millis
end 'pollWaitMillis'

// netpollBreak ends the wait of the thread in the poller, once for any number of breaks before it takes one.
function netpollBreak(scheduler Count)
	if __Raw.compareExchange(scheduler, offset: schedPollWakeSigOffset, expected: unset, desired: set) != unset 'sent'
		return
	end 'sent'
	sendBreak(scheduler)
end 'netpollBreak'

// tookBreak is what a poll does with a break it took, as Go's netpoll does. A poll that waited had its wait broken, and the
// next break is sent again. One that did not wait may have taken it from the thread that waits in the poller, since a
// claim of schedLastPollOffset read before that thread's does not keep it from polling while that thread waits; it passes
// the break on, or that thread would wait out its old deadline past an earlier timer.
function tookBreak(scheduler Count, delay Count)
	if delay == netpollNoWait 'passOn'
		sendBreak(scheduler)
		return
	end 'passOn'
	__Raw.storeRelease(scheduler, offset: schedPollWakeSigOffset, value: unset)
end 'tookBreak'

#if os(Windows)
	// The Win32 values of the poller.
	let anyConcurrency = 0 as Count

	let waitTimeout = 258 as Count

	let notAlertable = 0 as Count

	// skipOnSuccess is FILE_SKIP_COMPLETION_PORT_ON_SUCCESS | FILE_SKIP_SET_EVENT_ON_HANDLE: an operation that completes
	// at once posts no completion, and sets no event of the handle.
	let skipOnSuccess = 3 as Count

	// statusCancelled is STATUS_CANCELLED, the status an OVERLAPPED holds of an operation that a cancel ended.
	let statusCancelled = 0xC0000120 as Count

	let overlappedBytes = 32 as Count

	// initPoller makes the completion port.
	function initPoller(scheduler Count)
		let port = __Raw.callImport4("CreateIoCompletionPort", arg1: invalidHandle, arg2: 0, arg3: 0, arg4: anyConcurrency)
		if port == 0 'failed'
			panic("cannot make the poller's completion port")
		end 'failed'
		__Raw.storeWord(scheduler, offset: schedPollerOffset, value: port)
	end 'initPoller'

	// netpoll takes what has completed, waiting up to delay nanoseconds for something when nothing has, into the thread's
	// block, and gives the list of the green threads it readied. A completion of a handle's operation names the OVERLAPPED
	// of its mode; a posted packet, a user event's, none.
	function netpoll(context Count, delay Count) returns Count
		let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
		let entries = __Raw.wrappingAdd(threadBlockSwitch(context), right: threadBlockEventsOffset)
		var got = 0 as Count
		let wait = pollWaitMillis(delay, forever: waitForever)
		if __Raw.callImport6("GetQueuedCompletionStatusEx", arg1: __Raw.loadWord(scheduler, offset: schedPollerOffset), arg2: entries, arg3: pollEventSlots, arg4: __Raw.addressOf(got), arg5: wait, arg6: notAlertable) == 0 'none'
			if dword(__Raw.callImport0("GetLastError")) == waitTimeout 'timedOut'
				return noGreen
			end 'timedOut'
			panic("the poller's wait failed")
		end 'none'
		var list = noGreen
		var entry = entries
		for i in 0 upto dword(got) 'entries'
			let key = __Raw.loadWord(entry, offset: windowsEntryKeyOffset)
			if key == pollBreakKey 'break'
				tookBreak(scheduler, delay: delay)
			end 'break' else if __Raw.loadWord(entry, offset: windowsEntryOverlappedOffset) == __Raw.wrappingAdd(key, right: pollWriteOverlappedOffset) 'write'
				list = pollSignalledInto(key, mode: pollWrite, list: list)
			end 'write' else 'read'
				list = pollSignalledInto(key, mode: pollRead, list: list)
			end 'read'
			entry = __Raw.wrappingAdd(entry, right: windowsEntryBytes)
		end 'entries'
		return list
	end 'netpoll'

	// sendBreak breaks the wait of the thread in the poller.
	function sendBreak(scheduler Count)
		postCompletion(scheduler, key: pollBreakKey)
	end 'sendBreak'

	function postCompletion(scheduler Count, key Count)
		if __Raw.callImport4("PostQueuedCompletionStatus", arg1: __Raw.loadWord(scheduler, offset: schedPollerOffset), arg2: 0, arg3: key, arg4: 0) == 0 'failed'
			panic("cannot post a completion to the poller")
		end 'failed'
	end 'postCompletion'

	// pollRegister associates a handle with the port, its completions keyed by its descriptor, an operation that completes
	// at once posting none; a handle that cannot be so is refused before it is associated, since a handle is associated
	// for as long as it is open.
	function pollRegister(scheduler Count, descriptor Count) returns bool
		let handle = __Raw.loadWord(descriptor, offset: pollFdOffset)
		if __Raw.callImport2("SetFileCompletionNotificationModes", arg1: handle, arg2: skipOnSuccess) == 0 'modes'
			return false
		end 'modes'
		return __Raw.callImport4("CreateIoCompletionPort", arg1: handle, arg2: __Raw.loadWord(scheduler, offset: schedPollerOffset), arg3: descriptor, arg4: anyConcurrency) != 0
	end 'pollRegister'

	// pollUnregister has nothing to do: a handle leaves the port when it is closed, and no operation of it is pending.
	function pollUnregister(scheduler Count, descriptor Count)
	end 'pollUnregister'

	// pollOverlapped is the OVERLAPPED of a mode of a handle's descriptor, cleared, for its next operation, which the
	// caller starts at a file's position by its Offset and OffsetHigh, and reads the status (Internal) and the count
	// (InternalHigh) of once it completed.
	function pollOverlapped(descriptor Count, mode Count) returns Count
		var overlapped = __Raw.wrappingAdd(descriptor, right: pollReadOverlappedOffset)
		if mode == pollWrite 'write'
			overlapped = __Raw.wrappingAdd(descriptor, right: pollWriteOverlappedOffset)
		end 'write'
		var offset = 0 as Count
		while offset < overlappedBytes 'clear'
			__Raw.storeWord(overlapped, offset: offset, value: 0)
			offset = __Raw.wrappingAdd(offset, right: wordBytes)
		end 'clear'
		return overlapped
	end 'pollOverlapped'

	// cancelPending is what a wait on a handle's operation that ended otherwise than by its completion does: it cancels
	// the operation and waits for its completion, which comes whether the cancel took hold or the operation had completed,
	// and gives the wait's status, pollReady when the operation completed all the same.
	function cancelPending(scheduler Count, g Count, descriptor Count, mode Count, status Count) returns Count
		var overlapped = __Raw.wrappingAdd(descriptor, right: pollReadOverlappedOffset)
		if mode == pollWrite 'write'
			overlapped = __Raw.wrappingAdd(descriptor, right: pollWriteOverlappedOffset)
		end 'write'
		_ = __Raw.callImport2("CancelIoEx", arg1: __Raw.loadWord(descriptor, offset: pollFdOffset), arg2: overlapped)
		var completed = pollWaitOnce(scheduler, g: g, descriptor: descriptor, mode: mode, deadline: pollNoDeadline, ending: false)
		while completed != pollReady 'completion'
			completed = pollWaitOnce(scheduler, g: g, descriptor: descriptor, mode: mode, deadline: pollNoDeadline, ending: false)
		end 'completion'
		if dword(__Raw.loadWord(overlapped, offset: 0)) == statusCancelled 'cancelled'
			return status
		end 'cancelled'
		return pollReady
	end 'cancelPending'

	// pollUserNew has nothing to make: a user event is a packet posted to the port, keyed by its descriptor.
	function pollUserNew(scheduler Count, descriptor Count)
	end 'pollUserNew'

	function pollUserFree(scheduler Count, descriptor Count)
	end 'pollUserFree'

	// pollSignal signals a user event's descriptor with a completion packet whose key is the descriptor, from any thread.
	function pollSignal(descriptor Count)
		postCompletion(__Raw.loadWord(__Raw.threadContext(), offset: contextSchedulerOffset), key: descriptor)
	end 'pollSignal'
#endif
