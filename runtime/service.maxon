		setSenderLink(newest, link: next)
		__Raw.storeRelease(svc, offset: serviceReleaseAtOffset, value: entryMark(next))
		unlockMuted(svc, newest: newest)
	end 'part'
	setSenderLink(last, link: noSender)
	unmuteFrom(oldest)
end 'takeProgress'

// unmuteRing unmutes the entries of a ring taken off its service, oldest first.
function unmuteRing(newest Count)
	if newest != noSender 'senders'
		let oldest = senderLink(newest)
		setSenderLink(newest, link: noSender)
		unmuteFrom(oldest)
	end 'senders'
end 'unmuteRing'

// unmuteFrom unmutes the entries of a list in order: a muted service's kept message and a parked task go to the global run
// queue, and a service still running is no longer listed. After a turn's worth, the last carries the rest, which it
// unmutes once it runs.
function unmuteFrom(first Count)
	let context = __Raw.threadContext()
	var entry = first
	var woken = 0 as Count
	while entry != noSender 'entries'
		let next = senderLink(entry)
		var queued = true
		if (entry and senderService) != 0 'service'
			let svc = __Raw.wrappingSub(entry, right: senderService)
			let kept = __Raw.compareExchange(svc, offset: serviceWaitOffset, expected: waitListed, desired: waitNone)
			if kept == waitListed 'running'
				queued = false
			end 'running' else 'muted'
				__Raw.storeWord(svc, offset: serviceWaitOffset, value: waitNone)
				clearGateFlag(svc, flag: serviceMuted)
				woken = __Raw.wrappingAdd(woken, right: 1)
				__Raw.storeWord(svc, offset: serviceLinkOffset, value: next if woken == turnBehaviours else noSender)
				onGlobalQueue(context, entry: behaviourEntry(kept))
			end 'muted'
		end 'service' else 'task'
			woken = __Raw.wrappingAdd(woken, right: 1)
			__Raw.storeWord(entry, offset: greenMuteOffset, value: next if woken == turnBehaviours else noSender)
			if markReady(entry) 'parked'
				onGlobalQueue(context, entry: entry)
			end 'parked'
		end 'task'
		if queued and woken == turnBehaviours 'batch'
			return
		end 'batch'
		entry = next
	end 'entries'
end 'unmuteFrom'

// onGlobalQueue puts a run queue's entry at the tail of the global run queue, which is FIFO, and wakes a thread for it. A
// kept behaviour is counted among the live ones already.
function onGlobalQueue(context Count, entry Count)
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	lockScheduler(scheduler)
	globalPut(scheduler, g: entry)
	unlockScheduler(scheduler)
	wakeProc(scheduler)
end 'onGlobalQueue'

// lockMuted takes the lock of a service's list of slowed senders and gives the ring's newest entry; only its holder
// changes the ring, and unlockMuted lets it go with the newest entry it leaves.
function lockMuted(svc Count) returns Count
	while true 'lock'
		let word = __Raw.loadAcquire(svc, offset: serviceMutedOffset)
		if (word and mutedLock) == 0 and __Raw.compareExchange(svc, offset: serviceMutedOffset, expected: word, desired: __Raw.wrappingAdd(word, right: mutedLock)) == word 'taken'
			return word
		end 'taken'
		__Raw.spinPause()
	end 'lock'
	return noSender
end 'lockMuted'

function unlockMuted(svc Count, newest Count)
	__Raw.storeRelease(svc, offset: serviceMutedOffset, value: newest)
end 'unlockMuted'

// ringAdd adds an entry after the newest of a ring, as the newest, and gives it.
function ringAdd(newest Count, entry Count) returns Count
	if newest == noSender 'first'
		setSenderLink(entry, link: entry)
		return entry
	end 'first'
	setSenderLink(entry, link: senderLink(newest))
	setSenderLink(newest, link: entry)
	return entry
end 'ringAdd'

function senderLink(entry Count) returns Count
	if (entry and senderService) != 0 'service'
		return __Raw.loadWord(__Raw.wrappingSub(entry, right: senderService), offset: serviceLinkOffset)
	end 'service'
	return __Raw.loadWord(entry, offset: greenLinkOffset)
end 'senderLink'

function setSenderLink(entry Count, link Count)
	if (entry and senderService) != 0 'service'
		__Raw.storeWord(__Raw.wrappingSub(entry, right: senderService), offset: serviceLinkOffset, value: link)
		return
	end 'service'
	__Raw.storeWord(entry, offset: greenLinkOffset, value: link)
end 'setSenderLink'

// setGateFlag and clearGateFlag set and clear a flag of a service's gate, beside the sends that step its count.
function setGateFlag(svc Count, flag Count)
	var gate = __Raw.loadAcquire(svc, offset: serviceGateOffset)
	while (gate and flag) == 0 'set'
		let seen = __Raw.compareExchange(svc, offset: serviceGateOffset, expected: gate, desired: __Raw.wrappingAdd(gate, right: flag))
		if seen == gate 'done'
			return
		end 'done'
		gate = seen
	end 'set'
end 'setGateFlag'

function clearGateFlag(svc Count, flag Count)
	var gate = __Raw.loadAcquire(svc, offset: serviceGateOffset)
	while (gate and flag) != 0 'clear'
		let seen = __Raw.compareExchange(svc, offset: serviceGateOffset, expected: gate, desired: __Raw.wrappingSub(gate, right: flag))
		if seen == gate 'done'
			return
		end 'done'
		gate = seen
	end 'clear'
end 'clearGateFlag'

// replyNew is the cell of a reply: a green thread's record that is awaited and never runs, so it holds no stack and does
// not count among the live green threads; the behaviour of the message is the one that counts.
function replyNew() returns Count
	return newGreen(__Raw.threadContext(), code: 0, kind: greenAwaited)
end 'replyNew'

// replyGive finishes a reply as greenMain and finished finish a coroutine: the value and the error first, then the
// exchange of the waiter, so the awaiter either is readied here or finds the cell finished.
function replyGive(promise Count, value Count, error Count)
	__Raw.storeWord(promise, offset: greenResultOffset, value: value)
	__Raw.storeWord(promise, offset: greenErrorOffset, value: error)
	wakeWaiter(__Raw.threadContext(), waiter: __Raw.atomicExchange(promise, offset: greenWaiterOffset, value: greenFinished))
end 'replyGive'

// A deferred reply, a Reply, is the cell of the reply its sender awaits, which `reply.later()` takes out of the behaviour of
// the message, or 0 where the sender dropped the reply: no allocation, and a Reply waiting in a service's state is a word of
// that state, never a green thread or a timer. Its answer gives the cell its value, and its drop, unanswered, fails the
// sender's await with replyStoppedError.

// replyStoppedError is the error word of ReplyStopped.serviceStopped, the first case of the library's enum, plus 1, which is
// its word in every error of the await of a deferring message's reply.
let replyStoppedError = 1 as Count

// replyDefer is the Reply of a message whose handler deferred its reply: its cell.
function replyDefer(promise Count) returns Count
	return promise
end 'replyDefer'

// replyHeld is whether a Reply holds the cell of a reply its sender awaits: the compiled code drops the value of the answer of
// one whose sender dropped the reply.
function replyHeld(reply Count) returns bool
	return reply != 0
end 'replyHeld'

// replyAnswer gives the reply a sender awaits the value of a Reply's answer.
function replyAnswer(reply Count, value Count)
	replyGive(reply, value: value, error: 0)
end 'replyAnswer'

// replyDrop is the drop of a Reply that no answer consumed: its sender's await fails with ReplyStopped.serviceStopped.
function replyDrop(reply Count)
	replyGive(reply, value: 0, error: replyStoppedError)
end 'replyDrop'

// stringBoxBytes are the bytes of the box a String crosses to the awaiter of a reply in, its two words.
let stringBoxBytes = 16 as Count

// replyDropString is replyDrop of a Reply whose value is a String: the await of a String takes the words out of the box its
// value is, also where the reply failed, so the failure gives a box of the empty String, whose words are 0.
function replyDropString(reply Count)
	let box = alloc(stringBoxBytes)
	__Raw.storeWord(box, offset: 0, value: 0)
	__Raw.storeWord(box, offset: 8, value: 0)
	replyGive(reply, value: box, error: replyStoppedError)
end 'replyDropString'
