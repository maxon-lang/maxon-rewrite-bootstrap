// Output and the ways a program ends early: writing to a standard handle, a panic, and the leak report of an executable
// built to count its allocations. A panic and a leak write a few strings and exit, allocating nothing but the count's
// digits, so they work when the heap is the thing that failed.

// panicExitCode is what a panic exits with.
let panicExitCode = 1 as Count

let panicPrefix = "panic: "

// panicAtPrefix and panicAtSeparator frame the location of a panic the program calls, as maxon's runtime writes it.
let panicAtPrefix = "panic at "

let panicAtSeparator = ": "

let panicEnd = "\n"

// indexOutOfRange is the panic of an array index past the end.
let indexOutOfRange = "index out of range"

// emptySlotPrefix and emptySlotSuffix are maxon's message of a lent read of an empty slot, around the slot's index.
let emptySlotPrefix = "empty slot: element "

let emptySlotSuffix = " of the array was never filled"

// leakExitCode is what an executable built to count its allocations exits with when main returned and a box is still
// live. It differs from every code a program or a trap gives.
let leakExitCode = 99 as Count

let leakMessage = "leaked allocations: "

let leakMessageEnd = "\n"

#if os(Windows)
	// noOverlapped is WriteFile's lpOverlapped for a handle that is written in order.
	let noOverlapped = 0 as Count

	// writeHandle writes a string to a handle, all of it in one WriteFile, which a console or a pipe takes whole.
	function writeHandle(handle Count, text String)
		var written = 0 as Count
		let length = __Raw.stringLength(text)
		let bytes = __Raw.stringBytes(text)
		_ = __Raw.callImport5("WriteFile", arg1: handle, arg2: bytes, arg3: length, arg4: __Raw.addressOf(written), arg5: noOverlapped)
	end 'writeHandle'
#endif

// write is the program's write to a handle, which a pipe or a console may block: a blocking call, whose thread's processor
// the monitor may hand to another thread meanwhile. A panic writes with writeHandle alone, since it may come from code that
// holds the scheduler's lock.
function write(handle Count, text String)
	enterBlocking()
	writeHandle(handle, text: text)
	exitBlocking()
end 'write'

// panicWith is what a panic runs: it writes the message to standard error and exits.
function panicWith(message String)
	let handle = standardError()
	writeHandle(handle, text: panicPrefix)
	writeHandle(handle, text: message)
	writeHandle(handle, text: panicEnd)
	exitProcess(panicExitCode)
end 'panicWith'

// panicAt is what the program's own panic runs: the message after the file and line of the call.
function panicAt(location String, message String)
	let handle = standardError()
	writeHandle(handle, text: panicAtPrefix)
	writeHandle(handle, text: location)
	writeHandle(handle, text: panicAtSeparator)
	writeHandle(handle, text: message)
	writeHandle(handle, text: panicEnd)
	exitProcess(panicExitCode)
end 'panicAt'

// panicEmptySlot is the panic of a lent read of an empty slot of an array: the code of each such read calls it, rather
// than format the message itself, since the read is common and its panic cold.
function panicEmptySlot(location String, index Count)
	let handle = standardError()
	writeHandle(handle, text: panicAtPrefix)
	writeHandle(handle, text: location)
	writeHandle(handle, text: panicAtSeparator)
	writeHandle(handle, text: emptySlotPrefix)
	writeHandle(handle, text: itoa(index, unsigned: true))
	writeHandle(handle, text: emptySlotSuffix)
	writeHandle(handle, text: panicEnd)
	exitProcess(panicExitCode)
end 'panicEmptySlot'

// The runtime's aborts, maxon's (its RuntimeAbort): each writes `fatal error: runtime abort N (name)` to standard error and
// exits with N.
let abortPrefix = "fatal error: runtime abort "

let abortNameStart = " ("

let abortNameEnd = ")\n"

// promiseSlotConsumedTwice is the abort of a promise read out of a slot of a container or a field that an earlier read
// emptied, which the compiler could not see was the same slot.
let promiseSlotConsumedTwice = 118 as Count

// A fatal error, maxon's RuntimeFatal: a program's misuse of the runtime that no handler can catch, which writes `fatal error:
// <reason>` to standard error and exits with fatalExitCode.
let fatalPrefix = "fatal error: "

let fatalEnd = "\n"

let fatalExitCode = 70 as Count

// runtimeFatal writes the fatal error of a reason and exits with fatalExitCode.
function runtimeFatal(reason String)
	let handle = standardError()
	writeHandle(handle, text: fatalPrefix)
	writeHandle(handle, text: reason)
	writeHandle(handle, text: fatalEnd)
	exitProcess(fatalExitCode)
end 'runtimeFatal'

// runtimeAbort writes the abort of a code and its name and exits with the code.
function runtimeAbort(code Count, name String)
	let handle = standardError()
	writeHandle(handle, text: abortPrefix)
	writeHandle(handle, text: itoa(code, unsigned: true))
	writeHandle(handle, text: abortNameStart)
	writeHandle(handle, text: name)
	writeHandle(handle, text: abortNameEnd)
	exitProcess(code)
end 'runtimeAbort'

// panicIndex is the panic of the array entries when an index is past the end.
function panicIndex()
	panicWith(indexOutOfRange)
end 'panicIndex'

// checkLeaks is the end of an executable that counts its allocations, after main and every behaviour: a box still live is a drop that the
// program lacks, so it says how many on standard error and exits with leakExitCode. Otherwise it gives back main's exit
// code. A panic and a trap exit without it, since they end the program with values still held. It counts once every other
// thread that runs green threads has parked for good (quiesceForCount).
function checkLeaks(code Count) returns Count
	quiesceForCount(__Raw.threadContext())
	let live = liveBoxes()
	if live == 0 'clean'
		return code
	end 'clean'
	let handle = standardError()
	writeHandle(handle, text: leakMessage)
	writeHandle(handle, text: itoa(live, unsigned: true))
	writeHandle(handle, text: leakMessageEnd)
	exitProcess(leakExitCode)
	return code
end 'checkLeaks'

function standardError() returns Count
	return __Raw.loadWord(__Raw.stderrAddress(), offset: 0)
end 'standardError'

#if os(Windows)
	// exitProcess ends the process with a code; it does not return. It takes the exit claim first, so that ExitProcess
	// never meets a thread the monitor has suspended.
	function exitProcess(code Count)
		takeExitClaim(__Raw.threadContext())
		_ = __Raw.callImport1("ExitProcess", arg1: code)
	end 'exitProcess'
#endif
