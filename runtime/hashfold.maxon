// The seeded hash of maxon's runtime, its software fold (maxon-bin/Compiler/Runtime/HashRuntime.maxon): what
// __Builtins.hashWord and hashBytes give, and the bytes of maxon's ordered words. These are the runtime's functions for
// the hash entries (hash.maxon) and also, copied by builtingen to self/interp/hashfold_gen.maxon, the interpreter's, so
// that one text says what a hash is. A span of bytes is read through a HashInput, which each module declares with hashLoadWord, hashLoadHalf and
// hashLoadByte: the runtime's is the address of the span's first byte, the interpreter's the bytes themselves.

// HashWord is a word of the fold, whose arithmetic wraps.
typealias HashWord = bits(64)

// The fold's four secrets, as maxon's runtime has them.
let hashFirstSecret = 0xa0761d6478bd642f as HashWord

let hashSecondSecret = 0xe7037ed1a0b428db as HashWord

let hashThirdSecret = 0x8ebc6af09c88c6e3 as HashWord

let hashFourthSecret = 0x589965cc75374cc3 as HashWord

let hashHalfBits = 32 as HashWord

let hashHalfMask = 0xFFFFFFFF as HashWord

let hashSecondByteShift = 8 as HashWord

let hashThirdByteShift = 16 as HashWord

let hashBitsPerByte = 8 as HashWord

// The spans the fold reads a span in: a word, half of one, a pair of words, and a stride of three pairs.
let hashWordBytes = 8 as Count

let hashHalfWordBytes = 4 as Count

let hashPairBytes = 16 as Count

let hashStrideBytes = 48 as Count

let hashStrideSecondOffset = 16 as Count

let hashStrideThirdOffset = 32 as Count

// hashMulHigh is the high word of the 128-bit product of two words, made of the products of their halves.
function hashMulHigh(left HashWord, right HashWord) returns HashWord
	let leftLow = left and hashHalfMask
	let leftHigh = left shr hashHalfBits
	let rightLow = right and hashHalfMask
	let rightHigh = right shr hashHalfBits
	let crossLeft = leftHigh * rightLow
	let crossRight = leftLow * rightHigh
	let middle = ((leftLow * rightLow) shr hashHalfBits) + (crossLeft and hashHalfMask) + (crossRight and hashHalfMask)
	return (leftHigh * rightHigh) + (crossLeft shr hashHalfBits) + (crossRight shr hashHalfBits) + (middle shr hashHalfBits)
end 'hashMulHigh'

// hashFold folds two words into one: both halves of their product, and the words themselves.
function hashFold(left HashWord, right HashWord) returns HashWord
	return (left * right) xor hashMulHigh(left, right: right) xor left xor right
end 'hashFold'

// hashKeyedState is the state a fold under a seed starts from.
function hashKeyedState(seed HashWord) returns HashWord
	return seed xor hashFirstSecret
end 'hashKeyedState'

// hashFinish ends a fold: the last two words read, the state, and the count of bytes read.
function hashFinish(low HashWord, high HashWord, state HashWord, count HashWord) returns HashWord
	let first = low xor hashSecondSecret
	let second = high xor state
	let lowKept = (first * second) xor first
	let highKept = hashMulHigh(first, right: second) xor second
	return hashFold(lowKept xor hashFirstSecret xor count, right: highKept xor hashSecondSecret)
end 'hashFinish'

// hashWordFold is the fold of a word's 8 bytes under a seed.
function hashWordFold(word HashWord, seed HashWord) returns HashWord
	return hashFinish(word, high: word, state: hashKeyedState(seed), count: hashWordBytes as HashWord)
end 'hashWordFold'

// hashPairStep folds the pair of words at a position into a state, both keyed with it.
function hashPairStep(input HashInput, at Count, state HashWord, secret HashWord) returns HashWord
	let low = hashLoadWord(input, at: at)
	let high = hashLoadWord(input, at: try at + hashWordBytes otherwise panic("a hashed span past memory"))
	return hashFold(low xor secret xor state, right: high xor state)
end 'hashPairStep'

// hashSpan is the fold of a span of count bytes under a seed: up to two words read whole, a longer span a pair or a
// stride of three pairs at a time, and its last pair.
function hashSpan(input HashInput, count Count, seed HashWord) returns HashWord
	let state = hashKeyedState(seed)
	let n = count as HashWord
	if count > hashPairBytes 'long'
		return hashLongSpan(input, count: count, state: state)
	end 'long'
	if count >= hashWordBytes 'words'
		return hashFinish(hashLoadWord(input, at: 0), high: hashLoadWord(input, at: count - hashWordBytes), state: state, count: n)
	end 'words'
	if count >= hashHalfWordBytes 'halves'
		let low = hashLoadHalf(input, at: 0) or (hashLoadHalf(input, at: count - hashHalfWordBytes) shl hashHalfBits)
		return hashFinish(low, high: 0, state: state, count: n)
	end 'halves'
	if count > 0 'bytes'
		let first = hashLoadByte(input, at: 0)
		let middle = hashLoadByte(input, at: count shr 1) shl hashSecondByteShift
		let last = hashLoadByte(input, at: count - 1) shl hashThirdByteShift
		return hashFinish(first or middle or last, high: 0, state: state, count: n)
	end 'bytes'
	return hashFinish(0, high: 0, state: state, count: n)
end 'hashSpan'

// hashLongSpan is hashSpan of a span longer than a pair.
function hashLongSpan(input HashInput, count Count, state HashWord) returns HashWord
	var position = 0 as Count
	var remaining = count
	var merged = state
	if remaining > hashStrideBytes 'strides'
		var first = state
		var second = state
		var third = state
		while remaining > hashStrideBytes 'stride'
			first = hashPairStep(input, at: position, state: first, secret: hashSecondSecret)
			second = hashPairStep(input, at: try position + hashStrideSecondOffset otherwise panic("a hashed span past memory"), state: second, secret: hashThirdSecret)
			third = hashPairStep(input, at: try position + hashStrideThirdOffset otherwise panic("a hashed span past memory"), state: third, secret: hashFourthSecret)
			position = try position + hashStrideBytes otherwise panic("a hashed span past memory")
			remaining = remaining - hashStrideBytes
		end 'stride'
		merged = first xor second xor third
	end 'strides'
	while remaining > hashPairBytes 'pairs'
		merged = hashPairStep(input, at: position, state: merged, secret: hashSecondSecret)
		position = try position + hashPairBytes otherwise panic("a hashed span past memory")
		remaining = remaining - hashPairBytes
	end 'pairs'
	let low = hashLoadWord(input, at: try count - hashPairBytes otherwise panic("a long hashed span shorter than a pair"))
	let high = hashLoadWord(input, at: try count - hashWordBytes otherwise panic("a long hashed span shorter than a pair"))
	return hashFinish(low, high: high, state: merged, count: count as HashWord)
end 'hashLongSpan'

let hashByteMask = 0xFF as HashWord

// orderedWordShift is how far up the byte at an index of an ordered word of a width sits in the word, the first the most
// significant where bigEndian: the ordered words of maxon's library, which a read assembles and an append splits.
function orderedWordShift(index Count, width Count, bigEndian bool) returns HashWord
	if bigEndian 'big'
		return ((width as HashWord) - 1 - (index as HashWord)) * hashBitsPerByte
	end 'big'
	return (index as HashWord) * hashBitsPerByte
end 'orderedWordShift'

// orderedWordByte is the byte at an index of an ordered word.
function orderedWordByte(word HashWord, index Count, width Count, bigEndian bool) returns Byte
	return ((word shr orderedWordShift(index, width: width, bigEndian: bigEndian)) and hashByteMask) as Byte
end 'orderedWordByte'
