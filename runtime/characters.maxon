// The Character entries. A Character is two words, laid out as a String is, and the runtime's source, which names no
// Character, takes one as the String of its two words. One of 1 to stringInlineBytes bytes holds them in the words, as
// every String of so few bytes does (inline.maxon), so its words are those of the String of its bytes; a longer one is a
// String of its bytes, a literal's in the executable or a box it owns, so a Character never borrows.

let byteMask = 255 as Count

// byteShiftBits is how far an index of a byte is shifted to the count of bits before it in a word.
let byteShiftBits = 3 as Count

let charBefore = (charOrderSame - 1) as Count

let charAfter = (charOrderSame + 1) as Count

// The lowest lead bytes of a UTF-8 sequence of three and of four bytes, and the bits of a code point that each byte holds,
// which charCodepoint decodes.
let leadThree = 0xE0 as Count

let leadFour = 0xF0 as Count

let asciiTop = 0x80 as Count

let leadTwoBits = 0x1F as Count

let leadThreeBits = 0x0F as Count

let leadFourBits = 0x07 as Count

let continuationBits = 0x3F as Count

let continuationSpan = 64 as Count

// charLength is the count of a Character's bytes.
function charLength(c String) returns Count
	return __Raw.stringLength(c)
end 'charLength'

// charByte is the byte of a Character at an index below its count.
function charByte(c String, index Count) returns Byte
	if isInline(c) 'inline'
		return inlineByte(c, index: index)
	end 'inline'
	return __Raw.loadByte(__Raw.stringFirstWord(c), offset: index)
end 'charByte'

// byteShift is how far the byte at an index of a word is shifted up in it.
function byteShift(index Count) returns Count
	return ((index as HashWord) shl (byteShiftBits as HashWord)) as Count
end 'byteShift'

// charEquals is whether two Characters have the same bytes: a String's equality, since a Character is laid out as one.
function charEquals(left String, right String) returns bool
	return streq(left, right: right)
end 'charEquals'

// charCompare orders two Characters by their bytes, a shorter one that the other starts with first.
function charCompare(left String, right String) returns Count
	let leftLength = charLength(left)
	let rightLength = charLength(right)
	var at = 0 as Count
	while at < leftLength and at < rightLength 'bytes'
		let a = charByte(left, index: at)
		let b = charByte(right, index: at)
		if a != b 'differ'
			return charBefore if a < b else charAfter
		end 'differ'
		at = __Raw.wrappingAdd(at, right: 1)
	end 'bytes'
	if leftLength < rightLength 'shorter'
		return charBefore
	end 'shorter'
	if leftLength > rightLength 'longer'
		return charAfter
	end 'longer'
	return charOrderSame
end 'charCompare'

// charToString is a new String of a Character's bytes: the same two words where they hold the bytes.
function charToString(c String) returns String
	if isInline(c) 'inline'
		return __Raw.stringOfWords(__Raw.stringFirstWord(c), second: __Raw.stringSecondWord(c))
	end 'inline'
	return stringOfBytes(__Raw.stringFirstWord(c), length: __Raw.stringLength(c))
end 'charToString'

// charHash is the hash of a Character's bytes under a seed, a String's of the same bytes, since it is laid out as one.
function charHash(c String, seed Count) returns Count
	return hashStringBytes(c, at: 0, count: charLength(c), seed: seed)
end 'charHash'

// charFromCodepoint is the Character of a code point's UTF-8 bytes, which its two words always hold.
function charFromCodepoint(cp Count) returns String
	if strIsSurrogate(cp) 'surrogate'
		panic("Character.fromCodepoint: a surrogate is not a Unicode scalar value")
	end 'surrogate'
	let length = strEncodedLength(cp)
	var first = 0 as HashWord
	for i in 0 upto length 'bytes'
		first = first or ((strEncodedByte(cp, length: length, index: i) as HashWord) shl byteShift(i))
	end 'bytes'
	return inlineString(first as Count, rest: 0, count: length)
end 'charFromCodepoint'

// charNextScalar is the scalar value after a scalar value: the code point after it, but for the first after the surrogates.
function charNextScalar(cp Count) returns Count
	return strScalarOfRank(strAdd(strRankOfScalar(cp), right: 1))
end 'charNextScalar'

// charAdvanceBy is the Character of the scalar value step scalar values after the first code point of a Character, step a
// signed word: before it where it is negative.
function charAdvanceBy(c String, step Count) returns String
	let cp = charCodepoint(c)
	if strIsSurrogate(cp) 'surrogate'
		panic("Character.advanceBy: this character holds a surrogate, which is not a Unicode scalar value")
	end 'surrogate'
	let target = __Raw.wrappingAdd(strRankOfScalar(cp), right: step)
	if target > strScalarRankLast 'outside'
		panic("Character.advanceBy: the step leaves the Unicode scalar values")
	end 'outside'
	return charFromCodepoint(strScalarOfRank(target))
end 'charAdvanceBy'

// charOfBytes is a Character of the length bytes of a String from a byte position: held in its two words where they are few
// enough, and otherwise a String of a copy of them.
function charOfBytes(text String, from Count, length Count) returns String
	let total = __Raw.stringLength(text)
	if from > total or length > total - from 'outside'
		panic("a character's bytes reach past the end of its string")
	end 'outside'
	if length > stringInlineBytes 'held'
		return stringOfBytes(__Raw.wrappingAdd(__Raw.stringFirstWord(text), right: from), length: length)
	end 'held'
	return stringView(text, from: from, length: length)
end 'charOfBytes'

// charCodepoint is the code point of a Character's first UTF-8 sequence.
function charCodepoint(c String) returns Count
	let first = charByte(c, index: 0) as Count
	if first < asciiTop 'ascii'
		return first
	end 'ascii'
	var count = 4 as Count
	var cp = first and leadFourBits
	if first < leadThree 'two'
		count = 2
		cp = first and leadTwoBits
	end 'two' else if first < leadFour 'three'
		count = 3
		cp = first and leadThreeBits
	end 'three'
	for i in 1 upto count 'continuation'
		cp = try cp * continuationSpan + ((charByte(c, index: i) as Count) and continuationBits) otherwise panic("a code point past a word")
	end 'continuation'
	return cp
end 'charCodepoint'
