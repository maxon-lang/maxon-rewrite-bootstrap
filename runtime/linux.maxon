// The runtime's OS layer on Linux, which calls the kernel itself, by its x86-64 system calls (the linux constants of
// layout_gen.maxon), with no C library: output and exit, the pages the heap is carved from, the arguments and the
// environment the process started with, the clock, files and directories, a worker's thread and the futex it parks on.
// What each entry does is what its Windows twin does, in the files of the entries; a failure gives the case of its error
// that the same failure gives there (failureOf).

#if os(Linux)
	// noFd is the fd of an anonymous mapping, -1.
	let noFd = 0xFFFFFFFFFFFFFFFF as Count

	// noMappingOffset is the offset of an anonymous mapping, which has no file.
	let noMappingOffset = 0 as Count

	// noFlags asks a call for nothing special.
	let noFlags = 0 as Count

	// noTimeout is a futex wait's timeout: none, so it waits until it is woken.
	let noTimeout = 0 as Count

	let wakeOneSleeper = 1 as Count

	// linuxPathBytes is PATH_MAX, the longest path the kernel gives back, with its terminator.
	let linuxPathBytes = 4096 as Count

	// affinityMaskBytes is the room for the mask of the processors a thread may run on: 1024 of them, a bit each.
	let affinityMaskBytes = 128 as Count

	let lowBit = 1 as Count

	// The bytes of a path that the runtime reads: the separator, the other one that FilePath.from turns into it, as maxon's
	// does, and the terminator of a C string.
	let slashByte = 0x2F as Byte

	let terminatorByte = 0 as Byte

	let equalsByte = 0x3D as Byte

	let dotEntryByte = 0x2E as Byte

	let selfExecutable = "/proc/self/exe"

	// The process starts with the argument count at its stack pointer, the arguments' addresses after it, a null, and then
	// the environment's, ended by a null.
	let argumentsOffset = 8 as Count

	let directoryBufferBytes = 4096 as Count

	// failed is whether what a system call returned is -errno, a word in the last page of the address space.
	function failed(result Count) returns bool
		return result > __Raw.wrappingSub(0, right: linuxErrnoLimit)
	end 'failed'

	// errnoOf is the errno of a system call that failed.
	function errnoOf(result Count) returns Count
		return __Raw.wrappingSub(0, right: result)
	end 'errnoOf'

	// osErrorOf is the errno of a system call's result, or 0 when it did not fail.
	function osErrorOf(result Count) returns Count
		if failed(result) 'failed'
			return errnoOf(result)
		end 'failed'
		return 0
	end 'osErrorOf'

	// failureOf is the failure that an errno is, by the Win32 error that names the same failure on Windows.
	function failureOf(errno Count) returns Failure
		if errno == linuxEnoent or errno == linuxEnotdir 'missing'
			return failureNotFound
		end 'missing'
		if errno == linuxEacces or errno == linuxEperm or errno == linuxEisdir 'denied'
			return failureAccessDenied
		end 'denied'
		if errno == linuxEbusy or errno == linuxEtxtbsy 'busy'
			return failureBusy
		end 'busy'
		if errno == linuxEexist or errno == linuxEnotempty 'exists'
			return failureAlreadyExists
		end 'exists'
		return failureOther
	end 'failureOf'

	// writeAll writes the bytes at an address to an fd, as many calls as the kernel takes, and gives the errno that
	// stopped it, or 0.
	function writeAll(fd Count, data Count, length Count) returns Count
		var done = 0 as Count
		while done < length 'write'
			let written = __Raw.syscall3(linuxSysWrite, arg1: fd, arg2: __Raw.wrappingAdd(data, right: done), arg3: length - done)
			if failed(written) 'failed'
				if errnoOf(written) == linuxEintr 'again'
					continue 'write'
				end 'again'
				return errnoOf(written)
			end 'failed'
			done = __Raw.wrappingAdd(done, right: written)
		end 'write'
		return 0
	end 'writeAll'

	// writeHandle writes a string to an fd, all of it.
	function writeHandle(handle Count, text String)
		_ = writeAll(handle, data: __Raw.stringBytes(text), length: __Raw.stringLength(text))
	end 'writeHandle'

	// exitProcess ends the process, every thread of it, with a code; it does not return.
	function exitProcess(code Count)
		_ = __Raw.syscall1(linuxSysExitGroup, arg1: code)
	end 'exitProcess'

	function closeFd(fd Count)
		_ = __Raw.syscall1(linuxSysClose, arg1: fd)
	end 'closeFd'

	// The page heap's part of the kernel (pages.maxon), Go's: reservePages maps address space read-write with no reserve of
	// memory, so a page costs nothing until it is touched and commitPages has nothing to do; releasePagesToSystem gives the
	// memory of pages back by MADV_DONTNEED, after which they read zero.
	function reservePages(bytes Count) returns Count
		let block = __Raw.syscall6(linuxSysMmap, arg1: 0, arg2: bytes, arg3: linuxProtReadWrite, arg4: linuxMapAnonPrivate or linuxMapNoReserve, arg5: noFd, arg6: noMappingOffset)
		if failed(block) 'refused'
			panic("out of memory: the kernel maps no more pages")
		end 'refused'
		return block
	end 'reservePages'

	function commitPages(block Count, bytes Count)
	end 'commitPages'

	function releasePagesToSystem(block Count, bytes Count)
		if failed(__Raw.syscall3(linuxSysMadvise, arg1: block, arg2: bytes, arg3: linuxMadvDontNeed)) 'failed'
			panic("the page heap's pages cannot be given back to the kernel")
		end 'failed'
	end 'releasePagesToSystem'

	// processStart is the stack pointer the process started with.
	function processStart() returns Count
		return __Raw.loadWord(__Raw.processStartAddress(), offset: 0)
	end 'processStart'

	// startWord is the word at an index of the words the process started with: the argument count is the first.
	function startWord(index Count) returns Count
		return __Raw.loadWord(processStart(), offset: try index * wordBytes otherwise panic("a word past the process's start"))
	end 'startWord'

	// cLength is the length of the zero-terminated bytes at an address.
	function cLength(address Count) returns Count
		var length = 0 as Count
		while __Raw.loadByte(address, offset: length) != terminatorByte 'each'
			length = __Raw.wrappingAdd(length, right: 1)
		end 'each'
		return length
	end 'cLength'

	// atCwd is the directory fd of a path relative to the working directory, AT_FDCWD.
	function atCwd() returns Count
		return __Raw.wrappingSub(0, right: linuxAtCwdNegated)
	end 'atCwd'

	// reopenStandardFds opens the null device at each of the standard fds that the process started with closed, as Go's runtime
	// does at start-up (checkfds): the first fd a process opens takes the lowest number free, so otherwise the event queue, or
	// the first pipe of a spawn, would be its standard input, output or error, read and written as one, and a child that
	// inherits the stream would get that fd, or none, in place of it. The null device is opened without O_CLOEXEC, as a standard
	// stream is, so a child inherits it.
	function reopenStandardFds()
		let path = cStringOf("/dev/null")
		for fd in 0 upto 3 'fds'
			let flags = __Raw.syscall2(linuxSysFcntl, arg1: fd, arg2: linuxFcntlGetDescriptorFlags)
			if not failed(flags) 'open'
				continue 'fds'
			end 'open'
			if errnoOf(flags) != linuxEbadf 'unchecked'
				panic("cannot check a standard fd")
			end 'unchecked'
			if __Raw.syscall4(linuxSysOpenat, arg1: atCwd(), arg2: path, arg3: linuxOpenReadWrite, arg4: 0) != fd 'unopened'
				panic("cannot open the null device at a standard fd that is closed")
			end 'unopened'
		end 'fds'
		free(path)
	end 'reopenStandardFds'

	// osArgs is the program's arguments, the program's own name first, as the kernel gives them.
	function osArgs() returns Count
		let count = startWord(0)
		let args = stringArrayNew()
		for i in 0 upto count 'each'
			let arg = startWord(i + 1)
			pushBytes(args, address: arg, length: cLength(arg))
		end 'each'
		return args
	end 'osArgs'

	// environment is the address of the first of the environment's entries, each `NAME=value`, which a null ends.
	function environment() returns Count
		return __Raw.wrappingAdd(processStart(), right: try (startWord(0) + 2) * wordBytes otherwise panic("an environment past memory"))
	end 'environment'

	// namesEntry is whether the zero-terminated entry of the environment at an address is the one of a name: the name, then
	// '='.
	function namesEntry(entry Count, name Count, length Count) returns bool
		for i in 0 upto length 'bytes'
			if __Raw.loadByte(entry, offset: i) != __Raw.loadByte(name, offset: i) 'differs'
				return false
			end 'differs'
		end 'bytes'
		return __Raw.loadByte(entry, offset: length) == equalsByte
	end 'namesEntry'

	// environmentValueOf is the address of the zero-terminated value of a variable of the environment the process started with,
	// or noBox for a variable that is not set.
	function environmentValueOf(name String) returns Count
		let length = __Raw.stringLength(name)
		var at = environment()
		while __Raw.loadWord(at, offset: 0) != 0 'entries'
			let entry = __Raw.loadWord(at, offset: 0)
			if namesEntry(entry, name: __Raw.stringBytes(name), length: length) 'found'
				return __Raw.wrappingAdd(entry, right: __Raw.wrappingAdd(length, right: 1))
			end 'found'
			at = __Raw.wrappingAdd(at, right: wordBytes)
		end 'entries'
		return noBox
	end 'environmentValueOf'

	// osEnvironmentVariable is the value of a variable of the environment the process started with, which a variable that
	// is not set has none of.
	function osEnvironmentVariable(name String, errorAddress Count) returns String
		let value = environmentValueOf(name)
		if value == noBox 'unset'
			failWith(errorAddress, errorCase: variableUnset)
			return noString()
		end 'unset'
		succeed(errorAddress)
		return stringOfBytes(value, length: cLength(value))
	end 'osEnvironmentVariable'

	// osEnvironmentBytes writes the first bytes of the value of a variable to room, at most capacity of them, and gives how
	// many: 0 for a variable that is not set and for an empty one. Unlike osEnvironmentVariable it allocates nothing from
	// the program's heap.
	function osEnvironmentBytes(name String, room Count, capacity Count) returns Count
		let value = environmentValueOf(name)
		if value == noBox 'unset'
			return 0
		end 'unset'
		var length = cLength(value)
		if length > capacity 'long'
			length = capacity
		end 'long'
		if length != 0 'some'
			copyBytes(value, target: room, count: length)
		end 'some'
		return length
	end 'osEnvironmentBytes'

	// osExecutablePath is the full path of the running executable, which the link /proc/self/exe names, as maxon's runtime
	// reads it; a kernel with no /proc cannot give it.
	function osExecutablePath(errorAddress Count) returns String
		let link = cStringOf(selfExecutable)
		let buffer = alloc(linuxPathBytes)
		enterBlocking()
		let length = __Raw.syscall4(linuxSysReadlinkat, arg1: atCwd(), arg2: link, arg3: buffer, arg4: linuxPathBytes)
		exitBlocking()
		free(link)
		if failed(length) or length == linuxPathBytes 'failed'
			free(buffer)
			failWith(errorAddress, errorCase: pathUnavailable)
			return noString()
		end 'failed'
		let text = stringOfBytes(buffer, length: length)
		free(buffer)
		succeed(errorAddress)
		return text
	end 'osExecutablePath'

	// osCurrentPath is the working directory, which stops the program when the kernel cannot give it.
	function osCurrentPath() returns String
		let buffer = alloc(linuxPathBytes)
		enterBlocking()
		let size = __Raw.syscall2(linuxSysGetcwd, arg1: buffer, arg2: linuxPathBytes)
		exitBlocking()
		if failed(size) or size == 0 'failed'
			free(buffer)
			panic("Directory.currentPath: getcwd failed")
		end 'failed'
		let text = stringOfBytes(buffer, length: size - 1)
		free(buffer)
		return text
	end 'osCurrentPath'

	// osClockNanos is the monotonic clock in nanoseconds.
	function osClockNanos() returns Count
		return programClockNanos(linuxClockMonotonic)
	end 'osClockNanos'

	// osTickMillis is the milliseconds since the machine booted.
	function osTickMillis() returns Count
		return programClockNanos(linuxClockBoottime) / nanosPerMilli
	end 'osTickMillis'

	// threadCpuTime is the CPU time the running thread has used, in nanoseconds, as the runtime's own code reads it, outside
	// any bracket, on the thread whose context is context: through the timespec of the thread's block, so that it allocates
	// nothing in a bracket or a switch, or through one of its own on the one thread of a program without the scheduler, which
	// has no block and no bracket.
	function threadCpuTime(context Count) returns Count
		let block = threadBlockSwitch(context)
		if block == noThreadBlock 'alone'
			return clockNanosOf(linuxClockThreadCpu)
		end 'alone'
		return clockNanosFrom(linuxClockThreadCpu, time: __Raw.wrappingAdd(block, right: threadBlockClockOffset))
	end 'threadCpuTime'

	// osUnixNanos is the nanoseconds since 1970-01-01 UTC.
	function osUnixNanos() returns Count
		return programClockNanos(linuxClockRealtime)
	end 'osUnixNanos'

	// programClockNanos is a clock that a program reads, in nanoseconds: its system call is bracketed, as Go brackets every
	// call of its syscall package. The runtime reads the clock by a raw clock_gettime, and a preemption signal that comes
	// while a thread is in a system call is handled as the call returns, in the runtime's code, which is never stopped, so a
	// green thread that reads the clock over and over would almost never take the monitor's ask; in the bracket the monitor
	// takes its processor instead once it has held it for a slice (retake). The runtime's own reads, which may hold the
	// running thread or a bracket of their own, are monotonicNanos, clockNanosOf and clockNanosInto.
	function programClockNanos(clock Count) returns Count
		let time = alloc(linuxTimespecBytes)
		enterBlocking()
		_ = __Raw.syscall2(linuxSysClockGettime, arg1: clock, arg2: time)
		exitBlocking()
		let nanos = timespecNanos(time)
		free(time)
		return nanos
	end 'programClockNanos'

	// monotonicNanos is the monotonic clock in nanoseconds as the runtime's own code reads it, outside any bracket.
	function monotonicNanos() returns Count
		return clockNanosOf(linuxClockMonotonic)
	end 'monotonicNanos'

	// clockNanosOf is the clock that the system numbers clock, in nanoseconds.
	function clockNanosOf(clock Count) returns Count
		let time = alloc(linuxTimespecBytes)
		let nanos = clockNanosFrom(clock, time: time)
		free(time)
		return nanos
	end 'clockNanosOf'

	// clockNanosInto is the monotonic clock in nanoseconds, read through a timespec at an address.
	function clockNanosInto(time Count) returns Count
		return clockNanosFrom(linuxClockMonotonic, time: time)
	end 'clockNanosInto'

	// clockNanosFrom is a clock in nanoseconds, read through a timespec at an address.
	function clockNanosFrom(clock Count, time Count) returns Count
		_ = __Raw.syscall2(linuxSysClockGettime, arg1: clock, arg2: time)
		return timespecNanos(time)
	end 'clockNanosFrom'

	// timespecNanos is the time a timespec at an address holds, in nanoseconds.
	function timespecNanos(time Count) returns Count
		let wholeNanos = try __Raw.loadWord(time, offset: 0) * nanosPerSecond otherwise panic("the clock is past a word of nanoseconds")
		return try wholeNanos + __Raw.loadWord(time, offset: wordBytes) otherwise panic("the clock is past a word of nanoseconds")
	end 'timespecNanos'

	function osProcessId() returns Count
		return __Raw.syscall0(linuxSysGetpid)
	end 'osProcessId'

	// linuxPrioProcess is PRIO_PROCESS, and a who of 0 names the calling thread, which the kernel scopes a nice value to; the
	// threads and processes it starts afterwards inherit it.
	let linuxPrioProcess = 0 as Count

	let backgroundNice = 10 as Count

	// niceBias is what getpriority adds to the negated nice value so that its answer is positive.
	let niceBias = 20 as Count

	// osEnterBackgroundPriority sets the nice value to 10, as an absolute value so that asking twice sinks no further, and
	// answers the nice value that the kernel reports then.
	function osEnterBackgroundPriority() returns Count
		_ = __Raw.syscall3(linuxSysSetpriority, arg1: linuxPrioProcess, arg2: 0, arg3: backgroundNice)
		return __Raw.wrappingSub(niceBias, right: __Raw.syscall2(linuxSysGetpriority, arg1: linuxPrioProcess, arg2: 0))
	end 'osEnterBackgroundPriority'

	// osPathFrom is a path with the native separator in place of the other one; a Linux path may hold any other byte.
	function osPathFrom(path String, errorAddress Count) returns String
		let length = __Raw.stringLength(path)
		let source = __Raw.stringBytes(path)
		let dest = __Raw.stringRoom(length)
		for i in 0 upto length 'copy'
			let byte = __Raw.loadByte(source, offset: i)
			__Raw.storeByte(dest, offset: i, value: slashByte if byte == backslashByte else byte)
		end 'copy'
		succeed(errorAddress)
		return ownedString(dest, length: length, ascii: __Raw.stringAscii(path))
	end 'osPathFrom'

	// openPathBytes is the fd of the file that the bytes of a path name, opened with flags, or -errno.
	function openPathBytes(path Count, length Count, flags Count, mode Count) returns Count
		let cPath = cStringOfBytes(path, length: length)
		enterBlocking()
		let fd = __Raw.syscall4(linuxSysOpenat, arg1: atCwd(), arg2: cPath, arg3: flags, arg4: mode)
		exitBlocking()
		free(cPath)
		return fd
	end 'openPathBytes'

	// openPath is the fd of the file a path names, opened with flags, or -errno.
	function openPath(path String, flags Count, mode Count) returns Count
		return openPathBytes(__Raw.stringBytes(path), length: __Raw.stringLength(path), flags: flags, mode: mode)
	end 'openPath'

	// openFileBytes is the fd of an owned file handle (file.maxon), the file that the bytes of a path name opened in a way, close
	// on exec as every open of the runtime is; or it stores the errno at osErrorAddress and gives 0. A file opened to write is
	// put on the writers' list (openWriterBytes), whose fds the child of a clone closes before its execve.
	function openFileBytes(path Count, length Count, how Count, osErrorAddress Count) returns Count
		var fd = 0 as Count
		if how == openToRead 'read'
			fd = openPathBytes(path, length: length, flags: linuxOpenReadOnly, mode: 0)
		end 'read' else 'write'
			fd = openWriterBytes(path, length: length, flags: linuxOpenCreateNew if how == openToCreate else linuxOpenReplace, mode: linuxExecutableFileMode if how == openToWriteExecutable else linuxFileMode)
		end 'write'
		if failed(fd) 'refused'
			__Raw.storeWord(osErrorAddress, offset: 0, value: errnoOf(fd))
			return 0
		end 'refused'
		return fd
	end 'openFileBytes'

	// openWriterBytes is the fd of the file that the bytes of a path name, opened with flags to write, or -errno, put on the
	// writers' list. It holds the fork lock shared for the open and the list, so that no clone comes between them: a slot of the
	// list is taken first (takeWriterSlot), so that a list that is full refuses the open with EMFILE before the file is made or
	// emptied, as the kernel refuses an open past the process's fds, and the open's fd is put in it then, or the slot given back.
	// The lock is the scheduler's, made when there is none yet (writersLock), so that the fd is on the list a later clone reads.
	//
	// Every spawn waits while the lock is held, so the open under it is made with O_NONBLOCK, so that it never waits for
	// another process: a FIFO that no reader has open refuses it with ENXIO, and is opened again after the lock is given
	// back, a plain open that waits for the reader (who may be a child that this process is about to start), and is left off
	// the list, since a FIFO is never run and so never busy. Any other fd has the flag cleared again (F_SETFL), before anything
	// else sees it, so that it waits as an open file's fd does (fileEntryOf decides that from what it is). An open that a file
	// system holds (a hung NFS server's, a FUSE daemon's) holds every spawn back as long.
	function openWriterBytes(path Count, length Count, flags Count, mode Count) returns Count
		let lock = writersLock()
		let cPath = cStringOfBytes(path, length: length)
		enterBlocking()
		holdForkShared(lock)
		var fd = __Raw.wrappingSub(0, right: errnoTooManyFiles)
		if takeWriterSlot(lock) 'listed'
			fd = __Raw.syscall4(linuxSysOpenat, arg1: atCwd(), arg2: cPath, arg3: flags or linuxOpenNonblock, arg4: mode)
			replaceWriter(lock, fd: noFd, with: noFd if failed(fd) else fd)
		end 'listed'
		releaseForkShared(lock)
		if failed(fd) and errnoOf(fd) == linuxEnxio 'unreadFifo'
			fd = __Raw.syscall4(linuxSysOpenat, arg1: atCwd(), arg2: cPath, arg3: flags, arg4: mode)
		end 'unreadFifo' else if not failed(fd) 'opened'
			let status = __Raw.syscall2(linuxSysFcntl, arg1: fd, arg2: linuxFcntlGetFlags)
			if not failed(status) and (status and linuxOpenNonblock) != 0 'waits'
				_ = __Raw.syscall3(linuxSysFcntl, arg1: fd, arg2: linuxFcntlSetFlags, arg3: __Raw.wrappingSub(status, right: linuxOpenNonblock))
			end 'waits'
		end 'opened'
		exitBlocking()
		free(cPath)
		return fd
	end 'openWriterBytes'

	// closeFileHandle closes the fd of an open file in the blocking bracket, since a close may wait on its file system (a flush
	// to NFS, a FUSE daemon's), and gives its errno, or 0. A close that a signal breaks off has still freed the fd on Linux, so
	// it is not made again. A file open for writing is taken off the writers' list (a FIFO opened before its reader, which is
	// not on it, leaves the list as it is) and closed under the fork lock held shared,
	// so that no clone comes between them: a clone in flight has made its child close the fd before its execve, and the clone's
	// hold of the lock lasts till then, so the close waits for it and the file can be run once the close has returned.
	function closeFileHandle(fd Count, writes bool) returns Count
		let lock = writersLock() if writes else noForkLock
		enterBlocking()
		var result = 0 as Count
		if writes 'writer'
			holdForkShared(lock)
			replaceWriter(lock, fd: fd, with: noFd)
			result = __Raw.syscall1(linuxSysClose, arg1: fd)
			releaseForkShared(lock)
		end 'writer' else 'reader'
			result = __Raw.syscall1(linuxSysClose, arg1: fd)
		end 'reader'
		exitBlocking()
		return osErrorOf(result)
	end 'closeFileHandle'

	// fileEntryOf is the event entry of an open file's fd that waits on the event queue, as Go's os.File decides: a FIFO's, a
	// socket's or a character device's, which it makes not wait (O_NONBLOCK) and registers. A regular file, a directory and a
	// block device have none, and neither has an fd the event queue refuses (epoll's EPERM, as /dev/null's), whose flags are
	// put back. No fd of Linux must wait there, so the open is never unwaited.
	function fileEntryOf(fd Count, path Count, length Count, unwaitedAddress Count) returns Count
		let stat = alloc(linuxStatBytes)
		enterBlocking()
		let statted = __Raw.syscall2(linuxSysFstat, arg1: fd, arg2: stat)
		exitBlocking()
		let kind = __Raw.loadWord32(stat, offset: linuxStatModeOffset) and linuxModeTypeMask
		free(stat)
		if failed(statted) or not (kind == linuxModeFifo or kind == linuxModeSocket or kind == linuxModeCharacter) 'plain'
			return noEntry
		end 'plain'
		let flags = __Raw.syscall2(linuxSysFcntl, arg1: fd, arg2: linuxFcntlGetFlags)
		if failed(flags) 'unflagged'
			return noEntry
		end 'unflagged'
		_ = __Raw.syscall3(linuxSysFcntl, arg1: fd, arg2: linuxFcntlSetFlags, arg3: flags or linuxOpenNonblock)
		let entry = eventRegister(fd)
		if entry == noEntry 'refused'
			_ = __Raw.syscall3(linuxSysFcntl, arg1: fd, arg2: linuxFcntlSetFlags, arg3: flags)
		end 'refused'
		return entry
	end 'fileEntryOf'

	// readFileHandle is one read of up to length bytes of an open file's fd that does not wait on the event queue, in the
	// blocking bracket, made again after a signal: its count, 0 at the end of the file, or 0 with the errno at osErrorAddress.
	function readFileHandle(fd Count, buffer Count, length Count, osErrorAddress Count) returns Count
		enterBlocking()
		var result = __Raw.syscall3(linuxSysRead, arg1: fd, arg2: buffer, arg3: length)
		while failed(result) and errnoOf(result) == linuxEintr 'again'
			result = __Raw.syscall3(linuxSysRead, arg1: fd, arg2: buffer, arg3: length)
		end 'again'
		exitBlocking()
		if failed(result) 'refused'
			__Raw.storeWord(osErrorAddress, offset: 0, value: errnoOf(result))
			return 0
		end 'refused'
		return result
	end 'readFileHandle'

	// writeFileHandle writes length bytes to an open file's fd that does not wait on the event queue, all of them, in the
	// blocking bracket, and gives the errno that stopped it, or 0.
	function writeFileHandle(fd Count, buffer Count, length Count) returns Count
		enterBlocking()
		let errno = writeAll(fd, data: buffer, length: length)
		exitBlocking()
		return errno
	end 'writeFileHandle'

	// statPath fills a struct stat of the file a path names and gives 0, or gives -errno, as statCString does for a
	// zero-terminated path.
	function statPath(path String, stat Count) returns Count
		let cPath = cStringOf(path)
		let result = statCString(cPath, stat: stat)
		free(cPath)
		return result
	end 'statPath'

	function statCString(cPath Count, stat Count) returns Count
		enterBlocking()
		let result = __Raw.syscall4(linuxSysNewfstatat, arg1: atCwd(), arg2: cPath, arg3: stat, arg4: noFlags)
		exitBlocking()
		return result
	end 'statCString'

	// readFileRoom is the whole content of a file in a string room that the caller owns: it stores the length at lengthAddress and
	// gives the room, or sets the error word and gives nothing to use.
	function readFileRoom(path String, lengthAddress Count, errorAddress Count) returns Count
		let fd = openPath(path, flags: linuxOpenReadOnly, mode: 0)
		if failed(fd) 'open'
			endWithError(errorAddress, osError: errnoOf(fd), table: readFailures())
			return 0
		end 'open'
		let stat = alloc(linuxStatBytes)
		enterBlocking()
		let statted = __Raw.syscall2(linuxSysFstat, arg1: fd, arg2: stat)
		exitBlocking()
		let size = __Raw.loadWord(stat, offset: linuxStatSizeOffset)
		free(stat)
		if failed(statted) 'sized'
			closeFd(fd)
			endWithError(errorAddress, osError: errnoOf(statted), table: readFailures())
			return 0
		end 'sized'
		let bytes = __Raw.stringRoom(size)
		var done = 0 as Count
		var readError = 0 as Count
		var reading = true
		enterBlocking()
		while done < size and reading 'read'
			let chunk = __Raw.syscall3(linuxSysRead, arg1: fd, arg2: __Raw.wrappingAdd(bytes, right: done), arg3: size - done)
			if failed(chunk) 'failed'
				if errnoOf(chunk) != linuxEintr 'stop'
					readError = errnoOf(chunk)
					reading = false
				end 'stop'
			end 'failed' else if chunk == 0 'shrunk'
				reading = false
			end 'shrunk' else 'more'
				done = __Raw.wrappingAdd(done, right: chunk)
			end 'more'
		end 'read'
		exitBlocking()
		closeFd(fd)
		if readError != 0 'failedRead'
			__Raw.freeStringRoom(bytes)
			endWithError(errorAddress, osError: readError, table: readFailures())
			return 0
		end 'failedRead'
		succeed(errorAddress)
		__Raw.storeWord(lengthAddress, offset: 0, value: done)
		return bytes
	end 'readFileRoom'

	// writeFile replaces a file with bytes at an address, and gives the errno that stopped it, or 0. The mode applies to a file
	// that it creates; one that is there keeps its own. The file is open for writing only while the write holds the fork lock
	// shared.
	function writeFile(path String, data Count, length Count, executable bool) returns Count
		let cPath = cStringOf(path)
		let lock = forkLock()
		enterBlocking()
		holdForkShared(lock)
		let fd = __Raw.syscall4(linuxSysOpenat, arg1: atCwd(), arg2: cPath, arg3: linuxOpenReplace, arg4: linuxExecutableFileMode if executable else linuxFileMode)
		var errno = osErrorOf(fd)
		if errno == 0 'opened'
			errno = writeAll(fd, data: data, length: length)
			closeFd(fd)
		end 'opened'
		releaseForkShared(lock)
		exitBlocking()
		free(cPath)
		return errno
	end 'writeFile'

	// osRename moves a file or a directory, and replaces what is at the destination.
	function osRename(source String, destination String, errorAddress Count)
		let oldPath = cStringOf(source)
		let newPath = cStringOf(destination)
		enterBlocking()
		#if arch(arm64)
			let result = __Raw.syscall5(linuxSysRenameat2, arg1: atCwd(), arg2: oldPath, arg3: atCwd(), arg4: newPath, arg5: noFlags)
		#else
			let result = __Raw.syscall2(linuxSysRename, arg1: oldPath, arg2: newPath)
		#endif
		exitBlocking()
		free(oldPath)
		free(newPath)
		endWithError(errorAddress, osError: osErrorOf(result), table: renameFailures())
	end 'osRename'

	// osDelete deletes a file, which a directory is not: unlink refuses it.
	function osDelete(path String, errorAddress Count)
		let cPath = cStringOf(path)
		enterBlocking()
		#if arch(arm64)
			let result = __Raw.syscall3(linuxSysUnlinkat, arg1: atCwd(), arg2: cPath, arg3: noFlags)
		#else
			let result = __Raw.syscall1(linuxSysUnlink, arg1: cPath)
		#endif
		exitBlocking()
		free(cPath)
		endWithError(errorAddress, osError: osErrorOf(result), table: deleteFailures())
	end 'osDelete'

	// osDeleteDirectory removes an empty directory: rmdir, which arm64's kernel has as unlinkat with AT_REMOVEDIR.
	function osDeleteDirectory(path String, errorAddress Count)
		let cPath = cStringOf(path)
		enterBlocking()
		#if arch(arm64)
			let result = __Raw.syscall3(linuxSysUnlinkat, arg1: atCwd(), arg2: cPath, arg3: linuxAtRemoveDirectory)
		#else
			let result = __Raw.syscall1(linuxSysRmdir, arg1: cPath)
		#endif
		exitBlocking()
		free(cPath)
		endDirectoryDelete(errorAddress, osError: osErrorOf(result), notDirectory: linuxEnotdir, path: path)
	end 'osDeleteDirectory'

	// negativeWordBit is set in a word that holds a negative number, such as the seconds of a time before 1970.
	let negativeWordBit = 0x8000000000000000 as Count

	// secondsAt is the seconds of the timestamp at an offset of a struct stat or a struct statx, or 0 for a time before 1970, as
	// the Windows entry gives.
	function secondsAt(record Count, offset Count) returns Count
		let seconds = __Raw.loadWord(record, offset: offset)
		if (seconds and negativeWordBit) != 0 'before'
			return 0
		end 'before'
		return seconds
	end 'secondsAt'

	// storeBirthTime stores at created the seconds of when the file at cPath was made and gives 0, or stores 0 and gives
	// infoNotReportedFlag when the system does not report it: a file system that records none leaves STATX_BTIME out of stx_mask,
	// and a kernel without statx refuses the call. A struct stat has no birth time, and the inode's change time is not one.
	function storeBirthTime(cPath Count, created Count) returns Count
		let record = alloc(linuxStatxBytes)
		enterBlocking()
		let result = __Raw.syscall5(linuxSysStatx, arg1: atCwd(), arg2: cPath, arg3: noFlags, arg4: linuxStatxBirthTime, arg5: record)
		exitBlocking()
		var seconds = 0 as Count
		var flag = infoNotReportedFlag as Count
		if not failed(result) and (__Raw.loadWord32(record, offset: linuxStatxMaskOffset) and linuxStatxBirthTime) != 0 'reported'
			seconds = secondsAt(record, offset: linuxStatxCreatedOffset)
			flag = 0
		end 'reported'
		free(record)
		__Raw.storeWord(created, offset: 0, value: seconds)
		return flag
	end 'storeBirthTime'

	// osFileInfo is the time a file was last written, in Unix seconds, and stores its size, the time it was made and last
	// read and a word of its attributes (infoDirectoryFlag, infoReadOnlyFlag, infoNotReportedFlag) at the addresses given.
	function osFileInfo(path String, size Count, created Count, accessed Count, attributes Count, errorAddress Count) returns Count
		let cPath = cStringOf(path)
		let record = alloc(linuxStatBytes)
		let osError = osErrorOf(statCString(cPath, stat: record))
		if osError != 0 'failed'
			free(cPath)
			free(record)
			endWithError(errorAddress, osError: osError, table: infoFailures())
			return 0
		end 'failed'
		let mode = __Raw.loadWord32(record, offset: linuxStatModeOffset)
		var flags = 0 as Count
		if (mode and linuxModeTypeMask) == linuxModeDirectory 'directory'
			flags = flags or infoDirectoryFlag
		end 'directory'
		if (mode and linuxModeOwnerWrite) == 0 'readOnly'
			flags = flags or infoReadOnlyFlag
		end 'readOnly'
		flags = flags or storeBirthTime(cPath, created: created)
		free(cPath)
		__Raw.storeWord(size, offset: 0, value: __Raw.loadWord(record, offset: linuxStatSizeOffset))
		__Raw.storeWord(accessed, offset: 0, value: secondsAt(record, offset: linuxStatAccessedOffset))
		__Raw.storeWord(attributes, offset: 0, value: flags)
		let modified = secondsAt(record, offset: linuxStatModifiedOffset)
		free(record)
		succeed(errorAddress)
		return modified
	end 'osFileInfo'

	function osIsDirectory(path String) returns bool
		let stat = alloc(linuxStatBytes)
		let result = statPath(path, stat: stat)
		let mode = __Raw.loadWord32(stat, offset: linuxStatModeOffset)
		free(stat)
		return not failed(result) and (mode and linuxModeTypeMask) == linuxModeDirectory
	end 'osIsDirectory'

	// osExists is whether a file or a directory is at a path: it has a status.
	function osExists(path String) returns bool
		let stat = alloc(linuxStatBytes)
		let result = statPath(path, stat: stat)
		free(stat)
		return not failed(result)
	end 'osExists'

	// osCreateDirectory makes a directory and the parents it is missing, each prefix that ends before a separator first,
	// and gives whether the directory is there after it. A directory that is there already fails to be made, which is no
	// matter.
	function osCreateDirectory(path String) returns bool
		let cPath = cStringOf(path)
		let length = cLength(cPath)
		enterBlocking()
		for i in 1 upto length 'prefixes'
			if __Raw.loadByte(cPath, offset: i) == slashByte 'separator'
				__Raw.storeByte(cPath, offset: i, value: terminatorByte)
				#if arch(arm64)
					_ = __Raw.syscall3(linuxSysMkdirat, arg1: atCwd(), arg2: cPath, arg3: linuxDirectoryMode)
				#else
					_ = __Raw.syscall2(linuxSysMkdir, arg1: cPath, arg2: linuxDirectoryMode)
				#endif
				__Raw.storeByte(cPath, offset: i, value: slashByte)
			end 'separator'
		end 'prefixes'
		#if arch(arm64)
			_ = __Raw.syscall3(linuxSysMkdirat, arg1: atCwd(), arg2: cPath, arg3: linuxDirectoryMode)
		#else
			_ = __Raw.syscall2(linuxSysMkdir, arg1: cPath, arg2: linuxDirectoryMode)
		#endif
		exitBlocking()
		free(cPath)
		return osIsDirectory(path)
	end 'osCreateDirectory'

	// isDotName is whether the zero-terminated name of a directory entry is `.` or `..`, which a listing leaves out.
	function isDotName(name Count) returns bool
		if __Raw.loadByte(name, offset: 0) != dotEntryByte 'other'
			return false
		end 'other'
		let second = __Raw.loadByte(name, offset: 1)
		return second == terminatorByte or (second == dotEntryByte and __Raw.loadByte(name, offset: 2) == terminatorByte)
	end 'isDotName'

	// pushEntryPath puts a new string of the path joined to the zero-terminated name of an entry at the end of an array of
	// strings: a separator goes between them unless the path is empty or ends with one.
	function pushEntryPath(entries Count, path String, name Count)
		let pathLength = __Raw.stringLength(path)
		let pathBytes = __Raw.stringBytes(path)
		let nameLength = cLength(name)
		let separate = pathLength != 0 and __Raw.loadByte(pathBytes, offset: pathLength - 1) != slashByte
		var length = __Raw.wrappingAdd(pathLength, right: nameLength)
		if separate 'separator'
			length = __Raw.wrappingAdd(length, right: 1)
		end 'separator'
		let bytes = __Raw.stringRoom(length)
		if pathLength != 0 'path'
			copyBytes(pathBytes, target: bytes, count: pathLength)
		end 'path'
		var at = pathLength
		if separate 'slash'
			at = storeNextByte(bytes, offset: at, value: slashByte)
		end 'slash'
		if nameLength != 0 'name'
			copyBytes(name, target: __Raw.wrappingAdd(bytes, right: at), count: nameLength)
		end 'name'
		stringArrayPush(entries, room: bytes, textLength: length)
	end 'pushEntryPath'

	// osList is the path joined to the name of each entry of a directory, `.` and `..` left out, in the order the kernel
	// gives.
	function osList(path String, errorAddress Count) returns Count
		let fd = openPath(path, flags: linuxOpenDirectory, mode: 0)
		if failed(fd) 'open'
			endWithError(errorAddress, osError: errnoOf(fd), table: listFailures())
			return noBox
		end 'open'
		let buffer = alloc(directoryBufferBytes)
		let entries = stringArrayNew()
		var listing = true
		var listError = 0 as Count
		while listing 'batches'
			enterBlocking()
			let filled = __Raw.syscall3(linuxSysGetdents64, arg1: fd, arg2: buffer, arg3: directoryBufferBytes)
			exitBlocking()
			if failed(filled) 'failed'
				listError = errnoOf(filled)
				listing = false
			end 'failed' else if filled == 0 'done'
				listing = false
			end 'done' else 'batch'
				var at = 0 as Count
				while at < filled 'records'
					let record = __Raw.wrappingAdd(buffer, right: at)
					let name = __Raw.wrappingAdd(record, right: linuxDirentNameOffset)
					if not isDotName(name) 'entry'
						pushEntryPath(entries, path: path, name: name)
					end 'entry'
					at = __Raw.wrappingAdd(at, right: __Raw.loadWord16(record, offset: linuxDirentLengthOffset))
				end 'records'
			end 'batch'
		end 'batches'
		free(buffer)
		closeFd(fd)
		if listError != 0 'failedList'
			endWithError(errorAddress, osError: listError, table: listFailures())
			return entries
		end 'failedList'
		succeed(errorAddress)
		return entries
	end 'osList'

	// futexWait sleeps while the 32-bit word at an address holds a value, until a wake of the word. It may return early,
	// which a caller that rereads its word after it loses nothing by.
	function futexWait(address Count, value Count)
		_ = __Raw.syscall4(linuxSysFutex, arg1: address, arg2: linuxFutexWaitPrivate, arg3: value, arg4: noTimeout)
	end 'futexWait'

	// futexWakeOne wakes one thread that sleeps on the 32-bit word at an address.
	function futexWakeOne(address Count)
		_ = __Raw.syscall3(linuxSysFutex, arg1: address, arg2: linuxFutexWakePrivate, arg3: wakeOneSleeper)
	end 'futexWakeOne'

	function futexWakeAll(address Count)
		_ = __Raw.syscall3(linuxSysFutex, arg1: address, arg2: linuxFutexWakePrivate, arg3: wakeEverySleeper)
	end 'futexWakeAll'

	// wakeEverySleeper is INT_MAX, the count of a futex wake that wakes every thread that sleeps on the word.
	let wakeEverySleeper = 0x7FFFFFFF as Count

	// The fork lock, Go's syscall.ForkLock. A child that clone makes gets a copy of every fd the process has open at that
	// moment and keeps it until its execve closes it, close-on-exec as every fd of the runtime is. So a file that one thread
	// has open for writing while another clones is open for writing in that child too, and a run of the file started in that
	// time fails with ETXTBSY, however soon the writer closes its own fd. A write of a whole file (writeFile) holds the lock
	// shared from its open to its close and a clone holds it alone, so that no child is made holding such an fd. A file open
	// for writing through an open file holds it only for its open and for its close (openWriterBytes, closeFileHandle), and is
	// on the writers' list between them, whose fds the child of a clone closes before anything else (closeWriters). The kernel
	// lets go of a file whose last fd a close ends when that close returns, so the child's copies are gone before its execve,
	// and a clone that makes its child as vfork does holds the lock until the child's execve has replaced its memory, since the
	// clone returns only then, so the close of the writer, which waits for the lock, ends the file's last fd. The lock is the
	// scheduler's word (schedForkLockOffset): a process with no scheduler has one thread, which has nothing to order, and an
	// open for writing through an open file makes the scheduler, whose list a later clone reads. Both sides wait in a futex on
	// the word, inside a blocking call's bracket, which the caller makes.
	let forkHeldBit = 0x40000000 as Count

	// noForkLock is the lock of a process that has no scheduler.
	let noForkLock = 0 as Count

	// forkLock is the address of the fork lock, or noForkLock.
	function forkLock() returns Count
		let scheduler = __Raw.loadWord(__Raw.threadContext(), offset: contextSchedulerOffset)
		if scheduler == 0 'single'
			return noForkLock
		end 'single'
		return __Raw.wrappingAdd(scheduler, right: schedForkLockOffset)
	end 'forkLock'

	// holdForkShared takes the fork lock as one of the holders that may hold it at once (a write of a file, the open or the
	// close of a file open for writing), once no clone holds it or waits to.
	function holdForkShared(lock Count)
		if lock == noForkLock 'single'
			return
		end 'single'
		while true 'take'
			let state = __Raw.loadAcquire(lock, offset: 0)
			if (state and forkHeldBit) != 0 'cloning'
				futexWait(lock, value: state)
			end 'cloning' else if __Raw.compareExchange(lock, offset: 0, expected: state, desired: __Raw.wrappingAdd(state, right: 1)) == state 'taken'
				return
			end 'taken'
		end 'take'
	end 'holdForkShared'

	// releaseForkShared gives back a shared hold, and wakes a clone that waits for the last one to end.
	function releaseForkShared(lock Count)
		if lock == noForkLock 'single'
			return
		end 'single'
		while true 'give'
			let state = __Raw.loadAcquire(lock, offset: 0)
			let left = __Raw.wrappingSub(state, right: 1)
			if __Raw.compareExchange(lock, offset: 0, expected: state, desired: left) == state 'given'
				if left == forkHeldBit 'last'
					futexWakeAll(lock)
				end 'last'
				return
			end 'given'
		end 'give'
	end 'releaseForkShared'

	// holdForkAlone takes the fork lock for a clone: it sets forkHeldBit, which keeps new shared holds out, and then waits for
	// the shared holds there are to end.
	function holdForkAlone(lock Count)
		if lock == noForkLock 'single'
			return
		end 'single'
		while true 'take'
			let state = __Raw.loadAcquire(lock, offset: 0)
			if (state and forkHeldBit) != 0 'cloning'
				futexWait(lock, value: state)
			end 'cloning' else if __Raw.compareExchange(lock, offset: 0, expected: state, desired: state or forkHeldBit) == state 'taken'
				break 'take'
			end 'taken'
		end 'take'
		while true 'drain'
			let state = __Raw.loadAcquire(lock, offset: 0)
			if state == forkHeldBit 'drained'
				return
			end 'drained'
			futexWait(lock, value: state)
		end 'drain'
	end 'holdForkAlone'

	// releaseForkAlone gives back a clone's hold, and wakes the shared holds and the clones that wait for it.
	function releaseForkAlone(lock Count)
		if lock == noForkLock 'single'
			return
		end 'single'
		_ = __Raw.atomicExchange(lock, offset: 0, value: 0)
		futexWakeAll(lock)
	end 'releaseForkAlone'

	// The writers' list: the fds of the files open for writing through an open file, in no order, the first of the
	// schedWriterSlots slots at schedWritersOffset, as many as schedWriterCountOffset holds. A thread changes it only while it
	// holds the fork lock shared, and under the scheduler's lock, which orders those threads; a clone, which holds the fork lock
	// alone, and its child only read it, so the child, which shares the memory, reads it as the clone found it. Each open and
	// each close changes it in the one hold of the fork lock that the open or the close of the fd is made in, so a clone finds
	// on it the fds of the files open for writing and only those, none of whose numbers another fd can have; the one file open
	// for writing that is left off is a FIFO opened before its reader (openWriterBytes), which is never run. An open past the
	// slots is refused (takeWriterSlot), since a file left off the list would be a child's to hold.

	// writersLock is the fork lock of an open or a close of a file open for writing: the scheduler's, which it makes when there
	// is none yet.
	function writersLock() returns Count
		return __Raw.wrappingAdd(schedulerOf(__Raw.threadContext()), right: schedForkLockOffset)
	end 'writersLock'

	// writersOf is the scheduler's record of a fork lock that is not noForkLock, which holds the writers' list.
	function writersOf(lock Count) returns Count
		return __Raw.wrappingSub(lock, right: schedForkLockOffset)
	end 'writersOf'

	// writerSlot is the address of the slot of the writers' list at an index.
	function writerSlot(lock Count, index Count) returns Count
		return __Raw.wrappingAdd(writersOf(lock), right: __Raw.wrappingAdd(schedWritersOffset, right: (index mod schedWriterSlots) * wordBytes))
	end 'writerSlot'

	// takeWriterSlot takes a slot of the writers' list for an open that the caller is about to make, holding the fork lock
	// shared, and gives whether one was left. The slot holds noFd until the open's fd takes its place, or it is given back
	// (replaceWriter), in the same hold, so a clone never finds one taken.
	function takeWriterSlot(lock Count) returns bool
		let scheduler = writersOf(lock)
		lockScheduler(scheduler)
		let count = __Raw.loadWord(scheduler, offset: schedWriterCountOffset)
		let room = count < schedWriterSlots
		if room 'room'
			__Raw.storeWord(writerSlot(lock, index: count), offset: 0, value: noFd)
			__Raw.storeWord(scheduler, offset: schedWriterCountOffset, value: __Raw.wrappingAdd(count, right: 1))
		end 'room'
		unlockScheduler(scheduler)
		return room
	end 'takeWriterSlot'

	// replaceWriter puts an fd in the place of one on the writers' list, the caller holding the fork lock shared: an open's fd
	// in the place of the noFd of a slot taken for it, or noFd in the place of a closed fd or of the slot of an open that
	// failed, which takes it off the list, the last of the list moved into its slot. An fd that is not on the list changes
	// nothing.
	function replaceWriter(lock Count, fd Count, with Count)
		let scheduler = writersOf(lock)
		lockScheduler(scheduler)
		let count = __Raw.loadWord(scheduler, offset: schedWriterCountOffset)
		for index in 0 upto count 'find'
			let slot = writerSlot(lock, index: index)
			if __Raw.loadWord(slot, offset: 0) == fd 'found'
				if with == noFd 'unlisted'
					let last = __Raw.wrappingSub(count, right: 1)
					__Raw.storeWord(slot, offset: 0, value: __Raw.loadWord(writerSlot(lock, index: last), offset: 0))
					__Raw.storeWord(scheduler, offset: schedWriterCountOffset, value: last)
				end 'unlisted' else 'listed'
					__Raw.storeWord(slot, offset: 0, value: with)
				end 'listed'
				break 'find'
			end 'found'
		end 'find'
		unlockScheduler(scheduler)
	end 'replaceWriter'

	// closeWriters is the first step of the child of a clone that holds the fork lock alone: it closes its copy of each fd on the
	// writers' list, with raw system calls, allocating nothing and taking no lock. A process with no scheduler has no list, and
	// no file open for writing through an open file, whose open makes the scheduler.
	function closeWriters(lock Count)
		if lock == noForkLock 'single'
			return
		end 'single'
		for index in 0 upto __Raw.loadWord(writersOf(lock), offset: schedWriterCountOffset) 'writers'
			closeFd(__Raw.loadWord(writerSlot(lock, index: index), offset: 0))
		end 'writers'
	end 'closeWriters'

	// startThread starts a worker's thread at once, on a stack of the main thread's reserve that the kernel maps and
	// commits a page at a time, its lowest page the guard. The top word of the stack holds the thread's context, and is the
	// word that the thread's fs points at (rt.threadStart).
	function startThread(context Count)
		let block = __Raw.syscall6(linuxSysMmap, arg1: 0, arg2: stackReserveBytes, arg3: linuxProtReadWrite, arg4: linuxMapAnonPrivate or linuxMapNoReserve, arg5: noFd, arg6: noMappingOffset)
		if failed(block) 'unmapped'
			panic("cannot map a worker thread's stack")
		end 'unmapped'
		if failed(__Raw.syscall3(linuxSysMprotect, arg1: block, arg2: linuxPageBytes, arg3: linuxProtNone)) 'unguarded'
			panic("cannot guard a worker thread's stack")
		end 'unguarded'
		let top = __Raw.wrappingAdd(block, right: stackReserveBytes - 2 * wordBytes)
		__Raw.storeWord(top, offset: 0, value: context)
		if failed(__Raw.callCode1(__Raw.threadStartAddress(), arg1: top)) 'failed'
			panic("cannot start a worker thread")
		end 'failed'
	end 'startThread'

	// onlineProcessors is how many processors the process may run on, the bits of its affinity mask, which maxon's runtime
	// counts too; 0 when the kernel does not say.
	function onlineProcessors() returns Count
		let mask = alloc(affinityMaskBytes)
		let filled = __Raw.syscall3(linuxSysSchedGetaffinity, arg1: 0, arg2: affinityMaskBytes, arg3: mask)
		var count = 0 as Count
		if not failed(filled) 'counted'
			for i in 0 upto filled 'bytes'
				var bits = __Raw.loadByte(mask, offset: i) as Count
				while bits != 0 'bits'
					count = __Raw.wrappingAdd(count, right: bits and lowBit)
					bits = bits shr 1
				end 'bits'
			end 'bytes'
		end 'counted'
		free(mask)
		return count
	end 'onlineProcessors'

	let stdinFd = 0

	// readStandardInput reads up to count bytes of standard input to room and gives how many it read: 0 at the end of the
	// stream, which a failure is as well.
	function readStandardInput(room Count, count Count) returns Count
		enterBlocking()
		var got = __Raw.syscall3(linuxSysRead, arg1: stdinFd, arg2: room, arg3: count)
		while failed(got) and errnoOf(got) == linuxEintr 'again'
			got = __Raw.syscall3(linuxSysRead, arg1: stdinFd, arg2: room, arg3: count)
		end 'again'
		exitBlocking()
		if failed(got) 'failed'
			return 0
		end 'failed'
		return got
	end 'readStandardInput'

	function stdoutIsCharacterDevice() returns bool
		let stat = alloc(linuxStatBytes)
		let result = __Raw.syscall2(linuxSysFstat, arg1: stdoutFd, arg2: stat)
		let mode = __Raw.loadWord32(stat, offset: linuxStatModeOffset)
		free(stat)
		return not failed(result) and (mode and linuxModeTypeMask) == linuxModeCharacter
	end 'stdoutIsCharacterDevice'
#endif
