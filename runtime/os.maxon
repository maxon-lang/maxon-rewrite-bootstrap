// writeContent writes a file whole, as osWriteTextMode and osWriteBinaryMode do, and ends the entry.
function writeContent(path String, data Count, length Count, executable bool, errorAddress Count)
	let osError = writeFile(path, data: data, length: length, executable: executable)
	endWithError(errorAddress, osError: osError, table: writeFailures())
end 'writeContent'

// osWriteTextMode replaces a file with a string. A file that it creates gets the executable mode when executable is set.
function osWriteTextMode(path String, content String, executable bool, errorAddress Count)
	writeContent(path, data: __Raw.stringBytes(content), length: __Raw.stringLength(content), executable: executable, errorAddress: errorAddress)
end 'osWriteTextMode'

// osWriteBinaryMode replaces a file with the bytes of a byte array, as osWriteTextMode does.
function osWriteBinaryMode(path String, content Count, executable bool, errorAddress Count)
	let data = __Raw.loadWord(content, offset: osBytesDataOffset)
	let length = __Raw.loadWord(content, offset: osBytesLengthOffset)
	writeContent(path, data: data, length: length, executable: executable, errorAddress: errorAddress)
end 'osWriteBinaryMode'

// osWriteText and osWriteBinary are entries of the seed's table, which holds the runtime it compiles to every entry it
// names (E3004), though no compiler since it calls them; they go with the next seed.
function osWriteText(path String, content String, errorAddress Count)
	osWriteTextMode(path, content: content, executable: false, errorAddress: errorAddress)
end 'osWriteText'

function osWriteBinary(path String, content Count, errorAddress Count)
	osWriteBinaryMode(path, content: content, executable: false, errorAddress: errorAddress)
end 'osWriteBinary'

// osReadText is the whole content of a file as a String: the bytes of readFileRoom, which each system has its own.
function osReadText(path String, errorAddress Count) returns String
	var length = 0 as Count
	let room = readFileRoom(path, lengthAddress: __Raw.addressOf(length), errorAddress: errorAddress)
	if __Raw.loadWord(errorAddress, offset: 0) != 0 'failed'
		return noString()
	end 'failed'
	return stringOfRoom(room, length: length)
end 'osReadText'

// osReadBinary is the whole content of a file as a new byte array, read as osReadText reads it: the bytes of the string room
// are copied to the array and the room is freed.
function osReadBinary(path String, errorAddress Count) returns Count
	var length = 0 as Count
	let room = readFileRoom(path, lengthAddress: __Raw.addressOf(length), errorAddress: errorAddress)
	if __Raw.loadWord(errorAddress, offset: 0) != 0 'failed'
		return 0
	end 'failed'
	let bytes = bytesNew()
	if length > 0 'some'
		copyBytes(room, target: collectionExtend(bytes, count: length, elementBytes: byteBytes), count: length)
	end 'some'
	__Raw.freeStringRoom(room)
	return bytes
end 'osReadBinary'

