// The OS entries for files, directories, paths, the environment and the command line. On Windows each calls Win32's `W`
// functions with UTF-16 that it converts from the program's UTF-8 (text.maxon), and on Linux the kernel (linux.maxon), and
// each reports a failure so: an entry that can fail takes last the address of a word of the caller's, which it sets to the
// case of the error that the operation throws plus 1, or to 0 when it did not fail. What such an entry returns on a failure
// is nothing to read.

// What the entries read of an array and of a byte array until the array routines' layouts are in layout.maxon.
let osArrayHeaderBytes = 24 as Count

let osArrayLengthOffset = 0 as Count

let osArrayCapacityOffset = 8 as Count

let osArrayDataOffset = 16 as Count

let osArrayLimit = 0x100000000

let osBytesLengthOffset = 0 as Count

let osBytesDataOffset = 16 as Count

#if os(Windows)
	// The Win32 values the entries use.
	let genericRead = 0x80000000

	let genericWrite = 0x40000000

	let fileShareRead = 1

	let noSharing = 0

	let createNew = 1

	let createAlways = 2

	let openExisting = 3

	let fileAttributeNormal = 0x80

	let fileAttributeDirectory = 0x10

	let invalidHandle = 0xFFFFFFFFFFFFFFFF as Count

	let invalidFileAttributes = 0xFFFFFFFF

	let moveFileReplaceExisting = 1

	let dwordMask = 0xFFFFFFFF

	// dwordBits is the width of a DWORD, which the high half of a 64-bit quantity that Windows gives in two is shifted by.
	let dwordBits = 32

	let noSecurity = 0

	let noTemplate = 0

	let noTarget = 0

	let noBytes = 0

	// The Win32 errors that are told apart, and the failures they are.
	let win32FileNotFound = 2

	let win32PathNotFound = 3

	let win32AccessDenied = 5

	let win32SharingViolation = 32

	let win32FileExists = 80

	let win32DirNotEmpty = 145
#endif

let failureNotFound = 0

let failureAccessDenied = 1

let failureBusy = 2

let failureAlreadyExists = 3

let failureOther = 4

// caseBits is the width of the field of a failure's case in a table of failures.
let caseBits = 8

let caseMask = 0xFF

// caseSpan is the number of values a field of a table of failures takes.
let caseSpan = 256

// The cases of the errors that the entries throw, by their position in the enum.
let pathInvalidCharacter = 0

let pathUnavailable = 0

let variableUnset = 1

let readNotFound = 0

let readAccessDenied = 1

let readBusy = 2

let readFailed = 3

let writeFailed = 0

let writeNotFound = 1

let writeAccessDenied = 2

let writeAlreadyExists = 3

let writeBusy = 4

let writePartialFileLeft = 5

let renameFailed = 0

let renameNotFound = 1

let renameAccessDenied = 2

let renameBusy = 3

let renameAlreadyExists = 4

let deleteNotFound = 0

let deleteAccessDenied = 1

let deleteBusy = 2

let deleteFailed = 3

let infoNotFound = 0

let infoAccessDenied = 1

let infoBusy = 2

let infoFailed = 3

let listNotFound = 0

let listAccessDenied = 1

let listFailed = 2

let directoryDeleteNotFound = 0

let directoryDeleteNotEmpty = 1

let directoryDeleteFailed = 2

// The bits of the attributes word that osFileInfo gives, which lowering reads FileInfo's flags from.
let infoDirectoryFlag = 1

let infoReadOnlyFlag = 2

// infoNotReportedFlag is set when the system does not say when the file was made, which Linux's file systems may not.
let infoNotReportedFlag = 4

#if os(Windows)
	// What FilePath.from refuses: the control characters and these. A path's native separator is a backslash.
	let lastControlByte = 31

	let invalidPathBytes = "<>\"|?*"

	let pathSeparator = 0x5C

	let otherSeparator = 0x2F

	// pipePrefix is how a path that names a named pipe starts, as isPipePath reads it: backslashes and a lower-case pipe.
	let pipePrefix = "\\\\.\\pipe\\"

	let pipePrefixBytes = 9 as Count

	let asciiUpperA = 0x41

	let asciiUpperZ = 0x5A

	let asciiCaseOffset = 0x20

	let dotByte = 0x2E

	let listPatternSuffix = "\\*"

	// WIN32_FIND_DATAW: the size of the structure, and where it holds the entry's name.
	let findDataBytes = 592

	let findDataNameOffset = 44

	// Where WIN32_FIND_DATAW holds the attributes (a DWORD), the three FILETIMEs and the two halves of the size, the high
	// one first. The FILETIMEs sit at offsets that are not multiples of 8, which a word load on x64 does not mind.
	let findDataAttributesOffset = 0

	let findDataCreatedOffset = 4

	let findDataAccessedOffset = 12

	let findDataModifiedOffset = 20

	let findDataSizeHighOffset = 28

	let findDataSizeLowOffset = 32

	let fileAttributeReadOnly = 0x1

	// A FILETIME counts 100-nanosecond ticks from 1601: these make it Unix seconds.
	let fileTimeTicksPerSecond = 10000000

	let fileTimeTicksFrom1601To1970 = 116444736000000000

	// longPathUnits is the longest path Windows has, which a buffer for the executable's path or the working directory is
	// made to hold.
	let longPathUnits = 32768

	// maxEnvironmentReads is how many times a variable's value is read again when it grows between the call that sizes it
	// and the one that reads it.
	let maxEnvironmentReads = 4
#endif

#if os(Windows)
	// win32Error is the error of the last Win32 call that failed.
	function win32Error() returns Count
		return __Raw.callImport0("GetLastError")
	end 'win32Error'

	// dword is the low 32 bits of what a Win32 function returns, which is all that a DWORD or a BOOL has.
	function dword(value Count) returns Count
		return value and dwordMask
	end 'dword'

	function closeHandle(handle Count)
		_ = __Raw.callImport1("CloseHandle", arg1: handle)
	end 'closeHandle'
#endif

// Failure is one of the failures above.
typealias Failure = int(0 to 4)

// FailureCase is a case of an error enum, which a table of failures keeps a field of caseBits for.
typealias FailureCase = int(0 to 255)

#if os(Windows)
	// failureOf is the failure that a Win32 error is.
	function failureOf(win32 Count) returns Failure
		if win32 == win32FileNotFound or win32 == win32PathNotFound 'missing'
			return failureNotFound
		end 'missing'
		if win32 == win32AccessDenied 'denied'
			return failureAccessDenied
		end 'denied'
		if win32 == win32SharingViolation 'busy'
			return failureBusy
		end 'busy'
		if win32 == win32FileExists or win32 == win32DirNotEmpty 'exists'
			return failureAlreadyExists
		end 'exists'
		return failureOther
	end 'failureOf'
#endif

// failureCases is a table of the case that each failure is for one operation, a field of caseBits for each failure.
function failureCases(notFound FailureCase, accessDenied FailureCase, busy FailureCase, alreadyExists FailureCase, other FailureCase) returns Count
	let low = notFound + accessDenied * caseSpan + busy * caseSpan * caseSpan
	return low + alreadyExists * caseSpan * caseSpan * caseSpan + other * caseSpan * caseSpan * caseSpan * caseSpan
end 'failureCases'

function readFailures() returns Count
	return failureCases(readNotFound, accessDenied: readAccessDenied, busy: readBusy, alreadyExists: readFailed, other: readFailed)
end 'readFailures'

function writeFailures() returns Count
	return failureCases(writeNotFound, accessDenied: writeAccessDenied, busy: writeBusy, alreadyExists: writeAlreadyExists, other: writeFailed)
end 'writeFailures'

function renameFailures() returns Count
	return failureCases(renameNotFound, accessDenied: renameAccessDenied, busy: renameBusy, alreadyExists: renameAlreadyExists, other: renameFailed)
end 'renameFailures'

function deleteFailures() returns Count
	return failureCases(deleteNotFound, accessDenied: deleteAccessDenied, busy: deleteBusy, alreadyExists: deleteFailed, other: deleteFailed)
end 'deleteFailures'

function infoFailures() returns Count
	return failureCases(infoNotFound, accessDenied: infoAccessDenied, busy: infoBusy, alreadyExists: infoFailed, other: infoFailed)
end 'infoFailures'

function listFailures() returns Count
	return failureCases(listNotFound, accessDenied: listAccessDenied, busy: listFailed, alreadyExists: listFailed, other: listFailed)
end 'listFailures'

// directoryDeleteFailures is the table of Directory.delete: a directory that still holds an entry is the failure that a name
// already taken is, which is how every system tells it.
function directoryDeleteFailures() returns Count
	return failureCases(directoryDeleteNotFound, accessDenied: directoryDeleteFailed, busy: directoryDeleteFailed, alreadyExists: directoryDeleteNotEmpty, other: directoryDeleteFailed)
end 'directoryDeleteFailures'

// endDirectoryDelete ends osDeleteDirectory on a system whose rmdir answers ENOTDIR both for a path that is a file or a link
// and for one that passes through a file: Directory.delete says deleteFailed for the first and notFound for the second, as
// RemoveDirectoryW tells them apart, so a path that has a status is the first.
function endDirectoryDelete(errorAddress Count, osError Count, notDirectory Count, path String)
	if osError == notDirectory and osExists(path) 'file'
		failWith(errorAddress, errorCase: directoryDeleteFailed)
		return
	end 'file'
	if osError == notDirectory 'throughFile'
		failWith(errorAddress, errorCase: directoryDeleteNotFound)
		return
	end 'throughFile'
	endWithError(errorAddress, osError: osError, table: directoryDeleteFailures())
end 'endDirectoryDelete'

// succeed clears the error word of an entry that did not fail.
function succeed(errorAddress Count)
	__Raw.storeWord(errorAddress, offset: 0, value: 0)
end 'succeed'

// failWith sets the error word of an entry to a case of its error.
function failWith(errorAddress Count, errorCase Count)
	__Raw.storeWord(errorAddress, offset: 0, value: __Raw.wrappingAdd(errorCase, right: 1))
end 'failWith'

// endWithError ends an entry that did one call of the system: it did not fail when the system's error, a Win32 error or
// an errno, is 0, and otherwise it fails with the case that the failure of the error has in a table.
function endWithError(errorAddress Count, osError Count, table Count)
	if osError == 0 'none'
		succeed(errorAddress)
		return
	end 'none'
	failWith(errorAddress, errorCase: (table shr (failureOf(osError) * caseBits)) and caseMask)
end 'endWithError'

// noString is what an entry that returns a string gives when it failed: a literal, which nothing frees.
function noString() returns String
	return ""
end 'noString'

// stringArrayNew is a new array with no strings.
function stringArrayNew() returns Count
	return alloc(osArrayHeaderBytes)
end 'stringArrayNew'

// stringArrayPush puts the string that owns room (__Raw.stringRoom) of a length at the end of an array of strings, which
// grows by the growth policy (arrays.maxon).
function stringArrayPush(array Count, room Count, textLength Count)
	let elementBytes = __Raw.stringSize()
	let length = __Raw.loadWord(array, offset: osArrayLengthOffset)
	let capacity = __Raw.loadWord(array, offset: osArrayCapacityOffset)
	if length >= osArrayLimit 'outside'
		panic("array too long to build")
	end 'outside'
	if length == capacity 'grow'
		let grown = grownCapacity(capacity, required: length + 1)
		let data = alloc(collectionBytes(grown, elementBytes: elementBytes))
		let old = __Raw.loadWord(array, offset: osArrayDataOffset)
		if length != 0 'some'
			copyBytes(old, target: data, count: collectionBytes(length, elementBytes: elementBytes))
		end 'some'
		free(old)
		__Raw.storeWord(array, offset: osArrayDataOffset, value: data)
		__Raw.storeWord(array, offset: osArrayCapacityOffset, value: grown)
	end 'grow'
	let data = __Raw.loadWord(array, offset: osArrayDataOffset)
	storeOwnedString(data, offset: collectionBytes(length, elementBytes: elementBytes), bytes: room, length: textLength, ascii: false)
	__Raw.storeWord(array, offset: osArrayLengthOffset, value: length + 1)
end 'stringArrayPush'

// pushBytes puts a new string of a copy of a number of bytes at an address at the end of an array of strings.
function pushBytes(array Count, address Count, length Count)
	let room = __Raw.stringRoom(length)
	if length != 0 'some'
		copyBytes(address, target: room, count: length)
	end 'some'
	stringArrayPush(array, room: room, textLength: length)
end 'pushBytes'

// nanosPerSecond is what a count of whole seconds is scaled to.
let nanosPerSecond = 1000000000 as Count

// osClockMillis is the monotonic clock in whole milliseconds.
function osClockMillis() returns Count
	return osClockNanos() / nanosPerMilli
end 'osClockMillis'

// osUnixSeconds is the whole seconds since 1970-01-01 UTC.
function osUnixSeconds() returns Count
	return osUnixNanos() / nanosPerSecond
end 'osUnixSeconds'

// fileTimeAtUnixEpoch is 1970-01-01 in FILETIME's 100 ns steps since 1601-01-01, and nanosPerFileTimeStep the nanoseconds
// of one step.
let fileTimeAtUnixEpoch = 116444736000000000 as Count

let nanosPerFileTimeStep = 100 as Count

#if os(Windows)
	// osArgs is the program's arguments, the program's own name first, as the command line splits by the C runtime's rules.
	function osArgs() returns Count
		let wideLine = __Raw.callImport0("GetCommandLineW")
		let units = wideLength(wideLine)
		if units >= textUnitLimit 'outside'
			panic("command line too long to split")
		end 'outside'
		let line = alloc(units * maxUtf8BytesPerUnit + 1)
		let length = utf8FromUtf16(wideLine, units: units, dst: line)
		let scratch = alloc(__Raw.wrappingAdd(length, right: wordBytes))
		let args = stringArrayNew()
		var position = skipSeparators(line, length: length, position: 0)
		while position < length 'each'
			let next = scanArgument(line, length: length, position: position, scratch: scratch)
			pushBytes(args, address: __Raw.wrappingAdd(scratch, right: wordBytes), length: __Raw.loadWord(scratch, offset: 0))
			position = skipSeparators(line, length: length, position: next)
		end 'each'
		free(scratch)
		free(line)
		return args
	end 'osArgs'

	// osEnvironmentVariable is the value of a variable of the environment, which a variable that is not set has none of.
	function osEnvironmentVariable(name String, errorAddress Count) returns String
		let wideName = wideOf(name)
		var capacity = dword(__Raw.callImport3("GetEnvironmentVariableW", arg1: wideName, arg2: noBytes, arg3: 0))
		var reads = 0 as Count
		while capacity != 0 and reads < maxEnvironmentReads 'read'
			if capacity >= textUnitLimit 'outside'
				panic("environment variable too long to read")
			end 'outside'
			let value = alloc(capacity * wideUnitBytes)
			let units = dword(__Raw.callImport3("GetEnvironmentVariableW", arg1: wideName, arg2: value, arg3: capacity))
			if units < capacity 'fits'
				let text = stringOfUnits(value, units: units)
				free(value)
				free(wideName)
				succeed(errorAddress)
				return text
			end 'fits'
			free(value)
			capacity = units
			reads = reads + 1
		end 'read'
		free(wideName)
		failWith(errorAddress, errorCase: variableUnset)
		return noString()
	end 'osEnvironmentVariable'

	// osEnvironmentBytes writes the first bytes of the value of a variable to room, as UTF-8, at most capacity of them, and
	// gives how many: 0 for a variable that is not set and for an empty one. Unlike osEnvironmentVariable it allocates nothing
	// from the program's heap: its working memory is the runtime's own.
	function osEnvironmentBytes(name String, room Count, capacity Count) returns Count
		let nameLength = __Raw.stringLength(name)
		if nameLength >= textUnitLimit 'outside'
			panic("environment variable name too long to read")
		end 'outside'
		let nameBytes = (nameLength + 1) * wideUnitBytes
		let wideName = keep(nameBytes)
		_ = utf16FromUtf8(__Raw.stringBytes(name), byteLength: nameLength, dst: wideName)
		var length = 0 as Count
		var needed = dword(__Raw.callImport3("GetEnvironmentVariableW", arg1: wideName, arg2: noBytes, arg3: 0))
		var reads = 0 as Count
		while needed != 0 and reads < maxEnvironmentReads 'read'
			if needed >= textUnitLimit 'outside'
				panic("environment variable too long to read")
			end 'outside'
			let valueBytes = needed * wideUnitBytes
			let blockBytes = valueBytes + needed * maxUtf8BytesPerUnit
			let block = keep(blockBytes)
			let units = dword(__Raw.callImport3("GetEnvironmentVariableW", arg1: wideName, arg2: block, arg3: needed))
			if units < needed 'fits'
				let staging = __Raw.wrappingAdd(block, right: valueBytes)
				length = utf8FromUtf16(block, units: units, dst: staging)
				if length > capacity 'long'
					length = capacity
				end 'long'
				if length != 0 'some'
					copyBytes(staging, target: room, count: length)
				end 'some'
				needed = 0
			end 'fits' else 'grown'
				needed = units
				reads = reads + 1
			end 'grown'
			unkeep(block, bytes: blockBytes)
		end 'read'
		unkeep(wideName, bytes: nameBytes)
		return length
	end 'osEnvironmentBytes'

	// osExecutablePath is the full path of the running executable, which Windows may not be able to give.
	function osExecutablePath(errorAddress Count) returns String
		let buffer = alloc(longPathUnits * wideUnitBytes)
		enterBlocking()
		let units = dword(__Raw.callImport3("GetModuleFileNameW", arg1: noBytes, arg2: buffer, arg3: longPathUnits))
		exitBlocking()
		if units == 0 or units == longPathUnits 'failed'
			free(buffer)
			failWith(errorAddress, errorCase: pathUnavailable)
			return noString()
		end 'failed'
		let text = stringOfUnits(buffer, units: units)
		free(buffer)
		succeed(errorAddress)
		return text
	end 'osExecutablePath'

	// osCurrentPath is the working directory, which stops the program when Windows cannot give it.
	function osCurrentPath() returns String
		let buffer = alloc(longPathUnits * wideUnitBytes)
		enterBlocking()
		let units = dword(__Raw.callImport2("GetCurrentDirectoryW", arg1: longPathUnits, arg2: buffer))
		exitBlocking()
		if units == 0 or units >= longPathUnits 'failed'
			free(buffer)
			panic("Directory.currentPath: GetCurrentDirectory failed")
		end 'failed'
		let text = stringOfUnits(buffer, units: units)
		free(buffer)
		return text
	end 'osCurrentPath'

	// The clocks that a program reads bracket their calls into kernel32: the monitor never stops a thread in a DLL's code, so
	// a green thread that reads the clock over and over would seldom take its ask, and in the bracket the monitor takes its
	// processor instead once it has held it for a slice (retake).

	// osClockNanos is the monotonic clock in nanoseconds.
	function osClockNanos() returns Count
		enterBlocking()
		let nanos = monotonicNanos()
		exitBlocking()
		return nanos
	end 'osClockNanos'

	// monotonicNanos is the monotonic clock in nanoseconds as the runtime's own code reads it, outside any bracket, from the
	// performance counter. The seconds and the remainder of a second are scaled apart so that neither product passes a word
	// whatever the counter's rate is.
	function monotonicNanos() returns Count
		var ticks = 0 as Count
		var frequency = 0 as Count
		_ = __Raw.callImport1("QueryPerformanceFrequency", arg1: __Raw.addressOf(frequency))
		_ = __Raw.callImport1("QueryPerformanceCounter", arg1: __Raw.addressOf(ticks))
		if frequency <= 0 'unreadable'
			panic("the performance counter has no frequency")
		end 'unreadable'
		let wholeSeconds = ticks / frequency
		let remainder = ticks mod frequency
		let wholeNanos = try wholeSeconds * nanosPerSecond otherwise panic("the monotonic clock is past a word of nanoseconds")
		let partNanos = try remainder * nanosPerSecond otherwise panic("the performance counter's rate is past a word of nanoseconds")
		return try wholeNanos + partNanos / frequency otherwise panic("the monotonic clock is past a word of nanoseconds")
	end 'monotonicNanos'

	// osTickMillis is the milliseconds since the machine booted.
	function osTickMillis() returns Count
		enterBlocking()
		let millis = __Raw.callImport0("GetTickCount64")
		exitBlocking()
		return millis
	end 'osTickMillis'

	// threadCpuTime is the CPU cycles the running thread has used, which is the unit that maxon's clock gives on Windows, as
	// the runtime's own code reads it, outside any bracket, on the thread whose context is context.
	function threadCpuTime(context Count) returns Count
		return threadCycles(__Raw.callImport0("GetCurrentThread"))
	end 'threadCpuTime'

	// noCycles is what threadCycles gives when the system does not count a thread's cycles.
	let noCycles = 0 as Count

	// threadCycles is the count of CPU cycles a thread has run, from a handle with the access to query it.
	function threadCycles(handle Count) returns Count
		var cycles = noCycles
		if __Raw.callImport2("QueryThreadCycleTime", arg1: handle, arg2: __Raw.addressOf(cycles)) == 0 'unread'
			return noCycles
		end 'unread'
		return cycles
	end 'threadCycles'

	// osUnixNanos is the nanoseconds since 1970-01-01 UTC, from the calendar's FILETIME, the 100 ns steps since 1601.
	function osUnixNanos() returns Count
		var fileTime = 0 as Count
		enterBlocking()
		_ = __Raw.callImport1("GetSystemTimePreciseAsFileTime", arg1: __Raw.addressOf(fileTime))
		exitBlocking()
		return try (__Raw.wrappingSub(fileTime, right: fileTimeAtUnixEpoch)) * nanosPerFileTimeStep otherwise panic("the calendar is past a word of nanoseconds")
	end 'osUnixNanos'

	// osProcessId is the id of the running process, which Windows answers as a DWORD.
	function osProcessId() returns Count
		return dword(__Raw.callImport0("GetCurrentProcessId"))
	end 'osProcessId'

	// belowNormalPriorityClass is BELOW_NORMAL_PRIORITY_CLASS, which a process inherits to the processes it starts.
	let belowNormalPriorityClass = 0x4000 as Count

	// osEnterBackgroundPriority lowers the process's priority class and answers the class that Windows reports then, which is a
	// second reading of it and not the value written.
	function osEnterBackgroundPriority() returns Count
		let process = __Raw.callImport0("GetCurrentProcess")
		_ = __Raw.callImport2("SetPriorityClass", arg1: process, arg2: belowNormalPriorityClass)
		return dword(__Raw.callImport1("GetPriorityClass", arg1: process))
	end 'osEnterBackgroundPriority'

	// The form in which a path reaches Win32, as maxon's runtime gives it. Win32 reads a path of 260 units or more, and one
	// with a `.` or `..` part, only in the extended form that begins \\?\, which it takes as it is. So a path of
	// extendedPathThresholdUnits or more, and a path that is not rooted at a drive or a share, is resolved to its full path
	// first, and a full path of that length or more takes the prefix. A path of the device form is never resolved, since
	// GetFullPathNameW would collapse a `..` even inside \\?\.
	let extendedPathThresholdUnits = 248 as Count

	let extendedPrefix = "\\\\?\\"

	let extendedSharePrefix = "\\\\?\\UNC\\"

	// extendedPrefixUnits is the length of extendedPrefix.
	let extendedPrefixUnits = 4 as Count

	// shareSkippedUnits is how many units of a share's path the extended form drops: \\server becomes \\?\UNC\server.
	let shareSkippedUnits = 2 as Count

	// extendedPrefixSlackUnits is how many units more than the full path the buffer of its extension holds: the longer of the
	// two prefixes, less the units a share drops.
	let extendedPrefixSlackUnits = 6 as Count

	// rootProbeUnits is how many units a drive's or a share's root is read from.
	let rootProbeUnits = 3 as Count

	let questionMarkByte = 0x3F

	// maxPathReads is how many times a full path is read again when the working directory grows between the call that sizes it
	// and the one that reads it.
	let maxPathReads = 4 as Count

	// The kinds of root that a path has (widePathRootOf).
	let widePathRelative = 0 as Count

	let widePathDrive = 1 as Count

	let widePathShare = 2 as Count

	let widePathDevice = 3 as Count

	// isSeparatorUnit is whether a unit is either separator.
	function isSeparatorUnit(unit Count) returns bool
		return unit == pathSeparator or unit == otherSeparator
	end 'isSeparatorUnit'

	// isLetterUnit is whether a unit is a letter of the alphabet, in either case.
	function isLetterUnit(unit Count) returns bool
		let folded = unit or asciiCaseOffset
		return folded >= asciiUpperA + asciiCaseOffset and folded <= asciiUpperZ + asciiCaseOffset
	end 'isLetterUnit'

	// hasDevicePrefix is whether a zero-terminated UTF-16 path of units units begins \\?\ or \\.\.
	function hasDevicePrefix(text Count, units Count) returns bool
		if units < extendedPrefixUnits 'short'
			return false
		end 'short'
		let marker = unitAt(text, index: 2)
		return unitAt(text, index: 0) == pathSeparator and unitAt(text, index: 1) == pathSeparator and (marker == questionMarkByte or marker == dotByte) and unitAt(text, index: 3) == pathSeparator
	end 'hasDevicePrefix'

	// widePathRootOf is the kind of root that a zero-terminated UTF-16 path of units units has: widePathDevice for \\?\ or
	// \\.\, widePathShare for two separators, widePathDrive for a letter, a colon and a separator, and otherwise
	// widePathRelative.
	function widePathRootOf(text Count, units Count) returns Count
		if hasDevicePrefix(text, units: units) 'device'
			return widePathDevice
		end 'device'
		if units < rootProbeUnits 'short'
			return widePathRelative
		end 'short'
		let first = unitAt(text, index: 0)
		let second = unitAt(text, index: 1)
		if isSeparatorUnit(first) and isSeparatorUnit(second) 'share'
			return widePathShare
		end 'share'
		if isLetterUnit(first) and second == driveColonByte and isSeparatorUnit(unitAt(text, index: 2)) 'drive'
			return widePathDrive
		end 'drive'
		return widePathRelative
	end 'widePathRootOf'

	// fullWidePath is a new zero-terminated UTF-16 full path of the zero-terminated UTF-16 path at an address, in a buffer that
	// holds slack units more than the text, or 0 when Windows gives none.
	function fullWidePath(wide Count, slack Count) returns Count
		var needed = dword(__Raw.callImport4("GetFullPathNameW", arg1: wide, arg2: 0, arg3: 0, arg4: 0))
		var reads = 0 as Count
		while needed != 0 and reads < maxPathReads 'read'
			let capacity = __Raw.wrappingAdd(needed, right: slack)
			if capacity >= textUnitLimit 'outside'
				return 0
			end 'outside'
			let buffer = alloc(capacity * wideUnitBytes)
			let written = dword(__Raw.callImport4("GetFullPathNameW", arg1: wide, arg2: capacity, arg3: buffer, arg4: 0))
			if written != 0 and __Raw.wrappingAdd(written, right: slack) < capacity 'fits'
