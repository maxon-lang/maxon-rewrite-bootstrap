	// and gives whether the directory is there after it. A directory that is there already fails to be made, which is no
	// matter.
	function osCreateDirectory(path String) returns bool
		let widePath = widePathOf(path)
		let units = wideLength(widePath)
		for i in 1 upto units 'prefixes'
			let unit = unitAt(widePath, index: i)
			if unit == pathSeparator or unit == otherSeparator 'separator'
				storeUnit(widePath, index: i, value: 0)
				createDirectoryAt(widePath)
				storeUnit(widePath, index: i, value: unit)
			end 'separator'
		end 'prefixes'
		createDirectoryAt(widePath)
		let there = directoryAt(widePath)
		free(widePath)
		return there
	end 'osCreateDirectory'

	// isDotEntry is whether the name of a directory entry is `.` or `..`, which a listing leaves out.
	function isDotEntry(name Count, units Count) returns bool
		if units == 1 'one'
			return unitAt(name, index: 0) == dotByte
		end 'one'
		return units == 2 and unitAt(name, index: 0) == dotByte and unitAt(name, index: 1) == dotByte
	end 'isDotEntry'

	// pushEntryPath puts a new string of the path joined to the name of an entry at the end of an array of strings: a
	// separator goes between them unless the path is empty or ends with one.
	function pushEntryPath(entries Count, path String, name Count, units Count)
		let pathLength = __Raw.stringLength(path)
		let pathBytes = __Raw.stringBytes(path)
		let separate = pathLength != 0 and __Raw.loadByte(pathBytes, offset: __Raw.wrappingSub(pathLength, right: 1)) != pathSeparator
		if units >= textUnitLimit 'outside'
			panic("entry name too long to list")
		end 'outside'
		let bytes = __Raw.stringRoom(__Raw.wrappingAdd(__Raw.wrappingAdd(pathLength, right: 1), right: units * maxUtf8BytesPerUnit))
		if pathLength != 0 'path'
			copyBytes(pathBytes, target: bytes, count: pathLength)
		end 'path'
		var at = pathLength
		if separate 'separator'
			at = storeNextByte(bytes, offset: at, value: pathSeparator)
		end 'separator'
		at = __Raw.wrappingAdd(at, right: utf8FromUtf16(name, units: units, dst: __Raw.wrappingAdd(bytes, right: at)))
		stringArrayPush(entries, room: bytes, textLength: at)
	end 'pushEntryPath'

	// osList is the path joined to the name of each entry of a directory, `.` and `..` left out, in the order Windows gives.
	function osList(path String, errorAddress Count) returns Count
		let pattern = concat(path, right: listPatternSuffix)
		let widePattern = widePathOf(pattern)
		let findData = alloc(findDataBytes)
		var win32 = 0 as Count
		let search = findFirst(widePattern, findData: findData, win32Address: __Raw.addressOf(win32))
		if search == invalidHandle 'open'
			free(widePattern)
			free(findData)
			endWithError(errorAddress, osError: win32, table: listFailures())
			return noBox
		end 'open'
		free(widePattern)
		let entries = stringArrayNew()
		let name = __Raw.wrappingAdd(findData, right: findDataNameOffset)
		var more = true
		while more 'entries'
			let units = wideLength(name)
			if not isDotEntry(name, units: units) 'entry'
				pushEntryPath(entries, path: path, name: name, units: units)
			end 'entry'
			enterBlocking()
			more = dword(__Raw.callImport2("FindNextFileW", arg1: search, arg2: findData)) != 0
			exitBlocking()
		end 'entries'
		_ = __Raw.callImport1("FindClose", arg1: search)
		free(findData)
		succeed(errorAddress)
		return entries
	end 'osList'
#endif
