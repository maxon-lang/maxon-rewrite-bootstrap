// Running a program on macOS: posix_spawn makes the child with each standard stream the write end of an output pipe, the read end
// of a pipe that the run writes the input into as the child reads it, a file, the null device, or the run's own, every other fd
// closed in it (POSIX_SPAWN_CLOEXEC_DEFAULT), and says itself whether the program could be executed. The child's environment is the
// run's own or a block of the caller's, and it leads a process group of its own (POSIX_SPAWN_SETPGROUP), which ends the tree it
// starts (subprocess.maxon: endTree). The run reads the output pipes, writes
// the input and watches for the child's exit (the kqueue's
// EVFILT_PROC with NOTE_EXIT, eventProcessNew) through the event queue (subprocess.maxon), and then waits for the child, which
// returns at once.

#if os(macOS)
	// The run's record, one allocation: the ends of the three pipes as eventChildPipe makes them (the read end then the write
	// end, a word each), the fds opened for the streams that are files, and the run's wait (subprocess.maxon).
	let runOutputPipeOffset = 0 as Count

	let runErrorPipeOffset = (runOutputPipeOffset + pipeEndBytes) as Count

	let runInputPipeOffset = (runErrorPipeOffset + pipeEndBytes) as Count

	let runStreamFilesOffset = (runInputPipeOffset + pipeEndBytes) as Count

	let runWaitOffset = (runStreamFilesOffset + streamFilesBytes) as Count

	let runRecordBytes = (runWaitOffset + waitBytes) as Count

	let stdoutFd = 1

	let stderrFd = 2

	// The separator of the directories of PATH, which a program named without a directory is looked for in.
	let searchPathVariable = "PATH"

	let searchPathSeparator = 0x3A as Byte

	// isProgramAt is whether a zero-terminated path names a file that is not a directory.
	function isProgramAt(cPath Count) returns bool
		let stat = newStat()
		let result = statCString(cPath, stat: stat)
		let directory = statIsDirectory(stat)
		free(stat)
		return not failed(result) and not directory
	end 'isProgramAt'

	// joinedPath is a new zero-terminated path of the bytes of a directory, a separator and a name.
	function joinedPath(directory Count, directoryLength Count, name Count, nameLength Count) returns Count
		let path = alloc(__Raw.wrappingAdd(__Raw.wrappingAdd(directoryLength, right: nameLength), right: 2))
		if directoryLength != 0 'directory'
			copyBytes(directory, target: path, count: directoryLength)
		end 'directory'
		let at = storeNextByte(path, offset: directoryLength, value: slashByte)
		if nameLength != 0 'name'
			copyBytes(name, target: __Raw.wrappingAdd(path, right: at), count: nameLength)
		end 'name'
		return path
	end 'joinedPath'

	// programPath is a new zero-terminated path of the program that an executable names, its bytes and length: the name itself
	// when it holds a separator, and otherwise the first directory of PATH that holds a program of the name, as execvp looks; 0
	// when there is none.
	function programPath(name Count, nameLength Count) returns Count
		for i in 0 upto nameLength 'separator'
			if __Raw.loadByte(name, offset: i) == slashByte 'path'
				return cStringOfBytes(name, length: nameLength)
			end 'path'
		end 'separator'
		var unset = 0 as Count
		let search = osEnvironmentVariable(searchPathVariable, errorAddress: __Raw.addressOf(unset))
		if unset != 0 'noSearch'
			return 0
		end 'noSearch'
		let searchBytes = __Raw.stringBytes(search)
		let searchLength = __Raw.stringLength(search)
		var start = 0 as Count
		while start <= searchLength 'directories'
			var stop = start
			while stop < searchLength and __Raw.loadByte(searchBytes, offset: stop) != searchPathSeparator 'directory'
				stop = stop + 1
			end 'directory'
			let candidate = joinedPath(__Raw.wrappingAdd(searchBytes, right: start), directoryLength: __Raw.wrappingSub(stop, right: start), name: name, nameLength: nameLength)
			if isProgramAt(candidate) 'found'
				return candidate
			end 'found'
			free(candidate)
			start = __Raw.wrappingAdd(stop, right: 1)
		end 'directories'
		return 0
	end 'programPath'

	// openPipes makes the pipes of a run that the set of pipes names, and gives whether it made them all; a pipe it could not make
	// leaves those before it closed.
	function openPipes(run Count, pipes Count) returns bool
		return openRunPipes(fieldAt(run, offset: runWaitOffset), output: fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
	end 'openPipes'

	// reap waits for the child to end and gives its wait status.
	function reap(run Count, pid Count) returns Count
		let status = fieldAt(fieldAt(run, offset: runWaitOffset), offset: waitStatusOffset)
		while true 'wait'
			let result = waitChild(pid, status: status, options: noWaitOptions)
			if not interrupted(result) 'done'
				return __Raw.loadWord32(status, offset: 0)
			end 'done'
		end 'wait'
		return 0
	end 'reap'

	// orphanEnded is whether a child that nothing waits for has ended, which it waits for if so: without waiting for one that has
	// not, and a pid that is not a child of this process, one that something else waited for, is gone.
	function orphanEnded(pid Count) returns bool
		let result = waitChild(pid, status: 0, options: waitNoHang)
		if failed(result) 'refused'
			return not interrupted(result)
		end 'refused'
		return result == pid
	end 'orphanEnded'

	// orphanReap waits for a child that nothing waits for, whose exit the kqueue reported or which has started to exit, and ends
	// with it: the kqueue reports NOTE_EXIT before waitpid can take the child, so the one wait here blocks for the moment the exit
	// takes, as the reap of a child that a wait found exiting does.
	function orphanReap(pid Count)
		while true 'wait'
			let result = waitChild(pid, status: 0, options: noWaitOptions)
			if not interrupted(result) 'done'
				return
			end 'done'
		end 'wait'
	end 'orphanReap'

	// orphanArmed is whether the kqueue watches the process of an orphan's entry, and not that it has started to exit.
	function orphanArmed(entry Count) returns bool
		return processArm(entry)
	end 'orphanArmed'

	// orphanClose takes the exit filter of an orphan's entry off the kqueue, where the exit has not removed it.
	function orphanClose(scheduler Count, entry Count)
		entryUnregister(scheduler, entry: entry)
	end 'orphanClose'

	// childExited is whether the child has exited, which it waits for if so, its wait status kept in the wait. A wake of the
	// exit's entry proves nothing either way: the entry may hold an event of its last owner, and the kqueue reports NOTE_EXIT as
	// the child starts to exit, before waitpid can take it. So a child that waitpid does not yet find ended is watched again
	// (processArm): one still running is reported when it exits, and one that the kqueue refuses has started to exit and is
	// waited for, which returns as soon as it has ended.
	function childExited(wait Count, child Count) returns bool
		if isReaped(wait) or childWaited(wait, child: child, options: waitNoHang) 'ended'
			return true
		end 'ended'
		if processArm(wordAt(wait, offset: waitProcessOffset)) 'watched'
			return false
		end 'watched'
		enterBlocking()
		let waited = childWaited(wait, child: child, options: noWaitOptions)
		exitBlocking()
		return waited
	end 'childExited'

	// childWaited waits for the child with the options of waitpid, its wait status kept in the wait, and gives whether it had
	// ended (and it is waited for then): a child that has not been waited for may always be.
	function childWaited(wait Count, child Count, options Count) returns bool
		let status = fieldAt(wait, offset: waitStatusOffset)
		while true 'wait'
			let result = waitChild(child, status: status, options: options)
			if interrupted(result) 'again'
				continue 'wait'
			end 'again'
			if failed(result) 'refused'
				panic("cannot wait for a child that has not been waited for")
			end 'refused'
			if result == child 'ended'
				markReaped(wait)
			end 'ended'
			return result == child
		end 'wait'
		return false
	end 'childWaited'

	let stdinFd = 0

	// waitChild waits for a child to end, or with waitNoHang asks whether it has, its wait status at an address, and gives its pid,
	// 0 for a child that has not, or -errno.
	function waitChild(pid Count, status Count, options Count) returns Count
		return checkedInt(__Raw.callImport3("waitpid", arg1: pid, arg2: status, arg3: options))
	end 'waitChild'

	// signalGroup sends a signal to the process group that the child leads, which the child's pid names, and gives 0 or -errno.
	function signalGroup(pid Count, signal Count) returns Count
		return checkedInt(__Raw.callImport2("kill", arg1: __Raw.wrappingSub(0, right: pid), arg2: signal))
	end 'signalGroup'

	// noSuchGroup is whether the result of signalGroup says that the group has no member.
	function noSuchGroup(result Count) returns bool
		return failed(result) and errnoOf(result) == macosEsrch
	end 'noSuchGroup'

	// openStreamFile is the fd of the file that the bytes of a path name, open to read an existing file, or made or emptied for
	// writing, or -errno.
	function openStreamFile(path Count, length Count, forWrite bool) returns Count
		if forWrite 'write'
			return openPathBytes(path, length: length, flags: macosOpenReplace, mode: macosFileMode)
		end 'write'
		return openPathBytes(path, length: length, flags: macosOpenReadOnly, mode: 0)
	end 'openStreamFile'

	// reapChild waits for a child that has not run, or that is ended, and gives its wait status.
	function reapChild(run Count, pid Count) returns Count
		enterBlocking()
		let status = reap(run, pid: pid)
		exitBlocking()
		return status
	end 'reapChild'

	// newRun is a new run: a record whose wait has no entries.
	function newRun() returns Count
		let run = alloc(runRecordBytes)
		waitNew(fieldAt(run, offset: runWaitOffset))
		return run
	end 'newRun'

	// waitOf is the wait of a run, which awaitChild serves.
	function waitOf(run Count) returns Count
		return fieldAt(run, offset: runWaitOffset)
	end 'waitOf'

	// nullDeviceFlags is O_RDWR | O_CLOEXEC, which the null device is opened with: a stream of the child's that is none or
	// discarded is the file actions' copy of it.
	let nullDeviceFlags = macosOpenReadOnly or 2

	let nullDevicePath = "/dev/null"

	// startChild starts the child that a request describes in the run, and gives 0, or the failure of the step that failed, with
	// every pipe and fd it made closed. The zero-terminated copy of the directory is freed before it returns, on every way out.
	function startChild(request Count, run Count) returns Count
		let wait = fieldAt(run, offset: runWaitOffset)
		let blob = wordAt(request, offset: requestArgvOffset)
		let program = programPath(blob, nameLength: terminatedLength(blob))
		if program == 0 'missing'
			return systemFailure(failureStepProgram, code: macosEnoent)
		end 'missing'
		let pipes = pipesOf(request)
		let inputKind = wordAt(request, offset: requestInputKindOffset)
		let outputKind = wordAt(request, offset: requestOutputKindOffset)
		let errorKind = wordAt(request, offset: requestErrorKindOffset)
		prepareRun(wait, request: request)
		if not openPipes(run, pipes: pipes) 'pipes'
			free(program)
			return setupFailure()
		end 'pipes'
		let files = fieldAt(run, offset: runStreamFilesOffset)
		let unfiled = openStreamFiles(request, files: files)
		if unfiled != 0 'unfiled'
			closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
			closeOurEnds(wait)
			free(program)
			return unfiled
		end 'unfiled'
		var nullFd = noFd
		if inputKind == spawnStdinNone or outputKind == spawnOutputDiscard or errorKind == spawnOutputDiscard 'nulled'
			nullFd = openPath(nullDevicePath, flags: nullDeviceFlags, mode: 0)
			if failed(nullFd) 'unopened'
				let failure = systemFailure(failureStepStream, code: errnoOf(nullFd))
				closeStreamFiles(files)
				closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
				closeOurEnds(wait)
				free(program)
				return failure
			end 'unopened'
		end 'nulled'
		let vector = argumentVector(blob, argc: wordAt(request, offset: requestArgcOffset))
		let own = ownEnvironment(request)
		var envp = environment()
		if own != 0 'ownBlock'
			envp = own
		end 'ownBlock'
		var start = noDirectory as Count
		let directoryLength = wordAt(request, offset: requestDirectoryLengthOffset)
		if directoryLength != 0 'directory'
			start = cStringOfBytes(wordAt(request, offset: requestDirectoryOffset), length: directoryLength)
		end 'directory'
		let pid = spawnChild(run, request: request, path: program, vector: vector, directory: start, nullFd: nullFd, envp: envp)
		// posix_spawn gives a directory it cannot move to the not-found codes of a missing program, so a refusal is the directory's
		// when the directory is not one.
		var failedStep = failureStepProgram
		if failed(pid) and start != noDirectory and not directoryAt(start) 'unmoved'
			failedStep = failureStepDirectory
		end 'unmoved'
		if start != noDirectory 'started'
			free(start)
		end 'started'
		if own != 0 'freeBlock'
			free(own)
		end 'freeBlock'
		free(vector)
		free(program)
		closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
		closeStreamFiles(files)
		if nullFd != noFd 'closeNull'
			closeFd(nullFd)
		end 'closeNull'
		if failed(pid) 'spawn'
			closeOurEnds(wait)
			return systemFailure(failedStep, code: errnoOf(pid))
		end 'spawn'
		if isDetached(request) 'left'
			__Raw.storeWord(wait, offset: waitPidOffset, value: pid)
			return 0
		end 'left'
		let watch = eventProcessNew(pid)
		if watch == noEntry 'unwatched'
			endAndReap(run, pid: pid)
			closeOurEnds(wait)
			return setupFailure()
		end 'unwatched'
		__Raw.storeWord(wait, offset: waitChildOffset, value: pid)
		__Raw.storeWord(wait, offset: waitProcessOffset, value: watch)
		__Raw.storeWord(wait, offset: waitPidOffset, value: pid)
		return 0
	end 'startChild'

	// abandonRun ends a child that no wait has taken, with the processes of its group, and gives up what the run holds of it: its
	// exit's entry, its pid, which is waited for unless a kill of its tree did, and the ends of its pipes.
	function abandonRun(run Count)
		let wait = waitOf(run)
		let pid = wordAt(wait, offset: waitChildOffset)
		eventProcessFree(wordAt(wait, offset: waitProcessOffset))
		endAndReap(run, pid: pid)
		closeOurEnds(wait)
	end 'abandonRun'

	// finishRun gives back what a child holds once its wait has ended, which on macOS is nothing: the pid was waited for.
	function finishRun(run Count)
	end 'finishRun'

	// win32CodeOf is an errno in the words of Win32 that maxon's runtime uses on every system: a file or a directory that is not
	// there, access that is refused and a table of files that is full are the codes of Windows that say so; any other errno is
	// ERROR_GEN_FAILURE.
	function win32CodeOf(errno Count) returns Count
		if errno == macosEnoent 'missing'
			return codeFileNotFound
		end 'missing'
		if errno == macosEnotdir 'notDirectory'
			return codePathNotFound
		end 'notDirectory'
		if errno == macosEacces or errno == macosEperm 'denied'
			return codeAccessDenied
		end 'denied'
		if errno == errnoTooManyFiles or errno == errnoFileTableOverflow 'full'
			return codeTooManyOpenFiles
		end 'full'
		return codeGeneralFailure
	end 'win32CodeOf'

	// The errnos of a table of files that is full.
	let errnoTooManyFiles = 24

	let errnoFileTableOverflow = 23

	// resolveProgram is the program that a name asks for, as a new zero-terminated path, or 0 when there is none: the name's own
	// lookup (programPath), as execvp does.
	function resolveProgram(name Count, length Count) returns Count
		return programPath(name, nameLength: length)
	end 'resolveProgram'

	// noDirectory is the directory of a child that starts in the run's working directory.
	let noDirectory = 0

	// firstFailure is the failure of the first call of a setup that failed: the failure so far, or else the error that the next call
	// gave, which is 0 or an errno itself.
	function firstFailure(failure Count, result Count) returns Count
		if failure != 0 'failed'
			return failure
		end 'failed'
		return intResult(result)
	end 'firstFailure'

	// addStream adds the file action that makes the child's fd of a stream what its kind says: an end of the run's pipe for a collected
	// stream, the fd the child already has for one that is inherited (which the spawn closes unless told), the file the run opened
	// for one that is a file, and the null device that the run opened for the others. It gives 0 or the error of the action.
	function addStream(actions Count, fd Count, kind Count, collected Count, inherited Count, pipeEnd Count, nullFd Count, file Count, fileFd Count) returns Count
		if kind == collected 'collected'
			return intResult(__Raw.callImport3("posix_spawn_file_actions_adddup2", arg1: actions, arg2: pipeEnd, arg3: fd))
		end 'collected'
		if kind == inherited 'inherited'
			return intResult(__Raw.callImport2("posix_spawn_file_actions_addinherit_np", arg1: actions, arg2: fd))
		end 'inherited'
		if kind == file 'file'
			return intResult(__Raw.callImport3("posix_spawn_file_actions_adddup2", arg1: actions, arg2: fileFd, arg3: fd))
		end 'file'
		return intResult(__Raw.callImport3("posix_spawn_file_actions_adddup2", arg1: actions, arg2: nullFd, arg3: fd))
	end 'addStream'

	// spawnWith fills the file actions and the attributes of the run's child, whose standard streams are what the request's kinds
	// say, which leads a process group of its own (a session of its own, where it is detached), moves to the zero-terminated directory unless that is noDirectory and executes
	// the program with the environment that the vector of its entries is, and spawns it. It gives its pid, or -errno of the first
	// step that failed: a file action or an attribute that is refused fails the spawn, as posix_spawn's own refusal does.
	function spawnWith(run Count, request Count, path Count, vector Count, directory Count, nullFd Count, envp Count, actions Count, attributes Count) returns Count
		let files = fieldAt(run, offset: runStreamFilesOffset)
		var failure = addStream(actions, fd: stdoutFd, kind: wordAt(request, offset: requestOutputKindOffset), collected: spawnOutputCollect, inherited: spawnOutputInherit, pipeEnd: endOf(fieldAt(run, offset: runOutputPipeOffset), writeEnd: true), nullFd: nullFd, file: spawnOutputFile, fileFd: wordAt(files, offset: streamOutputFileOffset))
		failure = firstFailure(failure, result: addStream(actions, fd: stderrFd, kind: wordAt(request, offset: requestErrorKindOffset), collected: spawnOutputCollect, inherited: spawnOutputInherit, pipeEnd: endOf(fieldAt(run, offset: runErrorPipeOffset), writeEnd: true), nullFd: nullFd, file: spawnOutputFile, fileFd: wordAt(files, offset: streamErrorFileOffset)))
		failure = firstFailure(failure, result: addStream(actions, fd: stdinFd, kind: wordAt(request, offset: requestInputKindOffset), collected: spawnStdinBytes, inherited: spawnStdinInherit, pipeEnd: endOf(fieldAt(run, offset: runInputPipeOffset), writeEnd: false), nullFd: nullFd, file: spawnStdinFile, fileFd: wordAt(files, offset: streamInputFileOffset)))
		if directory != noDirectory 'directory'
			failure = firstFailure(failure, result: __Raw.callImport2("posix_spawn_file_actions_addchdir_np", arg1: actions, arg2: directory))
		end 'directory'
		if isDetached(request) 'detached'
			failure = firstFailure(failure, result: __Raw.callImport2("posix_spawnattr_setflags", arg1: attributes, arg2: macosSpawnCloexecDefault or macosSpawnSetSid))
		end 'detached' else 'attached'
			failure = firstFailure(failure, result: __Raw.callImport2("posix_spawnattr_setflags", arg1: attributes, arg2: macosSpawnCloexecDefault or macosSpawnSetPgroup))
			failure = firstFailure(failure, result: __Raw.callImport2("posix_spawnattr_setpgroup", arg1: attributes, arg2: 0))
		end 'attached'
		if failure != 0 'refused'
			return __Raw.wrappingSub(0, right: failure)
		end 'refused'
		// posix_spawn writes a pid_t, 32 bits, into the word's lower half.
		var pid = 0 as Count
		let error = intResult(__Raw.callImport6("posix_spawn", arg1: __Raw.addressOf(pid), arg2: path, arg3: actions, arg4: attributes, arg5: vector, arg6: envp))
		if error != 0 'spawn'
			return __Raw.wrappingSub(0, right: error)
		end 'spawn'
		return pid
	end 'spawnWith'

	// spawnChild spawns the run's child (spawnWith) with file actions and attributes that it makes and gives back, and gives its pid, or
	// -errno of the step that failed, a refused init included.
	function spawnChild(run Count, request Count, path Count, vector Count, directory Count, nullFd Count, envp Count) returns Count
		let actions = alloc(macosSpawnObjectBytes)
		let attributes = alloc(macosSpawnObjectBytes)
		var result = 0 as Count
		let actionsError = intResult(__Raw.callImport1("posix_spawn_file_actions_init", arg1: actions))
		if actionsError != 0 'actionsRefused'
			result = __Raw.wrappingSub(0, right: actionsError)
		end 'actionsRefused' else 'actionsMade'
			let attributesError = intResult(__Raw.callImport1("posix_spawnattr_init", arg1: attributes))
			if attributesError != 0 'attributesRefused'
				result = __Raw.wrappingSub(0, right: attributesError)
			end 'attributesRefused' else 'attributesMade'
				result = spawnWith(run, request: request, path: path, vector: vector, directory: directory, nullFd: nullFd, envp: envp, actions: actions, attributes: attributes)
				_ = __Raw.callImport1("posix_spawnattr_destroy", arg1: attributes)
			end 'attributesMade'
			_ = __Raw.callImport1("posix_spawn_file_actions_destroy", arg1: actions)
		end 'actionsMade'
		free(actions)
		free(attributes)
		return result
	end 'spawnChild'
#endif
