// Running a program on macOS: posix_spawn makes the child with each standard stream the write end of an output pipe, the read end
// of a pipe that the run writes the input into as the child reads it, the null device, or the run's own, every other fd closed in
// it (POSIX_SPAWN_CLOEXEC_DEFAULT), and says itself whether the program could be executed. The run reads the output pipes, writes
// the input and watches for the child's exit (the kqueue's
// EVFILT_PROC with NOTE_EXIT, eventProcessNew) through the event queue (subprocess.maxon), and then waits for the child, which
// returns at once.

#if os(macOS)
	// The run's record, one allocation: the ends of the three pipes as eventChildPipe makes them (the read end then the write
	// end, a word each), and the run's wait (subprocess.maxon).
	let runOutputPipeOffset = 0 as Count

	let runErrorPipeOffset = (runOutputPipeOffset + pipeEndBytes) as Count

	let runInputPipeOffset = (runErrorPipeOffset + pipeEndBytes) as Count

	let runWaitOffset = (runInputPipeOffset + pipeEndBytes) as Count

	let runRecordBytes = (runWaitOffset + waitBytes) as Count

	let stdoutFd = 1

	let stderrFd = 2

	// Decoding a wait status: the low seven bits are the signal that ended the child, 0 when it exited, with its code in
	// the eight bits after them; a child that a signal ended reports 128 plus the signal, the POSIX shell's convention, as
	// maxon's runtime does.
	let waitSignalMask = 0x7F

	let waitExitShift = 8

	let waitExitMask = 0xFF

	let signalExitCodeBase = 128

	let noWaitOptions = 0

	let waitNoHang = 1

	// The separator of the directories of PATH, which a program named without a directory is looked for in.
	let searchPathVariable = "PATH"

	let searchPathSeparator = 0x3A as Byte

	// isProgramAt is whether a zero-terminated path names a file that is not a directory.
	function isProgramAt(cPath Count) returns bool
		let stat = newStat()
		let result = statCString(cPath, stat: stat)
		let directory = statIsDirectory(stat)
		free(stat)
		return not failed(result) and not directory
	end 'isProgramAt'

	// joinedPath is a new zero-terminated path of the bytes of a directory, a separator and a name.
	function joinedPath(directory Count, directoryLength Count, name Count, nameLength Count) returns Count
		let path = alloc(__Raw.wrappingAdd(__Raw.wrappingAdd(directoryLength, right: nameLength), right: 2))
		if directoryLength != 0 'directory'
			copyBytes(directory, target: path, count: directoryLength)
		end 'directory'
		let at = storeNextByte(path, offset: directoryLength, value: slashByte)
		if nameLength != 0 'name'
			copyBytes(name, target: __Raw.wrappingAdd(path, right: at), count: nameLength)
		end 'name'
		return path
	end 'joinedPath'

	// programPath is a new zero-terminated path of the program that an executable names, its bytes and length: the name itself
	// when it holds a separator, and otherwise the first directory of PATH that holds a program of the name, as execvp looks; 0
	// when there is none.
	function programPath(name Count, nameLength Count) returns Count
		for i in 0 upto nameLength 'separator'
			if __Raw.loadByte(name, offset: i) == slashByte 'path'
				return cStringOfBytes(name, length: nameLength)
			end 'path'
		end 'separator'
		var unset = 0 as Count
		let search = osEnvironmentVariable(searchPathVariable, errorAddress: __Raw.addressOf(unset))
		if unset != 0 'noSearch'
			return 0
		end 'noSearch'
		let searchBytes = __Raw.stringBytes(search)
		let searchLength = __Raw.stringLength(search)
		var start = 0 as Count
		while start <= searchLength 'directories'
			var stop = start
			while stop < searchLength and __Raw.loadByte(searchBytes, offset: stop) != searchPathSeparator 'directory'
				stop = stop + 1
			end 'directory'
			let candidate = joinedPath(__Raw.wrappingAdd(searchBytes, right: start), directoryLength: __Raw.wrappingSub(stop, right: start), name: name, nameLength: nameLength)
			if isProgramAt(candidate) 'found'
				return candidate
			end 'found'
			free(candidate)
			start = __Raw.wrappingAdd(stop, right: 1)
		end 'directories'
		return 0
	end 'programPath'

	// argumentVector is a new null-ended vector of the addresses of the argc tokens of a blob, each already ended by a NUL, as
	// posix_spawn reads it; it is the caller's to free, and holds no copy of the blob, which must stay until the spawn returns.
	function argumentVector(blob Count, argc Count) returns Count
		let vector = alloc(try (argc + 1) * wordBytes otherwise panic("too many arguments for memory"))
		var offset = 0 as Count
		for i in 0 upto argc 'tokens'
			__Raw.storeWord(vector, offset: try i * wordBytes otherwise panic("too many arguments for memory"), value: __Raw.wrappingAdd(blob, right: offset))
			offset = __Raw.wrappingAdd(offset, right: __Raw.wrappingAdd(terminatedLength(__Raw.wrappingAdd(blob, right: offset)), right: 1))
		end 'tokens'
		return vector
	end 'argumentVector'

	// openPipes makes the pipes of a run that the set of pipes names, and gives whether it made them all; a pipe it could not make
	// leaves those before it closed.
	function openPipes(run Count, pipes Count) returns bool
		return openRunPipes(fieldAt(run, offset: runWaitOffset), output: fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
	end 'openPipes'

	// reap waits for the child to end and gives its wait status.
	function reap(run Count, pid Count) returns Count
		let status = fieldAt(fieldAt(run, offset: runWaitOffset), offset: waitStatusOffset)
		while true 'wait'
			let result = waitChild(pid, status: status, options: noWaitOptions)
			if not interrupted(result) 'done'
				return __Raw.loadWord32(status, offset: 0)
			end 'done'
		end 'wait'
		return 0
	end 'reap'

	// childExited is whether the child has exited, which it waits for if so, its wait status kept in the wait. A wake of the
	// exit's entry proves nothing either way: the entry may hold an event of its last owner, and the kqueue reports NOTE_EXIT as
	// the child starts to exit, before waitpid can take it. So a child that waitpid does not yet find ended is watched again
	// (processArm): one still running is reported when it exits, and one that the kqueue refuses has started to exit and is
	// waited for, which returns as soon as it has ended.
	function childExited(wait Count, child Count) returns bool
		if childWaited(wait, child: child, options: waitNoHang) 'ended'
			return true
		end 'ended'
		if processArm(wordAt(wait, offset: waitProcessOffset)) 'watched'
			return false
		end 'watched'
		enterBlocking()
		let waited = childWaited(wait, child: child, options: noWaitOptions)
		exitBlocking()
		return waited
	end 'childExited'

	// childWaited waits for the child with the options of waitpid, its wait status kept in the wait, and gives whether it had
	// ended: a child that has not been waited for may always be.
	function childWaited(wait Count, child Count, options Count) returns bool
		let status = fieldAt(wait, offset: waitStatusOffset)
		while true 'wait'
			let result = waitChild(child, status: status, options: options)
			if interrupted(result) 'again'
				continue 'wait'
			end 'again'
			if failed(result) 'refused'
				panic("cannot wait for a child that has not been waited for")
			end 'refused'
			return result == child
		end 'wait'
		return false
	end 'childWaited'

	// exitCodeOf is the exit code that a wait status says.
	function exitCodeOf(status Count) returns Count
		let signal = status and waitSignalMask
		if signal != 0 'signalled'
			return signalExitCodeBase + signal
		end 'signalled'
		return (status shr waitExitShift) and waitExitMask
	end 'exitCodeOf'

	let stdinFd = 0

	// waitChild waits for a child to end, or with waitNoHang asks whether it has, its wait status at an address, and gives its pid,
	// 0 for a child that has not, or -errno.
	function waitChild(pid Count, status Count, options Count) returns Count
		return checkedInt(__Raw.callImport3("waitpid", arg1: pid, arg2: status, arg3: options))
	end 'waitChild'

	// killChild ends a child that is still running when its deadline passes.
	function killChild(pid Count)
		_ = __Raw.callImport2("kill", arg1: pid, arg2: macosSigkill)
	end 'killChild'

	// reapChild waits for a child that has not run, or that is ended, and gives its wait status.
	function reapChild(run Count, pid Count) returns Count
		enterBlocking()
		let status = reap(run, pid: pid)
		exitBlocking()
		return status
	end 'reapChild'

	// newRun is a new run: a record whose wait has no entries.
	function newRun() returns Count
		let run = alloc(runRecordBytes)
		waitNew(fieldAt(run, offset: runWaitOffset))
		return run
	end 'newRun'

	// waitOf is the wait of a run, which awaitChild serves.
	function waitOf(run Count) returns Count
		return fieldAt(run, offset: runWaitOffset)
	end 'waitOf'

	// nullDeviceFlags is O_RDWR | O_CLOEXEC, which the null device is opened with: a stream of the child's that is none or
	// discarded is the file actions' copy of it.
	let nullDeviceFlags = macosOpenReadOnly or 2

	let nullDevicePath = "/dev/null"

	// startChild starts the child that a request describes in the run, and gives 0, or the failure of the step that failed, with
	// every pipe and fd it made closed. The zero-terminated copy of the directory is freed before it returns, on every way out.
	function startChild(request Count, run Count) returns Count
		let wait = fieldAt(run, offset: runWaitOffset)
		let blob = wordAt(request, offset: requestArgvOffset)
		let program = programPath(blob, nameLength: terminatedLength(blob))
		if program == 0 'missing'
			return systemFailure(failureStepProgram, code: macosEnoent)
		end 'missing'
		let pipes = pipesOf(request)
		let inputKind = wordAt(request, offset: requestInputKindOffset)
		let outputKind = wordAt(request, offset: requestOutputKindOffset)
		let errorKind = wordAt(request, offset: requestErrorKindOffset)
		prepareRun(wait, request: request)
		if not openPipes(run, pipes: pipes) 'pipes'
			free(program)
			return setupFailure()
		end 'pipes'
		var nullFd = noFd
		if inputKind == spawnStdinNone or outputKind == spawnOutputDiscard or errorKind == spawnOutputDiscard 'nulled'
			nullFd = openPath(nullDevicePath, flags: nullDeviceFlags, mode: 0)
			if failed(nullFd) 'unopened'
				let failure = systemFailure(failureStepStream, code: errnoOf(nullFd))
				closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
				closeOurEnds(wait)
				free(program)
				return failure
			end 'unopened'
		end 'nulled'
		let vector = argumentVector(blob, argc: wordAt(request, offset: requestArgcOffset))
		var start = noDirectory as Count
		let directoryLength = wordAt(request, offset: requestDirectoryLengthOffset)
		if directoryLength != 0 'directory'
			start = cStringOfBytes(wordAt(request, offset: requestDirectoryOffset), length: directoryLength)
		end 'directory'
		let pid = spawnChild(run, request: request, path: program, vector: vector, directory: start, nullFd: nullFd)
		if start != noDirectory 'started'
			free(start)
		end 'started'
		free(vector)
		free(program)
		closeChildEnds(fieldAt(run, offset: runOutputPipeOffset), errors: fieldAt(run, offset: runErrorPipeOffset), input: fieldAt(run, offset: runInputPipeOffset), pipes: pipes)
		if nullFd != noFd 'closeNull'
			closeFd(nullFd)
		end 'closeNull'
		if failed(pid) 'spawn'
			closeOurEnds(wait)
			return systemFailure(failureStepProgram, code: errnoOf(pid))
		end 'spawn'
		let watch = eventProcessNew(pid)
		if watch == noEntry 'unwatched'
			killChild(pid)
			_ = reapChild(run, pid: pid)
			closeOurEnds(wait)
			return setupFailure()
		end 'unwatched'
		__Raw.storeWord(wait, offset: waitChildOffset, value: pid)
		__Raw.storeWord(wait, offset: waitProcessOffset, value: watch)
		__Raw.storeWord(wait, offset: waitPidOffset, value: pid)
		return 0
	end 'startChild'

	// abandonRun ends a child that no wait has taken and gives up what the run holds of it: its exit's entry, its pid, which is
	// waited for, and the ends of its pipes.
	function abandonRun(run Count)
		let wait = waitOf(run)
		let pid = wordAt(wait, offset: waitChildOffset)
		eventProcessFree(wordAt(wait, offset: waitProcessOffset))
		killChild(pid)
		_ = reapChild(run, pid: pid)
		closeOurEnds(wait)
	end 'abandonRun'

	// finishRun gives back what a child holds once its wait has ended, which on macOS is nothing: the pid was waited for.
	function finishRun(run Count)
	end 'finishRun'

	// statusKindOf is how a child ended that a wait status says: a child that a signal ended is signalled.
	function statusKindOf(status Count) returns Count
		if (status and waitSignalMask) != 0 'signalled'
			return resultSignalled
		end 'signalled'
		return resultExited
	end 'statusKindOf'

	// statusCodeOf is the code of how a child ended: the signal's number for a child that a signal ended, and the exit code for
	// one that exited.
	function statusCodeOf(status Count) returns Count
		if (status and waitSignalMask) != 0 'signalled'
			return status and waitSignalMask
		end 'signalled'
		return (status shr waitExitShift) and waitExitMask
	end 'statusCodeOf'

	// win32CodeOf is an errno in the words of Win32 that maxon's runtime uses on every system: a file or a directory that is not
	// there, access that is refused and a table of files that is full are the codes of Windows that say so; any other errno is
	// ERROR_GEN_FAILURE.
	function win32CodeOf(errno Count) returns Count
		if errno == macosEnoent 'missing'
			return codeFileNotFound
		end 'missing'
		if errno == macosEnotdir 'notDirectory'
			return codePathNotFound
		end 'notDirectory'
		if errno == macosEacces or errno == macosEperm 'denied'
			return codeAccessDenied
		end 'denied'
		if errno == errnoTooManyFiles or errno == errnoFileTableOverflow 'full'
			return codeTooManyOpenFiles
		end 'full'
		return codeGeneralFailure
	end 'win32CodeOf'

	// The errnos of a table of files that is full.
	let errnoTooManyFiles = 24

	let errnoFileTableOverflow = 23

	// resolveProgram is the program that a name asks for, as a new zero-terminated path, or 0 when there is none: the name's own
	// lookup (programPath), as execvp does.
	function resolveProgram(name Count, length Count) returns Count
		return programPath(name, nameLength: length)
	end 'resolveProgram'

	// noDirectory is the directory of a child that starts in the run's working directory.
	let noDirectory = 0

	// addStream adds the file action that makes the child's fd of a stream what its kind says: an end of the run's pipe for a collected
	// stream, the fd the child already has for one that is inherited (which the spawn closes unless told), and the null device that
	// the run opened for the others.
	function addStream(actions Count, fd Count, kind Count, collected Count, inherited Count, pipeEnd Count, nullFd Count)
		if kind == collected 'collected'
			_ = __Raw.callImport3("posix_spawn_file_actions_adddup2", arg1: actions, arg2: pipeEnd, arg3: fd)
			return
		end 'collected'
		if kind == inherited 'inherited'
			_ = __Raw.callImport2("posix_spawn_file_actions_addinherit_np", arg1: actions, arg2: fd)
			return
		end 'inherited'
		_ = __Raw.callImport3("posix_spawn_file_actions_adddup2", arg1: actions, arg2: nullFd, arg3: fd)
	end 'addStream'

	// spawnChild spawns the run's child, whose standard streams are what the request's kinds say, which moves to the zero-terminated
	// directory unless that is noDirectory and executes the program, and gives its pid, or -errno where posix_spawn failed, which
	// gives the errno itself.
	function spawnChild(run Count, request Count, path Count, vector Count, directory Count, nullFd Count) returns Count
		let actions = alloc(macosSpawnObjectBytes)
		let attributes = alloc(macosSpawnObjectBytes)
		if intResult(__Raw.callImport1("posix_spawn_file_actions_init", arg1: actions)) != 0 'actions'
			panic("cannot make the file actions of a child")
		end 'actions'
		if intResult(__Raw.callImport1("posix_spawnattr_init", arg1: attributes)) != 0 'attributes'
			panic("cannot make the attributes of a child")
		end 'attributes'
		addStream(actions, fd: stdoutFd, kind: wordAt(request, offset: requestOutputKindOffset), collected: spawnOutputCollect, inherited: spawnOutputInherit, pipeEnd: endOf(fieldAt(run, offset: runOutputPipeOffset), writeEnd: true), nullFd: nullFd)
		addStream(actions, fd: stderrFd, kind: wordAt(request, offset: requestErrorKindOffset), collected: spawnOutputCollect, inherited: spawnOutputInherit, pipeEnd: endOf(fieldAt(run, offset: runErrorPipeOffset), writeEnd: true), nullFd: nullFd)
		addStream(actions, fd: stdinFd, kind: wordAt(request, offset: requestInputKindOffset), collected: spawnStdinBytes, inherited: spawnStdinInherit, pipeEnd: endOf(fieldAt(run, offset: runInputPipeOffset), writeEnd: false), nullFd: nullFd)
		if directory != noDirectory 'directory'
			_ = __Raw.callImport2("posix_spawn_file_actions_addchdir_np", arg1: actions, arg2: directory)
		end 'directory'
		_ = __Raw.callImport2("posix_spawnattr_setflags", arg1: attributes, arg2: macosSpawnCloexecDefault)
		// posix_spawn writes a pid_t, 32 bits, into the word's lower half.
		var pid = 0 as Count
		let error = intResult(__Raw.callImport6("posix_spawn", arg1: __Raw.addressOf(pid), arg2: path, arg3: actions, arg4: attributes, arg5: vector, arg6: environment()))
		_ = __Raw.callImport1("posix_spawn_file_actions_destroy", arg1: actions)
		_ = __Raw.callImport1("posix_spawnattr_destroy", arg1: attributes)
		free(actions)
		free(attributes)
		if error != 0 'refused'
			return __Raw.wrappingSub(0, right: error)
		end 'refused'
		return pid
	end 'spawnChild'
#endif
