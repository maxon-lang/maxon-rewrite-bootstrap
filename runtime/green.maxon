		return entry
	end 'green'
	let record = __Raw.wrappingSub(entry, right: behaviourEntryTag)
	let g = newGreen(context, code: __Raw.loadWord(record, offset: behaviourRunOffset), kind: greenBehaviour)
	__Raw.storeWord(g, offset: greenArgOffset, value: record)
	return g
end 'greenOf'

// parked is Go's park_m, the scheduler's half of a park: the green thread waits, unless a ready came while it switched, and
// then it runs next.
function parked(context Count, g Count)
