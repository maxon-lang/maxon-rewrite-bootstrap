// greenMain is the code a green thread's stack starts in (rt.greenStart, with the green thread): it runs the green
// thread's code, keeps the word that gave back, and finishes it, never to return.
function greenMain(g Count)
	let result = __Raw.callCode1(__Raw.loadWord(g, offset: greenCodeOffset), arg1: __Raw.loadWord(g, offset: greenArgOffset))
