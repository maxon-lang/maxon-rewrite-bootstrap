// Green threads (Go's g): a record (greenBytes) with the code it runs, its arguments, its status and the registers of its
// stack while it does not run, and a stack from a pool, taken when it first runs and given back when it finishes, so a
// green thread that is made and queued holds no stack. A thread runs one by switching from its scheduler's stack onto the
// green thread's (execute), and the green thread comes back by switching to its thread's scheduler with what it asks of
// it (the context's intent): to park it, to requeue it (a yield, or a preemption), to take it off a processor it lost in a
// blocking call, or to finish it. The scheduler does that on its own stack, once the green thread's registers are saved,
// so a green thread is never queued or readied while it still runs on its stack, as Go's mcall has it.
//
// Stacks never move, since a borrow is an address in a frame: each is a reserve of stackReserveBytes, the main thread's,
// that the system commits a page at a time, its lowest page a guard, so a stack overflow faults as a thread's does.
//
// Park and ready are Go's gopark and goready with a permit, so a ready that comes before its green thread has parked is
// not lost: ready makes a running green thread greenNotified, and its next park returns at once, consuming it.
//
// The API, which a test of the runtime calls and the language's async and await lower to (strand.maxon): greenSpawn(code)
// makes a green thread that runs code with itself as its one argument, greenSetArgument and greenArgument write and read
// its arguments, greenReady makes it runnable (after its arguments are written, as maxon's __gt_ready publishes last),
// greenAwait waits for it to finish and gives the word its code gave back, greenPark, greenYield, greenCurrent and
// greenSleep (timers.maxon).

// A green thread's status (greenStatusOffset).
let greenIdle = 0 as Count

let greenRunnable = 1 as Count

let greenRunning = 2 as Count

let greenWaiting = 3 as Count

let greenNotified = 4 as Count

let greenDead = 5 as Count

// A green thread's kind (greenKindOffset).
let greenBehaviour = 0 as Count

let greenAwaited = 1 as Count

// greenFinished is a green thread's waiter once it has finished: no record's address.
let greenFinished = 1 as Count

// noBehaviour is a green thread's handed behaviour when it has none (greenHandedOffset).
let noBehaviour = 0 as Count

// turnBehaviours is how many behaviours a green thread runs in one turn at most (runTurn), maxon's CownBatchMessages.
let turnBehaviours = 64 as Count

// What a green thread asks of its scheduler when it switches to it (contextIntentOffset).
let intentPark = 1 as Count

let intentYield = 2 as Count

let intentPreempted = 3 as Count

let intentFinish = 4 as Count

let intentNoProc = 5 as Count

// A processor keeps up to freeGreensKept free green threads' records and freeStacksKept free stacks, and sends half of
// them to the scheduler's lists when it has more, as Go's gfput does. A green thread's record is kept for good, as Go keeps
// its gs; a stack is not: the scheduler's list holds at most schedStacksKept, and a stack spilled past that goes back to
// the system, as Go's collector frees the stacks of the gs on its global free list, so a burst of green threads that
// parked leaves no stacks behind. Only a green thread that runs holds a record and a stack (a behaviour takes them when
// it starts, execute), so the pools hold what the peak of running and parked green threads used.
let freeGreensKept = 64 as Count

let freeStacksKept = 16 as Count

let schedStacksKept = 64 as Count

// stackKeptBytes is how much of a stack its last green thread may have committed for the stack to be pooled: one that grew
// past it goes back to the system when it is freed, as Go's gfput frees a stack that is not of the starting size, so the
// pages of one deep recursion do not stay committed in the pool. It is maxon's largest adaptive stack seed.
let stackKeptBytes = 65536 as Count

// newGreen is a green thread of a kind that runs code, not yet runnable: from the processor's free records, the
// scheduler's, or a new one. It counts among the live ones until it finishes.
function newGreen(context Count, code Count, kind Count) returns Count
	let scheduler = schedulerOf(context)
	let proc = __Raw.loadWord(context, offset: contextProcOffset)
	let g = takeFreeGreen(scheduler, proc: proc)
	__Raw.storeWord(g, offset: greenStatusOffset, value: greenIdle)
	__Raw.storeWord(g, offset: greenLinkOffset, value: noGreen)
	__Raw.storeWord(g, offset: greenStackOffset, value: noStack)
	__Raw.storeWord(g, offset: greenCodeOffset, value: code)
	__Raw.storeWord(g, offset: greenArgOffset, value: g)
	__Raw.storeWord(g, offset: greenResultOffset, value: 0)
	__Raw.storeWord(g, offset: greenWaiterOffset, value: noGreen)
	__Raw.storeWord(g, offset: greenKindOffset, value: kind)
	__Raw.storeWord(g, offset: greenPreemptOffset, value: unset)
	__Raw.storeWord(g, offset: greenStrandOffset, value: noGreen)
	__Raw.storeWord(g, offset: greenStrandHolderOffset, value: noGreen)
	__Raw.storeWord(g, offset: greenStrandHeadOffset, value: noGreen)
	__Raw.storeWord(g, offset: greenStrandTailOffset, value: noGreen)
	__Raw.storeWord(g, offset: greenStrandLockOffset, value: unset)
	__Raw.storeWord(g, offset: greenErrorOffset, value: 0)
	__Raw.storeWord(g, offset: greenCancelOffset, value: unset)
	__Raw.storeWord(g, offset: greenHandedOffset, value: noBehaviour)
	return g
end 'newGreen'

// greenSpawn makes a green thread that runs code, a function of one word, with the green thread itself, once it is
// readied, and counts it among the live ones, so the program does not end before it has finished.
function greenSpawn(code Count) returns Count
	let context = __Raw.threadContext()
	startMonitor(schedulerOf(context))
	stepLive(context, change: 1)
	return newGreen(context, code: code, kind: greenAwaited)
end 'greenSpawn'

// greenSetArgument writes a green thread's argument of an index, before it is readied.
function greenSetArgument(g Count, index Count, value Count)
	__Raw.storeWord(g, offset: greenArgumentOffset(index), value: value)
end 'greenSetArgument'

// greenArgument is a green thread's argument of an index.
function greenArgument(g Count, index Count) returns Count
	return __Raw.loadWord(g, offset: greenArgumentOffset(index))
end 'greenArgument'

function greenArgumentOffset(index Count) returns Count
	if index >= greenArgWords 'past'
		panic("a green thread has no argument of that index")
	end 'past'
	return __Raw.wrappingAdd(greenArgsOffset, right: index * wordBytes)
end 'greenArgumentOffset'

// greenCurrent is the green thread the running thread runs.
function greenCurrent() returns Count
	let g = __Raw.loadWord(__Raw.threadContext(), offset: contextGreenOffset)
	if g == noGreen 'off'
		panic("a green thread's operation is called off a green thread")
	end 'off'
	return g
end 'greenCurrent'

// greenReady makes a green thread runnable, or, when it runs and has not parked yet, has its next park return at once.
function greenReady(g Count)
	ready(__Raw.threadContext(), g: g)
end 'greenReady'

// greenPark parks the running green thread until a ready, which may have come already.
function greenPark()
	park(__Raw.threadContext())
end 'greenPark'

// greenYield is Go's Gosched: the running green thread goes to the global run queue, and its thread runs another. A member
// of a strand that others wait to run in gives them the strand first and runs again after them.
function greenYield()
	let context = __Raw.threadContext()
	let g = greenCurrent()
	let root = __Raw.loadWord(g, offset: greenStrandOffset)
	if root != noGreen and strandYield(context, root: root, g: g) 'strand'
		return
	end 'strand'
	switchToScheduler(context, intent: intentYield)
end 'greenYield'

// greenAwait waits for a green thread that greenSpawn made to finish, gives back the word its code gave back, and frees
// its record. The finish exchanges greenFinished into the waiter after it stored the result, so either the waiter is
// recorded before and readied by the finish, or it sees greenFinished.
function greenAwait(g Count) returns Count
	greenWait(g)
	return greenTake(g)
end 'greenAwait'

// greenWait waits for a green thread that greenSpawn made to finish, and leaves its record for greenTake.
function greenWait(g Count)
	let context = __Raw.threadContext()
	let waiter = greenCurrent()
	if __Raw.loadWord(g, offset: greenKindOffset) != greenAwaited 'kind'
		panic("a green thread that is not awaited is awaited")
	end 'kind'
	if __Raw.compareExchange(g, offset: greenWaiterOffset, expected: noGreen, desired: waiter) == noGreen 'wait'
		park(context)
		if __Raw.loadWord(g, offset: greenWaiterOffset) != greenFinished 'early'
			panic("a green thread that awaits another was readied before it finished")
		end 'early'
	end 'wait'
end 'greenWait'

// A waiter word may name a selector, the record of an awaitAny that waits on several promises at once (Go's select, whose
// one sudog every case shares), tagged with selectorTag: a box's address is a multiple of a word, and greenFinished and
// noGreen are no tagged address.
let selectorTag = 1 as Count

// noneFinished is what completedIn gives when no promise of the array has finished: no index, since an array's length
// is below it.
let noneFinished = 0xFFFFFFFFFFFFFFFF as Count

function isSelector(waiter Count) returns bool
	return waiter != greenFinished and (waiter and selectorTag) != 0
end 'isSelector'

// wakeWaiter is what a finish does for the waiter it exchanged greenFinished for: a green thread is readied, and a
// selector's green thread is, by the finish that claims it first; the finish then lets the selector go.
function wakeWaiter(context Count, waiter Count)
	if waiter == noGreen 'none'
		return
	end 'none'
	if isSelector(waiter) 'selector'
		let selector = __Raw.wrappingSub(waiter, right: selectorTag)
		if __Raw.compareExchange(selector, offset: selectorDoneOffset, expected: unset, desired: set) == unset 'first'
			ready(context, g: __Raw.loadWord(selector, offset: selectorGreenOffset))
		end 'first'
		releaseSelector(selector)
		return
	end 'selector'
	ready(context, g: waiter)
end 'wakeWaiter'

// releaseSelector lets a selector go, and frees it when nothing else holds it.
function releaseSelector(selector Count)
	if __Raw.atomicAdd(selector, offset: selectorRefsOffset, value: stepDown) == 1 'last'
		free(selector)
	end 'last'
end 'releaseSelector'

// asyncAwaitAny is maxon's awaitAny of an array of promises: it gives the index of the first that has finished, a slot
// that a take left empty holding none, and when none has it waits, registered as the waiter of each (Go's selectgo): the
// first finish readies it, and it takes itself off every promise before it looks again, so a later await of any finds no
// waiter. It consumes no promise. A promise that another waits for is a broken invariant, since only its owner awaits it.
function asyncAwaitAny(array Count) returns Count
	let found = completedIn(array)
	if found != noneFinished 'already'
		return found
	end 'already'
	let context = __Raw.threadContext()
	let selector = alloc(selectorBytes)
	__Raw.storeWord(selector, offset: selectorGreenOffset, value: greenCurrent())
	__Raw.storeWord(selector, offset: selectorDoneOffset, value: unset)
	__Raw.storeWord(selector, offset: selectorRefsOffset, value: 1)
	let tagged = __Raw.wrappingAdd(selector, right: selectorTag)
	let n = __Raw.loadWord(array, offset: arrayLengthOffset)
	var finishedEarly = false
	for i in 0 upto n 'register'
		let promise = promiseAt(array, index: i)
		if promise == noGreen 'empty'
			continue 'register'
		end 'empty'
		_ = __Raw.atomicAdd(selector, offset: selectorRefsOffset, value: 1)
		let was = __Raw.compareExchange(promise, offset: greenWaiterOffset, expected: noGreen, desired: tagged)
		if was == noGreen 'registered'
			continue 'register'
		end 'registered'
		_ = __Raw.atomicAdd(selector, offset: selectorRefsOffset, value: stepDown)
		if was != greenFinished 'waited'
			panic("a promise that awaitAny waits on has another waiter")
		end 'waited'
		finishedEarly = true
		break 'register'
	end 'register'
	// A finish that claimed the wake readies this green thread, which the park takes; one found finished while registering
	// claims it here, unless a finish claimed it first.
	if not finishedEarly or __Raw.compareExchange(selector, offset: selectorDoneOffset, expected: unset, desired: set) != unset 'wait'
		park(context)
	end 'wait'
	for i in 0 upto n 'deregister'
		let promise = promiseAt(array, index: i)
		if promise != noGreen and __Raw.compareExchange(promise, offset: greenWaiterOffset, expected: tagged, desired: noGreen) == tagged 'mine'
			releaseSelector(selector)
		end 'mine'
	end 'deregister'
	releaseSelector(selector)
	let after = completedIn(array)
	if after == noneFinished 'none'
		panic("awaitAny was woken with no promise finished")
	end 'none'
	return after
end 'asyncAwaitAny'

// completedIn is the index of the first promise of an array that has finished, or noneFinished.
function completedIn(array Count) returns Count
	let n = __Raw.loadWord(array, offset: arrayLengthOffset)
	for i in 0 upto n 'scan'
		let promise = promiseAt(array, index: i)
		if promise != noGreen and __Raw.atomicAdd(promise, offset: greenWaiterOffset, value: 0) == greenFinished 'finished'
			return i
		end 'finished'
	end 'scan'
	return noneFinished
end 'completedIn'

// promiseAt is the promise an array of them holds at an index, noGreen where a take left the slot empty.
function promiseAt(array Count, index Count) returns Count
	return __Raw.loadWord(__Raw.loadWord(array, offset: arrayDataOffset), offset: try index * wordBytes otherwise panic("an array past memory"))
end 'promiseAt'

// greenTake gives the word a green thread that greenWait waited for gave back, and frees its record.
function greenTake(g Count) returns Count
	let result = __Raw.loadWord(g, offset: greenResultOffset)
	let context = __Raw.threadContext()
	putFreeGreen(__Raw.loadWord(context, offset: contextSchedulerOffset), proc: __Raw.loadWord(context, offset: contextProcOffset), g: g)
	return result
end 'greenTake'

// ready is Go's goready: a parked or new green thread goes to runnext of the running thread's processor, and a thread is
// woken for an idle processor; a running one is notified instead.
function ready(context Count, g Count)
	if queueReady(context, g: g) 'queued'
		wakeProc(__Raw.loadWord(context, offset: contextSchedulerOffset))
	end 'queued'
end 'ready'

// queueReady is ready but for the wake: it queues a parked or new green thread on runnext of the running thread's
// processor, and says whether it did. mainRun readies main's green thread with it alone, as Go's newproc wakes no thread
// before main has started: the main thread runs it next, and there is nothing else to run yet.
function queueReady(context Count, g Count) returns bool
	if markReady(g) 'queue'
		runqPut(__Raw.loadWord(context, offset: contextProcOffset), g: g, next: true)
		return true
	end 'queue'
	return false
end 'queueReady'

// markReady moves a green thread's status for a ready and says whether the caller is to queue it: from parked or new to
// runnable, it is; from running to notified, or when a ready already came, it is not. The status is read by a locked add of
// 0, a full fence: what the readier stored before the ready (the condition the green thread waits on) must be seen by the
// green thread whenever the readier finds it runnable and leaves it so. A plain load could pass those stores on x64, see a
// runnable green thread that then starts, reads the old condition and parks, and the ready would be lost.
function markReady(g Count) returns bool
	while true 'status'
		let status = __Raw.atomicAdd(g, offset: greenStatusOffset, value: 0)
		if status == greenWaiting or status == greenIdle 'parked'
			if __Raw.compareExchange(g, offset: greenStatusOffset, expected: status, desired: greenRunnable) == status 'made'
				return true
			end 'made'
		end 'parked' else if status == greenRunning 'running'
			if __Raw.compareExchange(g, offset: greenStatusOffset, expected: greenRunning, desired: greenNotified) == greenRunning 'notified'
				return false
			end 'notified'
		end 'running' else if status == greenNotified or status == greenRunnable 'already'
			return false
		end 'already' else 'dead'
			panic("a green thread that finished is readied")
		end 'dead'
	end 'status'
	return false
end 'markReady'

// park is Go's gopark: the running green thread waits until a ready, unless one came already. A member of a strand gives
// the strand to the next member that waits to run while it waits, and runs again only once it holds the strand.
function park(context Count)
	let g = __Raw.loadWord(context, offset: contextGreenOffset)
	if g == noGreen 'off'
		panic("a park off a green thread")
	end 'off'
	let root = __Raw.loadWord(g, offset: greenStrandOffset)
	if root == noGreen 'alone'
		parkGreen(context, g: g)
		return
	end 'alone'
	strandRelease(context, root: root, g: g)
	parkGreen(context, g: g)
	strandAcquire(root, g: g)
end 'park'

// parkGreen parks the running green thread g of a thread's context until a ready, unless one came already. A behaviour
// handed on to g (handOn) is made runnable first: the code after a release, a drop that ends a cown's value, may wait,
// and what it waits for may be that behaviour's to do.
function parkGreen(context Count, g Count)
	if __Raw.compareExchange(g, offset: greenStatusOffset, expected: greenNotified, desired: greenRunning) == greenNotified 'permit'
		return
	end 'permit'
	let handed = __Raw.loadWord(g, offset: greenHandedOffset)
	if handed != noBehaviour 'handed'
		__Raw.storeWord(g, offset: greenHandedOffset, value: noBehaviour)
		schedPush(handed)
	end 'handed'
	switchToScheduler(context, intent: intentPark)
end 'parkGreen'

// switchToScheduler is Go's mcall: the running green thread saves its registers and goes to its thread's scheduler,
// which does what intent asks on its own stack. It returns when the green thread runs again, on whatever thread.
function switchToScheduler(context Count, intent Count)
	let g = __Raw.loadWord(context, offset: contextGreenOffset)
	__Raw.storeWord(context, offset: contextIntentOffset, value: intent)
	switchStacks(context, from: __Raw.wrappingAdd(g, right: greenSwitchOffset), onto: threadBlockSwitch(context))
end 'switchToScheduler'

// switchStacks saves the running stack's registers into from and goes on the stack of onto (rt.stackSwitch).
function switchStacks(context Count, from Count, onto Count)
	__Raw.storeWord(context, offset: contextSwitchFromOffset, value: from)
	__Raw.storeWord(context, offset: contextSwitchToOffset, value: onto)
	_ = __Raw.callCode1(__Raw.stackSwitchAddress(), arg1: __Raw.wrappingAdd(context, right: contextSwitchFromOffset))
end 'switchStacks'

// execute is Go's execute: the thread runs a run queue's entry, a green thread or a behaviour that starts on one, on its
// stack, giving it one when it first runs, until it switches back, then does what it asked.
function execute(context Count, entry Count)
