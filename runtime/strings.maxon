// The string entries: joining, formatting an integer, comparing, and reading a string's bytes. A string these make owns
// room of its own (__Raw.stringRoom), which the caller owns with it.

let decimalBase = 10 as Count

// digitZero is the byte of '0'; the digit d is digitZero + d.
let digitZero = 48 as Byte

let minusSign = 45 as Byte

// signBit is the bit that makes a signed word negative.
let signBit = 0x8000000000000000 as Count

// bothAscii is whether two Strings are both ASCII, from the bit of their words, without a branch: the short-circuit `and`
// of their two stringAscii is a taken branch where the first is not, which on the M3 cost up to 12 cycles an append in
// stringAppend's fast path, by where it fell in the code.
function bothAscii(text String, other String) returns bool
	return ((__Raw.stringSecondWord(text) and __Raw.stringSecondWord(other)) and stringAsciiBit) != 0
end 'bothAscii'

// concat is a new string of the bytes of left and then of right, every byte below 0x80 where each of them says so.
function concat(left String, right String) returns String
	let leftLength = __Raw.stringLength(left)
	let rightLength = __Raw.stringLength(right)
	let length = __Raw.wrappingAdd(leftLength, right: rightLength)
	if holdsInline(length) 'inline'
		return inlineAppend(left, part: right)
	end 'inline'
	let room = __Raw.stringRoom(length)
	copyBytes(__Raw.stringBytes(left), target: room, count: leftLength)
	copyBytes(__Raw.stringBytes(right), target: __Raw.wrappingAdd(room, right: leftLength), count: rightLength)
	return __Raw.stringOf(room, length: length, ascii: bothAscii(left, other: right))
end 'concat'

// itoa is the decimal digits of a word, read as signed unless unsigned says otherwise, with a '-' before a negative one.
function itoa(n Count, unsigned bool) returns String
	let length = decimalLength(n, unsigned: unsigned)
	if holdsInline(length) 'inline'
		return inlineDecimal(n, unsigned: unsigned, length: length)
	end 'inline'
	let bytes = __Raw.stringRoom(length)
	writeDecimal(bytes, n: n, unsigned: unsigned, length: length)
	return __Raw.stringOf(bytes, length: length, ascii: true)
end 'itoa'

// isNegative is whether a word read as signed unless unsigned says otherwise is below 0.
function isNegative(n Count, unsigned bool) returns bool
	return not unsigned and n >= signBit
end 'isNegative'

// decimalLength is how many bytes the decimal text of a word takes, read as signed unless unsigned says otherwise, its '-'
// among them.
function decimalLength(n Count, unsigned bool) returns Count
	var magnitude = n
	var length = 1 as Count
	if isNegative(n, unsigned: unsigned) 'sign'
		magnitude = __Raw.wrappingSub(0, right: n)
		length = 2
	end 'sign'
	var rest = (magnitude / decimalBase) as Count
	while rest != 0 'count'
		length = __Raw.wrappingAdd(length, right: 1)
		rest = rest / decimalBase
	end 'count'
	return length
end 'decimalLength'

// writeDecimal writes the length bytes of the decimal text of a word (decimalLength) at an address: the '-' of a negative
// one, then its digits, the last first.
function writeDecimal(at Count, n Count, unsigned bool, length Count)
	var value = n
	var digits = length
	if isNegative(n, unsigned: unsigned) 'sign'
		value = __Raw.wrappingSub(0, right: n)
		digits = __Raw.wrappingSub(length, right: 1)
		__Raw.storeByte(at, offset: 0, value: minusSign)
	end 'sign'
	var place = length
	for _ in 0 upto digits 'digit'
		place = __Raw.wrappingSub(place, right: 1)
		__Raw.storeByte(at, offset: place, value: digitZero + value mod decimalBase)
		value = value / decimalBase
	end 'digit'
end 'writeDecimal'

// The String an interpolation builds: stringJoinRoom gives it the room that the measure of its parts asks for, and each part
// is put after the ones before, a String's bytes by stringJoinPut and an integer's digits by stringJoinDigits, so it is made
// with one allocation and each byte is written once. Its ASCII bit is that of every part. Each of these entries takes the
// String it is given over, and the String it gives owns the same buffer: the code that calls them never drops what it
// passed, and nothing in this source calls them.

// stringJoinRoom is an empty String that owns room for a number of bytes and the slack past them.
// A String that will hold its bytes in its words is put together in its words: it starts as the String of no bytes with
// the inline bit (inlineScratchWord), which only a join or an append holds, and each part is shifted in after the bytes
// before.
function stringJoinRoom(length Count) returns String
	if holdsInline(length) 'inline'
		return __Raw.stringOfWords(0, second: inlineScratchWord)
	end 'inline'
	return __Raw.stringOf(__Raw.stringRoom(withSlack(length)), length: 0, ascii: true)
end 'stringJoinRoom'

// stringJoinPut is text with the bytes of part after its own, which text's buffer has room for.
function stringJoinPut(text String, part String) returns String
	let second = __Raw.stringSecondWord(text)
	if second >= signBit 'inline'
		return inlineAppend(text, part: part)
	end 'inline'
	let partSecond = __Raw.stringSecondWord(part)
	if partSecond >= signBit 'held'
		// A part in its words is its two word stores: the room of a join, stringJoinRoom's or stringExtend's, always has the
		// slack past the bytes it is made for.
		let bytes = __Raw.stringFirstWord(text)
		let length = second shr stringLengthShift
		let count = (partSecond shr stringCountShift) and inlineCountMask
		putPart(__Raw.wrappingAdd(bytes, right: length), part: part, count: count)
		return __Raw.stringOf(bytes, length: __Raw.wrappingAdd(length, right: count), ascii: bothAscii(text, other: part))
	end 'held'
	return joinPutCopy(text, part: part)
end 'stringJoinPut'

// joinPutCopy is stringJoinPut of a part whose bytes are elsewhere, copied: apart from it, so that its common case is a
// function of few registers.
function joinPutCopy(text String, part String) returns String
	let length = __Raw.stringLength(text)
	let count = __Raw.stringLength(part)
	let bytes = __Raw.stringFirstWord(text)
	copyBytes(__Raw.stringFirstWord(part), target: __Raw.wrappingAdd(bytes, right: length), count: count)
	return __Raw.stringOf(bytes, length: __Raw.wrappingAdd(length, right: count), ascii: bothAscii(text, other: part))
end 'joinPutCopy'

// stringJoinDigits is text with the length bytes of the decimal text of a word after its own, which text's buffer has room
// for.
function stringJoinDigits(text String, n Count, unsigned bool, length Count) returns String
	if isInline(text) 'inline'
		let digits = inlineDecimal(n, unsigned: unsigned, length: length)
		return inlineJoin(text, first: __Raw.stringFirstWord(digits), rest: inlineRest(digits), count: length, ascii: true)
	end 'inline'
	let start = __Raw.stringLength(text)
	let bytes = __Raw.stringBytes(text)
	writeDecimal(__Raw.wrappingAdd(bytes, right: start), n: n, unsigned: unsigned, length: length)
	return __Raw.stringOf(bytes, length: __Raw.wrappingAdd(start, right: length), ascii: __Raw.stringAscii(text))
end 'stringJoinDigits'

// An interpolation assigned back to the String it starts with, `s = "{s}..."`, appends the rest to that String: the old
// value is the assignment's to consume, so where it owns its buffer and the buffer has room (boxCapacity) the parts go in
// after its bytes, and otherwise its bytes move to a buffer that the growth policy (arrays.maxon) sizes. The old buffer is
// freed only after every part is in, since a later part may be a view of it, as the second of `"{s}{s}"` is. Whether the
// String owns its buffer is its owned bit, which the code reads in place and passes as owned: a literal's bytes are the
// executable's, so its first append copies them. As the entries of an interpolation do, these take the String over.

// extendedRoom is the address of a buffer that holds length bytes and room for needed in all: bytes, where owned says it is
// a buffer of its own with that room or one that grows to the growth policy's size in place, or else a new one of that
// size with the length bytes copied into it (grownBox): where fit, needed or needed and the slack past it, is no more than
// its capacity, it has the room. A buffer that grows is sized for needed and the slack past it. Nothing past the length of
// a String is read, so none of the room is zeroed.
function extendedRoom(bytes Count, length Count, owned bool, needed Count, fit Count) returns Count
	if not owned 'literal'
		return grownBox(bytes, held: 0, kept: length, bytes: grownCapacity(length, required: withSlack(needed)), zeroed: false)
	end 'literal'
	let capacity = boxCapacity(bytes)
	if fit <= capacity 'room'
		return bytes
	end 'room'
	return grownBox(bytes, held: capacity, kept: length, bytes: grownCapacity(capacity, required: withSlack(needed)), zeroed: false)
end 'extendedRoom'

// stringExtend is text's bytes with room for extra more after them and the slack past those, the old buffer left for
// stringRelease.
function stringExtend(text String, owned bool, extra Count) returns String
	let length = __Raw.stringLength(text)
	let needed = try length + extra otherwise panic("string size overflows")
	if holdsInline(needed) 'inline'
		if isInline(text) 'held'
			return __Raw.stringOfWords(__Raw.stringFirstWord(text), second: __Raw.stringSecondWord(text))
		end 'held'
		return __Raw.stringOfWords(0, second: inlineScratchWord)
	end 'inline'
	let room = extendedRoom(__Raw.stringBytes(text), length: length, owned: owned, needed: needed, fit: withSlack(needed))
	return __Raw.stringOf(room, length: length, ascii: __Raw.stringAscii(text))
end 'stringExtend'

// stringRelease frees the buffer of text, which stringExtend extended into grown, where text owned it and grown's bytes are
// in another. A text that owns its buffer is longer than a String holds in its words, and so is grown then.
function stringRelease(text String, owned bool, grown String)
	let bytes = __Raw.stringFirstWord(text)
	if owned and bytes != __Raw.stringFirstWord(grown) 'moved'
		__Raw.freeStringRoom(bytes)
	end 'moved'
end 'stringRelease'

// stringSlackBytes is the room past a String's bytes that a buffer a join or an append grows is made with, so that a part
// that holds its bytes in its words goes in as its two words, whatever their count: what is past the part is never read.
let stringSlackBytes = 16 as Count

// emptyWordLimit is the least word of a String that is not inline and has bytes: its length of 1 shifted up.
let emptyWordLimit = 8 as Count

// withSlack is a length of bytes with the slack past them.
function withSlack(length Count) returns Count
	return try length + stringSlackBytes otherwise panic("string size overflows")
end 'withSlack'

// putPart stores at an address with the slack past it the bytes of part, which holds count of them in its words: its first
// word, and its rest where it has bytes past the first. It is small enough to be copied into its callers.
function putPart(at Count, part String, count Count)
	__Raw.storeWord(at, offset: 0, value: __Raw.stringFirstWord(part))
	if count > wordBytes 'rest'
		__Raw.storeWord(at, offset: wordBytes, value: inlineRest(part))
	end 'rest'
end 'putPart'

// stringAppend is text with part's bytes after its own: the append of one part, which may be a view of text's bytes.
function stringAppend(text String, owned bool, part String) returns String
	let second = __Raw.stringSecondWord(text)
	let partSecond = __Raw.stringSecondWord(part)
	// An owned long text with sixteen bytes of room past its own and a piece in its words: the text's length is its word
	// shifted, the result is long, and the piece is two word stores into the room.
	if owned and (second < signBit) and (second >= emptyWordLimit) and (partSecond >= signBit) 'fast'
		let have = second shr stringLengthShift
		let bytes = __Raw.stringFirstWord(text)
		if withSlack(have) <= boxCapacity(bytes) 'room'
			let count = (partSecond shr stringCountShift) and inlineCountMask
			putPart(__Raw.wrappingAdd(bytes, right: have), part: part, count: count)
			return __Raw.stringOf(bytes, length: __Raw.wrappingAdd(have, right: count), ascii: bothAscii(text, other: part))
		end 'room'
	end 'fast'
	let length = __Raw.stringLength(text)
	let count = __Raw.stringLength(part)
	let needed = try length + count otherwise panic("string size overflows")
	if holdsInline(needed) 'inline'
		if owned 'owned'
			__Raw.freeStringRoom(__Raw.stringFirstWord(text))
		end 'owned'
		return inlineAppend(text, part: part)
	end 'inline'
	let bytes = __Raw.stringBytes(text)
	let room = extendedRoom(bytes, length: length, owned: owned, needed: needed, fit: needed)
	let at = __Raw.wrappingAdd(room, right: length)
	if isInline(part) 'held'
		// A piece of a word or more is two stores that overlap, written here: a call would cost more than they do.
		if count >= wordBytes 'words'
			__Raw.storeWord(at, offset: 0, value: __Raw.stringFirstWord(part))
			let over = __Raw.wrappingSub(count, right: wordBytes)
			if over > 0 'rest'
				__Raw.storeWord(at, offset: over, value: inlineLastWord(part, over: over))
			end 'rest'
		end 'words' else 'short'
			storeInline(at, part: part, count: count)
		end 'short'
	end 'held' else 'elsewhere'
		copyBytes(__Raw.stringFirstWord(part), target: at, count: count)
	end 'elsewhere'
	if owned and room != bytes 'moved'
		__Raw.freeStringRoom(bytes)
	end 'moved'
	return __Raw.stringOf(room, length: needed, ascii: bothAscii(text, other: part))
end 'stringAppend'

// halfWordBytes is the size of the half word that streq compares a string shorter than a word by.
let halfWordBytes = 4 as Count

// streq is whether two strings have the same bytes. Their bytes are compared a word at a time, and what is left past the
// last whole word as the last word of the string, which overlaps words already compared, as Go's memequal does; a string
// shorter than a word as two overlapping half words, or its few bytes. No read is outside either string's bytes.
function streq(left String, right String) returns bool
	let leftWord = __Raw.stringSecondWord(left)
	let rightWord = __Raw.stringSecondWord(right)
	if (leftWord or rightWord) >= signBit 'inline'
		return leftWord == rightWord and __Raw.stringFirstWord(left) == __Raw.stringFirstWord(right)
	end 'inline'
	let length = __Raw.stringLength(left)
	if length != __Raw.stringLength(right) 'lengths'
		return false
	end 'lengths'
	let leftBytes = __Raw.stringBytes(left)
	let rightBytes = __Raw.stringBytes(right)
	if length >= wordBytes 'words'
		var at = 0 as Count
		while __Raw.wrappingAdd(at, right: wordBytes) <= length 'whole'
			if __Raw.loadWord(leftBytes, offset: at) != __Raw.loadWord(rightBytes, offset: at) 'differ'
				return false
			end 'differ'
			at = __Raw.wrappingAdd(at, right: wordBytes)
		end 'whole'
		if at == length 'exact'
			return true
		end 'exact'
		let last = __Raw.wrappingSub(length, right: wordBytes)
		return __Raw.loadWord(leftBytes, offset: last) == __Raw.loadWord(rightBytes, offset: last)
	end 'words'
	if length >= halfWordBytes 'halves'
		let last = __Raw.wrappingSub(length, right: halfWordBytes)
		return __Raw.loadWord32(leftBytes, offset: 0) == __Raw.loadWord32(rightBytes, offset: 0) and __Raw.loadWord32(leftBytes, offset: last) == __Raw.loadWord32(rightBytes, offset: last)
	end 'halves'
	var at = 0 as Count
	while at < length 'bytes'
		if __Raw.loadByte(leftBytes, offset: at) != __Raw.loadByte(rightBytes, offset: at) 'differ'
			return false
		end 'differ'
		at = __Raw.wrappingAdd(at, right: 1)
	end 'bytes'
	return true
end 'streq'

// stringLength is the number of bytes of a string.
function stringLength(text String) returns Count
	return __Raw.stringLength(text)
end 'stringLength'

// stringByteAt is the byte at an index of a string, which panics past the end.
function stringByteAt(text String, index Count) returns Byte
	if index >= __Raw.stringLength(text) 'outside'
		panic("string byte position out of bounds")
	end 'outside'
	if isInline(text) 'inline'
		return inlineByte(text, index: index)
	end 'inline'
	return __Raw.loadByte(__Raw.stringFirstWord(text), offset: index)
end 'stringByteAt'

// stringOfBytes is a new string of a copy of a number of bytes at an address.
function stringOfBytes(bytes Count, length Count) returns String
	let room = __Raw.stringRoom(length)
	copyBytes(bytes, target: room, count: length)
	return stringOfRoom(room, length: length)
end 'stringOfBytes'

// stringOfRoom is the string of the length bytes that were just written to room, whose ASCII bit says what they are: the
// one pass over bytes that are still in the cache is what lets every later operation take its byte path.
function stringOfRoom(room Count, length Count) returns String
	return ownedString(room, length: length, ascii: bytesAreSimple(room, length: length))
end 'stringOfRoom'

// highBits has the top bit of each byte of a word set, and carriageReturns a carriage return in each byte.
let highBits = 0x8080808080808080 as Count

let carriageReturns = 0x0D0D0D0D0D0D0D0D as Count

let lowBits = 0x0101010101010101 as Count

let byteHighBit = 0x80 as Byte

let carriageReturn = 13 as Byte

// bytesAreSimple is whether every byte of a span is below 0x80 and none is a carriage return, so that every grapheme
// cluster of it is one byte: a carriage return and a line feed are one cluster. It is what a String's ASCII bit says (the
// layout's stringAsciiBit), a word at a time and then the bytes left over.
function bytesAreSimple(bytes Count, length Count) returns bool
	var at = 0 as Count
	while __Raw.wrappingAdd(at, right: wordBytes) <= length 'words'
		let word = __Raw.loadWord(bytes, offset: at)
		let crossed = word xor carriageReturns
		if (word and highBits) != 0 or (__Raw.wrappingSub(crossed, right: lowBits) and not crossed and highBits) != 0 'other'
			return false
		end 'other'
		at = __Raw.wrappingAdd(at, right: wordBytes)
	end 'words'
	while at < length 'bytes'
		let byte = __Raw.loadByte(bytes, offset: at)
		if byte >= byteHighBit or byte == carriageReturn 'other'
			return false
		end 'other'
		at = __Raw.wrappingAdd(at, right: 1)
	end 'bytes'
	return true
end 'bytesAreSimple'

// strKnownSimple is whether a string's ASCII bit is set, which says that each of its grapheme clusters is one byte
// (bytesAreSimple): the text operations (textops.maxon) then take their byte paths. A clear bit only means nothing is
// known.
function strKnownSimple(text String) returns bool
	return __Raw.stringAscii(text)
end 'strKnownSimple'

// checkSimpleBytes is the check of a String's ASCII bit that a build counting its allocations makes at each drop and copy
// of an owned String whose bit is set: the bit over a byte that is not simple is a bug of whatever made the String.
function checkSimpleBytes(bytes Count, length Count)
	if not bytesAreSimple(bytes, length: length) 'wrong'
		panic("a String's ASCII bit is set over a byte that is not ASCII or is a carriage return")
	end 'wrong'
end 'checkSimpleBytes'

// copyBytes copies a word at a time and then the bytes left over, first first, so that a target below the source may
// overlap it: each word is read before the target that overlaps it is written.
function copyBytes(source Count, target Count, count Count)
	var at = 0 as Count
	while __Raw.wrappingAdd(at, right: wordBytes) <= count 'words'
		__Raw.storeWord(target, offset: at, value: __Raw.loadWord(source, offset: at))
		at = __Raw.wrappingAdd(at, right: wordBytes)
	end 'words'
	while at < count 'bytes'
		__Raw.storeByte(target, offset: at, value: __Raw.loadByte(source, offset: at))
		at = __Raw.wrappingAdd(at, right: 1)
	end 'bytes'
end 'copyBytes'

// cStringOf is a new zero-terminated copy of a string, which the caller frees: a path or an argument as the kernel reads
// it, or a name as a Windows function of an A name reads it.
function cStringOf(text String) returns Count
	return cStringOfBytes(__Raw.stringBytes(text), length: __Raw.stringLength(text))
end 'cStringOf'

// cStringOfBytes is a new zero-terminated copy of a number of bytes at an address, which the caller frees.
function cStringOfBytes(bytes Count, length Count) returns Count
	let copy = alloc(__Raw.wrappingAdd(length, right: 1))
	copyBytes(bytes, target: copy, count: length)
	return copy
end 'cStringOfBytes'
