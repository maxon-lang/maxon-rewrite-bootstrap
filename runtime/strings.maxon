// The string entries: joining, formatting an integer, comparing, and reading a string's bytes. A string these make is a
// new box on the heap (layout_gen.maxon), which the caller owns.

let decimalBase = 10 as Count

// digitZero is the byte of '0'; the digit d is digitZero + d.
let digitZero = 48 as Byte

let minusSign = 45 as Byte

// signBit is the bit that makes a signed word negative.
let signBit = 0x8000000000000000 as Count

// concat is a new string of the bytes of left and then of right.
function concat(left String, right String) returns String
	let leftLength = stringLength(left)
	let rightLength = stringLength(right)
	let box = newStringBox(__Raw.wrappingAdd(leftLength, right: rightLength))
	let bytes = bytesOf(box)
	copyBytes(bytesOf(__Raw.stringAddress(left)), target: bytes, count: leftLength)
	copyBytes(bytesOf(__Raw.stringAddress(right)), target: __Raw.wrappingAdd(bytes, right: leftLength), count: rightLength)
	return __Raw.stringAt(box)
end 'concat'

// itoa is the decimal digits of a word, read as signed unless unsigned says otherwise, with a '-' before a negative one.
function itoa(n Count, unsigned bool) returns String
	let negative = not unsigned and n >= signBit
	var magnitude = n
	if negative 'sign'
		magnitude = __Raw.wrappingSub(0, right: n)
	end 'sign'
	var digits = 1 as Count
	var rest = (magnitude / decimalBase) as Count
	while rest != 0 'count'
		digits = __Raw.wrappingAdd(digits, right: 1)
		rest = rest / decimalBase
	end 'count'
	var length = digits
	if negative 'room'
		length = __Raw.wrappingAdd(length, right: 1)
	end 'room'
	let box = newStringBox(length)
	let bytes = bytesOf(box)
	if negative 'minus'
		__Raw.storeByte(bytes, offset: 0, value: minusSign)
	end 'minus'
	var at = length
	var value = magnitude
	for _ in 0 upto digits 'digit'
		at = __Raw.wrappingSub(at, right: 1)
		__Raw.storeByte(bytes, offset: at, value: digitZero + value mod decimalBase)
		value = value / decimalBase
	end 'digit'
	return __Raw.stringAt(box)
end 'itoa'

// streq is whether two strings have the same bytes.
function streq(left String, right String) returns bool
	let length = stringLength(left)
	if length != stringLength(right) 'lengths'
		return false
	end 'lengths'
	let leftBytes = bytesOf(__Raw.stringAddress(left))
	let rightBytes = bytesOf(__Raw.stringAddress(right))
	for i in 0 upto length 'bytes'
		if __Raw.loadByte(leftBytes, offset: i) != __Raw.loadByte(rightBytes, offset: i) 'differ'
			return false
		end 'differ'
	end 'bytes'
	return true
end 'streq'

// stringLength is the number of bytes of a string.
function stringLength(text String) returns Count
	return __Raw.loadWord(__Raw.stringAddress(text), offset: stringLengthOffset)
end 'stringLength'

// stringByteAt is the byte at an index of a string, which panics past the end.
function stringByteAt(text String, index Count) returns Byte
	if index >= stringLength(text) 'outside'
		panic("string byte position out of bounds")
	end 'outside'
	return __Raw.loadByte(bytesOf(__Raw.stringAddress(text)), offset: index)
end 'stringByteAt'

// stringSlice is a new string of the bytes of text from one index up to another, which panics unless
// from <= until <= the length.
function stringSlice(text String, from Count, until Count) returns String
	if from > until or until > stringLength(text) 'outside'
		panic("string slice out of bounds")
	end 'outside'
	let length = until - from
	let box = newStringBox(length)
	copyBytes(__Raw.wrappingAdd(bytesOf(__Raw.stringAddress(text)), right: from), target: bytesOf(box), count: length)
	return __Raw.stringAt(box)
end 'stringSlice'

// newStringBox is the box of a new string of a length, its bytes zero.
function newStringBox(length Count) returns Count
	let box = alloc(__Raw.wrappingAdd(stringBytesOffset, right: length))
	__Raw.storeWord(box, offset: stringLengthOffset, value: length)
	return box
end 'newStringBox'

// bytesOf is the address of the first byte of a string's box.
function bytesOf(box Count) returns Count
	return __Raw.wrappingAdd(box, right: stringBytesOffset)
end 'bytesOf'

function copyBytes(source Count, target Count, count Count)
	for i in 0 upto count 'bytes'
		__Raw.storeByte(target, offset: i, value: __Raw.loadByte(source, offset: i))
	end 'bytes'
end 'copyBytes'
