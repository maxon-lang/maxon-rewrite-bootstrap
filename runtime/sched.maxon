// The scheduler, Go's: green threads (G) run by threads (M, a thread's context) that each hold a processor (P) while
// they run one, with Go's run queues (runtime/proc.go). Each processor has a local run queue, a ring of procRunqSlots
// that its owner puts at the tail of and takes from the head of, beside runnext, the green thread readied last, which
// runs next, so the work a green thread just made runs on the core that has its data; a full ring sends half of itself to
// the global run queue, which every processor takes from once in fairnessTicks schedules and when its own is empty. A
// thread with nothing to run steals half of another processor's ring, and a thread that still finds nothing gives up its
// processor and stops, or waits in the event queue when a timer or an event entry is pending. Threads are started by work,
// not by the processor count: a green thread readied while a processor is idle and no thread is spinning starts one
// (wakep), and the monitor (monitor.maxon) starts one for a processor it takes from a blocking call.
//
// A behaviour is a green thread once it starts: `when` calls schedPush when the behaviour becomes runnable, which queues
// its record; a processor that takes the record
// from a run queue gives it a green thread that runs the record's run with the record (execute), and the behaviours that
// its release makes runnable after it on that green thread, a turn of them (runTurn). The
// main thread is thread 0 with processor 0, made with the scheduler when mainRun starts main's green thread; it runs the
// scheduler on its own stack until no behaviour or green thread is left. The program then ends with ExitProcess, which
// ends the other threads wherever they are. A program whose code needs none of this is linked without the scheduler
// (self/backend/start.maxon), and its main thread's context never names one.

// noScheduler is the scheduler field of a context before the scheduler is made, and for good in a program without it.
let noScheduler = 0 as Count

let noProc = 0 as Count

let noThread = 0 as Count

let noGreen = 0 as Count

// stepDown added to a count lowers it by one, since the atomic add takes a word.
let stepDown = 0xFFFFFFFFFFFFFFFF as Count

// The values of the scheduler's and a context's flags.
let unset = 0 as Count

let set = 1 as Count

// What a processor is doing (procStatusOffset).
let procIdle = 0 as Count

let procRunning = 1 as Count

let procSyscall = 2 as Count

// fairnessTicks is Go's: once in so many schedules a processor takes from the global run queue first, so a pair of green
// threads that keep readying each other cannot keep the global queue from running.
let fairnessTicks = 61 as Count

// stealTries is how many rounds a spinning thread tries every other processor, the last taking runnext too, as Go's
// stealWork does.
let stealTries = 4 as Count

// A thread that waits for the scheduler's lock pauses for lockPauses pause instructions between tries for lockSpinRounds
// rounds, then yields its processor between them: the lock is held for a few loads and stores.
let lockSpinRounds = 4 as Count

let lockPauses = 64 as Count

// randomStep is the increment of each thread's Weyl sequence, which picks the processor a steal tries first: 2^64 over the
// golden ratio, odd, so the sequence goes through every word before it repeats.
let randomStep = 0x9E3779B97F4A7C15 as Count

// randomShift keeps the high half of the sequence's word, which varies more from one step to the next than the low.
let randomShift = 32 as Count

// carveBlockBytes is the block of the process that green threads' and stacks' records are carved from, which the runtime
// keeps for the life of the process as Go keeps its g records. The first block is firstCarveBlockBytes, a page, and each
// next one twice the last up to carveBlockBytes, so a program of a few green threads holds a page of their records.
let carveBlockBytes = 65536 as Count

let firstCarveBlockBytes = 4096 as Count

#if os(Windows)
	// The Win32 values the scheduler passes.
	let allProcessorGroups = 0xFFFF

	let stackSizeIsReservation = 0x10000

	let noThreadAttributes = 0

	let noThreadId = 0

	let noEventAttributes = 0

	let autoReset = 0

	let startsUnset = 0

	let noEventName = 0

	let waitForever = 0xFFFFFFFF
#endif

// The number of processors is the number of the machine's, or MAXON_MAX_PROCS when it holds a decimal count in
// [fewestWorkers, mostRequestedWorkers], with an optional leading '+', as maxon's runtime reads it; any other value is
// ignored.
let maxProcsVariable = "MAXON_MAX_PROCS"

let fewestWorkers = 1 as Count

let mostRequestedWorkers = 0x7FFFFFFF as Count

let noRequest = 0 as Count

let plusSign = 0x2B as Byte

let digitNine = 0x39 as Byte

// schedPush makes a behaviour runnable: its record goes next on the running thread's processor as a run queue's entry, as
// Go's goready puts a goroutine in runnext, and a thread is woken for the processors that are idle (Go's ready calls
// wakep). It takes a green thread only when a processor starts it (execute).
function schedPush(record Count)
	let context = __Raw.threadContext()
	behaviourQueued(context, record: record, next: true)
	wakeProc(__Raw.loadWord(context, offset: contextSchedulerOffset))
end 'schedPush'

// behaviourYields queues the behaviour that a turn hands on past its end (runTurn) at the tail of the running thread's
// processor. A turn that ran its share of behaviours, or whose behaviour made a coroutine, yields as Go's goyield does:
// the behaviour goes on the thread's own processor and no thread is woken, since the thread that queues it is about to
// look for work there, so it waits only behind what was queued before it. A wake would start an idle thread at each such
// turn's end that takes the behaviour to another core, and the service's data with it, only to stop again when the turn
// ends there. A turn that the monitor preempted wakes one, as Go's goschedImpl calls wakep for a preempted goroutine: its
// thread was asked to stop because others wait, so the behaviour may be run elsewhere.
function behaviourYields(record Count, preempted bool)
	let context = __Raw.threadContext()
	behaviourQueued(context, record: record, next: false)
	if preempted 'preempted'
		wakeProc(__Raw.loadWord(context, offset: contextSchedulerOffset))
	end 'preempted'
end 'behaviourYields'

// behaviourQueued queues a behaviour that holds every cown it names on the processor of the running thread, whose context
// is context, next or at the tail, and counts it among the live ones (stepLive). A behaviour counts from when it is
// runnable, not from its `when`: one queued behind another on a cown is kept by the one ahead, which counts until it has
// handed the cown on, so the count is above 0 while anything is left, and a send to a busy service counts nothing.
function behaviourQueued(context Count, record Count, next bool)
	stepLive(context, change: 1)
	runqPut(__Raw.loadWord(context, offset: contextProcOffset), g: behaviourEntry(record), next: next)
end 'behaviourQueued'

// stepLive changes the count of live behaviours and green threads by 1 or stepDown, on the processor the running thread
// holds: only that thread writes the processor's count, so the step is a plain one, and no word that every core writes
// is stepped for each behaviour, where Go keeps no such count at all. A behaviour made live on one processor and finished
// on another leaves one count above and one below; the sum over the processors is exact once every processor is idle,
// which is when it is read (drained), each count published by the lock that put its processor on the idle list.
function stepLive(context Count, change Count)
	let proc = __Raw.loadWord(context, offset: contextProcOffset)
	__Raw.storeWord(proc, offset: procLiveOffset, value: __Raw.wrappingAdd(__Raw.loadWord(proc, offset: procLiveOffset), right: change))
end 'stepLive'

// A run queue's entry is a green thread's record, or a runnable behaviour's record with behaviourEntryTag added: a
// behaviour that has not started holds no green thread and no stack, as a message in maxon's cown queue holds no runner,
// so a burst of them costs their records only. A record's address is a box's, a multiple of a word, so the tag's bit is
// free. Go has no such entry, since a goroutine is made with its g; a behaviour is made by `when` before it can run.
let behaviourEntryTag = 1 as Count

// behaviourEntry is the run queue's entry of a runnable behaviour's record.
function behaviourEntry(record Count) returns Count
	return __Raw.wrappingAdd(record, right: behaviourEntryTag)
end 'behaviourEntry'

// isBehaviourEntry is whether a run queue's entry is a behaviour that has not started.
function isBehaviourEntry(entry Count) returns bool
	return (entry and behaviourEntryTag) != 0
end 'isBehaviourEntry'

// entryLink is the entry after one in the global run queue, linked through a green thread's greenLinkOffset or a runnable
// behaviour's behaviourLinkOffset.
function entryLink(entry Count) returns Count
	if isBehaviourEntry(entry) 'behaviour'
		return __Raw.loadWord(__Raw.wrappingSub(entry, right: behaviourEntryTag), offset: behaviourLinkOffset)
	end 'behaviour'
	return __Raw.loadWord(entry, offset: greenLinkOffset)
end 'entryLink'

// setEntryLink links an entry of the global run queue to the one after it.
function setEntryLink(entry Count, next Count)
	if isBehaviourEntry(entry) 'behaviour'
		__Raw.storeWord(__Raw.wrappingSub(entry, right: behaviourEntryTag), offset: behaviourLinkOffset, value: next)
		return
	end 'behaviour'
	__Raw.storeWord(entry, offset: greenLinkOffset, value: next)
end 'setEntryLink'

// osSetExitCode is Process.setExitCode: the process ends with the last code set, in place of main's, when main has
// returned and nothing is left. The code is read only then, after every behaviour has finished, so a plain store is
// enough.
function osSetExitCode(code Count)
	let scheduler = schedulerOf(__Raw.threadContext())
	__Raw.storeWord(scheduler, offset: schedExitCodeOffset, value: code)
	__Raw.storeWord(scheduler, offset: schedExitSetOffset, value: set)
end 'osSetExitCode'

// osExitAtOnce ends the process with the code at once (Process.exit): every write reaches standard output and error
// unbuffered, so nothing is left to flush, and nothing is freed and no behaviour that is left runs.
function osExitAtOnce(code Count)
	exitProcess(code)
end 'osExitAtOnce'

// schedulerOf is the scheduler's record, which the first call on the main thread makes: only the main thread's context
// starts with none, and no other thread runs before the record is made.
function schedulerOf(context Count) returns Count
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	if scheduler != noScheduler 'made'
		return scheduler
	end 'made'
	return makeScheduler(context)
end 'schedulerOf'

// schedDrain is what the entry stub calls after main: the main thread runs the scheduler until no behaviour or green
// thread is left, and gives back the exit code, main's or the one set last. When nothing was ever made it returns at once.
// The thread that returns from it ends the process, so it takes the exit claim, after which the monitor stops no thread.
function schedDrain(code Count) returns Count
	let context = __Raw.threadContext()
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	if scheduler == noScheduler 'nothing'
		return code
	end 'nothing'
	drainScheduler(context)
	return exitCodeAfter(scheduler, code: code)
end 'schedDrain'

// drainScheduler has the main thread run the scheduler until no behaviour or green thread is left, and takes the exit
// claim, since the thread that returns from it ends the process.
function drainScheduler(context Count)
	__Raw.storeWord(context, offset: contextDrainsOffset, value: set)
	scheduleLoop(context)
	__Raw.storeWord(context, offset: contextDrainsOffset, value: unset)
	regainProc(context)
	takeExitClaim(context)
end 'drainScheduler'

// exitCodeAfter is the code the process ends with once the scheduler is drained: the one Process.setExitCode set last, or
// else main's.
function exitCodeAfter(scheduler Count, code Count) returns Count
	if __Raw.loadWord(scheduler, offset: schedExitSetOffset) == set 'exitSet'
		return __Raw.loadWord(scheduler, offset: schedExitCodeOffset)
	end 'exitSet'
	return code
end 'exitCodeAfter'

// regainProc gives the main thread a processor again after a drain, which may have ended with it stopped and holding none,
// since main goes on to run as before: nothing is left, so every processor is idle or about to be.
function regainProc(context Count)
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	while __Raw.loadWord(context, offset: contextProcOffset) == noProc 'regain'
		lockScheduler(scheduler)
		let proc = idleProcGet(scheduler)
		unlockScheduler(scheduler)
		if proc != noProc 'got'
			acquireProc(context, proc: proc)
		end 'got' else 'wait'
			yieldThread()
		end 'wait'
	end 'regain'
end 'regainProc'

// workerMain is what a thread the runtime makes runs, with its context, which rt.threadStart has stored in the
// thread-local slot: the code the context names, after which the thread ends, or else Go's mstart, the scheduler with the
// processor its starter handed it, which never returns.
function workerMain(context Count)
	let code = __Raw.loadWord(context, offset: contextStartCodeOffset)
	if code != workerLoop 'own'
		_ = __Raw.callCode1(code, arg1: context)
		return
	end 'own'
	setThreadIdentity(context)
	acquireProc(context, proc: __Raw.atomicExchange(context, offset: contextNextProcOffset, value: noProc))
	scheduleLoop(context)
	panic("a thread's scheduler returned")
end 'workerMain'

// workerLoop is the start code of a worker's context: none of its own.
let workerLoop = 0 as Count

// scheduleLoop is Go's schedule, on the thread's own stack: it finds a green thread and runs it until it switches back,
// for good, or on the main thread after main until nothing is left. A thread that a green thread is pinned to runs that
// one alone, and a green thread pinned to another thread is handed to it; while no green thread is pinned, neither is
// read.
function scheduleLoop(context Count)
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	while true 'schedule'
		if anyPinned(scheduler) and pinnedGreen(context) != noGreen 'pinned'
			stopPinned(context)
			execute(context, entry: pinnedGreen(context))
			continue 'schedule'
		end 'pinned'
		if __Raw.loadWord(context, offset: contextProcOffset) == noProc 'noProc'
			if not stopThread(context) 'ended'
				return
			end 'ended'
		end 'noProc'
		let g = findRunnable(context)
		if g == noGreen 'ended'
			return
		end 'ended'
		if __Raw.loadWord(context, offset: contextSpinningOffset) == set 'spinning'
			resetSpinning(context)
		end 'spinning'
		if not isBehaviourEntry(g) and anyPinned(scheduler) and __Raw.loadWord(g, offset: greenLockedOffset) != noThread 'elsewhere'
			startPinned(context, g: g)
			continue 'schedule'
		end 'elsewhere'
		execute(context, entry: g)
	end 'schedule'
end 'scheduleLoop'

// anyPinned is whether some green thread is pinned to its thread, read where a pin is about to be acted on, never kept from
// an earlier read: the search for work may wait, and a green thread pinned meanwhile would then run on the thread that
// took it, leaving its own thread stopped for good. A green thread's pin is counted before it switches back to be queued,
// so a thread that takes it from a queue, an acquire, reads a count that holds the pin.
function anyPinned(scheduler Count) returns bool
	return __Raw.loadAcquire(scheduler, offset: schedPinnedOffset) != 0
end 'anyPinned'

// pinnedGreen is the green thread pinned to a thread (Go's m.lockedg), noGreen for none.
function pinnedGreen(context Count) returns Count
	return __Raw.loadWord(threadBlockSwitch(context), offset: threadBlockLockedOffset)
end 'pinnedGreen'

// stopPinned is Go's stoplockedm: a thread whose pinned green thread has parked, yielded or lost the thread's processor
// runs no other green thread, so it hands its processor to another thread and waits until the thread that takes the
// green thread from a queue hands it one to run it with (startPinned). The handed processor is the wake's signal, read
// after the flag is set, so a hand-off that comes before the wait is not lost.
function stopPinned(context Count)
	if __Raw.loadWord(context, offset: contextProcOffset) != noProc 'held'
		handOffProc(__Raw.loadWord(context, offset: contextSchedulerOffset), proc: releaseProc(context))
	end 'held'
	while true 'wait'
		_ = __Raw.atomicExchange(context, offset: contextStoppedOffset, value: set)
		let proc = __Raw.atomicExchange(context, offset: contextNextProcOffset, value: noProc)
		if proc != noProc 'handed'
			__Raw.storeWord(context, offset: contextStoppedOffset, value: unset)
			acquireProc(context, proc: proc)
			return
		end 'handed'
		waitStopped(context)
	end 'wait'
end 'stopPinned'

// startPinned is Go's startlockedm: a green thread taken from a queue that is pinned to another thread runs there, on
// this thread's processor, which this thread hands over, to stop until it is handed one again.
function startPinned(context Count, g Count)
	let pinnedTo = __Raw.loadWord(g, offset: greenLockedOffset)
	_ = __Raw.atomicExchange(pinnedTo, offset: contextNextProcOffset, value: releaseProc(context))
	wakeThread(pinnedTo)
end 'startPinned'

// findRunnable is Go's: the next green thread for the thread's processor, from its timers, its run queue, the global run
// queue, the event queue and the other processors' queues, or else the processor goes idle and the thread waits, in the event queue
// when something is pending there, until it is handed a processor. It gives noGreen only on the main thread's drain,
// once nothing is left.
function findRunnable(context Count) returns Count
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	while true 'top'
		let proc = __Raw.loadWord(context, offset: contextProcOffset)
		if __Raw.loadWord(proc, offset: procSchedTickOffset) mod fairnessTicks == 0 and globalQueued(scheduler) 'fair'
			lockScheduler(scheduler)
			let fair = globalGet(scheduler, proc: proc, most: 1)
			unlockScheduler(scheduler)
			if fair != noGreen 'found'
				return fair
			end 'found'
		end 'fair'
		runTimers(context, proc: proc)
		let own = runqGet(proc)
		if own != noGreen 'own'
			return own
		end 'own'
		if globalQueued(scheduler) 'global'
			lockScheduler(scheduler)
			let global = globalGet(scheduler, proc: proc, most: 0)
			unlockScheduler(scheduler)
			if global != noGreen 'found'
				return global
			end 'found'
		end 'global'
		if __Raw.loadAcquire(scheduler, offset: schedEventWaitersOffset) > 0 and __Raw.loadAcquire(scheduler, offset: schedLastTakeOffset) != 0 'take'
			let taken = eventsReadied(context, proc: proc, list: takeEvents(context, delay: takeEventsNoWait))
			if taken != noGreen 'found'
				return taken
			end 'found'
		end 'take'
		if mayStartSpinning(context, scheduler: scheduler) 'steal'
			let stolen = stealWork(context, proc: proc)
			if stolen != noGreen 'found'
				return stolen
			end 'found'
		end 'steal'
		lockScheduler(scheduler)
		if globalQueued(scheduler) 'late'
			let late = globalGet(scheduler, proc: proc, most: 0)
			unlockScheduler(scheduler)
			return late
		end 'late'
		let drained = idleProcPut(scheduler, proc: releaseProc(context))
		unlockScheduler(scheduler)
		if drained 'drained'
			endDrain(scheduler)
		end 'drained'
		if __Raw.loadWord(context, offset: contextSpinningOffset) == set 'wasSpinning'
			__Raw.storeWord(context, offset: contextSpinningOffset, value: unset)
			_ = __Raw.atomicAdd(scheduler, offset: schedSpinningOffset, value: stepDown)
			if takeProcForQueued(context, scheduler: scheduler) 'again'
				continue 'top'
			end 'again'
		end 'wasSpinning'
		if eventsPending(scheduler) and __Raw.atomicExchange(scheduler, offset: schedLastTakeOffset, value: 0) != 0 'wait'
			if waitInEventQueue(context, scheduler: scheduler) 'handed'
				continue 'top'
			end 'handed'
		end 'wait'
		if not stopThread(context) 'ended'
			return noGreen
		end 'ended'
	end 'top'
	panic("the scheduler's search for work ended")
end 'findRunnable'

// mayStartSpinning is whether the thread may look for work on the other processors, which it marks itself as doing: Go
// limits the spinning threads to half the busy processors, so that a burst of wakes does not have every idle thread
// steal at once.
function mayStartSpinning(context Count, scheduler Count) returns bool
	if __Raw.loadWord(context, offset: contextSpinningOffset) == set 'already'
		return true
	end 'already'
	let busy = __Raw.wrappingSub(procCount(scheduler), right: __Raw.loadAcquire(scheduler, offset: schedIdleProcCountOffset))
	let spinning = __Raw.loadAcquire(scheduler, offset: schedSpinningOffset)
	if __Raw.wrappingAdd(spinning, right: spinning) >= busy 'enough'
		return false
	end 'enough'
	__Raw.storeWord(context, offset: contextSpinningOffset, value: set)
	_ = __Raw.atomicAdd(scheduler, offset: schedSpinningOffset, value: 1)
	return true
end 'mayStartSpinning'

// takeProcForQueued is Go's check of every run queue after a thread stops spinning: work that was readied while it
// spun, whose readier saw a spinning thread and woke none, would otherwise wait. When some queue holds work the thread
// takes an idle processor and spins again.
function takeProcForQueued(context Count, scheduler Count) returns bool
	let procs = madeProcs(scheduler)
	for i in 0 upto procs 'procs'
		if not runqEmpty(procAt(scheduler, index: i)) 'queued'
			lockScheduler(scheduler)
			let proc = idleProcGet(scheduler)
			unlockScheduler(scheduler)
			if proc == noProc 'none'
				return false
			end 'none'
			acquireProc(context, proc: proc)
			__Raw.storeWord(context, offset: contextSpinningOffset, value: set)
			_ = __Raw.atomicAdd(scheduler, offset: schedSpinningOffset, value: 1)
			return true
		end 'queued'
	end 'procs'
	return false
end 'takeProcForQueued'

// resetSpinning is Go's: a spinning thread that found work stops spinning, and when it was the last one and a processor
// is idle it wakes another, which may find more.
function resetSpinning(context Count)
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	__Raw.storeWord(context, offset: contextSpinningOffset, value: unset)
	if __Raw.atomicAdd(scheduler, offset: schedSpinningOffset, value: stepDown) == 1 and __Raw.loadAcquire(scheduler, offset: schedIdleProcCountOffset) > 0 'last'
		wakeProc(scheduler)
	end 'last'
end 'resetSpinning'

// stealWork is Go's: stealTries rounds over the other processors from one picked at random, the last taking a victim's
// runnext too, which gives one of the green threads taken and puts the rest on the thief's ring.
function stealWork(context Count, proc Count) returns Count
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	let procs = madeProcs(scheduler)
	for round in 0 upto stealTries 'rounds'
		let last = round == stealTries - 1
		var victim = (try nextRandom(context) mod procs otherwise 0) as Count
		for i in 0 upto procs 'victims'
			let other = procAt(scheduler, index: victim)
			if other != proc 'other'
				let stolen = runqSteal(proc, victim: other, takesNext: last)
				if stolen != noGreen 'stolen'
					return stolen
				end 'stolen'
			end 'other'
			victim = __Raw.wrappingAdd(victim, right: 1)
			if victim == procs 'wrap'
				victim = 0
			end 'wrap'
		end 'victims'
	end 'rounds'
	return noGreen
end 'stealWork'

// nextRandom steps the thread's Weyl sequence.
function nextRandom(context Count) returns Count
	let state = __Raw.wrappingAdd(__Raw.loadWord(context, offset: contextRandomOffset), right: randomStep)
	__Raw.storeWord(context, offset: contextRandomOffset, value: state)
	return state shr randomShift
end 'nextRandom'

// waitInEventQueue is the wait of the one thread in the event queue, which has stored 0 in schedLastTakeOffset to claim it: until
// the earliest timer, or a completion, or a break. Then it takes an idle processor for what the event queue readied, and says
// whether it got one; when there is none, what was readied goes on the global run queue, and the thread stops.
function waitInEventQueue(context Count, scheduler Count) returns bool
	let next = __Raw.loadAcquire(scheduler, offset: schedTimerNextOffset)
	var delay = takeEventsForever
	if next != noTimer 'timer'
		let now = nanotime(context)
		delay = __Raw.wrappingSub(next, right: now) if next > now else takeEventsNoWait
	end 'timer'
	__Raw.storeRelease(scheduler, offset: schedTakeUntilOffset, value: next)
	let list = takeEvents(context, delay: delay)
	__Raw.storeRelease(scheduler, offset: schedTakeUntilOffset, value: noTimer)
	__Raw.storeRelease(scheduler, offset: schedLastTakeOffset, value: nanotime(context))
	lockScheduler(scheduler)
	let proc = idleProcGet(scheduler)
	if proc == noProc 'none'
		globalPutList(scheduler, list: list)
		unlockScheduler(scheduler)
		return false
	end 'none'
	unlockScheduler(scheduler)
	acquireProc(context, proc: proc)
	var g = list
	while g != noGreen 'readied'
		let after = __Raw.loadWord(g, offset: greenLinkOffset)
		runqPut(proc, g: g, next: false)
		g = after
	end 'readied'
	return true
end 'waitInEventQueue'

// eventsPending is whether a thread should wait in the event queue rather than stop: a timer is armed or a green thread waits
// on an event entry.
function eventsPending(scheduler Count) returns bool
	return __Raw.loadAcquire(scheduler, offset: schedTimerNextOffset) != noTimer or __Raw.loadAcquire(scheduler, offset: schedEventWaitersOffset) > 0
end 'eventsPending'

// eventsReadied puts what a take that did not wait readied on the thread's processor and gives the first of it to run.
function eventsReadied(context Count, proc Count, list Count) returns Count
	if list == noGreen 'none'
		return noGreen
	end 'none'
	var g = __Raw.loadWord(list, offset: greenLinkOffset)
	while g != noGreen 'rest'
		let next = __Raw.loadWord(g, offset: greenLinkOffset)
		runqPut(proc, g: g, next: false)
		g = next
	end 'rest'
	return list
end 'eventsReadied'

// stopThread is Go's stopm: the thread, holding no processor, waits on the list of idle threads until a thread that
// starts work hands it a processor (startThreadFor), which it takes. It says false on the main thread's drain when
// nothing is left, which is checked under the lock that the last processor's idle put and endDrain take, so the end of
// the last behaviour or green thread cannot be missed.
function stopThread(context Count) returns bool
	let scheduler = __Raw.loadWord(context, offset: contextSchedulerOffset)
	lockScheduler(scheduler)
	if drainEnded(context, scheduler: scheduler) 'ended'
		unlockScheduler(scheduler)
		return false
	end 'ended'
	__Raw.storeWord(context, offset: contextStoppedOffset, value: set)
	__Raw.storeWord(context, offset: contextIdleNextOffset, value: __Raw.loadWord(scheduler, offset: schedIdleThreadsOffset))
	__Raw.storeWord(scheduler, offset: schedIdleThreadsOffset, value: context)
	unlockScheduler(scheduler)
	releaseKept(__Raw.loadWord(context, offset: contextHeapOffset))
	waitStopped(context)
	let proc = __Raw.atomicExchange(context, offset: contextNextProcOffset, value: noProc)
	if proc == noProc 'unhanded'
		if __Raw.loadWord(context, offset: contextDrainsOffset) == set 'drain'
			return false
		end 'drain'
		panic("a thread was woken with no processor")
	end 'unhanded'
	acquireProc(context, proc: proc)
	return true
end 'stopThread'

// drainEnded is whether the thread is the main thread after main and nothing is left, under the lock.
function drainEnded(context Count, scheduler Count) returns bool
	return __Raw.loadWord(context, offset: contextDrainsOffset) == set and nothingLeft(scheduler)
end 'drainEnded'

// nothingLeft is Go's checkdead, under the lock: every processor is idle and no behaviour or green thread is live. With
// every processor idle no thread runs a green thread, so no count changes, and their sum is exact; once it is 0 nothing is
// left that could make one again.
function nothingLeft(scheduler Count) returns bool
	if __Raw.loadAcquire(scheduler, offset: schedIdleProcCountOffset) != procCount(scheduler) 'busy'
		return false
	end 'busy'
	var live = 0 as Count
	for i in 0 upto madeProcs(scheduler) 'procs'
		live = __Raw.wrappingAdd(live, right: __Raw.loadWord(procAt(scheduler, index: i), offset: procLiveOffset))
	end 'procs'
	return live == 0
end 'nothingLeft'

// endDrain is what the thread that puts the last processor on the idle list does once nothing is left: it wakes the main
// thread when it is stopped, taking it off the idle list, and breaks the event queue's wait, where the main thread may wait,
// so that schedDrain returns.
function endDrain(scheduler Count)
	let main = __Raw.loadWord(scheduler, offset: schedMainThreadOffset)
	lockScheduler(scheduler)
	var woken = false
	if __Raw.loadWord(main, offset: contextStoppedOffset) == set and takeIdleThread(scheduler, context: main) 'stopped'
		woken = true
	end 'stopped'
	unlockScheduler(scheduler)
	if woken 'wake'
		wakeThread(main)
	end 'wake'
	if __Raw.loadAcquire(scheduler, offset: schedLastTakeOffset) == 0 'waiting'
		breakEventWait(scheduler)
	end 'waiting'
end 'endDrain'

// takeIdleThread takes a thread off the idle list, under the lock, and says whether it was on it.
function takeIdleThread(scheduler Count, context Count) returns bool
	var previous = noThread
	var at = __Raw.loadWord(scheduler, offset: schedIdleThreadsOffset)
	while at != noThread 'walk'
		let next = __Raw.loadWord(at, offset: contextIdleNextOffset)
		if at == context 'found'
			if previous == noThread 'head'
				__Raw.storeWord(scheduler, offset: schedIdleThreadsOffset, value: next)
			end 'head' else 'inner'
				__Raw.storeWord(previous, offset: contextIdleNextOffset, value: next)
			end 'inner'
			return true
		end 'found'
		previous = at
		at = next
	end 'walk'
	return false
end 'takeIdleThread'

// startThreadFor is Go's startm: a stopped thread, or a new one, runs proc, or an idle processor when proc is noProc;
// spinning says it starts by looking for work, for which the caller counted it among the spinning threads already. It is
// the scheduler's work wherever it runs, as Go's startm runs on the system stack, so a green thread that starts a thread
// (a wake of a processor at a ready or a sleep) does not pay for the clone in its CPU clock.
function startThreadFor(scheduler Count, proc Count, spinning bool)
	let context = __Raw.threadContext()
	setGreenClockAside(context)
	takeThreadFor(scheduler, proc: proc, spinning: spinning)
	takeGreenClockBack(context)
end 'startThreadFor'

// takeThreadFor is startThreadFor's work: the thread and the processor taken under the scheduler's lock, and the thread
// woken or made.
function takeThreadFor(scheduler Count, proc Count, spinning bool)
	lockScheduler(scheduler)
	var p = proc
	if p == noProc 'any'
		p = idleProcGet(scheduler)
		if p == noProc 'none'
			unlockScheduler(scheduler)
			if spinning 'uncount'
				_ = __Raw.atomicAdd(scheduler, offset: schedSpinningOffset, value: stepDown)
			end 'uncount'
			return
		end 'none'
	end 'any'
	let thread = __Raw.loadWord(scheduler, offset: schedIdleThreadsOffset)
	if thread != noThread 'idle'
		__Raw.storeWord(scheduler, offset: schedIdleThreadsOffset, value: __Raw.loadWord(thread, offset: contextIdleNextOffset))
	end 'idle'
	unlockScheduler(scheduler)
	if thread == noThread 'new'
		newThread(scheduler, proc: p, spinning: spinning)
		return
	end 'new'
	__Raw.storeWord(thread, offset: contextSpinningOffset, value: set if spinning else unset)
	__Raw.storeWord(thread, offset: contextNextProcOffset, value: p)
	wakeThread(thread)
end 'takeThreadFor'

// wakeProc is Go's wakep: when a processor is idle and no thread spins, a thread starts spinning on it, which steals what
// was just readied or finds it on the global queue.
function wakeProc(scheduler Count)
	if __Raw.loadAcquire(scheduler, offset: schedIdleProcCountOffset) == 0 or __Raw.loadAcquire(scheduler, offset: schedSpinningOffset) != 0 'busy'
		return
	end 'busy'
	if __Raw.compareExchange(scheduler, offset: schedSpinningOffset, expected: 0, desired: 1) != 0 'another'
		return
	end 'another'
	startThreadFor(scheduler, proc: noProc, spinning: true)
end 'wakeProc'

// handOffProc is Go's handoffp, for a processor the monitor took from a thread in a blocking call: a thread runs it when
// it has work or work waits globally, or when no thread spins and none is idle; otherwise it goes idle, but the last one
// to go idle while a timer or an event entry is pending and no thread waits in the event queue gets a thread to wait there.
function handOffProc(scheduler Count, proc Count)
	if not runqEmpty(proc) or globalQueued(scheduler) 'work'
		startThreadFor(scheduler, proc: proc, spinning: false)
		return
	end 'work'
	if __Raw.loadAcquire(scheduler, offset: schedSpinningOffset) == 0 and __Raw.loadAcquire(scheduler, offset: schedIdleProcCountOffset) == 0 'nobody'
		if __Raw.compareExchange(scheduler, offset: schedSpinningOffset, expected: 0, desired: 1) == 0 'spin'
			startThreadFor(scheduler, proc: proc, spinning: true)
			return
		end 'spin'
	end 'nobody'
	lockScheduler(scheduler)
	if globalQueued(scheduler) 'late'
		unlockScheduler(scheduler)
		startThreadFor(scheduler, proc: proc, spinning: false)
		return
	end 'late'
	let lastBusy = __Raw.loadAcquire(scheduler, offset: schedIdleProcCountOffset) == __Raw.wrappingSub(procCount(scheduler), right: 1)
	if lastBusy and eventsPending(scheduler) and __Raw.loadAcquire(scheduler, offset: schedLastTakeOffset) != 0 'eventQueue'
		unlockScheduler(scheduler)
		startThreadFor(scheduler, proc: proc, spinning: false)
		return
	end 'eventQueue'
	let drained = idleProcPut(scheduler, proc: proc)
	unlockScheduler(scheduler)
	if drained 'drained'
		endDrain(scheduler)
	end 'drained'
end 'handOffProc'

// acquireProc is Go's acquirep: the thread holds the processor and runs its queues.
function acquireProc(context Count, proc Count)
	if proc == noProc 'none'
		panic("a thread acquires no processor")
	end 'none'
	__Raw.storeWord(context, offset: contextProcOffset, value: proc)
	__Raw.storeRelease(proc, offset: procThreadOffset, value: context)
	__Raw.storeRelease(proc, offset: procStatusOffset, value: procRunning)
end 'acquireProc'

// releaseProc is Go's releasep: the thread gives up its processor, which it gives back.
function releaseProc(context Count) returns Count
	let proc = __Raw.loadWord(context, offset: contextProcOffset)
	__Raw.storeWord(context, offset: contextProcOffset, value: noProc)
	__Raw.storeRelease(proc, offset: procThreadOffset, value: noThread)
	return proc
end 'releaseProc'

// idleProcPut is Go's pidleput, under the lock: the processor, whose queue is empty, joins the idle ones. It says whether
// that leaves nothing on the main thread's drain (Go's checkdead after an M goes idle), for which the caller calls
// endDrain once it has let the lock go.
function idleProcPut(scheduler Count, proc Count) returns bool
	__Raw.storeRelease(proc, offset: procStatusOffset, value: procIdle)
	__Raw.storeRelease(proc, offset: procThreadOffset, value: noThread)
	__Raw.storeWord(proc, offset: procLinkOffset, value: __Raw.loadWord(scheduler, offset: schedIdleProcsOffset))
	__Raw.storeWord(scheduler, offset: schedIdleProcsOffset, value: proc)
	_ = __Raw.atomicAdd(scheduler, offset: schedIdleProcCountOffset, value: 1)
	return drainEnded(__Raw.loadWord(scheduler, offset: schedMainThreadOffset), scheduler: scheduler)
end 'idleProcPut'

// idleProcGet is Go's pidleget, under the lock: an idle processor, or noProc. A processor that no thread has taken yet is
// idle too, and is made when it is first taken, after every idle one that was made: a program that keeps one processor
// busy holds the record of one.
function idleProcGet(scheduler Count) returns Count
	var proc = __Raw.loadWord(scheduler, offset: schedIdleProcsOffset)
	if proc != noProc 'one'
		__Raw.storeWord(scheduler, offset: schedIdleProcsOffset, value: __Raw.loadWord(proc, offset: procLinkOffset))
	end 'one' else if madeProcs(scheduler) < procCount(scheduler) 'unmade'
		proc = makeProc(scheduler)
	end 'unmade' else 'none'
		return noProc
	end 'none'
	_ = __Raw.atomicAdd(scheduler, offset: schedIdleProcCountOffset, value: stepDown)
	return proc
end 'idleProcGet'

// makeProc makes the processor of the next id, under the lock or before another thread runs. Its record and slot are
// written before the count of the made ones grows, which is a release, so that a thread that reads the count without the
// lock (madeProcs, an acquire) finds the slots below it and their processors written.
function makeProc(scheduler Count) returns Count
	let id = madeProcs(scheduler)
	let proc = keepApart(procBytes)
	__Raw.storeWord(proc, offset: procIdOffset, value: id)
	__Raw.storeWord(scheduler, offset: try schedProcessorsOffset + id * wordBytes otherwise panic("too many processors for memory"), value: proc)
	__Raw.storeRelease(scheduler, offset: schedMadeProcsOffset, value: __Raw.wrappingAdd(id, right: 1))
	return proc
end 'makeProc'

// keepApart is a block that keep makes, its start a multiple of sharingBytes, so that the words a record lays out
// sharingBytes apart, which different cores write, are on cache lines of their own.
function keepApart(bytes Count) returns Count
	return __Raw.wrappingAdd(keep(__Raw.wrappingAdd(bytes, right: sharingBytes)), right: sharingBytes - 1) and sharingMask
end 'keepApart'

// sharingBytes is the span within which the writes of two cores contend for one line: the cache line of Apple's cores,
// and the pair of lines that x64's spatial prefetcher fetches together. sharingMask clears the bits below it.
let sharingBytes = 128 as Count

let sharingMask = 0xFFFFFFFFFFFFFF80 as Count

function procCount(scheduler Count) returns Count
	return __Raw.loadWord(scheduler, offset: schedProcsOffset)
end 'procCount'

// madeProcs is how many processors are made, those of the ids below it, which a walk of the processors' queues visits.
function madeProcs(scheduler Count) returns Count
	return __Raw.loadAcquire(scheduler, offset: schedMadeProcsOffset)
end 'madeProcs'

// procAt is the processor of an index.
function procAt(scheduler Count, index Count) returns Count
	return __Raw.loadWord(scheduler, offset: try schedProcessorsOffset + index * wordBytes otherwise panic("a processor past the scheduler's record"))
end 'procAt'

// The local run queue, Go's runq: the owner writes the tail, and the owner and thieves take from the head by advancing it
// with a compare-exchange, so a slot is read before the exchange that claims it, and the owner writes a slot again only
// once the head has passed it. As in Go, the tail is stored as a release and read by a thief as an acquire, so a thief
// that sees an index sees the slot written before it, and the head is read as an acquire, so the owner overwrites a slot
// only after the thief's reads of it that the head's compare-exchange claimed. The owner reads its own tail plain.

// runqPut is Go's runqput: next makes g the processor's runnext, and the green thread it displaces goes to the tail.
function runqPut(proc Count, g Count, next bool)
	var put = g
	if next 'next'
		while true 'swap'
			let old = __Raw.loadWord(proc, offset: procRunNextOffset)
			if __Raw.compareExchange(proc, offset: procRunNextOffset, expected: old, desired: g) == old 'swapped'
				if old == noGreen 'first'
					return
				end 'first'
				put = old
				break 'swap'
			end 'swapped'
		end 'swap'
	end 'next'
	while true 'retry'
		let head = __Raw.loadAcquire(proc, offset: procRunqHeadOffset)
		let tail = __Raw.loadWord(proc, offset: procRunqTailOffset)
		if __Raw.wrappingSub(tail, right: head) < procRunqSlots 'room'
			__Raw.storeWord(runqSlot(proc, index: tail), offset: 0, value: put)
			__Raw.storeRelease(proc, offset: procRunqTailOffset, value: __Raw.wrappingAdd(tail, right: 1))
			return
		end 'room'
		if runqPutSlow(proc, g: put, head: head, tail: tail) 'spilled'
			return
		end 'spilled'
	end 'retry'
end 'runqPut'

// runqPutSlow is Go's runqputslow: half of the full ring and g go to the global run queue, in their order, or false when
// a thief took from the ring meanwhile, which makes room.
function runqPutSlow(proc Count, g Count, head Count, tail Count) returns bool
	let half = procRunqSlots / 2
	if __Raw.wrappingSub(tail, right: head) != procRunqSlots 'notFull'
		panic("the run queue is not full")
	end 'notFull'
	if __Raw.compareExchange(proc, offset: procRunqHeadOffset, expected: head, desired: __Raw.wrappingAdd(head, right: half)) != head 'lost'
		return false
	end 'lost'
	// Linked only once claimed, as Go links its batch after the compare-exchange: an entry a thief took meanwhile may have
	// run and had its record freed. The claimed slots still hold them, since only the owner writes a slot.
	let first = __Raw.loadWord(runqSlot(proc, index: head), offset: 0)
	var last = first
	for i in 1 upto half 'batch'
		let at = __Raw.loadWord(runqSlot(proc, index: __Raw.wrappingAdd(head, right: i)), offset: 0)
		setEntryLink(last, next: at)
		last = at
	end 'batch'
	setEntryLink(last, next: g)
	setEntryLink(g, next: noGreen)
	let scheduler = __Raw.loadWord(__Raw.threadContext(), offset: contextSchedulerOffset)
	lockScheduler(scheduler)
	globalPutBatch(scheduler, first: first, last: g, count: __Raw.wrappingAdd(half, right: 1))
	unlockScheduler(scheduler)
	return true
end 'runqPutSlow'

// runqGet is Go's runqget: runnext first, then the head of the ring, or noGreen.
function runqGet(proc Count) returns Count
	let next = __Raw.loadWord(proc, offset: procRunNextOffset)
	if next != noGreen and __Raw.compareExchange(proc, offset: procRunNextOffset, expected: next, desired: noGreen) == next 'next'
		return next
	end 'next'
	while true 'take'
		let head = __Raw.loadAcquire(proc, offset: procRunqHeadOffset)
		let tail = __Raw.loadWord(proc, offset: procRunqTailOffset)
		if head == tail 'empty'
			return noGreen
		end 'empty'
		let g = __Raw.loadWord(runqSlot(proc, index: head), offset: 0)
		if __Raw.compareExchange(proc, offset: procRunqHeadOffset, expected: head, desired: __Raw.wrappingAdd(head, right: 1)) == head 'taken'
			return g
		end 'taken'
	end 'take'
	return noGreen
end 'runqGet'

// runqEmpty is whether a processor has nothing queued.
function runqEmpty(proc Count) returns bool
	return __Raw.loadAcquire(proc, offset: procRunqHeadOffset) == __Raw.loadAcquire(proc, offset: procRunqTailOffset) and __Raw.loadAcquire(proc, offset: procRunNextOffset) == noGreen
end 'runqEmpty'

// runqSteal is Go's runqsteal: half of a victim's ring goes onto the thief's, past its tail, and the last of it is given
// to run; takesNext takes the victim's runnext when its ring is empty.
function runqSteal(proc Count, victim Count, takesNext bool) returns Count
	let tail = __Raw.loadWord(proc, offset: procRunqTailOffset)
	var n = runqGrab(victim, into: proc, at: tail, takesNext: takesNext)
	if n == 0 'none'
		return noGreen
	end 'none'
	n = __Raw.wrappingSub(n, right: 1)
	let g = __Raw.loadWord(runqSlot(proc, index: __Raw.wrappingAdd(tail, right: n)), offset: 0)
	if n == 0 'one'
		return g
	end 'one'
	let head = __Raw.loadAcquire(proc, offset: procRunqHeadOffset)
	if __Raw.wrappingAdd(__Raw.wrappingSub(tail, right: head), right: n) >= procRunqSlots 'overflow'
		panic("a steal overflows the thief's run queue")
	end 'overflow'
	__Raw.storeRelease(proc, offset: procRunqTailOffset, value: __Raw.wrappingAdd(tail, right: n))
	return g
end 'runqSteal'

// runqGrab is Go's runqgrab: it copies half of the victim's ring into the thief's from index at and claims them with a
// compare-exchange of the victim's head, or the victim's runnext when the ring is empty, and says how many it took.
function runqGrab(victim Count, into Count, at Count, takesNext bool) returns Count
	while true 'grab'
		let head = __Raw.loadAcquire(victim, offset: procRunqHeadOffset)
		let tail = __Raw.loadAcquire(victim, offset: procRunqTailOffset)
		let queued = __Raw.wrappingSub(tail, right: head)
		let n = __Raw.wrappingSub(queued, right: queued / 2)
		if n == 0 'empty'
			if takesNext 'next'
				let next = __Raw.loadWord(victim, offset: procRunNextOffset)
				if next != noGreen 'queued'
					if __Raw.loadAcquire(victim, offset: procStatusOffset) == procRunning 'running'
						runNextBackoff()
					end 'running'
					if __Raw.compareExchange(victim, offset: procRunNextOffset, expected: next, desired: noGreen) != next 'moved'
						continue 'grab'
					end 'moved'
					__Raw.storeWord(runqSlot(into, index: at), offset: 0, value: next)
					return 1
				end 'queued'
			end 'next'
			return 0
		end 'empty'
		if n > procRunqSlots / 2 'inconsistent'
			continue 'grab'
		end 'inconsistent'
		for i in 0 upto n 'copy'
			let g = __Raw.loadWord(runqSlot(victim, index: __Raw.wrappingAdd(head, right: i)), offset: 0)
			__Raw.storeWord(runqSlot(into, index: __Raw.wrappingAdd(at, right: i)), offset: 0, value: g)
		end 'copy'
		if __Raw.compareExchange(victim, offset: procRunqHeadOffset, expected: head, desired: __Raw.wrappingAdd(head, right: n)) == head 'claimed'
			return n
		end 'claimed'
	end 'grab'
	return 0
end 'runqGrab'

// runNextBackoff is Go's pause before a thief takes the runnext of a processor that is running: the green thread there
// has just readied it and is likely about to block, so its own processor runs it next with its data hot, rather than the
// two trading it between cores. A message between two green threads costs well under a microsecond, so Go waits
// runNextBackoffMicros, and yields the thread on Windows, whose timers are too coarse for that.
function runNextBackoff()
	#if os(Windows)
		yieldThread()
	#else
		sleepMicros(__Raw.threadContext(), micros: runNextBackoffMicros)
	#endif
end 'runNextBackoff'

let runNextBackoffMicros = 3 as Count

// runqSlot is the address of the slot of a processor's ring that holds an index.
function runqSlot(proc Count, index Count) returns Count
	return __Raw.wrappingAdd(proc, right: __Raw.wrappingAdd(procRunqOffset, right: (index mod procRunqSlots) * wordBytes))
end 'runqSlot'

// The global run queue, Go's sched.runq, under the scheduler's lock: entries linked through setEntryLink.

// globalQueued is whether the global run queue holds anything, read without the lock to choose whether to take it.
function globalQueued(scheduler Count) returns bool
	return __Raw.loadAcquire(scheduler, offset: schedRunqSizeOffset) > 0
end 'globalQueued'

function globalPut(scheduler Count, g Count)
	setEntryLink(g, next: noGreen)
	globalPutBatch(scheduler, first: g, last: g, count: 1)
end 'globalPut'

// globalPutBatch puts a linked list of count entries, whose last links to nothing, at the tail.
function globalPutBatch(scheduler Count, first Count, last Count, count Count)
	let tail = __Raw.loadWord(scheduler, offset: schedRunqTailOffset)
	if tail == noGreen 'empty'
		__Raw.storeWord(scheduler, offset: schedRunqHeadOffset, value: first)
	end 'empty' else 'after'
		setEntryLink(tail, next: first)
	end 'after'
	__Raw.storeWord(scheduler, offset: schedRunqTailOffset, value: last)
	__Raw.storeRelease(scheduler, offset: schedRunqSizeOffset, value: __Raw.wrappingAdd(__Raw.loadWord(scheduler, offset: schedRunqSizeOffset), right: count))
end 'globalPutBatch'

// globalPutList puts a list of green threads that a take of events readied at the tail, under the lock.
function globalPutList(scheduler Count, list Count)
	var g = list
	while g != noGreen 'each'
		let next = __Raw.loadWord(g, offset: greenLinkOffset)
		globalPut(scheduler, g: g)
		g = next
	end 'each'
end 'globalPutList'

// globalGet is Go's globrunqget, under the lock: a green thread to run, and a share of the rest onto the processor's
// ring, at most a share per processor and half a ring, or most when it is not 0. The ring is empty, or most is 1.
function globalGet(scheduler Count, proc Count, most Count) returns Count
	let size = __Raw.loadWord(scheduler, offset: schedRunqSizeOffset)
	if size == 0 'empty'
		return noGreen
	end 'empty'
	var n = __Raw.wrappingAdd(try size / procCount(scheduler) otherwise panic("a scheduler of no processor"), right: 1)
	if n > size 'size'
		n = size
	end 'size'
	if most > 0 and n > most 'most'
		n = most
	end 'most'
	if n > procRunqSlots / 2 'half'
		n = procRunqSlots / 2
	end 'half'
	__Raw.storeRelease(scheduler, offset: schedRunqSizeOffset, value: __Raw.wrappingSub(size, right: n))
	let g = globalPop(scheduler)
	for i in 1 upto n 'rest'
		runqPutUnspilled(proc, g: globalPop(scheduler))
	end 'rest'
	return g
end 'globalGet'

// globalPop takes the head of the global run queue, whose size the caller has lowered.
function globalPop(scheduler Count) returns Count
	let g = __Raw.loadWord(scheduler, offset: schedRunqHeadOffset)
	let next = entryLink(g)
	__Raw.storeWord(scheduler, offset: schedRunqHeadOffset, value: next)
	if next == noGreen 'last'
		__Raw.storeWord(scheduler, offset: schedRunqTailOffset, value: noGreen)
	end 'last'
	return g
end 'globalPop'

// runqPutUnspilled puts at the tail of a ring that has room, as globalGet's share does: a spill would take the lock it
// holds.
function runqPutUnspilled(proc Count, g Count)
	let tail = __Raw.loadWord(proc, offset: procRunqTailOffset)
	if __Raw.wrappingSub(tail, right: __Raw.loadAcquire(proc, offset: procRunqHeadOffset)) >= procRunqSlots 'full'
		panic("the global run queue's share overflows a processor's run queue")
	end 'full'
	__Raw.storeWord(runqSlot(proc, index: tail), offset: 0, value: g)
	__Raw.storeRelease(proc, offset: procRunqTailOffset, value: __Raw.wrappingAdd(tail, right: 1))
end 'runqPutUnspilled'

function lockScheduler(scheduler Count)
	spinLock(scheduler, offset: schedLockOffset)
end 'lockScheduler'

function unlockScheduler(scheduler Count)
	spinUnlock(scheduler, offset: schedLockOffset)
end 'unlockScheduler'

// The runtime's locks, the scheduler's and the page heap's: a word taken by a compare-exchange from 0 to 1 and given back
// by a store, held for a few loads and stores, or a system call, and never across a wait. Runtime code is never stopped by
// the monitor, so a holder is only ever descheduled by the system, and a waiter yields after a few rounds so as not to keep
// it from running.
function spinLock(record Count, offset Count)
	var round = 0 as Count
	while __Raw.compareExchange(record, offset: offset, expected: unset, desired: set) != unset 'take'
		if round < lockSpinRounds 'spin'
			for i in 0 upto lockPauses 'pauses'
				__Raw.spinPause()
			end 'pauses'
			round = __Raw.wrappingAdd(round, right: 1)
		end 'spin' else 'yield'
			yieldThread()
		end 'yield'
	end 'take'
end 'spinLock'

function spinUnlock(record Count, offset Count)
	_ = __Raw.atomicExchange(record, offset: offset, value: unset)
end 'spinUnlock'

// yieldThread gives the processor the thread runs on to another thread of the system.
function yieldThread()
	#if os(Windows)
		_ = __Raw.callImport0("SwitchToThread")
	#endif
	#if os(Linux)
		_ = __Raw.syscall0(linuxSysSchedYield)
	#endif
	#if os(macOS)
		yieldProcessor()
	#endif
end 'yieldThread'

// waitStopped waits until a waker clears the context's stopped flag (wakeThread). A wake before the wait makes the wait
// return at once: on Windows the auto-reset event stays set, on Linux the futex sees the flag already 0, and on macOS the
// parker reads it under its mutex. The flag is read as an acquire, so what the waker stored before its exchange, the
// processor it hands over among it, is seen after.
function waitStopped(context Count)
	while __Raw.loadAcquire(context, offset: contextStoppedOffset) == set 'wait'
		#if os(Windows)
			_ = __Raw.callImport2("WaitForSingleObject", arg1: __Raw.loadWord(context, offset: contextParkEventOffset), arg2: waitForever)
		#endif
		#if os(Linux)
			futexWait(__Raw.wrappingAdd(context, right: contextStoppedOffset), value: set)
		#endif
		#if os(macOS)
			parkWhileSet(__Raw.loadWord(context, offset: contextParkEventOffset), word: __Raw.wrappingAdd(context, right: contextStoppedOffset))
		#endif
	end 'wait'
end 'waitStopped'

// wakeThread wakes a stopped thread, which the waker has taken off the idle list.
function wakeThread(context Count)
	_ = __Raw.atomicExchange(context, offset: contextStoppedOffset, value: unset)
	#if os(Windows)
		_ = __Raw.callImport1("SetEvent", arg1: __Raw.loadWord(context, offset: contextParkEventOffset))
	#endif
	#if os(Linux)
		futexWakeOne(__Raw.wrappingAdd(context, right: contextStoppedOffset))
	#endif
	#if os(macOS)
		unpark(__Raw.loadWord(context, offset: contextParkEventOffset))
	#endif
end 'wakeThread'

// makeScheduler makes the scheduler's record and the processors, the event queue, and the main thread's part as thread 0 with
// processor 0.
function makeScheduler(mainContext Count) returns Count
	let procs = workerCount()
	let scheduler = keep(try schedProcessorsOffset + procs * wordBytes otherwise panic("too many processors for memory"))
	__Raw.storeWord(scheduler, offset: schedProcsOffset, value: procs)
	__Raw.storeWord(scheduler, offset: schedMainThreadOffset, value: mainContext)
	__Raw.storeWord(scheduler, offset: schedLastTakeOffset, value: 1)
	__Raw.storeWord(scheduler, offset: schedIdleProcCountOffset, value: __Raw.wrappingSub(procs, right: 1))
	let main = makeProc(scheduler)
	initThread(scheduler, context: mainContext)
	setThreadIdentity(mainContext)
	initEventQueue(scheduler)
	initPreemption()
	acquireProc(mainContext, proc: main)
	return scheduler
end 'makeScheduler'

// initThread gives a thread's context what the scheduler reads of it, before the thread runs green threads: its block,
// its event, the code a preemption calls, its random state, and its place on the list of every such thread.
function initThread(scheduler Count, context Count)
	__Raw.storeWord(context, offset: contextSchedulerOffset, value: scheduler)
	__Raw.storeWord(context, offset: contextSchedSwitchOffset, value: keep(threadBlockBytes))
	#if os(Windows)
		__Raw.storeWord(context, offset: contextParkEventOffset, value: newEvent())
	#endif
	#if os(macOS)
		__Raw.storeWord(context, offset: contextParkEventOffset, value: newParker())
	#endif
	__Raw.storeWord(context, offset: contextPreemptCodeOffset, value: __Raw.codeAddress("asyncPreempted"))
	#if os(Linux) or os(macOS)
		__Raw.storeWord(context, offset: contextSignalCodeOffset, value: __Raw.codeAddress("preemptSignal"))
	#endif
	__Raw.storeWord(context, offset: contextRandomOffset, value: __Raw.wrappingAdd(context, right: randomStep))
	lockScheduler(scheduler)
	__Raw.storeWord(context, offset: contextAllNextOffset, value: __Raw.loadWord(scheduler, offset: schedAllThreadsOffset))
	__Raw.storeWord(scheduler, offset: schedAllThreadsOffset, value: context)
	unlockScheduler(scheduler)
end 'initThread'

// newThread is Go's newm: a thread of its own context that runs proc, started at once.
function newThread(scheduler Count, proc Count, spinning bool)
	let context = keep(contextBytes)
	initThread(scheduler, context: context)
	__Raw.storeWord(context, offset: contextNextProcOffset, value: proc)
	__Raw.storeWord(context, offset: contextSpinningOffset, value: set if spinning else unset)
	startThread(context)
end 'newThread'

// noThreadBlock is the block of the one thread of a program without the scheduler, which has none.
let noThreadBlock = 0 as Count

// threadBlockSwitch is the switch record of a thread's scheduler, at the start of its block.
function threadBlockSwitch(context Count) returns Count
	return __Raw.loadWord(context, offset: contextSchedSwitchOffset)
end 'threadBlockSwitch'

// carve is a record of a number of bytes from the scheduler's carving block, which the runtime keeps for good: the
// records of green threads, which free lists reuse, so the leak check does not count them.
function carve(scheduler Count, bytes Count) returns Count
	lockScheduler(scheduler)
	var next = __Raw.loadWord(scheduler, offset: schedCarveNextOffset)
	if __Raw.wrappingAdd(next, right: bytes) > __Raw.loadWord(scheduler, offset: schedCarveEndOffset) or next == 0 'block'
		var block = __Raw.loadWord(scheduler, offset: schedCarveBytesOffset)
		if block == 0 'first'
			block = firstCarveBlockBytes
		end 'first'
		next = keep(block)
		__Raw.storeWord(scheduler, offset: schedCarveEndOffset, value: __Raw.wrappingAdd(next, right: block))
		if block < carveBlockBytes 'grow'
			__Raw.storeWord(scheduler, offset: schedCarveBytesOffset, value: __Raw.wrappingAdd(block, right: block))
		end 'grow'
	end 'block'
	__Raw.storeWord(scheduler, offset: schedCarveNextOffset, value: __Raw.wrappingAdd(next, right: bytes))
	unlockScheduler(scheduler)
	return next
end 'carve'

#if os(Windows)
	// startThread starts a thread at once, with the main thread's stack reserve, which CreateThread reserves rather than
	// commits when told so. The thread's handle is closed: a thread that the monitor may stop makes a handle of its own
	// (setThreadIdentity).
	function startThread(context Count)
		let thread = __Raw.callImport6("CreateThread", arg1: noThreadAttributes, arg2: stackReserveBytes, arg3: __Raw.threadStartAddress(), arg4: context, arg5: stackSizeIsReservation, arg6: noThreadId)
		if thread == 0 'failed'
			panic("cannot start a thread")
		end 'failed'
		closeHandle(thread)
	end 'startThread'

	// newEvent is a thread's event: auto-reset, so that a wait consumes the wake that ended it, and unset.
	function newEvent() returns Count
		let event = __Raw.callImport4("CreateEventW", arg1: noEventAttributes, arg2: autoReset, arg3: startsUnset, arg4: noEventName)
		if event == 0 'failed'
			panic("cannot make a thread's event")
		end 'failed'
		return event
	end 'newEvent'
#endif

// workerCount is how many processors run green threads: the processors of every group, which Windows may fail to
// count, or the count MAXON_MAX_PROCS asks for.
function workerCount() returns Count
	let requested = requestedWorkers()
	if requested != noRequest 'requested'
		return requested
	end 'requested'
	#if os(Windows)
		let processors = dword(__Raw.callImport1("GetActiveProcessorCount", arg1: allProcessorGroups))
	#else
		let processors = onlineProcessors()
	#endif
	if processors < fewestWorkers 'uncounted'
		return fewestWorkers
	end 'uncounted'
	return processors
end 'workerCount'

// osProcessorCount is Scheduler.processorCount: the processors the runtime runs green threads on, which is fixed by the
// machine and the environment alone, so it is the same before the first behaviour is scheduled as after it.
function osProcessorCount() returns Count
	return workerCount()
end 'osProcessorCount'

// requestedWorkers is the count MAXON_MAX_PROCS asks for, or noRequest when it is unset or asks for none it may.
function requestedWorkers() returns Count
	var failed = 0 as Count
	let text = osEnvironmentVariable(maxProcsVariable, errorAddress: __Raw.addressOf(failed))
	if failed != 0 'unset'
		return noRequest
	end 'unset'
	let n = text.byteLength()
	var i = 0 as Count
	if n > 0 and text.byteAt(0) == plusSign 'sign'
		i = 1
	end 'sign'
	if i == n 'noDigits'
		return noRequest
	end 'noDigits'
	var count = 0 as Count
	while i < n 'digits'
		let c = text.byteAt(i)
		if c < digitZero or c > digitNine 'notDigit'
			return noRequest
		end 'notDigit'
		count = try count * decimalBase + ((try c - digitZero otherwise 0) as Count) otherwise return noRequest
		if count > mostRequestedWorkers 'tooMany'
			return noRequest
		end 'tooMany'
		i = __Raw.wrappingAdd(i, right: 1)
	end 'digits'
	if count < fewestWorkers 'tooFew'
		return noRequest
	end 'tooFew'
	return count
end 'requestedWorkers'
