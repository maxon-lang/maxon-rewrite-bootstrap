	end 'cancelPending'

	// entryUserNew has nothing to make: a user event is a packet posted to the port, keyed by its entry.
	function entryUserNew(scheduler Count, entry Count)
	end 'entryUserNew'

	function entryUserFree(scheduler Count, entry Count)
	end 'entryUserFree'

	// eventSignal signals a user event's entry with a completion packet whose key is the entry, from any thread.
	function eventSignal(entry Count)
		postCompletion(__Raw.loadWord(__Raw.threadContext(), offset: contextSchedulerOffset), key: entry)
	end 'eventSignal'

	// processWatch makes a job object that holds the process alone and posts a completion keyed by the entry when it is
	// empty, whose handle the entry holds, or gives noEntry.
	function processWatch(scheduler Count, process Count) returns Count
		let job = __Raw.callImport2("CreateJobObjectW", arg1: noSecurity, arg2: noName)
