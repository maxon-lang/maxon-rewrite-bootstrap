	let anyConcurrency = 0 as Count

	let waitTimeout = 258 as Count

	// eventWaitForeverMillis is GetQueuedCompletionStatusEx's timeout of a wait with no end, INFINITE, and
	// longestPortWaitMillis the longest finite one it is given, the largest DWORD below it.
