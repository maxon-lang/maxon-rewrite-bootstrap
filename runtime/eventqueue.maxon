			entryGive(scheduler, entry: entry)
			closeHandle(job)
			return noEntry
		end 'unheld'
		return entry
	end 'processWatch'

	// jobHolds has a job's limits keep the children of its processes out of it, its notifications go to the port with the
	// entry as their key, and the process in it, and says whether each took.
	function jobHolds(job Count, process Count, entry Count, port Count) returns bool
		let record = alloc(jobRecordBytes)
		zeroRange(record, from: 0, to: jobRecordBytes)
		__Raw.storeWord32(record, offset: jobLimitFlagsOffset, value: jobSilentBreakawayOk)
		var held = dword(__Raw.callImport4("SetInformationJobObject", arg1: job, arg2: jobExtendedLimitInformation, arg3: record, arg4: jobRecordBytes)) != 0
		if held 'associate'
			zeroRange(record, from: 0, to: jobRecordBytes)
			__Raw.storeWord(record, offset: jobPortKeyOffset, value: entry)
			__Raw.storeWord(record, offset: jobPortOffset, value: port)
			held = dword(__Raw.callImport4("SetInformationJobObject", arg1: job, arg2: jobAssociateCompletionPort, arg3: record, arg4: wordBytes + wordBytes)) != 0
		end 'associate'
		free(record)
		if held 'assign'
			held = dword(__Raw.callImport2("AssignProcessToJobObject", arg1: job, arg2: process)) != 0
		end 'assign'
		return held
	end 'jobHolds'

	// processWatchClose closes the job object of a process's entry.
	function processWatchClose(job Count)
		closeHandle(job)
	end 'processWatchClose'
#endif
