	let overlappedBytes = 32 as Count

	// The values of a job object that holds a process and the tree it starts, and reports each exit of a process in it to the port:
	// JobObjectAssociateCompletionPortInformation and JobObjectExtendedLimitInformation, whose JOBOBJECT_EXTENDED_LIMIT_INFORMATION
	// is 144 bytes with its LimitFlags, 32 bits, at 16; JOB_OBJECT_LIMIT_BREAKAWAY_OK, which lets a process of the job start one
	// that leaves it (CREATE_BREAKAWAY_FROM_JOB) and keeps every other child of its processes in it; and the messages
	// JOB_OBJECT_MSG_EXIT_PROCESS and JOB_OBJECT_MSG_ABNORMAL_EXIT_PROCESS, whose OVERLAPPED word is the id of the process that ended, and
	// JOB_OBJECT_MSG_ACTIVE_PROCESS_ZERO, the message that says no process is left in it, which is how a kill of the job is reported (it sends no exit message for a process it ends).
