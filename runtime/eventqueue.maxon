		let create = libraryFunction(native, name: "NtCreateWaitCompletionPacket")
		let associate = libraryFunction(native, name: "NtAssociateWaitCompletionPacket")
		let cancel = libraryFunction(native, name: "NtCancelWaitCompletionPacket")
