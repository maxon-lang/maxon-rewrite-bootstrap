	let jobExtendedLimitInformation = 9 as Count

	let jobRecordBytes = 144 as Count

	let jobLimitFlagsOffset = 16 as Count

	let jobBreakawayOk = 0x800 as Count

	let jobMessageActiveProcessZero = 4 as Count

	let jobMessageExitProcess = 7 as Count

	let jobMessageAbnormalExitProcess = 8 as Count

