		if __Raw.callImport2("SetFileCompletionNotificationModes", arg1: handle, arg2: skipOnSuccess) == 0 'modes'
			return false
		end 'modes'
		return __Raw.callImport4("CreateIoCompletionPort", arg1: handle, arg2: __Raw.loadWord(scheduler, offset: schedEventQueueOffset), arg3: entry, arg4: anyConcurrency) != 0
	end 'entryRegister'

	// entryUnregister has nothing to do: a handle leaves the port when it is closed, and no operation of it is pending.
	function entryUnregister(scheduler Count, entry Count)
	end 'entryUnregister'

	// eventOverlapped is the OVERLAPPED of a mode of a handle's entry, cleared, for its next operation, which the
	// caller starts at a file's position by its Offset and OffsetHigh, and reads the status (Internal) and the count
	// (InternalHigh) of once it completed.
	function eventOverlapped(entry Count, mode Count) returns Count
		var overlapped = __Raw.wrappingAdd(entry, right: entryReadOverlappedOffset)
		if mode == eventWrite 'write'
			overlapped = __Raw.wrappingAdd(entry, right: entryWriteOverlappedOffset)
		end 'write'
		var offset = 0 as Count
		while offset < overlappedBytes 'clear'
			__Raw.storeWord(overlapped, offset: offset, value: 0)
			offset = __Raw.wrappingAdd(offset, right: wordBytes)
		end 'clear'
		return overlapped
	end 'eventOverlapped'

	// cancelPending is what a wait on a handle's operation that ended otherwise than by its completion does: it cancels
	// the operation and waits for its completion, which comes whether the cancel took hold or the operation had completed,
	// and gives the wait's status, eventReady when the operation completed all the same.
