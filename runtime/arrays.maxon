// The array entries, and the routines that arrays and byte arrays share. A byte array's box is an array's box
// (layout_gen.maxon): the length, the capacity and the address of a buffer, whose elements are a number of bytes each, so
// one set of routines takes the size of an element and the entries of each kind are thin functions over them. The
// elements of an array are words that the caller owns once they are moved out; the routines only ever move bytes, and
// never free an element.

// arrayNew is a new empty array: no buffer yet.
function arrayNew() returns Count
	return alloc(arrayHeaderBytes)
end 'arrayNew'

function arrayLength(array Count) returns Count
	return collectionLength(array)
end 'arrayLength'

// arrayElem is the address of the element at an index, which panics past the end. It is a borrow, valid until the next
// call that changes the array.
function arrayElem(array Count, index Count) returns Count
	return collectionElementAddress(array, index: index, elementBytes: wordBytes)
end 'arrayElem'

// arrayPop moves the last element out, which there is (the caller checked): nothing follows it, so only the length changes.
function arrayPop(array Count) returns Count
	return __Raw.loadWord(collectionPop(array, elementBytes: wordBytes), offset: 0)
end 'arrayPop'

// arrayInsert moves an element in at an index, which may be the length, after what follows moves up by one.
function arrayInsert(array Count, index Count, element Count)
	let at = collectionOpenGap(array, index: index, elementBytes: wordBytes)
	__Raw.storeWord(at, offset: 0, value: element)
end 'arrayInsert'

// arrayRemove moves the element at an index out, after what follows moves down by one: the caller owns it.
function arrayRemove(array Count, index Count) returns Count
	let at = collectionElementAddress(array, index: index, elementBytes: wordBytes)
	let element = __Raw.loadWord(at, offset: 0)
	collectionCloseGap(array, index: index, elementBytes: wordBytes)
	return element
end 'arrayRemove'

// arrayFill appends count copies of a word that needs no copy of its own, a scalar or the 0 of an empty slot, as as many
// inserts at the end would, in one pass over the room.
function arrayFill(array Count, count Count, word Count)
	let at = collectionExtend(array, count: count, elementBytes: wordBytes)
	let past = __Raw.wrappingAdd(at, right: collectionBytes(count, elementBytes: wordBytes))
	var place = at
	while place != past 'words'
		__Raw.storeWord(place, offset: 0, value: word)
		place = __Raw.wrappingAdd(place, right: wordBytes)
	end 'words'
end 'arrayFill'

// arrayCapacity is how many elements the buffer of an array or a byte array holds.
function arrayCapacity(array Count) returns Count
	return __Raw.loadWord(array, offset: arrayCapacityOffset)
end 'arrayCapacity'

// arrayReserve makes the buffer of an array hold a count of elements, exactly, where it holds fewer: a caller that knows how
// many it will insert pays for one buffer rather than for each doubling up to it.
function arrayReserve(array Count, count Count)
	if count > __Raw.loadWord(array, offset: arrayCapacityOffset) 'more'
		collectionMove(array, capacity: count, elementBytes: wordBytes)
	end 'more'
end 'arrayReserve'

// The entries of an array of strings, whose elements are a String each, __Raw.stringSize() bytes: the code that calls them
// moves the Strings in and out of the addresses they give.

// stringsElem is the address of the element at an index, which panics past the end.
function stringsElem(array Count, index Count) returns Count
	return collectionElementAddress(array, index: index, elementBytes: __Raw.stringSize())
end 'stringsElem'

// stringsOpen makes room for an element at an index, which may be the length, and gives its address: an empty String,
// its words 0, which the code may fill or leave empty.
function stringsOpen(array Count, index Count) returns Count
	let at = collectionOpenGap(array, index: index, elementBytes: __Raw.stringSize())
	__Raw.storeWord(at, offset: 0, value: 0)
	__Raw.storeWord(at, offset: wordBytes, value: 0)
	return at
end 'stringsOpen'

// stringsClose takes the element at an index, which the code moved out, out of the buffer.
function stringsClose(array Count, index Count)
	_ = collectionElementAddress(array, index: index, elementBytes: __Raw.stringSize())
	collectionCloseGap(array, index: index, elementBytes: __Raw.stringSize())
end 'stringsClose'

// stringsFill appends count empty elements, which alloc zeroed.
function stringsFill(array Count, count Count)
	let at = collectionExtend(array, count: count, elementBytes: __Raw.stringSize())
	let past = __Raw.wrappingAdd(at, right: collectionBytes(count, elementBytes: __Raw.stringSize()))
	var place = at
	while place != past 'words'
		__Raw.storeWord(place, offset: 0, value: 0)
		place = __Raw.wrappingAdd(place, right: wordBytes)
	end 'words'
end 'stringsFill'

// stringsReserve makes the buffer hold a count of elements, exactly, where it holds fewer.
function stringsReserve(array Count, count Count)
	if count > __Raw.loadWord(array, offset: arrayCapacityOffset) 'more'
		collectionMove(array, capacity: count, elementBytes: __Raw.stringSize())
	end 'more'
end 'stringsReserve'

// The entries of an array of records held in place, whose elements are the words of a record each, a number of bytes the
// code that calls them knows: it copies the words in and out of the addresses they give.

// recordsElem is the address of the element at an index, which panics past the end.
function recordsElem(array Count, index Count, bytes Count) returns Count
	return collectionElementAddress(array, index: index, elementBytes: bytes)
end 'recordsElem'

// recordsOpen makes room for an element at an index, which may be the length, and gives its address: its words 0, which
// the code fills.
function recordsOpen(array Count, index Count, bytes Count) returns Count
	let at = collectionOpenGap(array, index: index, elementBytes: bytes)
	var offset = 0 as Count
	while offset < bytes 'words'
		__Raw.storeWord(at, offset: offset, value: 0)
		offset = __Raw.wrappingAdd(offset, right: wordBytes)
	end 'words'
	return at
end 'recordsOpen'

// recordsClose takes the element at an index, whose words the code copied out, out of the buffer.
function recordsClose(array Count, index Count, bytes Count)
	_ = collectionElementAddress(array, index: index, elementBytes: bytes)
	collectionCloseGap(array, index: index, elementBytes: bytes)
end 'recordsClose'

// recordsReserve makes the buffer hold a count of elements, exactly, where it holds fewer.
function recordsReserve(array Count, count Count, bytes Count)
	if count > __Raw.loadWord(array, offset: arrayCapacityOffset) 'more'
		collectionMove(array, capacity: count, elementBytes: bytes)
	end 'more'
end 'recordsReserve'

// recordsShrink makes an array of records held in place a length that is not above its own, and keeps the buffer: a
// record held in place needs no drop.
function recordsShrink(array Count, length Count, bytes Count)
	arrayShrink(array, length: length)
end 'recordsShrink'

// arrayShrink makes an array or a byte array a length that is not above its own, and keeps the buffer. The elements
// above the length are the caller's to have moved out or dropped already, or need no drop.
function arrayShrink(array Count, length Count)
	if length > collectionLength(array) 'above'
		panicIndex()
	end 'above'
	__Raw.storeWord(array, offset: arrayLengthOffset, value: length)
end 'arrayShrink'

// arrayAppendSpan appends the count elements of other from start, elementBytes bytes each, in one copy of their bytes: the
// code calls it only for elements whose copy is their bytes, and checked that the span lies in other. Other may be the
// array itself: its buffer is read after the room is made, since making it can move that buffer, and the span lies below
// the old length, so it never overlaps the room.
function arrayAppendSpan(array Count, other Count, start Count, count Count, elementBytes Count)
	if count == 0 'empty'
		return
	end 'empty'
	let tail = collectionExtend(array, count: count, elementBytes: elementBytes)
	copyBytes(collectionPlace(other, index: start, elementBytes: elementBytes), target: tail, count: collectionBytes(count, elementBytes: elementBytes))
end 'arrayAppendSpan'

function collectionLength(box Count) returns Count
	return __Raw.loadWord(box, offset: arrayLengthOffset)
end 'collectionLength'

function collectionData(box Count) returns Count
	return __Raw.loadWord(box, offset: arrayDataOffset)
end 'collectionData'

// collectionElementAddress is where the element at an index is, which panics past the end.
function collectionElementAddress(box Count, index Count, elementBytes Count) returns Count
	if index >= collectionLength(box) 'outside'
		panicIndex()
	end 'outside'
	return collectionPlace(box, index: index, elementBytes: elementBytes)
end 'collectionElementAddress'

// collectionPlace is where the element at an index is, or would be: the index may be the length.
function collectionPlace(box Count, index Count, elementBytes Count) returns Count
	return __Raw.wrappingAdd(collectionData(box), right: collectionBytes(index, elementBytes: elementBytes))
end 'collectionPlace'

// collectionBytes is the size of a number of elements, which panics when no word holds it.
function collectionBytes(count Count, elementBytes Count) returns Count
	return try count * elementBytes otherwise panic("array size overflows")
end 'collectionBytes'

// The growth policy, maxon's (ManagedMemoryRuntime's __managed_grown_cap) and Go's nextslicecap, and the only one: every
// buffer that grows to hold more, an array's, a byte array's and a String's (strings.maxon), takes the capacity it gives.
// Below growthThreshold a buffer doubles, which copies a small one least; above it the step is
// (capacity + easeNumeratorScale * growthThreshold) / easeDivisor, a ratio of 1.25 + 0.75 * growthThreshold / capacity
// that eases toward 1.25, since a doubled big buffer holds up to a whole buffer of slack. An ask that outruns doubling is
// taken as it is, and no capacity is below minimumCapacity, so a small ask does not climb 1, 2, 3. A reserve is exact and
// takes none of it.
let growthThreshold = 256 as Count

let minimumCapacity = 4 as Count

let easeNumeratorScale = 3 as Count

let easeDivisor = 4 as Count

// grownCapacity is the capacity a buffer of a capacity grows to so that it holds a number of elements.
function grownCapacity(current Count, required Count) returns Count
	let doubled = try current + current otherwise panic("array size overflows")
	if required > doubled 'ask'
		return atLeastMinimum(required)
	end 'ask'
	if current < growthThreshold 'double'
		return atLeastMinimum(doubled)
	end 'double'
	var capacity = current
	while capacity < required 'ease'
		capacity = try capacity + (capacity + easeNumeratorScale * growthThreshold) / easeDivisor otherwise panic("array size overflows")
	end 'ease'
	return capacity
end 'grownCapacity'

function atLeastMinimum(capacity Count) returns Count
	if capacity < minimumCapacity 'floor'
		return minimumCapacity
	end 'floor'
	return capacity
end 'atLeastMinimum'

// collectionReserve makes the buffer hold a number of elements, growing it by the growth policy.
function collectionReserve(box Count, needed Count, elementBytes Count)
	let capacity = __Raw.loadWord(box, offset: arrayCapacityOffset)
	if needed <= capacity 'room'
		return
	end 'room'
	collectionMove(box, capacity: grownCapacity(capacity, required: needed), elementBytes: elementBytes)
end 'collectionReserve'

// collectionMove makes the buffer hold a larger capacity, whose slots past the length read zero, as a new buffer's do: in
// place where the heap can grow it, and else by moving the elements into a new buffer (grownBox) and freeing the one it
// leaves: the elements moved to the new one, so only the buffer goes.
function collectionMove(box Count, capacity Count, elementBytes Count)
	let old = collectionData(box)
	let held = collectionBytes(__Raw.loadWord(box, offset: arrayCapacityOffset), elementBytes: elementBytes)
	let length = collectionBytes(collectionLength(box), elementBytes: elementBytes)
	let buffer = grownBox(old, held: held, kept: length, bytes: collectionBytes(capacity, elementBytes: elementBytes), zeroed: true)
	if buffer != old 'moved'
		__Raw.storeWord(box, offset: arrayDataOffset, value: buffer)
		free(old)
	end 'moved'
	__Raw.storeWord(box, offset: arrayCapacityOffset, value: capacity)
end 'collectionMove'

// collectionExtend adds room for a number of elements after the last and gives the address of the room, which the
// caller fills.
function collectionExtend(box Count, count Count, elementBytes Count) returns Count
	let length = collectionLength(box)
	let total = try length + count otherwise panic("array size overflows")
	collectionReserve(box, needed: total, elementBytes: elementBytes)
	__Raw.storeWord(box, offset: arrayLengthOffset, value: total)
	return collectionPlace(box, index: length, elementBytes: elementBytes)
end 'collectionExtend'

// collectionOpenGap makes room for one element at an index, which may be the length and panics past it, by moving what
// follows up by one, and gives the address of the room. The index is
// not past the length, so its subtraction does not wrap.
function collectionOpenGap(box Count, index Count, elementBytes Count) returns Count
	let length = collectionLength(box)
	if index > length 'outside'
		panicIndex()
	end 'outside'
	_ = collectionExtend(box, count: 1, elementBytes: elementBytes)
	let at = collectionPlace(box, index: index, elementBytes: elementBytes)
	let moving = collectionBytes(__Raw.wrappingSub(length, right: index), elementBytes: elementBytes)
	if moving != 0 'follows'
		copyBackward(at, target: __Raw.wrappingAdd(at, right: elementBytes), count: moving)
	end 'follows'
	return at
end 'collectionOpenGap'

// collectionPop leaves the last element, which there is, out of the length, and gives its address: its bytes stay where they
// are until the buffer is next written.
function collectionPop(box Count, elementBytes Count) returns Count
	let last = __Raw.wrappingSub(collectionLength(box), right: 1)
	__Raw.storeWord(box, offset: arrayLengthOffset, value: last)
	return collectionPlace(box, index: last, elementBytes: elementBytes)
end 'collectionPop'

// collectionCloseGap takes the element at an index out of the buffer by moving what follows down by one. The index is
// in range, which collectionElementAddress has checked, so its subtractions do not wrap.
function collectionCloseGap(box Count, index Count, elementBytes Count)
	let length = collectionLength(box)
	let at = collectionPlace(box, index: index, elementBytes: elementBytes)
	let following = __Raw.wrappingSub(__Raw.wrappingSub(length, right: index), right: 1)
	let moving = collectionBytes(following, elementBytes: elementBytes)
	if moving != 0 'follows'
		copyForward(__Raw.wrappingAdd(at, right: elementBytes), target: at, count: moving)
	end 'follows'
	__Raw.storeWord(box, offset: arrayLengthOffset, value: __Raw.wrappingSub(length, right: 1))
end 'collectionCloseGap'

// copyBackward copies a word at a time from the end and then the bytes left at the start, so that a target above the
// source may overlap it: each word is read before the target that overlaps it is written.
function copyBackward(source Count, target Count, count Count)
	var left = count
	while left >= wordBytes 'words'
		left = __Raw.wrappingSub(left, right: wordBytes)
		__Raw.storeWord(target, offset: left, value: __Raw.loadWord(source, offset: left))
	end 'words'
	while left != 0 'bytes'
		left = __Raw.wrappingSub(left, right: 1)
		__Raw.storeByte(target, offset: left, value: __Raw.loadByte(source, offset: left))
	end 'bytes'
end 'copyBackward'
