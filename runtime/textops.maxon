// The String built-ins that look at more than one byte: the entries of the text operations (counting graphemes, searching,
// replacing, trimming, changing case). These are the runtime's functions for those entries (`runtimeFunctions` in
// internal/builtingen/table.go) and also, copied by that generator to self/interp/textops_gen.maxon, the interpreter's, so
// that one text says what each means. Everything here uses only what both modules have: a String's byte operations,
// interpolation and integers; a position is a byte position in a string, and a search gives its position plus 1, so that
// 0 is no match.

let strAsciiLimit = 0x80 as Byte

let strCarriageReturn = 13 as Byte

let strLineFeed = 10 as Byte

let strSpace = 32 as Byte

let strLowerFirst = 97 as Byte

let strLowerLast = 122 as Byte

let strUpperFirst = 65 as Byte

let strUpperLast = 90 as Byte

let strLowerLetters = "abcdefghijklmnopqrstuvwxyz"

let strUpperLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

// strLeadTwo, strLeadThree and strLeadFour are the lowest lead byte of a sequence of that many bytes.
let strLeadTwo = 0xC0 as Byte

let strLeadThree = 0xE0 as Byte

let strLeadFour = 0xF0 as Byte

let strTwoByteMask = 0x1F as Count

let strThreeByteMask = 0x0F as Count

let strFourByteMask = 0x07 as Count

let strContinuationMask = 0x3F as Count

let strContinuationSpan = 64 as Count

let strHangulSyllableFirst = 0xAC00 as Count

let strHangulSyllableLast = 0xD7A3 as Count

let strHangulTailCount = 28 as Count

let strZeroWidthJoiner = 0x200D as Count

// strAdd is a sum of positions and lengths, which fits a string that the heap holds.
function strAdd(left Count, right Count) returns Count
	return try left + right otherwise panic("a text position overflows")
end 'strAdd'

// strSub is a difference of positions, the one that the caller knows is not below 0.
function strSub(left Count, right Count) returns Count
	return try left - right otherwise panic("a text position underflows")
end 'strSub'

// strSequenceLength is how many bytes the sequence that starts with the byte first has; a byte that continues one is its own.
function strSequenceLength(first Byte) returns Count
	if first < strLeadTwo 'single'
		return 1
	end 'single'
	if first < strLeadThree 'two'
		return 2
	end 'two'
	if first < strLeadFour 'three'
		return 3
	end 'three'
	return 4
end 'strSequenceLength'

// strCodePoint is the code point of the sequence of the given length at a position, whose bytes the string has.
function strCodePoint(text String, at Count, length Count) returns Count
	let first = text.byteAt(at) as Count
	if length == 1 'single'
		return first
	end 'single'
	var mask = strTwoByteMask
	if length == 3 'three'
		mask = strThreeByteMask
	end 'three'
	if length == 4 'four'
		mask = strFourByteMask
	end 'four'
	var code = first and mask
	for i in 1 upto length 'continuations'
		let next = text.byteAt(strAdd(at, right: i)) as Count
		code = strAdd(try code * strContinuationSpan otherwise panic("a code point overflows"), right: next and strContinuationMask)
	end 'continuations'
	return code
end 'strCodePoint'

let strAsciiCodeLimit = 0x80 as Count

let strCarriageReturnCode = 13 as Count

let strLineFeedCode = 10 as Count

let strControlLimit = 32 as Count

let strDeleteCode = 0x7F as Count

// strTableDigit is the value of the character of the table at a position.
function strTableDigit(at Count) returns Count
	let character = strGraphemeTable.byteAt(at) as Count
	if character > strTableDigitEscape 'afterEscape'
		return strSub(strSub(character, right: strTableDigitFirst), right: 1)
	end 'afterEscape'
	return strSub(character, right: strTableDigitFirst)
end 'strTableDigit'

// strTableEntry is the number of the entry of the table at an index: the first code point of a run of one class, shifted up
// by strTableClassBits, and the class.
function strTableEntry(index Count) returns Count
	let first = try index * strTableDigits otherwise panic("a table position overflows")
	var value = 0 as Count
	for i in 0 upto strTableDigits 'digits'
		value = strAdd(try value shl strTableDigitBits otherwise panic("a table entry overflows"), right: strTableDigit(strAdd(first, right: i)))
	end 'digits'
	return value
end 'strTableEntry'

// strGraphemeClass is the class of a code point.
function strGraphemeClass(code Count) returns StrGraphemeClass
	if code < strAsciiCodeLimit 'ascii'
		if code == strCarriageReturnCode 'carriageReturn'
			return StrGraphemeClass.classCarriageReturn
		end 'carriageReturn'
		if code == strLineFeedCode 'lineFeed'
			return StrGraphemeClass.classLineFeed
		end 'lineFeed'
		if code < strControlLimit or code == strDeleteCode 'control'
			return StrGraphemeClass.classControl
		end 'control'
		return StrGraphemeClass.classOther
	end 'ascii'
	if code >= strHangulSyllableFirst and code <= strHangulSyllableLast 'syllable'
		if strSub(code, right: strHangulSyllableFirst) mod strHangulTailCount == 0 'open'
			return StrGraphemeClass.classHangulLV
		end 'open'
		return StrGraphemeClass.classHangulLVT
	end 'syllable'
	// The last entry whose first code point is at most the code point: the entry at 0 is the first, so one always is.
	var low = 0 as Count
	var high = strTableEntryCount
	while strSub(high, right: low) > 1 'search'
		let middle = strAdd(low, right: strSub(high, right: low) / 2)
		if strTableEntry(middle) shr strTableClassBits <= code 'right'
			low = middle
		end 'right' else 'left'
			high = middle
		end 'left'
	end 'search'
	return strGraphemeClassOfNumber(strTableEntry(low) and strTableClassMask)
end 'strGraphemeClass'

// strIsBreakClass is whether a class is one that a cluster ends before and after: a control or a line break.
function strIsBreakClass(class StrGraphemeClass) returns bool
	return class == StrGraphemeClass.classControl or class == StrGraphemeClass.classCarriageReturn or class == StrGraphemeClass.classLineFeed
end 'strIsBreakClass'

// strHangulJoins is whether the rules of the Hangul syllables (GB6 to GB8) keep two classes in one cluster.
function strHangulJoins(before StrGraphemeClass, after StrGraphemeClass) returns bool
	if before == StrGraphemeClass.classHangulL 'leading'
		return after == StrGraphemeClass.classHangulL or after == StrGraphemeClass.classHangulV or after == StrGraphemeClass.classHangulLV or after == StrGraphemeClass.classHangulLVT
	end 'leading'
	if before == StrGraphemeClass.classHangulLV or before == StrGraphemeClass.classHangulV 'vowel'
		return after == StrGraphemeClass.classHangulV or after == StrGraphemeClass.classHangulT
	end 'vowel'
	if before == StrGraphemeClass.classHangulLVT or before == StrGraphemeClass.classHangulT 'trailing'
		return after == StrGraphemeClass.classHangulT
	end 'trailing'
	return false
end 'strHangulJoins'

// strGraphemeEnd is the byte position where the cluster that starts at a position ends.
function strGraphemeEnd(text String, start Count) returns Count
	let size = text.byteLength()
	if start >= size 'atEnd'
		return size
	end 'atEnd'
	let first = text.byteAt(start)
	if first < strAsciiLimit and first != strCarriageReturn 'plain'
		let following = strAdd(start, right: 1)
		if following >= size or text.byteAt(following) < strAsciiLimit 'alone'
			return following
		end 'alone'
	end 'plain'
	var length = strSequenceLength(first)
	if length > size - start 'truncated'
		length = size - start
	end 'truncated'
	var before = strGraphemeClass(strCodePoint(text, at: start, length: length))
	var next = strAdd(start, right: length)
	var indicators = 0 as Count
	if before == StrGraphemeClass.classRegionalIndicator 'indicator'
		indicators = 1
	end 'indicator'
	// pictures is 1 after a pictograph and the extensions that follow it, and 2 after the joiner that follows those.
	var pictures = 0 as Count
	if before == StrGraphemeClass.classPictographic 'picture'
		pictures = 1
	end 'picture'
	while next < size 'cluster'
		var step = strSequenceLength(text.byteAt(next))
		if step > size - next 'cut'
			step = size - next
		end 'cut'
		let after = strGraphemeClass(strCodePoint(text, at: next, length: step))
		if before == StrGraphemeClass.classCarriageReturn and after == StrGraphemeClass.classLineFeed 'crlf'
			return strAdd(next, right: step)
		end 'crlf'
		if strIsBreakClass(before) or strIsBreakClass(after) 'broken'
			return next
		end 'broken'
		var joined = strHangulJoins(before, after: after) or after == StrGraphemeClass.classExtend or after == StrGraphemeClass.classZeroWidthJoiner or after == StrGraphemeClass.classSpacingMark or before == StrGraphemeClass.classPrepend
		if after == StrGraphemeClass.classPictographic and pictures == 2 'emoji'
			joined = true
		end 'emoji'
		if after == StrGraphemeClass.classRegionalIndicator and before == StrGraphemeClass.classRegionalIndicator and indicators mod 2 == 1 'pair'
			joined = true
		end 'pair'
		if not joined 'separate'
			return next
		end 'separate'
		if after == StrGraphemeClass.classRegionalIndicator 'moreIndicators'
			indicators = strAdd(indicators, right: 1)
		end 'moreIndicators' else 'noIndicators'
			indicators = 0
		end 'noIndicators'
		if after == StrGraphemeClass.classPictographic 'pictograph'
			pictures = 1
		end 'pictograph' else if after == StrGraphemeClass.classExtend and pictures == 1 'extension'
			pictures = 1
		end 'extension' else if after == StrGraphemeClass.classZeroWidthJoiner and pictures == 1 'joiner'
			pictures = 2
		end 'joiner' else 'ended'
			pictures = 0
		end 'ended'
		before = after
		next = strAdd(next, right: step)
	end 'cluster'
	return size
end 'strGraphemeEnd'

// stringCount is the number of grapheme clusters of a string.
function stringCount(text String) returns Count
	let size = text.byteLength()
	var at = 0 as Count
	var clusters = 0 as Count
	while at < size 'each'
		at = strGraphemeEnd(text, start: at)
		clusters = strAdd(clusters, right: 1)
	end 'each'
	return clusters
end 'stringCount'

// stringGraphemeIndex is the number of clusters that start before a byte position.
function stringGraphemeIndex(text String, bytePos Count) returns Count
	var at = 0 as Count
	var clusters = 0 as Count
	while at < bytePos and at < text.byteLength() 'each'
		at = strGraphemeEnd(text, start: at)
		clusters = strAdd(clusters, right: 1)
	end 'each'
	return clusters
end 'stringGraphemeIndex'

// stringGraphemeBytePos is the byte position that count clusters after the one at from end at, or the end of the string.
function stringGraphemeBytePos(text String, from Count, count Count) returns Count
	var at = from
	var left = count
	while left > 0 and at < text.byteLength() 'each'
		at = strGraphemeEnd(text, start: at)
		left = left - 1
	end 'each'
	return at
end 'stringGraphemeBytePos'

// strSequenceLengthAt is how many bytes the sequence that starts at a position has, which a string that ends inside it cuts.
function strSequenceLengthAt(text String, at Count) returns Count
	var length = strSequenceLength(text.byteAt(at))
	let left = strSub(text.byteLength(), right: at)
	if length > left 'cut'
		length = left
	end 'cut'
	return length
end 'strSequenceLengthAt'

// stringCodePointAt is the code point that starts at a byte position.
function stringCodePointAt(text String, bytePos Count) returns Count
	return strCodePoint(text, at: bytePos, length: strSequenceLengthAt(text, at: bytePos))
end 'stringCodePointAt'

// stringCodePointNext is the byte position of the code point after the one at a position, plus 1, or 0 where there is none.
function stringCodePointNext(text String, bytePos Count) returns Count
	let next = strAdd(bytePos, right: strSequenceLengthAt(text, at: bytePos))
	if next >= text.byteLength() 'last'
		return 0
	end 'last'
	return strAdd(next, right: 1)
end 'stringCodePointNext'

// stringCodePointCount is the number of code points of a string.
function stringCodePointCount(text String) returns Count
	let size = text.byteLength()
	var at = 0 as Count
	var count = 0 as Count
	while at < size 'each'
		at = strAdd(at, right: strSequenceLengthAt(text, at: at))
		count = strAdd(count, right: 1)
	end 'each'
	return count
end 'stringCodePointCount'

// A UTF-16 state is where a code unit is: twice the byte position of its code point, plus 1 at the second unit of a pair.
let strUnitsPerStateStep = 2 as Count

let strSupplementaryFirst = 0x10000 as Count

let strLeadSurrogateFirst = 0xD800 as Count

let strTrailSurrogateFirst = 0xDC00 as Count

let strSurrogateSpan = 0x400 as Count

// stringUtf16Unit is the UTF-16 code unit at a state.
function stringUtf16Unit(text String, state Count) returns Count
	let code = stringCodePointAt(text, bytePos: state / strUnitsPerStateStep)
	if code < strSupplementaryFirst 'single'
		return code
	end 'single'
	let offset = strSub(code, right: strSupplementaryFirst)
	if state mod strUnitsPerStateStep == 0 'lead'
		return strAdd(strLeadSurrogateFirst, right: offset / strSurrogateSpan)
	end 'lead'
	return strAdd(strTrailSurrogateFirst, right: offset mod strSurrogateSpan)
end 'stringUtf16Unit'

// stringUtf16Next is the state of the code unit after the one at a state, plus 1, or 0 where there is none.
function stringUtf16Next(text String, state Count) returns Count
	let bytePos = state / strUnitsPerStateStep
	if stringCodePointAt(text, bytePos: bytePos) >= strSupplementaryFirst and state mod strUnitsPerStateStep == 0 'pair'
		return strAdd(state, right: 2)
	end 'pair'
	let next = stringCodePointNext(text, bytePos: bytePos)
	if next == 0 'last'
		return 0
	end 'last'
	return strAdd(try strSub(next, right: 1) * strUnitsPerStateStep otherwise panic("a text position overflows"), right: 1)
end 'stringUtf16Next'

// stringUtf16Count is the number of UTF-16 code units of a string.
function stringUtf16Count(text String) returns Count
	let size = text.byteLength()
	var at = 0 as Count
	var count = 0 as Count
	while at < size 'each'
		count = strAdd(count, right: 1)
		if stringCodePointAt(text, bytePos: at) >= strSupplementaryFirst 'pair'
			count = strAdd(count, right: 1)
		end 'pair'
		at = strAdd(at, right: strSequenceLengthAt(text, at: at))
	end 'each'
	return count
end 'stringUtf16Count'

// strMatchesAt is whether the bytes of needle are the ones of text from a position, which the text has room for.
function strMatchesAt(text String, at Count, needle String) returns bool
	for i in 0 upto needle.byteLength() 'bytes'
		if text.byteAt(strAdd(at, right: i)) != needle.byteAt(i) 'differ'
			return false
		end 'differ'
	end 'bytes'
	return true
end 'strMatchesAt'

// stringFind is the position, plus 1, of the first place at or after from where needle occurs in text, or 0. An empty
// needle occurs at from.
function stringFind(text String, needle String, from Count) returns Count
	let size = text.byteLength()
	let length = needle.byteLength()
	if from > size 'past'
		return 0
	end 'past'
	if length == 0 'empty'
		return strAdd(from, right: 1)
	end 'empty'
	if length > size - from 'short'
		return 0
	end 'short'
	let firstByte = needle.byteAt(0)
	if length > size 'longer'
		return 0
	end 'longer'
	let last = size - length
	var at = from
	while at <= last 'scan'
		if text.byteAt(at) == firstByte and strMatchesAt(text, at: at, needle: needle) 'found'
			return strAdd(at, right: 1)
		end 'found'
		at = strAdd(at, right: 1)
	end 'scan'
	return 0
end 'stringFind'

// stringFindLast is the position, plus 1, of the last place where needle occurs in text, or 0. An empty needle occurs at
// the end.
function stringFindLast(text String, needle String) returns Count
	let size = text.byteLength()
	let length = needle.byteLength()
	if length == 0 'empty'
		return strAdd(size, right: 1)
	end 'empty'
	if length > size 'short'
		return 0
	end 'short'
	var candidates = (size - length + 1) as Count
	while candidates > 0 'scan'
		let at = candidates - 1
		if strMatchesAt(text, at: at, needle: needle) 'found'
			return candidates
		end 'found'
		candidates = at
	end 'scan'
	return 0
end 'stringFindLast'

// stringHasAffix is whether text starts with affix, or ends with it where atEnd.
function stringHasAffix(text String, affix String, atEnd bool) returns bool
	let size = text.byteLength()
	let length = affix.byteLength()
	if length > size 'short'
		return false
	end 'short'
	var at = 0 as Count
	if atEnd 'end'
		at = size - length
	end 'end'
	return strMatchesAt(text, at: at, needle: affix)
end 'stringHasAffix'

// stringReplace is text with each occurrence of old, or only the first where all is false, in place of replacement. An
// empty old, or one that is not in text, changes nothing.
function stringReplace(text String, old String, replacement String, all bool) returns String
	let size = text.byteLength()
	var result = ""
	var done = 0 as Count
	if old.byteLength() != 0 'searching'
		var found = stringFind(text, needle: old, from: 0)
		while found != 0 'each'
			let at = found - 1
			result = "{result}{text.sliceBytes(done, endPos: at)}{replacement}"
			done = strAdd(at, right: old.byteLength())
			if all 'more'
				found = stringFind(text, needle: old, from: done)
			end 'more' else 'once'
				found = 0
			end 'once'
		end 'each'
	end 'searching'
	return "{result}{text.sliceBytes(done, endPos: size)}"
end 'stringReplace'

function strIn(code Count, first Count, last Count) returns bool
	return code >= first and code <= last
end 'strIn'

// strIsSpace is whether a code point is one of the whitespace and newline characters that trim removes.
function strIsSpace(code Count) returns bool
	if code < 0x80 'ascii'
		return code == 32 or strIn(code, first: 9, last: 13)
	end 'ascii'
	return code == 0x85 or code == 0xA0 or code == 0x1680 or strIn(code, first: 0x2000, last: 0x200A) or code == 0x2028 or code == 0x2029 or code == 0x202F or code == 0x205F or code == 0x3000
end 'strIsSpace'

// strClusterIsSpace is whether the cluster between two positions is one whitespace character, or a carriage return and a
// line feed.
function strClusterIsSpace(text String, start Count, stop Count) returns bool
	let length = strSequenceLength(text.byteAt(start))
	let span = strSub(stop, right: start)
	if span == 2 and text.byteAt(start) == strCarriageReturn 'pair'
		return true
	end 'pair'
	return span == length and strIsSpace(strCodePoint(text, at: start, length: length))
end 'strClusterIsSpace'

// stringTrim is text without the whitespace clusters at its start, where trimStart, and at its end, where trimEnd.
function stringTrim(text String, trimStart bool, trimEnd bool) returns String
	let size = text.byteLength()
	var first = 0 as Count
	if trimStart 'leading'
		var stop = strGraphemeEnd(text, start: 0)
		while first < size and strClusterIsSpace(text, start: first, stop: stop) 'skip'
			first = stop
			stop = strGraphemeEnd(text, start: first)
		end 'skip'
	end 'leading'
	var last = size
	if trimEnd 'trailing'
		var at = first
		last = first
		while at < size 'scan'
			let stop = strGraphemeEnd(text, start: at)
			if not strClusterIsSpace(text, start: at, stop: stop) 'kept'
				last = stop
			end 'kept'
			at = stop
		end 'scan'
	end 'trailing'
	return text.sliceBytes(first, endPos: last)
end 'stringTrim'

// stringMapCase is text with its ASCII letters in upper case, or in lower case where upper is false.
function stringMapCase(text String, upper bool) returns String
	var first = strUpperFirst
	var last = strUpperLast
	var letters = strLowerLetters
	if upper 'upper'
		first = strLowerFirst
		last = strLowerLast
		letters = strUpperLetters
	end 'upper'
	let size = text.byteLength()
	var result = ""
	var done = 0 as Count
	for i in 0 upto size 'each'
		let byte = text.byteAt(i)
		if byte >= first and byte <= last 'letter'
			let letter = (byte - first) as Count
			result = "{result}{text.sliceBytes(done, endPos: i)}{letters.sliceBytes(letter, endPos: letter + 1)}"
			done = strAdd(i, right: 1)
		end 'letter'
	end 'each'
	return "{result}{text.sliceBytes(done, endPos: size)}"
end 'stringMapCase'
