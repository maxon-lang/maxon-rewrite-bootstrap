// A payload that is queued for a streaming child's input (subprocessQueueStdin) is written to it by a green thread of the runtime as the
// child takes it, and the input is closed after it, so the caller goes on: a child that writes a megabyte before it reads anything
// would block a caller that wrote its input itself, which only its own read of the output could free. The caller pushes
// (subprocessPushStdin, which says how many bytes are not written yet), waits for the input to take more (subprocessAwaitStdinWritable)
// and reads. A second payload is refused while one is queued, and a write of the input is too. The child is this program run again.
// native-only
//> queued: 0, a second queue: 2, a write: 2
//> the payload was written out and the input closed: true
//> the child that only reads counted: [count:2097152]
//> a queue and a write after the input was closed answer -1 and 1: -1 1
//> the child that writes first, read by the caller as it writes: 1048576 bytes, and then counted: [done:2097152]

typealias Blob = Array with Byte

let terminator = 0 as Byte

let parentEnvironment = 1

let streamOutput = 0 as FullRangeInt

let streamError = 1 as FullRangeInt

let megabyte = 1048576

// readAllInput counts the bytes of the input of this program up to its end.
function readAllInput() returns Count
	var total = 0 as Count
	var reading = true
	while reading 'reads'
		let got = __Builtins.readStdin(65536)
		if got.length() == 0 'end'
			reading = false
		end 'end' else 'more'
			total = try total + got.length() otherwise panic("a count of bytes past a word")
		end 'more'
	end 'reads'
	return total
end 'readAllInput'

// child counts its input and says so on its output; as the filler it writes a megabyte of output first, which nothing reads until
// its parent chooses, and says what it counted on its error.
function child(mode String) returns ExitCode
	if mode == "fill" 'fill'
		let line = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
		var written = 0 as Count
		while written < megabyte 'writes'
			print(line)
			written = try written + line.byteLength() otherwise panic("a count of bytes past a word")
		end 'writes'
		printError("done:{readAllInput()}")
		return 0
	end 'fill'
	print("count:{readAllInput()}")
	return 0
end 'child'

function appendToken(mutates out Blob, token String)
	for b in token.bytes() 'each'
		out.push(b)
	end 'each'
	out.push(terminator)
end 'appendToken'

function spawnSelf(mode String) returns FullRangeInt
	var argv = Blob.create(0)
	let executable = try Process.executablePath() otherwise return -1
	appendToken(argv, token: executable.path)
	appendToken(argv, token: mode)
	var env = Blob.create(1)
	env.push(terminator)
	let empty = ""
	return __Builtins.subprocessSpawnStreaming(argv.managed, 2, empty.cstr(), 0, env.managed, parentEnvironment)
end 'spawnSelf'

function readOf(handle FullRangeInt, stream FullRangeInt, most FullRangeInt) returns String
	return String.init(__Builtins.subprocessReadAvailable(handle, stream, most))
end 'readOf'

// readToEnd reads a stream of a child to its end and gives the text and how many bytes it had.
function readToEnd(handle FullRangeInt, stream FullRangeInt) returns String
	var text = ""
	var reading = true
	while reading 'reads'
		let chunk = readOf(handle, stream: stream, most: 65536)
		if chunk.byteLength() == 0 'end'
			reading = false
		end 'end' else 'more'
			text = "{text}{chunk}"
		end 'more'
	end 'reads'
	return text
end 'readToEnd'

// payload is a text of two megabytes.
function payload() returns String
	var text = "0123456789abcdef"
	for _ in 0 upto 17 'doubling'
		text = "{text}{text}"
	end 'doubling'
	return text
end 'payload'

// pushToEnd pushes and waits until nothing of the queued payload is left, and says whether the remaining count only went down.
function pushToEnd(handle FullRangeInt) returns bool
	var last = __Builtins.subprocessPushStdin(handle)
	var onlyDown = true
	var passes = 0 as Count
	while last > 0 'pushing'
		_ = __Builtins.subprocessAwaitStdinWritable(handle, passes)
		passes = (try passes + 1 otherwise 5) if passes < 5 else 5
		let now = __Builtins.subprocessPushStdin(handle)
		if now > last 'grew'
			onlyDown = false
		end 'grew'
		last = now
	end 'pushing'
	return onlyDown
end 'pushToEnd'

function main() returns ExitCode
	let args = CommandLine.args()
	if args.count() > 1 'child'
		let mode = try args.get(1) otherwise return 2
		return child(mode)
	end 'child'
	let text = payload()
	let counter = spawnSelf("count")
	let queued = __Builtins.subprocessQueueStdin(counter, text.cstr(), text.byteLength())
	let second = __Builtins.subprocessQueueStdin(counter, text.cstr(), text.byteLength())
	let written = __Builtins.subprocessWriteStdinBytes(counter, text.cstr(), 1)
	print("queued: {queued}, a second queue: {second}, a write: {written}\n")
	print("the payload was written out and the input closed: {pushToEnd(counter)}\n")
	print("the child that only reads counted: [{readToEnd(counter, stream: streamOutput)}]\n")
	print("a queue and a write after the input was closed answer -1 and 1: {__Builtins.subprocessQueueStdin(counter, text.cstr(), 1)} {__Builtins.subprocessWriteStdinBytes(counter, text.cstr(), 1)}\n")
	_ = __Builtins.subprocessWaitExit(counter, 0)
	__Builtins.subprocessReleaseHandle(counter)
	let filler = spawnSelf("fill")
	_ = __Builtins.subprocessQueueStdin(filler, text.cstr(), text.byteLength())
	let out = readToEnd(filler, stream: streamOutput)
	print("the child that writes first, read by the caller as it writes: {out.byteLength()} bytes, and then counted: [{readToEnd(filler, stream: streamError)}]\n")
	_ = __Builtins.subprocessWaitExit(filler, 0)
	__Builtins.subprocessReleaseHandle(filler)
	return 0
end 'main'
