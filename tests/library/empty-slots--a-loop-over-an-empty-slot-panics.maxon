// A loop over a slot array's cursor lends each element, and an empty slot of a managed element holds none, so the loop
// panics there with maxon's message rather than lend a box that is not there.
typealias Names = __SlotArray with String

function cleared(consumes one String, consumes two String) returns Names
	var slots = Names.create(0)
	slots.push(one)
	slots.push(two)
	try slots.clearSlot(1) otherwise panic("a slot inside the column")
	return slots
end 'cleared'

function walk(names Names)
	var at = try names.createCursor() otherwise panic("two slots")
	print("{at.current()}\n")
	try at.advance() otherwise panic("a second slot")
	print("{at.current()}\n")
end 'walk'

function main() returns ExitCode
	var names = cleared("ada", two: "bob")
	walk(names)
	try names.clearSlot(0) otherwise panic("a slot inside the column")
	names.dropEmpty()
	return 0
end 'main'

// expect-exit: 1
//> ada
