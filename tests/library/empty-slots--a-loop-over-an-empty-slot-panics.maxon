// A loop lends each element of an array, and an empty slot of a managed element holds none, so the loop panics there with
// maxon's message rather than lend a box that is not there.
typealias Names = Array with String

type Column uses Element where Element implements Droppable
	typealias Slots = Array with Element

	static function cleared(consumes first Element, consumes second Element) returns Slots
		var slots = Slots.create(0)
		slots.push(first)
		slots.push(second)
		try slots.clearSlot(1) otherwise panic("a slot inside the column")
		return slots
	end 'cleared'
end 'Column'

typealias NameColumn = Column with String

function main() returns ExitCode
	let names = NameColumn.cleared("ada", second: "bob")
	for name in names 'each'
		print("{name}\n")
	end 'each'
	return 0
end 'main'

// expect-exit: 1
//> ada
