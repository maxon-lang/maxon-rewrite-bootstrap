// A behaviour runs on another thread, so what it takes crosses by the rule of a message's arguments: a promise, whose
// coroutine belongs to the strand that started it, does not, and an interface value does, since what is put in its box
// crosses.
type Total
	export var sum as Count

	static function make() returns Total
		return Total{sum: 0}
	end 'make'
end 'Total'

function nap(n Count) returns Count
	sleep(1)
	return n
end 'nap'

function main() returns ExitCode
	let total = cown(Total.make())
	let pending = async nap(3)
	when total as t 'add'
		t.sum = try await pending otherwise 0
	end 'add'
	return 0
end 'main'

