// expect-exit: 1
// dropEmpty traps where the array still holds an element: an array has no empty slot below its count, so it ends only at
// count 0.
type Table uses Element where Element implements Droppable
	typealias Column = Array with Element
	var slots as Column

	static function filledOnce(consumes value Element) returns Self
		var slots = Column.create(0)
		slots.push(value)
		return Self{slots: slots}
	end 'filledOnce'

	function end(consumes self)
		slots.dropEmpty()
	end 'end'
end 'Table'

typealias Names = Table with String

function main() returns ExitCode
	print("before\n")
	Names.filledOnce("ada").end()
	print("after\n")
	return 0
end 'main'

//> before
