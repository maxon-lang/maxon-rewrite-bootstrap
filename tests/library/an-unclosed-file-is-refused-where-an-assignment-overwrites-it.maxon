// Assigning a new handle to the var that holds an open one drops the old one; exchange gives it back to be closed.
// expect-error: E3919
typealias Bytes = __ManagedMemory with Byte

function reassigned(path Bytes) throws __ManagedFileError
	var file = try __ManagedFile.openRead(path)
	file = try __ManagedFile.openRead(path)
	try file.close()
end 'reassigned'

function main() returns ExitCode
	return 0
end 'main'
