// The compiler's tier ends the process at once with __Builtins.exitAtOnce: what was written is out, the code is the one
// given, nothing after the call runs, and the boxes still held are not freed, which an executable that counts its boxes
// would otherwise report as a leak.
// expect-exit: 7
typealias Words = Array with String

function main() returns ExitCode
	var held = Words.create(0)
	held.push("a string long enough to be a box of its own")
	print("{held.count()} held\n")
	__Builtins.exitAtOnce(7)
	print("not reached\n")
	return 0
end 'main'

//> 1 held
