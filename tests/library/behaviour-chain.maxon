type Stage
	export var value as Count

	static function make(value Count) returns Stage
		return Stage{value: value}
	end 'make'
end 'Stage'

function third(c cown with Stage, carried Count)
	when c as s 'thirdBlock'
		s.value = try s.value + carried otherwise return
		print("third {s.value}\n")
	end 'thirdBlock'
end 'third'

function second(b cown with Stage, c cown with Stage, carried Count)
	let next = share(c)
	when b as s 'secondBlock'
		s.value = try s.value * carried otherwise return
		print("second {s.value}\n")
		third(next, carried: s.value)
	end 'secondBlock'
end 'second'

function first(a cown with Stage, b cown with Stage, c cown with Stage)
	let nextB = share(b)
	let nextC = share(c)
	when a as s 'firstBlock'
		s.value = try s.value + 1 otherwise return
		print("first {s.value}\n")
		second(nextB, c: nextC, carried: s.value)
	end 'firstBlock'
end 'first'

function main() returns ExitCode
	let a = cown(Stage.make(1))
	let b = cown(Stage.make(10))
	let c = cown(Stage.make(100))
	first(a, b: b, c: c)
	return 0
end 'main'

//> first 2
//> second 20
//> third 120
