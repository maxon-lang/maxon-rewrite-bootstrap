// native-only
// More tasks than a turn's worth send to one slow service, each slowed and parked again and again while it is behind:
// every message is handled once, and the service holds at most max(turn, tasks) + tasks, the 200 coroutines and main.
// A slowed task parks with its place counted and its message not yet queued, so the service can catch up with one place
// held per task, and each task let go then sends one more. The bound holds under any schedule and any stall of a thread:
// the catch-up acts only on a queue it finds empty under its lock, so a thread stopped between the release that emptied
// the queue and that lock lets no sender go into a queue that has filled again.
//> total 20000, within its bound
typealias Num = int(0 to 1000000000)

typealias Dones = Array with Promise with Num

let tasks = 200 as Count

let sendsPerTask = 100 as Count

let turn = 64 as Count

service Tally
	var sum as Num
	var sink as Num

	static function create() returns Self
		return Self{sum: 0, sink: 0}
	end 'create'

	export function add(mutates self, value Num)
		self.sum = try self.sum + value otherwise 0
		var spun = self.sink
		for i in 0 upto 2000 'work'
			spun = (spun + i) mod 1000
		end 'work'
		self.sink = spun
	end 'add'

	export function total() returns Num
		return self.sum
	end 'total'
end 'Tally'

function pump(consumes t Tally.handle) returns Num
	sleep(1)
	for i in 0 upto sendsPerTask 'sends'
		try t.add(1) otherwise panic("a running service takes the send")
	end 'sends'
	return 1
end 'pump'

function main() returns ExitCode
	let tally = spawn Tally.create()
	var dones = Dones.create(0)
	for k in 0 upto tasks 'tasks'
		dones.push(async pump(tally.clone()))
	end 'tasks'
	var at = 0 as Count
	while at < dones.count() 'wait'
		_ = await dones[at]
		at = at + 1
	end 'wait'
	let total = try await tally.total() otherwise 0
	let senders = tasks + 1
	let bound = (senders if senders > turn else turn) + senders
	let most = tally.mostQueued()
	let verdict = "within its bound" if most <= bound else "past its bound of {bound} with {most}"
	print("total {total}, {verdict}\n")
	return 0
end 'main'
