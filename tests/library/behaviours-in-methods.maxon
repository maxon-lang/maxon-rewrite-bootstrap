typealias StringArray = Array with String

typealias StringSlot = Slot with String

type Ledger
	export var entries as Array with String

	static function make() returns Ledger
		return Ledger{entries: StringArray.create(0)}
	end 'make'

	function record(mutates self, into cown with Ledger, text String)
		let note = text.clone()
		when into as l 'append'
			l.entries.push(note)
		end 'append'
	end 'record'

	function show(into cown with Ledger)
		when into as l 'showBlock'
			for i in 0 upto l.entries.count() 'lines'
				print("{i}: {l.entries[i]}\n")
			end 'lines'
		end 'showBlock'
	end 'show'
end 'Ledger'

type Slot uses T where T implements Droppable
	var held as T

	static function put(into cown with (Slot with T), consumes value T)
		when into as s 'putBlock'
			s.held = value
		end 'putBlock'
	end 'put'

	static function make(consumes held T) returns Self
		return Self{held: held}
	end 'make'
end 'Slot'

function main() returns ExitCode
	var local = Ledger.make()
	let book = cown(Ledger.make())
	local.record(book, text: "first")
	local.record(book, text: "second")
	let reader = share(book)
	local.show(reader)
	let slot = cown(Slot.make("a"))
	let writer = share(slot)
	StringSlot.put(slot, value: "b")
	StringSlot.put(writer, value: "c")
	return 0
end 'main'

//> 0: first
//> 1: second
