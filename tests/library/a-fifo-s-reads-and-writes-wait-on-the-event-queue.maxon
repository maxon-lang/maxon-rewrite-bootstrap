// A FIFO's reads and writes wait on the event queue, as a pipe's do: its open file is given an event entry at the open, so a
// read that comes before the writer has written parks the green thread until it has, and gives 0 once the writer has closed it,
// and a write to a FIFO that a reader reads writes all of it. On macOS, whose kqueue gives a FIFO's reader no event for its
// writer's close, a FIFO has no entry and its calls block instead, to the same results. /dev/null, a character device that
// epoll refuses on Linux, is read and written as a plain file. The other end of each FIFO is the shell's, started detached,
// so the opens, which wait for the other end, wait on another process and not on this program. Each step is watched by a timer
// re-armed before it with a message that names it: a step that waits past 6 s, within the runner's deadline, says which it was,
// with the pid of the shell at the FIFO's other end and the FIFO's path, and ends the program (a detached child's handle is its
// pid alone, so how it ended cannot be asked, and a handler may not run a child to look, E3221: the gate's sampler records the
// pid's `ps` line and who holds the FIFO open once a FIFO is 4 s old);
// the copy is waited for 4 s at most. Paths left by an earlier run whose pid this one has are removed first, mkfifo's exit is
// checked, and each path is checked to be a FIFO before a shell opens it. Each child is started beside a guard that ends it
// and removes the FIFOs once the program has ended, so a run the watchdog ended leaves nothing behind. A read, write or /dev/null call that fails panics
// with the error's name, on standard error, which the runner shows where it hides standard output.
// unsupported-targets: x64-windows
// native-only
// runs: alone
//> read: 4 then 0: ping
//> wrote: 4, the reader got pong
//> /dev/null: read 0, wrote 3
typealias Bytes = __ManagedMemory with Byte

typealias Arguments = Array with String

let tries = 80 as Count

let stepBudgetMs = 6000

// Watchdog is told by the step timer when a step has waited past its budget, and ends the program, naming it on standard
// error.
type Watchdog
	static function create() returns Self
		return Self{}
	end 'create'

	export function stuck(mutates self, step String, child Pid, path String)
		let who = "no child started" if child == 0 else "its other end the detached child {child}"
		panic("stuck for {stepBudgetMs} ms at {step}; {who}, at {path}")
	end 'stuck'
end 'Watchdog'

function shellArguments(script String) returns Arguments
	var arguments = Arguments.create(0)
	arguments.push("-c")
	arguments.push(script.clone())
	return arguments
end 'shellArguments'

// shell runs a script to its end and says whether it ran and exited with 0.
function shell(script String) returns bool
	let sh = try FilePath.from("/bin/sh") otherwise return false
	let out = try Subprocess.run(Executable.path(sh), arguments: shellArguments(script)) otherwise return false
	return out.succeeded()
end 'shell'

// detached starts a script that this program does not wait for, and gives its pid, or 0 where it did not start.
function detached(script String) returns Pid
	let sh = try FilePath.from("/bin/sh") otherwise return 0
	var configuration = Configuration.create(MxExecutable.path(sh))
	configuration.arguments = shellArguments(script)
	return try configuration.runDetached() otherwise 0
end 'detached'

// guard starts a shell that, once this program has ended, by its return or a panic, ends a child it started (a detached
// child leads a session of its own: the shell kills its process group, the child's own children too) and removes the
// paths, so that a run the watchdog ended leaves no child waiting on a FIFO, nor the FIFOs. The watchdog's handler may not
// start it (E3221), so it is started beside each child.
function guard(child Pid, paths String) returns Pid
	return detached("while kill -0 {Process.id()} 2>/dev/null; do sleep 0.2; done; kill -9 -- -{child} 2>/dev/null; rm -f {paths}")
end 'guard'

function failureName(e __ManagedFileError) returns String
	return match e 'kind'
		notFound gives "notFound"
		accessDenied gives "accessDenied"
		openFailed gives "openFailed"
		readFailed gives "readFailed"
		writeFailed gives "writeFailed"
		sizeFailed gives "sizeFailed"
		deleteFailed gives "deleteFailed"
		statFailed gives "statFailed"
		invalidStatBuffer gives "invalidStatBuffer"
		invalidStatIndex gives "invalidStatIndex"
		closed gives "closed"
		alreadyExists gives "alreadyExists"
		busy gives "busy"
	end 'kind'
end 'failureName'

// readFifo reads a FIFO whose writer opens it at once and writes only a second later, so the first read parks.
function readFifo(path String, mutates buffer Bytes) returns String throws __ManagedFileError
	var file = try __ManagedFile.openRead(path.addressableBytes())
	let first = try file.readAppending(buffer, most: 8) otherwise (e) 'first'
		try file.close() otherwise ignore
		throw e
	end 'first'
	let second = try file.readAppending(buffer, most: 8) otherwise (e) 'second'
		try file.close() otherwise ignore
		throw e
	end 'second'
	try file.close()
	return "{first} then {second}"
end 'readFifo'

// writeFifo writes a FIFO whose reader copies it to a file.
function writeFifo(path String) returns Count throws __ManagedFileError
	var file = try __ManagedFile.openWrite(path.addressableBytes())
	let wrote = try file.write("pong".toByteArray().managed) otherwise (e) 'unwritten'
		try file.close() otherwise ignore
		throw e
	end 'unwritten'
	try file.close()
	return wrote
end 'writeFifo'

// copied is what the reader of the FIFO wrote to its file, once it has written all of it.
function copied(out FilePath) returns String
	for _ in 0 upto tries 'wait'
		let text = try File.readText(out) otherwise ""
		if text == "pong" 'whole'
			return text
		end 'whole'
		sleep(50)
	end 'wait'
	return "nothing"
end 'copied'

function devNull() returns String throws __ManagedFileError
	var buffer = try Bytes.create(4, elementSize: 1) otherwise throw __ManagedFileError.readFailed
	var reader = try __ManagedFile.openRead("/dev/null".addressableBytes())
	let got = try reader.readAppending(buffer, most: 4) otherwise (e) 'unread'
		try reader.close() otherwise ignore
		throw e
	end 'unread'
	try reader.close()
	var writer = try __ManagedFile.openWrite("/dev/null".addressableBytes())
	let wrote = try writer.write("abc".toByteArray().managed) otherwise (e) 'unwritten'
		try writer.close() otherwise ignore
		throw e
	end 'unwritten'
	try writer.close()
	return "read {got}, wrote {wrote}"
end 'devNull'

// steps runs the program's steps, re-arming the step timer with a message that names each before it starts.
function steps(dog Watchdog.handle, mutates step Timer, inbound String, outbound String, copy String) returns ExitCode
	if not shell("rm -f '{inbound}' '{outbound}' '{copy}' && mkfifo '{inbound}' '{outbound}' && [ -p '{inbound}' ] && [ -p '{outbound}' ]") 'unmade'
		print("the FIFOs were not made\n")
		return 1
	end 'unmade'
	let writer = detached("exec 3>'{inbound}'; sleep 1; printf ping >&3; exec 3>&-")
	if writer == 0 'writer'
		print("the writer did not start\n")
		return 2
	end 'writer'
	_ = guard(writer, paths: "'{inbound}' '{outbound}' '{copy}'")
	step.rearm(stepBudgetMs, message: dog.post(Watchdog.Message.stuck("the open and read of the inbound FIFO, the writer's ping", child: writer, path: inbound.clone())))
	var buffer = try Bytes.create(16, elementSize: 1) otherwise return 3
	let reads = try readFifo(inbound, buffer: buffer) otherwise (e) 'unread'
		panic("the read of the inbound FIFO failed: {failureName(e)}")
	end 'unread'
	print("read: {reads}: {String.from(ByteArray.init(buffer))}\n")
	let reader = detached("cat '{outbound}' > '{copy}'")
	if reader == 0 'reader'
		print("the reader did not start\n")
		return 5
	end 'reader'
	_ = guard(reader, paths: "'{copy}'")
	step.rearm(stepBudgetMs, message: dog.post(Watchdog.Message.stuck("the open and write of the outbound FIFO, its reader", child: reader, path: outbound.clone())))
	let wrote = try writeFifo(outbound) otherwise (e) 'unwritten'
		panic("the write of the outbound FIFO failed: {failureName(e)}")
	end 'unwritten'
	step.rearm(stepBudgetMs, message: dog.post(Watchdog.Message.stuck("the copy of the outbound FIFO", child: reader, path: copy.clone())))
	let out = try FilePath.from(copy) otherwise return 7
	print("wrote: {wrote}, the reader got {copied(out)}\n")
	step.rearm(stepBudgetMs, message: dog.post(Watchdog.Message.stuck("/dev/null", child: 0, path: "/dev/null")))
	let null = try devNull() otherwise (e) 'nulled'
		panic("/dev/null failed: {failureName(e)}")
	end 'nulled'
	print("/dev/null: {null}\n")
	return 0
end 'steps'

function main() returns ExitCode
	let base = "/tmp/minimaxon_fifo_{Process.id()}"
	let inbound = "{base}_in"
	let outbound = "{base}_out"
	let copy = "{base}_copy"
	let dog = spawn Watchdog.create()
	let dogEnded = dog.stopped()
	var step = Timer.notifyAfter(stepBudgetMs, message: dog.post(Watchdog.Message.stuck("making the FIFOs", child: 0, path: inbound.clone())))
	let code = steps(dog, step: step, inbound: inbound, outbound: outbound, copy: copy)
	step.cancel()
	dog.shutdown()
	await dogEnded
	_ = shell("rm -f '{inbound}' '{outbound}' '{copy}'")
	return code
end 'main'
