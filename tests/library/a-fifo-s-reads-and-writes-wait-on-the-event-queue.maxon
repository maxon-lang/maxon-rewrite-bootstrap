// A FIFO's reads and writes wait on the event queue, as a pipe's do: its open file is given an event entry at the open, so a
// read that comes before the writer has written parks the green thread until it has, and gives 0 once the writer has closed it,
// and a write to a FIFO that a reader reads writes all of it. /dev/null, a character device that epoll refuses on Linux, is
// read and written as a plain file. The other end of each FIFO is the shell's, started detached, so the opens, which wait for
// the other end, wait on another process and not on this program.
// unsupported-targets: x64-windows
// native-only
//> read: 4 then 0: ping
//> wrote: 4, the reader got pong
//> /dev/null: read 0, wrote 3
typealias Bytes = __ManagedMemory with Byte

typealias Arguments = Array with String

let tries = 200 as Count

function shellArguments(script String) returns Arguments
	var arguments = Arguments.create(0)
	arguments.push("-c")
	arguments.push(script.clone())
	return arguments
end 'shellArguments'

// shell runs a script to its end and says whether it ran.
function shell(script String) returns bool
	let sh = try FilePath.from("/bin/sh") otherwise return false
	_ = try Subprocess.run(Executable.path(sh), arguments: shellArguments(script)) otherwise return false
	return true
end 'shell'

// detached starts a script that this program does not wait for, and says whether it started.
function detached(script String) returns bool
	let sh = try FilePath.from("/bin/sh") otherwise return false
	var configuration = Configuration.create(MxExecutable.path(sh))
	configuration.arguments = shellArguments(script)
	_ = try configuration.runDetached() otherwise return false
	return true
end 'detached'

function failureName(e __ManagedFileError) returns String
	return match e 'kind'
		notFound gives "notFound"
		accessDenied gives "accessDenied"
		openFailed gives "openFailed"
		readFailed gives "readFailed"
		writeFailed gives "writeFailed"
		sizeFailed gives "sizeFailed"
		deleteFailed gives "deleteFailed"
		statFailed gives "statFailed"
		invalidStatBuffer gives "invalidStatBuffer"
		invalidStatIndex gives "invalidStatIndex"
		closed gives "closed"
		alreadyExists gives "alreadyExists"
		busy gives "busy"
	end 'kind'
end 'failureName'

// readFifo reads a FIFO whose writer opens it at once and writes only a second later, so the first read parks.
function readFifo(path String, mutates buffer Bytes) returns String throws __ManagedFileError
	var file = try __ManagedFile.openRead(path.addressableBytes())
	let first = try file.readAppending(buffer, most: 8) otherwise (e) 'first'
		try file.close() otherwise ignore
		throw e
	end 'first'
	let second = try file.readAppending(buffer, most: 8) otherwise (e) 'second'
		try file.close() otherwise ignore
		throw e
	end 'second'
	try file.close()
	return "{first} then {second}"
end 'readFifo'

// writeFifo writes a FIFO whose reader copies it to a file.
function writeFifo(path String) returns Count throws __ManagedFileError
	var file = try __ManagedFile.openWrite(path.addressableBytes())
	let wrote = try file.write("pong".toByteArray().managed) otherwise (e) 'unwritten'
		try file.close() otherwise ignore
		throw e
	end 'unwritten'
	try file.close()
	return wrote
end 'writeFifo'

// copied is what the reader of the FIFO wrote to its file, once it has written all of it.
function copied(out FilePath) returns String
	for _ in 0 upto tries 'wait'
		let text = try File.readText(out) otherwise ""
		if text == "pong" 'whole'
			return text
		end 'whole'
		sleep(50)
	end 'wait'
	return "nothing"
end 'copied'

function devNull() returns String throws __ManagedFileError
	var buffer = try Bytes.create(4, elementSize: 1) otherwise throw __ManagedFileError.readFailed
	var reader = try __ManagedFile.openRead("/dev/null".addressableBytes())
	let got = try reader.readAppending(buffer, most: 4) otherwise (e) 'unread'
		try reader.close() otherwise ignore
		throw e
	end 'unread'
	try reader.close()
	var writer = try __ManagedFile.openWrite("/dev/null".addressableBytes())
	let wrote = try writer.write("abc".toByteArray().managed) otherwise (e) 'unwritten'
		try writer.close() otherwise ignore
		throw e
	end 'unwritten'
	try writer.close()
	return "read {got}, wrote {wrote}"
end 'devNull'

function main() returns ExitCode
	let base = "/tmp/minimaxon_fifo_{Process.id()}"
	let inbound = "{base}_in"
	let outbound = "{base}_out"
	let copy = "{base}_copy"
	if not shell("mkfifo '{inbound}' '{outbound}'") 'unmade'
		return 1
	end 'unmade'
	if not detached("exec 3>'{inbound}'; sleep 1; printf ping >&3; exec 3>&-") 'writer'
		return 2
	end 'writer'
	var buffer = try Bytes.create(16, elementSize: 1) otherwise return 3
	let reads = try readFifo(inbound, buffer: buffer) otherwise (e) 'unread'
		print("read: {failureName(e)}\n")
		return 4
	end 'unread'
	print("read: {reads}: {String.from(ByteArray.init(buffer))}\n")
	if not detached("cat '{outbound}' > '{copy}'") 'reader'
		return 5
	end 'reader'
	let wrote = try writeFifo(outbound) otherwise (e) 'unwritten'
		print("write: {failureName(e)}\n")
		return 6
	end 'unwritten'
	let out = try FilePath.from(copy) otherwise return 7
	print("wrote: {wrote}, the reader got {copied(out)}\n")
	let null = try devNull() otherwise (e) 'nulled'
		print("/dev/null: {failureName(e)}\n")
		return 8
	end 'nulled'
	print("/dev/null: {null}\n")
	_ = shell("rm -f '{inbound}' '{outbound}' '{copy}'")
	return 0
end 'main'
