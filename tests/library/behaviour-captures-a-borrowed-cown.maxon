// expect-error: E3909 at 13:8
type Acct
	export var balance as Count
	export var tag as String

	static function make(balance Count) returns Acct
		return Acct{balance: balance, tag: "t"}
	end 'make'
end 'Acct'

function show(c cown with Acct, d cown with Acct)
	when c as x 'showBlock'
		when d as y 'again'
			y.balance = 1
		end 'again'
	end 'showBlock'
end 'show'

function main() returns ExitCode
	return 0
end 'main'
