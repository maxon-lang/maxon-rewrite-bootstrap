typealias Names = Array with String

type Walk
	typealias Cursor = __ManagedMemoryCursor with String
	var raw as Cursor

	static function over(names Names) returns Walk throws IterationError
		let cursor = try names.managed.createCursor() otherwise throw IterationError.exhausted
		return Walk{raw: cursor}
	end 'over'

	function name() returns String
		return raw.current().clone()
	end 'name'
end 'Walk'

function main() returns ExitCode
	var names = Names.create(0)
	names.push("a")
	let w = try Walk.over(names) otherwise return 1
	names.push("b")
	print("{w.name()}\n")
	return 0
end 'main'

