// maxon's fold of a word under one seed, which is the software fold on every tier, and its ordered words read and appended
// in both orders. Its spans are tests/runtime/the-hash-tiers-fold-spans-as-maxons-do.maxon's, since a span folds by the
// process's tier.

function main() returns ExitCode
	let seed = 0x0123456789abcdef as HashDigest
	print("{__Builtins.hashWord(0 as HashDigest, seed)}\n")
	print("{__Builtins.hashWord(42 as HashDigest, seed)}\n")
	var words = ByteArray.create(0)
	__Builtins.appendBigEndian(words, 0x0102 as OrderedWord, 2)
	__Builtins.appendLittleEndian(words, 0x03040506 as OrderedWord, 4)
	__Builtins.appendBigEndian(words, 0x0708090a0b0c0d0e as OrderedWord, 8)
	print("{words.count()} {words[0]} {words[1]} {words[2]} {words[5]} {words[6]} {words[13]}\n")
	let big = try __Builtins.readBigEndian(words, 0, 2) otherwise panic("a word inside the array")
	let little = try __Builtins.readLittleEndian(words, 2, 4) otherwise panic("a word inside the array")
	let long = try __Builtins.readBigEndian(words, 6, 8) otherwise panic("a word inside the array")
	print("{big} {little} {long}\n")
	let past = try __Builtins.readLittleEndian(words, 8, 8) otherwise 'past'
		print("past the end\n")
		return 0
	end 'past'
	print("{past}\n")
	return 1
end 'main'

//> 7659338948286149400
//> 16831108802964612672
//> 14 1 2 6 3 7 14
//> 258 50595078 506664896818842894
//> past the end
