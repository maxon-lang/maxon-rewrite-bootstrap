// No capacity is named, and a slow consumer's queue still stays within a bound in messages, whatever the speeds: the
// runtime slows every send that finds a turn's worth (turnBehaviours, 64) queued, and a slowed sender adds nothing more
// until the service catches up. The bound is held on the most messages the service ever had queued (mostQueued), not on a
// time, so a loaded machine, a processor count or a schedule of the interpreter (whose turn is shorter) cannot move it.
//
// direct: main, a task, is the consumer's only sender. Once 64 are queued its send is slowed, and it parks after the
// message it sent, until the consumer's queue empties: at most turn + 1.
//
// relayed: main sends to a relay, which passes each message to the consumer. The relay has main alone for a sender, which
// adds one message once slowed and, should the relay be muted with main waiting on it, which lets main go, one more:
// turn + 2. While the consumer's queue holds a turn's worth, every send to it is slowed, so the relay is listed on it and
// muted after the handler that was slowed, unless it drains on, behind itself, holding a turn's worth (which makes it
// behind) or with main waiting on it: main is then slowed and parked until the relay's mute, and the relay passes on the
// message it runs and what it held, at most turn + 2, and is muted for the rest. So the consumer holds at most
// turn + (turn + 4), the bound runtime/service.maxon proves.
//
// The instance is small, because the interpreter's time grows with the square of the messages (3000 of them took it 15 s
// a schedule): 400 are over six turns, so that a send slowed later than at turnBehaviours finds the queue past a bound. A
// runtime that slowed at 65 queues 66 in direct, and one that slowed at 128 queues 129 in direct and past the relay's bound.
// schedules: 6
//> direct: handled=400, within its bound
//> relayed: handled=400, the relay and the consumer within their bounds
export typealias Amount = int(0 to 1000000)

typealias Divisor = int(1 to 1000000)

let messages = 400 as Amount

let work = 70 as Amount

let sinkModulus = 1000 as Divisor

// turn is the runtime's turnBehaviours: the interpreter's turn is shorter, so the bounds hold there with room.
let turn = 64 as Count

service Consumer
	var handled as Amount
	var sink as Amount
	// modulus is a field, so that each spin of take costs a division that the compiler cannot fold into a multiplication: the
	// consumer is slower than the sends to it with few spins, where the interpreter, which counts instructions, runs it fast.
	var modulus as Divisor

	static function create() returns Self
		return Self{handled: 0, sink: 0, modulus: sinkModulus}
	end 'create'

	export function take(mutates self)
		self.handled = try self.handled + 1 otherwise 0
		var spun = self.sink
		for i in 0 upto work 'work'
			spun = (spun + i) mod self.modulus
		end 'work'
		self.sink = spun
	end 'take'

	export function count() returns Amount
		return self.handled
	end 'count'
end 'Consumer'

service Relay
	var to as Consumer.handle

	static function create(consumes to Consumer.handle) returns Self
		return Self{to: to}
	end 'create'

	export function pass()
		try self.to.take() otherwise ignore
	end 'pass'
end 'Relay'

function drained(consumer Consumer.handle) returns Amount
	while (try await consumer.count() otherwise 0) < messages 'drain'
		sleep(1)
	end 'drain'
	return try await consumer.count() otherwise 0
end 'drained'

function within(most Count, bound Count) returns String
	return "within" if most <= bound else "past"
end 'within'

function main() returns ExitCode
	let consumer = spawn Consumer.create()
	for i in 0 upto messages 'direct'
		try consumer.take() otherwise ignore
	end 'direct'
	let direct = drained(consumer)
	let directMost = consumer.mostQueued()
	print("direct: handled={direct}, {within(directMost, bound: turn + 1)} its bound\n")
	if directMost > turn + 1 'directPast'
		print("most queued: {directMost}\n")
	end 'directPast'
	let relayed = spawn Consumer.create()
	let relay = spawn Relay.create(relayed.clone())
	for i in 0 upto messages 'relayed'
		try relay.pass() otherwise ignore
	end 'relayed'
	let handled = drained(relayed)
	let relayMost = relay.mostQueued()
	let consumerMost = relayed.mostQueued()
	let relayBound = turn + 2
	let consumerBound = turn + turn + 4
	let both = "within" if relayMost <= relayBound and consumerMost <= consumerBound else "past"
	print("relayed: handled={handled}, the relay and the consumer {both} their bounds\n")
	if both == "past" 'relayedPast'
		print("most queued: relay {relayMost}, consumer {consumerMost}\n")
	end 'relayedPast'
	return 0
end 'main'
