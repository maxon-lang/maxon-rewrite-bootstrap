// A break that leaves a file open in the loop drops it.
// expect-error: E3919
typealias Bytes = __ManagedMemory with Byte

function broken(path Bytes) throws __ManagedFileError
	for i in 0 upto 3 'each'
		let file = try __ManagedFile.openRead(path)
		if i == 1 'stop'
			break 'each'
		end 'stop'
		try file.close()
	end 'each'
end 'broken'

function main() returns ExitCode
	return 0
end 'main'
