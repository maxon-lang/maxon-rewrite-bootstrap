// A behaviour in generic code takes a value of a type parameter, which crosses to the behaviour's thread only where the
// type argument does: each instance is judged at its own, and a value that holds a promise does not cross.
interface Named
	function named() returns String
end 'Named'

type Word implements Named
	var text as String

	static function make(consumes text String) returns Word
		return Word{text: text}
	end 'make'

	function named() returns String
		return "word {self.text}"
	end 'named'
end 'Word'

type Log
	export var lines as Array with String

	static function make() returns Log
		return Log{lines: Array.create(0)}
	end 'make'
end 'Log'

function relay(into cown with Log, consumes item T) uses T where T implements Named and Droppable
	when into as l 'record'
		l.lines.push(item.named())
	end 'record'
end 'relay'

function main() returns ExitCode
	let log = cown(Log.make())
	relay(share(log), item: Word.make("fine"))
	relay(log, item: Late.make(async nap(1)))
	return 0
end 'main'

function nap(n Count) returns Count
	sleep(1)
	return n
end 'nap'

type Late implements Named
	var p as Promise with Count

	static function make(consumes p Promise with Count) returns Late
		return Late{p: p}
	end 'make'

	function named() returns String
		return "late"
	end 'named'
end 'Late'

