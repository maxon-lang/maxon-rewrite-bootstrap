// A `try xs.get(i)` outside a loop that proves the index keeps the test of the index against the length: it is a comparison
// whose failure goes to the handler, and without it the read would run past the array.
// expect-ir: at has some length.array
// expect-ir: at has some cmp
// expect-ir: at has some elemat

function at(xs Array with Count, i Count) returns Count
	return try xs.get(i) otherwise 7
end 'at'

function main() returns ExitCode
	var xs = Array.create(0) as Array with Count
	xs.push(1)
	print("{at(xs, i: 0)} {at(xs, i: 5)}\n")
	return 0
end 'main'
