// A counted `for` that reads an array with `get` needs no `try`: the range analysis proves the index below the count of an
// array the loop cannot change, so the read is the proven one and the function is left with no `bounds` test and no call of
// the runtime's failure of one.
// expect-ir: sum has no bounds
// expect-ir: sum does not call rt.array.elem

function sum(xs Array with Count) returns Count
	var total = 0 as Count
	for i in 0 upto xs.count() 'each'
		total = try total + (xs.get(i)) otherwise 0
	end 'each'
	return total
end 'sum'

function main() returns ExitCode
	var xs = Array.create(0) as Array with Count
	xs.push(1)
	print("{sum(xs)}\n")
	return 0
end 'main'
