// A parameter of a type that cannot be copied, stored whole, is taken with consumes.
type Token is noncopyable
	export var id as Count

	static function make(id Count) returns Self
		return Self{id: id}
	end 'make'
end 'Token'

type Box
	var item as Token

	static function make(consumes item Token) returns Self
		return Self{item: item}
	end 'make'
end 'Box'

function main() returns ExitCode
	let b = Box.make(Token.make(7))
	print("{b.item.id}\n")
	return 0
end 'main'
