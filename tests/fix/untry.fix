// A try that covers nothing that can fail is removed with its handler, whatever the handler is and wherever the covered
// expression has parentheses of its own or around it; a try block keeps its body.
enum ParseError implements Error
	empty
end 'ParseError'

typealias Digit = int(0 to 9)

function plain(n Count) returns Count
	return n
end 'plain'

function wrapped(a Digit, b Digit) returns Count
	let x = try (plain(1)) otherwise (0)
	let y = try (a + b) as Count otherwise panic("sum")
	let w = try plain(3) otherwise 'never'
		return 0
	end 'never'
	print("{x} {w}\n")
	return y
end 'wrapped'

function early(n Count) returns Count
	let v = try plain(n) otherwise return (1)
	return v
end 'early'

function block()
	try 'safe'
		print("a\n")
		if true 'nested'
			print("b\n")
		end 'nested'
	end 'safe' otherwise 'failed'
		print("c\n")
	end 'failed'
end 'block'

function relay() throws ParseError
	try 'passes'
		print("d\n")
	end 'passes'
end 'relay'

function main() returns ExitCode
	return 0
end 'main'
