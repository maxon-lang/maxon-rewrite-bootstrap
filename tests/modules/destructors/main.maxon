typealias TxnBox = ledger.Box with ledger.Txn

typealias TxnArray = Array with ledger.Txn

function main() returns ExitCode
	ledger.Txn.begin(1).commit()
	TxnBox.of(ledger.Txn.begin(2)).take().rollback()
	var pending = TxnArray.create(0)
	pending.push(ledger.Txn.begin(3))
	(pending.remove(0)).commit()
	pending.dropEmpty()
	ledger.Txn.begin(4).rollback()
	return 0
end 'main'

//> commit 1
//> rollback 2
//> commit 3
//> rollback 4
