export type Account
	export var balance as Count

	export static function open(balance Count) returns Account
		return Account{balance: balance}
	end 'open'
end 'Account'

export function credit(into cown with Account, amount Count)
	when into as a 'credit'
		a.balance = try a.balance + amount otherwise a.balance
	end 'credit'
end 'credit'

export function report(from cown with Account, label String)
	let note = label.clone()
	when from as a 'report'
		print("{note}: {a.balance}\n")
	end 'report'
end 'report'
