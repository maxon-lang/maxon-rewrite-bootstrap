typealias Score = int(i64.min to i64.max)

function twice(n Score) returns Score
	return n * 2
end 'twice'

function main() returns ExitCode
	let a = geometry.area(3, height: 4)
	let side = 7 as geometry.Length
	print("area {a} side {side} perimeter {perimeter(2, height: 5)}\n")
	var p = geometry.Point.create(1, y: 2)
	p.shift(10)
	print("point {p.x} {p.y} {p.describe()}\n")
	let c = geometry.Corner.topLeft
	print("corner {c} {twice(geometry.units.scale(3) as Score)}\n")
	var total = 0 as geometry.Length
	geometry.grow(total)
	geometry.grow(total)
	print("grown {total}\n")
	return 0
end 'main'

//> area 12 side 7 perimeter 14
//> point 11 2 (11, 2)
//> corner topLeft 30
//> grown 2
