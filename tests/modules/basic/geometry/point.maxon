export typealias Coord = int(i64.min to i64.max)

export type Point
	export var x as Coord
	export var y as Coord

	export function shift(mutates self, dx Coord)
		x = x + dx
	end 'shift'

	export function describe() returns String
		return "({x}, {y})"
	end 'describe'

	export static function create(x Coord, y Coord) returns Point
		return Point{x: x, y: y}
	end 'create'
end 'Point'
