type Point implements ranks.Ranked
	var value as ranks.Score

	static function make(value ranks.Score) returns Self
		return Self{value: value}
	end 'make'

	function rank() returns ranks.Score
		return value
	end 'rank'
end 'Point'

function main() returns ExitCode
	let p = Point.make(21)
	print("{p.doubledRank()} {extra.twiceOf(Point.make(4))}\n")
	return 0
end 'main'

//> 42 8
