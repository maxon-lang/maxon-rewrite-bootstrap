// A function of another module that a posted kind's handler calls is judged by what its module published: the kinds with
// no policy it sends, a first hop refused at the call.
type Child
	var id as lib.Amount

	static function create(id lib.Amount) returns Self
		return Self{id: id}
	end 'create'
end 'Child'

type Sup
	var log as lib.Log.handle

	static function create(consumes log lib.Log.handle) returns Self
		return Self{log: log}
	end 'create'

	export function watch(mutates self, child Child.handle)
		child.notifyStopped(self.handle.post(Sup.Message.childStopped(1)))
	end 'watch'

	export function childStopped(mutates self, id lib.Amount)
		lib.tell(self.log, id: id)
	end 'childStopped'
end 'Sup'

function main() returns ExitCode
	let sup = spawn Sup.create(spawn lib.Log.create())
	try sup.watch(spawn Child.create(1)) otherwise ignore
	return 0
end 'main'

