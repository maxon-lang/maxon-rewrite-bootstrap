type Round
	var radius as containers.Score
	static function make(radius containers.Score) returns Round
		return Round{radius: radius}
	end 'make'
	function area() returns containers.Score
		return radius * radius
	end 'area'
end 'Round'

function main() returns ExitCode
	let a = Round.make(1)
	let b = Round.make(2)
	print("{containers.total(a, b: b)}\n")
	return 0
end 'main'

