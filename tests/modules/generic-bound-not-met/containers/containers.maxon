export typealias Score = int(i64.min to i64.max)

export interface Shape
	function area() returns Score
	function grow(mutates self, by Score)
end 'Shape'

export type Box uses T where T implements Copyable
	export var item as T

	export static function make(consumes item T) returns Self
		return Self{item: item}
	end 'make'

	export function peek() returns T
		return item.clone()
	end 'peek'
end 'Box'

export union Option uses T
	some(value T)
	none

	export function isSome() returns bool
		return match self 'm'
			some(v) gives true
			none gives false
		end 'm'
	end 'isSome'
end 'Option'

export function swap(mutates a T, mutates b T) uses T where T implements Copyable
	var tmp = a.clone()
	a = b.clone()
	b = tmp
end 'swap'

export function total(a T, b T) uses T returns Score where T implements Shape
	return a.area() + b.area()
end 'total'

export function enlarge(mutates item T, by Score) uses T returns Box with T where T implements Shape and Copyable
	item.grow(by)
	return Box.make(item.clone())
end 'enlarge'

export function wrap(consumes item T) uses T returns Option with (Box with T)
	return Option.some(Box.make(item))
end 'wrap'
