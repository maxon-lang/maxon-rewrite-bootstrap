function main() returns ExitCode
	print("{try numbers.ratio(9, b: 3) otherwise 0}\n")
	try 'means'
		print("{numbers.mean(10, n: 2)}\n")
		print("{numbers.mean(10, n: 0)}\n")
	end 'means' otherwise (e) 'failed'
		match e 'why'
			overflow then print("overflow\n")
			divisionByZero then print("divisionByZero\n")
			negativeShift then print("negativeShift\n")
		end 'why'
	end 'failed'
	return 0
end 'main'

//> 3
//> 5
//> divisionByZero
