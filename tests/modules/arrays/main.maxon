typealias CountArray = Array with Count

typealias ItemArray = Array with inventory.Item

typealias StringArray = Array with String

function main() returns ExitCode
	var items = ItemArray.create(0)
	items.push(inventory.Item.make(1, weight: 5))
	items.push(inventory.Item.make(2, weight: 7))
	print("{inventory.heaviest(items)} {inventory.length(items)}\n")
	var shelf = inventory.Shelf.make()
	shelf.add(inventory.Item.make(3, weight: 9))
	shelf.add(inventory.Item.make(4, weight: 2))
	let total = try shelf.total() otherwise return 1
	print("{total} {shelf.size()}\n")
	let moved = inventory.drain(shelf)
	print("{moved.count()} {shelf.size()} {inventory.heaviest(moved)}\n")
	var numbers = CountArray.create(0)
	numbers.push(3)
	print("{inventory.firstOr(numbers, fallback: 9)} {inventory.firstOr(CountArray.create(0), fallback: 9)}\n")
	let names = StringArray.filled(2, value: "ab")
	print("{inventory.firstOr(names, fallback: "none")} {inventory.length(names)}\n")
	return 0
end 'main'

//> 7 2
//> 11 2
//> 2 0 9
//> 3 9
//> ab 2
