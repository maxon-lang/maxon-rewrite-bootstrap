typealias ItemArray = Array with Item

export type Item
	export var id as Count
	export var weight as Count

	export static function make(id Count, weight Count) returns Item
		return Item{id: id, weight: weight}
	end 'make'
end 'Item'

export type Shelf
	var items as Array with Item

	export static function make() returns Shelf
		return Shelf{items: ItemArray.create(0)}
	end 'make'

	export function add(mutates self, consumes item Item)
		items.push(item)
	end 'add'

	export function total() returns Count throws ArithmeticError
		var sum = 0 as Count
		for i in 0 upto items.count() 'each'
			sum = try sum + items[i].weight
		end 'each'
		return sum
	end 'total'

	export function size() returns Count
		return items.count()
	end 'size'
end 'Shelf'

export function heaviest(items Array with Item) returns Count
	var best = 0 as Count
	for i in 0 upto items.count() 'scan'
		if items[i].weight > best 'bigger'
			best = items[i].weight
		end 'bigger'
	end 'scan'
	return best
end 'heaviest'

export function length(items Array with T) uses T returns Count
	return items.count()
end 'length'

export function firstOr(items Array with T, consumes fallback T) uses T returns T where T implements Copyable
	if items.isEmpty() 'none'
		return fallback
	end 'none'
	return items[0].clone()
end 'firstOr'

export function drain(mutates shelf Shelf) returns Array with Item
	var out = ItemArray.create(0)
	while not shelf.items.isEmpty() 'each'
		out.push(shelf.items.remove(0))
	end 'each'
	return out
end 'drain'
