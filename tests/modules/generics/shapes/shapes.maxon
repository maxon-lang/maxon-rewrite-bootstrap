export type Square implements containers.Shape
	export var side as containers.Score

	export static function make(side containers.Score) returns Square
		return Square{side: side}
	end 'make'

	export function area() returns containers.Score
		return side * side
	end 'area'

	function grow(mutates self, by containers.Score)
		side = side + by
	end 'grow'
end 'Square'
