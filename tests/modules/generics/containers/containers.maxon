export typealias Score = int(i64.min to i64.max)

export interface Shape
	function area() returns Score
	function grow(mutable self, by Score)
end 'Shape'

export type Box[T]
	export var item as T

	export static function make(item sink T) returns Self
		return Self{item: item}
	end 'make'

	export function peek() returns T
		return item.copy()
	end 'peek'
end 'Box'

export union Option[T]
	some(value T)
	none

	export function isSome() returns bool
		return match self 'm'
			some(v) gives true
			none gives false
		end 'm'
	end 'isSome'
end 'Option'

export function swap[T](a mutable T, b mutable T)
	var tmp = a.copy()
	a = b.copy()
	b = tmp
end 'swap'

export function total[T implements Shape](a T, b T) returns Score
	return a.area() + b.area()
end 'total'

export function enlarge[T implements Shape](item mutable T, by Score) returns Box[T]
	item.grow(by)
	return Box[T].make(item.copy())
end 'enlarge'

export function wrap[T](item sink T) returns Option[Box[T]]
	return Option.some(Box.make(item))
end 'wrap'
