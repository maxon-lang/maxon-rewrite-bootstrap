export typealias Score = int(i64.min to i64.max)

export typealias ScoreBox = Box with Score

export typealias Length = int(0 to 1000)

export typealias Area = int(0 to 1000000)

export interface Shape
	function area() returns Area
	function grow(mutates self, by Length) throws ArithmeticError
end 'Shape'

export type Box uses T
	export var item as T

	export static function make(consumes item T) returns Self
		return Self{item: item}
	end 'make'

	export function peek() returns T where T implements Copyable
		return item.copy()
	end 'peek'
end 'Box'

export union Option uses T
	some(value T)
	none

	export function isSome() returns bool
		return match self 'm'
			some(v) gives true
			none gives false
		end 'm'
	end 'isSome'
end 'Option'

export function swap(mutates a T, mutates b T) uses T where T implements Copyable
	var tmp = a.copy()
	a = b.copy()
	b = tmp
end 'swap'

export function total(a T, b T) uses T returns Count where T implements Shape
	return a.area() + b.area()
end 'total'

export function enlarge(mutates item T, by Length) uses T returns Box with T throws ArithmeticError where T implements Shape and Copyable
	try item.grow(by)
	return Box.make(item.copy())
end 'enlarge'

export function wrap(consumes item T) uses T returns Option with (Box with T) where T implements Copyable
	return Option.some(Box.make(item))
end 'wrap'
