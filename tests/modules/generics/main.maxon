typealias Score = int(i64.min to i64.max)

typealias SquareBox = containers.Box with shapes.Square

typealias ScoreBoxes = array with containers.ScoreBox

function main() returns ExitCode
	var a = shapes.Square.make(3)
	var b = shapes.Square.make(4)
	print("{containers.total(a, b: b)}\n")
	let boxed = containers.enlarge(a, by: 2)
	print("{a.side} {boxed.peek().side}\n")
	containers.swap(a, b: b)
	print("{a.side} {b.side}\n")
	let inner = SquareBox.make(shapes.Square.make(5))
	print("{inner.item.area()}\n")
	let option = containers.wrap(shapes.Square.make(6))
	print("{option.isSome()}\n")
	var x = 1 as containers.Score
	var y = 2 as containers.Score
	containers.swap(x, b: y)
	print("{x} {y}\n")
	var boxes = ScoreBoxes.new()
	boxes.append(containers.ScoreBox.make(7))
	print("{boxes[0].peek()}\n")
	return 0
end 'main'

//> 25
//> 5 5
//> 4 5
//> 25
//> true
//> 2 1
//> 7
