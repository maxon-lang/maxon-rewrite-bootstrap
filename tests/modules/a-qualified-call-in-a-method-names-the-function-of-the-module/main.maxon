typealias Amount = int(0 to 1000)

type Counter
	var n as Amount

	static function create() returns Self
		return Self{n: 7}
	end 'create'

	function size() returns Amount
		return n
	end 'size'

	function twice() returns Amount
		return n
	end 'twice'

	// words.size and words.twice have the methods' names and other parameters: written with their module they are the
	// functions of that module, not the methods.
	function measure(text String) returns String
		let first = words.size(text, pad: size() as words.Amount)
		let second = words.twice(twice() as words.Amount)
		return "{first}/{second}/{size()}/{twice()}"
	end 'measure'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create()
	print("{c.measure("abc")}\n")
	return 0
end 'main'

//> 500/600/7/7
