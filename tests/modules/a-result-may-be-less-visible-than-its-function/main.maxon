function main() returns ExitCode
	let s = vault.make(5)
	print("{s.code} {s.bumped()} {s.name()}\n")
	var t = vault.make(6)
	t.code = 7
	print("{t.code}\n")
	let (a, n) = vault.pair(3)
	print("{a.code} {n}\n")
	let all = vault.many()
	for i in 0 upto all.count() 'each'
		print("{all[i].code}\n")
	end 'each'
	let shelf = vault.Shelf.stock(9)
	print("{shelf.look().code}\n")
	let read = function() gives vault.make(4)
	print("{read().code}\n")
	print("{names.describe(s)} {names.describe(vault.make(8))}\n")
	return 0
end 'main'

//> 5 6 secret 5
//> 7
//> 3 3
//> 1
//> 2
//> 9
//> 4
//> <secret 5> <secret 8>
