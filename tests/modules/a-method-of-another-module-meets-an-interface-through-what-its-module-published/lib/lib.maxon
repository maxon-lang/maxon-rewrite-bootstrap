export typealias Amount = int(0 to 1000000)

export interface Route requires service
	function handle(request Amount) returns Amount
end 'Route'

export service Ledger
	var total as Amount

	export static function create() returns Self
		return Self{total: 0}
	end 'create'

	@policy(Keep) export function read() returns Amount
		return self.total
	end 'read'

	export function note(mutates self, request Amount)
		self.total = request
	end 'note'
end 'Ledger'

export type Waiter
	var ledger as Ledger.handle

	export static function make(consumes ledger Ledger.handle) returns Self
		return Self{ledger: ledger}
	end 'make'

	// handle waits for a reply of another service, which a method that meets a requirement of Route may not do.
	export function handle(request Amount) returns Amount
		return try await self.ledger.read() otherwise 0
	end 'handle'
end 'Waiter'

export type Teller
	var ledger as Ledger.handle

	export static function make(consumes ledger Ledger.handle) returns Self
		return Self{ledger: ledger}
	end 'make'

	// handle sends a kind that names no policy.
	export function handle(request Amount) returns Amount
		try self.ledger.note(request) otherwise ignore
		return request
	end 'handle'
end 'Teller'

export type Quiet
	export static function make() returns Self
		return Self{}
	end 'make'

	export function handle(request Amount) returns Amount
		return request
	end 'handle'
end 'Quiet'
