typealias ItemList = List with Item

type Item
	export var name as String
	export var weight as Count

	static function make(consumes name String, weight Count) returns Item
		return Item{name: name, weight: weight}
	end 'make'
end 'Item'

function describe(l List with Item) returns String
	var text = ""
	if l.isEmpty() 'empty'
		return text
	end 'empty'
	var at = try l.first() otherwise panic("the list is empty")
	while true 'walk'
		text = "{text}{l[at].name}:{l[at].weight};"
		at = try l.next(at) otherwise break
	end 'walk'
	return text
end 'describe'

function main() returns ExitCode
	var l = ItemList.create()
	let b = l.append(Item.make("b", weight: 2))
	let a = l.prepend(Item.make("a", weight: 1))
	let c = l.append(Item.make("c", weight: 3))
	print("{describe(l)}\n")
	print("{l.count()} {l.contains(a)} {l.contains(b)} {l.contains(c)}\n")
	l.moveToFront(c)
	print("{describe(l)}\n")
	l[b].weight = 20
	print("{describe(l)}\n")
	let removed = try l.remove(b) otherwise panic("the handle names no element")
	print("{removed.name} {l.contains(b)} {l.count()} {describe(l)}\n")
	let d = l.append(Item.make("d", weight: 4))
	print("{l.contains(b)} {l.contains(d)} {b == d} {describe(l)}\n")
	let again = try l.remove(b) otherwise Item.make("none", weight: 0)
	print("{again.name}\n")
	let front = try l.removeFirst() otherwise panic("the list is empty")
	let back = try l.removeLast() otherwise panic("the list is empty")
	print("{front.name} {back.name} {l.count()} {describe(l)}\n")
	return 0
end 'main'

//> a:1;b:2;c:3;
//> 3 true true true
//> c:3;a:1;b:2;
//> c:3;a:1;b:20;
//> b false 2 c:3;a:1;
//> false true false c:3;a:1;d:4;
//> none
//> c d 1 a:1;
