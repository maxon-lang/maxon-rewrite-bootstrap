// Children that run at the same time inherit only their own pipes, so each run reads its child's output and sees the end of
// it when that child ends, whether or not another child is still running. Each child waits a moment before it writes, so
// that the runs overlap when there is more than one worker. The children are the host's shell's: cmd.exe's on Windows and
// sh's elsewhere.
// native-only
// schedules: 2
typealias Arguments = Array with String

// The host's shell, the flag that has it run a command, and the command that waits about a second and prints a child's
// label.
#if os(Windows)
	let shellName = "cmd.exe"

	let shellRuns = "/c"

	function pauseThenEcho(label Count) returns String
		return "ping -n 2 127.0.0.1 >nul& echo child {label}"
	end 'pauseThenEcho'
#else
	let shellName = "sh"

	let shellRuns = "-c"

	function pauseThenEcho(label Count) returns String
		return "sleep 1; echo child {label}"
	end 'pauseThenEcho'
#endif

// A Runner runs one child in each message. Each child is run by a service of its own, and messages of different services
// run at once, so the four children overlap.
type Runner
	var shell as String

	static function create() returns Self
		return Self{shell: shellName}
	end 'create'

	export function run(label Count) returns String
		var script = Arguments.create(0)
		script.push(shellRuns)
		script.push(pauseThenEcho(label))
		let out = try Subprocess.run(Executable.name(self.shell.clone()), arguments: script) otherwise panic("cannot run {self.shell}")
		return out.stdout.clone()
	end 'run'
end 'Runner'

function main() returns ExitCode
	let first = spawn Runner.create()
	let second = spawn Runner.create()
	let third = spawn Runner.create()
	let fourth = spawn Runner.create()
	let a = try first.run(1) otherwise panic("the service runs")
	let b = try second.run(2) otherwise panic("the service runs")
	let c = try third.run(3) otherwise panic("the service runs")
	let d = try fourth.run(4) otherwise panic("the service runs")
	let ta = await a
	let tb = await b
	let tc = await c
	let td = await d
	print("{ta.trim()} | {tb.trim()} | {tc.trim()} | {td.trim()}\n")
	return 0
end 'main'

//> child 1 | child 2 | child 3 | child 4
