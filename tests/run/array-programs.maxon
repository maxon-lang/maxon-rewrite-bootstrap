typealias CountArray = Array with Count

typealias CounterArray = Array with Counter

type Counter
	var n as Count

	static function make() returns Counter
		return Counter{n: 0}
	end 'make'

	function bump(mutates self)
		n = try n + 1 otherwise n
	end 'bump'

	function value() returns Count
		return n
	end 'value'
end 'Counter'

type Stack
	var items = CountArray.create(0)

	static function make() returns Stack
		return Stack{}
	end 'make'

	function push(mutates self, n Count)
		items.push(n)
	end 'push'

	function pop(mutates self) returns Count
		return try items.pop() otherwise panic("the array is empty")
	end 'pop'

	function size() returns Count
		return items.count()
	end 'size'
end 'Stack'

union Shape
	row(cells Array with Count)
	empty
end 'Shape'

function primesBelow(limit Count) returns Count
	var prime = Array.filled(limit, value: true)
	var found = 0 as Count
	for i in 2 upto limit 'candidates'
		if prime[i] 'is'
			found = found + 1
			var j = try i * i otherwise limit
			while j < limit 'strike'
				prime[j] = false
				j = try j + i otherwise limit
			end 'strike'
		end 'is'
	end 'candidates'
	return found
end 'primesBelow'

function sort(mutates a Array with Count)
	var swapped = true
	while swapped 'passes'
		swapped = false
		for i in 1 upto a.count() 'scan'
			if a[i - 1] > a[i] 'out'
				let t = a[i]
				a[i] = a[i - 1]
				a[i - 1] = t
				swapped = true
			end 'out'
		end 'scan'
	end 'passes'
end 'sort'

function main() returns ExitCode
	print("{primesBelow(100)} {primesBelow(1000)}\n")
	var a = CountArray.create(0)
	for i in 0 upto 8 'fill'
		a.push(((i * 5) mod 8) as Count)
	end 'fill'
	sort(a)
	var line = ""
	for i in 0 upto a.count() 'show'
		line = "{line}{a[i]},"
	end 'show'
	print("{line}\n")
	var counters = CounterArray.create(0)
	for i in 0 upto 3 'make'
		counters.push(Counter.make())
	end 'make'
	counters[1].bump()
	counters[1].bump()
	counters[2].bump()
	print("{counters[0].value()} {counters[1].value()} {counters[2].value()}\n")
	var stack = Stack.make()
	stack.push(10)
	stack.push(20)
	print("{stack.pop()} {stack.size()} {stack.pop()} {stack.size()}\n")
	var fib = CountArray.create(0)
	fib.push(0)
	fib.push(1)
	let rounds = 30 as Count
	for i in 2 upto rounds 'memo'
		fib.push(try fib[i - 1] + fib[i - 2] otherwise break)
	end 'memo'
	print("{fib[29]} {fib.count()}\n")
	let shape = Shape.row(a)
	match shape 'm'
		row(cells) then print("row of {cells.count()} starting {cells[0]}\n")
		empty then print("empty\n")
	end 'm'
	return 0
end 'main'

//> 25 168
//> 0,1,2,3,4,5,6,7,
//> 0 2 1
//> 20 1 10 0
//> 514229 30
//> row of 8 starting 0
