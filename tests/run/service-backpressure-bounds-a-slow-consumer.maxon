// No capacity is named, and a slow consumer's queue still stays short: main, a task, parks at a send to a service that is
// behind, so it cannot finish sending far ahead of the consumer's handling: the time it takes to send is nearly all of the time until the last message is handled, where with nothing to
// slow it main would be done long before. main yields now and then, as a long task does, so the services run beside it on
// one processor too; the yields alone leave a slow consumer falling further behind at each. Then a relay service passes
// main's messages on to the consumer: it is muted while the consumer is behind, but a relay that is itself behind is not,
// which a loaded machine makes it, so only that every message arrives is held there.
// native-only
// The consumer's work, which makes it slower than main, is 120,000,000 loop steps, which the interpreter does not run in a
// test's time; it parks and mutes in service-backpressure-propagates-up-a-chain and service-backpressure-lets-a-cycle-drain.
//> direct: handled=200000, kept up
//> relayed: handled=200000
export typealias Amount = int(0 to 1000000)

let messages = 200000 as Amount

let work = 300 as Amount

let sinkModulus = 1000 as Amount

// yieldEvery is how many messages main sends between two yields.
let yieldEvery = 100 as Amount

// keptUpTenths is the least share, in tenths, of the time until the last message is handled that main spends sending: a
// queue of a few turns is handled in a sliver of the time, and one that nothing bounds in most of it.
let keptUpTenths = 9 as InstantNanos

let tenths = 10 as InstantNanos

type Consumer
	var handled as Amount
	var sink as Amount

	static function create() returns Self
		return Self{handled: 0, sink: 0}
	end 'create'

	export function take(mutates self)
		self.handled = try self.handled + 1 otherwise 0
		var spun = self.sink
		for i in 0 upto work 'work'
			spun = (try spun + i otherwise 0) mod sinkModulus
		end 'work'
		self.sink = spun
	end 'take'

	export function count() returns Amount
		return self.handled
	end 'count'
end 'Consumer'

type Relay
	var to as Consumer.handle

	static function create(consumes to Consumer.handle) returns Self
		return Self{to: to}
	end 'create'

	export function pass()
		try self.to.take() otherwise ignore
	end 'pass'
end 'Relay'

// verdict waits until the consumer has handled every message, and says whether main's sending, which took sent of the
// nanoseconds since started, took nearly all of the time until then.
function verdict(consumer Consumer.handle, started InstantNanos, sent InstantNanos) returns String
	while (try await consumer.count() otherwise 0) < messages 'drain'
		sleep(1)
	end 'drain'
	let done = try Clock.nowNanos() - started otherwise 0
	let keptUp = (try sent * tenths otherwise 0) >= (try done * keptUpTenths otherwise 0)
	let how = "kept up" if keptUp else "fell behind: main sent in {sent} ns of {done}"
	return "handled={try await consumer.count() otherwise 0}, {how}"
end 'verdict'

function main() returns ExitCode
	let consumer = spawn Consumer.create()
	let started = Clock.nowNanos()
	for i in 0 upto messages 'direct'
		try consumer.take() otherwise ignore
		if i mod yieldEvery == 0 'share'
			Scheduler.yield()
		end 'share'
	end 'direct'
	print("direct: {verdict(consumer, started: started, sent: try Clock.nowNanos() - started otherwise 0)}\n")
	let relayed = spawn Consumer.create()
	let relay = spawn Relay.create(relayed.clone())
	for i in 0 upto messages 'relayed'
		try relay.pass() otherwise ignore
		if i mod yieldEvery == 0 'share'
			Scheduler.yield()
		end 'share'
	end 'relayed'
	while (try await relayed.count() otherwise 0) < messages 'drain'
		sleep(1)
	end 'drain'
	print("relayed: handled={try await relayed.count() otherwise 0}\n")
	return 0
end 'main'
