typealias NodeArray = Array with Node

union Node
	leaf(value Count, note String)
	branch(label String, kids Array with Node)

	function size() returns Count throws ArithmeticError
		return match self 'm'
			leaf(v, note) gives 1
			branch(label, kids) gives try 1 + sizeOf(kids)
		end 'm'
	end 'size'

	function text() returns String
		return match self 'm'
			leaf(v, note) gives "{v}{note}"
			branch(label, kids) gives "{label}[{join(kids)}]"
		end 'm'
	end 'text'
end 'Node'

function sizeOf(kids Array with Node) returns Count throws ArithmeticError
	var total = 0 as Count
	for i in 0 upto kids.count() 'each'
		total = try total + kids[i].size()
	end 'each'
	return total
end 'sizeOf'

function join(kids Array with Node) returns String
	var out = ""
	for i in 0 upto kids.count() 'each'
		out = "{out} {kids[i].text()}"
	end 'each'
	return out
end 'join'

function tree(depth Count) returns Node
	if depth == 0 'base'
		return Node.leaf(7, note: "!")
	end 'base'
	var kids = NodeArray.create(0)
	kids.push(tree(depth - 1))
	kids.push(Node.leaf(depth, note: "{depth}?"))
	kids.push(tree(depth - 1))
	return Node.branch("d{depth}", kids: kids)
end 'tree'

function main() returns ExitCode
	let a = tree(2)
	let b = a.clone()
	try 'report'
		print("{a.size()} {b.size()}\n{a.text()}\n{b.text()}\n")
		var kept = NodeArray.create(0)
		kept.push(b.clone())
		kept.push(a)
		let c = kept.clone()
		print("{sizeOf(c)} {sizeOf(kept)}\n")
	end 'report' otherwise 'failed'
		return 1
	end 'failed'
	return 0
end 'main'

//> 10 10
//> d2[ d1[ 7! 11? 7!] 22? d1[ 7! 11? 7!]]
//> d2[ d1[ 7! 11? 7!] 22? d1[ 7! 11? 7!]]
//> 20 20
