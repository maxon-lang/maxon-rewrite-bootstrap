// Running Linux's programs, found on PATH or by a path, as subprocess.maxon runs Windows'.
// unsupported-targets: x64-windows
// native-only
//> code=3 succeeded=false stdout=true stderr=true
//> spaced=true code=0 succeeded=true
//> path=true
//> missing=executableNotFound
//> sleeper=timeout
//> quick=ran 0
//> unbounded=ran 0

typealias Arguments = Array with String

// outcome runs a program under a deadline and says how it ended.
function outcome(name String, arguments Arguments, deadline WaitDeadline) returns String
	try 'run'
		let out = Subprocess.runWithDeadline(Executable.name(name.clone()), arguments: arguments, deadline: deadline)
		return "ran {out.exitCode()}"
	end 'run' otherwise (e) 'failed'
		match e 'kind'
			executableNotFound then return "executableNotFound"
			spawnFailed then return "spawnFailed"
			busy then return "busy"
			ioFailed then return "ioFailed"
			timeout then return "timeout"
			treeNotEnded then return "treeNotEnded"
			detachRefused then return "detachRefused"
			inputTooLarge then return "inputTooLarge"
			statusLost then return "statusLost"
		end 'kind'
	end 'failed'
	return "unreachable"
end 'outcome'

// sleepFor runs sleep for a number of seconds.
function sleepFor(seconds String, deadline WaitDeadline) returns String
	var args = Arguments.create(0)
	args.push(seconds.clone())
	return outcome("sleep", arguments: args, deadline: deadline)
end 'sleepFor'

function main() returns ExitCode
	var script = Arguments.create(0)
	script.push("-c")
	script.push("echo out; echo err 1>&2; exit 3")
	let out = try Subprocess.run(Executable.name("sh"), arguments: script) otherwise panic("cannot run sh")
	print("code={out.exitCode()} succeeded={out.succeeded()} stdout={out.stdout == "out\n"} stderr={out.stderr == "err\n"}\n")
	var echo = Arguments.create(0)
	echo.push("a b")
	let spaced = try Subprocess.run(Executable.name("echo"), arguments: echo) otherwise panic("cannot run echo")
	print("spaced={spaced.stdout == "a b\n"} code={spaced.exitCode()} succeeded={spaced.succeeded()}\n")
	let binEcho = try FilePath.from("/bin/echo") otherwise panic("not a path")
	let byPath = try Subprocess.run(Executable.path(binEcho), arguments: echo) otherwise panic("cannot run /bin/echo")
	print("path={byPath.stdout == spaced.stdout}\n")
	print("missing={outcome("minimaxon_no_such_exe_98765", arguments: Arguments.create(0), deadline: WaitDeadline.none)}\n")
	print("sleeper={sleepFor("11", deadline: WaitDeadline.within(300))}\n")
	print("quick={sleepFor("0", deadline: WaitDeadline.within(30000))}\n")
	print("unbounded={sleepFor("0", deadline: WaitDeadline.none)}\n")
	return 0
end 'main'
