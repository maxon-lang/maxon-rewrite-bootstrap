// A watch of a service's stop completes once the service is freed: the last handle goes while a message is still queued,
// and the release of that last behaviour, whose hold is the last owner, frees the service and gives its watches, with no
// stop at all.
//> watched
export typealias Count = int(0 to 1000)

service Counter
	var n as Count

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	export function bump(mutates self)
		self.n = try self.n + 1 otherwise 0
	end 'bump'
end 'Counter'

// release takes the last handle of a counter and drops it.
function release(consumes counter Counter.handle)
	try counter.bump() otherwise panic("send")
end 'release'

function main() returns ExitCode
	let counter = spawn Counter.create()
	try counter.bump() otherwise panic("send")
	let watch = counter.stopped()
	release(counter)
	await watch
	print("watched\n")
	return 0
end 'main'
