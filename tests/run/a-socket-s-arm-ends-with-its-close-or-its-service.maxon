// An arm of a socket's readiness ends with its close, with the end of the service it would tell, or with a call that waits
// in its mode: the message is never handled, the service's hold is given back, and the program ends with nothing left armed.
// native-only
// unsupported-targets: x64-windows
//> closed while armed: the watcher was told nothing
//> stopped while armed: the watcher was told nothing
//> a read that waits took the arm: more
export typealias Amount = int(0 to 1000000)

type Watcher
	var told as Amount

	static function create() returns Self
		return Self{told: 0}
	end 'create'

	export function acceptable(mutates self)
		print("told: a connection waits\n")
		self.told = try self.told + 1 otherwise 0
	end 'acceptable'

	export function readable(mutates self)
		self.told = try self.told + 1 otherwise 0
	end 'readable'
end 'Watcher'

function main() returns ExitCode
	var listener = try TcpListener.bind("127.0.0.1", port: 0) otherwise panic("a listener on the loopback")
	let w = spawn Watcher.create()
	let ended = w.stopped()
	listener.notifyAcceptable(w.post(Watcher.Message.acceptable))
	try listener.close() otherwise ignore
	try w.readable() otherwise panic("a send to a service that runs")
	w.shutdown()
	await ended
	print("closed while armed: the watcher was told nothing\n")
	var second = try TcpListener.bind("127.0.0.1", port: 0) otherwise panic("a listener on the loopback")
	let v = spawn Watcher.create()
	let stopped = v.stopped()
	second.notifyAcceptable(v.post(Watcher.Message.acceptable))
	try v.readable() otherwise panic("a send to a service that runs")
	v.shutdown()
	await stopped
	print("stopped while armed: the watcher was told nothing\n")
	var client = try TcpClient.connect("127.0.0.1", port: second.port()) otherwise panic("a connection to the listener")
	var server = try second.accept() otherwise panic("an accept")
	let u = spawn Watcher.create()
	server.notifyReadable(u.post(Watcher.Message.readable))
	_ = try client.send("more") otherwise panic("a send to the server")
	let got = try server.readSome(64) otherwise panic("a read that waits")
	print("a read that waits took the arm: {String.from(got)}\n")
	u.shutdown()
	try server.close() otherwise ignore
	try client.close() otherwise ignore
	try second.close() otherwise ignore
	return 0
end 'main'
