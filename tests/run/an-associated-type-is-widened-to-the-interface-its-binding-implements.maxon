// A value whose conformance binds an associated type to a type that implements an interface is put in a value of the
// interface that binds it to that interface: each cursor createIterator() makes is boxed as it is returned, with its own
// type's table, so two conformers binding the position to two types walk each their own. A requirement that does not
// give the associated type calls the method as it is.
typealias Integer = int(i64.min to i64.max)

interface Cursor uses Element
	function current() returns Element
	function advance(mutates self) throws IterationError
end 'Cursor'

interface Bag uses Element, Iter
	function createIterator() returns Iter throws IterationError
	function size() returns Integer
end 'Bag'

type UpCursor implements Cursor with Integer
	var pos as Integer
	let limit as Integer

	static function create(limit Integer) returns Self throws IterationError
		if limit < 1 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Self{pos: 1, limit: limit}
	end 'create'

	function current() returns Integer
		return self.pos
	end 'current'

	function advance(mutates self) throws IterationError
		if self.pos >= self.limit 'atTheLast'
			throw IterationError.exhausted
		end 'atTheLast'
		self.pos = self.pos + 1
	end 'advance'
end 'UpCursor'

type WordCursor implements Cursor with Integer
	var words as Array with String

	static function create(consumes words Array with String) returns Self throws IterationError
		if words.count() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Self{words: words}
	end 'create'

	function current() returns Integer
		return try self.words.get(0).byteLength() as Integer otherwise 0
	end 'current'

	function advance(mutates self) throws IterationError
		_ = try self.words.remove(0) otherwise panic("empty")
		if self.words.count() == 0 'atTheLast'
			throw IterationError.exhausted
		end 'atTheLast'
	end 'advance'
end 'WordCursor'

type UpBag implements Bag with (Integer, UpCursor)
	let limit as Integer

	static function create(limit Integer) returns Self
		return Self{limit: limit}
	end 'create'

	function createIterator() returns UpCursor throws IterationError
		return try UpCursor.create(self.limit)
	end 'createIterator'

	function size() returns Integer
		return self.limit
	end 'size'
end 'UpBag'

type Sentence implements Bag with (Integer, WordCursor)
	let text as String

	static function create(consumes text String) returns Self
		return Self{text: text}
	end 'create'

	function createIterator() returns WordCursor throws IterationError
		var words = Array.create(0) as Array with String
		for word in self.text.split(" ") 'each'
			words.push(word.clone())
		end 'each'
		return try WordCursor.create(words)
	end 'createIterator'

	function size() returns Integer
		return try self.text.byteLength() as Integer otherwise 0
	end 'size'
end 'Sentence'

typealias IntegerCursor = Cursor with Integer

typealias IntegerBag = Bag with (Integer, IntegerCursor)

function total(source IntegerBag) returns Integer
	var sum = 0 as Integer
	for item in source 'walk'
		sum = try sum + item otherwise panic("out of range")
	end 'walk'
	return sum
end 'total'

function main() returns ExitCode
	var bags = Array.create(0) as Array with IntegerBag
	bags.push(UpBag.create(4))
	bags.push(Sentence.create("a bb ccc"))
	bags.push(UpBag.create(0))
	for bag in bags 'each'
		print("{bag.size()} {total(bag)}\n")
	end 'each'
	return 0
end 'main'

//> 4 10
//> 8 6
//> 0 0
