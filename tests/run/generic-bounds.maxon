typealias Score = int(i64.min to i64.max)

typealias ColorWrapper = Wrapper with Color

typealias ColorWrapperWrapper = Wrapper with (Wrapper with Color)

interface Describe
	function describe() returns String
	function twin() returns Self
end 'Describe'

enum Color implements Describe
	red
	green

	function describe() returns String
		return "color {self.name}"
	end 'describe'

	function twin() returns Color
		return Color.green
	end 'twin'
end 'Color'

type Wrapper uses T implements Describe where T implements Describe
	var inner as T
	var calls = 0 as Score

	static function make(consumes inner T) returns Self
		return Self{inner: inner}
	end 'make'

	function describe() returns String
		return "wrapper of {inner.describe()}"
	end 'describe'

	function twin() returns Wrapper with T
		return Self.make(inner.twin())
	end 'twin'
end 'Wrapper'

type Tally
	var total = ColorWrapper.make(Color.red)
	var count = 3 as Score

	static function create() returns Tally
		return Tally{}
	end 'create'
end 'Tally'

function show(item T) uses T returns String where T implements Describe
	return item.describe()
end 'show'

function showTwin(item T) uses T returns String where T implements Describe and Droppable
	return show(item.twin())
end 'showTwin'

function depth(x T, n Score) uses T returns Score throws ArithmeticError where T implements Copyable
	if n == 0 'done'
		return 0
	end 'done'
	return try 1 + depth(x.copy(), n: n - 1)
end 'depth'

function ping(x T, n Score) uses T returns Score throws ArithmeticError where T implements Copyable
	if n == 0 'done'
		return 0
	end 'done'
	return try pong(x.copy(), n: n - 1)
end 'ping'

function pong(x T, n Score) uses T returns Score throws ArithmeticError where T implements Copyable
	return try 1 + ping(x.copy(), n: n)
end 'pong'

function main() returns ExitCode
	print("{show(Color.red)}\n")
	print("{showTwin(Color.red)}\n")
	let w = ColorWrapper.make(Color.red)
	print("{show(w)}\n")
	print("{showTwin(w)}\n")
	let w2 = ColorWrapperWrapper.make(w.copy())
	print("{show(w2)}\n")
	let t = Tally.create()
	print("{t.total.describe()} {t.count}\n")
	print("{try depth("x", n: 4) otherwise return 1} {try depth(Color.red, n: 2) otherwise return 1} {try ping(3 as Score, n: 5) otherwise return 1}\n")
	return 0
end 'main'

//> color red
//> color green
//> wrapper of color red
//> wrapper of color green
//> wrapper of wrapper of color red
//> wrapper of color red 3
//> 4 2 5
