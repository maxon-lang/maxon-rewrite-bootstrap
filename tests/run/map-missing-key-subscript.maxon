// expect-exit: 1
typealias StringCountMap = map with (String, Count)

function main() returns ExitCode
	var m = StringCountMap.new()
	m.insert("a", value: 1)
	print("{m["a"]} {m.has("b")}\n")
	let gone = m.remove("a")
	print("{gone.isSome()} {m.has("a")}\n")
	print("{m["a"]}\n")
	return 0
end 'main'

//> 1 false
//> true false
