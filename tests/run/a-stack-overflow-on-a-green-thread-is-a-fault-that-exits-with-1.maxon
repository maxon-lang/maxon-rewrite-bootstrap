// native-only
// Recursion with no end overflows main's green stack once a sleep has made the program one that runs the scheduler: the
// fault handler writes its line and ends the process with 1, taking the exit claim first. The interpreter runs no sleep.
// expect-scheduler: used
// expect-exit: 1
//> down

typealias Depth = int(0 to i64.max)

function down(n Depth) returns Depth
	return try down(try n + 1 otherwise 0) + 1 otherwise 0
end 'down'

function main() returns ExitCode
	sleep(1)
	print("down\n")
	return 0 if down(0) == 0 else 2
end 'main'
