// Requests sent one after another without waiting for their answers (pipelined, RFC 9112 §9.3.2) are answered in the order
// they came: three in one write, the second with a body, then two more whose bytes split the second's head across writes.
// native-only
//> 1: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 15\r\n\r\nGET /a HTTP/1.1
//> 2: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 29\r\n\r\nPOST /b HTTP/1.1 with 3 bytes
//> 3: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 15\r\n\r\nGET /c HTTP/1.1
//> 4: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 15\r\n\r\nGET /d HTTP/1.1
//> 5: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 15\r\nConnection: close\r\n\r\nGET /e HTTP/1.1
//> then: [closed]
//> stopped
function shown(text String) returns String
	return text.replace("\r\n", with: "\\r\\n")
end 'shown'

// readToEnd reads what the server sends until it closes the connection.
function readToEnd(mutates client TcpClient) returns String
	var all = ByteArray.create(0)
	while true 'reading'
		let chunk = try client.readSome(4096) otherwise return "{shown(String.from(all))} [the read failed]"
		if chunk.isEmpty() 'closed'
			break 'reading'
		end 'closed'
		all.append(chunk)
	end 'reading'
	return shown(String.from(all))
end 'readToEnd'

// headEnd is where the head that starts the bytes ends, past its empty line, or 0 where it has not all come.
function headEnd(bytes ByteArray) returns Count
	// The last four bytes read, one to a byte of the word: CR LF CR LF ends the head.
	var last = 0 as Count
	for j in 0 upto bytes.count() 'seek'
		last = try (last * 256 + bytes[j] as Count) mod 4294967296 otherwise 0
		if last == 218762506 'found'
			return j + 1
		end 'found'
	end 'seek'
	return 0
end 'headEnd'

// statedLength is the Content-Length a head states.
function statedLength(head String) returns Count
	let name = "Content-Length: "
	let at = try head.findFirst(name) otherwise return 0
	var value = 0 as Count
	let first = try at.bytePos() + name.byteLength() otherwise return 0
	var i = first as Count
	while i < head.byteLength() and head.byteAt(i) >= 48 and head.byteAt(i) <= 57 'digits'
		value = try value * 10 + (head.byteAt(i) - 48) as Count otherwise return 0
		i = i + 1
	end 'digits'
	return value
end 'statedLength'

// Answers reads answers off a kept connection one at a time, by the length each head states, and keeps what came past one
// for the next.
type Answers
	var client as TcpClient
	var held as ByteArray

	static function over(consumes client TcpClient) returns Answers
		return Answers{client: client, held: ByteArray.create(0)}
	end 'over'

	// next is the next whole answer, or what came of it and why it is not whole.
	function next(mutates self) returns String
		while true 'reading'
			let past = headEnd(self.held)
			if past > 0 'head'
				let length = statedLength(String.from(try self.held.slice(0, endIndex: past as ElementIndex) otherwise ByteArray.create(0)))
				let whole = try past + length otherwise 0
				if self.held.count() >= whole 'whole'
					let answer = try self.held.slice(0, endIndex: whole as ElementIndex) otherwise ByteArray.create(0)
					self.held = try self.held.slice(whole as ElementIndex, endIndex: self.held.count() as ElementIndex) otherwise ByteArray.create(0)
					return shown(String.from(answer))
				end 'whole'
			end 'head'
			let chunk = try self.client.readSome(4096) otherwise return "{shown(String.from(self.held))} [the read failed]"
			if chunk.isEmpty() 'closed'
				return "{shown(String.from(self.held))}[closed]"
			end 'closed'
			self.held.append(chunk)
		end 'reading'
		return ""
	end 'next'

	// rest is what comes until the server closes the connection.
	function rest(mutates self) returns String
		let before = shown(String.from(self.held))
		self.held = ByteArray.create(0)
		return "{before}{readToEnd(self.client)}"
	end 'rest'

	function send(mutates self, text String)
		_ = try self.client.send(text) otherwise 0
	end 'send'

	function close(destructs self)
		try self.client.close() otherwise ignore
	end 'close'
end 'Answers'

function connected(port NetworkPort) returns Answers
	var client = try TcpClient.connect("127.0.0.1", port: port) otherwise panic("a connection to the server")
	try client.setReadDeadline(5000) otherwise ignore
	return Answers.over(client)
end 'connected'

// Echo answers each request with its request line, and with how many bytes its body had where it had one.
type Echo implements HttpHandler
	// The content type of the answers, made once: maxon's text/plain, with no charset.
	let plainText as HttpFieldValue

	static function create() returns Self
		return Self{plainText: try HttpFieldValue.of("text/plain") otherwise panic("text/plain is a field's value")}
	end 'create'

	function handle(consumes exchange HttpExchange) returns HttpAnswered
		let line = "{methodName(exchange.request.method)} {exchange.request.target()} HTTP/1.{exchange.request.minorVersion}"
		let count = exchange.requestBody.count()
		return exchange.respondWith(StatusCode.ok, body: "{line} with {count} bytes" if count > 0 else line, contentType: self.plainText)
	end 'handle'
end 'Echo'

function methodName(method HttpMethod) returns String
	return match method 'method'
		get gives "GET"
		post gives "POST"
		put gives "PUT"
		delete gives "DELETE"
		head gives "HEAD"
		patch gives "PATCH"
		options gives "OPTIONS"
	end 'method'
end 'methodName'

function main() returns ExitCode
	let server = try HttpServer.bind("127.0.0.1", port: 0) otherwise panic("a server on the loopback")
	let port = server.port()
	let serving = server.serve(freeze(Echo.create()), config: ServerConfig.create())
	var answers = connected(port)
	answers.send("GET /a HTTP/1.1\r\nHost: a\r\n\r\nPOST /b HTTP/1.1\r\nHost: a\r\nContent-Length: 3\r\n\r\nxyzGET /c HTTP/1.1\r\nHost: a\r\n\r\n")
	for i in 1 upto 4 'three'
		print("{i}: {answers.next()}\n")
	end 'three'
	answers.send("GET /d HTTP/1.1\r\nHost: a\r\n\r\nGET /e HT")
	sleep(20)
	answers.send("TP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")
	print("4: {answers.next()}\n")
	print("5: {answers.next()}\n")
	print("then: {answers.next()}\n")
	answers.close()
	serving.stop(1000)
	print("stopped\n")
	return 0
end 'main'
