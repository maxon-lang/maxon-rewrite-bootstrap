typealias CountArray = array with Count

typealias CountArrayArray = array with (array with Count)

typealias PointArray = array with Point

type Point
	export var x as Count
	export var y as Count

	static function make(x Count, y Count) returns Point
		return Point{x: x, y: y}
	end 'make'
end 'Point'

function bump(mutates n Count)
	n = n + 1
end 'bump'

function shift(mutates p Point)
	p.x = p.x + 10
end 'shift'

function total(items array with Count) returns Count
	var sum = 0 as Count
	for i in 0 upto items.count() 'sum'
		sum = sum + items[i]
	end 'sum'
	return sum
end 'total'

function length(items array with T) uses T returns Count
	return items.count()
end 'length'

function duplicate(mutates items array with T, at Count) uses T where T implements Copyable
	items.insert(items[at].copy(), at: at)
end 'duplicate'

function popOr(mutates items array with Count, fallback Count) returns Count
	let last = items.pop()
	if last.isSome() 'some'
		return last.unwrap()
	end 'some'
	return fallback
end 'popOr'

function main() returns ExitCode
	var a = CountArray.new()
	for i in 0 upto 1000 'grow'
		a.append(i as Count)
	end 'grow'
	print("{a.count()} {total(a)} {a[999]}\n")
	var b = CountArray.filled(3, value: 7)
	b.insert(1, at: 0)
	b.insert(2, at: 2)
	b.insert(3, at: b.count())
	print("{b[0]} {b[1]} {b[2]} {b[3]} {b[4]} {b[5]}\n")
	print("{b.remove(1)} {b.count()} {b.remove(b.count() - 1)} {b.count()}\n")
	bump(b[0])
	b[1] = b[0] + b[1]
	print("{b[0]} {b[1]} {b[2]} {b[3]}\n")
	var empty = CountArray.new()
	print("{empty.isEmpty()} {b.isEmpty()} {popOr(empty, fallback: 42)} {popOr(b, fallback: 42)} {b.count()}\n")
	match b.pop() 'popped'
		some(v) then print("popped {v}\n")
		none then print("nothing\n")
	end 'popped'
	var points = PointArray.new()
	points.append(Point.make(1, y: 2))
	points.append(Point.make(3, y: 4))
	shift(points[1])
	points[0].y = 9
	var copied = points.copy()
	copied[0].x = 100
	print("{points[0].x} {points[0].y} {points[1].x} {points[1].y} {copied[0].x} {copied.count()}\n")
	let taken = points.remove(0)
	print("{taken.y} {points.count()} {length(points)} {length(a)}\n")
	duplicate(points, at: 0)
	points[0].x = 5
	print("{points[0].x} {points[1].x} {points.count()}\n")
	var grid = CountArrayArray.new()
	grid.append(CountArray.filled(3, value: 0))
	grid.append(CountArray.filled(2, value: 1))
	grid[0][1] = 5
	grid[1].append(8)
	print("{grid[0][0]} {grid[0][1]} {grid[1].count()} {grid[1][2]} {grid.count()}\n")
	return 0
end 'main'

//> 1000 499500 999
//> 1 7 2 7 7 3
//> 7 5 3 4
//> 2 4 7 7
//> true false 42 7 3
//> popped 7
//> 1 9 13 4 100 2
//> 9 1 1 1000
//> 5 13 2
//> 0 5 3 8 2
