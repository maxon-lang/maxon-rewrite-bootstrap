type Ledger
	export var entries as array[String]
	static function make() returns Ledger
		return Ledger{entries: array[String].new()}
	end 'make'
	function record(inout self, into cown[Ledger], text String)
		let note = text.copy()
		when into as l 'append'
			l.entries.append(note)
		end 'append'
	end 'record'
	function show(into cown[Ledger])
		when into as l 'show'
			for i in 0 upto l.entries.count() 'lines'
				print("{i}: {l.entries[i]}\n")
			end 'lines'
		end 'show'
	end 'show'
end 'Ledger'

type Slot[T]
	var held as T
	static function put(into cown[Slot[T]], value sink T)
		when into as s 'put'
			s.held = value
		end 'put'
	end 'put'
	static function make(held sink T) returns Self
		return Self{held: held}
	end 'make'
end 'Slot'

function main() returns ExitCode
	var local = Ledger.make()
	let book = cown(Ledger.make())
	local.record(book, text: "first")
	local.record(book, text: "second")
	let reader = share(book)
	local.show(reader)
	let slot = cown(Slot.make("a"))
	let writer = share(slot)
	Slot[String].put(slot, value: "b")
	Slot[String].put(writer, value: "c")
	return 0
end 'main'

//> 0: first
//> 1: second
