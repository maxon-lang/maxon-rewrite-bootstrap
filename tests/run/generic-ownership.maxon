typealias Score = int(i64.min to i64.max)

typealias ScoreSlot = Slot with Score

typealias StringSlot = Slot with String

typealias StringStringPair = Pair with (String, String)

type Pair uses A, B
	var first as A
	var second as B

	static function make(consumes first A, consumes second B) returns Self
		return Self{first: first, second: second}
	end 'make'

	function describe() returns String
		return "pair"
	end 'describe'

	function trade(mutates self, consumes other A)
		first = other
	end 'trade'
end 'Pair'

union Slot uses T
	full(value T)
	empty
end 'Slot'

function swap(mutates a T, mutates b T) uses T
	var tmp = a.copy()
	a = b.copy()
	b = tmp
end 'swap'

function fill(sets out T, from T) uses T
	out = from.copy()
end 'fill'

function count(a T) uses T returns Score
	return 1
end 'count'

function eat(consumes a T) uses T returns Score
	return 1
end 'eat'

function hold(consumes a T) uses T returns Pair with (T, T)
	let keep = a.copy()
	return Pair.make(a, second: keep)
end 'hold'

function reuse(consumes a T, b T) uses T returns Score
	var held = a
	var total = eat(held)
	held = b.copy()
	total = total + eat(held)
	return total
end 'reuse'

function later(a T, b T, flag bool) uses T returns T
	var chosen = a.copy()
	if flag 'f'
		chosen = b.copy()
	end 'f'
	return chosen
end 'later'

function either(consumes a T, consumes b T, flag bool) uses T returns T
	return a if flag else b
end 'either'

function inspect(slot Slot with T) uses T returns Score
	return match slot 'm'
		full(v) gives count(v)
		empty gives 0
	end 'm'
end 'inspect'

function reopen(slot Slot with T) uses T returns Slot with T
	return match slot 'm'
		full(v) gives Slot.full(v.copy())
		empty gives Slot.empty
	end 'm'
end 'reopen'

function disjoint(mutates p Pair with (T, T)) uses T
	swap(p.first, b: p.second)
end 'disjoint'

function uninit(a T) uses T returns T
	var x as T
	fill(x, from: a)
	return x
end 'uninit'

function main() returns ExitCode
	let h = hold("kept")
	print("{h.first} {h.second}\n")
	print("{reuse("a", b: "b")}\n")
	print("{later("x", b: "y", flag: true)} {later("x", b: "y", flag: false)}\n")
	print("{either("p", b: "q", flag: false)}\n")
	print("{inspect(StringSlot.full("s"))} {inspect(StringSlot.empty)}\n")
	let r = reopen(ScoreSlot.full(5))
	match r 'm'
		full(n) then print("score {n}\n")
		empty then print("empty\n")
	end 'm'
	var p = StringStringPair.make("one", second: "two")
	disjoint(p)
	print("{p.first} {p.second}\n")
	p.trade("three")
	print("{p.first} {p.second}\n")
	print("{uninit("made")}\n")
	var n = 1 as Score
	var m = 2 as Score
	swap(n, b: m)
	print("{n} {m}\n")
	return 0
end 'main'

//> kept kept
//> 2
//> y x
//> q
//> 1 0
//> score 5
//> two one
//> three one
//> made
//> 2 1
