// expect-exit: 1
typealias CellPool = SlotMap with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var p = CellPool.create()
	let old = p.insert(Cell.make(1))
	let gone = try p.remove(old) otherwise panic("the slot key names no element")
	print("removed {gone.n}\n")
	let fresh = p.insert(Cell.make(2))
	print("reused {(try p.get(fresh) otherwise panic("the slot key names no element")).n} {p.contains(old)}\n")
	print("{(try p.get(old) otherwise panic("the slot key names no element")).n}\n")
	return 0
end 'main'

//> removed 1
//> reused 2 false
