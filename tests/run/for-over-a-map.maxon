typealias Ages = Map with (String, Count)

typealias Boxes = Map with (Count, Box)

type Box
	export var n as Count

	static function make(n Count) returns Box
		return Box{n: n}
	end 'make'
end 'Box'

function main() returns ExitCode
	var ages = Ages.create()
	ages.upsert("ada", value: 36)
	ages.upsert("alan", value: 41)
	ages.upsert("grace", value: 85)
	var total = 0 as Count
	for (name, age) in ages 'entries'
		total = try total + age + name.count() otherwise panic("overflow")
	end 'entries'
	print("{total}\n")
	var names = 0 as Count
	for (name, _) in ages 'keys'
		names = try names + name.count() otherwise panic("overflow")
	end 'keys'
	var sum = 0 as Count
	for (_, age) in ages 'values'
		sum = try sum + age otherwise panic("overflow")
	end 'values'
	print("{names} {sum}\n")
	var visited = 0 as Count
	for (_, age) in ages 'first'
		visited = try visited + 1 otherwise panic("overflow")
		if age > 0 'any'
			break 'first'
		end 'any'
	end 'first'
	print("{visited}\n")
	let none = Ages.create()
	for (name, age) in none 'empty'
		print("never {name} {age}\n")
	end 'empty'
	var boxes = Boxes.create()
	boxes.upsert(1, value: Box.make(5))
	boxes.upsert(2, value: Box.make(7))
	for (_, box) in boxes 'boxes'
		box.n = try box.n * 2 otherwise panic("overflow")
	end 'boxes'
	var doubled = 0 as Count
	for (key, box) in boxes 'again'
		doubled = try doubled + key + box.n otherwise panic("overflow")
	end 'again'
	print("{doubled}\n")
	return 0
end 'main'

//> 174
//> 12 162
//> 1
//> 27
