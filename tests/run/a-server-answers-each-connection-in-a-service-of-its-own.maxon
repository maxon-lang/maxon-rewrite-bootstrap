// A serving HttpServer accepts each connection into a service of its own, and answers it: one connection after another,
// then two at once, each answered on its own connection. `stop` closes the listener and waits for every connection to end.
// The answers say what the request line was, in the handler's place, until the handler is called from the connection.
// native-only
//> GET /one HTTP/1.1\r\nHost: a\r\n\r\n -> HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 17\r\nConnection: close\r\n\r\nGET /one HTTP/1.1
//> GET /two HTTP/1.1\r\n\r\n -> HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 17\r\nConnection: close\r\n\r\nGET /two HTTP/1.1
//> first of two at once: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 19\r\nConnection: close\r\n\r\nGET /first HTTP/1.1
//> second of two at once: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 20\r\nConnection: close\r\n\r\nGET /second HTTP/1.1
//> stopped
//> a connection after the stop: refused
function shown(text String) returns String
	return text.replace("\r\n", with: "\\r\\n")
end 'shown'

// readToEnd reads what the server sends until it closes the connection.
function readToEnd(mutates client TcpClient) returns String
	var all = ByteArray.create(0)
	while true 'reading'
		let chunk = try client.readSome(4096) otherwise return "{shown(String.from(all))} [the read failed]"
		if chunk.isEmpty() 'closed'
			break 'reading'
		end 'closed'
		all.append(chunk)
	end 'reading'
	return shown(String.from(all))
end 'readToEnd'

function answerTo(port NetworkPort, request String) returns String
	var client = try TcpClient.connect("127.0.0.1", port: port) otherwise return "no connection"
	try client.setReadDeadline(5000) otherwise ignore
	_ = try client.send(request) otherwise 0
	let answer = readToEnd(client)
	try client.close() otherwise ignore
	return answer
end 'answerTo'

function main() returns ExitCode
	let server = try HttpServer.bind("127.0.0.1", port: 0) otherwise panic("a server on the loopback")
	let port = server.port()
	let serving = server.serve(ServerConfig.create())
	for request in ["GET /one HTTP/1.1\r\nHost: a\r\n\r\n", "GET /two HTTP/1.1\r\n\r\n"] 'each'
		print("{shown(request)} -> {answerTo(port, request: request)}\n")
	end 'each'
	var first = try TcpClient.connect("127.0.0.1", port: port) otherwise panic("a connection to the server")
	var second = try TcpClient.connect("127.0.0.1", port: port) otherwise panic("a connection to the server")
	try first.setReadDeadline(5000) otherwise ignore
	try second.setReadDeadline(5000) otherwise ignore
	_ = try second.send("GET /second HTTP/1.1\r\n\r\n") otherwise 0
	_ = try first.send("GET /first HTTP/1.1\r\n\r\n") otherwise 0
	print("first of two at once: {readToEnd(first)}\n")
	print("second of two at once: {readToEnd(second)}\n")
	try first.close() otherwise ignore
	try second.close() otherwise ignore
	serving.stop(1000)
	print("stopped\n")
	var late = try TcpClient.connect("127.0.0.1", port: port) otherwise 'refused'
		print("a connection after the stop: refused\n")
		return 0
	end 'refused'
	try late.close() otherwise ignore
	print("a connection after the stop: accepted\n")
	return 1
end 'main'
