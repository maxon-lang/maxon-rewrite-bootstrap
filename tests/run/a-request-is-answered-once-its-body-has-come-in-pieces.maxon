// A request's body is read up to its Content-Length however it comes: here in three pieces apart, the head's own read taking
// the first. The request is answered once the last byte of the body has come, and not before (RFC 9112 §6.2).
// native-only
//> before the last piece: nothing yet
//> answered: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 31\r\nConnection: close\r\n\r\nPOST /up HTTP/1.1 with 12 bytes
//> stopped
function shown(text String) returns String
	return text.replace("\r\n", with: "\\r\\n")
end 'shown'

// readToEnd reads what the server sends until it closes the connection.
function readToEnd(mutates client TcpClient) returns String
	var all = ByteArray.create(0)
	while true 'reading'
		let chunk = try client.readSome(4096) otherwise return "{shown(String.from(all))} [the read failed]"
		if chunk.isEmpty() 'closed'
			break 'reading'
		end 'closed'
		all.append(chunk)
	end 'reading'
	return shown(String.from(all))
end 'readToEnd'

function answerTo(port NetworkPort, request String) returns String
	var client = try TcpClient.connect("127.0.0.1", port: port) otherwise return "no connection"
	try client.setReadDeadline(5000) otherwise ignore
	_ = try client.send(request) otherwise 0
	let answer = readToEnd(client)
	try client.close() otherwise ignore
	return answer
end 'answerTo'

// Echo answers each request with its request line, and with how many bytes its body had where it had one.
type Echo implements HttpHandler
	static function create() returns Self
		return Self{}
	end 'create'

	function handle(consumes exchange HttpExchange) returns HttpAnswered
		let line = "{methodName(exchange.request.method)} {exchange.request.target()} HTTP/1.{exchange.request.minorVersion}"
		let count = exchange.requestBody.count()
		return exchange.respondWith(StatusCode.ok, body: "{line} with {count} bytes" if count > 0 else line, contentType: "text/plain")
	end 'handle'
end 'Echo'

function methodName(method HttpMethod) returns String
	return match method 'method'
		get gives "GET"
		post gives "POST"
		put gives "PUT"
		delete gives "DELETE"
		head gives "HEAD"
		patch gives "PATCH"
		options gives "OPTIONS"
	end 'method'
end 'methodName'

function main() returns ExitCode
	let server = try HttpServer.bind("127.0.0.1", port: 0) otherwise panic("a server on the loopback")
	let port = server.port()
	let serving = server.serve(freeze(Echo.create()), config: ServerConfig.create())
	var client = try TcpClient.connect("127.0.0.1", port: port) otherwise panic("a connection to the server")
	_ = try client.send("POST /up HTTP/1.1\r\nHost: a\r\nConnection: close\r\nContent-Length: 12\r\n\r\nfour") otherwise 0
	sleep(20)
	_ = try client.send("four") otherwise 0
	try client.setReadDeadline(100) otherwise ignore
	let early = try client.readSome(4096) otherwise ByteArray.create(0)
	print("before the last piece: {"nothing yet" if early.isEmpty() else shown(String.from(early))}\n")
	try client.setReadDeadline(5000) otherwise ignore
	_ = try client.send("four") otherwise 0
	print("answered: {readToEnd(client)}\n")
	try client.close() otherwise ignore
	serving.stop(1000)
	print("stopped\n")
	return 0
end 'main'
