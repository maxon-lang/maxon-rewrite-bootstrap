typealias TreeArray = array with Tree

type Tree
	var value as Count
	var kids = TreeArray.new()

	static function make(value Count) returns Tree
		return Tree{value: value}
	end 'make'

	function sum() returns Count throws ArithmeticError
		var total = value
		for i in 0 upto kids.count() 'each'
			total = try total + kids[i].sum()
		end 'each'
		return total
	end 'sum'

	function add(mutates self, consumes kid Tree)
		kids.append(kid)
	end 'add'

	function depth() returns Count throws ArithmeticError
		var deepest = 0 as Count
		for i in 0 upto kids.count() 'each'
			let d = try kids[i].depth()
			if d > deepest 'deeper'
				deepest = d
			end 'deeper'
		end 'each'
		return try deepest + 1
	end 'depth'
end 'Tree'

function main() returns ExitCode
	var root = Tree.make(1)
	var left = Tree.make(2)
	left.add(Tree.make(4))
	left.add(Tree.make(5))
	root.add(left)
	root.add(Tree.make(3))
	try 'report'
		print("{root.sum()} {root.depth()} {root.kids[0].kids.count()}\n")
		root.kids[0].kids[1].value = 50
		root.kids[1].add(Tree.make(7))
		print("{root.sum()} {root.depth()}\n")
	end 'report' otherwise 'failed'
		return 1
	end 'failed'
	return 0
end 'main'

//> 15 3 2
//> 67 3
