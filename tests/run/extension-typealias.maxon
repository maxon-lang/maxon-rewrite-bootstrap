typealias Count32 = int(0 to 1000)

typealias Counts = Array with Count32

type Holder
	typealias Mark = int(0 to 9)
	var v as Count32

	static function make(v Count32) returns Self
		return Self{v: v}
	end 'make'
end 'Holder'

extension Holder
	typealias Idx = int(0 to 100)
	typealias Bag = Array with Idx
	typealias Step = function(Idx) returns Idx

	function first(i Idx) returns Idx
		var bag = Bag.create(0)
		bag.push(i)
		return bag[0]
	end 'first'

	function marked(m Mark) returns Mark
		return m
	end 'marked'

	function apply(step Step, at Idx) returns Idx
		return step(at)
	end 'apply'
end 'Holder'

extension Holder
	function second(i Idx) returns Idx
		return i
	end 'second'
end 'Holder'

extension Array
	typealias Sizes = Array with Count32

	function sizeOf(other Sizes) returns Count32
		return try other.count() as Count32 otherwise 0
	end 'sizeOf'
end 'Array'

function same(i Holder.Idx) returns Holder.Idx
	return i
end 'same'

function main() returns ExitCode
	let h = Holder.make(7)
	let a = h.first(5 as Holder.Idx)
	let b = h.second(a)
	print("{b}\n")
	let c = same(b)
	print("{c}\n")
	let step = function(i Holder.Idx) gives i
	print("{h.apply(step, at: c)}\n")
	let sizes = Counts from [1, 2, 3]
	print("{sizes.sizeOf(sizes.clone())}\n")
	return 0
end 'main'

//> 5
//> 5
//> 5
//> 3
