// FileInfo.create makes the record that File.info gives, from maxon's types: the size is a FileSize and the three times are
// Timestamps (Unix seconds), whose range is the unsigned 64-bit word as Count's is. The fields have those types (sizeOf and
// modifiedOf return them as they are, and File.info gives a FileInfo), and a record made by create reads back as it was made.
// It touches no file, so it runs the same on every target and under the interpreter.
//> made=10 20 30 40 false true
//> largest=18446744073709551615 18446744073709551615
//> sizeOf=10
//> modifiedOf=20
//> again=10 false
function sizeOf(info FileInfo) returns FileSize
	return info.size
end 'sizeOf'

function modifiedOf(info FileInfo) returns Timestamp
	return info.modifiedTime
end 'modifiedOf'

function infoOf(path FilePath) returns FileInfo throws FileInfoError
	return try File.info(path)
end 'infoOf'

function main() returns ExitCode
	let made = FileInfo.create(10, modifiedTime: 20, createdTime: 30, accessedTime: 40, isDirectory: false, isReadOnly: true)
	print("made={made.size} {made.modifiedTime} {made.createdTime} {made.accessedTime} {made.isDirectory} {made.isReadOnly}\n")
	let most = FileInfo.create(18446744073709551615, modifiedTime: 18446744073709551615, createdTime: 0, accessedTime: 0, isDirectory: true, isReadOnly: false)
	print("largest={most.size} {most.modifiedTime}\n")
	print("sizeOf={sizeOf(made)}\n")
	print("modifiedOf={modifiedOf(made)}\n")
	let again = FileInfo.create(made.size, modifiedTime: made.modifiedTime, createdTime: made.createdTime, accessedTime: made.accessedTime, isDirectory: made.isDirectory, isReadOnly: not made.isReadOnly)
	print("again={again.size} {again.isReadOnly}\n")
	return 0
end 'main'
