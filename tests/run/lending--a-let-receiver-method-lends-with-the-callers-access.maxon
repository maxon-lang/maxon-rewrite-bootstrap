// A lending method lends with the access its caller has to the receiver: a method with a let receiver whose every lent
// place lies in self lends it to be changed where the receiver may change (a var, a mutates parameter) and to be read
// where it may only be read (a let, a let parameter, a let receiver of the caller), and two such reads may be live at once.
typealias Integer = int(i64.min to i64.max)

type Cell
	export var n as Integer
	export var name as String

	static function make(n Integer, consumes name String) returns Cell
		return Cell{n: n, name: name}
	end 'make'
end 'Cell'

type Pair
	var left as Cell
	var right as Cell

	static function make() returns Pair
		return Pair{left: Cell.make(1, name: "l"), right: Cell.make(2, name: "r")}
	end 'make'

	function first() returns borrowed Cell
		return left
	end 'first'

	function second() returns borrowed Cell
		return self.right
	end 'second'

	function count() returns borrowed Integer
		return left.n
	end 'count'

	function total() returns Integer
		return try self.first().n + self.second().n otherwise 0
	end 'total'
end 'Pair'

type Holder
	var pair as Pair

	static function make() returns Holder
		return Holder{pair: Pair.make()}
	end 'make'

	function inner() returns borrowed Pair
		return pair
	end 'inner'
end 'Holder'

function bump(mutates n Integer)
	n = try n + 1 otherwise n
end 'bump'

function rename(mutates c Cell, consumes to String)
	c.name = to
end 'rename'

function readOnly(p Pair) returns Integer
	return try p.first().n + p.count() otherwise 0
end 'readOnly'

function change(mutates p Pair)
	p.first().n = 40
end 'change'

function both(a Cell, b Cell) returns String
	return "{a.name}{b.name}"
end 'both'

function main() returns ExitCode
	var p = Pair.make()
	p.first().n = 10
	bump(p.count())
	rename(p.second(), to: "renamed")
	print("{p.first().n} {p.second().name} {p.total()}\n")
	let q = p.clone()
	print("{readOnly(q)} {q.first().name} {both(q.first(), b: q.second())}\n")
	change(p)
	var h = Holder.make()
	h.inner().first().n = 7
	print("{p.first().n} {q.first().n} {h.inner().first().n} {h.inner().total()}\n")
	return 0
end 'main'

//> 11 renamed 13
//> 22 l lrenamed
//> 40 11 7 9
