// A child started in a directory of its own (Subprocess.runInDirectory): the host's program that prints where it runs,
// cmd.exe's cd on Windows and pwd elsewhere, prints for ".." the directory above the runner's, and a directory that is not
// there fails the spawn.
// unsupported-targets: arm64-macos
// native-only
//> above=true
//> missing=spawnFailed

typealias Arguments = Array with String

// The host's program that prints the directory it runs in, its arguments, and the end of the line it prints.
#if os(Windows)
	let whereProgram = "cmd.exe"

	let lineEnd = "\r\n"

	function whereArguments() returns Arguments
		var args = Arguments.create(0)
		args.push("/c")
		args.push("cd")
		return args
	end 'whereArguments'
#else
	let whereProgram = "pwd"

	let lineEnd = "\n"

	function whereArguments() returns Arguments
		return Arguments.create(0)
	end 'whereArguments'
#endif

// whereRuns is what the program prints in directory, or in the program's own working directory for "".
function whereRuns(directory String) returns String throws SubprocessError
	if directory == "" 'own'
		let out = try Subprocess.run(Executable.name(whereProgram), arguments: whereArguments())
		return out.stdout.clone()
	end 'own'
	let at = try FilePath.from(directory) otherwise panic("not a path")
	let out = try Subprocess.runInDirectory(Executable.name(whereProgram), arguments: whereArguments(), directory: at, deadline: WaitDeadline.none)
	return out.stdout.clone()
end 'whereRuns'

function main() returns ExitCode
	let own = try whereRuns("") otherwise return 1
	let above = try whereRuns("..") otherwise return 2
	// The line ends as no other line follows the directory above.
	let line = try above.byteLength() - lineEnd.byteLength() otherwise 0
	print("above={own.startsWith(above.sliceBytes(0, endPos: line)) and above != own}\n")
	try 'missing'
		_ = whereRuns("a-directory-that-is-not-there")
		print("missing=ran\n")
	end 'missing' otherwise (e) 'failed'
		match e 'kind'
			spawnFailed then print("missing=spawnFailed\n")
			executableNotFound or
			busy or
			ioFailed or
			timeout or
			treeNotEnded or
			detachRefused or
			inputTooLarge or
			statusLost then print("missing=another failure\n")
		end 'kind'
	end 'failed'
	return 0
end 'main'
