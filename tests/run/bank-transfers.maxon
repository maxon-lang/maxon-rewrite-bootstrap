// Accounts whose balances must add up are one service: a transfer is one message, which changes both balances before any
// other message runs, so no message ever sees money that has left one account and not reached the other.
type Bank
	var a as Count
	var b as Count
	var c as Count

	static function open(a Count, b Count, c Count) returns Self
		return Self{a: a, b: b, c: c}
	end 'open'

	function balance(which Count) returns Count
		if which == 0 'first'
			return self.a
		end 'first'
		if which == 1 'second'
			return self.b
		end 'second'
		return self.c
	end 'balance'

	function setBalance(mutates self, which Count, value Count)
		if which == 0 'first'
			self.a = value
		end 'first' else if which == 1 'second'
			self.b = value
		end 'second' else 'third'
			self.c = value
		end 'third'
	end 'setBalance'

	export function transfer(mutates self, from Count, dest Count, amount Count)
		let have = self.balance(from)
		if have >= amount 'enough'
			let credited = try self.balance(dest) + amount otherwise return
			self.setBalance(from, value: have - amount)
			self.setBalance(dest, value: credited)
		end 'enough'
	end 'transfer'

	export function report() returns String
		let total = try self.a + self.b + self.c otherwise 0
		return "a {self.a} b {self.b} c {self.c} total {total}"
	end 'report'
end 'Bank'

function main() returns ExitCode
	let bank = spawn Bank.open(100, b: 50, c: 0)
	try bank.transfer(0, dest: 1, amount: 30) otherwise ignore
	try bank.transfer(1, dest: 2, amount: 70) otherwise ignore
	try bank.transfer(2, dest: 0, amount: 500) otherwise ignore
	try bank.transfer(0, dest: 2, amount: 20) otherwise ignore
	try bank.transfer(1, dest: 0, amount: 5) otherwise ignore
	print("{try await bank.report() otherwise "stopped"}\n")
	return 0
end 'main'

//> a 55 b 5 c 90 total 150
