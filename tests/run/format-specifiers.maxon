typealias Wide = bits(64)

enum Code
	ok = 0
	notFound = 404
end 'Code'

function show(u Wide)
	print("[{u}] [{u:d}] [{u:25}] [{u:x}]\n")
end 'show'

function main() returns ExitCode
	let n = 42
	print("{n:04} {n:6} {n:x} {n:04X} {-42:06} {255:08b}\n")
	let f = 3.14159
	print("{f:.2} {f:.4} {f:8.2} {-3.14:08} {2.5:.0} {0.125:.2} {0.375:.2} {10000000000000000000000.0:.2}\n")
	let neg = -12345
	print("[{neg:070}]\n")
	let low = i64.min
	print("[{low:d}] [{low:25}] [{low:025}] [{low:x}] [{low:o}] [{low:b}]\n")
	show(u64.max)
	let code = Code.notFound
	print("[{code}] [{code:08}] [{code:x}] [{code:6}]\n")
	let s = "say \"hi\"\n\{x\}"
	print("{s:q} [{s:30q}] [{s:z}] [{n:q}]\n")
	print("[{9.999:.2}] [{0.0:.3}] [{-0.001:.2}] [{99.995:.2}] [{f:12.3}] [{f:012.3}] [{f:10}]\n")
	return 0
end 'main'

