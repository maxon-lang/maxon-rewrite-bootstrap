//> empty=7
//> filled=10
//> w0
//> w1
//> rest w2
//> rest w3
//> w0
//> w1
//> w2
//> w3
//> box x
//> box y

typealias Names = Array with String

typealias Integer = int(i64.min to i64.max)

typealias IntArray = Array with Integer

type IntCursor
	var items as IntArray
	var pos as Count

	static function create(items IntArray) returns Self throws IterationError
		if items.count() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Self{items: items.clone(), pos: 0}
	end 'create'

	function current() returns Integer
		return self.items[self.pos]
	end 'current'

	function advance(mutates self) throws IterationError
		let next = try self.pos + 1 otherwise panic("overflow")
		if next >= self.items.count() 'atEnd'
			throw IterationError.exhausted
		end 'atEnd'
		self.pos = next
	end 'advance'
end 'IntCursor'

type IntSeq
	var items as IntArray

	static function create(items IntArray) returns Self
		return Self{items: items.clone()}
	end 'create'

	function createIterator() returns IntCursor throws IterationError
		return try IntCursor.create(self.items)
	end 'createIterator'
end 'IntSeq'

type Words
	var n as Count

	function current() returns String
		return "w{self.n}"
	end 'current'

	function advance(mutates self) throws IterationError
		if self.n >= 3 'done'
			throw IterationError.exhausted
		end 'done'
		self.n = self.n + 1
	end 'advance'

	static function make() returns Words
		return Words{n: 0}
	end 'make'
end 'Words'

type Box uses T where T implements Copyable
	var items as Array with T

	static function make(consumes items Array with T) returns Self
		return Self{items: items}
	end 'make'

	function createIterator() returns BoxCursor with T throws IterationError
		if self.items.count() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return BoxCursor.make(self.items.clone())
	end 'createIterator'
end 'Box'

type BoxCursor uses T where T implements Copyable
	var items as Array with T
	var at as Count

	static function make(consumes items Array with T) returns Self
		return Self{items: items, at: 0}
	end 'make'

	function current() returns T
		return self.items[self.at].clone()
	end 'current'

	function advance(mutates self) throws IterationError
		let next = try self.at + 1 otherwise panic("overflow")
		if next >= self.items.count() 'end'
			throw IterationError.exhausted
		end 'end'
		self.at = next
	end 'advance'
end 'BoxCursor'

function total(s IntSeq) returns Integer
	var sum = 7 as Integer
	for v in s 'each'
		sum = try sum + v otherwise panic("overflow")
	end 'each'
	return sum
end 'total'

function main() returns ExitCode
	let a = IntArray.create(0)
	print("empty={total(IntSeq.create(a))}\n")
	var b = IntArray.create(0)
	b.push(1)
	b.push(2)
	print("filled={total(IntSeq.create(b))}\n")
	var w = Words.make()
	for word in w 'words'
		if word == "w2" 'stop'
			break 'words'
		end 'stop'
		print("{word}\n")
	end 'words'
	for word in w 'rest'
		print("rest {word}\n")
	end 'rest'
	for word in Words.make() 'again'
		let kept = word
		print("{kept}\n")
	end 'again'
	var names = Names.create(0)
	names.push("x")
	names.push("y")
	let box = Box.make(names.clone())
	for n in box 'box'
		print("box {n}\n")
	end 'box'
	return 0
end 'main'
