typealias Integer = int(i64.min to i64.max)

interface Seq
	function current() returns Integer
	function advance(mutates self) throws IterationError
end 'Seq'

interface Lines
	function createIterator() returns Numbered throws IterationError
end 'Lines'

type Upto implements Seq
	var pos as Integer
	let limit as Integer

	static function create(limit Integer) returns Self
		return Self{pos: 1, limit: limit}
	end 'create'

	function current() returns Integer
		return self.pos
	end 'current'

	function advance(mutates self) throws IterationError
		if self.pos >= self.limit 'atTheLast'
			throw IterationError.exhausted
		end 'atTheLast'
		self.pos = try self.pos + 1 otherwise panic("overflow")
	end 'advance'
end 'Upto'

type Numbered
	var pos as Integer
	let limit as Integer

	static function create(limit Integer) returns Self
		return Self{pos: 1, limit: limit}
	end 'create'

	function current() returns String
		return "line {self.pos}"
	end 'current'

	function advance(mutates self) throws IterationError
		if self.pos >= self.limit 'atTheLast'
			throw IterationError.exhausted
		end 'atTheLast'
		self.pos = try self.pos + 1 otherwise panic("overflow")
	end 'advance'
end 'Numbered'

type Page implements Lines
	let lines as Integer

	static function create(lines Integer) returns Self
		return Self{lines: lines}
	end 'create'

	function createIterator() returns Numbered throws IterationError
		if self.lines == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Numbered.create(self.lines)
	end 'createIterator'
end 'Page'

// total walks the interface value itself, moved on in place through the table it carries.
function total(mutates source Seq) returns Integer
	var sum = 0 as Integer
	for item in source 'walk'
		sum = try sum + item otherwise panic("overflow")
	end 'walk'
	return sum
end 'total'

// show walks the cursor that the interface value's createIterator() makes.
function show(source Lines)
	for text in source 'walk'
		print("{text};")
	end 'walk'
	print("end\n")
end 'show'

function main() returns ExitCode
	var s = Upto.create(4) as Seq
	print("{total(s)}\n")
	show(Page.create(3))
	show(Page.create(0))
	return 0
end 'main'

//> 10
//> line 1;line 2;line 3;end
//> end
