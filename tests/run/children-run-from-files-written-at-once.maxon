// Children started at the same time each from a file written just before run, however their writes and starts interleave:
// a child that another run starts while a file is open for writing must not hold the file open past its own start, which
// would make the start of the file's run fail as busy (ETXTBSY on Linux). Each service writes and runs its own files one
// after another in one message, and the services' messages run at once, so that with more than one worker the writes of
// some overlap the starts of others.
// unsupported-targets: x64-windows
// native-only
typealias Arguments = Array with String

// How many services write and run files at once, and how many files each writes and runs.
let writers = 8

let rounds = 40

// A script that exits with exitCode, padded with a comment so that each write takes a while.
let exitCode = 7

let paddingLines = 512

function scriptText() returns String
	var text = "#!/bin/sh\nexit {exitCode}\n".toByteArray()
	for i in 0 upto paddingLines 'padding'
		text.append("# the run of a file written just before must not find the file busy: line {i}\n".toByteArray())
	end 'padding'
	return String.from(text)
end 'scriptText'

typealias Writers = Array with Writer.handle

// A Writer writes and runs files and counts the runs that did not end as the file says, keeping how the first one ended.
service Writer
	var failures as Count
	var first as String

	static function create() returns Self
		return Self{failures: 0, first: ""}
	end 'create'

	export function writeAndRun(mutates self, label Count, dir String)
		let script = scriptText()
		for round in 0 upto rounds 'rounds'
			let name = "{dir}/child-{label}-{round}"
			let file = path(name)
			try File.writeText(file, content: script, mode: FilePermission.executable) otherwise panic("cannot write {name}")
			let ended = outcome(file)
			if ended != "ran {exitCode}" 'failed'
				if self.failures == 0 'first'
					self.first = ended.clone()
				end 'first'
				self.failures = try self.failures + 1 otherwise panic("too many failures")
			end 'failed'
			try File.delete(file) otherwise panic("cannot delete {name}")
		end 'rounds'
	end 'writeAndRun'

	export function failures() returns Count
		return self.failures
	end 'failures'

	export function first() returns String
		return self.first.clone()
	end 'first'
end 'Writer'

function path(text String) returns FilePath
	return try FilePath.from(text) otherwise panic("not a path: {text}")
end 'path'

// outcome runs the file and says how the run ended.
function outcome(file FilePath) returns String
	try 'run'
		let out = Subprocess.run(Executable.path(file.clone()), arguments: Arguments.create(0))
		return "ran {out.exitCode()}"
	end 'run' otherwise (e) 'failed'
		match e 'kind'
			executableNotFound then return "executableNotFound"
			spawnFailed then return "spawnFailed"
			busy then return "busy"
			ioFailed then return "ioFailed"
			timeout then return "timeout"
			treeNotEnded then return "treeNotEnded"
			detachRefused then return "detachRefused"
			inputTooLarge then return "inputTooLarge"
			statusLost then return "statusLost"
		end 'kind'
	end 'failed'
	return "unreachable"
end 'outcome'

// earlier is the first of two failures that is one, or "" when neither is.
function earlier(first String, later String) returns String
	if first != "" 'first'
		return first.clone()
	end 'first'
	return later.clone()
end 'earlier'

function main() returns ExitCode
	let dir = "/tmp/minimaxon_children_from_written_files_{Process.id()}"
	_ = Directory.create(path(dir))
	var pool = Writers.create(0)
	for _ in 0 upto writers 'spawn'
		pool.push(spawn Writer.create())
	end 'spawn'
	var label = 0 as Count
	for w in pool 'send'
		try w.writeAndRun(label, dir: dir.clone()) otherwise panic("the service runs")
		label = try label + 1 otherwise panic("too many writers")
	end 'send'
	var failures = 0 as Count
	var first = ""
	for w in pool 'report'
		failures = try failures + (try await w.failures() otherwise panic("the service runs")) otherwise panic("too many failures")
		first = earlier(first, later: try await w.first() otherwise panic("the service runs"))
	end 'report'
	if failures == 0 'clean'
		print("every run ran\n")
	end 'clean' else 'failed'
		print("{failures} of {writers * rounds} runs failed, the first: {first}\n")
	end 'failed'
	try Directory.delete(path(dir)) otherwise panic("cannot remove the directory")
	return 0
end 'main'

//> every run ran
