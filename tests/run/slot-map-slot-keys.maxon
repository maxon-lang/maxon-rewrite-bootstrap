typealias CellPool = SlotMap with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function bump(mutates c Cell)
	c.n = try c.n + 1 otherwise c.n
end 'bump'

function main() returns ExitCode
	var p = CellPool.create()
	let a = p.insert(Cell.make(1))
	let b = p.insert(Cell.make(2))
	print("{p.count()} {p.contains(a)} {p.contains(b)} {a == b}\n")
	p[a].n = 10
	bump(p[b])
	print("{p[a].n} {p[b].n}\n")
	let gone = try p.remove(a) otherwise panic("the slot key names no element")
	print("{gone.n} {p.contains(a)} {p.count()}\n")
	let c = p.insert(Cell.make(3))
	print("{p.contains(a)} {p.contains(c)} {a == c} {p[c].n} {p.count()}\n")
	let again = try p.remove(a) otherwise Cell.make(0)
	print("{again.n} {p.count()}\n")
	let first = try p.remove(b) otherwise panic("the slot key names no element")
	let second = try p.remove(c) otherwise panic("the slot key names no element")
	print("{first.n} {second.n} {p.isEmpty()}\n")
	let late = p.insert(Cell.make(4))
	print("{p.contains(b)} {p.contains(c)} {p.contains(late)} {p[late].n}\n")
	let copied = p.clone()
	p[late].n = 5
	print("{p[late].n} {copied[late].n} {copied.contains(late)}\n")
	return 0
end 'main'

//> 2 true true false
//> 10 3
//> 10 false 1
//> false true false 3 2
//> 0 2
//> 3 3 true
//> false false true 4
//> 5 4 true
