// An interface that requires service holds each method that meets one of its requirements to the rules of a message of a
// service that a source outside the program feeds: it waits on no other party, calls only what the check sees, and sends only
// kinds that name a policy (the `Log` that `Slow` sends to names `Keep`). A message may then call it through a value of the
// interface, which a router does for each of its routes. The types that implement the interface are no services, and a
// method that meets no requirement is held to nothing.
export typealias Amount = int(0 to 1000000)

interface Route extends Copyable requires service
	function handle(request Amount) returns Amount
end 'Route'

type Doubler implements Route
	static function make() returns Self
		return Self{}
	end 'make'

	function handle(request Amount) returns Amount
		return try request * 2 otherwise 0
	end 'handle'
end 'Doubler'

type Slow implements Route
	var rest as Amount
	var log as Log.handle

	static function make(rest Amount, consumes log Log.handle) returns Self
		return Self{rest: rest, log: log}
	end 'make'

	// pause may sleep, which a requirement's method may do, and is called by one.
	function pause()
		sleep(1)
	end 'pause'

	function handle(request Amount) returns Amount
		self.pause()
		try self.log.note(request) otherwise ignore
		return try request + self.rest otherwise 0
	end 'handle'

	// audit meets no requirement, so it may wait on a service's reply while no requirement's method calls it.
	function audit(counter Log.handle) returns Amount
		return try await counter.count() otherwise 0
	end 'audit'
end 'Slow'

// A route that calls the routes it holds, through the interface, as the router does.
type Chain implements Route
	var next as Route

	static function make(consumes next Route) returns Self
		return Self{next: next}
	end 'make'

	function handle(request Amount) returns Amount
		return self.next.handle(request)
	end 'handle'
end 'Chain'

// A generic route is judged where it is declared, where the methods of its type parameter are not seen: it may hold a value of
// the type and call none of its methods.
type Tagged uses T implements Route where T implements Copyable
	var tag as T

	static function make(consumes tag T) returns Self
		return Self{tag: tag}
	end 'make'

	function handle(request Amount) returns Amount
		return request
	end 'handle'
end 'Tagged'

service Log
	var seen as Amount

	static function create() returns Self
		return Self{seen: 0}
	end 'create'

	@policy(Keep) export function note(mutates self, request Amount)
		self.seen = try self.seen + request otherwise 0
	end 'note'

	export function count() returns Amount
		return self.seen
	end 'count'
end 'Log'

service Router
	var routes as Array with Route
	var served as Amount

	static function create() returns Self
		var routes as Array with Route
		routes = Array.create(0)
		routes.push(Doubler.make() as Route)
		routes.push(Slow.make(7, log: spawn Log.create()) as Route)
		routes.push(Chain.make(Doubler.make() as Route) as Route)
		routes.push(Tagged.make("x") as Route)
		return Self{routes: routes, served: 0}
	end 'create'

	export function route(mutates self, index Count, request Amount) returns Amount
		let found = try self.routes.get(index) otherwise return 0
		let answer = found.handle(request)
		self.served = try self.served + 1 otherwise 0
		return answer
	end 'route'

	export function served() returns Amount
		return self.served
	end 'served'
end 'Router'

function main() returns ExitCode
	let router = spawn Router.create()
	let first = try await router.route(0, request: 5) otherwise 0
	let second = try await router.route(1, request: 5) otherwise 0
	let third = try await router.route(2, request: 5) otherwise 0
	let fourth = try await router.route(3, request: 5) otherwise 0
	let none = try await router.route(9, request: 5) otherwise 0
	print("{first} {second} {third} {fourth} {none}\n")
	let served = try await router.served() otherwise 0
	print("{served}\n")
	router.shutdown()
	let log = spawn Log.create()
	try log.note(3) otherwise ignore
	print("{Slow.make(1, log: spawn Log.create()).audit(log)}\n")
	log.shutdown()
	return 0
end 'main'

//> 10 12 10 5 0
//> 4
//> 3
