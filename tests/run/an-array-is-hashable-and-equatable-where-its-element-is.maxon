// An array is Hashable and Equatable where its element is both, as maxon's conditional conformance makes it: equals and ==
// compare element by element through the element's equals, equal arrays hash alike, an array of bytes hashes as the fold of
// its bytes, and such an array is a Map key and a Set element.
typealias Real = float(f64.min to f64.max)

typealias Reals = Array with Real

typealias Number = int(i64.min to i64.max)

typealias Numbers = Array with Number

typealias Texts = Array with String

typealias Letters = Array with Character

typealias Rows = Array with ByteArray

typealias Named = Map with (ByteArray, String)

typealias Phrases = Set with Texts

function folded(bytes ByteArray) returns HashValue
	var hasher = Hasher.create()
	hasher.combineBytes(bytes)
	return hasher.finalize()
end 'folded'

function main() returns ExitCode
	print("{(Numbers from [1, -2]) == (Numbers from [1, -2])} {(Numbers from [1]) != (Numbers from [1, 1])} {(Texts from ["a", "b"]).equals(Texts from ["a", "b"])}\n")
	// -0.0 equals 0.0 by the element's equals, and the two hash alike.
	let signed = Reals from [1.5, -0.0]
	let unsigned = Reals from [1.5, 0.0]
	print("{signed == unsigned} {signed.hash() == unsigned.hash()} {signed == (Reals from [1.5, 1.0])}\n")
	print("{(Letters from ['é', 'a']) == (Letters from ['é', 'a'])} {(Letters from ['é']) == (Letters from ['e'])}\n")
	let rows = Rows from [ByteArray from [1, 2], ByteArray from [3]]
	print("{rows == (Rows from [ByteArray from [1, 2], ByteArray from [3]])} {rows.hash() == (Rows from [ByteArray from [1, 2], ByteArray from [3]]).hash()} {rows == (Rows from [ByteArray from [1], ByteArray from [2, 3]])}\n")
	let bytes = ByteArray from [104, 105, 33, 0, 255]
	print("{bytes.hash() == folded(bytes)} {(ByteArray from [104, 105, 33, 0, 255]).hash() == bytes.hash()}\n")
	var named = Named.create()
	named.upsert(ByteArray from [1, 2, 3], value: "one two three")
	named.upsert(ByteArray from [3, 2, 1], value: "three two one")
	print("{named.count()} {try named.get(ByteArray from [3, 2, 1]) otherwise "missing"} {named.contains(ByteArray from [1, 2])}\n")
	var phrases = Phrases.create()
	phrases.insert(Texts from ["to", "be"])
	phrases.insert(Texts from ["to", "be"])
	phrases.insert(Texts from ["not", "to", "be"])
	print("{phrases.count()} {phrases.contains(Texts from ["to", "be"])} {phrases.contains(Texts from ["be", "to"])}\n")
	return 0
end 'main'

//> true true true
//> true true false
//> true false
//> true true false
//> true true
//> 2 three two one false
//> 2 true false
