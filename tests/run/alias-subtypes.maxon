typealias BlockId = int(0 to u64.max) implements ElementIndex

typealias LoopHead = int(0 to u64.max) implements BlockId

typealias VarId = int(0 to u64.max) implements ElementIndex

typealias Row = int(0 to 1000)

typealias RowArray = Array with Row

typealias Wide = float(-100.0 to 100.0)

typealias Narrow = float(0.0 to 10.0) implements Wide

function takesBlock(b BlockId) returns BlockId
	return b
end 'takesBlock'

function widen(n Narrow) returns Wide
	return n
end 'widen'

function main() returns ExitCode
	var rows = RowArray.create(0)
	rows.push(4)
	rows.push(9)
	let head = 1 as LoopHead
	let r = rows.get(head)
	let other = 3 as VarId
	let joined = head if r > 5 else (2 as BlockId)
	let hi = rows.count() as ElementIndex
	print("{r} {takesBlock(head)} {other} {joined} {hi} {widen(2.5)}\n")
	return 0
end 'main'

//> 9 1 3 1 2 2.5
