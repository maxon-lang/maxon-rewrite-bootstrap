// The behaviour that a stop of a service whose state can hold a Reply queues to drop the state waits in the service's queue
// among its messages, so a shedding policy's view of the queued messages walks to it: it holds the mark of no policy, as a
// message of a kind no shedding policy names does, and is never in a view.
// schedules: 6
//> parked failed: true, watched
export typealias Count = int(0 to 1000)

export typealias Parked = Array with Reply with Count

service Sampler
	var seen as Count
	var parked as Parked

	static function create() returns Self
		return Self{seen: 0, parked: Parked.create(0)}
	end 'create'

	@policy(DropOldest) export function sample(mutates self, value Count)
		self.seen = value
	end 'sample'

	// busy holds the service while main queues the samples and the stop behind it.
	export function busy(mutates self, rounds Count)
		var n = 0 as Count
		while n < rounds 'spin'
			self.seen = n
			n = n + 1
		end 'spin'
	end 'busy'

	export function wait(mutates self) returns Count throws ReplyStopped
		let pending = reply.later()
		self.parked.push(pending)
		return
	end 'wait'
end 'Sampler'

// stopped is what main takes for the reply of the parked message, which the drop of the state fails.
let stopped = 999 as Count

function main() returns ExitCode
	let sampler = spawn Sampler.create()
	try sampler.busy(1000) otherwise panic("send")
	let parked = try sampler.wait() otherwise panic("send")
	for i in 0 upto 8 'samples'
		try sampler.sample(i) otherwise ignore
	end 'samples'
	let watch = sampler.stopped()
	sampler.shutdown()
	let failed = (try await parked otherwise stopped) == stopped
	await watch
	print("parked failed: {failed}, watched\n")
	return 0
end 'main'
