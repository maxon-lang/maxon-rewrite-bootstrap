// A loop whose values are one over the general-purpose pool, around an element read whose index a check before it
// proved in range, compiles: its fallback reads the element through the entry's call, and the values that cross that
// call are in memory across it.
typealias Word = int(i64.min to i64.max)

typealias WordArray = Array with Word

function viaArray(a WordArray, n Word) returns Word
	var a0 = 1 as Word
	var a1 = 2 as Word
	var a2 = 3 as Word
	var a3 = 4 as Word
	var a4 = 5 as Word
	var a5 = 6 as Word
	var a6 = 7 as Word
	var a7 = 8 as Word
	var a8 = 9 as Word
	var a9 = 10 as Word
	var t = 0 as Word
	for i in 0 upto n 'each'
		a0 = try a0 + i otherwise panic("out of range")
		a1 = a1 xor a0
		a2 = try a2 + a1 otherwise panic("out of range")
		a3 = a3 xor a2
		a4 = try a4 + a3 otherwise panic("out of range")
		a5 = a5 xor a4
		a6 = try a6 + a5 otherwise panic("out of range")
		a7 = a7 xor a6
		a8 = try a8 + a7 otherwise panic("out of range")
		a9 = a9 xor a8
		let e = try a.get(i as ElementIndex) otherwise 99
		t = try t + e + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 otherwise panic("out of range")
	end 'each'
	return t
end 'viaArray'

function reference(n Word) returns Word
	var a0 = 1 as Word
	var a1 = 2 as Word
	var a2 = 3 as Word
	var a3 = 4 as Word
	var a4 = 5 as Word
	var a5 = 6 as Word
	var a6 = 7 as Word
	var a7 = 8 as Word
	var a8 = 9 as Word
	var a9 = 10 as Word
	var t = 0 as Word
	for i in 0 upto n 'each'
		a0 = try a0 + i otherwise panic("out of range")
		a1 = a1 xor a0
		a2 = try a2 + a1 otherwise panic("out of range")
		a3 = a3 xor a2
		a4 = try a4 + a3 otherwise panic("out of range")
		a5 = a5 xor a4
		a6 = try a6 + a5 otherwise panic("out of range")
		a7 = a7 xor a6
		a8 = try a8 + a7 otherwise panic("out of range")
		a9 = a9 xor a8
		let e = i if i < 6 else 99
		t = try t + e + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 otherwise panic("out of range")
	end 'each'
	return t
end 'reference'

function main() returns ExitCode
	var a = WordArray.create(0)
	for i in 0 upto 6 'seed'
		a.push(i)
	end 'seed'
	return 0 if viaArray(a, n: 12) == reference(12) else 1
end 'main'
