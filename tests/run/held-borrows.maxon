typealias Names = Array with String

typealias Rows = Array with Row

type Row
	export var cells as Array with String

	static function make() returns Row
		return Row{cells: Names.create(0)}
	end 'make'
end 'Row'

type Person
	export var name as String

	static function make(consumes name String) returns Person
		return Person{name: name}
	end 'make'
end 'Person'

function wipe(mutates a Names) returns String
	_ = try a.remove(0) otherwise panic("index out of range")
	return "x"
end 'wipe'

function take(consumes p Person) returns String
	return "t"
end 'take'

function shrink(mutates rows Rows) returns Count
	_ = try rows.remove(0) otherwise panic("index out of range")
	return 0
end 'shrink'

function main() returns ExitCode
	var a = Names.create(0)
	a.push("n{1}")
	if a[0].clone() == wipe(a) 'copy'
		print("same\n")
	end 'copy'
	a.push("n{2}")
	a.push("n{3}")
	let w = wipe(a)
	if a[0] != w 'later'
		print("{a[0]} differs from {w}\n")
	end 'later'
	var p = Person.make("p{1}")
	let name = p.name.clone()
	print("{name}{take(p)}\n")
	var rows = Rows.create(0)
	rows.push(Row.make())
	rows[0].cells.push("c{1}")
	rows.push(Row.make())
	let i = shrink(rows)
	print("{rows.count()} {i}\n")
	return 0
end 'main'

//> n3 differs from x
//> p1t
//> 1 0
