type Doc
	export var title as String
	export var words as array[Count]

	static function make(consumes title String) returns Doc
		var words = array[Count].new()
		words.append(3)
		words.append(5)
		return Doc{title: title, words: words}
	end 'make'

	function total() returns Count
		var sum = 0 as Count
		for i in 0 upto words.count() 'each'
			sum = sum + words[i]
		end 'each'
		return sum
	end 'total'

	function grow(mutates self)
		words.append(1)
	end 'grow'
end 'Doc'

type Library
	export var first as frozen[Doc]
	export var name as String

	static function make(consumes first frozen[Doc], consumes name String) returns Library
		return Library{first: first, name: name}
	end 'make'
end 'Library'

function describe(d Doc) returns String
	return "{d.title}: {d.total()}"
end 'describe'

function main() returns ExitCode
	let doc = freeze(Doc.make("notes"))
	print("{doc.title} {doc.total()} {doc.words[1]} {doc.words.count()}\n")
	print("{describe(doc)}\n")
	let again = share(doc)
	print("{again.title}\n")
	var mine = thaw(doc)
	mine.grow()
	mine.title = "mine"
	print("{mine.title} {mine.total()} {doc.total()}\n")
	var parts = doc.words.copy()
	parts.append(2)
	var name = doc.title.copy()
	name = "{name}!"
	print("{parts.count()} {doc.words.count()} {name} {doc.title}\n")
	let lib = freeze(Library.make(share(doc), name: "lib"))
	print("{lib.name} {lib.first.title} {lib.first.total()}\n")
	let copied = lib.copy()
	print("{copied.first.title}\n")
	match doc.title 'check'
		"notes" then print("matched\n")
		default then print("other\n")
	end 'check'
	return 0
end 'main'

//> notes 8 5 2
//> notes: 8
//> notes
//> mine 9 8
//> 3 2 notes! notes
//> lib notes 8
//> notes
//> matched
