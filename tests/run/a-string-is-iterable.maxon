// A String implements the library's Iterable, so code that knows it only through the protocol walks its grapheme
// clusters too: a type parameter bound by Iterable, an Iterable interface value, and its createIterator() called by hand,
// whose iterator borrows the String.
typealias Texts = Iterable with (String, StringIterator)

function lengths(source T) uses T where T implements Iterable with (String, StringIterator)
	for cluster in source 'each'
		print("{cluster.byteLength()};")
	end 'each'
	print("\n")
end 'lengths'

function show(source Texts)
	for cluster in source 'each'
		print("[{cluster}]")
	end 'each'
	print("\n")
end 'show'

function main() returns ExitCode
	lengths("añb\r\n")
	show("xy" as Texts)
	let pq = "pq"
	var cursor = try pq.createIterator() otherwise panic("the string is empty")
	print("{cursor.current()}")
	try cursor.advance() otherwise panic("one cluster is left")
	print("{cursor.current()}\n")
	let nothing = ""
	let empty = try nothing.createIterator() otherwise 'none'
		print("empty\n")
		return 0
	end 'none'
	print("{empty.current()}\n")
	return 1
end 'main'

//> 1;2;1;2;
//> [x][y]
//> pq
//> empty
