typealias Score = int(i64.min to i64.max)

typealias ScoreBox = Box with Score

typealias ScoreBoxBox = Box with (Box with Score)

typealias ScoreStringPair = Pair with Score, String

typealias StringBox = Box with String

type Box uses T where T implements Droppable
	var item as T

	static function make(consumes item T) returns Self
		return Self{item: item}
	end 'make'

	function peek() returns T where T implements Copyable
		return item.clone()
	end 'peek'

	function replace(mutates self, consumes next T)
		item = next
	end 'replace'
end 'Box'

type Pair uses A, B where B implements Copyable, A implements Copyable
	var first as A
	var second as B

	static function make(consumes first A, consumes second B) returns Self
		return Self{first: first, second: second}
	end 'make'

	function swapped() returns Pair with (B, A)
		return Pair.make(second.clone(), second: first.clone())
	end 'swapped'
end 'Pair'

union Option uses T where T implements Copyable
	some(value T)
	none

	function isSome() returns bool
		return match self 'm'
			some(v) gives true
			none gives false
		end 'm'
	end 'isSome'

	function orElse(fallback T) returns T
		return match self 'm'
			some(v) gives v.clone()
			none gives fallback.clone()
		end 'm'
	end 'orElse'
end 'Option'

function swap(mutates a T, mutates b T) uses T where T implements Copyable
	var tmp = a.clone()
	a = b.clone()
	b = tmp
end 'swap'

function twice(x T) uses T returns Pair with (T, T) where T implements Copyable
	return Pair.make(x.clone(), second: x.clone())
end 'twice'

function find(flag bool, x T) uses T returns Option with T where T implements Copyable
	if flag 'f'
		return Option.some(x.clone())
	end 'f'
	return Option.none
end 'find'

function main() returns ExitCode
	var a = 1 as Score
	var b = 2 as Score
	swap(a, b: b)
	print("{a} {b}\n")
	var p = StringBox.make("first")
	var q = StringBox.make("second")
	swap(p, b: q)
	print("{p.peek()} {q.peek()}\n")
	p.replace("third")
	print("{p.peek()} {q.peek()}\n")
	let pair = ScoreStringPair.make(7, second: "seven")
	let flipped = pair.swapped()
	print("{pair.first} {pair.second} {flipped.first} {flipped.second}\n")
	let both = twice(ScoreBox.make(4))
	print("{both.first.peek()} {both.second.peek()}\n")
	let nested = ScoreBoxBox.make(ScoreBox.make(9))
	var other = nested.clone()
	other.item.replace(1)
	print("{nested.peek().peek()} {other.peek().peek()}\n")
	let found = find(true, x: "yes")
	let missing = find(false, x: "no")
	print("{found.isSome()} {missing.isSome()} {found.orElse("else")} {missing.orElse("else")}\n")
	match found 'm'
		some(s) then print("got {s}\n")
		none then print("nothing\n")
	end 'm'
	return 0
end 'main'

//> 2 1
//> second first
//> third first
//> 7 seven seven 7
//> 4 4
//> 9 1
//> true false yes else
//> got yes
