// expect-exit: 1
typealias StringList = List with String

function main() returns ExitCode
	var l = StringList.create()
	let old = l.append("first")
	let gone = try l.remove(old) otherwise panic("the slot key names no element")
	print("removed {gone}\n")
	let fresh = l.append("second")
	print("reused {l[fresh]} {l.contains(old)}\n")
	print("{l[old]}\n")
	return 0
end 'main'

//> removed first
//> reused second false
