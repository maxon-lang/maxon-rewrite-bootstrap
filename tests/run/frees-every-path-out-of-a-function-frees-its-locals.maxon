function pick(n Count) returns Count
	let a = "a{1}"
	for i in 0 upto 5 'l'
		let b = "b{2}"
		if i == n 'hit'
			let c = "c{3}"
			return i
		end 'hit'
		if i == 1 'skip'
			continue
		end 'skip'
	end 'l'
	return 99
end 'pick'

function main() returns ExitCode
	_ = pick(2)
	return 0
end 'main'

