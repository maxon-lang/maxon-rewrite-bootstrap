typealias Score = int(i64.min to i64.max)

type Point
	export var x as Score
	export var y as Score

	function add(mutates self, amount Score) throws ArithmeticError
		x = try x + amount
	end 'add'

	static function create(x Score, y Score) returns Point
		return Point{x: x, y: y}
	end 'create'
end 'Point'

type Segment
	export var start as Point
	export var finish as Point

	static function create(consumes start Point, consumes finish Point) returns Segment
		return Segment{start: start, finish: finish}
	end 'create'
end 'Segment'

function bump(mutates n Score, by Score) throws ArithmeticError
	n = try n + by
end 'bump'

function swap(mutates a Score, mutates b Score)
	let t = a
	a = b
	b = t
end 'swap'

function main() returns ExitCode
	var p = Point.create(1, y: 2)
	swap(p.x, b: p.y)
	print("{p.x} {p.y}\n")
	var s = Segment.create(Point.create(1, y: 1), finish: Point.create(5, y: 5))
	swap(s.start.x, b: s.finish.x)
	try bump(s.start.y, by: s.finish.y.copy()) otherwise return 1
	print("{s.start.x} {s.start.y} {s.finish.x} {s.finish.y}\n")
	try s.start.add(s.finish.y) otherwise return 1
	print("{s.start.x}\n")
	try p.add(p.y.copy()) otherwise return 1
	print("{p.x}\n")
	return 0
end 'main'

//> 2 1
//> 5 6 1 5
//> 10
//> 3
