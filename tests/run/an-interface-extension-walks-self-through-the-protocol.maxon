// 'for item in self' in an extension of an interface walks each conformer through its iterator, which the interface's
// 'where' bounds: the loop is checked once and lowered for each instance.
typealias Score = int(0 to 1000)

interface Cursor uses Item
	function current() returns Item
	function advance(mutates self) throws IterationError
end 'Cursor'

interface Sequence uses Item, Walk where Walk implements Cursor with Item
	function createIterator() returns Walk throws IterationError
end 'Sequence'

extension Sequence
	function total() returns Count where Item implements Droppable, Walk implements Droppable
		var n = 0 as Count
		for _ in self 'each'
			n = try n + 1 otherwise panic("overflow")
		end 'each'
		return n
	end 'total'
end 'Sequence'

type Counter implements Cursor with Score
	var at as Score
	var last as Score

	static function from(at Score, last Score) returns Self
		return Self{at: at, last: last}
	end 'from'

	function current() returns Score
		return at
	end 'current'

	function advance(mutates self) throws IterationError
		if at >= last 'done'
			throw IterationError.exhausted
		end 'done'
		at = at + 1
	end 'advance'
end 'Counter'

type Upto implements Sequence with (Score, Counter)
	var n as Score

	static function of(n Score) returns Self
		return Self{n: n}
	end 'of'

	function createIterator() returns Counter throws IterationError
		if n == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Counter.from(0, last: n - 1)
	end 'createIterator'
end 'Upto'

function main() returns ExitCode
	print("{Upto.of(4).total()} {Upto.of(0).total()}\n")
	return 0
end 'main'

//> 4 0
