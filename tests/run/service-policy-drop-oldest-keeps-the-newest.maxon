// A message kind whose policy is DropOldest queues every message, and while its service is behind sheds the oldest queued
// messages of the kind until a turn of them is left, at the start of a message: a shed message is not handled and drops what
// it holds, so the newest is always handled. A message of another kind is never shed.
// schedules: 6
//> handled some: true, at most sent: true, newest handled: true
export typealias Amount = int(0 to 1000000)

type Feed
	var handled as Amount
	var newest as Amount

	static function create() returns Self
		return Self{handled: 0, newest: 0}
	end 'create'

	@policy(DropOldest) export function update(mutates self, n Amount, consumes label String)
		self.handled = try self.handled + 1 otherwise 0
		self.newest = n
	end 'update'

	export function report() returns Amount
		return self.handled
	end 'report'

	export function last() returns Amount
		return self.newest
	end 'last'
end 'Feed'

function main() returns ExitCode
	let f = spawn Feed.create()
	for i in 1 to 1000 'send'
		try f.update(i, label: "update {i}") otherwise ignore
	end 'send'
	let handled = try await f.report() otherwise 0
	let newest = try await f.last() otherwise 0
	print("handled some: {handled > 0}, at most sent: {handled <= 1000}, newest handled: {newest == 1000}\n")
	return 0
end 'main'
