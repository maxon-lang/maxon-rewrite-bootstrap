typealias CountOption = Option with Count

typealias NodeHandleOption = Option with (Handle with Node)

typealias NodePool = Pool with Node

type Node
	var value as Count
	var next as Option with (Handle with Node)

	static function make(value Count, consumes next Option with (Handle with Node)) returns Node
		return Node{value: value, next: next}
	end 'make'
end 'Node'

type Stack
	var nodes as Pool with Node
	var top as Option with (Handle with Node)

	static function make() returns Stack
		return Stack{nodes: NodePool.create(), top: NodeHandleOption.none}
	end 'make'

	function push(mutates self, value Count)
		let node = Node.make(value, next: top.clone())
		top = Option.some(nodes.insert(node))
	end 'push'

	function pop(mutates self) returns Option with Count
		if not top.isSome() 'empty'
			return CountOption.none
		end 'empty'
		let handle = top.clone().unwrap()
		let node = nodes.remove(handle).unwrap()
		top = node.next.clone()
		return Option.some(node.value)
	end 'pop'

	function peek() returns Option with Count
		if not top.isSome() 'empty'
			return CountOption.none
		end 'empty'
		return Option.some(nodes[top.clone().unwrap()].value)
	end 'peek'

	function size() returns Count
		return nodes.count()
	end 'size'
end 'Stack'

function show(o Option with Count) returns String
	return match o 'm'
		some(v) gives "{v}"
		none gives "none"
	end 'm'
end 'show'

function main() returns ExitCode
	var s = Stack.make()
	print("{show(s.peek())} {show(s.pop())} {s.size()}\n")
	s.push(1)
	s.push(2)
	s.push(3)
	print("{show(s.peek())} {s.size()}\n")
	print("{show(s.pop())} {show(s.pop())} {s.size()}\n")
	s.push(4)
	print("{show(s.peek())} {s.size()}\n")
	print("{show(s.pop())} {show(s.pop())} {show(s.pop())} {s.size()}\n")
	return 0
end 'main'

//> none none 0
//> 3 3
//> 3 2 1
//> 4 2
//> 4 1 none 0
