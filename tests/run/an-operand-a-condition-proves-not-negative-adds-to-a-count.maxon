typealias Index = int(0 to u64.max)

let top = 9

function at(index Index) returns Count
	return index as Count
end 'at'

function main() returns ExitCode
	let left = 5 as Index
	var total = 0 as Count
	var big = 0 as Count
	for column in 0 upto 19 'columns'
		let first = column - top if column > top else 0
		let last = column if column < top else top
		for index in first to last 'terms'
			total = try total + at(left + index) otherwise 0
		end 'terms'
		if column >= top 'high'
			let over = column - top
			if left + over > left 'past'
				big = try big + 1 otherwise 0
			end 'past'
		end 'high'
	end 'columns'
	print("{total} {big}\n")
	return 0
end 'main'

//> 950 9
