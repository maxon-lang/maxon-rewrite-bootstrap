typealias Coord = int(i64.min to i64.max)

type Point
	export var x as Coord
	export var y as Coord
	export let name = "point"

	function sum() returns Coord throws ArithmeticError
		return try x + y
	end 'sum'

	function move(mutates self, dx Coord) throws ArithmeticError
		x = try x + dx
	end 'move'

	function describe() returns String
		return "{name}({x}, {y})"
	end 'describe'

	static function create(x Coord, y Coord) returns Point
		return Point{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	var p = Point.create(1, y: 2)
	try p.move(10) otherwise return 1
	let sum = try p.sum() otherwise return 1
	print("{p.x} {p.y} {sum}\n")
	var q = p.copy()
	q.x = 5
	print("{p.describe()}\n")
	var r = Point.create(0, y: 0)
	let s = r
	r = Point.create(7, y: 8)
	print("{s.describe()} {r.describe()}\n")
	return 0
end 'main'

//> 11 2 13
//> point(11, 2)
//> point(0, 0) point(7, 8)
