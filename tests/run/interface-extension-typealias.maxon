interface Holder uses Element
	function get() returns Element
end 'Holder'

extension Holder
	typealias Pair = Array with Element
	typealias Pick = function(Element) returns bool

	function twice() returns Pair
		var r = Pair.create(0)
		r.push(self.get())
		r.push(self.get())
		return r
	end 'twice'

	function level(keep Pick, of Element) returns Count
		if keep(of) 'kept'
			return 3
		end 'kept'
		return 0
	end 'level'
end 'Holder'

type Box implements Holder with Count
	var n as Count

	static function make(n Count) returns Box
		return Box{n: n}
	end 'make'

	function get() returns Count
		return n
	end 'get'
end 'Box'

type Label implements Holder with String
	var text as String

	static function make(consumes text String) returns Label
		return Label{text: text}
	end 'make'

	function get() returns String
		return text.clone()
	end 'get'
end 'Label'

function big(n Count) returns bool
	return n > 2
end 'big'

function main() returns ExitCode
	let b = Box.make(3)
	let xs = b.twice()
	print("{xs.count()} {xs[0]} {xs[1]} {b.level(big, of: 7)} {b.level(big, of: 1)}\n")
	let l = Label.make("ab")
	let ys = l.twice()
	print("{ys[0]}{ys[1]}\n")
	return 0
end 'main'

//> 2 3 3 3 0
//> abab
