// A program writes its own overload policy as a type that implements OverloadPolicy with its service's message union: admit
// runs at the send, only while the service is behind, sees how many messages it holds, the runtime's turn and the message,
// and keeps no state, so it is tested as a plain static function. A handler asks underLoad() whether its service is behind, to do cheaper work while it is.
// schedules: 6
//> admits: queue refuse, handled and refused: 1000, underLoad off a message: false
export typealias Amount = int(0 to 1000000)

type TwoTurns implements OverloadPolicy with Worker.Message
	static function admit(arrival Arrival, message Worker.Message) returns Admission
		if arrival.count < (try 2 * arrival.turnSize otherwise arrival.count) 'room'
			return Admission.queue
		end 'room'
		return Admission.refuse
	end 'admit'
end 'TwoTurns'

type Worker
	var done as Amount
	var cheap as Amount

	static function create() returns Self
		return Self{done: 0, cheap: 0}
	end 'create'

	@policy(TwoTurns) export function work(mutates self, n Amount) returns Amount
		if underLoad() 'load'
			self.cheap = try self.cheap + 1 otherwise 0
		end 'load'
		self.done = try self.done + 1 otherwise 0
		return n
	end 'work'

	export function count() returns Amount
		return self.done
	end 'count'
end 'Worker'

function admitText(a Admission) returns String
	return match a 'a'
		queue gives "queue"
		refuse gives "refuse"
		discard gives "discard"
		replacePending gives "replacePending"
	end 'a'
end 'admitText'

function main() returns ExitCode
	let few = TwoTurns.admit(Arrival.make(10, turnSize: 64), message: Worker.Message.work(1))
	let many = TwoTurns.admit(Arrival.make(200, turnSize: 64), message: Worker.Message.count)
	let w = spawn Worker.create()
	var refused = 0 as Amount
	for i in 1 to 1000 'send'
		_ = try w.work(i) otherwise (e) 'no'
			match e 'why'
				busy then refused = try refused + 1 otherwise 0
				serviceStopped then print("stopped\n")
			end 'why'
			continue 'send'
		end 'no'
	end 'send'
	let n = try await w.count() otherwise 0
	print("admits: {admitText(few)} {admitText(many)}, handled and refused: {n + refused}, underLoad off a message: {underLoad()}\n")
	return 0
end 'main'
