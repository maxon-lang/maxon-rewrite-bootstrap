typealias Number = int(i64.min to i64.max)

type Vector2
	export var x as Number
	export var y as Number

	function dot(other Vector2) returns Number
		return x * other.x + y * other.y
	end 'dot'

	function scale(mutates self, by Number)
		x = x * by
		y = y * by
	end 'scale'

	function describe() returns String
		return "({x}, {y})"
	end 'describe'

	static function create(x Number, y Number) returns Vector2
		return Vector2{x: x, y: y}
	end 'create'
end 'Vector2'

function swap(mutates a Number, mutates b Number)
	let t = a
	a = b
	b = t
end 'swap'

function main() returns ExitCode
	var a = Vector2.create(1, y: 2)
	var b = a.copy()
	b.scale(10)
	print("{a.describe()} {b.describe()} {a.dot(b)}\n")
	var left = 1 as Number
	var right = 2 as Number
	swap(left, b: right)
	print("{left} {right}\n")
	swap(a.x, b: a.y)
	print("{a.describe()}\n")
	return 0
end 'main'

//> (1, 2) (10, 20) 50
//> 2 1
//> (2, 1)
