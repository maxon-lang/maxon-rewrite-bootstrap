union Option uses T
	some(value T)
	none

	function isSome() returns bool
		return match self 'o'
			some(v) gives true
			none gives false
		end 'o'
	end 'isSome'

	function unwrap(consumes self) returns T
		match consumes self 'o'
			some(value) then return value
			none then panic("unwrap of an Option that holds no value")
		end 'o'
	end 'unwrap'
end 'Option'

// expect-exit: 1
typealias CountOption = Option with Count

function main() returns ExitCode
	let first = CountOption.none
	print("{first.isSome()}\n")
	print("{first.unwrap()}\n")
	return 0
end 'main'

//> false
