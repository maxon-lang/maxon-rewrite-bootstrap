typealias Score = int(i64.min to i64.max)

function classify(n Score) returns String
	if n < 0 'neg'
		return "negative"
	end 'neg' else if n == 0 'zero'
		return "zero"
	end 'zero' else 'pos'
		return "positive"
	end 'pos'
end 'classify'

function bump(counter inout Score)
	counter = counter + 1
end 'bump'

function main() returns ExitCode
	print("{classify(-3)} {classify(0)} {classify(9)}\n")
	var k = 0 as Score
	bump(k)
	bump(k)
	print("k {k}\n")
	var i = 0 as Score
	while true 'outer'
		i = i + 1
		if i == 2 'skip'
			continue
		end 'skip'
		for j in 0 upto 10 'inner'
			if j == 3 'stop'
				break
			end 'stop'
			if i == 4 'done'
				break 'outer'
			end 'done'
			print("{i}.{j};")
		end 'inner'
	end 'outer'
	print("\n")
	return 0
end 'main'

//> negative zero positive
//> k 2
//> 1.0;1.1;1.2;3.0;3.1;3.2;
