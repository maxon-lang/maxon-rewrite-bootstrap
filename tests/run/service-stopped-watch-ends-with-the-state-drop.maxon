// A stop of a service whose state can hold a Reply queues the behaviour that drops the state after the queued messages, and
// the release of that behaviour is the service's own, as a message's is: the release that leaves the closed service with
// nothing queued ends it, so a watch of its stop completes, also where the behaviour runs in a turn of its own after a turn's
// worth of messages, and the Reply the state held fails its await.
// schedules: 6
//> parked failed: true, watched
export typealias Count = int(0 to 1000)

export typealias Parked = Array with Reply with Count

service Parker
	var parked as Parked

	static function create() returns Self
		return Self{parked: Parked.create(0)}
	end 'create'

	export function wait(mutates self) returns Count throws ReplyStopped
		let pending = reply.later()
		self.parked.push(pending)
		return
	end 'wait'

	export function poke() returns Count
		return 1
	end 'poke'
end 'Parker'

// pokes and the factory and the parked message are 64 behaviours, a turn's worth (runtime/green.maxon, turnBehaviours).
let pokes = 62 as Count

// stopped is what main takes for the reply of the parked message, which the drop of the state fails.
let stopped = 999 as Count

function main() returns ExitCode
	let parker = spawn Parker.create()
	let parked = try parker.wait() otherwise panic("send")
	for i in 0 upto pokes 'pokes'
		_ = try parker.poke() otherwise panic("poke")
	end 'pokes'
	let watch = parker.stopped()
	parker.shutdown()
	let failed = (try await parked otherwise stopped) == stopped
	await watch
	print("parked failed: {failed}, watched\n")
	return 0
end 'main'
