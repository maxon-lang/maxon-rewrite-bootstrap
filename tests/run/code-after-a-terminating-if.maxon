typealias Score = int(i64.min to i64.max)

function keep(a T) uses T returns T where T implements Copyable
	return a.clone()
end 'keep'

function afterBothBranches(c bool) returns Score
	if c 'pick'
		return 4
	end 'pick' else 'other'
		return 5
	end 'other'
	return keep(6 as Score)
end 'afterBothBranches'

function breakLeavesTheMatch(c bool) returns Score
	match c 'leave'
		true then break
		false then return 8
	end 'leave'
	return 9
end 'breakLeavesTheMatch'

function main() returns ExitCode
	print("{afterBothBranches(false)} {breakLeavesTheMatch(true)}\n")
	return 0
end 'main'

//> 5 9
