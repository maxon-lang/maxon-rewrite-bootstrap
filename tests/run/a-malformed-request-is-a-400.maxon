// A request whose head does not parse is a 400 and closes the connection (RFC 9112 §2.2, §3, §5): a line ended by a bare LF
// or a bare CR, a field line folded onto the one before it (obs-fold, §5.2), whitespace between a field's name and its colon
// (§5.1), a control byte in a value, a Content-Length that is not digits (RFC 9110 §8.6), an HTTP/1.1 request with no Host or
// two (§3.2), a request line with two spaces, and an asterisk target on anything but OPTIONS (§3.2.4). Empty lines before
// the request line are skipped (§2.2).
// native-only
//> a bare LF: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> a bare CR in a field: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> obs-fold: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> a space before the colon: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> a control byte in a value: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> a length that is not digits: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> no Host: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> two Hosts: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> two spaces: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> an asterisk on GET: HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 0\r\nConnection: close\r\n\r\n
//> empty lines first: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 19\r\nConnection: close\r\n\r\nGET /after HTTP/1.1
//> HTTP/1.0 with no Host: HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 17\r\nConnection: close\r\n\r\nGET /old HTTP/1.0
//> stopped
function shown(text String) returns String
	return text.replace("\r\n", with: "\\r\\n")
end 'shown'

// readToEnd reads what the server sends until it closes the connection.
function readToEnd(mutates client TcpClient) returns String
	var all = ByteArray.create(0)
	while true 'reading'
		let chunk = try client.readSome(4096) otherwise return "{shown(String.from(all))} [the read failed]"
		if chunk.isEmpty() 'closed'
			break 'reading'
		end 'closed'
		all.append(chunk)
	end 'reading'
	return shown(String.from(all))
end 'readToEnd'

function answerTo(port NetworkPort, request String) returns String
	var client = try TcpClient.connect("127.0.0.1", port: port) otherwise return "no connection"
	try client.setReadDeadline(5000) otherwise ignore
	_ = try client.send(request) otherwise 0
	let answer = readToEnd(client)
	try client.close() otherwise ignore
	return answer
end 'answerTo'

// Echo answers each request with its request line, and with how many bytes its body had where it had one.
type Echo implements HttpHandler
	static function create() returns Self
		return Self{}
	end 'create'

	function handle(consumes exchange HttpExchange) returns HttpAnswered
		let line = "{methodName(exchange.request.method)} {exchange.request.target()} HTTP/1.{exchange.request.minorVersion}"
		let count = exchange.requestBody.count()
		return exchange.respondWith(StatusCode.ok, body: "{line} with {count} bytes" if count > 0 else line, contentType: "text/plain")
	end 'handle'
end 'Echo'

function methodName(method HttpMethod) returns String
	return match method 'method'
		get gives "GET"
		post gives "POST"
		put gives "PUT"
		delete gives "DELETE"
		head gives "HEAD"
		patch gives "PATCH"
		options gives "OPTIONS"
	end 'method'
end 'methodName'

function main() returns ExitCode
	let server = try HttpServer.bind("127.0.0.1", port: 0) otherwise panic("a server on the loopback")
	let port = server.port()
	var config = ServerConfig.create()
	let serving = server.serve(freeze(Echo.create()), config: config)
	print("a bare LF: {answerTo(port, request: "GET / HTTP/1.1\nHost: a\r\n\r\n")}\n")
	print("a bare CR in a field: {answerTo(port, request: "GET / HTTP/1.1\r\nHost: a\rb\r\n\r\n")}\n")
	print("obs-fold: {answerTo(port, request: "GET / HTTP/1.1\r\nHost: a\r\nX-A: one\r\n two\r\n\r\n")}\n")
	print("a space before the colon: {answerTo(port, request: "GET / HTTP/1.1\r\nHost: a\r\nX-A : one\r\n\r\n")}\n")
	print("a control byte in a value: {answerTo(port, request: "GET / HTTP/1.1\r\nHost: a\r\nX-A: o\x01ne\r\n\r\n")}\n")
	print("a length that is not digits: {answerTo(port, request: "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: +5\r\n\r\n")}\n")
	print("no Host: {answerTo(port, request: "GET / HTTP/1.1\r\n\r\n")}\n")
	print("two Hosts: {answerTo(port, request: "GET / HTTP/1.1\r\nHost: a\r\nHost: a\r\n\r\n")}\n")
	print("two spaces: {answerTo(port, request: "GET  / HTTP/1.1\r\nHost: a\r\n\r\n")}\n")
	print("an asterisk on GET: {answerTo(port, request: "GET * HTTP/1.1\r\nHost: a\r\n\r\n")}\n")
	print("empty lines first: {answerTo(port, request: "\r\n\r\nGET /after HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n")}\n")
	print("HTTP/1.0 with no Host: {answerTo(port, request: "GET /old HTTP/1.0\r\n\r\n")}\n")
	serving.stop(1000)
	print("stopped\n")
	return 0
end 'main'
