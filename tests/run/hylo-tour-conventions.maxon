typealias Number = int(-1000 to 1000)

typealias Sum = int(-2000 to 2000)

type Pair
	export var first as Number
	export var second as Number

	static function create(first Number, second Number) returns Pair
		return Pair{first: first, second: second}
	end 'create'
end 'Pair'

type Wrapper
	export var pair as Pair

	static function wrap(consumes pair Pair) returns Wrapper
		return Wrapper{pair: pair}
	end 'wrap'
end 'Wrapper'

function total(p Pair) returns Sum
	return p.first + p.second
end 'total'

function double(mutates p Pair) throws ArithmeticError
	p.first = try p.first * 2
	p.second = try p.second * 2
end 'double'

function replace(mutates p Pair, consumes other Pair)
	p = other
end 'replace'

function consume(consumes p Pair) returns Sum
	let wrapper = Wrapper.wrap(p)
	return total(wrapper.pair)
end 'consume'

function make(sets p Pair, first Number, second Number)
	p = Pair.create(first, second: second)
end 'make'

function makeOrdered(sets p Pair, ascending bool)
	if ascending 'order'
		make(p, first: 1, second: 2)
	end 'order' else 'other'
		make(p, first: 2, second: 1)
	end 'other'
end 'makeOrdered'

function main() returns ExitCode
	var pair = Pair.create(3, second: 4)
	print("{total(pair)}\n")
	try double(pair) otherwise return 1
	print("{pair.first} {pair.second}\n")
	replace(pair, other: Pair.create(7, second: 8))
	print("{pair.first} {pair.second}\n")
	print("{consume(pair)}\n")
	pair = Pair.create(1, second: 1)
	print("{pair.first}\n")
	var made as Pair
	make(made, first: 5, second: 6)
	print("{made.first} {made.second}\n")
	var ordered as Pair
	makeOrdered(ordered, ascending: false)
	print("{ordered.first} {ordered.second}\n")
	return 0
end 'main'

//> 7
//> 6 8
//> 7 8
//> 15
//> 1
//> 5 6
//> 2 1
