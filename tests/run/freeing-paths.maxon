typealias NoteArray = Array with Note

typealias SlotArray = Array with Slot

typealias StringArray = Array with String

typealias StringArrayArray = Array with (Array with String)

type Note
	export var text as String
	export var tags = StringArray.create(0)

	static function make(consumes text String) returns Note
		return Note{text: text}
	end 'make'
end 'Note'

union Slot
	filled(note Note, rank Count)
	named(label String)
	vacant
end 'Slot'

function label(n Count) returns String
	return "label {n}"
end 'label'

function early(flag bool, n Count) returns Count
	let first = Note.make(label(n))
	if flag 'quick'
		let second = Note.make("{n} quick")
		print("{second.text.clone()} ")
		return first.tags.count()
	end 'quick'
	let third = Note.make("slow")
	return n
end 'early'

function loops(limit Count) returns Count
	var kept = 0 as Count
	for i in 0 upto limit 'each'
		let a = Note.make(label(i))
		if i == 2 'skip'
			continue
		end 'skip'
		let b = Note.make("kept {i}")
		if i == 7 'stop'
			break
		end 'stop'
		kept = kept + 1
	end 'each'
	return kept
end 'loops'

function grow(n Count) returns Count throws ArithmeticError
	var notes = NoteArray.create(0)
	for i in 0 upto n 'fill'
		notes.push(Note.make(label(i)))
	end 'fill'
	notes.insert(0, value: Note.make("front"))
	let removed = try notes.remove(3) otherwise panic("index out of range")
	var kept = NoteArray.create(0)
	kept.push(removed)
	notes[1] = Note.make("replaced")
	notes[2].tags.push("one")
	notes[2].tags.push("two")
	notes[2].tags.push(label(9))
	try 'm'
		let note = notes.pop()
		print("{note.text} ")
	end 'm' otherwise 'none'
		print("none ")
	end 'none'
	let again = try notes.pop() otherwise panic("the array is empty")
	print("{again.text} {kept[0].text} {notes.count()}\n")
	return try notes.count() + kept.count()
end 'grow'

function slots() returns Count throws ArithmeticError
	var held = SlotArray.create(0)
	held.push(Slot.filled(Note.make("a"), rank: 1))
	held.push(Slot.named(label(2)))
	held.push(Slot.vacant)
	held[0] = Slot.named("b")
	held[2] = Slot.filled(Note.make("c"), rank: 3)
	let copy = held.clone()
	var total = 0 as Count
	for i in 0 upto copy.count() 'each'
		match copy[i] 'm'
			filled(note, rank) then total = try total + rank
			named(text) then total = try total + 10
			vacant then total = try total + 100
		end 'm'
	end 'each'
	return try total + held.count()
end 'slots'

function nested() returns Count
	var grid = StringArrayArray.create(0)
	for i in 0 upto 3 'rows'
		var row = StringArray.create(0)
		for j in 0 upto 6 'cols'
			row.push("{i}{j}")
		end 'cols'
		grid.push(row)
	end 'rows'
	let copy = grid.clone()
	print("{copy[2][5]} ")
	return grid.count()
end 'nested'

function choose(flag bool) returns Count
	let note = Note.make("a") if flag else Note.make("longer")
	print("{note.text} ")
	return 0
end 'choose'

function main() returns ExitCode
	print("{early(true, n: 1)} {early(false, n: 5)} {loops(10)}\n")
	print("{try grow(6) otherwise return 1} {try slots() otherwise return 1} {nested()} {choose(true)} {choose(false)}\n")
	return 0
end 'main'

//> 1 quick 0 5 6
//> label 5 label 4 label 2 4
//> 25 a longer 5 26 3 0 0
