// Map.insert throws keyAlreadyExists where upsert replaces, remove says whether the key was there, and List's
// removeFirst, removeLast, first and last throw ArrayError on an empty list.
typealias StringCountMap = Map with String, Count

typealias NameList = List with String

function add(mutates m StringCountMap, key String, value Count) returns String
	try 'addBlock'
		m.insert(key.clone(), value: value)
	end 'addBlock' otherwise (e) 'failed'
		return match e 'why'
			keyNotFound gives "not found"
			keyAlreadyExists gives "{key} is there"
		end 'why'
	end 'failed'
	return "added {key}"
end 'add'

function main() returns ExitCode
	var m = StringCountMap.create()
	print("{add(m, key: "a", value: 1)} {add(m, key: "a", value: 2)} {(try m.get("a") otherwise panic("no such key"))}\n")
	m.upsert("a", value: 3)
	print("{(try m.get("a") otherwise panic("no such key"))} {m.contains("a")} {m.remove("a")} {m.remove("a")} {m.contains("a")} {m.count()}\n")
	var l = NameList.create()
	let first = try l.first() otherwise l.append("x")
	print("{l.count()} {l[first]}\n")
	let h = l.prepend("w")
	_ = l.append("y")
	print("{l[try l.first() otherwise h]} {l[try l.last() otherwise h]}\n")
	let front = try l.removeFirst() otherwise "none"
	let back = try l.removeLast() otherwise "none"
	let middle = try l.removeLast() otherwise "none"
	let after = try l.removeFirst() otherwise "none"
	print("{front} {back} {middle} {after} {l.isEmpty()}\n")
	return 0
end 'main'

//> added a a is there 1
//> 3 true true false false 0
//> 1 x
//> w y
//> w y x none true
