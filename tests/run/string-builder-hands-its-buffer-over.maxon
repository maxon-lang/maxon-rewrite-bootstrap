// A StringBuilder appends its pieces to one buffer in place and hands the buffer over as the String it builds, leaving
// itself empty; a piece with a byte past ASCII clears what the String's ASCII bit says.
function main() returns ExitCode
	var b = StringBuilder.create()
	b.reserve(16)
	for i in 0 upto 5 'pieces'
		b.append("item {i};")
	end 'pieces'
	let first = b.build()
	print("{first} {first.count()} {b.isEmpty()}\n")
	b.append("h\u00e9")
	b.append("!")
	let second = b.build()
	print("{second} {second.count()} {b.byteLength()}\n")
	let empty = b.build()
	print("[{empty}] {empty.count()}\n")
	return 0
end 'main'

//> item 0;item 1;item 2;item 3;item 4; 35 true
//> hé! 3 0
//> [] 0
