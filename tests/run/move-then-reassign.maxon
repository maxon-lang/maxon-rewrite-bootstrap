typealias Score = int(i64.min to i64.max)

type Box
	export var v as Score
	static function create(v Score) returns Box
		return Box{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var a = Box.create(1)
	let b = a
	a = Box.create(2)
	print("{a.v} {b.v}\n")
	return 0
end 'main'

//> 2 1
