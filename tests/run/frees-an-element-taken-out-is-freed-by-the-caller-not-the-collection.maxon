typealias StringArray = Array with String

function main() returns ExitCode
	var a = StringArray.create(0)
	a.push("e{1}")
	a.push("e{2}")
	a.push("e{3}")
	let taken = a.remove(1)
	_ = a.remove(0)
	let last = "z{4}"
	return 0
end 'main'

