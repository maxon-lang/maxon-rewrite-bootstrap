// expect-error: E3057 at 42:7
// A field of what a throwing method lends is assigned with a try before the target: without one it is E3057.
typealias Integer = int(i64.min to i64.max)

type Node
	export var visited as bool
	export var weight as Integer

	static function make(weight Integer) returns Node
		return Node{visited: false, weight: weight}
	end 'make'
end 'Node'

type Graph
	var a as Node
	var b as Node

	static function make() returns Graph
		return Graph{a: Node.make(1), b: Node.make(2)}
	end 'make'

	function look(key Integer) returns borrowed Node throws ArrayError
		if key == 0 'a'
			return a
		end 'a'
		throw ArrayError.emptySlot
	end 'look'

	function get(mutates self, key Integer) returns borrowed Node throws ArrayError
		if key == 0 'a'
			return a
		end 'a'
		if key == 1 'b'
			return b
		end 'b'
		throw ArrayError.emptySlot
	end 'get'
end 'Graph'

function main() returns ExitCode
	var g = Graph.make()
	g.get(1).weight = 5
	return 0
end 'main'
