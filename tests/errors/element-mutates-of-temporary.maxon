// expect-error: E2013 at 19:14
type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = c.n + 1
end 'touch'

function make() returns array[Cell]
	return array[Cell].new()
end 'make'

function main() returns ExitCode
	touch(make()[0])
	return 0
end 'main'
