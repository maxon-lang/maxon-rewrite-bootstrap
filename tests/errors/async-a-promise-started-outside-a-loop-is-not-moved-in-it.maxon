// A promise started outside a loop and moved inside it would be moved again by the next iteration: refused at the
// move, once, and not again where the loop's paths meet.
typealias Tally = int(0 to 1000000)

typealias TallyPromise = Promise with Tally

function nap(tag Tally) returns Tally
	sleep(1)
	return tag
end 'nap'

function finish(consumes p TallyPromise) returns Tally
	return await p
end 'finish'

function main() returns ExitCode
	let p = async nap(3)
	var total = 0 as Tally
	for i in 0 upto 3 'each'
		total = try total + finish(p) otherwise 0
	end 'each'
	return total
end 'main'

// expect-error: E3102 at 20:30
