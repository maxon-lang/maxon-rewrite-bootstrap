// expect-error: E3185 at 3:19
// A slot array, whose operations leave and fill empty slots, is the library tiers' alone.
typealias Names = __SlotArray with String

function main() returns ExitCode
	var names = Names.create(0)
	names.fillSlot(0, value: "ada")
	let ada = try names.takeSlot(0) otherwise ""
	print(ada)
	return 0
end 'main'
