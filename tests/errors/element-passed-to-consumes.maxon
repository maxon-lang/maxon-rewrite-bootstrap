// expect-error: E3901 at 18:16
typealias CellArray = Array with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function take(consumes c Cell) returns Count
	return c.n
end 'take'

function main() returns ExitCode
	var a = CellArray.create(0)
	print("{take(a[0])}")
	return 0
end 'main'
