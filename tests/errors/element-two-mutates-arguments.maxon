// expect-error: E3112 at 18:17
typealias CellArray = array with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function pair(mutates a Cell, mutates b Cell)
	a.n = b.n
end 'pair'

function main() returns ExitCode
	var a = CellArray.new()
	pair(a[0], b: a[1])
	return 0
end 'main'
