union Option uses T
	some(value T)
	none

	function isSome() returns bool
		return match self 'o'
			some(v) gives true
			none gives false
		end 'o'
	end 'isSome'

	function unwrap(consumes self) returns T
		match consumes self 'o'
			some(value) then return value
			none then panic("unwrap of an Option that holds no value")
		end 'o'
	end 'unwrap'
end 'Option'

// expect-error: E3914 at 23:1
typealias NodeCownOption = Option with (cown with Node)

type Node
	export var next as Option with (cown with Node)

	static function make() returns Node
		return Node{next: NodeCownOption.none}
	end 'make'
end 'Node'

function main() returns ExitCode
	return 0
end 'main'
