function spread(total Count, parts Count) returns Count
	var d = parts
	if d == 0 'none'
		return 0
	end 'none'
	var sum = 0 as Count
	while sum < 10 'fill'
		sum = sum + total / d
	end 'fill'
	return sum
end 'spread'

function main() returns ExitCode
	return 0
end 'main'

