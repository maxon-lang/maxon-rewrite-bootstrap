typealias Score = int(i64.min to i64.max)

typealias Digit = int(0 to 9)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 0
end 'touch'

// expect-error: E3057 at 20:12
function f(a Count, b Count) returns Count
	if a < 1000 or b < 1000 'small'
		return a * b
	end 'small'
	return 0
end 'f'

function main() returns ExitCode
	return 0
end 'main'
