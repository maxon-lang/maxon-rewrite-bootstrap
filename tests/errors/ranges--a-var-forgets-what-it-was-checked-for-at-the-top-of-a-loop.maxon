typealias Score = int(i64.min to i64.max)

typealias Digit = int(0 to 9)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 0
end 'touch'

// expect-error: E3057 at 25:21
function f(total Count, parts Count) returns Count
	var d = parts
	if d == 0 'none'
		return 0
	end 'none'
	var sum = 0 as Count
	while sum < 10 'fill'
		sum = sum + total / d
		d = parts
	end 'fill'
	return sum
end 'f'

function main() returns ExitCode
	return 0
end 'main'
