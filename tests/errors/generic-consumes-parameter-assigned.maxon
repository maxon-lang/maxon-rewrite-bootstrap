typealias Score = int(i64.min to i64.max)

type Box[T]
	var item as T
	let tag as Score

	static function make(consumes item T, tag Score) returns Self
		return Self{item: item, tag: tag}
	end 'make'

	function peek() returns T
		return item.copy()
	end 'peek'

	function replace(mutates self, consumes next T)
		item = next
	end 'replace'

	function bump(mutates self, by Score)
		var next = by
		next = next + 1
	end 'bump'
end 'Box'

union Slot[T]
	full(value T)
	empty
end 'Slot'

function swap[T](mutates a T, mutates b T)
	var tmp = a.copy()
	a = b.copy()
	b = tmp
end 'swap'

function join[T](mutates a T, consumes b T)
	a = b
end 'join'

function fill[T](sets out T, from T)
	out = from.copy()
end 'fill'

function consume[T](consumes a T) returns Score
	return 1
end 'consume'

function again[T](consumes a T, b T)
	a = b.copy()
end 'again'

function main() returns ExitCode
	return 0
end 'main'

