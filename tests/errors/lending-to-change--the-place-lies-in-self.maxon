// expect-error: E3926 at 26:10
// expect-error: E9000 at 34:15
// A place lent to be changed lies in 'self', outside any frozen value, and is no element yet: a parameter's place and a
// frozen value's contents are E3926, an element and a tuple E9000.
typealias Integer = int(i64.min to i64.max)

typealias Integers = Array with Integer

type Cell
	export var n as Integer

	static function make(n Integer) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

type Box
	var cell as Cell
	var frozenCell as frozen with Cell
	var items as Integers

	function fromParam(mutates self, c Cell) returns borrowed Cell
		return c
	end 'fromParam'

	function fromMutatesParam(mutates self, mutates c Cell) returns borrowed Cell
		return c
	end 'fromMutatesParam'

	function element(mutates self) returns borrowed Integer
		return items[0]
	end 'element'

	function inFrozen(mutates self) returns borrowed Cell
		return frozenCell
	end 'inFrozen'

	function readOnly() returns borrowed Cell
		return cell
	end 'readOnly'

	function pair(mutates self) returns borrowed (Cell, Cell)
		return (cell, cell)
	end 'pair'
end 'Box'

function main() returns ExitCode
	return 0
end 'main'
