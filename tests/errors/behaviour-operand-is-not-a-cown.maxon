// expect-error: E3129 at 12:7
type Acct
	export var balance as Count
	export var tag as String
	static function make(balance Count) returns Acct
		return Acct{balance: balance, tag: "t"}
	end 'make'
end 'Acct'

function main() returns ExitCode
	let c = Acct.make(1)
	when c as x 'outer'
		print("{x.balance}")
	end 'outer'
	return 0
end 'main'
