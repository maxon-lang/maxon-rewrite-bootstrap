interface Labelled
	function label() returns borrowed String
end 'Labelled'

// A call through the requirement takes a place it does not own, so a method that gives a new String would leave it with
// no owner to drop it.
type Shelf implements Labelled
	export var name as String

	function label() returns String
		return name.clone()
	end 'label'
end 'Shelf'

function main() returns ExitCode
	return 0
end 'main'

// expect-error: E3016 at 7:6
