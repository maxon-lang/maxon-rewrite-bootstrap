// A Reply is typed by its message's reply type, which the body of a generic type does not fix.
type Box uses T
	var held as T

	export function ask() returns Count throws ReplyStopped
		let pending = reply.later()
		return
	end 'ask'
end 'Box'

function main() returns ExitCode
	return 0
end 'main'

