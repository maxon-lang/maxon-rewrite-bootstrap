// A send through an interface handle names no policy, since the interface does not say which service is behind it: a method that
// meets a requirement of an interface that requires service sends through the service's own handle, which names one (E3957).
export typealias Amount = int(0 to 1000000)

interface Sink
	function put(mutates self, value Amount)
end 'Sink'

service Tally implements Sink
	var sum as Amount

	static function create() returns Self
		return Self{sum: 0}
	end 'create'

	@policy(Keep) export function put(mutates self, value Amount)
		self.sum = try self.sum + value otherwise 0
	end 'put'
end 'Tally'

interface Route requires service
	function handle(request Amount) returns Amount
end 'Route'

type Forward implements Route
	var sink as Sink.handle

	static function make(consumes sink Sink.handle) returns Self
		return Self{sink: sink}
	end 'make'

	function handle(request Amount) returns Amount
		try self.sink.put(request) otherwise ignore
		return request
	end 'handle'
end 'Forward'

function main() returns ExitCode
	let forward = Forward.make(spawn Tally.create())
	print("{forward.handle(1)}\n")
	return 0
end 'main'

// expect-error: E3957 at 33:17
