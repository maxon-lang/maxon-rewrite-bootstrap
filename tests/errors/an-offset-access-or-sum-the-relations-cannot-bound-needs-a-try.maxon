// expect-error: E3057 at 17:16
// expect-error: E3057 at 25:17
// expect-error: E3057 at 33:16
// expect-error: E3057 at 40:12
// An access or a sum moved by a constant needs a try where the relations do not bound it: the element after an index that
// only the index was guarded for, a guard that allows the index at the count, a sum of a bit pattern, which wraps past its
// word and so says nothing of its operand, and a sum of a full-range integer that a guard only puts at most another.
typealias Counts = Array with Count

typealias Word = bits(64)

function next(xs Counts, i Count) returns Count
	if i < xs.count() 'guarded'
		return 0
	end 'guarded'
	if i < 100 'small'
		return xs.get(i + 1)
	end 'small'
	return 0
end 'next'

function atMost(xs Counts, i Count) returns Count
	if i < 100 'small'
		if i + 1 <= xs.count() 'guarded'
			return xs.get(i + 1)
		end 'guarded'
	end 'small'
	return 0
end 'atMost'

function wrapped(xs Counts, w Word) returns Count
	if w + 1 < 3 'guarded'
		return xs.get(w as Count)
	end 'guarded'
	return 0
end 'wrapped'

function edge(i FullRangeInt, n FullRangeInt) returns FullRangeInt
	if i <= n 'guarded'
		return i + 1
	end 'guarded'
	return 0
end 'edge'

function main() returns ExitCode
	return 0
end 'main'
