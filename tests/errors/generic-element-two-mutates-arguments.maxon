function swap2(mutates x T, mutates y T) uses T where T implements Copyable
	let t = x.clone()
	x = y.clone()
	y = t
end 'swap2'

function f(mutates a Array with T) uses T where T implements Copyable
	swap2(a[0], y: a[1])
end 'f'

function main() returns ExitCode
	return 0
end 'main'
