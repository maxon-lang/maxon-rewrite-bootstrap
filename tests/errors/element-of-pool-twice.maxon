// expect-error: E3186 at 25:17
typealias CellArray = array with Cell

typealias CellPool = pool with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function pair(mutates a Cell, mutates b Cell)
	a.n = b.n
end 'pair'

function make() returns array with Cell
	return CellArray.new()
end 'make'

function main() returns ExitCode
	var p = CellPool.new()
	let h = p.insert(Cell.make(1))
	pair(p[h], b: p[h])
	return 0
end 'main'
