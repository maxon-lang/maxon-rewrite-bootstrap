export typealias Amount = int(0 to 1000000)

service Child
	var id as Amount

	static function create(id Amount) returns Self
		return Self{id: id}
	end 'create'

	export function ended(mutates self, child Amount)
		self.id = child
	end 'ended'
end 'Child'

service Sup
	var told as Amount

	static function create() returns Self
		return Self{told: 0}
	end 'create'

	@policy(Keep) export function told(mutates self, n Amount)
		self.told = n
	end 'told'

	export function watch(mutates self, child Child.handle)
		child.notifyStopped(self.handle.post(Child.Message.ended(1)))
	end 'watch'
end 'Sup'

function main() returns ExitCode
	let sup = spawn Sup.create()
	try sup.watch(spawn Child.create(1)) otherwise ignore
	return 0
end 'main'

