typealias Score = int(i64.min to i64.max)

type Box
	export var v as Score
	export var name as String

	function describe() returns String
		return name.copy()
	end 'describe'

	function rename(mutates self, consumes value String)
		name = value
	end 'rename'

	static function create(v Score, consumes name String) returns Box
		return Box{v: v, name: name}
	end 'create'
end 'Box'

type Account
	export var balance as Score
	export var history as Score

	function transfer(mutates self)
		self.apply(balance)
	end 'transfer'

	function apply(mutates self, amount Score)
		balance = amount
	end 'apply'
end 'Account'

function main() returns ExitCode
	return 0
end 'main'

