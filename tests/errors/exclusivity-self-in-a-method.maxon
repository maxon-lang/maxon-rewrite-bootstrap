typealias Score = int(i64.min to i64.max)

type Box
	export var v as Score
	export var name as String
	function describe() returns String
		return name.copy()
	end 'describe'
	function rename(inout self, value sink String)
		name = value
	end 'rename'
	function bump(inout self, by Score)
		v = v + by
	end 'bump'
	static function create(v Score, name sink String) returns Box
		return Box{v: v, name: name}
	end 'create'
end 'Box'

type Account
	export var balance as Score
	export var history as Score
	function transfer(inout self)
		self.apply(balance)
	end 'transfer'
	function apply(inout self, amount Score)
		balance = balance + amount
	end 'apply'
end 'Account'

function main() returns ExitCode
	return 0
end 'main'

