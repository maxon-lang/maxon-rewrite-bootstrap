typealias CountCellMap = Map with Count, Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function keep(consumes c Cell) returns Count
	return c.n
end 'keep'

// A value that a loop over a map lends stays the map's.
function main() returns ExitCode
	var m = CountCellMap.create()
	m.upsert(1, value: Cell.make(2))
	for (_, c) in m 'each'
		_ = keep(c)
	end 'each'
	return 0
end 'main'

// expect-error: E3900 at 20:12
