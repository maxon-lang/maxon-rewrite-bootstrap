typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
end 'Shape'

type Square implements Shape
	var side as Integer

	static function make(side Integer) returns Self
		return Self{side: side}
	end 'make'

	function area() returns Integer
		return side
	end 'area'
end 'Square'

type Plain
	var n as Integer

	static function make(n Integer) returns Self
		return Self{n: n}
	end 'make'
end 'Plain'

type Holder
	var shape as Shape

	static function make(consumes shape Shape) returns Self
		return Self{shape: shape}
	end 'make'
end 'Holder'

type Txn implements Shape
	var id as Integer

	static function begin(id Integer) returns Self
		return Self{id: id}
	end 'begin'

	function area() returns Integer
		return id
	end 'area'
	function commit(destructs self)
	end 'commit'
end 'Txn'

function main() returns ExitCode
	let h = Holder.make(Txn.begin(1))
	return 0
end 'main'

