// expect-error: E3005 at 14:17
typealias CellPool = SlotMap with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var p = CellPool.create()
	print("{(try p.get(0) otherwise panic("the slot key names no element")).n}")
	return 0
end 'main'
