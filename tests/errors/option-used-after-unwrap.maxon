// expect-error: E3102 at 16:10
typealias CellArray = array with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var a = CellArray.new()
	let o = a.pop()
	let c = o.unwrap()
	print("{o.isSome()} {c.n}")
	return 0
end 'main'
