// expect-error: E3102 at 15:10
typealias CellArray = Array with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	let o = Option.some(Cell.make(1))
	let c = o.unwrap()
	print("{o.isSome()} {c.n}")
	return 0
end 'main'
