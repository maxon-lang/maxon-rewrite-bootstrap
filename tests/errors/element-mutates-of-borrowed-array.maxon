// expect-error: E2013 at 15:9
type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 1
end 'touch'

function f(a Array with Cell)
	touch(a[0])
end 'f'

function main() returns ExitCode
	return 0
end 'main'
