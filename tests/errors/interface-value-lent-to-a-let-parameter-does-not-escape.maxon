typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
	function done(consumes self) returns Integer
end 'Shape'

type Square implements Shape
	var side as Integer

	function area() returns Integer
		return side
	end 'area'

	function done(consumes self) returns Integer
		return side
	end 'done'
end 'Square'

type Holder
	var s as Shape
end 'Holder'

typealias Shapes = Array with Shape

function take(consumes s Shape) returns Integer
	return s.area()
end 'take'

typealias Reader = function() returns Integer

// A `let` parameter of an interface type is lent a box that lives in the caller's frame, so nothing may keep it.
function returned(item Shape) returns Shape
	return item
end 'returned'

function stored(item Shape, mutates h Holder)
	h.s = item
end 'stored'

function pushed(item Shape, mutates a Shapes)
	a.push(item)
end 'pushed'

function captured(item Shape) returns Reader
	return function() gives item.area()
end 'captured'

function recovered(item Shape) returns Integer
	let sq = try item as Square otherwise panic("not a square")
	return sq.side
end 'recovered'

function consumedReceiver(item Shape) returns Integer
	return item.done()
end 'consumedReceiver'

function main() returns ExitCode
	return 0
end 'main'

