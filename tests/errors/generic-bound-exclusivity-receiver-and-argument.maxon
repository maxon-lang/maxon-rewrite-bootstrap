typealias Score = int(i64.min to i64.max)

interface Shape
	function area() returns Score
	function grow(inout self, by Score)
	function dispose(sink self)
	function absorb(inout self, other Self)
end 'Shape'

function twice[T implements Shape](a inout T)
	a.absorb(a)
end 'twice'

function main() returns ExitCode
	return 0
end 'main'

