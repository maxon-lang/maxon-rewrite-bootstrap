// expect-error: E3125 at 30:8
type Doc
	export var title as String
	export var n as Count
	export var words as array[Count]

	static function make(consumes title String) returns Doc
		return Doc{title: title, n: 1, words: array[Count].new()}
	end 'make'

	function grow(mutates self)
		n = n + 1
	end 'grow'

	function peek() returns Count
		return n
	end 'peek'
end 'Doc'

function bump(mutates x Count)
	x = x + 1
end 'bump'

function take(consumes d Doc)
	let kept = d
end 'take'

function main() returns ExitCode
	let d = freeze(Doc.make("a"))
	d.grow()
	return 0
end 'main'
