// expect-error: E3900 at 61:15
// expect-error: E3186 at 67:2
// expect-error: E3186 at 70:9
// expect-error: E3901 at 70:15
// A place a throwing method lends is a borrow as any other: a let bound to it keeps the receiver lent while it lives, so
// changing the receiver is E3186, and a non-scalar moved out of it, returned or passed to a consumes parameter, is E3901,
// whose fix is '.clone()'; a scalar read out of it is a value.
typealias Integer = int(i64.min to i64.max)

type Cell
	export var n as Integer
	export var name as String

	static function make(n Integer, consumes name String) returns Cell
		return Cell{n: n, name: name}
	end 'make'
end 'Cell'

type Pair
	var left as Cell
	var right as Cell
	var count as Integer

	static function make() returns Pair
		return Pair{left: Cell.make(1, name: "l"), right: Cell.make(2, name: "r"), count: 0}
	end 'make'

	function pick(mutates self, which Integer) returns borrowed Cell throws ArrayError
		if which == 0 'left'
			return left
		end 'left'
		if which == 1 'right'
			return right
		end 'right'
		throw ArrayError.indexOutOfBounds
	end 'pick'

	function look(which Integer) returns borrowed Cell throws ArrayError
		if which == 0 'left'
			return left
		end 'left'
		if which != 1 'none'
			throw ArrayError.emptySlot
		end 'none'
		return right
	end 'look'

	function keep(mutates self, consumes c Cell)
		left = c
	end 'keep'

	function counter(mutates self, open bool) returns borrowed Integer throws ArrayError
		if not open 'closed'
			throw ArrayError.emptySlot
		end 'closed'
		return count
	end 'counter'
end 'Pair'

function first(p Pair) returns Cell throws ArrayError
	return try p.look(0)
end 'first'

function main() returns ExitCode
	var p = Pair.make()
	let left = try p.look(0) otherwise panic("left")
	p.keep(Cell.make(5, name: "new"))
	print("{left.n}\n")
	var q = Pair.make()
	q.keep(try q.look(1) otherwise panic("right"))
	let n = try q.counter(true) otherwise 0
	q.keep(Cell.make(n, name: "counted"))
	return 0
end 'main'
