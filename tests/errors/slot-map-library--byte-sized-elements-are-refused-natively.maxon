// expect-error: E9000
// A SlotMap of byte-sized elements is refused natively for now: its array packs them, and a packed element has no word of
// its own to lend.
typealias Bytes = SlotMap with Byte

function main() returns ExitCode
	var b = Bytes.create()
	let k = b.insert(7)
	print("{try b.get(k) otherwise 0}\n")
	return 0
end 'main'
