// expect-error: E3111 at 14:10
typealias CellArray = array with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function f() returns Cell
	var a = CellArray.new()
	return a[0]
end 'f'

function main() returns ExitCode
	return 0
end 'main'
