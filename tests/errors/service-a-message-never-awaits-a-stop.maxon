export typealias Amount = int(0 to 1000000)

type Peer
	var n as Amount

	static function create() returns Self
		return Self{n: 1}
	end 'create'

	export function value() returns Amount
		return self.n
	end 'value'
end 'Peer'

type Asker
	var got as Amount

	static function create() returns Self
		return Self{got: 0}
	end 'create'

	export function ask(mutates self, peer Peer.handle)
		let done = peer.stopped()
		await done
	end 'ask'
end 'Asker'

function main() returns ExitCode
	let peer = spawn Peer.create()
	let asker = spawn Asker.create()
	try asker.ask(peer.clone()) otherwise ignore
	return 0
end 'main'

