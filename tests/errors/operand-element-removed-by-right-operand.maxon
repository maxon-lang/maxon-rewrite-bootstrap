// expect-error: E3186 at 16:18
typealias Names = Array with String

function label(n Count) returns String
	return "n{n}"
end 'label'

function wipe(mutates a Names) returns String
	_ = try a.remove(0) otherwise panic("index out of range")
	return "x"
end 'wipe'

function main() returns ExitCode
	var a = Names.create(0)
	a.push(label(1))
	if a[0] == wipe(a) 'eq'
		print("eq\n")
	end 'eq'
	return 0
end 'main'
