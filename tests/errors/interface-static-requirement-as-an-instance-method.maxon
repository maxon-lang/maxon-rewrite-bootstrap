typealias Code = int(0 to u32.max)

interface Wide
	static function tag() returns Code
end 'Wide'

// expect-error: E3016 at 8:6
type Point implements Wide
	export var x as Code

	function tag() returns Code
		return self.x
	end 'tag'
end 'Point'

function main() returns ExitCode
	return 0
end 'main'
