// expect-error: E3005 at 18:12
typealias CellPool = pool with Cell

typealias CountPool = pool with Count

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var p = CellPool.new()
	var q = CountPool.new()
	let h = q.insert(1)
	print("{p[h].n}")
	return 0
end 'main'
