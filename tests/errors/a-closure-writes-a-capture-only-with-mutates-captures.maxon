typealias Bump = function() returns Count

function increment(mutates n Count) returns Count
	n = try n + 1 otherwise 0
	return n
end 'increment'

function run(f Bump) returns Count
	return f()
end 'run'

function main() returns ExitCode
	var count = 0 as Count
	print("{run(function() gives increment(count))}\n")
	return 0
end 'main'

