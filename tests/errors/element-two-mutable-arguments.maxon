// expect-error: E3112 at 16:17
type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function pair(a mutable Cell, b mutable Cell)
	a.n = b.n
end 'pair'

function main() returns ExitCode
	var a = array[Cell].new()
	pair(a[0], b: a[1])
	return 0
end 'main'
