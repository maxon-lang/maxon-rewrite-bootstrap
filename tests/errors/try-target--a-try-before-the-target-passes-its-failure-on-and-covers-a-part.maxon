// expect-error: E2001 at 45:2
// expect-error: E2001 at 46:2
// A try before an assignment's target passes the failure on, so one with an 'otherwise' is refused, and it covers a
// field or an element of what a call lends, so a variable takes none.
typealias Integer = int(i64.min to i64.max)

type Node
	export var visited as bool
	export var weight as Integer

	static function make(weight Integer) returns Node
		return Node{visited: false, weight: weight}
	end 'make'
end 'Node'

type Graph
	var a as Node
	var b as Node

	static function make() returns Graph
		return Graph{a: Node.make(1), b: Node.make(2)}
	end 'make'

	function look(key Integer) returns borrowed Node throws ArrayError
		if key == 0 'a'
			return a
		end 'a'
		throw ArrayError.emptySlot
	end 'look'

	function get(mutates self, key Integer) returns borrowed Node throws ArrayError
		if key == 0 'a'
			return a
		end 'a'
		if key == 1 'b'
			return b
		end 'b'
		throw ArrayError.emptySlot
	end 'get'
end 'Graph'

function main() returns ExitCode
	var g = Graph.make()
	var n = 0 as Integer
	try g.get(0).visited otherwise panic("a") = true
	try n = 3
	print("{n}\n")
	return 0
end 'main'
