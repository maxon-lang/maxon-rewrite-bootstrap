typealias Score = int(i64.min to i64.max)

type Box
	export var v as Score
	export var name as String

	function describe() returns String
		return name.copy()
	end 'describe'

	function rename(mutates self, consumes value String)
		name = value
	end 'rename'

	function bump(mutates self, by Score)
		v = v + by
	end 'bump'

	static function create(v Score, consumes name String) returns Box
		return Box{v: v, name: name}
	end 'create'
end 'Box'

union Item
	named(name String)
	anonymous
end 'Item'

function replace(mutates item Item, name String)
	item = Item.named(name.copy())
end 'replace'

function main() returns ExitCode
	var item = Item.named("x")
	match item 'm'
		named(n) then replace(item, name: n)
		anonymous then print("none\n")
	end 'm'
	return 0
end 'main'

