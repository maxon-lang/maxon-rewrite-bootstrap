// expect-error: E3900 at 16:11
type Holder
	export var a as String
	export var b as String

	static function make() returns Holder
		return Holder{a: "x", b: "y"}
	end 'make'

	function both() returns borrowed (String, String)
		return (a, b)
	end 'both'
end 'Holder'

function pair(h Holder) returns (String, String)
	return h.both()
end 'pair'

function main() returns ExitCode
	let h = Holder.make()
	let (p, q) = pair(h)
	print("{p} {q}")
	return 0
end 'main'
