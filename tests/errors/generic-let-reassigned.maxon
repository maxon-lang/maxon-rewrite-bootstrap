typealias Score = int(i64.min to i64.max)

type Box uses T
	var item as T
	let tag as Score

	static function make(consumes item T, tag Score) returns Self
		return Self{item: item, tag: tag}
	end 'make'

	function peek() returns T
		return item.copy()
	end 'peek'

	function replace(mutates self, consumes next T)
		item = next
	end 'replace'

	function bump(mutates self, by Score)
		var next = by
		next = next + 1
	end 'bump'
end 'Box'

union Slot uses T
	full(value T)
	empty
end 'Slot'

function swap(mutates a T, mutates b T) uses T
	var tmp = a.copy()
	a = b.copy()
	b = tmp
end 'swap'

function join(mutates a T, consumes b T) uses T
	a = b
end 'join'

function fill(sets out T, from T) uses T
	out = from.copy()
end 'fill'

function consume(consumes a T) uses T returns Score
	return 1
end 'consume'

function again(a T, b T) uses T
	let x = a.copy()
	x = b.copy()
end 'again'

function main() returns ExitCode
	return 0
end 'main'

