typealias Score = int(i64.min to i64.max)

interface Shape
	function area() returns Score
end 'Shape'

interface Other
	function area() returns Score
end 'Other'

type Square implements Shape
	var side as Score
	static function make(side Score) returns Square
		return Square{side: side}
	end 'make'
	function area() returns Score
		return side * side
	end 'area'
end 'Square'

type Plain
	var n as Score
	static function make(n Score) returns Plain
		return Plain{n: n}
	end 'make'
end 'Plain'

type Box[T implements Shape]
	var item as T
end 'Box'

type Wrap[T]
	var inner as T
	static function make(inner sink T) returns Self
		return Self{inner: inner}
	end 'make'
end 'Wrap'

function sizeOf[T implements Shape](a T) returns Score
	return a.area()
end 'sizeOf'

function id[T](a sink T) returns T
	return a
end 'id'

function nest[T](x sink T, depth Score) returns Score
	if depth > 0 'more'
		return nest(Wrap[T].make(x), depth: depth - 1)
	end 'more'
	return 0
end 'nest'

function start() returns Score
	return nest(Plain.make(1), depth: 3)
end 'start'

function main() returns ExitCode
	return 0
end 'main'

