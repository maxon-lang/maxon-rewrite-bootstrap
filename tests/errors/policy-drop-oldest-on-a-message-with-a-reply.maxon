type Store
	var last as Count

	static function create() returns Self
		return Self{last: 0}
	end 'create'

	@policy(DropOldest) export function put(mutates self, value Count) returns Count
		self.last = value
		return value
	end 'put'
end 'Store'

function main() returns ExitCode
	return 0
end 'main'

