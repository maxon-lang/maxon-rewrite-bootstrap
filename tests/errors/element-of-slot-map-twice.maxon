// expect-error: E3186 at 25:73
typealias CellArray = Array with Cell

typealias CellPool = SlotMap with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function pair(mutates a Cell, mutates b Cell)
	a.n = b.n
end 'pair'

function make() returns Array with Cell
	return CellArray.create(0)
end 'make'

function main() returns ExitCode
	var p = CellPool.create()
	let h = p.insert(Cell.make(1))
	pair(try p.get(h) otherwise panic("the slot key names no element"), b: try p.get(h) otherwise panic("the slot key names no element"))
	return 0
end 'main'
