// expect-error: E2013 at 6:11
type Box uses T where T implements Copyable
	var item as T

	function reset(mutates self)
		replace(self)
	end 'reset'
end 'Box'

function replace(mutates b Box with T) uses T where T implements Copyable
	b.item = b.item.clone()
end 'replace'

function main() returns ExitCode
	return 0
end 'main'
