typealias Score = int(i64.min to i64.max)

type Box uses T
	var item as T
	let tag as Score

	static function make(consumes item T, tag Score) returns Self
		return Self{item: item, tag: tag}
	end 'make'

	function peek() returns T where T implements Copyable
		return item.clone()
	end 'peek'

	function replace(mutates self, consumes next T)
		item = next
	end 'replace'

	function note(mutates self, value Score)
		let seen = value
	end 'note'
end 'Box'

union Slot uses T
	full(value T)
	empty
end 'Slot'

function swap(mutates a T, mutates b T) uses T where T implements Copyable
	var tmp = a.clone()
	a = b.clone()
	b = tmp
end 'swap'

function join(mutates a T, consumes b T) uses T
	a = b
end 'join'

function fill(sets out T, from T) uses T where T implements Copyable
	out = from.clone()
end 'fill'

function consume(consumes a T) uses T returns Score
	return 1
end 'consume'

function reset(mutates b Box with T, value Score) uses T where T implements Copyable
	b.note(value)
end 'reset'

function grow(mutates b Box with T) uses T where T implements Copyable
	reset(b, value: b.tag)
end 'grow'

function main() returns ExitCode
	return 0
end 'main'

