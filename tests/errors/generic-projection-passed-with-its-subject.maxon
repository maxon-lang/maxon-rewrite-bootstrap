typealias Score = int(i64.min to i64.max)

type Box uses T
	var item as T
	let tag as Score

	static function make(consumes item T, tag Score) returns Self
		return Self{item: item, tag: tag}
	end 'make'

	function peek() returns T where T implements Copyable
		return item.copy()
	end 'peek'

	function replace(mutates self, consumes next T)
		item = next
	end 'replace'

	function bump(mutates self, by Score)
		var next = by
		next = next + 1
	end 'bump'
end 'Box'

union Slot uses T
	full(value T)
	empty
end 'Slot'

function swap(mutates a T, mutates b T) uses T where T implements Copyable
	var tmp = a.copy()
	a = b.copy()
	b = tmp
end 'swap'

function join(mutates a T, consumes b T) uses T
	a = b
end 'join'

function fill(sets out T, from T) uses T where T implements Copyable
	out = from.copy()
end 'fill'

function consume(consumes a T) uses T returns Score
	return 1
end 'consume'

function reopen(mutates slot Slot with T, again Slot with T) uses T where T implements Copyable
	slot = again.copy()
end 'reopen'

function visit(mutates slot Slot with T, fresh Slot with T) uses T where T implements Copyable
	match slot 'm'
		full(v) then reopen(slot, again: fresh.copy())
		empty then print("empty\n")
	end 'm'
end 'visit'

function main() returns ExitCode
	return 0
end 'main'

