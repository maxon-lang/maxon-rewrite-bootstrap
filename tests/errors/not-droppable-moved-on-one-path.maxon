type Txn
	var id as Count

	static function begin() returns Txn
		return Txn{id: 1}
	end 'begin'

	function commit(destructs self)
		print("commit\n")
	end 'commit'
end 'Txn'

function main() returns ExitCode
	let t = Txn.begin()
	if true 'f'
		t.commit()
	end 'f'
	return 0
end 'main'

