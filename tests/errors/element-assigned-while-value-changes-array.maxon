// expect-error: E3186 at 18:16
typealias CellArray = Array with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function drop(mutates xs Array with Cell) returns Count
	return xs.count()
end 'drop'

function main() returns ExitCode
	var a = CellArray.create(0)
	a[0].n = drop(a)
	return 0
end 'main'
