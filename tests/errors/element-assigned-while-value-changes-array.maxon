// expect-error: E3112 at 16:16
type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function drop(mutates xs array[Cell]) returns Count
	return xs.count()
end 'drop'

function main() returns ExitCode
	var a = array[Cell].new()
	a[0].n = drop(a)
	return 0
end 'main'
