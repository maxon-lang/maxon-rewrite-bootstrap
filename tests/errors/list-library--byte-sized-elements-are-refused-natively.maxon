// expect-error: E9000
// A List of byte-sized elements is refused natively for now, as a SlotMap of them is: its array packs them, and a packed
// element has no word of its own to lend.
typealias Bytes = List with Byte

function main() returns ExitCode
	var b = Bytes.create()
	b.append(7)
	print("{try b.get(0) otherwise 0}\n")
	return 0
end 'main'
