typealias Score = int(i64.min to i64.max)

type Box
	export var v as Score

	static function create(v Score) returns Box
		return Box{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var a = Box.create(1)
	let b = a
	print("{a.v} {b.v}\n")
	a = Box.create(2)
	print("{a.v}\n")
	return 0
end 'main'

// expect-error: E3102
// expect-no-error: E3077
