// expect-error: E3915 at 15:11
typealias CountArray = array with Count

type Acct
	export var balance as Count
	export var tag as String

	static function make(balance Count) returns Acct
		return Acct{balance: balance, tag: "t"}
	end 'make'
end 'Acct'

function main() returns ExitCode
	let c = cown(CountArray.new())
	print("{c[0]}")
	return 0
end 'main'
