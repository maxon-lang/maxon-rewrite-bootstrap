// expect-error: E3102 at 31:10
type Doc
	export var title as String
	export var n as Count
	export var words as array[Count]
	static function make(title sink String) returns Doc
		return Doc{title: title, n: 1, words: array[Count].new()}
	end 'make'
	function grow(inout self)
		n = n + 1
	end 'grow'
	function peek() returns Count
		return n
	end 'peek'
end 'Doc'

function bump(x inout Count)
	x = x + 1
end 'bump'

function take(d sink Doc)
	let kept = d
end 'take'

function main() returns ExitCode
	let c = cown(Doc.make("a"))
	let f = freeze(Doc.make("b"))
	when c as x 'use'
		print("{f.title}")
	end 'use'
	print("{f.title}")
	return 0
end 'main'
