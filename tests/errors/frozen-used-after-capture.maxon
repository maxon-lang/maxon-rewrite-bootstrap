// expect-error: E3102 at 36:10
typealias CountArray = array with Count

type Doc
	export var title as String
	export var n as Count
	export var words as array with Count

	static function make(consumes title String) returns Doc
		return Doc{title: title, n: 1, words: CountArray.new()}
	end 'make'

	function reset(mutates self)
		n = 0
	end 'reset'

	function peek() returns Count
		return n
	end 'peek'
end 'Doc'

function zero(mutates x Count)
	x = 0
end 'zero'

function take(consumes d Doc)
	let kept = d
end 'take'

function main() returns ExitCode
	let c = cown(Doc.make("a"))
	let f = freeze(Doc.make("b"))
	when c as x 'use'
		print("{f.title}")
	end 'use'
	print("{f.title}")
	return 0
end 'main'
