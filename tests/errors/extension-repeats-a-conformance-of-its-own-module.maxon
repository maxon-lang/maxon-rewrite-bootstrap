typealias Integer = int(i64.min to i64.max)

interface Sized
	function size() returns Integer
end 'Sized'

type Box
	var n as Integer
end 'Box'

extension Box implements Sized
	function size() returns Integer
		return n
	end 'size'
end 'Box'

extension Box implements Sized
end 'Box'

function main() returns ExitCode
	return 0
end 'main'

