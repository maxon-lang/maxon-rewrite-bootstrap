// expect-error: E2013 at 14:2
type Cell
	export var n as Count
	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function make() returns array[Cell]
	return array[Cell].new()
end 'make'

function main() returns ExitCode
	make()[0] = Cell.make(1)
	return 0
end 'main'
