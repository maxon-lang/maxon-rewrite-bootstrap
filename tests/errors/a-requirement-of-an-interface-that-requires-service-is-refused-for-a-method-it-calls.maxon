// Only the methods that meet a requirement are held to the rules, and a method of the same type that meets none may wait; it
// is refused when a requirement's method calls it, as the method that makes the call (E3210).
export typealias Amount = int(0 to 1000000)

interface Route requires service
	function handle(request Amount) returns Amount
end 'Route'

service Ledger
	var total as Amount

	static function create() returns Self
		return Self{total: 0}
	end 'create'

	@policy(Keep) export function read() returns Amount
		return self.total
	end 'read'
end 'Ledger'

type Audit implements Route
	var ledger as Ledger.handle

	static function make(consumes ledger Ledger.handle) returns Self
		return Self{ledger: ledger}
	end 'make'

	function total() returns Amount
		return try await self.ledger.read() otherwise 0
	end 'total'

	function handle(request Amount) returns Amount
		return self.total()
	end 'handle'
end 'Audit'

function main() returns ExitCode
	let audit = Audit.make(spawn Ledger.create())
	print("{audit.handle(1)}\n")
	return 0
end 'main'

// expect-error: E3210 at 32:2
