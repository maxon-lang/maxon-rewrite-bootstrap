// expect-error: E3017 at 21:7
// clear drops every element, so a List's clear needs elements that can be dropped: a list of values with destructors is
// emptied by taking each out and ended with dropEmpty.
typealias Txns = List with Txn

type Txn
	var id as Count

	static function begin(id Count) returns Txn
		return Txn{id: id}
	end 'begin'

	function commit(destructs self)
		print("commit {id}\n")
	end 'commit'
end 'Txn'

function main() returns ExitCode
	var txns = Txns.create()
	txns.append(Txn.begin(1))
	txns.clear()
	txns.dropEmpty()
	return 0
end 'main'
