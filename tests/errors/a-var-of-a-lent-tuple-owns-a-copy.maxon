// expect-error: E3900 at 17:7
type Holder
	export var a as String
	export var b as String

	static function make() returns Holder
		return Holder{a: "x", b: "y"}
	end 'make'

	function both() returns borrowed (String, String)
		return (a, b)
	end 'both'
end 'Holder'

function main() returns ExitCode
	let h = Holder.make()
	var (p, _) = h.both()
	p.append("!")
	return 0
end 'main'
