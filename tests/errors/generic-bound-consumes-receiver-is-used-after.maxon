typealias Score = int(i64.min to i64.max)

interface Shape
	function area() returns Score
	function grow(mutates self, by Score)
	function dispose(consumes self)
	function absorb(mutates self, other Self)
end 'Shape'

function drop(consumes a T) uses T returns Score where T implements Shape
	a.dispose()
	return a.area()
end 'drop'

function main() returns ExitCode
	return 0
end 'main'

