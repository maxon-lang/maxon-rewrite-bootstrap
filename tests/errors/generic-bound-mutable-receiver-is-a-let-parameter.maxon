typealias Score = int(i64.min to i64.max)

interface Shape
	function area() returns Score
	function grow(mutable self, by Score)
	function dispose(sink self)
	function absorb(mutable self, other Self)
end 'Shape'

function change[T implements Shape](a T)
	a.grow(1)
end 'change'

function main() returns ExitCode
	return 0
end 'main'

