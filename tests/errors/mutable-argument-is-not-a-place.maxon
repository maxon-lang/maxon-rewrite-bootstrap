typealias Score = int(i64.min to i64.max)

type Box
	export var v as Score
	export var name as String

	function describe() returns String
		return name.copy()
	end 'describe'

	function rename(mutable self, value sink String)
		name = value
	end 'rename'

	function bump(mutable self, by Score)
		v = v + by
	end 'bump'

	static function create(v Score, name sink String) returns Box
		return Box{v: v, name: name}
	end 'create'
end 'Box'

function bump(n mutable Score, by Score)
	n = n + by
end 'bump'

function make() returns Score
	return 3
end 'make'

function main() returns ExitCode
	bump(make(), by: 1)
	return 0
end 'main'

