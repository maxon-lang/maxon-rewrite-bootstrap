// expect-error: E3130 at 13:10
type Acct
	export var balance as Count
	export var tag as String

	static function make(balance Count) returns Acct
		return Acct{balance: balance, tag: "t"}
	end 'make'
end 'Acct'

function main() returns ExitCode
	let c = cown(Acct.make(1))
	when c, c as x, y 'outer'
		print("{x.balance}")
	end 'outer'
	return 0
end 'main'
