typealias Score = int(i64.min to i64.max)

type Box
	export var v as Score

	static function create(v Score) returns Box
		return Box{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var a = Box.create(1)
	for _ in 0 upto 3 'each'
		let b = a
		print("{b.v}\n")
	end 'each'
	a = Box.create(2)
	print("{a.v}\n")
	return 0
end 'main'

// expect-error: E3102
