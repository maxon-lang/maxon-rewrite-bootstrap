// expect-error: E3005 at 18:12
typealias CellPool = SlotMap with Cell

typealias CountPool = SlotMap with Count

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var p = CellPool.create()
	var q = CountPool.create()
	let h = q.insert(1)
	print("{p[h].n}")
	return 0
end 'main'
