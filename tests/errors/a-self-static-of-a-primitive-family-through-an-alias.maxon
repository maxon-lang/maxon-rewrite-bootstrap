// expect-error: E2015 at 17:15
// A static of the int family whose signature names Self is not yet instantiated for a typealias of an integer, so a call
// through one is refused rather than giving the family's type.
typealias Port = int(0 to 65535)

extension int
	static function seven() returns Self
		return 7
	end 'seven'
end 'int'

function takePort(p Port) returns Port
	return p
end 'takePort'

function main() returns ExitCode
	let p = Port.seven()
	print("{takePort(p)}\n")
	return 0
end 'main'
