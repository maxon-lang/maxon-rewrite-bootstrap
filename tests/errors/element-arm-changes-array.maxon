union Option uses T
	some(value T)
	none

	function isSome() returns bool
		return match self 'o'
			some(v) gives true
			none gives false
		end 'o'
	end 'isSome'

	function unwrap(consumes self) returns T
		match consumes self 'o'
			some(value) then return value
			none then panic("unwrap of an Option that holds no value")
		end 'o'
	end 'unwrap'
end 'Option'

// expect-error: E3186 at 36:16
typealias CellOption = Option with Cell

typealias CellOptionArray = Array with (Option with Cell)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var a = CellOptionArray.create(0)
	match a[0] 'm'
		some(c) then a.push(CellOption.none)
		none then print("none")
	end 'm'
	return 0
end 'main'
