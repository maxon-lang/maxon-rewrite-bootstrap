// expect-error: E3112 at 12:16
type Cell
	export var n as Count
	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var a = array[Option[Cell]].new()
	match a[0] 'm'
		some(c) then a.append(Option[Cell].none)
		none then print("none")
	end 'm'
	return 0
end 'main'
