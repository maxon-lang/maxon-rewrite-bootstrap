// expect-error: E3186 at 17:16
typealias CellOption = Option with Cell

typealias CellOptionArray = Array with (Option with Cell)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function main() returns ExitCode
	var a = CellOptionArray.create(0)
	match a[0] 'm'
		some(c) then a.push(CellOption.none)
		none then print("none")
	end 'm'
	return 0
end 'main'
