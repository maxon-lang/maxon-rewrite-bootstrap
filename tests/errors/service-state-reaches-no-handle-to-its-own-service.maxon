export typealias Amount = int(0 to 1000000)

type Echo
	var me as Array with Echo.handle

	static function create() returns Self
		return Self{me: Array.create(0)}
	end 'create'
end 'Echo'

function main() returns ExitCode
	let h = spawn Echo.create()
	return 0
end 'main'

