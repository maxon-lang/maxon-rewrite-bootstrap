// The event queue: a green thread waits on an event entry until another, after a sleep, signals it (a completion packet on
// Windows, the entry's eventfd on Linux), and the event queue readies the waiter; then a signal that comes before the wait
// is taken by the wait at once.
//> a completion readied its waiter
//> a completion before the wait was taken

let testSleepNanos = 20000000 as Count

function main() returns ExitCode
	greenReady(greenSpawn(__Raw.codeAddress("testCoordinator")))
	return 0
end 'main'

function testCoordinator(g Count) returns Count
	let entry = eventUserNew()
	let signaller = greenSpawn(__Raw.codeAddress("testSignaller"))
	greenSetArgument(signaller, index: 0, value: entry)
	greenReady(signaller)
	testReady(eventWait(entry, mode: eventRead, deadline: eventNoDeadline))
	testWrite("a completion readied its waiter\n")
	_ = greenAwait(signaller)
	eventSignal(entry)
	greenSleep(testSleepNanos)
	testReady(eventWait(entry, mode: eventRead, deadline: eventNoDeadline))
	testWrite("a completion before the wait was taken\n")
	eventUserFree(entry)
	return 0
end 'testCoordinator'

function testSignaller(g Count) returns Count
	greenSleep(testSleepNanos)
	eventSignal(greenArgument(g, index: 0))
	return 0
end 'testSignaller'

function testReady(status Count)
	if status != eventReady 'other'
		panic("a wait on a signalled entry ended otherwise")
	end 'other'
end 'testReady'

function testWrite(text String)
	write(__Raw.loadWord(__Raw.stdoutAddress(), offset: 0), text: text)
end 'testWrite'
