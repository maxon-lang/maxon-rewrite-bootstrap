// Timers: testSleepers green threads sleep for durations from testStepNanos to ten times it, all at once, each checking
// by the clock that it woke no earlier than it asked, and a sleep of 0 returns; the coordinator awaits them all. A break of
// the event queue's wait allocates nothing: the thread that idles the last processor breaks it as the main thread counts
// the live boxes at the end, which a box of the break's own would add to, as one of macOS did.
//> 50 sleepers woke, none early, a break allocated nothing

let testSleepers = 50 as Count

let testStepNanos = 3000000 as Count

let testSteps = 10 as Count

function main() returns ExitCode
	greenReady(greenSpawn(__Raw.codeAddress("testCoordinator")))
	return 0
end 'main'

function testCoordinator(g Count) returns Count
	greenSleep(0)
	let list = alloc(testSleepers * wordBytes)
	for i in 0 upto testSleepers 'spawn'
		let sleeper = greenSpawn(__Raw.codeAddress("testSleeper"))
		greenSetArgument(sleeper, index: 0, value: (try i mod testSteps otherwise 0) + 1)
		__Raw.storeWord(list, offset: i * wordBytes, value: sleeper)
		greenReady(sleeper)
	end 'spawn'
	for i in 0 upto testSleepers 'await'
		_ = greenAwait(__Raw.loadWord(list, offset: i * wordBytes))
	end 'await'
	free(list)
	let scheduler = __Raw.loadWord(__Raw.threadContext(), offset: contextSchedulerOffset)
	let allocs = processHeapCount(heapAllocsOffset)
	sendBreak(scheduler)
	if processHeapCount(heapAllocsOffset) != allocs 'allocated'
		panic("a break of the event queue's wait allocated")
	end 'allocated'
	testWrite("{testSleepers} sleepers woke, none early, a break allocated nothing\n")
	return 0
end 'testCoordinator'

function testSleeper(g Count) returns Count
	let nanos = try greenArgument(g, index: 0) * testStepNanos otherwise panic("a sleep past a word")
	let start = osClockNanos()
	greenSleep(nanos)
	if __Raw.wrappingSub(osClockNanos(), right: start) < nanos 'early'
		panic("a sleeper woke early")
	end 'early'
	return 0
end 'testSleeper'

function testWrite(text String)
	write(__Raw.loadWord(__Raw.stdoutAddress(), offset: 0), text: text)
end 'testWrite'
