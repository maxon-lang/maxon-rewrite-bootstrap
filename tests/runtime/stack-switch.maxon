// The entry stub's code for green threads, used by hand: two stacks that rt.stackSwitch switches between, the second
// started at rt.greenStart, the link's table of the code a green thread may be stopped in, and a thread stopped where it
// spins and made to return into rt.asyncPreempt, by SuspendThread and SetThreadContext on Windows and by the preemption
// signal, whose handler rewrites the signal's context, on Linux and macOS. The code the trampoline calls writes the return address
// the stop kept and acknowledges the stop by clearing the context's pending preemption, which ends the spin.
//> switched 1000 times, sum 500500
//> preemptible: the test's code yes, the runtime's alloc no
//> stopped where it spun, and went on

let testRounds = 1000 as Count

let testStackBytes = 1048576 as Count

// The record the two stacks share: the green stack's count and sum, and the two pairs of switch records that
// rt.stackSwitch takes, main's then the green stack's to go on the green stack, and the reverse to come back. The pairs
// are the test's own, not the thread context's, which the runtime's park of main's green thread writes: the monitor may
// stop main between a write of the context's pair and the switch, and the switch would then take the park's records.
let testCountOffset = 0 as Count

let testSumOffset = 8 as Count

let testToGreenOffset = 16 as Count

let testToMainOffset = 32 as Count

let testRecordBytes = 48 as Count

// The record of a stop, past the stopped thread's context, where both threads find it: 1 once the thread spins, what it
// is stopped by (its handle or its thread id), the address it was stopped at and the word that rt.asyncPreempt returns
// through, and 1 once it has gone on. The thread stores the flags with release and the stopper reads them with acquire,
// so a stopper that sees the thread spin sees what it is stopped by: with plain stores and loads arm64 may show the flag
// before the id, and a signal to thread 0 stops nothing, which left both threads spinning until the run timed out.
let testSpinningOffset = 0 as Count

let testTargetOffset = 8 as Count

let testResumeOffset = 16 as Count

let testSlotOffset = 24 as Count

let testDoneOffset = 32 as Count

let testStopBytes = 40 as Count

let testPending = 1 as Count

#if os(Windows)
	let testSuspendFailed = 0xFFFFFFFF as Count
#endif

function main() returns ExitCode
	testSwitching()
	testTable()
	testStopping()
	return 0
end 'main'

function testWrite(text String)
	write(__Raw.loadWord(__Raw.stdoutAddress(), offset: 0), text: text)
end 'testWrite'

// testSwitching switches to the green stack and back testRounds times; each time on it, the green stack counts and adds.
function testSwitching()
	let record = alloc(testRecordBytes)
	let mainSwitch = alloc(switchBytes)
	let greenSwitch = alloc(switchBytes)
	__Raw.storeWord(record, offset: testToGreenOffset, value: mainSwitch)
	__Raw.storeWord(record, offset: __Raw.wrappingAdd(testToGreenOffset, right: wordBytes), value: greenSwitch)
	__Raw.storeWord(record, offset: testToMainOffset, value: greenSwitch)
	__Raw.storeWord(record, offset: __Raw.wrappingAdd(testToMainOffset, right: wordBytes), value: mainSwitch)
	let low = testStack()
	let top = __Raw.wrappingAdd(low, right: testStackBytes)
	let sp = __Raw.wrappingSub(top, right: __Raw.wrappingAdd(wordBytes, right: wordBytes))
	__Raw.storeWord(sp, offset: 0, value: __Raw.greenStartAddress())
	__Raw.storeWord(greenSwitch, offset: switchSpOffset, value: sp)
	__Raw.storeWord(greenSwitch, offset: switchRbxOffset, value: record)
	__Raw.storeWord(greenSwitch, offset: switchR12Offset, value: __Raw.codeAddress("testGreenBody"))
	__Raw.storeWord(greenSwitch, offset: switchStackBaseOffset, value: top)
	__Raw.storeWord(greenSwitch, offset: switchStackLimitOffset, value: low)
	__Raw.storeWord(greenSwitch, offset: switchStackLowOffset, value: low)
	for i in 0 upto testRounds 'rounds'
		testSwitch(__Raw.wrappingAdd(record, right: testToGreenOffset))
		if __Raw.loadWord(record, offset: testCountOffset) != __Raw.wrappingAdd(i, right: 1) 'count'
			panic("the green stack did not run once for each switch to it")
		end 'count'
	end 'rounds'
	testWrite("switched ")
	testWrite(itoa(__Raw.loadWord(record, offset: testCountOffset), unsigned: true))
	testWrite(" times, sum ")
	testWrite(itoa(__Raw.loadWord(record, offset: testSumOffset), unsigned: true))
	testWrite("\n")
	free(greenSwitch)
	free(mainSwitch)
	free(record)
end 'testSwitching'

// testGreenBody runs on the green stack, which rt.greenStart started with the shared record, and never returns.
function testGreenBody(record Count)
	while true 'rounds'
		let count = __Raw.wrappingAdd(__Raw.loadWord(record, offset: testCountOffset), right: 1)
		__Raw.storeWord(record, offset: testCountOffset, value: count)
		__Raw.storeWord(record, offset: testSumOffset, value: __Raw.wrappingAdd(__Raw.loadWord(record, offset: testSumOffset), right: count))
		testSwitch(__Raw.wrappingAdd(record, right: testToMainOffset))
	end 'rounds'
end 'testGreenBody'

// testSwitch leaves the running stack for the one of the second switch record of a pair, saving it into the first.
function testSwitch(pair Count)
	_ = __Raw.callCode1(__Raw.stackSwitchAddress(), arg1: pair)
end 'testSwitch'

// testStack is the lowest address of testStackBytes of committed memory, which the process keeps.
function testStack() returns Count
	return keep(testStackBytes)
end 'testStack'

function testTable()
	let table = __Raw.preemptibleCodeAddress()
	testWrite("preemptible: the test's code ")
	testWrite(testYesNo(testPreemptible(table, address: __Raw.codeAddress("testGreenBody"))))
	testWrite(", the runtime's alloc ")
	testWrite(testYesNo(testPreemptible(table, address: __Raw.codeAddress("alloc"))))
	testWrite("\n")
end 'testTable'

function testYesNo(yes bool) returns String
	if yes 'yes'
		return "yes"
	end 'yes'
	return "no"
end 'testYesNo'

// testPreemptible is whether an address of the code is in a range of the table, whose words say how far below the table
// each range starts and ends.
function testPreemptible(table Count, address Count) returns bool
	let below = __Raw.wrappingSub(table, right: address)
	let ranges = __Raw.loadWord(table, offset: 0)
	for i in 0 upto ranges 'ranges'
		let slot = __Raw.wrappingAdd(table, right: try (i + i + 1) * wordBytes otherwise panic("the table is past memory"))
		if below <= __Raw.loadWord(slot, offset: 0) and below > __Raw.loadWord(slot, offset: wordBytes) 'inside'
			return true
		end 'inside'
	end 'ranges'
	return false
end 'testPreemptible'

// testStopping stops a thread of its own where it spins, until the code that rt.asyncPreempt calls clears the pending
// preemption of that thread's context. The thread holds no processor and runs no green thread, so the monitor, which may
// stop main's green thread whenever it has run long enough, never stops it, and the stop and the preemption code the
// test sets are the only ones it sees.
function testStopping()
	let spinner = keep(__Raw.wrappingAdd(contextBytes, right: testStopBytes))
	let stop = __Raw.wrappingAdd(spinner, right: contextBytes)
	__Raw.storeWord(spinner, offset: contextStartCodeOffset, value: __Raw.codeAddress("testSpinner"))
	__Raw.storeWord(spinner, offset: contextPreemptCodeOffset, value: __Raw.codeAddress("testPreempted"))
	__Raw.storeWord(spinner, offset: contextSignalPendingOffset, value: testPending)
	#if os(Linux) or os(macOS)
		__Raw.storeWord(spinner, offset: contextSignalCodeOffset, value: __Raw.codeAddress("testSignal"))
	#endif
	startThread(spinner)
	testAwait(stop, offset: testSpinningOffset)
	let target = __Raw.loadWord(stop, offset: testTargetOffset)
	if target == 0 'unseen'
		panic("the spinning thread's handle or id is not seen after it says it spins")
	end 'unseen'
	#if os(Windows)
		if dword(__Raw.callImport1("SuspendThread", arg1: target)) == testSuspendFailed 'suspend'
			panic("cannot suspend the spinning thread")
		end 'suspend'
		let buffer = alloc(__Raw.wrappingAdd(windowsContextBytes, right: windowsContextAlignment))
		let registers = __Raw.wrappingAdd(buffer, right: __Raw.wrappingSub(windowsContextAlignment, right: buffer mod windowsContextAlignment))
		__Raw.storeWord32(registers, offset: windowsContextFlagsOffset, value: windowsContextControl)
		if __Raw.callImport2("GetThreadContext", arg1: target, arg2: registers) == 0 'read'
			panic("cannot read the spinning thread's registers")
		end 'read'
		let slot = testResumeAt(stop, instruction: __Raw.loadWord(registers, offset: windowsContextRipOffset), stackPointer: __Raw.loadWord(registers, offset: windowsContextRspOffset))
		__Raw.storeWord(registers, offset: windowsContextRspOffset, value: slot)
		__Raw.storeWord(registers, offset: windowsContextRipOffset, value: __Raw.asyncPreemptAddress())
		if __Raw.callImport2("SetThreadContext", arg1: target, arg2: registers) == 0 'write'
			panic("cannot set the spinning thread's registers")
		end 'write'
		_ = __Raw.callImport1("ResumeThread", arg1: target)
		free(buffer)
	#else
		signalThread(target)
	#endif
	testAwait(stop, offset: testDoneOffset)
	#if os(Windows)
		closeHandle(target)
	#endif
	testWrite("stopped where it spun, and went on\n")
end 'testStopping'

// testAwait spins until the word of the stop record at offset is not 0, read with acquire, so what the thread stored
// before it is seen.
function testAwait(stop Count, offset Count)
	while __Raw.loadAcquire(stop, offset: offset) == 0 'wait'
		__Raw.spinPause()
	end 'wait'
end 'testAwait'

// testSpinner is the thread that is stopped: it takes what it is stopped by as the runtime's threads do, which on Linux
// and macOS also lets the signal through, says what that is, then spins until its stop is acknowledged.
function testSpinner(context Count)
	let stop = __Raw.wrappingAdd(context, right: contextBytes)
	setThreadIdentity(context)
	__Raw.storeWord(stop, offset: testTargetOffset, value: __Raw.loadWord(context, offset: contextThreadOffset))
	__Raw.storeRelease(stop, offset: testSpinningOffset, value: 1)
	while __Raw.loadWord(context, offset: contextSignalPendingOffset) != 0 'spin'
		__Raw.spinPause()
	end 'spin'
	__Raw.storeRelease(stop, offset: testDoneOffset, value: 1)
end 'testSpinner'

// testResumeAt is the runtime's resumeAt for the stop record: the stop keeps the address and the slot below the stack
// pointer, and leaves the stopped thread's stack to that thread, which alone may grow it through its guard page.
function testResumeAt(stop Count, instruction Count, stackPointer Count) returns Count
	let slot = __Raw.wrappingSub(stackPointer, right: wordBytes)
	__Raw.storeWord(stop, offset: testResumeOffset, value: instruction)
	__Raw.storeWord(stop, offset: testSlotOffset, value: slot)
	return slot
end 'testResumeAt'

// testPreempted is what rt.asyncPreempt calls on the stopped thread, with its context, as asyncPreempted is: it writes the
// address the thread was stopped at as rt.asyncPreempt's return, and acknowledges the stop.
function testPreempted(context Count)
	let stop = __Raw.wrappingAdd(context, right: contextBytes)
	__Raw.storeWord(__Raw.loadWord(stop, offset: testSlotOffset), offset: 0, value: __Raw.loadWord(stop, offset: testResumeOffset))
	__Raw.storeWord(context, offset: contextSignalPendingOffset, value: 0)
end 'testPreempted'

#if os(Linux) or os(macOS)
	// testSignal is what rt.preemptHandler calls with the signal's context on the stopped thread: it makes the stopped
	// code return into rt.asyncPreempt.
	function testSignal(signalContext Count)
		let stop = __Raw.wrappingAdd(__Raw.threadContext(), right: contextBytes)
		let pc = signalPcAddress(signalContext)
		let sp = signalSpAddress(signalContext)
		let slot = testResumeAt(stop, instruction: __Raw.loadWord(pc, offset: 0), stackPointer: __Raw.loadWord(sp, offset: 0))
		// x64's rt.asyncPreempt returns through the slot, which the stop moves the stack pointer to; arm64's branches through
		// it below the stack pointer it was stopped at.
		#if arch(x64)
			__Raw.storeWord(sp, offset: 0, value: slot)
		#endif
		__Raw.storeWord(pc, offset: 0, value: __Raw.asyncPreemptAddress())
	end 'testSignal'
#endif
