// The scheduler without `when`: behaviour records made by hand, whose run is testRun. Each behaviour adds its depth to
// its wave's tally and, above depth 0, schedules testFanOut children a level down from the thread it runs on, so each
// root makes a known tree of behaviours. main, a green thread, parks until the last behaviour of the first wave readies
// it and reports the wave; the second it leaves scheduled when it returns, so the entry's drain runs it, and the last of
// its behaviours reports it and sets the exit code, which replaces main's. Run many times with MAXON_MAX_PROCS at 1, 2
// and unset, it is what holds the queues and the parking to losing nothing.
// expect-exit: 5
//> wave 1: 174760 behaviours, depth sum 58232
//> wave 2: 174760 behaviours, depth sum 58232

let testFanOut = 4 as Count

let testDepth = 7 as Count

let testRoots = 8 as Count

// A test behaviour's record: the header that the scheduler reads, then its depth and the address of its wave's tally.
// A constant cannot be computed from another file's, so main checks that the depth is where the header ends.
let testDepthOffset = 24 as Count

let testTallyOffset = 32 as Count

let testRecordBytes = 40 as Count

// A wave's tally: how many of its behaviours have not finished, how many ran, the sum of their depths, its number, and the
// green thread its last behaviour readies, or 0.
let tallyRemainingOffset = 0 as Count

let tallyBehavioursOffset = 8 as Count

let tallyDepthSumOffset = 16 as Count

let tallyWaveOffset = 24 as Count

let tallyWaiterOffset = 32 as Count

let tallyBytes = 40 as Count

let reportedWave = 2 as Count

let reportedExit = 5 as Count

function main() returns ExitCode
	if testDepthOffset != behaviourSlotsOffset 'layout'
		panic("the test's record does not start where the behaviour header ends")
	end 'layout'
	let first = testWave(1, waiter: greenCurrent())
	greenPark()
	testReport(first)
	free(first)
	_ = testWave(reportedWave, waiter: 0)
	return 0
end 'main'

// testWave schedules a wave's roots and gives its tally.
function testWave(wave Count, waiter Count) returns Count
	let tally = alloc(tallyBytes)
	__Raw.storeWord(tally, offset: tallyRemainingOffset, value: try testRoots * testTreeSize() otherwise panic("the waves are too large"))
	__Raw.storeWord(tally, offset: tallyWaveOffset, value: wave)
	__Raw.storeWord(tally, offset: tallyWaiterOffset, value: waiter)
	for i in 0 upto testRoots 'roots'
		testSchedule(tally, depth: testDepth)
	end 'roots'
	return tally
end 'testWave'

// testTreeSize is how many behaviours a root makes.
function testTreeSize() returns Count
	var size = 0 as Count
	var level = 1 as Count
	for i in 0 upto testDepth + 1 'levels'
		size = try size + level otherwise panic("the trees are too large")
		level = try level * testFanOut otherwise panic("the trees are too large")
	end 'levels'
	return size
end 'testTreeSize'

function testSchedule(tally Count, depth Count)
	let record = alloc(testRecordBytes)
	__Raw.storeWord(record, offset: behaviourRunOffset, value: __Raw.codeAddress("testRun"))
	__Raw.storeWord(record, offset: testDepthOffset, value: depth)
	__Raw.storeWord(record, offset: testTallyOffset, value: tally)
	schedEnter()
	schedPush(record)
end 'testSchedule'

// testRun is a behaviour: it counts itself, schedules its children, frees its record, and when it is the last of the
// reported wave writes the tally and sets the exit code, and the last of the other readies main.
function testRun(record Count)
	let depth = __Raw.loadWord(record, offset: testDepthOffset)
	let tally = __Raw.loadWord(record, offset: testTallyOffset)
	free(record)
	_ = __Raw.atomicAdd(tally, offset: tallyBehavioursOffset, value: 1)
	_ = __Raw.atomicAdd(tally, offset: tallyDepthSumOffset, value: depth)
	if depth > 0 'children'
		for i in 0 upto testFanOut 'childrenBlock'
			testSchedule(tally, depth: depth - 1)
		end 'childrenBlock'
	end 'children'
	if __Raw.atomicAdd(tally, offset: tallyRemainingOffset, value: stepDown) == 1 'last'
		if __Raw.loadWord(tally, offset: tallyWaveOffset) == reportedWave 'reported'
			testReport(tally)
			free(tally)
			osSetExitCode(reportedExit)
		end 'reported' else 'waited'
			greenReady(__Raw.loadWord(tally, offset: tallyWaiterOffset))
		end 'waited'
	end 'last'
end 'testRun'

function testReport(tally Count)
	let handle = __Raw.loadWord(__Raw.stdoutAddress(), offset: 0)
	write(handle, text: "wave ")
	write(handle, text: itoa(__Raw.loadWord(tally, offset: tallyWaveOffset), unsigned: true))
	write(handle, text: ": ")
	write(handle, text: itoa(__Raw.loadWord(tally, offset: tallyBehavioursOffset), unsigned: true))
	write(handle, text: " behaviours, depth sum ")
	write(handle, text: itoa(__Raw.loadWord(tally, offset: tallyDepthSumOffset), unsigned: true))
	write(handle, text: "\n")
end 'testReport'
