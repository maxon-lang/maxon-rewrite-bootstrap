// The 128-bit vectors of the runtime's source: each __Raw vector intrinsic against the words it must give, a load at an
// unaligned address and a store back, and a function that holds more vectors live than the target has registers, so that
// its vectors are spilled and reloaded whole. A vector is no parameter and is held across no call (E5900), so each result is
// taken apart into its two words before the checks are written.
//> load ok
//> store ok
//> xor ok
//> and ok
//> or ok
//> addLanes32 ok
//> shuffleBytes ok
//> shuffleBytes zero ok
//> shiftBytesUp ok
//> shiftBytesDown ok
//> shiftLanesLeft ok
//> shiftLanesRight ok
//> zero ok
//> spilled ok

let testBufferBytes = 64 as Count

let testLoadOffset = 3 as Count

let testStoreOffset = 32 as Count

let testHighOffset = 8 as Count

function main() returns ExitCode
	let buffer = alloc(testBufferBytes)
	for i in 0 upto testBufferBytes 'fill'
		__Raw.storeByte(buffer, offset: i, value: i as Byte)
	end 'fill'
	let v = __Raw.vectorLoad(buffer, offset: testLoadOffset)
	let low0 = __Raw.vectorWord(v, lane: 0)
	let high0 = __Raw.vectorWord(v, lane: 1)
	__Raw.vectorStore(buffer, offset: testStoreOffset, value: v)
	let w = __Raw.vectorOfWords(0xFF00FF00FF00FF00, high: 0x0F0F0F0F0F0F0F0F)
	let xored = __Raw.vectorXor(v, right: w)
	let low1 = __Raw.vectorWord(xored, lane: 0)
	let high1 = __Raw.vectorWord(xored, lane: 1)
	let anded = __Raw.vectorAnd(v, right: w)
	let low2 = __Raw.vectorWord(anded, lane: 0)
	let high2 = __Raw.vectorWord(anded, lane: 1)
	let ored = __Raw.vectorOr(v, right: w)
	let low3 = __Raw.vectorWord(ored, lane: 0)
	let high3 = __Raw.vectorWord(ored, lane: 1)
	let doubled = __Raw.vectorAddLanes32(v, right: v)
	let low4 = __Raw.vectorWord(doubled, lane: 0)
	let high4 = __Raw.vectorWord(doubled, lane: 1)
	let reversed = __Raw.vectorShuffleBytes(v, picks: __Raw.vectorOfWords(0x08090A0B0C0D0E0F, high: 0x0001020304050607))
	let low5 = __Raw.vectorWord(reversed, lane: 0)
	let high5 = __Raw.vectorWord(reversed, lane: 1)
	let cleared = __Raw.vectorShuffleBytes(v, picks: __Raw.vectorOfWords(0x8080808080808080, high: 0x0000000000000080))
	let low6 = __Raw.vectorWord(cleared, lane: 0)
	let high6 = __Raw.vectorWord(cleared, lane: 1)
	let up = __Raw.vectorShiftBytesUp(v, bytes: 1)
	let low7 = __Raw.vectorWord(up, lane: 0)
	let high7 = __Raw.vectorWord(up, lane: 1)
	let down = __Raw.vectorShiftBytesDown(v, bytes: 1)
	let low8 = __Raw.vectorWord(down, lane: 0)
	let high8 = __Raw.vectorWord(down, lane: 1)
	let left = __Raw.vectorShiftLanesLeft(v, bits: 8)
	let low9 = __Raw.vectorWord(left, lane: 0)
	let high9 = __Raw.vectorWord(left, lane: 1)
	let right = __Raw.vectorShiftLanesRight(v, bits: 8)
	let low10 = __Raw.vectorWord(right, lane: 0)
	let high10 = __Raw.vectorWord(right, lane: 1)
	let zero = __Raw.vectorZero()
	let low11 = __Raw.vectorWord(zero, lane: 0)
	let high11 = __Raw.vectorWord(zero, lane: 1)
	testExpect("load", low: low0, high: high0, wantLow: 0x0A09080706050403, wantHigh: 0x1211100F0E0D0C0B)
	testExpect("store", low: __Raw.loadWord(buffer, offset: testStoreOffset), high: __Raw.loadWord(buffer, offset: testStoreOffset + testHighOffset), wantLow: 0x0A09080706050403, wantHigh: 0x1211100F0E0D0C0B)
	testExpect("xor", low: low1, high: high1, wantLow: 0xF509F707F905FB03, wantHigh: 0x1D1E1F0001020304)
	testExpect("and", low: low2, high: high2, wantLow: 0x0A00080006000400, wantHigh: 0x0201000F0E0D0C0B)
	testExpect("or", low: low3, high: high3, wantLow: 0xFF09FF07FF05FF03, wantHigh: 0x1F1F1F0F0F0F0F0F)
	testExpect("addLanes32", low: low4, high: high4, wantLow: 0x1412100E0C0A0806, wantHigh: 0x2422201E1C1A1816)
	testExpect("shuffleBytes", low: low5, high: high5, wantLow: 0x0B0C0D0E0F101112, wantHigh: 0x030405060708090A)
	testExpect("shuffleBytes zero", low: low6, high: high6, wantLow: 0, wantHigh: 0x0303030303030300)
	testExpect("shiftBytesUp", low: low7, high: high7, wantLow: 0x0908070605040300, wantHigh: 0x11100F0E0D0C0B0A)
	testExpect("shiftBytesDown", low: low8, high: high8, wantLow: 0x0B0A090807060504, wantHigh: 0x001211100F0E0D0C)
	testExpect("shiftLanesLeft", low: low9, high: high9, wantLow: 0x0908070605040300, wantHigh: 0x11100F0E0D0C0B00)
	testExpect("shiftLanesRight", low: low10, high: high10, wantLow: 0x000A090807060504, wantHigh: 0x001211100F0E0D0C)
	testExpect("zero", low: low11, high: high11, wantLow: 0, wantHigh: 0)
	testSpilled()
	free(buffer)
	return 0
end 'main'

// testSpilled holds forty vectors at once, more than x64's sixteen xmm registers and arm64's thirty-two, so that some are
// spilled and reloaded whole, and folds them in an order that reads each after the last is made.
function testSpilled()
	let a0 = __Raw.vectorOfWords(1, high: 101)
	let a1 = __Raw.vectorOfWords(2, high: 102)
	let a2 = __Raw.vectorOfWords(4, high: 104)
	let a3 = __Raw.vectorOfWords(8, high: 108)
	let a4 = __Raw.vectorOfWords(16, high: 116)
	let a5 = __Raw.vectorOfWords(32, high: 132)
	let a6 = __Raw.vectorOfWords(64, high: 164)
	let a7 = __Raw.vectorOfWords(128, high: 228)
	let a8 = __Raw.vectorOfWords(256, high: 356)
	let a9 = __Raw.vectorOfWords(512, high: 612)
	let b0 = __Raw.vectorOfWords(1024, high: 1124)
	let b1 = __Raw.vectorOfWords(2048, high: 2148)
	let b2 = __Raw.vectorOfWords(4096, high: 4196)
	let b3 = __Raw.vectorOfWords(8192, high: 8292)
	let b4 = __Raw.vectorOfWords(16384, high: 16484)
	let b5 = __Raw.vectorOfWords(32768, high: 32868)
	let b6 = __Raw.vectorOfWords(65536, high: 65636)
	let b7 = __Raw.vectorOfWords(131072, high: 131172)
	let b8 = __Raw.vectorOfWords(262144, high: 262244)
	let b9 = __Raw.vectorOfWords(524288, high: 524388)
	let c0 = __Raw.vectorOfWords(1048576, high: 1048676)
	let c1 = __Raw.vectorOfWords(2097152, high: 2097252)
	let c2 = __Raw.vectorOfWords(4194304, high: 4194404)
	let c3 = __Raw.vectorOfWords(8388608, high: 8388708)
	let c4 = __Raw.vectorOfWords(16777216, high: 16777316)
	let c5 = __Raw.vectorOfWords(33554432, high: 33554532)
	let c6 = __Raw.vectorOfWords(67108864, high: 67108964)
	let c7 = __Raw.vectorOfWords(134217728, high: 134217828)
	let c8 = __Raw.vectorOfWords(268435456, high: 268435556)
	let c9 = __Raw.vectorOfWords(536870912, high: 536871012)
	let d0 = __Raw.vectorOfWords(1073741824, high: 1073741924)
	let d1 = __Raw.vectorOfWords(2147483648, high: 2147483748)
	let d2 = __Raw.vectorOfWords(4294967296, high: 4294967396)
	let d3 = __Raw.vectorOfWords(8589934592, high: 8589934692)
	let d4 = __Raw.vectorOfWords(17179869184, high: 17179869284)
	let d5 = __Raw.vectorOfWords(34359738368, high: 34359738468)
	let d6 = __Raw.vectorOfWords(68719476736, high: 68719476836)
	let d7 = __Raw.vectorOfWords(137438953472, high: 137438953572)
	let d8 = __Raw.vectorOfWords(274877906944, high: 274877907044)
	let d9 = __Raw.vectorOfWords(549755813888, high: 549755813988)
	var sum = __Raw.vectorXor(d9, right: d8)
	sum = __Raw.vectorXor(sum, right: d7)
	sum = __Raw.vectorXor(sum, right: d6)
	sum = __Raw.vectorXor(sum, right: d5)
	sum = __Raw.vectorXor(sum, right: d4)
	sum = __Raw.vectorXor(sum, right: d3)
	sum = __Raw.vectorXor(sum, right: d2)
	sum = __Raw.vectorXor(sum, right: d1)
	sum = __Raw.vectorXor(sum, right: d0)
	sum = __Raw.vectorXor(sum, right: c9)
	sum = __Raw.vectorXor(sum, right: c8)
	sum = __Raw.vectorXor(sum, right: c7)
	sum = __Raw.vectorXor(sum, right: c6)
	sum = __Raw.vectorXor(sum, right: c5)
	sum = __Raw.vectorXor(sum, right: c4)
	sum = __Raw.vectorXor(sum, right: c3)
	sum = __Raw.vectorXor(sum, right: c2)
	sum = __Raw.vectorXor(sum, right: c1)
	sum = __Raw.vectorXor(sum, right: c0)
	sum = __Raw.vectorXor(sum, right: b9)
	sum = __Raw.vectorXor(sum, right: b8)
	sum = __Raw.vectorXor(sum, right: b7)
	sum = __Raw.vectorXor(sum, right: b6)
	sum = __Raw.vectorXor(sum, right: b5)
	sum = __Raw.vectorXor(sum, right: b4)
	sum = __Raw.vectorXor(sum, right: b3)
	sum = __Raw.vectorXor(sum, right: b2)
	sum = __Raw.vectorXor(sum, right: b1)
	sum = __Raw.vectorXor(sum, right: b0)
	sum = __Raw.vectorXor(sum, right: a9)
	sum = __Raw.vectorXor(sum, right: a8)
	sum = __Raw.vectorXor(sum, right: a7)
	sum = __Raw.vectorXor(sum, right: a6)
	sum = __Raw.vectorXor(sum, right: a5)
	sum = __Raw.vectorXor(sum, right: a4)
	sum = __Raw.vectorXor(sum, right: a3)
	sum = __Raw.vectorXor(sum, right: a2)
	sum = __Raw.vectorXor(sum, right: a1)
	sum = __Raw.vectorXor(sum, right: a0)
	let low = __Raw.vectorWord(sum, lane: 0)
	let high = __Raw.vectorWord(sum, lane: 1)
	testExpect("spilled", low: low, high: high, wantLow: 1099511627775, wantHigh: testHighs())
end 'testSpilled'

// testHighs is the exclusive or of the high words testSpilled makes its vectors of.
function testHighs() returns Count
	var high = 0 as Count
	var low = 1 as Count
	for _ in 0 upto 40 'each'
		high = high xor __Raw.wrappingAdd(low, right: 100)
		low = __Raw.wrappingAdd(low, right: low)
	end 'each'
	return high
end 'testHighs'

function testExpect(name String, low Count, high Count, wantLow Count, wantHigh Count)
	if low == wantLow and high == wantHigh 'same'
		testWrite("{name} ok\n")
		return
	end 'same'
	testWrite("{name} gave {itoa(low, unsigned: true)} {itoa(high, unsigned: true)}\n")
end 'testExpect'

function testWrite(text String)
	write(__Raw.loadWord(__Raw.stdoutAddress(), offset: 0), text: text)
end 'testWrite'
