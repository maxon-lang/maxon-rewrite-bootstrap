// testFillState writes SHA-256's initial state, a to h, each a little-endian 32-bit word.
function testFillState(at Count)
	__Raw.storeWord(at, offset: 0, value: 0xBB67AE856A09E667)
	__Raw.storeWord(at, offset: 8, value: 0xA54FF53A3C6EF372)
	__Raw.storeWord(at, offset: 16, value: 0x9B05688C510E527F)
	__Raw.storeWord(at, offset: 24, value: 0x5BE0CD191F83D9AB)
end 'testFillState'

// testDigestMatches is whether the state at an address is FIPS 180-4's SHA-256 of "abc".
function testDigestMatches(at Count) returns bool
	return __Raw.loadWord(at, offset: 0) == 0x8F01CFEABA7816BF and __Raw.loadWord(at, offset: 8) == 0x5DAE2223414140DE and __Raw.loadWord(at, offset: 16) == 0x96177A9CB00361A3 and __Raw.loadWord(at, offset: 24) == 0xF20015ADB410FF61
end 'testDigestMatches'
