// String building: a short string made by interpolation and an append for each item, and a scan of its bytes.
typealias Word = int(0 to u64.max)

let items = 300000 as Count

let modulus = 1000003 as Word

function work() returns ExitCode
	var checksum = 0 as Word
	var total = 0 as Word
	for i in 0 upto items 'items'
		var line = "item {i}"
		line.append(", value {i mod 97}")
		for at in 0 upto line.byteLength() 'bytes'
			checksum = try (checksum * 31 + line.byteAt(at)) mod modulus otherwise panic("checksum overflowed")
		end 'bytes'
		total = try total + (line.byteLength() as Word) otherwise panic("total overflowed")
	end 'items'
	print("{total} {checksum}\n")
	return 0
end 'work'

// main times the work, which bench.ps1 reads from the line it prints after the result.
function main() returns ExitCode
	let started = Clock.nowNanos()
	let code = work()
	let elapsed = try Clock.nowNanos() - started otherwise panic("the clock went backwards")
	print("work ns {elapsed}\n")
	return code
end 'main'

//> 6157960 434762
