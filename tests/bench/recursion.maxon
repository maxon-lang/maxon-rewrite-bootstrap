// A recursive function: calls and returns with a checked add at each level.
typealias Word = int(0 to u64.max)

let argument = 38 as Word

function fib(n Word) returns Word
	if n < 2 'base'
		return n
	end 'base'
	return try fib(n - 1) + fib(n - 2) otherwise panic("fib overflowed")
end 'fib'

function work() returns ExitCode
	print("{fib(argument)}\n")
	return 0
end 'work'

// main times the work, which bench.ps1 reads from the line it prints after the result.
function main() returns ExitCode
	let started = Clock.nowNanos()
	let code = work()
	let elapsed = try Clock.nowNanos() - started otherwise panic("the clock went backwards")
	print("work ns {elapsed}\n")
	return code
end 'main'

//> 39088169
