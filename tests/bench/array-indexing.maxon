// Array indexing: a sum over an array of words by index and a scan of a string's bytes by position, the element reads
// that a compiler's own passes are made of.
typealias Word = int(0 to u64.max)

typealias Words = Array with Word

let size = 10000 as Count

let rounds = 20000 as Count

let spread = 1000 as Count

// lap prints the time of the phase that began at since, which bench.ps1 and cmd/bench read from the line, and gives the
// time the next one begins.
function lap(phase String, since InstantNanos) returns InstantNanos
	let now = Clock.nowNanos()
	let elapsed = try (now - since) otherwise panic("the clock went backwards")
	print("{phase} ns {elapsed}\n")
	return now
end 'lap'

function work() returns ExitCode
	var started = Clock.nowNanos()
	var a = Words.create(0)
	var text = ""
	for i in 0 upto size 'fill'
		a.push((i mod spread) as Word)
		text = "{text}{i mod 10}"
	end 'fill'
	started = lap("fill", since: started)
	var sum = 0 as Word
	var high = 0 as Word
	for _ in 0 upto rounds 'rounds'
		for i in 0 upto a.count() 'sum'
			sum = try sum + a[i] otherwise panic("sum overflowed")
		end 'sum'
		for at in 0 upto text.byteLength() 'scan'
			if text.byteAt(at) > 52 'high'
				high = try high + 1 otherwise panic("count overflowed")
			end 'high'
		end 'scan'
	end 'rounds'
	started = lap("rounds", since: started)
	print("{sum} {high}\n")
	return 0
end 'work'

// main times the work, which bench.ps1 reads from the line it prints after the result.
function main() returns ExitCode
	let started = Clock.nowNanos()
	let code = work()
	let elapsed = try Clock.nowNanos() - started otherwise panic("the clock went backwards")
	print("work ns {elapsed}\n")
	return code
end 'main'

//> 99900000000 100000000
