typealias Score = int(i64.min to i64.max)

typealias Digit = int(0 to 9)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 0
end 'touch'

typealias Small = int(0 to 100)

function f(rows Digit, columns Digit, x Small) returns Count
	var total = 0 as Count
	for r in 0 upto rows 'rows'
		for c in 0 upto columns 'columns'
			total = total + (x as Count)
		end 'columns'
		total = total + 1
	end 'rows'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'
