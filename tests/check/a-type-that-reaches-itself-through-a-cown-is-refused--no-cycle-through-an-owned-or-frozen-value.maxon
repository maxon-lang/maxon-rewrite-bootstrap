union Option uses T
	some(value T)
	none

	function isSome() returns bool
		return match self 'o'
			some(v) gives true
			none gives false
		end 'o'
	end 'isSome'

	function unwrap(consumes self) returns T
		match consumes self 'o'
			some(value) then return value
			none then panic("unwrap of an Option that holds no value")
		end 'o'
	end 'unwrap'
end 'Option'

typealias LinkFrozenOption = Option with (frozen with Link)

type Link
	export var rest as Option with (frozen with Link)

	static function make() returns Link
		return Link{rest: LinkFrozenOption.none}
	end 'make'
end 'Link'

function main() returns ExitCode
	return 0
end 'main'
