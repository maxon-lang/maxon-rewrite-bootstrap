typealias Score = int(i64.min to i64.max)

typealias Digit = int(0 to 9)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 0
end 'touch'

function f(n Count) returns Digit
	return (n mod 10) as Digit
end 'f'

function g(n Count) returns Digit
	return (n and 7) as Digit
end 'g'

function main() returns ExitCode
	return 0
end 'main'
