function sumOf(items Array with Count) returns Count throws ArithmeticError
	var sum = 0 as Count
	for i in 0 upto items.count() 'each'
		sum = try sum + items[i]
	end 'each'
	return sum
end 'sumOf'

function drop(mutates items Array with Count)
	let last = try items.pop() otherwise 0
	items[0] = 1
end 'drop'

function lookup(m Map with (Count, Count), k Count) returns Count
	return (try m.get(k) otherwise panic("no such key"))
end 'lookup'

function overwrite(mutates n Count, value Count)
	n = value
end 'overwrite'

function build() returns Count
	var p = CountPool.create()
	let h = p.insert(1)
	overwrite(try p.get(h) otherwise panic("the slot key names no element"), value: 2)
	let copied = p.clone()
	return 0
end 'build'

function main() returns ExitCode
	return 0
end 'main'

typealias CountPool = SlotMap with Count
