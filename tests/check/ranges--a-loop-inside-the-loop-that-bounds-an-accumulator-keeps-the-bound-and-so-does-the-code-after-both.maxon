typealias Score = int(i64.min to i64.max)

typealias Digit = int(0 to 9)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 0
end 'touch'

function f(n Digit) returns Count
	var total = 0 as Count
	for i in 0 upto n 'outer'
		total = total + 1
		for j in 0 upto n 'inner'
			let next = total + 1
			if next > 0 'seen'
				total = total + 1
			end 'seen'
		end 'inner'
	end 'outer'
	return total + 1
end 'f'

function main() returns ExitCode
	return 0
end 'main'
