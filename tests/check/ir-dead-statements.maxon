typealias Score = int(i64.min to i64.max)

function keep(a T) uses T returns T where T implements Copyable
	return a.clone()
end 'keep'

function afterBothBranches(c bool) returns Score
	if c 'pick'
		return 4
	end 'pick' else 'other'
		return 5
	end 'other'
	return keep(6 as Score)
end 'afterBothBranches'

function main() returns ExitCode
	_ = afterBothBranches(true)
	return 0
end 'main'
