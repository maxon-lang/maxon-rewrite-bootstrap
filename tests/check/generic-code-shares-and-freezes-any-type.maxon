function wrap(consumes x T) uses T returns frozen with T where T implements Droppable
	return freeze(x)
end 'wrap'

function again(x frozen with T) uses T returns frozen with T
	return share(x)
end 'again'

function open(x frozen with T) uses T returns T where T implements Copyable
	return thaw(x)
end 'open'

function main() returns ExitCode
	let f = wrap("a")
	let g = again(f)
	let s = open(g)
	return 0
end 'main'
