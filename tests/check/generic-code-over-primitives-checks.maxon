union Option uses T
	some(value T)
	none

	function isSome() returns bool
		return match self 'o'
			some(v) gives true
			none gives false
		end 'o'
	end 'isSome'

	function unwrap(consumes self) returns T
		match consumes self 'o'
			some(value) then return value
			none then panic("unwrap of an Option that holds no value")
		end 'o'
	end 'unwrap'
end 'Option'

typealias CountArray = Array with Count

typealias CountArrayArray = Array with (Array with Count)

typealias CountList = List with Count

typealias CountPool = SlotMap with Count

typealias StringCountMap = Map with String, Count

function moveFirst(mutates source Array with T, mutates target Array with T) uses T
	if not source.isEmpty() 'some'
		target.push(try source.remove(0) otherwise panic("index out of range"))
	end 'some'
end 'moveFirst'

function store(mutates m Map with (String, V), consumes value V) uses V where V implements Droppable and Copyable
	m.upsert("key", value: value)
end 'store'

function put(mutates p SlotMap with T, consumes item T) uses T returns SlotKey with T
	return p.insert(item)
end 'put'

function rotate(mutates l List with T, consumes item T) uses T returns Count
	l.append(item)
	let first = try l.removeFirst() otherwise panic("the list has an element")
	l.append(first)
	return l.count()
end 'rotate'

function swapFirst(mutates a Array with T, mutates b Array with T) uses T where T implements Copyable
	let t = a[0].clone()
	a[0] = b[0].clone()
	b[0] = t
end 'swapFirst'

function find(p SlotMap with T, handle SlotKey with T) uses T returns Option with T where T implements Copyable
	if p.contains(handle) 'live'
		return Option.some((try p.get(handle) otherwise panic("the slot key names no element")).clone())
	end 'live'
	return Option.none
end 'find'

function nested(mutates grid Array with (Array with T), consumes item T) uses T
	grid[0].push(item)
end 'nested'

function main() returns ExitCode
	var a = CountArray.create(0)
	var b = CountArray.create(0)
	a.push(1)
	b.push(2)
	moveFirst(a, target: b)
	a.push(3)
	swapFirst(a, b: b)
	var m = StringCountMap.create()
	store(m, value: 1)
	var p = CountPool.create()
	let h = put(p, item: 4)
	var l = CountList.create()
	let n = rotate(l, item: 5)
	var grid = CountArrayArray.create(0)
	grid.push(CountArray.create(0))
	nested(grid, item: 6)
	print("{find(p, handle: h).isSome()} {n}")
	return 0
end 'main'
