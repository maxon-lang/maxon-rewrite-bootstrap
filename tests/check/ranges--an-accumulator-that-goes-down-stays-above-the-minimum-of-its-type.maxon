typealias Score = int(i64.min to i64.max)

typealias Digit = int(0 to 9)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 0
end 'touch'

function f(x Digit) returns Score
	var balance = 0 as Score
	for i in 0 to 9 'each'
		balance = balance - (x as Score)
	end 'each'
	return balance
end 'f'

function main() returns ExitCode
	return 0
end 'main'
