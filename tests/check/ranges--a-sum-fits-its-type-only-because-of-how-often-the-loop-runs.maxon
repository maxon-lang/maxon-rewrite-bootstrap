typealias Score = int(i64.min to i64.max)

typealias Digit = int(0 to 9)

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

function touch(mutates c Cell)
	c.n = 0
end 'touch'

typealias Small = int(0 to 100)

typealias Thousand = int(0 to 1000)

function f(x Small) returns Thousand
	var total = 0 as Thousand
	for i in 0 to 9 'ten'
		total = (x as Thousand) + total
	end 'ten'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'
