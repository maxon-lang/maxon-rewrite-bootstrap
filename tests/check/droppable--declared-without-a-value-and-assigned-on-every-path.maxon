typealias Score = int(i64.min to i64.max)

type Txn
	var id as Score

	static function begin() returns Txn
		return Txn{id: 1}
	end 'begin'

	function commit(destructs self)
		print("commit\n")
	end 'commit'

	function rollback(destructs self)
		print("rollback\n")
	end 'rollback'
end 'Txn'

union Step
	done(txn Txn)
	failed(txn Txn, note Score)
end 'Step'

function late(flag bool)
	var t as Txn
	if flag 'f'
		t = Txn.begin()
	end 'f' else 'g'
		t = Txn.begin()
	end 'g'
	t.commit()
end 'late'

function main() returns ExitCode
	return 0
end 'main'
