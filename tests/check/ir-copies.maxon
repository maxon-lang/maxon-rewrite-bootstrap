typealias StringArray = Array with String

typealias TreeArray = Array with Tree

type Tree
	var value as Count
	var name as String
	var kids = TreeArray.create(0)

	static function make() returns Tree
		return Tree{value: 1, name: "n"}
	end 'make'
end 'Tree'

function copies(t Tree, s String, n Count) returns Tree
	let a = s.clone()
	let b = n.clone()
	let c = StringArray.filled(3, value: s.clone())
	return t.clone()
end 'copies'

function takesMap(consumes m Map with (Count, Count)) returns Count
	return 0
end 'takesMap'

function takesTreeOfPools(consumes p SlotMap with Count, t Tree) returns Count
	return 0
end 'takesTreeOfPools'

function main() returns ExitCode
	return 0
end 'main'
