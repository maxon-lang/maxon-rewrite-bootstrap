// case: explicit type arguments
function main() returns ExitCode
	var a = 1 as Score
	var b = 2 as Score
	swap[Score](a, b: b)
	return 0
end 'main'

// case: inferred type arguments
function main() returns ExitCode
	var a = Square.create(1)
	var b = Square.create(2)
	swap(a, b: b)
	print("{total(a, b: b)}")
	return 0
end 'main'

// case: generic type and its field
function main() returns ExitCode
	var b = Box[String].make("x", tag: 1)
	b.replace("y")
	print("{b.peek()} {b.tag}")
	return 0
end 'main'

// case: nested instances
function main() returns ExitCode
	let b = Box[Box[Score]].make(Box[Score].make(1, tag: 2), tag: 3)
	print("{b.peek().tag}")
	return 0
end 'main'

// case: union instance
function main() returns ExitCode
	let s = Slot[String].full("x")
	match s 'm'
		full(v) then print(v)
		empty then print("none")
	end 'm'
	return 0
end 'main'

// case: union inferred from payload
function main() returns ExitCode
	let s = Slot.full(Square.create(1))
	match s 'm'
		full(v) then print("{v.area()}")
		empty then print("none")
	end 'm'
	return 0
end 'main'

// case: copy of a generic instance
function main() returns ExitCode
	let a = Box[String].make("x", tag: 1)
	let b = a.copy()
	print(b.peek())
	return 0
end 'main'
