// case: missing method
// expect-error: E3120
type Round implements Shape
	var r as Score

	function area() returns Score
		return r
	end 'area'
end 'Round'

function main() returns ExitCode
	return 0
end 'main'

// case: wrong return
// expect-error: E3120
type Round implements Shape
	var r as Score

	function area() returns String
		return "r"
	end 'area'

	function grow(mutates self, by Score)
		r = r + by
	end 'grow'
end 'Round'

function main() returns ExitCode
	return 0
end 'main'

// case: wrong convention
// expect-error: E3120
type Round implements Shape
	var r as Score

	function area() returns Score
		return r
	end 'area'

	function grow(by Score)
		print("x")
	end 'grow'
end 'Round'

function main() returns ExitCode
	return 0
end 'main'

// case: wrong parameter
// expect-error: E3120
type Round implements Shape
	var r as Score

	function area() returns Score
		return r
	end 'area'

	function grow(mutates self, by String)
		print(by)
	end 'grow'
end 'Round'

function main() returns ExitCode
	return 0
end 'main'
