// case: wrong number of type arguments
// expect-error: E3116
function main() returns ExitCode
	let b = Box[Score, Score].make(1, tag: 1)
	return 0
end 'main'

// case: generic type with no arguments
// expect-error: E3116
function f(b Box)
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: type arguments on a plain type
// expect-error: E3116
function f(p Plain[Score])
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: type arguments on a plain function
// expect-error: E3116
function plain(n Score) returns Score
	return n
end 'plain'

function main() returns ExitCode
	_ = plain[Score](1)
	return 0
end 'main'

// case: cannot infer from a constant
// expect-error: E3118
function main() returns ExitCode
	let b = Box.make(1, tag: 1)
	return 0
end 'main'

// case: interface as a type
// expect-error: E3119
function f(s Shape)
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: unknown method on an unbounded parameter
// expect-error: E3004
function f[T](a T) returns Score
	return a.area()
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: field of a type parameter
// expect-error: E3018
function f[T](a T) returns Score
	return a.tag
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: comparing type parameters
// expect-error: E3005
function f[T](a T, b T) returns bool
	return a == b
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: interpolating a type parameter
// expect-error: E3005
function f[T](a T) returns String
	return "{a}"
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: returning a different type parameter
// expect-error: E3005
function f[T, U](a T, b U) returns T
	return b.copy()
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: bound that is not an interface
// expect-error: E3123
function f[T implements Square](a T)
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'
