// case: wrong number of type arguments
// expect-error: E2056
typealias ScoreScoreBox = Box with Score, Score

function main() returns ExitCode
	let b = ScoreScoreBox.make(1, tag: 1)
	return 0
end 'main'

// case: generic type with no arguments
// expect-error: E2056
function f(b Box)
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: type arguments on a plain type
// expect-error: E2056
function f(p Plain with Score)
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: cannot infer from a constant
// expect-error: E3179
function main() returns ExitCode
	let b = Box.make(1, tag: 1)
	return 0
end 'main'

// case: interface as a type
// expect-error: E3905
function f(s Shape)
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: unknown method on an unbounded parameter
// expect-error: E3004
function f(a T) uses T returns Score
	return a.area()
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: field of a type parameter
// expect-error: E3018
function f(a T) uses T returns Score
	return a.tag
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: comparing type parameters
// expect-error: E3005
function f(a T, b T) uses T returns bool
	return a == b
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: interpolating a type parameter
// expect-error: E3005
function f(a T) uses T returns String
	return "{a}"
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: returning a different type parameter
// expect-error: E3005
function f(a T, b U) uses T, U returns T where U implements Copyable
	return b.copy()
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: bound that is not an interface
// expect-error: E3907
function f(a T) uses T where T implements Square
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'
