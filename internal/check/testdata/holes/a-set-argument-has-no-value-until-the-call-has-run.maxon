// case: a set argument is read by another argument
// expect-error: E3113
function main() returns ExitCode
	var s as String
	fill(s, from: s.copy())
	return 0
end 'main'

// case: a set argument is read after the call
function main() returns ExitCode
	var s as String
	fill(s, from: "a")
	print(s)
	return 0
end 'main'
