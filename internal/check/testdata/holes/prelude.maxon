type Label
	export var text as String

	static function make(consumes text String) returns Label
		return Label{text: text}
	end 'make'

	function resetOwn(mutates self)
		self.text = "x"
	end 'resetOwn'

	function again(mutates self)
		self.resetOwn()
		replaceText(self.text)
	end 'again'
end 'Label'

function replaceText(mutates t String)
	t = "z"
end 'replaceText'

function fill(sets out String, from String)
	out = from.copy()
end 'fill'
