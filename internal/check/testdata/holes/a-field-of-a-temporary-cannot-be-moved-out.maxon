// case: moving a field out of a temporary
// expect-error: E3901
function main() returns ExitCode
	let s = Label.make("a").text
	print(s)
	return 0
end 'main'

// case: copying a field out of a temporary
function main() returns ExitCode
	let s = Label.make("a").text.clone()
	print(s)
	return 0
end 'main'
