// case: a sets argument is read by another argument
// expect-error: E3902
function main() returns ExitCode
	var s as String
	fill(s, from: s.clone())
	return 0
end 'main'

// case: a sets argument is read after the call
function main() returns ExitCode
	var s as String
	fill(s, from: "a")
	print(s)
	return 0
end 'main'
