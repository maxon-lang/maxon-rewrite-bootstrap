// case: a local still holds its value when its scope ends
// expect-error: E3136
function main() returns ExitCode
	let t = Txn.begin()
	return 0
end 'main'

// case: a return leaves a local that holds its value
// expect-error: E3136
function f(flag bool)
	let t = Txn.begin()
	if flag 'f'
		return
	end 'f'
	t.commit()
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: moved on one branch only
// expect-error: E3136
function f(flag bool)
	let t = Txn.begin()
	if flag 'f'
		t.commit()
	end 'f'
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a break leaves a local that holds its value
// expect-error: E3136
function f()
	while true 'w'
		let t = Txn.begin()
		break
	end 'w'
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: assigned on one path only
// expect-error: E3136
function f(flag bool)
	var t as Txn
	if flag 'f'
		t = Txn.begin()
	end 'f'
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an assignment drops the old value
// expect-error: E3136
function main() returns ExitCode
	var t = Txn.begin()
	t = Txn.begin()
	t.commit()
	return 0
end 'main'

// case: a discard drops the value
// expect-error: E3136
function main() returns ExitCode
	_ = Txn.begin()
	return 0
end 'main'

// case: a result that nothing takes is dropped
// expect-error: E3136
function main() returns ExitCode
	Txn.begin()
	return 0
end 'main'

// case: a parameter that is never named is dropped
// expect-error: E3136
function f(consumes _ Txn)
	print("x")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a type parameter without the bound cannot die
// expect-error: E3136
function ignore(consumes x T) uses T
	print("x")
end 'ignore'

function main() returns ExitCode
	return 0
end 'main'

// case: an arm that does not name a payload drops it
// expect-error: E3136
function finish(consumes step Step)
	match consumes step 'which'
		done(_) then print("x")
		failed(t, note) then t.rollback()
	end 'which'
end 'finish'

function main() returns ExitCode
	return 0
end 'main'
