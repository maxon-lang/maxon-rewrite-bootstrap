typealias CountArray = Array with Count

typealias CountArrayArray = Array with (Array with Count)

typealias CountList = List with Count

typealias CountPool = Pool with Count

typealias StringCountMap = Map with String, Count

function moveFirst(mutates source Array with T, mutates target Array with T) uses T
	if not source.isEmpty() 'some'
		target.push(try source.remove(0) otherwise panic("index out of range"))
	end 'some'
end 'moveFirst'

function store(mutates m Map with (String, V), consumes value V) uses V where V implements Droppable
	m.upsert("key", value: value)
end 'store'

function put(mutates p Pool with T, consumes item T) uses T returns Handle with T
	return p.insert(item)
end 'put'

function back(mutates l List with T, consumes item T) uses T returns Handle with T
	let node = l.append(item)
	l.moveToFront(node)
	return node
end 'back'

function swapFirst(mutates a Array with T, mutates b Array with T) uses T where T implements Copyable
	let t = a[0].clone()
	a[0] = b[0].clone()
	b[0] = t
end 'swapFirst'

function find(p Pool with T, handle Handle with T) uses T returns Option with T where T implements Copyable
	if p.contains(handle) 'live'
		return Option.some(p[handle].clone())
	end 'live'
	return Option.none
end 'find'

function nested(mutates grid Array with (Array with T), consumes item T) uses T
	grid[0].push(item)
end 'nested'

function main() returns ExitCode
	var a = CountArray.create(0)
	var b = CountArray.create(0)
	a.push(1)
	b.push(2)
	moveFirst(a, target: b)
	a.push(3)
	swapFirst(a, b: b)
	var m = StringCountMap.create()
	store(m, value: 1)
	var p = CountPool.create()
	let h = put(p, item: 4)
	var l = CountList.create()
	let n = back(l, item: 5)
	var grid = CountArrayArray.create(0)
	grid.push(CountArray.create(0))
	nested(grid, item: 6)
	print("{find(p, handle: h).isSome()} {l.contains(n)}")
	return 0
end 'main'
