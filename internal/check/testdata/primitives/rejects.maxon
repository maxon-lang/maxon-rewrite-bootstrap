// case: move an element into a let
// expect-error: E3901
function main() returns ExitCode
	var a = CellArray.create(0)
	let c = a[0]
	print("{c.n}")
	return 0
end 'main'

// case: return an element of a variable
// expect-error: E3901
function f() returns Cell
	var a = CellArray.create(0)
	return a[0]
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: return an element of a borrowed array
// expect-error: E3900
function f(xs Array with Cell) returns Cell
	return xs[0]
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: consume an element
// expect-error: E3901
function main() returns ExitCode
	var a = CellArray.create(0)
	print("{take(a[0])}")
	return 0
end 'main'

// case: assign one element from another
// expect-error: E3901
function main() returns ExitCode
	var a = CellArray.create(0)
	a[0] = a[1]
	return 0
end 'main'

// case: move an element of a temporary
// expect-error: E3901
function main() returns ExitCode
	let c = make()[0]
	print("{c.n}")
	return 0
end 'main'

// case: move a value out of a map
// expect-error: E3901
typealias CountCellMap = Map with Count, Cell

function main() returns ExitCode
	var m = CountCellMap.create()
	let c = m[1]
	print("{c.n}")
	return 0
end 'main'

// case: two elements as mutates arguments
// expect-error: E3186
function main() returns ExitCode
	var a = CellArray.create(0)
	pair(a[0], b: a[1])
	return 0
end 'main'

// case: the array and one of its elements
// expect-error: E3186
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	grow(a, n: a[0])
	return 0
end 'main'

// case: append an element of the array
// expect-error: E3186
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	a.push(a[0])
	return 0
end 'main'

// case: insert an element of the array
// expect-error: E3186
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	a.insert(0, value: a[0])
	return 0
end 'main'

// case: remove while an element is borrowed
// expect-error: E3186
function main() returns ExitCode
	var a = CellArray.create(0)
	print("{look(a[0], n: drop(a))}")
	return 0
end 'main'

// case: change a pool while an element is borrowed
// expect-error: E3186
typealias CellPool = Pool with Cell

function main() returns ExitCode
	var p = CellPool.create()
	let h = p.insert(Cell.make(1))
	pair(p[h], b: p[h])
	return 0
end 'main'

// case: change the array in an arm that borrows its element
// expect-error: E3186
typealias CellOption = Option with Cell

typealias CellOptionArray = Array with (Option with Cell)

function main() returns ExitCode
	var a = CellOptionArray.create(0)
	match a[0] 'm'
		some(c) then a.push(CellOption.none)
		none then print("none")
	end 'm'
	return 0
end 'main'

// case: assign an element of a let
// expect-error: E2013
typealias CountArray = Array with Count

function main() returns ExitCode
	let a = CountArray.create(0)
	a[0] = 1
	return 0
end 'main'

// case: append to a let
// expect-error: E2013
typealias CountArray = Array with Count

function main() returns ExitCode
	let a = CountArray.create(0)
	a.push(1)
	return 0
end 'main'

// case: change an element of a borrowed array
// expect-error: E2013
function f(a Array with Cell)
	touch(a[0])
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: change an element of a temporary
// expect-error: E2013
function main() returns ExitCode
	touch(make()[0])
	return 0
end 'main'

// case: index with a bool
// expect-error: E3005
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	print("{a[true]}")
	return 0
end 'main'

// case: index a pool with a number
// expect-error: E3005
typealias CellPool = Pool with Cell

function main() returns ExitCode
	var p = CellPool.create()
	print("{p[0].n}")
	return 0
end 'main'

// case: index a map with the wrong key
// expect-error: E3005
typealias StringCountMap = Map with String, Count

function main() returns ExitCode
	var m = StringCountMap.create()
	print("{m[1]}")
	return 0
end 'main'

// case: index a number
// expect-error: E3005
function main() returns ExitCode
	let n = 3 as Count
	print("{n[0]}")
	return 0
end 'main'

// case: index a handle
// expect-error: E3005
typealias CellPool = Pool with Cell

function main() returns ExitCode
	var p = CellPool.create()
	let h = p.insert(Cell.make(1))
	print("{h[0]}")
	return 0
end 'main'

// case: index with two values
// expect-error: E3005
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	print("{a[0, 1]}")
	return 0
end 'main'

// case: a handle of another pool
// expect-error: E3005
typealias CellPool = Pool with Cell

typealias EntryPool = Pool with Entry

function main() returns ExitCode
	var p = CellPool.create()
	var q = EntryPool.create()
	let h = q.insert(Entry.make(1, value: "a"))
	print("{p[h].n}")
	return 0
end 'main'

// case: a record as a map key
// expect-error: E3908
typealias CellCountMap = Map with Cell, Count

function main() returns ExitCode
	var m = CellCountMap.create()
	return 0
end 'main'

// case: a type parameter as a map key
// expect-error: E3908
function f(m Map with (K, Count)) uses K
	print("{m.count()}")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an unknown method
// expect-error: E3004
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	a.shove(1)
	return 0
end 'main'

// case: a method named without a call
// expect-error: E9000
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	print("{a.count}")
	return 0
end 'main'

// case: the wrong number of arguments
// expect-error: E3036
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	a.push()
	return 0
end 'main'

// case: an unlabelled second argument
// expect-error: E2053
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	a.insert(1, 0)
	return 0
end 'main'

// case: an element of the wrong type
// expect-error: E3005
typealias CountArray = Array with Count

function main() returns ExitCode
	var a = CountArray.create(0)
	a.push("x")
	return 0
end 'main'

// case: an Option used after unwrap
// expect-error: E3102
function main() returns ExitCode
	let o = Option.some(Cell.make(1))
	let c = o.unwrap()
	print("{o.isSome()} {c.n}")
	return 0
end 'main'

// case: a primitive given to a bounded parameter
// expect-error: E3017
typealias CountArray = Array with Count

function main() returns ExitCode
	print("{total(CountArray.create(0))}")
	return 0
end 'main'

// case: an array without a type argument
// expect-error: E3179
function main() returns ExitCode
	let a = Array.create(0)
	return 0
end 'main'

// case: an array type without a type argument
// expect-error: E2056
function f(a Array) returns Count
	return 0
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a literal of a primitive
// expect-error: E3011
function main() returns ExitCode
	let a = array{}
	return 0
end 'main'

// case: a handle has no methods
// expect-error: E3004
typealias CellPool = Pool with Cell

function main() returns ExitCode
	var p = CellPool.create()
	let h = p.insert(Cell.make(1))
	print("{h.count()}")
	return 0
end 'main'
