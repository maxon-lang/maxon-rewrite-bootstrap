// case: move an element into a let
// expect-error: E3111
function main() returns ExitCode
	var a = array[Cell].new()
	let c = a[0]
	print("{c.n}")
	return 0
end 'main'

// case: return an element of a variable
// expect-error: E3111
function f() returns Cell
	var a = array[Cell].new()
	return a[0]
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: return an element of a borrowed array
// expect-error: E3110
function f(xs array[Cell]) returns Cell
	return xs[0]
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: consume an element
// expect-error: E3111
function main() returns ExitCode
	var a = array[Cell].new()
	print("{take(a[0])}")
	return 0
end 'main'

// case: assign one element from another
// expect-error: E3111
function main() returns ExitCode
	var a = array[Cell].new()
	a[0] = a[1]
	return 0
end 'main'

// case: move an element of a temporary
// expect-error: E3111
function main() returns ExitCode
	let c = make()[0]
	print("{c.n}")
	return 0
end 'main'

// case: move a value out of a map
// expect-error: E3111
function main() returns ExitCode
	var m = map[Count, Cell].new()
	let c = m[1]
	print("{c.n}")
	return 0
end 'main'

// case: two elements as mutates arguments
// expect-error: E3112
function main() returns ExitCode
	var a = array[Cell].new()
	pair(a[0], b: a[1])
	return 0
end 'main'

// case: the array and one of its elements
// expect-error: E3112
function main() returns ExitCode
	var a = array[Count].new()
	grow(a, n: a[0])
	return 0
end 'main'

// case: append an element of the array
// expect-error: E3112
function main() returns ExitCode
	var a = array[Count].new()
	a.append(a[0])
	return 0
end 'main'

// case: insert an element of the array
// expect-error: E3112
function main() returns ExitCode
	var a = array[Count].new()
	a.insert(a[0], at: 0)
	return 0
end 'main'

// case: remove while an element is borrowed
// expect-error: E3112
function main() returns ExitCode
	var a = array[Cell].new()
	print("{look(a[0], n: drop(a))}")
	return 0
end 'main'

// case: change a pool while an element is borrowed
// expect-error: E3112
function main() returns ExitCode
	var p = pool[Cell].new()
	let h = p.insert(Cell.make(1))
	pair(p[h], b: p[h])
	return 0
end 'main'

// case: change the array in an arm that borrows its element
// expect-error: E3112
function main() returns ExitCode
	var a = array[Option[Cell]].new()
	match a[0] 'm'
		some(c) then a.append(Option[Cell].none)
		none then print("none")
	end 'm'
	return 0
end 'main'

// case: assign an element of a let
// expect-error: E2013
function main() returns ExitCode
	let a = array[Count].new()
	a[0] = 1
	return 0
end 'main'

// case: append to a let
// expect-error: E2013
function main() returns ExitCode
	let a = array[Count].new()
	a.append(1)
	return 0
end 'main'

// case: change an element of a borrowed array
// expect-error: E2013
function f(a array[Cell])
	touch(a[0])
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: change an element of a temporary
// expect-error: E2013
function main() returns ExitCode
	touch(make()[0])
	return 0
end 'main'

// case: index with a bool
// expect-error: E3005
function main() returns ExitCode
	var a = array[Count].new()
	print("{a[true]}")
	return 0
end 'main'

// case: index a pool with a number
// expect-error: E3005
function main() returns ExitCode
	var p = pool[Cell].new()
	print("{p[0].n}")
	return 0
end 'main'

// case: index a map with the wrong key
// expect-error: E3005
function main() returns ExitCode
	var m = map[String, Count].new()
	print("{m[1]}")
	return 0
end 'main'

// case: index a number
// expect-error: E3005
function main() returns ExitCode
	let n = 3 as Count
	print("{n[0]}")
	return 0
end 'main'

// case: index a handle
// expect-error: E3005
function main() returns ExitCode
	var p = pool[Cell].new()
	let h = p.insert(Cell.make(1))
	print("{h[0]}")
	return 0
end 'main'

// case: index with two values
// expect-error: E3005
function main() returns ExitCode
	var a = array[Count].new()
	print("{a[0, 1]}")
	return 0
end 'main'

// case: a handle of another pool
// expect-error: E3005
function main() returns ExitCode
	var p = pool[Cell].new()
	var q = pool[Entry].new()
	let h = q.insert(Entry.make(1, value: "a"))
	print("{p[h].n}")
	return 0
end 'main'

// case: a record as a map key
// expect-error: E3124
function main() returns ExitCode
	var m = map[Cell, Count].new()
	return 0
end 'main'

// case: a type parameter as a map key
// expect-error: E3124
function f[K](m map[K, Count])
	print("{m.count()}")
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an unknown method
// expect-error: E3004
function main() returns ExitCode
	var a = array[Count].new()
	a.push(1)
	return 0
end 'main'

// case: a method named without a call
// expect-error: E9000
function main() returns ExitCode
	var a = array[Count].new()
	print("{a.count}")
	return 0
end 'main'

// case: the wrong number of arguments
// expect-error: E3036
function main() returns ExitCode
	var a = array[Count].new()
	a.append()
	return 0
end 'main'

// case: an unlabelled second argument
// expect-error: E2053
function main() returns ExitCode
	var a = array[Count].new()
	a.insert(1, 0)
	return 0
end 'main'

// case: an element of the wrong type
// expect-error: E3005
function main() returns ExitCode
	var a = array[Count].new()
	a.append("x")
	return 0
end 'main'

// case: an Option used after unwrap
// expect-error: E3102
function main() returns ExitCode
	var a = array[Cell].new()
	let o = a.pop()
	let c = o.unwrap()
	print("{o.isSome()} {c.n}")
	return 0
end 'main'

// case: a primitive given to a bounded parameter
// expect-error: E3117
function main() returns ExitCode
	print("{total(array[Count].new())}")
	return 0
end 'main'

// case: an array without a type argument
// expect-error: E3118
function main() returns ExitCode
	let a = array.new()
	return 0
end 'main'

// case: an array type without a type argument
// expect-error: E3116
function f(a array) returns Count
	return 0
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a literal of a primitive
// expect-error: E3011
function main() returns ExitCode
	let a = array{}
	return 0
end 'main'

// case: a handle has no methods
// expect-error: E3004
function main() returns ExitCode
	var p = pool[Cell].new()
	let h = p.insert(Cell.make(1))
	print("{h.count()}")
	return 0
end 'main'
