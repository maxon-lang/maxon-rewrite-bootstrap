typealias CellArray = array with Cell

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

type Entry
	export var key as Count
	export var value as String

	static function make(key Count, consumes value String) returns Entry
		return Entry{key: key, value: value}
	end 'make'
end 'Entry'

type Rack
	export var left as array with Cell
	export var right as array with Cell
	export var node as Handle with Cell

	static function make(node Handle with Cell) returns Rack
		return Rack{left: CellArray.new(), right: CellArray.new(), node: node}
	end 'make'
end 'Rack'

interface Shape
	function area() returns Count
end 'Shape'

function touch(mutates c Cell)
	c.n = c.n + 1
end 'touch'

function bump(mutates n Count)
	n = n + 1
end 'bump'

function pair(mutates a Cell, mutates b Cell)
	a.n = b.n
end 'pair'

function grow(mutates xs array with Count, n Count)
	xs.append(n)
end 'grow'

function drop(mutates xs array with Cell) returns Count
	return xs.count()
end 'drop'

function look(c Cell, n Count) returns Count
	return c.n + n
end 'look'

function take(consumes c Cell) returns Count
	return c.n
end 'take'

function make() returns array with Cell
	return CellArray.new()
end 'make'

function total(x T) uses T returns Count where T implements Shape
	return x.area()
end 'total'
