typealias CountEntryHandleMap = map with Count, Handle with Entry

typealias EntryList = list with Entry

typealias StringOption = Option with String

type Entry
	export var key as Count
	export var value as String

	static function make(key Count, consumes value String) returns Entry
		return Entry{key: key, value: value}
	end 'make'
end 'Entry'

type Cache
	var order as list with Entry
	var index as map with (Count, Handle with Entry)
	var capacity as Count

	static function make(capacity Count) returns Cache
		return Cache{order: EntryList.new(), index: CountEntryHandleMap.new(), capacity: capacity}
	end 'make'

	function get(mutates self, key Count) returns Option with String
		if not index.has(key) 'miss'
			return StringOption.none
		end 'miss'
		let node = index[key]
		order.moveToFront(node)
		return Option.some(order[node].value.copy())
	end 'get'

	function put(mutates self, key Count, consumes value String)
		if index.has(key) 'hit'
			let node = index[key]
			order[node].value = value
			order.moveToFront(node)
			return
		end 'hit'
		if index.count() == capacity 'full'
			match order.popBack() 'evict'
				some(oldest) then _ = index.remove(oldest.key)
				none then return
			end 'evict'
		end 'full'
		let node = order.pushFront(Entry.make(key, value: value))
		index.insert(key, value: node)
	end 'put'
end 'Cache'

function main() returns ExitCode
	var cache = Cache.make(2)
	cache.put(1, value: "one")
	cache.put(2, value: "two")
	match cache.get(1) 'm'
		some(v) then print(v)
		none then print("miss")
	end 'm'
	return 0
end 'main'
