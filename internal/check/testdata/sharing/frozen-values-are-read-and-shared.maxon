function main() returns ExitCode
	let d = freeze(Doc.make("a"))
	let e = share(d)
	print("{d.title} {d.n} {d.words.count()} {e.read()} {glance(d)}")
	let own = thaw(d)
	var again = thaw(e)
	again.grow()
	let copied = d.clone()
	let shelf = Shelf.make(copied, tray: cown(own))
	let f = freeze(shelf)
	print("{f.doc.title} {f.doc.n}")
	return 0
end 'main'
