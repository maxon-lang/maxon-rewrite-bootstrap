// case: the inner behaviour reads the outer one's access
// expect-error: E3909
function main() returns ExitCode
	let c = cown(Doc.make("a"))
	let d = cown(Doc.make("b"))
	when c as x 'outer'
		when d as y 'inner'
			y.n = x.n
		end 'inner'
	end 'outer'
	return 0
end 'main'

// case: the inner behaviour captures a scalar the outer one read
function main() returns ExitCode
	let c = cown(Doc.make("a"))
	let d = cown(Doc.make("b"))
	when c as x 'outer'
		let n = x.n
		when d as y 'inner'
			y.n = n
		end 'inner'
	end 'outer'
	return 0
end 'main'
