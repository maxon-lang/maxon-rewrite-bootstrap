// case: a cycle through a cown
// expect-error: E3914
typealias NodeCownOption = Option with (cown with Node)

type Node
	export var next as Option with (cown with Node)

	static function make() returns Node
		return Node{next: NodeCownOption.none}
	end 'make'
end 'Node'

function main() returns ExitCode
	return 0
end 'main'

// case: no cycle through an owned or frozen value
typealias LinkFrozenOption = Option with (frozen with Link)

type Link
	export var rest as Option with (frozen with Link)

	static function make() returns Link
		return Link{rest: LinkFrozenOption.none}
	end 'make'
end 'Link'

function main() returns ExitCode
	return 0
end 'main'
