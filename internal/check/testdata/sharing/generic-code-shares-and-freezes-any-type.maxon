function wrap(consumes x T) uses T returns frozen with T
	return freeze(x)
end 'wrap'

function again(x frozen with T) uses T returns frozen with T
	return share(x)
end 'again'

function open(x frozen with T) uses T returns T
	return thaw(x)
end 'open'

function hold(consumes x T) uses T returns cown with T
	return cown(x)
end 'hold'

function main() returns ExitCode
	let f = wrap("a")
	let g = again(f)
	let s = open(g)
	let c = hold(s)
	return 0
end 'main'
