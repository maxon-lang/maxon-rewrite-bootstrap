// case: a signed divisor that is not 0 may still be -1, and i64.min / -1 does not fit
// expect-error: E3140
function f(a Score, b Score) returns Score
	if b != 0 'checked'
		return a / b
	end 'checked'
	return 0
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: the then branch of 'or' knows only that one of them is true
// expect-error: E3140
function f(a Count, b Count) returns Count
	if a < 1000 or b < 1000 'small'
		return a * b
	end 'small'
	return 0
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a var forgets what it was checked for at the top of a loop
// expect-error: E3140
function f(total Count, parts Count) returns Count
	var d = parts
	if d == 0 'none'
		return 0
	end 'none'
	var sum = 0 as Count
	while sum < 10 'fill'
		sum = sum + total / d
	end 'fill'
	return sum
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a call that may change a field forgets what was known of it
// expect-error: E3140
function f(mutates c Cell)
	if c.n < 100 'room'
		touch(c)
		c.n = c.n + 1
	end 'room'
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an assignment forgets how the places compared
// expect-error: E3140
function f(a Count, b Count) returns Count
	var x = a
	if x >= b 'ok'
		x = b + 0
		return b - x
	end 'ok'
	return 0
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a cast that may not fit
// expect-error: E3140
function f(n Count) returns Digit
	return n as Digit
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a try with no handler in a function that does not throw
// expect-error: E3141
function f(a Count, b Count) returns Count
	return try a / b
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: where the context expects a digit the sum must fit one, whatever range its operands give
// expect-error: E3140
function f(a Digit, b Digit) returns Digit
	return a + b
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an intermediate result is a digit only by a cast
// expect-error: E3005
function f(a Digit, b Digit) returns Digit
	let sum = a + b
	return sum
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: no word holds a value that may be negative and one past i64.max
// expect-error: E3005
function f(a Count, b Score) returns bool
	return a + b > 0
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a count and a possibly negative value are not compared either
// expect-error: E3005
function f(a Count, b Score) returns bool
	return a < b
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a loop with no bound on how often it runs moves an accumulator as far as its type allows
// expect-error: E3140
function f(n Count) returns Count
	var total = 0 as Count
	for i in 0 upto n 'each'
		total = total + 2
	end 'each'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an accumulator that the loop also changes some other way is forgotten
// expect-error: E3140
function f(n Digit) returns Count
	var total = 0 as Count
	for i in 0 upto n 'each'
		total = total + 1
		if i == 3 'half'
			total = total / 2
		end 'half'
	end 'each'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an accumulator that a call may change is forgotten
// expect-error: E3140
function bump(mutates n Count)
	n = 0
end 'bump'

function f(n Digit) returns Count
	var total = 0 as Count
	for i in 0 upto n 'each'
		total = total + 1
		bump(total)
	end 'each'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: what a statement adds can name the accumulator, and then it is as large as the type allows
// expect-error: E3140
function f(n Digit) returns Count
	var total = 1 as Count
	for i in 0 upto n 'each'
		total = total + total
	end 'each'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a statement in a while loop inside the loop runs as often as the while loop does, which is not bounded
// expect-error: E3140
function f(n Digit, m Count) returns Count
	var total = 0 as Count
	for i in 0 upto n 'each'
		var k = 0 as Count
		while k < m 'inner'
			total = total + 1
			k = k + 1
		end 'inner'
	end 'each'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: a bound that leaves the type is still an error
// expect-error: E3140
typealias Small = int(0 to 100)

typealias Thousand = int(0 to 1000)

function f(x Small) returns Thousand
	var total = 0 as Thousand
	for i in 0 to 10 'eleven'
		total = total + (x as Thousand)
	end 'eleven'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'

// case: an accumulator that goes down passes the minimum of an unsigned type
// expect-error: E3140
function f(n Digit) returns Count
	var total = 100 as Count
	for i in 0 upto n 'each'
		total = total - 20
	end 'each'
	return total
end 'f'

function main() returns ExitCode
	return 0
end 'main'
