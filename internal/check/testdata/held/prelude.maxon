typealias Names = array with String

typealias Cells = array with Cell

typealias Rows = array with Row

typealias Items = array with Item

typealias CountPersonMap = map with (Count, Person)

typealias CellPool = pool with Cell

union Item
	named(name String)
	anonymous
end 'Item'

type Cell
	export var n as Count

	static function make(n Count) returns Cell
		return Cell{n: n}
	end 'make'
end 'Cell'

type Person
	export var name as String

	static function make(consumes name String) returns Person
		return Person{name: name}
	end 'make'
end 'Person'

type Row
	export var cells as array with String
	export var items as array with Item

	static function make() returns Row
		return Row{cells: Names.new(), items: Items.new()}
	end 'make'
end 'Row'

function label(n Count) returns String
	return "n{n}"
end 'label'

function wipe(mutates a Names) returns String
	_ = a.remove(0)
	return "x"
end 'wipe'

function reset(mutates a Names) returns Count
	a = Names.new()
	return 0
end 'reset'

function other(a Names) returns String
	return "y"
end 'other'

function take(consumes p Person) returns String
	return "t"
end 'take'

function rename(mutates p Person) returns String
	p.name = "z"
	return "r"
end 'rename'

function glance(p Person) returns String
	return "g"
end 'glance'

function rewrite(mutates s String) returns String
	s = "w"
	return "x"
end 'rewrite'

function shrink(mutates rows Rows) returns Count
	_ = rows.remove(0)
	return 0
end 'shrink'

function trim(mutates cs Cells) returns Count
	_ = cs.remove(0)
	return 0
end 'trim'

function drain(mutates m CountPersonMap) returns Count
	m = CountPersonMap.new()
	return 0
end 'drain'

function reap(mutates p CellPool) returns Handle with Cell
	return p.insert(Cell.make(0))
end 'reap'

function bump(mutates s String)
	s = "b"
end 'bump'
