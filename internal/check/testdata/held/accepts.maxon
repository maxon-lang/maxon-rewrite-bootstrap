// case: comparison of elements of two arrays
function main() returns ExitCode
	var a = Names.new()
	var b = Names.new()
	a.append(label(1))
	b.append(label(1))
	if a[0] == b[0] 'eq'
		print("eq\n")
	end 'eq'
	return 0
end 'main'

// case: comparison with a call that only reads the array
function main() returns ExitCode
	var a = Names.new()
	a.append(label(1))
	if a[0] == other(a) 'eq'
		print("eq\n")
	end 'eq'
	if a[0] != label(a.count()) 'ne'
		print("ne\n")
	end 'ne'
	return 0
end 'main'

// case: the other side of a comparison changes what it does not borrow
function main() returns ExitCode
	var a = Names.new()
	var b = Names.new()
	a.append(label(1))
	b.append(label(2))
	if a[0] == wipe(b) 'eq'
		print("eq\n")
	end 'eq'
	return 0
end 'main'

// case: a call on the left is a fresh value by the time the right is read
function main() returns ExitCode
	var a = Names.new()
	a.append(label(1))
	if wipe(a) == label(1) 'eq'
		print("eq\n")
	end 'eq'
	return 0
end 'main'

// case: a scalar operand is a value by the time the other is evaluated
function main() returns ExitCode
	var cs = Cells.new()
	cs.append(Cell.make(1))
	let total = cs[0].n + trim(cs)
	print("{total}")
	return 0
end 'main'

// case: subscript that reads the array in its index
function main() returns ExitCode
	var a = Names.new()
	a.append(label(1))
	print(a[a.count() - 1])
	return 0
end 'main'

// case: nested subscript with variable indexes
function main() returns ExitCode
	var rows = Rows.new()
	rows.append(Row.make())
	rows[0].cells.append(label(1))
	let i = 0
	let j = 0
	print(rows[i].cells[j])
	return 0
end 'main'

// case: nested subscript whose index reads the outer array
function main() returns ExitCode
	var rows = Rows.new()
	rows.append(Row.make())
	rows[0].cells.append(label(1))
	print(rows[0].cells[rows.count() - 1])
	rows[0].cells[rows.count() - 1] = "x"
	bump(rows[0].cells[rows.count() - 1])
	return 0
end 'main'

// case: subscript whose index changes another collection
function main() returns ExitCode
	var rows = Rows.new()
	var cs = Cells.new()
	rows.append(Row.make())
	rows[0].cells.append(label(1))
	cs.append(Cell.make(1))
	print(rows[0].cells[trim(cs)])
	return 0
end 'main'

// case: interpolation whose later part reads the record
function main() returns ExitCode
	var p = Person.make(label(1))
	print("{p.name}{glance(p)}")
	return 0
end 'main'

// case: interpolation whose later part consumes the record after a joined part
function main() returns ExitCode
	var p = Person.make(label(1))
	print("{p.name} {take(p)}")
	return 0
end 'main'

// case: interpolation of a number first
function main() returns ExitCode
	var p = Person.make(label(1))
	let n = 1
	print("{n}{take(p)}")
	return 0
end 'main'

// case: a copy on the left is a fresh value, which the right cannot change
function main() returns ExitCode
	var a = Names.new()
	a.append(label(1))
	if a[0].copy() == wipe(a) 'eq'
		print("eq\n")
	end 'eq'
	return 0
end 'main'

// case: the other operand computed into a variable first
function main() returns ExitCode
	var a = Names.new()
	a.append(label(1))
	let w = wipe(a)
	if a[0] == w 'eq'
		print("eq\n")
	end 'eq'
	return 0
end 'main'
