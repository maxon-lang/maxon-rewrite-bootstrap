typealias Score = int(i64.min to i64.max)

type Pair
	export var first as Score
	export var second as Score
	export var label as String

	function bump(mutable self, by Score)
		first = first + by
	end 'bump'

	static function create(first Score, second Score) returns Pair
		return Pair{first: first, second: second, label: "pair"}
	end 'create'
end 'Pair'

function change(p mutable Pair)
	p.first = 1
end 'change'

function swap(a mutable Score, b mutable Score)
	let t = a
	a = b
	b = t
end 'swap'

function take(p sink Pair) returns Score
	return p.first
end 'take'

function make(n set Score, flag bool)
	if flag 'early'
		n = 1
	end 'early' else 'late'
		n = 2
	end 'late'
end 'make'
