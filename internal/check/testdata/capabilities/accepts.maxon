// case: a plain type and a box of one are copyable
function main() returns ExitCode
	let a = Plain.make().copy()
	let b = Box.make(Plain.make()).copy()
	return 0
end 'main'

// case: frozen, cown and Handle stop what their content lacks
function hold(a frozen with Socket, b cown with Socket, h Handle with Socket)
	let x = a.copy()
	let y = b.copy()
	let z = h.copy()
end 'hold'

function main() returns ExitCode
	return 0
end 'main'

// case: a parameter with the bound is copyable
function dup(a T) uses T returns T where T implements Copyable
	return a.copy()
end 'dup'

function main() returns ExitCode
	return 0
end 'main'

// case: Copyable includes Droppable
function viaCopyable(x T) uses T where T implements Copyable
	needsDroppable(x)
end 'viaCopyable'

function main() returns ExitCode
	return 0
end 'main'

// case: a method's where bounds its type's parameter at the call and in the body
function main() returns ExitCode
	let s = Stack.make(Plain.make())
	let p = s.peek()
	let q = Stack.make(Socket.open()).size()
	let a = PlainArray.filled(2, value: Plain.make())
	return 0
end 'main'

// case: a destructor ends its receiver, through a bound as well
function shut(consumes d T) uses T where T implements Closeable
	d.close()
end 'shut'

function finish(consumes step Step)
	match consumes step 'which'
		done(t) then t.commit()
		failed(t, reason) then t.commit()
	end 'which'
end 'finish'

function main() returns ExitCode
	Txn.begin().commit()
	shut(Door.make())
	var current = Txn.begin()
	exchange(current, value: Txn.begin()).commit()
	current.commit()
	var pending = TxnArray.new()
	pending.dropEmpty()
	return 0
end 'main'
