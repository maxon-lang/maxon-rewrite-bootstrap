function sumOf(items array[Count]) returns Count
	var sum = 0 as Count
	for i in 0 upto items.count() 'each'
		sum = sum + items[i]
	end 'each'
	return sum
end 'sumOf'

function drop(mutates items array[Count])
	let last = items.pop()
	items[0] = 1
end 'drop'

function lookup(m map[Count, Count], k Count) returns Count
	return m[k]
end 'lookup'

function build() returns Count
	var p = pool[Count].new()
	let h = p.insert(1)
	p[h] = 2
	let copied = p.copy()
	return 0
end 'build'

function main() returns ExitCode
	return 0
end 'main'
