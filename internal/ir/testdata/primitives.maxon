function sumOf(items array with Count) returns Count throws ArithmeticError
	var sum = 0 as Count
	for i in 0 upto items.count() 'each'
		sum = try sum + items[i]
	end 'each'
	return sum
end 'sumOf'

function drop(mutates items array with Count)
	let last = items.pop()
	items[0] = 1
end 'drop'

function lookup(m map with (Count, Count), k Count) returns Count
	return m[k]
end 'lookup'

function build() returns Count
	var p = CountPool.new()
	let h = p.insert(1)
	p[h] = 2
	let copied = p.copy()
	return 0
end 'build'

function main() returns ExitCode
	return 0
end 'main'

typealias CountPool = pool with Count
