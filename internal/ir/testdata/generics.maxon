typealias Score = int(i64.min to i64.max)

typealias ScoreBox = Box with Score

interface Shape
	function area() returns Score
end 'Shape'

type Square implements Shape
	var side as Score

	static function create(side Score) returns Square
		return Square{side: side}
	end 'create'

	function area() returns Score
		return side * side
	end 'area'
end 'Square'

type Box uses T
	var item as T

	static function make(consumes item T) returns Self
		return Self{item: item}
	end 'make'

	function peek() returns T where T implements Copyable
		return item.copy()
	end 'peek'
end 'Box'

function swap(mutates a T, mutates b T) uses T where T implements Copyable
	var tmp = a.copy()
	a = b.copy()
	b = tmp
end 'swap'

function total(a T, b T) uses T returns Score where T implements Shape
	return a.area() + b.area()
end 'total'

function both(a T) uses T returns Score where T implements Shape and Copyable
	var b = a.copy()
	var c = a.copy()
	swap(b, b: c)
	return total(a, b: b)
end 'both'

function main() returns ExitCode
	var n = 1 as Score
	var m = 2 as Score
	swap(n, b: m)
	swap(n, b: m)
	var a = Square.create(1)
	var b = Square.create(2)
	swap(a, b: b)
	let x = ScoreBox.make(1)
	let y = ScoreBox.make(2)
	print("{both(a)} {total(a, b: b)} {x.peek()} {y.peek()}\n")
	return 0
end 'main'
