enum Shade
	light
	dark
end 'Shade'

union Shape
	dot
	box(width Count, height Count)
end 'Shape'

type Pair
	export var left as String
	export var right as String

	static function make(consumes left String, consumes right String) returns Pair
		return Pair{left: left, right: right}
	end 'make'
end 'Pair'

function label(n Count, shade Shade) returns String
	return "{n} is {shade.name}"
end 'label'

function area(s Shape) returns Count
	match s 'm'
		dot then return 0
		box(w, h) then return w * h
	end 'm'
	return 0
end 'area'

function join(consumes p Pair) returns String
	return "{p.left}{p.right}"
end 'join'

function total(items array with Count, bonus Count) returns Count
	var sum = 0 as Count
	for i in 0 upto items.count() 'each'
		if items[i] > bonus and items[i] != 4 'big'
			sum = sum + items[i]
		end 'big' else 'small'
			sum = sum + bonus
		end 'small'
	end 'each'
	return sum
end 'total'

function grow(mutates items array with Count, by Count)
	items.append(by)
	items[0] = items[0] + by
end 'grow'

function main() returns ExitCode
	var items = Counts.new()
	grow(items, by: 3)
	let pair = Pair.make(label(total(items, bonus: 1), shade: Shade.dark), right: "!")
	print(join(pair))
	print("{area(Shape.box(2, height: 3))}\n")
	return 0
end 'main'

typealias Counts = array with Count
