interface Shape
	function area() returns Score
	function grow(mutates self, by Score)
end 'Shape'

type Box uses T, U implements Shape where T implements Shape and Named
	var item as T
end 'Box'

function pick(a T) uses T returns Box with (T, lib.Other with Option with T) where T implements Shape
	let b = Box.make(a)
	return swap(a, b: b)
end 'pick'

typealias Boxes = array with (Box with (Count, String))
