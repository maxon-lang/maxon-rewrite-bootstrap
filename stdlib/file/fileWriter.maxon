public type FileWriter
	var file as __ManagedFile

	public static function open(path FilePath, mode FilePermission = FilePermission.normal) returns FileWriter throws FileWriteError
		let fileHandle = try openForWriting(path.path.addressableBytes(), mode: mode) otherwise (e) 'openFailed'
			throw writeFailureOf(e)
		end 'openFailed'
		return FileWriter{file: fileHandle}
	end 'open'

	public static function openNew(path FilePath) returns FileWriter throws FileWriteError
		let fileHandle = try __ManagedFile.openCreateNew(path.path.addressableBytes()) otherwise (e) 'createFailed'
			throw writeFailureOf(e)
		end 'createFailed'
		return FileWriter{file: fileHandle}
	end 'openNew'

	public function write(mutates self, content ByteArray) throws FileWriteError
		try writeManaged(content.managed)
	end 'write'

	function writeManaged(mutates self, managed __ManagedMemory with Byte) throws FileWriteError
		try file.write(managed) otherwise (e) 'err'
			throw writeFailureOf(e)
		end 'err'
	end 'writeManaged'

	public function close(destructs self) throws FileWriteError
		try file.close() otherwise (e) 'unclosed'
			throw writeFailureOf(e)
		end 'unclosed'
	end 'close'

	public function writeAll(destructs self, content ByteArray) throws FileWriteError
		try writeAllManaged(content.managed)
	end 'writeAll'

	public function writeAllText(destructs self, content String) throws FileWriteError
		try writeAllManaged(content.addressableBytes())
	end 'writeAllText'

	function writeAllManaged(destructs self, managed __ManagedMemory with Byte) throws FileWriteError
		try writeManaged(managed) otherwise (e) 'unwritten'
			try close()
			throw e
		end 'unwritten'
		try close()
	end 'writeAllManaged'

	/// Force the file's data to its device and throw `FileWriteError.failed` where the system refuses or fails it, as Go's `File.Sync` does.
	public function sync(mutates self) throws FileWriteError
		try file.sync() otherwise (e) 'unsynced'
			throw writeFailureOf(e)
		end 'unsynced'
	end 'sync'
end 'FileWriter'
