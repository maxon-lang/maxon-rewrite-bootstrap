// maxon's __ManagedFile, the owned handle of an open file that its library's FileSource and FileWriter hold, which maxon's
// compiler declares and minimaxon's library does, over the file rows of __Builtins (runtime/file.maxon). Its one destructor is
// close: a value of it has no copy and no drop, so every path that opens one closes it or moves it on (E3919), and no close
// runs that the program does not write. close throws what the system's close reports, as Go's Close does, and the handle is
// closed all the same. The type is the library tiers' (E3185), as maxon's is.

/// A buffer of bytes, which the rows of an open file read into and write from. A converted file of maxon's library calls a static
/// of maxon's bare buffer, `__ManagedMemory.create(n, 1)`, through it (cmd/convert, rewriteFileBuffers), since a static is called
/// through a typealias of an instance.
export typealias ByteMemory = __ManagedMemory with Byte

/// An open file's handle, which exactly one owner closes.
public type __ManagedFile
	let word as Count

	/// Open the file whose path is the bytes of `path` to read.
	public static function openRead(path __ManagedMemory with Byte) returns __ManagedFile throws __ManagedFileError
		return __ManagedFile{word: try __Builtins.fileOpenRead(path)}
	end 'openRead'

	/// Open the file to write: made where it is not there, emptied where it is.
	public static function openWrite(path __ManagedMemory with Byte) returns __ManagedFile throws __ManagedFileError
		return __ManagedFile{word: try __Builtins.fileOpenWrite(path)}
	end 'openWrite'

	/// openWrite, a file it makes getting the executable mode where the system has modes.
	public static function openWriteExecutable(path __ManagedMemory with Byte) returns __ManagedFile throws __ManagedFileError
		return __ManagedFile{word: try __Builtins.fileOpenWriteExecutable(path)}
	end 'openWriteExecutable'

	/// Make a file that must not be there (`alreadyExists`) and open it to write, in one step.
	public static function openCreateNew(path __ManagedMemory with Byte) returns __ManagedFile throws __ManagedFileError
		return __ManagedFile{word: try __Builtins.fileOpenCreateNew(path)}
	end 'openCreateNew'

	/// Read up to `most` bytes of the file into `managed` after its length, which grows by what was read, and give the count, 0
	/// at the end of the file. Bytes that would run past the buffer's capacity are `readFailed`, and nothing is read. A FIFO, a
	/// socket, a terminal or a named pipe parks the green thread until there is something to read.
	public function readAppending(mutates self, mutates managed __ManagedMemory with Byte, most Count) returns Count throws __ManagedFileError
		return try __Builtins.fileReadAppending(word, managed, most)
	end 'readAppending'

	/// Write the whole of `managed` to the file and give its length; `writeFailed` when the system refuses it.
	public function write(mutates self, managed __ManagedMemory with Byte) returns Count throws __ManagedFileError
		return try __Builtins.fileWrite(word, managed)
	end 'write'

	/// Force the file's data to its device, as Go's `File.Sync` does on each system: `F_FULLFSYNC` on macOS, where `fsync` instead
	/// where the file system has none, `fsync` on Linux and `FlushFileBuffers` on Windows. `writeFailed` says the
	/// system refused or failed it, so what was written may not be on the device: a handle that has no sync, a pipe or a FIFO is
	/// refused with the system's error (`EINVAL` on Linux), as Go gives it. The file stays open whether or not this throws.
	public function sync(mutates self) throws __ManagedFileError
		try __Builtins.fileSync(word)
	end 'sync'

	/// Send up to `count` bytes of the file from its position, which moves on by what is sent, on the connected socket whose
	/// word is `socket`, by the system's sendfile, so the bytes never pass through the process, and give the count, 0 at the end
	/// of the file. It parks only while the socket takes none, until the socket's write deadline.
	export function sendOn(mutates self, socket Count, count Count) returns Count throws __ManagedSocketError
		return try __Builtins.socketSendFile(socket, word, count)
	end 'sendOn'

	/// Close the file. It is closed whether or not this throws; `writeFailed` says the system's close reported an error, so
	/// what was written may not all be in the file.
	public function close(destructs self) throws __ManagedFileError
		try __Builtins.fileClose(word)
	end 'close'
end '__ManagedFile'
