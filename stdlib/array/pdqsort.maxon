// Pattern-Defeating Quicksort (pdqsort) — the engine behind every
// `Array.sortUnstable` call for inputs larger than the small-sort threshold
// (n > 32). Smaller inputs short-circuit through smallSortRange.
//
// Reference: Orson Peters, "Pattern-defeating Quicksort", arXiv:2106.05123.
// pdqsort proves O(n log n) worst case via a heapsort fallback when the
// "bad allowance" counter is exhausted, and beats traditional quicksort on
// common adversarial patterns (ascending, descending, equal, pipe-organ,
// sawtooth) via:
//   - Median-of-3 pivot selection (median-of-medians for n > 128).
//   - "Common prefix" skip when the left half from the previous partition
//     matches the new pivot — fast path for runs of duplicates.
//   - Equal-elements fast path: when partition produces a left half that
//     contains only values equal to the pivot, skip recursing on it.

export extension Array
	// Type alias is declared in insertionSort.maxon as `SortComparator`;
	// the parser folds extension-time aliases into Array.innerAliases so
	// this file's body sees them through `chaseTypealiasToFunctionType`.
	// Three-element comparator-based median: returns the index (a, b, or c)
	// whose value is the median of arr[a], arr[b], arr[c]. Doesn't reorder
	// the array — the partition pass does that with `swap`.
	export function medianOf3Index(a ElementIndex, b ElementIndex, c ElementIndex, cmp SortComparator) returns ElementIndex where T implements Copyable
		let va = try self.managed.get(a) otherwise panic("medianOf3Index: get OOB at a")
		let vb = try self.managed.get(b) otherwise panic("medianOf3Index: get OOB at b")
		let vc = try self.managed.get(c) otherwise panic("medianOf3Index: get OOB at c")
		if cmp(va, vb) == core.Ordering.lessThan 'aLessB'
			// a < b
			if cmp(vb, vc) == core.Ordering.lessThan 'bLessC'
				return b
			end 'bLessC'
			// a < b, b >= c
			if cmp(va, vc) == core.Ordering.lessThan 'aLessC'
				return c
			end 'aLessC'
			return a
		end 'aLessB'
		// a >= b
		if cmp(va, vc) == core.Ordering.lessThan 'aLessC2'
			return a
		end 'aLessC2'
		// a >= b, a >= c
		if cmp(vb, vc) == core.Ordering.lessThan 'bLessC2'
			return c
		end 'bLessC2'
		return b
	end 'medianOf3Index'

	// Median-of-medians: split [lo, hi) into three thirds, take median-of-3
	// from each third's first/middle/last, then median-of-3 of those three
	// medians. Used for n > 128 where a simple median-of-3 is too likely
	// to pick a degenerate pivot on partially-sorted input.
	function medianOfMediansIndex(lo ElementIndex, hi ElementIndex, cmp SortComparator) returns ElementIndex where T implements Copyable
		let n = try hi - lo otherwise panic("out of range")
		let third = n / 3
		let m1Lo = lo
		let m1Mid = try lo + third / 2 otherwise panic("out of range")
		let m1Hi = try lo + third - 1 otherwise panic("out of range")
		let m2Lo = try lo + third otherwise panic("out of range")
		let m2Mid = try lo + third + third / 2 otherwise panic("out of range")
		let m2Hi = try lo + 2 * third - 1 otherwise panic("out of range")
		let m3Lo = try lo + 2 * third otherwise panic("out of range")
		let m3Mid = try lo + 2 * third + third / 2 otherwise panic("out of range")
		let m3Hi = try hi - 1 otherwise panic("out of range")
		let m1 = self.medianOf3Index(m1Lo, b: m1Mid, c: m1Hi, cmp: cmp)
		let m2 = self.medianOf3Index(m2Lo, b: m2Mid, c: m2Hi, cmp: cmp)
		let m3 = self.medianOf3Index(m3Lo, b: m3Mid, c: m3Hi, cmp: cmp)
		return self.medianOf3Index(m1, b: m2, c: m3, cmp: cmp)
	end 'medianOfMediansIndex'

	// Pick a pivot index for [lo, hi). Uses median-of-3 for small slices,
	// median-of-medians for large ones. Returns the index of the pivot
	// element; partition swaps it into its sorted position.
	export function choosePivot(lo ElementIndex, hi ElementIndex, cmp SortComparator) returns ElementIndex where T implements Copyable
		let n = try hi - lo otherwise panic("out of range")
		if n > 128 'large'
			return self.medianOfMediansIndex(lo, hi: hi, cmp: cmp)
		end 'large'
		let mid = try lo + n / 2 otherwise panic("out of range")
		return self.medianOf3Index(lo, b: mid, c: try hi - 1 otherwise panic("out of range"), cmp: cmp)
	end 'choosePivot'

	// Partition [lo, hi) around the value at `pivotIndex`. Returns the new
	// position of the pivot (call it `p`) such that:
	//   * arr[lo..p)   has all elements < pivot
	//   * arr[p]       == pivot
	//   * arr[p+1..hi) has all elements >= pivot
	//
	// The `equalToPivotOnLeft` flag tracks whether every element placed in
	// the < region was strictly less; when partition finishes with a left
	// region that's all-equal to the pivot, callers skip recursing left.
	//
	// Algorithm: classic Hoare-style with the pivot swapped to lo, then a
	// two-pointer sweep. Branchless-ness is a future optimization — today
	// the comparator-call-then-branch pattern matches insertion sort's
	// shape, which keeps the inliner happy.
	function partition(mutates self, lo ElementIndex, hi ElementIndex, pivotIndex ElementIndex, cmp SortComparator) returns (ElementIndex, bool) where T implements Copyable
		// Move pivot to the front of the slice (unconditional swap).
		// After this `lo` holds the pivot value for the rest of the pass.
		self.swap(lo, j: pivotIndex)
		var leftAllStrictlyLess = true
		var i = try (lo + 1) as ElementIndex otherwise panic("out of range")
		var j = try (hi - 1) as ElementIndex otherwise panic("out of range")
		while i <= j 'sweep'
			// Read on every trip rather than held across the swap below, which writes `managed`.
			let pv = try self.managed.get(lo) otherwise panic("partition: get OOB at pivot")
			// Advance i while arr[i] < pivot.
			let vi = try self.managed.get(i) otherwise panic("partition: get OOB at i")
			let cmpI = cmp(vi, pv)
			if cmpI == core.Ordering.lessThan 'iAdvance'
				i = try i + 1 otherwise panic("out of range")
				continue
			end 'iAdvance'
			// Retreat j while arr[j] > pivot.
			let vj = try self.managed.get(j) otherwise panic("partition: get OOB at j")
			let cmpJ = cmp(vj, pv)
			if cmpJ == core.Ordering.greaterThan 'jRetreat'
				if j == lo 'underflowJ'
					break
				end 'underflowJ'
				j = try j - 1 otherwise panic("out of range")
				continue
			end 'jRetreat'
			// arr[i] >= pivot and arr[j] <= pivot — swap them.
			if i > j 'crossed'
				break
			end 'crossed'
			self.swap(i, j: j)
			// Element placed at i was the old arr[j]. It was <= pivot;
			// if it was equal (not strictly less), record that.
			if cmpJ != core.Ordering.lessThan 'rightWasEqual'
				leftAllStrictlyLess = false
			end 'rightWasEqual'
			i = try i + 1 otherwise panic("out of range")
			if j == lo 'underflowJ2'
				break
			end 'underflowJ2'
			j = try j - 1 otherwise panic("out of range")
		end 'sweep'
		// `j` now sits at the rightmost position of the < region.
		// Swap the pivot from lo into its final slot at j.
		self.swap(lo, j: j)
		return (j, leftAllStrictlyLess)
	end 'partition'

	// Heapsort sift-down: restore max-heap invariant rooted at `start`
	// within the first `count` elements of [lo, lo+count).
	// Declared before `heapsort` so the parser sees the symbol at point of use.
	function siftDown(mutates self, lo ElementIndex, start ElementIndex, count ElementIndex, cmp SortComparator) where T implements Copyable
		var root = start
		while true 'sift'
			var child = try (2 * root + 1) as ElementIndex otherwise panic("out of range")
			if child >= count 'leaf'
				return
			end 'leaf'
			// Pick the larger of the two children.
			if child + 1 < count 'hasRight'
				let l = try self.managed.get(lo + child) otherwise panic("siftDown: get OOB at left child")
				let r = try self.managed.get(lo + child + 1) otherwise panic("siftDown: get OOB at right child")
				if cmp(l, r) == core.Ordering.lessThan 'rightBigger'
					child = child + 1
				end 'rightBigger'
			end 'hasRight'
			let rv = try self.managed.get(lo + root) otherwise panic("siftDown: get OOB at root")
			let cv = try self.managed.get(lo + child) otherwise panic("siftDown: get OOB at chosen child")
			if cmp(rv, cv) != core.Ordering.lessThan 'heapOk'
				return
			end 'heapOk'
			// Raw swap, not get+set: a swap moves ownership with refcounts unchanged (see `Array.swap`).
			self.swap(try lo + root otherwise panic("out of range"), j: try lo + child otherwise panic("out of range"))
			root = child
		end 'sift'
	end 'siftDown'

	// Heapsort fallback: O(n log n) worst case, called when pdqsort's bad
	// allowance is exhausted (too many unbalanced partitions in a row).
	function heapsort(mutates self, lo ElementIndex, hi ElementIndex, cmp SortComparator) where T implements Copyable
		let n = try hi - lo otherwise panic("out of range")
		if n <= 1 'trivial'
			return
		end 'trivial'
		// Build the max-heap: sift-down from the last non-leaf node.
		var start = try (n / 2) as ElementIndex otherwise panic("out of range")
		while start > 0 'buildHeap'
			start = start - 1
			self.siftDown(lo, start: start, count: n, cmp: cmp)
		end 'buildHeap'
		// Extract elements one by one: swap root to end, shrink, sift the
		// new root down.
		var heapEnd = try n as ElementIndex otherwise panic("out of range")
		while heapEnd > 1 'extract'
			heapEnd = heapEnd - 1
			self.swap(lo, j: try lo + heapEnd otherwise panic("out of range"))
			self.siftDown(lo, start: 0, count: heapEnd, cmp: cmp)
		end 'extract'
	end 'heapsort'

	// Recursive driver for pdqsort. `badAllowance` decrements each time
	// partition produces a highly-unbalanced split; when it hits 0 we
	// fall back to heapsort to guarantee O(n log n) worst case.
	//
	// `prevPivotSame` records whether the previous level's partition produced
	// a left region whose elements were all equal to that level's pivot —
	// the "common prefix" optimization: when the new pivot at lo equals the
	// element just below the slice (prev pivot), all elements between are
	// equal to that pivot and don't need re-partitioning. Saves a full pass
	// on runs of duplicates.
	function pdqsortRecurse(mutates self, lo ElementIndex, hi ElementIndex, badAllowance ElementIndex, prevPivotSame bool, cmp SortComparator) where T implements Copyable
		var curLo = lo
		var curHi = hi
		var allowance = badAllowance
		var prevSame = prevPivotSame
		while (try curHi - curLo otherwise panic("out of range")) > SmallSortThreshold 'loop'
			let n = try curHi - curLo otherwise panic("out of range")
			if allowance == 0 'fallback'
				self.heapsort(curLo, hi: curHi, cmp: cmp)
				return
			end 'fallback'
			let pivotIndex = self.choosePivot(curLo, hi: curHi, cmp: cmp)
			// Common-prefix skip: if the new pivot equals the element just
			// before the slice, the partition would put every element of
			// the slice on the right of that pivot — i.e. all are == pivot.
			// We can skip a full partition pass.
			if prevSame and curLo > 0 'tryCommonPrefix'
				let prevAnchor = try self.managed.get(curLo - 1) otherwise panic("pdqsortRecurse: get OOB at curLo - 1")
				let pivotVal = try self.managed.get(pivotIndex) otherwise panic("pdqsortRecurse: get OOB at pivotIndex")
				if cmp(prevAnchor, pivotVal) == core.Ordering.equalTo 'commonHit'
					// Partition into [<pivot] (empty per the anchor invariant)
					// and [>=pivot]; only need to recurse on the right half.
					let (p, _) = self.partition(curLo, hi: curHi, pivotIndex: pivotIndex, cmp: cmp)
					curLo = try p + 1 otherwise panic("out of range")
					continue
				end 'commonHit'
			end 'tryCommonPrefix'
			let (pivotPos, leftAllStrictlyLess) = self.partition(curLo, hi: curHi, pivotIndex: pivotIndex, cmp: cmp)
			let leftSize = try pivotPos - curLo otherwise panic("out of range")
			let rightSize = try curHi - pivotPos - 1 otherwise panic("out of range")
			let smaller = leftSize if leftSize < rightSize else rightSize
			// Decrement allowance when partition was highly skewed.
			if smaller < n / 8 'skewed'
				if allowance > 0 'decBad'
					allowance = allowance - 1
				end 'decBad'
			end 'skewed'
			// Equal-elements fast path: when partition's left half is all
			// elements that were NOT strictly less than the pivot, we have
			// a run of equal elements on the left. Skip recursing on it.
			if not leftAllStrictlyLess 'equalLeft'
				curLo = try pivotPos + 1 otherwise panic("out of range")
				prevSame = true
				continue
			end 'equalLeft'
			// Sort the smaller side recursively (bounded stack depth) and
			// loop on the larger side. The mutable `curHi` lets the loop
			// shrink the working range on the right just like `curLo`
			// shrinks it on the left.
			if leftSize < rightSize 'recurseLeft'
				self.pdqsortRecurse(curLo, hi: pivotPos, badAllowance: allowance, prevPivotSame: prevSame, cmp: cmp)
				curLo = try pivotPos + 1 otherwise panic("out of range")
				prevSame = true
			end 'recurseLeft' else 'recurseRight'
				self.pdqsortRecurse(try pivotPos + 1 otherwise panic("out of range"), hi: curHi, badAllowance: allowance, prevPivotSame: true, cmp: cmp)
				curHi = pivotPos
			// prevSame for the next iteration's left half is unchanged.
			end 'recurseRight'
		end 'loop'
		// Slice fell below the small-sort threshold; finish with the small-sort.
		self.smallSortRange(curLo, hi: curHi, cmp: cmp)
	end 'pdqsortRecurse'

	export function pdqsortRange(mutates self, lo ElementIndex, hi ElementIndex, cmp SortComparator) where T implements Copyable
		let n = try hi - lo otherwise panic("out of range")
		if n <= SmallSortThreshold 'small'
			self.smallSortRange(lo, hi: hi, cmp: cmp)
			return
		end 'small'
		self.pdqsortRecurse(lo, hi: hi, badAllowance: self.sortDepthBudget(n), prevPivotSame: false, cmp: cmp)
	end 'pdqsortRange'
end 'Array'
