// In-place insertion sort over a half-open range `arr[lo:hi)` using a
// caller-supplied comparator. Called from `smallSortRange` (in smallSort.maxon)
// as the fallback for sizes outside the sorting-network cutoffs (3, 5, 6, 7,
// 9..32) and as the bottom of every recursive sort's recursion.
//
// Lives in a stand-alone extension so the algorithm body stays out of the
// already-large Array.maxon. Also declares the `SortComparator` alias every
// sort helper file spells.

export extension Array
	public typealias SortComparator = function(T, T) returns core.Ordering

	// In-place insertion sort over the closed-open range [lo, hi).
	// Stable: equal elements keep relative order because the bubble loop
	// stops as soon as the predecessor is not strictly greater than the
	// pending element (cmp returning `equalTo` does not trigger a swap).
	//
	// The pending element bubbles down via raw SWAPS rather than the textbook hold-and-shift form: a swap moves
	// ownership between slots with refcounts unchanged, so managed elements relocate without a retain or a release.
	export function internalInsertionSortRange(mutates self, lo ElementIndex, hi ElementIndex, cmp SortComparator) where T implements Copyable
		if hi <= (try lo + 1 otherwise panic("out of range")) 'trivial'
			return
		end 'trivial'
		var i = try (lo + 1) as ElementIndex otherwise panic("out of range")
		while i < hi 'outer'
			var j = i
			while j > lo 'inner'
				let prev = try self.managed.get(j - 1) otherwise panic("internalInsertionSortRange: prev get OOB; invariant j > lo >= 0")
				let pending = try self.managed.get(j) otherwise panic("internalInsertionSortRange: pending get OOB; invariant j <= i < hi <= managed.length()")
				let ord = cmp(prev, pending)
				if ord != core.Ordering.greaterThan 'placed'
					break
				end 'placed'
				self.swap(j - 1, j: j)
				j = j - 1
			end 'inner'
			i = try i + 1 otherwise panic("out of range")
		end 'outer'
	end 'internalInsertionSortRange'
end 'Array'
