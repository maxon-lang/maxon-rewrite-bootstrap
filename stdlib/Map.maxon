/// Hash map with open addressing and linear probing for key-value storage.
/// @category Collections
// Map receives managed memory buffers directly for literal initialization via BuiltinDictionaryLiteral.

// MapError - errors for dictionary/map operations
public enum MapError implements Error
	keyNotFound
	keyAlreadyExists
end 'MapError'

// Occupied entries. An entry needs a slot, so this is bounded by the table's capacity and carries the
// capacity's bound for the reason stated once on `TableCapacity`: 2^63 is the last capacity a doubling
// from 16 can mint.
public typealias EntryCount = int(0 to 9223372036854775808) implements Count

// The slot vocabulary is `helpers/hashtable/slotScan.maxon`'s, shared with `Set`: `SlotState`,
// `TableSlotIndex`, `TableCapacity` and the `findNextOccupied` scan both iterators advance through.
// Two byte-identical copies of a three-state enum fail ASYMMETRICALLY — a fourth state is a compile
// error at one file's `match`es and silence at the other's — so there is one.

public type Map uses Key, Value implements Iterable with (Entry, MapIterator) where Key implements Hashable and Equatable
	typealias KeyArray = Array with Key
	typealias ValueArray = Array with Value
	typealias StateArray = Array with hashtable.SlotState
	typealias HashSlotArray = Array with HashValue
	public typealias Entry = (Key, Value)
	typealias KeyMemory = __ManagedMemory with Key
	typealias ValueMemory = __ManagedMemory with Value
	var keys = KeyArray.create(0) // Key storage
	var values = ValueArray.create(0) // Value storage
	var states = StateArray.create(0) // Slot states
	var hashes = HashSlotArray.create(0) // Cached key hashes, parallel to keys
	var storedCount = 0 as EntryCount // Number of occupied entries
	var capacity = 0 as hashtable.TableCapacity // Total slots
	/// ⭐⭐ **A TOMBSTONE OCCUPIES A PROBE PATH, SO THE LOAD FACTOR HAS TO COUNT IT.** A probe stops at an
	/// EMPTY slot and walks over a tombstone, and a removal turns an occupied slot into one without ever
	/// giving an empty slot back — so a table that is inserted into and removed from in turn spends its
	/// empty slots one at a time and ends up probing its whole capacity for every key it does not hold,
	/// while `count` never moves and a load factor reading `count` alone never rehashes. `ensureCapacity`
	/// reads occupancy as `count + removalsSinceRehash` for that reason, and a rehash clears it. An insert
	/// that takes a tombstone does not give one back, so the churn spec
	/// `a-churn-of-inserts-and-removes-makes-the-same-allocations-wherever-the-keys-hash` holds.
	var removalsSinceRehash = 0 as hashtable.TableCapacity

	/// Create an empty map
	public static function create() returns Self
		return Self{}
	end 'create'

	// Default type for dictionary literals - compiler discovers this via BuiltinDictionaryLiteral interface
	static function init(initKeys KeyMemory, initValues ValueMemory) returns Self where Key implements Droppable and Copyable, Value implements Droppable and Copyable
		// Get number of elements in the managed memory buffers
		let numElements = initKeys.length()
		// Calculate capacity: at least 16, or next power of 2 above numElements * 2
		var cap = 16 as hashtable.TableCapacity
		while cap < (try numElements * 2 otherwise panic("out of range")) 'calc_cap'
			cap = try cap * 2 otherwise panic("out of range")
		end 'calc_cap'
		// Allocate internal arrays with preallocated capacity
		var ks = KeyArray{}
		ks.resize(cap)
		var vs = ValueArray{}
		vs.resize(cap)
		var sts = StateArray{}
		sts.resize(cap)
		var hs = HashSlotArray{}
		hs.resize(cap)
		// Create the map with arrays and preallocated capacity (count defaults to 0)
		var result = Self{keys: ks, values: vs, states: sts, hashes: hs, capacity: cap}
		// Insert each key-value pair from the init arrays
		for i in 0 upto numElements 'insert_loop'
			let k = try initKeys.get(i) otherwise 'kErr'
				panic("Map.init: initKeys.get OOB — i < numElements guaranteed")
			end 'kErr'
			let v = try initValues.get(i) otherwise 'vErr'
				panic("Map.init: initValues.get OOB — i < numElements guaranteed")
			end 'vErr'
			result.upsert(k, value: v)
		end 'insert_loop'
		return result
	end 'init'

	// Internal: initialize storage when capacity is zero, then rehash when the slots a probe walks —
	// live entries and the removals since the last rehash — pass 75% of them
	function ensureCapacity(mutates self) where Key implements Droppable and Copyable, Value implements Droppable and Copyable
		if capacity == 0 'init_empty'
			keys = KeyArray{}
			keys.resize(16)
			values = ValueArray{}
			values.resize(16)
			states = StateArray{}
			states.resize(16)
			hashes = HashSlotArray{}
			hashes.resize(16)
			capacity = 16
		end 'init_empty'
		let loadLimit = trunc(try (capacity * 3) / 4 otherwise panic("out of range"))
		if storedCount >= loadLimit 'full_of_entries'
			rehash(try capacity * 2 otherwise panic("out of range"))
			return
		end 'full_of_entries'
		if (try storedCount + removalsSinceRehash otherwise panic("out of range")) < loadLimit 'every_probe_path_still_ends'
			return
		end 'every_probe_path_still_ends'
		// The live entries fit and the tombstones do not, which is churn. Rehash into the capacity the
		// LIVE count needs: the same one while the entries are under half the limit, twice it otherwise.
		// Either way the next rehash is a quarter of a table's worth of operations away, so clearing
		// tombstones stays amortized constant.
		rehash(capacity if (try storedCount * 2 otherwise panic("out of range")) < loadLimit else (try capacity * 2 otherwise panic("out of range")))
	end 'ensureCapacity'

	// Internal: write a key-value pair into the given slot. `hash` is the key's
	// precomputed hash (from findSlot), cached in the parallel `hashes` array so
	// probes can skip the full key.equals() when hashes differ.
	//
	// The panics name "the probe" rather than `findSlot` because `rehash` also calls this, with an
	// index from its own inline empty-slot scan; both probes mask with `capacity - 1`, so both
	// hand over an index in [0, capacity).
	function insertAtSlot(mutates self, slotIndex hashtable.TableSlotIndex, key Key, value Value, hash HashValue) where Key implements Droppable and Copyable, Value implements Droppable and Copyable
		try keys.set(slotIndex as ElementIndex, value: key.clone()) otherwise panic("Map.insertAtSlot: keys.set OOB — slot from the probe is always in-bounds")
		try values.set(slotIndex as ElementIndex, value: value.clone()) otherwise panic("Map.insertAtSlot: values.set OOB — slot from the probe is always in-bounds")
		try states.set(slotIndex as ElementIndex, value: hashtable.SlotState.Occupied) otherwise panic("Map.insertAtSlot: states.set OOB — slot from the probe is always in-bounds")
		try hashes.set(slotIndex as ElementIndex, value: hash) otherwise panic("Map.insertAtSlot: hashes.set OOB — slot from the probe is always in-bounds")
		storedCount = try storedCount + 1 otherwise panic("out of range")
	end 'insertAtSlot'

	/// Insert a key-value pair into the map
	/// Throws if the key already exists
	/// Automatically resizes the map when load factor exceeds 75%
	public function insert(mutates self, key Key, value Value) throws MapError where Key implements Droppable and Copyable, Value implements Droppable and Copyable
		ensureCapacity()
		let hash = key.hash()
		let slotIndex = try findSlot(key, hash: hash) otherwise panic("Map.insert: findSlot named no slot — ensureCapacity established capacity > 0, which is the only condition findSlot throws on")
		let state = try states.get(slotIndex as ElementIndex) otherwise panic("Map.insert: states.get OOB — slot from findSlot is always in-bounds")
		if stateIsOccupied(state) 'found'
			throw MapError.keyAlreadyExists
		end 'found'
		insertAtSlot(slotIndex, key: key, value: value, hash: hash)
	end 'insert'

	/// Insert or update a key-value pair in the map
	/// If the key already exists, updates the value
	/// Automatically resizes the map when load factor exceeds 75%
	public function upsert(mutates self, key Key, value Value) where Value implements Droppable and Copyable, Key implements Droppable and Copyable
		ensureCapacity()
		let hash = key.hash()
		let slotIndex = try findSlot(key, hash: hash) otherwise panic("Map.upsert: findSlot named no slot — ensureCapacity established capacity > 0, which is the only condition findSlot throws on")
		let state = try states.get(slotIndex as ElementIndex) otherwise panic("Map.upsert: states.get OOB — slot from findSlot is always in-bounds")
		if stateIsOccupied(state) 'found'
			try values.set(slotIndex as ElementIndex, value: value.clone()) otherwise panic("Map.upsert: values.set OOB — slot from findSlot is always in-bounds")
			return
		end 'found'
		insertAtSlot(slotIndex, key: key, value: value, hash: hash)
	end 'upsert'

	/// Get the value for a key, throws if not found
	public function get(key Key) returns Value throws MapError where Value implements Copyable, Key implements Copyable
		// findSlot's own `keyNotFound` (the empty table) is exactly this function's answer, so it
		// propagates rather than being caught and re-thrown.
		let slotIndex = try findSlot(key, hash: key.hash())
		if slotHoldsKey(slotIndex) 'found'
			return try values.get(slotIndex as ElementIndex) otherwise panic("Map.get: values.get OOB — slot from findSlot is always in-bounds")
		end 'found'
		throw MapError.keyNotFound
	end 'get'

	/// Check if key exists in the map
	public function contains(key Key) returns bool where Key implements Copyable
		let slotIndex = try findSlot(key, hash: key.hash()) otherwise return false
		return slotHoldsKey(slotIndex)
	end 'contains'

	/// Remove key from map, returns true if key was present
	public function remove(mutates self, key Key) returns bool where Key implements Droppable and Copyable, Value implements Droppable
		let slotIndex = try findSlot(key, hash: key.hash()) otherwise return false
		if slotHoldsKey(slotIndex) 'found'
			// A tombstone owns nothing: holding the key and value until the map drops would keep them alive and
			// make the map a second owner of records the caller still holds. The cached hash stays, because the
			// hash-guard only runs inside findSlot's Occupied branch.
			try keys.clearSlot(slotIndex as ElementIndex) otherwise panic("Map.remove: keys.clearSlot OOB — slot from findSlot is always in-bounds")
			try values.clearSlot(slotIndex as ElementIndex) otherwise panic("Map.remove: values.clearSlot OOB — slot from findSlot is always in-bounds")
			try states.set(slotIndex as ElementIndex, value: hashtable.SlotState.Deleted) otherwise panic("Map.remove: states.set OOB — slot from findSlot is always in-bounds")
			storedCount = try storedCount - 1 otherwise panic("out of range")
			removalsSinceRehash = try removalsSinceRehash + 1 otherwise panic("out of range")
			return true
		end 'found'
		return false
	end 'remove'

	/// Get number of entries in the map
	public function count() returns EntryCount
		return storedCount
	end 'count'

	/// Create a fresh iterator positioned at the first occupied entry.
	/// Throws IterationError.exhausted if the map is empty.
	public function createIterator() returns MapIterator throws IterationError
		return try MapIterator.create(keys, values: values, states: states, capacity: capacity)
	end 'createIterator'

	/// Get current capacity (total number of slots)
	public function getCapacity() returns hashtable.TableCapacity
		return capacity
	end 'getCapacity'

	// Internal: find the slot for a key using linear probing.
	// `hash` is the key's precomputed hash (computed once by the caller).
	//
	// Returns a REAL slot index, always in [0, capacity): EITHER the slot holding the key OR
	// the vacancy an insert would take. Callers tell those two apart by re-reading the slot's
	// state with `slotHoldsKey`, which is exact because a returned vacancy is an Empty slot or
	// the first tombstone on the probe path — never an Occupied one.
	//
	// Throws `MapError.keyNotFound` only when there is no slot to NAME at all, which is the
	// empty table. "This key is in no slot" is literally true of an empty map, so the existing
	// error is the right one and no new case is minted.
	function findSlot(key Key, hash HashValue) returns hashtable.TableSlotIndex throws MapError where Key implements Copyable
		if capacity == 0 'empty'
			throw MapError.keyNotFound
		end 'empty'
		// capacity is always a power of two (starts at 16, only ever doubled), so
		// `and (capacity - 1)` selects the low bits — identical to `mod capacity` for the
		// non-negative HashValue range, but cheaper. It is the SPREAD hash that is masked,
		// never the raw one: see `spreadHash` for the measured quadratic that costs.
		let mask = (capacity - 1) as hashtable.TableSlotIndex
		var index = (spreadHash(hash) and (try mask as HashValue otherwise panic("out of range"))) as hashtable.TableSlotIndex
		var firstDeleted = 0 as hashtable.TableSlotIndex
		var sawDeleted = false
		var probes = 0 as hashtable.TableCapacity
		while probes < capacity 'probe'
			let state = try states.get(index as ElementIndex) otherwise panic("Map.findSlot: states.get OOB — index is masked into [0, capacity)")
			let isEmpty = match state 'se1'
				Empty gives true
				Occupied gives false
				Deleted gives false
			end 'se1'
			if isEmpty 'empty_slot'
				// Key not found — hand back the vacancy an insert should take: the first tombstone
				// on the probe path if there was one, else this empty slot.
				return firstDeleted if sawDeleted else index
			end 'empty_slot'
			let isDeleted = match state 'sd1'
				Deleted gives true
				Empty gives false
				Occupied gives false
			end 'sd1'
			if isDeleted and not sawDeleted 'mark_deleted'
				firstDeleted = index
				sawDeleted = true
			end 'mark_deleted'
			let isOccupied = match state 'so1'
				Occupied gives true
				Empty gives false
				Deleted gives false
			end 'so1'
			if isOccupied 'check_key'
				// Skip the full key.equals() unless the cached hash matches — this
				// is the hot-path win for string-keyed maps.
				let slotHash = try hashes.get(index as ElementIndex) otherwise panic("Map.findSlot: hashes.get OOB — the hash column is parallel to the states")
				if slotHash == hash 'hash_match'
					let existing = try keys.get(index as ElementIndex) otherwise panic("Map.findSlot: an occupied slot holds a key")
					if existing == key 'found'
						return index
					end 'found'
				end 'hash_match'
			end 'check_key'
			// Linear probing
			index = (index + 1) and mask
			probes = probes + 1
		end 'probe'
		// All slots probed without finding the key or an empty slot. A tombstone is still a vacancy
		// an insert can take, so it is a perfectly good answer.
		if sawDeleted 'use_deleted_fallback'
			return firstDeleted
		end 'use_deleted_fallback'
		// Falling through means every slot is Occupied — count == capacity — which `ensureCapacity`
		// forbids by rehashing at 75%. That is a broken invariant, not a runtime condition a caller
		// could handle, so it panics rather than throwing.
		panic("Map.findSlot: probed every slot and found neither the key nor a vacancy — the 75% load-factor invariant is broken")
	end 'findSlot'

	// Internal: does this slot hold a live entry? This is how `findSlot`'s callers tell a hit from
	// a miss, and it is exact because the vacancy findSlot hands back is always Empty or a
	// tombstone. It reads the same `states` cache line the probe just touched.
	function slotHoldsKey(slotIndex hashtable.TableSlotIndex) returns bool
		return stateIsOccupied(try states.get(slotIndex as ElementIndex) otherwise panic("Map.slotHoldsKey: states.get OOB — slot from findSlot is always in-bounds"))
	end 'slotHoldsKey'

	function stateIsOccupied(state hashtable.SlotState) returns bool
		return match state 'occupied'
			Occupied gives true
			Empty gives false
			Deleted gives false
		end 'occupied'
	end 'stateIsOccupied'

	// Internal: rebuild the table at `wantedCapacity`, which is twice the current one when the live
	// entries have filled it and the current one when only tombstones have — the fresh table has none,
	// which is what a churning map is rehashed for.
	function rehash(mutates self, wantedCapacity hashtable.TableCapacity) where Key implements Droppable and Copyable, Value implements Droppable and Copyable
		let oldCapacity = capacity
		var newCapacity = wantedCapacity
		if newCapacity == 0 'handle_zero'
			newCapacity = 16
		end 'handle_zero'
		// Allocate new arrays with preallocated capacity
		var newKeys = KeyArray{}
		newKeys.resize(newCapacity)
		var newValues = ValueArray{}
		newValues.resize(newCapacity)
		var newStates = StateArray{}
		newStates.resize(newCapacity)
		var newHashes = HashSlotArray{}
		newHashes.resize(newCapacity)
		// Save old arrays for rehashing, then replace with new ones
		let oldKeys = keys.clone()
		let oldValues = values.clone()
		let oldStates = states.clone()
		let oldHashes = hashes.clone()
		keys = newKeys
		values = newValues
		states = newStates
		hashes = newHashes
		capacity = newCapacity
		storedCount = 0
		removalsSinceRehash = 0
		// newCapacity is a power of two, so masking the SPREAD hash selects the low bits
		// (see `spreadHash`).
		let mask = try (capacity - 1) as hashtable.TableSlotIndex otherwise panic("out of range")
		// Rehash all occupied entries from old arrays. The new table is fresh
		// (no tombstones), so we can place each entry with a plain empty-slot
		// probe and reuse the cached hash instead of re-calling key.hash().
		for i in 0 upto oldCapacity 'eachOldSlot'
			let state = try oldStates.get(i) otherwise panic("Map.rehash: oldStates.get OOB — i is below the old capacity")
			let isOccupied = match state 'so1'
				Occupied gives true
				Empty gives false
				Deleted gives false
			end 'so1'
			if isOccupied 'occupied'
				let key = try oldKeys.get(i) otherwise panic("Map.rehash: an occupied slot holds a key")
				let value = try oldValues.get(i) otherwise panic("Map.rehash: an occupied slot holds a value")
				let hash = try oldHashes.get(i) otherwise panic("Map.rehash: oldHashes.get OOB — the hash column is parallel to the states")
				var index = (spreadHash(hash) and (try mask as HashValue otherwise panic("out of range"))) as hashtable.TableSlotIndex
				var currentState = try states.get(index as ElementIndex) otherwise panic("Map.rehash: states.get OOB — index is masked into [0, capacity)")
				var isNotEmpty = match currentState 'ns1'
					Empty gives false
					Occupied gives true
					Deleted gives true
				end 'ns1'
				while isNotEmpty 'find_slot'
					index = (index + 1) and mask
					currentState = try states.get(index as ElementIndex) otherwise panic("Map.rehash: states.get OOB — index is masked into [0, capacity)")
					isNotEmpty = match currentState 'ns2'
						Empty gives false
						Occupied gives true
						Deleted gives true
					end 'ns2'
				end 'find_slot'
				insertAtSlot(index, key: key, value: value, hash: hash)
			end 'occupied'
		end 'eachOldSlot'
	end 'rehash'
end 'Map'

/// Iterator for Map — scans hash table slots for occupied entries.
/// Positioning invariant: iterIndex always points at an occupied slot (or ==
/// capacity after the final advance throws). current() reads that slot without
/// a state check.
public type MapIterator uses Key, Value implements Iterator with Entry where Key implements Hashable and Equatable
	public typealias Entry = (Key, Value)
	public typealias IterKeyArray = Array with Key
	public typealias IterValueArray = Array with Value
	export typealias IterStateArray = Array with hashtable.SlotState
	typealias KeySlots = hashtable.SlotCursor with Key
	typealias ValueSlots = hashtable.SlotCursor with Value
	typealias KeyCursor = __ManagedMemoryCursor with Key
	typealias ValueCursor = __ManagedMemoryCursor with Value
	var keys as KeyCursor
	var values as ValueCursor
	var states as hashtable.SlotStateCursor
	var capacity as hashtable.TableCapacity

	export static function create(keys IterKeyArray, values IterValueArray, states IterStateArray, capacity hashtable.TableCapacity) returns Self throws IterationError
		var stateCursor = try states.managed.createCursor() otherwise throw IterationError.exhausted
		let first = try hashtable.findNextOccupied(stateCursor, capacity: capacity, from: 0)
		return Self{keys: KeySlots.over(keys.managed, at: first), values: ValueSlots.over(values.managed, at: first), states: stateCursor, capacity: capacity}
	end 'create'

	public function current() returns borrowed Entry
		return (keys.current(), values.current())
	end 'current'

	public function advance(mutates self) throws IterationError
		let next = try hashtable.findNextOccupied(states, capacity: capacity, from: try (states.index() as hashtable.TableSlotIndex) + 1 otherwise panic("out of range"))
		KeySlots.move(keys, to: next)
		ValueSlots.move(values, to: next)
	end 'advance'
end 'MapIterator'
