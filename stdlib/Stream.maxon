// maxon's stdlib/Stream.maxon and helpers/stream/streamBytes.maxon, written here until they convert: they name the sources
// of the network, TLS, files and child processes, which this library has not got yet, and they spell constants and
// arithmetic by maxon's rules (README, "Where it differs from Maxon"). The names, the behaviour and the messages are maxon's.

public typealias ReadCapacity = int(1 to i64.max)

public typealias LineCap = int(0 to u64.max) implements BytePos

let UnboundedLineCap = u64.max as LineCap

public let StreamMessageCap = (64 * 1024 * 1024) as LineCap

let StreamChunkBytes = 65536 as ReadCapacity

let LineFeed = "\n"

let CarriageReturn = 13 as Byte

public typealias StdinReader = StreamReader with StdinSource

public union StreamError implements Error
	timedOut
	closed
	failed(reason String)

	public function displayReason() returns String
		return match self 'e'
			timedOut gives "the read timed out"
			closed gives "the stream was closed"
			failed(reason) gives "the read failed: {reason}"
		end 'e'
	end 'displayReason'
end 'StreamError'

public union LineRead
	line(text String)
	ended
	pastTheCap
end 'LineRead'

public union LineOrEnd
	line(text String)
	ended
end 'LineOrEnd'

union UntilRead
	text(length BytePos)
	ended
	pastTheCap
end 'UntilRead'

public interface ByteSource
	/// Up to `most` bytes, parking until one arrives; empty only at the end of the stream.
	function readSome(mutates self, most ReadCapacity) returns ByteArray throws StreamError
end 'ByteSource'

public type StreamReader uses Source where Source implements ByteSource
	public var source as Source
	var backlog as ByteBacklog
	var atEnd as bool

	/// A reader over `source` with nothing buffered.
	public static function over(consumes source Source) returns Self
		return Self{source: source, backlog: ByteBacklog.create(), atEnd: false}
	end 'over'

	/// The bytes read from the source and not yet handed out.
	public function unreadBytes() returns BytePos
		return self.backlog.unread()
	end 'unreadBytes'

	/// The next line without its LF or a CR before it, however long it is.
	public function readLine(mutates self) returns LineOrEnd throws StreamError
		let read = try self.readLineWithin(UnboundedLineCap)
		return match consumes read 'read'
			line(text) gives LineOrEnd.line(text)
			ended gives LineOrEnd.ended
			pastTheCap panic("StreamReader.readLine: a read with no cap never passes one")
		end 'read'
	end 'readLine'

	/// The next line as `readLine` reads it, or `pastTheCap` when no LF arrives within `cap` bytes, which stay buffered.
	public function readLineWithin(mutates self, cap LineCap) returns LineRead throws StreamError
		let read = try self.seekDelimiter(LineFeed, cap: cap)
		match read 'read'
			text(length) then return LineRead.line(self.lineOf(length))
			ended then return try self.finalLine()
			pastTheCap then return LineRead.pastTheCap
		end 'read'
	end 'readLineWithin'

	/// The text up to `delimiter`, which is consumed and not returned; `pastTheCap` as `readLineWithin`.
	public function readUntil(mutates self, delimiter String, cap LineCap) returns LineRead throws StreamError
		let read = try self.seekDelimiter(delimiter, cap: cap)
		match read 'read'
			text(length) then return LineRead.line(String.from(self.backlog.take(length, skipping: delimiter.byteLength() as BytePos)))
			ended then return LineRead.ended
			pastTheCap then return LineRead.pastTheCap
		end 'read'
	end 'readUntil'

	/// Exactly `count` bytes, fewer only at the end of the stream.
	public function readBytes(mutates self, count BytePos) returns ByteArray throws StreamError
		while self.unreadBytes() < count and not self.atEnd 'filling'
			try self.fill()
		end 'filling'
		return self.backlog.takeAtMost(count)
	end 'readBytes'

	/// Every byte left in the stream, the buffered ones first.
	public function readToEnd(mutates self) returns ByteArray throws StreamError
		while not self.atEnd 'draining'
			try self.fill()
		end 'draining'
		return self.backlog.take(self.unreadBytes(), skipping: 0)
	end 'readToEnd'

	function seekDelimiter(mutates self, delimiter String, cap LineCap) returns UntilRead throws StreamError
		let width = delimiter.byteLength()
		let overlap = try width - 1 otherwise panic("streamFind: the delimiter is empty")
		var scanned = 0 as BytePos
		while true 'seeking'
			match self.backlog.find(delimiter, from: scanned) 'found'
				at(length) then return streamTextBefore(length, cap: cap)
				absent then scanned = try self.unreadBytes() - overlap otherwise 0
			end 'found'
			if scanned > cap 'pastTheCap'
				return UntilRead.pastTheCap
			end 'pastTheCap'
			try self.fill()
			if self.atEnd 'ended'
				return UntilRead.ended
			end 'ended'
		end 'seeking'
		panic("StreamReader.seekDelimiter: the search loop returns when it finds the delimiter, passes the cap or meets the end")
	end 'seekDelimiter'

	function lineOf(mutates self, length BytePos) returns String
		var textLength = length
		var skipping = LineFeed.byteLength() as BytePos
		if length > 0 'mayEndInCarriageReturn'
			let last = try length - 1 otherwise 0
			if self.backlog.byteAt(last) == CarriageReturn 'carriageReturn'
				textLength = last
				skipping = try skipping + 1 otherwise panic("StreamReader.lineOf: a line ending past a position")
			end 'carriageReturn'
		end 'mayEndInCarriageReturn'
		return String.from(self.backlog.take(textLength, skipping: skipping))
	end 'lineOf'

	function finalLine(mutates self) returns LineRead throws StreamError
		if self.unreadBytes() == 0 'nothingLeft'
			return LineRead.ended
		end 'nothingLeft'
		return LineRead.line(String.from(try self.readToEnd()))
	end 'finalLine'

	function fill(mutates self) throws StreamError
		if self.atEnd 'finished'
			return
		end 'finished'
		let arrived = try self.source.readSome(StreamChunkBytes)
		if arrived.isEmpty() 'sourceEnded'
			self.atEnd = true
			return
		end 'sourceEnded'
		self.backlog.append(arrived)
	end 'fill'
end 'StreamReader'

function streamTextBefore(length BytePos, cap LineCap) returns UntilRead
	if length > cap 'pastTheCap'
		return UntilRead.pastTheCap
	end 'pastTheCap'
	return UntilRead.text(length)
end 'streamTextBefore'

export union StreamFound
	at(offset BytePos)
	absent
end 'StreamFound'

// ByteBacklog is the bytes a reader read and has not handed out: those before consumed are handed out already.
export type ByteBacklog
	var bytes as ByteArray
	var consumed as BytePos

	export static function create() returns ByteBacklog
		return Self{bytes: ByteArray.create(0), consumed: 0}
	end 'create'

	export function unread() returns BytePos
		return try (self.bytes.count() as BytePos) - self.consumed otherwise panic("ByteBacklog.unread: more bytes handed out than read")
	end 'unread'

	export function byteAt(offset BytePos) returns Byte
		let at = try self.consumed + offset otherwise panic("ByteBacklog.byteAt: {offset} is past a position")
		return try self.bytes.get(at) otherwise panic("ByteBacklog.byteAt: {offset} is inside the {self.unread()} unread bytes")
	end 'byteAt'

	export function find(needle String, from BytePos) returns StreamFound
		let start = try self.consumed + from otherwise panic("ByteBacklog.find: {from} is past a position")
		return match streamFind(self.bytes, needle: needle, from: start) 'found'
			at(position) gives StreamFound.at(try position - self.consumed otherwise panic("ByteBacklog.find: a match before the unread bytes"))
			absent gives StreamFound.absent
		end 'found'
	end 'find'

	export function append(mutates self, arrived ByteArray)
		if self.consumed > 0 'compact'
			self.bytes = try self.bytes.slice(self.consumed, endIndex: self.bytes.count()) otherwise panic("ByteBacklog.append: the consumed bytes are inside the backlog")
			self.consumed = 0
		end 'compact'
		self.bytes.append(arrived)
	end 'append'

	export function takeAtMost(mutates self, most BytePos) returns ByteArray
		let left = self.unread()
		return self.take(most if left > most else left, skipping: 0)
	end 'takeAtMost'

	export function take(mutates self, length BytePos, skipping BytePos) returns ByteArray
		let stop = try self.consumed + length otherwise panic("ByteBacklog.take: {length} bytes are past a position")
		let taken = try self.bytes.slice(self.consumed, endIndex: stop) otherwise panic("ByteBacklog.take: {length} bytes are unread from {self.consumed}")
		self.consumed = try stop + skipping otherwise panic("ByteBacklog.take: {skipping} bytes are past a position")
		if self.consumed == self.bytes.count() 'drained'
			self.bytes.clear()
			self.consumed = 0
		end 'drained'
		return taken
	end 'take'
end 'ByteBacklog'

function streamFind(bytes ByteArray, needle String, from BytePos) returns StreamFound
	let width = needle.byteLength()
	if width == 0 'noNeedle'
		panic("streamFind: the delimiter is empty")
	end 'noNeedle'
	let total = bytes.count()
	let past = try from + width otherwise return StreamFound.absent
	if total < past 'tooShort'
		return StreamFound.absent
	end 'tooShort'
	let first = needle.byteAt(0)
	let lastStart = try total - width otherwise panic("streamFind: the needle is longer than the bytes searched")
	for position in from to lastStart 'eachStart'
		let candidate = try bytes.get(position) otherwise panic("streamFind: {position} is inside the {total} bytes searched")
		if candidate == first and streamMatchesAt(bytes, position: position, needle: needle) 'found'
			return StreamFound.at(position)
		end 'found'
	end 'eachStart'
	return StreamFound.absent
end 'streamFind'

function streamMatchesAt(bytes ByteArray, position BytePos, needle String) returns bool
	for offset in 1 upto needle.byteLength() 'eachByte'
		let at = try position + offset otherwise return false
		let candidate = try bytes.get(at) otherwise panic("streamMatchesAt: {at} is inside the bytes searched")
		if candidate != needle.byteAt(offset) 'differs'
			return false
		end 'differs'
	end 'eachByte'
	return true
end 'streamMatchesAt'
