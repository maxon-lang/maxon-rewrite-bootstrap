// maxon's stdlib/Console.maxon, written here with Stream.maxon until it converts.

/// Standard input as a `ByteSource`; `Console.stdin()` reads it through a `StreamReader`.
public type StdinSource implements stream.ByteSource
	static function create() returns StdinSource
		return Self{}
	end 'create'

	public function readSome(mutates self, most stream.ReadCapacity) returns ByteArray throws stream.StreamError
		return ByteArray.init(__Builtins.readStdin(most))
	end 'readSome'
end 'StdinSource'

public typealias StdinReader = stream.StreamReader with StdinSource

/// Convenience factory namespace. `Console.stdin()` is the typical entry point.
public type Console
	/// A reader over standard input with nothing buffered; keep one for the life of the program.
	public static function stdin() returns StdinReader
		return stream.StreamReader.over(StdinSource.create())
	end 'stdin'

	/// Whether output written to stdout may carry ANSI color escape sequences.
	public static function stdoutWantsColor() returns bool
		return __Builtins.stdoutWantsAnsiColor()
	end 'stdoutWantsColor'
end 'Console'
