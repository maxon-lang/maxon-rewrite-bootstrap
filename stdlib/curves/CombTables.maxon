let p256CombModuliPrime = WorkspaceLimbs from [3, 0, 4294967295, 4294967291, 4294967294, 4294967295, 4294967293, 4]

let p256CombModuliOrder = WorkspaceLimbs from [3195661986, 2200194197, 1237151654, 1184463260, 728493145, 675656249, 4091106848, 1726033300]

let p384CombModuliPrime = WorkspaceLimbs from [1, 4294967294, 0, 2, 0, 4294967294, 0, 2, 1, 0, 0, 0]

let p384CombModuliOrder = WorkspaceLimbs from [431229353, 758225700, 3743065113, 4282221029, 4239927623, 3158198330, 1252728005, 3557640471, 673605781, 1068522362, 725204769, 210038273]

function combTable(curve CombCurve) returns WorkspaceLimbs
	return match curve 'curve'
		p256 gives p256CombTable
		p384 gives p384CombTable
		ed25519 gives ed25519CombTable
	end 'curve'
end 'combTable'

function combModuli(curve CombCurve) returns CombModuli
	return match curve 'curve'
		p256 gives CombModuli.create(p256CombModuliPrime, order: p256CombModuliOrder)
		p384 gives CombModuli.create(p384CombModuliPrime, order: p384CombModuliOrder)
		ed25519 gives panic("curves: ed25519 keeps no Montgomery moduli")
	end 'curve'
end 'combModuli'
