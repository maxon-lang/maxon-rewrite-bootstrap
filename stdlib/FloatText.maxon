// maxon's float.fromString, which maxon reads with the reader of its float literals (Builtins.maxon's
// __float_bitsFromText) and which is minimaxon's own here, since that file is the compiler's: the same grammar, and the
// double correctly rounded, as the compiler reads a literal (self/ast/floats.maxon). The digits are one big integer and
// the power of ten scales it or its denominator, so the value is an exact ratio that is rounded once, to the nearest
// double, ties to even. floatTextRead is the reader of a prefix of a String, which fromString is built on.

typealias FloatTextLimb = int(0 to 4294967295)

typealias FloatTextLimbs = Array with FloatTextLimb

typealias FloatTextShift = int(0 to 31)

// FloatTextOrder is how two big integers compare: -1, 0 or 1 as the first is less, equal or greater.
typealias FloatTextOrder = int(-1 to 1)

typealias FloatTextExponent = int(-2000000 to 2000000)

let floatTextLimbMask = 4294967295 as Count

let floatTextLimbBits = 32 as Count

let floatTextLimbBase = 4294967296 as Count

let floatTextPrecision = 53 as FloatTextExponent

let floatTextUnitExponent = 1075 as FloatTextExponent

let floatTextMinNormalExponent = -1022 as FloatTextExponent

let floatTextMaxExponent = 1023 as FloatTextExponent

let floatTextExponentBias = 1023 as FloatTextExponent

let floatTextSignificandBits = 52 as Count

let floatTextImplicitBit = 4503599627370496 as Count

let floatTextSignBit = 9223372036854775808 as Count

// The decimal magnitudes past which the text is surely past f64.max, or surely rounds to 0: a bound on the powers of ten
// the ratio is built of.
let floatTextOverflowMagnitude = 310 as FloatTextExponent

let floatTextUnderflowMagnitude = -400 as FloatTextExponent

// floatTextExponentClamp is where an exponent stops growing: past both ends of the range, whatever the digits before it
// shift by, as long as the text is shorter than the clamp, and ten times it and one more digit still fit FloatTextExponent.
let floatTextExponentClamp = 100000 as FloatTextExponent

// The bits of the infinity that a text past f64.max reads as, before the sign.
let floatTextInfinityBits = 9218868437227405312 as Count

// FloatTextRead is the number a prefix of a String is: its double's 64 bits (the infinity's once pastRange, the text
// naming a magnitude past f64.max), and the byte position after the last byte of the literal.
type FloatTextRead
	export let bits as Count
	export let pastRange as bool
	export let endAt as Count

	static function create(bits Count, pastRange bool, endAt Count) returns FloatTextRead
		return FloatTextRead{bits: bits, pastRange: pastRange, endAt: endAt}
	end 'create'
end 'FloatTextRead'

extension float
	/// The double the text is, correctly rounded, in the type the call names (`Ratio.fromString("0.5")` is a `Ratio`): an
	/// optional `-`, digits with `_` between them, at most one `.`, and an exponent `e` or `E` with an optional sign, as a
	/// float literal is written. Text that is not one is `ParseError.invalidFormat`; a magnitude past `f64.max`, or a
	/// number outside the range of the type, is `ParseError.outOfRange`.
	public static function fromString(input String) returns Self throws ParseError
		let read = try floatTextRead(input, at: 0)
		if read.endAt != input.byteLength() 'trailing'
			throw ParseError.invalidFormat
		end 'trailing'
		if read.pastRange 'past'
			throw ParseError.outOfRange
		end 'past'
		let value = __Builtins.bitsToFloat(floatTextSigned(read.bits))
		return try value as Self otherwise throw ParseError.outOfRange
	end 'fromString'
end 'float'

// floatTextSigned is the 64 bits of a double as the signed integer bitsToFloat takes: the sign bit is its sign.
function floatTextSigned(bits Count) returns FullRangeInt
	if bits < floatTextSignBit 'positive'
		return try bits as FullRangeInt otherwise panic("FloatText: bits below the sign bit fit")
	end 'positive'
	return try ((bits - floatTextSignBit) as FullRangeInt) + i64.min otherwise panic("FloatText: bits with the sign bit fit")
end 'floatTextSigned'

enum FloatTextFailure implements Error
	overflow
end 'FloatTextFailure'

// floatTextRead reads the literal that starts at a byte position of the text: an optional `-`, the mantissa's digits,
// `_` and at most one `.`, and an exponent, and stops at the first byte that none of them admits. It is `invalidFormat`
// where the literal has no digit before its exponent.
function floatTextRead(text String, at Count) returns FloatTextRead throws ParseError
	let n = text.byteLength()
	var cursor = at
	var negative = false
	if cursor < n and text.byteAt(cursor) == ParseByte.minus 'sign'
		negative = true
		cursor = cursor + 1
	end 'sign'
	var digits = FloatTextLimbs.create(0)
	var significant = 0 as Count
	var fractionDigits = 0 as Count
	var pastPoint = false
	var sawDigit = false
	while cursor < n 'mantissa'
		let c = text.byteAt(cursor) as Count
		if c == ParseByte.point.rawValue 'point'
			if pastPoint 'second'
				break 'mantissa'
			end 'second'
			pastPoint = true
		end 'point' else if c >= ParseByte.zero.rawValue and c <= ParseByte.nine.rawValue 'digit'
			sawDigit = true
			if pastPoint 'fraction'
				fractionDigits = try fractionDigits + 1 otherwise throw ParseError.invalidFormat
			end 'fraction'
			let d = try (c - ParseByte.zero.rawValue) as FloatTextLimb otherwise panic("FloatText: a digit is below 10")
			if significant > 0 or d != 0 'counted'
				significant = try significant + 1 otherwise throw ParseError.invalidFormat
				floatTextMulAdd(digits, m: 10, add: d)
			end 'counted'
		end 'digit' else if c != ParseByte.underscore.rawValue 'other'
			break 'mantissa'
		end 'other'
		cursor = cursor + 1
	end 'mantissa'
	var exp10 = 0 as FloatTextExponent
	if cursor < n and (text.byteAt(cursor) == ParseByte.lowerE or text.byteAt(cursor) == ParseByte.upperE) 'exponent'
		cursor = cursor + 1
		var negativeExponent = false
		if cursor < n and (text.byteAt(cursor) == ParseByte.plus or text.byteAt(cursor) == ParseByte.minus) 'sign'
			negativeExponent = text.byteAt(cursor) == ParseByte.minus
			cursor = cursor + 1
		end 'sign'
		while cursor < n 'digits'
			let c = text.byteAt(cursor) as Count
			if c != ParseByte.underscore.rawValue 'digitOrEnd'
				if c < ParseByte.zero.rawValue or c > ParseByte.nine.rawValue 'notDigit'
					break 'digits'
				end 'notDigit'
				if exp10 < floatTextExponentClamp 'grow'
					exp10 = try exp10 * 10 + ((c - ParseByte.zero.rawValue) as FloatTextExponent) otherwise panic("FloatText: the exponent is clamped")
				end 'grow'
			end 'digitOrEnd'
			cursor = cursor + 1
		end 'digits'
		if negativeExponent 'negate'
			exp10 = -exp10
		end 'negate'
	end 'exponent'
	if not sawDigit 'empty'
		throw ParseError.invalidFormat
	end 'empty'
	let sign = floatTextSignBit if negative else 0
	if digits.count() == 0 'zero'
		return FloatTextRead.create(sign, pastRange: false, endAt: cursor)
	end 'zero'
	let fraction = try fractionDigits as FloatTextExponent otherwise throw ParseError.invalidFormat
	let kept = try significant as FloatTextExponent otherwise throw ParseError.invalidFormat
	let scale = try (exp10 - fraction) as FloatTextExponent otherwise throw ParseError.invalidFormat
	let magnitude = try scale + kept otherwise throw ParseError.invalidFormat
	if magnitude > floatTextOverflowMagnitude 'over'
		return FloatTextRead.create(floatTextInfinityBits or sign, pastRange: true, endAt: cursor)
	end 'over'
	if magnitude < floatTextUnderflowMagnitude 'under'
		return FloatTextRead.create(sign, pastRange: false, endAt: cursor)
	end 'under'
	var den = floatTextOne()
	if scale >= 0 'whole'
		floatTextMulPow10(digits, n: floatTextShift(scale))
	end 'whole' else 'fraction'
		floatTextMulPow10(den, n: floatTextShift(-scale))
	end 'fraction'
	let bits = try floatTextRound(digits, den: den) otherwise 'overflow'
		return FloatTextRead.create(floatTextInfinityBits or sign, pastRange: true, endAt: cursor)
	end 'overflow'
	return FloatTextRead.create(bits or sign, pastRange: false, endAt: cursor)
end 'floatTextRead'

function floatTextOne() returns FloatTextLimbs
	var one = FloatTextLimbs.create(0)
	one.push(1)
	return one
end 'floatTextOne'

function floatTextTrim(mutates a FloatTextLimbs)
	var n = a.count()
	while n > 0 and a[n - 1] == 0 'top'
		_ = try a.pop() otherwise panic("FloatText: a limb was just counted")
		n = n - 1
	end 'top'
end 'floatTextTrim'

// floatTextMulAdd sets a to a * m + add.
function floatTextMulAdd(mutates a FloatTextLimbs, m FloatTextLimb, add FloatTextLimb)
	let factor = m as Count
	var carry = add
	for i in 0 upto a.count() 'each'
		let t = (a[i] as Count) * factor + (carry as Count)
		a[i] = (t and floatTextLimbMask) as FloatTextLimb
		carry = (t / floatTextLimbBase) as FloatTextLimb
	end 'each'
	if carry != 0 'grow'
		a.push(carry)
	end 'grow'
	floatTextTrim(a)
end 'floatTextMulAdd'

function floatTextMulPow10(mutates a FloatTextLimbs, n Count)
	for _ in 0 upto n 'each'
		floatTextMulAdd(a, m: 10, add: 0)
	end 'each'
end 'floatTextMulPow10'

// floatTextShl is a * 2^n.
function floatTextShl(a FloatTextLimbs, n Count) returns FloatTextLimbs
	let part = (n mod floatTextLimbBits) as FloatTextShift
	var out = FloatTextLimbs.create(n / floatTextLimbBits)
	var carry = 0 as FloatTextLimb
	for i in 0 upto a.count() 'each'
		let t = ((a[i] as Count) shl part) + (carry as Count)
		out.push((t and floatTextLimbMask) as FloatTextLimb)
		carry = (t / floatTextLimbBase) as FloatTextLimb
	end 'each'
	out.push(carry)
	floatTextTrim(out)
	return out
end 'floatTextShl'

// floatTextCompare is -1, 0 or 1 as a is less than, equal to or greater than b.
function floatTextCompare(a FloatTextLimbs, b FloatTextLimbs) returns FloatTextOrder
	if a.count() != b.count() 'lengths'
		return -1 if a.count() < b.count() else 1
	end 'lengths'
	var i = a.count()
	while i > 0 'down'
		i = i - 1
		if a[i] != b[i] 'differs'
			return -1 if a[i] < b[i] else 1
		end 'differs'
	end 'down'
	return 0
end 'floatTextCompare'

// floatTextSub sets a to a - b, for a b that is not larger.
function floatTextSub(mutates a FloatTextLimbs, b FloatTextLimbs)
	var borrow = 0 as FloatTextLimb
	for i in 0 upto a.count() 'each'
		var sub = borrow as Count
		if i < b.count() 'part'
			sub = sub + (b[i] as Count)
		end 'part'
		let ai = a[i] as Count
		if ai >= sub 'fits'
			a[i] = try (ai - sub) as FloatTextLimb otherwise panic("FloatText: a difference is past a limb")
			borrow = 0
		end 'fits' else 'borrows'
			a[i] = try (ai + floatTextLimbMask + 1 - sub) as FloatTextLimb otherwise panic("FloatText: a borrow is past a limb")
			borrow = 1
		end 'borrows'
	end 'each'
	if borrow != 0 'negative'
		panic("FloatText: a subtraction went below 0")
	end 'negative'
	floatTextTrim(a)
end 'floatTextSub'

function floatTextBitLength(a FloatTextLimbs) returns FloatTextExponent
	let n = a.count()
	if n == 0 'zero'
		return 0
	end 'zero'
	var top = a[n - 1] as Count
	var bits = try ((n - 1) * floatTextLimbBits) as FloatTextExponent otherwise panic("FloatText: a number is past its bound")
	while top != 0 'bits'
		bits = try bits + 1 otherwise panic("FloatText: a number is past its bound")
		top = top shr 1
	end 'bits'
	return bits
end 'floatTextBitLength'

// floatTextShift is a shift that the exponents say is not negative, as a count of bits.
function floatTextShift(v FloatTextExponent) returns Count
	return try v as Count otherwise panic("FloatText: a shift is negative")
end 'floatTextShift'

// floatTextRound is the bits of the double nearest num / den, ties to even, for a num and a den that are not 0; past
// f64.max it fails.
function floatTextRound(num FloatTextLimbs, den FloatTextLimbs) returns Count throws FloatTextFailure
	var e0 = try (floatTextBitLength(num) - floatTextBitLength(den)) as FloatTextExponent otherwise panic("FloatText: a bit length is past its bound")
	if e0 >= 0 'up'
		if floatTextCompare(num, b: floatTextShl(den, n: floatTextShift(e0))) < 0 'below'
			e0 = try e0 - 1 otherwise panic("FloatText: a bit length is past its bound")
		end 'below'
	end 'up' else 'down'
		if floatTextCompare(floatTextShl(num, n: floatTextShift(-e0)), b: den) < 0 'below'
			e0 = try e0 - 1 otherwise panic("FloatText: a bit length is past its bound")
		end 'below'
	end 'down'
	if e0 > floatTextMaxExponent 'over'
		throw FloatTextFailure.overflow
	end 'over'
	var p = floatTextPrecision
	if e0 < floatTextMinNormalExponent 'subnormal'
		p = e0 + floatTextUnitExponent
	end 'subnormal'
	if p < 0 'under'
		return 0
	end 'under'
	let k = try (p - 1 - e0) as FloatTextExponent otherwise panic("FloatText: a scale is past its bound")
	var n = num.clone()
	var d = den.clone()
	if k >= 0 'scaleUp'
		n = floatTextShl(num, n: floatTextShift(k))
	end 'scaleUp' else 'scaleDown'
		d = floatTextShl(den, n: floatTextShift(-k))
	end 'scaleDown'
	var q = 0 as Count
	var i = floatTextShift(p)
	while i > 0 'bits'
		i = i - 1
		let di = floatTextShl(d, n: i)
		if floatTextCompare(n, b: di) >= 0 'set'
			floatTextSub(n, b: di)
			q = try q + (1 as Count shl i) otherwise panic("FloatText: a significand is past 53 bits")
		end 'set'
	end 'bits'
	let half = floatTextCompare(floatTextShl(n, n: 1), b: d)
	if half > 0 or (half == 0 and q mod 2 == 1) 'roundUp'
		q = try q + 1 otherwise panic("FloatText: a significand is past 53 bits")
	end 'roundUp'
	if p != floatTextPrecision 'subnormalBits'
		return q
	end 'subnormalBits'
	var biased = try (e0 + floatTextExponentBias) as FloatTextExponent otherwise panic("FloatText: an exponent is past its bound")
	var significand = q
	if significand == floatTextImplicitBit * 2 'carried'
		significand = floatTextImplicitBit
		biased = try biased + 1 otherwise panic("FloatText: an exponent is past its bound")
	end 'carried'
	if biased > floatTextMaxExponent + floatTextExponentBias 'carriedOver'
		throw FloatTextFailure.overflow
	end 'carriedOver'
	return try (floatTextShift(biased) shl floatTextSignificandBits) + (significand - floatTextImplicitBit) otherwise panic("FloatText: a significand lost its leading bit")
end 'floatTextRound'
