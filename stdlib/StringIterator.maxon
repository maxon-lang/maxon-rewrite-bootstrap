// A String's grapheme clusters through the iteration protocol, for code that reaches it through Iterable: a type parameter
// it stands for, or an interface value. A for over a String the code knows walks it in place, with no iterator (README,
// "Iteration"), and gives each cluster as this one's current() does.
extension String implements Iterable with (String, StringIterator)
	/// Create a fresh iterator over the grapheme clusters, which borrows the String.
	/// Throws IterationError.exhausted if the string is empty.
	public function createIterator() returns StringIterator throws IterationError
		return try StringIterator.create(self)
	end 'createIterator'
end 'String'

/// Iterator for String: its grapheme clusters in order, each lent as a view of the String, through a cursor that borrows it.
public type StringIterator implements Iterator with String
	var raw as __StringCursor

	export static function create(text String) returns Self throws IterationError
		let cursor = try __StringCursor.create(text) otherwise throw IterationError.exhausted
		return Self{raw: cursor}
	end 'create'

	public function current() returns borrowed String
		return raw.current()
	end 'current'

	public function advance(mutates self) throws IterationError
		try raw.advance() otherwise throw IterationError.exhausted
	end 'advance'
end 'StringIterator'
