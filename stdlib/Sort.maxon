// The sorts that maxon's `Array.sort` entry points call. maxon's are driftsort and pdqsort over the raw buffer; here a
// merge sort moves elements between arrays with `pop` and `push`, so it needs no copy of an element, and the unstable
// sorts are the stable one, which an unstable sort permits.
extension Array
	public typealias SortComparator = function(T, T) returns Ordering

	function driftsortRange(mutates self, lo ElementIndex, hi ElementIndex, cmp SortComparator) where T implements Droppable
		if hi <= (try lo + 1 otherwise panic("out of range")) 'trivial'
			return
		end 'trivial'
		var above = Self.create(0)
		while self.count() > hi 'detach'
			above.push(try self.pop() otherwise panic("driftsortRange: the array is longer than hi"))
		end 'detach'
		var middle = Self.create(0)
		while self.count() > lo 'lift'
			middle.push(try self.pop() otherwise panic("driftsortRange: the array is longer than lo"))
		end 'lift'
		middle = Self.flipped(Self.mergeSorted(Self.flipped(middle), cmp: cmp))
		while middle.count() > 0 'restore'
			self.push(try middle.pop() otherwise panic("driftsortRange: the sorted range is not empty"))
		end 'restore'
		while above.count() > 0 'reattach'
			self.push(try above.pop() otherwise panic("driftsortRange: the detached tail is not empty"))
		end 'reattach'
	end 'driftsortRange'

	function pdqsortRange(mutates self, lo ElementIndex, hi ElementIndex, cmp SortComparator) where T implements Droppable
		self.driftsortRange(lo, hi: hi, cmp: cmp)
	end 'pdqsortRange'

	static function flipped(consumes items Self) returns Self where T implements Droppable
		var source = items
		var result = Self.create(0)
		while source.count() > 0 'move'
			result.push(try source.pop() otherwise panic("flipped: the array is not empty"))
		end 'move'
		return result
	end 'flipped'

	static function mergeSorted(consumes items Self, cmp SortComparator) returns Self where T implements Droppable
		var left = items
		let total = left.count()
		if total < 2 'trivial'
			return left
		end 'trivial'
		var right = Self.create(0)
		for _ in 0 upto total shr 1 'split'
			right.push(try left.pop() otherwise panic("mergeSorted: the array holds total elements"))
		end 'split'
		right = Self.mergeSorted(Self.flipped(right), cmp: cmp)
		left = Self.mergeSorted(left, cmp: cmp)
		var merged = Self.create(0)
		while left.count() > 0 and right.count() > 0 'both'
			let leftLast = try left.count() - 1 otherwise panic("mergeSorted: the left half is not empty")
			let rightLast = try right.count() - 1 otherwise panic("mergeSorted: the right half is not empty")
			if cmp(left[leftLast], right[rightLast]) == Ordering.greaterThan 'leftLarger'
				merged.push(try left.pop() otherwise panic("mergeSorted: the left half is not empty"))
			end 'leftLarger' else 'rightLarger'
				merged.push(try right.pop() otherwise panic("mergeSorted: the right half is not empty"))
			end 'rightLarger'
		end 'both'
		while left.count() > 0 'drainLeft'
			merged.push(try left.pop() otherwise panic("mergeSorted: the left half is not empty"))
		end 'drainLeft'
		while right.count() > 0 'drainRight'
			merged.push(try right.pop() otherwise panic("mergeSorted: the right half is not empty"))
		end 'drainRight'
		return Self.flipped(merged)
	end 'mergeSorted'
end 'Array'
