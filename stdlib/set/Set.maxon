/// Hash set of unique elements, on the table of `Map`: a set is a map whose every value is true, so it shares the whole of
/// the map's probing, growth and tombstone handling.
/// @category Collections
// maxon's Set is its own open-addressing table; here there is one table implementation, the Map's.

public type Set uses Element implements core.Iterable with (Element, SetIterator), core.InitableFromArrayLiteral with Element where Element implements core.Hashable and core.Equatable
	public typealias SetIter = SetIterator with Element
	typealias Members = map.Map with (Element, bool)
	typealias Elements = Array with Element
	var members = Members.create()

	/// Create an empty set
	public static function create() returns Self
		return Self{}
	end 'create'

	/// Insert an element into the set; one that is there already is left as it is.
	public function insert(mutates self, consumes element Element) where Element implements Copyable
		if members.contains(element) 'present'
			return
		end 'present'
		try members.insert(element, value: true) otherwise panic("Set.insert: the member is absent")
	end 'insert'

	/// Create a set of the elements of `Set from [a, b, c]`, each moved in, in order: of two equal elements the first stays.
	static function init(consumes value Elements) returns Self where Element implements Droppable and Copyable
		var pending = value
		var reversed = Elements.create(0)
		reversed.reserve(pending.count())
		while pending.count() > 0 'reverse'
			reversed.push(try pending.pop() otherwise panic("Set.init: the pending elements are counted"))
		end 'reverse'
		pending.dropEmpty()
		var result = Self{}
		while reversed.count() > 0 'insert'
			result.insert(try reversed.pop() otherwise panic("Set.init: the reversed elements are counted"))
		end 'insert'
		reversed.dropEmpty()
		return result
	end 'init'

	public function contains(element Element) returns bool where Element implements Copyable
		return members.contains(element)
	end 'contains'

	/// Remove an element, answering whether it was there.
	public function remove(mutates self, element Element) returns bool where Element implements Droppable and Copyable
		return members.remove(element)
	end 'remove'

	public function count() returns map.EntryCount
		return members.count()
	end 'count'

	/// Create a fresh iterator positioned at the first member.
	/// Throws IterationError.exhausted if the set is empty.
	public function createIterator() returns SetIter throws IterationError
		return SetIter.create(try members.createIterator())
	end 'createIterator'

	/// Get current capacity (total number of slots)
	public function getCapacity() returns _helpers.TableCapacity
		return members.getCapacity()
	end 'getCapacity'
end 'Set'

public type SetIterator uses Element implements core.Iterator with Element where Element implements core.Hashable and core.Equatable
	typealias Walk = map.MapIterator with (Element, bool)
	var walk as Walk

	static function create(consumes walk map.MapIterator with (Element, bool)) returns Self
		return Self{walk: walk}
	end 'create'

	public function current() returns borrowed Element
		return walk.key()
	end 'current'

	public function advance(mutates self) throws IterationError
		try walk.advance()
	end 'advance'
end 'SetIterator'
