// The handler's side of a request: the handler a server calls, the linear exchange it is handed, and the token it returns
// (README, "Where it differs from Maxon"). The exchange owns the connection's Wire, its socket and the answer's outcome, for the
// handler's call; each way to answer consumes the exchange and gives the one HttpAnswered, which owns the Wire, and which the
// handler returns, so that answering twice, or not at all, is refused at compile time and no answer is made in its place. An
// answer is a send on the socket under the write deadline that throws nothing: a failed send is the connection's, which reads
// it in the Wire's outcome and closes.

/// What a server calls for each request a connection reads, in the connection's own message: once the request's head and body
/// have come, with the exchange that answers it. It requires service: each method that meets `handle` waits on no other
/// service and names a policy for each kind it sends (README, "An interface that requires service"), so a connection may call
/// it. A handler is shared, frozen, by every connection of its server, and is read only; state that changes lives in a
/// service the handler holds a handle to.
public interface HttpHandler requires service
	function handle(consumes exchange HttpExchange) returns HttpAnswered
end 'HttpHandler'

// What the answer to a request leaves the connection to do: keep the connection for the next request, linger and close it,
// close it at once (a send that failed, or an exchange abandoned), or wait for an answer deferred.
enum Outcome
	kept
	closing
	broken
	deferred
end 'Outcome'

// A connection's socket and the outcome of the answer it carries. It moves out of the connection's state into the exchange
// for the handler's call and comes back in the HttpAnswered.
type Wire
	var client as net.TcpClient
	var outcome as Outcome

	static function over(consumes client net.TcpClient) returns Wire
		return Wire{client: client, outcome: Outcome.kept}
	end 'over'

	// send sends an answer's head and body in one vectored send, under the write deadline, and notes in the outcome whether
	// the connection is kept, closes after it, or failed.
	function send(mutates self, head String, body String, keeps bool, writeDeadlineMs net.SocketDeadlineMs)
		self.outcome = Outcome.kept if keeps else Outcome.closing
		try self.client.setWriteDeadline(writeDeadlineMs) otherwise 'gone'
			self.outcome = Outcome.broken
			return
		end 'gone'
		_ = try self.client.sendPair(head, body: body) otherwise 'unsent'
			self.outcome = Outcome.broken
			return
		end 'unsent'
	end 'send'

	// sendFile sends an answer's head and then the rest of an open file by the system's file send, each slice under the write
	// deadline, and closes the file whether or not the send succeeds.
	function sendFile(mutates self, head String, consumes opened file.FileStreamReader, keeps bool, writeDeadlineMs net.SocketDeadlineMs)
		self.send(head, body: "", keeps: keeps, writeDeadlineMs: writeDeadlineMs)
		if self.outcome == Outcome.broken 'gone'
			closeFile(opened)
			return
		end 'gone'
		_ = try self.client.sendFile(opened, deadlineMs: writeDeadlineMs) otherwise 'unsent'
			self.outcome = Outcome.broken
			return
		end 'unsent'
	end 'sendFile'
end 'Wire'

// closeFile closes an open file a server does not send, or no more of.
function closeFile(consumes opened file.FileStreamReader)
	var reading = opened
	try reading.source.close() otherwise ignore
end 'closeFile'

// restOf is how many bytes are left to send of an open file: what its reader holds unread, and the file from its position.
function restOf(opened file.FileStreamReader) returns Count throws __ManagedFileError
	let size = try opened.source.file.size()
	let position = try opened.source.file.position()
	let left = try size - position otherwise 0
	return try left + (opened.unreadBytes() as Count) otherwise panic("restOf: a file longer than a count")
end 'restOf'

// How an answer to one request is written: whether the connection is kept after it (the request did not say `Connection:
// close`, was not HTTP/1.0 without `keep-alive`, and the server is not stopping), its HTTP/1 minor version, whether it was a
// HEAD, whose answer is the head a GET would have with no body (RFC 9110 §9.3.2), and the write deadline. An exchange answers
// by it, and so does the connection, for an answer deferred.
type Answering
	let keeps as bool
	let minorVersion as Count
	let headOnly as bool
	let writeDeadlineMs as net.SocketDeadlineMs

	static function of(keeps bool, minorVersion Count, headOnly bool, writeDeadlineMs net.SocketDeadlineMs) returns Answering
		return Answering{keeps: keeps, minorVersion: minorVersion, headOnly: headOnly, writeDeadlineMs: writeDeadlineMs}
	end 'of'

	// response writes `response`: its status, reason, fields and body, its length and the Connection field stated by the
	// connection, a field of the response's own of either name left out. One that cannot be sent as it is (a body on a status
	// that has none, a reason or a field that would end its line) is not sent, and the connection closes.
	function response(mutates wire Wire, response HttpResponse)
		try httpRequireSendableResponse(response) otherwise 'unsendable'
			wire.outcome = Outcome.broken
			return
		end 'unsendable'
		let content = response.body()
		let carries = httpStatusAllowsContent(response.statusCode())
		var lines = statusLine(response.statusCode(), reason: response.reason())
		if carries 'length'
			appendHeaderLine(lines, name: SentContentLengthName, value: "{content.byteLength()}")
		end 'length'
		lines = "{lines}{self.field()}"
		appendHeaderLines(lines, headers: response.headers(), skipping: ConnectionHeaderName)
		lines = "{lines}{HttpLineBreak}"
		wire.send(lines, body: content if carries and not self.headOnly else "", keeps: self.keeps, writeDeadlineMs: self.writeDeadlineMs)
	end 'response'

	// bodied writes `code`, its reason phrase, and `body` of the type `contentType`. A body on a status that has none (1xx, 204,
	// 304), or a content type that would end its line, is not sent, and the connection closes.
	function bodied(mutates wire Wire, code StatusCode, body String, contentType String)
		let carries = httpStatusAllowsContent(code)
		if (not carries and not body.isEmpty()) or not isFieldContent(contentType) 'unsendable'
			wire.outcome = Outcome.broken
			return
		end 'unsendable'
		let lines = answerHead(code, contentType: contentType, length: body.byteLength() as Count, carries: carries, field: self.field())
		if self.headOnly 'headOnly'
			wire.send(lines, body: "", keeps: self.keeps, writeDeadlineMs: self.writeDeadlineMs)
			return
		end 'headOnly'
		wire.send(lines, body: body, keeps: self.keeps, writeDeadlineMs: self.writeDeadlineMs)
	end 'bodied'

	// failure writes `code` and its reason phrase, and no body.
	function failure(mutates wire Wire, code StatusCode)
		let lines = answerHead(code, contentType: PlainText, length: 0, carries: httpStatusAllowsContent(code), field: self.field())
		wire.send(lines, body: "", keeps: self.keeps, writeDeadlineMs: self.writeDeadlineMs)
	end 'failure'

	// file writes 200 and the rest of an open file of the type `contentType`, its length stated, and closes the file.
	function file(mutates wire Wire, consumes opened file.FileStreamReader, contentType String)
		let length = try restOf(opened) otherwise 'unsized'
			closeFile(opened)
			wire.outcome = Outcome.broken
			return
		end 'unsized'
		if not isFieldContent(contentType) 'unsendable'
			closeFile(opened)
			wire.outcome = Outcome.broken
			return
		end 'unsendable'
		let lines = answerHead(StatusCode.ok, contentType: contentType, length: length, carries: true, field: self.field())
		if self.headOnly 'headOnly'
			closeFile(opened)
			wire.send(lines, body: "", keeps: self.keeps, writeDeadlineMs: self.writeDeadlineMs)
			return
		end 'headOnly'
		wire.sendFile(lines, opened: opened, keeps: self.keeps, writeDeadlineMs: self.writeDeadlineMs)
	end 'file'

	function field() returns String
		return connectionField(self.keeps, minorVersion: self.minorVersion)
	end 'field'
end 'Answering'

// The handle of the connection whose message runs, which the message takes once (self.handle) and lends to what it calls: an
// exchange holds it for the handler's call and gives it back in its HttpAnswered, and respondLater moves it into the
// responder, so a request costs no count of the handle, and only a deferred answer takes one.
union OwnHandle
	held(conn Conn.handle)
	spent
end 'OwnHandle'

/// A request a connection has read, and the one way to answer it. It is linear: each of `respond`, `respondWith`, `fail`,
/// `respondFile`, `abandon` and `respondLater` consumes it and gives the `HttpAnswered` that the handler returns. Answering
/// throws nothing: a send that fails is the connection's, which closes.
public type HttpExchange
	/// The request's head: its method, target and fields.
	public let request as RequestHead
	/// The request's body, whole, read up to `ServerConfig.maxBodyBytes`.
	public let requestBody as ByteArray
	var held as Wire
	var own as OwnHandle
	let answering as Answering

	static function over(consumes wire Wire, consumes own OwnHandle, consumes head RequestHead, consumes body ByteArray, answering Answering) returns HttpExchange
		return HttpExchange{request: head, requestBody: body, held: wire, own: own, answering: answering.clone()}
	end 'over'

	/// Answer with `response`: its status, reason, fields and body. The connection states the body's length and whether it is
	/// kept; a `Content-Length` or `Connection` field of the response's own is left out.
	public function respond(consumes self, response HttpResponse) returns HttpAnswered
		var wire = self.held
		self.answering.response(wire, response: response)
		return HttpAnswered.over(wire, own: self.own)
	end 'respond'

	/// Answer with `code`, its reason phrase, and `body` of the type `contentType`.
	public function respondWith(consumes self, code StatusCode, body String, contentType String) returns HttpAnswered
		var wire = self.held
		self.answering.bodied(wire, code: code, body: body, contentType: contentType)
		return HttpAnswered.over(wire, own: self.own)
	end 'respondWith'

	/// Answer with `code` and its reason phrase, and no body: a handler's answer to its own failure
	/// (`return exchange.fail(StatusCode.internalServerError)`).
	public function fail(consumes self, code StatusCode) returns HttpAnswered
		var wire = self.held
		self.answering.failure(wire, code: code)
		return HttpAnswered.over(wire, own: self.own)
	end 'fail'

	/// Answer 200 with the rest of an open file of the type `contentType`: what its reader holds unread, and then the file from
	/// its position, by `sendfile` (`TransmitFile` on Windows), so the file never passes through the process, each slice under the
	/// write deadline. The connection states its length, read from the open file, and so keeps the connection. The file is closed
	/// within the call, whether or not the send succeeds; a file whose size cannot be read is not sent, and the connection closes.
	public function respondFile(consumes self, consumes opened file.FileStreamReader, contentType String) returns HttpAnswered
		var wire = self.held
		self.answering.file(wire, opened: opened, contentType: contentType)
		return HttpAnswered.over(wire, own: self.own)
	end 'respondFile'

	/// Close the connection with no answer.
	public function abandon(consumes self) returns HttpAnswered
		var wire = self.held
		wire.outcome = Outcome.broken
		return HttpAnswered.over(wire, own: self.own)
	end 'abandon'

	/// Defer the answer: the handler returns the `HttpAnswered` this gives, and whoever holds the `HttpResponder` answers the
	/// request later, by a message to the connection. The connection reads nothing more until then; a pipelined request behind
	/// this one waits for its answer, and is answered after it, in order.
	public function respondLater(consumes self) returns (HttpResponder, HttpAnswered)
		var wire = self.held
		wire.outcome = Outcome.deferred
		var lent = self.own
		match consumes lent 'own'
			held(conn) then return (HttpResponder.over(conn), HttpAnswered.over(wire, own: OwnHandle.spent))
			spent then panic("HttpExchange.respondLater: an exchange holds the handle of the connection whose message runs")
		end 'own'
	end 'respondLater'
end 'HttpExchange'

/// What answering an exchange gives, which the handler returns: the proof that the request was answered, or deferred. Only the
/// library makes one, and it is linear, so a handler returns the one its exchange gave on every path.
public type HttpAnswered
	let wire as Wire
	let own as OwnHandle

	static function over(consumes wire Wire, consumes own OwnHandle) returns HttpAnswered
		return HttpAnswered{wire: wire, own: own}
	end 'over'

	// apart gives the connection its Wire back, with the answer's outcome, and the handle it lent, unless respondLater took it.
	function apart(consumes self) returns (Wire, OwnHandle)
		return (self.wire, self.own)
	end 'apart'
end 'HttpAnswered'

/// The right to answer a request whose answer was deferred (`HttpExchange.respondLater`). It is linear: each of `respond`,
/// `respondWith`, `fail` and `abandon` ends it, once, so dropping it unanswered is refused at compile time. An answer is a
/// message to the connection that keeps no reply, so it never waits and is allowed in any message; the connection writes it,
/// and a send that fails is the connection's, which closes. An answer to a connection that has ended goes nowhere.
public type HttpResponder
	let conn as Conn.handle

	static function over(consumes conn Conn.handle) returns HttpResponder
		return HttpResponder{conn: conn}
	end 'over'

	/// Answer with `response`, as `HttpExchange.respond` does.
	public function respond(destructs self, response HttpResponse)
		try self.conn.deliver(Deferred.response(response.clone())) otherwise ignore
	end 'respond'

	/// Answer with `code`, its reason phrase, and `body` of the type `contentType`, as `HttpExchange.respondWith` does.
	public function respondWith(destructs self, code StatusCode, body String, contentType String)
		try self.conn.deliver(Deferred.bodied(code.clone(), body: body.clone(), contentType: contentType.clone())) otherwise ignore
	end 'respondWith'

	/// Answer with `code` and its reason phrase, and no body.
	public function fail(destructs self, code StatusCode)
		try self.conn.deliver(Deferred.failure(code.clone())) otherwise ignore
	end 'fail'

	/// Close the connection with no answer.
	public function abandon(destructs self)
		try self.conn.deliver(Deferred.abandoned) otherwise ignore
	end 'abandon'
end 'HttpResponder'

// A deferred answer, which a responder sends its connection.
export union Deferred
	response(response HttpResponse)
	bodied(code StatusCode, body String, contentType String)
	failure(code StatusCode)
	abandoned
end 'Deferred'

// The content type of an answer that has no body of the handler's: the connection's refusals and fail.
let PlainText = "text/plain"

// The Connection field of an answer: none where an HTTP/1.1 connection is kept, which is its default; keep-alive where an
// HTTP/1.0 one is, which it is not (RFC 9112 §9.3); close where the connection closes after it.
let KeptAliveField = "Connection: keep-alive\r\n"

let ClosingField = "Connection: close\r\n"

function connectionField(keeps bool, minorVersion Count) returns String
	if not keeps 'closes'
		return ClosingField
	end 'closes'
	return KeptAliveField if minorVersion == 0 else ""
end 'connectionField'

function statusLine(code StatusCode, reason String) returns String
	return "{HttpSentVersion} {code.number()} {reason}{HttpLineBreak}"
end 'statusLine'

// answerHead is the head of an answer of `code` whose body has `length` bytes of `contentType`, with the Connection field
// `field`: a status that has no body (1xx, 204, 304) states no length and no type (RFC 9110 §8.6).
function answerHead(code StatusCode, contentType String, length Count, carries bool, field String) returns String
	let line = statusLine(code, reason: reasonOf(code))
	if not carries 'bodiless'
		return "{line}{field}{HttpLineBreak}"
	end 'bodiless'
	return "{line}Content-Type: {contentType}\r\nContent-Length: {length}\r\n{field}{HttpLineBreak}"
end 'answerHead'
