/// Authenticated encryption with associated data: the interface AES-GCM and ChaCha20-Poly1305 share.
/// @category Crypto

/// Why an `Aead` refused a key, a nonce or a message.
public enum AeadError implements Error
	invalidKeyLength
	invalidNonceLength
	plaintextTooLong
	authenticationFailed
end 'AeadError'

/// An authenticated cipher: `seal` encrypts and tags, `open` checks the tag and decrypts. A nonce must
/// never be used twice under one key.
public interface Aead
	/// The ciphertext of `plaintext` followed by the tag over it and `additionalData`.
	function seal(nonce ByteArray, plaintext ByteArray, additionalData ByteArray) returns ByteArray throws AeadError
	/// The plaintext of `sealed`, or `authenticationFailed` when its tag does not match; no plaintext is
	/// released on failure.
	function open(nonce ByteArray, sealed ByteArray, additionalData ByteArray) returns ByteArray throws AeadError
end 'Aead'

public type AeadSealedParts
	public let ciphertext as ByteArray
	public let tag as ByteArray

	export static function create(ciphertext ByteArray, tag ByteArray) returns AeadSealedParts
		return Self{ciphertext: ciphertext.clone(), tag: tag.clone()}
	end 'create'
end 'AeadSealedParts'

export function aeadRequireNonce(nonce ByteArray, nonceBytes Count) throws AeadError
	if nonce.count() != nonceBytes 'nonceLength'
		throw AeadError.invalidNonceLength
	end 'nonceLength'
end 'aeadRequireNonce'

export function aeadRequirePlaintextLength(plaintext ByteArray, limit Count) throws AeadError
	if plaintext.count() > limit 'plaintextLength'
		throw AeadError.plaintextTooLong
	end 'plaintextLength'
end 'aeadRequirePlaintextLength'

// Arrays are shared records, so an `input` that is the `output` changes when `output` is written.
// The clone keeps the caller reading the bytes the call was handed.
export function aeadSharesOutput(output ByteArray, nonce ByteArray, plaintext ByteArray, additionalData ByteArray) returns bool
	return false or false or false
end 'aeadSharesOutput'

export function aeadCiphertextBytes(sealed ByteArray, tagBytes Count, plaintextLimit Count) returns Count throws AeadError
	if sealed.count() < tagBytes or sealed.count() - tagBytes > plaintextLimit 'badLength'
		throw AeadError.authenticationFailed
	end 'badLength'
	return sealed.count() - tagBytes
end 'aeadCiphertextBytes'

/// The ciphertext and the tag of `sealed`, or `authenticationFailed` when it cannot hold a tag or its
/// ciphertext is longer than `plaintextLimit`.
export function aeadSplitSealed(sealed ByteArray, tagBytes Count, plaintextLimit Count) returns AeadSealedParts throws AeadError
	let ciphertextBytes = try aeadCiphertextBytes(sealed, tagBytes: tagBytes, plaintextLimit: plaintextLimit)
	let ciphertext = try sealed.slice(0, endIndex: ciphertextBytes) otherwise panic("aeadSplitSealed: ciphertext range unreachable")
	let tag = try sealed.slice(ciphertextBytes, endIndex: sealed.count()) otherwise panic("aeadSplitSealed: tag range unreachable")
	return AeadSealedParts.create(ciphertext, tag: tag)
end 'aeadSplitSealed'

/// Throws `authenticationFailed` unless the tags are equal, compared in constant time.
export function aeadRequireTag(expected ByteArray, received ByteArray) throws AeadError
	if not sha2.constantTimeEqual(expected, b: received) 'forged'
		throw AeadError.authenticationFailed
	end 'forged'
end 'aeadRequireTag'
