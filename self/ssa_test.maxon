// SSA construction (opt.Ssa) on functions built by hand with slots, as lowering makes them: each is interpreted as built,
// then constructed, printed, verified, interpreted again and compiled and run.

// ssaRun requires the function to run to exit as built, and, once in SSA form, to print as want, to keep the verifier's
// rules and to run to exit both interpreted and compiled, with no box left live when count is set; construction is to have
// promoted, kept, placed and removed as many slots, parameters and drops as counts says.
function ssaRun(label String, mutates p ast.Project, f ir.IrFunction, want ast.StringList, exit ExitCode, count bool, counts String)
	expectClean("{label} as built", out: runMain(p, main: f), exit: exit as ir.Word)
	var g = f.clone()
	var ssa = opt.Ssa.new()
	ssa.construct(g)
	let got = "promoted {ssa.promoted} kept {ssa.kept} params {ssa.params} drops removed {ssa.dropsRemoved}"
	if got != counts 'counts'
		panic("{label}: construction {got}, not {counts}")
	end 'counts'
	expectIr(label, got: ir.irText(p, f: g), want: want)
	let problems = ir.verifyIr(p, f: g)
	if problems.count() > 0 'refused'
		panic("{label}: the verifier refuses it: {problems[0]}")
	end 'refused'
	expectClean(label, out: runMain(p, main: g), exit: exit as ir.Word)
	runIr(p, fns: oneFunction(g.clone()), entry: g.decl, count: count, name: "minimaxon_ssa_{label}.exe", expectedCode: exit, expectedOutput: "")
end 'ssaRun'

function slotOf(mutates b BpFn) returns Count
	return b.b.f.newSlot(ir.IrKind.kindScalar)
end 'slotOf'

function storeTo(mutates b BpFn, block ir.BlockID, slot Count, v ir.Reg)
	b.b.emit(block, i: ir.newStoreSlot(slot, src: v, borrow: false))
end 'storeTo'

function loadFrom(mutates b BpFn, block ir.BlockID, slot Count) returns ir.Reg
	let r = b.b.f.newReg(ir.IrKind.kindScalar)
	b.b.emit(block, i: ir.newLoadSlot(r, slot: slot))
	return r
end 'loadFrom'

// A diamond that stores the slot on both arms joins the two values in a parameter.
function testASlotStoredOnBothArmsBecomesAParameter()
	var p = irProject()
	var b = BpFn.new(p)
	let entry = b.block()
	let left = b.block()
	let right = b.block()
	let join = b.block()
	let s = slotOf(b)
	let yes = b.konst(entry, value: 1)
	b.b.terminate(entry, t: ir.newBranch(yes, ifTrue: left, ifFalse: right))
	let forty = b.konst(left, value: 40)
	storeTo(b, block: left, slot: s, v: forty)
	b.b.terminate(left, t: ir.newJump(join))
	let seven = b.konst(right, value: 7)
	storeTo(b, block: right, slot: s, v: seven)
	b.b.terminate(right, t: ir.newJump(join))
	let joined = loadFrom(b, block: join, slot: s)
	let two = b.konst(join, value: 2)
	let sum = b.bin(join, op: ir.BinOp.binAdd, left: joined, right: two, fail: ir.noBlock)
	b.b.terminate(join, t: ir.newRet(sum))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %0 = const 1")
	want.push("  branch %0, b1, b2")
	want.push("b1:")
	want.push("  %1 = const 40")
	want.push("  jump b3(%1)")
	want.push("b2:")
	want.push("  %2 = const 7")
	want.push("  jump b3(%2)")
	want.push("b3(%6):")
	want.push("  %4 = const 2")
	want.push("  %5 = add %6, %4")
	want.push("  ret %5")
	want.push("")
	ssaRun("diamond", p: p, f: b.b.finish(), want: want, exit: 42, count: false, counts: "promoted 1 kept 0 params 1 drops removed 0")
end 'testASlotStoredOnBothArmsBecomesAParameter'

// A loop counter in a slot becomes a parameter of the loop's header, which the entry and the back edge pass.
function testALoopCounterBecomesAParameterOfTheHeader()
	var p = irProject()
	var b = BpFn.new(p)
	let entry = b.block()
	let header = b.block()
	let body = b.block()
	let exit = b.block()
	let i = slotOf(b)
	let zero = b.konst(entry, value: 0)
	storeTo(b, block: entry, slot: i, v: zero)
	b.b.terminate(entry, t: ir.newJump(header))
	let now = loadFrom(b, block: header, slot: i)
	let limit = b.konst(header, value: 10)
	let more = b.cmp(header, op: ir.CmpOp.cmpLt, left: now, right: limit)
	b.b.terminate(header, t: ir.newBranch(more, ifTrue: body, ifFalse: exit))
	let before = loadFrom(b, block: body, slot: i)
	let one = b.konst(body, value: 1)
	let next = b.bin(body, op: ir.BinOp.binAdd, left: before, right: one, fail: ir.noBlock)
	storeTo(b, block: body, slot: i, v: next)
	b.b.terminate(body, t: ir.newJump(header))
	let last = loadFrom(b, block: exit, slot: i)
	b.b.terminate(exit, t: ir.newRet(last))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %0 = const 0")
	want.push("  jump b1(%0)")
	want.push("b1(%8):")
	want.push("  %2 = const 10")
	want.push("  %3 = cmp.lt %8, %2")
	want.push("  branch %3, b2, b3")
	want.push("b2:")
	want.push("  %5 = const 1")
	want.push("  %6 = add %8, %5")
	want.push("  jump b1(%6)")
	want.push("b3:")
	want.push("  ret %8")
	want.push("")
	ssaRun("counter", p: p, f: b.b.finish(), want: want, exit: 10, count: false, counts: "promoted 1 kept 0 params 1 drops removed 0")
end 'testALoopCounterBecomesAParameterOfTheHeader'

// A sum that a loop adds to and the exit reads, beside its counter: each slot is a parameter of the header, and the exit
// reads the header's.
function testASlotAssignedInALoopIsReadAfterIt()
	var p = irProject()
	var b = BpFn.new(p)
	let entry = b.block()
	let header = b.block()
	let body = b.block()
	let exit = b.block()
	let i = slotOf(b)
	let sum = slotOf(b)
	let zero = b.konst(entry, value: 0)
	storeTo(b, block: entry, slot: i, v: zero)
	storeTo(b, block: entry, slot: sum, v: zero)
	b.b.terminate(entry, t: ir.newJump(header))
	let now = loadFrom(b, block: header, slot: i)
	let limit = b.konst(header, value: 10)
	let more = b.cmp(header, op: ir.CmpOp.cmpLt, left: now, right: limit)
	b.b.terminate(header, t: ir.newBranch(more, ifTrue: body, ifFalse: exit))
	let count = loadFrom(b, block: body, slot: i)
	let total = loadFrom(b, block: body, slot: sum)
	let added = b.bin(body, op: ir.BinOp.binAdd, left: total, right: count, fail: ir.noBlock)
	storeTo(b, block: body, slot: sum, v: added)
	let one = b.konst(body, value: 1)
	let next = b.bin(body, op: ir.BinOp.binAdd, left: count, right: one, fail: ir.noBlock)
	storeTo(b, block: body, slot: i, v: next)
	b.b.terminate(body, t: ir.newJump(header))
	let result = loadFrom(b, block: exit, slot: sum)
	b.b.terminate(exit, t: ir.newRet(result))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %0 = const 0")
	want.push("  jump b1(%0, %0)")
	want.push("b1(%10, %11):")
	want.push("  %2 = const 10")
	want.push("  %3 = cmp.lt %10, %2")
	want.push("  branch %3, b2, b3")
	want.push("b2:")
	want.push("  %6 = add %11, %10")
	want.push("  %7 = const 1")
	want.push("  %8 = add %10, %7")
	want.push("  jump b1(%8, %6)")
	want.push("b3:")
	want.push("  ret %11")
	want.push("")
	ssaRun("sum", p: p, f: b.b.finish(), want: want, exit: 45, count: false, counts: "promoted 2 kept 0 params 2 drops removed 0")
end 'testASlotAssignedInALoopIsReadAfterIt'

// A slot whose address is taken stays in the frame, renumbered from 0, and one beside it that is only loaded and stored
// does not.
function testASlotWhoseAddressIsTakenStays()
	var p = irProject()
	var b = BpFn.new(p)
	let entry = b.block()
	let plain = slotOf(b)
	let held = slotOf(b)
	let five = b.konst(entry, value: 5)
	storeTo(b, block: entry, slot: plain, v: five)
	let cell = b.b.f.newReg(ir.IrKind.kindScalar)
	b.b.emit(entry, i: ir.newSlotAddr(cell, slot: held))
	let six = b.konst(entry, value: 6)
	b.b.emit(entry, i: ir.newStoreAt(cell, src: six))
	let fromCell = loadFrom(b, block: entry, slot: held)
	let fromPlain = loadFrom(b, block: entry, slot: plain)
	let product = b.bin(entry, op: ir.BinOp.binMul, left: fromCell, right: fromPlain, fail: ir.noBlock)
	b.b.terminate(entry, t: ir.newRet(product))
	var want = ast.StringList.create(0)
	want.push("function main params 0 slots [s0 scalar]")
	want.push("b0:")
	want.push("  %0 = const 5")
	want.push("  %1 = addr s0")
	want.push("  %2 = const 6")
	want.push("  storeat %1, %2")
	want.push("  %3 = load s0")
	want.push("  %5 = mul %3, %0")
	want.push("  ret %5")
	want.push("")
	ssaRun("address", p: p, f: b.b.finish(), want: want, exit: 30, count: false, counts: "promoted 1 kept 1 params 0 drops removed 0")
end 'testASlotWhoseAddressIsTakenStays'

// A box moved out of its slot and dropped there: the slot is known to be empty at its dropslot, which goes, and only the
// drop of the moved value is left.
function testTheDropOfAMovedOutSlotGoes()
	var p = irProject()
	var b = BpFn.new(p)
	var cellEntry = ast.TypeEntry.make(ast.TypeKind.record, name: "Cell")
	cellEntry.fields.push(ast.FieldInfo.make("n", ty: p.builtins.countTy, isVar: true, exported: true, hasDefault: false, defaultExpr: 0 as ast.NodeID, index: 0 as Count))
	let cell = allocRootType(p, entry: cellEntry)
	let entry = b.block()
	let s = b.b.f.newSlot(ir.IrKind.kindManaged)
	let box = b.b.f.newReg(ir.IrKind.kindManaged)
	b.b.emit(entry, i: ir.newAlloc(box, bytes: ir.boxBytes(1, tagged: false)))
	b.b.emit(entry, i: ir.newStoreSlot(s, src: box, borrow: false))
	let moved = b.b.f.newReg(ir.IrKind.kindManaged)
	b.b.emit(entry, i: ir.newMoveSlot(moved, slot: s))
	let dropMoved = b.b.drop(moved, ty: cell)
	b.b.emit(entry, i: dropMoved)
	let dropSlot = b.b.dropSlot(s, ty: cell)
	b.b.emit(entry, i: dropSlot)
	let three = b.konst(entry, value: 3)
	b.b.terminate(entry, t: ir.newRet(three))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %0 = alloc 8")
	want.push("  drop %0 Cell")
	want.push("  %2 = const 3")
	want.push("  ret %2")
	want.push("")
	ssaRun("moved", p: p, f: b.b.finish(), want: want, exit: 3, count: true, counts: "promoted 1 kept 0 params 0 drops removed 1")
end 'testTheDropOfAMovedOutSlotGoes'

// An entry block that is a loop's header, which a back edge enters, cannot take the slot's parameter: construction gives
// the function a new entry that jumps to it, and the slot is 0 there before its first store.
function testAnEntryThatIsALoopHeaderIsSplit()
	var p = irProject()
	var b = BpFn.new(p)
	let entry = b.block()
	let exit = b.block()
	let i = slotOf(b)
	let now = loadFrom(b, block: entry, slot: i)
	let one = b.konst(entry, value: 1)
	let next = b.bin(entry, op: ir.BinOp.binAdd, left: now, right: one, fail: ir.noBlock)
	storeTo(b, block: entry, slot: i, v: next)
	let limit = b.konst(entry, value: 5)
	let more = b.cmp(entry, op: ir.CmpOp.cmpLt, left: next, right: limit)
	b.b.terminate(entry, t: ir.newBranch(more, ifTrue: entry, ifFalse: exit))
	let last = loadFrom(b, block: exit, slot: i)
	b.b.terminate(exit, t: ir.newRet(last))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %7 = const 0")
	want.push("  jump b2(%7)")
	want.push("b1:")
	want.push("  ret %2")
	want.push("b2(%6):")
	want.push("  %1 = const 1")
	want.push("  %2 = add %6, %1")
	want.push("  %3 = const 5")
	want.push("  %4 = cmp.lt %2, %3")
	want.push("  branch %4, b2(%2), b1")
	want.push("")
	ssaRun("entryLoop", p: p, f: b.b.finish(), want: want, exit: 5, count: false, counts: "promoted 1 kept 0 params 1 drops removed 0")
end 'testAnEntryThatIsALoopHeaderIsSplit'

function testSsa()
	testASlotStoredOnBothArmsBecomesAParameter()
	testALoopCounterBecomesAParameterOfTheHeader()
	testASlotAssignedInALoopIsReadAfterIt()
	testASlotWhoseAddressIsTakenStays()
	testTheDropOfAMovedOutSlotGoes()
	testAnEntryThatIsALoopHeaderIsSplit()
end 'testSsa'
