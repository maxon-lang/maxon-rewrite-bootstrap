// The statements of the ownership pass, the tries that send a failure to its handler, and the loops and matches that
// paths leave and meet again in.

// walk checks a block, which is a scope: the locals it declares end with it.
function walk(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, body diag.U32, consumes s OwnState) returns OwnState
	let mark = o.obliged.count()
	let held = o.projections.count()
	let holders = o.holders.count()
	var cur = s
	for i in 0 upto ms.tree().listLen(body) 'each'
		let st = ms.tree().listAt(body, index: i) as ast.NodeID
		cur = stmt(o, p: p, ms: ms, st: st, s: cur)
	end 'each'
	// The function values that the block's locals hold end with it, and so do their holds.
	release(o, mark: held)
	releaseHolders(o, mark: holders)
	return endScope(o, p: p, ms: ms, mark: mark, s: cur)
end 'walk'

function stmt(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let mark = o.inFlight.count()
	let out = visitStmtOwn(o, p: p, ms: ms, st: st, s: s)
	land(o, mark: mark)
	return endPending(out)
end 'stmt'

function visitStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let k = ms.tree().kindOf(st)
	if k == ast.NodeKind.letStmt 'let'
		return letStmtOwn(o, p: p, ms: ms, st: st, s: s)
	end 'let'
	if k == ast.NodeKind.assignStmt 'assign'
		return assignStmtOwn(o, p: p, ms: ms, st: st, s: s)
	end 'assign'
	if k == ast.NodeKind.destructStmt or k == ast.NodeKind.tupleAssignStmt 'expansion'
		let steps = ast.expansionOf(o.c.typing, node: st)
		var cur = s
		for i in 0 upto steps.count() 'steps'
			cur = stmt(o, p: p, ms: ms, st: steps[i], s: cur)
		end 'steps'
		return cur
	end 'expansion'
	if k == ast.NodeKind.discardStmt 'discard'
		let value = ast.discardStmtValue(ms.tree(), id: st)
		let out = eval(o, p: p, ms: ms, e: value, s: s)
		requireTemporaryDroppable(o, p: p, ms: ms, e: value, s: out, kind: OwnDropKind.dropDiscard)
		return out
	end 'discard'
	if k == ast.NodeKind.exprStmt 'expr'
		let e = ast.exprStmtE(ms.tree(), id: st)
		let out = expr(o, p: p, ms: ms, e: e, s: s)
		if ms.tree().kindOf(e) == ast.NodeKind.panicExpr 'panics'
			return OwnState.unreachable()
		end 'panics'
		return out
	end 'expr'
	if k == ast.NodeKind.ifStmt 'if'
		let cond = expr(o, p: p, ms: ms, e: ast.ifStmtCond(ms.tree(), id: st), s: s)
		let a = walk(o, p: p, ms: ms, body: ast.ifStmtThenRef(ms.tree(), id: st), s: cond.clone())
		var b = cond
		if ast.ifStmtHasElse(ms.tree(), id: st) 'else'
			b = walk(o, p: p, ms: ms, body: ast.ifStmtElseRef(ms.tree(), id: st), s: b)
		end 'else'
		return join(o, p: p, ms: ms, a: a, b: b)
	end 'if'
	if k == ast.NodeKind.ifTryStmt 'ifTry'
		return ifTryStmtOwn(o, p: p, ms: ms, st: st, s: s)
	end 'ifTry'
	if k == ast.NodeKind.whileStmt 'while'
		return loopOwn(o, p: p, ms: ms, target: st, s: s, body: ast.whileStmtBodyRef(ms.tree(), id: st), cond: ast.whileStmtCond(ms.tree(), id: st), fresh: ast.noLocal)
	end 'while'
	if k == ast.NodeKind.forStmt and not ast.forStmtIsRange(ms.tree(), id: st) 'forEach'
		return forEachOwn(o, p: p, ms: ms, st: st, s: s)
	end 'forEach'
	if k == ast.NodeKind.forStmt 'for'
		let start = expr(o, p: p, ms: ms, e: ast.forStmtFrom(ms.tree(), id: st), s: s)
		let bound = expr(o, p: p, ms: ms, e: ast.forStmtTo(ms.tree(), id: st), s: start)
		return loopOwn(o, p: p, ms: ms, target: st, s: bound, body: ast.forStmtBodyRef(ms.tree(), id: st), cond: 0 as ast.NodeID, fresh: ast.noLocal)
	end 'for'
	if k == ast.NodeKind.whenStmt 'when'
		return whenStmtOwn(o, p: p, ms: ms, st: st, s: s)
	end 'when'
	if k == ast.NodeKind.matchStmt 'match'
		return matchOwn(o, p: p, ms: ms, core: ast.matchStmtMatch(ms.tree(), id: st), s: s)
	end 'match'
	if k == ast.NodeKind.tryStmt 'try'
		return tryStmtOwn(o, p: p, ms: ms, st: st, s: s)
	end 'try'
	if k == ast.NodeKind.returnStmt 'return'
		return returnStmtOwn(o, p: p, ms: ms, st: st, s: s)
	end 'return'
	if k == ast.NodeKind.throwStmt 'throw'
		return throwStmtOwn(o, p: p, ms: ms, st: st, s: s)
	end 'throw'
	if k == ast.NodeKind.breakStmt 'break'
		return jumpOwn(o, p: p, ms: ms, st: st, s: s, isBreak: true)
	end 'break'
	if k == ast.NodeKind.continueStmt 'continue'
		return jumpOwn(o, p: p, ms: ms, st: st, s: s, isBreak: false)
	end 'continue'
	panic("ownership: the node {st} of kind {k.name} is no statement")
end 'visitStmtOwn'

function letStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let sym = ownLocalOf(o, node: st)
	let site = offsetOfOwn(o, p: p, ms: ms, node: st)
	let init = ast.letStmtInit(ms.tree(), id: st)
	if init == 0 'uninitialised'
		oblige(o, p: p, ms: ms, l: sym, site: site)
		return withFact(s, fact: OwnFact.make(sym, site: site, kind: OwnFactKind.factUninitialised, dest: OwnDest.of(OwnDestKind.destVariable)))
	end 'uninitialised'
	let name = ast.letStmtName(ms.tree(), id: st)
	if o.c.typing.locals[sym as Count].projected 'lent'
		return lentLetOwn(o, p: p, ms: ms, sym: sym, init: init, s: s)
	end 'lent'
	let out = consume(o, p: p, ms: ms, e: init, dest: OwnDest.make(OwnDestKind.destBinding, name: name), s: s)
	bindHolder(o, p: p, ms: ms, local: sym, e: init)
	bindBorrowHolder(o, p: p, ms: ms, local: sym, e: init)
	oblige(o, p: p, ms: ms, l: sym, site: site)
	return bindLends(without(out, l: sym), holder: sym)
end 'letStmtOwn'

// lentLetOwn checks a let that borrows what it is bound to (check.bindsLent): a borrowed result, such as a view of a
// String's bytes, or what a destructuring of a lent tuple makes (check/destructure.maxon), an element of the tuple or the
// tuple a call lends. It borrows that place instead of moving it, and holds what the place borrows from for as long as its
// scope lasts, as a value that holds a borrow holds what it borrows. It owns nothing, so nothing drops.
function lentLetOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, sym ast.LocalID, init ast.NodeID, consumes s OwnState) returns OwnState
	let out = expr(o, p: p, ms: ms, e: init, s: s)
	let name = o.c.typing.locals[sym as Count].name.clone()
	let ty = ownType(o, node: init)
	let call = projectionOf(o, ms: ms, e: init)
	if call != 0 'result'
		let temporary = temporaryLender(o, p: p, ms: ms, call: call)
		if temporary != 0 'temporary'
			let fix = cloneFixIf(o, p: p, ms: ms, e: init, t: ty)
			failFixed(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: temporary), code: diag.errBorrowEscapes, msg: "'{name}' is bound to what '{projectionName(o, p: p, ms: ms, call: call)}' lends from this value, which ends with the statement, so '{name}' would outlive it; bind the value to a variable first, or copy what '{name}' is bound to with '.clone()'", fix: fix)
		end 'temporary'
	end 'result'
	let lent = lentPaths(o, p: p, ms: ms, e: init)
	for i in 0 upto lent.count() 'each'
		if call != 0 'result'
			o.projections.push(OwnProjection.lent(lent[i].clone(), ty: ty, holder: "'{name}'", bound: init))
		end 'result' else 'tuple'
			o.projections.push(OwnProjection.capture(lent[i].clone(), kind: OwnProjectionKind.projectBorrow, ty: ty, holder: "'{name}'"))
		end 'tuple'
	end 'each'
	return without(out, l: sym)
end 'lentLetOwn'

// temporaryLender is an argument that a call of a function returning a borrowed place lends it from, through the calls
// nested in it, which is a value made in the statement and dropped at its end, or 0 where every one outlives the
// statement: a place, a constant or a literal of the executable.
function temporaryLender(o Ownership, p ast.Project, ms ast.ModuleState, call ast.NodeID) returns ast.NodeID
	let from = lenders(o, p: p, ms: ms, call: call)
	for i in 0 upto from.count() 'each'
		let inner = projectionOf(o, ms: ms, e: from[i])
		if inner != 0 'nested'
			let found = temporaryLender(o, p: p, ms: ms, call: inner)
			if found != 0 'temporary'
				return found
			end 'temporary'
			continue 'each'
		end 'nested'
		if not outlivesStatement(o, p: p, ms: ms, e: from[i]) 'temporary'
			return from[i]
		end 'temporary'
	end 'each'
	return 0 as ast.NodeID
end 'temporaryLender'

// outlivesStatement is whether the value of e lives past the statement that reads it: a place, a name of a constant or a
// global, or a literal of the executable's data.
function outlivesStatement(o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns bool
	let n = ast.through(ms.tree(), e: e)
	let k = ms.tree().kindOf(n)
	if k == ast.NodeKind.nameExpr or k == ast.NodeKind.selfExpr 'name'
		return true
	end 'name'
	if k == ast.NodeKind.memberExpr 'member'
		return isPlaceMember(ownMember(o, node: n).kind) and outlivesStatement(o, p: p, ms: ms, e: ast.memberExprObj(ms.tree(), id: n))
	end 'member'
	if k == ast.NodeKind.indexExpr 'element'
		return outlivesStatement(o, p: p, ms: ms, e: ast.indexExprObj(ms.tree(), id: n))
	end 'element'
	if k == ast.NodeKind.strLit 'literal'
		return ms.tree().strIsPlain(ast.strLitPartsRef(ms.tree(), id: n))
	end 'literal'
	return false
end 'outlivesStatement'

function assignStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let target = ast.assignStmtTarget(ms.tree(), id: st)
	let value = ast.assignStmtValue(ms.tree(), id: st)
	let site = offsetOfOwn(o, p: p, ms: ms, node: st)
	requireStoredBorrows(o, p: p, ms: ms, target: target, value: value, site: site)
	let k = ms.tree().kindOf(target)
	if k == ast.NodeKind.nameExpr 'name'
		let name = ownName(o, node: target)
		let targetName = ast.nameExprName(ms.tree(), id: target)
		if name.kind == ast.NameKind.nameLocal 'local'
			let out = consume(o, p: p, ms: ms, e: value, dest: OwnDest.make(OwnDestKind.destVariable, name: targetName), s: s)
			requireWritable(o, p: p, ms: ms, site: site, path: AccessPath.at(name.local))
			requireUnlent(o, p: p, ms: ms, root: name.local, site: site, s: out)
			if not out.dead 'live'
				requireHeld(o, p: p, ms: ms, site: site, ob: OwnObliged.make(name.local, site: 0 as diag.U32, destroys: false), s: out, kind: OwnDropKind.dropOverwrite)
			end 'live'
			return without(out, l: name.local)
		end 'local'
		if name.kind == ast.NameKind.nameSelfField 'selfField'
			let out = consumeInto(o, p: p, ms: ms, target: target, value: value, dest: OwnDest.make(OwnDestKind.destField, name: targetName), s: s)
			let path = pathOf(o, p: p, ms: ms, e: target)
			requireWritable(o, p: p, ms: ms, site: site, path: path)
			requireUnlent(o, p: p, ms: ms, root: path.root, site: site, s: out)
			match consumes assignPart(o, p: p, ms: ms, st: st, target: target, path: path, s: out) 'part'
				some(next) then return next
				none then _ = 0
			end 'part'
			requireOverwriteDroppable(o, p: p, ms: ms, st: st, target: target, s: out)
			return readRoot(o, p: p, ms: ms, l: selfLocalOf(o, p: p, ms: ms), site: offsetOfOwn(o, p: p, ms: ms, node: target), s: out)
		end 'selfField'
		if name.kind == ast.NameKind.nameConst or name.kind == ast.NameKind.nameFunc 'const'
			let out = consume(o, p: p, ms: ms, e: value, dest: OwnDest.make(OwnDestKind.destVariable, name: targetName.clone()), s: s)
			fail(o, p: p, site: site, code: diag.errAssignToImmutable, msg: diag.letReassigned(targetName))
			return out
		end 'const'
		panic("ownership: unhandled assignment target")
	end 'name'
	if k == ast.NodeKind.memberExpr 'member'
		let field = ast.memberExprName(ms.tree(), id: target)
		let out = consumeInto(o, p: p, ms: ms, target: target, value: value, dest: OwnDest.make(OwnDestKind.destField, name: field.clone()), s: s)
		if changesProjection(o, p: p, ms: ms, e: target, site: site, what: "assigned") 'projection'
			return out
		end 'projection'
		let path = pathOf(o, p: p, ms: ms, e: target)
		if not path.isPlace() 'temporary'
			fail(o, p: p, site: site, code: diag.errAssignToImmutable, msg: "the field '{field}' belongs to a temporary value, so assigning it changes nothing; assign it on a variable")
			return out
		end 'temporary'
		requireWritable(o, p: p, ms: ms, site: site, path: path)
		requireUnlent(o, p: p, ms: ms, root: path.root, site: site, s: out)
		match consumes assignPart(o, p: p, ms: ms, st: st, target: target, path: path, s: out) 'part'
			some(next) then return next
			none then _ = 0
		end 'part'
		requireOverwriteDroppable(o, p: p, ms: ms, st: st, target: target, s: out)
		return eval(o, p: p, ms: ms, e: ast.memberExprObj(ms.tree(), id: target), s: out)
	end 'member'
	if k == ast.NodeKind.indexExpr 'index'
		let collection = placeText(ms.tree(), e: ast.indexExprObj(ms.tree(), id: target))
		let out = consumeInto(o, p: p, ms: ms, target: target, value: value, dest: OwnDest.make(OwnDestKind.destElement, name: collection), s: s)
		if changesProjection(o, p: p, ms: ms, e: target, site: site, what: "assigned") 'projection'
			return out
		end 'projection'
		let path = pathOf(o, p: p, ms: ms, e: target)
		if not path.isPlace() 'temporary'
			fail(o, p: p, site: site, code: diag.errAssignToImmutable, msg: "the element belongs to a temporary collection, so assigning it changes nothing; assign it on a variable")
			return out
		end 'temporary'
		requireWritable(o, p: p, ms: ms, site: site, path: path)
		requireUnlent(o, p: p, ms: ms, root: path.root, site: site, s: out)
		requireOverwriteDroppable(o, p: p, ms: ms, st: st, target: target, s: out)
		return subscript(o, p: p, ms: ms, e: target, s: out)
	end 'index'
	panic("ownership: unhandled assignment target")
end 'assignStmtOwn'

// requireOverwriteDroppable is the drop of the value a field or an element holds when an assignment replaces it.
// A promise there is dropped as its holder would drop it, cancelled, or skipped when a take left the slot empty, as maxon's
// store into a promise field releases what the field held.
function requireOverwriteDroppable(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, target ast.NodeID, s OwnState)
	if not s.dead and not ast.isPromiseType(ms.types, reads: p.types, t: ownType(o, node: target)) 'live'
		let name = placeText(ms.tree(), e: target)
		requireDroppable(o, p: p, ms: ms, site: offsetOfOwn(o, p: p, ms: ms, node: st), t: ownType(o, node: target), d: OwnDrop.make(OwnDropKind.dropOverwrite, name: name))
	end 'live'
end 'requireOverwriteDroppable'

// consumeInto is the value stored into a part of a variable. The part's address is taken before the value is
// computed, so the target stays borrowed while it is: a call in the value that changes the variable could otherwise make
// the store land where the part used to be.
function consumeInto(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, target ast.NodeID, value ast.NodeID, consumes dest OwnDest, consumes s OwnState) returns OwnState
	let held = o.projections.count()
	hold(o, p: p, ms: ms, place: target, kind: OwnProjectionKind.projectTarget, byAddress: true)
	let out = consume(o, p: p, ms: ms, e: value, dest: dest, s: s)
	release(o, mark: held)
	return out
end 'consumeInto'

// whenStmtOwn schedules a behaviour. The cowns it names are only read: the behaviour takes a count of its own on each
// when it is scheduled. Each variable its body uses moves into it, so the enclosing function cannot use it again, and the
// body is checked as a function of its own. A behaviour that the bodies check recorded nothing for was not typed, and
// the behaviours pass that types it is the one that lets its body through.
function whenStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	return match consumes o.c.typing.whens.get(st as Count) 'info'
		some(behaviour) gives behaviourOwn(o, p: p, ms: ms, st: st, behaviour: behaviour, s: s)
		none gives s
	end 'info'
end 'whenStmtOwn'

function behaviourOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, behaviour ast.WhenInfo, consumes s OwnState) returns OwnState
	var out = s
	let cowns = ast.whenStmtCownsRef(ms.tree(), id: st)
	for i in 0 upto ms.tree().listLen(cowns) 'cowns'
		let cn = ms.tree().listAt(cowns, index: i) as ast.NodeID
		out = expr(o, p: p, ms: ms, e: cn, s: out)
	end 'cowns'
	for i in 0 upto behaviour.captures.count() 'captures'
		out = consume(o, p: p, ms: ms, e: behaviour.captures[i].refNode, dest: OwnDest.of(OwnDestKind.destBehaviour), s: out)
	end 'captures'
	runNested(o, p: p, ms: ms, fid: behaviour.fn, body: ast.whenStmtBodyRef(ms.tree(), id: st), site: st, closureTy: ast.noType)
	return out
end 'behaviourOwn'

// runNested checks the body of a behaviour or a closure, written at site, as a function of its own.
function runNested(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, fid ast.FuncID, body diag.U32, site ast.NodeID, closureTy ast.TypeID)
	var sites = ast.NodeIDList.create(0)
	for _ in 0 upto ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).params.count() 'params'
		sites.push(site)
	end 'params'
	let modID = o.c.modID
	let checker = exchange(o.c, value: Checker.make(modID, typing: ast.Typing.new(modID)))
	let found = exchange(o.errs, value: diag.ErrorList.create(0))
	var inner = Ownership.make(checker, errs: found)
	inner.closureTy = closureTy
	inner.borrowing = exchange(o.borrowing, value: BoolIntMap.new())
	run(inner, p: p, ms: ms, fid: fid, body: body, paramSites: sites)
	o.errs = exchange(inner.errs, value: diag.ErrorList.create(0))
	o.borrowing = exchange(inner.borrowing, value: BoolIntMap.new())
	o.c = exchange(inner.c, value: Checker.make(modID, typing: ast.Typing.new(modID)))
end 'runNested'

// tryStmtOwn checks the body of a try block with its failures going to the handler, which starts from the join of the
// states where they happen.
function tryStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let handles = ast.tryStmtHasOtherwise(ms.tree(), id: st)
	let body = ast.tryStmtBodyRef(ms.tree(), id: st)
	if not enterTry(o, handles: handles) 'passes'
		return walk(o, p: p, ms: ms, body: body, s: s)
	end 'passes'
	let after = walk(o, p: p, ms: ms, body: body, s: s)
	let c = leaveTry(o)
	if not handles 'noHandler'
		return after
	end 'noHandler'
	let handler = walk(o, p: p, ms: ms, body: ast.tryStmtHandlerRef(ms.tree(), id: st), s: c.entry)
	return join(o, p: p, ms: ms, a: after, b: handler)
end 'tryStmtOwn'

// ifTryStmtOwn checks a conditional try: the failures of its call go to the else block, which starts from the join of the
// states where they happen, and the block that runs when the call succeeds owns what the call gave.
function ifTryStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let call = ast.ifTryStmtCall(ms.tree(), id: st)
	let name = ast.ifTryStmtName(ms.tree(), id: st)
	let mark = o.inFlight.count()
	let added = enterTry(o, handles: true)
	var after = s
	if name != "" 'binds'
		if holdsBorrowOf(o, p: p, ms: ms, t: ownType(o, node: call)) 'borrows'
			fail(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: call), code: diag.errBorrowEscapes, msg: "'{name}' would hold a borrow, which 'if try' cannot bind; bind it with 'let {name} = try ... otherwise ...'")
		end 'borrows'
		after = consume(o, p: p, ms: ms, e: call, dest: OwnDest.make(OwnDestKind.destVariable, name: name.clone()), s: after)
	end 'binds' else 'bare'
		after = expr(o, p: p, ms: ms, e: call, s: after)
	end 'bare'
	let entry = leaveTryEntry(o, added: added)
	land(o, mark: mark)
	let scope = o.obliged.count()
	if name != "" 'bound'
		let sym = ownLocalOf(o, node: st)
		oblige(o, p: p, ms: ms, l: sym, site: offsetOfOwn(o, p: p, ms: ms, node: st))
		after = without(after, l: sym)
	end 'bound'
	let walked = walk(o, p: p, ms: ms, body: ast.ifTryStmtThenRef(ms.tree(), id: st), s: after)
	let succeeded = endScope(o, p: p, ms: ms, mark: scope, s: walked)
	if not ast.ifTryStmtHasElse(ms.tree(), id: st) 'noElse'
		return join(o, p: p, ms: ms, a: succeeded, b: entry)
	end 'noElse'
	let failed = walk(o, p: p, ms: ms, body: ast.ifTryStmtElseRef(ms.tree(), id: st), s: entry)
	return join(o, p: p, ms: ms, a: succeeded, b: failed)
end 'ifTryStmtOwn'

// enterTry starts a try: one with a handler catches what it covers, and one without passes it to the try around it, or
// with none around it to the caller. It gives whether the try added a catch.
function enterTry(mutates o Ownership, handles bool) returns bool
	if not handles and o.catches.count() > 0 'passes'
		return false
	end 'passes'
	let obliged = o.obliged.count()
	o.catches.push(OwnCatch.make(not handles, obliged: obliged))
	return true
end 'enterTry'

// leaveTry ends a try that enterTry added a catch for, and gives the catch.
function leaveTry(mutates o Ownership) returns OwnCatch
	return try o.catches.pop() otherwise panic("ownership: no try to leave")
end 'leaveTry'

// leaveTryEntry ends the try of a try expression: the state where its handler starts, which no path reaches when the
// try added no catch.
function leaveTryEntry(mutates o Ownership, added bool) returns OwnState
	if not added 'none'
		return OwnState.unreachable()
	end 'none'
	let c = leaveTry(o)
	return c.entry
end 'leaveTryEntry'

// failure is a place where the operation just checked can fail: the state there goes to the innermost try's handler, or
// out of the function. Either way the scopes the failure leaves are dropped, and so is what is in flight.
function failure(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, s OwnState)
	if s.dead or o.catches.count() == 0 'none'
		return
	end 'none'
	if o.inFlight.count() > 0 'inFlight'
		let e = o.inFlight[try o.inFlight.count() - 1 otherwise 0 as Count]
		fail(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: e), code: diag.errNotDroppable, msg: "a failure at line {lineOf(o, p: p, ms: ms, site: site)} would drop this value before what takes it runs, but '{ast.typeName(ms.types, reads: p.types, t: ownType(o, node: e))}' cannot be dropped; compute what can fail first, into a variable")
	end 'inFlight'
	let last = try o.catches.count() - 1 otherwise 0 as Count
	if o.catches[last].propagates 'propagates'
		requireEnded(o, p: p, ms: ms, from: 0 as Count, s: s, site: site, kind: OwnDropKind.dropFailure)
		return
	end 'propagates'
	let from = o.catches[last].obliged
	let left = leave(o, p: p, ms: ms, from: from, s: s.clone(), site: site, kind: OwnDropKind.dropFailure)
	let entry = exchange(o.catches[last].entry, value: OwnState.unreachable())
	let joined = join(o, p: p, ms: ms, a: entry, b: left)
	o.catches[last].entry = joined
end 'failure'

// land forgets the values in flight since mark: what took them has run.
function land(mutates o Ownership, mark Count)
	truncate(o.inFlight, mark: mark)
end 'land'

// handled checks what a transparent try does on a failure: return, break, continue or throw, or a handler block that leaves, or
// nothing for a try that passes it to the caller.
function handled(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes entry OwnState)
	let mark = o.inFlight.count()
	let ret = ast.tryExprRet(ms.tree(), id: e)
	let brk = ast.tryExprBrk(ms.tree(), id: e)
	let cont = ast.tryExprCont(ms.tree(), id: e)
	let thr = ast.tryExprThr(ms.tree(), id: e)
	let handler = ast.tryExprHandler(ms.tree(), id: e)
	if handler != 0 'handler'
		_ = walk(o, p: p, ms: ms, body: ast.handlerBlockBodyRef(ms.tree(), id: handler), s: entry)
	end 'handler' else if ret != 0 'return'
		_ = returnStmtOwn(o, p: p, ms: ms, st: ret, s: entry)
	end 'return' else if brk != 0 'break'
		_ = jumpOwn(o, p: p, ms: ms, st: brk, s: entry, isBreak: true)
	end 'break' else if cont != 0 'continue'
		_ = jumpOwn(o, p: p, ms: ms, st: cont, s: entry, isBreak: false)
	end 'continue' else if thr != 0 'throw'
		_ = throwStmtOwn(o, p: p, ms: ms, st: thr, s: entry)
	end 'throw'
	land(o, mark: mark)
end 'handled'

// tryExprOwn is a try whose value comes from its expression or from 'otherwise', like the branches of a conditional, or
// a transparent one, whose expression is only read.
function tryExprOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let inner = ast.tryExprE(ms.tree(), id: e)
	let passes = ast.propagates(ms.tree(), e: e)
	if ast.isTransparent(ms.tree(), e: e) 'transparent'
		let added = enterTry(o, handles: not passes)
		let after = eval(o, p: p, ms: ms, e: inner, s: s)
		let entry = leaveTryEntry(o, added: added)
		handled(o, p: p, ms: ms, e: e, entry: entry)
		return after
	end 'transparent'
	if ast.tryExprIgnore(ms.tree(), id: e) 'ignore'
		let added = enterTry(o, handles: not passes)
		let after = eval(o, p: p, ms: ms, e: inner, s: s)
		let entry = leaveTryEntry(o, added: added)
		return join(o, p: p, ms: ms, a: after, b: entry)
	end 'ignore'
	let handler = ast.tryExprHandler(ms.tree(), id: e)
	if handler != 0 'falls'
		let mark = o.inFlight.count()
		let added = enterTry(o, handles: true)
		let after = eval(o, p: p, ms: ms, e: inner, s: s)
		let entry = leaveTryEntry(o, added: added)
		let ended = walk(o, p: p, ms: ms, body: ast.handlerBlockBodyRef(ms.tree(), id: handler), s: entry)
		land(o, mark: mark)
		return join(o, p: p, ms: ms, a: after, b: ended)
	end 'falls'
	let mark = o.inFlight.count()
	let added = enterTry(o, handles: not passes)
	let after = consume(o, p: p, ms: ms, e: inner, dest: OwnDest.of(OwnDestKind.destResult), s: s)
	let entry = leaveTryEntry(o, added: added)
	land(o, mark: mark)
	let fallback = consume(o, p: p, ms: ms, e: ast.tryFallback(ms.tree(), e: e), dest: OwnDest.of(OwnDestKind.destResult), s: entry)
	return join(o, p: p, ms: ms, a: after, b: fallback)
end 'tryExprOwn'

function returnStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	var out = s
	let value = ast.returnStmtValue(ms.tree(), id: st)
	if value != 0 and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: o.fn).result == ast.ResultConv.resultBorrowed and ms.tree().kindOf(value) == ast.NodeKind.tupleExpr 'lentTuple'
		out = lentTupleOwn(o, p: p, ms: ms, e: value, s: out)
	end 'lentTuple' else if value != 0 and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: o.fn).result == ast.ResultConv.resultBorrowed 'lent'
		out = expr(o, p: p, ms: ms, e: value, s: out)
		requireLentByParameters(o, p: p, ms: ms, e: value)
	end 'lent' else if value != 0 'value'
		out = consume(o, p: p, ms: ms, e: value, dest: OwnDest.of(OwnDestKind.destReturn), s: out)
	end 'value'
	let site = offsetOfOwn(o, p: p, ms: ms, node: st)
	requireSetsInitialised(o, p: p, s: out, site: site)
	requireEnded(o, p: p, ms: ms, from: 0 as Count, s: out, site: site, kind: OwnDropKind.dropReturn)
	return OwnState.unreachable()
end 'returnStmtOwn'

// lentTupleOwn checks the tuple that a function returning a borrowed place returns, which is lent element by element: each
// element that is managed is a place under the law of requireLentByParameters, which it lends, and a scalar is its value,
// as a borrow of one is. The tuple holds those borrows and no value of its own (README, "Tuples").
function lentTupleOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let elements = match consumes o.c.typing.structLits.get(e as Count) 'lit'
		some(lit) gives lit.ordered
		none panic("ownership: the tuple at node {e} was not typed")
	end 'lit'
	var out = s
	for i in 0 upto elements.count() 'each'
		out = expr(o, p: p, ms: ms, e: elements[i], s: out)
		if isManagedOwn(p, ms: ms, t: ownType(o, node: elements[i])) or ast.boxedTo(o.c.typing, node: elements[i]) != ast.noType 'place'
			requireLentByParameters(o, p: p, ms: ms, e: elements[i])
		end 'place'
	end 'each'
	return out
end 'lentTupleOwn'

// requireLentByParameters is the law of a function that returns a borrowed place: the place lies in what the caller lent
// it, a let or a mutates parameter or a self that is not consumed, so it outlives the call. Through a call of another
// such function it lies in whatever that call may lend it from. A managed place cannot lie in a scalar, so a scalar
// argument of such a call lends nothing to a managed result.
function requireLentByParameters(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID)
	let site = offsetOfOwn(o, p: p, ms: ms, node: e)
	let fnName = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: o.fn).name.clone()
	if ast.boxedTo(o.c.typing, node: e) != ast.noType 'boxed'
		fail(o, p: p, site: site, code: diag.errBorrowedReturn, msg: "'{fnName}' returns a borrowed place, and this one would be put in a new box to be the interface it returns; return a place that holds the interface value, or declare 'returns T' to give a value")
		return
	end 'boxed'
	let call = projectionOf(o, ms: ms, e: e)
	if call != 0 'projection'
		let from = lenders(o, p: p, ms: ms, call: call)
		for i in 0 upto from.count() 'each'
			requireLentByParameters(o, p: p, ms: ms, e: from[i])
		end 'each'
		return
	end 'projection'
	let path = pathOf(o, p: p, ms: ms, e: e)
	if not path.isPlace() 'fresh'
		fail(o, p: p, site: site, code: diag.errBorrowedReturn, msg: "'{fnName}' returns a borrowed place, and this is a value made here, which nothing owns once it returns; return a parameter, or a field or an element of one, or declare 'returns T' to give a value")
		return
	end 'fresh'
	let root = o.c.typing.locals[path.root as Count].clone()
	let text = pathText(o, p: p, ms: ms, path: path)
	if root.isSelf 'self'
		let conv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: o.fn).selfConv
		if not lends(conv) 'owned'
			fail(o, p: p, site: site, code: diag.errBorrowedReturn, msg: "'{text}' lies in 'self', which '{fnName}' takes '{conv.keyword()} self' and so ends when it returns; take 'self' as a let or as 'mutates self', or declare 'returns T' to give a value")
		end 'owned'
		return
	end 'self'
	if root.isParam 'param'
		if not lends(root.conv) 'owned'
			fail(o, p: p, site: site, code: diag.errBorrowedReturn, msg: "'{text}' lies in '{root.name}', a '{root.conv.keyword()}' parameter, which '{fnName}' owns and ends when it returns; take '{root.name}' as a let or a 'mutates' parameter, or declare 'returns T' to give a value")
		end 'owned'
		return
	end 'param'
	fail(o, p: p, site: site, code: diag.errBorrowedReturn, msg: "'{text}' lies in the local '{root.name}', which ends when '{fnName}' returns; return a place in a let or a 'mutates' parameter or in 'self', or declare 'returns T' to give a value")
end 'requireLentByParameters'

// throwStmtOwn is a failure that always happens: it goes to the innermost try's handler, or with none out of the
// function.
function throwStmtOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let out = consume(o, p: p, ms: ms, e: ast.throwStmtValue(ms.tree(), id: st), dest: OwnDest.of(OwnDestKind.destReturn), s: s)
	let added = enterTry(o, handles: false)
	failure(o, p: p, ms: ms, site: offsetOfOwn(o, p: p, ms: ms, node: st), s: out)
	if added 'added'
		_ = leaveTry(o)
	end 'added'
	return OwnState.unreachable()
end 'throwStmtOwn'

// jumpOwn is a break or a continue, whose state joins the frame's where the jump lands.
function jumpOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState, isBreak bool) returns OwnState
	let frame = frameOf(o, target: ownJump(o, node: st))
	var kind = OwnDropKind.dropContinue
	if isBreak 'break'
		kind = OwnDropKind.dropBreak
	end 'break'
	let from = o.frames[frame].obliged
	let left = leave(o, p: p, ms: ms, from: from, s: s, site: offsetOfOwn(o, p: p, ms: ms, node: st), kind: kind)
	if isBreak 'breaks'
		let breaks = exchange(o.frames[frame].breaks, value: OwnState.unreachable())
		let joined = join(o, p: p, ms: ms, a: breaks, b: left)
		o.frames[frame].breaks = joined
	end 'breaks' else 'continues'
		let continues = exchange(o.frames[frame].continues, value: OwnState.unreachable())
		let joined = join(o, p: p, ms: ms, a: continues, b: left)
		o.frames[frame].continues = joined
	end 'continues'
	return OwnState.unreachable()
end 'jumpOwn'

// loop walks the body again from what the first walk added to the state, which is enough for a fact to reach the top of
// the next iteration; a first walk that adds nothing needs no second.
// fresh is a local that each pass through the body gives a value of its own before the body runs, or none.
function loopOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, target ast.NodeID, consumes s OwnState, body diag.U32, cond ast.NodeID, fresh ast.LocalID) returns OwnState
	pushFrameOwn(o, target: target)
	let frame = try o.frames.count() - 1 otherwise 0 as Count
	var entry = s
	if cond != 0 'cond'
		entry = expr(o, p: p, ms: ms, e: cond, s: entry)
	end 'cond'
	var after = OwnState.unreachable()
	for i in 0 upto 2 'walks'
		var pass = entry.clone()
		if fresh != ast.noLocal 'fresh'
			pass = without(pass, l: fresh)
		end 'fresh'
		after = walk(o, p: p, ms: ms, body: body, s: pass)
		let continues = o.frames[frame].continues.clone()
		let top = joinLoop(o, p: p, ms: ms, entry: entry.clone(), back: after.clone())
		let next = joinLoop(o, p: p, ms: ms, entry: top, back: continues)
		if sameState(next, b: entry) 'settled'
			break 'walks'
		end 'settled'
		entry = next
		if cond != 0 'again'
			entry = expr(o, p: p, ms: ms, e: cond, s: entry)
		end 'again'
	end 'walks'
	let closed = popFrameOwn(o)
	// A loop whose condition is the literal true is left by 'break' alone, so no path leaves it from the top or the
	// bottom of the body.
	if isTrue(ms.tree(), e: cond) 'forever'
		return closed.breaks
	end 'forever'
	let bottom = joinLoop(o, p: p, ms: ms, entry: entry, back: after)
	return join(o, p: p, ms: ms, a: bottom, b: closed.breaks)
end 'loopOwn'

// forEachOwn checks a for over a collection. An array lends each element to the variable in turn, so a place it is stays
// held while the body runs, as a match subject is while an arm that binds its payload does: the body may read it but
// neither change nor move it, except through the variable, whose fields are as writable as the element's. A type with the
// iteration protocol gives each element as a value of its own; one that is its own cursor is moved on in place, so a
// place it is must be mutable, and is held as an array is. A collection that is not a place is a temporary that the
// statement owns.
function forEachOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, consumes s OwnState) returns OwnState
	let source = ast.forStmtFrom(ms.tree(), id: st)
	let start = expr(o, p: p, ms: ms, e: source, s: s)
	let path = pathOf(o, p: p, ms: ms, e: source)
	// A borrowed result is held where it lies, but lends no part of itself to be changed through the variable.
	let projected = projectionOf(o, ms: ms, e: source) != 0
	var held = path.isPlace() or projected
	var lends = path.isPlace()
	var fresh = ast.noLocal
	if o.c.typing.iterations.has(st as Count) 'protocol'
		let info = iterationOwn(o, node: st)
		lends = false
		// An element that current() lends is a borrow of the cursor, which the loop holds; one it gives is the variable's.
		if info.current.result != ast.ResultConv.resultBorrowed 'owned'
			fresh = ownLocalOf(o, node: st)
		end 'owned'
		// A loop over a cursor moves it on in place; one over a collection holds it only where the cursor it makes borrows
		// it, as an array's loop does.
		let walksItself = not info.hasFactory
		held = held and (walksItself or holdsBorrowOf(o, p: p, ms: ms, t: info.cursorTy))
		let site = offsetOfOwn(o, p: p, ms: ms, node: source)
		if walksItself and held and ast.isByAddress(info.advance.selfConv) and not changesProjection(o, p: p, ms: ms, e: source, site: site, what: "moved on as the cursor of a for") 'advances'
			requireWritable(o, p: p, ms: ms, site: site, path: path)
			requireUnlent(o, p: p, ms: ms, root: path.root, site: site, s: start)
		end 'advances'
	end 'protocol'
	var lent = ast.LocalIDList.create(0)
	if lends 'element'
		lent.push(ownLocalOf(o, node: st))
		// A take of the promise out of the slot the variable names spends the variable for the pass alone.
		if ast.isPromiseType(ms.types, reads: p.types, t: o.c.typing.locals[ownLocalOf(o, node: st) as Count].ty) 'slots'
			fresh = ownLocalOf(o, node: st)
		end 'slots'
	end 'element'
	for i in 0 upto lent.count() 'lend'
		o.lenders.push(OwnLender.make(lent[i], collection: path.clone()))
	end 'lend'
	let mark = o.projections.count()
	if held 'hold'
		let lent = lentPaths(o, p: p, ms: ms, e: source)
		for i in 0 upto lent.count() 'each'
			o.projections.push(OwnProjection.make(lent[i].clone(), place: 0 as ast.NodeID, kind: OwnProjectionKind.projectLoop, ty: ownType(o, node: source)))
		end 'each'
	end 'hold'
	let out = loopOwn(o, p: p, ms: ms, target: st, s: start, body: ast.forStmtBodyRef(ms.tree(), id: st), cond: 0 as ast.NodeID, fresh: fresh)
	release(o, mark: mark)
	for _ in 0 upto lent.count() 'unlend'
		_ = try o.lenders.pop() otherwise panic("ownership: the lender of a loop's variable vanished")
	end 'unlend'
	return out
end 'forEachOwn'

function iterationOwn(o Ownership, node ast.NodeID) returns ast.IterationInfo
	return match consumes o.c.typing.iterations.get(node as Count) 'hit'
		some(info) gives info
		none panic("ownership: the for at node {node} walks no iteration protocol")
	end 'hit'
end 'iterationOwn'

function isTrue(tree ast.Tree, e ast.NodeID) returns bool
	return e != 0 and tree.kindOf(e) == ast.NodeKind.boolLit and ast.boolLitValue(tree, id: e)
end 'isTrue'

function matchOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, core ast.NodeID, consumes s OwnState) returns OwnState
	let consuming = ast.matchCoreConsumes(ms.tree(), id: core)
	let subject = ast.matchCoreSubject(ms.tree(), id: core)
	var start = s
	if consuming 'consumes'
		_ = requireMayTakeApart(o, p: p, ms: ms, site: offsetOfOwn(o, p: p, ms: ms, node: subject), t: ast.contentType(ms.types, reads: p.types, t: ownType(o, node: subject)), what: "a 'match consumes'")
		start = consume(o, p: p, ms: ms, e: subject, dest: OwnDest.of(OwnDestKind.destMatch), s: start)
	end 'consumes' else 'reads'
		start = expr(o, p: p, ms: ms, e: subject, s: start)
	end 'reads'
	pushFrameOwn(o, target: core)
	var subjectPaths = AccessPaths.create(0)
	var subjectKnown = false
	var result = OwnState.unreachable()
	let arms = ast.matchCoreArmsRef(ms.tree(), id: core)
	var fell = OwnState.unreachable()
	for i in 0 upto ms.tree().listLen(arms) 'arms'
		let arm = ms.tree().listAt(arms, index: i) as ast.NodeID
		let entered = join(o, p: p, ms: ms, a: start.clone(), b: fell)
		var a = freshBindings(o, ms: ms, arm: arm, s: entered)
		let mark = o.obliged.count()
		if consuming 'takeApart'
			takeApart(o, p: p, ms: ms, core: core, arm: arm)
		end 'takeApart'
		let borrows = armBorrows(o, p: p, ms: ms, arm: arm)
		if borrows and not subjectKnown 'find'
			subjectPaths = lentPaths(o, p: p, ms: ms, e: subject)
			subjectKnown = true
		end 'find'
		let held = o.projections.count()
		if borrows 'hold'
			for j in 0 upto subjectPaths.count() 'each'
				o.projections.push(OwnProjection.make(subjectPaths[j].clone(), place: 0 as ast.NodeID, kind: OwnProjectionKind.projectMatch, ty: ownType(o, node: subject)))
			end 'each'
		end 'hold'
		let form = ast.matchArmForm(ms.tree(), id: arm)
		if form == ast.ArmKind.armThen 'then'
			a = stmt(o, p: p, ms: ms, st: ast.matchArmAction(ms.tree(), id: arm), s: a)
		end 'then' else if form == ast.ArmKind.armGives 'gives'
			let flight = o.inFlight.count()
			a = consume(o, p: p, ms: ms, e: ast.matchArmValue(ms.tree(), id: arm), dest: OwnDest.of(OwnDestKind.destResult), s: a)
			land(o, mark: flight)
		end 'gives' else 'panics'
			_ = expr(o, p: p, ms: ms, e: ast.matchArmValue(ms.tree(), id: arm), s: a)
			a = OwnState.unreachable()
		end 'panics'
		release(o, mark: held)
		a = endScope(o, p: p, ms: ms, mark: mark, s: a)
		fell = OwnState.unreachable()
		if ast.matchArmFalls(ms.tree(), id: arm) 'falls'
			fell = a
		end 'falls' else 'leaves'
			result = join(o, p: p, ms: ms, a: result, b: a)
		end 'leaves'
	end 'arms'
	result = join(o, p: p, ms: ms, a: result, b: fell)
	let closed = popFrameOwn(o)
	return join(o, p: p, ms: ms, a: result, b: closed.breaks)
end 'matchOwn'

// freshBindings is the state at the start of an arm, whose bindings each hold the payload the arm binds them to anew,
// whatever a pass of a loop around the match did with them before.
function freshBindings(o Ownership, ms ast.ModuleState, arm ast.NodeID, consumes s OwnState) returns OwnState
	var out = s
	let patterns = ast.matchArmPatternsRef(ms.tree(), id: arm)
	for i in 0 upto ms.tree().listLen(patterns) 'patterns'
		let pat = ms.tree().listAt(patterns, index: i) as ast.NodeID
		if ast.patternForm(ms.tree(), id: pat) != ast.PatternKind.patCase 'literal'
			continue 'patterns'
		end 'literal'
		let info = ownPattern(o, node: pat)
		for j in 0 upto info.bindings.count() 'bindings'
			if info.bindings[j] != ast.noLocal 'named'
				out = without(out, l: info.bindings[j])
			end 'named'
		end 'bindings'
	end 'patterns'
	return out
end 'freshBindings'

// armBorrows is whether an arm binds a payload that is not a scalar, which borrows from the subject.
function armBorrows(o Ownership, p ast.Project, ms ast.ModuleState, arm ast.NodeID) returns bool
	let patterns = ast.matchArmPatternsRef(ms.tree(), id: arm)
	for i in 0 upto ms.tree().listLen(patterns) 'patterns'
		let pat = ms.tree().listAt(patterns, index: i) as ast.NodeID
		if ast.patternForm(ms.tree(), id: pat) != ast.PatternKind.patCase 'literal'
			continue 'patterns'
		end 'literal'
		let info = ownPattern(o, node: pat)
		for j in 0 upto info.bindings.count() 'bindings'
			let l = info.bindings[j]
			if l != ast.noLocal and o.c.typing.locals[l as Count].projected 'projected'
				return true
			end 'projected'
		end 'bindings'
	end 'patterns'
	return false
end 'armBorrows'

// takeApart is the start of an arm of a match that consumes its subject: each payload the arm names is an owned local of
// the arm, and the payloads it does not name are dropped with the subject.
function takeApart(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, core ast.NodeID, arm ast.NodeID)
	let u = ast.contentType(ms.types, reads: p.types, t: ownType(o, node: ast.matchCoreSubject(ms.tree(), id: core)))
	if ast.typeKind(ms.types, reads: p.types, t: u) != ast.TypeKind.unionTy 'notUnion'
		return
	end 'notUnion'
	let orig = ast.originOf(ms.types, reads: p.types, t: u)
	let patterns = ast.matchArmPatternsRef(ms.tree(), id: arm)
	for i in 0 upto ms.tree().listLen(patterns) 'patterns'
		let pat = ms.tree().listAt(patterns, index: i) as ast.NodeID
		if ast.patternForm(ms.tree(), id: pat) != ast.PatternKind.patCase 'literal'
			continue 'patterns'
		end 'literal'
		let info = ownPattern(o, node: pat)
		let site = offsetOfOwn(o, p: p, ms: ms, node: pat)
		for j in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases[info.caseIdx].payload.count() 'payload'
			if j < info.bindings.count() and info.bindings[j] != ast.noLocal 'named'
				oblige(o, p: p, ms: ms, l: info.bindings[j], site: site)
			end 'named' else 'dropped'
				let name = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[info.caseIdx].payload[j].name.clone()
				let t = ast.payloadType(ms.types, reads: p.types, owner: u, caseIndex: info.caseIdx, index: j)
				requireDroppable(o, p: p, ms: ms, site: site, t: t, d: OwnDrop.make(OwnDropKind.dropPayload, name: name))
			end 'dropped'
		end 'payload'
	end 'patterns'
	if ast.matchArmIsDefault(ms.tree(), id: arm) 'default'
		requireUnnamedCasesDroppable(o, p: p, ms: ms, core: core, arm: arm, u: u)
	end 'default'
end 'takeApart'

// requireUnnamedCasesDroppable is the drop of what a default arm leaves in the subject: the payloads of the cases that no
// arm names.
function requireUnnamedCasesDroppable(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, core ast.NodeID, arm ast.NodeID, u ast.TypeID)
	let orig = ast.originOf(ms.types, reads: p.types, t: u)
	var named = Array.filled(ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count(), value: false)
	let arms = ast.matchCoreArmsRef(ms.tree(), id: core)
	for i in 0 upto ms.tree().listLen(arms) 'arms'
		let other = ms.tree().listAt(arms, index: i) as ast.NodeID
		let patterns = ast.matchArmPatternsRef(ms.tree(), id: other)
		for j in 0 upto ms.tree().listLen(patterns) 'patterns'
			let pat = ms.tree().listAt(patterns, index: j) as ast.NodeID
			if ast.patternForm(ms.tree(), id: pat) == ast.PatternKind.patCase 'case'
				named[ownPattern(o, node: pat).caseIdx] = true
			end 'case'
		end 'patterns'
	end 'arms'
	let site = offsetOfOwn(o, p: p, ms: ms, node: arm)
	for ci in 0 upto named.count() 'cases'
		if named[ci] 'named'
			continue 'cases'
		end 'named'
		for pi in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload.count() 'payload'
			let name = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload[pi].name.clone()
			let t = ast.payloadType(ms.types, reads: p.types, owner: u, caseIndex: ci, index: pi)
			requireDroppable(o, p: p, ms: ms, site: site, t: t, d: OwnDrop.make(OwnDropKind.dropPayload, name: name))
		end 'payload'
	end 'cases'
end 'requireUnnamedCasesDroppable'
