// RangeHandler is a try that catches the failures of what it covers: the state where its handler starts is the join of
// the states at those failures. A try with no handler passes them to the caller.
type RangeHandler
	export var propagates as bool
	export var entry as Count
	// takes is the one error the handler names, which every failure it catches must be, or none for a handler that names
	// none and so catches any.
	export var takes as ast.TypeID
	// site is the try, or 0 for the handler a test's body has.
	export var site as ast.NodeID
	// failures is how many operations the try covers that can fail, and proofs how many accesses it covers that the analysis
	// proved cannot, the latest being proven. A try that covers no failure says a failure is handled that cannot happen.
	export var failures as Count
	export var proofs as Count
	export var proven as ast.NodeID

	static function make(propagates bool, takes ast.TypeID, site ast.NodeID) returns RangeHandler
		return RangeHandler{propagates: propagates, entry: deadState, takes: takes, site: site, failures: 0 as Count, proofs: 0 as Count, proven: 0 as ast.NodeID}
	end 'make'
end 'RangeHandler'

typealias RangeHandlerList = Array with RangeHandler

// RangeTry is a try being walked: the handler it added, if it added one, and what the handler that takes its failures had
// counted when it began, which the try's own end is measured against. A try inside another passes its failures on and adds
// no handler.
type RangeTry
	export var site as ast.NodeID
	export var added as bool
	// reached is whether the try can run: one in code the analysis proves unreachable covers nothing the walk judged.
	export var reached as bool
	export var failures as Count
	export var proofs as Count

	static function make(site ast.NodeID, added bool, reached bool, failures Count, proofs Count) returns RangeTry
		return RangeTry{site: site, added: added, reached: reached, failures: failures, proofs: proofs}
	end 'make'
end 'RangeTry'

// RangeFrame is a loop or a match being walked, which a break leaves for the state after it.
type RangeFrame
	export var node as ast.NodeID
	export var breaks as Count

	static function make(node ast.NodeID) returns RangeFrame
		return RangeFrame{node: node, breaks: deadState}
	end 'make'
end 'RangeFrame'

typealias RangeFrameList = Array with RangeFrame

// Ranges is the range analysis of the bodies: it follows the span of each integer local through the code, and of each
// field that a condition narrows, and how places compare, and decides for each operator and cast how it can still fail
// (ArithInfo.fails). An operation that can fail must be covered by a try, and so must a call of a function that throws;
// lowering checks only what can fail.
//
// The analysis is one walk, linear in the code. At the top of a loop, what the loop's body may falsify is forgotten
// (loops.maxon), and a place loses what is known of it when it is assigned or a call may change it, so no loop is walked
// twice.
type Ranges
	export var modID as diag.ModuleID
	export var modIdx as Count
	// typing is the module's, which the analysis holds while it runs and records the failures in.
	export var typing as ast.Typing
	export var errs as diag.ErrorList
	// needless are the tries that cover only proven accesses, which are errors where nothing else is wrong.
	export var needless as diag.ErrorList
	// failed is whether the walk of the function or the value has met its error, which ends the walk.
	export var failed as bool
	export var fn as ast.FuncID
	// base is the local whose slot is 0: the locals of fn are by their slot, their distance from it.
	export var base as Count
	export var slots as Count
	export var locals as ast.LocalIDList
	// mutable says by slot whether a local may be assigned: a var, or a mutates or sets parameter.
	export var mutable as ByteArray
	export var st as Count
	export var handlers as RangeHandlerList
	export var frames as RangeFrameList
	// behaviour is whether fn is the body of a behaviour, which nothing waits for.
	export var behaviour as bool
	// written are the places the walk has seen assigned or given to a call that may change them, in order: what a
	// condition says of a place it changes itself, as 'a > 5 and reset(a)' does, is not known afterwards.
	export var written as PlaceList
	export var states as States
	// bounds are the accumulators of the loops being walked, which keep a span through every loop inside theirs.
	export var bounds as AccBoundList
	// probing is set while the body of a loop is walked to learn how its accumulators move: the walk records no error and
	// no failure, and the state it leaves behind is discarded.
	export var probing as bool
	export var probe as LoopProbe
	// scans are the effects of the loops' bodies of the functions being walked, and wide the span of each local's type by
	// its slot, which a local a loop writes has at the loop's top.
	export var scans as LoopScans
	export var wide as SpanList

	static function make(modID diag.ModuleID, modIdx Count, consumes typing ast.Typing) returns Ranges
		return Ranges{modID: modID, modIdx: modIdx, typing: typing, errs: diag.ErrorList.create(0), needless: diag.ErrorList.create(0), failed: false, fn: ast.noFunc, base: 0 as Count, slots: 0 as Count, locals: ast.LocalIDList.create(0), mutable: ByteArray.create(0), st: deadState, handlers: RangeHandlerList.create(0), frames: RangeFrameList.create(0), behaviour: false, written: PlaceList.create(0), states: States.new(), bounds: AccBoundList.create(0), probing: false, probe: LoopProbe.new(), scans: LoopScans.new(), wide: SpanList.create(0)}
	end 'make'
end 'Ranges'

// checkRanges analyses the defaults of the module's record fields, then the bodies of its functions, and gives needless
// the tries that cover only proven accesses.
function checkRanges(mutates c Checker, p ast.Project, ms ast.ModuleState, functions ast.FuncIDList, mutates errs diag.ErrorList, mutates needless diag.ErrorList)
	var r = Ranges.make(c.modID, modIdx: c.modIdx, typing: exchange(c.typing, value: ast.Typing.new(c.modID)))
	for i in 0 upto p.modules[c.modIdx].decls.count() 'decls'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many declarations")
		rangeCheckValues(r, p: p, ms: ms, ord: ord)
	end 'decls'
	for i in 0 upto functions.count() 'functions'
		r.failed = false
		rangeParamValues(r, p: p, ms: ms, fid: functions[i])
		r.failed = false
		rangeFunction(r, p: p, ms: ms, fid: functions[i], behaviour: false)
	end 'functions'
	c.typing = exchange(r.typing, value: ast.Typing.new(c.modID))
	rangeHandOver(r, errs: errs)
	needless.append(r.needless)
end 'checkRanges'

// rangeConstant analyses a constant's value and gives its span, which a name of the constant has wherever it is used.
function rangeConstant(mutates c Checker, p ast.Project, ms ast.ModuleState, value ast.NodeID, mutates errs diag.ErrorList) returns Span
	var r = Ranges.make(c.modID, modIdx: c.modIdx, typing: exchange(c.typing, value: ast.Typing.new(c.modID)))
	let s = rangeValue(r, p: p, ms: ms, e: value)
	c.typing = exchange(r.typing, value: ast.Typing.new(c.modID))
	rangeHandOver(r, errs: errs)
	return s
end 'rangeConstant'

// rangeHandOver gives the errors the analysis found to the list of the check.
function rangeHandOver(r Ranges, mutates errs diag.ErrorList)
	for i in 0 upto r.errs.count() 'each'
		errs.push(r.errs[i].clone())
	end 'each'
end 'rangeHandOver'

// rangeParamValues analyses the default of each parameter of a function, which a call that leaves the argument out evaluates.
function rangeParamValues(mutates r Ranges, p ast.Project, ms ast.ModuleState, fid ast.FuncID)
	for i in 0 upto ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).params.count() 'params'
		let e = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).params[i].defaultExpr
		if e != 0 'default'
			r.failed = false
			_ = rangeValue(r, p: p, ms: ms, e: e)
		end 'default'
	end 'params'
end 'rangeParamValues'

// rangeCheckValues analyses the defaults of a record's fields, and the raw values of an enum or a union that are no literal,
// which no function holds.
function rangeCheckValues(mutates r Ranges, p ast.Project, ms ast.ModuleState, ord ast.DeclOrdinal)
	if isNominalDecl(p.modules[r.modIdx].decls[ord as Count]) 'raws'
		rangeRawValues(r, p: p, ms: ms, tid: declTypeOf(p, ms: ms, ref: ast.DeclRef.make(r.modID, ordinal: ord)))
		return
	end 'raws'
	if not isRecordDecl(p.modules[r.modIdx].decls[ord as Count]) 'notRecord'
		return
	end 'notRecord'
	let tid = declTypeOf(p, ms: ms, ref: ast.DeclRef.make(r.modID, ordinal: ord))
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: tid).fields.count() 'fields'
		if ast.typeEntry(ms.types, reads: p.types, t: tid).fields[i].hasDefault 'default'
			r.failed = false
			_ = rangeValue(r, p: p, ms: ms, e: ast.typeEntry(ms.types, reads: p.types, t: tid).fields[i].defaultExpr)
		end 'default'
	end 'fields'
end 'rangeCheckValues'

function rangeRawValues(mutates r Ranges, p ast.Project, ms ast.ModuleState, tid ast.TypeID)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: tid).cases.count() 'cases'
		let e = ast.typeEntry(ms.types, reads: p.types, t: tid).cases[i].rawExpr
		if e != 0 'written'
			r.failed = false
			_ = rangeValue(r, p: p, ms: ms, e: e)
		end 'written'
	end 'cases'
end 'rangeRawValues'

// isNominalDecl is whether a declaration is an enum or a union, whose cases may write raw values.
function isNominalDecl(d ast.Decl) returns bool
	return match d 'k'
		enumDecl(_) gives true
		unionDecl(_) gives true
		typeDecl(_) gives false
		funcDecl(_) gives false
		constDecl(_) gives false
		aliasDecl(_) gives false
		interfaceDecl(_) gives false
		extensionDecl(_) gives false
	end 'k'
end 'isNominalDecl'

function isRecordDecl(d ast.Decl) returns bool
	return match d 'k'
		typeDecl(_) gives true
		funcDecl(_) gives false
		constDecl(_) gives false
		enumDecl(_) gives false
		unionDecl(_) gives false
		aliasDecl(_) gives false
		interfaceDecl(_) gives false
		extensionDecl(_) gives false
	end 'k'
end 'isRecordDecl'

// rangeValue analyses an expression outside any function, a constant's value or a field's default, and gives its span.
function rangeValue(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	r.fn = ast.noFunc
	r.handlers = RangeHandlerList.create(0)
	r.frames = RangeFrameList.create(0)
	r.bounds = AccBoundList.create(0)
	let m = r.states.mark()
	r.st = r.states.state(0 as Count)
	let s = rangeEval(r, p: p, ms: ms, e: e)
	r.states.release(m)
	r.st = deadState
	return s
end 'rangeValue'

// functionLocals are the locals that the bodies check declared in a function.
function functionLocals(r Ranges, p ast.Project, ms ast.ModuleState, fid ast.FuncID) returns ast.LocalIDList
	return match r.typing.funcLocals.get(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).nodeID as Count) 'locals'
		some(ids) gives ids.clone()
		none gives ast.LocalIDList.create(0)
	end 'locals'
end 'functionLocals'

// rangeFunction analyses the body of a function, or of a behaviour, which runs later: neither what is known around it
// nor a try around it reaches into it.
function rangeFunction(mutates r Ranges, p ast.Project, ms ast.ModuleState, fid ast.FuncID, behaviour bool)
	let outerFn = r.fn
	let outerSt = r.st
	let outerBehaviour = r.behaviour
	let outerWritten = r.written.count()
	let outerBase = r.base
	let outerSlots = r.slots
	let outerHandlers = exchange(r.handlers, value: RangeHandlerList.create(0))
	let outerFrames = exchange(r.frames, value: RangeFrameList.create(0))
	let outerBounds = exchange(r.bounds, value: AccBoundList.create(0))
	let outerLocals = exchange(r.locals, value: functionLocals(r, p: p, ms: ms, fid: fid))
	let outerMutable = exchange(r.mutable, value: ByteArray.create(0))
	let outerLoops = r.scans.loops.count()
	let outerEffects = r.scans.effects.count()
	r.fn = fid
	r.behaviour = behaviour
	enterLocals(r)
	let m = r.states.mark()
	r.st = r.states.state(r.slots)
	for i in 0 upto r.locals.count() 'locals'
		let id = r.locals[i]
		let ty = r.typing.locals[id as Count].ty
		if ast.isIntType(ms.types, reads: p.types, t: ty) 'int'
			let slot = slotOf(r, local: id)
			let st = r.st
			r.states.list[st].spans[slot] = typeSpan(ms.types, reads: p.types, t: ty)
		end 'int'
	end 'locals'
	let outerWide = exchange(r.wide, value: r.states.list[r.st].spans.clone())
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).isTest 'test'
		// A test handles every error its body raises: the failure of any call, of any error type, ends the test.
		r.handlers.push(RangeHandler.make(false, takes: ast.noType, site: 0 as ast.NodeID))
	end 'test'
	rangeBlock(r, p: p, ms: ms, body: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).bodyRef)
	r.states.release(m)
	r.fn = outerFn
	r.st = outerSt
	r.behaviour = outerBehaviour
	r.base = outerBase
	r.slots = outerSlots
	r.handlers = outerHandlers
	r.frames = outerFrames
	r.bounds = outerBounds
	r.locals = outerLocals
	r.mutable = outerMutable
	r.wide = outerWide
	r.scans.truncate(outerLoops, effectCount: outerEffects)
	truncatePlaces(r.written, count: outerWritten)
end 'rangeFunction'

// enterLocals gives the locals of the function being entered their slots, from the first of them to the last, and says
// which may be assigned.
function enterLocals(mutates r Ranges)
	r.base = 0
	r.slots = 0
	if r.locals.count() == 0 'none'
		return
	end 'none'
	var lo = r.locals[0] as Count
	var hi = lo
	for i in 1 upto r.locals.count() 'bounds'
		let id = r.locals[i] as Count
		if id < lo 'lower'
			lo = id
		end 'lower'
		if id > hi 'higher'
			hi = id
		end 'higher'
	end 'bounds'
	r.base = lo
	r.slots = try hi - lo + 1 otherwise panic("ranges: too many locals")
	r.mutable = ByteArray.create(r.slots)
	for i in 0 upto r.locals.count() 'mutable'
		let id = r.locals[i]
		if isMutableLocal(r.typing.locals[id as Count]) 'assignable'
			let slot = slotOf(r, local: id)
			r.mutable[slot] = 1
		end 'assignable'
	end 'mutable'
end 'enterLocals'

// slotOf is the slot of a local of the function being walked.
function slotOf(r Ranges, local ast.LocalID) returns Count
	let slot = try (local as Count) - r.base otherwise panic("ranges: the local {local} is not of the function being walked")
	if slot >= r.slots 'outside'
		panic("ranges: the local {local} is not of the function being walked")
	end 'outside'
	return slot
end 'slotOf'

// localAt is the local at a slot of the function being walked.
function localAt(r Ranges, slot Count) returns ast.LocalID
	return try (r.base + slot) as ast.LocalID otherwise panic("ranges: the slot {slot} names no local")
end 'localAt'

function truncatePlaces(mutates places PlaceList, count Count)
	while places.count() > count 'pop'
		try places.pop() otherwise panic("ranges: the places written are fewer than their mark")
	end 'pop'
end 'truncatePlaces'

// rangeRaise reports the error that ends the walk of the function or the value.
function rangeRaise(mutates r Ranges, p ast.Project, ms ast.ModuleState, node ast.NodeID, consumes code String, consumes msg String)
	if r.failed 'once'
		return
	end 'once'
	r.failed = true
	checkFail(r.modID, off: ms.tree().startOf(node), code: code, msg: msg, errs: r.errs)
end 'rangeRaise'

// rangeRaiseFixed is rangeRaise for an error whose message names the change that fix makes.
function rangeRaiseFixed(mutates r Ranges, p ast.Project, ms ast.ModuleState, node ast.NodeID, consumes code String, consumes msg String, consumes fix diag.Fix)
	if r.failed 'once'
		return
	end 'once'
	r.failed = true
	checkFailFixed(r.modID, off: ms.tree().startOf(node), code: code, msg: msg, fix: fix, errs: r.errs)
end 'rangeRaiseFixed'

function typeOf(r Ranges, e ast.NodeID) returns ast.TypeID
	return ast.nodeType(r.typing, node: e)
end 'typeOf'

function isDead(r Ranges, s Count) returns bool
	return r.states.list[s].dead
end 'isDead'

// rangeKeep marks the current state as one that something comes back to, and gives it.
function rangeKeep(mutates r Ranges) returns Count
	let st = r.st
	r.states.list[st].kept = true
	return st
end 'rangeKeep'

// rangeOwn makes the current state one that can be changed in place.
function rangeOwn(mutates r Ranges)
	let st = r.st
	if r.states.list[st].kept 'kept'
		r.st = r.states.copyOf(st)
	end 'kept'
end 'rangeOwn'

function rangeBlock(mutates r Ranges, p ast.Project, ms ast.ModuleState, body diag.U32)
	for i in 0 upto ms.tree().listLen(body) 'each'
		if r.failed 'stop'
			return
		end 'stop'
		rangeStmt(r, p: p, ms: ms, s: ms.tree().listAt(body, index: i) as ast.NodeID)
	end 'each'
end 'rangeBlock'

// rangeWrite gives a place the value of the span s, after which nothing known of the place before holds.
function rangeWrite(mutates r Ranges, p ast.Project, ms ast.ModuleState, place Place, s Span, t ast.TypeID)
	if not rangeTouch(r, place: place) 'dead'
		return
	end 'dead'
	let st = r.st
	r.states.list[st].drop(Gone.overlapping(place.clone()))
	if ast.isIntType(ms.types, reads: p.types, t: t) 'int'
		r.states.list[st].refine(place, v: s.clamp(typeSpan(ms.types, reads: p.types, t: t)))
	end 'int'
end 'rangeWrite'

// rangeAffect is a collection that a call changes in a way the count effect says, and in no other way the analysis
// follows.
function rangeAffect(mutates r Ranges, place Place, effect ast.CountEffect)
	if not rangeTouch(r, place: place) 'dead'
		return
	end 'dead'
	let st = r.st
	r.states.list[st].affect(place, effect: effect)
end 'rangeAffect'

// rangeTouch notes that a place changes, in a state of its own to change, and says whether a path reaches the change.
function rangeTouch(mutates r Ranges, place Place) returns bool
	if isDead(r, s: r.st) 'dead'
		return false
	end 'dead'
	rangeOwn(r)
	r.written.push(place.clone())
	if r.probing and place.depth == 0 'probed'
		r.probe.noteWrite(place.root)
	end 'probed'
	return true
end 'rangeTouch'

// rangeChanged is a place that a call may change: what was known of it no longer holds.
function rangeChanged(mutates r Ranges, p ast.Project, ms ast.ModuleState, place Place, t ast.TypeID)
	if ast.isIntType(ms.types, reads: p.types, t: t) 'int'
		rangeWrite(r, p: p, ms: ms, place: place, s: typeSpan(ms.types, reads: p.types, t: t), t: t)
		return
	end 'int'
	rangeWrite(r, p: p, ms: ms, place: place, s: Span.make(ast.I128.zero(), hi: ast.I128.zero()), t: t)
end 'rangeChanged'

// rangePlaceOf is the place an expression names, if it names one the analysis follows: a local, a field of the receiver,
// or a field of a place that is not too deep already.
function rangePlaceOf(r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns table.Option with Place
	if r.fn == ast.noFunc 'outside'
		return table.Option.none
	end 'outside'
	let k = ms.tree().kindOf(e)
	if k == ast.NodeKind.nameExpr 'name'
		let name = nameInfoOf(r.typing, node: e)
		if name.kind == ast.NameKind.nameLocal 'local'
			return table.Option.some(Place.local(slotOf(r, local: name.local)))
		end 'local'
		if name.kind == ast.NameKind.nameSelfField 'selfField'
			return placeField(selfPlace(r, p: p, ms: ms), field: name.fieldIndex)
		end 'selfField'
		return table.Option.none
	end 'name'
	if k == ast.NodeKind.selfExpr 'self'
		return table.Option.some(selfPlace(r, p: p, ms: ms))
	end 'self'
	if k == ast.NodeKind.memberExpr 'member'
		let info = memberInfoOf(r, e: e)
		if info.kind == ast.MemberKind.memberField 'field'
			return match consumes rangePlaceOf(r, p: p, ms: ms, e: ast.memberExprObj(ms.tree(), id: e)) 'obj'
				some(obj) gives placeField(obj, field: info.fieldIndex)
				none gives table.Option.none
			end 'obj'
		end 'field'
	end 'member'
	if k == ast.NodeKind.callExpr 'call'
		return rangeMeasuredPlace(r, p: p, ms: ms, e: e, measure: ast.MeasureKind.measureCount)
	end 'call'
	return table.Option.none
end 'rangePlaceOf'

// rangeMeasuredPlace is the count of the collection whose count the call e reads as measure says, if the call is one and
// the collection is a place whose count the analysis follows.
function rangeMeasuredPlace(r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, measure ast.MeasureKind) returns table.Option with Place
	let call = r.typing.calls.expect(e as Count, what: "call")
	if ast.intrinsicMeasure(call.intrinsic) != measure 'other'
		return table.Option.none
	end 'other'
	let receiver = ast.callReceiver(ms.tree(), e: e, kind: call.kind)
	if receiver == 0 or not isMeasuredType(p, ms: ms, t: typeOf(r, e: receiver)) 'unfollowed'
		return table.Option.none
	end 'unfollowed'
	return match consumes rangePlaceOf(r, p: p, ms: ms, e: receiver) 'collection'
		some(q) gives table.Option.some(placeCount(q))
		none gives table.Option.none
	end 'collection'
end 'rangeMeasuredPlace'

function selfPlace(r Ranges, p ast.Project, ms ast.ModuleState) returns Place
	return Place.local(slotOf(r, local: ast.receiverLocal(p, ms: ms, f: r.fn)))
end 'selfPlace'

function memberInfoOf(r Ranges, e ast.NodeID) returns borrowed ast.MemberInfo
	return r.typing.members.expect(e as Count, what: "member")
end 'memberInfoOf'

function nodeLocalOf(r Ranges, node ast.NodeID) returns table.Option with ast.LocalID
	return r.typing.nodeLocals.get(node as Count)
end 'nodeLocalOf'

// rangeSpanAt is what is known of an integer place in the state s.
function rangeSpanAt(r Ranges, p ast.Project, ms ast.ModuleState, s Count, place Place, t ast.TypeID) returns Span
	if isDead(r, s: s) 'dead'
		return typeSpan(ms.types, reads: p.types, t: t)
	end 'dead'
	return match consumes r.states.list[s].at(place) 'known'
		some(v) gives v
		none gives typeSpan(ms.types, reads: p.types, t: t)
	end 'known'
end 'rangeSpanAt'

function rangeStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let k = ms.tree().kindOf(s)
	if k == ast.NodeKind.letStmt 'let'
		rangeLetStmt(r, p: p, ms: ms, s: s)
		return
	end 'let'
	if k == ast.NodeKind.assignStmt 'assign'
		rangeAssignStmt(r, p: p, ms: ms, s: s)
		return
	end 'assign'
	if k == ast.NodeKind.destructStmt or k == ast.NodeKind.tupleAssignStmt 'expansion'
		let steps = ast.expansionOf(r.typing, node: s).clone()
		for i in 0 upto steps.count() 'steps'
			rangeStmt(r, p: p, ms: ms, s: steps[i])
		end 'steps'
		return
	end 'expansion'
	if k == ast.NodeKind.discardStmt 'discard'
		_ = rangeEval(r, p: p, ms: ms, e: ast.discardStmtValue(ms.tree(), id: s))
		return
	end 'discard'
	if k == ast.NodeKind.exprStmt 'expr'
		rangeExprStmt(r, p: p, ms: ms, s: s)
		return
	end 'expr'
	if k == ast.NodeKind.ifStmt 'if'
		rangeIfStmt(r, p: p, ms: ms, s: s)
		return
	end 'if'
	if k == ast.NodeKind.ifTryStmt 'ifTry'
		rangeIfTryStmt(r, p: p, ms: ms, s: s)
		return
	end 'ifTry'
	if k == ast.NodeKind.whileStmt 'while'
		rangeWhileStmt(r, p: p, ms: ms, s: s)
		return
	end 'while'
	if k == ast.NodeKind.forStmt 'for'
		rangeForStmt(r, p: p, ms: ms, s: s)
		return
	end 'for'
	if k == ast.NodeKind.matchStmt 'match'
		_ = rangeMatch(r, p: p, ms: ms, core: ast.matchStmtMatch(ms.tree(), id: s))
		return
	end 'match'
	if k == ast.NodeKind.whenStmt 'when'
		rangeWhenStmt(r, p: p, ms: ms, s: s)
		return
	end 'when'
	if k == ast.NodeKind.tryStmt 'try'
		rangeTryStmt(r, p: p, ms: ms, s: s)
		return
	end 'try'
	if k == ast.NodeKind.throwStmt 'throw'
		rangeThrowStmt(r, p: p, ms: ms, s: s)
		return
	end 'throw'
	if k == ast.NodeKind.returnStmt 'return'
		rangeReturnStmt(r, p: p, ms: ms, s: s)
		return
	end 'return'
	if k == ast.NodeKind.breakStmt 'break'
		rangeBreakStmt(r, s: s)
		return
	end 'break'
	if k == ast.NodeKind.continueStmt 'continue'
		r.st = deadState
		return
	end 'continue'
	panic("ranges: the node {s} of kind {k.name} is no statement")
end 'rangeStmt'

function rangeLetStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let local = match consumes nodeLocalOf(r, node: s) 'local'
		some(id) gives id
		none panic("ranges: the let at node {s} declares no local")
	end 'local'
	let ty = r.typing.locals[local as Count].ty
	let init = ast.letStmtInit(ms.tree(), id: s)
	let place = Place.local(slotOf(r, local: local))
	if init != 0 'init'
		let v = rangeEval(r, p: p, ms: ms, e: init)
		rangeAssignTo(r, p: p, ms: ms, place: place, value: init, v: v, t: ty)
		return
	end 'init'
	var v = Span.make(ast.I128.zero(), hi: ast.I128.zero())
	if ast.isIntType(ms.types, reads: p.types, t: ty) 'declared'
		v = typeSpan(ms.types, reads: p.types, t: ty)
	end 'declared'
	rangeWrite(r, p: p, ms: ms, place: place, s: v, t: ty)
end 'rangeLetStmt'

function rangeAssignStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	match consumes rangeAccumulation(r, p: p, ms: ms, s: s) 'accumulation'
		some(a) then rangeAccumulate(r, p: p, ms: ms, s: s, a: a)
		none then rangeAssign(r, p: p, ms: ms, s: s)
	end 'accumulation'
end 'rangeAssignStmt'

function rangeAssign(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let target = ast.assignStmtTarget(ms.tree(), id: s)
	let value = ast.assignStmtValue(ms.tree(), id: s)
	match consumes rangePlaceOf(r, p: p, ms: ms, e: target) 'place'
		some(place) then rangeAssignPlace(r, p: p, ms: ms, place: place, target: target, value: value)
		none then rangeAssignOther(r, p: p, ms: ms, target: target, value: value)
	end 'place'
end 'rangeAssign'

function rangeAssignPlace(mutates r Ranges, p ast.Project, ms ast.ModuleState, place Place, target ast.NodeID, value ast.NodeID)
	let v = rangeEval(r, p: p, ms: ms, e: value)
	rangeAssignTo(r, p: p, ms: ms, place: place, value: value, v: v, t: typeOf(r, e: target))
end 'rangeAssignPlace'

// rangeAssignTo gives a place of the type t the value of the expression value, which has the span v. Where the value is a
// place moved by a constant and the sum is exact, the place is that much above it afterwards: 'n = xs.count()' leaves n equal
// to the count, and 'i = i + 1' moves what was known of i by one instead of forgetting it. A bits(64) pattern is not followed
// this way, since its sums wrap.
function rangeAssignTo(mutates r Ranges, p ast.Project, ms ast.ModuleState, place Place, value ast.NodeID, v Span, t ast.TypeID)
	if not ast.isIntType(ms.types, reads: p.types, t: t) or ast.isWordPattern(ms.types, reads: p.types, t: t) 'other'
		rangeWrite(r, p: p, ms: ms, place: place, s: v, t: t)
		return
	end 'other'
	match consumes rangeOffsetOf(r, p: p, ms: ms, e: value) 'offset'
		some(o) then rangeAssignOffset(r, p: p, ms: ms, place: place, o: o, v: v, t: t)
		none then rangeWrite(r, p: p, ms: ms, place: place, s: v, t: t)
	end 'offset'
end 'rangeAssignTo'

function rangeAssignOffset(mutates r Ranges, p ast.Project, ms ast.ModuleState, place Place, o Offset, v Span, t ast.TypeID)
	if not o.exact 'wraps'
		rangeWrite(r, p: p, ms: ms, place: place, s: v, t: t)
		return
	end 'wraps'
	if o.at.same(place) 'moved'
		if not rangeTouch(r, place: place) 'dead'
			return
		end 'dead'
		let st = r.st
		r.states.list[st].shiftPlace(place, by: o.by)
		r.states.list[st].refine(place, v: v.clamp(typeSpan(ms.types, reads: p.types, t: t)))
		return
	end 'moved'
	rangeWrite(r, p: p, ms: ms, place: place, s: v, t: t)
	if not isDead(r, s: r.st) and not o.at.overlaps(place) 'related'
		let st = r.st
		r.states.list[st].equate(place, w: o.at, by: o.by)
	end 'related'
end 'rangeAssignOffset'

function rangeAssignOther(mutates r Ranges, p ast.Project, ms ast.ModuleState, target ast.NodeID, value ast.NodeID)
	_ = rangeEval(r, p: p, ms: ms, e: target)
	_ = rangeEval(r, p: p, ms: ms, e: value)
end 'rangeAssignOther'

function rangeExprStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let e = ast.exprStmtE(ms.tree(), id: s)
	_ = rangeEval(r, p: p, ms: ms, e: e)
	if ms.tree().kindOf(e) == ast.NodeKind.panicExpr 'panics'
		r.st = deadState
	end 'panics'
end 'rangeExprStmt'

function rangeIfStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let cond = ast.ifStmtCond(ms.tree(), id: s)
	let since = rangeCondition(r, p: p, ms: ms, c: cond)
	let start = rangeKeep(r)
	let whenTrue = rangeNarrowed(r, p: p, ms: ms, from: start, c: cond, truth: true, since: since)
	r.st = whenTrue
	rangeBlock(r, p: p, ms: ms, body: ast.ifStmtThenRef(ms.tree(), id: s))
	let thenEnd = r.st
	let whenFalse = rangeNarrowed(r, p: p, ms: ms, from: start, c: cond, truth: false, since: since)
	r.st = whenFalse
	if ast.ifStmtHasElse(ms.tree(), id: s) 'else'
		rangeBlock(r, p: p, ms: ms, body: ast.ifStmtElseRef(ms.tree(), id: s))
	end 'else'
	let els = r.st
	r.st = r.states.joined(thenEnd, b: els)
end 'rangeIfStmt'

// rangeIfTryStmt covers the failures of the call of a conditional try: the else block starts from the state where the
// call failed, and the block that runs on success from the one after it, with the result bound.
function rangeIfTryStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let call = ast.ifTryStmtCall(ms.tree(), id: s)
	let takes = match consumes nodeLocalOf(r, node: call) 'local'
		some(id) gives r.typing.locals[id as Count].ty
		none gives ast.noType
	end 'local'
	let entered = rangeEnterTry(r, p: p, ms: ms, site: s, handles: true, takes: takes)
	let v = rangeEval(r, p: p, ms: ms, e: call)
	rangeCheckTry(r, p: p, ms: ms, entered: entered)
	if not entered.added 'passed'
		return
	end 'passed'
	let h = rangeLeaveTry(r)
	_ = rangeKeep(r)
	if ast.ifTryStmtName(ms.tree(), id: s) != "" 'bind'
		let local = match consumes nodeLocalOf(r, node: s) 'bound'
			some(id) gives id
			none panic("ranges: the conditional try at node {s} declares no local")
		end 'bound'
		let ty = r.typing.locals[local as Count].ty
		rangeWrite(r, p: p, ms: ms, place: Place.local(slotOf(r, local: local)), s: v, t: ty)
	end 'bind'
	rangeBlock(r, p: p, ms: ms, body: ast.ifTryStmtThenRef(ms.tree(), id: s))
	let succeeded = r.st
	r.st = h.entry
	if ast.ifTryStmtHasElse(ms.tree(), id: s) 'else'
		rangeBlock(r, p: p, ms: ms, body: ast.ifTryStmtElseRef(ms.tree(), id: s))
	end 'else'
	let failed = r.st
	r.st = r.states.joined(succeeded, b: failed)
end 'rangeIfTryStmt'

function rangeWhileStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	rangeLoopTop(r, p: p, ms: ms, s: s)
	let cond = ast.whileStmtCond(ms.tree(), id: s)
	let since = rangeCondition(r, p: p, ms: ms, c: cond)
	let top = rangeKeep(r)
	r.frames.push(RangeFrame.make(s))
	let times = rangeScaleTimes(r, trips: pastEveryWord())
	let whenTrue = rangeNarrowed(r, p: p, ms: ms, from: top, c: cond, truth: true, since: since)
	r.st = whenTrue
	rangeBlock(r, p: p, ms: ms, body: ast.whileStmtBodyRef(ms.tree(), id: s))
	rangeRestoreTimes(r, outer: times)
	let breaks = rangePopFrame(r)
	var exit = rangeNarrowed(r, p: p, ms: ms, from: top, c: cond, truth: false, since: since)
	if isTrue(ms.tree(), e: cond) 'forever'
		exit = deadState
	end 'forever'
	r.st = r.states.joined(exit, b: breaks)
end 'rangeWhileStmt'

// rangePopFrame ends the walk of the innermost loop or match, and gives the state its breaks leave it in.
function rangePopFrame(mutates r Ranges) returns Count
	let frame = try r.frames.pop() otherwise panic("ranges: a loop or a match ended that was never begun")
	return frame.breaks
end 'rangePopFrame'

function rangeForStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	if not ast.forStmtIsRange(ms.tree(), id: s) or ast.forStmtIsCharacterRange(ms.tree(), id: s) 'forEach'
		rangeForEach(r, p: p, ms: ms, s: s)
		return
	end 'forEach'
	let from = rangeEval(r, p: p, ms: ms, e: ast.forStmtFrom(ms.tree(), id: s))
	let upper = rangeEval(r, p: p, ms: ms, e: ast.forStmtTo(ms.tree(), id: s))
	let trips = tripBound(from, upper: upper, inclusive: ast.forStmtInclusive(ms.tree(), id: s))
	let times = rangeScaleTimes(r, trips: trips)
	let bounded = r.bounds.count()
	rangeLoopHead(r, p: p, ms: ms, s: s, from: from, upper: upper, trips: trips)
	let top = rangeKeep(r)
	r.frames.push(RangeFrame.make(s))
	let body = rangeLoopBody(r, p: p, ms: ms, s: s, top: top, from: from, upper: upper)
	r.st = body
	rangeBlock(r, p: p, ms: ms, body: ast.forStmtBodyRef(ms.tree(), id: s))
	let breaks = rangePopFrame(r)
	r.st = r.states.joined(top, b: breaks)
	while r.bounds.count() > bounded 'unbind'
		try r.bounds.pop() otherwise panic("ranges: the bounds are fewer than their mark")
	end 'unbind'
	rangeRestoreTimes(r, outer: times)
end 'rangeForStmt'

// rangeForEach walks a for over a collection as a while whose condition says nothing: it runs any number of times, and
// its variable is any value of its type.
function rangeForEach(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	_ = rangeEval(r, p: p, ms: ms, e: ast.forStmtFrom(ms.tree(), id: s))
	// A walk of a drain leaves the array at count 0 however it ends, a failure out of the body included, and the body cannot
	// name the array, so it shrinks from the start.
	if walksDrain(r, s: s) 'drained'
		rangeReceiverChanged(r, p: p, ms: ms, e: ast.forStmtFrom(ms.tree(), id: s), effect: ast.CountEffect.countShrink)
	end 'drained'
	rangeLoopTop(r, p: p, ms: ms, s: s)
	let top = rangeKeep(r)
	r.frames.push(RangeFrame.make(s))
	let times = rangeScaleTimes(r, trips: pastEveryWord())
	r.st = top
	rangeBlock(r, p: p, ms: ms, body: ast.forStmtBodyRef(ms.tree(), id: s))
	rangeRestoreTimes(r, outer: times)
	let breaks = rangePopFrame(r)
	r.st = r.states.joined(top, b: breaks)
end 'rangeForEach'

// walksDrain is whether the for loop s walks a drain, which leaves the array it drains at count 0.
function walksDrain(r Ranges, s ast.NodeID) returns bool
	return r.typing.drains.has(s as Count)
end 'walksDrain'

// rangeLoopBody is the state in the body of a for loop, whose variable lies between the bounds: the state at the top of
// the loop when the variable has no span to know.
function rangeLoopBody(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID, top Count, from Span, upper Span) returns Count
	let local = match consumes nodeLocalOf(r, node: s) 'local'
		some(id) gives id
		none gives ast.noLocal
	end 'local'
	if local == ast.noLocal or isDead(r, s: top) 'unknown'
		return top
	end 'unknown'
	let ty = r.typing.locals[local as Count].ty
	if not ast.isIntType(ms.types, reads: p.types, t: ty) 'notInt'
		return top
	end 'notInt'
	var hi = upper.hi.clone()
	if not ast.forStmtInclusive(ms.tree(), id: s) 'exclusive'
		hi = hi.sub(ast.I128.one())
	end 'exclusive'
	let body = r.states.copyOf(top)
	let v = Span.make(from.lo.clone(), hi: hi).clamp(typeSpan(ms.types, reads: p.types, t: ty))
	if v.isEmpty() 'never'
		r.states.list[body].dead = true
	end 'never' else 'runs'
		let counter = Place.local(slotOf(r, local: local))
		r.states.list[body].refine(counter, v: v)
		match consumes rangeOffsetOf(r, p: p, ms: ms, e: ast.forStmtTo(ms.tree(), id: s)) 'bound'
			some(bound) then rangeRelateBound(r, p: p, ms: ms, s: s, body: body, bound: bound, counter: counter)
			none then _ = 0
		end 'bound'
		match consumes rangeOffsetOf(r, p: p, ms: ms, e: ast.forStmtFrom(ms.tree(), id: s)) 'start'
			some(start) then rangeRelateStart(r, p: p, ms: ms, s: s, body: body, start: start, counter: counter)
			none then _ = 0
		end 'start'
	end 'runs'
	return body
end 'rangeLoopBody'

// rangeRelateBound records that the counter of the for loop s is below its bound, a place moved by a constant: 'bound >
// counter', or 'bound >= counter' for a loop that reaches its bound, where the body only raises the place or leaves it. The
// loop evaluated the bound once, and the counter stays below that value, which the place never falls under.
function rangeRelateBound(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID, body Count, bound Offset, counter Place)
	if not risesOnly(rangeLoopMoves(r, p: p, ms: ms, s: s, q: bound.at)) 'falls'
		return
	end 'falls'
	match consumes boundGap(bound.by, exact: bound.exact, inclusive: ast.forStmtInclusive(ms.tree(), id: s)) 'gap'
		some(gap) then r.states.list[body].relate(bound.at, lo: counter, gap: gap)
		none then _ = 0
	end 'gap'
end 'rangeRelateBound'

// rangeRelateStart records that the counter of the for loop s is at least where it started, a place moved by a constant,
// where the body only lowers the place or leaves it: the counter only rises from the value the loop evaluated once.
function rangeRelateStart(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID, body Count, start Offset, counter Place)
	if not fallsOnly(rangeLoopMoves(r, p: p, ms: ms, s: s, q: start.at)) 'rises'
		return
	end 'rises'
	match consumes startGap(start.by, exact: start.exact) 'gap'
		some(gap) then r.states.list[body].relate(counter, lo: start.at, gap: gap)
		none then _ = 0
	end 'gap'
end 'rangeRelateStart'

// rangeWhenStmt analyses the body of a behaviour as a function of its own: it runs later, so neither what is known here
// nor a try around it reaches into it. A behaviour whose body the bodies check gave no function has nothing to follow.
function rangeWhenStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	if r.probing 'probed'
		r.probe.opaque = true
		return
	end 'probed'
	match consumes r.typing.whens.get(s as Count) 'when'
		some(info) then rangeFunction(r, p: p, ms: ms, fid: info.fn, behaviour: true)
		none then _ = 0
	end 'when'
end 'rangeWhenStmt'

// rangeEnterTry starts a try. One with a handler catches what it covers, and takes only the error takes if that is not
// none; one without passes it to the try around it, and with none around it to the caller, which only a function that
// throws has.
function rangeEnterTry(mutates r Ranges, p ast.Project, ms ast.ModuleState, site ast.NodeID, handles bool, takes ast.TypeID) returns RangeTry
	var added = false
	if handles or r.handlers.count() == 0 'own'
		if not handles 'toCaller'
			rangeRequirePropagates(r, p: p, ms: ms, site: site)
		end 'toCaller'
		if handles or not r.failed 'allowed'
			r.handlers.push(RangeHandler.make(not handles, takes: takes, site: site))
			added = true
		end 'allowed'
	end 'own'
	var failures = 0 as Count
	var proofs = 0 as Count
	if r.handlers.count() > 0 'counted'
		let top = try r.handlers.count() - 1 otherwise panic("ranges: no handler")
		failures = r.handlers[top].failures
		proofs = r.handlers[top].proofs
	end 'counted'
	return RangeTry.make(site, added: added, reached: not isDead(r, s: r.st), failures: failures, proofs: proofs)
end 'rangeEnterTry'

// rangeCheckTry says whether the try that is ending covers anything that can fail, which one function decides for every form
// of try, whether it added a handler or passes its failures on: an operation the analysis leaves fallible, a call of a
// function that throws, an access it cannot prove. A try that covers none handles a failure that cannot happen, which is an
// error: the code would say a failure is possible where it is not. It does not end the walk, and it is reported only where
// nothing else is wrong. Code the analysis proves unreachable has nothing judged, so it is left alone.
function rangeCheckTry(mutates r Ranges, p ast.Project, ms ast.ModuleState, entered RangeTry)
	if r.failed or r.probing or not entered.reached 'unjudged'
		return
	end 'unjudged'
	let covering = try r.handlers.count() - 1 otherwise panic("ranges: a try ended outside every handler")
	if r.handlers[covering].failures != entered.failures 'fallible'
		return
	end 'fallible'
	var access = 0 as ast.NodeID
	if r.handlers[covering].proofs != entered.proofs 'proven'
		access = r.handlers[covering].proven
	end 'proven'
	checkFailFixed(r.modID, off: ms.tree().startOf(entered.site), code: diag.errNeedlessTry, msg: needlessTryText(ms.tree(), site: entered.site, access: access), fix: untryFix(ms.tree(), site: entered.site), errs: r.needless)
end 'rangeCheckTry'

// rangeLeaveTry ends a try that rangeEnterTry added a handler for, and gives the handler.
function rangeLeaveTry(mutates r Ranges) returns RangeHandler
	return try r.handlers.pop() otherwise panic("ranges: a try ended that was never begun")
end 'rangeLeaveTry'

// fnErrorType is the error the function being walked throws, or none.
function fnErrorType(r Ranges, p ast.Project, ms ast.ModuleState) returns ast.TypeID
	if r.fn == ast.noFunc 'outside'
		return ast.noType
	end 'outside'
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: r.fn).errTy
end 'fnErrorType'

// rangeRequirePropagates refuses a try with no handler where there is no caller that takes its failure.
function rangeRequirePropagates(mutates r Ranges, p ast.Project, ms ast.ModuleState, site ast.NodeID)
	if r.probing 'probed'
		return
	end 'probed'
	if r.fn == ast.noFunc 'value'
		rangeRaise(r, p: p, ms: ms, node: site, code: diag.errErrorTypeMismatch, msg: "a 'try' without 'otherwise' passes a failure to the caller, and a constant or a default has none: give 'otherwise' the value to use")
		return
	end 'value'
	if r.behaviour 'behaviour'
		rangeRaise(r, p: p, ms: ms, node: site, code: diag.errErrorTypeMismatch, msg: "a 'try' without 'otherwise' passes a failure to the caller, and nothing waits for a behaviour: give 'otherwise' what to do")
		return
	end 'behaviour'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: r.fn).errTy == ast.noType 'noThrows'
		let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: r.fn).name.clone()
		rangeRaise(r, p: p, ms: ms, node: site, code: diag.errErrorTypeMismatch, msg: "a 'try' without 'otherwise' passes a failure to the caller, but '{name}' does not throw: give 'otherwise' what to do, or declare '{name}' 'throws' the error")
	end 'noThrows'
end 'rangeRequirePropagates'

function rangeTryStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let takes = match consumes nodeLocalOf(r, node: s) 'local'
		some(id) gives r.typing.locals[id as Count].ty
		none gives ast.noType
	end 'local'
	let handles = ast.tryStmtHasOtherwise(ms.tree(), id: s)
	let entered = rangeEnterTry(r, p: p, ms: ms, site: s, handles: handles, takes: takes)
	rangeBlock(r, p: p, ms: ms, body: ast.tryStmtBodyRef(ms.tree(), id: s))
	rangeCheckTry(r, p: p, ms: ms, entered: entered)
	if not entered.added 'passed'
		return
	end 'passed'
	let h = rangeLeaveTry(r)
	if not handles 'noHandler'
		return
	end 'noHandler'
	let ended = rangeKeep(r)
	r.st = h.entry
	rangeBlock(r, p: p, ms: ms, body: ast.tryStmtHandlerRef(ms.tree(), id: s))
	let handled = r.st
	r.st = r.states.joined(ended, b: handled)
end 'rangeTryStmt'

// rangeThrowStmt is a failure that always happens: a throw needs no 'try', and passes its error to the caller when no try
// around it catches it.
function rangeThrowStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let value = ast.throwStmtValue(ms.tree(), id: s)
	_ = rangeEval(r, p: p, ms: ms, e: value)
	let e = typeOf(r, e: value)
	if r.handlers.count() == 0 'toCaller'
		let thrown = fnErrorType(r, p: p, ms: ms)
		if r.probing 'probed'
			_ = 0
		end 'probed' else if r.behaviour 'behaviour'
			rangeRaise(r, p: p, ms: ms, node: s, code: diag.errErrorTypeMismatch, msg: "a throw passes its error to the caller, and nothing waits for a behaviour: handle the failure in the behaviour")
		end 'behaviour' else if thrown == ast.noType 'noThrows'
			rangeRaise(r, p: p, ms: ms, node: s, code: diag.errErrorTypeMismatch, msg: diag.throwNoThrows(nameOfType(p, ms: ms, t: e)))
		end 'noThrows' else if thrown != e 'other'
			rangeRaise(r, p: p, ms: ms, node: s, code: diag.errErrorTypeMismatch, msg: diag.throwMismatch(nameOfType(p, ms: ms, t: e), enclosing: nameOfType(p, ms: ms, t: thrown)))
		end 'other'
		r.st = deadState
		return
	end 'toCaller'
	rangeFallible(r, p: p, ms: ms, site: s, err: e, why: Unchecked.thrown)
	r.st = deadState
end 'rangeThrowStmt'

function rangeReturnStmt(mutates r Ranges, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	let value = ast.returnStmtValue(ms.tree(), id: s)
	if value != 0 'value'
		let v = rangeEval(r, p: p, ms: ms, e: value)
		if r.typing.arith.has(s as Count) 'converts'
			let ret = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: r.fn).retTy
			_ = rangeConverted(r, p: p, ms: ms, e: s, v: v, src: typeOf(r, e: value), ty: ret, why: Unchecked.returned(ret, value: value))
		end 'converts'
	end 'value'
	r.st = deadState
end 'rangeReturnStmt'

function rangeBreakStmt(mutates r Ranges, s ast.NodeID)
	let target = r.typing.jumps.expect(s as Count, what: "jump target")
	var i = r.frames.count()
	while i > 0 'frames'
		i = i - 1
		if r.frames[i].node == target 'found'
			let kept = rangeKeep(r)
			let breaks = r.frames[i].breaks
			let joined = r.states.joined(breaks, b: kept)
			r.frames[i].breaks = joined
			break 'frames'
		end 'found'
	end 'frames'
	r.st = deadState
end 'rangeBreakStmt'

// rangeMatch walks each arm from the state after the subject, narrowed by the arm's patterns when the subject is an
// integer place, and gives the span of the values the arms give.
function rangeMatch(mutates r Ranges, p ast.Project, ms ast.ModuleState, core ast.NodeID) returns Span
	let subject = ast.matchCoreSubject(ms.tree(), id: core)
	_ = rangeEval(r, p: p, ms: ms, e: subject)
	let start = rangeKeep(r)
	let subjectTy = typeOf(r, e: subject)
	var subjectPlace as table.Option with Place
	if ast.isIntType(ms.types, reads: p.types, t: subjectTy) 'int'
		subjectPlace = rangePlaceOf(r, p: p, ms: ms, e: subject)
	end 'int' else 'other'
		subjectPlace = table.Option.none
	end 'other'
	r.frames.push(RangeFrame.make(core))
	var ended = deadState
	var given = Span.make(ast.I128.zero(), hi: ast.I128.zero())
	var anyGives = false
	var fell = deadState
	let armsRef = ast.matchCoreArmsRef(ms.tree(), id: core)
	for i in 0 upto ms.tree().listLen(armsRef) 'arms'
		let arm = ms.tree().listAt(armsRef, index: i) as ast.NodeID
		var from = start
		if not ast.matchArmIsDefault(ms.tree(), id: arm) 'patterns'
			match subjectPlace 'place'
				some(place) then from = rangeArmState(r, p: p, ms: ms, start: start, subject: place, t: subjectTy, arm: arm)
				none then _ = 0
			end 'place'
		end 'patterns'
		from = r.states.joined(from, b: fell)
		r.st = from
		let form = ast.matchArmForm(ms.tree(), id: arm)
		let value = ast.matchArmValue(ms.tree(), id: arm)
		if form == ast.ArmKind.armThen 'then'
			rangeStmt(r, p: p, ms: ms, s: ast.matchArmAction(ms.tree(), id: arm))
		end 'then' else if form == ast.ArmKind.armGives 'gives'
			let v = rangeEval(r, p: p, ms: ms, e: value)
			if not isDead(r, s: r.st) and ast.isIntType(ms.types, reads: p.types, t: typeOf(r, e: value)) 'int'
				if anyGives 'more'
					given = given.unionWith(v)
				end 'more' else 'first'
					given = v
					anyGives = true
				end 'first'
			end 'int'
		end 'gives' else 'panics'
			_ = rangeEval(r, p: p, ms: ms, e: value)
			r.st = deadState
		end 'panics'
		let kept = rangeKeep(r)
		fell = deadState
		if ast.matchArmFalls(ms.tree(), id: arm) 'falls'
			fell = kept
		end 'falls' else 'leaves'
			ended = r.states.joined(ended, b: kept)
		end 'leaves'
	end 'arms'
	ended = r.states.joined(ended, b: fell)
	let breaks = rangePopFrame(r)
	r.st = r.states.joined(ended, b: breaks)
	return given
end 'rangeMatch'

// rangeArmState is the state in an arm of a match on an integer place: the place holds one of the values the patterns
// name.
function rangeArmState(mutates r Ranges, p ast.Project, ms ast.ModuleState, start Count, subject Place, t ast.TypeID, arm ast.NodeID) returns Count
	if isDead(r, s: start) 'dead'
		return start
	end 'dead'
	var values = Span.make(ast.I128.zero(), hi: ast.I128.zero())
	let patternsRef = ast.matchArmPatternsRef(ms.tree(), id: arm)
	for i in 0 upto ms.tree().listLen(patternsRef) 'patterns'
		let pat = ms.tree().listAt(patternsRef, index: i) as ast.NodeID
		let form = ast.patternForm(ms.tree(), id: pat)
		var s = Span.make(ast.I128.zero(), hi: ast.I128.zero())
		if form == ast.PatternKind.patLiteral 'literal'
			s = typeSpan(ms.types, reads: p.types, t: typeOf(r, e: ast.patternValue(ms.tree(), id: pat)))
		end 'literal' else if form == ast.PatternKind.patRange 'range'
			let lo = typeSpan(ms.types, reads: p.types, t: typeOf(r, e: ast.patternValue(ms.tree(), id: pat))).lo.clone()
			var hi = typeSpan(ms.types, reads: p.types, t: typeOf(r, e: ast.patternHigh(ms.tree(), id: pat))).hi.clone()
			if not ast.patternInclusive(ms.tree(), id: pat) 'exclusive'
				hi = hi.sub(ast.I128.one())
			end 'exclusive'
			s = Span.make(lo, hi: hi)
		end 'range' else 'case'
			return start
		end 'case'
		if i == 0 'first'
			values = s
		end 'first' else 'more'
			values = values.unionWith(s)
		end 'more'
	end 'patterns'
	let out = r.states.copyOf(start)
	let narrowedTo = rangeSpanAt(r, p: p, ms: ms, s: start, place: subject, t: t).clamp(values)
	if narrowedTo.isEmpty() 'never'
		r.states.list[out].dead = true
	end 'never' else 'matches'
		r.states.list[out].refine(subject, v: narrowedTo)
	end 'matches'
	return out
end 'rangeArmState'
