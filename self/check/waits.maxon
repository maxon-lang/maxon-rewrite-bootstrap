// Wait inference, maxon's: a function may wait when it awaits, sleeps, yields, does file or process I/O, calls through a
// function value or an interface, or calls or starts with `async` a function that may; and it may wait on another party
// when it keeps a reply of a service, starts a service whose factory throws, calls through a function value or an
// interface, or calls or starts a function that may. A function of another module is judged by what the check of its
// module published (ast.Typing.waiting), which the verify of a module reads of the modules it names; one whose module
// published nothing is an unknown, which may wait on another party. E3073 refuses an async call of a function that never
// waits, and E3221 a holder of a service that may wait on another party: an unknown never makes the first refuse a correct
// program, and makes the second refuse what it cannot show sound.

// WaitFact is what the check of a function found: whether it waits itself, whether it waits on another party (a reply
// it keeps, or the start of a service whose factory throws), and the functions of the module it calls.
export type WaitFact
	export var waits as bool
	export var calls as ast.FuncIDList
	export var partyWaits as bool

	export static function make(waits bool, consumes calls ast.FuncIDList) returns WaitFact
		return WaitFact{waits: waits, calls: calls, partyWaits: false}
	end 'make'
end 'WaitFact'

export typealias WaitFacts = table.IntMap with WaitFact

// PendingAsync is an async call that E3073 asks about once every body of the module is checked: the call, and the
// function it starts.
export type PendingAsync
	export var node as ast.NodeID
	export var callee as ast.FuncID

	export static function make(node ast.NodeID, callee ast.FuncID) returns PendingAsync
		return PendingAsync{node: node, callee: callee}
	end 'make'
end 'PendingAsync'

export typealias PendingAsyncList = Array with PendingAsync

// startWaits begins the facts of a function whose body is checked.
function startWaits(mutates c Checker)
	c.waitNow = false
	c.partyWaitNow = false
	c.waitCalls = ast.FuncIDList.create(0)
end 'startWaits'

// finishWaits keeps the facts of the function whose body was checked.
function finishWaits(mutates c Checker)
	if c.rootFn == ast.noFunc 'none'
		return
	end 'none'
	var fact = WaitFact.make(c.waitNow, calls: exchange(c.waitCalls, value: ast.FuncIDList.create(0)))
	fact.partyWaits = c.partyWaitNow
	c.waits.insert(c.rootFn as Count, value: fact)
end 'finishWaits'

// noteCallWaits notes what a call says of whether the function being checked may wait.
function noteCallWaits(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID)
	var slot as Count
	if not c.typing.calls.find(call as Count, slot: slot) 'unrecorded'
		return
	end 'unrecorded'
	let k = c.typing.calls.valueAt(slot).kind
	let callee = c.typing.calls.valueAt(slot).fn
	if k == ast.CallKind.callValue or k == ast.CallKind.callBound 'unknown'
		c.waitNow = true
		c.partyWaitNow = true
		return
	end 'unknown'
	if k != ast.CallKind.callFunction and k != ast.CallKind.callStatic and k != ast.CallKind.callMethod 'noCall'
		return
	end 'noCall'
	noteCallee(c, p: p, ms: ms, callee: callee)
end 'noteCallWaits'

// noteCallee notes a call or an async start of a function: a wait point among the built-ins, or an edge to the function,
// which verifyAsyncs and verifyHolders follow.
function noteCallee(mutates c Checker, p ast.Project, ms ast.ModuleState, callee ast.FuncID)
	let intrinsic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).intrinsic
	if intrinsic != ast.Intrinsic.intrNone 'intrinsic'
		if waitingIntrinsic(intrinsic) 'waits'
			c.waitNow = true
		end 'waits'
		// awaitAny waits for a coroutine or a reply that the check cannot see, so on another party, as maxon has it.
		if intrinsic == ast.Intrinsic.intrArrayAwaitAny 'select'
			c.waitNow = true
			c.partyWaitNow = true
		end 'select'
		return
	end 'intrinsic'
	c.waitCalls.push(callee)
end 'noteCallee'

// waitingIntrinsic is whether a built-in parks the green thread that calls it: sleep and yield, a promise's cancel, which
// waits for its coroutine, and file, directory and process I/O and the wait for a debuggee's event and the waits of the subprocess rows.
function waitingIntrinsic(op ast.Intrinsic) returns bool
	return op == ast.Intrinsic.intrSleep or op == ast.Intrinsic.intrSchedulerYield or op == ast.Intrinsic.intrPromiseCancel or op == ast.Intrinsic.intrFileReadText or op == ast.Intrinsic.intrFileReadBinary or op == ast.Intrinsic.intrFileWriteText or op == ast.Intrinsic.intrFileWriteBinary or op == ast.Intrinsic.intrFileRename or op == ast.Intrinsic.intrFileDelete or op == ast.Intrinsic.intrFileInfo or op == ast.Intrinsic.intrFileExists or op == ast.Intrinsic.intrDirectoryIsDirectory or op == ast.Intrinsic.intrDirectoryCreate or op == ast.Intrinsic.intrDirectoryDelete or op == ast.Intrinsic.intrDirectoryList or op == ast.Intrinsic.intrSubprocessRun or op == ast.Intrinsic.intrSubprocessRunWithDeadline or op == ast.Intrinsic.intrSubprocessRunInDirectory or op == ast.Intrinsic.intrDebuggeeWaitEvent or waitingSubprocessRow(op) or waitingHandleRow(op)
end 'waitingIntrinsic'

// waitingHandleRow is whether a row of an open file waits: an open, a read and a write, which park the green thread on a
// handle that waits on the event queue, and the close, which is a call into the kernel that a file system may hold.
function waitingHandleRow(op ast.Intrinsic) returns bool
	return op == ast.Intrinsic.intrManagedFileOpenRead or op == ast.Intrinsic.intrManagedFileOpenWrite or op == ast.Intrinsic.intrManagedFileOpenWriteExecutable or op == ast.Intrinsic.intrManagedFileOpenCreateNew or op == ast.Intrinsic.intrManagedFileReadAppending or op == ast.Intrinsic.intrManagedFileWrite or op == ast.Intrinsic.intrManagedFileClose
end 'waitingHandleRow'

// waitingSubprocessRow is whether a row of maxon's subprocess surface parks the green thread that calls it: the waits for a child's
// output and for its exit, the read of a streaming child's output and the writes of its input.
function waitingSubprocessRow(op ast.Intrinsic) returns bool
	return op == ast.Intrinsic.intrSubprocessWaitCollect or op == ast.Intrinsic.intrSubprocessWaitExit or op == ast.Intrinsic.intrSubprocessReadAvailable or op == ast.Intrinsic.intrSubprocessWriteStdinAll or op == ast.Intrinsic.intrSubprocessWriteStdinBytes or op == ast.Intrinsic.intrSubprocessAwaitStdinWritable
end 'waitingSubprocessRow'

// verifyAsyncs is E3073 for each async call of the module whose function never waits.
function verifyAsyncs(mutates c Checker, p ast.Project, ms ast.ModuleState, mutates errs diag.ErrorList)
	for i in 0 upto c.pendingAsyncs.count() 'asyncs'
		var visited = BoolIntMap.new()
		if not mayWait(c, p: p, ms: ms, f: c.pendingAsyncs[i].callee, visited: visited) 'never'
			let e = c.pendingAsyncs[i].node
			checkFail(c.modID, off: ms.tree().reportStartOf(e), code: diag.errAsyncNonYielding, msg: diag.asyncNeverYields(exprText(ms.tree(), e: e)), errs: errs)
		end 'never'
	end 'asyncs'
end 'verifyAsyncs'

// mayWait is whether a function may wait, by its facts and those of the functions it calls.
function mayWait(c Checker, p ast.Project, ms ast.ModuleState, f ast.FuncID, mutates visited BoolIntMap) returns bool
	return waitingOf(c, p: p, ms: ms, f: f, visited: visited) != ast.Waiting.waitsNever
end 'mayWait'

// mayWaitOnParty is whether a function may wait on another party, by its facts and those of the functions it calls.
function mayWaitOnParty(c Checker, p ast.Project, ms ast.ModuleState, f ast.FuncID, mutates visited BoolIntMap) returns bool
	return waitingOf(c, p: p, ms: ms, f: f, visited: visited) == ast.Waiting.waitsOnParty
end 'mayWaitOnParty'

// waitingOf is what a function may wait for: what its module published, for a function of another module, and else the
// most of its facts and those of the functions it calls. A function of the module with no facts has no body the check
// saw, and a cycle that reaches no wait waits nowhere.
function waitingOf(c Checker, p ast.Project, ms ast.ModuleState, f ast.FuncID, mutates visited BoolIntMap) returns ast.Waiting
	var fid = f
	let origin = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).genericOrigin
	if origin != ast.noFunc 'instance'
		fid = origin
	end 'instance'
	let module = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).module
	if module != c.modID 'otherModule'
		return publishedWaiting(p, module: module, f: fid)
	end 'otherModule'
	if visited.has(fid as Count) 'seen'
		return ast.Waiting.waitsNever
	end 'seen'
	visited.insert(fid as Count, value: true)
	var slot as Count
	if not c.waits.find(fid as Count, slot: slot) 'unchecked'
		return ast.Waiting.waitsNever
	end 'unchecked'
	let fact = c.waits.valueAt(slot)
	if fact.partyWaits 'party'
		return ast.Waiting.waitsOnParty
	end 'party'
	var most = ast.Waiting.waitsParked if fact.waits else ast.Waiting.waitsNever
	for i in 0 upto fact.calls.count() 'calls'
		let reached = waitingOf(c, p: p, ms: ms, f: fact.calls[i], visited: visited)
		if reached == ast.Waiting.waitsOnParty 'onParty'
			return reached
		end 'onParty'
		if reached == ast.Waiting.waitsParked 'parked'
			most = reached
		end 'parked'
	end 'calls'
	return most
end 'waitingOf'

// publishedWaiting is what the check of the module that declares f published of it: an unknown, which may wait on another
// party, where it published nothing, as the standard library, whose functions with a body are the built-ins'.
function publishedWaiting(p ast.Project, module diag.ModuleID, f ast.FuncID) returns ast.Waiting
	if module == diag.stdlibID 'std'
		return ast.Waiting.waitsOnParty
	end 'std'
	return p.typings[ast.modIndex(module)].waiting.getOr(f as Count, fallback: ast.Waiting.waitsOnParty)
end 'publishedWaiting'

// publishWaits keeps in the module's typing what each of its functions may wait for, which the check of a module that calls
// one reads.
function publishWaits(mutates c Checker, p ast.Project, ms ast.ModuleState, functions ast.FuncIDList)
	for i in 0 upto functions.count() 'functions'
		if c.waits.has(functions[i] as Count) 'checked'
			var visited = BoolIntMap.new()
			let w = waitingOf(c, p: p, ms: ms, f: functions[i], visited: visited)
			c.typing.waiting.insert(functions[i] as Count, value: w)
		end 'checked'
	end 'functions'
end 'publishWaits'

// exprText is the text an expression is written with, for a message that quotes it.
function exprText(tree ast.Tree, e ast.NodeID) returns String
	let start = ast.exprStart(tree, e: e) as Count
	return match consumes ast.exprEnd(tree, e: e) 'end'
		some(past) gives tree.text.sliceBytes(start, endPos: past).clone()
		none gives placeText(tree, e: e)
	end 'end'
end 'exprText'
