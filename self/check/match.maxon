// MatchState is what the arms of a match have shown so far.
type MatchState
	// seen are the cases of the subject that an arm matches.
	export var seen as BoolIntMap
	export var sawTrue as bool
	export var sawFalse as bool
	export var hasDefault as bool
	// refusedOrder is whether an arm after the default arm was reported already: one is enough.
	export var refusedOrder as bool
	// refusedQualified is whether an arm named its case with its type's name, which maxon refuses at the first.
	export var refusedQualified as bool
	// result is the type the arms give, or none while no arm gave one.
	export var result as ast.TypeID
	// at is where the match starts, which is where a disagreement between its arms is reported.
	export var at as diag.U32

	static function make(at diag.U32) returns MatchState
		return MatchState{seen: BoolIntMap.new(), sawTrue: false, sawFalse: false, hasDefault: false, refusedOrder: false, refusedQualified: false, result: ast.noType, at: at}
	end 'make'
end 'MatchState'

function pushScope(mutates c Checker)
	c.scopes.push(LocalScope.new())
end 'pushScope'

function popScope(mutates c Checker)
	try c.scopes.pop() otherwise ignore
end 'popScope'

function pushBlock(mutates c Checker, consumes label String, isLoop bool, node ast.NodeID)
	c.blocks.push(BlockFrame.make(label, isLoop: isLoop, node: node))
end 'pushBlock'

function popBlock(mutates c Checker)
	try c.blocks.pop() otherwise ignore
end 'popBlock'

function lookupScopes(scopes ScopeList, name String) returns ast.LocalID
	var i = scopes.count()
	while i > 0 'scopes'
		i = i - 1
		var slot as Count
		if scopes[i].find(name, slot: slot) 'found'
			return scopes[i].valueAt(slot)
		end 'found'
	end 'scopes'
	return ast.noLocal
end 'lookupScopes'

// lookupLocal is the local that a name stands for where it is written, or none. For a name inside a behaviour that is a
// variable of an enclosing function it is that variable, and nothing is captured: this only asks.
function lookupLocal(c Checker, name String) returns ast.LocalID
	let own = lookupScopes(c.scopes, name: name)
	if own != ast.noLocal 'own'
		return own
	end 'own'
	var i = c.outers.count()
	while i > 0 'outers'
		i = i - 1
		let found = lookupScopes(c.outers[i].scopes, name: name)
		if found != ast.noLocal 'found'
			return found
		end 'found'
		if not c.outers[i].hasBehaviour 'top'
			break 'outers'
		end 'top'
	end 'outers'
	return ast.noLocal
end 'lookupLocal'

// selfRecord is the record that the method being checked belongs to, or none outside a method.
function selfRecord(c Checker, p ast.Project, ms ast.ModuleState) returns ast.TypeID
	if c.fn == ast.noFunc or not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).hasReceiver 'none'
		return ast.noType
	end 'none'
	return nominalRecordOrNone(p, ms: ms, t: c.owner)
end 'selfRecord'

function nominalRecordOrNone(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	if t != ast.noType and ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.record 'record'
		return t
	end 'record'
	return ast.noType
end 'nominalRecordOrNone'

// bindLocal makes a local of the code being checked, visible in the innermost scope, and lists it with the function's.
function bindLocal(mutates c Checker, p ast.Project, ms ast.ModuleState, consumes entry ast.LocalEntry, off diag.U32, mutates errs diag.ErrorList) returns ast.LocalID
	let name = entry.name.clone()
	let rt = selfRecord(c, p: p, ms: ms)
	if rt != ast.noType and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: rt)).findField(name).isSome() 'shadows'
		checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: diag.localShadowsSelfField(name, typeName: ast.typeEntry(ms.types, reads: p.types, t: rt).name), errs: errs)
		return ast.noLocal
	end 'shadows'
	let top = try c.scopes.count() - 1 otherwise panic("a local is declared outside every scope")
	if c.scopes[top].has(name) 'twice'
		checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: "'{name}' is declared twice in this scope", errs: errs)
		return ast.noLocal
	end 'twice'
	let id = c.typing.allocLocal(entry)
	c.scopes[top].insert(name, value: id)
	c.fnLocals.push(id)
	return id
end 'bindLocal'

// declareLocal makes a variable of the code being checked, which the statement definedAt declares, or 0 for a binding of a
// match.
function declareLocal(mutates c Checker, p ast.Project, ms ast.ModuleState, name String, t ast.TypeID, isVar bool, definedAt ast.NodeID, off diag.U32, mutates errs diag.ErrorList) returns ast.LocalID
	var entry = ast.LocalEntry.make(name.clone(), ty: t, isVar: isVar, isParam: false, conv: ast.Convention.convLet, definedAt: definedAt)
	entry.slot = try c.nextSlot as ast.SlotIndex otherwise panic("too many locals in one function")
	let id = bindLocal(c, p: p, ms: ms, entry: entry, off: off, errs: errs)
	if id != ast.noLocal 'declared'
		c.nextSlot = try c.nextSlot + 1 otherwise panic("too many locals in one function")
	end 'declared'
	return id
end 'declareLocal'

// requireNotCown refuses the use of a cown's value outside a behaviour that holds it. use says what is done with it.
function requireNotCown(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, t ast.TypeID, use String, mutates errs diag.ErrorList) returns bool
	if t != ast.noType and ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.builtinCown 'cown'
		checkFail(c.modID, off: off, code: diag.errCownAccess, msg: "{use} needs the value of a {nameOfType(p, ms: ms, t: t)}, which is touched only inside a behaviour that holds the cown: write 'when <name> as x' and use x", errs: errs)
		return false
	end 'cown'
	return true
end 'requireNotCown'

function isFrozenType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return t != ast.noType and ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.builtinFrozen
end 'isFrozenType'

// lendsContents is whether a value of type t, where a let place of type want reads it, lends the contents of the frozen
// values it nests, which are want: a let argument or receiver, and the place a function that returns a borrowed place
// returns, read them where they stand, as the lower does (ir.contentsLent).
function lendsContents(p ast.Project, ms ast.ModuleState, t ast.TypeID, want ast.TypeID) returns bool
	return isFrozenType(p, ms: ms, t: t) and ast.contentType(ms.types, reads: p.types, t: t) == want
end 'lendsContents'

// checkMatch types a match and gives the type of its value, which is void for a statement and never where no arm gives
// one.
function checkMatch(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, core ast.NodeID, isExpr bool, mutates errs diag.ErrorList) returns ast.TypeID
	let subject = ast.matchCoreSubject(ms.tree(), id: core)
	let subjectTy = checkExpr(c, p: p, ms: ms, e: subject, errs: errs)
	if subjectTy == ast.noType 'badSubject'
		return ast.noType
	end 'badSubject'
	markMatchedBinding(c, p: p, ms: ms, subject: subject)
	let st = ast.contentType(ms.types, reads: p.types, t: subjectTy)
	if not checkSubject(c, p: p, ms: ms, core: core, subject: subject, subjectTy: subjectTy, st: st, errs: errs) 'unfit'
		return ast.noType
	end 'unfit'
	let expect = c.expect
	var state = MatchState.make(offsetOf(c, p: p, ms: ms, node: core))
	pushBlock(c, label: ast.matchCoreLabel(ms.tree(), id: core).clone(), isLoop: false, node: core)
	let armsRef = ast.matchCoreArmsRef(ms.tree(), id: core)
	let owned = ast.matchCoreConsumes(ms.tree(), id: core)
	for i in 0 upto ms.tree().listLen(armsRef) 'arms'
		let arm = ms.tree().listAt(armsRef, index: i) as ast.NodeID
		checkArmScoped(c, p: p, ms: ms, arm: arm, st: st, owned: owned, isExpr: isExpr, expect: expect, state: state, errs: errs)
		checkFallthrough(c, p: p, ms: ms, armsRef: armsRef, index: i, st: st, errs: errs)
	end 'arms'
	popBlock(c)
	let mark = errs.count()
	checkExhaustive(c, p: p, ms: ms, core: core, st: st, isExpr: isExpr, state: state, errs: errs)
	if failedSince(errs, mark: mark) 'inexhaustive'
		return ast.noType
	end 'inexhaustive'
	if not isExpr 'statement'
		return p.builtins.voidTy
	end 'statement'
	if state.result == ast.noType 'noArm'
		return p.builtins.neverTy
	end 'noArm'
	return state.result
end 'checkMatch'

// checkFallthrough refuses an arm that falls through after a 'return', and one that falls into an arm that binds a payload: the
// arm it falls into is reached from a case it does not name, so its bindings would take apart a case the value does not hold.
function checkFallthrough(mutates c Checker, p ast.Project, ms ast.ModuleState, armsRef diag.U32, index Count, st ast.TypeID, mutates errs diag.ErrorList)
	let arm = ms.tree().listAt(armsRef, index: index) as ast.NodeID
	if not ast.matchArmFalls(ms.tree(), id: arm) 'stays'
		return
	end 'stays'
	let action = ast.matchArmAction(ms.tree(), id: arm)
	if action != 0 and ms.tree().kindOf(action) == ast.NodeKind.returnStmt 'returns'
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: action), code: diag.errMatchFallthroughWithReturn, msg: diag.fallthroughWithReturn(), errs: errs)
		return
	end 'returns'
	let next = try index + 1 otherwise index
	if next >= ms.tree().listLen(armsRef) 'last'
		return
	end 'last'
	let target = ms.tree().listAt(armsRef, index: next) as ast.NodeID
	let patternsRef = ast.matchArmPatternsRef(ms.tree(), id: target)
	for i in 0 upto ms.tree().listLen(patternsRef) 'patterns'
		let pattern = ms.tree().listAt(patternsRef, index: i) as ast.NodeID
		if patternBindsNames(ms.tree(), pattern: pattern) 'binds'
			let word = unionWordOf(p, ms: ms, t: st)
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: pattern), code: diag.errUnsupportedFeature, msg: "Unsupported: `and fallthrough` into the payload-binding arm '{ast.patternCaseName(ms.tree(), id: pattern)}' of `{word} {nameOfType(p, ms: ms, t: st)}` — the preceding arm matched a DIFFERENT case, so on that edge these bindings would destructure a case the value does not hold (reading another case's slots, or a slot that arm already moved out and nulled). Fall through into a payload-free arm, or give this arm its own body", errs: errs)
			return
		end 'binds'
	end 'patterns'
end 'checkFallthrough'

// patternBindsNames is whether a pattern names a payload that it binds, which `_` does not.
function patternBindsNames(tree ast.Tree, pattern ast.NodeID) returns bool
	let bindings = ast.patternBindingsRef(tree, id: pattern)
	for i in 0 upto tree.listLen(bindings) 'each'
		if tree.nameAt(tree.listAt(bindings, index: i)) != "_" 'named'
			return true
		end 'named'
	end 'each'
	return false
end 'patternBindsNames'

function unionWordOf(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	if kindOfType(p, ms: ms, t: t) == ast.TypeKind.enumTy 'enum'
		return enumWord
	end 'enum'
	return unionWord
end 'unionWordOf'

// checkSubject refuses a subject that cannot be matched on.
function checkSubject(mutates c Checker, p ast.Project, ms ast.ModuleState, core ast.NodeID, subject ast.NodeID, subjectTy ast.TypeID, st ast.TypeID, mutates errs diag.ErrorList) returns bool
	let off = offsetOf(c, p: p, ms: ms, node: subject)
	if ast.matchCoreConsumes(ms.tree(), id: core) and isFrozenType(p, ms: ms, t: subjectTy) 'frozen'
		checkFail(c.modID, off: off, code: diag.errMoveOutOfField, msg: "the contents of a frozen value are shared with its other owners, so 'match consumes' cannot take them apart; match without 'consumes', or use 'thaw(...)' for an owned copy", errs: errs)
		return false
	end 'frozen'
	if not requireNotCown(c, p: p, ms: ms, off: off, t: st, use: "matching on it", errs: errs) 'cown'
		return false
	end 'cown'
	if not requireSigned64(c, off: off, t: st, p: p, ms: ms, errs: errs) 'wide'
		return false
	end 'wide'
	let k = kindOfType(p, ms: ms, t: st)
	if ast.isIntType(ms.types, reads: p.types, t: st) or st == p.builtins.stringTy or st == p.builtins.characterTy or st == p.builtins.boolTy or k == ast.TypeKind.enumTy or k == ast.TypeKind.unionTy 'matchable'
		return true
	end 'matchable'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "cannot match on a value of {nameOfType(p, ms: ms, t: st)}", errs: errs)
	return false
end 'checkSubject'

function hasCases(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.enumTy) or typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.unionTy)
end 'hasCases'

// checkArmScoped checks an arm in a scope of its own, which holds what its patterns bind.
function checkArmScoped(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, arm ast.NodeID, st ast.TypeID, owned bool, isExpr bool, expect ast.TypeID, mutates state MatchState, mutates errs diag.ErrorList)
	let form = ast.matchArmForm(ms.tree(), id: arm)
	if state.hasDefault 'afterDefault'
		if not state.refusedOrder 'first'
			state.refusedOrder = true
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: arm), code: diag.errMatchDefaultNotLast, msg: diag.matchDefaultNotLast(), errs: errs)
		end 'first'
		return
	end 'afterDefault'
	if ast.matchArmIsDefault(ms.tree(), id: arm) 'default'
		if hasCases(p, ms: ms, t: st) and form != ast.ArmKind.armPanic and not ast.matchArmThrows(ms.tree(), id: arm) 'mustThrow'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: arm), code: diag.errMatchDefaultEnumMustThrow, msg: "on an enum or union, 'default' is 'default throws ...' or 'default panic(...)'", errs: errs)
			return
		end 'mustThrow'
		state.hasDefault = true
	end 'default'
	pushScope(c)
	checkArm(c, p: p, ms: ms, arm: arm, st: st, owned: owned, isExpr: isExpr, expect: expect, state: state, errs: errs)
	popScope(c)
end 'checkArmScoped'

// checkArm checks one arm of a match. owned is whether the match consumes its subject, so each payload the arm binds is
// owned by the arm instead of borrowed from the subject.
function checkArm(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, arm ast.NodeID, st ast.TypeID, owned bool, isExpr bool, expect ast.TypeID, mutates state MatchState, mutates errs diag.ErrorList)
	let mark = errs.count()
	let patternsRef = ast.matchArmPatternsRef(ms.tree(), id: arm)
	let altCount = ms.tree().listLen(patternsRef)
	for i in 0 upto altCount 'patterns'
		let pattern = ms.tree().listAt(patternsRef, index: i) as ast.NodeID
		checkPattern(c, p: p, ms: ms, pattern: pattern, st: st, owned: owned, altCount: altCount, state: state, errs: errs)
	end 'patterns'
	// Every alternative is checked, so a refused one leaves the cases of the others covered.
	if failedSince(errs, mark: mark) 'badPattern'
		return
	end 'badPattern'
	let form = ast.matchArmForm(ms.tree(), id: arm)
	let off = offsetOf(c, p: p, ms: ms, node: arm)
	let value = ast.matchArmValue(ms.tree(), id: arm)
	if form == ast.ArmKind.armThen 'then'
		if isExpr and not ast.matchArmThrows(ms.tree(), id: arm) 'inExpr'
			checkFail(c.modID, off: off, code: diag.errUnexpectedToken, msg: "an arm of a match expression 'gives' a value", errs: errs)
			return
		end 'inExpr'
		let action = ast.matchArmAction(ms.tree(), id: arm)
		let keyword = blockStatementKeyword(ms.tree().kindOf(action))
		if keyword != "" 'block'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: action), code: diag.errMatchBlockStatement, msg: diag.matchBlockStatement(keyword), errs: errs)
			return
		end 'block'
		if ms.tree().kindOf(action) == ast.NodeKind.tryStmt 'tryBlock'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: action), code: diag.errMatchBlockStatement, msg: diag.matchTryBlockForm(), errs: errs)
			return
		end 'tryBlock'
		let handler = blockHandlerOf(ms.tree(), action: action)
		if handler != 0 'otherwiseBlock'
			checkFail(c.modID, off: ms.tree().labelStart(ast.handlerBlockLabelRef(ms.tree(), id: handler)), code: diag.errMatchBlockStatement, msg: diag.matchOtherwiseBlockForm(), errs: errs)
			return
		end 'otherwiseBlock'
		checkStmt(c, p: p, ms: ms, s: action, errs: errs)
		return
	end 'then'
	if form == ast.ArmKind.armGives 'gives'
		if not isExpr 'inStatement'
			checkFail(c.modID, off: off, code: diag.errUnexpectedToken, msg: "an arm of a match statement uses 'then'", errs: errs)
			return
		end 'inStatement'
		joinArm(c, p: p, ms: ms, value: value, expect: expect, state: state, errs: errs)
		return
	end 'gives'
	_ = checkExpr(c, p: p, ms: ms, e: value, errs: errs)
end 'checkArm'

// blockStatementKeyword is the word that opens a statement that holds a block, or "" for one that does not.
// blockHandlerOf is the block handler of the try expression that an arm's statement is, or none.
function blockHandlerOf(tree ast.Tree, action ast.NodeID) returns ast.NodeID
	if tree.kindOf(action) != ast.NodeKind.exprStmt 'notExpression'
		return 0
	end 'notExpression'
	let e = ast.exprStmtE(tree, id: action)
	if tree.kindOf(e) != ast.NodeKind.tryExpr 'notTry'
		return 0
	end 'notTry'
	return ast.tryExprHandler(tree, id: e)
end 'blockHandlerOf'

function blockStatementKeyword(kind ast.NodeKind) returns String
	if kind == ast.NodeKind.ifStmt or kind == ast.NodeKind.ifTryStmt 'if'
		return "if"
	end 'if'
	if kind == ast.NodeKind.whileStmt 'while'
		return "while"
	end 'while'
	if kind == ast.NodeKind.forStmt 'for'
		return "for"
	end 'for'
	if kind == ast.NodeKind.matchStmt 'match'
		return "match"
	end 'match'
	if kind == ast.NodeKind.whenStmt 'when'
		return "when"
	end 'when'
	return ""
end 'blockStatementKeyword'

// joinArm types the value an arm gives and joins its type with the types of the arms before it.
function joinArm(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, value ast.NodeID, expect ast.TypeID, mutates state MatchState, mutates errs diag.ErrorList)
	let t = checkExpecting(c, p: p, ms: ms, e: value, want: expect, errs: errs)
	if t == ast.noType 'failed'
		return
	end 'failed'
	if state.result == ast.noType 'first'
		state.result = t
		return
	end 'first'
	let before = state.result
	let joined = joinTypes(c, p: p, ms: ms, off: state.at, clash: Clash.arms, a: before, b: t, errs: errs)
	if joined != ast.noType 'joined'
		state.result = joined
	end 'joined'
end 'joinArm'

// matchEndOffset is where maxon reports a match that does not cover its subject: the 'end' that closes it.
function matchEndOffset(c Checker, p ast.Project, ms ast.ModuleState, core ast.NodeID) returns diag.U32
	let endNode = ast.matchCoreEnd(ms.tree(), id: core)
	if endNode == 0 'unlabelled'
		return offsetOf(c, p: p, ms: ms, node: core)
	end 'unlabelled'
	return ms.tree().endKeywordStart(endNode)
end 'matchEndOffset'

// checkExhaustive refuses a match that no default ends and that leaves a case of its subject out.
function checkExhaustive(c Checker, p ast.Project, ms ast.ModuleState, core ast.NodeID, st ast.TypeID, isExpr bool, state MatchState, mutates errs diag.ErrorList)
	if state.hasDefault 'covered'
		return
	end 'covered'
	let off = matchEndOffset(c, p: p, ms: ms, core: core)
	if hasCases(p, ms: ms, t: st) 'cases'
		let orig = ast.originOf(ms.types, reads: p.types, t: st)
		if state.seen.count() < ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() 'missing'
			var word = unionWord
			if kindOfType(p, ms: ms, t: st) == ast.TypeKind.enumTy 'enumWord'
				word = enumWord
			end 'enumWord'
			checkFail(c.modID, off: off, code: diag.errMatchNotExhaustive, msg: diag.enumMatchNotExhaustive(word, typeName: ast.typeEntry(ms.types, reads: p.types, t: orig).name, missing: missingCases(p, ms: ms, orig: orig, state: state)), errs: errs)
		end 'missing'
		return
	end 'cases'
	let leavesBoolOut = st == p.builtins.boolTy and not (state.sawTrue and state.sawFalse)
	if leavesBoolOut or ast.isIntType(ms.types, reads: p.types, t: st) or st == p.builtins.stringTy or st == p.builtins.characterTy 'values'
		var subject = "match"
		if isExpr 'expr'
			subject = "match expression"
		end 'expr'
		checkFail(c.modID, off: off, code: diag.errMatchNotExhaustive, msg: diag.matchNotExhaustive(subject), errs: errs)
	end 'values'
end 'checkExhaustive'

// missingCases lists the cases of a declaration that no arm matches.
function missingCases(p ast.Project, ms ast.ModuleState, orig ast.TypeID, state MatchState) returns String
	var buf = ByteArray.create(0)
	var first = true
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() 'each'
		if not state.seen.has(i) 'unmatched'
			if not first 'sep'
				buf.append(", ".toByteArray())
			end 'sep'
			buf.append(ast.typeEntry(ms.types, reads: p.types, t: orig).cases[i].name.toByteArray())
			first = false
		end 'unmatched'
	end 'each'
	return String.from(buf)
end 'missingCases'

function checkPattern(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, pattern ast.NodeID, st ast.TypeID, owned bool, altCount Count, mutates state MatchState, mutates errs diag.ErrorList)
	let form = ast.patternForm(ms.tree(), id: pattern)
	if form == ast.PatternKind.patCase 'case'
		checkCasePattern(c, p: p, ms: ms, pattern: pattern, st: st, owned: owned, altCount: altCount, state: state, errs: errs)
		return
	end 'case'
	// A pattern of values binds nothing, and the lowering finds that in its entry as it does a case's bindings.
	c.typing.patterns.insert(pattern as Count, value: ast.PatternInfo.makeValue(form))
	if form == ast.PatternKind.patLiteral 'literal'
		checkLiteralPattern(c, p: p, ms: ms, pattern: pattern, st: st, state: state, errs: errs)
		return
	end 'literal'
	checkRangePattern(c, p: p, ms: ms, pattern: pattern, st: st, errs: errs)
end 'checkPattern'

function checkCasePattern(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, pattern ast.NodeID, st ast.TypeID, owned bool, altCount Count, mutates state MatchState, mutates errs diag.ErrorList)
	let off = offsetOf(c, p: p, ms: ms, node: pattern)
	let qualifier = ast.patternCaseName(ms.tree(), id: pattern).clone()
	let member = ast.patternMember(ms.tree(), id: pattern).clone()
	var caseName = qualifier.clone()
	if member != "" 'qualified'
		caseName = member.clone()
		if not state.refusedQualified 'first'
			state.refusedQualified = true
			checkFail(c.modID, off: off, code: diag.errMatchQualifiedCaseName, msg: diag.matchQualifiedCaseName(member, qualified: "{qualifier}.{member}"), errs: errs)
		end 'first'
	end 'qualified'
	if not hasCases(p, ms: ms, t: st) 'notCases'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "a case pattern needs an enum or union subject, found {nameOfType(p, ms: ms, t: st)}", errs: errs)
		return
	end 'notCases'
	let isEnum = kindOfType(p, ms: ms, t: st) == ast.TypeKind.enumTy
	var word = unionWord
	if isEnum 'enumWord'
		word = enumWord
	end 'enumWord'
	let orig = ast.originOf(ms.types, reads: p.types, t: st)
	var caseIdx = 0 as Count
	let found = ast.typeEntry(ms.types, reads: p.types, t: orig).findCase(caseName)
	if not found.isSome() 'unknown'
		reportUnknownCase(c, off: off, word: word, caseName: caseName, errs: errs)
		return
	end 'unknown'
	match consumes found 'index'
		some(i) then caseIdx = i
		none then _ = 0
	end 'index'
	var locals = ast.LocalIDList.create(0)
	if ast.patternHasBindings(ms.tree(), id: pattern) 'binds'
		if not bindCase(c, p: p, ms: ms, pattern: pattern, st: st, caseIdx: caseIdx, owned: owned, altCount: altCount, locals: locals, errs: errs) 'bad'
			return
		end 'bad'
	end 'binds'
	if state.seen.has(caseIdx) 'twice'
		checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: "case '{caseName}' is matched twice", errs: errs)
		return
	end 'twice'
	state.seen.insert(caseIdx, value: true)
	c.typing.patterns.insert(pattern as Count, value: ast.PatternInfo.makeCase(caseIdx, bindings: locals))
end 'checkCasePattern'

function reportUnknownCase(c Checker, off diag.U32, word String, caseName String, mutates errs diag.ErrorList)
	checkFail(c.modID, off: off, code: diag.errEnumUnknownCase, msg: diag.enumUnknownCase(word, caseName: caseName), errs: errs)
end 'reportUnknownCase'

// bindCase declares the locals that a pattern binds to the payload of a case of a union, and refuses bindings for an
// enum's.
function bindCase(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, pattern ast.NodeID, st ast.TypeID, caseIdx Count, owned bool, altCount Count, mutates locals ast.LocalIDList, mutates errs diag.ErrorList) returns bool
	let off = offsetOf(c, p: p, ms: ms, node: pattern)
	let caseName = ast.patternCaseName(ms.tree(), id: pattern).clone()
	let bindingsRef = ast.patternBindingsRef(ms.tree(), id: pattern)
	let bindingCount = ms.tree().listLen(bindingsRef)
	let orig = ast.originOf(ms.types, reads: p.types, t: st)
	var payloadCount = 0 as Count
	if kindOfType(p, ms: ms, t: st) == ast.TypeKind.unionTy 'union'
		payloadCount = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[caseIdx].payload.count()
	end 'union'
	if bindingCount != payloadCount 'count'
		var cause = diag.ErrorCause.none
		if orig == p.builtins.sendErrorTy or orig == p.builtins.subprocessErrorTy 'builtin'
			cause = diag.ErrorCause.payloadOfBuiltinError
		end 'builtin'
		checkFailCaused(c.modID, off: off, code: diag.errEnumWrongBindingCount, msg: diag.enumWrongBindingCount(caseName, expected: "{payloadCount}", got: "{bindingCount}"), cause: cause, errs: errs)
		return false
	end 'count'
	if altCount > 1 'alternatives'
		checkFail(c.modID, off: off, code: diag.errMatchArmPayloadBindingConflict, msg: "an arm that binds a payload covers exactly one case, since on another case's path it would read a value no pattern bound; give each case an arm of its own", errs: errs)
	end 'alternatives'
	for i in 0 upto payloadCount 'payload'
		let bindingName = ms.tree().nameAt(ms.tree().listAt(bindingsRef, index: i)).clone()
		if bindingName == "_" 'ignored'
			locals.push(ast.noLocal)
			continue 'payload'
		end 'ignored'
		let payloadTy = ast.payloadType(ms.types, reads: p.types, owner: st, caseIndex: caseIdx, index: i)
		let id = declareLocal(c, p: p, ms: ms, name: bindingName, t: payloadTy, isVar: false, definedAt: 0 as ast.NodeID, off: off, errs: errs)
		if id == ast.noLocal 'failed'
			return false
		end 'failed'
		c.typing.locals[id as Count].projected = ast.isManagedType(ms.types, reads: p.types, t: payloadTy) and not owned
		locals.push(id)
	end 'payload'
	return true
end 'bindCase'

function checkLiteralPattern(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, pattern ast.NodeID, st ast.TypeID, mutates state MatchState, mutates errs diag.ErrorList)
	let off = offsetOf(c, p: p, ms: ms, node: pattern)
	let value = ast.patternValue(ms.tree(), id: pattern)
	let checked = checkExpr(c, p: p, ms: ms, e: value, errs: errs)
	if checked == ast.noType 'failed'
		return
	end 'failed'
	let t = integerized(c, p: p, ms: ms, e: value, t: checked, other: st)
	let valueKind = ms.tree().kindOf(value)
	if valueKind == ast.NodeKind.charLit and st == p.builtins.characterTy 'character'
		return
	end 'character'
	if valueKind == ast.NodeKind.boolLit and st == p.builtins.boolTy 'bool'
		recordBoolPattern(c, p: p, ms: ms, pattern: pattern, value: value, state: state, errs: errs)
		return
	end 'bool'
	if valueKind == ast.NodeKind.strLit and st == p.builtins.stringTy and ms.tree().strIsPlain(ast.strLitPartsRef(ms.tree(), id: value)) 'string'
		return
	end 'string'
	if isConstInt(p, ms: ms, t: t) and ast.isIntType(ms.types, reads: p.types, t: st) 'integer'
		var expected = st
		if isConstInt(p, ms: ms, t: st) 'constSubject'
			expected = p.builtins.anon64Ty
		end 'constSubject'
		_ = coerce(c, p: p, ms: ms, node: value, at: exprOffset(c, p: p, ms: ms, node: value), src: t, target: expected, wrong: Mismatch.expectedGot, errs: errs)
		return
	end 'integer'
	checkFail(c.modID, off: off, code: diag.errMatchTypeMismatch, msg: diag.patternTypeMismatch(gotName(p, ms: ms, t: t), scrutinee: gotName(p, ms: ms, t: st)), errs: errs)
end 'checkLiteralPattern'

function recordBoolPattern(mutates c Checker, p ast.Project, ms ast.ModuleState, pattern ast.NodeID, value ast.NodeID, mutates state MatchState, mutates errs diag.ErrorList)
	let isTrue = ast.boolLitValue(ms.tree(), id: value)
	var seenAlready = state.sawFalse
	var word = "False"
	if isTrue 'truth'
		seenAlready = state.sawTrue
		word = "True"
	end 'truth'
	if seenAlready 'twice'
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: pattern), code: diag.errDuplicateDefinition, msg: "'{word}' is matched twice", errs: errs)
		return
	end 'twice'
	if isTrue 'markTrue'
		state.sawTrue = true
	end 'markTrue' else 'markFalse'
		state.sawFalse = true
	end 'markFalse'
end 'recordBoolPattern'

function checkRangePattern(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, pattern ast.NodeID, st ast.TypeID, mutates errs diag.ErrorList)
	let off = offsetOf(c, p: p, ms: ms, node: pattern)
	let lowNode = ast.patternValue(ms.tree(), id: pattern)
	let highNode = ast.patternHigh(ms.tree(), id: pattern)
	let checkedLo = checkExpr(c, p: p, ms: ms, e: lowNode, errs: errs)
	if checkedLo == ast.noType 'badLow'
		return
	end 'badLow'
	let checkedHi = checkExpr(c, p: p, ms: ms, e: highNode, errs: errs)
	if checkedHi == ast.noType 'badHigh'
		return
	end 'badHigh'
	let lo = integerized(c, p: p, ms: ms, e: lowNode, t: checkedLo, other: st)
	let hi = integerized(c, p: p, ms: ms, e: highNode, t: checkedHi, other: st)
	if st == p.builtins.characterTy and ms.tree().kindOf(lowNode) == ast.NodeKind.charLit and ms.tree().kindOf(highNode) == ast.NodeKind.charLit 'characters'
		return
	end 'characters'
	if not ast.isIntType(ms.types, reads: p.types, t: st) or not isConstInt(p, ms: ms, t: lo) or not isConstInt(p, ms: ms, t: hi) 'notInts'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "a range pattern needs integer bounds and an integer subject", errs: errs)
		return
	end 'notInts'
	var top = ast.typeEntry(ms.types, reads: p.types, t: hi).minVal.clone()
	if not ast.patternInclusive(ms.tree(), id: pattern) 'exclusive'
		top = top.sub(ast.I128.one())
	end 'exclusive'
	if ast.typeEntry(ms.types, reads: p.types, t: lo).minVal.gt(top) 'empty'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "the range pattern is empty", errs: errs)
	end 'empty'
end 'checkRangePattern'
