// checkStructLit types a record literal, which only a method of the record writes.
function checkStructLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let typeName = ast.structLitExprTypeName(ms.tree(), id: e).clone()
	let off = offsetOf(c, p: p, ms: ms, node: e)
	var target = ast.noType
	if typeName == "Self" 'selfType'
		target = c.owner
		noteConstantType(c, p: p, ms: ms, t: target)
	end 'selfType' else 'named'
		match consumes ast.nodeDecl(p, ms: ms, node: e as Count) 'bound'
			some(ref) then target = declaredTypeOrNone(p, ms: ms, ref: ref)
			none then _ = 0
		end 'bound'
	end 'named'
	if typeHasKind(p, ms: ms, t: target, kind: ast.TypeKind.builtinArray) 'array'
		return checkEmptyArrayLit(c, p: p, ms: ms, e: e, t: target, errs: errs)
	end 'array'
	if not typeHasKind(p, ms: ms, t: target, kind: ast.TypeKind.record) 'notRecord'
		checkFail(c.modID, off: off, code: diag.errUnknownType, msg: "'{typeName}' is not a type with fields", errs: errs)
		return ast.noType
	end 'notRecord'
	let tName = nameOfType(p, ms: ms, t: target)
	if ast.typeEntry(ms.types, reads: p.types, t: target).typeParams.count() > 0 'generic'
		checkFail(c.modID, off: off, code: diag.errTypeArgumentCount, msg: "a literal of the generic '{tName}' is written 'Self\{...\}', which gives it its own type parameters", errs: errs)
		return ast.noType
	end 'generic'
	if not c.inRawValue and (c.owner != target or (c.fn == ast.noFunc and c.constName == "")) 'restricted'
		checkFail(c.modID, off: off, code: diag.errConstructorRestriction, msg: diag.constructorRestricted(tName), errs: errs)
		return ast.noType
	end 'restricted'
	return checkLiteralFields(c, p: p, ms: ms, e: e, rt: target, errs: errs)
end 'checkStructLit'

// checkEmptyArrayLit types `Items{}` over an array alias, maxon's literal of an Array with every field at its default: a new
// empty array, as `Items.create(0)` is. An array has no field that a literal could give.
function checkEmptyArrayLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if ms.tree().listLen(ast.structLitExprFieldsRef(ms.tree(), id: e)) > 0 'fields'
		let name = nameOfType(p, ms: ms, t: t)
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errUnknownType, msg: "'{name}' is an array, which has no fields: write '{name}\{\}' for an empty one, or its elements in '[...]'", errs: errs)
		return ast.noType
	end 'fields'
	c.typing.structLits.insert(e as Count, value: ast.StructLitInfo.make(t, ordered: ast.NodeIDList.create(0)))
	return t
end 'checkEmptyArrayLit'

// checkLiteralFields types the field values of a record literal, and leaves the fields it does not give to their defaults.
function checkLiteralFields(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, rt ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let orig = ast.originOf(ms.types, reads: p.types, t: rt)
	let fieldCount = ast.typeEntry(ms.types, reads: p.types, t: orig).fields.count()
	var ordered = ast.NodeIDList.create(0)
	for _ in 0 upto fieldCount 'slots'
		ordered.push(0 as ast.NodeID)
	end 'slots'
	let fieldsRef = ast.structLitExprFieldsRef(ms.tree(), id: e)
	let given = ms.tree().listLen(fieldsRef)
	for i in 0 upto given 'given'
		let sf = ms.tree().listAt(fieldsRef, index: i) as ast.NodeID
		if not checkLiteralField(c, p: p, ms: ms, rt: rt, sf: sf, ordered: ordered, errs: errs) 'bad'
			return ast.noType
		end 'bad'
	end 'given'
	for fi in 0 upto fieldCount 'defaults'
		if ordered[fi] == 0 'left'
			if not ast.typeEntry(ms.types, reads: p.types, t: orig).fields[fi].hasDefault 'required'
				checkFail(c.modID, off: braceOffset(c, p: p, ms: ms, literal: e), code: diag.errFieldNotInitialized, msg: diag.fieldNotInitialized(ast.typeEntry(ms.types, reads: p.types, t: orig).fields[fi].name, typeName: nameOfType(p, ms: ms, t: rt)), errs: errs)
				return ast.noType
			end 'required'
			recordFieldUses(c, defaultExpr: ast.typeEntry(ms.types, reads: p.types, t: orig).fields[fi].defaultExpr)
		end 'left'
	end 'defaults'
	c.typing.structLits.insert(e as Count, value: ast.StructLitInfo.make(rt, ordered: ordered))
	return rt
end 'checkLiteralFields'

// checkLiteralField types one field value of a record literal, as a value of the field's type.
function checkLiteralField(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, rt ast.TypeID, sf ast.NodeID, mutates ordered ast.NodeIDList, mutates errs diag.ErrorList) returns bool
	let name = ast.structFieldName(ms.tree(), id: sf).clone()
	let value = ast.structFieldValue(ms.tree(), id: sf)
	let typeName = nameOfType(p, ms: ms, t: rt)
	if not ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: rt)).findField(name).isSome() 'unknown'
		failAt(c, p: p, ms: ms, node: sf, code: diag.errUnknownField, msg: diag.unknownField(typeName, fieldName: name), errs: errs)
		return false
	end 'unknown'
	let index = fieldIndexNamed(p, ms: ms, rt: rt, name: name)
	if ordered[index] != 0 'twice'
		failAt(c, p: p, ms: ms, node: sf, code: diag.errDuplicateDefinition, msg: "field '{name}' is given twice", errs: errs)
		return false
	end 'twice'
	let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: rt, index: index)
	let t = checkExpecting(c, p: p, ms: ms, e: value, want: fieldTy, errs: errs)
	if t == ast.noType 'badValue'
		return false
	end 'badValue'
	if not coerce(c, p: p, ms: ms, node: value, at: offsetOf(c, p: p, ms: ms, node: sf), src: t, target: fieldTy, wrong: Mismatch.assignment("field '{name}' of '{declaredNameOfType(p, ms: ms, t: rt)}'", bare: "field '{name}'"), errs: errs) 'badType'
		return false
	end 'badType'
	ordered[index] = value
	return true
end 'checkLiteralField'

// checkTupleLit types a tuple literal, whose elements are the fields of the record that the tuple type is. The type the
// context expects, when it is a tuple of as many elements, gives each element its own; otherwise each element has the type
// it is written with, and a bare number keeps the range it spans, or takes the whole word inside another literal.
function checkTupleLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let elemsRef = ast.tupleExprElemsRef(ms.tree(), id: e)
	let count = ms.tree().listLen(elemsRef)
	let want = c.expect
	var given = ast.TypeIDList.create(0)
	if ast.isTupleType(ms.types, reads: p.types, t: want) and ast.typeEntry(ms.types, reads: p.types, t: want).typeArgs.count() == count 'stated'
		given = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: want).typeArgs)
	end 'stated'
	let wide = c.literalWide
	c.literalWide = true
	var elems = ast.TypeIDList.create(0)
	var ordered = ast.NodeIDList.create(0)
	for i in 0 upto count 'each'
		let node = ms.tree().listAt(elemsRef, index: i) as ast.NodeID
		var wanted = ast.noType
		if given.count() == count 'hasWanted'
			wanted = given[i]
		end 'hasWanted'
		let t = checkTupleElement(c, p: p, ms: ms, node: node, wanted: wanted, want: want, index: i, wide: wide, errs: errs)
		if t == ast.noType 'failed'
			c.literalWide = wide
			return ast.noType
		end 'failed'
		elems.push(t)
		ordered.push(node)
	end 'each'
	c.literalWide = wide
	let ty = ast.tupleType(ms.types, reads: p.types, elems: elems)
	c.typing.structLits.insert(e as Count, value: ast.StructLitInfo.make(ty, ordered: ordered))
	return ty
end 'checkTupleLit'

// checkTupleElement types one element of a tuple literal and gives the type it has in the tuple.
function checkTupleElement(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID, wanted ast.TypeID, want ast.TypeID, index Count, wide bool, mutates errs diag.ErrorList) returns ast.TypeID
	let t = checkExpecting(c, p: p, ms: ms, e: node, want: wanted, errs: errs)
	if t == ast.noType 'failed'
		return ast.noType
	end 'failed'
	let off = offsetOf(c, p: p, ms: ms, node: node)
	if t == p.builtins.voidTy or t == p.builtins.neverTy 'noValue'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "an element of a tuple is an expression with no value", errs: errs)
		return ast.noType
	end 'noValue'
	if not requireSigned64(c, off: off, t: t, p: p, ms: ms, errs: errs) 'wide'
		return ast.noType
	end 'wide'
	if wanted != ast.noType 'stated'
		let elementPlace = "element {index} of tuple {nameOfType(p, ms: ms, t: want)}"
		if not coerce(c, p: p, ms: ms, node: node, at: exprOffset(c, p: p, ms: ms, node: node), src: t, target: wanted, wrong: Mismatch.assignment(elementPlace.clone(), bare: elementPlace), errs: errs) 'badType'
			return ast.noType
		end 'badType'
		return wanted
	end 'stated'
	return tupleElementType(p, ms: ms, t: t, wide: wide)
end 'checkTupleElement'

// tupleElementType is the type that an element written with the type t has in a tuple that states none: bare numbers keep
// the range they span, as those of an array literal do, and take the whole word inside another literal.
function tupleElementType(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, wide bool) returns ast.TypeID
	let held = bareRange(p, ms: ms, t: t)
	if wide and typeIsAnonInt(ms.types, reads: p.types, t: held) 'word'
		if rangeHi(ms.types, reads: p.types, t: held).gt(ast.I128.i64Max()) 'unsigned'
			return p.builtins.anonU64Ty
		end 'unsigned'
		return p.builtins.anon64Ty
	end 'word'
	return held
end 'tupleElementType'

function declaredTypeOrNone(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns ast.TypeID
	match ast.declType(p, ms: ms, ref: ref) 'dt'
		some(tid) then return tid
		none then return ast.noType
	end 'dt'
end 'declaredTypeOrNone'

// checkIndex types a subscript, which only an array, a list or a slot map has. An element of a primitive is a
// projection, never a value of its own: what it is used for decides whether it borrows the element to read it or to change
// it, and the ownership pass refuses to move one out.
function checkIndex(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let obj = ast.indexExprObj(ms.tree(), id: e)
	let typed = checkExpr(c, p: p, ms: ms, e: obj, errs: errs)
	if typed == ast.noType 'failed'
		return ast.noType
	end 'failed'
	let t = ast.contentType(ms.types, reads: p.types, t: typed)
	if not requireNotCown(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), t: t, use: "reading an element", errs: errs) 'cown'
		return ast.noType
	end 'cown'
	let k = kindOfType(p, ms: ms, t: t)
	if k != ast.TypeKind.builtinArray 'notSubscriptable'
		failAt(c, p: p, ms: ms, node: e, code: diag.errTypeMismatch, msg: "{nameOfType(p, ms: ms, t: t)} has no elements to index: only an array does", errs: errs)
		return ast.noType
	end 'notSubscriptable'
	let argsRef = ast.indexExprArgsRef(ms.tree(), id: e)
	let given = ms.tree().listLen(argsRef)
	if given != 1 'arity'
		failAt(c, p: p, ms: ms, node: e, code: diag.errTypeMismatch, msg: "an index is one value, given {given}", errs: errs)
		return ast.noType
	end 'arity'
	let arg = ms.tree().listAt(argsRef, index: 0 as Count) as ast.NodeID
	let indexTy = typeIndexType(p, ms: ms, ownerTy: t)
	let argTy = checkExpecting(c, p: p, ms: ms, e: arg, want: indexTy, errs: errs)
	if argTy == ast.noType 'badIndex'
		return ast.noType
	end 'badIndex'
	if not coerce(c, p: p, ms: ms, node: arg, at: exprOffset(c, p: p, ms: ms, node: arg), src: argTy, target: indexTy, wrong: Mismatch.expectedGot, errs: errs) 'badType'
		return ast.noType
	end 'badType'
	return typeElemType(p, ms: ms, ownerTy: t)
end 'checkIndex'

// checkMember types 'Type.case' and the members that an enum or a union value has.
function checkMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	if c.typing.members.has(e as Count) 'typed'
		return ast.nodeType(c.typing, node: e)
	end 'typed'
	let obj = ast.memberExprObj(ms.tree(), id: e)
	let param = typeParamNamed(c, p: p, ms: ms, e: obj)
	if param != ast.noType 'parameter'
		return memberOfTypeParam(c, p: p, ms: ms, e: e, param: param, errs: errs)
	end 'parameter'
	let primitive = primitiveNamed(c, p: p, ms: ms, e: obj)
	if primitive != ast.noType 'primitive'
		let mark = errs.count()
		match consumes extensionStaticOf(c, p: p, ms: ms, nt: primitive, member: ast.memberExprName(ms.tree(), id: e), e: e, errs: errs) 'static'
			some(ref) then return readTypeStatic(c, p: p, ms: ms, e: e, obj: obj, nt: primitive, ref: ref, errs: errs)
			none then _ = 0
		end 'static'
		if failedSince(errs, mark: mark) 'ambiguous'
			return ast.noType
		end 'ambiguous'
	end 'primitive'
	var named = ast.noType
	if ms.tree().kindOf(obj) == ast.NodeKind.nameExpr 'headIsName'
		let mark = errs.count()
		named = typeNamed(c, p: p, ms: ms, name: obj, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return ast.noType
		end 'failed'
		if ast.familyOfSelf(ms.types, reads: p.types, t: named) != ast.noType 'familySelf'
			// A static let is one of the family, which every `Self` reads alike.
			named = ast.familyOfSelf(ms.types, reads: p.types, t: named)
		end 'familySelf'
	end 'headIsName'
	if named != ast.noType 'typeMember'
		return checkTypeMember(c, p: p, ms: ms, e: e, obj: obj, nt: named, errs: errs)
	end 'typeMember'
	if ms.tree().kindOf(obj) == ast.NodeKind.nameExpr 'headIsSized'
		match consumes ast.sizedLimitValue(ast.nameExprName(ms.tree(), id: obj), member: ast.memberExprName(ms.tree(), id: e)) 'limit'
			some(v) then return checkLimitMember(c, p: p, ms: ms, e: e, value: v)
			none then _ = 0
		end 'limit'
	end 'headIsSized'
	match consumes payloadCaseNamed(c, p: p, ms: ms, obj: obj) 'payloadCase'
		some(read) then return checkCaseRead(c, p: p, ms: ms, e: e, read: read, errs: errs)
		none then _ = 0
	end 'payloadCase'
	let typed = checkExpr(c, p: p, ms: ms, e: obj, errs: errs)
	if typed == ast.noType 'badObj'
		return ast.noType
	end 'badObj'
	return checkValueMember(c, p: p, ms: ms, e: e, t: typed, errs: errs)
end 'checkMember'

// memberOfTypeParam refuses a member written on a type parameter's name: a requirement of its bounds is reached only on
// a concrete type, and is no function value.
function memberOfTypeParam(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, param ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let member = ast.memberExprName(ms.tree(), id: e)
	let paramName = nameOfType(p, ms: ms, t: param)
	let req = boundRequirement(p, ms: ms, boundedFn: c.boundedFn, param: param, name: member)
	if req.sig != ast.noFunc 'requirement'
		let ifaceName = ast.typeEntry(ms.types, reads: p.types, t: req.iface).name.clone()
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errMethodAsFunctionValue, msg: diag.requirementAsFunctionValue("{paramName}.{member}", interfaceName: ifaceName), errs: errs)
		return ast.noType
	end 'requirement'
	checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errUnknownStaticMember, msg: "'{paramName}' is a type parameter, which has no member '{member}': a type parameter has only the methods of its bounds, called on a value", errs: errs)
	return ast.noType
end 'memberOfTypeParam'

// checkLimitMember types `u64.max` and its like, the constant that a sized integer's limit is.
function checkLimitMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes value ast.I128) returns ast.TypeID
	c.typing.members.insert(e as Count, value: ast.MemberInfo.make(ast.MemberKind.memberLimit, ownerTy: ast.noType))
	return ast.internConstInt(ms.types, reads: p.types, val: value)
end 'checkLimitMember'

// checkTypeMember types a case of an enum or a union written after the type's name.
function checkTypeMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, obj ast.NodeID, nt ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let member = ast.memberExprName(ms.tree(), id: e).clone()
	let off = offsetOf(c, p: p, ms: ms, node: e)
	let k = kindOfType(p, ms: ms, t: nt)
	var named = nt
	if k == ast.TypeKind.unionTy and ast.typeEntry(ms.types, reads: p.types, t: nt).typeParams.count() > 0 and ast.typeEntry(ms.types, reads: p.types, t: nt).findCase(member).isSome() 'inferred'
		named = instantiateInferred(c, p: p, ms: ms, obj: obj, ut: nt, member: member, errs: errs)
		if named == ast.noType 'cannotInfer'
			return ast.noType
		end 'cannotInfer'
	end 'inferred'
	let mark = errs.count()
	let isCase = (k == ast.TypeKind.enumTy or k == ast.TypeKind.unionTy) and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: named)).findCase(member).isSome()
	if not isCase 'notCase'
		match consumes bodyStaticOf(p, ms: ms, nt: named, member: member) 'body'
			some(ref) then return readTypeStatic(c, p: p, ms: ms, e: e, obj: obj, nt: named, ref: ref, errs: errs)
			none then _ = 0
		end 'body'
		match consumes extensionStaticOf(c, p: p, ms: ms, nt: named, member: member, e: e, errs: errs) 'static'
			some(ref) then return readTypeStatic(c, p: p, ms: ms, e: e, obj: obj, nt: named, ref: ref, errs: errs)
			none then _ = 0
		end 'static'
		if failedSince(errs, mark: mark) 'ambiguousStatic'
			return ast.noType
		end 'ambiguousStatic'
	end 'notCase'
	_ = requireInstance(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: obj), nt: named, errs: errs)
	if failedSince(errs, mark: mark) 'generic'
		return ast.noType
	end 'generic'
	if (k == ast.TypeKind.enumTy or k == ast.TypeKind.unionTy) and (member == allCasesMember or member == allCaseNamesMember) 'caseList'
		return checkCaseListMember(c, p: p, ms: ms, e: e, obj: obj, member: member, nt: named, errs: errs)
	end 'caseList'
	if k == ast.TypeKind.enumTy or k == ast.TypeKind.unionTy 'cases'
		return checkCaseMember(c, p: p, ms: ms, e: e, member: member, nt: named, errs: errs)
	end 'cases'
	let method = methodOf(c, p: p, ms: ms, t: named, name: member, node: e, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if method != ast.noFunc 'method'
		let spelled = "{writtenType(c, p: p, ms: ms, obj: obj)}.{member}"
		let words = diag.methodAsFunctionValue(spelled) if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).isStatic else diag.instanceMethodAsFunctionValue(spelled, method: member)
		checkFail(c.modID, off: off, code: diag.errMethodAsFunctionValue, msg: words, errs: errs)
		return ast.noType
	end 'method'
	if k == ast.TypeKind.record 'noMember'
		checkFail(c.modID, off: off, code: diag.errUnknownStaticMember, msg: diag.noStaticMember(nameOfType(p, ms: ms, t: named), member: member), errs: errs)
		return ast.noType
	end 'noMember'
	checkFail(c.modID, off: off, code: diag.errUnknownField, msg: "'{nameOfType(p, ms: ms, t: named)}.{member}' is not a value", errs: errs)
	return ast.noType
end 'checkTypeMember'

// extensionStaticOf is the static let that an extension seen from the module adds to the type nt under the name member, or none.
// Two that the module sees are ambiguous, which it refuses at e.
function extensionStaticOf(mutates c Checker, p ast.Project, ms ast.ModuleState, nt ast.TypeID, member String, e ast.NodeID, mutates errs diag.ErrorList) returns table.Option with ast.DeclRef
	let key = ast.extensionKey(p, ms: ms, t: nt)
	if not key.isSome() 'unextended'
		return table.Option.none
	end 'unextended'
	match consumes ast.extensionStatic(p, ms: ms, from: c.modID, owner: key.unwrap(), name: member) 'lookup'
		found(ref) then return table.Option.some(ref)
		ambiguous(first, second) then failAmbiguousStatic(c, p: p, ms: ms, e: e, nt: nt, member: member, first: first, second: second, errs: errs)
		absent then _ = 0
	end 'lookup'
	return table.Option.none
end 'extensionStaticOf'

function failAmbiguousStatic(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, nt ast.TypeID, member String, first ast.DeclRef, second ast.DeclRef, mutates errs diag.ErrorList)
	let typeName = nameOfType(p, ms: ms, t: nt)
	checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errAmbiguousExtension, msg: "'{typeName}.{member}' is ambiguous here: an extension in {ast.describeModule(p, modID: first.module)} and an extension in {ast.describeModule(p, modID: second.module)} both add the static let '{member}' to '{typeName}', and {ast.describeModule(p, modID: c.modID)} sees both; a read cannot name it through its module, so rename or remove one of the two", errs: errs)
end 'failAmbiguousStatic'

// bodyStaticOf is the static let that the body of the type nt, or of the generic type it is an instance of, declares under
// the name member, or none: the resolve makes a name of one written after the type's own name, and this finds one written
// after a typealias or an instance of the type.
function bodyStaticOf(p ast.Project, ms ast.ModuleState, nt ast.TypeID, member String) returns table.Option with ast.DeclRef
	let origin = ast.originOf(ms.types, reads: p.types, t: nt)
	let k = ast.typeKind(ms.types, reads: p.types, t: origin)
	if k != ast.TypeKind.record and k != ast.TypeKind.enumTy and k != ast.TypeKind.unionTy 'noBody'
		return table.Option.none
	end 'noBody'
	let ref = ast.typeEntry(ms.types, reads: p.types, t: origin).decl.clone()
	let statics = ast.moduleDecl(p, ref: ref).staticLets()
	for i in 0 upto statics.count() 'each'
		if statics[i].name == member 'hit'
			let qualified = ast.nestedAliasName(ast.typeEntry(ms.types, reads: p.types, t: origin).name, name: member)
			var ord as table.Option with ast.DeclOrdinal
			if ref.module == diag.stdlibID 'library'
				ord = p.stdlib.names.get(qualified)
			end 'library' else 'module'
				ord = p.modules[ast.modIndex(ref.module)].names.get(qualified)
			end 'module'
			match consumes ord 'declared'
				some(o) then return table.Option.some(ast.DeclRef.make(ref.module, ordinal: o))
				none then panic("the static let '{member}' of '{qualified}' is not among the declarations of its module")
			end 'declared'
		end 'hit'
	end 'each'
	return table.Option.none
end 'bodyStaticOf'

// readTypeStatic types a read of the static let ref of the type nt, written Type.member at e, where the type is named by a
// typealias, as an instance, or by an extension's: the bodies make the member a name of the constant, as the resolve
// makes one of a static let written after its type's own name. A static let whose value names the type's parameters is
// one for each instance (ConstValue.instanceOf), read through an instance, which binds them; any other is read through the
// type itself, as maxon has it. The constants stage shares its tree, so a read in a constant's initializer is rewritten by
// the bodies stage (Checker.deferredNames).
function readTypeStatic(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, obj ast.NodeID, nt ast.TypeID, consumes ref ast.DeclRef, mutates errs diag.ErrorList) returns ast.TypeID
	let member = ast.memberExprName(ms.tree(), id: e).clone()
	let off = offsetOf(c, p: p, ms: ms, node: e)
	let level = ast.declLevel(p, ref: ref)
	if ref.module != c.modID and not ast.isVisibleFrom(p, v: level, owner: ref.module, from: c.modID) 'hidden'
		checkFail(c.modID, off: off, code: diag.errNotExported, msg: ast.notVisible(p, name: ast.declName(p, ref: ref), v: level, owner: ref.module, from: c.modID), errs: errs)
		return ast.noType
	end 'hidden'
	let origin = ast.originOf(ms.types, reads: p.types, t: nt)
	let throughInstance = ast.typeEntry(ms.types, reads: p.types, t: origin).typeParams.count() > 0 and ast.typeEntry(ms.types, reads: p.types, t: nt).typeArgs.count() > 0
	let instanceOf = instanceOfConstant(p, ms: ms, ref: ref)
	if instanceOf == ast.noType and throughInstance 'shared'
		let typeName = nameOfType(p, ms: ms, t: origin)
		checkFail(c.modID, off: off, code: diag.errUnknownStaticMember, msg: "'{writtenType(c, p: p, ms: ms, obj: obj)}.{member}' is a static of '{typeName}', which is read through the type itself: write '{typeName}.{member}'", errs: errs)
		return ast.noType
	end 'shared'
	if ast.typeKind(ms.types, reads: p.types, t: origin) != ast.TypeKind.record and familySelf(p, ms: ms, t: nt) != nt and constantType(p, ms: ms, ref: ref) == familySelf(p, ms: ms, t: nt) 'implicitSelf'
		checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: implicitSelfRefusal(p, ms: ms, qualifier: nt, name: member), errs: errs)
		return ast.noType
	end 'implicitSelf'
	if instanceOf != ast.noType and not throughInstance 'bare'
		failBareInstanceStatic(c, p: p, ms: ms, off: off, qualified: "{nameOfType(p, ms: ms, t: instanceOf)}.{member}", origin: instanceOf, errs: errs)
		return ast.noType
	end 'bare'
	if instanceOf != ast.noType 'perInstance'
		c.typing.staticInstances.insert(e as Count, value: nt)
	end 'perInstance'
	if ms.readsSharedTree() 'constant'
		c.deferredNames.push(e)
		c.deferredHeads.push(obj)
	end 'constant' else 'body'
		ms.ownTree.becomeName(e, head: obj)
	end 'body'
	ms.tables.bindMemberDecl(e, d: ref.clone())
	return checkDeclaredName(c, p: p, ms: ms, e: e, ref: ref, name: member, errs: errs)
end 'readTypeStatic'

// constantType is the type of the constant ref, or noType before it is typed.
function constantType(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns ast.TypeID
	match consumes constantOf(p, ms: ms, ref: ref) 'valued'
		some(value) then return value.ty
		none then return ast.noType
	end 'valued'
end 'constantType'

// instanceOfConstant is the generic type that the constant ref is one for each instance of, or noType.
function instanceOfConstant(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns ast.TypeID
	match consumes constantOf(p, ms: ms, ref: ref) 'valued'
		some(value) then return value.instanceOf
		none then return ast.noType
	end 'valued'
end 'instanceOfConstant'

// failBareInstanceStatic refuses a read of a static let that is one for each instance of the generic type origin, read where
// nothing names the instance: through the generic type's own name, outside its methods.
export function failBareInstanceStatic(mutates c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, qualified String, origin ast.TypeID, mutates errs diag.ErrorList)
	let typeName = nameOfType(p, ms: ms, t: origin)
	let start = try typeName.byteLength() + 1 otherwise qualified.byteLength()
	let member = qualified.sliceBytes(start, endPos: qualified.byteLength()).clone() if qualified.startsWith("{typeName}.") else qualified.clone()
	checkFail(c.modID, off: off, code: diag.errTypeArgumentCount, msg: "'{qualified}' is one for each instance of '{typeName}', since its value names the type's parameters, and nothing here says which: read it through an instance, as 'Items.{member}' after `typealias Items = {typeName} with ...`", errs: errs)
end 'failBareInstanceStatic'

// writtenType is a type's name as the source writes it: the path of its module comes first where another module declares it.
function writtenType(c Checker, p ast.Project, ms ast.ModuleState, obj ast.NodeID) returns String
	let written = writtenName(ms.tree(), e: obj)
	match consumes ast.nodeDecl(p, ms: ms, node: obj as Count) 'bound'
		some(ref) then return written if ref.module == c.modID else ast.inModule(p, modID: ref.module, name: written)
		none then return written
	end 'bound'
end 'writtenType'

// writtenName is a name, or a chain of member names, as the source writes it.
function writtenName(tree ast.Tree, e ast.NodeID) returns String
	if tree.kindOf(e) == ast.NodeKind.memberExpr 'member'
		return "{writtenName(tree, e: ast.memberExprObj(tree, id: e))}.{ast.memberExprName(tree, id: e)}"
	end 'member'
	return ast.nameExprName(tree, id: e).clone()
end 'writtenName'

// The members that give every case of an enum, or every name of the cases of an enum or a union, in the order they are
// declared. They are read before a case of the same name, as maxon reads them.
let allCasesMember = "allCases"

let allCaseNamesMember = "allCaseNames"

// checkCaseListMember types 'Type.allCases', an Array of the cases of an enum, and 'Type.allCaseNames', an Array with
// String of the names of the cases of an enum or a union. A union has no value for a case that carries a payload, so it has
// no 'allCases'.
function checkCaseListMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, obj ast.NodeID, member String, nt ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	var kind = ast.MemberKind.memberAllCaseNames
	var elem = p.builtins.stringTy
	if member == allCasesMember 'cases'
		if kindOfType(p, ms: ms, t: nt) == ast.TypeKind.unionTy 'union'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: obj), code: diag.errInvalidFieldAccess, msg: diag.allCasesOnUnion(), errs: errs)
			return ast.noType
		end 'union'
		kind = ast.MemberKind.memberAllCases
		elem = nt
	end 'cases'
	c.typing.members.insert(e as Count, value: ast.MemberInfo.make(kind, ownerTy: nt))
	var args = ast.TypeIDList.create(0)
	args.push(elem)
	let origin = p.builtins.arrayOrigin
	return instantiateGeneric(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), orig: origin, args: args, errs: errs)
end 'checkCaseListMember'

function checkCaseMember(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, member String, nt ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: e)
	let isEnum = kindOfType(p, ms: ms, t: nt) == ast.TypeKind.enumTy
	var word = unionWord
	if isEnum 'enumKind'
		word = enumWord
	end 'enumKind'
	let orig = ast.originOf(ms.types, reads: p.types, t: nt)
	var caseIndex = 0 as Count
	match consumes ast.typeEntry(ms.types, reads: p.types, t: orig).findCase(member) 'found'
		some(i) then caseIndex = i
		none then return unknownCase(c, off: exprOffset(c, p: p, ms: ms, node: e), word: word, member: member, errs: errs)
	end 'found'
	if not isEnum and ast.typeEntry(ms.types, reads: p.types, t: orig).cases[caseIndex].payload.count() > 0 'payload'
		checkFail(c.modID, off: off, code: diag.errCallArgCountMismatch, msg: "case '{member}' carries a payload: construct it with arguments", errs: errs)
		return ast.noType
	end 'payload'
	var kind = ast.MemberKind.memberUnionCase
	if isEnum 'enumCase'
		kind = ast.MemberKind.memberEnumCase
	end 'enumCase'
	var info = ast.MemberInfo.make(kind, ownerTy: nt)
	info.enumCase = caseIndex
	c.typing.members.insert(e as Count, value: info)
	return nt
end 'checkCaseMember'

function unknownCase(c Checker, off diag.U32, word String, member String, mutates errs diag.ErrorList) returns ast.TypeID
	checkFail(c.modID, off: off, code: diag.errEnumUnknownCase, msg: diag.enumUnknownCase(word, caseName: member), errs: errs)
	return ast.noType
end 'unknownCase'

// checkValueMember types a field of a record value, and '.name', '.ordinal' and '.rawValue' of an enum or a union value.
function checkValueMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let member = ast.memberExprName(ms.tree(), id: e).clone()
	let content = ast.contentType(ms.types, reads: p.types, t: t)
	if not requireNotCown(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), t: content, use: "reading '{member}'", errs: errs) 'cown'
		return ast.noType
	end 'cown'
	if typeHasKind(p, ms: ms, t: content, kind: ast.TypeKind.record) and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: content)).findField(member).isSome() 'field'
		return checkFieldMember(c, p: p, ms: ms, e: e, rt: content, member: member, errs: errs)
	end 'field'
	match consumes ast.builtinView(p.builtins, owner: ast.originOf(ms.types, reads: p.types, t: content), name: member) 'view'
		some(view) then return checkViewMember(c, p: p, ms: ms, e: e, t: content, member: member, view: view, errs: errs)
		none then _ = 0
	end 'view'
	if rawValuesUntyped(p, ms: ms, t: t) and member != "name" and member != "ordinal" 'untyped'
		return failRawUntyped(c, p: p, ms: ms, e: e, t: t, errs: errs)
	end 'untyped'
	match consumes rawBackingField(p, ms: ms, t: t, member: member) 'backing'
		some(index) then return checkRawFieldMember(c, p: p, ms: ms, e: e, t: t, index: index, errs: errs)
		none then _ = 0
	end 'backing'
	let k = kindOfType(p, ms: ms, t: t)
	if (k == ast.TypeKind.enumTy and (member == "name" or member == "ordinal" or member == "rawValue")) or (k == ast.TypeKind.unionTy and (member == "name" or member == "ordinal" or member == "rawValue")) 'builtinMember'
		return builtinMemberType(c, p: p, ms: ms, e: e, t: t, member: member, errs: errs)
	end 'builtinMember'
	if typeIsNominal(ms.types, reads: p.types, t: t) and methodNamed(p, ms: ms, t: t, name: member) != ast.noFunc 'method'
		failAt(c, p: p, ms: ms, node: e, code: diag.errUnsupported, msg: "a method value is not supported by minimaxon; call the method", errs: errs)
		return ast.noType
	end 'method'
	failAt(c, p: p, ms: ms, node: e, code: diag.errUnknownField, msg: diag.unknownField(nameOfType(p, ms: ms, t: t), fieldName: member), errs: errs)
	return ast.noType
end 'checkValueMember'

// checkFieldMember types 'record.field', which the module must be able to name.
function checkFieldMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, rt ast.TypeID, member String, mutates errs diag.ErrorList) returns ast.TypeID
	let index = fieldIndexNamed(p, ms: ms, rt: rt, name: member)
	let orig = ast.originOf(ms.types, reads: p.types, t: rt)
	let level = ast.typeEntry(ms.types, reads: p.types, t: orig).fields[index].level
	let owner = ast.typeEntry(ms.types, reads: p.types, t: orig).decl.module
	if not ast.isVisibleFrom(p, v: level, owner: owner, from: c.modID) 'hidden'
		failAt(c, p: p, ms: ms, node: e, code: diag.errFieldNotExported, msg: "field {ast.notVisible(p, name: "{nameOfType(p, ms: ms, t: rt)}.{member}", v: level, owner: owner, from: c.modID)}", errs: errs)
		return ast.noType
	end 'hidden'
	var info = ast.MemberInfo.make(ast.MemberKind.memberField, ownerTy: rt)
	info.fieldIndex = index
	c.typing.members.insert(e as Count, value: info)
	return ast.fieldType(ms.types, reads: p.types, owner: rt, index: index)
end 'checkFieldMember'

function builtinMemberType(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, t ast.TypeID, member String, mutates errs diag.ErrorList) returns ast.TypeID
	let isEnum = kindOfType(p, ms: ms, t: t) == ast.TypeKind.enumTy
	var kind = ast.MemberKind.memberUnionName
	var result = p.builtins.stringTy
	if member == "ordinal" 'ordinal'
		result = p.builtins.countTy
		kind = ast.MemberKind.memberUnionOrdinal
		if isEnum 'enumOrdinal'
			kind = ast.MemberKind.memberEnumOrdinal
		end 'enumOrdinal'
	end 'ordinal' else if member == "rawValue" 'raw'
		kind = ast.MemberKind.memberUnionRaw
		if isEnum 'enumRaw'
			kind = ast.MemberKind.memberEnumRaw
		end 'enumRaw'
		result = rawValueType(p, ms: ms, t: t)
		if result == ast.noType 'untyped'
			return failRawUntyped(c, p: p, ms: ms, e: e, t: t, errs: errs)
		end 'untyped'
	end 'raw' else if isEnum 'enumName'
		kind = ast.MemberKind.memberEnumName
	end 'enumName'
	c.typing.members.insert(e as Count, value: ast.MemberInfo.make(kind, ownerTy: t))
	return result
end 'builtinMemberType'

// rawValueType is the type of the raw value of an enum or a union: the type of the values the cases write, a String or a
// FullRangeFloat for the strings and floats, and for integers a Count, or a FullRangeInt where a case has a negative one.
function rawValueType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	if ast.typeEntry(ms.types, reads: p.types, t: orig).rawKind == ast.RawKind.value 'value'
		return ast.rawTypeOf(p, ms: ms, t: orig)
	end 'value'
	if ast.typeEntry(ms.types, reads: p.types, t: orig).rawKind == ast.RawKind.string 'string'
		return p.builtins.stringTy
	end 'string'
	if ast.typeEntry(ms.types, reads: p.types, t: orig).rawKind == ast.RawKind.float 'float'
		return p.builtins.fullRangeFloatTy
	end 'float'
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() 'each'
		if ast.typeEntry(ms.types, reads: p.types, t: orig).cases[i].rawValue.isNeg() 'negative'
			return p.builtins.fullRangeIntTy
		end 'negative'
	end 'each'
	return p.builtins.countTy
end 'rawValueType'

// fieldIndexNamed is the place of the field of that name among the fields of a record, which has one.
function fieldIndexNamed(p ast.Project, ms ast.ModuleState, rt ast.TypeID, name String) returns Count
	match ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: rt)).findField(name) 'field'
		some(i) then return i
		none then _ = 0
	end 'field'
	panic("'{ast.typeEntry(ms.types, reads: p.types, t: rt).name}' has no field '{name}'")
end 'fieldIndexNamed'

// instantiateInferred is the instance of a generic union that a case written without type arguments stands for, whose
// arguments come from where the case goes.
function instantiateInferred(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, obj ast.NodeID, ut ast.TypeID, member String, mutates errs diag.ErrorList) returns ast.TypeID
	let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: ut).typeParams)
	let own = ast.selfType(ms.types, reads: p.types, declTy: ut)
	let callee = "{nameOfType(p, ms: ms, t: ut)}.{member}"
	let mark = errs.count()
	let args = inferRest(c, p: p, ms: ms, node: obj, callee: callee, params: params, args: openArgs(params.count()), result: own, code: diag.errCannotInfer, errs: errs)
	if failedSince(errs, mark: mark) 'cannotInfer'
		return ast.noType
	end 'cannotInfer'
	return instantiateGeneric(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: obj), orig: ut, args: args, errs: errs)
end 'instantiateInferred'
