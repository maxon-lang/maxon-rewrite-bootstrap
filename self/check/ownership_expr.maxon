// The expressions of the ownership pass: where a value moves, where a place is changed, the calls whose arguments must
// not overlap, and the borrows an expression holds while the rest of it runs.

// readRoot is a use of a local's value, which needs one to exist.
function readRoot(mutates o Ownership, p ast.Project, ms ast.ModuleState, l ast.LocalID, site diag.U32, consumes s OwnState) returns OwnState
	if s.dead or not s.has(l) 'held'
		return s
	end 'held'
	let fact = s.factOf(l)
	let name = o.c.typing.locals[l as Count].name.clone()
	if fact.kind == OwnFactKind.factMoved and promiseUsedAgain(o, p: p, site: site, fact: fact) 'awaited'
		return without(s, l: l)
	end 'awaited'
	if fact.kind == OwnFactKind.factMoved 'moved'
		if site <= fact.site 'loop'
			fail(o, p: p, site: site, code: diag.errUseAfterMove, msg: diag.movedInEarlierIteration(name))
		end 'loop' else 'later'
			fail(o, p: p, site: site, code: diag.errUseAfterMove, msg: diag.useOfMovedValue(name))
		end 'later'
	end 'moved' else if fact.kind == OwnFactKind.factUninitialised 'uninitialised'
		fail(o, p: p, site: site, code: diag.errUseBeforeInit, msg: "'{name}' has no value here; assign it on every path before reading it")
	end 'uninitialised' else 'partly'
		let moved = moveText(o, p: p, ms: ms, m: fact.moves[0], root: l)
		fail(o, p: p, site: site, code: diag.errUseAfterMove, msg: "'{name}' lost '{moved}', which was moved into {fact.moves[0].dest.text()} at line {lineOf(o, p: p, ms: ms, site: fact.moves[0].site)}, so it cannot be used as a whole; use its other fields, or assign '{moved}' again first")
		return s
	end 'partly'
	return without(s, l: l)
end 'readRoot'

// consume is an expression whose value is stored, passed to a consumes parameter or returned. Code that can run marks
// the expression consumed, which is how lowering learns where a value changes owner. A scalar is copied, and a fresh
// value needs nothing. A place holding a managed value is moved out of, which only a whole local that owns its value
// allows; everything else is refused and says to copy.
function consume(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes dest OwnDest, consumes s OwnState) returns OwnState
	if ms.tree().kindOf(e) == ast.NodeKind.tryExpr and ast.isTransparent(ms.tree(), e: e) 'transparent'
		let added = enterTry(o, handles: not ast.propagates(ms.tree(), e: e))
		let after = consume(o, p: p, ms: ms, e: ast.tryExprE(ms.tree(), id: e), dest: dest, s: s)
		let entry = leaveTryEntry(o, added: added)
		handled(o, p: p, ms: ms, e: e, entry: entry)
		return after
	end 'transparent'
	if isView(o, ms: ms, e: e) 'view'
		return consume(o, p: p, ms: ms, e: ast.memberExprObj(ms.tree(), id: e), dest: dest, s: s)
	end 'view'
	var out = eval(o, p: p, ms: ms, e: e, s: s)
	if out.dead 'dead'
		return out
	end 'dead'
	if ms.tree().kindOf(e) == ast.NodeKind.asyncExpr 'async'
		out = takePending(o, p: p, ms: ms, e: e, dest: dest, s: out)
	end 'async'
	o.c.typing.consumed.insert(e as Count, value: true)
	let t = ownType(o, node: e)
	if ast.isFunctionType(ms.types, reads: p.types, t: t) and dest.kind != OwnDestKind.destClosure and dest.kind != OwnDestKind.destBinding and dest.kind != OwnDestKind.destCast and dest.kind != OwnDestKind.destBranch 'escapes'
		requireNoBorrows(o, p: p, ms: ms, e: e, what: "moved into {dest.text()}")
	end 'escapes'
	if holdsBorrow(p, ms: ms, t: t) 'borrows'
		requireBorrowsStay(o, p: p, ms: ms, e: e, dest: dest)
	end 'borrows'
	if not isManagedOwn(p, ms: ms, t: t) or ast.sharesOnCopy(ms.types, reads: p.types, t: t) 'scalar'
		return out
	end 'scalar'
	let projection = projectionOf(o, ms: ms, e: e)
	if projection != 0 'projection'
		moveOfProjection(o, p: p, ms: ms, e: e, call: projection, t: t, dest: dest)
		return out
	end 'projection'
	if lacksDroppable(o, p: p, ms: ms, t: t) 'inFlight'
		o.inFlight.push(e)
	end 'inFlight'
	let site = offsetOfOwn(o, p: p, ms: ms, node: e)
	let path = pathOf(o, p: p, ms: ms, e: e)
	if not path.isPlace() 'fresh'
		if projectsElement(o, p: p, ms: ms, e: e) 'element'
			fail(o, p: p, site: site, code: diag.errMoveOutOfField, msg: "an element of a collection that is not stored in a variable cannot be moved out of it into {dest.text()}; bind the collection to a variable and take the element out of it, or copy it")
		end 'element' else if ast.isStorage(ms.tree(), typing: o.c.typing, node: e) 'part'
			let advice = copyAdvice(o, p: p, ms: ms, t: t, ifCopyable: "copy it with '.clone()'", fallback: "")
			let fix = cloneFixIf(o, p: p, ms: ms, e: e, t: t)
			failFixed(o, p: p, site: site, code: diag.errMoveOutOfField, msg: "a part of a temporary value cannot be moved out of it into {dest.text()}, because the temporary is dropped when the statement ends; {advice}", fix: fix)
		end 'part'
		return out
	end 'fresh'
	let text = pathText(o, p: p, ms: ms, path: path)
	if path.crossesFrozen() 'frozen'
		let advice = copyAdvice(o, p: p, ms: ms, t: t, ifCopyable: "use '{text}.clone()'", fallback: "")
		fail(o, p: p, site: site, code: diag.errMoveOutOfField, msg: "'{text}' is part of a frozen value, which keeps its contents and shares them with its other owners, so it cannot be moved out of it into {dest.text()}; {advice}")
		return out
	end 'frozen'
	if isBorrowed(o.c.typing.locals[path.root as Count]) and ast.isPromiseType(ms.types, reads: p.types, t: t) 'borrowedPromise'
		let root = o.c.typing.locals[path.root as Count].clone()
		var fix = diag.Fix.none()
		if root.isParam and not root.isSelf and root.conv == ast.Convention.convLet and path.steps.count() == 0 'whole'
			fix = conventionFix(ms.tree(), param: root.definedAt, keyword: fixKindConsumes)
		end 'whole'
		failFixed(o, p: p, site: site, code: diag.errPromiseBorrowed, msg: "'{text}' is a promise this function only borrows, so it cannot be moved into {dest.text()}: a promise has one owner, which awaits it; take the parameter 'consumes' to own the promise", fix: fix)
		return out
	end 'borrowedPromise'
	if isBorrowed(o.c.typing.locals[path.root as Count]) 'borrowed'
		let advice = copyAdvice(o, p: p, ms: ms, t: t, ifCopyable: "use '{text}.clone()' to give it its own copy", fallback: "")
		let fix = borrowedMoveFix(o, p: p, ms: ms, e: e, t: t, path: path)
		failFixed(o, p: p, site: site, code: diag.errMoveOutOfBorrow, msg: "'{text}' is borrowed, not owned, so it cannot be moved into {dest.text()}; {advice}", fix: fix)
		return out
	end 'borrowed'
	if path.crossesElement() 'element'
		let advice = copyAdvice(o, p: p, ms: ms, t: t, ifCopyable: "use '{text}.clone()'", fallback: "take it out of the collection with its remove method")
		let fix = cloneFixIf(o, p: p, ms: ms, e: e, t: t)
		failFixed(o, p: p, site: site, code: diag.errMoveOutOfField, msg: "'{text}' is, or lies inside, an element of a collection, which owns it, so it cannot be moved out of it into {dest.text()}; {advice}", fix: fix)
		return out
	end 'element'
	if path.steps.count() > 0 'part'
		return movePart(o, p: p, ms: ms, e: e, path: path, dest: dest, s: out)
	end 'part'
	if o.c.typing.locals[path.root as Count].isSelf and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: o.fn).isDestructor and dest.kind != OwnDestKind.destDestructor and dest.kind != OwnDestKind.destMatch 'destructor'
		fail(o, p: p, site: site, code: diag.errDestructorMisuse, msg: "'self' is moved into {dest.text()}, but inside a destructor it may only be passed whole to another destructor of its type, which ends it there; move its fields out instead, or call a destructor")
		return out
	end 'destructor'
	requireNotProjected(o, p: p, ms: ms, path: path, site: site)
	requireUnlent(o, p: p, ms: ms, root: path.root, site: site, s: out)
	let released = releaseHolder(o, p: p, root: path.root, site: site, dest: dest, s: out)
	return withFact(released, fact: OwnFact.make(path.root, site: site, kind: OwnFactKind.factMoved, dest: dest))
end 'consume'

// moveOfProjection refuses to move a part of a borrowed result, which its function lends from its arguments: E3900 where
// what it lends from is itself borrowed, and E3901 where it is a part of a value that stays where it is, as for an element.
function moveOfProjection(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, call ast.NodeID, t ast.TypeID, dest OwnDest)
	let name = projectionName(o, p: p, ms: ms, call: call)
	let lent = lentPaths(o, p: p, ms: ms, e: e)
	var code = diag.errMoveOutOfField
	if lent.count() > 0 and isBorrowed(o.c.typing.locals[lent[0].root as Count]) 'borrowed'
		code = diag.errMoveOutOfBorrow
	end 'borrowed'
	let advice = copyAdvice(o, p: p, ms: ms, t: t, ifCopyable: "copy it with '.clone()'", fallback: "declare '{name}' 'returns T' to give a value")
	let fix = cloneFixIf(o, p: p, ms: ms, e: e, t: t)
	failFixed(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: e), code: code, msg: "'{name}' returns a place it borrows from its arguments, not a value of its own, so it cannot be moved into {dest.text()}; {advice}", fix: fix)
end 'moveOfProjection'

// changesProjection refuses a change to a part of a borrowed result, which its function lends only to be read, and says
// whether e is one. what is how the change is said.
function changesProjection(mutates o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID, site diag.U32, what String) returns bool
	let call = projectionOf(o, ms: ms, e: e)
	if call == 0 'notProjection'
		return false
	end 'notProjection'
	let name = projectionName(o, p: p, ms: ms, call: call)
	fail(o, p: p, site: site, code: diag.errAssignToImmutable, msg: "'{name}' returns a borrowed place to be read, so what it gives cannot be {what}; change the place it borrows from instead, or change a copy: 'var x = {name}(...).clone()'")
	return true
end 'changesProjection'

// borrowedMoveFix is the change that lets a borrowed value be stored: a copy when its type can be copied, the bound that
// lets it be copied when only a type parameter's lack of one stops it, which keeps maxon's copy and the caller's value, and
// otherwise, for a parameter given whole, taking it with consumes, which is the move of the whole value the message asks for.
// In a method of an extension of an interface consumes comes first: a bound there withholds the method from every conformer
// that binds the associated type to an interface value, which cannot be copied.
function borrowedMoveFix(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, path AccessPath) returns diag.Fix
	let lacking = lacksCap(o.c, p: p, ms: ms, wantCopy: true, t: t)
	if not lacking.missing 'copy'
		return cloneFix(ms.tree(), e: e)
	end 'copy'
	let root = o.c.typing.locals[path.root as Count].clone()
	let whole = root.isParam and not root.isSelf and root.conv == ast.Convention.convLet and path.steps.count() == 0
	if whole and o.fn != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: o.fn).extendedIface != ast.noType 'ofInterface'
		return conventionFix(ms.tree(), param: root.definedAt, keyword: fixKindConsumes)
	end 'ofInterface'
	let bound = lackBoundFix(p, ms: ms, fn: o.fn, info: lacking, capName: "Copyable")
	if bound.isSome() 'bound'
		return bound
	end 'bound'
	if whole 'whole'
		return conventionFix(ms.tree(), param: root.definedAt, keyword: fixKindConsumes)
	end 'whole'
	return diag.Fix.none()
end 'borrowedMoveFix'

// requireWritable refuses a change to a place that is not mutable, and one that a match binding still borrows.
function requireWritable(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, path AccessPath)
	requireWritableFor(o, p: p, ms: ms, site: site, path: path, call: ast.noType)
end 'requireWritable'

// requireWritableFor is requireWritable for a change that is a call of the value at path, of the function type call that
// mutates its captures, or for a plain change when call is none.
function requireWritableFor(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, path AccessPath, call ast.TypeID)
	if requireMutable(o, p: p, ms: ms, site: site, path: path, call: call) 'mutable'
		requireNotProjected(o, p: p, ms: ms, path: path, site: site)
	end 'mutable'
end 'requireWritableFor'

// requireMutable refuses a change to a place that is not mutable, and says whether it is. A part of the variable of a for
// is a part of the element it borrows, so it is as mutable as that part of the collection. A call of a value whose type
// call mutates its captures changes the value, so it is refused where a change is, saying so.
function requireMutable(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, path AccessPath, call ast.TypeID) returns bool
	let root = o.c.typing.locals[path.root as Count].clone()
	let text = pathText(o, p: p, ms: ms, path: path)
	if path.crossesFrozen() 'frozen'
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: diag.Fix.none(), code: diag.errFrozenChange, msg: "'{text}' is part of a frozen value, whose contents are immutable and shared with its other owners; change a copy instead: 'var c = thaw(...)'")
		return false
	end 'frozen'
	if (isForVariable(ms.tree(), l: root) or root.projected) and path.steps.count() == 0 'forVariable'
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: diag.Fix.none(), code: diag.errAssignToImmutable, msg: diag.letReassigned(root.name))
		return false
	end 'forVariable'
	if root.projected and path.steps.count() > 0 'part'
		match consumes lenderOf(o, local: path.root) 'lender'
			some(collection) then return requireMutable(o, p: p, ms: ms, site: site, path: throughElement(collection, path: path), call: call)
			none then _ = 0
		end 'lender'
	end 'part'
	if root.projected 'projected'
		let advice = copyAdvice(o, p: p, ms: ms, t: root.ty, ifCopyable: "copy it into a var first: 'var x = {root.name}.clone()'", fallback: "change the subject itself instead of a binding of it")
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: diag.Fix.none(), code: diag.errAssignToImmutable, msg: "'{root.name}' borrows part of {lenderName(o, p: p, ms: ms, root: root)} and cannot be changed; {advice}")
		return false
	end 'projected'
	for i in 0 upto path.steps.count() 'steps'
		if not path.steps[i].isElement() and not fieldIsVar(p, ms: ms, step: path.steps[i]) 'letField'
			mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: diag.Fix.none(), code: diag.errAssignToImmutable, msg: diag.letFieldReassigned(fieldName(p, ms: ms, step: path.steps[i])))
			return false
		end 'letField'
	end 'steps'
	if root.isCapture and not isMutableLocal(root) 'capture'
		if ast.funcMutatesCaptures(ms.types, reads: p.types, t: o.closureTy) 'immutable'
			mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: diag.Fix.none(), code: diag.errAssignToImmutable, msg: "'{root.name}' is borrowed where the closure captures it, so even a closure that mutates its captures only reads it; a mutating closure changes what it owns, a 'var', a 'mutates' parameter or 'mutates self'")
			return false
		end 'immutable'
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: diag.Fix.none(), code: diag.errCapabilityConversion, msg: diag.writesCaptures(nameOfType(p, ms: ms, t: o.closureTy)))
		return false
	end 'capture'
	if root.isSelf and not isMutableLocal(root) 'self'
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: mutatesSelfFix(ms.tree(), method: root.definedAt), code: diag.errAssignToImmutable, msg: "'{text}' cannot be changed because 'self' is not mutable here; declare the method with 'mutates self'")
		return false
	end 'self'
	if root.isParam and root.conv == ast.Convention.convLet 'let'
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: conventionFix(ms.tree(), param: root.definedAt, keyword: fixKindMutates), code: diag.errAssignToImmutable, msg: "'{text}' cannot be changed because '{root.name}' is a let parameter; write 'mutates' before it to change the caller's value, or copy it into a var")
		return false
	end 'let'
	if root.isParam and ast.ownsValue(root.conv) 'owns'
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: diag.Fix.none(), code: diag.errAssignToImmutable, msg: "'{text}' cannot be changed because '{root.name}' is a '{root.conv.keyword()}' parameter; move it into a var first")
		return false
	end 'owns'
	if not isMutableLocal(root) 'immutable'
		mutableFail(o, p: p, ms: ms, site: site, call: call, text: text, fix: varFix(ms.tree(), stmt: root.definedAt), code: diag.errAssignToImmutable, msg: diag.letReassigned(root.name))
		return false
	end 'immutable'
	return true
end 'requireMutable'

// mutableFail reports why the place text cannot be changed: for a call of a value whose type mutates its captures, as why
// that call needs it mutable.
function mutableFail(mutates o Ownership, p ast.Project, ms ast.ModuleState, site diag.U32, call ast.TypeID, text String, consumes fix diag.Fix, code String, consumes msg String)
	if call == ast.noType 'change'
		failFixed(o, p: p, site: site, code: code, msg: msg, fix: fix)
		return
	end 'change'
	var advice = ""
	if fix.kind == fixKindVar 'var'
		advice = "; declare it with 'var'"
	end 'var'
	failFixed(o, p: p, site: site, code: code, msg: "calling '{text}' changes the state its closure holds, since '{nameOfType(p, ms: ms, t: call)}' mutates captures, so it needs a place that may be changed: {msg}{advice}", fix: fix)
end 'mutableFail'

// lenderOf is the collection that the variable of an enclosing for borrows its elements from: none for any other local,
// and for one over a temporary.
function lenderOf(o Ownership, local ast.LocalID) returns table.Option with AccessPath
	for i in 0 upto o.lenders.count() 'each'
		if o.lenders[i].local == local 'found'
			return table.Option.some(o.lenders[i].collection.clone())
		end 'found'
	end 'each'
	return table.Option.none
end 'lenderOf'

// throughElement is a part of the variable of a for as the same part of the element it borrows from the collection.
function throughElement(collection AccessPath, path AccessPath) returns AccessPath
	var out = collection.clone()
	out.steps.push(PathStep.element(0 as ast.NodeID))
	for i in 0 upto path.steps.count() 'each'
		out.steps.push(path.steps[i].clone())
	end 'each'
	return out
end 'throughElement'

// lenderName says what a local that borrows lends from: the variable of a for borrows an element of its collection, and
// any other is a binding of a match.
function lenderName(o Ownership, p ast.Project, ms ast.ModuleState, root ast.LocalEntry) returns String
	if isForVariable(ms.tree(), l: root) 'loop'
		return "the collection the loop walks"
	end 'loop'
	return "the match subject"
end 'lenderName'

// isForVariable is whether a local is the variable of a for: a count, or each element of a collection in turn, which a
// local that borrows is unless it is a binding of a match.
function isForVariable(tree ast.Tree, l ast.LocalEntry) returns bool
	return l.definedAt != 0 and tree.kindOf(l.definedAt) == ast.NodeKind.forStmt
end 'isForVariable'

// requireNotProjected refuses a change or a move of a place while a binding of an enclosing match, or a place that an
// enclosing expression holds, still borrows part of it.
function requireNotProjected(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, path AccessPath, site diag.U32)
	for i in 0 upto o.projections.count() 'each'
		let place = o.projections[i].place
		if place != 0 'find'
			let found = pathOf(o, p: p, ms: ms, e: place)
			o.projections[i].subject = found
			o.projections[i].place = 0 as ast.NodeID
		end 'find'
		if not o.projections[i].subject.isPlace() or not o.projections[i].subject.overlaps(path) 'apart'
			continue 'each'
		end 'apart'
		if o.projections[i].kind == OwnProjectionKind.projectCapture and path.steps.count() > 0 'part'
			continue 'each'
		end 'part'
		let pr = o.projections[i].clone()
		projectionConflict(o, p: p, ms: ms, pr: pr, path: path, site: site)
		return
	end 'each'
end 'requireNotProjected'

function projectionConflict(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, pr OwnProjection, path AccessPath, site diag.U32)
	let text = pathText(o, p: p, ms: ms, path: path)
	let held = pathText(o, p: p, ms: ms, path: pr.subject)
	let k = pr.kind
	if k == OwnProjectionKind.projectMatch 'match'
		let advice = copyAdvice(o, p: p, ms: ms, t: pr.ty, ifCopyable: "copy the payload out with '.clone()' before changing it", fallback: "change it after the match")
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{text}' is borrowed by a binding of an enclosing match on '{held}'; {advice}")
		return
	end 'match'
	if k == OwnProjectionKind.projectArgument 'argument'
		let advice = copyAdvice(o, p: p, ms: ms, t: pr.ty, ifCopyable: "pass a copy: '{held}.clone()'", fallback: "compute this first into a variable")
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{text}' is borrowed by the argument '{held}', which the enclosing call holds while this runs; {advice}")
		return
	end 'argument'
	if k == OwnProjectionKind.projectTarget 'target'
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{held}' is the target of an assignment whose value is still being computed, and this changes it; compute the value into a variable first")
		return
	end 'target'
	if k == OwnProjectionKind.projectOperand 'operand'
		let advice = copyAdvice(o, p: p, ms: ms, t: pr.ty, ifCopyable: "compare a copy: '{held}.clone()'", fallback: "compute this first into a variable")
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{text}' is borrowed by the operand '{held}', which the enclosing comparison holds while its other operand is evaluated; {advice}")
		return
	end 'operand'
	if k == OwnProjectionKind.projectCollection 'collection'
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{text}' is borrowed by '{held}', the collection of an enclosing subscript, which holds it while the index is evaluated; compute the index first into a variable")
		return
	end 'collection'
	if k == OwnProjectionKind.projectPart 'part'
		let advice = copyAdvice(o, p: p, ms: ms, t: pr.ty, ifCopyable: "interpolate a copy: '{held}.clone()'", fallback: "compute this first into a variable")
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{text}' is borrowed by the part '{held}' of an enclosing string, which holds it while the next part is evaluated; {advice}")
		return
	end 'part'
	if k == OwnProjectionKind.projectLoop 'loop'
		let advice = copyAdvice(o, p: p, ms: ms, t: pr.ty, ifCopyable: "loop over a copy: 'for x in {held}.clone()'", fallback: "change it after the loop")
		failCaused(o, p: p, site: site, code: diag.errExclusivity, msg: "'{text}' is borrowed by the enclosing loop over '{held}', which lends its elements while the body runs; {advice}", cause: diag.ErrorCause.loopHoldsCollection)
		return
	end 'loop'
	if k == OwnProjectionKind.projectCapture 'capture'
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{held}' is borrowed by {pr.holder}, a function value that reads it when it is called, so it cannot be replaced while that lives; change its fields instead, or replace it after the function value's scope ends")
		return
	end 'capture'
	if k == OwnProjectionKind.projectBorrow 'borrow'
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{held}' is borrowed by {pr.holder}, which holds a borrow of it until its scope ends, so '{text}' cannot be changed or moved here; change it after that scope, or end the borrowing value in a block of its own")
		return
	end 'borrow'
	if k == OwnProjectionKind.projectMutableCapture 'mutableCapture'
		fail(o, p: p, site: site, code: diag.errExclusivity, msg: "'{held}' is borrowed to be changed by {pr.holder}, a mutating closure that lives until its scope ends, so it cannot be changed here; change it after that, or through the closure")
		return
	end 'mutableCapture'
	panic("ownership: unknown projection kind {k.name}")
end 'projectionConflict'

// expr is an expression whose value is only read: a fresh value is a temporary that is dropped when the statement ends.
function expr(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let out = eval(o, p: p, ms: ms, e: e, s: s)
	requireTemporaryDroppable(o, p: p, ms: ms, e: e, s: out, kind: OwnDropKind.dropTemporary)
	return out
end 'expr'

// eval checks an expression and leaves what happens to its value to the caller.
function eval(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let mark = o.inFlight.count()
	let out = visitExprOwn(o, p: p, ms: ms, e: e, s: s)
	land(o, mark: mark)
	return out
end 'eval'

function visitExprOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let k = ms.tree().kindOf(e)
	if k == ast.NodeKind.intLit or k == ast.NodeKind.floatLit or k == ast.NodeKind.boolLit or k == ast.NodeKind.byteStrLit or k == ast.NodeKind.typeQueryExpr 'literal'
		return s
	end 'literal'
	if k == ast.NodeKind.selfExpr 'self'
		return readRoot(o, p: p, ms: ms, l: selfLocalOf(o, p: p, ms: ms), site: offsetOfOwn(o, p: p, ms: ms, node: e), s: s)
	end 'self'
	if k == ast.NodeKind.strLit 'str'
		return strLitOwn(o, p: p, ms: ms, e: e, s: s)
	end 'str'
	if k == ast.NodeKind.nameExpr 'name'
		return nameExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'name'
	if k == ast.NodeKind.binaryExpr 'binary'
		return binaryExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'binary'
	if k == ast.NodeKind.unaryExpr 'unary'
		let out = expr(o, p: p, ms: ms, e: ast.unaryExprE(ms.tree(), id: e), s: s)
		return failed(o, p: p, ms: ms, e: e, s: out)
	end 'unary'
	if k == ast.NodeKind.asyncExpr 'async'
		return asyncExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'async'
	if k == ast.NodeKind.awaitExpr 'await'
		return awaitExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'await'
	if k == ast.NodeKind.spawnExpr 'spawn'
		var out = s
		let capacity = ast.spawnExprCapacity(ms.tree(), id: e)
		if capacity != 0 'capacity'
			out = expr(o, p: p, ms: ms, e: ast.argValue(ms.tree(), id: capacity), s: out)
		end 'capacity'
		// What the factory makes moves into the service.
		return consume(o, p: p, ms: ms, e: ast.spawnExprCall(ms.tree(), id: e), dest: OwnDest.make(OwnDestKind.destParameter, name: "the state of the service"), s: out)
	end 'spawn'
	if k == ast.NodeKind.castExpr 'cast'
		let operand = ast.castExprE(ms.tree(), id: e)
		if typeHasKind(p, ms: ms, t: ownType(o, node: e), kind: ast.TypeKind.interfaceTy) or typeHasKind(p, ms: ms, t: ownType(o, node: operand), kind: ast.TypeKind.interfaceTy) 'interface'
			// A cast to an interface puts the value in a new box, and a cast of an interface value to a type takes it out of
			// its box, so the operand moves either way.
			let moved = consume(o, p: p, ms: ms, e: operand, dest: OwnDest.of(OwnDestKind.destCast), s: s)
			return failed(o, p: p, ms: ms, e: e, s: moved)
		end 'interface'
		if ast.castRebrands(ms.types, reads: p.types, target: ownType(o, node: e)) 'rebrand'
			// The cast gives the same value, which the value it makes shares or takes over.
			return consume(o, p: p, ms: ms, e: operand, dest: OwnDest.of(OwnDestKind.destCast), s: s)
		end 'rebrand'
		let out = expr(o, p: p, ms: ms, e: operand, s: s)
		return failed(o, p: p, ms: ms, e: e, s: out)
	end 'cast'
	if k == ast.NodeKind.condExpr 'cond'
		return condExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'cond'
	if k == ast.NodeKind.callExpr 'call'
		return callExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'call'
	if k == ast.NodeKind.indexExpr 'index'
		return subscript(o, p: p, ms: ms, e: e, s: s)
	end 'index'
	if k == ast.NodeKind.memberExpr 'member'
		return memberExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'member'
	if k == ast.NodeKind.structLitExpr or k == ast.NodeKind.tupleExpr 'structLit'
		return structLitOwn(o, p: p, ms: ms, e: e, s: s)
	end 'structLit'
	if k == ast.NodeKind.collectionLitExpr 'collectionLit'
		return collectionLitOwn(o, p: p, ms: ms, e: e, s: s)
	end 'collectionLit'
	if k == ast.NodeKind.fromExpr 'from'
		return expr(o, p: p, ms: ms, e: ast.fromExprValue(ms.tree(), id: e), s: s)
	end 'from'
	if k == ast.NodeKind.matchExpr 'match'
		return matchOwn(o, p: p, ms: ms, core: ast.matchExprMatch(ms.tree(), id: e), s: s)
	end 'match'
	if k == ast.NodeKind.panicExpr 'panic'
		return expr(o, p: p, ms: ms, e: ast.panicExprMessage(ms.tree(), id: e), s: s)
	end 'panic'
	if k == ast.NodeKind.tryExpr 'try'
		return tryExprOwn(o, p: p, ms: ms, e: e, s: s)
	end 'try'
	if k == ast.NodeKind.closureExpr 'closure'
		return closureOwn(o, p: p, ms: ms, e: e, s: s)
	end 'closure'
	panic("ownership: the node {e} of kind {k.name} is no expression")
end 'visitExprOwn'

// strLitOwn holds a first part that is a string while the second is evaluated: lowering joins the parts from the left,
// and joins the first with the second once both exist. Every later part is joined as soon as it is evaluated, so none of
// them is held, and a part that is not a string is turned into one as soon as it is evaluated.
function strLitOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let parts = ast.strLitPartsRef(ms.tree(), id: e)
	let n = ms.tree().strPartCount(parts)
	let held = o.projections.count()
	var out = s
	for i in 0 upto n 'parts'
		let part = partExpr(ms.tree(), parts: parts, index: i)
		if part != 0 'expr'
			out = expr(o, p: p, ms: ms, e: part, s: out)
		end 'expr'
		if i == 0 and n > 1 'first'
			holdText(o, p: p, ms: ms, first: part, second: partExpr(ms.tree(), parts: parts, index: 1))
		end 'first' else if i == 1 'second'
			release(o, mark: held)
		end 'second'
	end 'parts'
	return out
end 'strLitOwn'

// partExpr is the expression of a part of a string, or 0 for a part that is text.
function partExpr(tree ast.Tree, parts diag.U32, index Count) returns ast.NodeID
	if tree.strPartIsExpr(parts, index: index) 'expr'
		return tree.strPartExpr(parts, index: index)
	end 'expr'
	return 0 as ast.NodeID
end 'partExpr'

// holdText holds the first part of an interpolated string while the second is evaluated, when the first is a string and
// a second part runs after it.
function holdText(mutates o Ownership, p ast.Project, ms ast.ModuleState, first ast.NodeID, second ast.NodeID)
	if first != 0 and second != 0 and not runsNoCode(ms.tree(), e: second) and ast.contentType(ms.types, reads: p.types, t: ownType(o, node: first)) == p.builtins.stringTy 'held'
		hold(o, p: p, ms: ms, place: first, kind: OwnProjectionKind.projectPart, byAddress: false)
	end 'held'
end 'holdText'

function nameExprOwn(mutates o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let name = ownName(o, node: e)
	let site = offsetOfOwn(o, p: p, ms: ms, node: e)
	if name.kind == ast.NameKind.nameLocal 'local'
		requireNotMutablyHeld(o, p: p, local: name.local, site: site)
		requireUnlentRead(o, p: p, ms: ms, root: name.local, site: site, s: s)
		return readRoot(o, p: p, ms: ms, l: name.local, site: site, s: s)
	end 'local'
	if name.kind == ast.NameKind.nameSelfField 'selfField'
		requireNotMutablyHeld(o, p: p, local: selfLocalOf(o, p: p, ms: ms), site: site)
		if o.partials > 0 and readPart(o, p: p, ms: ms, e: e, s: s) 'part'
			return s
		end 'part'
		return readRoot(o, p: p, ms: ms, l: selfLocalOf(o, p: p, ms: ms), site: site, s: s)
	end 'selfField'
	if name.kind == ast.NameKind.nameConst or name.kind == ast.NameKind.nameFunc 'value'
		return s
	end 'value'
	panic("ownership: unresolved name '{ast.nameExprName(ms.tree(), id: e)}'")
end 'nameExprOwn'

// binaryExprOwn walks an operator and the operators nested in its left operand, innermost first, so that a long chain
// takes no stack. Each operator that is the left operand of the next ends as expr ends it: the values it left in flight
// are taken, and a temporary it made must be one that can be dropped. All of them began at the same count of values in
// flight, because nothing runs between one operator and its left operand.
function binaryExprOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let mark = o.inFlight.count()
	var chain = ast.leftChain(ms.tree(), e: e)
	var node = ast.nextOperator(chain, e: e)
	var state = expr(o, p: p, ms: ms, e: ast.binaryExprL(ms.tree(), id: node), s: s)
	while node != e 'inner'
		state = operatorOwn(o, p: p, ms: ms, e: node, s: state)
		land(o, mark: mark)
		requireTemporaryDroppable(o, p: p, ms: ms, e: node, s: state, kind: OwnDropKind.dropTemporary)
		node = ast.nextOperator(chain, e: e)
	end 'inner'
	return operatorOwn(o, p: p, ms: ms, e: e, s: state)
end 'binaryExprOwn'

// operatorOwn holds a managed left operand, which only a string comparison has, while the right is evaluated: lowering
// compares the two strings once both are computed. The state s is the one after the left operand.
function operatorOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let op = ast.binaryExprOp(ms.tree(), id: e)
	let l = ast.binaryExprL(ms.tree(), id: e)
	let r = ast.binaryExprR(ms.tree(), id: e)
	if (op == "and" or op == "or") and ownType(o, node: e) == p.builtins.boolTy 'logical'
		// The right operand runs only when the left one does not decide.
		let right = expr(o, p: p, ms: ms, e: r, s: s.clone())
		return join(o, p: p, ms: ms, a: s, b: right)
	end 'logical'
	let held = o.projections.count()
	holdAcross(o, p: p, ms: ms, place: l, kind: OwnProjectionKind.projectOperand, next: r)
	let right = expr(o, p: p, ms: ms, e: r, s: s)
	release(o, mark: held)
	return failed(o, p: p, ms: ms, e: e, s: right)
end 'operatorOwn'

// failed is the failure of an operator or a cast that the range analysis could not rule out. An operator that the
// checker gave no arithmetic, a comparison of two strings among them, cannot fail.
function failed(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let fails = match o.c.typing.arith.get(e as Count) 'arith'
		some(info) gives info.fails
		none gives ast.failNone
	end 'arith'
	if fails != ast.failNone 'fails'
		failure(o, p: p, ms: ms, site: offsetOfOwn(o, p: p, ms: ms, node: e), s: s)
	end 'fails'
	return s
end 'failed'

// condExprOwn moves from each branch alone: the value it gives is a fresh one, so a place in a branch is moved.
function condExprOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let cond = expr(o, p: p, ms: ms, e: ast.condExprCond(ms.tree(), id: e), s: s)
	let mark = o.inFlight.count()
	let yes = consume(o, p: p, ms: ms, e: ast.condExprThen(ms.tree(), id: e), dest: OwnDest.of(OwnDestKind.destBranch), s: cond.clone())
	land(o, mark: mark)
	let no = consume(o, p: p, ms: ms, e: ast.condExprElse(ms.tree(), id: e), dest: OwnDest.of(OwnDestKind.destBranch), s: cond)
	return join(o, p: p, ms: ms, a: yes, b: no)
end 'condExprOwn'

function callExprOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let call = ownCall(o, node: e)
	let receiver = ast.callReceiver(ms.tree(), e: e, kind: call.kind)
	let k = call.kind
	if k == ast.CallKind.callCopy 'copy'
		if ast.isFunctionType(ms.types, reads: p.types, t: ownType(o, node: receiver)) 'function'
			requireNoBorrows(o, p: p, ms: ms, e: receiver, what: "copied with 'clone()'")
		end 'function'
		return expr(o, p: p, ms: ms, e: receiver, s: s)
	end 'copy'
	if k == ast.CallKind.callPrint or k == ast.CallKind.callPrintError 'print'
		return expr(o, p: p, ms: ms, e: call.ordered[0], s: s)
	end 'print'
	if k == ast.CallKind.callUnionCtor 'unionCtor'
		let orig = ast.originOf(ms.types, reads: p.types, t: call.unionTy)
		var out = s
		for i in 0 upto call.ordered.count() 'args'
			let name = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[call.unionCase].payload[i].name.clone()
			out = consume(o, p: p, ms: ms, e: call.ordered[i], dest: OwnDest.make(OwnDestKind.destField, name: name), s: out)
		end 'args'
		return out
	end 'unionCtor'
	if k == ast.CallKind.callFunction or k == ast.CallKind.callStatic or k == ast.CallKind.callMethod or k == ast.CallKind.callBound 'user'
		return userCall(o, p: p, ms: ms, site: offsetOfOwn(o, p: p, ms: ms, node: e), call: call, receiver: receiver, s: s)
	end 'user'
	if k == ast.CallKind.callSend 'send'
		// The handle is read, every argument moves into the service, and the send can fail: the arguments are gone either
		// way.
		return passArguments(o, p: p, ms: ms, site: offsetOfOwn(o, p: p, ms: ms, node: e), call: call, receiver: receiver, fails: true, s: s)
	end 'send'
	if k == ast.CallKind.callValue 'value'
		let callee = ast.callExprCallee(ms.tree(), id: e)
		let held = o.projections.count()
		let out = expr(o, p: p, ms: ms, e: callee, s: s)
		requireCallable(o, p: p, ms: ms, callee: callee)
		hold(o, p: p, ms: ms, place: callee, kind: OwnProjectionKind.projectArgument, byAddress: false)
		let after = userCall(o, p: p, ms: ms, site: offsetOfOwn(o, p: p, ms: ms, node: e), call: call, receiver: 0 as ast.NodeID, s: out)
		release(o, mark: held)
		return after
	end 'value'
	panic("ownership: unresolved call")
end 'callExprOwn'

// callError is the error that the function a call runs throws, or noType for a call that cannot fail.
function callError(p ast.Project, ms ast.ModuleState, call ast.CallInfo) returns ast.TypeID
	if call.kind == ast.CallKind.callBound 'bound'
		return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: call.method).errTy
	end 'bound'
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: call.fn).errTy
end 'callError'

function userCall(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, call ast.CallInfo, receiver ast.NodeID, consumes s OwnState) returns OwnState
	return passArguments(o, p: p, ms: ms, site: site, call: call, receiver: receiver, fails: callError(p, ms: ms, call: call) != ast.noType, s: s)
end 'userCall'

// passArguments passes a call its receiver and arguments, each as its parameter takes it, and fails at site where fails
// says the callee can fail there.
function passArguments(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, call ast.CallInfo, receiver ast.NodeID, fails bool, consumes s OwnState) returns OwnState
	var exclusive = receiver != 0 and call.selfConv != ast.Convention.convLet
	for i in 0 upto call.paramSpecs.count() 'specs'
		exclusive = exclusive or call.paramSpecs[i].conv != ast.Convention.convLet or ms.tree().kindOf(call.ordered[i]) == ast.NodeKind.closureExpr
	end 'specs'
	if exclusive and not ast.intrinsicMayOverlap(call.intrinsic) 'exclusive'
		requireExclusive(o, p: p, ms: ms, call: call, receiver: receiver)
	end 'exclusive'
	let held = o.projections.count()
	let arguments = o.inFlight.count()
	let outer = exchange(o.initialising, value: ast.LocalIDList.create(0))
	var out = s
	let n = call.ordered.count()
	if receiver != 0 'receiver'
		out = argument(o, p: p, ms: ms, e: receiver, conv: call.selfConv, dest: OwnDest.make(OwnDestKind.destParameter, name: "self"), s: out)
		if n > 0 'more'
			hold(o, p: p, ms: ms, place: receiver, kind: OwnProjectionKind.projectArgument, byAddress: ast.isByAddress(call.selfConv))
		end 'more'
	end 'receiver'
	for i in 0 upto n 'args'
		let arg = call.ordered[i]
		if arg == 0 'defaulted'
			continue 'args'
		end 'defaulted'
		let conv = call.paramSpecs[i].conv
		let name = call.paramSpecs[i].name.clone()
		if conv == ast.Convention.convMutates 'mutates'
			requireNotReceiver(o, p: p, ms: ms, arg: arg, param: name)
		end 'mutates'
		out = argument(o, p: p, ms: ms, e: arg, conv: conv, dest: OwnDest.make(OwnDestKind.destParameter, name: name), s: out)
		let next = try i + 1 otherwise n
		if next < n 'more'
			hold(o, p: p, ms: ms, place: arg, kind: OwnProjectionKind.projectArgument, byAddress: ast.isByAddress(conv))
			holdArgument(o, p: p, ms: ms, e: arg)
		end 'more'
	end 'args'
	release(o, mark: held)
	requireAbsorbedBorrows(o, p: p, ms: ms, site: site, call: call, receiver: receiver)
	if fails 'fails'
		// The callee has its arguments by now, and ends them itself when it fails.
		land(o, mark: arguments)
		failure(o, p: p, ms: ms, site: site, s: out)
	end 'fails'
	for i in 0 upto o.initialising.count() 'initialised'
		out = without(out, l: o.initialising[i])
	end 'initialised'
	o.initialising = outer
	return out
end 'passArguments'

// requireNotReceiver refuses 'self' as a mutates argument. A mutates parameter may be assigned as a whole, which replaces
// the caller's value, and 'self' is the receiver of the call that is running, not a place that can be replaced.
function requireNotReceiver(mutates o Ownership, p ast.Project, ms ast.ModuleState, arg ast.NodeID, param String)
	let k = ms.tree().kindOf(arg)
	var receiver = ast.noLocal
	if k == ast.NodeKind.selfExpr 'self'
		receiver = selfLocalOf(o, p: p, ms: ms)
	end 'self' else if k == ast.NodeKind.nameExpr and isCapturedReceiver(o, e: arg) 'captured'
		receiver = ownName(o, node: arg).local
	end 'captured'
	if receiver == ast.noLocal 'notSelf'
		return
	end 'notSelf'
	if isMutableLocal(o.c.typing.locals[receiver as Count]) 'mutable'
		fail(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: arg), code: diag.errAssignToImmutable, msg: "'self' cannot be passed to the 'mutates' parameter '{param}', which could replace the whole value; pass a field of it, or call a method on it")
	end 'mutable'
end 'requireNotReceiver'

// isCapturedReceiver is whether a name is the receiver that a mutating closure captured to change.
function isCapturedReceiver(o Ownership, e ast.NodeID) returns bool
	let name = ownName(o, node: e)
	return name.kind == ast.NameKind.nameLocal and o.c.typing.locals[name.local as Count].isSelf
end 'isCapturedReceiver'

// hold keeps the place that an expression has evaluated to a borrow borrowed until release, for an expression that uses
// the borrow again after evaluating more: a call nested in the rest that changes an overlapping place would otherwise
// leave the borrow pointing at what moved. What lowering keeps across that evaluation is a handle for a managed value,
// which points into the place, and the place's address when it is passed by address. A scalar that is only read is a
// value by then and needs no hold, so a correct program pays a push for each borrow, and no look at its path: that is
// found only when something in the rest changes or moves a place.
function hold(mutates o Ownership, p ast.Project, ms ast.ModuleState, place ast.NodeID, kind OwnProjectionKind, byAddress bool)
	let t = ownType(o, node: place)
	if not byAddress and not isManagedOwn(p, ms: ms, t: t) 'value'
		return
	end 'value'
	if projectionOf(o, ms: ms, e: place) != 0 'lent'
		let lent = lentPaths(o, p: p, ms: ms, e: place)
		for i in 0 upto lent.count() 'each'
			o.projections.push(OwnProjection.make(lent[i].clone(), place: 0 as ast.NodeID, kind: kind, ty: t))
		end 'each'
		return
	end 'lent'
	o.projections.push(OwnProjection.make(AccessPath.none(), place: place, kind: kind, ty: t))
end 'hold'

// holdAcross is hold for a borrow that an expression uses again after evaluating next. Most operands are a name or a
// literal, which run no code, so a correct program rarely pays for more than the kind of next.
function holdAcross(mutates o Ownership, p ast.Project, ms ast.ModuleState, place ast.NodeID, kind OwnProjectionKind, next ast.NodeID)
	if not runsNoCode(ms.tree(), e: next) 'runs'
		hold(o, p: p, ms: ms, place: place, kind: kind, byAddress: false)
	end 'runs'
end 'holdAcross'

// runsNoCode is whether evaluating e is the read of a name or a literal, which cannot change a place. It does not look
// into anything larger: holding is always right, and the walk costs more than the hold it would save.
function runsNoCode(tree ast.Tree, e ast.NodeID) returns bool
	let k = tree.kindOf(e)
	return k == ast.NodeKind.intLit or k == ast.NodeKind.floatLit or k == ast.NodeKind.boolLit or k == ast.NodeKind.byteStrLit or k == ast.NodeKind.nameExpr or k == ast.NodeKind.selfExpr or k == ast.NodeKind.typeQueryExpr
end 'runsNoCode'

// release ends the holds taken since projections had mark entries.
function release(mutates o Ownership, mark Count)
	truncate(o.projections, mark: mark)
end 'release'

// argument passes an expression as the convention says: a let borrows it, mutates borrows it to change, consumes takes
// it, and sets initialises it.
function argument(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, conv ast.Convention, consumes dest OwnDest, consumes s OwnState) returns OwnState
	return match conv 'conv'
		convLet gives expr(o, p: p, ms: ms, e: e, s: s)
		convMutates gives mutatesArgument(o, p: p, ms: ms, e: e, dest: dest, s: s)
		convConsumes gives consume(o, p: p, ms: ms, e: e, dest: dest, s: s)
		convDestructs gives consume(o, p: p, ms: ms, e: e, dest: OwnDest.make(OwnDestKind.destDestructor, name: dest.name.clone()), s: s)
		convSets gives initialise(o, p: p, ms: ms, e: e, dest: dest, s: s)
	end 'conv'
end 'argument'

// closureOwn makes a closure. What it owns moves into it, and what the code around it borrows it borrows too, or, for a
// mutating closure, borrows to change: either is held while the closure lives, which is where it is bound or passed. Its
// body is checked as a function of its own.
function closureOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	return match consumes o.c.typing.closures.get(e as Count) 'closure'
		some(info) gives closureCaptures(o, p: p, ms: ms, e: e, info: info, s: s)
		none gives s
	end 'closure'
end 'closureOwn'

function closureCaptures(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, info ast.ClosureInfo, consumes s OwnState) returns OwnState
	var out = s
	for i in 0 upto info.captures.count() 'captures'
		let ref = info.captures[i].refNode
		let conv = info.captures[i].conv
		if conv == ast.Convention.convConsumes 'moved'
			out = consume(o, p: p, ms: ms, e: ref, dest: OwnDest.of(OwnDestKind.destClosure), s: out)
			let t = ownType(o, node: ref)
			requireNoPromiseCaptured(o, p: p, ms: ms, ref: ref, name: info.captures[i].name, behaviour: false)
			if isManagedOwn(p, ms: ms, t: t) and lacksDroppable(o, p: p, ms: ms, t: t) and not ast.isPromiseType(ms.types, reads: p.types, t: t) 'obliged'
				fail(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: ref), code: diag.errNotDroppable, msg: "'{info.captures[i].name}' has a destructor, so it must be ended by one, and a closure drops what it owns; end it before the closure, or pass it to the closure's call as an argument")
			end 'obliged'
		end 'moved' else if conv == ast.Convention.convMutates 'changed'
			out = mutatesArgument(o, p: p, ms: ms, e: ref, dest: OwnDest.of(OwnDestKind.destClosure), s: out)
		end 'changed' else 'borrowed'
			out = expr(o, p: p, ms: ms, e: ref, s: out)
		end 'borrowed'
	end 'captures'
	runNested(o, p: p, ms: ms, fid: info.fn, body: ast.closureExprBodyRef(ms.tree(), id: e), site: e, closureTy: info.ty)
	return out
end 'closureCaptures'

function mutatesArgument(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, dest OwnDest, consumes s OwnState) returns OwnState
	let out = eval(o, p: p, ms: ms, e: e, s: s)
	let site = offsetOfOwn(o, p: p, ms: ms, node: e)
	if changesProjection(o, p: p, ms: ms, e: e, site: site, what: "passed to the 'mutates' parameter '{dest.name}'") 'projection'
		return out
	end 'projection'
	let path = pathOf(o, p: p, ms: ms, e: e)
	if not path.isPlace() and ast.isMutatingFunction(ms.types, reads: p.types, t: ownType(o, node: e)) 'temporary'
		// A new function value is changed only by the call it is passed to, as one called where it is made is.
		return out
	end 'temporary'
	if not path.isPlace() 'fresh'
		fail(o, p: p, site: site, code: diag.errAssignToImmutable, msg: "the 'mutates' parameter '{dest.name}' changes its argument, so pass a variable, or a field or an element of one")
		return out
	end 'fresh'
	requireWritable(o, p: p, ms: ms, site: site, path: path)
	requireUnlent(o, p: p, ms: ms, root: path.root, site: site, s: out)
	return out
end 'mutatesArgument'

// initialise is an argument for a sets parameter: a variable that has no value yet, which has one afterwards.
function initialise(mutates o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID, dest OwnDest, consumes s OwnState) returns OwnState
	let site = offsetOfOwn(o, p: p, ms: ms, node: e)
	var local = ast.noLocal
	if ms.tree().kindOf(e) == ast.NodeKind.nameExpr 'name'
		let name = ownName(o, node: e)
		if name.kind == ast.NameKind.nameLocal 'local'
			local = name.local
		end 'local'
	end 'name'
	if local == ast.noLocal or not isMutableLocal(o.c.typing.locals[local as Count]) 'notVariable'
		fail(o, p: p, site: site, code: diag.errSetArgument, msg: "the 'sets' parameter '{dest.name}' initialises its argument, so pass a variable declared without a value: 'var x as T'")
		return s
	end 'notVariable'
	if s.dead 'dead'
		return s
	end 'dead'
	if not s.has(local) or s.factOf(local).kind != OwnFactKind.factUninitialised 'hasValue'
		let name = ast.nameExprName(ms.tree(), id: e)
		fail(o, p: p, site: site, code: diag.errSetArgument, msg: "'{name}' already has a value, but the 'sets' parameter '{dest.name}' initialises its argument; declare a variable without a value: 'var x as T'")
		return s
	end 'hasValue'
	o.initialising.push(local)
	return s
end 'initialise'

// requireExclusive is the law of exclusivity for one call: an argument passed mutates, consumes or sets must not overlap
// any other argument, receiver included, because the callee would then reach one place through two names.
function requireExclusive(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, call ast.CallInfo, receiver ast.NodeID)
	o.accesses = CallAccesses.create(0)
	if receiver != 0 'receiver'
		addAccess(o, p: p, ms: ms, e: receiver, conv: call.selfConv)
	end 'receiver'
	for i in 0 upto call.ordered.count() 'args'
		if call.ordered[i] != 0 'given'
			requireApartFromClosure(o, p: p, ms: ms, e: call.ordered[i])
			addAccess(o, p: p, ms: ms, e: call.ordered[i], conv: call.paramSpecs[i].conv)
		end 'given'
	end 'args'
	for j in 1 upto o.accesses.count() 'later'
		for i in 0 upto j 'earlier'
			let a = o.accesses[i].clone()
			let b = o.accesses[j].clone()
			if (a.conv == ast.Convention.convLet and b.conv == ast.Convention.convLet) or not a.path.overlaps(b.path) 'apart'
				continue 'earlier'
			end 'apart'
			let msg = overlapMessage(o, p: p, ms: ms, a: a, b: b)
			fail(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: b.expr), code: diag.errExclusivity, msg: msg)
		end 'earlier'
	end 'later'
end 'requireExclusive'

// requireApartFromClosure refuses a closure written as an argument that borrows a place an earlier argument passes
// mutates, consumes or sets, or that changes a place an earlier argument names: the callee would reach it through both.
// A later argument meets the closure's hold instead.
function requireApartFromClosure(mutates o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID)
	if ms.tree().kindOf(e) != ast.NodeKind.closureExpr 'notClosure'
		return
	end 'notClosure'
	let b = borrowsOf(o, p: p, ms: ms, e: e)
	for r in 0 upto b.roots.count() 'roots'
		let path = AccessPath.at(b.roots[r])
		for i in 0 upto o.accesses.count() 'earlier'
			let a = o.accesses[i].clone()
			if (a.conv == ast.Convention.convLet and not b.mutable[r]) or not a.path.overlaps(path) 'apart'
				continue 'earlier'
			end 'apart'
			let text = pathText(o, p: p, ms: ms, path: a.path)
			let name = o.c.typing.locals[b.roots[r] as Count].name.clone()
			fail(o, p: p, site: offsetOfOwn(o, p: p, ms: ms, node: e), code: diag.errExclusivity, msg: "'{text}' is passed {a.conv.keyword()} to this call, and the closure passed after it borrows '{name}', which overlaps it, so the callee would reach one place through two names; pass separate values")
		end 'earlier'
	end 'roots'
end 'requireApartFromClosure'

function addAccess(mutates o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID, conv ast.Convention)
	let lent = lentPaths(o, p: p, ms: ms, e: e)
	for i in 0 upto lent.count() 'each'
		o.accesses.push(CallAccess.make(e, path: lent[i].clone(), conv: conv))
	end 'each'
end 'addAccess'

function overlapMessage(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, a CallAccess, b CallAccess) returns String
	var changing = a.clone()
	var other = b.clone()
	if a.conv == ast.Convention.convLet 'swap'
		changing = b.clone()
		other = a.clone()
	end 'swap'
	let aText = pathText(o, p: p, ms: ms, path: a.path)
	let bText = pathText(o, p: p, ms: ms, path: b.path)
	let changingText = pathText(o, p: p, ms: ms, path: changing.path)
	let message = "'{aText}' and '{bText}' overlap, and '{changingText}' is passed {changing.conv.keyword()}, so the callee would reach one place through two names"
	if other.conv == ast.Convention.convLet 'borrowed'
		let otherText = pathText(o, p: p, ms: ms, path: other.path)
		let advice = copyAdvice(o, p: p, ms: ms, t: ownType(o, node: other.expr), ifCopyable: "pass a copy of the borrowed one: '{otherText}.clone()'", fallback: "pass separate values")
		return "{message}; {advice}"
	end 'borrowed'
	return "{message}; pass separate values"
end 'overlapMessage'

// subscript evaluates the collection of a subscript and its index, which lowering takes the element address from only
// after both: the collection stays borrowed while the index is computed.
function subscript(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let obj = ast.indexExprObj(ms.tree(), id: e)
	let index = indexArg(ms.tree(), e: e)
	let out = expr(o, p: p, ms: ms, e: obj, s: s)
	let held = o.projections.count()
	holdAcross(o, p: p, ms: ms, place: obj, kind: OwnProjectionKind.projectCollection, next: index)
	let after = expr(o, p: p, ms: ms, e: index, s: out)
	release(o, mark: held)
	return after
end 'subscript'

function memberExprOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let kind = ownMember(o, node: e).kind
	if ast.memberOfType(kind) 'case'
		return s
	end 'case'
	if o.partials > 0 and kind == ast.MemberKind.memberField and readPart(o, p: p, ms: ms, e: e, s: s) 'part'
		return s
	end 'part'
	return expr(o, p: p, ms: ms, e: ast.memberExprObj(ms.tree(), id: e), s: s)
end 'memberExprOwn'

function structLitOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let lit = match consumes o.c.typing.structLits.get(e as Count) 'hit'
		some(info) gives info
		none panic("ownership: the struct literal at node {e} was not recorded by the bodies check")
	end 'hit'
	let orig = ast.originOf(ms.types, reads: p.types, t: lit.ty)
	var out = s
	for i in 0 upto lit.ordered.count() 'fields'
		if lit.ordered[i] != 0 'given'
			let name = ast.typeEntry(ms.types, reads: p.types, t: orig).fields[i].name.clone()
			out = consume(o, p: p, ms: ms, e: lit.ordered[i], dest: OwnDest.make(OwnDestKind.destField, name: name), s: out)
		end 'given'
	end 'fields'
	return out
end 'structLitOwn'

// collectionLitOwn moves each element, or each key and its value, into the collection in the order they are written.
function collectionLitOwn(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes s OwnState) returns OwnState
	let elemsRef = ast.collectionLitExprElemsRef(ms.tree(), id: e)
	let valuesRef = ast.collectionLitExprValuesRef(ms.tree(), id: e)
	var out = s
	for i in 0 upto ms.tree().listLen(elemsRef) 'each'
		out = consume(o, p: p, ms: ms, e: ms.tree().listAt(elemsRef, index: i) as ast.NodeID, dest: OwnDest.of(OwnDestKind.destLiteral), s: out)
		if ms.tree().listLen(valuesRef) > 0 'pair'
			out = consume(o, p: p, ms: ms, e: ms.tree().listAt(valuesRef, index: i) as ast.NodeID, dest: OwnDest.of(OwnDestKind.destLiteral), s: out)
		end 'pair'
	end 'each'
	return out
end 'collectionLitOwn'
