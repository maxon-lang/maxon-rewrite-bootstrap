// checkCall types a call, whose failure, if the function it runs throws, goes to the try around it.
function checkCall(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let t = typeCall(c, p: p, call: e, errs: errs)
	if t == ast.noType 'failed'
		return ast.noType
	end 'failed'
	recordCallFailure(c, p: p, call: e)
	return t
end 'checkCall'

// recordCallFailure notes that the function a call runs can fail, for the try that catches it.
function recordCallFailure(mutates c Checker, p ast.Project, call ast.NodeID)
	match consumes c.typing.calls.get(call as Count) 'info'
		some(info) then recordFailureOf(c, p: p, info: info)
		none then _ = 0
	end 'info'
end 'recordCallFailure'

function recordFailureOf(mutates c Checker, p ast.Project, info ast.CallInfo)
	let failure = callErrorType(p, info: info)
	if failure != ast.noType 'fails'
		recordFailure(c, e: failure)
	end 'fails'
end 'recordFailureOf'

// callErrorType is the error that the function a call runs throws, or none.
function callErrorType(p ast.Project, info ast.CallInfo) returns ast.TypeID
	if info.kind == ast.CallKind.callFunction or info.kind == ast.CallKind.callStatic or info.kind == ast.CallKind.callMethod 'target'
		return p.funcs.entries[info.fn as Count].errTy
	end 'target'
	if info.kind == ast.CallKind.callBound 'bound'
		return p.funcs.entries[info.method as Count].errTy
	end 'bound'
	return ast.noType
end 'callErrorType'

// callTargetName is the name of the function that a call that throws runs.
function callTargetName(p ast.Project, info ast.CallInfo) returns String
	if info.kind == ast.CallKind.callBound 'bound'
		return p.funcs.entries[info.method as Count].name.clone()
	end 'bound'
	return p.funcs.entries[info.fn as Count].name.clone()
end 'callTargetName'

// reservedPrefix starts the names that the compiler keeps for its intrinsics.
let reservedPrefix = "__"

// refuseConstantCall refuses a call in the initializer of a constant or a raw value that is no literal factory: a call whose
// result is a number, an enum or a bool is the constant evaluator's refusal, as maxon words it, and any other is the refusal of
// a call at module level, which says what a constant may call.
function refuseConstantCall(mutates c Checker, mutates p ast.Project, call ast.NodeID, callee ast.NodeID, mutates errs diag.ErrorList)
	var scratch = diag.ErrorList.create(0)
	c.allowCalls = true
	startUses(c, node: call, inField: false)
	let t = typeCall(c, p: p, call: call, errs: scratch)
	c.hasUses = false
	c.allowCalls = false
	if scratch.count() == 0 and t != ast.noType and isConstantResult(p, t: t) 'scalar'
		let name = ast.nameExprName(p.modules[c.modIdx].tree, id: callee) if p.modules[c.modIdx].tree.kindOf(callee) == ast.NodeKind.nameExpr else ast.memberExprName(p.modules[c.modIdx].tree, id: callee)
		checkFail(c.modID, off: p.modules[c.modIdx].tree.reportStartOf(call), code: diag.errNonConstantInitializer, msg: diag.constantCallNotConstant(name), errs: errs)
		return
	end 'scalar'
	let written = writtenCallee(c, p: p, callee: callee, errs: errs)
	checkFail(c.modID, off: exprOffset(c, p: p, node: call), code: diag.errModuleLetCallsFunction, msg: "the initializer of '{c.constName}' calls '{written}': a module-level or static `let` initializer and a raw value call nothing but a static `create`-style function whose body is one `return Self\{...\}` of its parameters and constants, so write a literal, or build the value where it is used", errs: errs)
end 'refuseConstantCall'

// isConstantResult is whether a value of type t is a number, an enum or a bool, which a constant may hold.
function isConstantResult(p ast.Project, t ast.TypeID) returns bool
	return match kindOfType(p, t: t) 'k'
		intRange gives true
		constInt gives true
		floatRange gives true
		constFloat gives true
		enumTy gives true
		primBool gives true
		invalid gives false
		primString gives false
		primVoid gives false
		primNever gives false
		record gives false
		unionTy gives false
		builtinArray gives false
		builtinMap gives false
		builtinList gives false
		builtinPool gives false
		builtinHandle gives false
		builtinFrozen gives false
		builtinCown gives false
		typeParam gives false
		interfaceTy gives false
		funcTy gives false
	end 'k'
end 'isConstantResult'

function typeCall(mutates c Checker, mutates p ast.Project, call ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let callee = ast.callExprCallee(p.modules[c.modIdx].tree, id: call)
	let k = p.modules[c.modIdx].tree.kindOf(callee)
	let bare = k == ast.NodeKind.nameExpr and not isQualifiedName(c, p: p, e: callee)
	let named = k == ast.NodeKind.nameExpr and (not bare or lookupLocal(c, name: ast.nameExprName(p.modules[c.modIdx].tree, id: callee)) == ast.noLocal)
	if (named or k == ast.NodeKind.memberExpr) and not c.allowCalls and not isLiteralFactoryCall(c, p: p, callee: callee) 'forbidden'
		refuseConstantCall(c, p: p, call: call, callee: callee, errs: errs)
		return ast.noType
	end 'forbidden'
	if named 'named'
		if bare 'bare'
			let sibling = siblingMethod(c, p: p, callee: callee, errs: errs)
			if sibling != ast.noFunc 'sibling'
				return callSibling(c, p: p, call: call, callee: callee, method: sibling, errs: errs)
			end 'sibling'
		end 'bare'
		return callNamed(c, p: p, call: call, callee: callee, errs: errs)
	end 'named'
	if k == ast.NodeKind.memberExpr and not namesFunctionField(c, p: p, callee: callee) 'member'
		return callMember(c, p: p, call: call, callee: callee, errs: errs)
	end 'member'
	return callValue(c, p: p, call: call, callee: callee, errs: errs)
end 'typeCall'

// siblingMethod is the method of the enclosing type that a bare name stands for, as a bare field name stands for a field,
// or none: the type's method outranks a function of the same name. In an extension of an interface the enclosing type is
// the parameter that stands for the type implementing it, whose methods are those of its bounds.
function siblingMethod(c Checker, p ast.Project, callee ast.NodeID, mutates errs diag.ErrorList) returns ast.FuncID
	if c.owner == ast.noType or c.fn == ast.noFunc or c.inBehaviour or c.inClosure 'outside'
		return ast.noFunc
	end 'outside'
	let name = ast.nameExprName(p.modules[c.modIdx].tree, id: callee)
	if typeHasKind(p, t: c.owner, kind: ast.TypeKind.typeParam) 'parameter'
		let req = boundRequirement(p, boundedFn: c.boundedFn, param: c.owner, name: name)
		if req.sig != ast.noFunc 'required'
			return req.sig
		end 'required'
		return lookedUp(c, p: p, t: c.owner, name: name, node: callee, lookup: ast.interfaceExtensionMethod(p, from: c.modID, have: boundsOfParam(p, boundedFn: c.boundedFn, paramTy: c.owner), name: name), errs: errs)
	end 'parameter'
	return methodOf(c, p: p, t: c.owner, name: name, node: callee, errs: errs)
end 'siblingMethod'

// callSibling types a bare call of a method of the enclosing type: `helper()` is `self.helper()`, and a static method is
// called as `Self.helper()`. A static method has no `self`, so a bare call of an instance method in it has no receiver.
function callSibling(mutates c Checker, mutates p ast.Project, call ast.NodeID, callee ast.NodeID, method ast.FuncID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = ast.nameExprName(p.modules[c.modIdx].tree, id: callee)
	let owner = c.owner
	if p.funcs.entries[method as Count].isStatic 'static'
		return callOnType(c, p: p, call: call, nt: owner, name: name, errs: errs)
	end 'static'
	if not p.funcs.entries[c.fn as Count].hasReceiver 'noReceiver'
		return refuseInstanceMethodWithoutReceiver(c, p: p, node: callee, owner: owner, name: name, errs: errs)
	end 'noReceiver'
	let start = p.modules[c.modIdx].tree.startOf(callee)
	let member = ast.newMemberExpr(p.modules[c.modIdx].tree, start: start)
	let receiver = ast.newSelfExpr(p.modules[c.modIdx].tree, start: start)
	ast.setMemberExprObj(p.modules[c.modIdx].tree, id: member, value: receiver)
	ast.setMemberExprNameRef(p.modules[c.modIdx].tree, id: member, ref: ast.nameExprNameRef(p.modules[c.modIdx].tree, id: callee))
	ast.setCallExprCallee(p.modules[c.modIdx].tree, id: call, value: member)
	return callMember(c, p: p, call: call, callee: member, errs: errs)
end 'callSibling'

// refuseInstanceMethodWithoutReceiver is E3193: an instance method named where there is no value to call it on.
function refuseInstanceMethodWithoutReceiver(c Checker, p ast.Project, node ast.NodeID, owner ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	failAt(c, p: p, node: node, code: diag.errInstanceMethodWithoutReceiver, msg: diag.instanceMethodWithoutReceiver(name, owner: nameOfType(p, t: owner)), errs: errs)
	return ast.noType
end 'refuseInstanceMethodWithoutReceiver'

// writtenCallee is a callee as a message names it: a function by its name, a method by the name of its type and its own.
function writtenCallee(mutates c Checker, mutates p ast.Project, callee ast.NodeID, mutates errs diag.ErrorList) returns String
	if p.modules[c.modIdx].tree.kindOf(callee) == ast.NodeKind.nameExpr 'function'
		return ast.nameExprName(p.modules[c.modIdx].tree, id: callee)
	end 'function'
	let obj = ast.memberExprObj(p.modules[c.modIdx].tree, id: callee)
	let method = ast.memberExprName(p.modules[c.modIdx].tree, id: callee)
	if p.modules[c.modIdx].tree.kindOf(obj) == ast.NodeKind.nameExpr 'named'
		return "{ast.nameExprName(p.modules[c.modIdx].tree, id: obj)}.{method}"
	end 'named'
	let t = checkExpr(c, p: p, e: obj, errs: errs)
	if t == ast.noType 'untyped'
		return method
	end 'untyped'
	return "{declaredNameOfType(p, t: ast.contentType(p.types, t: t))}.{method}"
end 'writtenCallee'

// undefinedFunctionText is the refusal of a call to a function nothing declares, which says what the reserved prefix means when
// the name has it.
function undefinedFunctionText(name String) returns String
	if name.byteLength() >= reservedPrefix.byteLength() and name.sliceBytes(0, endPos: reservedPrefix.byteLength()) == reservedPrefix 'reserved'
		return diag.undefinedReservedFunction(name)
	end 'reserved'
	return diag.undefinedFunction(name)
end 'undefinedFunctionText'

// namesFunctionField is whether 'obj.name' names a field of a function type of the record obj is, which a call then calls
// through, rather than a method. A method of that name comes first, as a field and a method cannot share a name.
function namesFunctionField(mutates c Checker, mutates p ast.Project, callee ast.NodeID) returns bool
	let obj = ast.memberExprObj(p.modules[c.modIdx].tree, id: callee)
	let k = p.modules[c.modIdx].tree.kindOf(obj)
	if k != ast.NodeKind.nameExpr and k != ast.NodeKind.selfExpr 'notPlace'
		return false
	end 'notPlace'
	var t = ast.noType
	if k == ast.NodeKind.selfExpr 'self'
		t = selfRecord(c, p: p)
	end 'self' else 'name'
		let local = lookupLocal(c, name: ast.nameExprName(p.modules[c.modIdx].tree, id: obj))
		if local == ast.noLocal 'notLocal'
			return false
		end 'notLocal'
		t = c.typing.locals[local as Count].ty
	end 'name'
	if not typeHasKind(p, t: t, kind: ast.TypeKind.record) 'notRecord'
		return false
	end 'notRecord'
	let name = ast.memberExprName(p.modules[c.modIdx].tree, id: callee)
	match consumes p.types.entries[ast.originOf(p.types, t: t) as Count].findField(name) 'field'
		some(index) then return fieldIsFunction(p, owner: t, index: index)
		none then return false
	end 'field'
end 'namesFunctionField'

function fieldIsFunction(mutates p ast.Project, owner ast.TypeID, index Count) returns bool
	let ft = ast.fieldType(p.types, owner: owner, index: index)
	return typeHasKind(p, t: ft, kind: ast.TypeKind.funcTy)
end 'fieldIsFunction'

function unknownFunction(c Checker, p ast.Project, call ast.NodeID, name String, qualifiers Count, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: call)
	if qualifiers == 0 'bare'
		diag.pushUnqualifiedError(errs, code: diag.errUnknownFunction, message: undefinedFunctionText(name), module: c.modID, offset: off, name: name.clone())
		return ast.noType
	end 'bare'
	checkFail(c.modID, off: off, code: diag.errUnknownFunction, msg: undefinedFunctionText(name), errs: errs)
	return ast.noType
end 'unknownFunction'

// callNamed types a call of a name that no local stands for: print, a function, or the cown type.
function callNamed(mutates c Checker, mutates p ast.Project, call ast.NodeID, callee ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = ast.nameExprName(p.modules[c.modIdx].tree, id: callee)
	match consumes p.resolutions[c.modIdx].decls.get(callee as Count) 'bound'
		some(ref) then return callDeclared(c, p: p, call: call, ref: ref, name: name, errs: errs)
		none then _ = 0
	end 'bound'
	if name == "print" or name == "printError" 'print'
		return callPrint(c, p: p, call: call, name: name, errs: errs)
	end 'print'
	return unknownFunction(c, p: p, call: call, name: name, qualifiers: 0 as Count, errs: errs)
end 'callNamed'

function callDeclared(mutates c Checker, mutates p ast.Project, call ast.NodeID, ref ast.DeclRef, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let fid = declaredFunction(p, ref: ref)
	if fid != ast.noFunc 'function'
		return callFunction(c, p: p, call: call, kind: ast.CallKind.callFunction, target: fid, hasGiven: false, given: ast.TypeIDList.create(0), errs: errs)
	end 'function'
	if typeHasKind(p, t: declaredTypeOrNone(p, ref: ref), kind: ast.TypeKind.builtinCown) 'cown'
		return cownCall(c, p: p, call: call, errs: errs)
	end 'cown'
	if ast.declIsConst(p, ref: ref) 'constant'
		return callValue(c, p: p, call: call, callee: ast.callExprCallee(p.modules[c.modIdx].tree, id: call), errs: errs)
	end 'constant'
	return unknownFunction(c, p: p, call: call, name: name, qualifiers: 0 as Count, errs: errs)
end 'callDeclared'

// declaredFunction is the function that a declaration is, or none for a declaration of another kind.
function declaredFunction(p ast.Project, ref ast.DeclRef) returns ast.FuncID
	match p.declFuncs.get(ast.declKey(ref)) 'fn'
		some(fid) then return fid
		none then return ast.noFunc
	end 'fn'
end 'declaredFunction'

// methodNamed is the method of that name that the declaration of a type has, or none.
function methodNamed(p ast.Project, t ast.TypeID, name String) returns ast.FuncID
	match p.types.entries[ast.originOf(p.types, t: t) as Count].findMethod(name) 'method'
		some(fid) then return fid
		none then return ast.noFunc
	end 'method'
end 'methodNamed'

// methodLookup is what the name finds among the methods of a value of type t for the code of the module being checked:
// the method the declaration of the type has, else what the extensions of the type that the module sees add, which are
// its own and those of the modules it names, else what the extensions it sees add to the interfaces that the type
// implements there. Each outranks the next, so a type's own method is the one called wherever the type is known.
function methodLookup(c Checker, p ast.Project, t ast.TypeID, name String) returns ast.MethodLookup
	var own = methodNamed(p, t: t, name: name)
	if t == p.builtins.stringTy 'string'
		own = stringMethodNamed(p, name: name)
	end 'string'
	if own != ast.noFunc 'declared'
		return ast.MethodLookup.found(own)
	end 'declared'
	let key = ast.extensionKey(p, t: t)
	if key.isSome() 'extensions'
		let ofType = ast.extensionMethod(p, from: c.modID, owner: key.unwrap(), name: name)
		if not ofType.isAbsent() 'found'
			return ofType
		end 'found'
	end 'extensions'
	return ast.interfaceExtensionMethod(p, from: c.modID, have: ast.seenInterfaces(p, from: c.modID, t: t), name: name)
end 'methodLookup'

// methodOf is the method that the name finds for a value of type t, or none. Two methods that extensions add under the
// name are ambiguous, which it refuses at node.
function methodOf(c Checker, p ast.Project, t ast.TypeID, name String, node ast.NodeID, mutates errs diag.ErrorList) returns ast.FuncID
	return lookedUp(c, p: p, t: t, name: name, node: node, lookup: methodLookup(c, p: p, t: t, name: name), errs: errs)
end 'methodOf'

// lookedUp is the method that a lookup of the name on a value of type t found, or none; it refuses an ambiguous one at node.
function lookedUp(c Checker, p ast.Project, t ast.TypeID, name String, node ast.NodeID, consumes lookup ast.MethodLookup, mutates errs diag.ErrorList) returns ast.FuncID
	match consumes lookup 'lookup'
		absent then return ast.noFunc
		found(fid) then return fid
		ambiguous(first, second) then failAmbiguousMethod(c, p: p, node: node, t: t, name: name, first: first, second: second, errs: errs)
	end 'lookup'
	return ast.noFunc
end 'lookedUp'

// failAmbiguousMethod refuses a name that two extensions the module sees add to the type t. A call has no spelling that
// names the method through its module, so one of them has to go or take another name.
function failAmbiguousMethod(c Checker, p ast.Project, node ast.NodeID, t ast.TypeID, name String, first ast.FuncID, second ast.FuncID, mutates errs diag.ErrorList)
	let typeName = nameOfType(p, t: t)
	let firstModule = ast.describeModule(p, modID: p.funcs.entries[first as Count].module)
	let secondModule = ast.describeModule(p, modID: p.funcs.entries[second as Count].module)
	failAt(c, p: p, node: node, code: diag.errAmbiguousExtension, msg: "'{typeName}.{name}' is ambiguous here: {extensionText(p, fid: first, module: firstModule)} and {extensionText(p, fid: second, module: secondModule)} both add '{name}' to '{typeName}', and {ast.describeModule(p, modID: c.modID)} sees both; a call cannot name the method through its module, so rename or remove one of the two", errs: errs)
end 'failAmbiguousMethod'

// extensionText names the extension that declares the method fid, in the module described.
function extensionText(p ast.Project, fid ast.FuncID, module String) returns String
	let iface = p.funcs.entries[fid as Count].extendedIface
	if iface != ast.noType 'ofInterface'
		return "an extension of {p.types.entries[iface as Count].name} in {module}"
	end 'ofInterface'
	return "an extension in {module}"
end 'extensionText'

// stringMethodNamed is the method of String of that name, or none.
function stringMethodNamed(p ast.Project, name String) returns ast.FuncID
	match p.builtins.stringMethods.get(name) 'method'
		some(fid) then return fid
		none then return ast.noFunc
	end 'method'
end 'stringMethodNamed'

// callPrint types print and printError, which take the text to write.
function callPrint(mutates c Checker, mutates p ast.Project, call ast.NodeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	var specs = ast.ParamSpecList.create(0)
	specs.push(ast.ParamSpec.make("text", ty: p.builtins.stringTy, conv: ast.Convention.convLet))
	let mark = errs.count()
	let ordered = bindArgs(c, p: p, call: call, callee: name, specs: specs, receivers: 0, argsChecked: false, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'failed'
		return ast.noType
	end 'failed'
	var kind = ast.CallKind.callPrintError
	if name == "print" 'plain'
		kind = ast.CallKind.callPrint
	end 'plain'
	var info = ast.CallInfo.make(kind, fn: ast.noFunc, receiverTy: ast.noType)
	info.ordered = ordered
	info.paramSpecs = specs
	c.typing.calls.insert(call as Count, value: info)
	return p.builtins.voidTy
end 'callPrint'

// namesString is whether e is the name String, a primitive type with no declaration, where no local shadows it.
function namesString(c Checker, p ast.Project, e ast.NodeID) returns bool
	if p.modules[c.modIdx].tree.kindOf(e) != ast.NodeKind.nameExpr 'notName'
		return false
	end 'notName'
	let name = ast.nameExprName(p.modules[c.modIdx].tree, id: e)
	return name == "String" and lookupLocal(c, name: name) == ast.noLocal
end 'namesString'

// callMember types 'Type.function(...)', 'Union.case(...)' and 'object.method(...)'.
function callMember(mutates c Checker, mutates p ast.Project, call ast.NodeID, callee ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let obj = ast.memberExprObj(p.modules[c.modIdx].tree, id: callee)
	let name = ast.memberExprName(p.modules[c.modIdx].tree, id: callee)
	if namesString(c, p: p, e: obj) 'string'
		return callStringStatic(c, p: p, call: call, name: name, errs: errs)
	end 'string'
	let param = typeParamNamed(c, p: p, e: obj)
	if param != ast.noType 'parameter'
		return callOnTypeParam(c, p: p, call: call, param: param, name: name, errs: errs)
	end 'parameter'
	var named = ast.noType
	if p.modules[c.modIdx].tree.kindOf(obj) == ast.NodeKind.nameExpr 'headIsName'
		let mark = errs.count()
		named = typeNamed(c, p: p, name: obj, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return ast.noType
		end 'failed'
	end 'headIsName'
	if named != ast.noType 'type'
		return callOnType(c, p: p, call: call, nt: named, name: name, errs: errs)
	end 'type'
	let receiver = checkExpr(c, p: p, e: obj, errs: errs)
	if receiver == ast.noType 'badReceiver'
		return ast.noType
	end 'badReceiver'
	return callOnValue(c, p: p, call: call, receiver: receiver, name: name, errs: errs)
end 'callMember'

function callStringStatic(mutates c Checker, mutates p ast.Project, call ast.NodeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let mark = errs.count()
	let sf = methodOf(c, p: p, t: p.builtins.stringTy, name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if sf != ast.noFunc and p.funcs.entries[sf as Count].isStatic 'static'
		return callFunction(c, p: p, call: call, kind: ast.CallKind.callStatic, target: sf, hasGiven: false, given: ast.TypeIDList.create(0), errs: errs)
	end 'static'
	return unknownFunction(c, p: p, call: call, name: "String.{name}", qualifiers: 1 as Count, errs: errs)
end 'callStringStatic'

// typeParamNamed is the type parameter that the expression e names, or none: a type parameter's name outranks a
// declaration of that name.
function typeParamNamed(c Checker, p ast.Project, e ast.NodeID) returns ast.TypeID
	if p.modules[c.modIdx].tree.kindOf(e) != ast.NodeKind.nameExpr 'notName'
		return ast.noType
	end 'notName'
	match p.resolutions[c.modIdx].typeParamSlots.get(e as Count) 'slot'
		some(slot) then return typeParamOfNode(c, p: p, node: p.resolutions[c.modIdx].typeParams[slot].id)
		none then return ast.noType
	end 'slot'
end 'typeParamNamed'

// callOnTypeParam refuses a call written on a type parameter's name: a static requirement has no receiver to dispatch
// on, so only a concrete type reaches it.
function callOnTypeParam(mutates c Checker, mutates p ast.Project, call ast.NodeID, param ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let paramName = nameOfType(p, t: param)
	let req = boundRequirement(p, boundedFn: c.boundedFn, param: param, name: name)
	if req.sig != ast.noFunc and p.funcs.entries[req.sig as Count].isStatic 'static'
		failAt(c, p: p, node: call, code: diag.errStaticRequirementNotDispatchable, msg: diag.staticRequirementNotDispatchable("{paramName}.{name}", reacher: "the type parameter '{paramName}'"), errs: errs)
		return ast.noType
	end 'static'
	return unknownFunction(c, p: p, call: call, name: "{paramName}.{name}", qualifiers: 1 as Count, errs: errs)
end 'callOnTypeParam'

// boundRequirement is the first requirement of that name among the bounds of the type parameter param, or one whose sig
// is none.
function boundRequirement(p ast.Project, boundedFn ast.FuncID, param ast.TypeID, name String) returns ast.Requirement
	let bounds = boundsOfParam(p, boundedFn: boundedFn, paramTy: param)
	for i in 0 upto bounds.count() 'each'
		let named = requirementsNamed(p, iface: bounds[i], name: name)
		if named.count() > 0 'hit'
			return named[0].clone()
		end 'hit'
	end 'each'
	return ast.Requirement.make(ast.noType, sig: ast.noFunc)
end 'boundRequirement'

// callOnType types a call written on a type's name: a case of a union that carries a payload, or a static function.
function callOnType(mutates c Checker, mutates p ast.Project, call ast.NodeID, nt ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	if p.types.entries[nt as Count].kind == ast.TypeKind.typeParam 'parameter'
		return callOnTypeParam(c, p: p, call: call, param: nt, name: name, errs: errs)
	end 'parameter'
	if p.types.entries[nt as Count].kind == ast.TypeKind.unionTy and p.types.entries[ast.originOf(p.types, t: nt) as Count].findCase(name).isSome() 'union'
		return unionConstructor(c, p: p, call: call, ut: nt, caseName: name, errs: errs)
	end 'union'
	if name == "create" and ast.originOf(p.types, t: nt) == p.builtins.fixedArrayOrigin 'fixedArray'
		return callFixedArrayCreate(c, p: p, call: call, named: nt, errs: errs)
	end 'fixedArray'
	let mark = errs.count()
	let sm = methodOf(c, p: p, t: nt, name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if sm != ast.noFunc and p.funcs.entries[sm as Count].isStatic 'static'
		return callFunction(c, p: p, call: call, kind: ast.CallKind.callStatic, target: sm, hasGiven: p.types.entries[nt as Count].typeArgs.count() > 0, given: p.types.entries[nt as Count].typeArgs.clone(), errs: errs)
	end 'static'
	if sm != ast.noFunc 'instance'
		return refuseInstanceMethodWithoutReceiver(c, p: p, node: ast.callExprCallee(p.modules[c.modIdx].tree, id: call), owner: nt, name: name, errs: errs)
	end 'instance'
	return unknownFunction(c, p: p, call: call, name: "{nameOfType(p, t: nt)}.{name}", qualifiers: 1 as Count, errs: errs)
end 'callOnType'

// callOnValue types 'value.method(...)'.
function callOnValue(mutates c Checker, mutates p ast.Project, call ast.NodeID, receiver ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	if name == cloneMethod 'clone'
		return copyCall(c, p: p, call: call, t: receiver, errs: errs)
	end 'clone'
	let content = ast.contentType(p.types, t: receiver)
	if not requireNotCown(c, p: p, off: offsetOf(c, p: p, node: call), t: content, use: "calling '{name}'", errs: errs) 'cown'
		return ast.noType
	end 'cown'
	if typeHasKind(p, t: content, kind: ast.TypeKind.typeParam) 'parameter'
		return boundCall(c, p: p, call: call, param: content, receiver: receiver, name: name, errs: errs)
	end 'parameter'
	if typeHasKind(p, t: content, kind: ast.TypeKind.interfaceTy) 'interface'
		return witnessCall(c, p: p, call: call, iface: content, receiver: receiver, name: name, errs: errs)
	end 'interface'
	let mark = errs.count()
	let method = methodOf(c, p: p, t: content, name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if method != ast.noFunc and p.funcs.entries[method as Count].extendedIface != ast.noType 'ofInterface'
		return callInterfaceExtension(c, p: p, call: call, receiver: receiver, content: content, method: method, have: ast.seenInterfaces(p, from: c.modID, t: content), errs: errs)
	end 'ofInterface'
	if method != ast.noFunc and not p.funcs.entries[method as Count].isStatic 'instance'
		return callMethod(c, p: p, call: call, receiver: receiver, content: content, method: method, name: name, errs: errs)
	end 'instance'
	return unknownFunction(c, p: p, call: call, name: "{nameOfType(p, t: receiver)}.{name}", qualifiers: 1 as Count, errs: errs)
end 'callOnValue'

function callMethod(mutates c Checker, mutates p ast.Project, call ast.NodeID, receiver ast.TypeID, content ast.TypeID, method ast.FuncID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	if not requireNotFrozenChange(c, p: p, call: call, recv: receiver, conv: p.funcs.entries[method as Count].selfConv, method: name, errs: errs) 'frozen'
		return ast.noType
	end 'frozen'
	return callFunction(c, p: p, call: call, kind: ast.CallKind.callMethod, target: method, hasGiven: p.types.entries[content as Count].typeArgs.count() > 0, given: p.types.entries[content as Count].typeArgs.clone(), errs: errs)
end 'callMethod'

// callInterfaceExtension types a call of the method that an extension of an interface adds, on a value of the type
// content, which implements the interfaces have: the instance at content and the associated types that it binds, whose
// bound the verify stage checks as any instance's, with the conformance the module of the call sees.
function callInterfaceExtension(mutates c Checker, mutates p ast.Project, call ast.NodeID, receiver ast.TypeID, content ast.TypeID, method ast.FuncID, have ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	if not requireNotFrozenChange(c, p: p, call: call, recv: receiver, conv: p.funcs.entries[method as Count].selfConv, method: p.funcs.entries[method as Count].name, errs: errs) 'frozen'
		return ast.noType
	end 'frozen'
	let args = ast.interfaceExtensionArgs(p, recv: content, have: have, fid: method)
	queueBounds(c, p: p, off: offsetOf(c, p: p, node: call), params: ast.cloneTypeArgs(p.funcs.entries[method as Count].generics), args: args)
	return callFunction(c, p: p, call: call, kind: ast.CallKind.callMethod, target: method, hasGiven: true, given: args, errs: errs)
end 'callInterfaceExtension'

// requireNotFrozenChange refuses a call that would change or consume the contents of a frozen value.
function requireNotFrozenChange(c Checker, p ast.Project, call ast.NodeID, recv ast.TypeID, conv ast.Convention, method String, mutates errs diag.ErrorList) returns bool
	if isFrozenType(p, t: recv) and conv != ast.Convention.convLet 'frozen'
		failAt(c, p: p, node: call, code: diag.errFrozenChange, msg: "'{method}' takes its receiver as {conv.keyword()}, and the contents of a frozen value are immutable and owned by it; call it on a copy: 'thaw(x).{method}(...)' gives an owned value", errs: errs)
		return false
	end 'frozen'
	return true
end 'requireNotFrozenChange'

// callFunction types a call of a function, a method or a static function, once it is known which. given are the type
// arguments of the instance a method or a static function is called on, which a generic callee takes as they are.
function callFunction(mutates c Checker, mutates p ast.Project, call ast.NodeID, kind ast.CallKind, target ast.FuncID, hasGiven bool, given ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	if ast.intrinsicRuntimeOnly(p.funcs.entries[target as Count].intrinsic) and not p.modules[c.modIdx].isRuntime 'outsideRuntime'
		failAt(c, p: p, node: call, code: diag.errRawIntrinsicOutsideRuntime, msg: diag.rawIntrinsicOutsideRuntime(funcSymbol(p, f: target)), errs: errs)
		return ast.noType
	end 'outsideRuntime'
	if not requireVisible(c, p: p, node: call, target: target, errs: errs) 'hidden'
		return ast.noType
	end 'hidden'
	if p.funcs.entries[target as Count].generics.count() > 0 'generic'
		return callGeneric(c, p: p, call: call, kind: kind, target: target, hasGiven: hasGiven, given: given, errs: errs)
	end 'generic'
	let specs = p.funcs.entries[target as Count].params.clone()
	let callee = funcSymbol(p, f: target)
	var info = ast.CallInfo.make(kind, fn: target, receiverTy: ast.noType)
	info.paramSpecs = specs.clone()
	info.selfConv = p.funcs.entries[target as Count].selfConv
	info.intrinsic = p.funcs.entries[target as Count].intrinsic
	if declares(c, p: p, f: target) 'declared'
		let mark = errs.count()
		info.ordered = bindArgs(c, p: p, call: call, callee: callee, specs: specs, receivers: receiverCount(p, f: target), argsChecked: false, payload: false, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return ast.noType
		end 'failed'
		c.typing.calls.insert(call as Count, value: info)
		return p.funcs.entries[target as Count].retTy
	end 'declared'
	c.typing.calls.insert(call as Count, value: info)
	if not typeArgumentsOfOtherModule(c, p: p, call: call, specs: specs, errs: errs) 'badArgs'
		return ast.noType
	end 'badArgs'
	queuePending(c, call: call, callee: callee, fn: target, specs: specs)
	return p.funcs.entries[target as Count].retTy
end 'callFunction'

// typeArgumentsOfOtherModule types the arguments of a call that is verified later, each with the type of the parameter it
// stands for as its expected type, as a call in the module does, so an argument means the same whichever module the
// callee is in. One that stands for no parameter is an error that verify reports.
function typeArgumentsOfOtherModule(mutates c Checker, mutates p ast.Project, call ast.NodeID, specs ast.ParamSpecList, mutates errs diag.ErrorList) returns bool
	let argsRef = ast.callExprArgsRef(p.modules[c.modIdx].tree, id: call)
	let count = p.modules[c.modIdx].tree.listLen(argsRef)
	for i in 0 upto count 'each'
		let arg = p.modules[c.modIdx].tree.listAt(argsRef, index: i) as ast.NodeID
		var want = ast.noType
		match consumes argSlot(i, label: ast.argLabel(p.modules[c.modIdx].tree, id: arg), specs: specs) 'slot'
			some(slot) then want = expectedFor(specs, slot: slot, given: count)
			none then _ = 0
		end 'slot'
		if checkExpecting(c, p: p, e: ast.argValue(p.modules[c.modIdx].tree, id: arg), want: want, errs: errs) == ast.noType 'failed'
			return false
		end 'failed'
	end 'each'
	return true
end 'typeArgumentsOfOtherModule'

function expectedFor(specs ast.ParamSpecList, slot Count, given Count) returns ast.TypeID
	if slot < specs.count() and given == specs.count() 'fits'
		return specs[slot].ty
	end 'fits'
	return ast.noType
end 'expectedFor'

// receiverCount is how many arguments beyond its parameters a function takes: its receiver, which maxon counts in the arity of a method.
function receiverCount(p ast.Project, f ast.FuncID) returns Count
	if p.funcs.entries[f as Count].hasReceiver 'method'
		return 1
	end 'method'
	return 0
end 'receiverCount'

// callGeneric types a call whose callee has type parameters. given are the arguments of the instance the callee is called
// on, which were checked against their bounds where the instance was written; without them they are inferred.
function callGeneric(mutates c Checker, mutates p ast.Project, call ast.NodeID, kind ast.CallKind, target ast.FuncID, hasGiven bool, given ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	let callee = funcSymbol(p, f: target)
	let generics = ast.cloneTypeArgs(p.funcs.entries[target as Count].generics)
	let declared = p.funcs.entries[target as Count].params.clone()
	var args = given.clone()
	var specs = declared.clone()
	var ordered = ast.NodeIDList.create(0)
	let mark = errs.count()
	if hasGiven 'instance'
		specs = applySpecs(p, specs: declared, params: generics, args: given)
		ordered = orderArgs(c, p: p, call: call, callee: callee, specs: specs, receivers: receiverCount(p, f: target), errs: errs)
		if failedSince(errs, mark: mark) 'badOrder'
			return ast.noType
		end 'badOrder'
		for i in 0 upto specs.count() 'typed'
			if ordered[i] == 0 'defaulted'
				continue 'typed'
			end 'defaulted'
			if checkExpecting(c, p: p, e: ordered[i], want: specs[i].ty, errs: errs) == ast.noType 'failed'
				return ast.noType
			end 'failed'
		end 'typed'
	end 'instance' else 'inferred'
		ordered = checkedArgs(c, p: p, call: call, callee: callee, specs: declared, receivers: receiverCount(p, f: target), errs: errs)
		if failedSince(errs, mark: mark) 'badArgs'
			return ast.noType
		end 'badArgs'
	end 'inferred'
	let intrinsic = p.funcs.entries[target as Count].intrinsic
	let isFree = intrinsic != ast.Intrinsic.intrNone and p.funcs.entries[target as Count].ownerTy == ast.noType
	if isFree 'checkFirst'
		checkIntrinsicArgs(c, p: p, call: call, target: target, ordered: ordered, errs: errs)
		if failedSince(errs, mark: mark) 'badIntrinsic'
			return ast.noType
		end 'badIntrinsic'
	end 'checkFirst'
	let off = offsetOf(c, p: p, node: call)
	if not hasGiven 'infer'
		let result = p.funcs.entries[target as Count].retTy
		args = infer(c, p: p, node: call, callee: callee, params: generics, specs: declared, ordered: ordered, result: result, errs: errs)
		if failedSince(errs, mark: mark) 'cannotInfer'
			return ast.noType
		end 'cannotInfer'
		queueBounds(c, p: p, off: off, params: generics, args: args)
		specs = applySpecs(p, specs: declared, params: generics, args: args)
	end 'infer'
	queueMethodBounds(c, p: p, off: off, method: target, args: args)
	var info = ast.CallInfo.make(kind, fn: target, receiverTy: ast.noType)
	info.typeArgs = args.clone()
	info.paramSpecs = specs.clone()
	info.selfConv = p.funcs.entries[target as Count].selfConv
	info.intrinsic = intrinsic
	info.ordered = ordered.clone()
	c.typing.calls.insert(call as Count, value: info)
	if intrinsic == ast.Intrinsic.intrNone 'user'
		recordUse(c, call: call)
	end 'user' else if not isFree 'checkAfter'
		checkIntrinsicArgs(c, p: p, call: call, target: target, ordered: ordered, errs: errs)
		if failedSince(errs, mark: mark) 'badIntrinsic'
			return ast.noType
		end 'badIntrinsic'
	end 'checkAfter'
	if not declares(c, p: p, f: target) 'pending'
		queuePending(c, call: call, callee: callee, fn: target, specs: specs)
	end 'pending' else 'bound'
		for i in 0 upto specs.count() 'each'
			if ordered[i] == 0 'defaulted'
				continue 'each'
			end 'defaulted'
			if not coerceArg(c, p: p, call: call, value: ordered[i], callee: callee, spec: specs[i], payload: false, errs: errs) 'badArg'
				return ast.noType
			end 'badArg'
		end 'each'
	end 'bound'
	return ast.substituteType(p.types, t: p.funcs.entries[target as Count].retTy, params: generics, args: args)
end 'callGeneric'

// unionConstructor types 'Union.case(payload)'. A generic union written without type arguments takes them from the
// payload.
function unionConstructor(mutates c Checker, mutates p ast.Project, call ast.NodeID, ut ast.TypeID, caseName String, mutates errs diag.ErrorList) returns ast.TypeID
	let orig = ast.originOf(p.types, t: ut)
	let caseIndex = caseIndexNamed(p, orig: orig, name: caseName)
	let unionName = nameOfType(p, t: ut)
	if p.types.entries[orig as Count].cases[caseIndex].payload.count() == 0 'noPayload'
		failAt(c, p: p, node: call, code: diag.errCallArgCountMismatch, msg: "case '{caseName}' carries no payload: write '{unionName}.{caseName}'", errs: errs)
		return ast.noType
	end 'noPayload'
	var info = ast.CallInfo.make(ast.CallKind.callUnionCtor, fn: ast.noFunc, receiverTy: ast.noType)
	info.unionCase = caseIndex
	var specs = payloadSpecs(p, ut: ut, caseIndex: caseIndex)
	let callee = "{unionName}.{caseName}"
	var resolved = ut
	let mark = errs.count()
	var ordered = ast.NodeIDList.create(0)
	if p.types.entries[ut as Count].typeParams.count() > 0 'generic'
		ordered = checkedArgs(c, p: p, call: call, callee: callee, specs: specs, receivers: 0, errs: errs)
		if failedSince(errs, mark: mark) 'badArgs'
			return ast.noType
		end 'badArgs'
		let params = ast.cloneTypeArgs(p.types.entries[ut as Count].typeParams)
		let own = ast.selfType(p.types, declTy: ut)
		let args = infer(c, p: p, node: call, callee: unionName, params: params, specs: specs, ordered: ordered, result: own, errs: errs)
		if failedSince(errs, mark: mark) 'cannotInfer'
			return ast.noType
		end 'cannotInfer'
		resolved = instantiateGeneric(c, p: p, off: offsetOf(c, p: p, node: call), orig: ut, args: args, errs: errs)
		if resolved == ast.noType 'badInstance'
			return ast.noType
		end 'badInstance'
		specs = payloadSpecs(p, ut: resolved, caseIndex: caseIndex)
		for i in 0 upto specs.count() 'each'
			if not coerceArg(c, p: p, call: call, value: ordered[i], callee: callee, spec: specs[i], payload: true, errs: errs) 'badArg'
				return ast.noType
			end 'badArg'
		end 'each'
	end 'generic' else 'plain'
		ordered = bindArgs(c, p: p, call: call, callee: callee, specs: specs, receivers: 0, argsChecked: false, payload: true, errs: errs)
		if failedSince(errs, mark: mark) 'badBind'
			return ast.noType
		end 'badBind'
	end 'plain'
	info.ordered = ordered
	info.unionTy = resolved
	info.paramSpecs = specs
	c.typing.calls.insert(call as Count, value: info)
	return resolved
end 'unionConstructor'

// caseIndexNamed is the place of the case of that name among those of a union or an enum, which has one.
function caseIndexNamed(p ast.Project, orig ast.TypeID, name String) returns Count
	match p.types.entries[orig as Count].findCase(name) 'case'
		some(i) then return i
		none then _ = 0
	end 'case'
	panic("'{p.types.entries[orig as Count].name}' has no case '{name}'")
end 'caseIndexNamed'

// payloadSpecs are the parameters a union's constructor of a case takes: the payload, each consumed.
function payloadSpecs(mutates p ast.Project, ut ast.TypeID, caseIndex Count) returns ast.ParamSpecList
	let orig = ast.originOf(p.types, t: ut)
	var specs = ast.ParamSpecList.create(0)
	for i in 0 upto p.types.entries[orig as Count].cases[caseIndex].payload.count() 'each'
		let name = p.types.entries[orig as Count].cases[caseIndex].payload[i].name.clone()
		let t = ast.payloadType(p.types, owner: ut, caseIndex: caseIndex, index: i)
		specs.push(ast.ParamSpec.make(name, ty: t, conv: ast.Convention.convConsumes))
	end 'each'
	return specs
end 'payloadSpecs'

// boundCall types a call of a method that a type parameter's bounds declare. It is the only method a value of a type
// parameter has, and it runs the method of whatever type the parameter becomes.
function boundCall(mutates c Checker, mutates p ast.Project, call ast.NodeID, param ast.TypeID, receiver ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let bounds = boundsOfParam(p, boundedFn: c.boundedFn, paramTy: param)
	var bound = ast.noType
	var iface = ast.noType
	var sig = ast.noFunc
	for i in 0 upto bounds.count() 'candidates'
		let named = requirementsNamed(p, iface: bounds[i], name: name)
		if named.count() > 1 'inheritedTwice'
			failAt(c, p: p, node: call, code: diag.errAmbiguousBound, msg: "'{name}' taking {p.funcs.entries[named[0].sig as Count].params.count()} argument(s) is provided by both {requirementText(p, req: named[0])} and {requirementText(p, req: named[1])} through the constraints on type parameter '{nameOfType(p, t: param)}' — a witness dispatch binds ONE table slot, and these are two, so there is nothing to choose by. Rename one requirement, or drop one of the constraints", errs: errs)
			return ast.noType
		end 'inheritedTwice'
		if named.count() == 0 or named[0].sig == sig 'absentOrSame'
			continue 'candidates'
		end 'absentOrSame'
		let found = named[0].clone()
		if sig != ast.noFunc 'ambiguous'
			failAt(c, p: p, node: call, code: diag.errAmbiguousBound, msg: "the bounds '{nameOfType(p, t: bound)}' and '{nameOfType(p, t: bounds[i])}' of '{nameOfType(p, t: param)}' both declare '{name}'; keep only one bound that declares it", errs: errs)
			return ast.noType
		end 'ambiguous'
		bound = bounds[i]
		iface = found.iface
		sig = found.sig
	end 'candidates'
	if sig == ast.noFunc 'notRequired'
		let mark = errs.count()
		let extended = lookedUp(c, p: p, t: param, name: name, node: call, lookup: ast.interfaceExtensionMethod(p, from: c.modID, have: bounds, name: name), errs: errs)
		if failedSince(errs, mark: mark) 'ambiguous'
			return ast.noType
		end 'ambiguous'
		if extended != ast.noFunc 'extension'
			return callInterfaceExtension(c, p: p, call: call, receiver: receiver, content: param, method: extended, have: bounds, errs: errs)
		end 'extension'
		failAt(c, p: p, node: call, code: diag.errUnknownFunction, msg: "{nameOfType(p, t: param)} has no method '{name}'{boundsText(p, bounds: bounds, param: param)}", errs: errs)
		return ast.noType
	end 'notRequired'
	if p.funcs.entries[sig as Count].isStatic 'static'
		failAt(c, p: p, node: call, code: diag.errStaticRequirementNotDispatchable, msg: diag.staticRequirementNotDispatchable("{p.types.entries[iface as Count].name}.{name}", reacher: "a value of type parameter '{nameOfType(p, t: param)}'"), errs: errs)
		return ast.noType
	end 'static'
	let selfConv = p.funcs.entries[sig as Count].selfConv
	if not requireNotFrozenChange(c, p: p, call: call, recv: receiver, conv: selfConv, method: name, errs: errs) 'frozen'
		return ast.noType
	end 'frozen'
	let selfParams = requirementParams(p, iface: iface)
	let selfArgs = requirementArgs(p, iface: iface, own: param)
	let specs = applySpecs(p, specs: p.funcs.entries[sig as Count].params.clone(), params: selfParams, args: selfArgs)
	let calleeName = "{nameOfType(p, t: param)}.{name}"
	var info = ast.CallInfo.make(ast.CallKind.callBound, fn: ast.noFunc, receiverTy: receiver)
	info.method = sig
	info.selfConv = selfConv
	info.paramSpecs = specs.clone()
	let mark = errs.count()
	info.ordered = bindArgs(c, p: p, call: call, callee: calleeName, specs: specs, receivers: 0, argsChecked: false, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'badArgs'
		return ast.noType
	end 'badArgs'
	c.typing.calls.insert(call as Count, value: info)
	recordUse(c, call: call)
	return ast.substituteType(p.types, t: p.funcs.entries[sig as Count].retTy, params: selfParams, args: selfArgs)
end 'boundCall'

function oneType(t ast.TypeID) returns ast.TypeIDList
	var list = ast.TypeIDList.create(0)
	list.push(t)
	return list
end 'oneType'

// boundsText says what a type parameter can call, for the error that names a method it cannot.
function boundsText(p ast.Project, bounds ast.TypeIDList, param ast.TypeID) returns String
	let name = nameOfType(p, t: param)
	if bounds.count() == 0 'none'
		return ": a type parameter has only the methods of its bounds, and '{name}' has none; constrain it with 'where {name} implements <Interface>'"
	end 'none'
	var names = ast.StringList.create(0)
	for i in 0 upto bounds.count() 'each'
		names.push(nameOfType(p, t: bounds[i]))
	end 'each'
	return ": a type parameter has only the methods of its bounds ({ast.joinNames(names, sep: ", ")})"
end 'boundsText'

// copyCall types 'value.clone()'.
function copyCall(mutates c Checker, mutates p ast.Project, call ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if t == p.builtins.voidTy or t == p.builtins.neverTy 'noValue'
		failAt(c, p: p, node: call, code: diag.errTypeMismatch, msg: "an expression with no value cannot be copied", errs: errs)
		return ast.noType
	end 'noValue'
	let lacking = lacksCap(c, p: p, wantCopy: true, t: t)
	if lacking.missing 'noCopy'
		let why = lackWhyText(p.types, info: lacking, capName: "Copyable")
		let fix = lackFixText(p.types, info: lacking, capName: "Copyable")
		failAt(c, p: p, node: call, code: diag.errNotCopyable, msg: "a value of '{nameOfType(p, t: t)}' cannot be copied: {why}; {fix}, or move the value instead of copying it", errs: errs)
		return ast.noType
	end 'noCopy'
	var info = ast.CallInfo.make(ast.CallKind.callCopy, fn: ast.noFunc, receiverTy: t)
	let mark = errs.count()
	info.ordered = bindArgs(c, p: p, call: call, callee: cloneMethod, specs: ast.ParamSpecList.create(0), receivers: 0, argsChecked: false, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'badArgs'
		return ast.noType
	end 'badArgs'
	c.typing.calls.insert(call as Count, value: info)
	return t
end 'copyCall'
