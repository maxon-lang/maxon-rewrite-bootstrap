// checkCall types a call, whose failure, if the function it runs throws, goes to the try around it.
function checkCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let t = typeCall(c, p: p, ms: ms, call: e, errs: errs)
	if t == ast.noType 'failed'
		return ast.noType
	end 'failed'
	recordCallFailure(c, p: p, ms: ms, call: e)
	noteCallWaits(c, p: p, ms: ms, call: e)
	return t
end 'checkCall'

// recordCallFailure notes that the function a call runs can fail, for the try that catches it.
function recordCallFailure(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID)
	var slot as Count
	if not c.typing.calls.find(call as Count, slot: slot) 'unrecorded'
		return
	end 'unrecorded'
	let failure = callErrorType(p, ms: ms, info: c.typing.calls.valueAt(slot))
	if failure != ast.noType 'fails'
		recordFailure(c, e: failure)
	end 'fails'
end 'recordCallFailure'

// callErrorType is the error that the function a call runs throws, or none.
function callErrorType(p ast.Project, ms ast.ModuleState, info ast.CallInfo) returns ast.TypeID
	if info.kind == ast.CallKind.callFunction or info.kind == ast.CallKind.callStatic or info.kind == ast.CallKind.callMethod 'target'
		return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).errTy
	end 'target'
	if info.kind == ast.CallKind.callBound 'bound'
		return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.method).errTy
	end 'bound'
	if info.kind == ast.CallKind.callSend 'send'
		return p.builtins.sendErrorTy
	end 'send'
	return ast.noType
end 'callErrorType'

// callTargetName is the name of the function that a call that throws runs.
function callTargetName(p ast.Project, ms ast.ModuleState, info ast.CallInfo) returns String
	if info.kind == ast.CallKind.callBound 'bound'
		return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.method).name.clone()
	end 'bound'
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).name.clone()
end 'callTargetName'

// reservedPrefix starts the names that the compiler keeps for its intrinsics.
let reservedPrefix = "__"

// refuseConstantCall refuses a call in the initializer of a constant or a raw value that is no literal factory: a call whose
// result is a number, an enum or a bool is the constant evaluator's refusal, as maxon words it, and any other is the refusal of
// a call at module level, which says what a constant may call.
function refuseConstantCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, callee ast.NodeID, mutates errs diag.ErrorList)
	var scratch = diag.ErrorList.create(0)
	c.allowCalls = true
	startUses(c, node: call, inField: false)
	let t = typeCall(c, p: p, ms: ms, call: call, errs: scratch)
	c.hasUses = false
	c.allowCalls = false
	if scratch.count() == 0 and t != ast.noType and isConstantResult(p, ms: ms, t: t) 'scalar'
		let name = ast.nameExprName(ms.tree(), id: callee).clone() if ms.tree().kindOf(callee) == ast.NodeKind.nameExpr else ast.memberExprName(ms.tree(), id: callee).clone()
		checkFail(c.modID, off: ms.tree().reportStartOf(call), code: diag.errNonConstantInitializer, msg: diag.constantCallNotConstant(name), errs: errs)
		return
	end 'scalar'
	let written = writtenCallee(c, p: p, ms: ms, callee: callee, errs: errs)
	checkFail(c.modID, off: exprOffset(c, p: p, ms: ms, node: call), code: diag.errModuleLetCallsFunction, msg: "the initializer of '{c.constName}' calls '{written}': a module-level or static `let` initializer and a raw value call nothing but a static `create`-style function whose body is one `return Self\{...\}` of its parameters and constants, so write a literal, or build the value where it is used", errs: errs)
end 'refuseConstantCall'

// isConstantResult is whether a value of type t is a number, an enum or a bool, which a constant may hold.
function isConstantResult(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return match kindOfType(p, ms: ms, t: t) 'k'
		intRange gives true
		constInt gives true
		floatRange gives true
		constFloat gives true
		enumTy gives true
		primBool gives true
		invalid gives false
		primString gives false
		primCharacter gives false
		primVoid gives false
		primNever gives false
		record gives false
		unionTy gives false
		builtinArray gives false
		builtinList gives false
		builtinPool gives false
		builtinHandle gives false
		builtinFrozen gives false
		builtinCown gives false
		builtinCursor gives false
		builtinGroups gives false
		builtinPromise gives false
		builtinService gives false
		typeParam gives false
		interfaceTy gives false
		funcTy gives false
	end 'k'
end 'isConstantResult'

function typeCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let callee = ast.callExprCallee(ms.tree(), id: call)
	let k = ms.tree().kindOf(callee)
	let bare = k == ast.NodeKind.nameExpr and not isQualifiedName(c, p: p, ms: ms, e: callee)
	let named = k == ast.NodeKind.nameExpr and (not bare or lookupLocal(c, name: ast.nameExprName(ms.tree(), id: callee)) == ast.noLocal)
	if (named or k == ast.NodeKind.memberExpr) and not c.allowCalls and not isLiteralFactoryCall(c, p: p, ms: ms, callee: callee) 'forbidden'
		refuseConstantCall(c, p: p, ms: ms, call: call, callee: callee, errs: errs)
		return ast.noType
	end 'forbidden'
	if named 'named'
		if bare 'bare'
			let sibling = siblingMethod(c, p: p, ms: ms, callee: callee, errs: errs)
			if sibling != ast.noFunc 'sibling'
				return callSibling(c, p: p, ms: ms, call: call, callee: callee, method: sibling, errs: errs)
			end 'sibling'
		end 'bare'
		return callNamed(c, p: p, ms: ms, call: call, callee: callee, errs: errs)
	end 'named'
	if k == ast.NodeKind.memberExpr and not namesFunctionField(c, p: p, ms: ms, callee: callee) 'member'
		return callMember(c, p: p, ms: ms, call: call, callee: callee, errs: errs)
	end 'member'
	return callValue(c, p: p, ms: ms, call: call, callee: callee, errs: errs)
end 'typeCall'

// siblingMethod is the method of the enclosing type that a bare name stands for, as a bare field name stands for a field,
// or none: the type's method outranks a function of the same name. In an extension of an interface the enclosing type is
// the parameter that stands for the type implementing it, whose methods are those of its bounds. The initializer of a static
// let is written inside its type, so a bare name there stands for a static function of the type.
function siblingMethod(c Checker, p ast.Project, ms ast.ModuleState, callee ast.NodeID, mutates errs diag.ErrorList) returns ast.FuncID
	if c.owner == ast.noType or c.inBehaviour or c.inClosure 'outside'
		return ast.noFunc
	end 'outside'
	if c.fn == ast.noFunc 'initializer'
		return staticSibling(c, p: p, ms: ms, callee: callee)
	end 'initializer'
	let name = ast.nameExprName(ms.tree(), id: callee)
	if ast.familyOfSelf(ms.types, reads: p.types, t: c.owner) != ast.noType 'ofFamily'
		return methodOf(c, p: p, ms: ms, t: ast.familyOfSelf(ms.types, reads: p.types, t: c.owner), name: name, node: callee, errs: errs)
	end 'ofFamily'
	if typeHasKind(p, ms: ms, t: c.owner, kind: ast.TypeKind.typeParam) 'parameter'
		let req = boundRequirement(p, ms: ms, boundedFn: c.boundedFn, param: c.owner, name: name)
		if req.sig != ast.noFunc 'required'
			return req.sig
		end 'required'
		return lookedUp(c, p: p, ms: ms, t: c.owner, name: name, node: callee, lookup: ast.interfaceExtensionMethod(p, ms: ms, from: c.modID, have: boundsOfParam(p, ms: ms, boundedFn: c.boundedFn, paramTy: c.owner), name: name), errs: errs)
	end 'parameter'
	return methodOf(c, p: p, ms: ms, t: c.owner, name: name, node: callee, errs: errs)
end 'siblingMethod'

// staticSibling is the static function of the enclosing type that a bare name in the initializer of one of its static lets
// stands for, or none.
function staticSibling(c Checker, p ast.Project, ms ast.ModuleState, callee ast.NodeID) returns ast.FuncID
	if c.constName == "" or typeHasKind(p, ms: ms, t: c.owner, kind: ast.TypeKind.typeParam) or typeHasKind(p, ms: ms, t: c.owner, kind: ast.TypeKind.interfaceTy) 'none'
		return ast.noFunc
	end 'none'
	match consumes methodLookup(c, p: p, ms: ms, t: c.owner, name: ast.nameExprName(ms.tree(), id: callee)) 'lookup'
		found(fid) then return fid if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).isStatic else ast.noFunc
		absent then return ast.noFunc
		ambiguous(_, _) then return ast.noFunc
	end 'lookup'
end 'staticSibling'

// callSibling types a bare call of a method of the enclosing type: `helper()` is `self.helper()`, and a static method is
// called as `Self.helper()`. A static method has no `self`, so a bare call of an instance method in it has no receiver.
function callSibling(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, callee ast.NodeID, method ast.FuncID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = ast.nameExprName(ms.tree(), id: callee).clone()
	let owner = c.owner
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).isStatic 'static'
		return callOnType(c, p: p, ms: ms, call: call, nt: owner, name: name, errs: errs)
	end 'static'
	if not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).hasReceiver 'noReceiver'
		return refuseInstanceMethodWithoutReceiver(c, p: p, ms: ms, node: callee, owner: owner, name: name, errs: errs)
	end 'noReceiver'
	let start = ms.tree().startOf(callee)
	let member = ast.newMemberExpr(ms.ownTree, start: start)
	let receiver = ast.newSelfExpr(ms.ownTree, start: start)
	ast.setMemberExprObj(ms.ownTree, id: member, value: receiver)
	ast.setMemberExprNameRef(ms.ownTree, id: member, ref: ast.nameExprNameRef(ms.tree(), id: callee))
	ast.setCallExprCallee(ms.ownTree, id: call, value: member)
	return callMember(c, p: p, ms: ms, call: call, callee: member, errs: errs)
end 'callSibling'

// refuseInstanceMethodWithoutReceiver is E3193: an instance method named where there is no value to call it on.
function refuseInstanceMethodWithoutReceiver(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, owner ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	failAt(c, p: p, ms: ms, node: node, code: diag.errInstanceMethodWithoutReceiver, msg: diag.instanceMethodWithoutReceiver(name, owner: nameOfType(p, ms: ms, t: owner)), errs: errs)
	return ast.noType
end 'refuseInstanceMethodWithoutReceiver'

// writtenCallee is a callee as a message names it: a function by its name, a method by the name of its type and its own.
function writtenCallee(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, callee ast.NodeID, mutates errs diag.ErrorList) returns String
	if ms.tree().kindOf(callee) == ast.NodeKind.nameExpr 'function'
		return ast.nameExprName(ms.tree(), id: callee).clone()
	end 'function'
	let obj = ast.memberExprObj(ms.tree(), id: callee)
	let method = ast.memberExprName(ms.tree(), id: callee).clone()
	if ms.tree().kindOf(obj) == ast.NodeKind.nameExpr 'named'
		return "{ast.nameExprName(ms.tree(), id: obj)}.{method}"
	end 'named'
	let t = checkExpr(c, p: p, ms: ms, e: obj, errs: errs)
	if t == ast.noType 'untyped'
		return method
	end 'untyped'
	return "{declaredNameOfType(p, ms: ms, t: ast.contentType(ms.types, reads: p.types, t: t))}.{method}"
end 'writtenCallee'

// undefinedFunctionText is the refusal of a call to a function nothing declares, which says what the reserved prefix means when
// the name has it.
function undefinedFunctionText(name String) returns String
	if name.byteLength() >= reservedPrefix.byteLength() and name.sliceBytes(0, endPos: reservedPrefix.byteLength()) == reservedPrefix 'reserved'
		return diag.undefinedReservedFunction(name)
	end 'reserved'
	return diag.undefinedFunction(name)
end 'undefinedFunctionText'

// namesFunctionField is whether 'obj.name' names a field of a function type of the record obj is, which a call then calls
// through, rather than a method. A method of that name comes first, as a field and a method cannot share a name.
function namesFunctionField(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, callee ast.NodeID) returns bool
	let obj = ast.memberExprObj(ms.tree(), id: callee)
	let k = ms.tree().kindOf(obj)
	if k != ast.NodeKind.nameExpr and k != ast.NodeKind.selfExpr 'notPlace'
		return false
	end 'notPlace'
	var t = ast.noType
	if k == ast.NodeKind.selfExpr 'self'
		t = selfRecord(c, p: p, ms: ms)
	end 'self' else 'name'
		let local = lookupLocal(c, name: ast.nameExprName(ms.tree(), id: obj))
		if local == ast.noLocal 'notLocal'
			return false
		end 'notLocal'
		t = c.typing.locals[local as Count].ty
	end 'name'
	if not typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.record) 'notRecord'
		return false
	end 'notRecord'
	let name = ast.memberExprName(ms.tree(), id: callee).clone()
	match consumes ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: t)).findField(name) 'field'
		some(index) then return fieldIsFunction(p, ms: ms, owner: t, index: index)
		none then return false
	end 'field'
end 'namesFunctionField'

function fieldIsFunction(p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, index Count) returns bool
	let ft = ast.fieldType(ms.types, reads: p.types, owner: owner, index: index)
	return typeHasKind(p, ms: ms, t: ft, kind: ast.TypeKind.funcTy)
end 'fieldIsFunction'

function unknownFunction(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, name String, qualifiers Count, consumes fix diag.Fix, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: call)
	if qualifiers == 0 'bare'
		diag.pushUnqualifiedError(errs, code: diag.errUnknownFunction, message: undefinedFunctionText(name), module: c.modID, offset: off, name: name.clone())
		return ast.noType
	end 'bare'
	checkFailFixed(c.modID, off: off, code: diag.errUnknownFunction, msg: undefinedFunctionText(name), fix: fix, errs: errs)
	let last = try errs.count() - 1 otherwise panic("the unknown function was reported")
	errs[last].cause = diag.rawSurfaceCause(name)
	return ast.noType
end 'unknownFunction'

// callNamed types a call of a name that no local stands for: print, a function, or the cown type.
function callNamed(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, callee ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = ast.nameExprName(ms.tree(), id: callee).clone()
	match consumes ast.nodeDecl(p, ms: ms, node: callee as Count) 'bound'
		some(ref) then return callDeclared(c, p: p, ms: ms, call: call, ref: ref, name: name, errs: errs)
		none then _ = 0
	end 'bound'
	if name == "print" or name == "printError" 'print'
		return callPrint(c, p: p, ms: ms, call: call, name: name, errs: errs)
	end 'print'
	return unknownFunction(c, p: p, ms: ms, call: call, name: name, qualifiers: 0 as Count, fix: diag.Fix.none(), errs: errs)
end 'callNamed'

function callDeclared(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, ref ast.DeclRef, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let fid = declaredFunction(p, ms: ms, ref: ref)
	if fid != ast.noFunc 'function'
		return callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callFunction, target: fid, hasGiven: false, given: ast.TypeIDList.create(0), errs: errs)
	end 'function'
	if typeHasKind(p, ms: ms, t: declaredTypeOrNone(p, ms: ms, ref: ref), kind: ast.TypeKind.builtinCown) 'cown'
		return cownCall(c, p: p, ms: ms, call: call, errs: errs)
	end 'cown'
	if ast.declIsConst(p, ref: ref) 'constant'
		return callValue(c, p: p, ms: ms, call: call, callee: ast.callExprCallee(ms.tree(), id: call), errs: errs)
	end 'constant'
	return unknownFunction(c, p: p, ms: ms, call: call, name: name, qualifiers: 0 as Count, fix: diag.Fix.none(), errs: errs)
end 'callDeclared'

// declaredFunction is the function that a declaration is, or none for a declaration of another kind.
function declaredFunction(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns ast.FuncID
	match ast.declFunc(p, ms: ms, ref: ref) 'fn'
		some(fid) then return fid
		none then return ast.noFunc
	end 'fn'
end 'declaredFunction'

// methodNamed is the method of that name that the declaration of a type has, or none.
function methodNamed(p ast.Project, ms ast.ModuleState, t ast.TypeID, name String) returns ast.FuncID
	match ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: t)).findMethod(name) 'method'
		some(fid) then return fid
		none then return ast.noFunc
	end 'method'
end 'methodNamed'

// methodLookup is what the name finds among the methods of a value of type t for the code of the module being checked:
// the method the declaration of the type has, else what the extensions of the type that the module sees add, which are
// its own and those of the modules it names, else what the extensions it sees add to the interfaces that the type
// implements there. Each outranks the next, so a type's own method is the one called wherever the type is known.
function methodLookup(c Checker, p ast.Project, ms ast.ModuleState, t ast.TypeID, name String) returns ast.MethodLookup
	var own = methodNamed(p, ms: ms, t: t, name: name)
	if t == p.builtins.stringTy or t == p.builtins.characterTy 'primitive'
		own = primitiveMethodNamed(p, t: t, name: name)
	end 'primitive'
	if own != ast.noFunc 'declared'
		return ast.MethodLookup.found(own)
	end 'declared'
	let key = ast.extensionKey(p, ms: ms, t: t)
	if key.isSome() 'extensions'
		let ofType = ast.extensionMethod(p, ms: ms, from: c.modID, owner: key.unwrap(), name: name)
		if not ofType.isAbsent() 'found'
			return ofType
		end 'found'
	end 'extensions'
	return ast.interfaceExtensionMethod(p, ms: ms, from: c.modID, have: ast.seenInterfaces(p, ms: ms, from: c.modID, t: t), name: name)
end 'methodLookup'

// methodOf is the method that the name finds for a value of type t, or none. Two methods that extensions add under the
// name are ambiguous, which it refuses at node.
function methodOf(c Checker, p ast.Project, ms ast.ModuleState, t ast.TypeID, name String, node ast.NodeID, mutates errs diag.ErrorList) returns ast.FuncID
	return lookedUp(c, p: p, ms: ms, t: t, name: name, node: node, lookup: methodLookup(c, p: p, ms: ms, t: t, name: name), errs: errs)
end 'methodOf'

// lookedUp is the method that a lookup of the name on a value of type t found, or none; it refuses an ambiguous one at node.
function lookedUp(c Checker, p ast.Project, ms ast.ModuleState, t ast.TypeID, name String, node ast.NodeID, consumes lookup ast.MethodLookup, mutates errs diag.ErrorList) returns ast.FuncID
	match consumes lookup 'lookup'
		absent then return ast.noFunc
		found(fid) then return fid
		ambiguous(first, second) then failAmbiguousMethod(c, p: p, ms: ms, node: node, t: t, name: name, first: first, second: second, errs: errs)
	end 'lookup'
	return ast.noFunc
end 'lookedUp'

// failAmbiguousMethod refuses a name that two extensions the module sees add to the type t. A call has no spelling that
// names the method through its module, so one of them has to go or take another name.
function failAmbiguousMethod(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, t ast.TypeID, name String, first ast.FuncID, second ast.FuncID, mutates errs diag.ErrorList)
	let typeName = nameOfType(p, ms: ms, t: t)
	let firstModule = ast.describeModule(p, modID: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: first).module)
	let secondModule = ast.describeModule(p, modID: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: second).module)
	failAt(c, p: p, ms: ms, node: node, code: diag.errAmbiguousExtension, msg: "'{typeName}.{name}' is ambiguous here: {extensionText(p, ms: ms, fid: first, module: firstModule)} and {extensionText(p, ms: ms, fid: second, module: secondModule)} both add '{name}' to '{typeName}', and {ast.describeModule(p, modID: c.modID)} sees both; a call cannot name the method through its module, so rename or remove one of the two", errs: errs)
end 'failAmbiguousMethod'

// extensionText names the extension that declares the method fid, in the module described.
function extensionText(p ast.Project, ms ast.ModuleState, fid ast.FuncID, module String) returns String
	let iface = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).extendedIface
	if iface != ast.noType 'ofInterface'
		return "an extension of {ast.typeEntry(ms.types, reads: p.types, t: iface).name} in {module}"
	end 'ofInterface'
	return "an extension in {module}"
end 'extensionText'

// primitiveMethodNamed is the method of that name of String or Character, or none.
function primitiveMethodNamed(p ast.Project, t ast.TypeID, name String) returns ast.FuncID
	match ast.primitiveMethod(p.builtins, t: t, name: name) 'method'
		some(fid) then return fid
		none then return ast.noFunc
	end 'method'
end 'primitiveMethodNamed'

// callPrint types print and printError, which take the text to write.
function callPrint(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	var specs = ast.ParamSpecList.create(0)
	specs.push(ast.ParamSpec.make("text", ty: p.builtins.stringTy, conv: ast.Convention.convLet))
	let mark = errs.count()
	let ordered = bindArgs(c, p: p, ms: ms, call: call, callee: name, specs: specs, receivers: 0, argsChecked: false, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'failed'
		return ast.noType
	end 'failed'
	var kind = ast.CallKind.callPrintError
	if name == "print" 'plain'
		kind = ast.CallKind.callPrint
	end 'plain'
	var info = ast.CallInfo.make(kind, fn: ast.noFunc, receiverTy: ast.noType)
	info.ordered = ordered
	info.paramSpecs = specs
	c.typing.calls.insert(call as Count, value: info)
	return p.builtins.voidTy
end 'callPrint'

// primitiveNamed is the primitive type with no declaration that e names where no local shadows the name, or none: String or
// Character, whose methods the table gives, or the family that `int`, `float` or `bool` names, whose static functions only
// extensions add.
function primitiveNamed(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns ast.TypeID
	if ms.tree().kindOf(e) != ast.NodeKind.nameExpr 'notName'
		return ast.noType
	end 'notName'
	let name = ast.nameExprName(ms.tree(), id: e)
	if lookupLocal(c, name: name) != ast.noLocal 'shadowed'
		return ast.noType
	end 'shadowed'
	let family = familyNamed(p, name: name)
	if family != ast.noType 'family'
		return family
	end 'family'
	return primitiveAliasNamed(p, ms: ms, e: e)
end 'primitiveNamed'

// familySelf is the Self of an extension of the family of the primitive type t: the integers' widest, the floats', or t.
function familySelf(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	if ast.isIntType(ms.types, reads: p.types, t: t) 'integer'
		return p.builtins.anon64Ty
	end 'integer'
	if ast.isFloatType(ms.types, reads: p.types, t: t) 'float'
		return p.builtins.anonFloatTy
	end 'float'
	return t
end 'familySelf'

// isFamilyType is whether t is the type that names a primitive family: every integer, every float, or bool.
function isFamilyType(p ast.Project, t ast.TypeID) returns bool
	return t == p.builtins.anon64Ty or t == p.builtins.anonFloatTy or t == p.builtins.boolTy
end 'isFamilyType'

// staticHolder is the type whose extensions declare the statics that a qualifier of type t reaches: the family, where t is the
// `Self` of a static of one, and t itself otherwise.
function staticHolder(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	let family = ast.familyOfSelf(ms.types, reads: p.types, t: t)
	if family == ast.noType 'other'
		return t
	end 'other'
	return family
end 'staticHolder'

// implicitSelfRefusal is the message that refuses a static let of a primitive family whose type is the family's own, reached
// through a typealias of the family: the constant is one for the family, so its type is not the alias's.
export function implicitSelfRefusal(p ast.Project, ms ast.ModuleState, qualifier ast.TypeID, name String) returns String
	let alias = nameOfType(p, ms: ms, t: qualifier)
	var family = nameOfType(p, ms: ms, t: qualifier)
	if ast.isIntType(ms.types, reads: p.types, t: qualifier) 'integer'
		family = intFamily
	end 'integer' else if ast.isFloatType(ms.types, reads: p.types, t: qualifier) 'float'
		family = floatFamily
	end 'float'
	return "Unsupported: '{alias}.{name}' is a static let of the family of '{alias}' whose type is the family's own, which is not the type of '{alias}'; write '{family}.{name}' and convert the result to '{alias}'"
end 'implicitSelfRefusal'

// familyNamed is the type that a primitive's word names as the qualifier of a static, or noType.
function familyNamed(p ast.Project, name String) returns ast.TypeID
	if name == "String" 'string'
		return p.builtins.stringTy
	end 'string'
	if name == "Character" 'character'
		return p.builtins.characterTy
	end 'character'
	if name == intFamily 'integer'
		return p.builtins.anon64Ty
	end 'integer'
	if name == floatFamily 'float'
		return p.builtins.anonFloatTy
	end 'float'
	if name == boolName 'boolean'
		return p.builtins.boolTy
	end 'boolean'
	return ast.noType
end 'familyNamed'

// primitiveAliasNamed is the type that the typealias e names, where it is an integer, a float or bool, which qualifies a
// static of its family as the family's name does (`Port.limit`, `Port.fromString(text)`), or noType.
function primitiveAliasNamed(p ast.Project, ms ast.ModuleState, e ast.NodeID) returns ast.TypeID
	let bound = ast.nodeDecl(p, ms: ms, node: e as Count)
	if not bound.isSome() 'unbound'
		return ast.noType
	end 'unbound'
	let ref = bound.unwrap()
	let isAlias = match ast.moduleDecl(p, ref: ref) 'decl'
		aliasDecl(_) gives true
		funcDecl(_) gives false
		constDecl(_) gives false
		typeDecl(_) gives false
		enumDecl(_) gives false
		unionDecl(_) gives false
		interfaceDecl(_) gives false
		extensionDecl(_) gives false
	end 'decl'
	if not isAlias 'notAlias'
		return ast.noType
	end 'notAlias'
	let typed = ast.declType(p, ms: ms, ref: ref)
	if not typed.isSome() 'untyped'
		return ast.noType
	end 'untyped'
	let t = typed.unwrap()
	if ast.isIntType(ms.types, reads: p.types, t: t) or ast.isFloatType(ms.types, reads: p.types, t: t) or ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.primBool 'primitive'
		return t
	end 'primitive'
	return ast.noType
end 'primitiveAliasNamed'

// intFamily, floatFamily and boolName are the words that name the integers, the floats and bool as the qualifier of a static.
let intFamily = "int"

let floatFamily = "float"

let boolName = "bool"

// callMember types 'Type.function(...)', 'Union.case(...)' and 'object.method(...)'.
function callMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, callee ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let obj = ast.memberExprObj(ms.tree(), id: callee)
	let name = ast.memberExprName(ms.tree(), id: callee).clone()
	let primitive = primitiveNamed(c, p: p, ms: ms, e: obj)
	if primitive != ast.noType 'primitive'
		return callPrimitiveStatic(c, p: p, ms: ms, call: call, t: primitive, name: name, errs: errs)
	end 'primitive'
	let param = typeParamNamed(c, p: p, ms: ms, e: obj)
	if param != ast.noType 'parameter'
		return callOnTypeParam(c, p: p, ms: ms, call: call, param: param, name: name, errs: errs)
	end 'parameter'
	var named = ast.noType
	if ms.tree().kindOf(obj) == ast.NodeKind.nameExpr 'headIsName'
		let mark = errs.count()
		named = typeNamed(c, p: p, ms: ms, name: obj, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return ast.noType
		end 'failed'
	end 'headIsName'
	if named != ast.noType 'type'
		return callOnType(c, p: p, ms: ms, call: call, nt: named, name: name, errs: errs)
	end 'type'
	let receiver = checkExpr(c, p: p, ms: ms, e: obj, errs: errs)
	if receiver == ast.noType 'badReceiver'
		return ast.noType
	end 'badReceiver'
	return callOnValue(c, p: p, ms: ms, call: call, receiver: receiver, name: name, errs: errs)
end 'callMember'

// callPrimitiveStatic types a call of a static function on the qualifier t: a primitive's name, a typealias of an integer, a
// float or bool, or the `Self` of a static function of an extension of a primitive family. A static function of a family
// is generic over its `Self`, which the call binds to the qualifier.
function callPrimitiveStatic(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, t ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let mark = errs.count()
	let sf = methodOf(c, p: p, ms: ms, t: staticHolder(p, ms: ms, t: t), name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if sf != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sf).isStatic 'static'
		var given = ast.TypeIDList.create(0)
		if ast.familyOfSelf(ms.types, reads: p.types, t: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sf).ownerTy) != ast.noType 'ofFamily'
			given.push(t)
		end 'ofFamily'
		return callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callStatic, target: sf, hasGiven: given.count() > 0, given: given, errs: errs)
	end 'static'
	return unknownFunction(c, p: p, ms: ms, call: call, name: "{nameOfType(p, ms: ms, t: t)}.{name}", qualifiers: 1 as Count, fix: diag.Fix.none(), errs: errs)
end 'callPrimitiveStatic'

// typeParamNamed is the type parameter that the expression e names, or none: a type parameter's name outranks a
// declaration of that name.
function typeParamNamed(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns ast.TypeID
	if ms.tree().kindOf(e) != ast.NodeKind.nameExpr 'notName'
		return ast.noType
	end 'notName'
	match ast.resolutionOf(p, ms: ms).typeParamSlots.get(e as Count) 'slot'
		some(slot) then return typeParamOfNode(c, p: p, ms: ms, node: ast.resolutionOf(p, ms: ms).typeParams[slot].id)
		none then return ast.noType
	end 'slot'
end 'typeParamNamed'

// callOnTypeParam refuses a call written on a type parameter's name: a static requirement has no receiver to dispatch
// on, so only a concrete type reaches it.
function callOnTypeParam(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, param ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let paramName = nameOfType(p, ms: ms, t: param)
	let req = boundRequirement(p, ms: ms, boundedFn: c.boundedFn, param: param, name: name)
	if req.sig != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: req.sig).isStatic 'static'
		failAt(c, p: p, ms: ms, node: call, code: diag.errStaticRequirementNotDispatchable, msg: diag.staticRequirementNotDispatchable("{paramName}.{name}", reacher: "the type parameter '{paramName}'"), errs: errs)
		return ast.noType
	end 'static'
	return unknownFunction(c, p: p, ms: ms, call: call, name: "{paramName}.{name}", qualifiers: 1 as Count, fix: diag.Fix.none(), errs: errs)
end 'callOnTypeParam'

// boundRequirement is the first requirement of that name among the bounds of the type parameter param, or one whose sig
// is none.
function boundRequirement(p ast.Project, ms ast.ModuleState, boundedFn ast.FuncID, param ast.TypeID, name String) returns ast.Requirement
	let bounds = boundsOfParam(p, ms: ms, boundedFn: boundedFn, paramTy: param)
	for i in 0 upto bounds.count() 'each'
		let named = requirementsNamed(p, ms: ms, iface: bounds[i], name: name)
		if named.count() > 0 'hit'
			return named[0].clone()
		end 'hit'
	end 'each'
	return ast.Requirement.make(ast.noType, sig: ast.noFunc, bindings: ast.TypeIDList.create(0))
end 'boundRequirement'

// overloadByFirstArgument is the function a call of the static function declared names: declared itself, or the form of
// it that the type of the first argument chooses, as maxon's __Builtins.hashBytes folds a byte array's bytes or a
// string's. The argument is typed here only where it is a variable, which typing again gives the same, and a form is
// chosen only for the argument's type alone.
function overloadByFirstArgument(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, declared ast.FuncID, mutates errs diag.ErrorList) returns ast.FuncID
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: declared).intrinsic != ast.Intrinsic.intrHashBytes 'single'
		return declared
	end 'single'
	let args = ast.callExprArgsRef(ms.tree(), id: call)
	if ms.tree().listLen(args) == 0 'none'
		return declared
	end 'none'
	let first = ast.argValue(ms.tree(), id: ms.tree().listAt(args, index: 0) as ast.NodeID)
	if ms.tree().kindOf(first) != ast.NodeKind.nameExpr 'notVariable'
		return declared
	end 'notVariable'
	if checkExpr(c, p: p, ms: ms, e: first, errs: errs) == p.builtins.stringTy 'string'
		return p.builtins.hashStringBytesFunc
	end 'string'
	return declared
end 'overloadByFirstArgument'

// callOnType types a call written on a type's name: a case of a union that carries a payload, or a static function.
function callOnType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, nt ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	if isFamilyType(p, t: nt) or ast.familyOfSelf(ms.types, reads: p.types, t: nt) != ast.noType 'family'
		return callPrimitiveStatic(c, p: p, ms: ms, call: call, t: nt, name: name, errs: errs)
	end 'family'
	if ast.typeKind(ms.types, reads: p.types, t: nt) == ast.TypeKind.typeParam 'parameter'
		return callOnTypeParam(c, p: p, ms: ms, call: call, param: nt, name: name, errs: errs)
	end 'parameter'
	if ast.typeKind(ms.types, reads: p.types, t: nt) == ast.TypeKind.unionTy and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: nt)).findCase(name).isSome() 'union'
		return unionConstructor(c, p: p, ms: ms, call: call, ut: nt, caseName: name, errs: errs)
	end 'union'
	if name == "create" and ast.originOf(ms.types, reads: p.types, t: nt) == p.builtins.fixedArrayOrigin 'fixedArray'
		return callFixedArrayCreate(c, p: p, ms: ms, call: call, named: nt, errs: errs)
	end 'fixedArray'
	let mark = errs.count()
	let sm = methodOf(c, p: p, ms: ms, t: nt, name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if sm != ast.noFunc and hiddenOnBuiltin(c, p: p, ms: ms, nt: nt, f: sm) 'hidden'
		return unknownTypeFunction(c, p: p, ms: ms, call: call, nt: nt, name: name, errs: errs)
	end 'hidden'
	if sm != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sm).isStatic 'static'
		var target = overloadByFirstArgument(c, p: p, ms: ms, call: call, declared: sm, errs: errs)
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).intrinsic == ast.Intrinsic.intrArrayCreate and ms.tree().listLen(ast.callExprArgsRef(ms.tree(), id: call)) == 2 'zeroed'
			target = p.builtins.arrayCreateZeroedFunc
		end 'zeroed'
		return callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callStatic, target: target, hasGiven: ast.typeEntry(ms.types, reads: p.types, t: nt).typeArgs.count() > 0, given: ast.typeEntry(ms.types, reads: p.types, t: nt).typeArgs.clone(), errs: errs)
	end 'static'
	if sm != ast.noFunc 'instance'
		return refuseInstanceMethodWithoutReceiver(c, p: p, ms: ms, node: ast.callExprCallee(ms.tree(), id: call), owner: nt, name: name, errs: errs)
	end 'instance'
	return unknownTypeFunction(c, p: p, ms: ms, call: call, nt: nt, name: name, errs: errs)
end 'callOnType'

// hiddenOnBuiltin is whether f is a function that the library's extension of a built-in type nt declares and keeps from the
// module of the call: as far as that module is concerned the built-in has no such function, so a call of it is one of a
// function the type lacks (unknownTypeFunction), which a type of that name in another module of the program may have.
function hiddenOnBuiltin(c Checker, p ast.Project, ms ast.ModuleState, nt ast.TypeID, f ast.FuncID) returns bool
	let origin = ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: nt))
	if (origin.hasDecl and origin.decl.module != diag.stdlibID) or declares(c, p: p, ms: ms, f: f) 'declared'
		return false
	end 'declared'
	let entry = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f)
	return not ast.isVisibleFrom(p, v: ast.visibilityOf(entry.visibility), owner: entry.module, from: c.modID)
end 'hiddenOnBuiltin'

// unknownTypeFunction refuses a call of a function that the type it is written on does not have. A bare type name that the
// module does not declare is a built-in, and where another module declares a type of that name, maxon's bare lookup finds
// that one, so the error names it with its module and its fix writes the module.
function unknownTypeFunction(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, nt ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let written = "{nameOfType(p, ms: ms, t: nt)}.{name}"
	let callee = ast.callExprCallee(ms.tree(), id: call)
	if ms.tree().kindOf(callee) == ast.NodeKind.memberExpr 'member'
		let head = ast.memberExprObj(ms.tree(), id: callee)
		if ms.tree().kindOf(head) == ast.NodeKind.nameExpr and not isQualifiedName(c, p: p, ms: ms, e: head) and not p.modules[c.modIdx].names.has(ast.nameExprName(ms.tree(), id: head)) 'builtIn'
			diag.pushUnqualifiedErrorAt(errs, code: diag.errUnknownFunction, message: undefinedFunctionText(written), module: c.modID, offset: offsetOf(c, p: p, ms: ms, node: call), name: ast.nameExprName(ms.tree(), id: head).clone(), at: offsetOf(c, p: p, ms: ms, node: head))
			return ast.noType
		end 'builtIn'
	end 'member'
	return unknownFunction(c, p: p, ms: ms, call: call, name: written, qualifiers: 1 as Count, fix: diag.Fix.none(), errs: errs)
end 'unknownTypeFunction'

// callOnValue types 'value.method(...)'.
function callOnValue(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, receiver ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	if name == cloneMethod 'clone'
		return copyCall(c, p: p, ms: ms, call: call, t: receiver, errs: errs)
	end 'clone'
	let content = ast.contentType(ms.types, reads: p.types, t: receiver)
	if ast.isServiceType(ms.types, reads: p.types, t: content) 'service'
		return callSend(c, p: p, ms: ms, call: call, handle: content, name: name, errs: errs)
	end 'service'
	if not requireNotCown(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: call), t: content, use: "calling '{name}'", errs: errs) 'cown'
		return ast.noType
	end 'cown'
	if typeHasKind(p, ms: ms, t: content, kind: ast.TypeKind.typeParam) 'parameter'
		return boundCall(c, p: p, ms: ms, call: call, param: content, receiver: receiver, name: name, errs: errs)
	end 'parameter'
	if typeHasKind(p, ms: ms, t: content, kind: ast.TypeKind.interfaceTy) 'interface'
		return witnessCall(c, p: p, ms: ms, call: call, iface: content, receiver: receiver, name: name, errs: errs)
	end 'interface'
	let mark = errs.count()
	let method = methodOf(c, p: p, ms: ms, t: content, name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if method != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).extendedIface != ast.noType 'ofInterface'
		return callInterfaceExtension(c, p: p, ms: ms, call: call, receiver: receiver, content: content, method: method, have: ast.seenInterfaces(p, ms: ms, from: c.modID, t: content), errs: errs)
	end 'ofInterface'
	if method != ast.noFunc and not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).isStatic 'instance'
		return callMethod(c, p: p, ms: ms, call: call, receiver: receiver, content: content, method: method, name: name, errs: errs)
	end 'instance'
	var fix = diag.Fix.none()
	if name == "append" and content == p.builtins.stringTy 'stringAppend'
		fix = stringAppendFix(ms.tree(), call: call)
	end 'stringAppend' else if name == toStringMethod and interpolatesItself(p, ms: ms, t: content) 'toString'
		fix = toStringFix(ms.tree(), call: call)
	end 'toString'
	return unknownFunction(c, p: p, ms: ms, call: call, name: "{nameOfType(p, ms: ms, t: receiver)}.{name}", qualifiers: 1 as Count, fix: fix, errs: errs)
end 'callOnValue'

function callMethod(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, receiver ast.TypeID, content ast.TypeID, method ast.FuncID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	if not requireNotFrozenChange(c, p: p, ms: ms, call: call, recv: receiver, conv: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).selfConv, method: name, errs: errs) 'frozen'
		return ast.noType
	end 'frozen'
	return callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callMethod, target: method, hasGiven: ast.typeEntry(ms.types, reads: p.types, t: content).typeArgs.count() > 0, given: ast.typeEntry(ms.types, reads: p.types, t: content).typeArgs.clone(), errs: errs)
end 'callMethod'

// callInterfaceExtension types a call of the method that an extension of an interface adds, on a value of the type
// content, which implements the interfaces have: the instance at content and the associated types that it binds, whose
// bound the verify stage checks as any instance's, with the conformance the module of the call sees.
function callInterfaceExtension(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, receiver ast.TypeID, content ast.TypeID, method ast.FuncID, have ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	if not requireNotFrozenChange(c, p: p, ms: ms, call: call, recv: receiver, conv: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).selfConv, method: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).name, errs: errs) 'frozen'
		return ast.noType
	end 'frozen'
	let args = ast.interfaceExtensionArgs(p, ms: ms, recv: content, have: have, fid: method)
	queueBorrowFree(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: call), params: ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).generics), args: args)
	queueBounds(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: call), params: ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).generics), args: args)
	return callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callMethod, target: method, hasGiven: true, given: args, errs: errs)
end 'callInterfaceExtension'

// requireNotFrozenChange refuses a call that would change or consume the contents of a frozen value.
function requireNotFrozenChange(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, recv ast.TypeID, conv ast.Convention, method String, mutates errs diag.ErrorList) returns bool
	if isFrozenType(p, ms: ms, t: recv) and conv != ast.Convention.convLet 'frozen'
		failAt(c, p: p, ms: ms, node: call, code: diag.errFrozenChange, msg: "'{method}' takes its receiver as {conv.keyword()}, and the contents of a frozen value are immutable and owned by it; call it on a copy: 'thaw(x).{method}(...)' gives an owned value", errs: errs)
		return false
	end 'frozen'
	return true
end 'requireNotFrozenChange'

// requireOwnedResult refuses a function that returns a borrowed place where the language calls it for the program and
// takes what it gives as a value of its own: the cursor and the elements of a for, and 'Type from "text"'.
function requireOwnedResult(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, target ast.FuncID, use String, mutates errs diag.ErrorList) returns bool
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).result == ast.ResultConv.resultOwned 'owned'
		return true
	end 'owned'
	let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).name.clone()
	failAt(c, p: p, ms: ms, node: node, code: diag.errUnsupported, msg: "'{name}' returns a borrowed place, and {use} takes a value of its own from it, which is not supported yet; declare it 'returns T' to give a value", errs: errs)
	return false
end 'requireOwnedResult'

// callFunction types a call of a function, a method or a static function, once it is known which. given are the type
// arguments of the instance a method or a static function is called on, which a generic callee takes as they are.
function callFunction(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, kind ast.CallKind, target ast.FuncID, hasGiven bool, given ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	if ast.intrinsicRuntimeOnly(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).intrinsic) and not p.modules[c.modIdx].isRuntime 'outsideRuntime'
		failAt(c, p: p, ms: ms, node: call, code: diag.errRawIntrinsicOutsideRuntime, msg: diag.rawIntrinsicOutsideRuntime(funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: target)), errs: errs)
		return ast.noType
	end 'outsideRuntime'
	if refusesRawCall(c, p: p, ms: ms, call: call, target: target, errs: errs) 'raw'
		return ast.noType
	end 'raw'
	if not requireVisible(c, p: p, ms: ms, node: call, target: target, errs: errs) 'hidden'
		return ast.noType
	end 'hidden'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).generics.count() > 0 'generic'
		return callGeneric(c, p: p, ms: ms, call: call, kind: kind, target: target, hasGiven: hasGiven, given: given, errs: errs)
	end 'generic'
	let specs = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).params.clone()
	let callee = funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: target)
	var info = ast.CallInfo.make(kind, fn: target, receiverTy: ast.noType)
	info.paramSpecs = specs.clone()
	info.selfConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).selfConv
	info.intrinsic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).intrinsic
	info.result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).result
	if info.intrinsic == ast.Intrinsic.intrFloatTrunc 'trunc'
		return callTrunc(c, p: p, ms: ms, call: call, callee: callee, specs: specs, info: info, errs: errs)
	end 'trunc'
	if declares(c, p: p, ms: ms, f: target) 'declared'
		let mark = errs.count()
		info.ordered = bindArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: receiverCount(p, ms: ms, f: target), argsChecked: false, payload: false, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return ast.noType
		end 'failed'
		c.typing.calls.insert(call as Count, value: info)
		return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).retTy
	end 'declared'
	c.typing.calls.insert(call as Count, value: info)
	if not typeArgumentsOfOtherModule(c, p: p, ms: ms, call: call, specs: specs, errs: errs) 'badArgs'
		return ast.noType
	end 'badArgs'
	queuePending(c, call: call, callee: callee, fn: target, specs: specs)
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).retTy
end 'callFunction'

// typeArgumentsOfOtherModule types the arguments of a call that is verified later, each with the type of the parameter it
// stands for as its expected type, as a call in the module does, so an argument means the same whichever module the
// callee is in. One that stands for no parameter is an error that verify reports.
function typeArgumentsOfOtherModule(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, specs ast.ParamSpecList, mutates errs diag.ErrorList) returns bool
	let argsRef = ast.callExprArgsRef(ms.tree(), id: call)
	let count = ms.tree().listLen(argsRef)
	for i in 0 upto count 'each'
		let arg = ms.tree().listAt(argsRef, index: i) as ast.NodeID
		var want = ast.noType
		match consumes argSlot(i, label: ast.argLabel(ms.tree(), id: arg), specs: specs) 'slot'
			some(slot) then want = expectedFor(specs, slot: slot, given: count)
			none then _ = 0
		end 'slot'
		if checkExpecting(c, p: p, ms: ms, e: ast.argValue(ms.tree(), id: arg), want: want, errs: errs) == ast.noType 'failed'
			return false
		end 'failed'
	end 'each'
	return true
end 'typeArgumentsOfOtherModule'

function expectedFor(specs ast.ParamSpecList, slot Count, given Count) returns ast.TypeID
	if slot < specs.count() and given == specs.count() 'fits'
		return specs[slot].ty
	end 'fits'
	return ast.noType
end 'expectedFor'

// receiverCount is how many arguments beyond its parameters a function takes: its receiver, which maxon counts in the arity of a method.
function receiverCount(p ast.Project, ms ast.ModuleState, f ast.FuncID) returns Count
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).hasReceiver 'method'
		return 1
	end 'method'
	return 0
end 'receiverCount'

// callGeneric types a call whose callee has type parameters. given are the arguments of the instance the callee is called
// on, which were checked against their bounds where the instance was written; without them they are inferred.
function callGeneric(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, kind ast.CallKind, target ast.FuncID, hasGiven bool, given ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	let callee = funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: target)
	let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).generics)
	let declared = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).params.clone()
	var args = given.clone()
	var specs = declared.clone()
	var ordered = ast.NodeIDList.create(0)
	let mark = errs.count()
	if hasGiven 'instance'
		specs = applySpecs(p, ms: ms, specs: declared, params: generics, args: given)
		ordered = orderArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: receiverCount(p, ms: ms, f: target), errs: errs)
		if failedSince(errs, mark: mark) 'badOrder'
			return ast.noType
		end 'badOrder'
		for i in 0 upto specs.count() 'typed'
			if ordered[i] == 0 'defaulted'
				continue 'typed'
			end 'defaulted'
			if checkExpecting(c, p: p, ms: ms, e: ordered[i], want: specs[i].ty, errs: errs) == ast.noType 'failed'
				return ast.noType
			end 'failed'
		end 'typed'
	end 'instance' else 'inferred'
		ordered = checkedArgs(c, p: p, ms: ms, call: call, callee: callee, specs: declared, receivers: receiverCount(p, ms: ms, f: target), errs: errs)
		if failedSince(errs, mark: mark) 'badArgs'
			return ast.noType
		end 'badArgs'
	end 'inferred'
	let intrinsic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).intrinsic
	let isFree = intrinsic != ast.Intrinsic.intrNone and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).ownerTy == ast.noType
	if isFree 'checkFirst'
		checkIntrinsicArgs(c, p: p, ms: ms, call: call, target: target, ordered: ordered, errs: errs)
		if failedSince(errs, mark: mark) 'badIntrinsic'
			return ast.noType
		end 'badIntrinsic'
	end 'checkFirst'
	let off = offsetOf(c, p: p, ms: ms, node: call)
	if not hasGiven 'infer'
		let result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).retTy
		// A static of a generic type called through the type's bare name names no instance of it, which maxon refuses under a
		// code of its own; a generic function that its call does not fix is the inference's refusal.
		let ofType = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).ownerTy != ast.noType
		let code = diag.errBareGenericSubjectUnbound if ofType else diag.errCannotInfer
		args = infer(c, p: p, ms: ms, node: call, callee: callee, params: generics, specs: declared, ordered: ordered, result: result, code: code, errs: errs)
		if failedSince(errs, mark: mark) 'cannotInfer'
			return ast.noType
		end 'cannotInfer'
		queueBorrowFree(c, p: p, ms: ms, off: off, params: generics, args: args)
		queueBounds(c, p: p, ms: ms, off: off, params: generics, args: args)
		specs = applySpecs(p, ms: ms, specs: declared, params: generics, args: args)
	end 'infer'
	queueMethodBounds(c, p: p, ms: ms, off: off, method: target, args: args)
	var info = ast.CallInfo.make(kind, fn: target, receiverTy: ast.noType)
	info.typeArgs = args.clone()
	info.paramSpecs = specs.clone()
	info.selfConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).selfConv
	info.intrinsic = intrinsic
	info.result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).result
	info.ordered = ordered.clone()
	c.typing.calls.insert(call as Count, value: info)
	if intrinsic == ast.Intrinsic.intrNone 'user'
		recordUse(c, call: call)
	end 'user' else if not isFree 'checkAfter'
		checkIntrinsicArgs(c, p: p, ms: ms, call: call, target: target, ordered: ordered, errs: errs)
		if failedSince(errs, mark: mark) 'badIntrinsic'
			return ast.noType
		end 'badIntrinsic'
	end 'checkAfter'
	if not declares(c, p: p, ms: ms, f: target) 'pending'
		queuePending(c, call: call, callee: callee, fn: target, specs: specs)
	end 'pending' else 'bound'
		for i in 0 upto specs.count() 'each'
			if ordered[i] == 0 'defaulted'
				continue 'each'
			end 'defaulted'
			if not coerceArg(c, p: p, ms: ms, call: call, value: ordered[i], callee: callee, spec: specs[i], payload: false, errs: errs) 'badArg'
				return ast.noType
			end 'badArg'
		end 'each'
	end 'bound'
	return ast.substituteType(ms.types, reads: p.types, t: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).retTy, params: generics, args: args)
end 'callGeneric'

// unionConstructor types 'Union.case(payload)'. A generic union written without type arguments takes them from the
// payload.
function unionConstructor(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, ut ast.TypeID, caseName String, mutates errs diag.ErrorList) returns ast.TypeID
	let orig = ast.originOf(ms.types, reads: p.types, t: ut)
	let caseIndex = caseIndexNamed(p, ms: ms, orig: orig, name: caseName)
	let unionName = nameOfType(p, ms: ms, t: ut)
	if ast.typeEntry(ms.types, reads: p.types, t: orig).cases[caseIndex].payload.count() == 0 'noPayload'
		failAt(c, p: p, ms: ms, node: call, code: diag.errCallArgCountMismatch, msg: "case '{caseName}' carries no payload: write '{unionName}.{caseName}'", errs: errs)
		return ast.noType
	end 'noPayload'
	var info = ast.CallInfo.make(ast.CallKind.callUnionCtor, fn: ast.noFunc, receiverTy: ast.noType)
	info.unionCase = caseIndex
	var specs = payloadSpecs(p, ms: ms, ut: ut, caseIndex: caseIndex)
	let callee = "{unionName}.{caseName}"
	var resolved = ut
	let mark = errs.count()
	var ordered = ast.NodeIDList.create(0)
	if ast.typeEntry(ms.types, reads: p.types, t: ut).typeParams.count() > 0 'generic'
		ordered = checkedArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: 0, errs: errs)
		if failedSince(errs, mark: mark) 'badArgs'
			return ast.noType
		end 'badArgs'
		let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: ut).typeParams)
		let own = ast.selfType(ms.types, reads: p.types, declTy: ut)
		let args = infer(c, p: p, ms: ms, node: call, callee: unionName, params: params, specs: specs, ordered: ordered, result: own, code: diag.errCannotInfer, errs: errs)
		if failedSince(errs, mark: mark) 'cannotInfer'
			return ast.noType
		end 'cannotInfer'
		resolved = instantiateGeneric(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: call), orig: ut, args: args, errs: errs)
		if resolved == ast.noType 'badInstance'
			return ast.noType
		end 'badInstance'
		specs = payloadSpecs(p, ms: ms, ut: resolved, caseIndex: caseIndex)
		for i in 0 upto specs.count() 'each'
			if not coerceArg(c, p: p, ms: ms, call: call, value: ordered[i], callee: callee, spec: specs[i], payload: true, errs: errs) 'badArg'
				return ast.noType
			end 'badArg'
		end 'each'
	end 'generic' else 'plain'
		ordered = bindArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: 0, argsChecked: false, payload: true, errs: errs)
		if failedSince(errs, mark: mark) 'badBind'
			return ast.noType
		end 'badBind'
	end 'plain'
	info.ordered = ordered
	info.unionTy = resolved
	info.paramSpecs = specs
	c.typing.calls.insert(call as Count, value: info)
	return resolved
end 'unionConstructor'

// caseIndexNamed is the place of the case of that name among those of a union or an enum, which has one.
function caseIndexNamed(p ast.Project, ms ast.ModuleState, orig ast.TypeID, name String) returns Count
	match ast.typeEntry(ms.types, reads: p.types, t: orig).findCase(name) 'case'
		some(i) then return i
		none then _ = 0
	end 'case'
	panic("'{ast.typeEntry(ms.types, reads: p.types, t: orig).name}' has no case '{name}'")
end 'caseIndexNamed'

// payloadSpecs are the parameters a union's constructor of a case takes: the payload, each consumed.
function payloadSpecs(p ast.Project, mutates ms ast.ModuleState, ut ast.TypeID, caseIndex Count) returns ast.ParamSpecList
	let orig = ast.originOf(ms.types, reads: p.types, t: ut)
	var specs = ast.ParamSpecList.create(0)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases[caseIndex].payload.count() 'each'
		let name = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[caseIndex].payload[i].name.clone()
		let t = ast.payloadType(ms.types, reads: p.types, owner: ut, caseIndex: caseIndex, index: i)
		specs.push(ast.ParamSpec.make(name, ty: t, conv: ast.Convention.convConsumes))
	end 'each'
	return specs
end 'payloadSpecs'

// boundCall types a call of a method that a type parameter's bounds declare. It is the only method a value of a type
// parameter has, and it runs the method of whatever type the parameter becomes.
function boundCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, param ast.TypeID, receiver ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let bounds = boundsOfParam(p, ms: ms, boundedFn: c.boundedFn, paramTy: param)
	let looked = errs.count()
	let req = uniqueBoundRequirement(c, p: p, ms: ms, node: call, param: param, bounds: bounds, name: name, errs: errs)
	if failedSince(errs, mark: looked) 'ambiguousBound'
		return ast.noType
	end 'ambiguousBound'
	let iface = req.iface
	let sig = req.sig
	if sig == ast.noFunc 'notRequired'
		let mark = errs.count()
		let extended = lookedUp(c, p: p, ms: ms, t: param, name: name, node: call, lookup: ast.interfaceExtensionMethod(p, ms: ms, from: c.modID, have: bounds, name: name), errs: errs)
		if failedSince(errs, mark: mark) 'ambiguous'
			return ast.noType
		end 'ambiguous'
		if extended != ast.noFunc 'extension'
			return callInterfaceExtension(c, p: p, ms: ms, call: call, receiver: receiver, content: param, method: extended, have: bounds, errs: errs)
		end 'extension'
		failAt(c, p: p, ms: ms, node: call, code: diag.errUnknownFunction, msg: "{nameOfType(p, ms: ms, t: param)} has no method '{name}'{boundsText(p, ms: ms, bounds: bounds, param: param)}", errs: errs)
		return ast.noType
	end 'notRequired'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).isStatic 'static'
		failAt(c, p: p, ms: ms, node: call, code: diag.errStaticRequirementNotDispatchable, msg: diag.staticRequirementNotDispatchable("{ast.typeEntry(ms.types, reads: p.types, t: iface).name}.{name}", reacher: "a value of type parameter '{nameOfType(p, ms: ms, t: param)}'"), errs: errs)
		return ast.noType
	end 'static'
	let selfConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).selfConv
	if not requireNotFrozenChange(c, p: p, ms: ms, call: call, recv: receiver, conv: selfConv, method: name, errs: errs) 'frozen'
		return ast.noType
	end 'frozen'
	let selfParams = requirementParams(p, ms: ms, iface: iface)
	let selfArgs = requirementBindings(param, req: req)
	let specs = applySpecs(p, ms: ms, specs: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).params.clone(), params: selfParams, args: selfArgs)
	let calleeName = "{nameOfType(p, ms: ms, t: param)}.{name}"
	var info = requirementCall(p, ms: ms, sig: sig, receiver: receiver, specs: specs)
	let mark = errs.count()
	info.ordered = bindArgs(c, p: p, ms: ms, call: call, callee: calleeName, specs: specs, receivers: 0, argsChecked: false, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'badArgs'
		return ast.noType
	end 'badArgs'
	c.typing.calls.insert(call as Count, value: info)
	recordUse(c, call: call)
	return ast.substituteType(ms.types, reads: p.types, t: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).retTy, params: selfParams, args: selfArgs)
end 'boundCall'

// uniqueBoundRequirement is the requirement named name that one of the bounds of the type parameter param declares, written at
// node, or one whose sig is noFunc where none does. Two bounds that declare it are an error, since a witness dispatch
// binds one table slot.
function uniqueBoundRequirement(mutates c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, param ast.TypeID, bounds ast.TypeIDList, name String, mutates errs diag.ErrorList) returns ast.Requirement
	var bound = ast.noType
	var req = ast.Requirement.make(ast.noType, sig: ast.noFunc, bindings: ast.TypeIDList.create(0))
	for i in 0 upto bounds.count() 'candidates'
		let named = requirementsNamed(p, ms: ms, iface: bounds[i], name: name)
		if named.count() > 1 'inheritedTwice'
			failAt(c, p: p, ms: ms, node: node, code: diag.errAmbiguousBound, msg: "'{name}' taking {ast.funcEntry(ms.funcs, funcReads: p.funcs, f: named[0].sig).params.count()} argument(s) is provided by both {requirementText(p, ms: ms, req: named[0])} and {requirementText(p, ms: ms, req: named[1])} through the constraints on type parameter '{nameOfType(p, ms: ms, t: param)}' — a witness dispatch binds ONE table slot, and these are two, so there is nothing to choose by. Rename one requirement, or drop one of the constraints", errs: errs)
			return req
		end 'inheritedTwice'
		if named.count() == 0 or named[0].sig == req.sig 'absentOrSame'
			continue 'candidates'
		end 'absentOrSame'
		if req.sig != ast.noFunc 'ambiguous'
			failAt(c, p: p, ms: ms, node: node, code: diag.errAmbiguousBound, msg: "the bounds '{nameOfType(p, ms: ms, t: bound)}' and '{nameOfType(p, ms: ms, t: bounds[i])}' of '{nameOfType(p, ms: ms, t: param)}' both declare '{name}'; keep only one bound that declares it", errs: errs)
			return req
		end 'ambiguous'
		bound = bounds[i]
		req = named[0].clone()
	end 'candidates'
	return req
end 'uniqueBoundRequirement'

// boundOperatorCall types a comparison on two values of the type parameter param as maxon's: a call of the 'equals' (for
// '==' and '!=') or the 'compare' (for an ordering) that a bound of it declares.
function boundOperatorCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, op String, param ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let bounds = boundsOfParam(p, ms: ms, boundedFn: c.boundedFn, paramTy: param)
	let name = operatorMethod(op)
	let mark = errs.count()
	let req = uniqueBoundRequirement(c, p: p, ms: ms, node: e, param: param, bounds: bounds, name: name, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguousBound'
		return ast.noType
	end 'ambiguousBound'
	if req.sig == ast.noFunc or not meetsOperator(p, ms: ms, f: req.sig, op: op) 'notMet'
		failAt(c, p: p, ms: ms, node: e, code: diag.errTypeMismatch, msg: diag.operatorRequiresConformance(op, typeParamName: nameOfType(p, ms: ms, t: param), interfaceName: operatorInterface(op)), errs: errs)
		return ast.noType
	end 'notMet'
	let specs = applySpecs(p, ms: ms, specs: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: req.sig).params.clone(), params: requirementParams(p, ms: ms, iface: req.iface), args: requirementBindings(param, req: req))
	let info = requirementCall(p, ms: ms, sig: req.sig, receiver: param, specs: specs)
	return recordOperatorCall(c, p: p, ms: ms, e: e, callee: "{nameOfType(p, ms: ms, t: param)}.{name}", info: info, errs: errs)
end 'boundOperatorCall'

// methodOperatorCall types a comparison on two values of the type t, a record or an array, as maxon's: a call of the type's
// own 'equals' (for '==' and '!=') or 'compare' (for an ordering), which it need not declare a conformance for. A type
// with no such method cannot be compared.
function methodOperatorCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, op String, t ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = operatorMethod(op)
	let mark = errs.count()
	let method = methodOf(c, p: p, ms: ms, t: t, name: name, node: e, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if method == ast.noFunc or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).extendedIface != ast.noType or not meetsOperator(p, ms: ms, f: method, op: op) 'none'
		failAt(c, p: p, ms: ms, node: e, code: diag.errTypeMismatch, msg: diag.comparisonTypeMismatch(gotName(p, ms: ms, t: t), right: gotName(p, ms: ms, t: t)), errs: errs)
		return ast.noType
	end 'none'
	if not requireVisible(c, p: p, ms: ms, node: e, target: method, errs: errs) 'hidden'
		return ast.noType
	end 'hidden'
	let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).generics)
	var specs = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).params.clone()
	var info = ast.CallInfo.make(ast.CallKind.callMethod, fn: method, receiverTy: ast.noType)
	if generics.count() > 0 'generic'
		let given = ast.typeEntry(ms.types, reads: p.types, t: t).typeArgs.clone()
		specs = applySpecs(p, ms: ms, specs: specs, params: generics, args: given)
		queueMethodBounds(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), method: method, args: given)
		info.typeArgs = given
	end 'generic'
	info.paramSpecs = specs
	info.selfConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).selfConv
	info.intrinsic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).intrinsic
	info.result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).result
	return recordOperatorCall(c, p: p, ms: ms, e: e, callee: "{nameOfType(p, ms: ms, t: t)}.{name}", info: info, errs: errs)
end 'methodOperatorCall'

// recordOperatorCall binds the right operand of the comparison e to the one parameter of the method that info calls, and
// records the call at the operator, with the left operand as its receiver.
function recordOperatorCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, callee String, consumes info ast.CallInfo, mutates errs diag.ErrorList) returns ast.TypeID
	let right = ast.binaryExprR(ms.tree(), id: e)
	if not coerceArg(c, p: p, ms: ms, call: e, value: right, callee: callee, spec: info.paramSpecs[0], payload: false, errs: errs) 'badArg'
		return ast.noType
	end 'badArg'
	var call = info
	var ordered = ast.NodeIDList.create(0)
	ordered.push(right)
	call.ordered = ordered.clone()
	let intrinsic = call.intrinsic
	let target = call.fn
	c.typing.calls.insert(e as Count, value: call)
	if intrinsic != ast.Intrinsic.intrNone 'builtIn'
		let mark = errs.count()
		checkIntrinsicArgs(c, p: p, ms: ms, call: e, target: target, ordered: ordered, errs: errs)
		if failedSince(errs, mark: mark) 'refused'
			return ast.noType
		end 'refused'
		return p.builtins.boolTy
	end 'builtIn'
	recordUse(c, call: e)
	return p.builtins.boolTy
end 'recordOperatorCall'

// meetsOperator is whether the method f is what the comparison op calls: an instance method of one parameter that returns
// bool for '==' and '!=', and an Ordering for an ordering.
function meetsOperator(p ast.Project, ms ast.ModuleState, f ast.FuncID, op String) returns bool
	let entry = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f)
	if entry.isStatic or entry.params.count() != 1 'shape'
		return false
	end 'shape'
	if isEqualityOp(op) 'equality'
		return entry.retTy == p.builtins.boolTy
	end 'equality'
	return ast.isOrdering(ms.types, reads: p.types, t: entry.retTy)
end 'meetsOperator'

function isEqualityOp(op String) returns bool
	return op == "==" or op == "!="
end 'isEqualityOp'

// operatorMethod is the method that the comparison op calls on a type that is no primitive.
function operatorMethod(op String) returns String
	if isEqualityOp(op) 'equality'
		return equalsMethod
	end 'equality'
	return compareMethod
end 'operatorMethod'

// operatorInterface is the interface whose requirement the comparison op calls on a type parameter.
function operatorInterface(op String) returns String
	if isEqualityOp(op) 'equality'
		return "Equatable"
	end 'equality'
	return "Comparable"
end 'operatorInterface'

// equalsMethod is the method that '==' calls on a type that is no primitive, Equatable's requirement.
let equalsMethod = "equals"

// compareMethod is the method that an ordering operator calls on a type that is no primitive, Comparable's requirement.
let compareMethod = "compare"

// requirementCall is a call through the requirement sig of an interface, on a receiver of a type parameter or of the
// interface: it runs the method of whatever type stands there, and its result is a value or a borrowed place as the
// requirement declares, which every method that meets it gives alike.
function requirementCall(p ast.Project, ms ast.ModuleState, sig ast.FuncID, receiver ast.TypeID, specs ast.ParamSpecList) returns ast.CallInfo
	var info = ast.CallInfo.make(ast.CallKind.callBound, fn: ast.noFunc, receiverTy: receiver)
	info.method = sig
	info.selfConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).selfConv
	info.paramSpecs = specs.clone()
	info.result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).result
	return info
end 'requirementCall'

function oneType(t ast.TypeID) returns ast.TypeIDList
	var list = ast.TypeIDList.create(0)
	list.push(t)
	return list
end 'oneType'

// boundsText says what a type parameter can call, for the error that names a method it cannot.
function boundsText(p ast.Project, ms ast.ModuleState, bounds ast.TypeIDList, param ast.TypeID) returns String
	let name = nameOfType(p, ms: ms, t: param)
	if bounds.count() == 0 'none'
		return ": a type parameter has only the methods of its bounds, and '{name}' has none; constrain it with 'where {name} implements <Interface>'"
	end 'none'
	var names = ast.StringList.create(0)
	for i in 0 upto bounds.count() 'each'
		names.push(nameOfType(p, ms: ms, t: bounds[i]))
	end 'each'
	return ": a type parameter has only the methods of its bounds ({ast.joinNames(names, sep: ", ")})"
end 'boundsText'

// copyCall types 'value.clone()'.
function copyCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if t == p.builtins.voidTy or t == p.builtins.neverTy 'noValue'
		failAt(c, p: p, ms: ms, node: call, code: diag.errTypeMismatch, msg: "an expression with no value cannot be copied", errs: errs)
		return ast.noType
	end 'noValue'
	let lacking = lacksCap(c, p: p, ms: ms, wantCopy: true, t: t)
	if lacking.missing 'noCopy'
		let why = lackWhyText(ms.types, reads: p.types, info: lacking, capName: "Copyable")
		let fix = lackFixText(ms.types, reads: p.types, info: lacking, capName: "Copyable")
		checkFailFixed(c.modID, off: offsetOf(c, p: p, ms: ms, node: call), code: diag.errNotCopyable, msg: "a value of '{nameOfType(p, ms: ms, t: t)}' cannot be copied: {why}; {fix}, or move the value instead of copying it", fix: lackBoundFix(p, ms: ms, fn: c.rootFn, info: lacking, capName: "Copyable"), errs: errs)
		return ast.noType
	end 'noCopy'
	var info = ast.CallInfo.make(ast.CallKind.callCopy, fn: ast.noFunc, receiverTy: t)
	let mark = errs.count()
	info.ordered = bindArgs(c, p: p, ms: ms, call: call, callee: cloneMethod, specs: ast.ParamSpecList.create(0), receivers: 0, argsChecked: false, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'badArgs'
		return ast.noType
	end 'badArgs'
	c.typing.calls.insert(call as Count, value: info)
	return t
end 'copyCall'
