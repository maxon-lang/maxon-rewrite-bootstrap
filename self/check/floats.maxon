// The typing of floats. A float constant is the double of its literal, folded through arithmetic as the hardware would
// compute it; any other float has the range of its alias, and an operation on one gives FullRangeFloat. An integer
// beside a float converts to it, and a float never converts to an integer.

// isNumberType is whether a value of the type takes part in arithmetic: an integer or a float.
function isNumberType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return ast.isIntType(ms.types, reads: p.types, t: t) or ast.isFloatType(ms.types, reads: p.types, t: t)
end 'isNumberType'

function isConstFloat(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return t != ast.noType and kindOfType(p, ms: ms, t: t) == ast.TypeKind.constFloat
end 'isConstFloat'

export function typeIsNamedFloat(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	return t != ast.noType and ast.typeKind(tt, reads: reads, t: t) == ast.TypeKind.floatRange and ast.typeEntry(tt, reads: reads, t: t).name != ""
end 'typeIsNamedFloat'

function typeIsAnonFloat(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	return t != ast.noType and ast.typeKind(tt, reads: reads, t: t) == ast.TypeKind.floatRange and ast.typeEntry(tt, reads: reads, t: t).name == ""
end 'typeIsAnonFloat'

// truncatedInteger is the type of the integer that a trunc is given, which it gives back as it is, as maxon's does: there
// is nothing to truncate, and a round trip through a double would lose the bits past its mantissa. It is noType for a
// float.
function truncatedInteger(c Checker, p ast.Project, ms ast.ModuleState, arg ast.NodeID) returns ast.TypeID
	let t = ast.nodeType(c.typing, node: arg)
	if ast.isIntType(ms.types, reads: p.types, t: t) 'integer'
		return t
	end 'integer'
	return ast.noType
end 'truncatedInteger'

// callTrunc types a call of trunc, whose argument is typed by itself first: an integer is the call's value and type, and a
// float is truncated to a FullRangeInt as the built-in declares.
function callTrunc(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, callee String, specs ast.ParamSpecList, consumes info ast.CallInfo, mutates errs diag.ErrorList) returns ast.TypeID
	let mark = errs.count()
	let ordered = orderArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: 0, errs: errs)
	if failedSince(errs, mark: mark) 'badOrder'
		return ast.noType
	end 'badOrder'
	if checkExpecting(c, p: p, ms: ms, e: ordered[0], want: ast.noType, errs: errs) == ast.noType 'badArg'
		return ast.noType
	end 'badArg'
	var typed = info
	let integer = truncatedInteger(c, p: p, ms: ms, arg: ordered[0])
	if integer != ast.noType 'identity'
		typed.ordered = ordered.clone()
		typed.paramSpecs[0].ty = integer
		c.typing.calls.insert(call as Count, value: typed)
		return integer
	end 'identity'
	typed.ordered = bindArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: 0, argsChecked: true, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'failed'
		return ast.noType
	end 'failed'
	c.typing.calls.insert(call as Count, value: typed)
	return p.builtins.fullRangeIntTy
end 'callTrunc'

// constantBits is the double of a constant: a float constant's, or an integer constant's converted.
function constantBits(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns Count
	if isConstFloat(p, ms: ms, t: t) 'float'
		return ast.floatLowBits(ms.types, reads: p.types, t: t)
	end 'float'
	return ast.floatFromInt(ast.typeEntry(ms.types, reads: p.types, t: t).minVal)
end 'constantBits'

// floatFits is whether a value of src goes where dst, a float range, is needed with no cast.
export function floatFits(p ast.Project, ms ast.ModuleState, src ast.TypeID, dst ast.TypeID) returns bool
	let sk = ast.typeKind(ms.types, reads: p.types, t: src)
	if sk == ast.TypeKind.constFloat or sk == ast.TypeKind.constInt 'constant'
		return ast.floatRangeHolds(ms.types, reads: p.types, t: dst, bits: constantBits(p, ms: ms, t: src))
	end 'constant'
	if sk == ast.TypeKind.floatRange 'range'
		return (typeIsAnonFloat(ms.types, reads: p.types, t: src) or typeIsAnonFloat(ms.types, reads: p.types, t: dst)) and ast.floatRangeCovers(ms.types, reads: p.types, dst: dst, src: src)
	end 'range'
	return false
end 'floatFits'

// floatValueText is how a diagnostic writes the double of a constant.
function floatValueText(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return ast.floatDiagnosticText(constantBits(p, ms: ms, t: t))
end 'floatValueText'

function floatOutOfRange(p ast.Project, ms ast.ModuleState, value ast.TypeID, target ast.TypeID) returns String
	let lo = ast.floatDiagnosticText(ast.floatLowBits(ms.types, reads: p.types, t: target))
	let hi = ast.floatDiagnosticText(ast.floatHighBits(ms.types, reads: p.types, t: target))
	return diag.floatOutOfRange(floatValueText(p, ms: ms, t: value), alias: ast.typeName(ms.types, reads: p.types, t: target), low: lo, high: hi)
end 'floatOutOfRange'

// floatMismatch is the error for a value of src where the float range target is needed, which it does not fit.
function floatMismatch(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, at diag.U32, src ast.TypeID, target ast.TypeID, wrong Mismatch, mutates errs diag.ErrorList)
	let sk = ast.typeKind(ms.types, reads: p.types, t: src)
	if sk == ast.TypeKind.constFloat or sk == ast.TypeKind.constInt 'constant'
		checkFail(c.modID, off: at, code: diag.errTypeMismatch, msg: floatOutOfRange(p, ms: ms, value: src, target: target), errs: errs)
		return
	end 'constant'
	let tName = ast.typeName(ms.types, reads: p.types, t: target)
	let castable = typeIsAnonFloat(ms.types, reads: p.types, t: src) or ast.isIntType(ms.types, reads: p.types, t: src)
	var fix = diag.Fix.none()
	if castable 'cast'
		fix = castFix(ms.tree(), e: node, target: tName)
	end 'cast'
	checkFailFixed(c.modID, off: at, code: diag.errTypeMismatch, msg: wrong.words(tName, got: gotName(p, ms: ms, t: src), castable: false), fix: fix, errs: errs)
end 'floatMismatch'

// requireOneFloatAlias refuses two operands of float aliases with no common ancestor, as two integer aliases are.
function requireOneFloatAlias(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns bool
	if typeIsNamedFloat(ms.types, reads: p.types, t: l) and typeIsNamedFloat(ms.types, reads: p.types, t: r) and ast.commonSupertype(ms.types, reads: p.types, a: l, b: r) == ast.noType 'diff'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "the operands are {ast.typeName(ms.types, reads: p.types, t: l)} and {ast.typeName(ms.types, reads: p.types, t: r)}; cast one so both are the same type", errs: errs)
		return false
	end 'diff'
	return true
end 'requireOneFloatAlias'

// checkFloatOp types an arithmetic operator one of whose operands is a float.
function checkFloatOp(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: e)
	if op != "+" and op != "-" and op != "*" and op != "/" 'notArithmetic'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "'{op}' needs integers, found {nameOfType(p, ms: ms, t: l)} and {nameOfType(p, ms: ms, t: r)}; a float has + - * / and no '{op}'", errs: errs)
		return ast.noType
	end 'notArithmetic'
	if not isNumberType(p, ms: ms, t: l) or not isNumberType(p, ms: ms, t: r) 'notNumbers'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "'{op}' needs numbers, found {nameOfType(p, ms: ms, t: l)} and {nameOfType(p, ms: ms, t: r)}", errs: errs)
		return ast.noType
	end 'notNumbers'
	if not requireOneFloatAlias(c, p: p, ms: ms, off: off, l: l, r: r, errs: errs) 'twoAliases'
		return ast.noType
	end 'twoAliases'
	setOperand(c, node: e, operand: p.builtins.anonFloatTy)
	let lConst = isConstFloat(p, ms: ms, t: l) or isConstInt(p, ms: ms, t: l)
	let rConst = isConstFloat(p, ms: ms, t: r) or isConstInt(p, ms: ms, t: r)
	if lConst and rConst 'folded'
		return ast.internConstFloat(ms.types, reads: p.types, bits: foldFloat(op, a: constantBits(p, ms: ms, t: l), b: constantBits(p, ms: ms, t: r)))
	end 'folded'
	return p.builtins.anonFloatTy
end 'checkFloatOp'

function foldFloat(op String, a Count, b Count) returns Count
	return match op 'op'
		"+" gives ast.floatAdd(a, b: b)
		"-" gives ast.floatSub(a, b: b)
		"*" gives ast.floatMul(a, b: b)
		"/" gives ast.floatDiv(a, b: b)
		default panic("check: '{op}' is no float operator")
	end 'op'
end 'foldFloat'

// checkFloatComparison types a comparison one of whose operands is a float; the other may be an integer, which converts.
function checkFloatComparison(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: e)
	if not isNumberType(p, ms: ms, t: l) or not isNumberType(p, ms: ms, t: r) 'notNumbers'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.comparisonTypeMismatch(nameOfType(p, ms: ms, t: l), right: nameOfType(p, ms: ms, t: r)), errs: errs)
		return ast.noType
	end 'notNumbers'
	if not requireOneFloatAlias(c, p: p, ms: ms, off: off, l: l, r: r, errs: errs) 'twoAliases'
		return ast.noType
	end 'twoAliases'
	setOperand(c, node: e, operand: p.builtins.anonFloatTy)
	return p.builtins.boolTy
end 'checkFloatComparison'

// checkFloatNegation types '-' on a float: the sign of the double flips, so a constant stays one and a range turns over.
function checkFloatNegation(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	if isConstFloat(p, ms: ms, t: t) 'constant'
		return ast.internConstFloat(ms.types, reads: p.types, bits: ast.floatNegate(ast.floatLowBits(ms.types, reads: p.types, t: t)))
	end 'constant'
	let lo = ast.floatNegate(ast.floatHighBits(ms.types, reads: p.types, t: t))
	let hi = ast.floatNegate(ast.floatLowBits(ms.types, reads: p.types, t: t))
	return ast.internFloatRange(ms.types, reads: p.types, aliasName: "", lo: lo, hi: hi)
end 'checkFloatNegation'

// checkFloatCast types a cast to the float range target: from a constant, whose double must fit, or from any other
// integer or float, which the range analysis checks.
function checkFloatCast(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, src ast.TypeID, target ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if isConstFloat(p, ms: ms, t: src) or isConstInt(p, ms: ms, t: src) 'constant'
		if not ast.floatRangeHolds(ms.types, reads: p.types, t: target, bits: constantBits(p, ms: ms, t: src)) 'doesNotFit'
			checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: floatOutOfRange(p, ms: ms, value: src, target: target), errs: errs)
			return ast.noType
		end 'doesNotFit'
		return target
	end 'constant'
	if isNumberType(p, ms: ms, t: src) 'number'
		return target
	end 'number'
	failCast(c, p: p, ms: ms, off: off, src: src, target: target, errs: errs)
	return ast.noType
end 'checkFloatCast'

// convertsFloat is whether a value of src is converted to the float range dst where it is returned, as an 'as' would:
// an integer or another float, which the range analysis checks.
export function convertsFloat(p ast.Project, ms ast.ModuleState, src ast.TypeID, dst ast.TypeID) returns bool
	if src == ast.noType or dst == ast.noType 'err'
		return false
	end 'err'
	if ast.typeKind(ms.types, reads: p.types, t: dst) != ast.TypeKind.floatRange 'notFloat'
		return false
	end 'notFloat'
	let sk = ast.typeKind(ms.types, reads: p.types, t: src)
	if sk != ast.TypeKind.floatRange and sk != ast.TypeKind.intRange 'notConverted'
		return false
	end 'notConverted'
	return not floatFits(p, ms: ms, src: src, dst: dst)
end 'convertsFloat'

// floatConversionFails is how a conversion of a value of src to the float range dst can fail: where the value may lie
// outside it.
export function floatConversionFails(p ast.Project, ms ast.ModuleState, src ast.TypeID, dst ast.TypeID) returns Byte
	if ast.isFullFloatRange(ms.types, reads: p.types, t: dst) 'all'
		return ast.failNone
	end 'all'
	let sk = ast.typeKind(ms.types, reads: p.types, t: src)
	if sk == ast.TypeKind.floatRange and ast.floatRangeCovers(ms.types, reads: p.types, dst: dst, src: src) 'covered'
		return ast.failNone
	end 'covered'
	if sk == ast.TypeKind.intRange 'integer'
		let lo = ast.floatFromInt(ast.typeEntry(ms.types, reads: p.types, t: src).minVal)
		let hi = ast.floatFromInt(ast.typeEntry(ms.types, reads: p.types, t: src).maxVal)
		if ast.floatRangeHolds(ms.types, reads: p.types, t: dst, bits: lo) and ast.floatRangeHolds(ms.types, reads: p.types, t: dst, bits: hi) 'held'
			return ast.failNone
		end 'held'
	end 'integer'
	return ast.failBelow or ast.failAbove
end 'floatConversionFails'

// floatRangeText is how the range analysis's errors write a float range.
export function floatRangeText(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return "{ast.floatDiagnosticText(ast.floatLowBits(ms.types, reads: p.types, t: t))} to {ast.floatDiagnosticText(ast.floatHighBits(ms.types, reads: p.types, t: t))}"
end 'floatRangeText'
