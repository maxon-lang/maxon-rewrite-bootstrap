// The typing of floats. A float constant is the double of its literal, folded through arithmetic as the hardware would
// compute it; any other float has the range of its alias, and an operation on one gives FullRangeFloat. An integer
// beside a float converts to it, and a float never converts to an integer.

// isNumberType is whether a value of the type takes part in arithmetic: an integer or a float.
function isNumberType(p ast.Project, t ast.TypeID) returns bool
	return ast.isIntType(p.types, t: t) or ast.isFloatType(p.types, t: t)
end 'isNumberType'

function isConstFloat(p ast.Project, t ast.TypeID) returns bool
	return t != ast.noType and kindOfType(p, t: t) == ast.TypeKind.constFloat
end 'isConstFloat'

export function typeIsNamedFloat(tt ast.TypeTable, t ast.TypeID) returns bool
	return t != ast.noType and tt.entries[t as Count].kind == ast.TypeKind.floatRange and tt.entries[t as Count].name != ""
end 'typeIsNamedFloat'

function typeIsAnonFloat(tt ast.TypeTable, t ast.TypeID) returns bool
	return t != ast.noType and tt.entries[t as Count].kind == ast.TypeKind.floatRange and tt.entries[t as Count].name == ""
end 'typeIsAnonFloat'

// constantBits is the double of a constant: a float constant's, or an integer constant's converted.
function constantBits(p ast.Project, t ast.TypeID) returns Count
	if isConstFloat(p, t: t) 'float'
		return ast.floatLowBits(p.types, t: t)
	end 'float'
	return ast.floatFromInt(p.types.entries[t as Count].minVal)
end 'constantBits'

// floatFits is whether a value of src goes where dst, a float range, is needed with no cast.
export function floatFits(p ast.Project, src ast.TypeID, dst ast.TypeID) returns bool
	let sk = p.types.entries[src as Count].kind
	if sk == ast.TypeKind.constFloat or sk == ast.TypeKind.constInt 'constant'
		return ast.floatRangeHolds(p.types, t: dst, bits: constantBits(p, t: src))
	end 'constant'
	if sk == ast.TypeKind.floatRange 'range'
		return (typeIsAnonFloat(p.types, t: src) or typeIsAnonFloat(p.types, t: dst)) and ast.floatRangeCovers(p.types, dst: dst, src: src)
	end 'range'
	return false
end 'floatFits'

// floatValueText is how a diagnostic writes the double of a constant.
function floatValueText(p ast.Project, t ast.TypeID) returns String
	return ast.floatDiagnosticText(constantBits(p, t: t))
end 'floatValueText'

function floatOutOfRange(p ast.Project, value ast.TypeID, target ast.TypeID) returns String
	let lo = ast.floatDiagnosticText(ast.floatLowBits(p.types, t: target))
	let hi = ast.floatDiagnosticText(ast.floatHighBits(p.types, t: target))
	return diag.floatOutOfRange(floatValueText(p, t: value), alias: ast.typeName(p.types, t: target), low: lo, high: hi)
end 'floatOutOfRange'

// floatMismatch is the error for a value of src where the float range target is needed, which it does not fit.
function floatMismatch(c Checker, mutates p ast.Project, node ast.NodeID, at diag.U32, src ast.TypeID, target ast.TypeID, wrong Mismatch, mutates errs diag.ErrorList)
	let sk = p.types.entries[src as Count].kind
	if sk == ast.TypeKind.constFloat or sk == ast.TypeKind.constInt 'constant'
		checkFail(c.modID, off: at, code: diag.errTypeMismatch, msg: floatOutOfRange(p, value: src, target: target), errs: errs)
		return
	end 'constant'
	let tName = ast.typeName(p.types, t: target)
	let castable = typeIsAnonFloat(p.types, t: src) or ast.isIntType(p.types, t: src)
	var fix = diag.Fix.none()
	if castable 'cast'
		fix = castFix(p.modules[c.modIdx].tree, e: node, target: tName)
	end 'cast'
	checkFailFixed(c.modID, off: at, code: diag.errTypeMismatch, msg: wrong.words(tName, got: gotName(p, t: src), castable: castable), fix: fix, errs: errs)
end 'floatMismatch'

// requireOneFloatAlias refuses two operands of different float aliases, as two integer aliases are.
function requireOneFloatAlias(c Checker, p ast.Project, off diag.U32, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns bool
	if typeIsNamedFloat(p.types, t: l) and typeIsNamedFloat(p.types, t: r) and l != r 'diff'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "the operands are {ast.typeName(p.types, t: l)} and {ast.typeName(p.types, t: r)}; cast one so both are the same type", errs: errs)
		return false
	end 'diff'
	return true
end 'requireOneFloatAlias'

// checkFloatOp types an arithmetic operator one of whose operands is a float.
function checkFloatOp(mutates c Checker, mutates p ast.Project, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: e)
	if op != "+" and op != "-" and op != "*" and op != "/" 'notArithmetic'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "'{op}' needs integers, found {nameOfType(p, t: l)} and {nameOfType(p, t: r)}; a float has + - * / and no '{op}'", errs: errs)
		return ast.noType
	end 'notArithmetic'
	if not isNumberType(p, t: l) or not isNumberType(p, t: r) 'notNumbers'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "'{op}' needs numbers, found {nameOfType(p, t: l)} and {nameOfType(p, t: r)}", errs: errs)
		return ast.noType
	end 'notNumbers'
	if not requireOneFloatAlias(c, p: p, off: off, l: l, r: r, errs: errs) 'twoAliases'
		return ast.noType
	end 'twoAliases'
	setOperand(c, node: e, operand: p.builtins.anonFloatTy)
	let lConst = isConstFloat(p, t: l) or isConstInt(p, t: l)
	let rConst = isConstFloat(p, t: r) or isConstInt(p, t: r)
	if lConst and rConst 'folded'
		return ast.internConstFloat(p.types, bits: foldFloat(op, a: constantBits(p, t: l), b: constantBits(p, t: r)))
	end 'folded'
	return p.builtins.anonFloatTy
end 'checkFloatOp'

function foldFloat(op String, a Count, b Count) returns Count
	return match op 'op'
		"+" gives ast.floatAdd(a, b: b)
		"-" gives ast.floatSub(a, b: b)
		"*" gives ast.floatMul(a, b: b)
		"/" gives ast.floatDiv(a, b: b)
		default panic("check: '{op}' is no float operator")
	end 'op'
end 'foldFloat'

// checkFloatComparison types a comparison one of whose operands is a float; the other may be an integer, which converts.
function checkFloatComparison(mutates c Checker, mutates p ast.Project, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: e)
	if not isNumberType(p, t: l) or not isNumberType(p, t: r) 'notNumbers'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.comparisonTypeMismatch(nameOfType(p, t: l), right: nameOfType(p, t: r)), errs: errs)
		return ast.noType
	end 'notNumbers'
	if not requireOneFloatAlias(c, p: p, off: off, l: l, r: r, errs: errs) 'twoAliases'
		return ast.noType
	end 'twoAliases'
	setOperand(c, node: e, operand: p.builtins.anonFloatTy)
	return p.builtins.boolTy
end 'checkFloatComparison'

// checkFloatNegation types '-' on a float: the sign of the double flips, so a constant stays one and a range turns over.
function checkFloatNegation(mutates p ast.Project, t ast.TypeID) returns ast.TypeID
	if isConstFloat(p, t: t) 'constant'
		return ast.internConstFloat(p.types, bits: ast.floatNegate(ast.floatLowBits(p.types, t: t)))
	end 'constant'
	let lo = ast.floatNegate(ast.floatHighBits(p.types, t: t))
	let hi = ast.floatNegate(ast.floatLowBits(p.types, t: t))
	return ast.internFloatRange(p.types, aliasName: "", lo: lo, hi: hi)
end 'checkFloatNegation'

// checkFloatCast types a cast to the float range target: from a constant, whose double must fit, or from any other
// integer or float, which the range analysis checks.
function checkFloatCast(c Checker, mutates p ast.Project, off diag.U32, src ast.TypeID, target ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if isConstFloat(p, t: src) or isConstInt(p, t: src) 'constant'
		if not ast.floatRangeHolds(p.types, t: target, bits: constantBits(p, t: src)) 'doesNotFit'
			checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: floatOutOfRange(p, value: src, target: target), errs: errs)
			return ast.noType
		end 'doesNotFit'
		return target
	end 'constant'
	if isNumberType(p, t: src) 'number'
		return target
	end 'number'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "cannot cast {nameOfType(p, t: src)} to {nameOfType(p, t: target)}", errs: errs)
	return ast.noType
end 'checkFloatCast'

// convertsFloat is whether a value of src is converted to the float range dst where it is returned, as an 'as' would:
// an integer or another float, which the range analysis checks.
export function convertsFloat(p ast.Project, src ast.TypeID, dst ast.TypeID) returns bool
	if src == ast.noType or dst == ast.noType 'err'
		return false
	end 'err'
	if p.types.entries[dst as Count].kind != ast.TypeKind.floatRange 'notFloat'
		return false
	end 'notFloat'
	let sk = p.types.entries[src as Count].kind
	if sk != ast.TypeKind.floatRange and sk != ast.TypeKind.intRange 'notConverted'
		return false
	end 'notConverted'
	return not floatFits(p, src: src, dst: dst)
end 'convertsFloat'

// floatConversionFails is how a conversion of a value of src to the float range dst can fail: where the value may lie
// outside it.
export function floatConversionFails(p ast.Project, src ast.TypeID, dst ast.TypeID) returns Byte
	if ast.isFullFloatRange(p.types, t: dst) 'all'
		return ast.failNone
	end 'all'
	let sk = p.types.entries[src as Count].kind
	if sk == ast.TypeKind.floatRange and ast.floatRangeCovers(p.types, dst: dst, src: src) 'covered'
		return ast.failNone
	end 'covered'
	if sk == ast.TypeKind.intRange 'integer'
		let lo = ast.floatFromInt(p.types.entries[src as Count].minVal)
		let hi = ast.floatFromInt(p.types.entries[src as Count].maxVal)
		if ast.floatRangeHolds(p.types, t: dst, bits: lo) and ast.floatRangeHolds(p.types, t: dst, bits: hi) 'held'
			return ast.failNone
		end 'held'
	end 'integer'
	return ast.failBelow or ast.failAbove
end 'floatConversionFails'

// floatRangeText is how the range analysis's errors write a float range.
export function floatRangeText(p ast.Project, t ast.TypeID) returns String
	return "{ast.floatDiagnosticText(ast.floatLowBits(p.types, t: t))} to {ast.floatDiagnosticText(ast.floatHighBits(p.types, t: t))}"
end 'floatRangeText'
