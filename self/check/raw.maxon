// The doors of maxon's raw surface (E3185): naming a type of it, calling a function or a method of it, and reading a view.
// They read and write memory past the ownership model's bookkeeping, so only a module of a library tier goes through one;
// each refusal is at the door, in maxon's words, with what a program uses instead.

// checksLibraryTier is whether the module being checked is in a library tier, which may go through the raw surface's doors
// and write cowns and behaviours.
function checksLibraryTier(c Checker, p ast.Project) returns bool
	return p.modules[c.modIdx].inLibraryTier()
end 'checksLibraryTier'

// refusesRawType refuses a type of the raw surface that a module outside the library tiers names at off.
function refusesRawType(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, t ast.TypeID, mutates errs diag.ErrorList) returns bool
	let origin = ast.originOf(ms.types, reads: p.types, t: t)
	if refusesMissingFacility(c, p: p, ms: ms, off: off, origin: origin, errs: errs) 'missing'
		return true
	end 'missing'
	if checksLibraryTier(c, p: p) 'tier'
		return false
	end 'tier'
	match consumes ast.rawTypeSurface(p.builtins, origin: origin) 'raw'
		some(door) then checkFail(c.modID, off: off, code: diag.errRawSurfaceOutsideLibrary, msg: diag.rawTypeOutsideLibrary(ast.typeEntry(ms.types, reads: p.types, t: origin).name.clone(), what: door.what, instead: door.instead), errs: errs)
		none then return refusesRawLibraryType(c, p: p, ms: ms, off: off, origin: origin, errs: errs)
	end 'raw'
	return true
end 'refusesRawType'

// refusesMissingFacility refuses a type of the library that is a facility the target's system does not have yet (E3104,
// ast.missingFacility), named at off by a module outside the library: TcpClient on x64-windows. The library's own modules name
// it freely, since a program that never names it compiles them too.
function refusesMissingFacility(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, origin ast.TypeID, mutates errs diag.ErrorList) returns bool
	if p.modules[c.modIdx].isLibrary or p.modules[c.modIdx].isRuntime 'library'
		return false
	end 'library'
	let entry = ast.typeEntry(ms.types, reads: p.types, t: origin)
	if not entry.hasDecl or entry.decl.module == diag.stdlibID or not ast.isLibraryModule(p, modID: entry.decl.module) 'unlisted'
		return false
	end 'unlisted'
	let why = ast.missingFacility(entry.name.clone(), system: p.target.system)
	if why.isEmpty() 'provided'
		return false
	end 'provided'
	checkFail(c.modID, off: off, code: diag.errTargetUnsupported, msg: "'{entry.name}' is not available for {p.target.name()}: {why}", errs: errs)
	return true
end 'refusesMissingFacility'

// refusesRawLibraryType refuses a type of the raw surface that the library declares (__ManagedFile), named at off outside the
// library tiers. Only a module of a library tier declares a name that starts with `__` (E2051), so a declared type of such a
// name is the library's.
function refusesRawLibraryType(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, origin ast.TypeID, mutates errs diag.ErrorList) returns bool
	if not ast.typeEntry(ms.types, reads: p.types, t: origin).hasDecl 'undeclared'
		return false
	end 'undeclared'
	let name = ast.typeEntry(ms.types, reads: p.types, t: origin).name.clone()
	match consumes ast.rawLibraryTypeSurface(name.clone()) 'raw'
		some(door) then checkFail(c.modID, off: off, code: diag.errRawSurfaceOutsideLibrary, msg: diag.rawTypeOutsideLibrary(name, what: door.what, instead: door.instead), errs: errs)
		none then return false
	end 'raw'
	return true
end 'refusesRawLibraryType'

// refusesRawCall refuses a call that a module outside the library tiers makes of a raw static function, of a raw member of a
// type that is not raw (a door such as `SlotKey.fromWord`), or of a method of a type of the raw surface. Any other static
// function of such a type is called on its name, which refusesRawType refused already.
function refusesRawCall(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, target ast.FuncID, mutates errs diag.ErrorList) returns bool
	if p.modules[c.modIdx].inLibraryTier() or writesSelfStop(ms, call: call, target: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).intrinsic) 'tier'
		return false
	end 'tier'
	let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).ownerTy
	if owner == ast.noType 'free'
		return false
	end 'free'
	let origin = ast.originOf(ms.types, reads: p.types, t: owner)
	let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).name.clone()
	match consumes ast.rawCallInstead(p.builtins, owner: origin, name: name) 'call'
		some(instead) then return refuseRawCall(c, p: p, ms: ms, call: call, ownerName: ast.typeEntry(ms.types, reads: p.types, t: origin).name.clone(), name: name, instead: instead, errs: errs)
		none then _ = 0
	end 'call'
	match consumes ast.rawMemberSurface(p.builtins, owner: origin, name: name.clone()) 'member'
		some(door) then return refuseRawMember(c, p: p, ms: ms, call: call, name: name, door: door, errs: errs)
		none then _ = 0
	end 'member'
	if not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).hasReceiver 'static'
		return false
	end 'static'
	match consumes ast.rawMethodSurface(p.builtins, origin: origin) 'method'
		some(door) then return refuseRawMember(c, p: p, ms: ms, call: call, name: name, door: door, errs: errs)
		none then return false
	end 'method'
	return false
end 'refusesRawCall'

function refuseRawMember(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, name String, door ast.RawSurface, mutates errs diag.ErrorList) returns bool
	failAt(c, p: p, ms: ms, node: call, code: diag.errRawSurfaceOutsideLibrary, msg: diag.rawMemberOutsideLibrary("{name}()", what: door.what, instead: door.instead), errs: errs)
	return true
end 'refuseRawMember'

function refuseRawCall(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ownerName String, name String, instead String, mutates errs diag.ErrorList) returns bool
	failAt(c, p: p, ms: ms, node: call, code: diag.errRawSurfaceOutsideLibrary, msg: diag.rawCallOutsideLibrary("{ownerName}.{name}", owner: ownerName, instead: instead), errs: errs)
	return true
end 'refuseRawCall'

// checkViewMember types a view of a built-in generic value, `xs.managed`: the same value as an instance of the view's type
// at the value's type arguments, which a module outside the library tiers may not read.
function checkViewMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, member String, consumes view ast.BuiltinView, mutates errs diag.ErrorList) returns ast.TypeID
	if not p.modules[c.modIdx].inLibraryTier() 'outside'
		failAt(c, p: p, ms: ms, node: e, code: diag.errRawSurfaceOutsideLibrary, msg: diag.rawMemberOutsideLibrary(member, what: view.surface.what, instead: view.surface.instead), errs: errs)
		return ast.noType
	end 'outside'
	c.typing.members.insert(e as Count, value: ast.MemberInfo.make(ast.MemberKind.memberView, ownerTy: t))
	let args = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: t).typeArgs)
	return instantiateGeneric(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), orig: view.origin, args: args, errs: errs)
end 'checkViewMember'
