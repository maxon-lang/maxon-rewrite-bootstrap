// declareRecordMembers declares what a type holds: the interfaces it implements and its fields. A field without a type
// takes one from its default, which declareFieldDefaults finds.
function declareRecordMembers(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, td ast.TypeDecl, tid ast.TypeID, mutates errs diag.ErrorList)
	let mark = errs.count()
	declareConforms(c, p: p, ms: ms, interfaces: td.conforms, nt: tid, errs: errs)
	if failedSince(errs, mark: mark) 'conforms'
		return
	end 'conforms'
	let selfTy = ast.selfType(ms.types, reads: p.types, declTy: tid)
	for i in 0 upto td.fields.count() 'each'
		let f = td.fields[i].clone()
		if ast.typeEntry(ms.types, reads: p.types, t: tid).findField(f.name).isSome() 'dup'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: f.id), code: diag.errDuplicateDefinition, msg: diag.duplicateField(f.name, typeName: td.name), errs: errs)
			return
		end 'dup'
		var ft = p.builtins.voidTy
		if f.typeRef != 0 'typed'
			ft = resolveTypeRef(c, p: p, ms: ms, tr: f.typeRef, selfTy: selfTy, errs: errs)
			if failedSince(errs, mark: mark) 'badType'
				return
			end 'badType'
		end 'typed'
		if f.typeRef != 0 and ast.holdsGrowingInstance(ms.types, reads: p.types, t: ft, origin: tid) 'grows'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: f.typeRef), code: diag.errGenericGrowsWithoutBound, msg: diag.genericTypeGrowsWithoutBound(f.name, owner: td.name, declared: declaredTypeName(p, ms: ms, c: c, tr: f.typeRef, t: ft)), errs: errs)
			return
		end 'grows'
		let level = ast.visibilityOf(f.visibility)
		var info = ast.FieldInfo.make(f.name.clone(), ty: ft, isVar: f.isVar, exported: level != ast.Visibility.unexported, hasDefault: f.defaultRef != 0, defaultExpr: f.defaultRef, index: ast.typeEntry(ms.types, reads: p.types, t: tid).fields.count())
		info.level = level
		ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].fields.push(info)
	end 'each'
end 'declareRecordMembers'

// declaredTypeName is how a declaration writes a type in a message: the typealias that names it, else the type.
function declaredTypeName(p ast.Project, ms ast.ModuleState, c Checker, tr ast.NodeID, t ast.TypeID) returns String
	match consumes ast.nodeDecl(p, ms: ms, node: tr as Count) 'bound'
		some(ref) then return aliasOrTypeName(p, ms: ms, ref: ref, t: t)
		none then return ast.typeName(ms.types, reads: p.types, t: t)
	end 'bound'
end 'declaredTypeName'

function aliasOrTypeName(p ast.Project, ms ast.ModuleState, ref ast.DeclRef, t ast.TypeID) returns String
	return match ast.moduleDecl(p, ref: ref) 'd'
		aliasDecl(_) gives ast.declName(p, ref: ref)
		funcDecl(_) gives ast.typeName(ms.types, reads: p.types, t: t)
		constDecl(_) gives ast.typeName(ms.types, reads: p.types, t: t)
		typeDecl(_) gives ast.typeName(ms.types, reads: p.types, t: t)
		enumDecl(_) gives ast.typeName(ms.types, reads: p.types, t: t)
		unionDecl(_) gives ast.typeName(ms.types, reads: p.types, t: t)
		interfaceDecl(_) gives ast.typeName(ms.types, reads: p.types, t: t)
		extensionDecl(_) gives ast.typeName(ms.types, reads: p.types, t: t)
	end 'd'
end 'aliasOrTypeName'

// RawState is the raw values of the cases of an enum or a union read so far: what they are, which the first case settles
// (a case that writes none is an integer; one that writes a value that is no literal makes them all values, whose types
// the constants stage compares), and the integer that the next case without one has.
type RawState
	var kind as ast.RawKind
	var started as bool
	var next as ast.I128
	// value, text and explicit are the raw value of the case read last: its integer or the bits of its float, the text of its
	// string, and whether it wrote one.
	var value as ast.I128
	var text as String
	var explicit as bool
	// expr is the expression of the case read last when it is a value, and 0 otherwise.
	var expr as ast.NodeID

	static function new() returns RawState
		return RawState{kind: ast.RawKind.integer, started: false, next: ast.I128.zero(), value: ast.I128.zero(), text: "", explicit: false, expr: 0 as ast.NodeID}
	end 'new'
end 'RawState'

// rawKindOf is the kind of raw value that a case writes: the literal's kind, an integer for a case that writes none, and a
// value for any other expression.
function rawKindOf(p ast.Project, ms ast.ModuleState, raw ast.NodeID) returns ast.RawKind
	if raw == 0 'none'
		return ast.RawKind.integer
	end 'none'
	let k = ms.tree.kindOf(raw)
	if k == ast.NodeKind.intLit 'integer'
		return ast.RawKind.integer
	end 'integer'
	if k == ast.NodeKind.floatLit 'float'
		return ast.RawKind.float
	end 'float'
	if k == ast.NodeKind.strLit 'string'
		return ast.RawKind.string
	end 'string'
	return ast.RawKind.value
end 'rawKindOf'

// readRaw reads the raw value that a case writes, or the integer that counts up for a case that writes none, into st, and
// refuses a literal that is not of the kind the first case settled or that another case of the type has. A value that is no
// literal is typed by the constants stage, which compares it with the others there, so it makes every case a value. It gives
// whether it did not refuse.
function readRaw(mutates c Checker, p ast.Project, ms ast.ModuleState, tid ast.TypeID, raw ast.NodeID, off diag.U32, mutates st RawState, mutates errs diag.ErrorList) returns bool
	st.explicit = raw != 0
	let kind = rawKindOf(p, ms: ms, raw: raw)
	let valued = kind == ast.RawKind.value or (st.started and st.kind == ast.RawKind.value)
	if st.started and not valued and st.kind != kind 'mismatch'
		checkFail(c.modID, off: off, code: diag.errEnumRawValueTypeMismatch, msg: diag.rawValueTypeMismatch(st.kind.noun(), got: kind.noun()), errs: errs)
		return false
	end 'mismatch'
	st.started = true
	st.kind = ast.RawKind.value if valued else kind
	st.expr = raw if kind == ast.RawKind.value else 0 as ast.NodeID
	var shown = ""
	if kind == ast.RawKind.integer 'integer'
		st.value = st.next.clone()
		if st.explicit 'written'
			st.value = ast.intLitValue(ms.tree, id: raw)
		end 'written'
		st.next = st.value.add(ast.I128.one())
		st.text = ""
		shown = st.value.toString()
	end 'integer' else if kind == ast.RawKind.float 'floatKind'
		let bits = ast.floatLitBits(ms.tree, id: raw)
		st.value = ast.I128.fromCount(bits)
		st.text = ""
		shown = ast.floatDiagnosticText(bits)
	end 'floatKind' else if kind == ast.RawKind.string 'stringKind'
		let parts = ast.strLitPartsRef(ms.tree, id: raw)
		if not ms.tree.strIsPlain(parts) 'interpolated'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: raw), code: diag.errRawValueNotLiteral, msg: "a raw value is a constant: write the string without an interpolated value", errs: errs)
			return false
		end 'interpolated'
		st.value = ast.I128.zero()
		st.text = ast.strPartsText(ms.tree, partsRef: parts)
		shown = st.text.clone()
	end 'stringKind' else 'valueKind'
		st.value = ast.I128.zero()
		st.text = ""
	end 'valueKind'
	if valued 'unordered'
		return true
	end 'unordered'
	for j in 0 upto ast.typeEntry(ms.types, reads: p.types, t: tid).cases.count() 'rawDup'
		let other = ast.typeEntry(ms.types, reads: p.types, t: tid).cases[j].clone()
		if other.rawValue.eq(st.value) and other.rawText == st.text 'same'
			checkFail(c.modID, off: off, code: diag.errEnumDuplicateRawValue, msg: diag.duplicateRawValue(shown), errs: errs)
			return false
		end 'same'
	end 'rawDup'
	return true
end 'readRaw'

// pushRawCase adds the case that readRaw has read to the type, with the payload it has.
function pushRawCase(p ast.Project, mutates ms ast.ModuleState, tid ast.TypeID, consumes name String, consumes payload ast.CaseFieldList, st RawState)
	var info = ast.CaseInfo.make(name, payload: payload, hasRaw: st.explicit, rawValue: st.value.clone())
	info.rawText = st.text.clone()
	info.rawExpr = st.expr
	ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].cases.push(info)
	ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].rawKind = st.kind
	if st.explicit and st.kind != ast.RawKind.value 'explicit'
		ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].hasExplicitRaw = true
	end 'explicit'
end 'pushRawCase'

// declareEnumMembers declares the cases of an enum, each with the raw value it writes or else the one after the case
// before.
function declareEnumMembers(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ed ast.EnumDecl, tid ast.TypeID, mutates errs diag.ErrorList)
	let mark = errs.count()
	declareConforms(c, p: p, ms: ms, interfaces: ed.conforms, nt: tid, errs: errs)
	if failedSince(errs, mark: mark) 'conforms'
		return
	end 'conforms'
	var st = RawState.new()
	for i in 0 upto ed.cases.count() 'each'
		let cs = ed.cases[i].clone()
		let off = offsetOf(c, p: p, ms: ms, node: cs.id)
		if ast.typeEntry(ms.types, reads: p.types, t: tid).findCase(cs.name).isSome() 'dup'
			checkFail(c.modID, off: off, code: diag.errEnumDuplicateCase, msg: diag.duplicateEnumCase(cs.name), errs: errs)
			return
		end 'dup'
		if not readRaw(c, p: p, ms: ms, tid: tid, raw: cs.raw, off: off, st: st, errs: errs) 'refused'
			return
		end 'refused'
		pushRawCase(p, ms: ms, tid: tid, name: cs.name.clone(), payload: ast.CaseFieldList.create(0), st: st)
	end 'each'
end 'declareEnumMembers'

// declareUnionMembers declares the cases of a union and the payload of each.
function declareUnionMembers(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ud ast.UnionDecl, tid ast.TypeID, mutates errs diag.ErrorList)
	let mark = errs.count()
	declareConforms(c, p: p, ms: ms, interfaces: ud.conforms, nt: tid, errs: errs)
	if failedSince(errs, mark: mark) 'conforms'
		return
	end 'conforms'
	let selfTy = ast.selfType(ms.types, reads: p.types, declTy: tid)
	var st = RawState.new()
	for i in 0 upto ud.cases.count() 'each'
		let cs = ud.cases[i].clone()
		if ast.typeEntry(ms.types, reads: p.types, t: tid).findCase(cs.name).isSome() 'dup'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: cs.id), code: diag.errEnumDuplicateCase, msg: diag.duplicateEnumCase(cs.name), errs: errs)
			return
		end 'dup'
		var payload = ast.CaseFieldList.create(0)
		for j in 0 upto cs.fields.count() 'fields'
			let f = cs.fields[j].clone()
			if f.convention != "" 'convention'
				checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: f.id), code: diag.errUnexpectedToken, msg: "a union payload is not a parameter and takes no '{f.convention}'", errs: errs)
				return
			end 'convention'
			let t = resolveTypeRef(c, p: p, ms: ms, tr: f.typeRef, selfTy: selfTy, errs: errs)
			if failedSince(errs, mark: mark) 'badType'
				return
			end 'badType'
			payload.push(ast.CaseFieldInfo.make(f.name.clone(), ty: t))
		end 'fields'
		if not readRaw(c, p: p, ms: ms, tid: tid, raw: cs.raw, off: offsetOf(c, p: p, ms: ms, node: cs.id), st: st, errs: errs) 'refused'
			return
		end 'refused'
		pushRawCase(p, ms: ms, tid: tid, name: cs.name.clone(), payload: payload, st: st)
	end 'each'
end 'declareUnionMembers'

// declareParentInterfaces records the interfaces that an interface extends in its conforms. A parent binds no associated
// types, which its requirements would have to take from the child's, and one that extends the interface again is a cycle.
function declareParentInterfaces(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ifd ast.InterfaceDecl, tid ast.TypeID, mutates errs diag.ErrorList)
	let off = offsetOf(c, p: p, ms: ms, node: ifd.id)
	let parents = conformedInterfaces(c, p: p, ms: ms, interfaces: ifd.parents, capabilities: true, errs: errs)
	for i in 0 upto parents.count() 'each'
		let parent = parents[i]
		let parentName = ast.typeEntry(ms.types, reads: p.types, t: parent).name.clone()
		if ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: parent)).typeParams.count() > 0 'generic'
			checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: "the interface '{ifd.name}' extends '{parentName}', which has associated types; an interface extends only interfaces without them, so list '{parentName}' in the 'implements' of each type instead", errs: errs)
			return
		end 'generic'
		if ast.extendsInterface(ms.types, reads: p.types, have: parent, want: tid) 'cycle'
			checkFail(c.modID, off: off, code: diag.errResolutionCycle, msg: "interface '{ifd.name}' forms a type cycle: the interface it extends, '{parentName}', extends '{ifd.name}'", errs: errs)
			return
		end 'cycle'
		ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].conforms.push(parent)
	end 'each'
end 'declareParentInterfaces'

// declareInterfaceMembers declares the methods an interface requires, each a signature in which 'Self' is the type that
// implements the interface.
function declareInterfaceMembers(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ifd ast.InterfaceDecl, tid ast.TypeID, mutates errs diag.ErrorList)
	let selfParam = ast.allocType(ms.types, module: c.modID, e: ast.TypeEntry.make(ast.TypeKind.typeParam, name: "Self"))
	ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].selfParam = selfParam
	declareParentInterfaces(c, p: p, ms: ms, ifd: ifd, tid: tid, errs: errs)
	for i in 0 upto ifd.methods.count() 'each'
		declareSignature(c, p: p, ms: ms, it: tid, m: ifd.methods[i].clone(), errs: errs)
	end 'each'
end 'declareInterfaceMembers'
