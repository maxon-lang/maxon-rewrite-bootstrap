// enterContext makes the checker ready for code outside any function, or inside f whose owner is the type owner.
function enterContext(mutates c Checker, p ast.Project, f ast.FuncID, owner ast.TypeID, calls bool)
	c.fn = f
	c.rootFn = f
	c.boundedFn = ast.noFunc
	if f != ast.noFunc and p.funcs.slots[ast.funcSlot(f)][ast.funcIndex(f)].bounds.count() > 0 'bounded'
		c.boundedFn = f
	end 'bounded'
	c.whens = 0 as Count
	c.inBehaviour = false
	c.inClosure = false
	c.outers = Array.create(0)
	c.owner = owner
	c.constName = ""
	c.inRawValue = false
	c.allowCalls = calls
	c.scopes = ScopeList.create(0)
	c.scopes.push(LocalScope.new())
	c.blocks = BlockFrameList.create(0)
	c.nextSlot = 0 as Count
	c.dead = false
	c.tries = Array.create(0)
	c.bindings = Array.create(0)
	c.statement = 0 as ast.NodeID
	c.usesNode = 0 as ast.NodeID
	c.usesField = false
	c.hasUses = false
	c.recorded = ast.NodeIDList.create(0)
	c.fnLocals = ast.LocalIDList.create(0)
end 'enterContext'

// newFuncEntry makes the entry of a function or a method and registers it under its node, and a function of the
// module's top level under its declaration too. A method belongs to the type nt; a function to none.
function newFuncEntry(mutates c Checker, mutates p ast.Project, f ast.FuncDecl, ownerTy ast.TypeID, ref ast.DeclRef) returns ast.FuncID
	var fn = ast.FuncEntry.make(f.name.clone(), visibility: f.visibility.clone(), module: c.modID, nodeID: f.id)
	fn.isStatic = f.isStatic
	fn.isDestructor = f.receiver == ast.Convention.convDestructs.keyword()
	fn.hasReceiver = ownerTy != ast.noType and not f.isStatic
	fn.bodyRef = f.body
	fn.isTest = f.testName != ""
	if ownerTy == ast.noType 'free'
		fn.hasDecl = true
		fn.decl = ref.clone()
	end 'free'
	let fid = ast.allocFunc(p.funcs, module: c.modID, f: fn)
	ast.setNodeFunc(p, module: c.modID, node: f.id, f: fid)
	if ownerTy == ast.noType 'registered'
		ast.setDeclFunc(p, ref: ref, f: fid)
	end 'registered'
	return fid
end 'newFuncEntry'

// declareGenerics gives a function its type parameters: its own, or for a method the ones of its type, which its
// 'where' may bound further. A method that an extension of an interface adds belongs to the extension's parameter 'Self',
// and takes it and the associated types of the interface that bounds it.
function declareGenerics(mutates c Checker, mutates p ast.Project, f ast.FuncDecl, fid ast.FuncID, nt ast.TypeID, mutates errs diag.ErrorList)
	let isMethod = nt != ast.noType
	if f.typeParams.count() > 0 and isMethod 'ownParams'
		checkFail(c.modID, off: offsetOf(c, p: p, node: f.id), code: diag.errGenericDeclaration, msg: "the method '{f.name}' takes no type parameters of its own: use the type's, or write a function", errs: errs)
		return
	end 'ownParams'
	let ofInterface = isMethod and ast.typeKind(p.types, t: nt) == ast.TypeKind.typeParam
	if isMethod and (ofInterface or p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].typeParams.count() > 0) 'ofType'
		var generics = ast.cloneTypeArgs(p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].typeParams)
		if ofInterface 'interface'
			generics.push(nt)
			generics.append(p.types.lists[ast.typeList(p.types, t: p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].bounds[0].ifaceTy)][ast.typeIndex(p.types, t: p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].bounds[0].ifaceTy)].typeArgs)
		end 'interface'
		var bounds = ast.ParamBoundList.create(0)
		let mark = errs.count()
		for i in 0 upto f.whereList.count() 'cons'
			let cs = f.whereList[i].clone()
			let constrained = boundedParamOf(c, p: p, cs: cs)
			for bi in 0 upto p.modules[c.modIdx].tree.listLen(cs.bounds) 'bounds'
				let iface = resolveBoundTypeRef(c, p: p, tr: p.modules[c.modIdx].tree.listAt(cs.bounds, index: bi) as ast.NodeID, isBound: true, errs: errs)
				if failedSince(errs, mark: mark) 'failed'
					return
				end 'failed'
				bounds.push(ast.ParamBound.make(constrained, ifaceTy: iface))
			end 'bounds'
		end 'cons'
		p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].generics = generics
		p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].bounds = bounds
		return
	end 'ofType'
	if f.typeParams.count() > 0 'own'
		var generics = ast.TypeIDList.create(0)
		declareFunctionTypeParams(c, p: p, params: f.typeParams, constraints: f.whereList, generics: generics, errs: errs)
		p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].generics = generics
	end 'own'
end 'declareGenerics'

// addFunction declares the signature of a function or of a method of the type nt, which is none for a function.
function addFunction(mutates c Checker, mutates p ast.Project, f ast.FuncDecl, fid ast.FuncID, nt ast.TypeID, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	let off = offsetOf(c, p: p, node: f.id)
	if nt == ast.noType and f.isStatic 'staticFree'
		checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: "a static function belongs in a 'type'", errs: errs)
		return
	end 'staticFree'
	if f.receiver != "" and (nt == ast.noType or f.isStatic) 'receiver'
		checkFail(c.modID, off: off, code: diag.errUnexpectedToken, msg: "only an instance method takes a receiver parameter", errs: errs)
		return
	end 'receiver'
	var selfTy = ast.noType
	if nt != ast.noType 'owned'
		selfTy = ast.selfType(p.types, declTy: nt)
		p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].ownerTy = selfTy
	end 'owned'
	let mark = errs.count()
	declareGenerics(c, p: p, f: f, fid: fid, nt: nt, errs: errs)
	if failedSince(errs, mark: mark) 'badGenerics'
		return
	end 'badGenerics'
	if nt != ast.noType and ast.typeKind(p.types, t: nt) == ast.TypeKind.enumTy and p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].isDestructor 'enumDestructor'
		let tName = p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].name.clone()
		checkFail(c.modID, off: off, code: diag.errDestructorMisuse, msg: "'{tName}' is an enum, whose values are plain numbers with nothing to end; remove 'destructs', or make '{tName}' a type or a union", errs: errs)
		return
	end 'enumDestructor'
	p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].selfConv = ast.parseConvention(f.receiver)
	var specs = ast.ParamSpecList.create(0)
	paramSpecs(c, p: p, params: f.params, selfTy: selfTy, specs: specs, errs: errs)
	if failedSince(errs, mark: mark) 'badParams'
		return
	end 'badParams'
	var types = ast.TypeIDList.create(0)
	for i in 0 upto specs.count() 'types'
		types.push(specs[i].ty)
	end 'types'
	let ret = returnOf(c, p: p, returnsRef: f.returnsRef, selfTy: selfTy, errs: errs)
	if failedSince(errs, mark: mark) 'badReturn'
		return
	end 'badReturn'
	let err = errorOf(c, p: p, site: f.id, throwsRef: f.throwsRef, specs: specs, errs: errs)
	if failedSince(errs, mark: mark) 'badThrows'
		return
	end 'badThrows'
	p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].params = specs
	p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].paramTypes = types
	p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].retTy = ret
	p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].errTy = err
	declared.push(fid)
end 'addFunction'

// addMethods declares the methods of a type, a union or an enum.
function addMethods(mutates c Checker, mutates p ast.Project, methods ast.FuncDeclList, nt ast.TypeID, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	let isRecord = ast.typeKind(p.types, t: nt) == ast.TypeKind.record
	for i in 0 upto methods.count() 'each'
		addMethod(c, p: p, m: methods[i].clone(), nt: nt, isRecord: isRecord, declared: declared, errs: errs)
	end 'each'
end 'addMethods'

function addMethod(mutates c Checker, mutates p ast.Project, m ast.FuncDecl, nt ast.TypeID, isRecord bool, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	let off = offsetOf(c, p: p, node: m.id)
	if m.isStatic and not isRecord 'static'
		checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: "a static function belongs in a 'type'", errs: errs)
		return
	end 'static'
	if m.name == cloneMethod 'clone'
		checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: "'{cloneMethod}' is built in for every type; name the method something else", errs: errs)
		return
	end 'clone'
	if p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].findMethod(m.name).isSome() 'dup'
		checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: diag.duplicateMethod(m.name, typeName: p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].name), errs: errs)
		return
	end 'dup'
	let fid = newFuncEntry(c, p: p, f: m, ownerTy: nt, ref: ast.DeclRef.make(c.modID, ordinal: 0 as ast.DeclOrdinal))
	p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].methods.push(ast.MethodRef.make(m.name.clone(), func: fid))
	if p.funcs.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].isDestructor 'destructor'
		p.types.lists[ast.typeList(p.types, t: nt)][ast.typeIndex(p.types, t: nt)].dropFunc = fid
	end 'destructor'
	addFunction(c, p: p, f: m, fid: fid, nt: nt, declared: declared, errs: errs)
end 'addMethod'

// mainDecl is the declaration of the entry function that the module declares, or none where it declares no function of
// that name.
function mainDecl(p ast.Project, modIdx Count) returns table.Option with ast.FuncDecl
	match consumes entryOrdinal(p, modIdx: modIdx) 'named'
		some(ord) then return functionOf(p.modules[modIdx].decls[ord as Count].clone())
		none then return table.Option.none
	end 'named'
end 'mainDecl'

// entryOrdinal is where the module declares its entry function, or none where it declares no function of that name.
function entryOrdinal(p ast.Project, modIdx Count) returns table.Option with ast.DeclOrdinal
	match consumes p.modules[modIdx].names.get(entryFunction) 'named'
		some(ord) then return onlyIfFunction(p, modIdx: modIdx, ord: ord)
		none then return table.Option.none
	end 'named'
end 'entryOrdinal'

function onlyIfFunction(p ast.Project, modIdx Count, ord ast.DeclOrdinal) returns table.Option with ast.DeclOrdinal
	if functionOf(p.modules[modIdx].decls[ord as Count].clone()).isSome() 'function'
		return table.Option.some(ord)
	end 'function'
	return table.Option.none
end 'onlyIfFunction'

// declaresEntry is whether the module declares the entry function.
export function declaresEntry(p ast.Project, modIdx Count) returns bool
	return entryOrdinal(p, modIdx: modIdx).isSome()
end 'declaresEntry'

function functionOf(consumes d ast.Decl) returns table.Option with ast.FuncDecl
	return match consumes d 'k'
		funcDecl(f) gives table.Option.some(f)
		constDecl(_) gives table.Option.none
		typeDecl(_) gives table.Option.none
		enumDecl(_) gives table.Option.none
		unionDecl(_) gives table.Option.none
		aliasDecl(_) gives table.Option.none
		interfaceDecl(_) gives table.Option.none
		extensionDecl(_) gives table.Option.none
	end 'k'
end 'functionOf'

// returnsExitCode is whether the function returns a typealias named ExitCode.
function returnsExitCode(c Checker, p ast.Project, f ast.FuncDecl) returns bool
	if f.returnsRef == 0 'none'
		return false
	end 'none'
	match consumes p.resolutions[c.modIdx].decls.get(f.returnsRef as Count) 'bound'
		some(ref) then return namesExitCode(ast.moduleDecl(p, ref: ref))
		none then return false
	end 'bound'
end 'returnsExitCode'

function namesExitCode(consumes d ast.Decl) returns bool
	return match consumes d 'k'
		aliasDecl(a) gives a.name == "ExitCode"
		funcDecl(_) gives false
		constDecl(_) gives false
		typeDecl(_) gives false
		enumDecl(_) gives false
		unionDecl(_) gives false
		interfaceDecl(_) gives false
		extensionDecl(_) gives false
	end 'k'
end 'namesExitCode'

// checkMain checks the entry function that the module declares, which takes no parameters, returns an ExitCode and throws
// nothing, and gives its function. It gives none after it reported why the function is not one.
export function checkMain(mutates c Checker, mutates p ast.Project, mutates errs diag.ErrorList) returns ast.FuncID
	var f as ast.FuncDecl
	match consumes mainDecl(p, modIdx: c.modIdx) 'found'
		some(fd) then f = fd
		none then panic("checkMain: module {c.modID} declares no {entryFunction}")
	end 'found'
	let off = offsetOf(c, p: p, node: f.id)
	if f.params.count() > 0 'params'
		checkFail(c.modID, off: off, code: diag.errEntryTakesParameters, msg: diag.entryTakesParameters(entryFunction), errs: errs)
		return ast.noFunc
	end 'params'
	if not returnsExitCode(c, p: p, f: f) 'returns'
		checkFail(c.modID, off: off, code: diag.errMainWrongReturnType, msg: diag.entryWrongReturnType(entryFunction), errs: errs)
		return ast.noFunc
	end 'returns'
	if f.throwsRef != 0 'throws'
		checkFail(c.modID, off: offsetOf(c, p: p, node: f.throwsRef), code: diag.errMainCannotThrow, msg: diag.entryCannotThrow(entryFunction), errs: errs)
		return ast.noFunc
	end 'throws'
	return mainFuncOf(c, p: p, f: f)
end 'checkMain'

// entryOrder is where the module's entry function stands in the order of the program's files, which is the byte order of their
// paths with a slash for each separator: the later of two entry functions is the duplicate.
export function entryOrder(p ast.Project, modIdx Count) returns String
	let ord = match consumes entryOrdinal(p, modIdx: modIdx) 'found'
		some(o) gives o
		none panic("entryOrder: module {modIdx} declares no {entryFunction}")
	end 'found'
	let at = p.modules[modIdx].decls[ord as Count].offset(p.modules[modIdx].tree)
	let path = p.modules[modIdx].files[ast.findFileIndex(p.modules[modIdx].files, offset: at)].path.clone()
	var key = ByteArray.create(0)
	for i in 0 upto path.byteLength() 'bytes'
		var c = path.byteAt(i)
		if c == backslashByte 'separator'
			c = slashByte
		end 'separator'
		key.push(c)
	end 'bytes'
	return String.from(key)
end 'entryOrder'

let backslashByte = 92 as Byte

let slashByte = 47 as Byte

// reportSecondEntry reports the entry function of a module when an earlier module of the program declares one: the program has
// one entry, whatever directory declares it.
export function reportSecondEntry(mutates c Checker, p ast.Project, mutates errs diag.ErrorList)
	let ord = match consumes entryOrdinal(p, modIdx: c.modIdx) 'found'
		some(o) gives o
		none panic("reportSecondEntry: module {c.modID} declares no {entryFunction}")
	end 'found'
	let off = p.modules[c.modIdx].decls[ord as Count].offset(p.modules[c.modIdx].tree)
	checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: diag.duplicateDefinition(entryFunction, keyword: "function"), errs: errs)
end 'reportSecondEntry'

// reportNoEntry reports a program in which no module declares the entry function.
export function reportNoEntry(mutates errs diag.ErrorList)
	diag.pushUnplacedError(errs, code: diag.errNoMainFunction, message: diag.noEntryFunction(entryFunction))
end 'reportNoEntry'

function mainFuncOf(c Checker, p ast.Project, f ast.FuncDecl) returns ast.FuncID
	match ast.nodeFunc(p, module: c.modID, node: f.id) 'fn'
		some(fid) then return fid
		none then _ = 0
	end 'fn'
	panic("the entry function of module {c.modID} was not declared")
end 'mainFuncOf'
