// The expressions. A module-level constant is checked outside any function, where no call is made and no local is
// declared, so the same expressions serve a constant, a field's default and the body of a function.
// shiftLimit is the count from which a shift moves every bit out of a 64-bit word.
let shiftLimit = 64 as Count

function isArithmeticOp(op String) returns bool
	return op == "+" or op == "-" or op == "*" or op == "/" or op == "mod" or op == "shl" or op == "shr"
end 'isArithmeticOp'

function isLogicalOp(op String) returns bool
	return op == "and" or op == "or" or op == "xor"
end 'isLogicalOp'

function isComparisonOp(op String) returns bool
	return op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
end 'isComparisonOp'

function kindOfType(p ast.Project, t ast.TypeID) returns ast.TypeKind
	return p.types.entries[t as Count].kind
end 'kindOfType'

function isConstInt(p ast.Project, t ast.TypeID) returns bool
	return t != ast.noType and kindOfType(p, t: t) == ast.TypeKind.constInt
end 'isConstInt'

function typeHasKind(p ast.Project, t ast.TypeID, kind ast.TypeKind) returns bool
	return t != ast.noType and kindOfType(p, t: t) == kind
end 'typeHasKind'

function nameOfType(p ast.Project, t ast.TypeID) returns String
	return ast.typeName(p.types, t: t)
end 'nameOfType'

// declaredNameOfType is the name a type was declared with, which a generic instance shares with its generic.
function declaredNameOfType(p ast.Project, t ast.TypeID) returns String
	return ast.typeName(p.types, t: ast.originOf(p.types, t: t))
end 'declaredNameOfType'

// checkExpr types an expression, which gives the type it has, or none after it reported why it has none.
function checkExpr(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	return checkExpecting(c, p: p, e: e, want: ast.noType, errs: errs)
end 'checkExpr'

// checkExpecting types an expression whose context needs a value of want; want is none where the context needs none in
// particular. The expectation reaches only the expression itself, and the branches that give its value.
function checkExpecting(mutates c Checker, mutates p ast.Project, e ast.NodeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let outer = c.expect
	c.expect = want
	var t = visitExpr(c, p: p, e: e, errs: errs)
	c.expect = outer
	if isConstInt(p, t: t) and ast.isFloatType(p.types, t: want) 'asFloat'
		// An integer constant where a float is needed is the double of its value.
		t = ast.internConstFloat(p.types, bits: constantBits(p, t: t))
	end 'asFloat'
	recordType(c, e: e, t: t)
	return t
end 'checkExpecting'

// recordType keeps the type of an expression that has one.
function recordType(mutates c Checker, e ast.NodeID, t ast.TypeID)
	if t != ast.noType 'typed'
		ast.setNodeType(c.typing, node: e, ty: t)
	end 'typed'
end 'recordType'

function visitExpr(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let k = p.modules[c.modIdx].tree.kindOf(e)
	if k == ast.NodeKind.intLit 'intLit'
		return ast.internConstInt(p.types, val: ast.intLitValue(p.modules[c.modIdx].tree, id: e))
	end 'intLit'
	if k == ast.NodeKind.floatLit 'floatLit'
		return ast.internConstFloat(p.types, bits: ast.floatLitBits(p.modules[c.modIdx].tree, id: e))
	end 'floatLit'
	if k == ast.NodeKind.boolLit 'boolLit'
		return p.builtins.boolTy
	end 'boolLit'
	if k == ast.NodeKind.strLit 'strLit'
		return checkStrLit(c, p: p, e: e, errs: errs)
	end 'strLit'
	if k == ast.NodeKind.byteStrLit 'byteStrLit'
		return checkByteStrLit(c, p: p, e: e, errs: errs)
	end 'byteStrLit'
	if k == ast.NodeKind.nameExpr 'nameExpr'
		return checkNameExpr(c, p: p, e: e, errs: errs)
	end 'nameExpr'
	if k == ast.NodeKind.selfExpr 'selfExpr'
		return checkSelfExpr(c, p: p, e: e, errs: errs)
	end 'selfExpr'
	if k == ast.NodeKind.binaryExpr 'binaryExpr'
		return checkBinary(c, p: p, e: e, errs: errs)
	end 'binaryExpr'
	if k == ast.NodeKind.unaryExpr 'unaryExpr'
		return checkUnary(c, p: p, e: e, errs: errs)
	end 'unaryExpr'
	if k == ast.NodeKind.condExpr 'condExpr'
		return checkCond(c, p: p, e: e, errs: errs)
	end 'condExpr'
	if k == ast.NodeKind.castExpr 'castExpr'
		return checkCast(c, p: p, e: e, errs: errs)
	end 'castExpr'
	if k == ast.NodeKind.fromExpr 'fromExpr'
		return checkFromExpr(c, p: p, e: e, errs: errs)
	end 'fromExpr'
	if k == ast.NodeKind.memberExpr 'memberExpr'
		return checkMember(c, p: p, e: e, errs: errs)
	end 'memberExpr'
	if k == ast.NodeKind.tryExpr 'tryExpr'
		return checkTry(c, p: p, e: e, errs: errs)
	end 'tryExpr'
	if k == ast.NodeKind.panicExpr 'panicExpr'
		return checkPanic(c, p: p, e: e, errs: errs)
	end 'panicExpr'
	if k == ast.NodeKind.callExpr 'callExpr'
		return checkCall(c, p: p, e: e, errs: errs)
	end 'callExpr'
	if k == ast.NodeKind.structLitExpr 'structLitExpr'
		return checkStructLit(c, p: p, e: e, errs: errs)
	end 'structLitExpr'
	if k == ast.NodeKind.tupleExpr 'tupleExpr'
		return checkTupleLit(c, p: p, e: e, errs: errs)
	end 'tupleExpr'
	if k == ast.NodeKind.indexExpr 'indexExpr'
		return checkIndex(c, p: p, e: e, errs: errs)
	end 'indexExpr'
	if k == ast.NodeKind.collectionLitExpr 'collectionLitExpr'
		return checkCollectionLit(c, p: p, e: e, errs: errs)
	end 'collectionLitExpr'
	if k == ast.NodeKind.matchExpr 'matchExpr'
		let core = ast.matchExprMatch(p.modules[c.modIdx].tree, id: e)
		return checkMatch(c, p: p, core: core, isExpr: true, errs: errs)
	end 'matchExpr'
	if k == ast.NodeKind.closureExpr 'closureExpr'
		return checkClosure(c, p: p, e: e, errs: errs)
	end 'closureExpr'
	if k == ast.NodeKind.typeQueryExpr 'typeQueryExpr'
		return checkTypeQuery(c, p: p, e: e, errs: errs)
	end 'typeQueryExpr'
	panic("the node {e} of kind {k.name} is no expression")
end 'visitExpr'

// checkStrLit types a string, whose interpolated values must be of a type that has a text.
function checkStrLit(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let partsRef = ast.strLitPartsRef(p.modules[c.modIdx].tree, id: e)
	let count = p.modules[c.modIdx].tree.strPartCount(partsRef)
	for i in 0 upto count 'parts'
		if p.modules[c.modIdx].tree.strPartIsExpr(partsRef, index: i) 'interpolated'
			let part = p.modules[c.modIdx].tree.strPartExpr(partsRef, index: i)
			if not checkInterpolation(c, p: p, part: part, errs: errs) 'bad'
				return ast.noType
			end 'bad'
		end 'interpolated'
	end 'parts'
	return p.builtins.stringTy
end 'checkStrLit'

// checkByteStrLit types a byte string: a new ByteArray of its bytes, which the program may write.
function checkByteStrLit(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	var args = ast.TypeIDList.create(0)
	args.push(p.builtins.byteTy)
	let origin = p.builtins.arrayOrigin
	return instantiateGeneric(c, p: p, off: offsetOf(c, p: p, node: e), orig: origin, args: args, errs: errs)
end 'checkByteStrLit'

function checkInterpolation(mutates c Checker, mutates p ast.Project, part ast.NodeID, mutates errs diag.ErrorList) returns bool
	let typed = checkExpr(c, p: p, e: part, errs: errs)
	if typed == ast.noType 'failed'
		return false
	end 'failed'
	let t = ast.contentType(p.types, t: typed)
	let off = offsetOf(c, p: p, node: part)
	if not requireSigned64(c, off: off, t: t, p: p, errs: errs) 'wide'
		return false
	end 'wide'
	let k = kindOfType(p, t: t)
	if isNumberType(p, t: t) or t == p.builtins.stringTy or t == p.builtins.boolTy or k == ast.TypeKind.enumTy or k == ast.TypeKind.unionTy 'printable'
		return true
	end 'printable'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "a value of {nameOfType(p, t: t)} cannot be interpolated", errs: errs)
	return false
end 'checkInterpolation'

// constantOf is the constant that a name written as an expression stands for, if it is one.
function constantOf(p ast.Project, ref ast.DeclRef) returns table.Option with ast.ConstValue
	return ast.declConst(p, ref: ref)
end 'constantOf'

// isQualifiedName is whether the resolver made a name of a name written with its module or its type, `mod.name`: it stands
// for that declaration, never for a local, a field or a method of the enclosing type, which a bare name outranks.
function isQualifiedName(c Checker, p ast.Project, e ast.NodeID) returns bool
	return p.resolutions[c.modIdx].becomeNames.has(e as Count)
end 'isQualifiedName'

function checkQualifiedName(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = ast.nameExprName(p.modules[c.modIdx].tree, id: e)
	match consumes p.resolutions[c.modIdx].decls.get(e as Count) 'bound'
		some(ref) then return checkDeclaredName(c, p: p, e: e, ref: ref, name: name, errs: errs)
		none then panic("a qualified name '{name}' was resolved to no declaration")
	end 'bound'
end 'checkQualifiedName'

function checkNameExpr(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	if isQualifiedName(c, p: p, e: e) 'qualified'
		return checkQualifiedName(c, p: p, e: e, errs: errs)
	end 'qualified'
	let name = ast.nameExprName(p.modules[c.modIdx].tree, id: e)
	let off = offsetOf(c, p: p, node: e)
	let mark = errs.count()
	let local = useLocal(c, p: p, use: e, name: name, errs: errs)
	if failedSince(errs, mark: mark) 'refused'
		return ast.noType
	end 'refused'
	if local != ast.noLocal 'local'
		c.typing.names.insert(e as Count, value: ast.NameInfo.localName(local))
		let declared = c.typing.locals[local as Count].ty
		if declared == ast.noType 'refused'
			diag.pushConsequence(errs, code: diag.errExpressionError, message: "'{name}' was declared with a type that was refused", module: c.modID, offset: off)
		end 'refused'
		return declared
	end 'local'
	let rt = selfRecord(c, p: p)
	if rt != ast.noType 'inMethod'
		match consumes p.types.entries[ast.originOf(p.types, t: rt) as Count].findField(name) 'field'
			some(index) then return selfFieldType(c, p: p, e: e, rt: rt, name: name, index: index)
			none then _ = 0
		end 'field'
	end 'inMethod'
	if c.inBehaviour 'behaviour'
		match consumes selfFieldInBehaviour(c, p: p, name: name) 'selfField'
			some(fieldTy) then return refuseBehaviourSelf(c, p: p, off: off, what: "the field '{name}'", t: fieldTy, errs: errs)
			none then _ = 0
		end 'selfField'
	end 'behaviour'
	match consumes p.resolutions[c.modIdx].decls.get(e as Count) 'bound'
		some(ref) then return checkDeclaredName(c, p: p, e: e, ref: ref, name: name, errs: errs)
		none then _ = 0
	end 'bound'
	if name == "Self" 'selfName'
		checkFail(c.modID, off: off, code: diag.errExpressionError, msg: "'Self' is a type, not a value", errs: errs)
		return ast.noType
	end 'selfName'
	diag.pushUnqualifiedError(errs, code: diag.errExpressionError, message: diag.undefinedVariable(name), module: c.modID, offset: off, name: name.clone())
	return ast.noType
end 'checkNameExpr'

// selfFieldType records that a name stands for a field of the receiver, and gives the type the field has in the receiver.
function selfFieldType(mutates c Checker, mutates p ast.Project, e ast.NodeID, rt ast.TypeID, consumes name String, index Count) returns ast.TypeID
	c.typing.names.insert(e as Count, value: ast.NameInfo.selfFieldName(name, fieldIndex: index))
	return ast.fieldType(p.types, owner: rt, index: index)
end 'selfFieldType'

function checkDeclaredName(mutates c Checker, mutates p ast.Project, e ast.NodeID, consumes ref ast.DeclRef, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: e)
	if ast.declIsType(p, ref: ref) 'type'
		checkFail(c.modID, off: off, code: diag.errExpressionError, msg: "'{name}' is a type, not a value", errs: errs)
		return ast.noType
	end 'type'
	match consumes constantOf(p, ref: ref) 'const'
		some(value) then return typeOfConstant(c, e: e, ref: ref, value: value)
		none then _ = 0
	end 'const'
	if ast.declIsConst(p, ref: ref) 'unvalued'
		checkFail(c.modID, off: off, code: diag.errExpressionError, msg: "constant '{name}' has no value", errs: errs)
		return ast.noType
	end 'unvalued'
	return functionValue(c, p: p, e: e, ref: ref, name: name, errs: errs)
end 'checkDeclaredName'

function typeOfConstant(mutates c Checker, e ast.NodeID, consumes ref ast.DeclRef, consumes value ast.ConstValue) returns ast.TypeID
	c.typing.names.insert(e as Count, value: ast.NameInfo.constName(ref))
	return value.ty
end 'typeOfConstant'

function checkSelfExpr(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	if c.inClosure 'closure'
		// A closure in a method names its receiver by name, which the resolver made of 'self'.
		checkFail(c.modID, off: offsetOf(c, p: p, node: e), code: diag.errUnexpectedToken, msg: diag.selfOutsideInstanceMethod(), errs: errs)
		return ast.noType
	end 'closure'
	if c.inBehaviour 'behaviour'
		let owner = c.owner
		return refuseBehaviourSelf(c, p: p, off: offsetOf(c, p: p, node: e), what: "'self'", t: owner, errs: errs)
	end 'behaviour'
	if c.fn == ast.noFunc or not p.funcs.entries[c.fn as Count].hasReceiver 'outside'
		checkFail(c.modID, off: offsetOf(c, p: p, node: e), code: diag.errUnexpectedToken, msg: diag.selfOutsideInstanceMethod(), errs: errs)
		return ast.noType
	end 'outside'
	return c.owner
end 'checkSelfExpr'

// foldOp is the value of an operator on two constants, or none after it reported why the operator gives none.
function foldOp(c Checker, off diag.U32, rightOff diag.U32, op String, a ast.I128, b ast.I128, mutates errs diag.ErrorList) returns table.Option with ast.I128
	var r = ast.I128.zero()
	if op == "+" 'add'
		r = a.add(b)
	end 'add' else if op == "-" 'sub'
		r = a.sub(b)
	end 'sub' else if op == "*" 'mul'
		r = ast.mulWide(a, b: b)
	end 'mul' else if op == "/" or op == "mod" 'div'
		if b.isZero() 'zero'
			checkFail(c.modID, off: off, code: diag.errDivisionByZero, msg: diag.divisionByProvableZero(op), errs: errs)
			return table.Option.none
		end 'zero'
		if op == "/" 'quotient'
			r = ast.quoTrunc(a, b: b)
		end 'quotient' else 'remainder'
			r = ast.modTrunc(a, b: b)
		end 'remainder'
	end 'div' else if op == "and" 'and'
		r = ast.bitwise(ast.BitsOp.bitAnd, a: a, b: b)
	end 'and' else if op == "or" 'or'
		r = ast.bitwise(ast.BitsOp.bitOr, a: a, b: b)
	end 'or' else if op == "xor" 'xor'
		r = ast.bitwise(ast.BitsOp.bitXor, a: a, b: b)
	end 'xor' else if op == "shl" or op == "shr" 'shift'
		return foldShift(c, off: rightOff, op: op, a: a, b: b, errs: errs)
	end 'shift' else 'unknown'
		checkFail(c.modID, off: off, code: diag.errUnsupported, msg: "cannot fold '{op}'", errs: errs)
		return table.Option.none
	end 'unknown'
	return checkedFold(c, off: off, r: r, errs: errs)
end 'foldOp'

function foldShift(c Checker, off diag.U32, op String, a ast.I128, b ast.I128, mutates errs diag.ErrorList) returns table.Option with ast.I128
	if b.isNeg() 'negative'
		checkFail(c.modID, off: off, code: diag.errShiftCountNegative, msg: diag.shiftCountNegative(b.toString()), errs: errs)
		return table.Option.none
	end 'negative'
	var count = shiftLimit
	if b.lt(ast.I128.fromCount(shiftLimit)) 'narrow'
		count = b.lo
	end 'narrow'
	if op == "shl" 'left'
		if count >= shiftLimit 'wide'
			return checkedFold(c, off: off, r: ast.I128.zero(), errs: errs)
		end 'wide'
		return checkedFold(c, off: off, r: ast.shiftLeft(a, n: count), errs: errs)
	end 'left'
	return checkedFold(c, off: off, r: ast.shiftRight(a, n: count), errs: errs)
end 'foldShift'

// checkedFold is a folded value, refused where it is past the 64 bits that a word holds.
function checkedFold(c Checker, off diag.U32, consumes r ast.I128, mutates errs diag.ErrorList) returns table.Option with ast.I128
	if r.lt(ast.I128.i64Min()) or r.gt(ast.I128.u64Max()) 'past'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "the constant expression overflows 64 bits", errs: errs)
		return table.Option.none
	end 'past'
	return table.Option.some(r)
end 'checkedFold'

// setOperand records the arithmetic of an operator or a cast, which every one that types has, so that the lowering finds
// it; the range analysis then says how the operation can fail.
function setOperand(mutates c Checker, node ast.NodeID, operand ast.TypeID)
	c.typing.arith.insert(node as Count, value: ast.ArithInfo.make(operand, word: operand, fails: ast.failNone, unreached: false, checkedFail: false))
end 'setOperand'

// checkBinary types an operator. A chain of operators nests to the left, so the chain is walked innermost first with a
// loop: each operator is checked once the type of its left operand is known, which is what visiting the left operand
// first gives.
function checkBinary(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let want = c.expect
	var chain = ast.leftChain(p.modules[c.modIdx].tree, e: e)
	var node = ast.nextOperator(chain, e: e)
	var l = checkExpr(c, p: p, e: ast.binaryExprL(p.modules[c.modIdx].tree, id: node), errs: errs)
	while node != e 'inner'
		if l == ast.noType 'badInner'
			return ast.noType
		end 'badInner'
		l = checkOperator(c, p: p, e: node, l: l, want: ast.noType, errs: errs)
		recordType(c, e: node, t: l)
		node = ast.nextOperator(chain, e: e)
	end 'inner'
	if l == ast.noType 'badLeft'
		return ast.noType
	end 'badLeft'
	return checkOperator(c, p: p, e: e, l: l, want: want, errs: errs)
end 'checkBinary'

// checkOperator types an operator whose left operand has the type l.
function checkOperator(mutates c Checker, mutates p ast.Project, e ast.NodeID, l ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let op = ast.binaryExprOp(p.modules[c.modIdx].tree, id: e)
	let rNode = ast.binaryExprR(p.modules[c.modIdx].tree, id: e)
	let r = checkExpr(c, p: p, e: rNode, errs: errs)
	if r == ast.noType 'badRight'
		return ast.noType
	end 'badRight'
	let off = offsetOf(c, p: p, node: e)
	if op == "is" 'identity'
		return checkIdentity(c, p: p, e: e, l: l, r: r, errs: errs)
	end 'identity'
	if ast.isFloatType(p.types, t: l) or ast.isFloatType(p.types, t: r) 'floats'
		if isComparisonOp(op) 'comparison'
			return checkFloatComparison(c, p: p, e: e, op: op, l: l, r: r, errs: errs)
		end 'comparison'
		if isArithmeticOp(op) or isLogicalOp(op) 'arithmetic'
			return checkFloatOp(c, p: p, e: e, op: op, l: l, r: r, errs: errs)
		end 'arithmetic'
	end 'floats'
	if isArithmeticOp(op) or (isLogicalOp(op) and ast.isIntType(p.types, t: l)) 'integers'
		return checkIntegerOp(c, p: p, e: e, op: op, l: l, r: r, want: want, errs: errs)
	end 'integers'
	if isLogicalOp(op) 'logical'
		if l != p.builtins.boolTy or r != p.builtins.boolTy 'notBool'
			return refuseOperands(c, p: p, off: off, op: op, l: l, r: r, errs: errs)
		end 'notBool'
		return p.builtins.boolTy
	end 'logical'
	if isComparisonOp(op) 'comparison'
		return checkComparison(c, p: p, e: e, op: op, l: l, r: r, errs: errs)
	end 'comparison'
	checkFail(c.modID, off: off, code: diag.errUnsupported, msg: "unknown operator '{op}'", errs: errs)
	return ast.noType
end 'checkOperator'

// hasIdentity is whether a value of the type is an object that two names can stand for: a record, a string or a collection.
// A number, a bool, an enum case, a union, a function and a type parameter are values with no object to name.
function hasIdentity(p ast.Project, t ast.TypeID) returns bool
	return match p.types.entries[t as Count].kind 'kind'
		record gives true
		primString gives true
		builtinArray gives true
		builtinMap gives true
		builtinList gives true
		invalid gives false
		primBool gives false
		primVoid gives false
		primNever gives false
		intRange gives false
		constInt gives false
		floatRange gives false
		constFloat gives false
		enumTy gives false
		unionTy gives false
		builtinPool gives false
		builtinHandle gives false
		builtinFrozen gives false
		builtinCown gives false
		typeParam gives false
		interfaceTy gives false
		funcTy gives false
	end 'kind'
end 'hasIdentity'

// checkIdentity types 'a is b' and 'a is not b': whether two names stand for one object. A record has one owner, so the
// answer is true only where one operand borrows the other, or both borrow one owner.
function checkIdentity(mutates c Checker, mutates p ast.Project, e ast.NodeID, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: e)
	var op = "is"
	if ast.binaryExprNegated(p.modules[c.modIdx].tree, id: e) 'negated'
		op = "is not"
	end 'negated'
	if not hasIdentity(p, t: l) or not hasIdentity(p, t: r) 'primitive'
		checkFail(c.modID, off: off, code: diag.errRefIdentityOnPrimitive, msg: diag.refIdentityOnPrimitive(op), errs: errs)
		return ast.noType
	end 'primitive'
	if l != r 'different'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.refIdentityTypeMismatch(op, left: gotName(p, t: l), right: gotName(p, t: r)), errs: errs)
		return ast.noType
	end 'different'
	setOperand(c, node: e, operand: l)
	return p.builtins.boolTy
end 'checkIdentity'

// isWordOp is whether an operator works on the bits of its operands, which must then be two bools or two integers.
function isWordOp(op String) returns bool
	return isLogicalOp(op) or op == "shl" or op == "shr"
end 'isWordOp'

// refuseOperands reports operands that the operator has no meaning for, in the words maxon gives each kind of operator.
function refuseOperands(mutates c Checker, mutates p ast.Project, off diag.U32, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let lName = gotName(p, t: l)
	let rName = gotName(p, t: r)
	if isWordOp(op) and not (l == r or (ast.isIntType(p.types, t: l) and ast.isIntType(p.types, t: r))) 'mixed'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.operandTypeMismatch(op), errs: errs)
		return ast.noType
	end 'mixed'
	if isWordOp(op) 'word'
		var offending = lName
		if ast.isIntType(p.types, t: l) 'left'
			offending = rName
		end 'left'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.nonIntegralOperands(op, operand: offending), errs: errs)
		return ast.noType
	end 'word'
	if lName == rName 'same'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.undefinedOperatorForType(op, typeName: lName), errs: errs)
		return ast.noType
	end 'same'
	checkFail(c.modID, off: off, code: diag.errExpressionError, msg: diag.nonNumericOperands(lName, right: rName), errs: errs)
	return ast.noType
end 'refuseOperands'

// checkIntegerOp types an arithmetic, bitwise or shift operator on two integers.
function checkIntegerOp(mutates c Checker, mutates p ast.Project, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: e)
	if not ast.isIntType(p.types, t: l) or not ast.isIntType(p.types, t: r) 'notInts'
		return refuseOperands(c, p: p, off: off, op: op, l: l, r: r, errs: errs)
	end 'notInts'
	let lConst = isConstInt(p, t: l)
	let rConst = isConstInt(p, t: r)
	if lConst and rConst 'folded'
		setOperand(c, node: e, operand: p.builtins.anon64Ty)
		return foldedType(c, p: p, off: off, rightOff: exprOffset(c, p: p, node: ast.binaryExprR(p.modules[c.modIdx].tree, id: e)), op: op, l: l, r: r, errs: errs)
	end 'folded'
	if (op == "/" or op == "mod") and rConst and p.types.entries[r as Count].minVal.isZero() 'byZero'
		checkFail(c.modID, off: off, code: diag.errDivisionByZero, msg: diag.divisionByProvableZero(op), errs: errs)
		return ast.noType
	end 'byZero'
	if op == "shl" or op == "shr" 'shift'
		var shifted = l
		if lConst 'constLeft'
			shifted = p.builtins.anon64Ty
		end 'constLeft'
		setOperand(c, node: e, operand: shifted)
		return shifted
	end 'shift'
	if isLogicalOp(op) 'bitwise'
		let t = unifyInts(c, p: p, off: off, clash: Clash.operator(op.clone()), l: l, r: r, errs: errs)
		if t != ast.noType 'unified'
			setOperand(c, node: e, operand: t)
		end 'unified'
		return t
	end 'bitwise'
	let word = operandWord(c, p: p, off: off, op: op, l: l, r: r, errs: errs)
	if word == ast.noType 'noWord'
		return ast.noType
	end 'noWord'
	let pattern = wordPatternOf(p, l: l, r: r)
	if pattern != ast.noType 'pattern'
		setOperand(c, node: e, operand: pattern)
		if typeHasKind(p, t: want, kind: ast.TypeKind.intRange) 'patternExpected'
			return want
		end 'patternExpected'
		return pattern
	end 'pattern'
	setOperand(c, node: e, operand: word)
	if typeHasKind(p, t: want, kind: ast.TypeKind.intRange) 'expected'
		return want
	end 'expected'
	let computed = arithmetic(op, l: typeSpan(p.types, t: l), r: typeSpan(p.types, t: r), word: typeSpan(p.types, t: word))
	let exact = computed.span.clone()
	return exactType(p, word: word, lo: exact.lo, hi: exact.hi)
end 'checkIntegerOp'

// wordPatternOf is the bits(64) type that an arithmetic operation on the operand types l and r computes in, which wraps
// where another unsigned type fails, or noType where neither operand is one.
function wordPatternOf(p ast.Project, l ast.TypeID, r ast.TypeID) returns ast.TypeID
	if ast.isWordPattern(p.types, t: l) 'left'
		return l
	end 'left'
	if ast.isWordPattern(p.types, t: r) 'right'
		return r
	end 'right'
	return ast.noType
end 'wordPatternOf'

function foldedType(mutates c Checker, mutates p ast.Project, off diag.U32, rightOff diag.U32, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let a = p.types.entries[l as Count].minVal.clone()
	let b = p.types.entries[r as Count].minVal.clone()
	match consumes foldOp(c, off: off, rightOff: rightOff, op: op, a: a, b: b, errs: errs) 'value'
		some(v) then return ast.internConstInt(p.types, val: v)
		none then return ast.noType
	end 'value'
end 'foldedType'

function checkComparison(mutates c Checker, mutates p ast.Project, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: e)
	if ast.isIntType(p.types, t: l) and ast.isIntType(p.types, t: r) 'integers'
		let word = operandWord(c, p: p, off: off, op: op, l: l, r: r, errs: errs)
		if word == ast.noType 'noWord'
			return ast.noType
		end 'noWord'
		setOperand(c, node: e, operand: word)
		return p.builtins.boolTy
	end 'integers'
	if typeHasKind(p, t: l, kind: ast.TypeKind.unionTy) or typeHasKind(p, t: r, kind: ast.TypeKind.unionTy) 'union'
		checkFail(c.modID, off: off, code: diag.errEnumNotComparable, msg: diag.unionNotComparable(op), errs: errs)
		return ast.noType
	end 'union'
	let equality = op == "==" or op == "!="
	if equality and l == r and (l == p.builtins.boolTy or l == p.builtins.stringTy or typeHasKind(p, t: l, kind: ast.TypeKind.enumTy) or typeHasKind(p, t: l, kind: ast.TypeKind.builtinHandle)) 'comparable'
		setOperand(c, node: e, operand: l)
		return p.builtins.boolTy
	end 'comparable'
	if l == r and typeHasKind(p, t: l, kind: ast.TypeKind.typeParam) 'parameter'
		var required = "Comparable"
		if equality 'equality'
			required = "Equatable"
		end 'equality'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.operatorRequiresConformance(op, typeParamName: nameOfType(p, t: l), interfaceName: required), errs: errs)
		return ast.noType
	end 'parameter'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.comparisonTypeMismatch(gotName(p, t: l), right: gotName(p, t: r)), errs: errs)
	return ast.noType
end 'checkComparison'

function checkUnary(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let want = c.expect
	let op = ast.unaryExprOp(p.modules[c.modIdx].tree, id: e)
	let operand = ast.unaryExprE(p.modules[c.modIdx].tree, id: e)
	let t = checkExpr(c, p: p, e: operand, errs: errs)
	if t == ast.noType 'failed'
		return ast.noType
	end 'failed'
	setOperand(c, node: e, operand: t)
	let off = offsetOf(c, p: p, node: e)
	if op == "not" 'not'
		return checkNot(c, p: p, off: off, t: t, want: want, errs: errs)
	end 'not'
	if isConstInt(p, t: t) 'constant'
		return ast.internConstInt(p.types, val: p.types.entries[t as Count].minVal.neg())
	end 'constant'
	if ast.isFloatType(p.types, t: t) 'float'
		return checkFloatNegation(p, t: t)
	end 'float'
	if typeHasKind(p, t: t, kind: ast.TypeKind.intRange) 'range'
		return checkNegation(c, p: p, off: off, t: t, want: want, errs: errs)
	end 'range'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "'-' needs an integer, found {nameOfType(p, t: t)}", errs: errs)
	return ast.noType
end 'checkUnary'

// checkNot gives a complement the operand's alias only where the alias is closed under it (a pattern, or a range that
// flipping maps onto itself), as maxon does; otherwise, like a negation, the type the context expects or the exact range
// of the flipped bits.
function checkNot(mutates c Checker, mutates p ast.Project, off diag.U32, t ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if t == p.builtins.boolTy 'bool'
		return t
	end 'bool'
	if isConstInt(p, t: t) 'constant'
		return ast.internConstInt(p.types, val: ast.notWord(p.types.entries[t as Count].minVal))
	end 'constant'
	if typeHasKind(p, t: t, kind: ast.TypeKind.intRange) 'range'
		let lo = rangeLo(p.types, t: t)
		let hi = rangeHi(p.types, t: t)
		var word = p.builtins.anon64Ty
		var flippedLo = hi.neg().sub(ast.I128.one())
		var flippedHi = lo.neg().sub(ast.I128.one())
		if ast.isUnsignedInt(p.types, t: t) 'unsigned'
			word = p.builtins.anonU64Ty
			flippedLo = ast.I128.u64Max().sub(hi)
			flippedHi = ast.I128.u64Max().sub(lo)
		end 'unsigned'
		if p.types.entries[t as Count].bitsWidth != 0 or (flippedLo.eq(lo) and flippedHi.eq(hi)) 'closed'
			return t
		end 'closed'
		if typeHasKind(p, t: want, kind: ast.TypeKind.intRange) 'expected'
			return want
		end 'expected'
		return exactType(p, word: word, lo: flippedLo, hi: flippedHi)
	end 'range'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.nonIntegralOperands("not", operand: gotName(p, t: t)), errs: errs)
	return ast.noType
end 'checkNot'

function checkNegation(mutates c Checker, mutates p ast.Project, off diag.U32, t ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if ast.isWordPattern(p.types, t: t) 'pattern'
		return t
	end 'pattern'
	if ast.isUnsignedInt(p.types, t: t) 'unsigned'
		checkFail(c.modID, off: off, code: diag.errUnsignedNegation, msg: diag.unsignedNegation(nameOfType(p, t: t)), errs: errs)
		return ast.noType
	end 'unsigned'
	if typeHasKind(p, t: want, kind: ast.TypeKind.intRange) 'expected'
		return want
	end 'expected'
	let lo = p.types.entries[t as Count].maxVal.neg()
	let hi = p.types.entries[t as Count].minVal.neg()
	let word = p.builtins.anon64Ty
	return exactType(p, word: word, lo: lo, hi: hi)
end 'checkNegation'

function requireBool(mutates c Checker, mutates p ast.Project, e ast.NodeID, keyword String, mutates errs diag.ErrorList) returns bool
	let t = checkExpr(c, p: p, e: e, errs: errs)
	if t == ast.noType 'failed'
		return false
	end 'failed'
	if t != p.builtins.boolTy 'notBool'
		checkFail(c.modID, off: exprOffset(c, p: p, node: e), code: diag.errTypeMismatch, msg: diag.nonBoolCondition(keyword, got: gotName(p, t: t)), errs: errs)
		return false
	end 'notBool'
	return true
end 'requireBool'

function checkCond(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let cond = ast.condExprCond(p.modules[c.modIdx].tree, id: e)
	let thenNode = ast.condExprThen(p.modules[c.modIdx].tree, id: e)
	let elseNode = ast.condExprElse(p.modules[c.modIdx].tree, id: e)
	let condTy = checkExpr(c, p: p, e: cond, errs: errs)
	if condTy == ast.noType 'badCond'
		return ast.noType
	end 'badCond'
	if condTy != p.builtins.boolTy 'notBool'
		checkFail(c.modID, off: offsetOf(c, p: p, node: e), code: diag.errMatchTypeMismatch, msg: diag.ternaryNonBoolCondition(gotName(p, t: condTy)), errs: errs)
		return ast.noType
	end 'notBool'
	let expected = c.expect
	let thenTy = checkExpecting(c, p: p, e: thenNode, want: expected, errs: errs)
	if thenTy == ast.noType 'badThen'
		return ast.noType
	end 'badThen'
	let elseTy = checkExpecting(c, p: p, e: elseNode, want: expected, errs: errs)
	if elseTy == ast.noType 'badElse'
		return ast.noType
	end 'badElse'
	return joinTypes(c, p: p, off: offsetOf(c, p: p, node: e), clash: Clash.branches, a: thenTy, b: elseTy, errs: errs)
end 'checkCond'

function checkCast(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, node: e)
	let targetRef = ast.castExprTarget(p.modules[c.modIdx].tree, id: e)
	let operand = ast.castExprE(p.modules[c.modIdx].tree, id: e)
	let owner = c.owner
	let mark = errs.count()
	let bare = bareNumberName(p, modIdx: c.modIdx, tr: targetRef)
	if bare != "" 'bare'
		var message = diag.bareIntCast()
		if bare == "float" 'float'
			message = diag.bareFloatCast()
		end 'float'
		checkFail(c.modID, off: offsetOf(c, p: p, node: targetRef), code: diag.errTypeMismatch, msg: message, errs: errs)
		return ast.noType
	end 'bare'
	let target = resolveTypeRef(c, p: p, tr: targetRef, selfTy: owner, errs: errs)
	if target == ast.noType 'badTarget'
		anchorUnknownTypes(c, mark: mark, at: p.modules[c.modIdx].tree.castKeywordStart(targetRef), errs: errs)
		return ast.noType
	end 'badTarget'
	if typeHasKind(p, t: target, kind: ast.TypeKind.funcTy) 'function'
		return checkFunctionCast(c, p: p, e: e, operand: operand, target: target, errs: errs)
	end 'function'
	if typeHasKind(p, t: target, kind: ast.TypeKind.interfaceTy) 'interface'
		return checkInterfaceCast(c, p: p, e: e, operand: operand, target: target, errs: errs)
	end 'interface'
	let toFloat = typeHasKind(p, t: target, kind: ast.TypeKind.floatRange)
	let toInt = typeHasKind(p, t: target, kind: ast.TypeKind.intRange)
	let numeric = toInt or toFloat
	var src = ast.noType
	if numeric 'number'
		src = checkExpr(c, p: p, e: operand, errs: errs)
	end 'number' else 'other'
		// A literal is written as the target, as at any place that expects the type.
		src = checkExpecting(c, p: p, e: operand, want: target, errs: errs)
	end 'other'
	if src == ast.noType 'badSource'
		return ast.noType
	end 'badSource'
	setOperand(c, node: e, operand: src)
	if typeHasKind(p, t: src, kind: ast.TypeKind.interfaceTy) 'recovered'
		return checkRecoveryCast(c, p: p, e: e, src: src, target: target, errs: errs)
	end 'recovered'
	if not numeric 'notNumber'
		// Every spelling of a type is that one type here, so a cast to the type the value has, or to one it retags to,
		// is the value itself.
		if retags(p.types, a: src, b: target) 'identity'
			return target
		end 'identity'
		if p.types.entries[target as Count].typeArgs.count() > 0 and not p.types.entries[target as Count].isTuple 'container'
			checkFail(c.modID, off: off, code: diag.errCastTargetIsAContainer, msg: diag.castTargetIsAContainer(nameOfType(p, t: target), source: nameOfType(p, t: src)), errs: errs)
			return ast.noType
		end 'container'
		if castTargetIsRefused(p, target: target) and not assignable(p, src: src, dst: target) 'refused'
			failCast(c, p: p, off: off, src: src, target: target, errs: errs)
			return ast.noType
		end 'refused'
		checkFail(c.modID, off: off, code: diag.errUnsupported, msg: "a cast to {nameOfType(p, t: target)} is not supported by minimaxon", errs: errs)
		return ast.noType
	end 'notNumber'
	if toFloat 'float'
		return checkFloatCast(c, p: p, off: off, src: src, target: target, errs: errs)
	end 'float'
	if ast.isFloatType(p.types, t: src) 'fromFloat'
		failCast(c, p: p, off: off, src: src, target: target, errs: errs)
		return ast.noType
	end 'fromFloat'
	if isConstInt(p, t: src) 'constant'
		let value = p.types.entries[src as Count].minVal.clone()
		if not intRangeHolds(p.types, dst: target, v: value) 'doesNotFit'
			checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: valueOutOfRange(p, value: value.toString(), target: target), errs: errs)
			return ast.noType
		end 'doesNotFit'
		return target
	end 'constant'
	if typeHasKind(p, t: src, kind: ast.TypeKind.intRange) 'range'
		return target
	end 'range'
	failCast(c, p: p, off: off, src: src, target: target, errs: errs)
	return ast.noType
end 'checkCast'

// checkFunctionCast casts a function value to another function type of its shape, which re-brands it, as in maxon: the
// value is the same closure. A closure written in the cast takes the target as the type it is written for.
function checkFunctionCast(mutates c Checker, mutates p ast.Project, e ast.NodeID, operand ast.NodeID, target ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let src = checkExpecting(c, p: p, e: operand, want: target, errs: errs)
	if src == ast.noType 'badSource'
		return ast.noType
	end 'badSource'
	if not typeHasKind(p, t: src, kind: ast.TypeKind.funcTy) or not shapeFits(p, src: src, dst: target) 'shape'
		failCast(c, p: p, off: offsetOf(c, p: p, node: e), src: src, target: target, errs: errs)
		return ast.noType
	end 'shape'
	return target
end 'checkFunctionCast'

// anchorUnknownTypes moves the refusals of an unknown type that were reported since mark to at, where maxon reports the type of a cast: at its 'as'.
function anchorUnknownTypes(c Checker, mark Count, at diag.U32, mutates errs diag.ErrorList)
	for i in mark upto errs.count() 'each'
		if errs[i].code == diag.errUnknownType 'unknown'
			errs[i].site = diag.Site.make(c.modID, offset: at)
		end 'unknown'
	end 'each'
end 'anchorUnknownTypes'

// castTargetIsRefused is whether maxon refuses a cast to target, whatever the value: a type that no value is converted to.
function castTargetIsRefused(p ast.Project, target ast.TypeID) returns bool
	return match kindOfType(p, t: target) 'k'
		primBool gives true
		primString gives true
		record gives true
		enumTy gives true
		unionTy gives true
		funcTy gives true
		invalid gives false
		primVoid gives false
		primNever gives false
		intRange gives false
		constInt gives false
		floatRange gives false
		constFloat gives false
		builtinArray gives false
		builtinMap gives false
		builtinList gives false
		builtinPool gives false
		builtinHandle gives false
		builtinFrozen gives false
		builtinCown gives false
		typeParam gives false
		interfaceTy gives false
	end 'k'
end 'castTargetIsRefused'

// castKindWord is how maxon's messages about a cast name the type of a value: its kind, or the name of a named type.
function castKindWord(p ast.Project, t ast.TypeID) returns String
	let name = nameOfType(p, t: t)
	return match kindOfType(p, t: t) 'k'
		invalid gives panic("a cast names a value that has no type")
		primBool gives "bool"
		primString gives "String"
		primVoid gives name
		primNever gives name
		intRange gives "int" if typeIsAnonInt(p.types, t: t) else name
		constInt gives "int"
		floatRange gives "float" if typeIsAnonFloat(p.types, t: t) else name
		constFloat gives "float"
		record gives name
		enumTy gives "enum"
		unionTy gives "union"
		builtinArray gives name
		builtinMap gives name
		builtinList gives name
		builtinPool gives name
		builtinHandle gives name
		builtinFrozen gives name
		builtinCown gives name
		typeParam gives name
		interfaceTy gives name
		funcTy gives "function"
	end 'k'
end 'castKindWord'

// castTargetWord is how maxon's messages about a cast name the type it converts to: the kind of the type.
function castTargetWord(p ast.Project, t ast.TypeID) returns String
	return match kindOfType(p, t: t) 'k'
		invalid gives panic("a cast names a target that has no type")
		primBool gives "bool"
		primString gives "String"
		intRange gives "int"
		constInt gives "int"
		floatRange gives "float"
		constFloat gives "float"
		record gives "struct"
		funcTy gives "function"
		primVoid gives nameOfType(p, t: t)
		primNever gives nameOfType(p, t: t)
		enumTy gives nameOfType(p, t: t)
		unionTy gives nameOfType(p, t: t)
		builtinArray gives nameOfType(p, t: t)
		builtinMap gives nameOfType(p, t: t)
		builtinList gives nameOfType(p, t: t)
		builtinPool gives nameOfType(p, t: t)
		builtinHandle gives nameOfType(p, t: t)
		builtinFrozen gives nameOfType(p, t: t)
		builtinCown gives nameOfType(p, t: t)
		typeParam gives nameOfType(p, t: t)
		interfaceTy gives nameOfType(p, t: t)
	end 'k'
end 'castTargetWord'

// failCast refuses a cast that has no conversion, with the words maxon uses for it.
export function failCast(c Checker, p ast.Project, off diag.U32, src ast.TypeID, target ast.TypeID, mutates errs diag.ErrorList)
	let source = castKindWord(p, t: src)
	let tName = nameOfType(p, t: target)
	var msg = diag.invalidCast(source, target: castTargetWord(p, t: target))
	if kindOfType(p, t: target) == ast.TypeKind.enumTy 'toEnum'
		msg = diag.castFormsAValue(source, target: "enum '{tName}'", remedy: diag.castToEnumRemedy(tName))
	end 'toEnum' else if kindOfType(p, t: target) == ast.TypeKind.unionTy 'toUnion'
		msg = diag.castFormsAValue(source, target: "union '{tName}'", remedy: diag.castToUnionRemedy())
	end 'toUnion' else if kindOfType(p, t: target) == ast.TypeKind.funcTy and kindOfType(p, t: src) == ast.TypeKind.funcTy 'toFunction'
		msg = diag.functionShapeCast(tName, got: nameOfType(p, t: src))
	end 'toFunction'
	checkFail(c.modID, off: off, code: diag.errUnsafeCast, msg: msg, errs: errs)
end 'failCast'

function checkPanic(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let message = ast.panicExprMessage(p.modules[c.modIdx].tree, id: e)
	if checkExpr(c, p: p, e: message, errs: errs) == ast.noType 'failed'
		return ast.noType
	end 'failed'
	return p.builtins.neverTy
end 'checkPanic'

// checkTry types a try: the value of its expression, or on a failure the value 'otherwise' gives or the jump it makes. One
// that ignores a failure has no value, so it stands alone as a statement.
function checkTry(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let want = c.expect
	let guarded = ast.tryExprE(p.modules[c.modIdx].tree, id: e)
	let propagates = ast.propagates(p.modules[c.modIdx].tree, e: e)
	let alone = c.statement == e
	var errors = ast.TypeIDList.create(0)
	if not propagates 'catching'
		beginCatching(c)
	end 'catching'
	let result = checkExpecting(c, p: p, e: guarded, want: want, errs: errs)
	if not propagates 'caught'
		errors = endCatching(c)
	end 'caught'
	if result == ast.noType 'failed'
		return ast.noType
	end 'failed'
	let handler = ast.tryExprHandler(p.modules[c.modIdx].tree, id: e)
	if handler != 0 'handler'
		return checkTryHandler(c, p: p, e: e, result: result, errors: errors, alone: alone, errs: errs)
	end 'handler'
	if ast.tryExprIgnore(p.modules[c.modIdx].tree, id: e) 'ignore'
		if c.statement != e 'notAlone'
			failAt(c, p: p, node: e, code: diag.errErrorTypeMismatch, msg: diag.tryValueNeedsFallback(), errs: errs)
			return ast.noType
		end 'notAlone'
		return p.builtins.voidTy
	end 'ignore'
	let fallback = ast.tryFallback(p.modules[c.modIdx].tree, e: e)
	if fallback != 0 'value'
		return checkFallback(c, p: p, e: e, fallback: fallback, result: result, want: want, errs: errs)
	end 'value'
	checkTryJump(c, p: p, e: e, errs: errs)
	return result
end 'checkTry'

// checkTryHandler types the block handler of a try: it runs on a failure, binding the error when it names it. A handler that
// leaves gives the try its expression's value; one that runs off its end gives none, so the try stands alone as a statement.
function checkTryHandler(mutates c Checker, mutates p ast.Project, e ast.NodeID, result ast.TypeID, errors ast.TypeIDList, alone bool, mutates errs diag.ErrorList) returns ast.TypeID
	if c.fn == ast.noFunc 'noFunction'
		failAt(c, p: p, node: e, code: diag.errUnexpectedToken, msg: "a constant or a default is in no function to run a handler block in: give 'otherwise' the value to use", errs: errs)
		return ast.noType
	end 'noFunction'
	let falls = ast.tryHandlerFallsThrough(p.modules[c.modIdx].tree, e: e)
	let want = c.expect
	let statement = c.statement
	let body = ast.handlerBlockBodyRef(p.modules[c.modIdx].tree, id: ast.tryExprHandler(p.modules[c.modIdx].tree, id: e))
	let binding = ast.tryBinding(p.modules[c.modIdx].tree, e: e)
	pushScope(c)
	if binding == "" 'anonymous'
		checkStmts(c, p: p, body: body, errs: errs)
	end 'anonymous' else 'named'
		checkHandlerBinding(c, p: p, s: e, binding: binding, errors: errors, body: body, requireMatch: false, errs: errs)
	end 'named'
	popScope(c)
	c.statement = statement
	c.expect = want
	if not falls 'leaves'
		return result
	end 'leaves'
	if not alone 'notAlone'
		failAt(c, p: p, node: e, code: diag.errErrorTypeMismatch, msg: diag.tryValueNeedsFallback(), errs: errs)
		return ast.noType
	end 'notAlone'
	return p.builtins.voidTy
end 'checkTryHandler'

// checkTryJump types the statement that a try with no value makes on a failure.
function checkTryJump(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList)
	let ret = ast.tryExprRet(p.modules[c.modIdx].tree, id: e)
	if ret != 0 'return'
		if c.fn == ast.noFunc 'noFunction'
			failAt(c, p: p, node: ret, code: diag.errUnexpectedToken, msg: "a constant or a default is in no function to return from: give 'otherwise' the value to use", errs: errs)
			return
		end 'noFunction'
		checkReturn(c, p: p, s: ret, errs: errs)
		return
	end 'return'
	let brk = ast.tryExprBrk(p.modules[c.modIdx].tree, id: e)
	if brk != 0 'break'
		checkJump(c, p: p, s: brk, isBreak: true, errs: errs)
		return
	end 'break'
	let cont = ast.tryExprCont(p.modules[c.modIdx].tree, id: e)
	if cont != 0 'continue'
		checkJump(c, p: p, s: cont, isBreak: false, errs: errs)
		return
	end 'continue'
	let thr = ast.tryExprThr(p.modules[c.modIdx].tree, id: e)
	if thr != 0 'throw'
		checkThrow(c, p: p, s: thr, errs: errs)
	end 'throw'
end 'checkTryJump'

function checkFallback(mutates c Checker, mutates p ast.Project, e ast.NodeID, fallback ast.NodeID, result ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	// A literal fallback is a value of the alias the call returns, as in maxon, so one outside its range is refused. Any
	// other integer fallback with no type to take is joined with the result as a conditional's branches are, rather than
	// computed in the result's alias, which it need not fit.
	var expected = want
	if expected == ast.noType and not typeHasKind(p, t: result, kind: ast.TypeKind.intRange) 'noExpectation'
		expected = result
	end 'noExpectation'
	let other = checkExpecting(c, p: p, e: fallback, want: expected, errs: errs)
	if other == ast.noType 'failed'
		return ast.noType
	end 'failed'
	if typeIsNamedInt(p.types, t: result) and isConstInt(p, t: other) and fallbackIsPlainLiteral(p, c: c, fallback: fallback) 'literal'
		let value = p.types.entries[other as Count].minVal.clone()
		if not intRangeHolds(p.types, dst: result, v: value) 'doesNotFit'
			failAt(c, p: p, node: e, code: diag.errTypeMismatch, msg: otherwiseValueOutOfRange(p, value: value.toString(), target: result), errs: errs)
			return ast.noType
		end 'doesNotFit'
	end 'literal'
	return joinTypes(c, p: p, off: offsetOf(c, p: p, node: fallback), clash: Clash.other, a: result, b: other, errs: errs)
end 'checkFallback'

// fallbackIsPlainLiteral is whether a fallback is an integer literal, negated or not: the only fallback that maxon holds to
// the alias of the call's result.
function fallbackIsPlainLiteral(p ast.Project, c Checker, fallback ast.NodeID) returns bool
	var literal = fallback
	if p.modules[c.modIdx].tree.kindOf(fallback) == ast.NodeKind.unaryExpr and ast.unaryExprOp(p.modules[c.modIdx].tree, id: fallback) == "-" 'negated'
		literal = ast.unaryExprE(p.modules[c.modIdx].tree, id: fallback)
	end 'negated'
	return p.modules[c.modIdx].tree.kindOf(literal) == ast.NodeKind.intLit
end 'fallbackIsPlainLiteral'
