// The expressions. A module-level constant is checked outside any function, where no call is made and no local is
// declared, so the same expressions serve a constant, a field's default and the body of a function.
// shiftLimit is the count from which a shift moves every bit out of a 64-bit word.
let shiftLimit = 64 as Count

function isArithmeticOp(op String) returns bool
	return op == "+" or op == "-" or op == "*" or op == "/" or op == "mod" or op == "shl" or op == "shr"
end 'isArithmeticOp'

function isLogicalOp(op String) returns bool
	return op == "and" or op == "or" or op == "xor"
end 'isLogicalOp'

function isComparisonOp(op String) returns bool
	return op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
end 'isComparisonOp'

function kindOfType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeKind
	return ast.typeKind(ms.types, reads: p.types, t: t)
end 'kindOfType'

function isConstInt(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return t != ast.noType and kindOfType(p, ms: ms, t: t) == ast.TypeKind.constInt
end 'isConstInt'

function typeHasKind(p ast.Project, ms ast.ModuleState, t ast.TypeID, kind ast.TypeKind) returns bool
	return t != ast.noType and kindOfType(p, ms: ms, t: t) == kind
end 'typeHasKind'

function nameOfType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return ast.typeName(ms.types, reads: p.types, t: t)
end 'nameOfType'

// rawSurfaceCauseOfTypes is the cause of an error about two types: rawSurface when one is a type of maxon's raw memory surface and
// the other is not, as an array is not a buffer here without `.managed`. Two buffers that differ are a mismatch of their
// elements.
function rawSurfaceCauseOfTypes(p ast.Project, ms ast.ModuleState, a ast.TypeID, b ast.TypeID) returns diag.ErrorCause
	let first = diag.rawSurfaceCause(nameOfType(p, ms: ms, t: a))
	let second = diag.rawSurfaceCause(nameOfType(p, ms: ms, t: b))
	if first != second 'one'
		return diag.ErrorCause.rawSurface
	end 'one'
	return diag.ErrorCause.none
end 'rawSurfaceCauseOfTypes'

// declaredNameOfType is the name a type was declared with, which a generic instance shares with its generic.
function declaredNameOfType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return ast.typeName(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: t))
end 'declaredNameOfType'

// checkExpr types an expression, which gives the type it has, or none after it reported why it has none.
function checkExpr(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	return checkExpecting(c, p: p, ms: ms, e: e, want: ast.noType, errs: errs)
end 'checkExpr'

// checkExpecting types an expression whose context needs a value of want; want is none where the context needs none in
// particular. The expectation reaches only the expression itself, and the branches that give its value.
function checkExpecting(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let outer = c.expect
	c.expect = want
	var t = visitExpr(c, p: p, ms: ms, e: e, errs: errs)
	c.expect = outer
	if isConstInt(p, ms: ms, t: t) and ast.isFloatType(ms.types, reads: p.types, t: want) 'asFloat'
		// An integer constant where a float is needed is the double of its value.
		t = ast.internConstFloat(ms.types, reads: p.types, bits: constantBits(p, ms: ms, t: t))
	end 'asFloat'
	recordType(c, e: e, t: t)
	return t
end 'checkExpecting'

// recordType keeps the type of an expression that has one.
function recordType(mutates c Checker, e ast.NodeID, t ast.TypeID)
	if t != ast.noType 'typed'
		ast.setNodeType(c.typing, node: e, ty: t)
	end 'typed'
end 'recordType'

function visitExpr(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let k = ms.tree().kindOf(e)
	if k == ast.NodeKind.intLit 'intLit'
		return ast.internConstInt(ms.types, reads: p.types, val: ast.intLitValue(ms.tree(), id: e))
	end 'intLit'
	if k == ast.NodeKind.floatLit 'floatLit'
		return ast.internConstFloat(ms.types, reads: p.types, bits: ast.floatLitBits(ms.tree(), id: e))
	end 'floatLit'
	if k == ast.NodeKind.boolLit 'boolLit'
		return p.builtins.boolTy
	end 'boolLit'
	if k == ast.NodeKind.strLit 'strLit'
		return checkStrLit(c, p: p, ms: ms, e: e, errs: errs)
	end 'strLit'
	if k == ast.NodeKind.byteStrLit 'byteStrLit'
		return checkByteStrLit(c, p: p, ms: ms, e: e, errs: errs)
	end 'byteStrLit'
	if k == ast.NodeKind.charLit 'charLit'
		return p.builtins.characterTy
	end 'charLit'
	if k == ast.NodeKind.nameExpr 'nameExpr'
		return checkNameExpr(c, p: p, ms: ms, e: e, errs: errs)
	end 'nameExpr'
	if k == ast.NodeKind.selfExpr 'selfExpr'
		return checkSelfExpr(c, p: p, ms: ms, e: e, errs: errs)
	end 'selfExpr'
	if k == ast.NodeKind.binaryExpr 'binaryExpr'
		return checkBinary(c, p: p, ms: ms, e: e, errs: errs)
	end 'binaryExpr'
	if k == ast.NodeKind.unaryExpr 'unaryExpr'
		return checkUnary(c, p: p, ms: ms, e: e, errs: errs)
	end 'unaryExpr'
	if k == ast.NodeKind.asyncExpr 'asyncExpr'
		noteAct(c)
		return checkAsync(c, p: p, ms: ms, e: e, errs: errs)
	end 'asyncExpr'
	if k == ast.NodeKind.awaitExpr 'awaitExpr'
		noteAct(c)
		return checkAwait(c, p: p, ms: ms, e: e, errs: errs)
	end 'awaitExpr'
	if k == ast.NodeKind.spawnExpr 'spawnExpr'
		noteAct(c)
		return checkSpawn(c, p: p, ms: ms, e: e, errs: errs)
	end 'spawnExpr'
	if k == ast.NodeKind.condExpr 'condExpr'
		return checkCond(c, p: p, ms: ms, e: e, errs: errs)
	end 'condExpr'
	if k == ast.NodeKind.castExpr 'castExpr'
		return checkCast(c, p: p, ms: ms, e: e, errs: errs)
	end 'castExpr'
	if k == ast.NodeKind.fromExpr 'fromExpr'
		return checkFromExpr(c, p: p, ms: ms, e: e, errs: errs)
	end 'fromExpr'
	if k == ast.NodeKind.rangeExpr 'rangeExpr'
		return checkRangeExpr(c, p: p, ms: ms, e: e, errs: errs)
	end 'rangeExpr'
	if k == ast.NodeKind.memberExpr 'memberExpr'
		return checkMember(c, p: p, ms: ms, e: e, errs: errs)
	end 'memberExpr'
	if k == ast.NodeKind.tryExpr 'tryExpr'
		return checkTry(c, p: p, ms: ms, e: e, errs: errs)
	end 'tryExpr'
	if k == ast.NodeKind.panicExpr 'panicExpr'
		noteAct(c)
		return checkPanic(c, p: p, ms: ms, e: e, errs: errs)
	end 'panicExpr'
	if k == ast.NodeKind.callExpr 'callExpr'
		let called = checkCall(c, p: p, ms: ms, e: e, errs: errs)
		noteCallActs(c, call: e)
		return called
	end 'callExpr'
	if k == ast.NodeKind.structLitExpr 'structLitExpr'
		return checkStructLit(c, p: p, ms: ms, e: e, errs: errs)
	end 'structLitExpr'
	if k == ast.NodeKind.tupleExpr 'tupleExpr'
		return checkTupleLit(c, p: p, ms: ms, e: e, errs: errs)
	end 'tupleExpr'
	if k == ast.NodeKind.indexExpr 'indexExpr'
		return checkIndex(c, p: p, ms: ms, e: e, errs: errs)
	end 'indexExpr'
	if k == ast.NodeKind.collectionLitExpr 'collectionLitExpr'
		return checkCollectionLit(c, p: p, ms: ms, e: e, errs: errs)
	end 'collectionLitExpr'
	if k == ast.NodeKind.matchExpr 'matchExpr'
		let core = ast.matchExprMatch(ms.tree(), id: e)
		return checkMatch(c, p: p, ms: ms, core: core, isExpr: true, errs: errs)
	end 'matchExpr'
	if k == ast.NodeKind.closureExpr 'closureExpr'
		// A closure's body runs when it is called: making the closure does nothing it does.
		let outerActs = c.acts
		let closure = checkClosure(c, p: p, ms: ms, e: e, errs: errs)
		c.acts = outerActs
		return closure
	end 'closureExpr'
	if k == ast.NodeKind.typeQueryExpr 'typeQueryExpr'
		return checkTypeQuery(c, p: p, ms: ms, e: e, errs: errs)
	end 'typeQueryExpr'
	panic("the node {e} of kind {k.name} is no expression")
end 'visitExpr'

// noteCallActs counts a call among the acts, unless it constructs a case of a union, which makes a value and does nothing.
function noteCallActs(mutates c Checker, call ast.NodeID)
	var slot as Count
	if c.typing.calls.find(call as Count, slot: slot) 'recorded'
		if c.typing.calls.valueAt(slot).kind == ast.CallKind.callUnionCtor 'constructs'
			return
		end 'constructs'
	end 'recorded'
	noteAct(c)
end 'noteCallActs'

// noteAct counts one call, send, await, async call, spawn or panic among the acts of the code being checked.
function noteAct(mutates c Checker)
	c.acts = try c.acts + 1 otherwise panic("check: too many calls")
end 'noteAct'

// checkStrLit types a string, whose interpolated values must be of a type that has a text.
function checkStrLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let partsRef = ast.strLitPartsRef(ms.tree(), id: e)
	let count = ms.tree().strPartCount(partsRef)
	for i in 0 upto count 'parts'
		if ms.tree().strPartIsExpr(partsRef, index: i) 'interpolated'
			let part = ms.tree().strPartExpr(partsRef, index: i)
			let formatted = ms.tree().strPartFormat(partsRef, index: i).byteLength() > 0
			if not checkInterpolation(c, p: p, ms: ms, part: part, formatted: formatted, errs: errs) 'bad'
				return ast.noType
			end 'bad'
		end 'interpolated'
	end 'parts'
	return p.builtins.stringTy
end 'checkStrLit'

// checkByteStrLit types a byte string: a new ByteArray of its bytes, which the program may write. Where the context expects
// an array of another integer type that holds every byte of it in one byte each, the literal is that array, as maxon's
// adopts the element type it is written for.
function checkByteStrLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	if adoptsBytes(p, ms: ms, e: e, want: c.expect) 'adopted'
		return c.expect
	end 'adopted'
	var args = ast.TypeIDList.create(0)
	args.push(p.builtins.byteTy)
	let origin = p.builtins.arrayOrigin
	return instantiateGeneric(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), orig: origin, args: args, errs: errs)
end 'checkByteStrLit'

// adoptsBytes is whether the byte string e can be an array of the type want: an array of an integer type that packs one byte
// to an element and whose range holds each byte of the literal.
function adoptsBytes(p ast.Project, ms ast.ModuleState, e ast.NodeID, want ast.TypeID) returns bool
	if want == ast.noType or ast.typeKind(ms.types, reads: p.types, t: want) != ast.TypeKind.builtinArray or ast.originOf(ms.types, reads: p.types, t: want) != p.builtins.arrayOrigin 'notArray'
		return false
	end 'notArray'
	let elem = ast.typeEntry(ms.types, reads: p.types, t: want).typeArgs[0]
	if ast.typeKind(ms.types, reads: p.types, t: elem) != ast.TypeKind.intRange or not ast.packsByte(ms.types, reads: p.types, b: p.builtins, elem: elem) 'notBytes'
		return false
	end 'notBytes'
	let lo = ast.typeEntry(ms.types, reads: p.types, t: elem).minVal.clone()
	let hi = ast.typeEntry(ms.types, reads: p.types, t: elem).maxVal.clone()
	let text = ast.strPartsText(ms.tree(), partsRef: ast.byteStrLitPartsRef(ms.tree(), id: e))
	for i in 0 upto text.byteLength() 'bytes'
		let b = ast.I128.fromCount(text.byteAt(i) as Count)
		if b.lt(lo) or b.gt(hi) 'outside'
			return false
		end 'outside'
	end 'bytes'
	return true
end 'adoptsBytes'

// interpolatesItself is whether the interpolation writes the text of a value of type t itself: a built-in type, an enum or
// a union.
function interpolatesItself(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let k = kindOfType(p, ms: ms, t: t)
	return isNumberType(p, ms: ms, t: t) or t == p.builtins.stringTy or t == p.builtins.characterTy or t == p.builtins.boolTy or t == p.builtins.filePathTy or k == ast.TypeKind.enumTy or k == ast.TypeKind.unionTy
end 'interpolatesItself'

// toStringMethod is the method that gives the text of a value of a type that makes its own, which interpolation calls.
let toStringMethod = "toString"

// checkInterpolation checks a value interpolated into a string: a built-in type the interpolation writes itself, or a type
// with a `toString()` that gives a String, which it calls (recorded in the hooks of the typing). A format written after it
// is for the built-in types alone.
function checkInterpolation(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, part ast.NodeID, formatted bool, mutates errs diag.ErrorList) returns bool
	let typed = checkExpr(c, p: p, ms: ms, e: part, errs: errs)
	if typed == ast.noType 'failed'
		return false
	end 'failed'
	let t = ast.contentType(ms.types, reads: p.types, t: typed)
	let off = offsetOf(c, p: p, ms: ms, node: part)
	if not requireSigned64(c, off: off, t: t, p: p, ms: ms, errs: errs) 'wide'
		return false
	end 'wide'
	if interpolatesItself(p, ms: ms, t: t) 'printable'
		return true
	end 'printable'
	if not formatted 'hook'
		let hook = protocolCall(c, p: p, ms: ms, t: t, name: toStringMethod)
		if hook.found and hook.thrown == ast.noType and hook.result == p.builtins.stringTy 'text'
			if not requireProtocolVisible(c, p: p, ms: ms, s: part, call: hook, errs: errs) 'hidden'
				return false
			end 'hidden'
			c.waitNow = true
			c.typing.hooks.insert(part as Count, value: hook.info.clone())
			if hook.generic 'instances'
				recordUse(c, call: part)
			end 'instances'
			return true
		end 'text'
	end 'hook'
	checkFail(c.modID, off: off, code: diag.errConformance, msg: diag.interpolatedWithoutText(nameOfType(p, ms: ms, t: t)), errs: errs)
	return false
end 'checkInterpolation'

// constantOf is the constant that a name written as an expression stands for, if it is one.
function constantOf(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns table.Option with ast.ConstValue
	return ast.declConst(p, ms: ms, ref: ref)
end 'constantOf'

// isQualifiedName is whether the resolver made a name of a name written with its module or its type, `mod.name`, or the bodies
// one of a static let that an extension adds, `Type.name`: it stands for that declaration, never for a local, a field or a
// method of the enclosing type, which a bare name outranks.
function isQualifiedName(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns bool
	return ast.resolutionOf(p, ms: ms).becomeNames.has(e as Count) or ms.tables.memberDecl(e as Count).isSome()
end 'isQualifiedName'

// checkShadowedQualifier refuses a type written after a module's name that a local, a parameter or a field of that name has a member
// of too (resolve's namesModuleTypeMember read the qualifier as the module): `url.URL.parse(s)` where the local url's type has
// a member URL could mean either, so neither is chosen.
function checkShadowedQualifier(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, name String, mutates errs diag.ErrorList) returns bool
	match ast.resolutionOf(p, ms: ms).shadowingLocals.get(e as Count) 'shadowing'
		some(module) then return not localHasMember(c, p: p, ms: ms, e: e, local: module, member: name, errs: errs)
		none then return true
	end 'shadowing'
end 'checkShadowedQualifier'

function localHasMember(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, local String, member String, mutates errs diag.ErrorList) returns bool
	let held = shadowingType(c, p: p, ms: ms, name: local)
	if held == ast.noType 'none'
		return false
	end 'none'
	let t = ast.contentType(ms.types, reads: p.types, t: held)
	let isField = typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.record) and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: t)).findField(member).isSome()
	let isMethod = typeIsNominal(ms.types, reads: p.types, t: t) and methodNamed(p, ms: ms, t: t, name: member) != ast.noFunc
	if not isField and not isMethod 'none'
		return false
	end 'none'
	failAt(c, p: p, ms: ms, node: e, code: diag.errAmbiguousQualifier, msg: "'{local}.{member}' is ambiguous: '{local}' names the module that declares the type '{member}' and a {shadowingKind(c, name: local)} whose type '{nameOfType(p, ms: ms, t: t)}' has a member '{member}'; rename the {shadowingKind(c, name: local)}", errs: errs)
	return true
end 'localHasMember'

// shadowingType is the type of the local, the parameter or the field of the enclosing type that a bare name stands for, or
// noType: a local outranks a field, as a bare name's lookup has it.
function shadowingType(c Checker, p ast.Project, ms ast.ModuleState, name String) returns ast.TypeID
	let id = lookupLocal(c, name: name)
	if id != ast.noLocal 'local'
		return c.typing.locals[id as Count].ty
	end 'local'
	let rt = selfRecord(c, p: p, ms: ms)
	if rt == ast.noType 'noSelf'
		return ast.noType
	end 'noSelf'
	let entry = ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: rt))
	match entry.findField(name) 'field'
		some(index) then return entry.fields[index].ty
		none then return ast.noType
	end 'field'
end 'shadowingType'

function shadowingKind(c Checker, name String) returns String
	return "local" if lookupLocal(c, name: name) != ast.noLocal else "field"
end 'shadowingKind'

function checkQualifiedName(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = ast.nameExprName(ms.tree(), id: e).clone()
	if not checkShadowedQualifier(c, p: p, ms: ms, e: e, name: name, errs: errs) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	match consumes ast.nodeDecl(p, ms: ms, node: e as Count) 'bound'
		some(ref) then return checkDeclaredName(c, p: p, ms: ms, e: e, ref: ref, name: name, errs: errs)
		none then panic("a qualified name '{name}' was resolved to no declaration")
	end 'bound'
end 'checkQualifiedName'

function checkNameExpr(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	if isQualifiedName(c, p: p, ms: ms, e: e) 'qualified'
		return checkQualifiedName(c, p: p, ms: ms, e: e, errs: errs)
	end 'qualified'
	let name = ast.nameExprName(ms.tree(), id: e).clone()
	let off = offsetOf(c, p: p, ms: ms, node: e)
	let mark = errs.count()
	let local = useLocal(c, p: p, ms: ms, use: e, name: name, errs: errs)
	if failedSince(errs, mark: mark) 'refused'
		return ast.noType
	end 'refused'
	if local != ast.noLocal 'local'
		c.typing.names.insert(e as Count, value: ast.NameInfo.localName(local))
		let declared = c.typing.locals[local as Count].ty
		if declared == ast.noType 'refused'
			diag.pushConsequence(errs, code: diag.errExpressionError, message: "'{name}' was declared with a type that was refused", module: c.modID, offset: off)
		end 'refused'
		return declared
	end 'local'
	let rt = selfRecord(c, p: p, ms: ms)
	if rt != ast.noType 'inMethod'
		match consumes ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: rt)).findField(name) 'field'
			some(index) then return selfFieldType(c, p: p, ms: ms, e: e, rt: rt, name: name, index: index)
			none then break
		end 'field'
	end 'inMethod'
	if c.inBehaviour 'behaviour'
		match consumes selfFieldInBehaviour(c, p: p, ms: ms, name: name) 'selfField'
			some(fieldTy) then return refuseBehaviourSelf(c, p: p, ms: ms, off: off, what: "the field '{name}'", t: fieldTy, errs: errs)
			none then break
		end 'selfField'
	end 'behaviour'
	match consumes ast.nodeDecl(p, ms: ms, node: e as Count) 'bound'
		some(ref) then return checkDeclaredName(c, p: p, ms: ms, e: e, ref: ref, name: name, errs: errs)
		none then break
	end 'bound'
	if name == "Self" 'selfName'
		checkFail(c.modID, off: off, code: diag.errExpressionError, msg: "'Self' is a type, not a value", errs: errs)
		return ast.noType
	end 'selfName'
	diag.pushUnqualifiedError(errs, code: diag.errExpressionError, message: diag.undefinedVariable(name), module: c.modID, offset: off, name: name.clone())
	return ast.noType
end 'checkNameExpr'

// selfFieldType records that a name stands for a field of the receiver, and gives the type the field has in the receiver.
function selfFieldType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, rt ast.TypeID, consumes name String, index Count) returns ast.TypeID
	c.typing.names.insert(e as Count, value: ast.NameInfo.selfFieldName(name, fieldIndex: index))
	return ast.fieldType(ms.types, reads: p.types, owner: rt, index: index)
end 'selfFieldType'

function checkDeclaredName(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes ref ast.DeclRef, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: e)
	if ast.declIsType(p, ref: ref) 'type'
		checkFail(c.modID, off: off, code: diag.errExpressionError, msg: "'{name}' is a type, not a value", errs: errs)
		return ast.noType
	end 'type'
	match consumes constantOf(p, ms: ms, ref: ref) 'const'
		some(value) then return typeOfConstant(c, p: p, ms: ms, e: e, ref: ref, value: value, errs: errs)
		none then break
	end 'const'
	if ast.declIsConst(p, ref: ref) 'unvalued'
		checkFail(c.modID, off: off, code: diag.errExpressionError, msg: "constant '{name}' has no value", errs: errs)
		return ast.noType
	end 'unvalued'
	return functionValue(c, p: p, ms: ms, e: e, ref: ref, name: name, errs: errs)
end 'checkDeclaredName'

// typeOfConstant types a read of the constant ref. A constant is built where it is read, so the calls of its value that need
// an instance of a generic (a map literal's) are the reader's. A reader in the constant's module takes them on as its own;
// one in another module records the read itself, since the calls are nodes of the constant's module, whose check may not
// have ended yet: finding the instances follows the read to them (ir.visitSites).
function typeOfConstant(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes ref ast.DeclRef, consumes value ast.ConstValue, mutates errs diag.ErrorList) returns ast.TypeID
	if value.instanceOf != ast.noType 'perInstance'
		match consumes c.typing.staticInstances.get(e as Count) 'instance'
			some(instance) then return typeOfInstanceConstant(c, p: p, ms: ms, e: e, ref: ref, value: value, instance: instance)
			none then break
		end 'instance'
		if ast.originOf(ms.types, reads: p.types, t: c.owner) != value.instanceOf 'bare'
			failBareInstanceStatic(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), qualified: ast.declName(p, ref: ref), origin: value.instanceOf, errs: errs)
			return ast.noType
		end 'bare'
		// A static let whose value reads one that is one for each instance is one for each instance too.
		if c.constName != "" 'constant'
			c.constNamesParams = true
		end 'constant'
	end 'perInstance'
	if c.hasUses 'reader'
		if ref.module == c.modID 'here'
			match consumes c.typing.fieldUses.get(ast.constValueNode(p, ref: ref) as Count) 'uses'
				some(calls) then recordAll(c, calls: calls)
				none then break
			end 'uses'
		end 'here' else if ref.module != diag.stdlibID 'elsewhere'
			recordUse(c, call: e)
		end 'elsewhere'
	end 'reader'
	c.typing.names.insert(e as Count, value: ast.NameInfo.constName(ref))
	return value.ty
end 'typeOfConstant'

// typeOfInstanceConstant types a read of a static let that is one for each instance of its generic type, read through the
// instance: its type with the type's parameters bound to the instance's arguments. Its value is built at the read with them
// bound, so the read itself is recorded for the instances its calls need (ir.visitSites), wherever the constant is.
function typeOfInstanceConstant(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, consumes ref ast.DeclRef, consumes value ast.ConstValue, instance ast.TypeID) returns ast.TypeID
	if c.hasUses 'reader'
		recordUse(c, call: e)
	end 'reader'
	c.typing.names.insert(e as Count, value: ast.NameInfo.constName(ref))
	let params = ast.typeEntry(ms.types, reads: p.types, t: value.instanceOf).typeParams.clone()
	let args = ast.typeEntry(ms.types, reads: p.types, t: instance).typeArgs.clone()
	return ast.substituteType(ms.types, reads: p.types, t: value.ty, params: params, args: args)
end 'typeOfInstanceConstant'

function checkSelfExpr(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	if c.inClosure 'closure'
		// A closure in a method names its receiver by name, which the resolver made of 'self'.
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errUnexpectedToken, msg: diag.selfOutsideInstanceMethod(), errs: errs)
		return ast.noType
	end 'closure'
	if c.inBehaviour 'behaviour'
		let owner = c.owner
		return refuseBehaviourSelf(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), what: "'self'", t: owner, errs: errs)
	end 'behaviour'
	if c.fn == ast.noFunc or not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).hasReceiver 'outside'
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errUnexpectedToken, msg: diag.selfOutsideInstanceMethod(), errs: errs)
		return ast.noType
	end 'outside'
	requireParallelRead(c, p: p, ms: ms, use: e, local: ast.receiverLocal(p, ms: ms, f: c.fn), errs: errs)
	return c.owner
end 'checkSelfExpr'

// foldOp is the value of an operator on two constants, or none after it reported why the operator gives none.
function foldOp(c Checker, off diag.U32, rightOff diag.U32, op String, a ast.I128, b ast.I128, mutates errs diag.ErrorList) returns table.Option with ast.I128
	var r = ast.I128.zero()
	if op == "+" 'add'
		r = a.add(b)
	end 'add' else if op == "-" 'sub'
		r = a.sub(b)
	end 'sub' else if op == "*" 'mul'
		r = ast.mulWide(a, b: b)
	end 'mul' else if op == "/" or op == "mod" 'div'
		if b.isZero() 'zero'
			checkFail(c.modID, off: off, code: diag.errDivisionByZero, msg: diag.divisionByProvableZero(op), errs: errs)
			return table.Option.none
		end 'zero'
		if op == "/" 'quotient'
			r = ast.quoTrunc(a, b: b)
		end 'quotient' else 'remainder'
			r = ast.modTrunc(a, b: b)
		end 'remainder'
	end 'div' else if op == "and" 'and'
		r = ast.bitwise(ast.BitsOp.bitAnd, a: a, b: b)
	end 'and' else if op == "or" 'or'
		r = ast.bitwise(ast.BitsOp.bitOr, a: a, b: b)
	end 'or' else if op == "xor" 'xor'
		r = ast.bitwise(ast.BitsOp.bitXor, a: a, b: b)
	end 'xor' else if op == "shl" or op == "shr" 'shift'
		return foldShift(c, off: rightOff, op: op, a: a, b: b, errs: errs)
	end 'shift' else 'unknown'
		checkFail(c.modID, off: off, code: diag.errUnsupported, msg: "cannot fold '{op}'", errs: errs)
		return table.Option.none
	end 'unknown'
	return checkedFold(c, off: off, r: r, errs: errs)
end 'foldOp'

function foldShift(c Checker, off diag.U32, op String, a ast.I128, b ast.I128, mutates errs diag.ErrorList) returns table.Option with ast.I128
	if b.isNeg() 'negative'
		checkFail(c.modID, off: off, code: diag.errShiftCountNegative, msg: diag.shiftCountNegative(b.toString()), errs: errs)
		return table.Option.none
	end 'negative'
	var count = shiftLimit
	if b.lt(ast.I128.fromCount(shiftLimit)) 'narrow'
		count = b.lo
	end 'narrow'
	if op == "shl" 'left'
		if count >= shiftLimit 'wide'
			return checkedFold(c, off: off, r: ast.I128.zero(), errs: errs)
		end 'wide'
		return checkedFold(c, off: off, r: ast.shiftLeft(a, n: count), errs: errs)
	end 'left'
	return checkedFold(c, off: off, r: ast.shiftRight(a, n: count), errs: errs)
end 'foldShift'

// checkedFold is a folded value, refused where it is past the 64 bits that a word holds.
function checkedFold(c Checker, off diag.U32, consumes r ast.I128, mutates errs diag.ErrorList) returns table.Option with ast.I128
	if r.lt(ast.I128.i64Min()) or r.gt(ast.I128.u64Max()) 'past'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "the constant expression overflows 64 bits", errs: errs)
		return table.Option.none
	end 'past'
	return table.Option.some(r)
end 'checkedFold'

// setOperand records the arithmetic of an operator or a cast, which every one that types has, so that the lowering finds
// it; the range analysis then says how the operation can fail.
function setOperand(mutates c Checker, node ast.NodeID, operand ast.TypeID)
	c.typing.arith.insert(node as Count, value: ast.ArithInfo.make(operand, word: operand, fails: ast.failNone, unreached: false, checkedFail: false))
end 'setOperand'

// checkBinary types an operator. A chain of operators nests to the left, so the chain is walked innermost first with a
// loop: each operator is checked once the type of its left operand is known, which is what visiting the left operand
// first gives.
function checkBinary(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let want = c.expect
	var chain = ast.leftChain(ms.tree(), e: e)
	var node = ast.nextOperator(chain, e: e)
	var l = checkExpr(c, p: p, ms: ms, e: ast.binaryExprL(ms.tree(), id: node), errs: errs)
	while node != e 'inner'
		if l == ast.noType 'badInner'
			return ast.noType
		end 'badInner'
		l = checkOperator(c, p: p, ms: ms, e: node, checkedL: l, want: ast.noType, errs: errs)
		recordType(c, e: node, t: l)
		node = ast.nextOperator(chain, e: e)
	end 'inner'
	if l == ast.noType 'badLeft'
		return ast.noType
	end 'badLeft'
	return checkOperator(c, p: p, ms: ms, e: e, checkedL: l, want: want, errs: errs)
end 'checkBinary'

// checkOperator types an operator whose left operand has the type l.
function checkOperator(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, checkedL ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let op = ast.binaryExprOp(ms.tree(), id: e)
	let rNode = ast.binaryExprR(ms.tree(), id: e)
	let checkedR = checkExpr(c, p: p, ms: ms, e: rNode, errs: errs)
	if checkedR == ast.noType 'badRight'
		return ast.noType
	end 'badRight'
	let lNode = ast.binaryExprL(ms.tree(), id: e)
	let integerL = integerized(c, p: p, ms: ms, e: lNode, t: checkedL, other: checkedR)
	let integerR = integerized(c, p: p, ms: ms, e: rNode, t: checkedR, other: integerL)
	let caseL = rawCaseCompared(c, p: p, ms: ms, e: lNode, t: integerL, other: integerR, compares: isComparisonOp(op))
	let caseR = rawCaseCompared(c, p: p, ms: ms, e: rNode, t: integerR, other: caseL, compares: isComparisonOp(op))
	// In an operation that is no comparison and of which neither operand names an alias, a literal's code point is a Codepoint,
	// as maxon's is: `'A' + 1` is a Codepoint, which a parameter of another alias refuses.
	let unaliased = not isComparisonOp(op) and not typeIsNamedInt(ms.types, reads: p.types, t: caseL) and not typeIsNamedInt(ms.types, reads: p.types, t: caseR)
	let l = codepointTyped(c, p: p, ms: ms, e: lNode, t: caseL, retype: unaliased)
	let r = codepointTyped(c, p: p, ms: ms, e: rNode, t: caseR, retype: unaliased)
	let off = offsetOf(c, p: p, ms: ms, node: e)
	if ast.isFloatType(ms.types, reads: p.types, t: l) or ast.isFloatType(ms.types, reads: p.types, t: r) 'floats'
		if isComparisonOp(op) 'comparison'
			return checkFloatComparison(c, p: p, ms: ms, e: e, op: op, l: l, r: r, errs: errs)
		end 'comparison'
		if isArithmeticOp(op) or isLogicalOp(op) 'arithmetic'
			return checkFloatOp(c, p: p, ms: ms, e: e, op: op, l: l, r: r, errs: errs)
		end 'arithmetic'
	end 'floats'
	if isArithmeticOp(op) or (isLogicalOp(op) and ast.isIntType(ms.types, reads: p.types, t: l)) 'integers'
		return checkIntegerOp(c, p: p, ms: ms, e: e, op: op, l: l, r: r, want: want, errs: errs)
	end 'integers'
	if isLogicalOp(op) 'logical'
		if l != p.builtins.boolTy or r != p.builtins.boolTy 'notBool'
			return refuseOperands(c, p: p, ms: ms, off: off, op: op, l: l, r: r, errs: errs)
		end 'notBool'
		return p.builtins.boolTy
	end 'logical'
	if isComparisonOp(op) 'comparison'
		return checkComparison(c, p: p, ms: ms, e: e, op: op, l: l, r: r, errs: errs)
	end 'comparison'
	checkFail(c.modID, off: off, code: diag.errUnsupported, msg: "unknown operator '{op}'", errs: errs)
	return ast.noType
end 'checkOperator'

// integerized is the type of the operand e, of type t, beside an operand of type other: a character literal that is the whole of
// an operand beside an integer is its code point, a constant, as maxon's is (cp - '0'), where its cluster is one code point;
// any other operand, a Character that is no literal among them, keeps its type.
function integerized(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, other ast.TypeID) returns ast.TypeID
	if ms.tree().kindOf(e) != ast.NodeKind.charLit or not ast.isIntType(ms.types, reads: p.types, t: other) 'kept'
		return t
	end 'kept'
	let cp = ast.charLitCodepoint(ms.tree(), id: e)
	if not cp.isSome() 'cluster'
		return t
	end 'cluster'
	let coerced = ast.internConstInt(ms.types, reads: p.types, val: ast.I128.fromCount(cp.unwrap()))
	recordType(c, e: e, t: coerced)
	return coerced
end 'integerized'

// rawCaseCompared is the type of the operand e, of type t, of a comparison with an integer of the type other: the raw value
// of the enum case it writes, as the integer constant it is, where rawCaseConstant gives one (`b == Ascii.underscore`), and
// t otherwise.
function rawCaseCompared(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, other ast.TypeID, compares bool) returns ast.TypeID
	if not compares or not ast.isIntType(ms.types, reads: p.types, t: other) 'kept'
		return t
	end 'kept'
	let raw = rawCaseConstant(c, p: p, ms: ms, e: e)
	if raw != ast.noType 'case'
		recordType(c, e: e, t: raw)
		return raw
	end 'case'
	let span = rawValueSpan(p, ms: ms, t: t)
	if span == ast.noType 'notConstants'
		return t
	end 'notConstants'
	c.typing.rawReads.insert(e as Count, value: true)
	return span
end 'rawCaseCompared'

// rawValueSpan is the integer range of the raw values of the enum t, as an anonymous range, where it is maxon's constants
// enum, whose cases write integers: a value of it goes where an integer is expected as the raw value of its case, read when
// it runs (rawReads). noType for any other type.
function rawValueSpan(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	if ast.typeKind(ms.types, reads: p.types, t: t) != ast.TypeKind.enumTy 'notEnum'
		return ast.noType
	end 'notEnum'
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	if ast.typeEntry(ms.types, reads: p.types, t: orig).rawKind != ast.RawKind.integer or not ast.typeEntry(ms.types, reads: p.types, t: orig).hasExplicitRaw or ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() == 0 'notConstants'
		return ast.noType
	end 'notConstants'
	var lo = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[0].rawValue.clone()
	var hi = lo.clone()
	for i in 1 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() 'cases'
		let v = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[i].rawValue.clone()
		if v.lt(lo) 'lower'
			lo = v.clone()
		end 'lower'
		if hi.lt(v) 'higher'
			hi = v.clone()
		end 'higher'
	end 'cases'
	return ast.internIntRange(ms.types, reads: p.types, aliasName: "", minVal: lo, maxVal: hi, inferred: true)
end 'rawValueSpan'

// rawCaseConstant is the raw value of the enum case that e writes (`Ascii.space`), as an integer constant, where the case
// writes an integer: maxon's constants enum, whose case is its raw value where an integer is expected, compared with one or
// passed, stored or returned as one. It is noType for any other e, and for a value of such an enum that is no case written
// out, whose case is not known before it runs.
function rawCaseConstant(c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns ast.TypeID
	let owner = caseOwner(c, e: e, kind: ast.MemberKind.memberEnumCase)
	if owner == ast.noType or not ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: owner)).hasExplicitRaw 'unwritten'
		return ast.noType
	end 'unwritten'
	return caseRawConstant(c, p: p, ms: ms, e: e, kind: ast.MemberKind.memberEnumCase)
end 'rawCaseConstant'

// caseRawConstant is the constant type of the raw value of the case (of the member kind) that e writes, whose cases write
// integers or none: unnamed, so it takes the integer alias of the operand it meets as maxon's does. It is noType for any other e.
function caseRawConstant(c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, kind ast.MemberKind) returns ast.TypeID
	let owner = caseOwner(c, e: e, kind: kind)
	if owner == ast.noType 'notCase'
		return ast.noType
	end 'notCase'
	let orig = ast.originOf(ms.types, reads: p.types, t: owner)
	if ast.typeEntry(ms.types, reads: p.types, t: orig).rawKind != ast.RawKind.integer 'notInteger'
		return ast.noType
	end 'notInteger'
	let info = c.typing.members.get(e as Count).unwrap()
	return ast.internConstInt(ms.types, reads: p.types, val: ast.typeEntry(ms.types, reads: p.types, t: orig).cases[info.enumCase].rawValue.clone())
end 'caseRawConstant'

// caseOwner is the enum or union that the case e names belongs to, where e names a case of that kind of type, and noType otherwise.
function caseOwner(c Checker, e ast.NodeID, kind ast.MemberKind) returns ast.TypeID
	if not c.typing.members.has(e as Count) 'notMember'
		return ast.noType
	end 'notMember'
	let info = c.typing.members.get(e as Count).unwrap()
	if info.kind != kind 'notCase'
		return ast.noType
	end 'notCase'
	return info.ownerTy
end 'caseOwner'

// codepointTyped is the type of the operand e, of type t: a Codepoint where retype says so and e is a character literal that
// integerized made its code point, and t otherwise.
function codepointTyped(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, t ast.TypeID, retype bool) returns ast.TypeID
	if not retype or ms.tree().kindOf(e) != ast.NodeKind.charLit or not isConstInt(p, ms: ms, t: t) 'kept'
		return t
	end 'kept'
	recordType(c, e: e, t: p.builtins.codepointTy)
	return p.builtins.codepointTy
end 'codepointTyped'

// isWordOp is whether an operator works on the bits of its operands, which must then be two bools or two integers.
function isWordOp(op String) returns bool
	return isLogicalOp(op) or op == "shl" or op == "shr"
end 'isWordOp'

// refuseOperands reports operands that the operator has no meaning for, in the words maxon gives each kind of operator.
function refuseOperands(mutates c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let lName = gotName(p, ms: ms, t: l)
	let rName = gotName(p, ms: ms, t: r)
	if isWordOp(op) and not (l == r or (ast.isIntType(ms.types, reads: p.types, t: l) and ast.isIntType(ms.types, reads: p.types, t: r))) 'mixed'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.operandTypeMismatch(op), errs: errs)
		return ast.noType
	end 'mixed'
	if isWordOp(op) 'word'
		var offending = lName
		if ast.isIntType(ms.types, reads: p.types, t: l) 'left'
			offending = rName
		end 'left'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.nonIntegralOperands(op, operand: offending), errs: errs)
		return ast.noType
	end 'word'
	if lName == rName 'same'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.undefinedOperatorForType(op, typeName: lName), errs: errs)
		return ast.noType
	end 'same'
	checkFail(c.modID, off: off, code: diag.errExpressionError, msg: diag.nonNumericOperands(lName, right: rName), errs: errs)
	return ast.noType
end 'refuseOperands'

// checkIntegerOp types an arithmetic, bitwise or shift operator on two integers.
function checkIntegerOp(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: e)
	if not ast.isIntType(ms.types, reads: p.types, t: l) or not ast.isIntType(ms.types, reads: p.types, t: r) 'notInts'
		return refuseOperands(c, p: p, ms: ms, off: off, op: op, l: l, r: r, errs: errs)
	end 'notInts'
	let lConst = isConstInt(p, ms: ms, t: l)
	let rConst = isConstInt(p, ms: ms, t: r)
	if lConst and rConst 'folded'
		setOperand(c, node: e, operand: p.builtins.anon64Ty)
		return foldedType(c, p: p, ms: ms, off: off, rightOff: exprOffset(c, p: p, ms: ms, node: ast.binaryExprR(ms.tree(), id: e)), op: op, l: l, r: r, errs: errs)
	end 'folded'
	if (op == "/" or op == "mod") and rConst and ast.typeEntry(ms.types, reads: p.types, t: r).minVal.isZero() 'byZero'
		checkFail(c.modID, off: off, code: diag.errDivisionByZero, msg: diag.divisionByProvableZero(op), errs: errs)
		return ast.noType
	end 'byZero'
	if op == "shl" or op == "shr" 'shift'
		var shifted = l
		if lConst 'constLeft'
			shifted = p.builtins.anon64Ty
		end 'constLeft' else if not typeIsNamedInt(ms.types, reads: p.types, t: l) and not ast.isWordPattern(ms.types, reads: p.types, t: l) 'anonymousLeft'
			let word = wordOf(c, p: p, ms: ms, off: off, l: l, r: l, errs: errs)
			setOperand(c, node: e, operand: word)
			let computed = arithmetic(op, l: typeSpan(ms.types, reads: p.types, t: l), r: typeSpan(ms.types, reads: p.types, t: r), word: typeSpan(ms.types, reads: p.types, t: word))
			let exact = computed.span.clone()
			return exactType(p, ms: ms, word: word, lo: exact.lo, hi: exact.hi)
		end 'anonymousLeft'
		setOperand(c, node: e, operand: shifted)
		return shifted
	end 'shift'
	if op == "and" 'masked'
		let masked = maskedAlias(p, ms: ms, l: l, r: r)
		if masked != ast.noType and wordOf(c, p: p, ms: ms, off: off, l: l, r: r, errs: errs) != ast.noType 'fits'
			setOperand(c, node: e, operand: masked)
			return masked
		end 'fits'
	end 'masked'
	if isLogicalOp(op) 'bitwise'
		let t = unifyInts(c, p: p, ms: ms, off: off, clash: Clash.operator(op.clone()), l: l, r: r, errs: errs)
		if t != ast.noType 'unified'
			setOperand(c, node: e, operand: t)
		end 'unified'
		return t
	end 'bitwise'
	let word = operandWord(c, p: p, ms: ms, off: off, op: op, l: l, r: r, errs: errs)
	if word == ast.noType 'noWord'
		return ast.noType
	end 'noWord'
	let pattern = wordPatternOf(p, ms: ms, l: l, r: r)
	if pattern != ast.noType 'pattern'
		setOperand(c, node: e, operand: pattern)
		if typeHasKind(p, ms: ms, t: want, kind: ast.TypeKind.intRange) 'patternExpected'
			return want
		end 'patternExpected'
		return pattern
	end 'pattern'
	setOperand(c, node: e, operand: word)
	if typeHasKind(p, ms: ms, t: want, kind: ast.TypeKind.intRange) 'expected'
		return want
	end 'expected'
	let computed = arithmetic(op, l: typeSpan(ms.types, reads: p.types, t: l), r: typeSpan(ms.types, reads: p.types, t: r), word: typeSpan(ms.types, reads: p.types, t: word))
	let exact = computed.span.clone()
	return exactType(p, ms: ms, word: word, lo: exact.lo, hi: exact.hi)
end 'checkIntegerOp'

// maskedAlias is the alias of the one named operand of an 'and' whose other operand it does not hold, where it holds the
// result all the same: the bits of a non-negative operand bound the result to between 0 and that operand, whatever the
// other, so '(index + 1) and mask' is within the mask's alias. It is noType where that does not prove the alias holds the
// result, and the operands are typed as any other bitwise operator's.
function maskedAlias(p ast.Project, ms ast.ModuleState, l ast.TypeID, r ast.TypeID) returns ast.TypeID
	let lNamed = typeIsNamedInt(ms.types, reads: p.types, t: l)
	let rNamed = typeIsNamedInt(ms.types, reads: p.types, t: r)
	if lNamed == rNamed 'notOne'
		return ast.noType
	end 'notOne'
	var alias = r
	if lNamed 'left'
		alias = l
	end 'left'
	let lBounds = not rangeLo(ms.types, reads: p.types, t: l).isNeg()
	let rBounds = not rangeLo(ms.types, reads: p.types, t: r).isNeg()
	if not lBounds and not rBounds 'unbounded'
		return ast.noType
	end 'unbounded'
	var hi = rangeHi(ms.types, reads: p.types, t: l)
	if not lBounds or (rBounds and rangeHi(ms.types, reads: p.types, t: r).lt(hi)) 'right'
		hi = rangeHi(ms.types, reads: p.types, t: r)
	end 'right'
	if rangeLo(ms.types, reads: p.types, t: alias).gt(ast.I128.zero()) or hi.gt(rangeHi(ms.types, reads: p.types, t: alias)) 'outside'
		return ast.noType
	end 'outside'
	return alias
end 'maskedAlias'

// wordPatternOf is the bits(64) type that an arithmetic operation on the operand types l and r computes in, which wraps
// where another unsigned type fails, or noType where neither operand is one.
function wordPatternOf(p ast.Project, ms ast.ModuleState, l ast.TypeID, r ast.TypeID) returns ast.TypeID
	if ast.isWordPattern(ms.types, reads: p.types, t: l) 'left'
		return l
	end 'left'
	if ast.isWordPattern(ms.types, reads: p.types, t: r) 'right'
		return r
	end 'right'
	return ast.noType
end 'wordPatternOf'

function foldedType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, rightOff diag.U32, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let a = ast.typeEntry(ms.types, reads: p.types, t: l).minVal.clone()
	let b = ast.typeEntry(ms.types, reads: p.types, t: r).minVal.clone()
	match consumes foldOp(c, off: off, rightOff: rightOff, op: op, a: a, b: b, errs: errs) 'value'
		some(v) then return ast.internConstInt(ms.types, reads: p.types, val: v)
		none then return ast.noType
	end 'value'
end 'foldedType'

function checkComparison(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: e)
	if ast.isIntType(ms.types, reads: p.types, t: l) and ast.isIntType(ms.types, reads: p.types, t: r) 'integers'
		let word = operandWord(c, p: p, ms: ms, off: off, op: op, l: l, r: r, errs: errs)
		if word == ast.noType 'noWord'
			return ast.noType
		end 'noWord'
		setOperand(c, node: e, operand: word)
		return p.builtins.boolTy
	end 'integers'
	if typeHasKind(p, ms: ms, t: l, kind: ast.TypeKind.unionTy) or typeHasKind(p, ms: ms, t: r, kind: ast.TypeKind.unionTy) 'union'
		checkFail(c.modID, off: off, code: diag.errEnumNotComparable, msg: diag.unionNotComparable(op), errs: errs)
		return ast.noType
	end 'union'
	if l == r and l == p.builtins.characterTy 'characters'
		// Characters are equal and ordered by their bytes, maxon's Equatable and Comparable.
		setOperand(c, node: e, operand: l)
		return p.builtins.boolTy
	end 'characters'
	let equality = op == "==" or op == "!="
	if equality and l == r and (l == p.builtins.boolTy or l == p.builtins.stringTy or typeHasKind(p, ms: ms, t: l, kind: ast.TypeKind.enumTy) or typeHasKind(p, ms: ms, t: l, kind: ast.TypeKind.builtinSlotKey)) 'comparable'
		setOperand(c, node: e, operand: l)
		return p.builtins.boolTy
	end 'comparable'
	if l == r and typeHasKind(p, ms: ms, t: l, kind: ast.TypeKind.typeParam) 'parameter'
		setOperand(c, node: e, operand: l)
		return boundOperatorCall(c, p: p, ms: ms, e: e, op: op, param: l, errs: errs)
	end 'parameter'
	// Two Strings are equal by the built-in comparison above, and ordered by the compare of their Comparable conformance.
	if l == r and (l == p.builtins.stringTy or typeHasKind(p, ms: ms, t: l, kind: ast.TypeKind.record) or typeHasKind(p, ms: ms, t: l, kind: ast.TypeKind.builtinArray)) 'method'
		setOperand(c, node: e, operand: l)
		return methodOperatorCall(c, p: p, ms: ms, e: e, op: op, t: l, errs: errs)
	end 'method'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.comparisonTypeMismatch(gotName(p, ms: ms, t: l), right: gotName(p, ms: ms, t: r)), errs: errs)
	return ast.noType
end 'checkComparison'

function checkUnary(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let want = c.expect
	let op = ast.unaryExprOp(ms.tree(), id: e)
	let operand = ast.unaryExprE(ms.tree(), id: e)
	let t = checkExpr(c, p: p, ms: ms, e: operand, errs: errs)
	if t == ast.noType 'failed'
		return ast.noType
	end 'failed'
	setOperand(c, node: e, operand: t)
	let off = offsetOf(c, p: p, ms: ms, node: e)
	if op == "not" 'not'
		return checkNot(c, p: p, ms: ms, off: off, t: t, want: want, errs: errs)
	end 'not'
	if isConstInt(p, ms: ms, t: t) 'constant'
		return ast.internConstInt(ms.types, reads: p.types, val: ast.typeEntry(ms.types, reads: p.types, t: t).minVal.neg())
	end 'constant'
	if ast.isFloatType(ms.types, reads: p.types, t: t) 'float'
		return checkFloatNegation(p, ms: ms, t: t)
	end 'float'
	if typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.intRange) 'range'
		return checkNegation(c, p: p, ms: ms, off: off, t: t, want: want, errs: errs)
	end 'range'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "'-' needs an integer, found {nameOfType(p, ms: ms, t: t)}", errs: errs)
	return ast.noType
end 'checkUnary'

// checkNot gives a complement the operand's alias only where the alias is closed under it (a pattern, or a range that
// flipping maps onto itself), as maxon does; otherwise, like a negation, the type the context expects or the exact range
// of the flipped bits.
function checkNot(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, t ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if t == p.builtins.boolTy 'bool'
		return t
	end 'bool'
	if isConstInt(p, ms: ms, t: t) 'constant'
		return ast.internConstInt(ms.types, reads: p.types, val: ast.notWord(ast.typeEntry(ms.types, reads: p.types, t: t).minVal))
	end 'constant'
	if typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.intRange) 'range'
		let lo = rangeLo(ms.types, reads: p.types, t: t)
		let hi = rangeHi(ms.types, reads: p.types, t: t)
		var word = p.builtins.anon64Ty
		var flippedLo = hi.neg().sub(ast.I128.one())
		var flippedHi = lo.neg().sub(ast.I128.one())
		if ast.isUnsignedInt(ms.types, reads: p.types, t: t) 'unsigned'
			word = p.builtins.anonU64Ty
			flippedLo = ast.I128.u64Max().sub(hi)
			flippedHi = ast.I128.u64Max().sub(lo)
		end 'unsigned'
		if ast.typeEntry(ms.types, reads: p.types, t: t).bitsWidth != 0 or (flippedLo.eq(lo) and flippedHi.eq(hi)) 'closed'
			return t
		end 'closed'
		if typeHasKind(p, ms: ms, t: want, kind: ast.TypeKind.intRange) 'expected'
			return want
		end 'expected'
		return exactType(p, ms: ms, word: word, lo: flippedLo, hi: flippedHi)
	end 'range'
	checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.nonIntegralOperands("not", operand: gotName(p, ms: ms, t: t)), errs: errs)
	return ast.noType
end 'checkNot'

function checkNegation(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, t ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if ast.isWordPattern(ms.types, reads: p.types, t: t) 'pattern'
		return t
	end 'pattern'
	if ast.isUnsignedInt(ms.types, reads: p.types, t: t) 'unsigned'
		checkFail(c.modID, off: off, code: diag.errUnsignedNegation, msg: diag.unsignedNegation(nameOfType(p, ms: ms, t: t)), errs: errs)
		return ast.noType
	end 'unsigned'
	if typeHasKind(p, ms: ms, t: want, kind: ast.TypeKind.intRange) 'expected'
		return want
	end 'expected'
	let lo = ast.typeEntry(ms.types, reads: p.types, t: t).maxVal.neg()
	let hi = ast.typeEntry(ms.types, reads: p.types, t: t).minVal.neg()
	let word = p.builtins.anon64Ty
	return exactType(p, ms: ms, word: word, lo: lo, hi: hi)
end 'checkNegation'

function requireBool(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, keyword String, mutates errs diag.ErrorList) returns bool
	let t = checkExpr(c, p: p, ms: ms, e: e, errs: errs)
	if t == ast.noType 'failed'
		return false
	end 'failed'
	if t != p.builtins.boolTy 'notBool'
		checkFail(c.modID, off: exprOffset(c, p: p, ms: ms, node: e), code: diag.errTypeMismatch, msg: diag.nonBoolCondition(keyword, got: gotName(p, ms: ms, t: t)), errs: errs)
		return false
	end 'notBool'
	return true
end 'requireBool'

function checkCond(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let cond = ast.condExprCond(ms.tree(), id: e)
	let thenNode = ast.condExprThen(ms.tree(), id: e)
	let elseNode = ast.condExprElse(ms.tree(), id: e)
	let condTy = checkExpr(c, p: p, ms: ms, e: cond, errs: errs)
	if condTy == ast.noType 'badCond'
		return ast.noType
	end 'badCond'
	if condTy != p.builtins.boolTy 'notBool'
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errMatchTypeMismatch, msg: diag.ternaryNonBoolCondition(gotName(p, ms: ms, t: condTy)), errs: errs)
		return ast.noType
	end 'notBool'
	let expected = c.expect
	let thenTy = checkExpecting(c, p: p, ms: ms, e: thenNode, want: expected, errs: errs)
	if thenTy == ast.noType 'badThen'
		return ast.noType
	end 'badThen'
	let elseTy = checkExpecting(c, p: p, ms: ms, e: elseNode, want: expected, errs: errs)
	if elseTy == ast.noType 'badElse'
		return ast.noType
	end 'badElse'
	return joinTypes(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), clash: Clash.branches, a: thenTy, b: elseTy, errs: errs)
end 'checkCond'

function checkCast(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: e)
	let targetRef = ast.castExprTarget(ms.tree(), id: e)
	let operand = ast.castExprE(ms.tree(), id: e)
	let owner = c.owner
	let mark = errs.count()
	if ms.tree().kindOf(operand) == ast.NodeKind.castExpr 'chained'
		checkFail(c.modID, off: ms.tree().castKeywordStart(targetRef), code: diag.errCastOperandIsACast, msg: diag.castOperandIsACast(ast.typeRefName(ms.tree(), id: targetRef)), errs: errs)
		return ast.noType
	end 'chained'
	let bare = bareNumberName(p, ms: ms, tr: targetRef)
	if bare != "" 'bare'
		var message = diag.bareIntCast()
		if bare == "float" 'float'
			message = diag.bareFloatCast()
		end 'float'
		checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: targetRef), code: diag.errTypeMismatch, msg: message, errs: errs)
		return ast.noType
	end 'bare'
	let target = resolveTypeRef(c, p: p, ms: ms, tr: targetRef, selfTy: owner, errs: errs)
	if target == ast.noType 'badTarget'
		anchorUnknownTypes(c, mark: mark, at: ms.tree().castKeywordStart(targetRef), errs: errs)
		return ast.noType
	end 'badTarget'
	if typeHasKind(p, ms: ms, t: target, kind: ast.TypeKind.funcTy) 'function'
		return checkFunctionCast(c, p: p, ms: ms, e: e, operand: operand, target: target, errs: errs)
	end 'function'
	if typeHasKind(p, ms: ms, t: target, kind: ast.TypeKind.interfaceTy) 'interface'
		return checkInterfaceCast(c, p: p, ms: ms, e: e, operand: operand, target: target, errs: errs)
	end 'interface'
	if ast.isInterfaceHandle(ms.types, reads: p.types, t: target) 'interfaceHandle'
		return checkHandleCast(c, p: p, ms: ms, e: e, operand: operand, target: target, errs: errs)
	end 'interfaceHandle'
	if ast.familyOfSelf(ms.types, reads: p.types, t: target) != ast.noType 'ofFamily'
		return checkFamilyCast(c, p: p, ms: ms, e: e, operand: operand, target: target, errs: errs)
	end 'ofFamily'
	let toFloat = typeHasKind(p, ms: ms, t: target, kind: ast.TypeKind.floatRange)
	let toInt = typeHasKind(p, ms: ms, t: target, kind: ast.TypeKind.intRange)
	let numeric = toInt or toFloat
	var src = ast.noType
	if numeric 'number'
		src = checkExpr(c, p: p, ms: ms, e: operand, errs: errs)
	end 'number' else 'other'
		// A literal is written as the target, as at any place that expects the type.
		src = checkExpecting(c, p: p, ms: ms, e: operand, want: target, errs: errs)
	end 'other'
	if src == ast.noType 'badSource'
		return ast.noType
	end 'badSource'
	setOperand(c, node: e, operand: src)
	if typeHasKind(p, ms: ms, t: src, kind: ast.TypeKind.interfaceTy) 'recovered'
		return checkRecoveryCast(c, p: p, ms: ms, e: e, src: src, target: target, errs: errs)
	end 'recovered'
	if not numeric 'notNumber'
		// Every spelling of a type is that one type here, so a cast to the type the value has, or to one it retags to,
		// is the value itself.
		if retags(ms.types, reads: p.types, a: src, b: target) 'identity'
			return target
		end 'identity'
		if ast.typeEntry(ms.types, reads: p.types, t: target).typeArgs.count() > 0 and not ast.typeEntry(ms.types, reads: p.types, t: target).isTuple 'container'
			checkFailCaused(c.modID, off: off, code: diag.errCastTargetIsAContainer, msg: diag.castTargetIsAContainer(nameOfType(p, ms: ms, t: target), source: nameOfType(p, ms: ms, t: src)), cause: rawSurfaceCauseOfTypes(p, ms: ms, a: target, b: src), errs: errs)
			return ast.noType
		end 'container'
		if castTargetIsRefused(p, ms: ms, target: target) and not assignable(p, ms: ms, src: src, dst: target) 'refused'
			failCast(c, p: p, ms: ms, off: off, src: src, target: target, errs: errs)
			return ast.noType
		end 'refused'
		checkFail(c.modID, off: off, code: diag.errUnsupported, msg: "a cast to {nameOfType(p, ms: ms, t: target)} is not supported by minimaxon", errs: errs)
		return ast.noType
	end 'notNumber'
	if toFloat 'float'
		return checkFloatCast(c, p: p, ms: ms, off: off, src: src, target: target, errs: errs)
	end 'float'
	if ast.isFloatType(ms.types, reads: p.types, t: src) 'fromFloat'
		failCast(c, p: p, ms: ms, off: off, src: src, target: target, errs: errs)
		return ast.noType
	end 'fromFloat'
	if isConstInt(p, ms: ms, t: src) 'constant'
		let value = ast.typeEntry(ms.types, reads: p.types, t: src).minVal.clone()
		if not intRangeHolds(ms.types, reads: p.types, dst: target, v: value) 'doesNotFit'
			checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: valueOutOfRange(p, ms: ms, value: value.toString(), target: target), errs: errs)
			return ast.noType
		end 'doesNotFit'
		return target
	end 'constant'
	if typeHasKind(p, ms: ms, t: src, kind: ast.TypeKind.intRange) 'range'
		return target
	end 'range'
	failCast(c, p: p, ms: ms, off: off, src: src, target: target, errs: errs)
	return ast.noType
end 'checkCast'

// checkFamilyCast types a cast to the `Self` of a static function of an extension of a primitive family: a number of the
// family converts to it, and which type `Self` is, so which values fit, is known only to each instance, so the range analysis
// takes the conversion as one that can fail and the instance checks the value against its own range. A bool converts from
// nothing, as any cast to one is refused.
function checkFamilyCast(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, operand ast.NodeID, target ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let src = checkExpr(c, p: p, ms: ms, e: operand, errs: errs)
	if src == ast.noType 'badSource'
		return ast.noType
	end 'badSource'
	setOperand(c, node: e, operand: src)
	let family = ast.familyOfSelf(ms.types, reads: p.types, t: target)
	let fromInteger = family == p.builtins.anon64Ty and ast.isIntType(ms.types, reads: p.types, t: src)
	let fromNumber = family == p.builtins.anonFloatTy and isNumberType(p, ms: ms, t: src)
	if src == target or fromInteger or fromNumber 'converts'
		return target
	end 'converts'
	failCast(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), src: src, target: target, errs: errs)
	return ast.noType
end 'checkFamilyCast'

// checkFunctionCast casts a function value to another function type of its shape, which re-brands it, as in maxon: the
// value is the same closure. A closure written in the cast takes the target as the type it is written for.
function checkFunctionCast(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, operand ast.NodeID, target ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let src = checkExpecting(c, p: p, ms: ms, e: operand, want: target, errs: errs)
	if src == ast.noType 'badSource'
		return ast.noType
	end 'badSource'
	if not typeHasKind(p, ms: ms, t: src, kind: ast.TypeKind.funcTy) or not shapeFits(p, ms: ms, src: src, dst: target) 'shape'
		failCast(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), src: src, target: target, errs: errs)
		return ast.noType
	end 'shape'
	return target
end 'checkFunctionCast'

// anchorUnknownTypes moves the refusals of an unknown type that were reported since mark to at, where maxon reports the type of a cast: at its 'as'.
function anchorUnknownTypes(c Checker, mark Count, at diag.U32, mutates errs diag.ErrorList)
	for i in mark upto errs.count() 'each'
		if errs[i].code == diag.errUnknownType 'unknown'
			errs[i].site = diag.Site.make(c.modID, offset: at)
		end 'unknown'
	end 'each'
end 'anchorUnknownTypes'

// castTargetIsRefused is whether maxon refuses a cast to target, whatever the value: a type that no value is converted to.
function castTargetIsRefused(p ast.Project, ms ast.ModuleState, target ast.TypeID) returns bool
	return match kindOfType(p, ms: ms, t: target) 'k'
		primBool gives true
		primString gives true
		primCharacter gives true
		primCString gives true
		record gives true
		enumTy gives true
		unionTy gives true
		funcTy gives true
		invalid gives false
		primVoid gives false
		primNever gives false
		intRange gives false
		constInt gives false
		floatRange gives false
		constFloat gives false
		builtinArray gives false
		builtinSlotKey gives false
		builtinFrozen gives false
		builtinCown gives false
		builtinCursor gives false
		builtinGroups gives false
		builtinPromise gives false
		builtinReply gives false
		builtinService gives false
		typeParam gives false
		interfaceTy gives false
	end 'k'
end 'castTargetIsRefused'

// castKindWord is how maxon's messages about a cast name the type of a value: its kind, or the name of a named type.
function castKindWord(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	let name = nameOfType(p, ms: ms, t: t)
	return match kindOfType(p, ms: ms, t: t) 'k'
		invalid gives panic("a cast names a value that has no type")
		primBool gives "bool"
		primString gives "String"
		primCharacter gives "Character"
		primCString gives "cstring"
		primVoid gives name
		primNever gives name
		intRange gives "int" if typeIsAnonInt(ms.types, reads: p.types, t: t) else name
		constInt gives "int"
		floatRange gives "float" if typeIsAnonFloat(ms.types, reads: p.types, t: t) else name
		constFloat gives "float"
		record gives name
		enumTy gives "enum"
		unionTy gives "union"
		builtinArray gives name
		builtinSlotKey gives name
		builtinFrozen gives name
		builtinCown gives name
		builtinCursor gives name
		builtinGroups gives name
		builtinPromise gives name
		builtinReply gives name
		builtinService gives name
		typeParam gives name
		interfaceTy gives name
		funcTy gives "function"
	end 'k'
end 'castKindWord'

// castTargetWord is how maxon's messages about a cast name the type it converts to: the kind of the type.
function castTargetWord(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return match kindOfType(p, ms: ms, t: t) 'k'
		invalid gives panic("a cast names a target that has no type")
		primBool gives "bool"
		primString gives "String"
		primCharacter gives "Character"
		primCString gives "cstring"
		intRange gives "int"
		constInt gives "int"
		floatRange gives "float"
		constFloat gives "float"
		record gives "struct"
		funcTy gives "function"
		primVoid gives nameOfType(p, ms: ms, t: t)
		primNever gives nameOfType(p, ms: ms, t: t)
		enumTy gives nameOfType(p, ms: ms, t: t)
		unionTy gives nameOfType(p, ms: ms, t: t)
		builtinArray gives nameOfType(p, ms: ms, t: t)
		builtinSlotKey gives nameOfType(p, ms: ms, t: t)
		builtinFrozen gives nameOfType(p, ms: ms, t: t)
		builtinCown gives nameOfType(p, ms: ms, t: t)
		builtinCursor gives nameOfType(p, ms: ms, t: t)
		builtinGroups gives nameOfType(p, ms: ms, t: t)
		builtinPromise gives nameOfType(p, ms: ms, t: t)
		builtinReply gives nameOfType(p, ms: ms, t: t)
		builtinService gives nameOfType(p, ms: ms, t: t)
		typeParam gives nameOfType(p, ms: ms, t: t)
		interfaceTy gives nameOfType(p, ms: ms, t: t)
	end 'k'
end 'castTargetWord'

// failCast refuses a cast that has no conversion, with the words maxon uses for it.
export function failCast(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, src ast.TypeID, target ast.TypeID, mutates errs diag.ErrorList)
	let source = castKindWord(p, ms: ms, t: src)
	let tName = nameOfType(p, ms: ms, t: target)
	var msg = diag.invalidCast(source, target: castTargetWord(p, ms: ms, t: target))
	if kindOfType(p, ms: ms, t: target) == ast.TypeKind.enumTy 'toEnum'
		msg = diag.castFormsAValue(source, target: "enum '{tName}'", remedy: diag.castToEnumRemedy(tName))
	end 'toEnum' else if kindOfType(p, ms: ms, t: target) == ast.TypeKind.unionTy 'toUnion'
		msg = diag.castFormsAValue(source, target: "union '{tName}'", remedy: diag.castToUnionRemedy())
	end 'toUnion' else if kindOfType(p, ms: ms, t: target) == ast.TypeKind.funcTy and kindOfType(p, ms: ms, t: src) == ast.TypeKind.funcTy 'toFunction'
		msg = diag.functionShapeCast(tName, got: nameOfType(p, ms: ms, t: src))
	end 'toFunction'
	checkFail(c.modID, off: off, code: diag.errUnsafeCast, msg: msg, errs: errs)
end 'failCast'

function checkPanic(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let message = ast.panicExprMessage(ms.tree(), id: e)
	if checkExpr(c, p: p, ms: ms, e: message, errs: errs) == ast.noType 'failed'
		return ast.noType
	end 'failed'
	return p.builtins.neverTy
end 'checkPanic'

// checkTry types a try: the value of its expression, or on a failure the value 'otherwise' gives or the jump it makes. One
// that ignores a failure has no value, so it stands alone as a statement.
function checkTry(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let want = c.expect
	let guarded = ast.tryExprE(ms.tree(), id: e)
	let propagates = ast.propagates(ms.tree(), e: e)
	let alone = c.statement == e
	if propagates and c.tries.count() == 0 and defersHere(c, p: p, ms: ms) 'deferred'
		refuseDeferredThrow(c, p: p, ms: ms, node: e, errs: errs)
		return ast.noType
	end 'deferred'
	var errors = ast.TypeIDList.create(0)
	if not propagates 'catching'
		beginCatching(c)
	end 'catching'
	let result = checkExpecting(c, p: p, ms: ms, e: guarded, want: want, errs: errs)
	if not propagates 'caught'
		errors = endCatching(c)
	end 'caught'
	if result == ast.noType 'failed'
		return ast.noType
	end 'failed'
	let handler = ast.tryExprHandler(ms.tree(), id: e)
	if handler != 0 'handler'
		return checkTryHandler(c, p: p, ms: ms, e: e, result: result, errors: errors, alone: alone, errs: errs)
	end 'handler'
	if ast.tryExprIgnore(ms.tree(), id: e) 'ignore'
		if c.statement != e 'notAlone'
			failAt(c, p: p, ms: ms, node: e, code: diag.errErrorTypeMismatch, msg: diag.tryValueNeedsFallback(), errs: errs)
			return ast.noType
		end 'notAlone'
		return p.builtins.voidTy
	end 'ignore'
	let fallback = ast.tryFallback(ms.tree(), e: e)
	if fallback != 0 'value'
		let t = checkFallback(c, p: p, ms: ms, e: e, fallback: fallback, result: result, want: want, errs: errs)
		holdFallback(c, p: p, ms: ms, e: e, fallback: fallback, t: t, errs: errs)
		return t
	end 'value'
	checkTryJump(c, p: p, ms: ms, e: e, errs: errs)
	return result
end 'checkTry'

// holdFallback declares the local that holds the fallback of a try over a call that lends a managed place, where the
// fallback is a value made there (impliesFallbackLocal): the try lends it on a failure as it lends the place on a success,
// so the value lives in the local, which the enclosing block owns and ends, and nothing is copied on either path. The local
// is the fallback's node's, since a try's own is the error its handler binds.
function holdFallback(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, fallback ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList)
	if t == ast.noType 'failed'
		return
	end 'failed'
	let inner = ast.through(ms.tree(), e: ast.tryExprE(ms.tree(), id: e))
	if ms.tree().kindOf(inner) != ast.NodeKind.callExpr or not ast.isProjectionCall(c.typing, call: inner) or not ast.isManagedType(ms.types, reads: p.types, t: t) 'value'
		return
	end 'value'
	c.typing.lentTries.insert(e as Count, value: true)
	if not impliesFallbackLocal(c, ms: ms, fallback: fallback) 'none'
		return
	end 'none'
	pushScope(c)
	let local = declareLocal(c, p: p, ms: ms, name: "'fallback", t: t, isVar: false, definedAt: e, off: offsetOf(c, p: p, ms: ms, node: fallback), errs: errs)
	popScope(c)
	if local != ast.noLocal 'declared'
		c.typing.nodeLocals.insert(fallback as Count, value: local)
	end 'declared'
end 'holdFallback'

// impliesFallbackLocal is whether a fallback is a value made where the try is, which a local must hold for the try to lend
// it: not a place (a name, a field, an element, the place a call lends), whose own owner it borrows, nor a String literal
// with no parts, which is static.
function impliesFallbackLocal(c Checker, ms ast.ModuleState, fallback ast.NodeID) returns bool
	let n = ast.through(ms.tree(), e: fallback)
	let k = ms.tree().kindOf(n)
	if k == ast.NodeKind.nameExpr or k == ast.NodeKind.memberExpr or k == ast.NodeKind.indexExpr or k == ast.NodeKind.panicExpr 'place'
		return false
	end 'place'
	if k == ast.NodeKind.callExpr and ast.isProjectionCall(c.typing, call: n) 'lent'
		return false
	end 'lent'
	return not (k == ast.NodeKind.strLit and ms.tree().strIsPlain(ast.strLitPartsRef(ms.tree(), id: n)))
end 'impliesFallbackLocal'

// checkTryHandler types the block handler of a try: it runs on a failure, binding the error when it names it. A handler that
// leaves gives the try its expression's value; one that runs off its end gives none, so the try stands alone as a statement.
function checkTryHandler(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, result ast.TypeID, errors ast.TypeIDList, alone bool, mutates errs diag.ErrorList) returns ast.TypeID
	if c.fn == ast.noFunc 'noFunction'
		failAt(c, p: p, ms: ms, node: e, code: diag.errUnexpectedToken, msg: "a constant or a default is in no function to run a handler block in: give 'otherwise' the value to use", errs: errs)
		return ast.noType
	end 'noFunction'
	let falls = ast.tryHandlerFallsThrough(ms.tree(), e: e)
	let want = c.expect
	let statement = c.statement
	let body = ast.handlerBlockBodyRef(ms.tree(), id: ast.tryExprHandler(ms.tree(), id: e))
	let binding = ast.tryBinding(ms.tree(), e: e)
	pushScope(c)
	if binding == "" 'anonymous'
		checkStmts(c, p: p, ms: ms, body: body, errs: errs)
	end 'anonymous' else 'named'
		checkHandlerBinding(c, p: p, ms: ms, s: e, binding: binding, errors: errors, body: body, requireMatch: false, errs: errs)
	end 'named'
	popScope(c)
	c.statement = statement
	c.expect = want
	if not falls 'leaves'
		return result
	end 'leaves'
	if not alone 'notAlone'
		failAt(c, p: p, ms: ms, node: e, code: diag.errErrorTypeMismatch, msg: diag.tryValueNeedsFallback(), errs: errs)
		return ast.noType
	end 'notAlone'
	return p.builtins.voidTy
end 'checkTryHandler'

// checkTryJump types the statement that a try with no value makes on a failure.
function checkTryJump(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList)
	let ret = ast.tryExprRet(ms.tree(), id: e)
	if ret != 0 'return'
		if c.fn == ast.noFunc 'noFunction'
			failAt(c, p: p, ms: ms, node: ret, code: diag.errUnexpectedToken, msg: "a constant or a default is in no function to return from: give 'otherwise' the value to use", errs: errs)
			return
		end 'noFunction'
		checkReturn(c, p: p, ms: ms, s: ret, errs: errs)
		return
	end 'return'
	let brk = ast.tryExprBrk(ms.tree(), id: e)
	if brk != 0 'break'
		checkJump(c, p: p, ms: ms, s: brk, isBreak: true, errs: errs)
		return
	end 'break'
	let cont = ast.tryExprCont(ms.tree(), id: e)
	if cont != 0 'continue'
		checkJump(c, p: p, ms: ms, s: cont, isBreak: false, errs: errs)
		return
	end 'continue'
	let thr = ast.tryExprThr(ms.tree(), id: e)
	if thr != 0 'throw'
		checkThrow(c, p: p, ms: ms, s: thr, errs: errs)
	end 'throw'
end 'checkTryJump'

function checkFallback(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, fallback ast.NodeID, result ast.TypeID, want ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	// A literal fallback is a value of the alias the call returns, as in maxon, so one outside its range is refused. Any
	// other integer fallback with no type to take is joined with the result as a conditional's branches are, rather than
	// computed in the result's alias, which it need not fit.
	var expected = want
	if expected == ast.noType and not typeHasKind(p, ms: ms, t: result, kind: ast.TypeKind.intRange) 'noExpectation'
		expected = result
	end 'noExpectation'
	let other = checkExpecting(c, p: p, ms: ms, e: fallback, want: expected, errs: errs)
	if other == ast.noType 'failed'
		return ast.noType
	end 'failed'
	if typeIsNamedInt(ms.types, reads: p.types, t: result) and isConstInt(p, ms: ms, t: other) and fallbackIsPlainLiteral(p, ms: ms, c: c, fallback: fallback) 'literal'
		let value = ast.typeEntry(ms.types, reads: p.types, t: other).minVal.clone()
		if not intRangeHolds(ms.types, reads: p.types, dst: result, v: value) 'doesNotFit'
			failAt(c, p: p, ms: ms, node: e, code: diag.errTypeMismatch, msg: otherwiseValueOutOfRange(p, ms: ms, value: value.toString(), target: result), errs: errs)
			return ast.noType
		end 'doesNotFit'
	end 'literal'
	return joinTypes(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: fallback), clash: Clash.other, a: result, b: other, errs: errs)
end 'checkFallback'

// fallbackIsPlainLiteral is whether a fallback is an integer literal, negated or not: the only fallback that maxon holds to
// the alias of the call's result.
function fallbackIsPlainLiteral(p ast.Project, ms ast.ModuleState, c Checker, fallback ast.NodeID) returns bool
	var literal = fallback
	if ms.tree().kindOf(fallback) == ast.NodeKind.unaryExpr and ast.unaryExprOp(ms.tree(), id: fallback) == "-" 'negated'
		literal = ast.unaryExprE(ms.tree(), id: fallback)
	end 'negated'
	return ms.tree().kindOf(literal) == ast.NodeKind.intLit
end 'fallbackIsPlainLiteral'
