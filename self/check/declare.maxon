// cloneMethod is the name of the deep copy that every type has.
let cloneMethod = "clone"

// entryFunction is the function a program starts in.
let entryFunction = "main"

// enumWord and unionWord are how a message names the kind of a type that has cases.
let enumWord = "enum"

let unionWord = "union"

// A phase of the declare stage stops at its first error: each step that can fail compares the error count with the mark it took at the start.
function failedSince(errs diag.ErrorList, mark Count) returns bool
	return errs.count() > mark
end 'failedSince'

function offsetOf(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID) returns diag.U32
	return ms.tree().reportStartOf(node)
end 'offsetOf'

// exprOffset is where an expression starts, which is where maxon points for a value that is not what its place needs.
function exprOffset(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID) returns diag.U32
	return try ast.exprStart(ms.tree(), e: node) as diag.U32 otherwise panic("an expression starts past the end of its module")
end 'exprOffset'

// braceOffset is where the brace of a struct literal opens, which is where maxon reports a field it leaves out: the
// layout puts the brace right after the type name.
function braceOffset(c Checker, p ast.Project, ms ast.ModuleState, literal ast.NodeID) returns diag.U32
	return try ms.tree().startOf(literal) + (ast.structLitExprTypeName(ms.tree(), id: literal).byteLength() as diag.U32) otherwise panic("a struct literal ends past its module")
end 'braceOffset'

// closingOffset is where the parenthesis closing a call stands, which is where maxon reports the payload that a union case
// is given of the wrong type.
function closingOffset(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID) returns diag.U32
	match ast.exprEnd(ms.tree(), e: call) 'end'
		some(finish) then return try (finish - 1) as diag.U32 otherwise panic("a call ends past its module")
		none then return exprOffset(c, p: p, ms: ms, node: call)
	end 'end'
end 'closingOffset'

// placeOffset is where maxon points for an assignment to a place: a field at its name, any other place at its start.
function placeOffset(c Checker, p ast.Project, ms ast.ModuleState, place ast.NodeID) returns diag.U32
	if ms.tree().kindOf(place) == ast.NodeKind.memberExpr 'field'
		return offsetOf(c, p: p, ms: ms, node: place)
	end 'field'
	return exprOffset(c, p: p, ms: ms, node: place)
end 'placeOffset'

function declTypeOf(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns ast.TypeID
	match ast.declType(p, ms: ms, ref: ref) 'dt'
		some(tid) then return tid
		none then _ = 0
	end 'dt'
	panic("the declaration at ordinal {ref.ordinal} of module {ref.module} has no type")
end 'declTypeOf'

// typeParamOfNode is the type of the type parameter that a node of the module declares.
function typeParamOfNode(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID) returns ast.TypeID
	match ast.paramType(p, ms: ms, module: c.modID, node: node) 'tp'
		some(tid) then return tid
		none then _ = 0
	end 'tp'
	panic("the type parameter at node {node} of module {c.modID} is not declared")
end 'typeParamOfNode'

// boundedParamOf is the type that a 'where' constraint bounds: the one its parameter name resolved to.
function boundedParamOf(c Checker, p ast.Project, ms ast.ModuleState, cs ast.Constraint) returns ast.TypeID
	match ast.resolutionOf(p, ms: ms).typeParamSlots.get(cs.id as Count) 'slot'
		some(slot) then return typeParamOfNode(c, p: p, ms: ms, node: ast.resolutionOf(p, ms: ms).typeParams[slot].id)
		none then _ = 0
	end 'slot'
	panic("the constraint at node {cs.id} of module {c.modID} names no type parameter")
end 'boundedParamOf'

// paramNamed is the shell parameter of a generic declaration that a declared parameter has, found by its name because
// the shells leave out a parameter that repeats one.
function paramNamed(p ast.Project, ms ast.ModuleState, owner ast.TypeID, name String) returns table.Option with ast.TypeID
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: owner).typeParams.count() 'each'
		let tid = ast.typeEntry(ms.types, reads: p.types, t: owner).typeParams[i]
		if ast.typeEntry(ms.types, reads: p.types, t: tid).name == name 'hit'
			return table.Option.some(tid)
		end 'hit'
	end 'each'
	return table.Option.none
end 'paramNamed'

// repeatsEarlier is whether the name at index is one of the names before it.
function repeatsEarlier(names ast.StringList, index Count) returns bool
	for j in 0 upto index 'prev'
		if names[j] == names[index] 'dup'
			return true
		end 'dup'
	end 'prev'
	return false
end 'repeatsEarlier'

// declareBounds gives each type parameter the bounds its declaration's constraints name. A bound is a handle to an
// interface, so it needs nothing from the interface's own declaration.
function declareBounds(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, constraints ast.ConstraintList, mutates errs diag.ErrorList)
	let mark = errs.count()
	for i in 0 upto constraints.count() 'each'
		let cs = constraints[i].clone()
		let constrained = boundedParamOf(c, p: p, ms: ms, cs: cs)
		for bi in 0 upto ms.tree().listLen(cs.bounds) 'bounds'
			let iface = resolveBoundTypeRef(c, p: p, ms: ms, tr: ms.tree().listAt(cs.bounds, index: bi) as ast.NodeID, isBound: true, selfTy: ast.noType, errs: errs)
			if failedSince(errs, mark: mark) 'failed'
				return
			end 'failed'
			ms.types.lists[ast.typeList(ms.types, t: constrained)][ast.typeIndex(ms.types, t: constrained)].bounds.push(ast.ParamBound.make(constrained, ifaceTy: iface))
			declareImpliedBounds(p, ms: ms, owner: constrained, iface: iface)
		end 'bounds'
	end 'each'
end 'declareBounds'

// declareImpliedBounds gives each type parameter that a bound of owner binds to an associated type of the interface the
// bounds that the interface's 'where' states for that associated type: 'S implements Iterable with (E, I)' gives I the bound
// 'Iterator with E' of Iterable's 'where Iter implements Iterator with Element', which every conformance meets.
function declareImpliedBounds(p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, iface ast.TypeID)
	let orig = ast.originOf(ms.types, reads: p.types, t: iface)
	if ast.typeKind(ms.types, reads: p.types, t: orig) != ast.TypeKind.interfaceTy 'notInterface'
		return
	end 'notInterface'
	let associated = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: orig).typeParams)
	let bound = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: iface).typeArgs)
	if associated.count() != bound.count() 'unbound'
		return
	end 'unbound'
	let params = requirementParams(p, ms: ms, iface: orig)
	let args = requirementArgs(p, ms: ms, iface: iface, own: owner)
	for k in 0 upto associated.count() 'each'
		let held = bound[k]
		if ast.typeKind(ms.types, reads: p.types, t: held) != ast.TypeKind.typeParam or held == owner 'notParam'
			continue 'each'
		end 'notParam'
		let stated = ast.typeEntry(ms.types, reads: p.types, t: associated[k]).bounds.clone()
		for b in 0 upto stated.count() 'bounds'
			let implied = ast.substituteType(ms.types, reads: p.types, t: stated[b].ifaceTy, params: params, args: args)
			ms.types.lists[ast.typeList(ms.types, t: held)][ast.typeIndex(ms.types, t: held)].bounds.push(ast.ParamBound.make(held, ifaceTy: implied))
		end 'bounds'
	end 'each'
end 'declareImpliedBounds'

// declareFunctionTypeParams gives a function its type parameters, and each parameter the bounds the function's
// constraints name. The parameters of a type and of a union were made with its shell, and only get their bounds.
function declareFunctionTypeParams(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, params ast.TypeParamList, constraints ast.ConstraintList, mutates generics ast.TypeIDList, mutates errs diag.ErrorList)
	var names = ast.StringList.create(0)
	for i in 0 upto params.count() 'names'
		names.push(params[i].name.clone())
	end 'names'
	for i in 0 upto params.count() 'each'
		if repeatsEarlier(names, index: i) 'dup'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: params[i].id), code: diag.errDuplicateDefinition, msg: "type parameter '{params[i].name}' is declared twice", errs: errs)
			return
		end 'dup'
		let tid = ast.allocType(ms.types, module: c.modID, e: ast.TypeEntry.make(ast.TypeKind.typeParam, name: params[i].name.clone()))
		ast.setParamType(ms, module: c.modID, node: params[i].id, t: tid)
		generics.push(tid)
	end 'each'
	declareBounds(c, p: p, ms: ms, constraints: constraints, errs: errs)
end 'declareFunctionTypeParams'

// declareNominalTypeParams registers the parameters of the shell of a type or a union as what their nodes declare, then
// gives them their bounds. A parameter that repeats one is refused where the shell is made.
function declareNominalTypeParams(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, params ast.TypeParamList, constraints ast.ConstraintList, mutates errs diag.ErrorList)
	for i in 0 upto params.count() 'each'
		match paramNamed(p, ms: ms, owner: owner, name: params[i].name) 'shell'
			some(tid) then ast.setParamType(ms, module: c.modID, node: params[i].id, t: tid)
			none then panic("the shell of '{ast.typeEntry(ms.types, reads: p.types, t: owner).name}' has no type parameter '{params[i].name}'")
		end 'shell'
	end 'each'
	declareBounds(c, p: p, ms: ms, constraints: constraints, errs: errs)
end 'declareNominalTypeParams'

// declareInterfaceTypeParams declares the associated types of an interface and the bounds its 'where' states. One that the
// 'where' bounds may be bound to a type that holds a borrow (README, "Borrowing values"): an iterator that a collection
// makes, whose code an extension of the interface reaches only through the bound.
function declareInterfaceTypeParams(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, ifd ast.InterfaceDecl, mutates errs diag.ErrorList)
	declareNominalTypeParams(c, p: p, ms: ms, owner: owner, params: ifd.typeParams, constraints: ifd.whereList, errs: errs)
	let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: owner).typeParams)
	for i in 0 upto params.count() 'each'
		if ast.typeEntry(ms.types, reads: p.types, t: params[i]).bounds.count() > 0 'bounded'
			ms.types.lists[ast.typeList(ms.types, t: params[i])][ast.typeIndex(ms.types, t: params[i])].mayBorrow = true
		end 'bounded'
	end 'each'
end 'declareInterfaceTypeParams'

function optOutAdvice(p ast.Project, iface ast.TypeID) returns String
	if iface == p.builtins.copyableTy 'copy'
		return ", and write 'is noncopyable' after the name to opt out"
	end 'copy'
	return ""
end 'optOutAdvice'

// declareConforms records the interfaces that a declaration implements. Copyable and Droppable are no interface to
// implement, since every type has them unless it opts out or holds a part that lacks them.
function declareConforms(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, interfaces diag.U32, nt ast.TypeID, mutates errs diag.ErrorList)
	let named = conformedInterfaces(c, p: p, ms: ms, interfaces: interfaces, capabilities: false, selfTy: nt, errs: errs)
	for i in 0 upto named.count() 'each'
		let bound = boundBySiblings(p, ms: ms, iface: named[i], named: named)
		ms.types.lists[ast.typeList(ms.types, t: nt)][ast.typeIndex(ms.types, t: nt)].conforms.push(bound)
	end 'each'
end 'declareConforms'

// boundBySiblings is the interface iface, named without its associated types in a clause that names others, at the types
// that another interface of the clause binds them to: an associated type that iface inherits from an interface it extends,
// which `implements Cursor with Pos, BiCursor` binds through Cursor, as maxon searches the clause for it. iface is left as
// it is named where it binds its associated types or where the clause does not bind each one.
function boundBySiblings(p ast.Project, mutates ms ast.ModuleState, iface ast.TypeID, named ast.TypeIDList) returns ast.TypeID
	let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: iface).typeParams)
	if params.count() == 0 or ast.typeEntry(ms.types, reads: p.types, t: iface).typeArgs.count() > 0 'bound'
		return iface
	end 'bound'
	var args = ast.TypeIDList.create(0)
	for i in 0 upto params.count() 'params'
		let binding = siblingBinding(p, ms: ms, iface: iface, param: params[i], named: named)
		if binding == ast.noType 'unbound'
			return iface
		end 'unbound'
		args.push(binding)
	end 'params'
	return ast.instantiateType(ms.types, reads: p.types, origin: iface, args: args)
end 'boundBySiblings'

// siblingBinding is what an interface of named other than iface binds the associated type param to, or none.
function siblingBinding(p ast.Project, ms ast.ModuleState, iface ast.TypeID, param ast.TypeID, named ast.TypeIDList) returns ast.TypeID
	for j in 0 upto named.count() 'siblings'
		let sibling = ast.originOf(ms.types, reads: p.types, t: named[j])
		let args = ast.typeEntry(ms.types, reads: p.types, t: named[j]).typeArgs.clone()
		let params = ast.typeEntry(ms.types, reads: p.types, t: sibling).typeParams.clone()
		if sibling != iface and args.count() == params.count() 'binds'
			for k in 0 upto params.count() 'each'
				if params[k] == param 'hit'
					return args[k]
				end 'hit'
			end 'each'
		end 'binds'
	end 'siblings'
	return ast.noType
end 'siblingBinding'

// conformedInterfaces are the interfaces a declaration or an extension names after 'implements', or an interface after
// 'extends', up to the first that is not one. Only an interface names a capability, which every type that implements it
// then has, so that each value of it has it too. selfTy is the type that names them, whose type parameters a generic
// written bare among their arguments binds by name (boundByName).
function conformedInterfaces(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, interfaces diag.U32, capabilities bool, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeIDList
	var named = ast.TypeIDList.create(0)
	let mark = errs.count()
	for i in 0 upto ms.tree().listLen(interfaces) 'each'
		let tr = ms.tree().listAt(interfaces, index: i) as ast.NodeID
		let iface = resolveBoundTypeRef(c, p: p, ms: ms, tr: tr, isBound: false, selfTy: selfTy, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return named
		end 'failed'
		if p.builtins.isCapability(iface) and not capabilities 'capability'
			let name = ast.typeEntry(ms.types, reads: p.types, t: iface).name.clone()
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: tr), code: diag.errCapabilityMisuse, msg: "'{name}' is not implemented by saying so: every type has it unless it opts out or holds a part that lacks it; remove it from 'implements'{optOutAdvice(p, iface: iface)}", errs: errs)
			continue 'each'
		end 'capability'
		named.push(iface)
	end 'each'
	return named
end 'conformedInterfaces'

// paramSpecs resolves a parameter list, which a function and an interface's method are both written with. It stops at
// the first error.
function paramSpecs(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, params ast.ParamList, selfTy ast.TypeID, mutates specs ast.ParamSpecList, mutates errs diag.ErrorList)
	let mark = errs.count()
	var names = ast.StringList.create(0)
	for i in 0 upto params.count() 'names'
		names.push(params[i].name.clone())
	end 'names'
	for i in 0 upto params.count() 'each'
		let prm = params[i].clone()
		let conv = ast.parseConvention(prm.convention)
		let off = offsetOf(c, p: p, ms: ms, node: prm.id)
		if prm.name == "_" and conv == ast.Convention.convSets 'anonymousSets'
			checkFail(c.modID, off: off, code: diag.errSetNotInitialized, msg: "a 'sets' parameter must be named, so the function can initialise it", errs: errs)
			return
		end 'anonymousSets'
		if prm.name != "_" and repeatsEarlier(names, index: i) 'dup'
			checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: "parameter '{prm.name}' is declared twice", errs: errs)
			return
		end 'dup'
		let t = resolveTypeRef(c, p: p, ms: ms, tr: prm.typeRef, selfTy: selfTy, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return
		end 'failed'
		if prm.defaultRef != 0 and ast.isByAddress(conv) 'byAddress'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: prm.defaultRef), code: diag.errUnsupportedFeature, msg: "Unsupported: a default value on the {conv.keyword()} parameter '{prm.name}': it passes a place of the caller's, which a default is not", errs: errs)
			return
		end 'byAddress'
		specs.push(ast.ParamSpec.withDefault(prm.name.clone(), ty: t, conv: conv, defaultExpr: prm.defaultRef))
	end 'each'
end 'paramSpecs'

// returnOf is the type a function returns, which is void where it writes none.
function returnOf(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, returnsRef ast.NodeID, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if returnsRef == 0 'none'
		return p.builtins.voidTy
	end 'none'
	return resolveTypeRef(c, p: p, ms: ms, tr: returnsRef, selfTy: selfTy, errs: errs)
end 'returnOf'

// errorOf is the error a function's 'throws' names, or none for a function that throws nothing. An error is an enum, whose
// case comes back from a call in a register, or a union, whose box does. A clause that names neither is refused at the
// function's name, as maxon does.
function errorOf(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, site ast.NodeID, throwsRef ast.NodeID, specs ast.ParamSpecList, mutates errs diag.ErrorList) returns ast.TypeID
	if throwsRef == 0 'none'
		return ast.noType
	end 'none'
	let off = offsetOf(c, p: p, ms: ms, node: site)
	var unresolved = diag.ErrorList.create(0)
	var t = ast.noType
	if not ast.typeRefIsTuple(ms.tree(), id: throwsRef) 'named'
		t = resolveNamedTypeRef(c, p: p, ms: ms, tr: throwsRef, selfTy: ast.noType, errs: unresolved)
	end 'named'
	if t == ast.noType 'unresolved'
		checkFail(c.modID, off: off, code: diag.errThrowsNotAnErrorEnum, msg: diag.throwsNamesNoError(ast.typeRefName(ms.tree(), id: throwsRef)), errs: errs)
		return ast.noType
	end 'unresolved'
	if ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.interfaceTy 'interface'
		checkFail(c.modID, off: off, code: diag.errThrowsNotAnErrorEnum, msg: diag.throwsNamesAnInterface(ast.typeName(ms.types, reads: p.types, t: t)), errs: errs)
		return ast.noType
	end 'interface'
	if not ast.isErrorType(ms.types, reads: p.types, t: t) 'notError'
		checkFail(c.modID, off: off, code: diag.errThrowsNotAnErrorEnum, msg: diag.throwsNamesNoError(ast.typeName(ms.types, reads: p.types, t: t)), errs: errs)
		return ast.noType
	end 'notError'
	for i in 0 upto specs.count() 'each'
		if specs[i].conv == ast.Convention.convSets 'sets'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: throwsRef), code: diag.errThrows, msg: "a failure would leave the 'sets' parameter '{specs[i].name}' set or not, which its caller cannot tell: return the value instead, or catch the failures in the function", errs: errs)
			return ast.noType
		end 'sets'
	end 'each'
	return t
end 'errorOf'

// declareSignature records a method of an interface as the function entry its signature describes.
function declareSignature(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, it ast.TypeID, m ast.FuncSig, mutates errs diag.ErrorList)
	let off = offsetOf(c, p: p, ms: ms, node: m.id)
	if m.name == cloneMethod 'clone'
		if not requiresBuiltinClone(c, p: p, ms: ms, it: it, m: m) 'other'
			checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: "'{cloneMethod}' is built in for every type; name the method something else", errs: errs)
			return
		end 'other'
		// The built-in clone() of a Copyable type is the method, so the interface asks its conformers to be Copyable.
		if not ast.reachesInterface(ms.types, reads: p.types, have: it, want: p.builtins.copyableTy) 'copyable'
			ms.types.lists[ast.typeList(ms.types, t: it)][ast.typeIndex(ms.types, t: it)].conforms.push(p.builtins.copyableTy)
		end 'copyable'
		return
	end 'clone'
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: it).sigs.count() 'each'
		let sig = ast.typeEntry(ms.types, reads: p.types, t: it).sigs[i]
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).name == m.name 'exists'
			checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: diag.duplicateRequirement(m.name, interfaceName: ast.typeEntry(ms.types, reads: p.types, t: it).name), errs: errs)
			return
		end 'exists'
	end 'each'
	var fn = ast.FuncEntry.make(m.name.clone(), visibility: "", module: c.modID, nodeID: m.id)
	fn.selfConv = ast.parseConvention(m.receiver)
	fn.isStatic = m.isStatic
	fn.hasReceiver = not m.isStatic
	fn.ownerTy = it
	let selfTy = ast.typeEntry(ms.types, reads: p.types, t: it).selfParam
	let mark = errs.count()
	paramSpecs(c, p: p, ms: ms, params: m.params, selfTy: selfTy, specs: fn.params, errs: errs)
	if failedSince(errs, mark: mark) 'badParams'
		return
	end 'badParams'
	for i in 0 upto fn.params.count() 'types'
		fn.paramTypes.push(fn.params[i].ty)
	end 'types'
	fn.retTy = returnOf(c, p: p, ms: ms, returnsRef: m.returnsRef, selfTy: selfTy, errs: errs)
	if failedSince(errs, mark: mark) 'badReturn'
		return
	end 'badReturn'
	fn.errTy = errorOf(c, p: p, ms: ms, site: m.id, throwsRef: m.throwsRef, specs: fn.params, errs: errs)
	if failedSince(errs, mark: mark) 'badThrows'
		return
	end 'badThrows'
	fn.result = ast.parseResultConv(m.resultMode)
	if refusesBorrowedThrows(c, off: off, name: m.name, result: fn.result, err: fn.errTy, errs: errs) 'borrowedThrows'
		return
	end 'borrowedThrows'
	ms.types.lists[ast.typeList(ms.types, t: it)][ast.typeIndex(ms.types, t: it)].sigs.push(ast.allocFunc(ms.funcs, module: c.modID, f: fn))
end 'declareSignature'

// refusesBorrowedThrows refuses a function or a requirement that returns a borrowed place and throws: a failure leaves a
// borrowed result with no place to lend, and the caller's try would need a fallback place.
function refusesBorrowedThrows(c Checker, off diag.U32, name String, result ast.ResultConv, err ast.TypeID, mutates errs diag.ErrorList) returns bool
	if result != ast.ResultConv.resultBorrowed or err == ast.noType 'fine'
		return false
	end 'fine'
	checkFail(c.modID, off: off, code: diag.errUnsupported, msg: "'{name}' returns a borrowed place and throws, which is not supported yet; let the caller test first and remove 'throws', or return a value: 'returns T'", errs: errs)
	return true
end 'refusesBorrowedThrows'

// requiresBuiltinClone is whether the requirement m of the interface it is `function clone() returns Self`, which the
// built-in clone() of every Copyable type meets, as maxon's Cloneable is met by the clone() its compiler generates.
function requiresBuiltinClone(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, it ast.TypeID, m ast.FuncSig) returns bool
	if m.isStatic or m.receiver != "" or m.params.count() != 0 or m.throwsRef != 0 or m.returnsRef == 0 or ast.parseResultConv(m.resultMode) != ast.ResultConv.resultOwned 'shape'
		return false
	end 'shape'
	var unresolved = diag.ErrorList.create(0)
	let selfTy = ast.typeEntry(ms.types, reads: p.types, t: it).selfParam
	return resolveTypeRef(c, p: p, ms: ms, tr: m.returnsRef, selfTy: selfTy, errs: unresolved) == selfTy and unresolved.count() == 0
end 'requiresBuiltinClone'

// typeNamed is the type that a name written as an expression names, or none if it names no type. A generic type names
// its declaration, which only a call or a case that infers the arguments accepts; requireInstance refuses it anywhere
// else. A typealias of an instance names the instance. It reports why a 'Self' outside a type names none.
function typeNamed(c Checker, p ast.Project, ms ast.ModuleState, name ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let spelling = ast.nameExprName(ms.tree(), id: name)
	if spelling == "Self" 'selfName'
		if c.owner == ast.noType 'noOwner'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: name), code: diag.errUnknownType, msg: "'Self' names a type only inside one", errs: errs)
		end 'noOwner'
		return c.owner
	end 'selfName'
	if lookupLocal(c, name: spelling) != ast.noLocal 'local'
		return ast.noType
	end 'local'
	let rt = selfRecord(c, p: p, ms: ms)
	if rt != ast.noType and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: rt)).findField(spelling).isSome() 'field'
		return ast.noType
	end 'field'
	let named = match consumes ast.nodeDecl(p, ms: ms, node: name as Count) 'bound'
		some(ref) gives nominalTypeOf(p, ms: ms, ref: ref)
		none gives ast.noType
	end 'bound'
	if named != ast.noType and refusesRawType(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: name), t: named, errs: errs) 'raw'
		return ast.noType
	end 'raw'
	return named
end 'typeNamed'

function nominalTypeOf(p ast.Project, ms ast.ModuleState, consumes ref ast.DeclRef) returns ast.TypeID
	match ast.declType(p, ms: ms, ref: ref) 'dt'
		some(tid) then return nominalOrNone(p, ms: ms, t: tid)
		none then return ast.noType
	end 'dt'
end 'nominalTypeOf'

function nominalOrNone(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	if typeIsNominal(ms.types, reads: p.types, t: t) 'nominal'
		return t
	end 'nominal'
	return ast.noType
end 'nominalOrNone'

// requireInstance refuses a generic declaration where a type is needed and no call can infer its arguments.
function requireInstance(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, nt ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if ast.typeEntry(ms.types, reads: p.types, t: nt).typeParams.count() > 0 'generic'
		var names = ast.StringList.create(0)
		for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: nt).typeParams.count() 'params'
			names.push(ast.typeEntry(ms.types, reads: p.types, t: ast.typeEntry(ms.types, reads: p.types, t: nt).typeParams[i]).name.clone())
		end 'params'
		let tName = ast.typeEntry(ms.types, reads: p.types, t: nt).name.clone()
		checkFailCaused(c.modID, off: off, code: diag.errTypeArgumentCount, msg: "'{tName}' is generic: name an instance with a typealias, as 'typealias Name = {ast.instanceSpelling(tName, args: names)}'", cause: diag.rawSurfaceCause(tName), errs: errs)
	end 'generic'
	return nt
end 'requireInstance'

// defaultHead is the name that heads a default value written as a member or a call of one, or none.
function defaultHead(tree ast.Tree, e ast.NodeID) returns ast.NodeID
	let k = tree.kindOf(e)
	if k == ast.NodeKind.memberExpr 'member'
		return ast.memberExprObj(tree, id: e)
	end 'member'
	if k == ast.NodeKind.callExpr 'call'
		let callee = ast.callExprCallee(tree, id: e)
		if tree.kindOf(callee) == ast.NodeKind.memberExpr 'viaMember'
			return ast.memberExprObj(tree, id: callee)
		end 'viaMember'
	end 'call'
	return 0 as ast.NodeID
end 'defaultHead'

// defaultType is the type a field's default value gives the field: its cast, a bool, a string, or the type the default
// names to make a value of.
function defaultType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let k = ms.tree().kindOf(e)
	if k == ast.NodeKind.castExpr 'cast'
		return resolveTypeRef(c, p: p, ms: ms, tr: ast.castExprTarget(ms.tree(), id: e), selfTy: selfTy, errs: errs)
	end 'cast'
	if k == ast.NodeKind.boolLit 'bool'
		return p.builtins.boolTy
	end 'bool'
	if k == ast.NodeKind.strLit and ms.tree().strIsPlain(ast.strLitPartsRef(ms.tree(), id: e)) 'string'
		return p.builtins.stringTy
	end 'string'
	if k == ast.NodeKind.charLit 'character'
		return p.builtins.characterTy
	end 'character'
	let head = defaultHead(ms.tree(), e: e)
	if head != 0 and ms.tree().kindOf(head) == ast.NodeKind.nameExpr 'named'
		let mark = errs.count()
		let nt = typeNamed(c, p: p, ms: ms, name: head, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return ast.noType
		end 'failed'
		if nt != ast.noType 'type'
			return requireInstance(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: head), nt: nt, errs: errs)
		end 'type'
	end 'named'
	checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errExpressionError, msg: diag.uninferrableFieldDefault(), errs: errs)
	return ast.noType
end 'defaultType'

// declareFieldDefaults gives each field that has a default the type its default has.
function declareFieldDefaults(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tid ast.TypeID, mutates errs diag.ErrorList)
	let selfTy = ast.selfType(ms.types, reads: p.types, declTy: tid)
	enterContext(c, p: p, ms: ms, f: ast.noFunc, owner: selfTy, calls: false)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: tid).fields.count() 'each'
		if ast.typeEntry(ms.types, reads: p.types, t: tid).fields[i].hasDefault 'hasDefault'
			let mark = errs.count()
			let defaultExpr = ast.typeEntry(ms.types, reads: p.types, t: tid).fields[i].defaultExpr
			let t = defaultType(c, p: p, ms: ms, e: defaultExpr, selfTy: selfTy, errs: errs)
			if not failedSince(errs, mark: mark) 'typed'
				ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].fields[i].ty = t
			end 'typed'
		end 'hasDefault'
	end 'each'
end 'declareFieldDefaults'

// declareDeclTypeParams declares the bounds of the type parameters of a type or a union, and tells whether it did so
// without an error.
function declareDeclTypeParams(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ord ast.DeclOrdinal, mutates errs diag.ErrorList) returns bool
	let ref = ast.DeclRef.make(c.modID, ordinal: ord)
	let mark = errs.count()
	match p.modules[c.modIdx].decls[ord as Count].clone() 'k'
		typeDecl(td) then declareNominalTypeParams(c, p: p, ms: ms, owner: declTypeOf(p, ms: ms, ref: ref), params: td.typeParams, constraints: td.whereList, errs: errs)
		unionDecl(ud) then declareNominalTypeParams(c, p: p, ms: ms, owner: declTypeOf(p, ms: ms, ref: ref), params: ud.typeParams, constraints: ud.whereList, errs: errs)
		funcDecl(_) then _ = 0
		constDecl(_) then _ = 0
		enumDecl(_) then _ = 0
		aliasDecl(_) then _ = 0
		interfaceDecl(ifd) then declareInterfaceTypeParams(c, p: p, ms: ms, owner: declTypeOf(p, ms: ms, ref: ref), ifd: ifd, errs: errs)
		extensionDecl(_) then _ = 0
	end 'k'
	return not failedSince(errs, mark: mark)
end 'declareDeclTypeParams'

// declareDecl declares a declaration's members and signatures. The type parameters of a type and of a union were
// declared already, and paramsOk is whether they were declared without an error.
function declareDecl(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ord ast.DeclOrdinal, paramsOk bool, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	let ref = ast.DeclRef.make(c.modID, ordinal: ord)
	match p.modules[c.modIdx].decls[ord as Count].clone() 'k'
		funcDecl(f) then declareFunction(c, p: p, ms: ms, f: f, ref: ref, declared: declared, errs: errs)
		typeDecl(td) then declareTypeDecl(c, p: p, ms: ms, td: td, tid: declTypeOf(p, ms: ms, ref: ref), paramsOk: paramsOk, declared: declared, errs: errs)
		enumDecl(ed) then declareEnumDecl(c, p: p, ms: ms, ed: ed, tid: declTypeOf(p, ms: ms, ref: ref), declared: declared, errs: errs)
		unionDecl(ud) then declareUnionDecl(c, p: p, ms: ms, ud: ud, tid: declTypeOf(p, ms: ms, ref: ref), paramsOk: paramsOk, declared: declared, errs: errs)
		interfaceDecl(ifd) then declareInterfaceMembers(c, p: p, ms: ms, ifd: ifd, tid: declTypeOf(p, ms: ms, ref: ref), errs: errs)
		extensionDecl(xd) then declareExtension(c, p: p, ms: ms, xd: xd, declared: declared, errs: errs)
		constDecl(_) then _ = 0
		aliasDecl(_) then _ = 0
	end 'k'
end 'declareDecl'

function declareFunction(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, f ast.FuncDecl, ref ast.DeclRef, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	let fid = newFuncEntry(c, p: p, ms: ms, f: f, ownerTy: ast.noType, ref: ref)
	addFunction(c, p: p, ms: ms, f: f, fid: fid, nt: ast.noType, declared: declared, errs: errs)
end 'declareFunction'

function declareTypeDecl(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, td ast.TypeDecl, tid ast.TypeID, paramsOk bool, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	if paramsOk 'members'
		declareRecordMembers(c, p: p, ms: ms, td: td, tid: tid, errs: errs)
	end 'members'
	addMethods(c, p: p, ms: ms, methods: td.methods, nt: tid, declared: declared, errs: errs)
	declareFieldDefaults(c, p: p, ms: ms, tid: tid, errs: errs)
end 'declareTypeDecl'

function declareEnumDecl(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ed ast.EnumDecl, tid ast.TypeID, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	declareEnumMembers(c, p: p, ms: ms, ed: ed, tid: tid, errs: errs)
	addMethods(c, p: p, ms: ms, methods: ed.methods, nt: tid, declared: declared, errs: errs)
end 'declareEnumDecl'

function declareUnionDecl(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ud ast.UnionDecl, tid ast.TypeID, paramsOk bool, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	if paramsOk 'members'
		declareUnionMembers(c, p: p, ms: ms, ud: ud, tid: tid, errs: errs)
	end 'members'
	addMethods(c, p: p, ms: ms, methods: ud.methods, nt: tid, declared: declared, errs: errs)
end 'declareUnionDecl'

// declareTypeParamBounds declares the bounds of the type parameters of every type and union of the module, and gives for each
// declaration whether it was declared without an error. It runs before the module's typealiases and members: an instance of
// a generic type that either names queues the check of its type arguments against the bounds, whichever of the two is
// written first, and a module that names the type finds them declared.
export function declareTypeParamBounds(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, mutates errs diag.ErrorList) returns ByteArray
	declareParentInterfaces(c, p: p, ms: ms, errs: errs)
	let count = p.modules[c.modIdx].decls.count()
	var paramsOk = ByteArray.create(count)
	for i in 0 upto count 'params'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many declarations")
		if declareDeclTypeParams(c, p: p, ms: ms, ord: ord, errs: errs) 'ok'
			paramsOk[i] = 1 as Byte
		end 'ok'
	end 'params'
	return paramsOk
end 'declareTypeParamBounds'

// declareModule declares the module's members and signatures, and gives the functions whose bodies are to be checked.
// paramsOk is what declareTypeParamBounds gave.
export function declareModule(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, paramsOk ByteArray, mutates errs diag.ErrorList) returns ast.FuncIDList
	var declared = ast.FuncIDList.create(0)
	c.typing.declared = true
	for i in 0 upto p.modules[c.modIdx].decls.count() 'decls'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many declarations")
		declareDecl(c, p: p, ms: ms, ord: ord, paramsOk: paramsOk[i] == 1, declared: declared, errs: errs)
	end 'decls'
	return declared
end 'declareModule'
