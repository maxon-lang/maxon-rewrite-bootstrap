// Unchecked is an operation that can fail, which says what to write when no try covers it.
union Unchecked
	call(name String)
	// index is a get or a set of a fixed array that states its count, at an index not proven inside it.
	index(method String, count Count)
	// access is a get or a set of the collection receiver at the index argument, or another call whose precondition on
	// the collection's count the analysis did not prove.
	access(receiver ast.NodeID, index ast.NodeID, requirement ast.Precondition)
	operation(op String, fails Byte, node ast.NodeID, ty ast.TypeID)
	cast(ty ast.TypeID)
	// recovered is a cast of a value of the interface iface to the type ty, which fails when it holds another.
	recovered(iface ast.TypeID, ty ast.TypeID)
	// returned is a return whose value is converted to ty, the declared type of the function.
	returned(ty ast.TypeID, value ast.NodeID)
	// thrown is a throw, which needs no try: no error names it.
	thrown
end 'Unchecked'

// rangeCondition evaluates a condition, and gives where the places it changes begin in written.
function rangeCondition(mutates r Ranges, p ast.Project, ms ast.ModuleState, c ast.NodeID) returns Count
	let since = r.written.count()
	_ = rangeEval(r, p: p, ms: ms, e: c)
	return since
end 'rangeCondition'

// rangeNarrowed is the state in which the condition c had the value truth, except for the places that changed since,
// which the condition itself changed after it read them.
function rangeNarrowed(mutates r Ranges, p ast.Project, ms ast.ModuleState, from Count, c ast.NodeID, truth bool, since Count) returns Count
	if isDead(r, s: from) 'dead'
		return from
	end 'dead'
	var out = from
	rangeNarrow(r, p: p, ms: ms, st: out, from: from, c: c, truth: truth, since: since)
	return out
end 'rangeNarrowed'

// rangeNarrow narrows st, which is from or a copy of it made on the first change, by c having the value truth.
function rangeNarrow(mutates r Ranges, p ast.Project, ms ast.ModuleState, mutates st Count, from Count, c ast.NodeID, truth bool, since Count)
	let k = ms.tree().kindOf(c)
	if k == ast.NodeKind.unaryExpr 'unary'
		if ast.unaryExprOp(ms.tree(), id: c) == "not" and typeOf(r, e: c) == p.builtins.boolTy 'not'
			rangeNarrow(r, p: p, ms: ms, st: st, from: from, c: ast.unaryExprE(ms.tree(), id: c), truth: not truth, since: since)
		end 'not'
		return
	end 'unary'
	if k == ast.NodeKind.callExpr 'call'
		match consumes rangeMeasuredPlace(r, p: p, ms: ms, e: c, measure: ast.MeasureKind.measureIsEmpty) 'emptiness'
			some(count) then rangeNarrowCount(r, p: p, ms: ms, st: st, from: from, count: count, op: emptyComparison(truth), since: since)
			none then _ = 0
		end 'emptiness'
		return
	end 'call'
	if k != ast.NodeKind.binaryExpr 'other'
		return
	end 'other'
	let op = ast.binaryExprOp(ms.tree(), id: c)
	let l = ast.binaryExprL(ms.tree(), id: c)
	let right = ast.binaryExprR(ms.tree(), id: c)
	if (op == "and" and truth) or (op == "or" and not truth) 'both'
		if typeOf(r, e: c) == p.builtins.boolTy 'logical'
			rangeNarrow(r, p: p, ms: ms, st: st, from: from, c: l, truth: truth, since: since)
			rangeNarrow(r, p: p, ms: ms, st: st, from: from, c: right, truth: truth, since: since)
		end 'logical'
		return
	end 'both'
	if isComparisonOp(op) and ast.isIntType(ms.types, reads: p.types, t: typeOf(r, e: l)) and ast.isIntType(ms.types, reads: p.types, t: typeOf(r, e: right)) 'comparison'
		var holds = op.clone()
		if not truth 'negated'
			holds = negatedComparison(op)
		end 'negated'
		rangeCompare(r, p: p, ms: ms, st: st, from: from, x: l, op: holds, y: right, since: since)
		rangeCompare(r, p: p, ms: ms, st: st, from: from, x: right, op: flippedComparison(holds), y: l, since: since)
	end 'comparison'
end 'rangeNarrow'

// negatedComparison is the comparison that holds where op does not.
function negatedComparison(op String) returns String
	return match op 'op'
		"==" gives "!="
		"!=" gives "=="
		"<" gives ">="
		"<=" gives ">"
		">" gives "<="
		">=" gives "<"
		default panic("ranges: '{op}' is no comparison")
	end 'op'
end 'negatedComparison'

// flippedComparison is the comparison that holds with the operands swapped.
function flippedComparison(op String) returns String
	return match op 'op'
		"==" gives "=="
		"!=" gives "!="
		"<" gives ">"
		"<=" gives ">="
		">" gives "<"
		">=" gives "<="
		default panic("ranges: '{op}' is no comparison")
	end 'op'
end 'flippedComparison'

// Offset is an expression whose value is a place moved by a constant: the place itself, 'p + c', 'p - c' or 'c + p'. node
// is the operand that names the place. exact is whether the sum is computed exactly, so that wherever its value is reached
// it is the place's moved by the constant: checked arithmetic fails past its word instead, and a bits(64) pattern wraps.
type Offset
	export var at as Place
	export var node as ast.NodeID
	export var by as ast.I128
	export var exact as bool

	static function make(consumes at Place, node ast.NodeID, consumes by ast.I128, exact bool) returns Offset
		return Offset{at: at, node: node, by: by, exact: exact}
	end 'make'
end 'Offset'

// rangeOffsetOf is the place and the constant an expression is, if it is a place moved by a constant.
function rangeOffsetOf(r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns table.Option with Offset
	match consumes rangePlaceOf(r, p: p, ms: ms, e: e) 'place'
		some(place) then return table.Option.some(Offset.make(place, node: e, by: ast.I128.zero(), exact: true))
		none then _ = 0
	end 'place'
	if ms.tree().kindOf(e) != ast.NodeKind.binaryExpr or not r.typing.arith.has(e as Count) 'other'
		return table.Option.none
	end 'other'
	let op = ast.binaryExprOp(ms.tree(), id: e)
	if op != "+" and op != "-" 'notSum'
		return table.Option.none
	end 'notSum'
	let exact = not ast.isWordPattern(ms.types, reads: p.types, t: arithOf(r, e: e).operand)
	let l = ast.binaryExprL(ms.tree(), id: e)
	let right = ast.binaryExprR(ms.tree(), id: e)
	match consumes rangeConstantOf(r, p: p, ms: ms, e: right) 'right'
		some(c) then return offsetBy(rangePlaceOf(r, p: p, ms: ms, e: l), node: l, by: c.neg() if op == "-" else c, exact: exact)
		none then _ = 0
	end 'right'
	if op == "-" 'difference'
		return table.Option.none
	end 'difference'
	return match consumes rangeConstantOf(r, p: p, ms: ms, e: l) 'left'
		some(c) gives offsetBy(rangePlaceOf(r, p: p, ms: ms, e: right), node: right, by: c, exact: exact)
		none gives table.Option.none
	end 'left'
end 'rangeOffsetOf'

function offsetBy(consumes place table.Option with Place, node ast.NodeID, consumes by ast.I128, exact bool) returns table.Option with Offset
	return match consumes place 'place'
		some(at) gives table.Option.some(Offset.make(at, node: node, by: by, exact: exact))
		none gives table.Option.none
	end 'place'
end 'offsetBy'

// rangeConstantOf is the value of an integer expression that is a constant: a literal or the name of a constant.
function rangeConstantOf(r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns table.Option with ast.I128
	let t = typeOf(r, e: e)
	if not ast.isIntType(ms.types, reads: p.types, t: t) 'notInt'
		return table.Option.none
	end 'notInt'
	var v = noSpan()
	if isConstInt(p, ms: ms, t: t) 'literalType'
		v = typeSpan(ms.types, reads: p.types, t: t)
	end 'literalType' else if ms.tree().kindOf(e) == ast.NodeKind.intLit 'literal'
		v = Span.exactly(ast.intLitValue(ms.tree(), id: e))
	end 'literal' else if ms.tree().kindOf(e) == ast.NodeKind.nameExpr and nameInfoOf(r.typing, node: e).kind == ast.NameKind.nameConst 'constant'
		v = constSpan(p, ms: ms, ref: nameInfoOf(r.typing, node: e).decl)
	end 'constant' else 'other'
		return table.Option.none
	end 'other'
	if not isOneValue(v) 'many'
		return table.Option.none
	end 'many'
	return table.Option.some(v.lo.clone())
end 'rangeConstantOf'

// rangeCompare narrows the place of x, if x is a place or a place moved by a constant, by 'x op y', and records how the
// places of x and y compare when y is one too.
function rangeCompare(mutates r Ranges, p ast.Project, ms ast.ModuleState, mutates st Count, from Count, x ast.NodeID, op String, y ast.NodeID, since Count)
	match consumes rangeOffsetOf(r, p: p, ms: ms, e: x) 'x'
		some(ox) then rangeCompareAt(r, p: p, ms: ms, st: st, from: from, ox: ox, op: op, y: y, since: since)
		none then _ = 0
	end 'x'
end 'rangeCompare'

function rangeCompareAt(mutates r Ranges, p ast.Project, ms ast.ModuleState, mutates st Count, from Count, ox Offset, op String, y ast.NodeID, since Count)
	if isDead(r, s: st) or changedIn(ox.at, written: r.written, since: since) 'unknown'
		return
	end 'unknown'
	let oy = rangeOffsetOf(r, p: p, ms: ms, e: y)
	match oy 'y'
		some(o) then rangeRelateUnchanged(r, st: st, from: from, x: ox, op: op, y: o, since: since)
		none then _ = 0
	end 'y'
	let cur = rangeSpanAt(r, p: p, ms: ms, s: st, place: ox.at, t: typeOf(r, e: ox.node))
	let other = rangeSidePeek(r, p: p, ms: ms, s: st, e: y, side: oy, since: since)
	match consumes comparedSpan(cur, op: op, other: other, dx: ox.by, exact: ox.exact) 'narrowed'
		some(next) then rangeRefineAt(r, st: st, from: from, place: ox.at, cur: cur, next: next)
		none then _ = 0
	end 'narrowed'
end 'rangeCompareAt'

// rangeSidePeek is the span of the operand y of a comparison as the comparison read it: its place's moved by its constant
// when it is an exact offset, its type's when the condition changed its place after reading it, and what rangePeek knows
// otherwise.
function rangeSidePeek(r Ranges, p ast.Project, ms ast.ModuleState, s Count, e ast.NodeID, side table.Option with Offset, since Count) returns Span
	match side 'side'
		some(o) then return rangeOffsetSpan(r, p: p, ms: ms, s: s, e: e, o: o, since: since)
		none then return rangePeek(r, p: p, ms: ms, s: s, e: e)
	end 'side'
end 'rangeSidePeek'

function rangeOffsetSpan(r Ranges, p ast.Project, ms ast.ModuleState, s Count, e ast.NodeID, o Offset, since Count) returns Span
	if changedIn(o.at, written: r.written, since: since) or not o.exact 'unknown'
		return typeSpan(ms.types, reads: p.types, t: typeOf(r, e: e))
	end 'unknown'
	return shiftedSpan(rangeSpanAt(r, p: p, ms: ms, s: s, place: o.at, t: typeOf(r, e: o.node)), by: o.by)
end 'rangeOffsetSpan'

// rangeRefineAt gives a place the span next in st, where it had cur: a span that holds no value means no path gets here.
function rangeRefineAt(mutates r Ranges, mutates st Count, from Count, place Place, cur Span, next Span)
	if next.same(cur) 'unchanged'
		return
	end 'unchanged'
	if st == from 'first'
		st = r.states.copyOf(from)
	end 'first'
	if rulesOut(next) 'never'
		r.states.list[st].dead = true
		return
	end 'never'
	r.states.list[st].refine(place, v: next)
end 'rangeRefineAt'

// rangeNarrowCount narrows the count of a collection by 'count op 0', what a test of whether it is empty says, unless the
// condition changed the collection after it read it.
function rangeNarrowCount(mutates r Ranges, p ast.Project, ms ast.ModuleState, mutates st Count, from Count, count Place, op String, since Count)
	if isDead(r, s: st) or changedIn(count, written: r.written, since: since) 'unknown'
		return
	end 'unknown'
	let cur = countSpanAt(r, s: st, count: count)
	rangeRefineAt(r, st: st, from: from, place: count, cur: cur, next: narrowedSpan(cur, op: op, other: Span.exactly(ast.I128.zero())))
end 'rangeNarrowCount'

// countSpanAt is what is known of the count of a collection in the state s: no array holds maxElementCount elements.
function countSpanAt(r Ranges, s Count, count Place) returns Span
	return match consumes r.states.list[s].at(count) 'known'
		some(v) gives v
		none gives Span.make(ast.I128.zero(), hi: ast.I128.fromCount(maxElementCount))
	end 'known'
end 'countSpanAt'

// rangeRelateUnchanged records what 'x op y' says of the difference of the places of two offsets, which a subtraction of
// them reads, unless the condition changed y's place after reading it.
function rangeRelateUnchanged(mutates r Ranges, mutates st Count, from Count, x Offset, op String, y Offset, since Count)
	if changedIn(y.at, written: r.written, since: since) or x.at.same(y.at) 'unknown'
		return
	end 'unknown'
	match consumes comparedGap(op, dx: x.by, dy: y.by, exact: x.exact and y.exact) 'gap'
		some(gap) then rangeRelateBy(r, st: st, from: from, x: x.at, y: y.at, gap: gap)
		none then _ = 0
	end 'gap'
end 'rangeRelateUnchanged'

function rangeRelateBy(mutates r Ranges, mutates st Count, from Count, x Place, y Place, gap ast.I128)
	if st == from 'first'
		st = r.states.copyOf(from)
	end 'first'
	r.states.list[st].relate(x, lo: y, gap: gap)
end 'rangeRelateBy'

// rangePeek is the span of an operand of a condition that has been evaluated already: a local's, a constant's, or else
// its type's.
function rangePeek(r Ranges, p ast.Project, ms ast.ModuleState, s Count, e ast.NodeID) returns Span
	let t = typeOf(r, e: e)
	if isConstInt(p, ms: ms, t: t) 'literal'
		return typeSpan(ms.types, reads: p.types, t: t)
	end 'literal'
	match consumes rangePlaceOf(r, p: p, ms: ms, e: e) 'place'
		some(place) then return rangeSpanAt(r, p: p, ms: ms, s: s, place: place, t: t)
		none then _ = 0
	end 'place'
	if ms.tree().kindOf(e) == ast.NodeKind.nameExpr 'name'
		let name = nameInfoOf(r.typing, node: e)
		if name.kind == ast.NameKind.nameConst 'constant'
			return constSpan(p, ms: ms, ref: name.decl)
		end 'constant'
	end 'name'
	return typeSpan(ms.types, reads: p.types, t: t)
end 'rangePeek'

// constSpan is the span that the range analysis gave a constant's value.
function constSpan(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns Span
	return match consumes ast.declConst(p, ms: ms, ref: ref) 'constant'
		some(value) gives Span.make(value.low.clone(), hi: value.high.clone())
		none panic("ranges: the constant {ref.ordinal} of module {ref.module} has no value")
	end 'constant'
end 'constSpan'

// rangeTyped is the span of a value that the analysis knows nothing more of than its type.
function rangeTyped(r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let t = typeOf(r, e: e)
	if ast.isIntType(ms.types, reads: p.types, t: t) 'int'
		return typeSpan(ms.types, reads: p.types, t: t)
	end 'int'
	return noSpan()
end 'rangeTyped'

// noSpan is the span of a value that is not an integer, which means nothing.
function noSpan() returns Span
	return Span.make(ast.I128.zero(), hi: ast.I128.zero())
end 'noSpan'

// rangeEval walks an expression and gives its span, which means nothing for a value that is not an integer.
function rangeEval(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	if r.failed 'stopped'
		return noSpan()
	end 'stopped'
	let t = typeOf(r, e: e)
	if isConstInt(p, ms: ms, t: t) 'literal'
		return typeSpan(ms.types, reads: p.types, t: t)
	end 'literal'
	let k = ms.tree().kindOf(e)
	if k == ast.NodeKind.intLit 'intLit'
		return Span.exactly(ast.intLitValue(ms.tree(), id: e))
	end 'intLit'
	if k == ast.NodeKind.floatLit or k == ast.NodeKind.boolLit or k == ast.NodeKind.selfExpr or k == ast.NodeKind.byteStrLit or k == ast.NodeKind.charLit 'nothing'
		return noSpan()
	end 'nothing'
	if k == ast.NodeKind.strLit 'strLit'
		return rangeStrLit(r, p: p, ms: ms, e: e)
	end 'strLit'
	if k == ast.NodeKind.structLitExpr or k == ast.NodeKind.tupleExpr 'structLit'
		return rangeStructLit(r, p: p, ms: ms, e: e)
	end 'structLit'
	if k == ast.NodeKind.collectionLitExpr 'collectionLit'
		return rangeCollectionLit(r, p: p, ms: ms, e: e)
	end 'collectionLit'
	if k == ast.NodeKind.nameExpr 'name'
		return rangeNameExpr(r, p: p, ms: ms, e: e)
	end 'name'
	if k == ast.NodeKind.panicExpr 'panic'
		_ = rangeEval(r, p: p, ms: ms, e: ast.panicExprMessage(ms.tree(), id: e))
		return noSpan()
	end 'panic'
	if k == ast.NodeKind.matchExpr 'match'
		return rangeMatch(r, p: p, ms: ms, core: ast.matchExprMatch(ms.tree(), id: e))
	end 'match'
	if k == ast.NodeKind.memberExpr and r.typing.names.has(e as Count) 'deferredName'
		// A read Type.member of a static let in a constant's initializer, which the bodies stage makes a name.
		return rangeNameExpr(r, p: p, ms: ms, e: e)
	end 'deferredName'
	if k == ast.NodeKind.memberExpr 'member'
		return rangeMemberExpr(r, p: p, ms: ms, e: e)
	end 'member'
	if k == ast.NodeKind.indexExpr 'index'
		return rangeIndexExpr(r, p: p, ms: ms, e: e)
	end 'index'
	if k == ast.NodeKind.callExpr 'call'
		return rangeCallExpr(r, p: p, ms: ms, e: e)
	end 'call'
	if k == ast.NodeKind.fromExpr 'from'
		_ = rangeEval(r, p: p, ms: ms, e: ast.fromExprValue(ms.tree(), id: e))
		return noSpan()
	end 'from'
	if k == ast.NodeKind.rangeExpr 'range'
		_ = rangeEval(r, p: p, ms: ms, e: ast.rangeExprLow(ms.tree(), id: e))
		_ = rangeEval(r, p: p, ms: ms, e: ast.rangeExprHigh(ms.tree(), id: e))
		return noSpan()
	end 'range'
	if k == ast.NodeKind.condExpr 'cond'
		return rangeCondExpr(r, p: p, ms: ms, e: e)
	end 'cond'
	if k == ast.NodeKind.tryExpr 'try'
		return rangeTryExpr(r, p: p, ms: ms, e: e)
	end 'try'
	if k == ast.NodeKind.binaryExpr 'binary'
		return rangeBinaryExpr(r, p: p, ms: ms, e: e)
	end 'binary'
	if k == ast.NodeKind.unaryExpr 'unary'
		return rangeUnaryExpr(r, p: p, ms: ms, e: e)
	end 'unary'
	if k == ast.NodeKind.asyncExpr 'async'
		rangeAsyncCall(r, p: p, ms: ms, e: ast.asyncExprCall(ms.tree(), id: e))
		return noSpan()
	end 'async'
	if k == ast.NodeKind.awaitExpr 'await'
		return rangeAwait(r, p: p, ms: ms, e: e)
	end 'await'
	if k == ast.NodeKind.spawnExpr 'spawn'
		let capacity = ast.spawnExprCapacity(ms.tree(), id: e)
		if capacity != 0 'capacity'
			_ = rangeEval(r, p: p, ms: ms, e: ast.argValue(ms.tree(), id: capacity))
		end 'capacity'
		_ = rangeEval(r, p: p, ms: ms, e: ast.spawnExprCall(ms.tree(), id: e))
		return noSpan()
	end 'spawn'
	if k == ast.NodeKind.castExpr 'cast'
		return rangeCastExpr(r, p: p, ms: ms, e: e)
	end 'cast'
	if k == ast.NodeKind.closureExpr 'closure'
		rangeClosure(r, p: p, ms: ms, e: e)
		return noSpan()
	end 'closure'
	if k == ast.NodeKind.typeQueryExpr and ast.typeQueryExprOp(ms.tree(), id: e) == "sizeof" 'sizeof'
		// The size of a value of a type a generic's parameters build, which each instance knows: a value is never larger
		// than the address space.
		return Span.make(ast.I128.one(), hi: ast.I128.i64Max())
	end 'sizeof'
	if k == ast.NodeKind.typeQueryExpr 'countof'
		return rangeTyped(r, p: p, ms: ms, e: e)
	end 'countof'
	panic("ranges: the node {e} of kind {k.name} is no expression")
end 'rangeEval'

// rangeClosure analyses the body of a closure as a function of its own: it runs when it is called, so nothing known where
// it is made reaches into it. A closure the bodies check gave no function has nothing to follow.
function rangeClosure(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID)
	match consumes r.typing.closures.get(e as Count) 'closure'
		some(info) then rangeClosureOf(r, p: p, ms: ms, info: info)
		none then _ = 0
	end 'closure'
end 'rangeClosure'

// rangeClosureOf forgets what is known of each variable the closure borrows to change, which its calls change wherever
// they are: the ownership pass lets nothing read the variable while the closure lives, so no span of it is learned
// before the closure is gone.
function rangeClosureOf(mutates r Ranges, p ast.Project, ms ast.ModuleState, info ast.ClosureInfo)
	for capture in info.captures 'captures'
		if capturesToChange(capture) 'changes'
			rangeChanged(r, p: p, ms: ms, place: Place.local(slotOf(r, local: capture.outerLocal)), t: typeOf(r, e: capture.refNode))
		end 'changes'
	end 'captures'
	if r.probing 'probed'
		return
	end 'probed'
	rangeFunction(r, p: p, ms: ms, fid: info.fn, behaviour: false)
end 'rangeClosureOf'

function rangeStrLit(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let partsRef = ast.strLitPartsRef(ms.tree(), id: e)
	for i in 0 upto ms.tree().strPartCount(partsRef) 'parts'
		if ms.tree().strPartIsExpr(partsRef, index: i) 'interpolated'
			_ = rangeEval(r, p: p, ms: ms, e: ms.tree().strPartExpr(partsRef, index: i))
		end 'interpolated'
	end 'parts'
	return noSpan()
end 'rangeStrLit'

function rangeStructLit(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let ordered = match consumes r.typing.structLits.get(e as Count) 'lit'
		some(info) gives info.ordered
		none panic("ranges: the record literal at node {e} was typed without a record of its fields")
	end 'lit'
	for i in 0 upto ordered.count() 'fields'
		if ordered[i] != 0 'given'
			_ = rangeEval(r, p: p, ms: ms, e: ordered[i])
		end 'given'
	end 'fields'
	return noSpan()
end 'rangeStructLit'

function rangeCollectionLit(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let elemsRef = ast.collectionLitExprElemsRef(ms.tree(), id: e)
	let valuesRef = ast.collectionLitExprValuesRef(ms.tree(), id: e)
	for i in 0 upto ms.tree().listLen(elemsRef) 'each'
		_ = rangeEval(r, p: p, ms: ms, e: ms.tree().listAt(elemsRef, index: i) as ast.NodeID)
		if ms.tree().listLen(valuesRef) > 0 'pair'
			_ = rangeEval(r, p: p, ms: ms, e: ms.tree().listAt(valuesRef, index: i) as ast.NodeID)
		end 'pair'
	end 'each'
	return noSpan()
end 'rangeCollectionLit'

function rangeNameExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let t = typeOf(r, e: e)
	if ast.isIntType(ms.types, reads: p.types, t: t) 'int'
		match consumes rangePlaceOf(r, p: p, ms: ms, e: e) 'place'
			some(place) then return rangeSpanAt(r, p: p, ms: ms, s: r.st, place: place, t: t)
			none then _ = 0
		end 'place'
	end 'int'
	let name = nameInfoOf(r.typing, node: e)
	if name.kind == ast.NameKind.nameConst and ast.isIntType(ms.types, reads: p.types, t: t) 'constant'
		return constSpan(p, ms: ms, ref: name.decl)
	end 'constant'
	return rangeTyped(r, p: p, ms: ms, e: e)
end 'rangeNameExpr'

function rangeMemberExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let kind = memberInfoOf(r, e: e).kind
	if not ast.memberOfType(kind) 'value'
		_ = rangeEval(r, p: p, ms: ms, e: ast.memberExprObj(ms.tree(), id: e))
	end 'value'
	let t = typeOf(r, e: e)
	if ast.isIntType(ms.types, reads: p.types, t: t) 'int'
		match consumes rangePlaceOf(r, p: p, ms: ms, e: e) 'place'
			some(place) then return rangeSpanAt(r, p: p, ms: ms, s: r.st, place: place, t: t)
			none then _ = 0
		end 'place'
	end 'int'
	return rangeTyped(r, p: p, ms: ms, e: e)
end 'rangeMemberExpr'

function rangeIndexExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	_ = rangeEval(r, p: p, ms: ms, e: ast.indexExprObj(ms.tree(), id: e))
	let argsRef = ast.indexExprArgsRef(ms.tree(), id: e)
	for i in 0 upto ms.tree().listLen(argsRef) 'args'
		_ = rangeEval(r, p: p, ms: ms, e: ms.tree().listAt(argsRef, index: i) as ast.NodeID)
	end 'args'
	return rangeTyped(r, p: p, ms: ms, e: e)
end 'rangeIndexExpr'

function rangeCallExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let call = r.typing.calls.expect(e as Count, what: "call").clone()
	let receiver = ast.callReceiver(ms.tree(), e: e, kind: call.kind)
	if receiver != 0 'receiver'
		_ = rangeEval(r, p: p, ms: ms, e: receiver)
	end 'receiver'
	if call.kind == ast.CallKind.callValue 'value'
		_ = rangeEval(r, p: p, ms: ms, e: ast.callExprCallee(ms.tree(), id: e))
	end 'value'
	var first = noSpan()
	var afterFirst = r.written.count()
	for i in 0 upto call.ordered.count() 'args'
		if call.ordered[i] != 0 'given'
			let span = rangeEval(r, p: p, ms: ms, e: call.ordered[i])
			if i == 0 'first'
				first = span
				afterFirst = r.written.count()
			end 'first'
		end 'given'
	end 'args'
	let access = receiver != 0 and rangeAccess(r, p: p, ms: ms, e: e, info: call, receiver: receiver, index: first, since: afterFirst)
	for i in 0 upto call.ordered.count() 'changes'
		if argumentChanges(call, i: i) 'byAddress'
			rangeChangedAt(r, p: p, ms: ms, e: call.ordered[i])
		end 'byAddress'
	end 'changes'
	if receiverChanges(call, receiver: receiver) 'receiverChanges'
		rangeReceiverChanged(r, p: p, ms: ms, e: receiver, effect: receiverEffect(p, ms: ms, info: call, receiverType: typeOf(r, e: receiver)))
	end 'receiverChanges'
	if access 'judged'
		return rangeTyped(r, p: p, ms: ms, e: e)
	end 'judged'
	let err = callErrorType(p, ms: ms, info: call)
	if err != ast.noType 'throws'
		rangeFallible(r, p: p, ms: ms, site: e, err: err, why: Unchecked.call(callTargetName(p, ms: ms, info: call)))
	end 'throws'
	return rangeTyped(r, p: p, ms: ms, e: e)
end 'rangeCallExpr'

// rangeAsyncCall analyses the arguments of the call an async call starts, which it evaluates as the call would: it fails
// nowhere, since what the function throws its await fails with, and what it changes is unknown until the await.
function rangeAsyncCall(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID)
	let call = r.typing.calls.expect(e as Count, what: "async call").clone()
	for i in 0 upto call.ordered.count() 'args'
		if call.ordered[i] != 0 'given'
			_ = rangeEval(r, p: p, ms: ms, e: call.ordered[i])
		end 'given'
	end 'args'
	for i in 0 upto call.ordered.count() 'changes'
		if argumentChanges(call, i: i) 'byAddress'
			rangeChangedAt(r, p: p, ms: ms, e: call.ordered[i])
		end 'byAddress'
	end 'changes'
end 'rangeAsyncCall'

// argumentChanges is whether a call may change what its argument i names: an argument given to a parameter taken mutates
// or sets. The walk and the scan of a loop's body both ask it.
function argumentChanges(info ast.CallInfo, i Count) returns bool
	return info.ordered[i] != 0 and i < info.paramSpecs.count() and ast.isByAddress(info.paramSpecs[i].conv)
end 'argumentChanges'

// receiverChanges is whether a call may change its receiver, in the way receiverEffect says.
function receiverChanges(info ast.CallInfo, receiver ast.NodeID) returns bool
	return receiver != 0 and info.selfConv != ast.Convention.convLet
end 'receiverChanges'

// capturesToChange is whether a closure's calls may change the local a capture names, wherever they run.
function capturesToChange(capture ast.Capture) returns bool
	return capture.conv == ast.Convention.convMutates
end 'capturesToChange'

// rangeAwait analyses an await, which fails with what the function of the promise's coroutine throws.
function rangeAwait(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let operand = ast.awaitExprE(ms.tree(), id: e)
	_ = rangeEval(r, p: p, ms: ms, e: operand)
	let err = ast.promiseError(ms.types, reads: p.types, t: typeOf(r, e: operand))
	if err != ast.noType 'throws'
		let why = "await' on a promise from a function that throws '{nameOfType(p, ms: ms, t: err)}' drops the error and leaks its payload — use 'try await"
		rangeFallible(r, p: p, ms: ms, site: e, err: err, why: Unchecked.call(why))
	end 'throws'
	return rangeTyped(r, p: p, ms: ms, e: e)
end 'rangeAwait'

// rangeAccess judges a call of a built-in whose only failure is a precondition on the count of its receiver, a collection
// whose count the analysis follows, and says whether the call was one: a get or a set at an index. Where the analysis
// proves the precondition, the call becomes the twin that cannot fail, which reads or writes with no check; elsewhere it
// stays the checked call, whose failure a try must cover. A constant index outside a fixed array that states its count is
// an error of its own.
function rangeAccess(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, info ast.CallInfo, receiver ast.NodeID, index Span, since Count) returns bool
	let requirement = ast.intrinsicRequires(info.intrinsic)
	if requirement == ast.Precondition.requiresNone or not isMeasuredType(p, ms: ms, t: typeOf(r, e: receiver)) 'other'
		return false
	end 'other'
	let checked = checkedAccessFunc(p, ms: ms, info: info, receiverType: typeOf(r, e: receiver))
	let twin = match consumes ast.provenTwin(p.builtins, f: checked) 'twin'
		some(f) gives f
		none panic("ranges: the built-in '{ast.funcEntry(ms.funcs, funcReads: p.funcs, f: checked).name}' has a precondition but no twin that cannot fail")
	end 'twin'
	let proven = rangeProves(r, p: p, ms: ms, info: info, receiver: receiver, requirement: requirement, index: index, since: since)
	if not r.probing 'record'
		var chosen = info.clone()
		chosen.fn = checked
		if proven 'twin'
			chosen.fn = twin
		end 'twin'
		chosen.intrinsic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: chosen.fn).intrinsic
		r.typing.calls.insert(e as Count, value: chosen)
	end 'record'
	if proven 'inside'
		rangeProvenCovered(r, e: e)
		return true
	end 'inside'
	let t = ast.contentType(ms.types, reads: p.types, t: typeOf(r, e: receiver))
	if requirement == ast.Precondition.requiresIndexBelow and statesItsCount(p, ms: ms, t: t) 'stated'
		let count = ast.statedCount(ms.types, reads: p.types, t: t)
		let last = ast.I128.fromCount(count).sub(ast.I128.one())
		if index.lo.eq(index.hi) and index.lo.gt(last) and not r.probing 'constant'
			rangeRaise(r, p: p, ms: ms, node: info.ordered[0], code: diag.errTypeMismatch, msg: "Value {index.lo.toString()} is outside the range of the indices of 'FixedArray with {count}' (int(0 to {last.toString()}))")
			return true
		end 'constant'
		rangeFallible(r, p: p, ms: ms, site: e, err: p.builtins.arrayErrorTy, why: Unchecked.index(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: checked).name.clone(), count: count))
		return true
	end 'stated'
	rangeFallible(r, p: p, ms: ms, site: e, err: p.builtins.arrayErrorTy, why: Unchecked.access(receiver, index: indexArgument(info), requirement: requirement))
	return true
end 'rangeAccess'

// rangeProvenCovered notes the proven access e in the try that covers it, if one does.
function rangeProvenCovered(mutates r Ranges, e ast.NodeID)
	if r.handlers.count() == 0 'uncovered'
		return
	end 'uncovered'
	let last = try r.handlers.count() - 1 otherwise panic("ranges: no handler")
	r.handlers[last].proofs = try r.handlers[last].proofs + 1 otherwise panic("ranges: more proofs than a count holds")
	r.handlers[last].proven = e
end 'rangeProvenCovered'

// indexArgument is the first argument of a call, the index of an access, or 0 for a call with none.
function indexArgument(info ast.CallInfo) returns ast.NodeID
	if info.ordered.count() == 0 'none'
		return 0 as ast.NodeID
	end 'none'
	return info.ordered[0]
end 'indexArgument'

// statesItsCount is whether the collection type t is a fixed array whose type states its count.
function statesItsCount(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return ast.originOf(ms.types, reads: p.types, t: t) == p.builtins.fixedArrayOrigin and ast.statesCount(ms.types, reads: p.types, t: t)
end 'statesItsCount'

// checkedAccessFunc is the checked row of the method that a call of an access names, which the call names unless an
// earlier walk chose its twin: the first method of the name that the collection's type declares.
function checkedAccessFunc(p ast.Project, ms ast.ModuleState, info ast.CallInfo, receiverType ast.TypeID) returns ast.FuncID
	let origin = ast.originOf(ms.types, reads: p.types, t: ast.contentType(ms.types, reads: p.types, t: receiverType))
	return ast.typeEntry(ms.types, reads: p.types, t: origin).findMethod(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).name).unwrap()
end 'checkedAccessFunc'

// rangeProves is whether the state proves the precondition of an access on the collection receiver: that the index, whose
// value has the span index, lies inside the collection's count, or that the count is not 0. The count's span and how far
// the count is known to lie above the index's place decide it, as they are where the index was evaluated: a fact on either
// that changed since is not used.
function rangeProves(r Ranges, p ast.Project, ms ast.ModuleState, info ast.CallInfo, receiver ast.NodeID, requirement ast.Precondition, index Span, since Count) returns bool
	if isDead(r, s: r.st) 'dead'
		return false
	end 'dead'
	var count = Span.make(ast.I128.zero(), hi: ast.I128.fromCount(maxElementCount))
	let t = ast.contentType(ms.types, reads: p.types, t: typeOf(r, e: receiver))
	if statesItsCount(p, ms: ms, t: t) 'stated'
		count = Span.exactly(ast.I128.fromCount(ast.statedCount(ms.types, reads: p.types, t: t)))
	end 'stated'
	var at = index.clone()
	if indexArgument(info) != 0 'indexed'
		at = rangeTightened(r, p: p, ms: ms, e: indexArgument(info), v: index, since: since)
	end 'indexed'
	var least = count.lo.sub(at.hi)
	match consumes rangePlaceOf(r, p: p, ms: ms, e: receiver) 'collection'
		some(q) then least = rangeCountAbove(r, p: p, ms: ms, count: placeCount(q), stated: count, index: at, at: indexArgument(info), since: since)
		none then _ = 0
	end 'collection'
	return match requirement 'requirement'
		requiresNone gives panic("ranges: an access with no precondition")
		requiresNonEmpty gives least.ge(ast.I128.one())
		requiresIndexBelow gives not at.lo.isNeg() and least.ge(ast.I128.one())
	end 'requirement'
end 'rangeProves'

// rangeCountAbove is the least that the count of a collection lies above the index of the span index, which the
// expression at evaluates, or above 0 for an access with no index: from the count's span, within stated, what its type says
// of it, and from a relation between the count and the index's place. A fact on a place that changed since the index was
// evaluated is not used.
function rangeCountAbove(r Ranges, p ast.Project, ms ast.ModuleState, count Place, stated Span, index Span, at ast.NodeID, since Count) returns ast.I128
	if changedIn(count, written: r.written, since: since) 'changed'
		return stated.lo.sub(index.hi)
	end 'changed'
	let known = countSpanAt(r, s: r.st, count: count).clamp(stated)
	let least = known.lo.sub(index.hi)
	if at == 0 'noIndex'
		return least
	end 'noIndex'
	match consumes rangeOffsetOf(r, p: p, ms: ms, e: at) 'index'
		some(i) then return rangeGapSince(r, hi: count, lo: i, since: since, least: least)
		none then return least
	end 'index'
end 'rangeCountAbove'

// rangeGapSince is the least of hi - lo, where lo is a place moved by a constant, by the relations of the place, or least
// where none is known, the sum may have wrapped, or the place changed since.
function rangeGapSince(r Ranges, hi Place, lo Offset, since Count, least ast.I128) returns ast.I128
	if changedIn(lo.at, written: r.written, since: since) or not lo.exact 'changed'
		return least.clone()
	end 'changed'
	return match consumes r.states.list[r.st].least(hi, lo: lo.at) 'gap'
		some(g) gives ast.maxI128(least, b: g.sub(lo.by))
		none gives least.clone()
	end 'gap'
end 'rangeGapSince'

// isMeasuredType is whether the count of a collection of the type t is a place the analysis follows: an Array's or a
// FixedArray's. A '__ManagedMemory' shares Array's intrinsics, but it is an Array's storage, so its length would be a
// second place for one quantity; a change through it overlaps the Array that holds it instead. A '__SlotArray''s get also
// fails on an empty slot, so a proven index would remove none of its failures.
function isMeasuredType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let origin = ast.originOf(ms.types, reads: p.types, t: ast.contentType(ms.types, reads: p.types, t: t))
	return origin == p.builtins.arrayOrigin or origin == p.builtins.fixedArrayOrigin
end 'isMeasuredType'

// receiverEffect is what a call that takes its receiver to change does to the receiver's count: the built-in row's
// effect on a collection whose count is followed, and a change of everything in the receiver otherwise.
function receiverEffect(p ast.Project, ms ast.ModuleState, info ast.CallInfo, receiverType ast.TypeID) returns ast.CountEffect
	if info.intrinsic == ast.Intrinsic.intrNone or not isMeasuredType(p, ms: ms, t: receiverType) 'unknown'
		return ast.CountEffect.countChange
	end 'unknown'
	return ast.intrinsicCountEffect(info.intrinsic)
end 'receiverEffect'

// rangeReceiverChanged is a receiver that a call changes with the count effect effect, if it names a place.
function rangeReceiverChanged(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, effect ast.CountEffect)
	if effect == ast.CountEffect.countChange 'unknown'
		rangeChangedAt(r, p: p, ms: ms, e: e)
		return
	end 'unknown'
	match consumes rangePlaceOf(r, p: p, ms: ms, e: e) 'place'
		some(place) then rangeAffect(r, place: place, effect: effect)
		none then _ = 0
	end 'place'
end 'rangeReceiverChanged'

// rangeChangedAt is an expression that a call may change, if it names a place.
function rangeChangedAt(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID)
	match consumes rangePlaceOf(r, p: p, ms: ms, e: e) 'place'
		some(place) then rangeChanged(r, p: p, ms: ms, place: place, t: typeOf(r, e: e))
		none then _ = 0
	end 'place'
end 'rangeChangedAt'

function rangeCondExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let cond = ast.condExprCond(ms.tree(), id: e)
	let since = rangeCondition(r, p: p, ms: ms, c: cond)
	let start = rangeKeep(r)
	let whenTrue = rangeNarrowed(r, p: p, ms: ms, from: start, c: cond, truth: true, since: since)
	r.st = whenTrue
	let thenSpan = rangeEval(r, p: p, ms: ms, e: ast.condExprThen(ms.tree(), id: e))
	let thenEnd = r.st
	let whenFalse = rangeNarrowed(r, p: p, ms: ms, from: start, c: cond, truth: false, since: since)
	r.st = whenFalse
	let els = rangeEval(r, p: p, ms: ms, e: ast.condExprElse(ms.tree(), id: e))
	let elseEnd = r.st
	r.st = r.states.joined(thenEnd, b: elseEnd)
	if isDead(r, s: thenEnd) 'onlyElse'
		return els
	end 'onlyElse'
	if isDead(r, s: elseEnd) 'onlyThen'
		return thenSpan
	end 'onlyThen'
	return thenSpan.unionWith(els)
end 'rangeCondExpr'

// rangeTryExpr covers the failures of its expression: a try with 'otherwise' catches them, and one without passes them to
// the caller.
function rangeTryExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let takes = match consumes nodeLocalOf(r, node: e) 'local'
		some(id) gives r.typing.locals[id as Count].ty
		none gives ast.noType
	end 'local'
	let entered = rangeEnterTry(r, p: p, ms: ms, site: e, handles: not ast.propagates(ms.tree(), e: e), takes: takes)
	let v = rangeEval(r, p: p, ms: ms, e: ast.tryExprE(ms.tree(), id: e))
	rangeCheckTry(r, p: p, ms: ms, entered: entered)
	if not entered.added 'passed'
		return v
	end 'passed'
	let h = rangeLeaveTry(r)
	if h.propagates 'toCaller'
		return v
	end 'toCaller'
	let ended = rangeKeep(r)
	r.st = h.entry
	var other = noSpan()
	let value = ast.tryFallback(ms.tree(), e: e)
	let handler = ast.tryExprHandler(ms.tree(), id: e)
	let ret = ast.tryExprRet(ms.tree(), id: e)
	let brk = ast.tryExprBrk(ms.tree(), id: e)
	let thr = ast.tryExprThr(ms.tree(), id: e)
	if value != 0 'value'
		other = rangeEval(r, p: p, ms: ms, e: value)
	end 'value' else if handler != 0 'handler'
		rangeBlock(r, p: p, ms: ms, body: ast.handlerBlockBodyRef(ms.tree(), id: handler))
	end 'handler' else if ret != 0 'return'
		rangeReturnStmt(r, p: p, ms: ms, s: ret)
	end 'return' else if brk != 0 'break'
		rangeBreakStmt(r, s: brk)
	end 'break' else if ast.tryExprCont(ms.tree(), id: e) != 0 'continue'
		r.st = deadState
	end 'continue' else if thr != 0 'throw'
		rangeThrowStmt(r, p: p, ms: ms, s: thr)
	end 'throw'
	let failed = r.st
	r.st = r.states.joined(ended, b: failed)
	if isDead(r, s: failed) 'caughtNothing'
		return v
	end 'caughtNothing'
	if isDead(r, s: ended) 'alwaysFails'
		return other
	end 'alwaysFails'
	return v.unionWith(other)
end 'rangeTryExpr'

// rangeBinaryExpr walks an operator and the operators nested in its left operand, innermost first, so that a long chain
// takes no stack. An operator is an 'and' or an 'or' that evaluates its right operand only when the left one allows it,
// a comparison, or an operator on integers.
function rangeBinaryExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let since = r.written.count()
	var chain = ast.leftChain(ms.tree(), e: e)
	ast.trimFolded(p, ms: ms, typing: r.typing, chain: chain)
	var node = ast.nextOperator(chain, e: e)
	var l = rangeEval(r, p: p, ms: ms, e: ast.binaryExprL(ms.tree(), id: node))
	while node != e 'inner'
		l = rangeOperator(r, p: p, ms: ms, e: node, l: l, since: since)
		node = ast.nextOperator(chain, e: e)
	end 'inner'
	return rangeOperator(r, p: p, ms: ms, e: e, l: l, since: since)
end 'rangeBinaryExpr'

// rangeOperator is the span of an operator whose left operand has been walked and has the span l; since is where the
// places that the whole expression changes begin in written.
function rangeOperator(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, l Span, since Count) returns Span
	let op = ast.binaryExprOp(ms.tree(), id: e)
	let left = ast.binaryExprL(ms.tree(), id: e)
	let right = ast.binaryExprR(ms.tree(), id: e)
	if (op == "and" or op == "or") and typeOf(r, e: e) == p.builtins.boolTy 'logical'
		let start = rangeKeep(r)
		let rightRuns = rangeNarrowed(r, p: p, ms: ms, from: start, c: left, truth: op == "and", since: since)
		r.st = rightRuns
		_ = rangeEval(r, p: p, ms: ms, e: right)
		let ended = r.st
		r.st = r.states.joined(start, b: ended)
		return noSpan()
	end 'logical'
	let rightFrom = r.written.count()
	let rs = rangeEval(r, p: p, ms: ms, e: right)
	return rangeOperate(r, p: p, ms: ms, e: e, l: l, rs: rs, rightFrom: rightFrom, bound: table.Option.none)
end 'rangeOperator'

// rangeOperate is the span of an operator on operands of the spans l and rs, where rightFrom is where the places that the
// right operand changes begin in written. An exact result outside bound, if there is one, is one the code cannot reach.
function rangeOperate(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, l Span, rs Span, rightFrom Count, bound table.Option with Span) returns Span
	let op = ast.binaryExprOp(ms.tree(), id: e)
	if isComparisonOp(op) or not ast.isIntType(ms.types, reads: p.types, t: typeOf(r, e: e)) 'noSpan'
		return noSpan()
	end 'noSpan'
	var word = signedWord()
	if ast.isUnsignedInt(ms.types, reads: p.types, t: arithOf(r, e: e).operand) 'unsigned'
		word = unsignedWord()
	end 'unsigned'
	let lt = rangeTightened(r, p: p, ms: ms, e: ast.binaryExprL(ms.tree(), id: e), v: l, since: rightFrom)
	let rt = rangeTightened(r, p: p, ms: ms, e: ast.binaryExprR(ms.tree(), id: e), v: rs, since: r.written.count())
	let computed = arithmetic(op, l: lt, r: rt, word: word)
	var exact = computed.span.clone()
	var fails = computed.fails
	if ast.isWordPattern(ms.types, reads: p.types, t: arithOf(r, e: e).operand) and wraps(op) 'wrapping'
		exact = unsignedWord()
		fails = fails and (ast.failDivZero or ast.failShift)
	end 'wrapping'
	match bound 'bound'
		some(b) then exact = withinBound(exact, bound: b)
		none then _ = 0
	end 'bound'
	if op == "-" and not isDead(r, s: r.st) and not ast.isWordPattern(ms.types, reads: p.types, t: arithOf(r, e: e).operand) 'difference'
		exact.lo = rangeDifferenceLow(r, p: p, ms: ms, e: e, low: exact.lo)
	end 'difference'
	var known = ""
	let leftTy = typeOf(r, e: ast.binaryExprL(ms.tree(), id: e))
	let rightTy = typeOf(r, e: ast.binaryExprR(ms.tree(), id: e))
	let aliased = checkedAtOperation(p, ms: ms, op: op, operand: leftTy) or checkedAtOperation(p, ms: ms, op: op, operand: rightTy)
	if aliased and isOneValue(l) and isOneValue(rs) 'known'
		known = "{l.lo.toString()} {op} {rs.lo.toString()}"
	end 'known'
	return rangeResult(r, p: p, ms: ms, e: e, op: op, exact: exact, fails: fails, word: word, known: known)
end 'rangeOperate'

// wraps is whether an operation on a bits(64) pattern is computed modulo 2^64, as against failing past the word: an
// addition, a subtraction, a product, and a left shift, which drops the bits shifted past the word.
function wraps(op String) returns bool
	return op == "+" or op == "-" or op == "*" or op == "shl"
end 'wraps'

// rangeTightened is the span v of an operand e, cut by the relations of its place where it names one that nothing changed
// since it was read: an index below a count is below the count's highest, which keeps 'i + 1' inside the word.
function rangeTightened(r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, v Span, since Count) returns Span
	if isDead(r, s: r.st) or r.states.list[r.st].relations.count() == 0 or not ast.isIntType(ms.types, reads: p.types, t: typeOf(r, e: e)) 'nothing'
		return v.clone()
	end 'nothing'
	match consumes rangePlaceOf(r, p: p, ms: ms, e: e) 'place'
		some(place) then return rangeTightenedAt(r, place: place, v: v, since: since)
		none then return v.clone()
	end 'place'
end 'rangeTightened'

function rangeTightenedAt(r Ranges, place Place, v Span, since Count) returns Span
	if changedIn(place, written: r.written, since: since) 'changed'
		return v.clone()
	end 'changed'
	let out = r.states.list[r.st].tightened(place, cur: v)
	if out.isEmpty() 'never'
		return v.clone()
	end 'never'
	return out
end 'rangeTightenedAt'

// withinBound is an exact result cut to a bound, unless no value of it lies within the bound.
function withinBound(exact Span, bound Span) returns Span
	let within = exact.clamp(bound)
	if within.isEmpty() 'outside'
		return exact.clone()
	end 'outside'
	return within
end 'withinBound'

// rangeDifferenceLow is the least a subtraction of two places can give, by what is known of how far apart they are.
function rangeDifferenceLow(r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, low ast.I128) returns ast.I128
	let px = rangePlaceOf(r, p: p, ms: ms, e: ast.binaryExprL(ms.tree(), id: e))
	let py = rangePlaceOf(r, p: p, ms: ms, e: ast.binaryExprR(ms.tree(), id: e))
	match px 'x'
		some(x) then return gapLow(r, x: x, y: py, low: low)
		none then return low.clone()
	end 'x'
end 'rangeDifferenceLow'

function gapLow(r Ranges, x Place, y table.Option with Place, low ast.I128) returns ast.I128
	match y 'y'
		some(lo) then return gapOrLow(r.states.list[r.st].least(x, lo: lo), low: low)
		none then return low.clone()
	end 'y'
end 'gapLow'

function gapOrLow(consumes gap table.Option with ast.I128, low ast.I128) returns ast.I128
	match consumes gap 'gap'
		some(g) then return ast.maxI128(low, b: g)
		none then return low.clone()
	end 'gap'
end 'gapOrLow'

function arithOf(r Ranges, e ast.NodeID) returns borrowed ast.ArithInfo
	return r.typing.arith.expect(e as Count, what: "arithmetic")
end 'arithOf'

// rangeResult judges an operation whose exact result has the span exact: it fails where that leaves the word it computes
// in or the range of its type, and gives the span of the values it can give. known writes the operation with its operands
// where the analysis knows each to be one value, and is empty elsewhere.
function rangeResult(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, op String, exact Span, fails Byte, word Span, known String) returns Span
	let ty = typeOf(r, e: e)
	let t = typeSpan(ms.types, reads: p.types, t: ty)
	if refusesKnownValue(r, p: p, ms: ms, e: e, v: exact, ty: ty, known: known) 'refused'
		return exact.clamp(t)
	end 'refused'
	var f = fails
	if not exact.isEmpty() 'reached'
		if not exact.within(word) 'pastWord'
			f = f or ast.failOverflow
		end 'pastWord'
		let inWord = exact.clamp(word)
		if inWord.lo.lt(t.lo) 'below'
			f = f or ast.failBelow
		end 'below'
		if inWord.hi.gt(t.hi) 'above'
			f = f or ast.failAbove
		end 'above'
	end 'reached'
	rangeFail(r, p: p, ms: ms, e: e, fails: f, why: Unchecked.operation(op.clone(), fails: f, node: e, ty: ty))
	return exact.clamp(t)
end 'rangeResult'

// refusesKnownValue refuses an operation checked at the operation whose operands the analysis knows, as known writes
// them, and whose result v, one value, its integer type ty does not hold, where no try covers it, and says whether it did:
// it can only fail, which maxon refuses as it does a literal outside the type (E3005), where a failure it may not make is
// the missing try's (E3057). Under a try the failure is the handler's, as any other is. An operation that is not checked
// there, or whose operands are not known, has an empty known and is judged as any other.
function refusesKnownValue(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, v Span, ty ast.TypeID, known String) returns bool
	if known == "" or r.handlers.count() > 0 or r.probing or isDead(r, s: r.st) or not isOneValue(v) or ast.isWordPattern(ms.types, reads: p.types, t: ty) 'unknown'
		return false
	end 'unknown'
	if typeSpan(ms.types, reads: p.types, t: ty).has(v.lo) 'holds'
		return false
	end 'holds'
	let low = ast.typeEntry(ms.types, reads: p.types, t: ty).minVal.toString()
	let high = ast.typeEntry(ms.types, reads: p.types, t: ty).maxVal.toString()
	rangeRaise(r, p: p, ms: ms, node: e, code: diag.errTypeMismatch, msg: diag.resultOutOfRange(known, alias: nameOfType(p, ms: ms, t: ty), low: low, high: high))
	return true
end 'refusesKnownValue'

// checkedAtOperation is whether the operator op over operands of the type operand is checked where it is computed, so that
// a result outside the range is the operation's failure: an addition, a subtraction, a product or a negation over an alias
// whose range is a whole word, which no wider word holds the result of. Over a narrower alias, a constant or a value of no
// alias, a loop's counter, the result is computed in a word and checked where it is used, and a shift is computed in a
// word whatever its operand.
function checkedAtOperation(p ast.Project, ms ast.ModuleState, op String, operand ast.TypeID) returns bool
	if not (op == "+" or op == "-" or op == "*") or not typeIsNamedInt(ms.types, reads: p.types, t: operand) or ast.isWordPattern(ms.types, reads: p.types, t: operand) 'other'
		return false
	end 'other'
	let t = typeSpan(ms.types, reads: p.types, t: operand)
	return t.same(signedWord()) or t.same(unsignedWord())
end 'checkedAtOperation'

// isOneValue is whether the span holds a single value.
function isOneValue(v Span) returns bool
	return not v.isEmpty() and v.lo.eq(v.hi)
end 'isOneValue'

// failureText says how an operation can fail, for the error that it is not caught.
function failureText(p ast.Project, ms ast.ModuleState, op String, fails Byte, ty ast.TypeID) returns String
	if (fails and ast.failDivZero) != 0 'zero'
		return "the divisor of '{op}' may be 0"
	end 'zero'
	let t = typeSpan(ms.types, reads: p.types, t: ty)
	let name = nameOfType(p, ms: ms, t: ty)
	if (fails and ast.failShift) != 0 'shift'
		return "the count of '{op}' may be negative"
	end 'shift'
	if (fails and (ast.failOverflow or ast.failAbove)) != 0 and (fails and ast.failBelow) != 0 'both'
		return "the result of '{op}' may not fit {name} ({t.lo.toString()} to {t.hi.toString()})"
	end 'both'
	if (fails and ast.failBelow) != 0 or ((fails and ast.failOverflow) != 0 and op == "-") 'below'
		return "the result of '{op}' may be below the minimum of {name}, {t.lo.toString()}"
	end 'below'
	return "the result of '{op}' may be above the maximum of {name}, {t.hi.toString()}"
end 'failureText'

// guardAdvice is a condition that would rule the failure out, when one is short to say.
function guardAdvice(tree ast.Tree, fails Byte, e ast.NodeID) returns String
	if tree.kindOf(e) != ast.NodeKind.binaryExpr 'notBinary'
		return ""
	end 'notBinary'
	let right = ast.binaryExprR(tree, id: e)
	if tree.kindOf(right) != ast.NodeKind.nameExpr 'notNamed'
		return ""
	end 'notNamed'
	let name = ast.nameExprName(tree, id: right)
	if (fails and ast.failDivZero) != 0 'zero'
		return "if {name} != 0"
	end 'zero'
	if (fails and ast.failShift) != 0 'shift'
		return "if {name} >= 0"
	end 'shift'
	return ""
end 'guardAdvice'

// operandFix is the end of the error for an operation that can fail because of its operands: a try, or the condition
// that guard says rules the failure out, or a general one.
function operandFix(guard String) returns String
	if guard == "" 'general'
		return "; handle the failure with 'try', or check the operands first with an 'if' that rules it out"
	end 'general'
	return "; handle the failure with 'try', or guard it with '{guard}'"
end 'operandFix'

// castText is the error for a conversion to ty that can fail where no try covers it.
function castText(p ast.Project, ms ast.ModuleState, ty ast.TypeID) returns String
	if ast.isFloatType(ms.types, reads: p.types, t: ty) 'float'
		return "the value may not fit {nameOfType(p, ms: ms, t: ty)} ({floatRangeText(p, ms: ms, t: ty)}){operandFix("")}"
	end 'float'
	return "the value may not fit {nameOfType(p, ms: ms, t: ty)} ({typeSpan(ms.types, reads: p.types, t: ty).lo.toString()} to {typeSpan(ms.types, reads: p.types, t: ty).hi.toString()}){operandFix("")}"
end 'castText'

// uncheckedNode is the node an error for why is reported at: the operation, or the value that a return converts.
function uncheckedNode(why Unchecked, site ast.NodeID) returns ast.NodeID
	return match why 'why'
		returned(_, value) gives value
		call(_) gives site
		index(_, _) gives site
		access(_, _, _) gives site
		operation(_, _, _, _) gives site
		cast(_) gives site
		recovered(_, _) gives site
		thrown gives site
	end 'why'
end 'uncheckedNode'

// uncheckedFix is the change the error for why names: a try around the operation, or around the conversion that a return
// makes.
function uncheckedFix(p ast.Project, ms ast.ModuleState, t ast.Tree, why Unchecked, site ast.NodeID) returns diag.Fix
	return match why 'why'
		returned(ty, value) gives returnFix(t, e: value, target: nameOfType(p, ms: ms, t: ty))
		call(_) gives tryFix(t, e: site)
		index(_, _) gives tryFix(t, e: site)
		access(_, _, _) gives tryFix(t, e: site)
		operation(_, _, _, _) gives tryFix(t, e: site)
		cast(_) gives tryFix(t, e: site)
		recovered(_, _) gives tryFix(t, e: site)
		thrown gives tryFix(t, e: site)
	end 'why'
end 'uncheckedFix'

// ownTryFix is the change for an operation that fails where the try around it passes the failure to a caller, or to a
// handler, that takes another error: a try of its own that panics, as one that no try covers gets. Only a failure of the
// operation's range is such a fault of the program, as maxon's check of a value at a parameter or a cast panics; a
// call's error, or a throw, is the program's to handle, so it gets no fix.
function ownTryFix(p ast.Project, ms ast.ModuleState, why Unchecked, site ast.NodeID) returns diag.Fix
	return match why 'why'
		call(_) gives diag.Fix.none()
		thrown gives diag.Fix.none()
		index(_, _) gives uncheckedFix(p, ms: ms, t: ms.tree(), why: why, site: site)
		access(_, _, _) gives uncheckedFix(p, ms: ms, t: ms.tree(), why: why, site: site)
		operation(_, _, _, _) gives uncheckedFix(p, ms: ms, t: ms.tree(), why: why, site: site)
		cast(_) gives uncheckedFix(p, ms: ms, t: ms.tree(), why: why, site: site)
		recovered(_, _) gives uncheckedFix(p, ms: ms, t: ms.tree(), why: why, site: site)
		returned(_, _) gives uncheckedFix(p, ms: ms, t: ms.tree(), why: why, site: site)
	end 'why'
end 'ownTryFix'

// uncheckedText is the error for an operation that can fail where no try covers it.
function uncheckedText(r Ranges, p ast.Project, ms ast.ModuleState, why Unchecked, site ast.NodeID) returns String
	return match why 'why'
		call(name) gives diag.throwingCallRequiresTry(name)
		index(method, count) gives "{diag.throwingCallRequiresTry(method)} — its index is not proven inside the fixed array's {count} elements; wrap it as `try … otherwise …`, or give the index a ranged type within `int(0 to {ast.I128.fromCount(count).sub(ast.I128.one()).toString()})`"
		access(receiver, index, requirement) gives accessText(ms.tree(), call: site, receiver: receiver, index: index, requirement: requirement)
		operation(op, fails, node, ty) gives "{failureText(p, ms: ms, op: op, fails: fails, ty: ty)}{operandFix(guardAdvice(ms.tree(), fails: fails, e: node))}"
		cast(ty) gives castText(p, ms: ms, ty: ty)
		recovered(iface, ty) gives "the value of '{nameOfType(p, ms: ms, t: iface)}' may hold a value of another type than '{nameOfType(p, ms: ms, t: ty)}', and then the cast fails with CastError.otherType; handle the failure with 'try'"
		returned(ty, _) gives castText(p, ms: ms, ty: ty)
		thrown panic("ranges: a throw is always covered")
	end 'why'
end 'uncheckedText'

// accessText is the error for an access at call whose precondition on the count of the collection receiver is not proven
// where no try covers it: what it needs, and the two ways to give it.
function accessText(t ast.Tree, call ast.NodeID, receiver ast.NodeID, index ast.NodeID, requirement ast.Precondition) returns String
	let written = exprText(t, e: call)
	let count = "{receiverText(t, call: call, receiver: receiver)}.count()"
	let needs = match requirement 'requirement'
		requiresNone gives panic("ranges: an access with no precondition")
		requiresIndexBelow gives "{exprText(t, e: index)} < {count}"
		requiresNonEmpty gives "{count} > 0"
	end 'requirement'
	return "'{written}' needs {needs}, which is not known here: guard it with 'if {needs}', or check it with 'try {written} otherwise …'"
end 'accessText'

// receiverText is the text of the receiver of a method call: what stands before the dot of the callee, which is where the
// member starts, since the extent of a bare name runs on through the dotted words after it.
function receiverText(t ast.Tree, call ast.NodeID, receiver ast.NodeID) returns String
	let callee = ast.callExprCallee(t, id: call)
	if t.kindOf(callee) != ast.NodeKind.memberExpr 'unqualified'
		return exprText(t, e: receiver)
	end 'unqualified'
	return table.blankTrimmed(t.text.sliceBytes(ast.exprStart(t, e: receiver), endPos: t.startOf(callee) as Count), fromStart: false, fromEnd: true).clone()
end 'receiverText'

// needlessTryText is the error for a try that covers nothing that can fail: what it covers, when that is an expression or a
// call, and the change that leaves the code saying what is true. access is the access that the analysis proved inside its
// collection, or 0 where nothing was an access.
function needlessTryText(t ast.Tree, site ast.NodeID, access ast.NodeID) returns String
	let kind = t.kindOf(site)
	if kind == ast.NodeKind.tryExpr 'expression'
		let covered = ast.tryExprE(t, id: site)
		let why = needlessReason(t, covered: covered, access: access)
		if ast.propagates(t, e: site) 'passes'
			return "{why}, so this 'try' passes on a failure that never happens; remove the 'try'"
		end 'passes'
		return "{why}, so this 'try' handles a failure that never happens; remove the 'try' and its handler"
	end 'expression'
	if kind == ast.NodeKind.tryStmt 'block'
		let why = "nothing in this 'try' block can fail" if access == 0 else "its only access, '{exprText(t, e: access)}', is proven inside the collection, and nothing else in this 'try' block can fail"
		if ast.tryStmtHasOtherwise(t, id: site) 'handled'
			return "{why}, so its handler never runs; remove the 'try' and the 'end' around the body, and the handler"
		end 'handled'
		return "{why}, so the 'try' passes on a failure that never happens; remove the 'try' and the 'end' around the body"
	end 'block'
	if kind == ast.NodeKind.ifTryStmt 'conditional'
		let why = needlessReason(t, covered: ast.ifTryStmtCall(t, id: site), access: access)
		return "{why}, so the 'else' of this 'if try' never runs; call it without 'try' and write the block that follows, which 'fix' does not do for you"
	end 'conditional'
	panic("ranges: a needless try at a node that is no try")
end 'needlessTryText'

// needlessReason says that the expression a try covers cannot fail.
function needlessReason(t ast.Tree, covered ast.NodeID, access ast.NodeID) returns String
	if access != 0 'proven'
		return "'{exprText(t, e: access)}' cannot fail here: its index is proven inside the collection"
	end 'proven'
	return "'{exprText(t, e: covered)}' cannot fail here"
end 'needlessReason'

// rangeFail records how the operation e can fail, if it can, and that the innermost try covers it. The probe of a loop
// records nothing, as the real walk of the loop will.
function rangeFail(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, fails Byte, why Unchecked)
	if fails == ast.failNone or isDead(r, s: r.st) 'cannot'
		return
	end 'cannot'
	if not r.probing 'record'
		setFails(r, e: e, fails: fails)
	end 'record'
	rangeFallible(r, p: p, ms: ms, site: e, err: p.builtins.arithmeticErrorTy, why: why)
end 'rangeFail'

// setFails records how an operation can fail, for the lowering, which checks only that.
function setFails(mutates r Ranges, e ast.NodeID, fails Byte)
	var info = arithOf(r, e: e).clone()
	info.fails = fails
	r.typing.arith.insert(e as Count, value: info)
end 'setFails'

// rangeFallible is an operation that can fail with the error err: the innermost try covers it, and its handler can start
// in the state here. No try is an error, which why says, and so is a try whose handler or caller takes another error.
// Code the analysis proves unreachable is held to the same rule, since the lowering emits it and what is proved
// unreachable depends on how sharp the analysis is.
function rangeFallible(mutates r Ranges, p ast.Project, ms ast.ModuleState, site ast.NodeID, err ast.TypeID, why Unchecked)
	if r.handlers.count() == 0 'uncovered'
		if not r.probing 'report'
			rangeRaiseFixed(r, p: p, ms: ms, node: uncheckedNode(why, site: site), code: diag.errUncheckedFailure, msg: uncheckedText(r, p: p, ms: ms, why: why, site: site), fix: uncheckedFix(p, ms: ms, t: ms.tree(), why: why, site: site))
		end 'report'
		return
	end 'uncovered'
	let last = try r.handlers.count() - 1 otherwise panic("ranges: no handler")
	r.handlers[last].failures = try r.handlers[last].failures + 1 otherwise panic("ranges: more failures than a count holds")
	let propagates = r.handlers[last].propagates
	let takes = r.handlers[last].takes
	if not r.probing 'judged'
		let thrown = fnErrorType(r, p: p, ms: ms)
		if propagates and thrown != err 'otherError'
			rangeRaiseFixed(r, p: p, ms: ms, node: site, code: diag.errErrorTypeMismatch, msg: diag.propagateMismatch(nameOfType(p, ms: ms, t: err), enclosing: nameOfType(p, ms: ms, t: thrown)), fix: ownTryFix(p, ms: ms, why: why, site: site))
			return
		end 'otherError'
		if takes != ast.noType and takes != err 'otherHandler'
			rangeRaiseFixed(r, p: p, ms: ms, node: site, code: diag.errErrorTypeMismatch, msg: "this fails with '{nameOfType(p, ms: ms, t: err)}', but the handler of the try around it names a '{nameOfType(p, ms: ms, t: takes)}': give it a 'try ... otherwise' of its own", fix: ownTryFix(p, ms: ms, why: why, site: site))
			return
		end 'otherHandler'
	end 'judged'
	if not propagates and not isDead(r, s: r.st) 'caught'
		let kept = rangeKeep(r)
		let entry = r.handlers[last].entry
		let joined = r.states.joined(entry, b: kept)
		r.handlers[last].entry = joined
	end 'caught'
end 'rangeFallible'

function rangeUnaryExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let operand = ast.unaryExprE(ms.tree(), id: e)
	let v = rangeEval(r, p: p, ms: ms, e: operand)
	let t = typeOf(r, e: e)
	if not ast.isIntType(ms.types, reads: p.types, t: t) 'notInt'
		return noSpan()
	end 'notInt'
	let op = ast.unaryExprOp(ms.tree(), id: e)
	// A negation is computed in a signed word whatever type the context gives its result, and a complement in its
	// operand's word.
	let unsigned = op == "not" and ast.isUnsignedInt(ms.types, reads: p.types, t: typeOf(r, e: operand))
	var word = signedWord()
	if unsigned 'unsigned'
		word = unsignedWord()
	end 'unsigned'
	var exact = Span.make(v.hi.neg(), hi: v.lo.neg())
	if op == "-" and ast.isWordPattern(ms.types, reads: p.types, t: t) 'wrappingNegation'
		// The negation of a bit pattern wraps modulo 2^64, so it is a pattern too.
		word = unsignedWord()
		exact = unsignedWord()
	end 'wrappingNegation'
	if op == "not" 'not'
		// The bits of a value flipped: -v - 1 in a signed word, and u64.max - v in an unsigned one.
		if unsigned 'unsignedNot'
			exact = Span.make(ast.I128.u64Max().sub(v.hi), hi: ast.I128.u64Max().sub(v.lo))
		end 'unsignedNot' else 'signedNot'
			exact = Span.make(v.hi.neg().sub(ast.I128.one()), hi: v.lo.neg().sub(ast.I128.one()))
		end 'signedNot'
	end 'not'
	var known = ""
	if op == "-" and checkedAtOperation(p, ms: ms, op: op, operand: typeOf(r, e: operand)) and isOneValue(v) 'known'
		known = "-{v.lo.toString()}"
	end 'known'
	return rangeResult(r, p: p, ms: ms, e: e, op: op, exact: exact, fails: ast.failNone, word: word, known: known)
end 'rangeUnaryExpr'

// rangeCastExpr fails where the value may lie outside the target's range.
function rangeCastExpr(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns Span
	let operand = ast.castExprE(ms.tree(), id: e)
	let v = rangeEval(r, p: p, ms: ms, e: operand)
	let ty = typeOf(r, e: e)
	let src = typeOf(r, e: operand)
	if typeHasKind(p, ms: ms, t: src, kind: ast.TypeKind.interfaceTy) 'recovered'
		if not isDead(r, s: r.st) 'live'
			rangeFallible(r, p: p, ms: ms, site: e, err: p.builtins.castErrorTy, why: Unchecked.recovered(src, ty: ty))
		end 'live'
		if typeHasKind(p, ms: ms, t: ty, kind: ast.TypeKind.intRange) 'integer'
			return typeSpan(ms.types, reads: p.types, t: ty)
		end 'integer'
		return noSpan()
	end 'recovered'
	if ast.familyOfSelf(ms.types, reads: p.types, t: ty) != ast.noType 'ofFamily'
		// Each instance has its own range, so the value may lie outside it on either side.
		if src != ty 'converted'
			rangeFail(r, p: p, ms: ms, e: e, fails: ast.failBelow or ast.failAbove, why: Unchecked.cast(ty))
		end 'converted'
		return noSpan()
	end 'ofFamily'
	if ast.castRebrands(ms.types, reads: p.types, target: ty) 'rebrand'
		return noSpan()
	end 'rebrand'
	return rangeConverted(r, p: p, ms: ms, e: e, v: v, src: typeOf(r, e: operand), ty: ty, why: Unchecked.cast(ty))
end 'rangeCastExpr'

// reinterpreted is the span of a value of the span v and the type src once it is converted to ty, before ty's range is
// applied. A bits(64) pattern and an integer type that holds every signed word are two readings of the same 64 bits, so
// a conversion between them changes the value and never fails; any other conversion keeps the value.
function reinterpreted(p ast.Project, ms ast.ModuleState, v Span, src ast.TypeID, ty ast.TypeID) returns Span
	let word = unsignedWord()
	if ast.isWordPattern(ms.types, reads: p.types, t: ty) and v.lo.isNeg() 'toPattern'
		return word
	end 'toPattern'
	let target = typeSpan(ms.types, reads: p.types, t: ty)
	if ast.isWordPattern(ms.types, reads: p.types, t: src) and signedWord().within(target) and v.hi.gt(ast.I128.i64Max()) 'toSigned'
		if v.lo.gt(ast.I128.i64Max()) 'wholly'
			let wrap = ast.I128.u64Max().add(ast.I128.one())
			return Span.make(v.lo.sub(wrap), hi: v.hi.sub(wrap))
		end 'wholly'
		return signedWord()
	end 'toSigned'
	return v.clone()
end 'reinterpreted'

// rangeConverted is the conversion of the value of the span v to ty, at the node e that records how it can fail.
function rangeConverted(mutates r Ranges, p ast.Project, ms ast.ModuleState, e ast.NodeID, v Span, src ast.TypeID, ty ast.TypeID, why Unchecked) returns Span
	if ast.isFloatType(ms.types, reads: p.types, t: ty) 'float'
		rangeFail(r, p: p, ms: ms, e: e, fails: floatConversionFails(p, ms: ms, src: src, dst: ty), why: why)
		return noSpan()
	end 'float'
	let t = typeSpan(ms.types, reads: p.types, t: ty)
	let seen = reinterpreted(p, ms: ms, v: v, src: src, ty: ty)
	var fails = ast.failNone
	if seen.lo.lt(t.lo) and not ast.isWordPattern(ms.types, reads: p.types, t: ty) 'below'
		fails = fails or ast.failBelow
	end 'below'
	if seen.hi.gt(t.hi) and not ast.isWordPattern(ms.types, reads: p.types, t: ty) 'above'
		fails = fails or ast.failAbove
	end 'above'
	rangeFail(r, p: p, ms: ms, e: e, fails: fails, why: why)
	return seen.clamp(t)
end 'rangeConverted'
