// Services, maxon's: `spawn T.f(args)` starts a service of the type T, whose state the static factory f makes, and gives
// its handle, a `T.handle`; a call of an export instance method of T through the handle is a message, which the service
// handles one at a time on its own green thread. What crosses into a service is decided in one place, unsendable: a
// value moves in, or is frozen and shared, and nothing borrowed crosses, so no part of a value is reachable from two
// threads and no count but the atomic ones of frozen values, cowns and handles is stepped by two. A send fails at once
// with SendError only when the service is shut down; a mailbox has no capacity, the runtime slows a sender of a service
// that is behind instead (runtime/service.maxon). A message whose handler returns or throws replies, and the reply is a
// promise the sender awaits, as an async call's is. A handler never waits on another party (E3221), so services never wait
// on each other in a cycle.

// checkSpawn types a spawn: its target is a static factory of a type that returns the type, which becomes the service's
// state. A factory that cannot throw runs as the service's first behaviour, so its arguments move in as a message's do; one
// that throws runs where the spawn is, which fails with the factory's error, as maxon's spawner waits for it.
function checkSpawn(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let call = ast.spawnExprCall(ms.tree(), id: e)
	if ms.tree().kindOf(call) != ast.NodeKind.callExpr or ms.tree().kindOf(ast.callExprCallee(ms.tree(), id: call)) != ast.NodeKind.memberExpr 'notFactory'
		refuseSpawnTarget(c, p: p, ms: ms, e: e, errs: errs)
		return ast.noType
	end 'notFactory'
	let result = typeCall(c, p: p, ms: ms, call: call, errs: errs)
	if result == ast.noType 'failed'
		return ast.noType
	end 'failed'
	recordType(c, e: call, t: result)
	var info = match consumes c.typing.calls.get(call as Count) 'info'
		some(i) gives i
		none panic("check: a spawn was typed without a record of what it calls")
	end 'info'
	if info.kind != ast.CallKind.callStatic or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).ownerTy != result 'notOwn'
		refuseSpawnTarget(c, p: p, ms: ms, e: e, errs: errs)
		return ast.noType
	end 'notOwn'
	if not requireService(c, p: p, ms: ms, e: e, state: result, factory: info.fn, errs: errs) 'refused'
		return ast.noType
	end 'refused'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).errTy != ast.noType 'throws'
		recordCallFailure(c, p: p, ms: ms, call: call)
		noteCallWaits(c, p: p, ms: ms, call: call)
		c.partyWaitNow = true
	end 'throws' else 'onService'
		movesEveryArgument(info)
		info.body = serviceBody(c, p: p, ms: ms, node: e)
		c.typing.calls.insert(call as Count, value: info)
	end 'onService'
	if not holdsType(c.spawned, t: result) 'first'
		c.spawned.push(result)
		c.spawnSites.push(e)
	end 'first'
	return serviceHandleType(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), state: result, errs: errs)
end 'checkSpawn'

// serviceHandleType is `state.handle`, the type of a handle to a service of the state.
export function serviceHandleType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, state ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	var args = ast.TypeIDList.create(0)
	args.push(state)
	return instantiateGeneric(c, p: p, ms: ms, off: off, orig: p.builtins.serviceOrigin, args: args, errs: errs)
end 'serviceHandleType'

function refuseSpawnTarget(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList)
	failAt(c, p: p, ms: ms, node: e, code: diag.errSpawnTarget, msg: "`spawn` starts a service of a type through a static factory of the type that returns it, as 'spawn Calc.create()'; '{exprText(ms.tree(), e: ast.spawnExprCall(ms.tree(), id: e))}' is not one", errs: errs)
end 'refuseSpawnTarget'

// movesEveryArgument makes each parameter of a call that runs on a service take its argument, which moves in: the
// behaviour that calls the function owns it, and drops what a let parameter only borrowed once the function returns.
function movesEveryArgument(mutates info ast.CallInfo)
	var moved = ast.ParamSpecList.create(0)
	for i in 0 upto info.paramSpecs.count() 'specs'
		var spec = info.paramSpecs[i].clone()
		spec.conv = ast.Convention.convConsumes
		moved.push(spec)
	end 'specs'
	info.paramSpecs = moved
	info.selfConv = ast.Convention.convLet
end 'movesEveryArgument'

// serviceBody is the function of the behaviour that runs a factory or a message on the service, numbered with the bodies of
// the behaviours of the function being checked.
function serviceBody(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID) returns ast.FuncID
	var entry = ast.FuncEntry.make(ast.behaviourName(funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: c.fn), index: c.whens), visibility: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).visibility.clone(), module: c.modID, nodeID: node)
	entry.retTy = p.builtins.voidTy
	let fid = ast.allocFunc(ms.funcs, module: c.modID, f: entry)
	c.whens = try c.whens + 1 otherwise panic("too many behaviours in one function")
	return fid
end 'serviceBody'

function holdsType(ts ast.TypeIDList, t ast.TypeID) returns bool
	for i in 0 upto ts.count() 'each'
		if ts[i] == t 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'holdsType'

// callSend types a call through a handle: `shutdown`, a method of every handle, or a message, an export instance method of
// the service's type. A message's arguments move into the service, its send fails with SendError, and a handler that
// returns or throws replies: the send gives the reply's promise, unless a discard drops it.
function callSend(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, handle ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	let mark = errs.count()
	let own = methodOf(c, p: p, ms: ms, t: handle, name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return ast.noType
	end 'ambiguous'
	if own != ast.noFunc 'handleMethod'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: own).intrinsic == ast.Intrinsic.intrServiceStopNow and not requireStopsNow(c, p: p, ms: ms, node: call, state: ast.serviceState(ms.types, reads: p.types, t: handle), errs: errs) 'undeclared'
			return ast.noType
		end 'undeclared'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: own).intrinsic == ast.Intrinsic.intrServiceStopped 'watch'
			return callStopped(c, p: p, ms: ms, call: call, handle: handle, own: own, errs: errs)
		end 'watch'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: own).intrinsic == ast.Intrinsic.intrServiceNotifyStopped 'notify'
			return callNotifyStopped(c, p: p, ms: ms, call: call, handle: handle, own: own, errs: errs)
		end 'notify'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: own).intrinsic == ast.Intrinsic.intrServicePost 'post'
			return callPost(c, p: p, ms: ms, call: call, handle: handle, own: own, errs: errs)
		end 'post'
		let typed = callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callMethod, target: own, hasGiven: true, given: ast.typeEntry(ms.types, reads: p.types, t: handle).typeArgs.clone(), errs: errs)
		let op = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: own).intrinsic
		if typed != ast.noType and (op == ast.Intrinsic.intrServiceShutdown or op == ast.Intrinsic.intrServiceStopNow) 'stop'
			noteStateEnd(c, p: p, ms: ms, call: call, state: ast.serviceState(ms.types, reads: p.types, t: handle))
		end 'stop'
		return typed
	end 'handleMethod'
	if ast.isInterfaceHandle(ms.types, reads: p.types, t: handle) 'interface'
		return callInterfaceSend(c, p: p, ms: ms, call: call, handle: handle, name: name, errs: errs)
	end 'interface'
	let state = ast.serviceState(ms.types, reads: p.types, t: handle)
	let method = methodOf(c, p: p, ms: ms, t: state, name: name, node: call, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguousMessage'
		return ast.noType
	end 'ambiguousMessage'
	if not isMessage(p, ms: ms, method: method) 'notMessage'
		failAt(c, p: p, ms: ms, node: call, code: diag.errNotAMessage, msg: "'{name}' is not a message of '{nameOfType(p, ms: ms, t: handle)}': a handle reaches the export instance methods of '{nameOfType(p, ms: ms, t: state)}', each a message; export it, or call it inside a message", errs: errs)
		return ast.noType
	end 'notMessage'
	let result = callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callSend, target: method, hasGiven: false, given: ast.TypeIDList.create(0), errs: errs)
	if result == ast.noType 'failed'
		return ast.noType
	end 'failed'
	var info = match consumes c.typing.calls.get(call as Count) 'info'
		some(i) gives i
		none panic("check: a send was typed without a record of what it calls")
	end 'info'
	if not requireNoFrozenContents(c, p: p, ms: ms, call: call, info: info, errs: errs) 'lent'
		return ast.noType
	end 'lent'
	movesEveryArgument(info)
	info.receiverTy = handle
	info.body = serviceBody(c, p: p, ms: ms, node: call)
	// A message that defers its reply answers what its header declares through its Reply.
	var reply = result
	if ast.defers(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method)) 'deferred'
		reply = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).deferredTy
	end 'deferred'
	let thrown = ast.replyErrorOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method))
	let replies = reply != p.builtins.voidTy or thrown != ast.noType
	info.replyKept = replies and c.discardedSend != call
	let kept = info.replyKept
	c.typing.calls.insert(call as Count, value: info)
	if ast.hasGenericPolicy(ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, nt: ast.typeEntry(ms.types, reads: p.types, t: state).effectiveOrigin()) 'policies'
		// The send runs the instances of its type's generic policies, which are found where the send is (ir.notePolicies).
		recordUse(c, call: call)
	end 'policies'
	if not kept 'noReply'
		return p.builtins.voidTy
	end 'noReply'
	c.partyWaitNow = true
	return replyPromise(c, p: p, ms: ms, call: call, reply: reply, thrown: ast.awaitErrorOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method)), errs: errs)
end 'callSend'

// The stops a message asks of its own service (README, "Stops"): `self.stop()` closes its mailbox as a shutdown does, and
// `self.stopNow()`, for a type that implements StopsNow, ends it at once. A type that declares a method of either name keeps
// the name for its own. Each is a call of the built-in floor of its name, which stops the service whose message runs.
let stopMethod = "stop"

let stopNowMethod = "stopNow"

let stopFloor = "serviceStop"

let stopNowFloor = "serviceStopNow"

// isSelfStop is whether a call that names no method of its receiver's type, content, is `self.stop()` or `self.stopNow()` in
// a message of that type.
function isSelfStop(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, content ast.TypeID, name String) returns bool
	if name != stopMethod and name != stopNowMethod 'other'
		return false
	end 'other'
	let callee = ast.callExprCallee(ms.tree(), id: call)
	if ms.tree().kindOf(callee) != ast.NodeKind.memberExpr or ms.tree().kindOf(ast.memberExprObj(ms.tree(), id: callee)) != ast.NodeKind.selfExpr 'notSelf'
		return false
	end 'notSelf'
	if c.fn == ast.noFunc or not isMessage(p, ms: ms, method: c.fn) 'notMessage'
		return false
	end 'notMessage'
	let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).ownerTy
	return owner != ast.noType and ast.typeEntry(ms.types, reads: p.types, t: owner).effectiveOrigin() == ast.typeEntry(ms.types, reads: p.types, t: content).effectiveOrigin()
end 'isSelfStop'

// callSelfStop types `self.stop()` or `self.stopNow()` in a message of the type content.
function callSelfStop(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, content ast.TypeID, name String, mutates errs diag.ErrorList) returns ast.TypeID
	if name == stopNowMethod and not requireStopsNow(c, p: p, ms: ms, node: call, state: content, errs: errs) 'undeclared'
		return ast.noType
	end 'undeclared'
	let floor = methodNamed(p, ms: ms, t: p.builtins.builtinsTy, name: stopFloor if name == stopMethod else stopNowFloor)
	if floor == ast.noFunc 'missing'
		panic("check: the built-ins have no floor of {name}")
	end 'missing'
	let typed = callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callStatic, target: floor, hasGiven: false, given: ast.TypeIDList.create(0), errs: errs)
	if typed != ast.noType and ast.endsAtStop(p, tt: ms.types, reads: p.types, nt: content) 'stop'
		noteStateEnd(c, p: p, ms: ms, call: call, state: content)
		// The behaviour is queued on the service whose message stops it, a handle of the type.
		let handle = serviceHandleType(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: call), state: content, errs: errs)
		var info = match consumes c.typing.calls.get(call as Count) 'info'
			some(i) gives i
			none panic("check: a stop was typed without a record of what it calls")
		end 'info'
		info.receiverTy = handle
		c.typing.calls.insert(call as Count, value: info)
	end 'stop'
	return typed
end 'callSelfStop'

// noteStateEnd gives a stop of a service whose state can hold a Reply, or whose type implements Ends, the behaviour that
// ends the state once the queued messages have run (ir.endState): its finish closes what it holds, and the Replies it holds
// fail their senders' awaits then, as maxon's do when the service finishes, rather than when its last handle goes.
function noteStateEnd(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, state ast.TypeID)
	if not ast.endsAtStop(p, tt: ms.types, reads: p.types, nt: state) 'none'
		return
	end 'none'
	var info = match consumes c.typing.calls.get(call as Count) 'info'
		some(i) gives i
		none panic("check: a stop was typed without a record of what it calls")
	end 'info'
	info.body = serviceBody(c, p: p, ms: ms, node: call)
	c.typing.calls.insert(call as Count, value: info)
end 'noteStateEnd'

// writesSelfStop is whether a call of a raw floor is `self.stop()` or `self.stopNow()`, which callSelfStop made a call of its
// floor: the program writes the stop, never the floor.
function writesSelfStop(ms ast.ModuleState, call ast.NodeID, target ast.Intrinsic) returns bool
	if target != ast.Intrinsic.intrServiceStopSelf and target != ast.Intrinsic.intrServiceStopNowSelf 'other'
		return false
	end 'other'
	let callee = ast.callExprCallee(ms.tree(), id: call)
	return ms.tree().kindOf(callee) == ast.NodeKind.memberExpr and ms.tree().kindOf(ast.memberExprObj(ms.tree(), id: callee)) == ast.NodeKind.selfExpr
end 'writesSelfStop'

// callStopped types `h.stopped()`, a promise of no value that the service's end completes, which a task awaits and a message
// never does, since it waits on another party.
function callStopped(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, handle ast.TypeID, own ast.FuncID, mutates errs diag.ErrorList) returns ast.TypeID
	if callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callMethod, target: own, hasGiven: true, given: ast.typeEntry(ms.types, reads: p.types, t: handle).typeArgs.clone(), errs: errs) == ast.noType 'failed'
		return ast.noType
	end 'failed'
	c.partyWaitNow = true
	var args = ast.TypeIDList.create(0)
	args.push(p.builtins.voidTy)
	args.push(p.builtins.voidTy)
	return instantiateGeneric(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: call), orig: p.builtins.promiseOrigin, args: args, errs: errs)
end 'callStopped'

// Posted messages (README, "Stops"; out/dev/step3-readiness-design.md): a message the runtime posts to a service, which no
// sender awaits, named by a value of the service's message union, `Sup.Message.childStopped(id)`. `h.post(m)` makes it, the
// library's PostedMessage, which every source of such a message takes: `child.notifyStopped(h.post(m))` posts m to the service
// of h once the child has ended. The message must be a value of the service's own union (E3954), and the kind it names must
// give no reply, since nobody awaits it (E3955): a kind written as a case of the union is its case's, and a value of any other
// form may be any case of it, so every one must be.

// callNotifyStopped types `child.notifyStopped(message)`, whose message is a PostedMessage, which moves in.
function callNotifyStopped(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, handle ast.TypeID, own ast.FuncID, mutates errs diag.ErrorList) returns ast.TypeID
	let argsRef = ast.callExprArgsRef(ms.tree(), id: call)
	if ms.tree().listLen(argsRef) != 1 'arity'
		failAt(c, p: p, ms: ms, node: call, code: diag.errCallArgCountMismatch, msg: "'notifyStopped' takes the message to post once the service ends, as 'child.notifyStopped(self.handle.post(Sup.Message.childStopped(id)))'", errs: errs)
		return ast.noType
	end 'arity'
	let posted = postedMessageType(p, ms: ms)
	if posted == ast.noType 'noLibrary'
		failAt(c, p: p, ms: ms, node: call, code: diag.errPostedMessageOfOtherType, msg: "'notifyStopped' takes the library's PostedMessage, which this project does not have", errs: errs)
		return ast.noType
	end 'noLibrary'
	var specs = ast.ParamSpecList.create(0)
	specs.push(ast.ParamSpec.make("message", ty: posted, conv: ast.Convention.convConsumes))
	let callee = funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: own)
	let mark = errs.count()
	let ordered = bindArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: 1 as Count, argsChecked: false, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'badArgs'
		return ast.noType
	end 'badArgs'
	var info = ast.CallInfo.make(ast.CallKind.callMethod, fn: own, receiverTy: handle)
	info.paramSpecs = specs.clone()
	info.ordered = ordered
	info.intrinsic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: own).intrinsic
	info.typeArgs = ast.typeEntry(ms.types, reads: p.types, t: handle).typeArgs.clone()
	c.typing.calls.insert(call as Count, value: info)
	return p.builtins.voidTy
end 'callNotifyStopped'

// callPost types `h.post(m)`, a message to post to the service of h later, which a source of posted messages takes: the
// library's PostedMessage. m is a value of the service's own message union, of a kind that gives no reply.
function callPost(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, handle ast.TypeID, own ast.FuncID, mutates errs diag.ErrorList) returns ast.TypeID
	let argsRef = ast.callExprArgsRef(ms.tree(), id: call)
	if ms.tree().listLen(argsRef) != 1 'arity'
		failAt(c, p: p, ms: ms, node: call, code: diag.errCallArgCountMismatch, msg: "'post' takes the message to post the service, as 'self.handle.post(Sup.Message.childStopped(id))'", errs: errs)
		return ast.noType
	end 'arity'
	// A posted message is a value of the message union of the service's own type, which an interface handle does not name.
	if ast.isInterfaceHandle(ms.types, reads: p.types, t: handle) 'interface'
		let handleName = nameOfType(p, ms: ms, t: handle)
		failAt(c, p: p, ms: ms, node: call, code: diag.errPostedMessageOfOtherType, msg: "a message posted to a service is a value of its own type's message union, which '{handleName}' does not name: post through the service's own handle, as 'self.handle.post(Sup.Message.childStopped(id))'", errs: errs)
		return ast.noType
	end 'interface'
	let messages = postedUnion(c, p: p, ms: ms, node: call, handle: handle, errs: errs)
	if messages == ast.noType 'noUnion'
		return ast.noType
	end 'noUnion'
	let messageArg = ast.argValue(ms.tree(), id: ms.tree().listAt(argsRef, index: 0 as Count) as ast.NodeID)
	if not checkPostedMessage(c, p: p, ms: ms, e: messageArg, handle: handle, messages: messages, errs: errs) 'badMessage'
		return ast.noType
	end 'badMessage'
	let posted = postedMessageType(p, ms: ms)
	if posted == ast.noType 'noLibrary'
		failAt(c, p: p, ms: ms, node: call, code: diag.errPostedMessageOfOtherType, msg: "'post' gives the library's PostedMessage, which this project does not have", errs: errs)
		return ast.noType
	end 'noLibrary'
	var specs = ast.ParamSpecList.create(0)
	specs.push(ast.ParamSpec.make("message", ty: messages, conv: ast.Convention.convConsumes))
	if recordPosting(c, p: p, ms: ms, call: call, handle: handle, own: own, specs: specs, errs: errs) == ast.noType 'failed'
		return ast.noType
	end 'failed'
	return posted
end 'callPost'

// postedMessageType is the library's PostedMessage, which `h.post(m)` gives, or noType where the project has no library.
function postedMessageType(p ast.Project, ms ast.ModuleState) returns ast.TypeID
	let found = ast.libraryModuleNamed(p, name: ast.libraryServiceModule)
	if not found.isSome() 'none'
		return ast.noType
	end 'none'
	let library = found.unwrap()
	return match consumes p.modules[ast.modIndex(library)].names.get(ast.libraryPostedName) 'name'
		some(o) gives match consumes ast.declType(p, ms: ms, ref: ast.DeclRef.make(library, ordinal: o)) 'type'
			some(t) gives t
			none gives ast.noType
		end 'type'
		none gives ast.noType
	end 'name'
end 'postedMessageType'

// postedUnion is the message union of the service of a handle, which a message posted to it is a value of: the union its
// module declares where it names it, `Sup.Message`. A type whose module names none has none (E3954).
function postedUnion(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID, handle ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let state = ast.serviceState(ms.types, reads: p.types, t: handle)
	let decl = ast.typeEntry(ms.types, reads: p.types, t: state).effectiveOrigin()
	let messages = ast.messageUnionOf(p, ms: ms, nt: decl)
	if messages == ast.noType 'none'
		let stateName = nameOfType(p, ms: ms, t: state)
		failAt(c, p: p, ms: ms, node: node, code: diag.errPostedMessageOfOtherType, msg: "a message posted to '{stateName}' is a value of its message union, '{stateName}.Message', which its module names where it makes one: write the message as '{stateName}.Message.kind(...)'", errs: errs)
	end 'none'
	return messages
end 'postedUnion'

// checkPostedMessage types the message a registration posts to the service of a handle: a value of that service's message
// union (E3954), whose kind gives no reply (E3955). A kind written as a case of the union is that case; any other value may be
// any case of it. The kinds it may be are kept as posted, for the fed-from-outside rule.
function checkPostedMessage(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, handle ast.TypeID, messages ast.TypeID, mutates errs diag.ErrorList) returns bool
	let t = checkExpr(c, p: p, ms: ms, e: e, errs: errs)
	if t == ast.noType 'failed'
		return false
	end 'failed'
	let state = ast.serviceState(ms.types, reads: p.types, t: handle)
	let stateName = nameOfType(p, ms: ms, t: state)
	if ast.typeEntry(ms.types, reads: p.types, t: t).effectiveOrigin() != ast.typeEntry(ms.types, reads: p.types, t: messages).effectiveOrigin() 'other'
		failAt(c, p: p, ms: ms, node: e, code: diag.errPostedMessageOfOtherType, msg: "the message posted to '{stateName}' is a '{nameOfType(p, ms: ms, t: t)}', and a service is posted only a value of its own message union, '{stateName}.Message': name a kind of '{stateName}', or post to the service the message is of", errs: errs)
		return false
	end 'other'
	let decl = ast.typeEntry(ms.types, reads: p.types, t: state).effectiveOrigin()
	let named = writtenCase(c, ms: ms, e: e)
	let cases = ast.typeEntry(ms.types, reads: p.types, t: messages).cases.count()
	var posted = PostedKindList.create(0)
	for i in 0 upto cases 'cases'
		if named != noWrittenCase and named != i 'otherCase'
			continue 'cases'
		end 'otherCase'
		let kind = ast.typeEntry(ms.types, reads: p.types, t: messages).cases[i].name.clone()
		let handler = methodNamed(p, ms: ms, t: decl, name: kind)
		if handler != ast.noFunc and ast.hasReply(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: handler), voidTy: p.builtins.voidTy) 'replies'
			let which = "'{stateName}.{kind}'" if named != noWrittenCase else "'{stateName}.{kind}', a kind the message may be,"
			failAt(c, p: p, ms: ms, node: e, code: diag.errPostedKindReplies, msg: "{which} returns or throws, and nobody awaits a message the runtime posts: post a kind whose handler returns nothing and throws nothing, and send its answer on as a message of its own", errs: errs)
			return false
		end 'replies'
		if handler != ast.noFunc 'handled'
			posted.push(PostedKind.make(e, kind: declaredFunc(p, ms: ms, f: handler)))
		end 'handled'
	end 'cases'
	// The kinds a post names are fed from outside (policies.maxon).
	c.posted.append(posted)
	return true
end 'checkPostedMessage'

let noWrittenCase = 0xFFFFFFFF as Count

// writtenCase is the case of a message union that a value is written as, `Sup.Message.childStopped(id)` or a case with no
// payload, or noWrittenCase for any other form.
function writtenCase(c Checker, ms ast.ModuleState, e ast.NodeID) returns Count
	let k = ms.tree().kindOf(e)
	if k == ast.NodeKind.callExpr and c.typing.calls.has(e as Count) 'call'
		let info = c.typing.calls.get(e as Count).unwrap()
		if info.kind == ast.CallKind.callUnionCtor 'ctor'
			return info.unionCase
		end 'ctor'
	end 'call'
	if k == ast.NodeKind.memberExpr and c.typing.members.has(e as Count) 'member'
		let member = c.typing.members.get(e as Count).unwrap()
		if member.kind == ast.MemberKind.memberUnionCase 'case'
			return member.enumCase
		end 'case'
	end 'member'
	return noWrittenCase
end 'writtenCase'

// recordPosting records a call of post, whose message was typed already: it moves in, and the call has the behaviour of the
// posted message as its body.
function recordPosting(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, handle ast.TypeID, own ast.FuncID, specs ast.ParamSpecList, mutates errs diag.ErrorList) returns ast.TypeID
	let callee = funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: own)
	let mark = errs.count()
	let ordered = bindArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: 1 as Count, argsChecked: true, payload: false, errs: errs)
	if failedSince(errs, mark: mark) 'badArgs'
		return ast.noType
	end 'badArgs'
	var info = ast.CallInfo.make(ast.CallKind.callMethod, fn: own, receiverTy: handle)
	info.paramSpecs = specs.clone()
	info.ordered = ordered
	info.intrinsic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: own).intrinsic
	info.typeArgs = ast.typeEntry(ms.types, reads: p.types, t: handle).typeArgs.clone()
	info.body = serviceBody(c, p: p, ms: ms, node: call)
	c.typing.calls.insert(call as Count, value: info)
	return p.builtins.voidTy
end 'recordPosting'

// requireStopsNow refuses a stopNow() of a service whose type does not implement StopsNow (E3952): the senders of such a type
// await its replies as if its queued messages always ran, which stopNow() would drop.
function requireStopsNow(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, state ast.TypeID, mutates errs diag.ErrorList) returns bool
	if ast.stopsNow(p, tt: ms.types, reads: p.types, nt: state) 'declared'
		return true
	end 'declared'
	let stateName = nameOfType(p, ms: ms, t: state)
	if ast.typeKind(ms.types, reads: p.types, t: state) == ast.TypeKind.interfaceTy 'interface'
		failAt(c, p: p, ms: ms, node: node, code: diag.errStopNowUndeclared, msg: "stopNow() would drop the messages queued on the service behind '{stateName}.handle', whose senders through it await their replies as if they always ran, since no requirement of '{stateName}' fails with serviceStopped: stop it at once through its own handle, whose type implements StopsNow, or with shutdown(), which runs the queued messages first", errs: errs)
		return false
	end 'interface'
	failAt(c, p: p, ms: ms, node: node, code: diag.errStopNowUndeclared, msg: "stopNow() would drop the messages queued on '{stateName}', whose senders await their replies as if they always ran, since '{stateName}' does not implement StopsNow: declare 'type {stateName} implements StopsNow', which tells each await of its replies that it may fail with serviceStopped, or stop it with shutdown() (self.stop() in a message), which runs the queued messages first", errs: errs)
	return false
end 'requireStopsNow'

// isMessage is whether a method is a message: an export or public instance method.
function isMessage(p ast.Project, ms ast.ModuleState, method ast.FuncID) returns bool
	if method == ast.noFunc or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).isStatic 'none'
		return false
	end 'none'
	return ast.visibilityOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).visibility) != ast.Visibility.unexported
end 'isMessage'

// requireNoFrozenContents refuses an argument that lends the contents of a frozen value to a parameter of the type it
// holds: a send moves its arguments, and the contents are the frozen value's, never the sender's to give.
function requireNoFrozenContents(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, info ast.CallInfo, mutates errs diag.ErrorList) returns bool
	for i in 0 upto info.ordered.count() 'args'
		let arg = info.ordered[i]
		if arg != 0 and lendsContents(p, ms: ms, t: ast.nodeType(c.typing, node: arg), want: info.paramSpecs[i].ty) 'lends'
			failAt(c, p: p, ms: ms, node: arg, code: diag.errNotSendable, msg: "the parameter '{info.paramSpecs[i].name}' of a message takes a '{nameOfType(p, ms: ms, t: info.paramSpecs[i].ty)}', which moves into the service, and the contents of a frozen value are lent, never given: send a copy, 'thaw(...)', or declare the parameter 'frozen with {nameOfType(p, ms: ms, t: info.paramSpecs[i].ty)}' to share it", errs: errs)
			return false
		end 'lends'
	end 'args'
	return true
end 'requireNoFrozenContents'

// requireService checks, once for each type a module spawns, what maxon checks at the spawn that makes the type a service:
// its state holds no promise (E3216) and reaches no handle to its own service (E4014), and each of its messages and the
// factory carry only what can cross (E3217, E3140). It is false when it refused something.
function requireService(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, state ast.TypeID, factory ast.FuncID, mutates errs diag.ErrorList) returns bool
	let stateName = nameOfType(p, ms: ms, t: state)
	if ast.typeKind(ms.types, reads: p.types, t: state) != ast.TypeKind.record or ast.typeEntry(ms.types, reads: p.types, t: state).typeArgs.count() > 0 'notRecord'
		failAt(c, p: p, ms: ms, node: e, code: diag.errUnsupportedFeature, msg: "'{stateName}' is not a type declared with 'type' and no type parameters, and only such a type can be a service yet", errs: errs)
		return false
	end 'notRecord'
	let mark = errs.count()
	requireCrossingParams(c, p: p, ms: ms, e: e, what: "the factory '{ast.funcEntry(ms.funcs, funcReads: p.funcs, f: factory).name}'", fn: factory, errs: errs)
	if holdsType(c.servicesChecked, t: state) 'checked'
		return not failedSince(errs, mark: mark)
	end 'checked'
	c.servicesChecked.push(state)
	var visiting = ast.TypeIDList.create(0)
	if holdsPromise(p, ms: ms, t: state, visiting: visiting) 'promise'
		failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStatePromise, msg: "the state of the service '{stateName}' holds a promise, and each message may run on another green thread while a coroutine belongs to the strand that started it: await the coroutine in the message that starts it, and keep its result", errs: errs)
	end 'promise'
	requireEnds(c, p: p, ms: ms, e: e, state: state, errs: errs)
	var path = ast.StringList.create(0)
	var visited = BoolIntMap.new()
	if reachesThroughCown(p, ms: ms, from: state, target: state, via: false, services: true, path: path, visited: visited) 'cycle'
		failAt(c, p: p, ms: ms, node: e, code: diag.errTypeCycle, msg: "the state of the service '{stateName}' reaches a handle to its own service (via {ast.joinNames(path, sep: " -> ")}), which would keep the service alive for ever: pass the handle with each message that needs it instead", errs: errs)
	end 'cycle'
	let orig = ast.originOf(ms.types, reads: p.types, t: state)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).methods.count() 'methods'
		let method = ast.typeEntry(ms.types, reads: p.types, t: orig).methods[i].func
		if isMessage(p, ms: ms, method: method) 'message'
			requireMessage(c, p: p, ms: ms, e: e, method: method, errs: errs)
		end 'message'
	end 'methods'
	return not failedSince(errs, mark: mark)
end 'requireService'

// requireEnds refuses a service whose state holds a value that cannot be dropped, an open file or a socket, where its type
// does not implement Ends (E3956): the service would drop that value when it stops, which only its destructor may end. The
// type's own module is told at the type's declaration, with the fix that declares it Ends and writes its finish, which ends
// each such field where it has one way to end that takes nothing; another module is told at the spawn.
function requireEnds(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, state ast.TypeID, mutates errs diag.ErrorList)
	if ast.ends(p, tt: ms.types, reads: p.types, nt: state) 'declared'
		return
	end 'declared'
	let lacking = lacksCap(c, p: p, ms: ms, wantCopy: false, t: state)
	if not lacking.missing 'droppable'
		return
	end 'droppable'
	let stateName = nameOfType(p, ms: ms, t: state)
	let why = lackWhyText(ms.types, reads: p.types, info: lacking, capName: "Droppable")
	let msg = "the state of the service '{stateName}' cannot be dropped ({why}), so the service cannot end it when it stops: declare 'type {stateName} implements Ends' and its 'function finish(consumes self)', which is given the state once the service has stopped, and end each such field there"
	let orig = ast.originOf(ms.types, reads: p.types, t: state)
	let hasDecl = ast.typeEntry(ms.types, reads: p.types, t: orig).hasDecl
	let ref = ast.typeEntry(ms.types, reads: p.types, t: orig).decl.clone()
	if not hasDecl or ref.module != ms.module 'elsewhere'
		failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg, errs: errs)
		return
	end 'elsewhere'
	match ast.moduleDecl(p, ref: ref) 'declared'
		typeDecl(td) then endsAtDecl(c, p: p, ms: ms, state: state, td: td, msg: msg, errs: errs)
		funcDecl(_) then failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg.clone(), errs: errs)
		constDecl(_) then failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg.clone(), errs: errs)
		enumDecl(_) then failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg.clone(), errs: errs)
		unionDecl(_) then failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg.clone(), errs: errs)
		aliasDecl(_) then failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg.clone(), errs: errs)
		interfaceDecl(_) then failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg.clone(), errs: errs)
		extensionDecl(_) then failAt(c, p: p, ms: ms, node: e, code: diag.errServiceStateNotEnded, msg: msg.clone(), errs: errs)
	end 'declared'
end 'requireEnds'

// endsAtDecl is E3956 at the declaration of the state type, with its fix.
function endsAtDecl(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, state ast.TypeID, td ast.TypeDecl, msg String, mutates errs diag.ErrorList)
	let fix = endsFix(c, p: p, ms: ms, state: state, td: td)
	diag.pushFixedError(errs, code: diag.errServiceStateNotEnded, message: msg.clone(), module: c.modID, offset: offsetOf(c, p: p, ms: ms, node: td.id), fix: fix)
end 'endsAtDecl'

// endsFix declares the state type of a service Ends and writes its finish, whose body ends each field that cannot be dropped
// where its type has one way to end it that takes nothing (endingOf): `try self.out.close() otherwise ignore` for a
// FileWriter. A field with no such way is left for the author, whom E3919 then shows the field.
function endsFix(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, state ast.TypeID, td ast.TypeDecl) returns diag.Fix
	var calls = ast.StringList.create(0)
	let orig = ast.originOf(ms.types, reads: p.types, t: state)
	for f in ast.typeEntry(ms.types, reads: p.types, t: orig).fields.clone() 'fields'
		let fTy = ast.fieldType(ms.types, reads: p.types, owner: state, index: f.index)
		if not ast.isManagedType(ms.types, reads: p.types, t: fTy) or not lacksCap(c, p: p, ms: ms, wantCopy: false, t: fTy).missing 'droppable'
			continue 'fields'
		end 'droppable'
		match consumes endingOf(c, p: p, ms: ms, t: fTy, depth: 1) 'ending'
			some(ending) then calls.push(endingCall("self.{f.name}", ending: ending))
			none then _ = 0
		end 'ending'
	end 'fields'
	return endsDeclFix(ms.tree(), td: td, calls: calls)
end 'endsFix'

// requireMessage checks a message: it takes its state as let or mutates, takes only what can cross, and replies with what
// can cross.
function requireMessage(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, method ast.FuncID, mutates errs diag.ErrorList)
	let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).name.clone()
	let what = "the message '{name}'"
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).generics.count() > 0 'generic'
		failAt(c, p: p, ms: ms, node: e, code: diag.errUnsupportedFeature, msg: "{what} has type parameters of its own, and a message is not generic yet", errs: errs)
		return
	end 'generic'
	let selfConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).selfConv
	if selfConv != ast.Convention.convLet and selfConv != ast.Convention.convMutates 'consumesSelf'
		failAt(c, p: p, ms: ms, node: e, code: diag.errNotSendable, msg: "{what} takes its receiver as {selfConv.keyword()}, and a message is given the service's state, which it may read or change but never take: declare it 'mutates self', or leave the receiver as it is", errs: errs)
	end 'consumesSelf'
	requireCrossingParams(c, p: p, ms: ms, e: e, what: what, fn: method, errs: errs)
	let reply = ast.replyTypeOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method))
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).result != ast.ResultConv.resultOwned 'borrowed'
		failAt(c, p: p, ms: ms, node: e, code: diag.errReplyNotCarriable, msg: "{what} returns a borrowed place, and a reply moves out of the service to the sender: return a value", errs: errs)
		return
	end 'borrowed'
	let replyWhy = unsendable(p, ms: ms, t: reply)
	if replyWhy != "" 'reply'
		failAt(c, p: p, ms: ms, node: e, code: diag.errReplyNotCarriable, msg: "{what} replies with a '{nameOfType(p, ms: ms, t: reply)}', which cannot cross back to the sender: {replyWhy}; reply with the value it is derived from", errs: errs)
	end 'reply'
	let thrown = ast.replyErrorOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method))
	if thrown != ast.noType 'throws'
		let thrownWhy = unsendable(p, ms: ms, t: thrown)
		if thrownWhy != "" 'error'
			failAt(c, p: p, ms: ms, node: e, code: diag.errReplyNotCarriable, msg: "{what} throws a '{nameOfType(p, ms: ms, t: thrown)}', which cannot cross back to the sender: {thrownWhy}", errs: errs)
		end 'error'
	end 'throws'
end 'requireMessage'

// requireCrossingParams refuses a parameter of a factory or a message that does not take what crosses into the service:
// one that borrows to change or initialise (mutates, sets), and one of a type that cannot cross.
function requireCrossingParams(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, what String, fn ast.FuncID, mutates errs diag.ErrorList)
	for i in 0 upto ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).params.count() 'params'
		let param = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).params[i].clone()
		if param.conv != ast.Convention.convLet and param.conv != ast.Convention.convConsumes 'byAddress'
			failAt(c, p: p, ms: ms, node: e, code: diag.errNotSendable, msg: "the parameter '{param.name}' of {what} is {param.conv.keyword()}, and nothing is lent to a service, which runs after the sender's frame may be gone: take the value, and reply with what changed", errs: errs)
			continue 'params'
		end 'byAddress'
		let why = unsendable(p, ms: ms, t: param.ty)
		if why != "" 'unsendable'
			failAt(c, p: p, ms: ms, node: e, code: diag.errNotSendable, msg: "the parameter '{param.name}' of {what} takes a '{nameOfType(p, ms: ms, t: param.ty)}', which cannot cross into a service: {why}; send a value the service owns from then on, or share a 'frozen with T'", errs: errs)
		end 'unsendable'
	end 'params'
end 'requireCrossingParams'

// unsendable is why a value of type t cannot cross into or out of a service, or "" when it can: the rule of what crosses
// between threads, ast.unsendableToService.
export function unsendable(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns String
	return ast.unsendableToService(ms.types, reads: p.types, t: t)
end 'unsendable'

// holdsPromise is whether a value of type t is or holds a promise, at any depth but through a cown or a handle, whose
// value is another service's or another behaviour's.
function holdsPromise(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, mutates visiting ast.TypeIDList) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	if kind == ast.TypeKind.builtinPromise 'promise'
		return true
	end 'promise'
	if holdsType(visiting, t: t) or kind == ast.TypeKind.builtinCown or kind == ast.TypeKind.builtinService 'elsewhere'
		return false
	end 'elsewhere'
	visiting.push(t)
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	var held = ast.TypeIDList.create(0)
	if kind == ast.TypeKind.record 'record'
		for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).fields.count() 'fields'
			held.push(ast.fieldType(ms.types, reads: p.types, owner: t, index: i))
		end 'fields'
	end 'record' else if kind == ast.TypeKind.unionTy 'union'
		for ci in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() 'cases'
			for pi in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload.count() 'payload'
				held.push(ast.payloadType(ms.types, reads: p.types, owner: t, caseIndex: ci, index: pi))
			end 'payload'
		end 'cases'
	end 'union' else if kind.isBuiltin() 'builtin'
		held = ast.typeEntry(ms.types, reads: p.types, t: t).typeArgs.clone()
	end 'builtin'
	var found = false
	for i in 0 upto held.count() 'each'
		if holdsPromise(p, ms: ms, t: held[i], visiting: visiting) 'hit'
			found = true
			break 'each'
		end 'hit'
	end 'each'
	_ = try visiting.pop() otherwise panic("check: a type left that was never visited")
	return found
end 'holdsPromise'

// verifyHolders is E3221 for each message, and each factory, of a type that the module spawns, that may wait on another
// party: it holds its service while it waits, so two services that wait on each other would wait for ever. What a function
// of another module may wait for is what its module published; a call through a function value or an interface, whose
// target the check cannot see, is taken to wait on another party. A type of the module is refused at the message, and one
// of another module, whose check may not spawn it, at the spawn that makes it a service here.
function verifyHolders(mutates c Checker, p ast.Project, ms ast.ModuleState, mutates errs diag.ErrorList)
	for i in 0 upto c.spawned.count() 'services'
		let orig = ast.originOf(ms.types, reads: p.types, t: c.spawned[i])
		let own = ast.typeEntry(ms.types, reads: p.types, t: orig).decl.module == c.modID
		for j in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).methods.count() 'methods'
			let method = ast.typeEntry(ms.types, reads: p.types, t: orig).methods[j].func
			let entry = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).clone()
			let factory = entry.isStatic and entry.retTy == c.spawned[i]
			if not isMessage(p, ms: ms, method: method) and not factory 'other'
				continue 'methods'
			end 'other'
			var visited = BoolIntMap.new()
			if not mayWaitOnParty(c, p: p, ms: ms, f: method, visited: visited) 'never'
				continue 'methods'
			end 'never'
			let kind = "factory" if factory and not isMessage(p, ms: ms, method: method) else "message"
			let fix = "send the request with this service's handle and handle the reply in another message, and call through a function value or an interface only what a message may wait for"
			if own 'atMessage'
				checkFail(c.modID, off: ms.tree().startOf(entry.nodeID), code: diag.errHolderMayWait, msg: "the {kind} '{entry.name}' may wait on another party (it awaits a reply from a service, starts one whose factory throws, or calls what may, or what the check cannot see) while holding its own service; {fix}", errs: errs)
			end 'atMessage' else 'atSpawn'
				checkFail(c.modID, off: ms.tree().reportStartOf(c.spawnSites[i]), code: diag.errHolderMayWait, msg: "this spawn makes '{nameOfType(p, ms: ms, t: c.spawned[i])}' a service, and its {kind} '{entry.name}' may wait on another party (it awaits a reply from a service, starts one whose factory throws, or calls what may, or what the check cannot see) while holding the service; {fix}", errs: errs)
			end 'atSpawn'
		end 'methods'
	end 'services'
end 'verifyHolders'

// requireReplyHandled refuses a send whose reply is neither awaited, kept nor dropped on purpose: maxon's E3190, for the
// call that a statement makes.
function requireReplyHandled(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, mutates errs diag.ErrorList)
	if ms.tree().kindOf(call) != ast.NodeKind.callExpr 'notCall'
		return
	end 'notCall'
	let info = match consumes c.typing.calls.get(call as Count) 'info'
		some(i) gives i
		none gives ast.CallInfo.make(ast.CallKind.callUnresolved, fn: ast.noFunc, receiverTy: ast.noType)
	end 'info'
	if info.kind == ast.CallKind.callSend and info.replyKept 'replies'
		let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).name.clone()
		failAt(c, p: p, ms: ms, node: call, code: diag.errReplyDropped, msg: "the message '{name}' replies, and its reply is neither awaited nor kept: await it with 'try await', keep it with 'let p = try ...', or drop it on purpose with '_ = try ...'", errs: errs)
	end 'replies'
end 'requireReplyHandled'

// discardedCall is the call whose value a discard drops, through the try around it, or none.
function discardedCall(tree ast.Tree, value ast.NodeID) returns ast.NodeID
	var e = value
	if tree.kindOf(e) == ast.NodeKind.tryExpr 'try'
		e = ast.tryExprE(tree, id: e)
	end 'try'
	if tree.kindOf(e) == ast.NodeKind.callExpr 'call'
		return e
	end 'call'
	return 0 as ast.NodeID
end 'discardedCall'
