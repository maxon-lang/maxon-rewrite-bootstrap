export typealias LocalScope = table.StringMap with ast.LocalID

export typealias ScopeList = Array with LocalScope

export typealias LackMap = table.StringMap with LackInfo

export typealias VisitMap = table.StringMap with bool

export typealias BoolIntMap = table.IntMap with bool

export typealias ModConstList = Array with ast.ConstValue

export type PendingCall
	export var modID as diag.ModuleID
	export var callNode as ast.NodeID
	export var calleeName as String
	export var fnID as ast.FuncID
	export var params as ast.ParamSpecList
	export var hasOmittedArg as bool
	export var omittedArgIdx as Count

	export static function make(modID diag.ModuleID, callNode ast.NodeID, consumes calleeName String, fnID ast.FuncID, consumes params ast.ParamSpecList, hasOmittedArg bool, omittedArgIdx Count) returns PendingCall
		return PendingCall{modID: modID, callNode: callNode, calleeName: calleeName, fnID: fnID, params: params, hasOmittedArg: hasOmittedArg, omittedArgIdx: omittedArgIdx}
	end 'make'
end 'PendingCall'

export typealias PendingCallList = Array with PendingCall

export type PendingBound
	export var modID as diag.ModuleID
	export var off as diag.U32
	export var paramTy as ast.TypeID
	export var argTy as ast.TypeID
	export var ifaceTy as ast.TypeID
	export var withinFn as ast.FuncID
	// inFn is the function whose body gives the type arguments, where the fix of an argument that lacks a bound writes it.
	export var inFn as ast.FuncID
	export var hasMethod as bool
	export var methodFn as ast.FuncID
	// receiverTy is, for a bound that the 'where' of a conditional extension gives, the type of the value the method is
	// called on; none for any other bound.
	export var receiverTy as ast.TypeID

	export static function make(modID diag.ModuleID, off diag.U32, paramTy ast.TypeID, argTy ast.TypeID, ifaceTy ast.TypeID, withinFn ast.FuncID, inFn ast.FuncID, hasMethod bool, methodFn ast.FuncID) returns PendingBound
		return PendingBound{modID: modID, off: off, paramTy: paramTy, argTy: argTy, ifaceTy: ifaceTy, withinFn: withinFn, inFn: inFn, hasMethod: hasMethod, methodFn: methodFn, receiverTy: ast.noType}
	end 'make'
end 'PendingBound'

export typealias PendingBoundList = Array with PendingBound

export type BlockFrame
	export var label as String
	export var isLoop as bool
	export var node as ast.NodeID
	// isParallel is whether the block is a parallel for's body, whose own variables are firstInner and those after it; walked
	// is the variable whose elements it lends to be changed, which the body may not name, or none; refused are the variables
	// from around it that the body was refused to read, each reported once.
	export var isParallel as bool
	export var firstInner as ast.LocalID
	export var walked as ast.LocalID
	export var refused as ast.LocalIDList

	export static function make(consumes label String, isLoop bool, node ast.NodeID) returns BlockFrame
		return BlockFrame{label: label, isLoop: isLoop, node: node, isParallel: false, firstInner: ast.noLocal, walked: ast.noLocal, refused: ast.LocalIDList.create(0)}
	end 'make'
end 'BlockFrame'

export typealias BlockFrameList = Array with BlockFrame

// OuterLevel is a function whose body encloses the body being checked, a behaviour's or a closure's. hasBehaviour is
// whether it is itself such a body, and closure whether that body is a closure's.
export type OuterLevel
	export var fn as ast.FuncID
	export var scopes as ScopeList
	export var blocks as BlockFrameList
	export var nextSlot as Count
	export var whens as Count
	export var hasBehaviour as bool
	export var closure as bool
	export var behIdx as Count
	export var fnLocals as ast.LocalIDList
	export var tries as TryFrameList

	export static function make(fn ast.FuncID, consumes scopes ScopeList, consumes blocks BlockFrameList, nextSlot Count, whens Count, hasBehaviour bool, behIdx Count, consumes fnLocals ast.LocalIDList, consumes tries TryFrameList) returns OuterLevel
		return OuterLevel{fn: fn, scopes: scopes, blocks: blocks, nextSlot: nextSlot, whens: whens, hasBehaviour: hasBehaviour, closure: false, behIdx: behIdx, fnLocals: fnLocals, tries: tries}
	end 'make'
end 'OuterLevel'

// BehaviourFrame is the body of a behaviour or of a closure being checked, and what it captured. A closure has no
// accesses; mutatesCaptures is whether it is written for a function type that mutates its captures.
export type BehaviourFrame
	export var fn as ast.FuncID
	export var isClosure as bool
	export var mutatesCaptures as bool
	export var accesses as ast.LocalIDList
	export var capturedOuter as ast.LocalIDList
	export var capturedInner as ast.LocalIDList
	export var captures as ast.CaptureList

	export static function make(fn ast.FuncID) returns BehaviourFrame
		return BehaviourFrame{fn: fn, isClosure: false, mutatesCaptures: false, accesses: ast.LocalIDList.create(0), capturedOuter: ast.LocalIDList.create(0), capturedInner: ast.LocalIDList.create(0), captures: ast.CaptureList.create(0)}
	end 'make'
end 'BehaviourFrame'

// A TryFrame is a try whose covered code is being checked, which collects the errors of what can fail in it: the handler
// of a try block names that error.
export type TryFrame
	export var errors as ast.TypeIDList

	export static function make() returns TryFrame
		return TryFrame{errors: ast.TypeIDList.create(0)}
	end 'make'
end 'TryFrame'

export typealias TryFrameList = Array with TryFrame

// A TryBinding is the error that a try block's handler names, which the handler must match on to tell the failures apart.
export type TryBinding
	export var local as ast.LocalID
	export var matched as bool

	export static function make(local ast.LocalID) returns TryBinding
		return TryBinding{local: local, matched: false}
	end 'make'
end 'TryBinding'

export enum LackReason
	lackNone
	lackDeclared
	lackDestructor
	lackUnbounded
	lackMutatesCaptures
	lackInterface
	// lackPromise is a promise, which owns a coroutine that one owner awaits: it is neither copied nor dropped.
	lackPromise
	// lackReply is a deferred reply, which one service answers once: it is dropped, which fails its sender's await, but never
	// copied.
	lackReply
end 'LackReason'

export type LackStep
	export var owner as ast.TypeID
	export var partTy as ast.TypeID
	export var place as String
	export var reason as LackReason

	export static function root(owner ast.TypeID, reason LackReason) returns LackStep
		return LackStep{owner: owner, partTy: ast.noType, place: "", reason: reason}
	end 'root'

	export static function part(owner ast.TypeID, partTy ast.TypeID, consumes place String) returns LackStep
		return LackStep{owner: owner, partTy: partTy, place: place, reason: LackReason.lackNone}
	end 'part'
end 'LackStep'

export type LackInfo
	export var missing as bool
	export var steps as Array with LackStep

	export static function ok() returns LackInfo
		return LackInfo{missing: false, steps: Array.create(0)}
	end 'ok'

	export static function fail(consumes rootStep LackStep) returns LackInfo
		var xs as Array with LackStep
		xs = Array.create(0)
		xs.push(rootStep)
		return LackInfo{missing: true, steps: xs}
	end 'fail'

	export static function wrap(consumes step LackStep, consumes inner LackInfo) returns LackInfo
		var xs as Array with LackStep
		xs = Array.create(0)
		xs.push(step)
		for i in 0 upto inner.steps.count() 'cp'
			xs.push(inner.steps[i].clone())
		end 'cp'
		return LackInfo{missing: true, steps: xs}
	end 'wrap'
end 'LackInfo'

export type Checker
	export var modID as diag.ModuleID
	export var modIdx as Count
	export var typing as ast.Typing
	export var pendingCalls as PendingCallList
	export var pendingBounds as PendingBoundList
	export var pendingBorrowFree as PendingBorrowFreeList
	export var pendingBoxes as PendingBoxList
	export var pendingHandles as PendingHandleList
	export var pendingValueTypes as PendingValueTypeList
	export var callers as ast.FuncIDList
	export var callersSeen as BoolIntMap
	export var fn as ast.FuncID
	export var rootFn as ast.FuncID
	export var boundedFn as ast.FuncID
	export var owner as ast.TypeID
	export var allowCalls as bool
	// constName is the module-level constant whose initializer is being typed, for the message that refuses a call in it.
	export var constName as String
	// constNamesParams is whether the initializer being typed names a type parameter of the type it belongs to, or its
	// Self: a static let of a generic type is then one for each of its instances (noteConstantType).
	export var constNamesParams as bool
	// deferredNames are the reads Type.member of a static let in the initializers of constants, which the constants stage
	// types on a tree it shares and so cannot rewrite into names: the bodies stage, which
	// writes the tree, rewrites (moduleBodies), and deferredHeads the head of each.
	export var deferredNames as ast.NodeIDList
	export var deferredHeads as ast.NodeIDList
	// inRawValue is whether the value that a case of an enum or a union writes after "=" is being typed: it may build any record,
	// since it belongs to the enum or union that declares it and to no record.
	export var inRawValue as bool
	export var dead as bool
	export var expect as ast.TypeID
	// literalWide is whether an array or map literal being typed is inside another, so that its bare numbers take the whole word
	// instead of the range they span.
	export var literalWide as bool
	export var scopes as ScopeList
	export var blocks as BlockFrameList
	export var nextSlot as Count
	export var whens as Count
	export var outers as Array with OuterLevel
	export var bFrames as Array with BehaviourFrame
	export var inBehaviour as bool
	// bareNumbers is whether a bare 'int' or 'float' is the full range of its kind, which only the right side of a typealias says.
	export var bareNumbers as bool
	// inClosure is whether the innermost body being checked is a closure's; it and inBehaviour are never both true.
	export var inClosure as bool
	export var activeBehIdx as Count
	export var isFieldDefault as bool
	export var defaultFieldKey as Count
	export var hasOmitted as bool
	export var omittedCall as ast.NodeID
	export var omittedArgIdx as Count
	export var capKnown as LackMap
	export var capVisiting as VisitMap
	// tries are the tries around the code being checked that catch its failures, innermost last; bindings are the errors
	// that the handlers being checked name, innermost last.
	export var tries as TryFrameList
	export var bindings as Array with TryBinding
	// statement is the try that stands alone as the statement being checked, which alone may ignore a failure.
	export var statement as ast.NodeID
	// usesNode is the function, or the field default, whose calls that need an instance of a generic are being recorded,
	// and usesField whether it is a field default; hasUses is false outside both.
	export var usesNode as ast.NodeID
	export var usesField as bool
	export var hasUses as bool
	export var recorded as ast.NodeIDList
	// fnLocals are the locals of the function being checked, in the order they were declared.
	export var fnLocals as ast.LocalIDList
	// waitNow is whether the function being checked may wait, and waitCalls the functions of the module it calls, whose
	// facts say whether it may; waits holds each checked function's, and pendingAsyncs the async calls that E3073 asks
	// them of once every body is checked (waits.maxon).
	export var waitNow as bool
	export var waitCalls as ast.FuncIDList
	export var waits as WaitFacts
	// waitSends are the sends the function being checked makes of kinds that name no policy, and its calls of other modules'
	// functions; sendsUnpoliced is whether a body of the module sends such a kind, directly or through another module; posted
	// are the kinds the module's posts name (policies.maxon).
	export var waitSends as UnpolicedSends
	export var sendsUnpoliced as bool
	export var posted as PostedKindList
	export var pendingAsyncs as PendingAsyncList
	// pendingPolicies are the messages of the module whose '@policy' is declared once every type of the module is (policies.maxon).
	export var pendingPolicies as PendingPolicyList
	// partyWaitNow is whether the function being checked waits on another party: a reply it keeps, or the start of a service
	// whose factory throws; spawned are the types the module spawns services of, each once, whose messages E3221 asks it of
	// (services.maxon), at the first spawn of each (spawnSites), servicesChecked the types whose service rules were checked,
	// and discardedSend the send that the discard being checked drops the reply of.
	export var partyWaitNow as bool
	export var spawned as ast.TypeIDList
	export var spawnSites as ast.NodeIDList
	export var servicesChecked as ast.TypeIDList
	export var discardedSend as ast.NodeID

	export static function make(modID diag.ModuleID, consumes typing ast.Typing) returns Checker
		let mIdx = ast.modIndex(modID)
		let csMap = BoolIntMap.new()
		return Checker{modID: modID, modIdx: mIdx, typing: typing, pendingCalls: PendingCallList.create(0), pendingBounds: PendingBoundList.create(0), pendingBorrowFree: PendingBorrowFreeList.create(0), pendingBoxes: PendingBoxList.create(0), pendingHandles: PendingHandleList.create(0), pendingValueTypes: PendingValueTypeList.create(0), callers: ast.FuncIDList.create(0), callersSeen: csMap, fn: ast.noFunc, rootFn: ast.noFunc, boundedFn: ast.noFunc, owner: ast.noType, allowCalls: false, constName: "", constNamesParams: false, deferredNames: ast.NodeIDList.create(0), deferredHeads: ast.NodeIDList.create(0), inRawValue: false, dead: false, expect: ast.noType, literalWide: false, scopes: ScopeList.create(0), blocks: BlockFrameList.create(0), nextSlot: 0 as Count, whens: 0 as Count, outers: Array.create(0), bFrames: Array.create(0), inBehaviour: false, bareNumbers: false, inClosure: false, activeBehIdx: 0 as Count, isFieldDefault: false, defaultFieldKey: 0 as Count, hasOmitted: false, omittedCall: 0 as ast.NodeID, omittedArgIdx: 0 as Count, capKnown: LackMap.new(), capVisiting: VisitMap.new(), tries: Array.create(0), bindings: Array.create(0), statement: 0 as ast.NodeID, usesNode: 0 as ast.NodeID, usesField: false, hasUses: false, recorded: ast.NodeIDList.create(0), fnLocals: ast.LocalIDList.create(0), waitNow: false, waitCalls: ast.FuncIDList.create(0), waits: WaitFacts.new(), waitSends: UnpolicedSends.create(0), sendsUnpoliced: false, posted: PostedKindList.create(0), pendingAsyncs: PendingAsyncList.create(0), pendingPolicies: PendingPolicyList.create(0), partyWaitNow: false, spawned: ast.TypeIDList.create(0), spawnSites: ast.NodeIDList.create(0), servicesChecked: ast.TypeIDList.create(0), discardedSend: 0 as ast.NodeID}
	end 'make'
end 'Checker'

export function checkFail(modID diag.ModuleID, off diag.U32, consumes code String, consumes msg String, mutates errs diag.ErrorList)
	diag.pushSiteError(errs, code: code, message: msg, module: modID, offset: off)
end 'checkFail'

// checkFailCaused is checkFail for an error whose cause a tool tells apart from the others of its code.
export function checkFailCaused(modID diag.ModuleID, off diag.U32, consumes code String, consumes msg String, cause diag.ErrorCause, mutates errs diag.ErrorList)
	var err = diag.CompileError.atSite(code, message: msg, site: diag.Site.make(modID, offset: off))
	err.cause = cause
	errs.push(err)
end 'checkFailCaused'

// checkFailFixed is checkFail for an error whose message names the change that fix makes.
export function checkFailFixed(modID diag.ModuleID, off diag.U32, consumes code String, consumes msg String, consumes fix diag.Fix, mutates errs diag.ErrorList)
	diag.pushFixedError(errs, code: code, message: msg, module: modID, offset: off, fix: fix)
end 'checkFailFixed'

// isMutableLocal is whether the local, and the fields reached through it, may be assigned.
function isMutableLocal(l ast.LocalEntry) returns bool
	return l.isVar or (l.isParam and ast.isByAddress(l.conv))
end 'isMutableLocal'

// nameInfoOf is what a name expression was typed as naming.
function nameInfoOf(typing ast.Typing, node ast.NodeID) returns borrowed ast.NameInfo
	return typing.names.expect(node as Count, what: "name")
end 'nameInfoOf'

export function typeIsAnonInt(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	if t == ast.noType 'n'
		return false
	end 'n'
	return ast.typeKind(tt, reads: reads, t: t) == ast.TypeKind.intRange and ast.typeEntry(tt, reads: reads, t: t).name == ""
end 'typeIsAnonInt'

export function typeIsNamedInt(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	if t == ast.noType 'n'
		return false
	end 'n'
	return ast.typeKind(tt, reads: reads, t: t) == ast.TypeKind.intRange and ast.typeEntry(tt, reads: reads, t: t).name != ""
end 'typeIsNamedInt'

// valueOutOfRange is the error for a value that the range of the integer type target does not hold, which names the
// range as the alias was declared: int(low to high) or bits(n).
export function valueOutOfRange(p ast.Project, ms ast.ModuleState, value String, target ast.TypeID) returns String
	let alias = ast.typeName(ms.types, reads: p.types, t: target)
	if ast.isBitPattern(ms.types, reads: p.types, t: target) 'pattern'
		return diag.patternLiteralOutOfRange(value, alias: alias, width: "{ast.typeEntry(ms.types, reads: p.types, t: target).bitsWidth}")
	end 'pattern'
	return diag.literalOutOfRange(value, alias: alias, low: ast.typeEntry(ms.types, reads: p.types, t: target).minVal.toString(), high: ast.typeEntry(ms.types, reads: p.types, t: target).maxVal.toString())
end 'valueOutOfRange'

// otherwiseValueOutOfRange is valueOutOfRange for the literal that a try gives in place of a failed call whose result is
// the alias target.
export function otherwiseValueOutOfRange(p ast.Project, ms ast.ModuleState, value String, target ast.TypeID) returns String
	let alias = ast.typeName(ms.types, reads: p.types, t: target)
	if ast.isBitPattern(ms.types, reads: p.types, t: target) 'pattern'
		return diag.otherwisePatternOutOfRange(value, alias: alias, width: "{ast.typeEntry(ms.types, reads: p.types, t: target).bitsWidth}")
	end 'pattern'
	return diag.otherwiseOutOfRange(value, alias: alias, low: ast.typeEntry(ms.types, reads: p.types, t: target).minVal.toString(), high: ast.typeEntry(ms.types, reads: p.types, t: target).maxVal.toString())
end 'otherwiseValueOutOfRange'

export function intRangeHolds(tt ast.TypeSlot, reads ast.TypeTable, dst ast.TypeID, v ast.I128) returns bool
	return v.ge(ast.typeEntry(tt, reads: reads, t: dst).minVal) and v.le(ast.typeEntry(tt, reads: reads, t: dst).maxVal)
end 'intRangeHolds'

export function intRangeCovers(tt ast.TypeSlot, reads ast.TypeTable, dst ast.TypeID, src ast.TypeID) returns bool
	return ast.typeEntry(tt, reads: reads, t: dst).minVal.le(ast.typeEntry(tt, reads: reads, t: src).minVal) and ast.typeEntry(tt, reads: reads, t: dst).maxVal.ge(ast.typeEntry(tt, reads: reads, t: src).maxVal)
end 'intRangeCovers'

export function rangeLo(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns ast.I128
	return ast.typeEntry(tt, reads: reads, t: t).minVal.clone()
end 'rangeLo'

export function rangeHi(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns ast.I128
	return ast.typeEntry(tt, reads: reads, t: t).maxVal.clone()
end 'rangeHi'

export function sameType(tt ast.TypeSlot, reads ast.TypeTable, a ast.TypeID, b ast.TypeID) returns bool
	if a == b 'eq'
		return true
	end 'eq'
	if a == ast.noType or b == ast.noType 'n'
		return false
	end 'n'
	let ka = ast.typeKind(tt, reads: reads, t: a)
	let kb = ast.typeKind(tt, reads: reads, t: b)
	if ka != kb 'diff'
		return false
	end 'diff'
	if ka == ast.TypeKind.intRange 'rng'
		if ast.typeEntry(tt, reads: reads, t: a).name != "" or ast.typeEntry(tt, reads: reads, t: b).name != "" 'named'
			return a == b
		end 'named'
		return ast.typeEntry(tt, reads: reads, t: a).minVal.eq(ast.typeEntry(tt, reads: reads, t: b).minVal) and ast.typeEntry(tt, reads: reads, t: a).maxVal.eq(ast.typeEntry(tt, reads: reads, t: b).maxVal)
	end 'rng'
	return false
end 'sameType'

// retags is whether a value of a is a value of b by its bits alone, so that a cast between them retags it, as maxon's
// does a container: one type, or two instances of one generic whose arguments retag pairwise, where two integer
// aliases retag when they are declarations of one name with one range and one domain (the alias of a library and the
// author's own, or one spelled from two modules).
export function retags(tt ast.TypeSlot, reads ast.TypeTable, a ast.TypeID, b ast.TypeID) returns bool
	if sameType(tt, reads: reads, a: a, b: b) 'same'
		return true
	end 'same'
	if a == ast.noType or b == ast.noType or ast.typeKind(tt, reads: reads, t: a) != ast.typeKind(tt, reads: reads, t: b) 'kinds'
		return false
	end 'kinds'
	if ast.typeKind(tt, reads: reads, t: a) == ast.TypeKind.intRange 'range'
		let named = ast.typeEntry(tt, reads: reads, t: a).name != "" and ast.typeEntry(tt, reads: reads, t: a).name == ast.typeEntry(tt, reads: reads, t: b).name
		let ranged = ast.typeEntry(tt, reads: reads, t: a).minVal.eq(ast.typeEntry(tt, reads: reads, t: b).minVal) and ast.typeEntry(tt, reads: reads, t: a).maxVal.eq(ast.typeEntry(tt, reads: reads, t: b).maxVal)
		return named and ranged and ast.typeEntry(tt, reads: reads, t: a).bitsWidth == ast.typeEntry(tt, reads: reads, t: b).bitsWidth
	end 'range'
	let origin = ast.typeEntry(tt, reads: reads, t: a).origin
	if origin == ast.noType or origin != ast.typeEntry(tt, reads: reads, t: b).origin 'origins'
		return false
	end 'origins'
	let arity = ast.typeEntry(tt, reads: reads, t: a).typeArgs.count()
	if arity == 0 or arity != ast.typeEntry(tt, reads: reads, t: b).typeArgs.count() 'arity'
		return false
	end 'arity'
	for i in 0 upto arity 'args'
		if not retags(tt, reads: reads, a: ast.typeEntry(tt, reads: reads, t: a).typeArgs[i], b: ast.typeEntry(tt, reads: reads, t: b).typeArgs[i]) 'differs'
			return false
		end 'differs'
	end 'args'
	return true
end 'retags'

export function assignable(p ast.Project, ms ast.ModuleState, src ast.TypeID, dst ast.TypeID) returns bool
	if src == ast.noType or dst == ast.noType 'err'
		return true
	end 'err'
	if sameType(ms.types, reads: p.types, a: src, b: dst) or src == p.builtins.neverTy 'sameOrNever'
		return true
	end 'sameOrNever'
	if ast.isSubtypeOf(ms.types, reads: p.types, sub: src, sup: dst) 'subtype'
		return true
	end 'subtype'
	let dk = ast.typeKind(ms.types, reads: p.types, t: dst)
	if dk == ast.TypeKind.intRange 'dstInt'
		let sk = ast.typeKind(ms.types, reads: p.types, t: src)
		if sk == ast.TypeKind.constInt 'c'
			return intRangeHolds(ms.types, reads: p.types, dst: dst, v: ast.typeEntry(ms.types, reads: p.types, t: src).minVal)
		end 'c'
		if sk == ast.TypeKind.intRange 'i'
			return (typeIsAnonInt(ms.types, reads: p.types, t: src) or typeIsAnonInt(ms.types, reads: p.types, t: dst)) and intRangeCovers(ms.types, reads: p.types, dst: dst, src: src)
		end 'i'
		return false
	end 'dstInt'
	if dk == ast.TypeKind.funcTy and ast.typeKind(ms.types, reads: p.types, t: src) == ast.TypeKind.funcTy 'functions'
		return funcFits(p, ms: ms, src: src, dst: dst)
	end 'functions'
	if dk == ast.TypeKind.floatRange 'dstFloat'
		return floatFits(p, ms: ms, src: src, dst: dst)
	end 'dstFloat'
	return false
end 'assignable'

// convertsInteger is whether a value of the integer type src is converted to the integer type dst where it is returned,
// which the range analysis accepts when it proves the value fits (the ArithInfo of the return statement records it). A
// literal is not converted: it fits or is an error, as everywhere.
export function convertsInteger(p ast.Project, ms ast.ModuleState, src ast.TypeID, dst ast.TypeID) returns bool
	if src == ast.noType or dst == ast.noType 'err'
		return false
	end 'err'
	if ast.typeKind(ms.types, reads: p.types, t: src) != ast.TypeKind.intRange or ast.typeKind(ms.types, reads: p.types, t: dst) != ast.TypeKind.intRange 'notIntegers'
		return false
	end 'notIntegers'
	return not assignable(p, ms: ms, src: src, dst: dst)
end 'convertsInteger'

export function requireSigned64(c Checker, off diag.U32, t ast.TypeID, p ast.Project, ms ast.ModuleState, mutates errs diag.ErrorList) returns bool
	if t != ast.noType and ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.constInt 'c'
		if ast.typeEntry(ms.types, reads: p.types, t: t).minVal.gt(ast.I128.i64Max()) 'over'
			let vs = ast.typeEntry(ms.types, reads: p.types, t: t).minVal.toString()
			checkFail(c.modID, off: off, code: diag.errIntegerLiteralRange, msg: diag.unsignedLiteralWithoutAlias(vs), errs: errs)
			return false
		end 'over'
	end 'c'
	return true
end 'requireSigned64'

// A Mismatch is how the place that needs a value words one that is not of the type the place needs.
export union Mismatch
	expectedGot
	argument(label String)
	// bare is the place without the type that holds it, which the messages about a function value leave out.
	assignment(place String, bare String)
	returned

	// castable is whether a cast to expected would make the value fit.
	export function words(expected String, got String, castable bool) returns String
		return match self 'm'
			expectedGot gives diag.expectedGotCast(expected, got: got) if castable else diag.expectedGot(expected, got: got)
			argument(label) gives diag.argTypeMismatchCast(label, expected: expected, got: got) if castable else diag.argTypeMismatch(label, expected: expected, got: got)
			assignment(place, _) gives diag.assignMismatchCast(got, place: place, expected: expected) if castable else diag.assignMismatch(got, place: place, expected: expected)
			returned gives diag.returnTypeMismatch(got, expected: expected)
		end 'm'
	end 'words'

	// conformWords is the refusal of a value put where an interface value is expected whose type does not implement the
	// interface.
	export function conformWords(got String, iface String) returns String
		return match self 'm'
			expectedGot gives diag.notConforming(got, iface: iface)
			argument(label) gives diag.argNotConforming(label, got: got, iface: iface)
			assignment(place, _) gives diag.assignNotConforming(place, got: got, iface: iface)
			returned gives diag.returnNotConforming(got, iface: iface)
		end 'm'
	end 'conformWords'

	// wideningWords is what the place does with a value that is widened to the interface type iface, in the function fn.
	export function wideningWords(iface String, fn String) returns String
		return match self 'm'
			expectedGot gives "Cannot use a value as the interface type '{iface}'"
			argument(label) gives "Cannot pass a value as {label}, which is declared at the interface type '{iface}'"
			assignment(place, bare) gives "Cannot store a value into the {memberPlace(place, bare: bare)}, which is declared at the interface type '{iface}'"
			returned gives "Cannot return a value from '{fn}' as the interface type '{iface}'"
		end 'm'
	end 'wideningWords'

	// opaqueWords is the refusal of a value of a type parameter where a concrete type is needed.
	export function opaqueWords(expected String) returns String
		return match self 'm'
			expectedGot gives diag.expectedGot(expected, got: "type parameter")
			argument(label) gives diag.argTypeMismatchOpaque(label, expected: expected, reason: diag.opaqueTypeParameterReason())
			assignment(place, _) gives diag.assignMismatch("type parameter", place: place, expected: expected)
			returned gives diag.returnTypeMismatch("type parameter", expected: expected)
		end 'm'
	end 'opaqueWords'

	// functionWords is the refusal of a function value where the place needs something that is not a function.
	export function functionWords(expected String) returns String
		return match self 'm'
			expectedGot gives diag.expectedGot(expected, got: "function")
			argument(label) gives diag.functionValuePassed(label, expected: expected, hint: diag.functionValueHint())
			assignment(_, bare) gives diag.functionValueAssigned(bare, expected: expected, hint: diag.functionValueHint())
			returned gives diag.functionValueReturned(expected, hint: diag.functionValueHint())
		end 'm'
	end 'functionWords'

	// shapeWords is the refusal of a function value of another shape than the function type the place needs.
	export function shapeWords(expected String, got String) returns String
		return match self 'm'
			expectedGot gives diag.expectedGot(expected, got: got)
			argument(label) gives diag.argTypeMismatch(label, expected: expected, got: got)
			assignment(_, bare) gives diag.functionShapeAssigned(bare, expected: expected, got: got)
			returned gives diag.functionShapeReturned(expected, got: got)
		end 'm'
	end 'shapeWords'
end 'Mismatch'

// fieldPrefix and ownerInfix are the words of the place of a field, "field 'name' of 'Type'", whose bare place is "field 'name'".
let fieldPrefix = "field '"

let ownerInfix = " of '"

// memberPlace is a field's place written as maxon's messages about a Reply write it, "field 'Type.name'", and any other place
// as it is.
function memberPlace(place String, bare String) returns String
	let lead = fieldPrefix.byteLength()
	let at = try bare.byteLength() + ownerInfix.byteLength() otherwise panic("check: a place past memory")
	if bare.byteLength() <= lead or place.byteLength() <= at or place.sliceBytes(0, endPos: lead) != fieldPrefix or place.sliceBytes(bare.byteLength(), endPos: at) != ownerInfix 'other'
		return place.clone()
	end 'other'
	let name = bare.sliceBytes(lead, endPos: try bare.byteLength() - 1 otherwise panic("check: a field's place shorter than its prefix"))
	let owner = place.sliceBytes(at, endPos: try place.byteLength() - 1 otherwise panic("check: a field's place shorter than its owner"))
	return "{fieldPrefix}{owner}.{name}'"
end 'memberPlace'

// frozenFix converts between a value and a frozen value of its type, which a type of its own tells apart: a value given up to
// freeze where the frozen value is wanted, and an owned copy of the contents (thaw) where the value is, when it can be
// copied. Nothing for other types.
function frozenFix(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID, src ast.TypeID, target ast.TypeID) returns diag.Fix
	if isFrozenType(p, ms: ms, t: target) and assignable(p, ms: ms, src: src, dst: ast.contentType(ms.types, reads: p.types, t: target)) 'freeze'
		return freezeFix(ms.tree(), e: node)
	end 'freeze'
	if isFrozenType(p, ms: ms, t: src) and assignable(p, ms: ms, src: ast.contentType(ms.types, reads: p.types, t: src), dst: target) and not lacksCap(c, p: p, ms: ms, wantCopy: true, t: target).missing 'thaw'
		return thawFix(ms.tree(), e: node)
	end 'thaw'
	return diag.Fix.none()
end 'frozenFix'

// coerce requires the value of node, of type src, where a target is needed, and reports a refusal at the offset at, which is
// where maxon points for the place that needs the value. An integer of another type is fixed by a cast
// to the target, which is what the language converts with.
export function coerce(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID, at diag.U32, src ast.TypeID, target ast.TypeID, wrong Mismatch, mutates errs diag.ErrorList) returns bool
	if src == ast.noType or target == ast.noType 'okErr'
		return true
	end 'okErr'
	let sk = ast.typeKind(ms.types, reads: p.types, t: src)
	let dk = ast.typeKind(ms.types, reads: p.types, t: target)
	if dk == ast.TypeKind.interfaceTy and sk != ast.TypeKind.interfaceTy and ast.holdsReply(ms.types, reads: p.types, t: src) 'reply'
		let fnName = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).name.clone() if c.fn != ast.noFunc else ""
		let iface = nameOfType(p, ms: ms, t: target)
		checkFail(c.modID, off: at, code: diag.errReplyDeferralRefused, msg: replyWideningText(wrong.wideningWords(iface, fn: fnName), iface: iface), errs: errs)
		return false
	end 'reply'
	if assignable(p, ms: ms, src: src, dst: target) 'ok'
		return true
	end 'ok'
	if sk == ast.TypeKind.enumTy and dk == ast.TypeKind.intRange 'rawCase'
		let raw = rawCaseConstant(c, p: p, ms: ms, e: node)
		if raw != ast.noType 'written'
			recordType(c, e: node, t: raw)
			return coerce(c, p: p, ms: ms, node: node, at: at, src: raw, target: target, wrong: wrong, errs: errs)
		end 'written'
		let span = rawValueSpan(p, ms: ms, t: src)
		if span != ast.noType 'constants'
			if not coerce(c, p: p, ms: ms, node: node, at: at, src: span, target: target, wrong: wrong, errs: errs) 'unfit'
				return false
			end 'unfit'
			c.typing.rawReads.insert(node as Count, value: true)
			return true
		end 'constants'
	end 'rawCase'
	if dk == ast.TypeKind.interfaceTy and sk != ast.TypeKind.interfaceTy 'interface'
		return boxInto(c, p: p, ms: ms, node: node, at: at, src: src, iface: target, wrong: wrong, errs: errs)
	end 'interface'
	if ast.isInterfaceHandle(ms.types, reads: p.types, t: target) and ast.isServiceType(ms.types, reads: p.types, t: src) 'handle'
		return boxHandleInto(c, p: p, ms: ms, node: node, at: at, src: src, target: target, wrong: wrong, errs: errs)
	end 'handle'
	if dk == ast.TypeKind.floatRange and (ast.isFloatType(ms.types, reads: p.types, t: src) or ast.isIntType(ms.types, reads: p.types, t: src)) 'float'
		floatMismatch(c, p: p, ms: ms, node: node, at: at, src: src, target: target, wrong: wrong, errs: errs)
		return false
	end 'float'
	if dk == ast.TypeKind.intRange and ast.isFloatType(ms.types, reads: p.types, t: src) 'lossy'
		let lossy = diag.lossyFloatConversion(ast.typeName(ms.types, reads: p.types, t: target))
		let msg = match wrong 'where'
			argument(label) gives "argument {label}: {lossy}"
			expectedGot gives lossy
			assignment(_, _) gives lossy
			returned gives lossy
		end 'where'
		checkFail(c.modID, off: at, code: diag.errUnsafeCast, msg: msg, errs: errs)
		return false
	end 'lossy'
	let tName = ast.typeName(ms.types, reads: p.types, t: target)
	let castTarget = castName(p, ms: ms, target: target)
	if (sk == ast.TypeKind.constInt or typeIsAnonInt(ms.types, reads: p.types, t: src)) and dk == ast.TypeKind.intRange 'valueFit'
		// A constant that does not fit is wrong whatever converts it, and an anonymous range goes in by the cast that the
		// range analysis proves where the value is used.
		var fit = diag.Fix.none()
		if sk != ast.TypeKind.constInt 'anonymous'
			fit = castFix(ms.tree(), e: node, target: castTarget)
		end 'anonymous'
		checkFailFixed(c.modID, off: at, code: diag.errTypeMismatch, msg: valueOutOfRange(p, ms: ms, value: offendingBound(p, ms: ms, src: src, target: target), target: target), fix: fit, errs: errs)
		return false
	end 'valueFit'
	if sk == ast.TypeKind.typeParam and dk != ast.TypeKind.typeParam 'opaque'
		checkFail(c.modID, off: at, code: diag.errTypeMismatch, msg: wrong.opaqueWords(tName), errs: errs)
		return false
	end 'opaque'
	if sk == ast.TypeKind.funcTy 'function'
		let words = wrong.shapeWords(clashName(p, ms: ms, t: target, other: src), got: clashName(p, ms: ms, t: src, other: target)) if dk == ast.TypeKind.funcTy else wrong.functionWords(tName)
		checkFail(c.modID, off: at, code: diag.errTypeMismatch, msg: words, errs: errs)
		return false
	end 'function'
	if ast.isPromiseType(ms.types, reads: p.types, t: src) and ast.isPromiseType(ms.types, reads: p.types, t: target) 'promise'
		checkFail(c.modID, off: at, code: diag.errPromiseStorageMismatch, msg: diag.promiseStorageMismatch(promiseClaim(p, ms: ms, t: src), slot: tName, claim: promiseClaim(p, ms: ms, t: target)), errs: errs)
		return false
	end 'promise'
	var fix = diag.Fix.none()
	let integers = sk == ast.TypeKind.intRange and dk == ast.TypeKind.intRange
	if integers 'cast'
		fix = castFix(ms.tree(), e: node, target: castTarget)
	end 'cast' else 'frozen'
		fix = frozenFix(c, p: p, ms: ms, node: node, src: src, target: target)
	end 'frozen'
	checkFailFixed(c.modID, off: at, code: diag.errTypeMismatch, msg: wrong.words(clashName(p, ms: ms, t: target, other: src), got: clashName(p, ms: ms, t: src, other: target), castable: integers), fix: fix, errs: errs)
	let reported = try errs.count() - 1 otherwise panic("the mismatch was reported")
	errs[reported].cause = rawSurfaceCauseOfTypes(p, ms: ms, a: target, b: src)
	return false
end 'coerce'

// promiseClaim is what a promise type says it gives: its result, and the error it throws if it throws.
function promiseClaim(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	let result = "'{ast.typeName(ms.types, reads: p.types, t: ast.promiseResult(ms.types, reads: p.types, t: t))}'"
	let failure = ast.promiseError(ms.types, reads: p.types, t: t)
	if failure == ast.noType 'plain'
		return result
	end 'plain'
	return "{result} throwing '{ast.typeName(ms.types, reads: p.types, t: failure)}'"
end 'promiseClaim'

// castName is how a cast to the integer type target is written: an anonymous 64-bit signed range, the type of `Self` in an
// extension of `int`, has no spelling of its own, and its alias is FullRangeInt.
function castName(p ast.Project, ms ast.ModuleState, target ast.TypeID) returns String
	if target == p.builtins.anon64Ty 'anonymous'
		return ast.typeName(ms.types, reads: p.types, t: p.builtins.fullRangeIntTy)
	end 'anonymous'
	return ast.typeName(ms.types, reads: p.types, t: target)
end 'castName'

// offendingBound is the end of the range of src that target does not hold: the lowest value when that is below the target, else the highest.
function offendingBound(p ast.Project, ms ast.ModuleState, src ast.TypeID, target ast.TypeID) returns String
	if intRangeHolds(ms.types, reads: p.types, dst: target, v: ast.typeEntry(ms.types, reads: p.types, t: src).minVal) 'high'
		return ast.typeEntry(ms.types, reads: p.types, t: src).maxVal.toString()
	end 'high'
	return ast.typeEntry(ms.types, reads: p.types, t: src).minVal.toString()
end 'offendingBound'

// gotName is how a message names the type of the value it refuses: a bare number is an 'int', whatever its value.
function gotName(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	if ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.constInt 'bare'
		return "int"
	end 'bare'
	if ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.constFloat 'bareFloat'
		return "float"
	end 'bareFloat'
	return ast.typeName(ms.types, reads: p.types, t: t)
end 'gotName'

// A Clash is how the place that joins two types words the refusal of types that do not agree.
export union Clash
	operator(op String)
	arms
	branches
	other
end 'Clash'

// failAlias reports two different integer aliases where one type is needed.
function failAlias(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, clash Clash, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList)
	let lName = ast.typeName(ms.types, reads: p.types, t: l)
	let rName = ast.typeName(ms.types, reads: p.types, t: r)
	match clash 'k'
		operator(op) then checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.operandAliasMismatch(op, left: lName, right: rName), errs: errs)
		arms then checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.giveTypeMismatch(rName, expected: lName), errs: errs)
		branches then checkFail(c.modID, off: off, code: diag.errMatchTypeMismatch, msg: diag.ternaryValueTypeMismatch(lName, falseType: rName), errs: errs)
		other then checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "the operands are {lName} and {rName}; cast one so both are the same type", errs: errs)
	end 'k'
end 'failAlias'

// failJoin reports two types that no one type holds, of which the first came before the second.
function failJoin(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, clash Clash, a ast.TypeID, b ast.TypeID, mutates errs diag.ErrorList)
	match clash 'k'
		arms then checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.giveTypeMismatch(clashName(p, ms: ms, t: b, other: a), expected: clashName(p, ms: ms, t: a, other: b)), errs: errs)
		branches then checkFail(c.modID, off: off, code: diag.errMatchTypeMismatch, msg: diag.ternaryValueTypeMismatch(clashName(p, ms: ms, t: a, other: b), falseType: clashName(p, ms: ms, t: b, other: a)), errs: errs)
		other then checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "the branches produce {clashName(p, ms: ms, t: a, other: b)} and {clashName(p, ms: ms, t: b, other: a)}", errs: errs)
		operator(op) then panic("the operator '{op}' joins no types")
	end 'k'
end 'failJoin'

export function requireOneAlias(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, clash Clash, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns bool
	if l == ast.noType or r == ast.noType 'e'
		return false
	end 'e'
	if typeIsNamedInt(ms.types, reads: p.types, t: l) and typeIsNamedInt(ms.types, reads: p.types, t: r) and ast.commonSupertype(ms.types, reads: p.types, a: l, b: r) == ast.noType 'diff'
		failAlias(c, p: p, ms: ms, off: off, clash: clash, l: l, r: r, errs: errs)
		return false
	end 'diff'
	return true
end 'requireOneAlias'

export function wordOf(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let lmin = rangeLo(ms.types, reads: p.types, t: l)
	let lmax = rangeHi(ms.types, reads: p.types, t: l)
	let rmin = rangeLo(ms.types, reads: p.types, t: r)
	let rmax = rangeHi(ms.types, reads: p.types, t: r)
	let i64m = ast.I128.i64Max()
	if not lmax.gt(i64m) and not rmax.gt(i64m) 'signed'
		return p.builtins.anon64Ty
	end 'signed'
	if lmin.isNeg() or rmin.isNeg() 'badMix'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "no 64-bit word holds both {ast.typeName(ms.types, reads: p.types, t: l)} and {ast.typeName(ms.types, reads: p.types, t: r)}: one may be negative and the other is past i64.max; cast one with 'as <Alias>' to a range that is not negative, or that stays within i64.max", errs: errs)
		return ast.noType
	end 'badMix'
	return p.builtins.anonU64Ty
end 'wordOf'

export function operandWord(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, op String, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if not requireOneAlias(c, p: p, ms: ms, off: off, clash: Clash.operator(op.clone()), l: l, r: r, errs: errs) 'bad'
		return ast.noType
	end 'bad'
	return wordOf(c, p: p, ms: ms, off: off, l: l, r: r, errs: errs)
end 'operandWord'

export function exactType(p ast.Project, mutates ms ast.ModuleState, word ast.TypeID, lo ast.I128, hi ast.I128) returns ast.TypeID
	if word == ast.noType 'n'
		return ast.noType
	end 'n'
	let wLo = rangeLo(ms.types, reads: p.types, t: word)
	let wHi = rangeHi(ms.types, reads: p.types, t: word)
	let cLo = ast.maxI128(lo, b: wLo)
	let cHi = ast.minI128(hi, b: wHi)
	if cLo.gt(cHi) or (cLo.eq(wLo) and cHi.eq(wHi)) 'word'
		return word
	end 'word'
	return ast.internIntRange(ms.types, reads: p.types, aliasName: "", minVal: cLo, maxVal: cHi, inferred: true)
end 'exactType'

export function unifyInts(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, clash Clash, l ast.TypeID, r ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if not requireOneAlias(c, p: p, ms: ms, off: off, clash: clash, l: l, r: r, errs: errs) 'bad'
		return ast.noType
	end 'bad'
	var alias = ast.noType
	var other = r
	if typeIsNamedInt(ms.types, reads: p.types, t: l) 'la'
		alias = l
		other = r
	end 'la' else if typeIsNamedInt(ms.types, reads: p.types, t: r) 'ra'
		alias = r
		other = l
	end 'ra'
	if alias == ast.noType 'noAlias'
		return wordOf(c, p: p, ms: ms, off: off, l: l, r: r, errs: errs)
	end 'noAlias'
	if typeIsNamedInt(ms.types, reads: p.types, t: other) 'related'
		return ast.commonSupertype(ms.types, reads: p.types, a: l, b: r)
	end 'related'
	if not assignable(p, ms: ms, src: other, dst: alias) 'notFit'
		let oName = ast.typeName(ms.types, reads: p.types, t: other)
		let aName = ast.typeName(ms.types, reads: p.types, t: alias)
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "an operand of {oName} does not fit {aName}; cast it with 'as {aName}'", errs: errs)
		return ast.noType
	end 'notFit'
	return alias
end 'unifyInts'

export function joinTypes(c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, clash Clash, a ast.TypeID, b ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if a == ast.noType or b == ast.noType 'e'
		return ast.noType
	end 'e'
	if a == p.builtins.neverTy 'na'
		return b
	end 'na'
	if b == p.builtins.neverTy or sameType(ms.types, reads: p.types, a: a, b: b) 'nbOrEq'
		return a
	end 'nbOrEq'
	let common = ast.commonSupertype(ms.types, reads: p.types, a: a, b: b)
	if common != ast.noType 'ancestor'
		return common
	end 'ancestor'
	if ast.isIntType(ms.types, reads: p.types, t: a) and ast.isIntType(ms.types, reads: p.types, t: b) 'ints'
		if not requireOneAlias(c, p: p, ms: ms, off: off, clash: clash, l: a, r: b, errs: errs) 'bad'
			return ast.noType
		end 'bad'
		var alias = ast.noType
		var other = b
		if typeIsNamedInt(ms.types, reads: p.types, t: a) 'alA'
			alias = a
			other = b
		end 'alA' else if typeIsNamedInt(ms.types, reads: p.types, t: b) 'alB'
			alias = b
			other = a
		end 'alB'
		if alias != ast.noType and assignable(p, ms: ms, src: other, dst: alias) 'useAlias'
			return alias
		end 'useAlias'
		let w = wordOf(c, p: p, ms: ms, off: off, l: a, r: b, errs: errs)
		if w == ast.noType 'badW'
			return ast.noType
		end 'badW'
		let nLo = ast.minI128(rangeLo(ms.types, reads: p.types, t: a), b: rangeLo(ms.types, reads: p.types, t: b))
		let nHi = ast.maxI128(rangeHi(ms.types, reads: p.types, t: a), b: rangeHi(ms.types, reads: p.types, t: b))
		return ast.internIntRange(ms.types, reads: p.types, aliasName: "", minVal: nLo, maxVal: nHi, inferred: true)
	end 'ints'
	if (ast.isFloatType(ms.types, reads: p.types, t: a) or ast.isFloatType(ms.types, reads: p.types, t: b)) and isNumberType(p, ms: ms, t: a) and isNumberType(p, ms: ms, t: b) 'floats'
		if not requireOneFloatAlias(c, p: p, ms: ms, off: off, l: a, r: b, errs: errs) 'bad'
			return ast.noType
		end 'bad'
		if typeIsNamedFloat(ms.types, reads: p.types, t: a) and assignable(p, ms: ms, src: b, dst: a) 'aliasA'
			return a
		end 'aliasA'
		if typeIsNamedFloat(ms.types, reads: p.types, t: b) and assignable(p, ms: ms, src: a, dst: b) 'aliasB'
			return b
		end 'aliasB'
		return p.builtins.anonFloatTy
	end 'floats'
	if typeHasKind(p, ms: ms, t: a, kind: ast.TypeKind.funcTy) and typeHasKind(p, ms: ms, t: b, kind: ast.TypeKind.funcTy) 'functions'
		let joined = joinFunctions(p, ms: ms, a: a, b: b)
		if joined != ast.noType 'joined'
			return joined
		end 'joined'
	end 'functions'
	failJoin(c, p: p, ms: ms, off: off, clash: clash, a: a, b: b, errs: errs)
	return ast.noType
end 'joinTypes'

export function boundsOfParam(p ast.Project, ms ast.ModuleState, boundedFn ast.FuncID, paramTy ast.TypeID) returns ast.TypeIDList
	var out = ast.TypeIDList.create(0)
	let bi = ast.typeEntry(ms.types, reads: p.types, t: paramTy).boundIface
	if bi != ast.noType 'std'
		out.push(bi)
	end 'std'
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: paramTy).bounds.count() 'pb'
		out.push(ast.typeEntry(ms.types, reads: p.types, t: paramTy).bounds[i].ifaceTy)
	end 'pb'
	if boundedFn != ast.noFunc 'fnBnd'
		for i in 0 upto ast.funcEntry(ms.funcs, funcReads: p.funcs, f: boundedFn).bounds.count() 'fb'
			if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: boundedFn).bounds[i].paramTy == paramTy 'hit'
				out.push(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: boundedFn).bounds[i].ifaceTy)
			end 'hit'
		end 'fb'
	end 'fnBnd'
	return out
end 'boundsOfParam'

export function typeIsNominal(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	if t == ast.noType 'n'
		return false
	end 'n'
	return match ast.typeKind(tt, reads: reads, t: t) 'k'
		record gives true
		enumTy gives true
		unionTy gives true
		builtinArray gives true
		builtinSlotKey gives true
		builtinFrozen gives true
		builtinCown gives true
		builtinCursor gives true
		builtinGroups gives true
		builtinPromise gives true
		builtinReply gives true
		builtinService gives true
		invalid gives false
		primBool gives false
		primString gives false
		primCharacter gives false
		primCString gives false
		primVoid gives false
		primNever gives false
		intRange gives false
		constInt gives false
		floatRange gives false
		constFloat gives false
		typeParam gives false
		interfaceTy gives false
		funcTy gives false
	end 'k'
end 'typeIsNominal'

export function hasDestructorOn(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	return ast.typeEntry(ms.types, reads: p.types, t: orig).dropFunc != ast.noFunc
end 'hasDestructorOn'

export function hasBoundCap(p ast.Project, ms ast.ModuleState, boundedFn ast.FuncID, paramTy ast.TypeID, wantCopy bool) returns bool
	let ifaces = boundsOfParam(p, ms: ms, boundedFn: boundedFn, paramTy: paramTy)
	for i in 0 upto ifaces.count() 'each'
		let iface = ifaces[i]
		let copies = ast.reachesInterface(ms.types, reads: p.types, have: iface, want: p.builtins.copyableTy)
		if copies or ((not wantCopy) and ast.reachesInterface(ms.types, reads: p.types, have: iface, want: p.builtins.droppableTy)) 'yes'
			return true
		end 'yes'
	end 'each'
	return false
end 'hasBoundCap'

export function typeElemType(p ast.Project, ms ast.ModuleState, ownerTy ast.TypeID) returns ast.TypeID
	let orig = ast.originOf(ms.types, reads: p.types, t: ownerTy)
	let k = ast.typeKind(ms.types, reads: p.types, t: orig)
	let args = ast.typeArgsOf(ms.types, reads: p.types, t: ownerTy)
	if args.count() >= 1 'one'
		return args[0]
	end 'one'
	return ast.noType
end 'typeElemType'

export function typeIndexType(p ast.Project, mutates ms ast.ModuleState, ownerTy ast.TypeID) returns ast.TypeID
	let orig = ast.originOf(ms.types, reads: p.types, t: ownerTy)
	let k = ast.typeKind(ms.types, reads: p.types, t: orig)
	if k == ast.TypeKind.builtinArray 'arr'
		return p.builtins.countTy
	end 'arr'
	return ast.noType
end 'typeIndexType'

export function lacksCap(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, wantCopy bool, t ast.TypeID) returns LackInfo
	if t == ast.noType 'err'
		return LackInfo.ok()
	end 'err'
	let k = ast.typeKind(ms.types, reads: p.types, t: t)
	if k == ast.TypeKind.intRange or k == ast.TypeKind.constInt or k == ast.TypeKind.floatRange or k == ast.TypeKind.constFloat or k == ast.TypeKind.primBool or k == ast.TypeKind.primString or k == ast.TypeKind.primCharacter or k == ast.TypeKind.primVoid or k == ast.TypeKind.primNever or k == ast.TypeKind.enumTy 'scalar'
		return LackInfo.ok()
	end 'scalar'
	if k == ast.TypeKind.funcTy 'function'
		if wantCopy and ast.isMutatingFunction(ms.types, reads: p.types, t: t) 'mutating'
			return LackInfo.fail(LackStep.root(t, reason: LackReason.lackMutatesCaptures))
		end 'mutating'
		return LackInfo.ok()
	end 'function'
	if k == ast.TypeKind.typeParam 'tp'
		if ast.familyOfSelf(ms.types, reads: p.types, t: t) != ast.noType 'primitive'
			return LackInfo.ok()
		end 'primitive'
		if hasBoundCap(p, ms: ms, boundedFn: c.boundedFn, paramTy: t, wantCopy: wantCopy) 'ok'
			return LackInfo.ok()
		end 'ok'
		return LackInfo.fail(LackStep.root(t, reason: LackReason.lackUnbounded))
	end 'tp'
	if k == ast.TypeKind.builtinPromise 'promise'
		return LackInfo.fail(LackStep.root(t, reason: LackReason.lackPromise))
	end 'promise'
	if k == ast.TypeKind.builtinReply 'reply'
		if wantCopy 'copied'
			return LackInfo.fail(LackStep.root(t, reason: LackReason.lackReply))
		end 'copied'
		return LackInfo.ok()
	end 'reply'
	if k == ast.TypeKind.interfaceTy 'interface'
		if wantCopy and not ast.reachesInterface(ms.types, reads: p.types, have: t, want: p.builtins.copyableTy) 'notCopyable'
			return LackInfo.fail(LackStep.root(t, reason: LackReason.lackInterface))
		end 'notCopyable'
		return LackInfo.ok()
	end 'interface'
	var capTag = "D"
	if wantCopy 'cpTag'
		capTag = "C"
	end 'cpTag'
	let key = "{capTag}|{t}|{c.boundedFn}"
	match consumes c.capKnown.get(key) 'hit'
		some(l) then return l
		none then _ = 0
	end 'hit'
	if c.capVisiting.has(key) 'cyc'
		return LackInfo.ok()
	end 'cyc'
	c.capVisiting.insert(key.clone(), value: true)
	var res = LackInfo.ok()
	if k == ast.TypeKind.record 'rec'
		let orig = ast.originOf(ms.types, reads: p.types, t: t)
		if hasDestructorOn(p, ms: ms, t: orig) 'dtor'
			res = LackInfo.fail(LackStep.root(t, reason: LackReason.lackDestructor))
		end 'dtor' else if wantCopy and ast.typeEntry(ms.types, reads: p.types, t: orig).isNoncopyable 'nc'
			res = LackInfo.fail(LackStep.root(t, reason: LackReason.lackDeclared))
		end 'nc' else 'fields'
			let fCount = ast.typeEntry(ms.types, reads: p.types, t: orig).fields.count()
			for fi in 0 upto fCount 'eachF'
				let fTy = ast.fieldType(ms.types, reads: p.types, owner: t, index: fi)
				let sub = partLacks(c, p: p, ms: ms, wantCopy: wantCopy, t: fTy)
				if sub.missing 'fMiss'
					let fName = ast.typeEntry(ms.types, reads: p.types, t: orig).fields[fi].name.clone()
					res = LackInfo.wrap(LackStep.part(t, partTy: fTy, place: "in its field '{fName}'"), inner: sub)
					break 'eachF'
				end 'fMiss'
			end 'eachF'
		end 'fields'
	end 'rec' else if k == ast.TypeKind.unionTy 'uni'
		let orig = ast.originOf(ms.types, reads: p.types, t: t)
		if hasDestructorOn(p, ms: ms, t: orig) 'dtor'
			res = LackInfo.fail(LackStep.root(t, reason: LackReason.lackDestructor))
		end 'dtor' else if wantCopy and ast.typeEntry(ms.types, reads: p.types, t: orig).isNoncopyable 'nc'
			res = LackInfo.fail(LackStep.root(t, reason: LackReason.lackDeclared))
		end 'nc' else 'cases'
			let cCount = ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count()
			for ci in 0 upto cCount 'eachC'
				let cName = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].name.clone()
				let pCount = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload.count()
				for pi in 0 upto pCount 'eachP'
					let pTy = ast.payloadType(ms.types, reads: p.types, owner: t, caseIndex: ci, index: pi)
					let sub = partLacks(c, p: p, ms: ms, wantCopy: wantCopy, t: pTy)
					if sub.missing 'pMiss'
						let pName = ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload[pi].name.clone()
						res = LackInfo.wrap(LackStep.part(t, partTy: pTy, place: "in the payload '{pName}' of its case '{cName}'"), inner: sub)
						break 'eachC'
					end 'pMiss'
				end 'eachP'
			end 'eachC'
		end 'cases'
	end 'uni' else if k == ast.TypeKind.builtinArray 'col'
		let elTy = typeElemType(p, ms: ms, ownerTy: t)
		let sub = partLacks(c, p: p, ms: ms, wantCopy: wantCopy, t: elTy)
		if sub.missing 'elMiss'
			res = LackInfo.wrap(LackStep.part(t, partTy: elTy, place: "as its elements"), inner: sub)
		end 'elMiss'
	end 'col' else if k == ast.TypeKind.builtinGroups 'groups'
		let halves = ast.typeArgsOf(ms.types, reads: p.types, t: t)
		for hi in 0 upto halves.count() 'eachHalf'
			let sub = partLacks(c, p: p, ms: ms, wantCopy: wantCopy, t: halves[hi])
			if sub.missing 'halfMiss'
				res = LackInfo.wrap(LackStep.part(t, partTy: halves[hi], place: "as a half of its pairs"), inner: sub)
				break 'eachHalf'
			end 'halfMiss'
		end 'eachHalf'
	end 'groups'
	_ = c.capVisiting.remove(key)
	if res.missing or c.capVisiting.isEmpty() 'cache'
		c.capKnown.insert(key, value: res.clone())
	end 'cache'
	return res
end 'lacksCap'

// partLacks is lacksCap of a part of a value: a promise that a record, a union, a tuple or a collection holds is Droppable,
// since the drop of its holder cancels it, as maxon's does; a promise of its own, in a local, is must-use (E3213).
function partLacks(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, wantCopy bool, t ast.TypeID) returns LackInfo
	if not wantCopy and ast.isPromiseType(ms.types, reads: p.types, t: t) 'promise'
		return LackInfo.ok()
	end 'promise'
	return lacksCap(c, p: p, ms: ms, wantCopy: wantCopy, t: t)
end 'partLacks'

export function lackWhyText(tt ast.TypeSlot, reads ast.TypeTable, info LackInfo, capName String) returns String
	var buf = ByteArray.create(0)
	let n = info.steps.count()
	for i in 0 upto n 'each'
		if i > 0 'sep'
			buf.append("; ".toByteArray())
		end 'sep'
		let oName = ast.typeName(tt, reads: reads, t: info.steps[i].owner)
		let r = info.steps[i].reason
		if r == LackReason.lackNone 'part'
			let pName = ast.typeName(tt, reads: reads, t: info.steps[i].partTy)
			buf.append("'{oName}' holds '{pName}' {info.steps[i].place}".toByteArray())
		end 'part' else if r == LackReason.lackDeclared 'dec'
			buf.append("'{oName}' is declared 'is noncopyable'".toByteArray())
		end 'dec' else if r == LackReason.lackDestructor 'dtor'
			buf.append("'{oName}' has a destructor".toByteArray())
		end 'dtor' else if r == LackReason.lackMutatesCaptures 'captures'
			buf.append("'{oName}' mutates captures, so its closure holds state that only one owner may change".toByteArray())
		end 'captures' else if r == LackReason.lackInterface 'interface'
			buf.append("a '{oName}' value holds a value of any type that implements '{oName}', which need not be Copyable".toByteArray())
		end 'interface' else if r == LackReason.lackPromise 'promise'
			buf.append("'{oName}' owns a coroutine, which exactly one owner awaits".toByteArray())
		end 'promise' else if r == LackReason.lackReply 'reply'
			buf.append("'{oName}' is a reply that one service answers once".toByteArray())
		end 'reply' else 'unb'
			buf.append("the type parameter '{oName}' is not known to be {capName}".toByteArray())
		end 'unb'
	end 'each'
	return String.from(buf)
end 'lackWhyText'

export function lackFixText(tt ast.TypeSlot, reads ast.TypeTable, info LackInfo, capName String) returns String
	let lastIdx = try info.steps.count() - 1 otherwise 0 as Count
	let oName = ast.typeName(tt, reads: reads, t: info.steps[lastIdx].owner)
	let r = info.steps[lastIdx].reason
	if r == LackReason.lackDeclared 'dec'
		return "remove 'is noncopyable' from '{oName}' if its values can be copied"
	end 'dec'
	if r == LackReason.lackDestructor 'dtor'
		return "a '{oName}' is ended only by calling one of its destructors; remove them if its values may be copied and dropped"
	end 'dtor'
	if r == LackReason.lackUnbounded 'unb'
		return "add the bound 'where {oName} implements {capName}'"
	end 'unb'
	if r == LackReason.lackMutatesCaptures 'captures'
		return "pass it 'mutates' to share its use"
	end 'captures'
	if r == LackReason.lackInterface 'interface'
		return "declare 'interface {oName} extends Copyable', so that only a Copyable type implements it"
	end 'interface'
	if r == LackReason.lackPromise 'promise'
		return "'await' the promise, and copy or drop a value that holds its result"
	end 'promise'
	if r == LackReason.lackReply 'reply'
		return "answer the reply once, where it is held, with 'answer(value)'"
	end 'reply'
	return ""
end 'lackFixText'

// lackBoundFix is the change that lackFixText names when a value lacks the capability only because a type parameter is not
// known to have it: the bound on that parameter, written in the header of fn, the function whose body needs it. A closure
// has no header of its own, and any other lack names another change.
export function lackBoundFix(p ast.Project, ms ast.ModuleState, fn ast.FuncID, info LackInfo, capName String) returns diag.Fix
	let n = info.steps.count()
	if n == 0 'nothing'
		return diag.Fix.none()
	end 'nothing'
	let last = info.steps[n - 1].clone()
	if last.reason != LackReason.lackUnbounded 'otherChange'
		return diag.Fix.none()
	end 'otherChange'
	return paramBoundFix(p, ms: ms, fn: fn, param: last.owner, bound: capName)
end 'lackBoundFix'

// paramBoundFix writes the bound on the type parameter param in the header of fn, the function whose body needs it. In a
// method of an extension of an interface the bound is the method's own, so a conformer that binds an associated type to a
// type without it lacks that method alone.
export function paramBoundFix(p ast.Project, ms ast.ModuleState, fn ast.FuncID, param ast.TypeID, bound String) returns diag.Fix
	if fn == ast.noFunc or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).isClosure 'noHeader'
		return diag.Fix.none()
	end 'noHeader'
	return boundFix(ms.tree(), decl: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).nodeID, param: ast.typeName(ms.types, reads: p.types, t: param), bound: bound)
end 'paramBoundFix'

export function copyAdviceText(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, ifCopyable String, otherwiseText String) returns String
	let l = lacksCap(c, p: p, ms: ms, wantCopy: true, t: t)
	if not l.missing 'cp'
		if otherwiseText == "" 'only'
			return ifCopyable.clone()
		end 'only'
		return "{ifCopyable}, or {otherwiseText}"
	end 'cp'
	var ow = otherwiseText.clone()
	if ow == "" 'def'
		ow = "move the whole value instead of copying it"
	end 'def'
	let why = lackWhyText(ms.types, reads: p.types, info: l, capName: "Copyable")
	let last = l.steps[try l.steps.count() - 1 otherwise panic("a lack with no step")].reason
	if last == LackReason.lackUnbounded 'bound'
		return "'{ast.typeName(ms.types, reads: p.types, t: t)}' cannot be copied ({why}); {lackFixText(ms.types, reads: p.types, info: l, capName: "Copyable")}, then {ifCopyable}, or {ow}"
	end 'bound'
	return "'{ast.typeName(ms.types, reads: p.types, t: t)}' cannot be copied ({why}), so {ow}"
end 'copyAdviceText'

// queueBounds queues the check of each type argument against its parameter's bounds, which are read at the arguments: a
// bound may bind an interface's associated type to another of the parameters.
export function queueBounds(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, params ast.TypeIDList, args ast.TypeIDList)
	for i in 0 upto params.count() 'each'
		let pid = params[i]
		let bCount = ast.typeEntry(ms.types, reads: p.types, t: pid).bounds.count()
		let stdB = ast.typeEntry(ms.types, reads: p.types, t: pid).boundIface
		if stdB != ast.noType 'hasStd'
			c.pendingBounds.push(PendingBound.make(c.modID, off: off, paramTy: pid, argTy: args[i], ifaceTy: stdB, withinFn: c.boundedFn, inFn: c.rootFn, hasMethod: false, methodFn: ast.noFunc))
		end 'hasStd'
		for bi in 0 upto bCount 'eachB'
			let declared = ast.typeEntry(ms.types, reads: p.types, t: pid).bounds[bi].ifaceTy
			let iface = ast.substituteType(ms.types, reads: p.types, t: declared, params: params, args: args)
			c.pendingBounds.push(PendingBound.make(c.modID, off: off, paramTy: pid, argTy: args[i], ifaceTy: iface, withinFn: c.boundedFn, inFn: c.rootFn, hasMethod: false, methodFn: ast.noFunc))
		end 'eachB'
	end 'each'
end 'queueBounds'

export function queueMethodBounds(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, method ast.FuncID, args ast.TypeIDList)
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).bounds.count() == 0 'none'
		return
	end 'none'
	let bCount = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).bounds.count()
	let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).generics)
	for bi in 0 upto bCount 'eachB'
		let pTy = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).bounds[bi].paramTy
		let declared = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).bounds[bi].ifaceTy
		let iface = ast.substituteType(ms.types, reads: p.types, t: declared, params: generics, args: args)
		for gi in 0 upto generics.count() 'findG'
			if generics[gi] == pTy and gi < args.count() 'hit'
				var bound = PendingBound.make(c.modID, off: off, paramTy: pTy, argTy: args[gi], ifaceTy: iface, withinFn: c.boundedFn, inFn: c.rootFn, hasMethod: true, methodFn: method)
				if bi < ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).conditionalBounds 'conditional'
					bound.receiverTy = receiverOf(p, ms: ms, method: method, args: args)
				end 'conditional'
				c.pendingBounds.push(bound)
				break 'findG'
			end 'hit'
		end 'findG'
	end 'eachB'
end 'queueMethodBounds'

// receiverOf is the type of the value that the method is called on at the type arguments args: the type that implements
// the interface whose extension adds it, or the generic type it is a method of.
function receiverOf(p ast.Project, ms ast.ModuleState, method ast.FuncID, args ast.TypeIDList) returns ast.TypeID
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).extendedIface != ast.noType 'ofInterface'
		return args[0]
	end 'ofInterface'
	return ast.originOf(ms.types, reads: p.types, t: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).ownerTy)
end 'receiverOf'

export function instantiateGeneric(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, orig ast.TypeID, args ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	let base = ast.originOf(ms.types, reads: p.types, t: orig)
	let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: base).typeParams)
	if base == p.builtins.promiseOrigin and args.count() == 1 'unthrowing'
		// `Promise with T` is the promise of a function that throws nothing: its error argument is void.
		var both = ast.cloneTypeArgs(args)
		both.push(p.builtins.voidTy)
		return instantiateGeneric(c, p: p, ms: ms, off: off, orig: orig, args: both, errs: errs)
	end 'unthrowing'
	if args.count() != params.count() 'badCount'
		let bName = ast.typeEntry(ms.types, reads: p.types, t: base).name.clone()
		checkFailCaused(c.modID, off: off, code: diag.errTypeArgumentCount, msg: diag.genericArityMismatch(bName, expected: "{params.count()}", supplied: "{args.count()}"), cause: diag.rawSurfaceCause(bName), errs: errs)
		return ast.noType
	end 'badCount'
	let bk = ast.typeKind(ms.types, reads: p.types, t: base)
	if bk == ast.TypeKind.builtinFrozen 'fr'
		if args[0] != ast.noType and not ast.isManagedType(ms.types, reads: p.types, t: args[0]) 'badF'
			checkFail(c.modID, off: off, code: diag.errFreezeScalar, msg: "'{ast.typeName(ms.types, reads: p.types, t: args[0])}' is a plain value, which is immutable already and copied freely, so there is nothing to freeze: freeze a record, a union, a String or a collection", errs: errs)
			return ast.noType
		end 'badF'
	end 'fr'
	queueBorrowFree(c, p: p, ms: ms, off: off, params: params, args: args)
	queueBounds(c, p: p, ms: ms, off: off, params: params, args: args)
	return ast.instantiateType(ms.types, reads: p.types, origin: base, args: args)
end 'instantiateGeneric'

// resolveBoundTypeRef is the interface that a bound or an 'implements' names, the instance of a generic one at the types
// its 'with' binds. A bound binds every associated type, since a call through it is typed by them; a conformance that
// binds none is refused where its declaration is checked, which names what it lacks.
export function resolveBoundTypeRef(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, isBound bool, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = ms.tree().startOf(tr)
	let tName = ast.typeRefName(ms.tree(), id: tr).clone()
	match ast.nodeDecl(p, ms: ms, node: tr as Count) 'hit'
		some(ref) then return checkInterfaceRef(c, p: p, ms: ms, tr: tr, off: off, tName: tName, ref: ref, isBound: isBound, selfTy: selfTy, errs: errs)
		none then _ = 0
	end 'hit'
	if ast.resolutionOf(p, ms: ms).typeParamSlots.has(tr as Count) 'typeParameter'
		checkFail(c.modID, off: off, code: diag.errGenericDeclaration, msg: "'{tName}' is not an interface, and only an interface can be a bound or be implemented", errs: errs)
		return ast.noType
	end 'typeParameter'
	failUnknownType(c, p: p, ms: ms, tr: tr, errs: errs)
	return ast.noType
end 'resolveBoundTypeRef'

// failUnknownType reports a type reference that names no type. A bare name may name a declaration of another module, which
// is always qualified, so the error is marked for locating to say how.
// failUnknownType refuses a type reference that names no type. With type arguments it names a base that is not generic, as
// maxon words it.
function failUnknownType(c Checker, p ast.Project, ms ast.ModuleState, tr ast.NodeID, mutates errs diag.ErrorList)
	let off = ms.tree().startOf(tr)
	let tName = ast.typeRefName(ms.tree(), id: tr)
	let applied = ms.tree().listLen(ast.typeRefTypeArgsRef(ms.tree(), id: tr)) > 0
	let code = diag.errBaseNotGeneric if applied else diag.errUnknownType
	let message = diag.baseNotGeneric(tName) if applied else diag.unknownType(tName)
	if ms.tree().listLen(ast.typeRefQualifierRef(ms.tree(), id: tr)) == 0 'bare'
		diag.pushUnqualifiedError(errs, code: code, message: message, module: c.modID, offset: off, name: tName.clone())
		return
	end 'bare'
	checkFailCaused(c.modID, off: off, code: code, msg: message, cause: diag.rawSurfaceCause(tName), errs: errs)
end 'failUnknownType'

// failNotGeneric refuses type arguments given to the type of the name, which has no type parameters.
function failNotGeneric(c Checker, off diag.U32, name String, mutates errs diag.ErrorList)
	checkFail(c.modID, off: off, code: diag.errBaseNotGeneric, msg: diag.baseNotGeneric(name), errs: errs)
end 'failNotGeneric'

function checkInterfaceRef(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, off diag.U32, tName String, ref ast.DeclRef, isBound bool, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	match ast.declType(p, ms: ms, ref: ref) 'dt'
		some(tid) then return verifyInterfaceTarget(c, p: p, ms: ms, tr: tr, off: off, tName: tName, tid: tid, isBound: isBound, selfTy: selfTy, errs: errs)
		none then _ = 0
	end 'dt'
	checkFail(c.modID, off: off, code: diag.errGenericDeclaration, msg: "'{tName}' is not an interface, and only an interface can be a bound or be implemented", errs: errs)
	return ast.noType
end 'checkInterfaceRef'

function verifyInterfaceTarget(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, off diag.U32, tName String, tid ast.TypeID, isBound bool, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if ast.typeKind(ms.types, reads: p.types, t: tid) != ast.TypeKind.interfaceTy 'notIface'
		checkFail(c.modID, off: off, code: diag.errGenericDeclaration, msg: "'{tName}' is not an interface, and only an interface can be a bound or be implemented", errs: errs)
		return ast.noType
	end 'notIface'
	let argsRef = ast.typeRefTypeArgsRef(ms.tree(), id: tr)
	let argCount = ms.tree().listLen(argsRef)
	let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: tid).typeParams)
	if params.count() == 0 'plain'
		if argCount > 0 'hasArgs'
			failNotGeneric(c, off: off, name: tName, errs: errs)
			return ast.noType
		end 'hasArgs'
		return tid
	end 'plain'
	if argCount == 0 and not isBound 'unbound'
		return tid
	end 'unbound'
	if argCount != params.count() 'badCount'
		var names = ast.StringList.create(0)
		for i in 0 upto params.count() 'names'
			names.push(ast.typeEntry(ms.types, reads: p.types, t: params[i]).name.clone())
		end 'names'
		checkFail(c.modID, off: off, code: diag.errTypeArgumentCount, msg: "the interface '{tName}' binds {params.count()} associated type(s) and {argCount} were given: write '{ast.instanceSpelling(tName, args: names)}' with the type of each", errs: errs)
		return ast.noType
	end 'badCount'
	var args = ast.TypeIDList.create(0)
	for i in 0 upto argCount 'args'
		let at = resolveTypeArg(c, p: p, ms: ms, tr: ms.tree().listAt(argsRef, index: i) as ast.NodeID, selfTy: selfTy, errs: errs)
		if at == ast.noType 'failed'
			return ast.noType
		end 'failed'
		args.push(at)
	end 'args'
	queueBorrowFree(c, p: p, ms: ms, off: off, params: params, args: args)
	return ast.instantiateType(ms.types, reads: p.types, origin: tid, args: args)
end 'verifyInterfaceTarget'

export function resolveTypeRef(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	if ast.typeRefIsTuple(ms.tree(), id: tr) 'tuple'
		return resolveTupleTypeRef(c, p: p, ms: ms, tr: tr, selfTy: selfTy, errs: errs)
	end 'tuple'
	let t = resolveNamedTypeRef(c, p: p, ms: ms, tr: tr, selfTy: selfTy, errs: errs)
	noteConstantType(c, p: p, ms: ms, t: t)
	if t != ast.noType and ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.interfaceTy 'ifTy'
		let off = ms.tree().startOf(tr)
		c.pendingValueTypes.push(PendingValueType.make(off, iface: t, written: ast.typeRefName(ms.tree(), id: tr).clone()))
	end 'ifTy'
	return t
end 'resolveTypeRef'

// noteConstantType notes a type that the initializer of a constant names, where it names a type parameter: the parameters
// of the type a static let belongs to, or that type's Self, are the only ones an initializer can name.
export function noteConstantType(mutates c Checker, p ast.Project, ms ast.ModuleState, t ast.TypeID)
	if c.constName != "" and t != ast.noType and ast.mentionsTypeParam(ms.types, reads: p.types, t: t) 'names'
		c.constNamesParams = true
	end 'names'
end 'noteConstantType'

// resolveTupleTypeRef is the tuple that a parenthesized list of types stands for. A type that cannot be an element is
// refused where the list names it.
function resolveTupleTypeRef(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let elemsRef = ast.typeRefElemsRef(ms.tree(), id: tr)
	var elems = ast.TypeIDList.create(0)
	for i in 0 upto ms.tree().listLen(elemsRef) 'each'
		let node = ms.tree().listAt(elemsRef, index: i) as ast.NodeID
		let t = resolveTypeRef(c, p: p, ms: ms, tr: node, selfTy: selfTy, errs: errs)
		if t == ast.noType 'failed'
			return ast.noType
		end 'failed'
		elems.push(t)
	end 'each'
	return ast.tupleType(ms.types, reads: p.types, elems: elems)
end 'resolveTupleTypeRef'

// resolveTypeArg resolves a type argument. A bare 'int' or 'float' names no range, and a type argument is no place where it
// means the full range of its kind, not even on the right side of a typealias.
function resolveTypeArg(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let bare = bareNumberName(p, ms: ms, tr: tr)
	if bare != "" 'bare'
		checkFail(c.modID, off: ms.tree().startOf(tr), code: diag.errBareTypeArgument, msg: diag.bareTypeArgument(bare), errs: errs)
		return ast.noType
	end 'bare'
	return resolveTypeRef(c, p: p, ms: ms, tr: tr, selfTy: selfTy, errs: errs)
end 'resolveTypeArg'

// bareNumberName is "int" or "float" when a type reference is that word alone, and "" for any other.
function bareNumberName(p ast.Project, ms ast.ModuleState, tr ast.NodeID) returns String
	let qualified = ms.tree().listLen(ast.typeRefQualifierRef(ms.tree(), id: tr)) > 0
	let applied = ms.tree().listLen(ast.typeRefTypeArgsRef(ms.tree(), id: tr)) > 0
	if ast.typeRefIsTuple(ms.tree(), id: tr) or qualified or applied 'other'
		return ""
	end 'other'
	let name = ast.typeRefName(ms.tree(), id: tr)
	if name == "int" or name == "float" 'bare'
		return name.clone()
	end 'bare'
	return ""
end 'bareNumberName'

function resolveNamedTypeRef(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = ms.tree().startOf(tr)
	let tName = ast.typeRefName(ms.tree(), id: tr).clone()
	let argsRef = ast.typeRefTypeArgsRef(ms.tree(), id: tr)
	let hasArgs = ms.tree().listLen(argsRef) > 0
	match ast.resolutionOf(p, ms: ms).typeParamSlots.get(tr as Count) 'tpSlot'
		some(slot) then return resolveBoundTP(c, p: p, ms: ms, off: off, name: tName, slot: slot, hasArgs: hasArgs, errs: errs)
		none then _ = 0
	end 'tpSlot'
	let qualCount = ms.tree().listLen(ast.typeRefQualifierRef(ms.tree(), id: tr))
	if qualCount == 0 'unqual'
		if tName == "bool" 'bl'
			if hasArgs 'badA'
				failNotGeneric(c, off: off, name: "bool", errs: errs)
			end 'badA'
			return p.builtins.boolTy
		end 'bl'
		if tName == "String" 'str'
			if hasArgs 'badA'
				failNotGeneric(c, off: off, name: "String", errs: errs)
			end 'badA'
			return p.builtins.stringTy
		end 'str'
		if tName == "Character" 'char'
			if hasArgs 'badA'
				failNotGeneric(c, off: off, name: "Character", errs: errs)
			end 'badA'
			return p.builtins.characterTy
		end 'char'
		if tName == "cstring" 'cstring'
			if hasArgs 'badA'
				failNotGeneric(c, off: off, name: "cstring", errs: errs)
			end 'badA'
			if refusesRawType(c, p: p, ms: ms, off: off, t: p.builtins.cStringTy, errs: errs) 'raw'
				return ast.noType
			end 'raw'
			return p.builtins.cStringTy
		end 'cstring'
		if tName == "Self" 'slf'
			if selfTy == ast.noType 'noS'
				checkFail(c.modID, off: off, code: diag.errUnknownType, msg: "'Self' names a type only inside one", errs: errs)
				return ast.noType
			end 'noS'
			if hasArgs 'badA'
				failNotGeneric(c, off: off, name: "Self", errs: errs)
			end 'badA'
			return selfTy
		end 'slf'
		if tName == "int" and c.bareNumbers 'fullInt'
			return p.builtins.fullRangeIntTy
		end 'fullInt'
		if tName == "float" and c.bareNumbers 'fullFloat'
			return p.builtins.fullRangeFloatTy
		end 'fullFloat'
		if tName == "int" 'bareInt'
			checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.bareIntType(), errs: errs)
			return ast.noType
		end 'bareInt'
		if tName == "float" 'bareFloat'
			checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.bareFloatType(), errs: errs)
			return ast.noType
		end 'bareFloat'
	end 'unqual'
	if qualCount > 0 and tName == ast.serviceHandleMember 'handle'
		match consumes handleTypeOf(c, p: p, ms: ms, tr: tr, errs: errs) 'service'
			some(t) then return t
			none then _ = 0
		end 'service'
	end 'handle'
	match ast.nodeDecl(p, ms: ms, node: tr as Count) 'declHit'
		some(ref) then return applyTypeArgs(c, p: p, ms: ms, tr: tr, off: off, tName: tName, ref: ref, selfTy: selfTy, errs: errs)
		none then _ = 0
	end 'declHit'
	failUnknownType(c, p: p, ms: ms, tr: tr, errs: errs)
	return ast.noType
end 'resolveNamedTypeRef'

function resolveBoundTP(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, name String, slot Count, hasArgs bool, mutates errs diag.ErrorList) returns ast.TypeID
	if hasArgs 'badA'
		failNotGeneric(c, off: off, name: name, errs: errs)
	end 'badA'
	let tpNode = ast.resolutionOf(p, ms: ms).typeParams[slot].id
	match ast.paramType(p, ms: ms, module: c.modID, node: tpNode) 'tid'
		some(id) then return id
		none then _ = 0
	end 'tid'
	checkFail(c.modID, off: off, code: diag.errUnknownType, msg: diag.unknownType(name), errs: errs)
	return ast.noType
end 'resolveBoundTP'

// boundByName is what a generic type written with no 'with' stands for inside the body, header or extension of a generic
// type, as maxon's: its type parameters bound by name to the enclosing type's, so 'MapIterator' inside 'Map uses Key,
// Value' is 'MapIterator with (Key, Value)'. It is empty where the enclosing type does not declare every one of them, and
// the bare base is then refused for its count.
function boundByName(p ast.Project, ms ast.ModuleState, target ast.TypeID, selfTy ast.TypeID) returns ast.TypeIDList
	var bound = ast.TypeIDList.create(0)
	if selfTy == ast.noType 'outside'
		return bound
	end 'outside'
	var scope = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: selfTy).typeArgs)
	if scope.count() == 0 'origin'
		scope = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: selfTy).typeParams)
	end 'origin'
	let wanted = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: target).typeParams)
	for i in 0 upto wanted.count() 'params'
		var found = ast.noType
		for k in 0 upto scope.count() 'scope'
			if typeHasKind(p, ms: ms, t: scope[k], kind: ast.TypeKind.typeParam) and ast.typeEntry(ms.types, reads: p.types, t: scope[k]).name == ast.typeEntry(ms.types, reads: p.types, t: wanted[i]).name 'named'
				found = scope[k]
				break 'scope'
			end 'named'
		end 'scope'
		if found == ast.noType 'unbound'
			return ast.TypeIDList.create(0)
		end 'unbound'
		bound.push(found)
	end 'params'
	return bound
end 'boundByName'

function applyTypeArgs(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tr ast.NodeID, off diag.U32, tName String, ref ast.DeclRef, selfTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	var target = ast.noType
	match ast.declType(p, ms: ms, ref: ref) 'dt'
		some(tid) then target = tid
		none then target = ast.noType
	end 'dt'
	if target == ast.noType 'unk'
		failUnknownType(c, p: p, ms: ms, tr: tr, errs: errs)
		return ast.noType
	end 'unk'
	if refusesRawType(c, p: p, ms: ms, off: off, t: target, errs: errs) 'raw'
		return ast.noType
	end 'raw'
	let argsRef = ast.typeRefTypeArgsRef(ms.tree(), id: tr)
	let argCount = ms.tree().listLen(argsRef)
	if ast.typeEntry(ms.types, reads: p.types, t: target).typeParams.count() == 0 'nonGen'
		if argCount > 0 'badA'
			failNotGeneric(c, off: off, name: tName, errs: errs)
		end 'badA'
		return target
	end 'nonGen'
	var resolvedArgs = ast.TypeIDList.create(0)
	if argCount == 0 'bare'
		resolvedArgs = boundByName(p, ms: ms, target: target, selfTy: selfTy)
	end 'bare'
	for i in 0 upto argCount 'eachA'
		let aNode = ms.tree().listAt(argsRef, index: i) as ast.NodeID
		let at = resolveTypeArg(c, p: p, ms: ms, tr: aNode, selfTy: selfTy, errs: errs)
		if at == ast.noType 'fail'
			return ast.noType
		end 'fail'
		resolvedArgs.push(at)
	end 'eachA'
	let count = ast.typeRefCount(ms.tree(), id: tr)
	if count == 0 'uncounted'
		return instantiateGeneric(c, p: p, ms: ms, off: off, orig: target, args: resolvedArgs, errs: errs)
	end 'uncounted'
	let unsized = instantiateGeneric(c, p: p, ms: ms, off: off, orig: target, args: resolvedArgs, errs: errs)
	if unsized == ast.noType 'failed'
		return ast.noType
	end 'failed'
	return countedInstance(c, p: p, ms: ms, unsized: unsized, tName: tName, count: count, errs: errs)
end 'applyTypeArgs'

// fixedArrayCountLimit is the largest count a fixed array's type states, maxon's.
let fixedArrayCountLimit = 4294967295 as Count

// countedInstance is the instance of a fixed array that states the count a type reference writes after 'with', which is
// an integer literal from 1 to fixedArrayCountLimit.
function countedInstance(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, unsized ast.TypeID, tName String, count ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = ms.tree().startOf(count)
	if ast.originOf(ms.types, reads: p.types, t: unsized) != p.builtins.fixedArrayOrigin 'notFixed'
		checkFail(c.modID, off: off, code: diag.errTypeArgumentCount, msg: "'{tName}' states no count: only a 'FixedArray' takes one before its element, as in 'FixedArray with 3 Int'", errs: errs)
		return ast.noType
	end 'notFixed'
	let value = ast.typeCountValue(ms.tree(), id: count)
	let negative = ast.typeCountNegative(ms.tree(), id: count)
	if negative or value.isZero() or value.gt(ast.I128.fromCount(fixedArrayCountLimit)) 'outside'
		var written = value.toString()
		if negative 'minus'
			written = "-{written}"
		end 'minus'
		checkFail(c.modID, off: off, code: diag.errFixedArrayCount, msg: "A `FixedArray` element count runs from 1 to {fixedArrayCountLimit}, and the element count of a `FixedArray` type is an integer literal, not `{written}`", errs: errs)
		return ast.noType
	end 'outside'
	return ast.countedType(ms.types, reads: p.types, unsized: unsized, count: value.lo)
end 'countedInstance'
