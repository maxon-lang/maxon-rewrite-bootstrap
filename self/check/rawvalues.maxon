// RawCases are the cases of an enum or a union that is declared with raw values: each case's declaration and the value it
// writes after "=" (0 for none), in the order the cases are declared.
type RawCases
	export var nodes as ast.NodeIDList
	export var raws as ast.NodeIDList

	static function create() returns RawCases
		return RawCases{nodes: ast.NodeIDList.create(0), raws: ast.NodeIDList.create(0)}
	end 'create'
end 'RawCases'

function enumRawCases(ed ast.EnumDecl) returns RawCases
	var cases = RawCases.create()
	for i in 0 upto ed.cases.count() 'each'
		cases.nodes.push(ed.cases[i].id)
		cases.raws.push(ed.cases[i].raw)
	end 'each'
	return cases
end 'enumRawCases'

function unionRawCases(ud ast.UnionDecl) returns RawCases
	var cases = RawCases.create()
	for i in 0 upto ud.cases.count() 'each'
		cases.nodes.push(ud.cases[i].id)
		cases.raws.push(ud.cases[i].raw)
	end 'each'
	return cases
end 'unionRawCases'

// checkTypeRawValues types the raw values of an enum or a union whose cases write ones that are no literal. Each is a
// constant of the program, typed by the constants stage in the order of the constants it reads and checked as the value of a
// constant is; all the cases of a type write the same type, which is the type of its `.rawValue`.
function checkTypeRawValues(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tid ast.TypeID, cases RawCases, mutates errs diag.ErrorList)
	if ast.typeEntry(ms.types, reads: p.types, t: tid).rawKind != ast.RawKind.value 'literals'
		return
	end 'literals'
	let mark = errs.count()
	var settled = ast.noType
	var settledNoun = ""
	for i in 0 upto cases.raws.count() 'each'
		var noun = ""
		var t = ast.noType
		if ast.typeEntry(ms.types, reads: p.types, t: tid).cases[i].rawExpr == 0 as ast.NodeID 'literal'
			noun = rawKindOf(p, ms: ms, raw: cases.raws[i]).noun()
		end 'literal' else 'value'
			t = checkRawValue(c, p: p, ms: ms, tid: tid, index: i, node: cases.nodes[i], raw: cases.raws[i], errs: errs)
			if t == ast.noType 'failed'
				continue 'each'
			end 'failed'
			noun = nameOfType(p, ms: ms, t: t)
		end 'value'
		if i == 0 'first'
			settled = t
			settledNoun = noun.clone()
		end 'first' else if t != settled or noun != settledNoun 'mismatch'
			checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: cases.nodes[i]), code: diag.errEnumRawValueTypeMismatch, msg: diag.rawValueTypeMismatch(settledNoun.clone(), got: noun), errs: errs)
		end 'mismatch'
	end 'each'
	if not failedSince(errs, mark: mark) 'typed'
		ast.setRawType(ms, t: tid, raw: settled)
	end 'typed'
end 'checkTypeRawValues'

// checkRawValue types the value that the case at index writes as the value of a constant, and gives its type, or none after
// it reported why it has none. Unlike a constant of the module, it may build any record, whatever its constructors say, since
// it belongs to the type.
function checkRawValue(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tid ast.TypeID, index Count, node ast.NodeID, raw ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let name = "{ast.typeEntry(ms.types, reads: p.types, t: tid).name}.{ast.typeEntry(ms.types, reads: p.types, t: tid).cases[index].name}"
	enterContext(c, p: p, ms: ms, f: ast.noFunc, owner: ast.noType, calls: false)
	c.constName = name.clone()
	c.inRawValue = true
	startUses(c, node: raw, inField: true)
	let t = checkExpr(c, p: p, ms: ms, e: raw, errs: errs)
	c.hasUses = false
	c.inRawValue = false
	if t == ast.noType or not checkConstantType(c, p: p, ms: ms, name: name, node: node, value: raw, t: t, errs: errs) 'failed'
		return ast.noType
	end 'failed'
	return t
end 'checkRawValue'

// rawValuesUntyped is whether t is an enum or a union whose raw values are values that have no type, since typing them failed.
function rawValuesUntyped(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let k = kindOfType(p, ms: ms, t: t)
	if k != ast.TypeKind.enumTy and k != ast.TypeKind.unionTy 'notNominal'
		return false
	end 'notNominal'
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	return ast.typeEntry(ms.types, reads: p.types, t: orig).rawKind == ast.RawKind.value and ast.rawTypeOf(p, ms: ms, t: orig) == ast.noType
end 'rawValuesUntyped'

function failRawUntyped(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: e), code: diag.errExpressionError, msg: "the raw values of '{nameOfType(p, ms: ms, t: t)}' have no type", errs: errs)
	return ast.noType
end 'failRawUntyped'

// rawBackingField is the index of the field named member in the record that the raw values of an enum or a union are, or
// none: `.name`, `.ordinal` and `.rawValue` are the value's own and are never read from it.
function rawBackingField(p ast.Project, ms ast.ModuleState, t ast.TypeID, member String) returns table.Option with Count
	let k = kindOfType(p, ms: ms, t: t)
	if member == "name" or member == "ordinal" or member == "rawValue" or (k != ast.TypeKind.enumTy and k != ast.TypeKind.unionTy) 'own'
		return table.Option.none
	end 'own'
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	if ast.typeEntry(ms.types, reads: p.types, t: orig).rawKind != ast.RawKind.value or not typeHasKind(p, ms: ms, t: ast.rawTypeOf(p, ms: ms, t: orig), kind: ast.TypeKind.record) 'noRecord'
		return table.Option.none
	end 'noRecord'
	return ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: ast.rawTypeOf(p, ms: ms, t: orig))).findField(member)
end 'rawBackingField'

// rawFieldType is the type of the field at index of the raw value of the enum or union t, which a value reads straight off
// the case: a scalar, since the record it is a field of is made for the read and gone after it.
function rawFieldType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, index Count, mutates errs diag.ErrorList) returns ast.TypeID
	let record = ast.rawTypeOf(p, ms: ms, t: ast.originOf(ms.types, reads: p.types, t: t))
	let orig = ast.originOf(ms.types, reads: p.types, t: record)
	let field = ast.typeEntry(ms.types, reads: p.types, t: orig).fields[index].clone()
	let owner = ast.typeEntry(ms.types, reads: p.types, t: orig).decl.module
	if not ast.isVisibleFrom(p, v: field.level, owner: owner, from: c.modID) 'hidden'
		failAt(c, p: p, ms: ms, node: e, code: diag.errFieldNotExported, msg: "field {ast.notVisible(p, name: "{nameOfType(p, ms: ms, t: record)}.{field.name}", v: field.level, owner: owner, from: c.modID)}", errs: errs)
		return ast.noType
	end 'hidden'
	let ft = ast.fieldType(ms.types, reads: p.types, owner: record, index: index)
	if isManagedOwn(p, ms: ms, t: ft) 'managed'
		failAt(c, p: p, ms: ms, node: e, code: diag.errUnsupportedFeature, msg: "Unsupported: the field '{field.name}' of the raw value of '{nameOfType(p, ms: ms, t: t)}' holds a value that is made with the raw value, so it is not read off the case: write '.rawValue.{field.name}'", errs: errs)
		return ast.noType
	end 'managed'
	return ft
end 'rawFieldType'

// checkRawFieldMember types `value.field` for a field of the raw value of the enum or union value.
function checkRawFieldMember(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, t ast.TypeID, index Count, mutates errs diag.ErrorList) returns ast.TypeID
	let ft = rawFieldType(c, p: p, ms: ms, e: e, t: t, index: index, errs: errs)
	if ft == ast.noType 'failed'
		return ast.noType
	end 'failed'
	var info = ast.MemberInfo.make(ast.MemberKind.memberRawField, ownerTy: t)
	info.fieldIndex = index
	c.typing.members.insert(e as Count, value: info)
	return ft
end 'checkRawFieldMember'

// CaseRead is a case of a union that has a payload, which a member is read from by its type's name.
type CaseRead
	var owner as ast.TypeID
	var caseIndex as Count

	static function make(owner ast.TypeID, caseIndex Count) returns CaseRead
		return CaseRead{owner: owner, caseIndex: caseIndex}
	end 'make'
end 'CaseRead'

// payloadCaseNamed is the case that obj names as `Type.case`, when Type is a union that is not generic and the case has a
// payload, and none for any other expression. Making such a case needs its payload, so a member of it that its tag answers
// (`Op.mul.latency`) is read without making one.
function payloadCaseNamed(mutates c Checker, p ast.Project, ms ast.ModuleState, obj ast.NodeID) returns table.Option with CaseRead
	if ms.tree().kindOf(obj) != ast.NodeKind.memberExpr 'notMember'
		return table.Option.none
	end 'notMember'
	let head = ast.memberExprObj(ms.tree(), id: obj)
	if ms.tree().kindOf(head) != ast.NodeKind.nameExpr 'notName'
		return table.Option.none
	end 'notName'
	var probe = diag.ErrorList.create(0)
	let named = typeNamed(c, p: p, ms: ms, name: head, errs: probe)
	if probe.count() > 0 or not typeHasKind(p, ms: ms, t: named, kind: ast.TypeKind.unionTy) or ast.typeEntry(ms.types, reads: p.types, t: named).typeParams.count() > 0 'notUnion'
		return table.Option.none
	end 'notUnion'
	match consumes ast.typeEntry(ms.types, reads: p.types, t: named).findCase(ast.memberExprName(ms.tree(), id: obj)) 'found'
		some(i) then return payloadRead(p, ms: ms, t: named, caseIndex: i)
		none then return table.Option.none
	end 'found'
end 'payloadCaseNamed'

function payloadRead(p ast.Project, ms ast.ModuleState, t ast.TypeID, caseIndex Count) returns table.Option with CaseRead
	if ast.typeEntry(ms.types, reads: p.types, t: t).cases[caseIndex].payload.count() == 0 'plain'
		return table.Option.none
	end 'plain'
	return table.Option.some(CaseRead.make(t, caseIndex: caseIndex))
end 'payloadRead'

// checkCaseRead types a member that the tag of a case with a payload answers: its name, its ordinal, its raw value, or a
// field of its raw value. Any other member of it is not a value that can be made without the payload.
function checkCaseRead(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, read CaseRead, mutates errs diag.ErrorList) returns ast.TypeID
	let member = ast.memberExprName(ms.tree(), id: e).clone()
	var kind = ast.MemberKind.memberCaseRawField
	var result = p.builtins.stringTy
	var fieldIndex = 0 as Count
	if member == "name" 'name'
		kind = ast.MemberKind.memberCaseName
	end 'name' else if member == "ordinal" 'ordinal'
		kind = ast.MemberKind.memberCaseOrdinal
		result = p.builtins.countTy
	end 'ordinal' else if member == "rawValue" 'raw'
		kind = ast.MemberKind.memberCaseRaw
		result = rawValueType(p, ms: ms, t: read.owner)
		if result == ast.noType 'untyped'
			return failRawUntyped(c, p: p, ms: ms, e: e, t: read.owner, errs: errs)
		end 'untyped'
	end 'raw' else 'field'
		if rawValuesUntyped(p, ms: ms, t: read.owner) 'untyped'
			return failRawUntyped(c, p: p, ms: ms, e: e, t: read.owner, errs: errs)
		end 'untyped'
		match consumes rawBackingField(p, ms: ms, t: read.owner, member: member) 'backing'
			some(i) then fieldIndex = i
			none then return caseNeedsPayload(c, p: p, ms: ms, e: e, read: read, errs: errs)
		end 'backing'
		result = rawFieldType(c, p: p, ms: ms, e: e, t: read.owner, index: fieldIndex, errs: errs)
		if result == ast.noType 'failed'
			return ast.noType
		end 'failed'
	end 'field'
	var info = ast.MemberInfo.make(kind, ownerTy: read.owner)
	info.enumCase = read.caseIndex
	info.fieldIndex = fieldIndex
	c.typing.members.insert(e as Count, value: info)
	return result
end 'checkCaseRead'

function caseNeedsPayload(mutates c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, read CaseRead, mutates errs diag.ErrorList) returns ast.TypeID
	let name = ast.typeEntry(ms.types, reads: p.types, t: read.owner).cases[read.caseIndex].name.clone()
	checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: ast.memberExprObj(ms.tree(), id: e)), code: diag.errCallArgCountMismatch, msg: "case '{name}' carries a payload: construct it with arguments", errs: errs)
	return ast.noType
end 'caseNeedsPayload'
