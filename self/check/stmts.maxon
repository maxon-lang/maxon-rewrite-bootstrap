// failAt reports an error at a node of the module being checked.
function failAt(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, consumes code String, consumes msg String, mutates errs diag.ErrorList)
	checkFail(c.modID, off: offsetOf(c, p: p, ms: ms, node: node), code: code, msg: msg, errs: errs)
end 'failAt'

// terminates is whether a statement never completes normally: it returns or panics on every path, so a function whose
// body ends with it needs no return after it. A throw leaves the function, or goes to the handler of a try block around
// it, which decides for that block whether it terminates.
function terminates(tree ast.Tree, s ast.NodeID) returns bool
	let k = tree.kindOf(s)
	if k == ast.NodeKind.returnStmt or k == ast.NodeKind.throwStmt 'leaves'
		return true
	end 'leaves'
	if k == ast.NodeKind.exprStmt 'expr'
		return tree.kindOf(ast.exprStmtE(tree, id: s)) == ast.NodeKind.panicExpr
	end 'expr'
	if k == ast.NodeKind.ifStmt 'if'
		return ast.ifStmtHasElse(tree, id: s) and bodyTerminates(tree, body: ast.ifStmtThenRef(tree, id: s)) and bodyTerminates(tree, body: ast.ifStmtElseRef(tree, id: s))
	end 'if'
	if k == ast.NodeKind.ifTryStmt 'ifTry'
		return ast.ifTryStmtHasElse(tree, id: s) and bodyTerminates(tree, body: ast.ifTryStmtThenRef(tree, id: s)) and bodyTerminates(tree, body: ast.ifTryStmtElseRef(tree, id: s))
	end 'ifTry'
	if k == ast.NodeKind.matchStmt 'match'
		return armsTerminate(tree, core: ast.matchStmtMatch(tree, id: s))
	end 'match'
	if k == ast.NodeKind.tryStmt 'try'
		return bodyTerminates(tree, body: ast.tryStmtBodyRef(tree, id: s)) and (not ast.tryStmtHasOtherwise(tree, id: s) or bodyTerminates(tree, body: ast.tryStmtHandlerRef(tree, id: s)))
	end 'try'
	if k == ast.NodeKind.letStmt or k == ast.NodeKind.destructStmt or k == ast.NodeKind.tupleAssignStmt or k == ast.NodeKind.assignStmt or k == ast.NodeKind.discardStmt or k == ast.NodeKind.whileStmt or k == ast.NodeKind.whenStmt or k == ast.NodeKind.forStmt or k == ast.NodeKind.breakStmt or k == ast.NodeKind.continueStmt 'continues'
		return false
	end 'continues'
	panic("the node {s} of kind {k.name} is no statement")
end 'terminates'

function armsTerminate(tree ast.Tree, core ast.NodeID) returns bool
	let armsRef = ast.matchCoreArmsRef(tree, id: core)
	for i in 0 upto tree.listLen(armsRef) 'arms'
		let arm = tree.listAt(armsRef, index: i) as ast.NodeID
		if ast.matchArmFalls(tree, id: arm) and i + 1 < tree.listLen(armsRef) 'falls'
			continue 'arms'
		end 'falls'
		let action = ast.matchArmAction(tree, id: arm)
		if ast.matchArmForm(tree, id: arm) != ast.ArmKind.armPanic and (action == 0 or not terminates(tree, s: action)) 'continues'
			return false
		end 'continues'
	end 'arms'
	return true
end 'armsTerminate'

// bodyTerminates is whether the last statement of a body terminates.
function bodyTerminates(tree ast.Tree, body diag.U32) returns bool
	let n = tree.listLen(body)
	if n == 0 'empty'
		return false
	end 'empty'
	return terminates(tree, s: tree.listAt(body, index: try n - 1 otherwise 0 as Count) as ast.NodeID)
end 'bodyTerminates'

// endsBlock is whether control never reaches the statement after this one in its block.
function endsBlock(tree ast.Tree, s ast.NodeID) returns bool
	let k = tree.kindOf(s)
	return k == ast.NodeKind.breakStmt or k == ast.NodeKind.continueStmt or terminates(tree, s: s)
end 'endsBlock'

// liveCount is how many statements of a block can run: those up to the first that terminates or jumps out of the block.
// The rest are type-checked like any code, but record no calls and are not lowered, so they instantiate nothing. A break or
// a continue ends only its own block's live statements: it may leave an enclosing block that is not a loop, so it never
// makes that block terminate.
function liveCount(tree ast.Tree, body diag.U32) returns Count
	let n = tree.listLen(body)
	for i in 0 upto n 'each'
		if endsBlock(tree, s: tree.listAt(body, index: i) as ast.NodeID) 'ends'
			return try i + 1 otherwise n
		end 'ends'
	end 'each'
	return n
end 'liveCount'

function checkBlock(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, body diag.U32, mutates errs diag.ErrorList)
	pushScope(c)
	checkStmts(c, p: p, ms: ms, body: body, errs: errs)
	popScope(c)
end 'checkBlock'

// checkStmts types the statements of a block. Each stops at its first error and the ones after it are typed all the same.
function checkStmts(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, body diag.U32, mutates errs diag.ErrorList)
	let live = liveCount(ms.tree, body: body)
	let outer = c.dead
	for i in 0 upto ms.tree.listLen(body) 'each'
		c.dead = outer or i >= live
		checkStmt(c, p: p, ms: ms, s: ms.tree.listAt(body, index: i) as ast.NodeID, errs: errs)
	end 'each'
	c.dead = outer
end 'checkStmts'

function checkStmt(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let k = ms.tree.kindOf(s)
	if k == ast.NodeKind.letStmt 'let'
		checkLet(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'let'
	if k == ast.NodeKind.assignStmt 'assign'
		checkAssign(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'assign'
	if k == ast.NodeKind.destructStmt 'destruct'
		checkDestruct(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'destruct'
	if k == ast.NodeKind.tupleAssignStmt 'tupleAssign'
		checkTupleAssign(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'tupleAssign'
	if k == ast.NodeKind.exprStmt 'expr'
		checkExprStmt(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'expr'
	if k == ast.NodeKind.discardStmt 'discard'
		_ = checkExpr(c, p: p, ms: ms, e: ast.discardStmtValue(ms.tree, id: s), errs: errs)
		return
	end 'discard'
	if k == ast.NodeKind.ifStmt 'if'
		checkIf(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'if'
	if k == ast.NodeKind.ifTryStmt 'ifTry'
		checkIfTryStmt(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'ifTry'
	if k == ast.NodeKind.whileStmt 'while'
		checkWhile(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'while'
	if k == ast.NodeKind.forStmt 'for'
		checkFor(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'for'
	if k == ast.NodeKind.matchStmt 'match'
		_ = checkMatch(c, p: p, ms: ms, core: ast.matchStmtMatch(ms.tree, id: s), isExpr: false, errs: errs)
		return
	end 'match'
	if k == ast.NodeKind.tryStmt 'try'
		checkTryStmt(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'try'
	if k == ast.NodeKind.throwStmt 'throw'
		checkThrow(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'throw'
	if k == ast.NodeKind.returnStmt 'return'
		checkReturn(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'return'
	if k == ast.NodeKind.breakStmt 'break'
		checkJump(c, p: p, ms: ms, s: s, isBreak: true, errs: errs)
		return
	end 'break'
	if k == ast.NodeKind.continueStmt 'continue'
		checkJump(c, p: p, ms: ms, s: s, isBreak: false, errs: errs)
		return
	end 'continue'
	if k == ast.NodeKind.whenStmt 'when'
		checkBehaviour(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'when'
	panic("the node {s} of kind {k.name} is no statement")
end 'checkStmt'

function checkExprStmt(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let whole = ast.exprStmtE(ms.tree, id: s)
	var e = whole
	var catches = false
	if ms.tree.kindOf(e) == ast.NodeKind.tryExpr 'try'
		c.statement = e
		catches = ast.tryExprHandler(ms.tree, id: e) != 0 or ast.tryExprIgnore(ms.tree, id: e)
		e = ast.tryExprE(ms.tree, id: e)
	end 'try'
	let k = ms.tree.kindOf(e)
	if not catches and k != ast.NodeKind.callExpr and k != ast.NodeKind.panicExpr 'notCall'
		failAt(c, p: p, ms: ms, node: s, code: diag.errUnexpectedToken, msg: "only a call can stand alone as a statement; bind the value with 'let', or discard it with '_ ='", errs: errs)
		return
	end 'notCall'
	_ = checkExpr(c, p: p, ms: ms, e: whole, errs: errs)
end 'checkExprStmt'

function checkIf(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	if not requireBool(c, p: p, ms: ms, e: ast.ifStmtCond(ms.tree, id: s), keyword: "if", errs: errs) 'badCond'
		return
	end 'badCond'
	checkBlock(c, p: p, ms: ms, body: ast.ifStmtThenRef(ms.tree, id: s), errs: errs)
	if ast.ifStmtHasElse(ms.tree, id: s) 'else'
		checkBlock(c, p: p, ms: ms, body: ast.ifStmtElseRef(ms.tree, id: s), errs: errs)
	end 'else'
end 'checkIf'

// The word 'try' and the space after it, which come right before the call of a conditional try.
let tryKeywordWidth = 4 as Count

// ifTryKeywordOffset is where the 'try' of a conditional try is, which its errors are reported at.
function ifTryKeywordOffset(tree ast.Tree, call ast.NodeID) returns diag.U32
	return try (ast.exprStart(tree, e: call) - tryKeywordWidth) as diag.U32 otherwise panic("a conditional try starts before its 'try'")
end 'ifTryKeywordOffset'

// failVoidTry refuses a 	ry of a call that returns nothing where a value is needed, and tells whether e was one.
function failVoidTry(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns bool
	if ms.tree.kindOf(e) != ast.NodeKind.tryExpr 'notTry'
		return false
	end 'notTry'
	let call = ast.tryExprE(ms.tree, id: e)
	if ms.tree.kindOf(call) != ast.NodeKind.callExpr 'notCall'
		return false
	end 'notCall'
	failAt(c, p: p, ms: ms, node: e, code: diag.errErrorTypeMismatch, msg: diag.callReturnsNoValue(voidCalleeText(c, p: p, ms: ms, call: call)), errs: errs)
	return true
end 'failVoidTry'

// voidCalleeText is the callee of a call that returns nothing, as maxon names it: a method of a declared type with its type's name,\n// a method of a built-in type by its own name alone.
function voidCalleeText(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID) returns String
	let callee = ast.callExprCallee(ms.tree, id: call)
	if ms.tree.kindOf(callee) != ast.NodeKind.memberExpr 'plain'
		return calleeText(ms.tree, call: call)
	end 'plain'
	let name = ast.memberExprName(ms.tree, id: callee)
	let holder = ast.contentType(ms.types, reads: p.types, t: ast.nodeType(c.typing, node: ast.memberExprObj(ms.tree, id: callee)))
	if holder != ast.noType and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: holder)).hasDecl and ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: holder)).decl.module != diag.stdlibID 'declared'
		return "{declaredNameOfType(p, ms: ms, t: holder)}.{name}"
	end 'declared'
	return name
end 'voidCalleeText'

// calleeText is the name a call is written with, as an error names it.
function calleeText(tree ast.Tree, call ast.NodeID) returns String
	return placeText(tree, e: ast.callExprCallee(tree, id: call))
end 'calleeText'

// checkIfTryStmt types a conditional try: its call can fail, and what it gives is bound for the block that runs when it does
// not. The else block runs on a failure, and names the error when it asks. The error binding is keyed by the call, the
// binding of the result by the statement.
function checkIfTryStmt(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let call = ast.ifTryStmtCall(ms.tree, id: s)
	let name = ast.ifTryStmtName(ms.tree, id: s)
	if ms.tree.kindOf(call) != ast.NodeKind.callExpr 'notCall'
		checkFail(c.modID, off: ifTryKeywordOffset(ms.tree, call: call), code: diag.errExpressionError, msg: "'if try' tests a call that can fail: write the call after 'try'", errs: errs)
		return
	end 'notCall'
	beginCatching(c)
	let t = checkExpr(c, p: p, ms: ms, e: call, errs: errs)
	let errors = endCatching(c)
	if t == ast.noType 'badCall'
		return
	end 'badCall'
	let hasValue = t != p.builtins.voidTy and t != p.builtins.neverTy
	let at = ifTryKeywordOffset(ms.tree, call: call)
	if name == "" and hasValue 'discards'
		checkFail(c.modID, off: at, code: diag.errIfTryDiscardsResult, msg: diag.ifTryDiscardsResult(calleeText(ms.tree, call: call)), errs: errs)
		return
	end 'discards'
	if name != "" and not hasValue 'noValue'
		checkFail(c.modID, off: at, code: diag.errErrorTypeMismatch, msg: diag.callReturnsNoValue(voidCalleeText(c, p: p, ms: ms, call: call)), errs: errs)
		return
	end 'noValue'
	pushScope(c)
	if name != "" 'bind'
		bindLet(c, p: p, ms: ms, s: s, name: name, t: t, isVar: ast.ifTryStmtIsVar(ms.tree, id: s), off: offsetOf(c, p: p, ms: ms, node: s), errs: errs)
	end 'bind'
	checkStmts(c, p: p, ms: ms, body: ast.ifTryStmtThenRef(ms.tree, id: s), errs: errs)
	popScope(c)
	if not ast.ifTryStmtHasElse(ms.tree, id: s) 'noElse'
		return
	end 'noElse'
	let failed = ast.ifTryStmtErrName(ms.tree, id: s)
	let handler = ast.ifTryStmtElseRef(ms.tree, id: s)
	pushScope(c)
	if failed == "" 'anonymous'
		checkStmts(c, p: p, ms: ms, body: handler, errs: errs)
	end 'anonymous' else 'named'
		checkHandlerBinding(c, p: p, ms: ms, s: call, binding: failed, errors: errors, body: handler, requireMatch: false, errs: errs)
	end 'named'
	popScope(c)
end 'checkIfTryStmt'

function checkWhile(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	if not requireBool(c, p: p, ms: ms, e: ast.whileStmtCond(ms.tree, id: s), keyword: "while", errs: errs) 'badCond'
		return
	end 'badCond'
	pushBlock(c, label: ast.whileStmtLabel(ms.tree, id: s), isLoop: true, node: s)
	checkBlock(c, p: p, ms: ms, body: ast.whileStmtBodyRef(ms.tree, id: s), errs: errs)
	popBlock(c)
end 'checkWhile'

function checkFor(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	if not ast.forStmtIsRange(ms.tree, id: s) 'iterates'
		checkForEach(c, p: p, ms: ms, s: s, errs: errs)
		return
	end 'iterates'
	let lowerNode = ast.forStmtFrom(ms.tree, id: s)
	let upperNode = ast.forStmtTo(ms.tree, id: s)
	let lowerTy = checkExpr(c, p: p, ms: ms, e: lowerNode, errs: errs)
	if lowerTy == ast.noType 'badLower'
		return
	end 'badLower'
	let upperTy = checkExpr(c, p: p, ms: ms, e: upperNode, errs: errs)
	if upperTy == ast.noType 'badUpper'
		return
	end 'badUpper'
	if not ast.isIntType(ms.types, reads: p.types, t: lowerTy) or not ast.isIntType(ms.types, reads: p.types, t: upperTy) 'notInts'
		failAt(c, p: p, ms: ms, node: s, code: diag.errTypeMismatch, msg: "a range needs integer bounds, found {nameOfType(p, ms: ms, t: lowerTy)} and {nameOfType(p, ms: ms, t: upperTy)}", errs: errs)
		return
	end 'notInts'
	let varType = forVariableType(c, p: p, ms: ms, s: s, lowerTy: lowerTy, upperTy: upperTy, errs: errs)
	if varType == ast.noType 'badType'
		return
	end 'badType'
	checkForBody(c, p: p, ms: ms, s: s, varType: varType, borrows: false, errs: errs)
end 'checkFor'

// checkForBody declares the variable of a for and checks the body it is in scope for. A variable that borrows is an
// element the collection lends, as a match binding of a payload is.
function checkForBody(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, varType ast.TypeID, borrows bool, mutates errs diag.ErrorList)
	enterForBody(c, p: p, ms: ms, s: s)
	let destructures = ms.tree.listLen(ast.forStmtVarsRef(ms.tree, id: s)) > 0
	var local = ast.noLocal
	var bound = ast.NodeIDList.create(0)
	if destructures 'tuples'
		local = declareTupleVariable(c, p: p, ms: ms, s: s, varType: varType, bound: bound, errs: errs)
	end 'tuples' else 'single'
		let name = ast.forStmtVar(ms.tree, id: s)
		local = declareLocal(c, p: p, ms: ms, name: name, t: varType, isVar: false, definedAt: s, off: offsetOf(c, p: p, ms: ms, node: s), errs: errs)
	end 'single'
	if local != ast.noLocal 'declared'
		c.typing.locals[local as Count].projected = borrows
		c.typing.nodeLocals.insert(s as Count, value: local)
		checkStmts(c, p: p, ms: ms, body: ast.forStmtBodyRef(ms.tree, id: s), errs: errs)
		if destructures 'steps'
			putStepsBeforeBody(c, p: p, ms: ms, s: s, steps: bound)
		end 'steps'
	end 'declared'
	leaveForBody(c)
end 'checkForBody'

function enterForBody(mutates c Checker, p ast.Project, ms ast.ModuleState, s ast.NodeID)
	pushBlock(c, label: ast.forStmtLabel(ms.tree, id: s), isLoop: true, node: s)
	pushScope(c)
end 'enterForBody'

function leaveForBody(mutates c Checker)
	popScope(c)
	popBlock(c)
end 'leaveForBody'

// checkMapEntries types a for over the entries of a Map, in the order their keys were inserted. Each pass lends the key
// and the value of one entry to the two names of the loop, as an array lends an element, so no pair is made for the
// entry: the loop names both, `for (key, value) in m`, and `_` stands for one it does not need.
function checkMapEntries(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList)
	let namesRef = ast.forStmtVarsRef(ms.tree, id: s)
	if ms.tree.listLen(namesRef) != 2 'notPair'
		failAt(c, p: p, ms: ms, node: s, code: diag.errUnsupportedFeature, msg: "Unsupported: `for … in` over a `{nameOfType(p, ms: ms, t: t)}` needs a name for the key and one for the value, `for (key, value) in map`, with `_` for the one the body does not use: the map holds no pair of the two to bind to a single variable", errs: errs)
		return
	end 'notPair'
	let args = ast.typeArgsOf(ms.types, reads: p.types, t: t)
	enterForBody(c, p: p, ms: ms, s: s)
	for i in 0 upto 2 'names'
		let at = ms.tree.listAt(namesRef, index: i) as ast.NodeID
		let name = ast.bindNameName(ms.tree, id: at)
		if name == "_" 'discard'
			continue 'names'
		end 'discard'
		let local = declareLocal(c, p: p, ms: ms, name: name, t: args[i], isVar: false, definedAt: s, off: offsetOf(c, p: p, ms: ms, node: at), errs: errs)
		if local == ast.noLocal 'failed'
			leaveForBody(c)
			return
		end 'failed'
		c.typing.locals[local as Count].projected = ast.isManagedType(ms.types, reads: p.types, t: args[i])
		c.typing.nodeLocals.insert(at as Count, value: local)
	end 'names'
	checkStmts(c, p: p, ms: ms, body: ast.forStmtBodyRef(ms.tree, id: s), errs: errs)
	leaveForBody(c)
end 'checkMapEntries'

// The methods of maxon's iteration protocol: a cursor's current() is its element and advance() moves it on, throwing
// IterationError past the last one, and a collection's createIterator() makes a cursor, throwing where it is empty.
let currentMethod = "current"

let advanceMethod = "advance"

let createIteratorMethod = "createIterator"

// checkForEach types a for over the elements of a collection. An array lends each element to the variable, as a
// subscript lends it, and a map its keys and values; a type that declares the iteration protocol gives each one as the
// value its current() returns.
function checkForEach(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let source = ast.forStmtFrom(ms.tree, id: s)
	let typed = checkExpr(c, p: p, ms: ms, e: source, errs: errs)
	if typed == ast.noType 'badSource'
		return
	end 'badSource'
	let t = ast.contentType(ms.types, reads: p.types, t: typed)
	if not requireNotCown(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: source), t: t, use: "a 'for' over its elements", errs: errs) 'cown'
		return
	end 'cown'
	if kindOfType(p, ms: ms, t: t) == ast.TypeKind.builtinArray 'array'
		let elem = typeElemType(p, ms: ms, ownerTy: t)
		checkForBody(c, p: p, ms: ms, s: s, varType: elem, borrows: ast.isManagedType(ms.types, reads: p.types, t: elem), errs: errs)
		return
	end 'array'
	if kindOfType(p, ms: ms, t: t) == ast.TypeKind.builtinMap 'map'
		checkMapEntries(c, p: p, ms: ms, s: s, t: t, errs: errs)
		return
	end 'map'
	let elem = checkIteration(c, p: p, ms: ms, s: s, t: t, typed: typed, errs: errs)
	if elem == ast.noType 'notIterable'
		return
	end 'notIterable'
	checkForBody(c, p: p, ms: ms, s: s, varType: elem, borrows: false, errs: errs)
end 'checkForEach'

// checkIteration finds how a for walks a value of type t through the iteration protocol, records it for the node, and
// gives the type of the elements: none, with an error, when t declares no protocol a loop can walk. A type that is a
// cursor itself is walked from where it stands, and any other through the cursor its createIterator() makes.
function checkIteration(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, t ast.TypeID, typed ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	var cursor = t
	var factory = ast.noFunc
	if not declaresCursor(p, ms: ms, t: t) 'factory'
		factory = zeroArgumentMethod(p, ms: ms, t: t, name: createIteratorMethod)
		if factory == ast.noFunc 'none'
			failNotIterable(c, p: p, ms: ms, s: s, t: typed, errs: errs)
			return ast.noType
		end 'none'
		let thrown = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: factory).errTy
		if thrown != ast.noType and thrown != p.builtins.iterationErrorTy 'otherError'
			failAt(c, p: p, ms: ms, node: s, code: diag.errUnsupportedFeature, msg: "Unsupported: `for … in` over a `{nameOfType(p, ms: ms, t: t)}`, whose `{createIteratorMethod}()` throws `{nameOfType(p, ms: ms, t: thrown)}` — the loop absorbs what the traversal protocol throws without binding it, which is sound only for the payload-free `IterationError`; a factory throwing anything else must be called with an explicit `try` and its result iterated", errs: errs)
			return ast.noType
		end 'otherError'
		let made = methodResult(p, ms: ms, recv: t, method: factory)
		cursor = ast.contentType(ms.types, reads: p.types, t: made)
		if not declaresCursor(p, ms: ms, t: cursor) 'notCursor'
			failNotIterable(c, p: p, ms: ms, s: s, t: cursor, errs: errs)
			return ast.noType
		end 'notCursor'
	end 'factory'
	let current = zeroArgumentMethod(p, ms: ms, t: cursor, name: currentMethod)
	let advance = zeroArgumentMethod(p, ms: ms, t: cursor, name: advanceMethod)
	var info = ast.IterationInfo.make(cursor, current: methodCall(p, ms: ms, recv: cursor, method: current), advance: methodCall(p, ms: ms, recv: cursor, method: advance))
	var generic = isGeneric(p, ms: ms, f: current) or isGeneric(p, ms: ms, f: advance)
	if factory != ast.noFunc 'withFactory'
		info.hasFactory = true
		info.factory = methodCall(p, ms: ms, recv: t, method: factory)
		generic = generic or isGeneric(p, ms: ms, f: factory)
		if not requireVisible(c, p: p, ms: ms, node: s, target: factory, errs: errs) 'hiddenFactory'
			return ast.noType
		end 'hiddenFactory'
	end 'withFactory'
	if not requireVisible(c, p: p, ms: ms, node: s, target: current, errs: errs) or not requireVisible(c, p: p, ms: ms, node: s, target: advance, errs: errs) 'hidden'
		return ast.noType
	end 'hidden'
	if (factory != ast.noFunc and not requireOwnedResult(c, p: p, ms: ms, node: s, target: factory, use: "a for", errs: errs)) or not requireOwnedResult(c, p: p, ms: ms, node: s, target: current, use: "a for", errs: errs) 'borrowed'
		return ast.noType
	end 'borrowed'
	c.typing.iterations.insert(s as Count, value: info)
	if generic 'instances'
		recordUse(c, call: s)
	end 'instances'
	return methodResult(p, ms: ms, recv: cursor, method: current)
end 'checkIteration'

function failNotIterable(c Checker, p ast.Project, ms ast.ModuleState, s ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList)
	failAt(c, p: p, ms: ms, node: s, code: diag.errUnsupportedFeature, msg: "Unsupported: `for … in` over a `{nameOfType(p, ms: ms, t: t)}` value — the compiler iterates an `Array`, a `Map`'s entries, the counted ranges `<lo> to <hi>` / `<lo> upto <hi>`, and any type declaring the cursor protocol `{currentMethod}()` + `{advanceMethod}() throws IterationError` or a `{createIteratorMethod}()` factory that returns one", errs: errs)
end 'failNotIterable'

// declaresCursor is whether a type is a cursor: its current() gives a value and cannot fail, and its advance() throws
// IterationError.
function declaresCursor(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let current = zeroArgumentMethod(p, ms: ms, t: t, name: currentMethod)
	let advance = zeroArgumentMethod(p, ms: ms, t: t, name: advanceMethod)
	return current != ast.noFunc and advance != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: current).retTy != p.builtins.voidTy and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: current).errTy == ast.noType and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: advance).errTy == p.builtins.iterationErrorTy
end 'declaresCursor'

// zeroArgumentMethod is the method of that name a value of type t has that takes no arguments, or none.
function zeroArgumentMethod(p ast.Project, ms ast.ModuleState, t ast.TypeID, name String) returns ast.FuncID
	if not typeIsNominal(ms.types, reads: p.types, t: t) 'notNominal'
		return ast.noFunc
	end 'notNominal'
	let method = methodNamed(p, ms: ms, t: t, name: name)
	if method == ast.noFunc or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).isStatic or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).params.count() != 0 'unfit'
		return ast.noFunc
	end 'unfit'
	return method
end 'zeroArgumentMethod'

function isGeneric(p ast.Project, ms ast.ModuleState, f ast.FuncID) returns bool
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).generics.count() > 0
end 'isGeneric'

// methodCall is a call of a method that takes no arguments on a value of type recv, as a call written in the source
// records it.
function methodCall(p ast.Project, ms ast.ModuleState, recv ast.TypeID, method ast.FuncID) returns ast.CallInfo
	var info = ast.CallInfo.make(ast.CallKind.callMethod, fn: method, receiverTy: ast.noType)
	if isGeneric(p, ms: ms, f: method) 'generic'
		info.typeArgs = ast.typeEntry(ms.types, reads: p.types, t: recv).typeArgs.clone()
	end 'generic'
	info.selfConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).selfConv
	return info
end 'methodCall'

// methodResult is the type that a method of the type recv returns, with the type's arguments for its parameters.
function methodResult(p ast.Project, mutates ms ast.ModuleState, recv ast.TypeID, method ast.FuncID) returns ast.TypeID
	let result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).retTy
	if not isGeneric(p, ms: ms, f: method) 'plain'
		return result
	end 'plain'
	let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).generics)
	let args = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: recv).typeArgs)
	return ast.substituteType(ms.types, reads: p.types, t: result, params: generics, args: args)
end 'methodResult'

// forVariableType is the type of the variable of a for: the alias of a bound that has one, else the range from the first
// value of the lower bound to the last of the upper.
function forVariableType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, lowerTy ast.TypeID, upperTy ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let off = offsetOf(c, p: p, ms: ms, node: s)
	if typeIsNamedInt(ms.types, reads: p.types, t: lowerTy) or typeIsNamedInt(ms.types, reads: p.types, t: upperTy) 'named'
		return unifyInts(c, p: p, ms: ms, off: off, clash: Clash.other, l: lowerTy, r: upperTy, errs: errs)
	end 'named'
	let lowerOff = offsetOf(c, p: p, ms: ms, node: ast.forStmtFrom(ms.tree, id: s))
	if not requireSigned64(c, off: lowerOff, t: lowerTy, p: p, ms: ms, errs: errs) 'wideLower'
		return ast.noType
	end 'wideLower'
	let upperOff = offsetOf(c, p: p, ms: ms, node: ast.forStmtTo(ms.tree, id: s))
	if not requireSigned64(c, off: upperOff, t: upperTy, p: p, ms: ms, errs: errs) 'wideUpper'
		return ast.noType
	end 'wideUpper'
	let lo = rangeLo(ms.types, reads: p.types, t: lowerTy)
	var hi = rangeHi(ms.types, reads: p.types, t: upperTy)
	if not ast.forStmtInclusive(ms.tree, id: s) 'exclusive'
		hi = hi.sub(ast.I128.one())
	end 'exclusive'
	return ast.internIntRange(ms.types, reads: p.types, aliasName: "", minVal: lo.clone(), maxVal: ast.maxI128(lo, b: hi), inferred: true)
end 'forVariableType'

// heapAnnotationWord is the one annotation of a binding.
let heapAnnotationWord = "heap"

// scalarTag is what a value that owns no heap is called where `@heap` refuses it, and empty for a value that does.
function scalarTag(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return match kindOfType(p, ms: ms, t: t) 'k'
		primBool gives "bool"
		intRange gives "int"
		constInt gives "int"
		floatRange gives "float"
		constFloat gives "float"
		enumTy gives "enum"
		funcTy gives "function"
		invalid gives ""
		primString gives ""
		primVoid gives ""
		primNever gives ""
		record gives ""
		unionTy gives ""
		builtinArray gives ""
		builtinMap gives ""
		builtinList gives ""
		builtinPool gives ""
		builtinHandle gives ""
		builtinFrozen gives ""
		builtinCown gives ""
		typeParam gives ""
		interfaceTy gives ""
	end 'k'
end 'scalarTag'

// checkHeapAnnotation holds `@heap let x = value` to what Maxon holds it to: no other word after the `@`, and a value that owns a heap
// record. A record is a box here whatever the annotation says, so it changes nothing else. It gives whether the binding is
// well annotated.
function checkHeapAnnotation(mutates c Checker, p ast.Project, ms ast.ModuleState, s ast.NodeID, name String, t ast.TypeID, mutates errs diag.ErrorList) returns bool
	let tag = scalarTag(p, ms: ms, t: t)
	if tag == "" 'owns'
		return true
	end 'owns'
	checkFail(c.modID, off: try ast.letStmtNameRef(ms.tree, id: s) - 1 otherwise panic("a name starts at no offset"), code: diag.errUnexpectedToken, msg: diag.heapAnnotationOnNonRecord(name, tag: tag), errs: errs)
	return false
end 'checkHeapAnnotation'

function checkLet(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	if ast.letStmtIsHeap(ms.tree, id: s) and ast.letStmtAnnotation(ms.tree, id: s) != heapAnnotationWord 'unknownAnnotation'
		failAt(c, p: p, ms: ms, node: s, code: diag.errUnexpectedToken, msg: diag.unknownAnnotation(ast.letStmtAnnotation(ms.tree, id: s)), errs: errs)
		return
	end 'unknownAnnotation'
	let name = ast.letStmtName(ms.tree, id: s)
	if name == "_" 'discard'
		failAt(c, p: p, ms: ms, node: s, code: diag.errUnexpectedToken, msg: "write '_ = call()' to discard a result", errs: errs)
		return
	end 'discard'
	let isVar = ast.letStmtIsVar(ms.tree, id: s)
	let initNode = ast.letStmtInit(ms.tree, id: s)
	let off = offsetOf(c, p: p, ms: ms, node: s)
	if initNode == 0 'declaredOnly'
		let owner = c.owner
		let declared = resolveTypeRef(c, p: p, ms: ms, tr: ast.letStmtType(ms.tree, id: s), selfTy: owner, errs: errs)
		if declared == ast.noType 'badType'
			bindLet(c, p: p, ms: ms, s: s, name: name, t: ast.noType, isVar: isVar, off: off, errs: errs)
			return
		end 'badType'
		bindLet(c, p: p, ms: ms, s: s, name: name, t: declared, isVar: isVar, off: off, errs: errs)
		return
	end 'declaredOnly'
	let t = checkExpr(c, p: p, ms: ms, e: initNode, errs: errs)
	if t == ast.noType 'badInit'
		bindLet(c, p: p, ms: ms, s: s, name: name, t: ast.noType, isVar: isVar, off: off, errs: errs)
		return
	end 'badInit'
	let initOff = offsetOf(c, p: p, ms: ms, node: initNode)
	if not requireSigned64(c, off: initOff, t: t, p: p, ms: ms, errs: errs) 'wide'
		bindLet(c, p: p, ms: ms, s: s, name: name, t: ast.noType, isVar: isVar, off: off, errs: errs)
		return
	end 'wide'
	if t == p.builtins.voidTy or t == p.builtins.neverTy 'noValue'
		if not failVoidTry(c, p: p, ms: ms, e: initNode, errs: errs) 'plain'
			failAt(c, p: p, ms: ms, node: initNode, code: diag.errTypeMismatch, msg: "'{name}' is bound to an expression with no value", errs: errs)
		end 'plain'
		bindLet(c, p: p, ms: ms, s: s, name: name, t: ast.noType, isVar: isVar, off: off, errs: errs)
		return
	end 'noValue'
	if isVar and (isConstInt(p, ms: ms, t: t) or typeIsAnonInt(ms.types, reads: p.types, t: t) or holdsBareNumbers(p, ms: ms, t: t)) 'bareNumber'
		failAt(c, p: p, ms: ms, node: initNode, code: diag.errExpressionError, msg: diag.varStartsFromBareNumber(), errs: errs)
		bindLet(c, p: p, ms: ms, s: s, name: name, t: ast.noType, isVar: isVar, off: off, errs: errs)
		return
	end 'bareNumber'
	if ast.letStmtIsHeap(ms.tree, id: s) and not checkHeapAnnotation(c, p: p, ms: ms, s: s, name: name, t: t, errs: errs) 'badHeap'
		bindLet(c, p: p, ms: ms, s: s, name: name, t: ast.noType, isVar: isVar, off: off, errs: errs)
		return
	end 'badHeap'
	bindLet(c, p: p, ms: ms, s: s, name: name, t: t, isVar: isVar, off: off, errs: errs)
end 'checkLet'

function bindLet(mutates c Checker, p ast.Project, ms ast.ModuleState, s ast.NodeID, name String, t ast.TypeID, isVar bool, off diag.U32, mutates errs diag.ErrorList)
	let local = declareLocal(c, p: p, ms: ms, name: name, t: t, isVar: isVar, definedAt: s, off: off, errs: errs)
	if local != ast.noLocal 'declared'
		c.typing.nodeLocals.insert(s as Count, value: local)
	end 'declared'
end 'bindLet'

// checkAssign types an assignment to a variable, a field or an element.
function checkAssign(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let targetNode = ast.assignStmtTarget(ms.tree, id: s)
	let valueNode = ast.assignStmtValue(ms.tree, id: s)
	let k = ms.tree.kindOf(targetNode)
	var target = ast.noType
	var wrong = Mismatch.expectedGot
	if k == ast.NodeKind.nameExpr 'name'
		target = checkNameExpr(c, p: p, ms: ms, e: targetNode, errs: errs)
		if target != ast.noType and nameInfoOf(c.typing, node: targetNode).kind == ast.NameKind.nameConst 'constant'
			let constant = ast.declName(p, ref: nameInfoOf(c.typing, node: targetNode).decl)
			failAt(c, p: p, ms: ms, node: s, code: diag.errAssignToImmutable, msg: diag.letReassigned(constant), errs: errs)
			return
		end 'constant'
		let varPlace = "variable '{ast.nameExprName(ms.tree, id: targetNode)}'"
		wrong = Mismatch.assignment(varPlace.clone(), bare: varPlace)
	end 'name' else if k == ast.NodeKind.memberExpr 'member'
		target = checkMember(c, p: p, ms: ms, e: targetNode, errs: errs)
		if target == ast.noType 'badMember'
			return
		end 'badMember'
		let memberName = ast.memberExprName(ms.tree, id: targetNode)
		if memberKindOf(c, node: targetNode) != ast.MemberKind.memberField 'notField'
			failAt(c, p: p, ms: ms, node: s, code: diag.errAssignToImmutable, msg: "'{memberName}' cannot be assigned", errs: errs)
			return
		end 'notField'
		let holder = ast.contentType(ms.types, reads: p.types, t: ast.nodeType(c.typing, node: ast.memberExprObj(ms.tree, id: targetNode)))
		wrong = Mismatch.assignment("field '{memberName}' of '{declaredNameOfType(p, ms: ms, t: holder)}'", bare: "field '{memberName}'")
	end 'member' else if k == ast.NodeKind.indexExpr 'index'
		target = checkIndex(c, p: p, ms: ms, e: targetNode, errs: errs)
	end 'index' else 'other'
		failAt(c, p: p, ms: ms, node: s, code: diag.errUnexpectedToken, msg: "only a variable, a field or an element can be assigned", errs: errs)
		return
	end 'other'
	if target == ast.noType 'badTarget'
		return
	end 'badTarget'
	ast.setNodeType(c.typing, node: targetNode, ty: target)
	let value = checkExpecting(c, p: p, ms: ms, e: valueNode, want: target, errs: errs)
	if value == ast.noType 'badValue'
		return
	end 'badValue'
	if k == ast.NodeKind.nameExpr and not namesAssignable(c, node: targetNode) 'refused'
		return
	end 'refused'
	_ = coerce(c, p: p, ms: ms, node: valueNode, at: placeOffset(c, p: p, ms: ms, place: targetNode), src: value, target: target, wrong: wrong, errs: errs)
end 'checkAssign'

// namesAssignable is whether the name that an assignment targets may be reassigned. When it may not, the value is not held to the\n// name's type, since the refusal is the assignment's, which the ownership pass reports.
function namesAssignable(c Checker, node ast.NodeID) returns bool
	let info = nameInfoOf(c.typing, node: node)
	return match info.kind 'k'
		nameLocal gives isMutableLocal(c.typing.locals[info.local as Count])
		nameSelfField gives true
		nameConst gives false
		nameFunc gives false
		nameUnresolved gives false
	end 'k'
end 'namesAssignable'

function memberKindOf(c Checker, node ast.NodeID) returns ast.MemberKind
	match consumes c.typing.members.get(node as Count) 'info'
		some(m) then return m.kind
		none then _ = 0
	end 'info'
	panic("the member at node {node} was typed without a record of what it is")
end 'memberKindOf'

function checkReturn(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let ret = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).retTy
	let fnName = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).name.clone()
	let value = ast.returnStmtValue(ms.tree, id: s)
	if ret == p.builtins.voidTy 'void'
		if value != 0 and c.inClosure 'closure'
			let given = checkExpr(c, p: p, ms: ms, e: value, errs: errs)
			if given != ast.noType and given != ret and given != p.builtins.neverTy 'valued'
				failAt(c, p: p, ms: ms, node: value, code: diag.errTypeMismatch, msg: "the closure gives {nameOfType(p, ms: ms, t: given)}, and its function type returns nothing; call something that returns nothing, or give the function type a result", errs: errs)
			end 'valued'
			return
		end 'closure'
		if value != 0 'given'
			if c.inBehaviour 'behaviour'
				failAt(c, p: p, ms: ms, node: s, code: diag.errTypeMismatch, msg: "a behaviour returns nothing and nothing waits for it: pass a result on by scheduling another behaviour", errs: errs)
				return
			end 'behaviour'
			failAt(c, p: p, ms: ms, node: s, code: diag.errTypeMismatch, msg: diag.returnValueFromVoid(fnName), errs: errs)
		end 'given'
		return
	end 'void'
	if value == 0 'missing'
		failAt(c, p: p, ms: ms, node: s, code: diag.errMissingReturn, msg: diag.returnWithoutValue(fnName), errs: errs)
		return
	end 'missing'
	if ret == ast.noType 'inferred'
		let given = checkExpr(c, p: p, ms: ms, e: value, errs: errs)
		if given != ast.noType 'typed'
			_ = inferResult(c, p: p, ms: ms, t: given)
		end 'typed'
		return
	end 'inferred'
	let t = checkExpecting(c, p: p, ms: ms, e: value, want: ret, errs: errs)
	if t == ast.noType 'badValue'
		return
	end 'badValue'
	if convertsInteger(p, ms: ms, src: t, dst: ret) or convertsFloat(p, ms: ms, src: t, dst: ret) 'converts'
		setOperand(c, node: s, operand: t)
		return
	end 'converts'
	if typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.funcTy) and typeHasKind(p, ms: ms, t: ret, kind: ast.TypeKind.funcTy) 'function'
		// A return re-brands a function value of the right shape, as in maxon.
		if not shapeFits(p, ms: ms, src: t, dst: ret) 'shape'
			failAt(c, p: p, ms: ms, node: s, code: diag.errTypeMismatch, msg: diag.functionShapeReturned(clashName(p, ms: ms, t: ret, other: t), got: clashName(p, ms: ms, t: t, other: ret)), errs: errs)
		end 'shape'
		return
	end 'function'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).result == ast.ResultConv.resultBorrowed and lendsContents(p, ms: ms, t: t, want: ret) 'contents'
		return
	end 'contents'
	_ = coerce(c, p: p, ms: ms, node: value, at: offsetOf(c, p: p, ms: ms, node: s), src: t, target: ret, wrong: Mismatch.returned, errs: errs)
end 'checkReturn'

// checkThrow types a throw, which fails with a case of an error enum or a value of an error union.
function checkThrow(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let value = ast.throwStmtValue(ms.tree, id: s)
	let e = checkExpr(c, p: p, ms: ms, e: value, errs: errs)
	if e == ast.noType 'badValue'
		return
	end 'badValue'
	if not ast.isErrorType(ms.types, reads: p.types, t: e) 'notError'
		failAt(c, p: p, ms: ms, node: s, code: diag.errTypeMismatch, msg: diag.thrownValueNotAnErrorEnum(), errs: errs)
		return
	end 'notError'
	recordFailure(c, e: e)
end 'checkThrow'

function checkJump(mutates c Checker, p ast.Project, ms ast.ModuleState, s ast.NodeID, isBreak bool, mutates errs diag.ErrorList)
	var label = ast.continueStmtLabel(ms.tree, id: s)
	if isBreak 'break'
		label = ast.breakStmtLabel(ms.tree, id: s)
	end 'break'
	match consumes resolveJump(c, p: p, ms: ms, s: s, label: label, isBreak: isBreak, errs: errs) 'target'
		some(node) then c.typing.jumps.insert(s as Count, value: node)
		none then _ = 0
	end 'target'
end 'checkJump'

// resolveJump is the loop or match that a break or a continue leaves or repeats, or none after it reported why there is
// none.
function resolveJump(c Checker, p ast.Project, ms ast.ModuleState, s ast.NodeID, label String, isBreak bool, mutates errs diag.ErrorList) returns table.Option with ast.NodeID
	var word = "continue"
	if isBreak 'break'
		word = "break"
	end 'break'
	var i = c.blocks.count()
	while i > 0 'blocks'
		i = try i - 1 otherwise 0 as Count
		let frame = c.blocks[i].clone()
		if label == "" 'unlabelled'
			if isBreak or frame.isLoop 'found'
				return table.Option.some(frame.node)
			end 'found'
			continue 'blocks'
		end 'unlabelled'
		if frame.label != label 'other'
			continue 'blocks'
		end 'other'
		if not isBreak and not frame.isLoop 'notLoop'
			failAt(c, p: p, ms: ms, node: s, code: diag.errUnexpectedToken, msg: "'continue' names '{label}', which is not a loop", errs: errs)
			return table.Option.none
		end 'notLoop'
		return table.Option.some(frame.node)
	end 'blocks'
	if label == "" 'noLoop'
		failAt(c, p: p, ms: ms, node: s, code: diag.errUnexpectedToken, msg: "'{word}' outside a loop", errs: errs)
		return table.Option.none
	end 'noLoop'
	failAt(c, p: p, ms: ms, node: s, code: diag.errUnexpectedToken, msg: "no enclosing loop or match is labelled '{label}'", errs: errs)
	return table.Option.none
end 'resolveJump'

// catching: beginCatching and endCatching surround code whose failures a try catches, and give the errors they fail with.
function beginCatching(mutates c Checker)
	c.tries.push(TryFrame.make())
end 'beginCatching'

function endCatching(mutates c Checker) returns ast.TypeIDList
	let frame = try c.tries.pop() otherwise panic("a try ended that was never begun")
	return frame.errors.clone()
end 'endCatching'

// recordFailure notes that the code being checked can fail with the error e, for the try that catches it.
function recordFailure(mutates c Checker, e ast.TypeID)
	if c.tries.count() == 0 'none'
		return
	end 'none'
	let last = try c.tries.count() - 1 otherwise 0 as Count
	for i in 0 upto c.tries[last].errors.count() 'seen'
		if c.tries[last].errors[i] == e 'again'
			return
		end 'again'
	end 'seen'
	c.tries[last].errors.push(e)
end 'recordFailure'

// checkTryStmt types the body of a try block and its handler, which may name the error that failed.
function checkTryStmt(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	let body = ast.tryStmtBodyRef(ms.tree, id: s)
	if not ast.tryStmtHasOtherwise(ms.tree, id: s) 'plain'
		checkBlock(c, p: p, ms: ms, body: body, errs: errs)
		return
	end 'plain'
	beginCatching(c)
	checkBlock(c, p: p, ms: ms, body: body, errs: errs)
	let errors = endCatching(c)
	let handler = ast.tryStmtHandlerRef(ms.tree, id: s)
	let binding = ast.tryStmtBinding(ms.tree, id: s)
	pushScope(c)
	if binding == "" 'anonymous'
		checkStmts(c, p: p, ms: ms, body: handler, errs: errs)
		popScope(c)
		return
	end 'anonymous'
	checkHandlerBinding(c, p: p, ms: ms, s: s, binding: binding, errors: errors, body: handler, requireMatch: true, errs: errs)
	popScope(c)
end 'checkTryStmt'

// checkHandlerBinding types the body of a handler that names the error, which a try block's handler must match on and a
// try expression's need not.
function checkHandlerBinding(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, binding String, errors ast.TypeIDList, body diag.U32, requireMatch bool, mutates errs diag.ErrorList)
	let handled = handlerError(c, p: p, ms: ms, s: s, binding: binding, errors: errors, errs: errs)
	if handled == ast.noType 'ambiguous'
		return
	end 'ambiguous'
	let local = declareLocal(c, p: p, ms: ms, name: binding, t: handled, isVar: false, definedAt: s, off: offsetOf(c, p: p, ms: ms, node: s), errs: errs)
	if local == ast.noLocal 'failed'
		return
	end 'failed'
	c.typing.nodeLocals.insert(s as Count, value: local)
	c.bindings.push(TryBinding.make(local))
	checkStmts(c, p: p, ms: ms, body: body, errs: errs)
	let frame = try c.bindings.pop() otherwise panic("a handler ended that was never begun")
	if requireMatch and not frame.matched 'unmatched'
		failAt(c, p: p, ms: ms, node: s, code: diag.errTryBlockBindingNotMatched, msg: diag.tryBlockBindingNotMatched(binding), errs: errs)
	end 'unmatched'
end 'checkHandlerBinding'

// handlerError is the error that a try block's handler names: the one error its body's calls and throws fail with, or with
// none of those ArithmeticError, the error of an integer operation, which is all that is left to fail.
function handlerError(c Checker, p ast.Project, ms ast.ModuleState, s ast.NodeID, binding String, errors ast.TypeIDList, mutates errs diag.ErrorList) returns ast.TypeID
	if errors.count() == 0 'none'
		return p.builtins.arithmeticErrorTy
	end 'none'
	if errors.count() == 1 'one'
		return errors[0]
	end 'one'
	failAt(c, p: p, ms: ms, node: s, code: diag.errErrorTypeMismatch, msg: "the block fails with '{nameOfType(p, ms: ms, t: errors[0])}' and with '{nameOfType(p, ms: ms, t: errors[1])}', and '({binding})' names one error: give the calls of one of them a 'try ... otherwise' of their own, or drop '({binding})'", errs: errs)
	return ast.noType
end 'handlerError'

// markMatchedBinding notes a match on the error that a handler names.
function markMatchedBinding(mutates c Checker, p ast.Project, ms ast.ModuleState, subject ast.NodeID)
	if ms.tree.kindOf(subject) != ast.NodeKind.nameExpr 'notName'
		return
	end 'notName'
	let local = lookupLocal(c, name: ast.nameExprName(ms.tree, id: subject))
	for i in 0 upto c.bindings.count() 'each'
		if c.bindings[i].local == local 'hit'
			c.bindings[i].matched = true
		end 'hit'
	end 'each'
end 'markMatchedBinding'
