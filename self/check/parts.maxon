// The fields a move takes out of a local, which leave it partly moved, and what a partly moved local can still do: read
// and assign the fields it has, be given back the ones it lost, and be dropped in what is left of it.

// OwnMove is a field that moved out of a local: the fields to select from the local to reach it, its type, and where it
// went.
export type OwnMove
	export var fields as PathSteps
	export var ty as ast.TypeID
	export var site as diag.U32
	export var dest as OwnDest

	export static function make(consumes fields PathSteps, ty ast.TypeID, site diag.U32, consumes dest OwnDest) returns OwnMove
		return OwnMove{fields: fields, ty: ty, site: site, dest: dest}
	end 'make'

	// covers is whether the move takes the place named by fields, or a place that contains it.
	export function covers(other PathSteps) returns bool
		if fields.count() > other.count() 'deeper'
			return false
		end 'deeper'
		for i in 0 upto fields.count() 'each'
			if not fields[i].sameField(other[i]) 'apart'
				return false
			end 'apart'
		end 'each'
		return true
	end 'covers'

	// overlapsPath is whether the move and the place share storage: one contains the other.
	export function overlapsPath(path AccessPath) returns bool
		var n = fields.count()
		if path.steps.count() < n 'shorter'
			n = path.steps.count()
		end 'shorter'
		for i in 0 upto n 'each'
			if not path.steps[i].sameField(fields[i]) 'apart'
				return false
			end 'apart'
		end 'each'
		return true
	end 'overlapsPath'
end 'OwnMove'

export typealias OwnMoves = Array with OwnMove

// moveText is how a message names the field a move took out of the local root.
function moveText(o Ownership, p ast.Project, ms ast.ModuleState, m OwnMove, root ast.LocalID) returns String
	var b = ByteArray.create(0)
	b.append(o.c.typing.locals[root as Count].name.toByteArray())
	for i in 0 upto m.fields.count() 'each'
		b.append(".{fieldName(p, ms: ms, step: m.fields[i])}".toByteArray())
	end 'each'
	return String.from(b)
end 'moveText'

function coveredBy(moves OwnMoves, m OwnMove) returns bool
	for i in 0 upto moves.count() 'each'
		if moves[i].covers(m.fields) 'covered'
			return true
		end 'covered'
	end 'each'
	return false
end 'coveredBy'

// fieldsOf is the fields a place selects, which must all be fields: a move never goes through an element or frozen
// contents.
function fieldsOf(path AccessPath) returns PathSteps
	for i in 0 upto path.steps.count() 'each'
		if path.steps[i].kind != StepKind.stepField 'notField'
			panic("ownership: a move through an element or frozen contents reached the field moves")
		end 'notField'
	end 'each'
	return path.steps.clone()
end 'fieldsOf'

// mergeFacts is what two paths say about one local: gone as a whole on either path, it is gone; partly moved on both,
// it lacks what either path lacks.
function mergeFacts(a OwnFact, b OwnFact) returns OwnFact
	if not a.isPartial() 'aWhole'
		return a.clone()
	end 'aWhole'
	if not b.isPartial() 'bWhole'
		return b.clone()
	end 'bWhole'
	var extra = OwnMoves.create(0)
	for i in 0 upto b.moves.count() 'each'
		if not coveredBy(a.moves, m: b.moves[i]) 'new'
			extra.push(b.moves[i].clone())
		end 'new'
	end 'each'
	if extra.count() == 0 'same'
		return a.clone()
	end 'same'
	var moves = OwnMoves.create(0)
	for i in 0 upto a.moves.count() 'kept'
		if not coveredBy(extra, m: a.moves[i]) 'keep'
			moves.push(a.moves[i].clone())
		end 'keep'
	end 'kept'
	moves.append(extra)
	return OwnFact.partly(a.local, site: a.site, moves: moves)
end 'mergeFacts'

// requireMayTakeApart is E3922: a move of a part, or a 'match consumes', takes t apart, which a type with destructors
// only allows inside its own destructors, so that no value of it ends without one.
function requireMayTakeApart(mutates o Ownership, p ast.Project, ms ast.ModuleState, site diag.U32, t ast.TypeID, what String) returns bool
	if not hasDestructorOn(p, ms: ms, t: t) 'plain'
		return true
	end 'plain'
	let receiver = selfLocalOf(o, p: p, ms: ms)
	if ms.funcs.slots[ast.funcSlot(o.fn)][ast.funcIndex(o.fn)].isDestructor and o.c.typing.locals[receiver as Count].ty == t 'own'
		return true
	end 'own'
	fail(o, p: p, site: site, code: diag.errTakeApartDestructible, msg: "{what} takes '{ast.typeName(ms.types, t: t)}' apart, which ends it without calling a destructor, and only its own destructors may do that; end it by calling one of them, or read the part without moving it")
	return false
end 'requireMayTakeApart'

// requireMayTakeApartFrom checks each record along a field path that a move takes a part from.
function requireMayTakeApartFrom(mutates o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID, what String) returns bool
	let k = p.modules[o.c.modIdx].tree.kindOf(e)
	let site = offsetOfOwn(o, p: p, node: e)
	if k == ast.NodeKind.memberExpr 'member'
		let obj = ast.memberExprObj(p.modules[o.c.modIdx].tree, id: e)
		return requireMayTakeApartFrom(o, p: p, ms: ms, e: obj, what: what) and requireMayTakeApart(o, p: p, ms: ms, site: site, t: ownType(o, node: obj), what: what)
	end 'member'
	if k == ast.NodeKind.nameExpr and ownName(o, node: e).kind == ast.NameKind.nameSelfField 'selfField'
		let receiver = selfLocalOf(o, p: p, ms: ms)
		let t = o.c.typing.locals[receiver as Count].ty
		return requireMayTakeApart(o, p: p, ms: ms, site: site, t: t, what: what)
	end 'selfField'
	return true
end 'requireMayTakeApartFrom'

// movePart moves a field out of the local that e's path starts at: the local is then partly moved, which a fact says by
// listing the fields that are gone.
function movePart(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, path AccessPath, consumes dest OwnDest, consumes s OwnState) returns OwnState
	let site = offsetOfOwn(o, p: p, node: e)
	requireNotProjected(o, p: p, ms: ms, path: path, site: site)
	if not requireMayTakeApartFrom(o, p: p, ms: ms, e: e, what: "moving '{pathText(o, p: p, ms: ms, path: path)}'") 'refused'
		return s
	end 'refused'
	let m = OwnMove.make(fieldsOf(path), ty: ownType(o, node: e), site: site, dest: dest)
	var moves = OwnMoves.create(0)
	if s.hasPartial(path.root) 'earlier'
		let fact = s.factOf(path.root)
		for i in 0 upto fact.moves.count() 'each'
			if not m.covers(fact.moves[i].fields) 'kept'
				moves.push(fact.moves[i].clone())
			end 'kept'
		end 'each'
	end 'earlier'
	moves.insert(0, value: m)
	o.partials = try o.partials + 1 otherwise panic("ownership: too many moves")
	return withFact(s, fact: OwnFact.partly(path.root, site: site, moves: moves))
end 'movePart'

// readPart is a read of a field path of a local, which needs no part of that place to be gone. It is false when the
// local has lost none of its fields, and the caller then reads the local as a whole.
function readPart(mutates o Ownership, p ast.Project, ms ast.ModuleState, e ast.NodeID, s OwnState) returns bool
	let path = pathOf(o, p: p, ms: ms, e: e)
	if not path.isPlace() or path.crossesElement() 'notPart'
		return false
	end 'notPart'
	if not s.hasPartial(path.root) 'whole'
		return false
	end 'whole'
	let fact = s.factOf(path.root)
	for i in 0 upto fact.moves.count() 'each'
		if fact.moves[i].overlapsPath(path) 'gone'
			let moved = moveText(o, p: p, ms: ms, m: fact.moves[i], root: path.root)
			fail(o, p: p, site: offsetOfOwn(o, p: p, node: e), code: diag.errUseAfterMove, msg: "'{pathText(o, p: p, ms: ms, path: path)}' overlaps '{moved}', which was moved into {fact.moves[i].dest.text()} at line {lineOf(o, p: p, site: fact.moves[i].site)}; assign '{moved}' again before using it")
			break 'each'
		end 'gone'
	end 'each'
	return true
end 'readPart'

// assignPart is an assignment to a field path of a local that has lost some of its fields. Assigning a gone field gives
// it a value again, and the local is whole once it has them all. The old value of a field that is partly gone is
// dropped in its remaining parts. It is none when the local has lost nothing that the assignment touches.
function assignPart(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, st ast.NodeID, target ast.NodeID, path AccessPath, s OwnState) returns table.Option with OwnState
	if o.partials == 0 or s.dead or path.crossesElement() 'notPart'
		return table.Option.none
	end 'notPart'
	if not s.hasPartial(path.root) 'whole'
		return table.Option.none
	end 'whole'
	let fact = s.factOf(path.root)
	let site = offsetOfOwn(o, p: p, node: st)
	var kept = OwnMoves.create(0)
	var under = OwnMoves.create(0)
	var reinitialised = false
	for i in 0 upto fact.moves.count() 'each'
		let depth = fact.moves[i].fields.count()
		if not fact.moves[i].overlapsPath(path) 'apart'
			kept.push(fact.moves[i].clone())
		end 'apart' else if depth == path.steps.count() 'same'
			reinitialised = true
		end 'same' else if depth > path.steps.count() 'inside'
			under.push(fact.moves[i].clone())
		end 'inside' else 'around'
			let moved = moveText(o, p: p, ms: ms, m: fact.moves[i], root: path.root)
			fail(o, p: p, site: site, code: diag.errUseAfterMove, msg: "'{pathText(o, p: p, ms: ms, path: path)}' lies inside '{moved}', which was moved into {fact.moves[i].dest.text()} at line {lineOf(o, p: p, site: fact.moves[i].site)}; assign '{moved}' again first")
			return table.Option.some(s.clone())
		end 'around'
	end 'each'
	if not reinitialised 'kept'
		if under.count() > 0 'under'
			requireRemainder(o, p: p, ms: ms, site: site, ty: ownType(o, node: target), depth: path.steps.count(), moves: under, name: pathText(o, p: p, ms: ms, path: path), kind: OwnDropKind.dropOverwrite, destroys: false)
		end 'under' else 'untouched'
			requireOverwriteDroppable(o, p: p, ms: ms, st: st, target: target, s: s)
			return table.Option.some(s.clone())
		end 'untouched'
	end 'kept'
	if kept.count() == 0 'whole'
		return table.Option.some(without(s.clone(), l: path.root))
	end 'whole'
	return table.Option.some(withFact(s.clone(), fact: OwnFact.partly(path.root, site: fact.site, moves: kept)))
end 'assignPart'

// requireRemainder is the drop of what a value of type ty keeps when the moves have taken their fields out of it: each
// field that is left must be droppable, and a field that is partly gone is judged by what is left of it. moves are the
// moves inside the value, each reaching the field at depth. A value that nothing was taken from is dropped as a whole,
// except the self of a destructor, which ends by dropping its fields, so those are judged one by one.
function requireRemainder(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, ty ast.TypeID, depth Count, moves OwnMoves, name String, kind OwnDropKind, destroys bool)
	if moves.count() == 0 and not destroys 'whole'
		requireDroppable(o, p: p, ms: ms, site: site, t: ty, d: OwnDrop.make(kind, name: name.clone()))
		return
	end 'whole'
	let orig = ast.originOf(ms.types, t: ty)
	let k = ast.typeKind(ms.types, t: ty)
	if k == ast.TypeKind.record 'record'
		for fi in 0 upto ms.types.lists[ast.typeList(ms.types, t: orig)][ast.typeIndex(ms.types, t: orig)].fields.count() 'fields'
			var gone = false
			var inside = OwnMoves.create(0)
			for i in 0 upto moves.count() 'moves'
				if moves[i].fields[depth].field != fi 'other'
					continue 'moves'
				end 'other'
				if moves[i].fields.count() == try depth + 1 otherwise depth 'exact'
					gone = true
				end 'exact' else 'deeper'
					inside.push(moves[i].clone())
				end 'deeper'
			end 'moves'
			if not gone 'left'
				let fName = ms.types.lists[ast.typeList(ms.types, t: orig)][ast.typeIndex(ms.types, t: orig)].fields[fi].name.clone()
				let fTy = ast.fieldType(ms.types, owner: ty, index: fi)
				requireRemainder(o, p: p, ms: ms, site: site, ty: fTy, depth: try depth + 1 otherwise depth, moves: inside, name: "{name}.{fName}", kind: kind, destroys: false)
			end 'left'
		end 'fields'
		return
	end 'record'
	if k == ast.TypeKind.unionTy 'union'
		for ci in 0 upto ms.types.lists[ast.typeList(ms.types, t: orig)][ast.typeIndex(ms.types, t: orig)].cases.count() 'cases'
			for pi in 0 upto ms.types.lists[ast.typeList(ms.types, t: orig)][ast.typeIndex(ms.types, t: orig)].cases[ci].payload.count() 'payload'
				let pName = ms.types.lists[ast.typeList(ms.types, t: orig)][ast.typeIndex(ms.types, t: orig)].cases[ci].payload[pi].name.clone()
				let pTy = ast.payloadType(ms.types, owner: ty, caseIndex: ci, index: pi)
				requireDroppable(o, p: p, ms: ms, site: site, t: pTy, d: OwnDrop.make(kind, name: "{name}.{pName}"))
			end 'payload'
		end 'cases'
		return
	end 'union'
	panic("ownership: '{ast.typeName(ms.types, t: ty)}' has no fields to move out of")
end 'requireRemainder'

// requireHeld is the drop of an obliged local at the place where it is dropped, whatever its fact says it lost.
function requireHeld(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, site diag.U32, ob OwnObliged, s OwnState, kind OwnDropKind)
	let name = o.c.typing.locals[ob.local as Count].name.clone()
	let ty = o.c.typing.locals[ob.local as Count].ty
	if s.hasPartial(ob.local) 'partly'
		let fact = s.factOf(ob.local)
		requireRemainder(o, p: p, ms: ms, site: site, ty: ty, depth: 0 as Count, moves: fact.moves, name: name, kind: kind, destroys: ob.destroys)
		return
	end 'partly'
	if not s.has(ob.local) 'held'
		requireRemainder(o, p: p, ms: ms, site: site, ty: ty, depth: 0 as Count, moves: OwnMoves.create(0), name: name, kind: kind, destroys: ob.destroys)
	end 'held'
end 'requireHeld'

// lostOnOnePath is E3919 for what the path with the fact lost and the other path still holds: the merged state says it
// is gone, so nothing would drop it where the other path holds it, unless what it holds can be dropped.
function lostOnOnePath(mutates o Ownership, p ast.Project, mutates ms ast.ModuleState, ob OwnObliged, lost OwnState, other OwnState)
	if not lost.has(ob.local) 'kept'
		return
	end 'kept'
	let fact = lost.factOf(ob.local)
	let hasOther = other.has(ob.local)
	let name = o.c.typing.locals[ob.local as Count].name.clone()
	let ty = o.c.typing.locals[ob.local as Count].ty
	if fact.isPartial() 'partly'
		for i in 0 upto fact.moves.count() 'each'
			var inside = OwnMoves.create(0)
			if hasOther 'other'
				let otherFact = other.factOf(ob.local)
				if not otherFact.isPartial() or coveredBy(otherFact.moves, m: fact.moves[i]) 'alsoGone'
					continue 'each'
				end 'alsoGone'
				for j in 0 upto otherFact.moves.count() 'within'
					if fact.moves[i].covers(otherFact.moves[j].fields) 'in'
						inside.push(otherFact.moves[j].clone())
					end 'in'
				end 'within'
			end 'other'
			let m = fact.moves[i].clone()
			requireRemainder(o, p: p, ms: ms, site: m.site, ty: m.ty, depth: m.fields.count(), moves: inside, name: moveText(o, p: p, ms: ms, m: m, root: ob.local), kind: OwnDropKind.dropOtherPath, destroys: false)
		end 'each'
		return
	end 'partly'
	if hasOther 'other'
		if other.hasPartial(ob.local) 'partly'
			let otherFact = other.factOf(ob.local)
			requireRemainder(o, p: p, ms: ms, site: fact.site, ty: ty, depth: 0 as Count, moves: otherFact.moves, name: name, kind: OwnDropKind.dropOtherPath, destroys: ob.destroys)
		end 'partly'
		return
	end 'other'
	if ob.destroys 'destroys'
		requireRemainder(o, p: p, ms: ms, site: fact.site, ty: ty, depth: 0 as Count, moves: OwnMoves.create(0), name: name, kind: OwnDropKind.dropOtherPath, destroys: true)
		return
	end 'destroys'
	disagreeWhole(o, p: p, ms: ms, ob: ob, fact: fact)
end 'lostOnOnePath'
