// The fixes of the diagnostics whose message names one change: each is built from the nodes the message is built from, and
// only when the diagnostic is raised, so a program that checks clean never pays for them.

// The kinds of fix, by which a tool counts what it changed.
export let fixKindTry = "try"

export let fixKindCast = "as"

export let fixKindClone = "clone"

export let fixKindConsumes = "consumes"

export let fixKindMutates = "mutates"

export let fixKindMutatesSelf = "mutates self"

export let fixKindBorrowed = "borrowed"

export let fixKindVar = "var"

export let fixKindEnding = "ending"

export let fixKindBound = "bound"

let fixKindBind = "bind"

export let fixKindInterpolation = "interpolation"

export let fixKindMatchConsumes = "match consumes"

export let fixKindUntry = "no try"

let fixKindDiscard = "no discard"

let fixKindEnds = "ends"

let fixKindService = "service"

// typeKeyword and serviceKeyword are the words that open the declaration of a type and of a service.
let typeKeyword = "type"

let serviceKeyword = "service"

let fixKindUnrequire = "no requires"

let fixKindThaw = "thaw"

let fixKindFreeze = "freeze"

// fixPanicText is what the panic of a try that a fix writes says: the failure it stands for, which the program never
// expected.
let fixPanicText = "out of range"

let letKeyword = "let"

let varKeyword = "var"

let openParenByte = 40 as Byte

let closeParenByte = 41 as Byte

let newlineByte = 10 as Byte

let carriageReturnByte = 13 as Byte

let tabByte = 9 as Byte

let apostropheBeforeName = 1 as Count

let spaceByte = 32 as Byte

let dotByte = 46 as Byte

let upperA = 65 as Byte

let upperZ = 90 as Byte

let lowerA = 97 as Byte

let lowerZ = 122 as Byte

let digit0 = 48 as Byte

let digit9 = 57 as Byte

let underscoreByte = 95 as Byte

let openBraceByte = 123 as Byte

let closeBraceByte = 125 as Byte

let returnsKeyword = "returns"

let otherwiseKeyword = "otherwise"

let borrowedKeyword = "borrowed"

function fixOf(consumes kind String, consumes edits diag.FixEdits) returns diag.Fix
	return diag.Fix.make(kind, edits: edits)
end 'fixOf'

function at32(offset Count) returns diag.U32
	return try offset as diag.U32 otherwise panic("fixes: an offset past a module")
end 'at32'

// wrapFix writes before and after around the expression, with parentheses around the whole of it when it is an operand.
function wrapFix(t ast.Tree, consumes kind String, e ast.NodeID, before String, after String) returns diag.Fix
	let found = ast.exprExtent(t, e: e)
	if not found.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	let extent = found.unwrap()
	var open = before.clone()
	var close = after.clone()
	if ast.isOperand(t, extent: extent) 'grouped'
		open = "({before}"
		close = "{after})"
	end 'grouped'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.insert(t.module, at: extent.begin, text: open))
	edits.push(diag.FixEdit.insert(t.module, at: extent.until, text: close))
	return fixOf(kind, edits: edits)
end 'wrapFix'

function panicClause() returns String
	return " otherwise panic(\"{fixPanicText}\")"
end 'panicClause'

// isCompound is whether the expression e needs parentheses where a cast is written after it.
function isCompound(t ast.Tree, e ast.NodeID) returns bool
	let k = t.kindOf(e)
	return k == ast.NodeKind.binaryExpr or k == ast.NodeKind.unaryExpr or k == ast.NodeKind.condExpr or k == ast.NodeKind.rangeExpr or k == ast.NodeKind.tryExpr or k == ast.NodeKind.castExpr or k == ast.NodeKind.asyncExpr or k == ast.NodeKind.awaitExpr or k == ast.NodeKind.spawnExpr
end 'isCompound'

// tryFix covers the failure of e with a try around the whole arithmetic expression it is part of, which panics: what
// "handle the failure with 'try'" asks for, where the program had no handling of its own.
export function tryFix(t ast.Tree, e ast.NodeID) returns diag.Fix
	return wrapFix(t, kind: fixKindTry, e: ast.outermostArithmetic(t, e: e), before: "try ", after: panicClause())
end 'tryFix'

// untryFix removes a try that covers nothing that can fail, with the handler that never runs, leaving the code the try
// covers. A conditional try has no fix: its block and its else are written as a call and the code that follows it.
export function untryFix(t ast.Tree, site ast.NodeID) returns diag.Fix
	let kind = t.kindOf(site)
	if kind == ast.NodeKind.tryExpr 'expression'
		return untryExprFix(t, site: site)
	end 'expression'
	if kind == ast.NodeKind.tryStmt 'block'
		return untryBlockFix(t, site: site)
	end 'block'
	if kind == ast.NodeKind.ifTryStmt 'conditional'
		return diag.Fix.none()
	end 'conditional'
	panic("fixes: a try fix for a node that is no try")
end 'untryFix'

// unrequireFix removes the invariant of the while loop s with its 'requires', which is the change a loop invariant that the
// analysis cannot prove, or does not follow, names: what needed it is then refused where it is not known.
function unrequireFix(t ast.Tree, s ast.NodeID) returns diag.Fix
	let cond = ast.exprExtent(t, e: ast.whileStmtCond(t, id: s))
	let invariant = ast.exprExtent(t, e: ast.whileStmtInvariant(t, id: s))
	if not cond.isSome() or not invariant.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.make(t.module, begin: cond.unwrap().until, until: invariant.unwrap().until, text: ""))
	return fixOf(fixKindUnrequire, edits: edits)
end 'unrequireFix'

// untryExprFix removes the 'try' of a try expression and its handler, whichever of the forms of handler it has, and leaves
// the parentheses around what it covered.
function untryExprFix(t ast.Tree, site ast.NodeID) returns diag.Fix
	let start = ast.exprStart(t, e: site)
	let afterTry = ast.skipSpace(t.text, at: ast.wordEnd(t.text, at: start))
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.make(t.module, begin: at32(start), until: at32(afterTry), text: ""))
	if ast.propagates(t, e: site) 'passes'
		return fixOf(fixKindUntry, edits: edits)
	end 'passes'
	let covered = wrappedEnd(t, begin: afterTry, e: ast.tryExprE(t, id: site))
	if not covered.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	let coveredEnd = covered.unwrap()
	let finish = tryEnd(t, e: site, covered: coveredEnd)
	if not finish.isSome() 'unterminated'
		return diag.Fix.none()
	end 'unterminated'
	edits.push(diag.FixEdit.make(t.module, begin: at32(coveredEnd), until: at32(finish.unwrap()), text: ""))
	return fixOf(fixKindUntry, edits: edits)
end 'untryExprFix'

// wrappedEnd is past the expression e and the parentheses that stand around all of it, as many closing ones as there are
// opening ones between begin and the start of its extent. It is nothing where the end of e is not known or the parentheses
// do not close.
function wrappedEnd(t ast.Tree, begin Count, e ast.NodeID) returns table.Option with Count
	let found = ast.exprExtent(t, e: e)
	if not found.isSome() 'unknown'
		return table.Option.none
	end 'unknown'
	let extent = found.unwrap()
	var opened = 0 as Count
	for i in begin upto extent.begin as Count 'between'
		if t.text.byteAt(i) == openParenByte 'open'
			opened = try opened + 1 otherwise panic("fixes: more parentheses than a module holds")
		end 'open'
	end 'between'
	var at = extent.until as Count
	while opened > 0 'close'
		let next = ast.skipSpace(t.text, at: at)
		if next >= t.text.byteLength() or t.text.byteAt(next) != closeParenByte 'unclosed'
			return table.Option.none
		end 'unclosed'
		at = next + 1
		opened = opened - 1
	end 'close'
	return table.Option.some(at)
end 'wrappedEnd'

// untryBlockFix removes the 'try' line of a try block, the line of the 'end' that closes its body and its handler, and one
// tab of each line of the body, which it keeps. The handler never runs, so what it holds is dropped with it. A block whose
// 'try' or 'end' shares its line with other code has no fix.
function untryBlockFix(t ast.Tree, site ast.NodeID) returns diag.Fix
	var last = ast.tryStmtEnd(t, id: site)
	let bodyEnd = last
	if ast.tryStmtHasOtherwise(t, id: site) 'handled'
		last = ast.tryStmtHandlerEnd(t, id: site)
	end 'handled'
	if bodyEnd == 0 or last == 0 'unlabelled'
		return diag.Fix.none()
	end 'unlabelled'
	let opened = ast.labelEnd(t.text, at: t.labelStart(ast.tryStmtLabelRef(t, id: site)) as Count)
	let headerBegin = ast.lineBegin(t.text, at: t.startOf(site) as Count)
	let tailBegin = ast.lineBegin(t.text, at: t.endKeywordStart(bodyEnd) as Count)
	if not ast.isIndent(t.text, begin: headerBegin, until: t.startOf(site) as Count) or not ast.isIndent(t.text, begin: tailBegin, until: t.endKeywordStart(bodyEnd) as Count) 'shared'
		return diag.Fix.none()
	end 'shared'
	var edits = diag.FixEdits.create(0)
	var line = ast.lineAfter(t.text, at: opened)
	edits.push(diag.FixEdit.make(t.module, begin: at32(headerBegin), until: at32(line), text: ""))
	while line < tailBegin 'body'
		if t.text.byteAt(line) == tabByte 'indented'
			edits.push(diag.FixEdit.make(t.module, begin: at32(line), until: at32(line + 1), text: ""))
		end 'indented'
		line = ast.lineAfter(t.text, at: line)
	end 'body'
	edits.push(diag.FixEdit.make(t.module, begin: at32(tailBegin), until: at32(ast.lineAfter(t.text, at: endLabelPast(t, label: last))), text: ""))
	return fixOf(fixKindUntry, edits: edits)
end 'untryBlockFix'

// endLabelPast is past the label that closes a block, whose label node is label: the node starts at the name, after the
// apostrophe that opens the label.
function endLabelPast(t ast.Tree, label ast.NodeID) returns Count
	return ast.labelEnd(t.text, at: try (t.startOf(label) as Count) - apostropheBeforeName otherwise panic("fixes: an end label starts before its apostrophe"))
end 'endLabelPast'

// tryEnd is where a try expression ends, whose covered expression ends at covered: after its fallback, the value of its
// return or throw, the statement or the block its handler is, or the word ignore.
function tryEnd(t ast.Tree, e ast.NodeID, covered Count) returns table.Option with Count
	let ret = ast.tryExprRet(t, id: e)
	if ret != 0 and ast.returnStmtValue(t, id: ret) != 0 'returns'
		return wrappedEnd(t, begin: ast.wordEnd(t.text, at: t.startOf(ret) as Count), e: ast.returnStmtValue(t, id: ret))
	end 'returns'
	let thr = ast.tryExprThr(t, id: e)
	if thr != 0 'throws'
		return wrappedEnd(t, begin: ast.wordEnd(t.text, at: t.startOf(thr) as Count), e: ast.throwStmtValue(t, id: thr))
	end 'throws'
	var jump = ast.tryExprBrk(t, id: e)
	if jump == 0 'notBreak'
		jump = ast.tryExprCont(t, id: e)
	end 'notBreak'
	if jump == 0 'notContinue'
		jump = ret
	end 'notContinue'
	if jump != 0 'jumps'
		return table.Option.some(ast.jumpEnd(t.text, at: t.startOf(jump) as Count))
	end 'jumps'
	if ast.tryExprIgnore(t, id: e) 'ignores'
		return table.Option.some(ast.wordEnd(t.text, at: ast.skipSpace(t.text, at: ast.wordEnd(t.text, at: ast.skipSpace(t.text, at: covered)))))
	end 'ignores'
	let handler = ast.tryExprHandler(t, id: e)
	if handler != 0 and ast.handlerBlockEnd(t, id: handler) != 0 'block'
		return table.Option.some(endLabelPast(t, label: ast.handlerBlockEnd(t, id: handler)))
	end 'block'
	if handler != 0 'unlabelled'
		return table.Option.none
	end 'unlabelled'
	let fallback = ast.tryFallback(t, e: e)
	if fallback == 0 'passes'
		panic("fixes: a try with no handler that does not pass its failure on")
	end 'passes'
	return wrappedEnd(t, begin: ast.wordEnd(t.text, at: ast.skipSpace(t.text, at: covered)), e: fallback)
end 'tryEnd'

// passingTryFix covers the failure of e with a try that passes it to the caller, around the whole arithmetic expression it is
// part of, where the function throws the failure's error itself.
export function passingTryFix(t ast.Tree, e ast.NodeID) returns diag.Fix
	return wrapFix(t, kind: fixKindTry, e: ast.outermostArithmetic(t, e: e), before: "try ", after: "")
end 'passingTryFix'

// returnFix writes the conversion that a return makes to the integer type named target as a cast that a try covers.
export function returnFix(t ast.Tree, e ast.NodeID, target String) returns diag.Fix
	if isCompound(t, e: e) 'operator'
		return wrapFix(t, kind: fixKindTry, e: e, before: "try (", after: ") as {target}{panicClause()}")
	end 'operator'
	return wrapFix(t, kind: fixKindTry, e: e, before: "try ", after: " as {target}{panicClause()}")
end 'returnFix'

// castFix converts the value of e to the integer type named target, as a cast to it is written.
export function castFix(t ast.Tree, e ast.NodeID, target String) returns diag.Fix
	if isCompound(t, e: e) 'operator'
		return wrapFix(t, kind: fixKindCast, e: e, before: "(", after: ") as {target}")
	end 'operator'
	return wrapFix(t, kind: fixKindCast, e: e, before: "", after: " as {target}")
end 'castFix'

// cloneFix copies the value of the place e instead of moving it.
export function cloneFix(t ast.Tree, e ast.NodeID) returns diag.Fix
	if t.kindOf(e) == ast.NodeKind.tryExpr and ast.tryFallback(t, e: e) != 0 'fallback'
		// A '.clone()' after the fallback would copy only the fallback.
		return wrapFix(t, kind: fixKindClone, e: e, before: "(", after: ").clone()")
	end 'fallback'
	let found = ast.exprEnd(t, e: e)
	if not found.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.insert(t.module, at: at32(found.unwrap()), text: ".clone()"))
	return fixOf(fixKindClone, edits: edits)
end 'cloneFix'

// thawFix passes an owned copy of the contents of the frozen value e instead of the frozen value.
function thawFix(t ast.Tree, e ast.NodeID) returns diag.Fix
	return wrapFix(t, kind: fixKindThaw, e: e, before: "thaw(", after: ")")
end 'thawFix'

// freezeFix gives up the value of e to a frozen value of it, where a frozen value of its type is wanted.
function freezeFix(t ast.Tree, e ast.NodeID) returns diag.Fix
	return wrapFix(t, kind: fixKindFreeze, e: e, before: "freeze(", after: ")")
end 'freezeFix'

// conventionFix writes a convention before a parameter that has none.
export function conventionFix(t ast.Tree, param ast.NodeID, consumes keyword String) returns diag.Fix
	if param == 0 or t.kindOf(param) != ast.NodeKind.param 'notParam'
		return diag.Fix.none()
	end 'notParam'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.insert(t.module, at: t.startOf(param), text: "{keyword} "))
	return fixOf(keyword, edits: edits)
end 'conventionFix'

// matchConsumesFix makes a match consume its subject, so that each arm owns the payloads it binds, and first takes the
// parameter param with consumes, when there is one, for the match to have it to give.
export function matchConsumesFix(t ast.Tree, subject ast.NodeID, param ast.NodeID) returns diag.Fix
	let found = ast.exprExtent(t, e: subject)
	if not found.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	var edits = diag.FixEdits.create(0)
	if param != 0 'param'
		if t.kindOf(param) != ast.NodeKind.param 'notParam'
			return diag.Fix.none()
		end 'notParam'
		edits.push(diag.FixEdit.insert(t.module, at: t.startOf(param), text: "{fixKindConsumes} "))
	end 'param'
	edits.push(diag.FixEdit.insert(t.module, at: found.unwrap().begin, text: "{fixKindConsumes} "))
	return fixOf(fixKindMatchConsumes, edits: edits)
end 'matchConsumesFix'

// letToVar replaces the let keyword at start with var, or gives no fix where it is not written there.
function letToVar(t ast.Tree, start Count) returns diag.Fix
	let finish = try start + letKeyword.byteLength() otherwise panic("fixes: an offset past a module")
	if finish > t.text.byteLength() or t.text.sliceBytes(start, endPos: finish) != letKeyword 'notWritten'
		return diag.Fix.none()
	end 'notWritten'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.make(t.module, begin: at32(start), until: at32(finish), text: varKeyword))
	return fixOf(fixKindVar, edits: edits)
end 'letToVar'

// varFix declares the local of a let statement with var.
export function varFix(t ast.Tree, stmt ast.NodeID) returns diag.Fix
	if stmt == 0 or t.kindOf(stmt) != ast.NodeKind.letStmt 'notLet'
		return diag.Fix.none()
	end 'notLet'
	return letToVar(t, start: t.startOf(stmt) as Count)
end 'varFix'

// HoistWord is what a word before a temporary on its statement's line, or after it, says of binding the temporary to a var
// on the line before.
enum HoistWord
	// neutral is any word that leaves the temporary computed whenever the line runs.
	neutral
	// conditional is a word that computes it on some runs of the line only (the right of 'and' or 'or', a branch of a
	// conditional, a try's fallback): binding it first computes it on every run, which only a factory may (isFactoryOfPlaces).
	conditional
	// misplaced is a word that makes the line no statement of its own, or one run again for each turn of a loop: the line
	// before is no place to bind it.
	misplaced
end 'HoistWord'

function hoistWord(word String, first bool, before bool) returns HoistWord
	if word == "while" or word == "until" or word == "end" or word == "gives" or word == "then" or word == "function" 'misplaced'
		return HoistWord.misplaced
	end 'misplaced'
	if word == "if" and not (first and before) or before and (word == "and" or word == "or" or word == "else" or word == "otherwise") 'conditional'
		return HoistWord.conditional
	end 'conditional'
	return HoistWord.neutral
end 'hoistWord'

// bindFix binds the temporary e, which a mutates parameter or a mutates self method changes, to a new var on the line before
// its statement, named base or base followed by a number, the skip-th such name no local of the function has, so that the
// change has a variable to land in, as the message asks: `X509Reader.over(b).sequenceElements()` becomes
// `var x509Reader = X509Reader.over(b)` and `x509Reader.sequenceElements()`. A statement is one line; a temporary that the
// line computes only on some of its runs is bound only where it is a factory's value (factory).
export function bindFix(t ast.Tree, e ast.NodeID, base String, locals ast.LocalEntryList, ids ast.LocalIDList, factory bool, skip Count) returns diag.Fix
	let found = ast.exprExtent(t, e: e)
	if not found.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	let extent = found.unwrap()
	let begin = extent.begin as Count
	var start = ast.lineBegin(t.text, at: begin)
	while start < begin and t.text.byteAt(start) == tabByte 'indent'
		start = start + 1
	end 'indent'
	let indent = t.text.sliceBytes(ast.lineBegin(t.text, at: begin), endPos: start)
	let before = hoistWords(t, from: start, until: begin, before: true)
	let after = hoistWords(t, from: extent.until as Count, until: ast.lineAfter(t.text, at: begin), before: false)
	if before == HoistWord.misplaced or after == HoistWord.misplaced or not factory and (before == HoistWord.conditional or after == HoistWord.conditional) 'unbound'
		return diag.Fix.none()
	end 'unbound'
	let name = unusedName(locals, ids: ids, base: base, skip: skip)
	let value = t.text.sliceBytes(begin, endPos: extent.until as Count)
	var edits = diag.FixEdits.create(0)
	if begin == start 'statement'
		edits.push(diag.FixEdit.make(t.module, begin: extent.begin, until: extent.until, text: "{varKeyword} {name} = {value}\n{indent}{name}"))
	end 'statement' else 'operand'
		edits.push(diag.FixEdit.insert(t.module, at: at32(start), text: "{varKeyword} {name} = {value}\n{indent}"))
		edits.push(diag.FixEdit.make(t.module, begin: extent.begin, until: extent.until, text: name))
	end 'operand'
	return fixOf(fixKindBind, edits: edits)
end 'bindFix'

// hoistWords is the strongest of what the words of the text from from until until say (hoistWord), before the temporary
// or after it.
function hoistWords(t ast.Tree, from Count, until Count, before bool) returns HoistWord
	var held = HoistWord.neutral
	var at = from
	while at < until 'words'
		let past = ast.wordEnd(t.text, at: at)
		if past == at 'punctuation'
			at = at + 1
			continue 'words'
		end 'punctuation'
		let word = hoistWord(t.text.sliceBytes(at, endPos: past), first: at == from, before: before)
		if word == HoistWord.misplaced 'misplaced'
			return word
		end 'misplaced'
		if word == HoistWord.conditional 'conditional'
			held = word
		end 'conditional'
		at = past
	end 'words'
	return held
end 'hoistWords'

// bindingName is the name of a var that holds a value of the type named typeName: the name without its module and its
// type arguments, its first letter lower case (`x509.X509Reader` is `x509Reader`), or `value` where that leaves no name.
export function bindingName(typeName String) returns String
	var first = 0 as Count
	var until = typeName.byteLength()
	for i in 0 upto typeName.byteLength() 'bytes'
		let b = typeName.byteAt(i)
		if b == dotByte 'qualified'
			first = i + 1
		end 'qualified' else if not isNameByte(b) 'arguments'
			until = i
			break 'bytes'
		end 'arguments'
	end 'bytes'
	if first >= until or typeName.byteAt(first) < upperA or typeName.byteAt(first) > upperZ 'unnamed'
		return "value"
	end 'unnamed'
	return "{typeName.sliceBytes(first, endPos: first + 1).toLower()}{typeName.sliceBytes(first + 1, endPos: until)}"
end 'bindingName'

function isNameByte(b Byte) returns bool
	return b >= upperA and b <= upperZ or b >= lowerA and b <= lowerZ or b >= digit0 and b <= digit9 or b == underscoreByte
end 'isNameByte'

// unusedName is base, or base and a number from 2, the skip-th of them (from 0) that no local of locals that ids names is named.
function unusedName(locals ast.LocalEntryList, ids ast.LocalIDList, base String, skip Count) returns String
	var left = skip
	var n = 1 as Count
	while true 'candidates'
		let name = base.clone() if n == 1 else "{base}{n}"
		if not isLocalName(locals, ids: ids, name: name) 'unused'
			if left == 0 'chosen'
				return name
			end 'chosen'
			left = left - 1
		end 'unused'
		n = try n + 1 otherwise panic("fixes: more names than a module holds")
	end 'candidates'
	panic("fixes: no unused name")
end 'unusedName'

function isLocalName(locals ast.LocalEntryList, ids ast.LocalIDList, name String) returns bool
	for i in 0 upto ids.count() 'each'
		if locals[ids[i] as Count].name == name 'named'
			return true
		end 'named'
	end 'each'
	return false
end 'isLocalName'

// letFieldFix declares the field that an assignment changes with var, in the module that declares its type: another
// module's source is not the one being checked, so a field of its types has no fix.
export function letFieldFix(p ast.Project, ms ast.ModuleState, owner ast.TypeID, field String) returns diag.Fix
	let entry = ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: owner))
	if not entry.hasDecl or entry.decl.module != ms.module 'elsewhere'
		return diag.Fix.none()
	end 'elsewhere'
	let t = ms.tree()
	match p.modules[ast.modIndex(ms.module)].decls[entry.decl.ordinal as Count] 'declared'
		typeDecl(td) then return letFieldDeclFix(t, fields: td.fields, field: field)
		funcDecl(_) then return diag.Fix.none()
		constDecl(_) then return diag.Fix.none()
		enumDecl(_) then return diag.Fix.none()
		unionDecl(_) then return diag.Fix.none()
		aliasDecl(_) then return diag.Fix.none()
		interfaceDecl(_) then return diag.Fix.none()
		extensionDecl(_) then return diag.Fix.none()
	end 'declared'
end 'letFieldFix'

// letFieldDeclFix is the fix of the field named field among a type's field declarations: its let, which a visibility
// word may come before.
function letFieldDeclFix(t ast.Tree, fields ast.FieldDeclList, field String) returns diag.Fix
	for i in 0 upto fields.count() 'each'
		if fields[i].name != field 'other'
			continue 'each'
		end 'other'
		var at = t.startOf(fields[i].id) as Count
		let afterVisibility = ast.skipSpace(t.text, at: ast.wordEnd(t.text, at: at))
		if t.text.sliceBytes(at, endPos: ast.wordEnd(t.text, at: at)) != letKeyword 'modified'
			at = afterVisibility
		end 'modified'
		return letToVar(t, start: at)
	end 'each'
	return diag.Fix.none()
end 'letFieldDeclFix'

// mutatesSelfFix declares the receiver of the method mutable, first among its parameters. A method whose receiver is
// already written with another convention has none: the message names no change for it.
export function mutatesSelfFix(t ast.Tree, method ast.NodeID) returns diag.Fix
	if method == 0 or t.kindOf(method) != ast.NodeKind.funcDecl 'notMethod'
		return diag.Fix.none()
	end 'notMethod'
	let open = ast.openingAfter(t.text, at: t.startOf(method) as Count)
	if open >= t.text.byteLength() 'noParameters'
		return diag.Fix.none()
	end 'noParameters'
	let inside = open + 1
	let first = ast.skipSpace(t.text, at: inside)
	var text = "mutates self, "
	if first < t.text.byteLength() and t.text.byteAt(first) == closeParenByte 'empty'
		text = "mutates self"
	end 'empty' else 'parameters'
		let word = ast.wordEnd(t.text, at: first)
		let second = ast.skipSpace(t.text, at: word)
		if t.text.sliceBytes(second, endPos: ast.wordEnd(t.text, at: second)) == "self" 'written'
			return diag.Fix.none()
		end 'written'
	end 'parameters'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.insert(t.module, at: at32(inside), text: text))
	return fixOf(fixKindMutatesSelf, edits: edits)
end 'mutatesSelfFix'

// borrowedResultFix declares that the method lends its result, which a requirement it meets lends: 'borrowed' after the
// 'returns' of its header, the first on the line it starts.
export function borrowedResultFix(t ast.Tree, method ast.NodeID) returns diag.Fix
	if method == 0 or t.kindOf(method) != ast.NodeKind.funcDecl 'notMethod'
		return diag.Fix.none()
	end 'notMethod'
	let written = "{returnsKeyword} "
	var at = t.startOf(method) as Count
	while at < t.text.byteLength() and t.text.byteAt(at) != newlineByte 'scan'
		let past = try at + written.byteLength() otherwise panic("fixes: an offset past a module")
		if past <= t.text.byteLength() and t.text.sliceBytes(at, endPos: past) == written 'returns'
			var edits = diag.FixEdits.create(0)
			edits.push(diag.FixEdit.insert(t.module, at: at32(past), text: "{borrowedKeyword} "))
			return fixOf(fixKindBorrowed, edits: edits)
		end 'returns'
		at = at + 1
	end 'scan'
	return diag.Fix.none()
end 'borrowedResultFix'

// stringAppendFix is the repair for the call `place.append(value)` of a String that stands alone as a statement on an
// assignable place: converted maxon code is repaired by fix, and a String is built here by the interpolation assigned
// back to it, `place = "{place}{value}"`, where a literal value's text goes in as it is written. It is no fix for a call
// in any other position, on a place that is no name, or whose text it cannot find.
export function stringAppendFix(t ast.Tree, call ast.NodeID) returns diag.Fix
	let callee = ast.callExprCallee(t, id: call)
	let argsRef = ast.callExprArgsRef(t, id: call)
	if t.kindOf(callee) != ast.NodeKind.memberExpr or t.listLen(argsRef) != 1 'shape'
		return diag.Fix.none()
	end 'shape'
	let arg = ast.argValue(t, id: t.listAt(argsRef, index: 0 as Count) as ast.NodeID)
	let value = ast.exprExtent(t, e: arg)
	let whole = ast.exprExtent(t, e: call)
	if not value.isSome() or not whole.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	let valueExtent = value.unwrap()
	let extent = whole.unwrap()
	if not aloneOnItsLine(t, begin: extent.begin as Count, until: extent.until as Count) 'notStatement'
		return diag.Fix.none()
	end 'notStatement'
	// The place is the text before the member's dot, which is where a member node starts: the extent of a bare name runs on
	// through the dotted words after it, as a qualified name's does.
	let placeText = table.blankTrimmed(t.text.sliceBytes(ast.exprStart(t, e: ast.memberExprObj(t, id: callee)), endPos: t.startOf(callee) as Count), fromStart: false, fromEnd: true)
	if not isDottedName(placeText) 'notPlace'
		return diag.Fix.none()
	end 'notPlace'
	var part = "\{{t.text.sliceBytes(valueExtent.begin as Count, endPos: valueExtent.until as Count)}\}"
	if t.kindOf(arg) == ast.NodeKind.strLit 'literal'
		part = t.text.sliceBytes(nextOf(valueExtent.begin as Count), endPos: try (valueExtent.until as Count) - 1 otherwise panic("fixes: a string literal with no quotes")).clone()
	end 'literal'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.make(t.module, begin: extent.begin, until: extent.until, text: "{placeText} = \"\{{placeText}\}{part}\""))
	return fixOf(fixKindInterpolation, edits: edits)
end 'stringAppendFix'

// toStringFix is the repair for the call `x.toString()` of a built-in type, which has no such method: the interpolation
// "{x}" is the one way to make the text of a value. A call that is itself the whole of an interpolated part with no format,
// "{x.toString()}", becomes the part "{x}".
export function toStringFix(t ast.Tree, call ast.NodeID) returns diag.Fix
	let callee = ast.callExprCallee(t, id: call)
	if t.kindOf(callee) != ast.NodeKind.memberExpr or t.listLen(ast.callExprArgsRef(t, id: call)) != 0 'shape'
		return diag.Fix.none()
	end 'shape'
	let whole = ast.exprExtent(t, e: call)
	if not whole.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	let extent = whole.unwrap()
	// The receiver is the call's text before the dot of `.toString()`: a bare name's extent runs on through the dotted words
	// after it, so the receiver's own extent does not end it.
	let callText = t.text.sliceBytes(extent.begin as Count, endPos: extent.until as Count)
	let tail = "{toStringMethod}()"
	if not callText.endsWith(tail) 'spelled'
		return diag.Fix.none()
	end 'spelled'
	var text = table.blankTrimmed(callText.sliceBytes(0, endPos: try callText.byteLength() - tail.byteLength() otherwise panic("fixes: a short call")), fromStart: false, fromEnd: true)
	if not text.endsWith(".") 'noDot'
		return diag.Fix.none()
	end 'noDot'
	text = table.blankTrimmed(text.sliceBytes(0, endPos: try text.byteLength() - 1 otherwise panic("fixes: an empty receiver")), fromStart: false, fromEnd: true)
	var written = "\"\{{text}\}\""
	if extent.begin > 0 and t.text.byteAt((extent.begin as Count) - 1) == openBraceByte and (extent.until as Count) < t.text.byteLength() and t.text.byteAt(extent.until as Count) == closeBraceByte 'part'
		written = text.clone()
	end 'part'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.make(t.module, begin: extent.begin, until: extent.until, text: written))
	return fixOf(fixKindInterpolation, edits: edits)
end 'toStringFix'

// endingFix ends a value that the exit at the offset at would drop, with call, the call that ends it, written before the exit:
// on a line of its own where the exit starts its line, and, where the exit is the handler of a try on the line
// (`otherwise return 1`), by making the handler a block named label that ends the value and then leaves. An exit inside
// parentheses, which a block cannot be, has no fix.
export function endingFix(t ast.Tree, at diag.U32, call String, label String) returns diag.Fix
	let start = at as Count
	var lineStart = start
	while lineStart > 0 'back'
		let prev = lineStart - 1
		if t.text.byteAt(prev) == newlineByte 'line'
			break 'back'
		end 'line'
		lineStart = prev
	end 'back'
	var indentEnd = lineStart
	while indentEnd < start and isBlank(t.text.byteAt(indentEnd)) 'indent'
		indentEnd = nextOf(indentEnd)
	end 'indent'
	let indent = t.text.sliceBytes(lineStart, endPos: indentEnd).clone()
	var edits = diag.FixEdits.create(0)
	if indentEnd == start 'ownLine'
		edits.push(diag.FixEdit.insert(t.module, at: at, text: "{call}\n{indent}"))
		return fixOf(fixKindEnding, edits: edits)
	end 'ownLine'
	let before = table.blankTrimmed(t.text.sliceBytes(indentEnd, endPos: start), fromStart: false, fromEnd: true)
	if not before.endsWith(otherwiseKeyword) 'inside'
		return diag.Fix.none()
	end 'inside'
	var lineEnd = start
	var opens = 0 as Count
	var closes = 0 as Count
	while lineEnd < t.text.byteLength() and t.text.byteAt(lineEnd) != newlineByte and t.text.byteAt(lineEnd) != carriageReturnByte 'rest'
		if t.text.byteAt(lineEnd) == openParenByte 'open'
			opens = nextOf(opens)
		end 'open' else if t.text.byteAt(lineEnd) == closeParenByte 'close'
			closes = nextOf(closes)
		end 'close'
		lineEnd = nextOf(lineEnd)
	end 'rest'
	if closes > opens 'parenthesized'
		return diag.Fix.none()
	end 'parenthesized'
	edits.push(diag.FixEdit.insert(t.module, at: at, text: "'{label}'\n{indent}\t{call}\n{indent}\t"))
	edits.push(diag.FixEdit.insert(t.module, at: at32(lineEnd), text: "\n{indent}end '{label}'"))
	return fixOf(fixKindEnding, edits: edits)
end 'endingFix'

function nextOf(at Count) returns Count
	return try at + 1 otherwise panic("fixes: an offset past a module")
end 'nextOf'

// discardFix removes the discard s of a value that already exists, which does nothing: the line it stands alone on or, as the
// action of a match arm, the statement, which becomes the 'break' that leaves the match. A discard that is the one
// statement of its block, which may not be empty, or that shares its line otherwise, has none.
function discardFix(t ast.Tree, s ast.NodeID, inArm bool, sole bool) returns diag.Fix
	let found = ast.exprExtent(t, e: ast.discardStmtValue(t, id: s))
	if not found.isSome() 'unknown'
		return diag.Fix.none()
	end 'unknown'
	let begin = t.startOf(s) as Count
	let until = found.unwrap().until as Count
	var edits = diag.FixEdits.create(0)
	if inArm 'arm'
		edits.push(diag.FixEdit.make(t.module, begin: at32(begin), until: at32(until), text: "break"))
		return fixOf(fixKindDiscard, edits: edits)
	end 'arm'
	if sole or not aloneOnItsLine(t, begin: begin, until: until) 'kept'
		return diag.Fix.none()
	end 'kept'
	edits.push(diag.FixEdit.make(t.module, begin: at32(ast.lineBegin(t.text, at: begin)), until: at32(ast.lineAfter(t.text, at: until)), text: ""))
	return fixOf(fixKindDiscard, edits: edits)
end 'discardFix'

// aloneOnItsLine is whether only blanks stand on the line of the text from begin until until, before and after it.
function aloneOnItsLine(t ast.Tree, begin Count, until Count) returns bool
	var at = begin
	while at > 0 'before'
		let prev = at - 1
		let b = t.text.byteAt(prev)
		if b == newlineByte 'line'
			break 'before'
		end 'line'
		if not isBlank(b) 'blank'
			return false
		end 'blank'
		at = prev
	end 'before'
	at = until
	while at < t.text.byteLength() and t.text.byteAt(at) != newlineByte 'after'
		if not isBlank(t.text.byteAt(at)) 'blank'
			return false
		end 'blank'
		at = nextOf(at)
	end 'after'
	return true
end 'aloneOnItsLine'

function isBlank(b Byte) returns bool
	return b == tabByte or b == spaceByte or b == carriageReturnByte
end 'isBlank'

// isDottedName is whether text is names joined by dots: a local, a field of one, or a static field of a type.
function isDottedName(text String) returns bool
	if text.byteLength() == 0 'empty'
		return false
	end 'empty'
	for i in 0 upto text.byteLength() 'each'
		let b = text.byteAt(i)
		let word = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 46
		if not word 'other'
			return false
		end 'other'
	end 'each'
	return true
end 'isDottedName'

// endsDeclFix declares the type td Ends, after the interfaces it implements or its name and type parameters, and writes its
// finish last in its body, with a line of its body for each call: what E3956 asks of a service's state that cannot be
// dropped. A type with no end label has none.
function endsDeclFix(t ast.Tree, td ast.TypeDecl, calls ast.StringList) returns diag.Fix
	if td.endRef == 0 'unlabelled'
		return diag.Fix.none()
	end 'unlabelled'
	let start = t.startOf(td.id) as Count
	var lineEnd = start
	while lineEnd < t.text.byteLength() and t.text.byteAt(lineEnd) != newlineByte and t.text.byteAt(lineEnd) != carriageReturnByte 'header'
		lineEnd = nextOf(lineEnd)
	end 'header'
	var at = lineEnd
	if td.whereList.count() > 0 'where'
		let clause = " where "
		var scan = start
		var past = clause.byteLength()
		past = try past + scan otherwise panic("fixes: an offset past a module")
		while past <= lineEnd 'scan'
			if t.text.sliceBytes(scan, endPos: past) == clause 'found'
				at = scan
				break 'scan'
			end 'found'
			scan = nextOf(scan)
			past = nextOf(past)
		end 'scan'
	end 'where'
	let named = ", Ends" if td.conforms != 0 else " implements Ends"
	var endLine = t.startOf(td.endRef) as Count
	while endLine > 0 and t.text.byteAt(endLine - 1) != newlineByte 'back'
		endLine = endLine - 1
	end 'back'
	var indentEnd = endLine
	while isBlank(t.text.byteAt(indentEnd)) 'indent'
		indentEnd = nextOf(indentEnd)
	end 'indent'
	let indent = "{t.text.sliceBytes(endLine, endPos: indentEnd)}\t"
	var body = ""
	for call in calls 'calls'
		body = "{body}{indent}\t{call}\n"
	end 'calls'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.insert(t.module, at: at32(at), text: named))
	edits.push(diag.FixEdit.insert(t.module, at: at32(endLine), text: "\n{indent}function finish(consumes self)\n{body}{indent}end 'finish'\n"))
	return fixOf(fixKindEnds, edits: edits)
end 'endsDeclFix'

// serviceHeaderFix writes `service` for the `type` that opens the declaration of the type that ref names, where a file of
// the program declares it: a type of the library or of the runtime is no file that a fix may edit.
function serviceHeaderFix(p ast.Project, ref ast.DeclRef) returns diag.Fix
	if ref.module == diag.stdlibID or ast.isLibraryModule(p, modID: ref.module) or ast.isRuntimeModule(p, modID: ref.module) 'notProgram'
		return diag.Fix.none()
	end 'notProgram'
	for declaring in p.modules 'modules'
		if declaring.id == ref.module 'declares'
			return serviceHeaderEdit(declaring.tree, nameAt: declaring.tree.reportStartOf(ast.declNodeID(p, ref: ref)) as Count)
		end 'declares'
	end 'modules'
	return diag.Fix.none()
end 'serviceHeaderFix'

// serviceHeaderEdit is the fix that writes `service` for the word `type` before the name at nameAt in the text of t, and is no
// fix where that word does not stand there.
function serviceHeaderEdit(t ast.Tree, nameAt Count) returns diag.Fix
	var wordEnd = nameAt
	while wordEnd > 0 and isBlank(t.text.byteAt(wordEnd - 1)) 'blanks'
		wordEnd = wordEnd - 1
	end 'blanks'
	let wordStart = try wordEnd - typeKeyword.byteLength() otherwise return diag.Fix.none()
	if t.text.sliceBytes(wordStart, endPos: wordEnd) != typeKeyword 'other'
		return diag.Fix.none()
	end 'other'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.make(t.module, begin: at32(wordStart), until: at32(wordEnd), text: serviceKeyword.clone()))
	return fixOf(fixKindService, edits: edits)
end 'serviceHeaderEdit'

// boundFix gives the type parameter named param the bound in the where clause of the function or the type declared at decl,
// a type parameter of its own or, for a function, of the type it is a method of: what "add the bound 'where T implements
// Copyable'" asks for.
export function boundFix(t ast.Tree, decl ast.NodeID, param String, bound String) returns diag.Fix
	if decl == 0 or not (t.kindOf(decl) == ast.NodeKind.funcDecl or t.kindOf(decl) == ast.NodeKind.typeDecl or t.kindOf(decl) == ast.NodeKind.unionDecl) 'noHeader'
		return diag.Fix.none()
	end 'noHeader'
	match consumes ast.boundPlace(t.text, at: t.startOf(decl) as Count, param: param) 'place'
		some(place) then return fixOf(fixKindBound, edits: boundEdits(t, place: place, param: param, bound: bound))
		none then return diag.Fix.none()
	end 'place'
end 'boundFix'

function boundEdits(t ast.Tree, place ast.BoundPlace, param String, bound String) returns diag.FixEdits
	var text = ""
	match place.form 'form'
		newClause then text = " where {param} implements {bound}"
		newConstraint then text = ", {param} implements {bound}"
		moreBounds then text = " and {bound}"
	end 'form'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.insert(t.module, at: at32(place.at), text: text))
	return edits
end 'boundEdits'
