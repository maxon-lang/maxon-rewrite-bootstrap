let constUnvisited = 0 as Byte

let constVisiting = 1 as Byte

let constDone = 2 as Byte

// ConstOrder is where the ordering of a module's constants is: the constants in the order they are typed, and the ones
// being visited.
type ConstOrder
	// state is by the constant's place among the module's declarations.
	export var state as ByteArray
	export var order as OrdinalList
	export var path as OrdinalList

	static function make(declCount Count) returns ConstOrder
		return ConstOrder{state: ByteArray.create(declCount), order: OrdinalList.create(0), path: OrdinalList.create(0)}
	end 'make'
end 'ConstOrder'

// ConstReads is what the expressions of a constant read: the declarations of the module that the constants stage types, so
// that they are typed first, and whether any of them runs code (a call or a panic), which a value known before the program
// runs does not.
type ConstReads
	export var refs as DeclRefList
	export var runs as bool

	static function create() returns ConstReads
		return ConstReads{refs: DeclRefList.create(0), runs: false}
	end 'create'
end 'ConstReads'

// typedByConstants is whether the constants stage types the declaration: a constant, or an enum or a union whose cases write
// raw values that are no literal, each of which is a constant too. The library declares no such enum or union.
function typedByConstants(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns bool
	if ast.declIsConst(p, ref: ref) 'constant'
		return true
	end 'constant'
	if ref.module == diag.stdlibID 'library'
		return false
	end 'library'
	if not isNominalDecl(p.modules[ast.modIndex(ref.module)].decls[ref.ordinal as Count]) 'notNominal'
		return false
	end 'notNominal'
	return ast.typeEntry(ms.types, reads: p.types, t: declTypeOf(p, ms: ms, ref: ref)).rawKind == ast.RawKind.value
end 'typedByConstants'

function pushIfConstant(p ast.Project, ms ast.ModuleState, consumes ref ast.DeclRef, mutates out ConstReads)
	if typedByConstants(p, ms: ms, ref: ref) 'constant'
		out.refs.push(ref)
	end 'constant'
end 'pushIfConstant'

// constRefs notes what an expression of the module reads: the constants it names, so that they are typed first, and whether it
// runs code. It walks every
// expression a constant could hold, including ones the checker then refuses, because a missed reference would type a
// constant before one it reads.
function constRefs(p ast.Project, ms ast.ModuleState, tree ast.Tree, res ast.Resolution, e ast.NodeID, mutates out ConstReads)
	if e == 0 'nil'
		return
	end 'nil'
	let k = tree.kindOf(e)
	if k == ast.NodeKind.nameExpr 'name'
		match consumes res.decls.get(e as Count) 'bound'
			some(ref) then pushIfConstant(p, ms: ms, ref: ref, out: out)
			none then _ = 0
		end 'bound'
		return
	end 'name'
	if k == ast.NodeKind.strLit 'str'
		constRefsOfString(p, ms: ms, tree: tree, res: res, e: e, out: out)
		return
	end 'str'
	if k == ast.NodeKind.matchExpr 'match'
		constRefsOfMatch(p, ms: ms, tree: tree, res: res, core: ast.matchExprMatch(tree, id: e), out: out)
		return
	end 'match'
	if k == ast.NodeKind.callExpr or k == ast.NodeKind.indexExpr or k == ast.NodeKind.structLitExpr or k == ast.NodeKind.collectionLitExpr or k == ast.NodeKind.tupleExpr 'lists'
		constRefsOfLists(p, ms: ms, tree: tree, res: res, e: e, k: k, out: out)
		return
	end 'lists'
	constRefsOfOperands(p, ms: ms, tree: tree, res: res, e: e, k: k, out: out)
end 'constRefs'

function constRefsOfString(p ast.Project, ms ast.ModuleState, tree ast.Tree, res ast.Resolution, e ast.NodeID, mutates out ConstReads)
	let partsRef = ast.strLitPartsRef(tree, id: e)
	for i in 0 upto tree.strPartCount(partsRef) 'parts'
		if tree.strPartIsExpr(partsRef, index: i) 'expr'
			constRefs(p, ms: ms, tree: tree, res: res, e: tree.strPartExpr(partsRef, index: i), out: out)
		end 'expr'
	end 'parts'
end 'constRefsOfString'

// constRefsOfOperands covers the expressions that hold a fixed number of operands, and the ones that hold none.
function constRefsOfOperands(p ast.Project, ms ast.ModuleState, tree ast.Tree, res ast.Resolution, e ast.NodeID, k ast.NodeKind, mutates out ConstReads)
	if k == ast.NodeKind.binaryExpr 'binary'
		constRefsOfChain(p, ms: ms, tree: tree, res: res, e: e, out: out)
	end 'binary' else if k == ast.NodeKind.unaryExpr 'unary'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.unaryExprE(tree, id: e), out: out)
	end 'unary' else if k == ast.NodeKind.asyncExpr 'async'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.asyncExprCall(tree, id: e), out: out)
	end 'async' else if k == ast.NodeKind.spawnExpr 'spawn'
		out.runs = true
		let capacity = ast.spawnExprCapacity(tree, id: e)
		if capacity != 0 'capacity'
			constRefs(p, ms: ms, tree: tree, res: res, e: ast.argValue(tree, id: capacity), out: out)
		end 'capacity'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.spawnExprCall(tree, id: e), out: out)
	end 'spawn' else if k == ast.NodeKind.awaitExpr 'await'
		out.runs = true
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.awaitExprE(tree, id: e), out: out)
	end 'await' else if k == ast.NodeKind.tryExpr 'try'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.tryExprE(tree, id: e), out: out)
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.tryFallback(tree, e: e), out: out)
	end 'try' else if k == ast.NodeKind.condExpr 'cond'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.condExprCond(tree, id: e), out: out)
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.condExprThen(tree, id: e), out: out)
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.condExprElse(tree, id: e), out: out)
	end 'cond' else if k == ast.NodeKind.castExpr 'cast'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.castExprE(tree, id: e), out: out)
	end 'cast' else if k == ast.NodeKind.fromExpr 'from'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.fromExprValue(tree, id: e), out: out)
	end 'from' else if k == ast.NodeKind.rangeExpr 'range'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.rangeExprLow(tree, id: e), out: out)
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.rangeExprHigh(tree, id: e), out: out)
	end 'range' else if k == ast.NodeKind.memberExpr 'member'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.memberExprObj(tree, id: e), out: out)
	end 'member' else if k == ast.NodeKind.panicExpr 'panic'
		out.runs = true
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.panicExprMessage(tree, id: e), out: out)
	end 'panic' else if k == ast.NodeKind.intLit or k == ast.NodeKind.floatLit or k == ast.NodeKind.boolLit or k == ast.NodeKind.selfExpr or k == ast.NodeKind.byteStrLit or k == ast.NodeKind.charLit or k == ast.NodeKind.typeQueryExpr 'leaf'
		_ = 0
	end 'leaf' else if k == ast.NodeKind.closureExpr 'closure'
		// A closure's body runs when it is called, so the constants it names are not part of the value.
		_ = 0
	end 'closure' else 'unknown'
		panic("the node {e} of kind {k.name} is no expression")
	end 'unknown'
end 'constRefsOfOperands'

// constRefsOfChain covers an operator and the operators nested in its left operand, innermost first, so that a long chain
// takes no stack.
function constRefsOfChain(p ast.Project, ms ast.ModuleState, tree ast.Tree, res ast.Resolution, e ast.NodeID, mutates out ConstReads)
	var chain = ast.leftChain(tree, e: e)
	var node = ast.nextOperator(chain, e: e)
	constRefs(p, ms: ms, tree: tree, res: res, e: ast.binaryExprL(tree, id: node), out: out)
	while node != e 'inner'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.binaryExprR(tree, id: node), out: out)
		node = ast.nextOperator(chain, e: e)
	end 'inner'
	constRefs(p, ms: ms, tree: tree, res: res, e: ast.binaryExprR(tree, id: e), out: out)
end 'constRefsOfChain'

// constRefsOfLists covers the expressions that hold a list of operands.
function constRefsOfLists(p ast.Project, ms ast.ModuleState, tree ast.Tree, res ast.Resolution, e ast.NodeID, k ast.NodeKind, mutates out ConstReads)
	if k == ast.NodeKind.callExpr 'call'
		out.runs = out.runs or not isCopyCall(p, tree: tree, call: e)
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.callExprCallee(tree, id: e), out: out)
		let argsRef = ast.callExprArgsRef(tree, id: e)
		for i in 0 upto tree.listLen(argsRef) 'args'
			let arg = tree.listAt(argsRef, index: i) as ast.NodeID
			constRefs(p, ms: ms, tree: tree, res: res, e: ast.argValue(tree, id: arg), out: out)
		end 'args'
	end 'call' else if k == ast.NodeKind.indexExpr 'index'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.indexExprObj(tree, id: e), out: out)
		let argsRef = ast.indexExprArgsRef(tree, id: e)
		for i in 0 upto tree.listLen(argsRef) 'indices'
			constRefs(p, ms: ms, tree: tree, res: res, e: tree.listAt(argsRef, index: i) as ast.NodeID, out: out)
		end 'indices'
	end 'index' else if k == ast.NodeKind.structLitExpr 'literal'
		let fieldsRef = ast.structLitExprFieldsRef(tree, id: e)
		for i in 0 upto tree.listLen(fieldsRef) 'fields'
			let field = tree.listAt(fieldsRef, index: i) as ast.NodeID
			constRefs(p, ms: ms, tree: tree, res: res, e: ast.structFieldValue(tree, id: field), out: out)
		end 'fields'
	end 'literal' else if k == ast.NodeKind.tupleExpr 'tuple'
		let tupleRef = ast.tupleExprElemsRef(tree, id: e)
		for i in 0 upto tree.listLen(tupleRef) 'members'
			constRefs(p, ms: ms, tree: tree, res: res, e: tree.listAt(tupleRef, index: i) as ast.NodeID, out: out)
		end 'members'
	end 'tuple' else if k == ast.NodeKind.collectionLitExpr 'collection'
		let elemsRef = ast.collectionLitExprElemsRef(tree, id: e)
		for i in 0 upto tree.listLen(elemsRef) 'elems'
			constRefs(p, ms: ms, tree: tree, res: res, e: tree.listAt(elemsRef, index: i) as ast.NodeID, out: out)
		end 'elems'
		let valuesRef = ast.collectionLitExprValuesRef(tree, id: e)
		for i in 0 upto tree.listLen(valuesRef) 'values'
			constRefs(p, ms: ms, tree: tree, res: res, e: tree.listAt(valuesRef, index: i) as ast.NodeID, out: out)
		end 'values'
	end 'collection' else 'unknown'
		panic("the node {e} of kind {k.name} holds no list of operands")
	end 'unknown'
end 'constRefsOfLists'

// isCopyCall is whether a call is `x.clone()`, which copies a value and runs no code of the program.
function isCopyCall(p ast.Project, tree ast.Tree, call ast.NodeID) returns bool
	let callee = ast.callExprCallee(tree, id: call)
	if tree.kindOf(callee) != ast.NodeKind.memberExpr 'notMember'
		return false
	end 'notMember'
	return ast.memberExprName(tree, id: callee) == cloneMethod and tree.listLen(ast.callExprArgsRef(tree, id: call)) == 0
end 'isCopyCall'

// constRefsOfMatch covers a match expression: its subject and, in each arm, its patterns' values and the arm's value. A
// 'then' arm, the only one holding a statement, is refused in one.
function constRefsOfMatch(p ast.Project, ms ast.ModuleState, tree ast.Tree, res ast.Resolution, core ast.NodeID, mutates out ConstReads)
	constRefs(p, ms: ms, tree: tree, res: res, e: ast.matchCoreSubject(tree, id: core), out: out)
	let armsRef = ast.matchCoreArmsRef(tree, id: core)
	for i in 0 upto tree.listLen(armsRef) 'arms'
		let arm = tree.listAt(armsRef, index: i) as ast.NodeID
		let patternsRef = ast.matchArmPatternsRef(tree, id: arm)
		for j in 0 upto tree.listLen(patternsRef) 'patterns'
			let pattern = tree.listAt(patternsRef, index: j) as ast.NodeID
			constRefs(p, ms: ms, tree: tree, res: res, e: ast.patternValue(tree, id: pattern), out: out)
			constRefs(p, ms: ms, tree: tree, res: res, e: ast.patternHigh(tree, id: pattern), out: out)
		end 'patterns'
		constRefs(p, ms: ms, tree: tree, res: res, e: ast.matchArmValue(tree, id: arm), out: out)
	end 'arms'
end 'constRefsOfMatch'

// constReadsOf is what the value of a declaration of its module that the constants stage types reads: a constant's value,
// or every raw value that the cases of an enum or a union write.
function constReadsOf(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns ConstReads
	var out = ConstReads.create()
	let modIdx = ast.modIndex(ref.module)
	if ref.module != ms.module 'other'
		panic("the constants stage of module {ms.module} orders a constant of module {ref.module}")
	end 'other'
	if ast.declIsConst(p, ref: ref) 'constant'
		match p.modules[modIdx].decls[ref.ordinal as Count] 'k'
			constDecl(cd) then constRefs(p, ms: ms, tree: ms.tree(), res: ast.resolutionOf(p, ms: ms), e: cd.value, out: out)
			funcDecl(_) then panic("the constant at ordinal {ref.ordinal} is a function")
			typeDecl(_) then panic("the constant at ordinal {ref.ordinal} is a type")
			enumDecl(_) then panic("the constant at ordinal {ref.ordinal} is an enum")
			unionDecl(_) then panic("the constant at ordinal {ref.ordinal} is a union")
			aliasDecl(_) then panic("the constant at ordinal {ref.ordinal} is a typealias")
			interfaceDecl(_) then panic("the constant at ordinal {ref.ordinal} is an interface")
			extensionDecl(_) then panic("the constant at ordinal {ref.ordinal} is an extension")
		end 'k'
		return out
	end 'constant'
	let tid = declTypeOf(p, ms: ms, ref: ref)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: tid).cases.count() 'cases'
		constRefs(p, ms: ms, tree: ms.tree(), res: ast.resolutionOf(p, ms: ms), e: ast.typeEntry(ms.types, reads: p.types, t: tid).cases[i].rawExpr, out: out)
	end 'cases'
	return out
end 'constReadsOf'

// constCycle spells the loop that visiting the constant at ord closes, from the first constant of path that is it.
function constCycle(m ast.Module, path OrdinalList, ord ast.DeclOrdinal) returns String
	let first = positionIn(path, ord: ord)
	var buf = ByteArray.create(0)
	for i in first upto path.count() 'each'
		if i > first 'sep'
			buf.append(", ".toByteArray())
		end 'sep'
		buf.append(m.decls[path[i] as Count].name().toByteArray())
	end 'each'
	return String.from(buf)
end 'constCycle'

// visitConst puts the constant at ord in the order after the constants of the module that its value names, and gives
// whether it could: a constant that names itself through others is refused.
function visitConst(mutates w ConstOrder, c Checker, p ast.Project, ms ast.ModuleState, ord ast.DeclOrdinal, mutates errs diag.ErrorList) returns bool
	let st = w.state[ord as Count]
	if st == constDone 'done'
		return true
	end 'done'
	if st == constVisiting 'cycle'
		let off = p.modules[c.modIdx].decls[ord as Count].offset(ms.tree())
		checkFail(c.modID, off: off, code: diag.errDependsOnItself, msg: diag.circularConstants(constCycle(p.modules[c.modIdx], path: w.path, ord: ord)), errs: errs)
		return false
	end 'cycle'
	w.state[ord as Count] = constVisiting
	w.path.push(ord)
	let reads = constReadsOf(p, ms: ms, ref: ast.DeclRef.make(c.modID, ordinal: ord))
	for i in 0 upto reads.refs.count() 'refs'
		if reads.refs[i].module == c.modID 'own'
			if not visitConst(w, c: c, p: p, ms: ms, ord: reads.refs[i].ordinal, errs: errs) 'failed'
				return false
			end 'failed'
		end 'own'
	end 'refs'
	try w.path.pop() otherwise ignore
	w.state[ord as Count] = constDone
	w.order.push(ord)
	return true
end 'visitConst'

// constantOrder is the module's constants and its enums and unions whose raw values are constants, each after those of the
// module that its value names, so that each is typed after them. The constants of other modules that it names are typed already, since the module graph has no cycle and
// the module's constants wait for those of the modules it depends on. A constant that names itself through others is
// refused, and then no constant of the module is ordered.
export function constantOrder(c Checker, p ast.Project, ms ast.ModuleState, mutates errs diag.ErrorList) returns OrdinalList
	var w = ConstOrder.make(p.modules[c.modIdx].decls.count())
	for i in 0 upto p.modules[c.modIdx].decls.count() 'each'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many declarations")
		if typedByConstants(p, ms: ms, ref: ast.DeclRef.make(c.modID, ordinal: ord)) 'constant'
			if not visitConst(w, c: c, p: p, ms: ms, ord: ord, errs: errs) 'cycle'
				return OrdinalList.create(0)
			end 'cycle'
		end 'constant'
	end 'each'
	return w.order.clone()
end 'constantOrder'

// checkConstantType refuses a constant whose value has no type to give it: a range that no type names, no value, a
// string that interpolates, or a type that cannot be copied. The constant is named name and declared at node, and value is
// what it is written as.
function checkConstantType(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, name String, node ast.NodeID, value ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList) returns bool
	let off = offsetOf(c, p: p, ms: ms, node: node)
	if typeIsAnonInt(ms.types, reads: p.types, t: t) 'anonymous'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "constant '{name}' has the range {nameOfType(p, ms: ms, t: t)}, which no type names: give it an alias, 'as <Alias>'", errs: errs)
		return false
	end 'anonymous'
	if t == p.builtins.voidTy or t == p.builtins.neverTy 'noValue'
		checkFail(c.modID, off: off, code: diag.errNonConstantInitializer, msg: "constant '{name}' must be a value known before the program runs", errs: errs)
		return false
	end 'noValue'
	if t == p.builtins.stringTy and not interpolatesNothing(c, p: p, ms: ms, e: value) 'interpolates'
		checkFail(c.modID, off: off, code: diag.errNonConstantInitializer, msg: "a constant string cannot interpolate", errs: errs)
		return false
	end 'interpolates'
	let lacking = lacksCap(c, p: p, ms: ms, wantCopy: true, t: t)
	if lacking.missing 'noCopy'
		let why = lackWhyText(ms.types, reads: p.types, info: lacking, capName: "Copyable")
		let fix = lackFixText(ms.types, reads: p.types, info: lacking, capName: "Copyable")
		checkFail(c.modID, off: off, code: diag.errNotCopyable, msg: "constant '{name}' has type '{nameOfType(p, ms: ms, t: t)}', which is not Copyable, and a constant is read any number of times: {why}; {fix}", errs: errs)
		return false
	end 'noCopy'
	return true
end 'checkConstantType'

// interpolatesNothing is whether the value is no string with an interpolated part.
function interpolatesNothing(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns bool
	if ms.tree().kindOf(e) != ast.NodeKind.strLit 'notString'
		return true
	end 'notString'
	return ms.tree().strIsPlain(ast.strLitPartsRef(ms.tree(), id: e))
end 'interpolatesNothing'

// constantValue is the constant with the type its value has, and the value where the type holds it: an integer constant
// of a literal's type. The range analysis gives the value of any other, once it runs.
function constantValue(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.ConstValue
	if isConstInt(p, ms: ms, t: t) 'literal'
		return ast.ConstValue.makeInt(t, v: ast.typeEntry(ms.types, reads: p.types, t: t).minVal.clone())
	end 'literal'
	return ast.ConstValue.typed(t)
end 'constantValue'

// constOwner is the type that a static let belongs to, which its value is written inside of, or none for a constant of the
// module: the type whose body declares it, or the type that the extension adding it extends.
function constOwner(c Checker, p ast.Project, mutates ms ast.ModuleState, ord ast.DeclOrdinal, name String) returns ast.TypeID
	if ast.isExtensionAlias(ms.tables, ordinal: ord) 'extension'
		let extended = ast.extendedBy(p, ms: ms, ref: ast.DeclRef.make(c.modID, ordinal: ord))
		if ast.typeKind(ms.types, reads: p.types, t: extended) == ast.TypeKind.interfaceTy 'interface'
			return extended
		end 'interface'
		return ast.selfType(ms.types, reads: p.types, declTy: extended)
	end 'extension'
	match consumes ast.nestedAliasOwner(name) 'owner'
		some(typeName) then return ownerSelfType(c, p: p, ms: ms, typeName: typeName)
		none then return ast.noType
	end 'owner'
end 'constOwner'

function ownerSelfType(c Checker, p ast.Project, mutates ms ast.ModuleState, typeName String) returns ast.TypeID
	match consumes p.modules[c.modIdx].names.get(typeName) 'declared'
		some(ord) then return ast.selfType(ms.types, reads: p.types, declTy: declTypeOf(p, ms: ms, ref: ast.DeclRef.make(c.modID, ordinal: ord)))
		none then panic("the type '{typeName}' of a static let is not among the declarations of its module")
	end 'declared'
end 'ownerSelfType'

// checkConst types a constant's value, which gives the constant its type.
function checkConst(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ord ast.DeclOrdinal, mutates errs diag.ErrorList)
	var cd as ast.ConstDecl
	match p.modules[c.modIdx].decls[ord as Count].clone() 'k'
		constDecl(v) then cd = v.clone()
		funcDecl(_) then panic("the declaration at ordinal {ord} is no constant")
		typeDecl(_) then panic("the declaration at ordinal {ord} is no constant")
		enumDecl(_) then panic("the declaration at ordinal {ord} is no constant")
		unionDecl(_) then panic("the declaration at ordinal {ord} is no constant")
		aliasDecl(_) then panic("the declaration at ordinal {ord} is no constant")
		interfaceDecl(_) then panic("the declaration at ordinal {ord} is no constant")
		extensionDecl(_) then panic("the declaration at ordinal {ord} is no constant")
	end 'k'
	if ast.isRefusedExtensionAlias(ms.tables, ordinal: ord) 'unextended'
		return
	end 'unextended'
	let owner = constOwner(c, p: p, ms: ms, ord: ord, name: cd.name)
	if refusesStaticLet(c, p: p, ms: ms, cd: cd, owner: owner, errs: errs) 'refused'
		return
	end 'refused'
	enterContext(c, p: p, ms: ms, f: ast.noFunc, owner: owner, calls: false)
	c.constName = cd.name.clone()
	startUses(c, node: cd.value, inField: true)
	let t = checkExpr(c, p: p, ms: ms, e: cd.value, errs: errs)
	// The calls the value makes are made where it is read (typeOfConstant).
	finishUses(c)
	if t == ast.noType 'failed'
		return
	end 'failed'
	if checkConstantType(c, p: p, ms: ms, name: cd.name, node: cd.id, value: cd.value, t: t, errs: errs) 'typed'
		refuseHiddenConstantType(c, p: p, ms: ms, cd: cd, t: t, errs: errs)
		var value = constantValue(p, ms: ms, t: t)
		let s = rangeConstant(c, p: p, ms: ms, value: cd.value, errs: errs)
		if ast.isIntType(ms.types, reads: p.types, t: t) 'int'
			value.low = s.lo.clone()
			value.high = s.hi.clone()
		end 'int'
		ast.setDeclConst(ms, ref: ast.DeclRef.make(c.modID, ordinal: ord), value: value)
	end 'typed'
end 'checkConst'

// refusesStaticLet refuses a static let of the type owner that has to be one for each type, and tells whether it did, as Swift
// refuses a static stored property of a generic type or in an extension of a protocol: a generic type's would be one for each
// of its instances, and an interface's one for each type that implements it.
function refusesStaticLet(mutates c Checker, p ast.Project, ms ast.ModuleState, cd ast.ConstDecl, owner ast.TypeID, mutates errs diag.ErrorList) returns bool
	if owner == ast.noType 'module'
		return false
	end 'module'
	let off = ms.tree().reportStartOf(cd.id)
	let ownerName = ast.typeName(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: owner))
	if ast.typeKind(ms.types, reads: p.types, t: owner) == ast.TypeKind.interfaceTy 'interface'
		checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: interfaceStaticRefusal("let", name: ownerName), errs: errs)
		return true
	end 'interface'
	if ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: owner)).typeParams.count() > 0 'generic'
		checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: "Unsupported: a `static let` of the generic type '{ownerName}' — there would have to be one for each instance of '{ownerName}'; make it a static function, or move it to a type that is not generic", errs: errs)
		return true
	end 'generic'
	return false
end 'refusesStaticLet'

// refuseHiddenConstantType refuses an exported or public constant whose type, written or inferred from its value, names a
// declaration less visible than the constant: a reader of the constant would hold a value of a type it cannot name.
function refuseHiddenConstantType(mutates c Checker, p ast.Project, ms ast.ModuleState, cd ast.ConstDecl, t ast.TypeID, mutates errs diag.ErrorList)
	let tier = ast.visibilityOf(cd.visibility)
	if tier == ast.Visibility.unexported 'unexported'
		return
	end 'unexported'
	match hiddenDeclIn(p, ms: ms, t: t, tier: tier) 'hidden'
		some(ref) then checkFail(c.modID, off: ms.tree().reportStartOf(cd.id), code: diag.errExposesHiddenType, msg: diag.exposesLessVisibleType(ast.visibilityWord(tier), noun: "constant", name: ast.inModule(p, modID: c.modID, name: cd.name), typeTier: ast.visibilityWord(ast.declLevel(p, ref: ref)), typeNoun: declNoun(p, ref: ref), typeName: ast.declName(p, ref: ref), position: "in its type"), errs: errs)
		none then _ = 0
	end 'hidden'
end 'refuseHiddenConstantType'

// hiddenDeclIn is the first declaration less visible than tier that the type t names, itself or through its type arguments,
// or none.
function hiddenDeclIn(p ast.Project, ms ast.ModuleState, t ast.TypeID, tier ast.Visibility) returns table.Option with ast.DeclRef
	if t == ast.noType 'none'
		return table.Option.none
	end 'none'
	let e = ast.typeEntry(ms.types, reads: p.types, t: t)
	if e.hasDecl and e.decl.module != diag.stdlibID and ast.declLevel(p, ref: e.decl).ordinal < tier.ordinal 'hidden'
		return table.Option.some(e.decl.clone())
	end 'hidden'
	let args = ast.cloneTypeArgs(e.typeArgs)
	for i in 0 upto args.count() 'args'
		let inner = hiddenDeclIn(p, ms: ms, t: args[i], tier: tier)
		if inner.isSome() 'found'
			return inner
		end 'found'
	end 'args'
	return table.Option.none
end 'hiddenDeclIn'

// declNoun names the kind of the type declaration ref in a message.
function declNoun(p ast.Project, ref ast.DeclRef) returns String
	return match ast.moduleDecl(p, ref: ref) 'k'
		typeDecl(_) gives "type"
		enumDecl(_) gives "enum"
		unionDecl(_) gives "union"
		aliasDecl(_) gives "typealias"
		interfaceDecl(_) gives "interface"
		extensionDecl(_) gives "extension"
		funcDecl(_) gives "function"
		constDecl(_) gives "constant"
	end 'k'
end 'declNoun'

// checkConstants types the module's constants and the raw values of its enums and unions in the order constantOrder gave.
export function checkConstants(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, order OrdinalList, mutates errs diag.ErrorList)
	for i in 0 upto order.count() 'each'
		let ref = ast.DeclRef.make(c.modID, ordinal: order[i])
		match p.modules[c.modIdx].decls[order[i] as Count].clone() 'k'
			constDecl(_) then checkConst(c, p: p, ms: ms, ord: order[i], errs: errs)
			enumDecl(ed) then checkTypeRawValues(c, p: p, ms: ms, tid: declTypeOf(p, ms: ms, ref: ref), cases: enumRawCases(ed), errs: errs)
			unionDecl(ud) then checkTypeRawValues(c, p: p, ms: ms, tid: declTypeOf(p, ms: ms, ref: ref), cases: unionRawCases(ud), errs: errs)
			funcDecl(_) then panic("the constants stage orders the function at ordinal {order[i]}")
			typeDecl(_) then panic("the constants stage orders the type at ordinal {order[i]}")
			aliasDecl(_) then panic("the constants stage orders the typealias at ordinal {order[i]}")
			interfaceDecl(_) then panic("the constants stage orders the interface at ordinal {order[i]}")
			extensionDecl(_) then panic("the constants stage orders the extension at ordinal {order[i]}")
		end 'k'
	end 'each'
end 'checkConstants'

// isLiteralFactoryCall is whether the callee of a call in the value of a constant is a literal factory of a record
// (`Meta.create(4, isMemory: true)`): the call is known before the program runs, as the literal it returns is, so a constant
// may make it where it makes no other.
function isLiteralFactoryCall(c Checker, p ast.Project, ms ast.ModuleState, callee ast.NodeID) returns bool
	if ms.tree().kindOf(callee) == ast.NodeKind.nameExpr 'bare'
		let sibling = staticSibling(c, p: p, ms: ms, callee: callee)
		return sibling != ast.noFunc and isLiteralFactory(p, ms: ms, fn: sibling)
	end 'bare'
	if ms.tree().kindOf(callee) != ast.NodeKind.memberExpr 'notMember'
		return false
	end 'notMember'
	let obj = ast.memberExprObj(ms.tree(), id: callee)
	if ms.tree().kindOf(obj) != ast.NodeKind.nameExpr 'notType'
		return false
	end 'notType'
	var probe = diag.ErrorList.create(0)
	let t = typeNamed(c, p: p, ms: ms, name: obj, errs: probe)
	if probe.count() > 0 or t == ast.noType or not typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.record) 'notRecord'
		return false
	end 'notRecord'
	let fn = methodOf(c, p: p, ms: ms, t: t, name: ast.memberExprName(ms.tree(), id: callee), node: callee, errs: probe)
	return probe.count() == 0 and fn != ast.noFunc and isLiteralFactory(p, ms: ms, fn: fn)
end 'isLiteralFactoryCall'

// isLiteralFactory is whether a function is a literal factory: a static function that the program declares, of a type that
// is not generic, that is not generic and throws nothing, and whose body is one `return` of a record literal whose fields run
// no code, so they are its parameters and constants. A call of it is the literal with the arguments written in.
function isLiteralFactory(p ast.Project, ms ast.ModuleState, fn ast.FuncID) returns bool
	let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).ownerTy
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).module == diag.stdlibID or not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).isStatic or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).generics.count() > 0 or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).errTy != ast.noType or owner == ast.noType 'notStatic'
		return false
	end 'notStatic'
	if ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: owner)).typeParams.count() > 0 'genericOwner'
		return false
	end 'genericOwner'
	let module = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).module
	let body = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).bodyRef
	if module == ms.module 'own'
		return returnsLiteral(p, ms: ms, tree: ms.tree(), res: ast.resolutionOf(p, ms: ms), body: body)
	end 'own'
	let mi = ast.modIndex(module)
	p.modules[mi].tables.requireHeld()
	return returnsLiteral(p, ms: ms, tree: p.modules[mi].tree, res: p.resolutions[mi], body: body)
end 'isLiteralFactory'

// returnsLiteral is whether the body, in tree, is one `return` of a record literal whose fields run no code.
function returnsLiteral(p ast.Project, ms ast.ModuleState, tree ast.Tree, res ast.Resolution, body diag.U32) returns bool
	if tree.listLen(body) != 1 'statements'
		return false
	end 'statements'
	let s = tree.listAt(body, index: 0) as ast.NodeID
	if tree.kindOf(s) != ast.NodeKind.returnStmt 'notReturn'
		return false
	end 'notReturn'
	let value = ast.returnStmtValue(tree, id: s)
	if value == 0 or tree.kindOf(value) != ast.NodeKind.structLitExpr 'notLiteral'
		return false
	end 'notLiteral'
	var reads = ConstReads.create()
	constRefs(p, ms: ms, tree: tree, res: res, e: value, out: reads)
	return not reads.runs
end 'returnsLiteral'
