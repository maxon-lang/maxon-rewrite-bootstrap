// The array and map literals. A literal is the collection that the explicit code would build: an empty one, then a push or
// an upsert of each element in order, so each element is checked as the argument of that call is, and moved in the same
// way. The element type is the one the context expects, else the one the elements give.

// Column is the type of one column of a literal: its elements, or its keys, or its values. A stated one is the type the
// context expects, and each element must fit it; an open one is taken from the elements, which are joined as the
// branches of a conditional are.
type Column
	var fixed as bool
	var ty as ast.TypeID
	var label as String

	static function fixedTo(ty ast.TypeID, consumes label String) returns Column
		return Column{fixed: true, ty: ty, label: label}
	end 'fixedTo'

	static function open(consumes label String) returns Column
		return Column{fixed: false, ty: ast.noType, label: label}
	end 'open'
end 'Column'

// expectedArgs are the type arguments of the type that the context expects when it is an instance of the built-in
// collection of kind, and none otherwise.
function expectedArgs(p ast.Project, ms ast.ModuleState, want ast.TypeID, kind ast.TypeKind) returns ast.TypeIDList
	if want == ast.noType or ast.typeKind(ms.types, reads: p.types, t: want) != kind 'other'
		return ast.TypeIDList.create(0)
	end 'other'
	return ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: want).typeArgs)
end 'expectedArgs'

function checkCollectionLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let elemsRef = ast.collectionLitExprElemsRef(ms.tree(), id: e)
	let valuesRef = ast.collectionLitExprValuesRef(ms.tree(), id: e)
	if ms.tree().listLen(elemsRef) == 0 'empty'
		failAt(c, p: p, ms: ms, node: e, code: diag.errUnsupportedFeature, msg: diag.emptyArrayLiteral(), errs: errs)
		return ast.noType
	end 'empty'
	let isMap = ms.tree().listLen(valuesRef) > 0
	let wide = c.literalWide
	let want = c.expect
	c.literalWide = true
	var result = ast.noType
	if isMap 'map'
		result = checkMapLit(c, p: p, ms: ms, e: e, want: want, wide: wide, errs: errs)
	end 'map' else 'array'
		result = checkArrayLit(c, p: p, ms: ms, e: e, want: want, wide: wide, errs: errs)
	end 'array'
	c.literalWide = wide
	return result
end 'checkCollectionLit'

function checkArrayLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, want ast.TypeID, wide bool, mutates errs diag.ErrorList) returns ast.TypeID
	let elemsRef = ast.collectionLitExprElemsRef(ms.tree(), id: e)
	let given = expectedArgs(p, ms: ms, want: want, kind: ast.TypeKind.builtinArray)
	var elems = Column.open("'value'")
	if given.count() == 1 and given[0] != ast.noType 'stated'
		elems = Column.fixedTo(given[0], label: "'value'")
	end 'stated'
	for i in 0 upto ms.tree().listLen(elemsRef) 'each'
		if not addToColumn(c, p: p, ms: ms, col: elems, node: ms.tree().listAt(elemsRef, index: i) as ast.NodeID, errs: errs) 'bad'
			return ast.noType
		end 'bad'
	end 'each'
	var args = ast.TypeIDList.create(0)
	args.push(columnType(p, ms: ms, col: elems, wide: wide))
	let origin = p.builtins.arrayOrigin
	return instantiateGeneric(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: e), orig: origin, args: args, errs: errs)
end 'checkArrayLit'

// isLibraryMap is whether t is an instance of the standard library's Map, the type of a map literal.
function isLibraryMap(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let origin = ast.originOf(ms.types, reads: p.types, t: t)
	return match consumes ast.libraryModuleNamed(p, name: ast.libraryMapModule) 'library'
		some(holder) gives ast.typeEntry(ms.types, reads: p.types, t: origin).decl.module == holder and ast.typeEntry(ms.types, reads: p.types, t: origin).name == ast.libraryMapName
		none gives false
	end 'library'
end 'isLibraryMap'

// mapInitName is the static function of the library's Map that a map literal calls, maxon's: it reads the keys and the
// values from two buffers, in the order they are written, into a new map.
let mapInitName = "init"

// checkMapLit types a map literal, which makes the standard library's Map, the type that resolve bound the literal to:
// a call of its static init, as maxon's literal is, with the keys and the values, each converted to its column.
function checkMapLit(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, want ast.TypeID, wide bool, mutates errs diag.ErrorList) returns ast.TypeID
	let keysRef = ast.collectionLitExprElemsRef(ms.tree(), id: e)
	let valuesRef = ast.collectionLitExprValuesRef(ms.tree(), id: e)
	var origin = ast.noType
	match consumes p.resolutions[ast.modIndex(c.modID)].decls.get(e as Count) 'map'
		some(ref) then origin = declTypeOf(p, ms: ms, ref: ref)
		none then return ast.noType
	end 'map'
	var given = ast.TypeIDList.create(0)
	if want != ast.noType and ast.originOf(ms.types, reads: p.types, t: want) == origin 'expected'
		given = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: want).typeArgs)
	end 'expected'
	var keys = Column.open("'key'")
	var values = Column.open("'value'")
	if given.count() == 2 and given[0] != ast.noType and given[1] != ast.noType 'stated'
		keys = Column.fixedTo(given[0], label: "'key'")
		values = Column.fixedTo(given[1], label: "'value'")
	end 'stated'
	for i in 0 upto ms.tree().listLen(keysRef) 'each'
		if not addToColumn(c, p: p, ms: ms, col: keys, node: ms.tree().listAt(keysRef, index: i) as ast.NodeID, errs: errs) 'badKey'
			return ast.noType
		end 'badKey'
		if not addToColumn(c, p: p, ms: ms, col: values, node: ms.tree().listAt(valuesRef, index: i) as ast.NodeID, errs: errs) 'badValue'
			return ast.noType
		end 'badValue'
	end 'each'
	var args = ast.TypeIDList.create(0)
	args.push(columnType(p, ms: ms, col: keys, wide: wide))
	args.push(columnType(p, ms: ms, col: values, wide: wide))
	let off = offsetOf(c, p: p, ms: ms, node: e)
	let t = instantiateGeneric(c, p: p, ms: ms, off: off, orig: origin, args: args, errs: errs)
	if t == ast.noType 'refused'
		return ast.noType
	end 'refused'
	let init = methodNamed(p, ms: ms, t: t, name: mapInitName)
	if init == ast.noFunc or not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: init).isStatic 'noInit'
		failAt(c, p: p, ms: ms, node: e, code: diag.errExpressionError, msg: "a map literal makes the standard library's '{ast.libraryMapName}' through its static '{mapInitName}', which it does not declare", errs: errs)
		return ast.noType
	end 'noInit'
	let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: init).generics)
	var info = ast.CallInfo.make(ast.CallKind.callStatic, fn: init, receiverTy: ast.noType)
	info.typeArgs = args.clone()
	info.paramSpecs = applySpecs(p, ms: ms, specs: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: init).params.clone(), params: generics, args: args)
	info.result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: init).result
	c.typing.calls.insert(e as Count, value: info)
	queueMethodBounds(c, p: p, ms: ms, off: off, method: init, args: args)
	recordUse(c, call: e)
	return t
end 'checkMapLit'

// rangeBounds is the number of bounds a range value gives its type's create, the first and the last or the end.
let rangeBounds = 2 as Count

// checkRangeExpr types a range value, `a to b` or `a upto b`, which makes the standard library's Range or OpenRange, the
// type that resolve bound it to: a call of the type's static create with the two bounds, as maxon's range value is, each
// converted to its parameter, so what a range is and which bounds it takes are the library's to say.
function checkRangeExpr(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	var t = ast.noType
	match consumes p.resolutions[ast.modIndex(c.modID)].decls.get(e as Count) 'range'
		some(ref) then t = declTypeOf(p, ms: ms, ref: ref)
		none then return ast.noType
	end 'range'
	let create = methodNamed(p, ms: ms, t: t, name: ast.rangeCreateName)
	if create == ast.noFunc or not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: create).isStatic or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: create).params.count() != rangeBounds 'noCreate'
		failAt(c, p: p, ms: ms, node: e, code: diag.errExpressionError, msg: "a range value makes the standard library's '{nameOfType(p, ms: ms, t: t)}' through its static '{ast.rangeCreateName}' of the two bounds, which it does not declare", errs: errs)
		return ast.noType
	end 'noCreate'
	let specs = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: create).params.clone()
	var bounds = ast.NodeIDList.create(0)
	bounds.push(ast.rangeExprLow(ms.tree(), id: e))
	bounds.push(ast.rangeExprHigh(ms.tree(), id: e))
	for i in 0 upto rangeBounds 'bounds'
		let bound = bounds[i]
		let bt = checkExpecting(c, p: p, ms: ms, e: bound, want: specs[i].ty, errs: errs)
		if bt == ast.noType 'failed'
			return ast.noType
		end 'failed'
		if not coerce(c, p: p, ms: ms, node: bound, at: exprOffset(c, p: p, ms: ms, node: bound), src: bt, target: specs[i].ty, wrong: Mismatch.argument(argumentLabel(specs[i].name)), errs: errs) 'wrong'
			return ast.noType
		end 'wrong'
	end 'bounds'
	var info = ast.CallInfo.make(ast.CallKind.callStatic, fn: create, receiverTy: ast.noType)
	info.paramSpecs = specs.clone()
	info.ordered = bounds.clone()
	info.result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: create).result
	c.typing.calls.insert(e as Count, value: info)
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: create).retTy
end 'checkRangeExpr'

// addToColumn types an element and folds its type into the column, which gives whether it could.
function addToColumn(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, mutates col Column, node ast.NodeID, mutates errs diag.ErrorList) returns bool
	var wanted = col.ty
	if not col.fixed and ast.isIntType(ms.types, reads: p.types, t: col.ty) 'integers'
		wanted = ast.noType
	end 'integers'
	let t = checkExpecting(c, p: p, ms: ms, e: node, want: wanted, errs: errs)
	if t == ast.noType 'failed'
		return false
	end 'failed'
	let off = offsetOf(c, p: p, ms: ms, node: node)
	if t == p.builtins.voidTy or t == p.builtins.neverTy 'noValue'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "an element of a literal is an expression with no value", errs: errs)
		return false
	end 'noValue'
	if col.fixed 'stated'
		return coerce(c, p: p, ms: ms, node: node, at: exprOffset(c, p: p, ms: ms, node: node), src: t, target: col.ty, wrong: Mismatch.argument(col.label.clone()), errs: errs)
	end 'stated'
	if col.ty == ast.noType 'first'
		col.ty = bareRange(p, ms: ms, t: t)
		return true
	end 'first'
	if ast.isIntType(ms.types, reads: p.types, t: col.ty) and ast.isIntType(ms.types, reads: p.types, t: t) 'integers'
		if not requireCommonWord(c, p: p, ms: ms, off: off, a: col.ty, b: t, errs: errs) 'mixed'
			return false
		end 'mixed'
		col.ty = joinTypes(c, p: p, ms: ms, off: off, clash: Clash.other, a: col.ty, b: t, errs: errs)
		return col.ty != ast.noType
	end 'integers'
	return coerce(c, p: p, ms: ms, node: node, at: exprOffset(c, p: p, ms: ms, node: node), src: t, target: col.ty, wrong: Mismatch.argument(col.label.clone()), errs: errs)
end 'addToColumn'

// requireCommonWord refuses two integer types that no 64-bit word holds together: one may be negative while the other
// goes past i64.max.
function requireCommonWord(mutates c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, a ast.TypeID, b ast.TypeID, mutates errs diag.ErrorList) returns bool
	let i64max = ast.I128.i64Max()
	var negative = a
	var large = b
	if rangeLo(ms.types, reads: p.types, t: b).isNeg() and rangeHi(ms.types, reads: p.types, t: a).gt(i64max) 'swapped'
		negative = b
		large = a
	end 'swapped'
	if rangeLo(ms.types, reads: p.types, t: negative).isNeg() and rangeHi(ms.types, reads: p.types, t: large).gt(i64max) 'mixed'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.noCommonIntegerType(rangeLo(ms.types, reads: p.types, t: negative).toString(), high: rangeHi(ms.types, reads: p.types, t: large).toString()), errs: errs)
		return false
	end 'mixed'
	return true
end 'requireCommonWord'

// columnType is the type that the column's elements are stored as. Bare numbers, which have no alias, keep the range
// they span, so that they fit any alias that holds all of them; a literal inside another takes the whole word instead, since
// no alias could be told apart from its siblings.
function columnType(p ast.Project, mutates ms ast.ModuleState, col Column, wide bool) returns ast.TypeID
	if col.fixed or not ast.isIntType(ms.types, reads: p.types, t: col.ty) or typeIsNamedInt(ms.types, reads: p.types, t: col.ty) 'named'
		return col.ty
	end 'named'
	if wide 'word'
		if rangeHi(ms.types, reads: p.types, t: col.ty).gt(ast.I128.i64Max()) 'unsigned'
			return p.builtins.anonU64Ty
		end 'unsigned'
		return p.builtins.anon64Ty
	end 'word'
	return ast.internIntRange(ms.types, reads: p.types, aliasName: "", minVal: rangeLo(ms.types, reads: p.types, t: col.ty), maxVal: rangeHi(ms.types, reads: p.types, t: col.ty), inferred: true)
end 'columnType'

// bareRange is the range that a bare number spans, which a column of elements holds in place of the number; any other type
// is its own.
function bareRange(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	if isConstFloat(p, ms: ms, t: t) 'float'
		return p.builtins.anonFloatTy
	end 'float'
	if not isConstInt(p, ms: ms, t: t) 'other'
		return t
	end 'other'
	return ast.internIntRange(ms.types, reads: p.types, aliasName: "", minVal: rangeLo(ms.types, reads: p.types, t: t), maxVal: rangeHi(ms.types, reads: p.types, t: t), inferred: true)
end 'bareRange'

// holdsBareNumbers is whether a collection stores numbers that no alias names, which a variable cannot hold: it could not
// take a number outside their range later.
function holdsBareNumbers(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	if kind != ast.TypeKind.builtinArray and not ast.isTupleType(ms.types, reads: p.types, t: t) and not isLibraryMap(p, ms: ms, t: t) 'other'
		return false
	end 'other'
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: t).typeArgs.count() 'args'
		let arg = ast.typeEntry(ms.types, reads: p.types, t: t).typeArgs[i]
		if typeIsAnonInt(ms.types, reads: p.types, t: arg) or holdsBareNumbers(p, ms: ms, t: arg) 'bare'
			return true
		end 'bare'
	end 'args'
	return false
end 'holdsBareNumbers'
