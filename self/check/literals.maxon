// The array and map literals. A literal is the collection that the explicit code would build: an empty one, then a push or
// an upsert of each element in order, so each element is checked as the argument of that call is, and moved in the same
// way. The element type is the one the context expects, else the one the elements give.

// Column is the type of one column of a literal: its elements, or its keys, or its values. A stated one is the type the
// context expects, and each element must fit it; an open one is taken from the elements, which are joined as the
// branches of a conditional are.
type Column
	var fixed as bool
	var ty as ast.TypeID
	var label as String

	static function fixedTo(ty ast.TypeID, consumes label String) returns Column
		return Column{fixed: true, ty: ty, label: label}
	end 'fixedTo'

	static function open(consumes label String) returns Column
		return Column{fixed: false, ty: ast.noType, label: label}
	end 'open'
end 'Column'

// expectedArgs are the type arguments of the type that the context expects when it is an instance of the built-in
// collection of kind, and none otherwise.
function expectedArgs(p ast.Project, want ast.TypeID, kind ast.TypeKind) returns ast.TypeIDList
	if want == ast.noType or p.types.entries[ast.typeIndex(want)].kind != kind 'other'
		return ast.TypeIDList.create(0)
	end 'other'
	return ast.cloneTypeArgs(p.types.entries[ast.typeIndex(want)].typeArgs)
end 'expectedArgs'

function checkCollectionLit(mutates c Checker, mutates p ast.Project, e ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let elemsRef = ast.collectionLitExprElemsRef(p.modules[c.modIdx].tree, id: e)
	let valuesRef = ast.collectionLitExprValuesRef(p.modules[c.modIdx].tree, id: e)
	if p.modules[c.modIdx].tree.listLen(elemsRef) == 0 'empty'
		failAt(c, p: p, node: e, code: diag.errUnsupportedFeature, msg: diag.emptyArrayLiteral(), errs: errs)
		return ast.noType
	end 'empty'
	let isMap = p.modules[c.modIdx].tree.listLen(valuesRef) > 0
	let wide = c.literalWide
	let want = c.expect
	c.literalWide = true
	var result = ast.noType
	if isMap 'map'
		result = checkMapLit(c, p: p, e: e, want: want, wide: wide, errs: errs)
	end 'map' else 'array'
		result = checkArrayLit(c, p: p, e: e, want: want, wide: wide, errs: errs)
	end 'array'
	c.literalWide = wide
	return result
end 'checkCollectionLit'

function checkArrayLit(mutates c Checker, mutates p ast.Project, e ast.NodeID, want ast.TypeID, wide bool, mutates errs diag.ErrorList) returns ast.TypeID
	let elemsRef = ast.collectionLitExprElemsRef(p.modules[c.modIdx].tree, id: e)
	let given = expectedArgs(p, want: want, kind: ast.TypeKind.builtinArray)
	var elems = Column.open("'value'")
	if given.count() == 1 and given[0] != ast.noType 'stated'
		elems = Column.fixedTo(given[0], label: "'value'")
	end 'stated'
	for i in 0 upto p.modules[c.modIdx].tree.listLen(elemsRef) 'each'
		if not addToColumn(c, p: p, col: elems, node: p.modules[c.modIdx].tree.listAt(elemsRef, index: i) as ast.NodeID, errs: errs) 'bad'
			return ast.noType
		end 'bad'
	end 'each'
	var args = ast.TypeIDList.create(0)
	args.push(columnType(p, col: elems, wide: wide))
	let origin = p.builtins.arrayOrigin
	return instantiateGeneric(c, p: p, off: offsetOf(c, p: p, node: e), orig: origin, args: args, errs: errs)
end 'checkArrayLit'

function checkMapLit(mutates c Checker, mutates p ast.Project, e ast.NodeID, want ast.TypeID, wide bool, mutates errs diag.ErrorList) returns ast.TypeID
	let keysRef = ast.collectionLitExprElemsRef(p.modules[c.modIdx].tree, id: e)
	let valuesRef = ast.collectionLitExprValuesRef(p.modules[c.modIdx].tree, id: e)
	let given = expectedArgs(p, want: want, kind: ast.TypeKind.builtinMap)
	var keys = Column.open("'key'")
	var values = Column.open("'value'")
	if given.count() == 2 and given[0] != ast.noType and given[1] != ast.noType 'stated'
		keys = Column.fixedTo(given[0], label: "'key'")
		values = Column.fixedTo(given[1], label: "'value'")
	end 'stated'
	for i in 0 upto p.modules[c.modIdx].tree.listLen(keysRef) 'each'
		if not addToColumn(c, p: p, col: keys, node: p.modules[c.modIdx].tree.listAt(keysRef, index: i) as ast.NodeID, errs: errs) 'badKey'
			return ast.noType
		end 'badKey'
		if not addToColumn(c, p: p, col: values, node: p.modules[c.modIdx].tree.listAt(valuesRef, index: i) as ast.NodeID, errs: errs) 'badValue'
			return ast.noType
		end 'badValue'
	end 'each'
	var args = ast.TypeIDList.create(0)
	args.push(columnType(p, col: keys, wide: wide))
	args.push(columnType(p, col: values, wide: wide))
	let origin = p.builtins.mapOrigin
	return instantiateGeneric(c, p: p, off: offsetOf(c, p: p, node: e), orig: origin, args: args, errs: errs)
end 'checkMapLit'

// addToColumn types an element and folds its type into the column, which gives whether it could.
function addToColumn(mutates c Checker, mutates p ast.Project, mutates col Column, node ast.NodeID, mutates errs diag.ErrorList) returns bool
	var wanted = col.ty
	if not col.fixed and ast.isIntType(p.types, t: col.ty) 'integers'
		wanted = ast.noType
	end 'integers'
	let t = checkExpecting(c, p: p, e: node, want: wanted, errs: errs)
	if t == ast.noType 'failed'
		return false
	end 'failed'
	let off = offsetOf(c, p: p, node: node)
	if t == p.builtins.voidTy or t == p.builtins.neverTy 'noValue'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: "an element of a literal is an expression with no value", errs: errs)
		return false
	end 'noValue'
	if not requireSigned64(c, off: off, t: t, p: p, errs: errs) 'wide'
		return false
	end 'wide'
	if col.fixed 'stated'
		return coerce(c, p: p, node: node, at: exprOffset(c, p: p, node: node), src: t, target: col.ty, wrong: Mismatch.argument(col.label.clone()), errs: errs)
	end 'stated'
	if col.ty == ast.noType 'first'
		col.ty = bareRange(p, t: t)
		return true
	end 'first'
	if ast.isIntType(p.types, t: col.ty) and ast.isIntType(p.types, t: t) 'integers'
		if not requireCommonWord(c, p: p, off: off, a: col.ty, b: t, errs: errs) 'mixed'
			return false
		end 'mixed'
		col.ty = joinTypes(c, p: p, off: off, clash: Clash.other, a: col.ty, b: t, errs: errs)
		return col.ty != ast.noType
	end 'integers'
	return coerce(c, p: p, node: node, at: exprOffset(c, p: p, node: node), src: t, target: col.ty, wrong: Mismatch.argument(col.label.clone()), errs: errs)
end 'addToColumn'

// requireCommonWord refuses two integer types that no 64-bit word holds together: one may be negative while the other
// goes past i64.max.
function requireCommonWord(mutates c Checker, p ast.Project, off diag.U32, a ast.TypeID, b ast.TypeID, mutates errs diag.ErrorList) returns bool
	let i64max = ast.I128.i64Max()
	var negative = a
	var large = b
	if rangeLo(p.types, t: b).isNeg() and rangeHi(p.types, t: a).gt(i64max) 'swapped'
		negative = b
		large = a
	end 'swapped'
	if rangeLo(p.types, t: negative).isNeg() and rangeHi(p.types, t: large).gt(i64max) 'mixed'
		checkFail(c.modID, off: off, code: diag.errTypeMismatch, msg: diag.noCommonIntegerType(rangeLo(p.types, t: negative).toString(), high: rangeHi(p.types, t: large).toString()), errs: errs)
		return false
	end 'mixed'
	return true
end 'requireCommonWord'

// columnType is the type that the column's elements are stored as. Bare numbers, which have no alias, keep the range
// they span, so that they fit any alias that holds all of them; a literal inside another takes the whole word instead, since
// no alias could be told apart from its siblings.
function columnType(mutates p ast.Project, col Column, wide bool) returns ast.TypeID
	if col.fixed or not ast.isIntType(p.types, t: col.ty) or typeIsNamedInt(p.types, t: col.ty) 'named'
		return col.ty
	end 'named'
	if wide 'word'
		if rangeHi(p.types, t: col.ty).gt(ast.I128.i64Max()) 'unsigned'
			return p.builtins.anonU64Ty
		end 'unsigned'
		return p.builtins.anon64Ty
	end 'word'
	return ast.internIntRange(p.types, aliasName: "", minVal: rangeLo(p.types, t: col.ty), maxVal: rangeHi(p.types, t: col.ty), inferred: true)
end 'columnType'

// bareRange is the range that a bare number spans, which a column of elements holds in place of the number; any other type
// is its own.
function bareRange(mutates p ast.Project, t ast.TypeID) returns ast.TypeID
	if isConstFloat(p, t: t) 'float'
		return p.builtins.anonFloatTy
	end 'float'
	if not isConstInt(p, t: t) 'other'
		return t
	end 'other'
	return ast.internIntRange(p.types, aliasName: "", minVal: rangeLo(p.types, t: t), maxVal: rangeHi(p.types, t: t), inferred: true)
end 'bareRange'

// holdsBareNumbers is whether a collection stores numbers that no alias names, which a variable cannot hold: it could not
// take a number outside their range later.
function holdsBareNumbers(p ast.Project, t ast.TypeID) returns bool
	let kind = p.types.entries[ast.typeIndex(t)].kind
	if kind != ast.TypeKind.builtinArray and kind != ast.TypeKind.builtinMap and kind != ast.TypeKind.builtinList and not ast.isTupleType(p.types, t: t) 'other'
		return false
	end 'other'
	for i in 0 upto p.types.entries[ast.typeIndex(t)].typeArgs.count() 'args'
		let arg = p.types.entries[ast.typeIndex(t)].typeArgs[i]
		if typeIsAnonInt(p.types, t: arg) or holdsBareNumbers(p, t: arg) 'bare'
			return true
		end 'bare'
	end 'args'
	return false
end 'holdsBareNumbers'
