// PlaceDepth is how many fields deep a place goes.
typealias PlaceDepth = int(0 to 2)

// placeDepth is how many fields deep the range analysis follows a place: 'x', 'x.f' and 'x.f.g'.
let placeDepth = 2 as PlaceDepth

// Place is storage that the range analysis follows: a local, or a field of one, or a field of that. Values have one owner
// and nothing else reaches them, so a place changes only where the code names it: an assignment to it or to what holds
// it, or a call that takes it to change it. The root is the local's slot in the function being walked, and a field is
// its index in the record that holds it, which the path from the root decides.
type Place
	export var root as Count
	export var depth as PlaceDepth
	export var first as Count
	export var second as Count
	// counted is whether the place is the count of the collection at the path rather than the collection: the count lies
	// in the collection's storage, so what overlaps the collection overlaps its count.
	export var counted as bool

	static function local(root Count) returns Place
		return Place{root: root, depth: 0 as PlaceDepth, first: 0 as Count, second: 0 as Count, counted: false}
	end 'local'

	// isLocal is whether the place is a local itself, whose span a state keeps by its slot.
	function isLocal() returns bool
		return depth == 0 and not counted
	end 'isLocal'

	// isCountOf is whether this place is the count of the collection at q.
	function isCountOf(q Place) returns bool
		return counted and not q.counted and self.samePath(q)
	end 'isCountOf'

	function samePath(other Place) returns bool
		return root == other.root and depth == other.depth and first == other.first and second == other.second
	end 'samePath'

	// fieldAt is the field the path takes at a depth below the place's own.
	function fieldAt(i Count) returns Count
		if i == 0 'first'
			return first
		end 'first'
		return second
	end 'fieldAt'

	function same(other Place) returns bool
		return self.samePath(other) and counted == other.counted
	end 'same'

	// holds is whether the storage of q is this place's or lies inside it, a count being in its collection's storage.
	function holds(q Place) returns bool
		if root != q.root or depth > q.depth 'apart'
			return false
		end 'apart'
		for i in 0 upto depth as Count 'each'
			if self.fieldAt(i) != q.fieldAt(i) 'differs'
				return false
			end 'differs'
		end 'each'
		return true
	end 'holds'

	// overlaps is whether a change to this place changes q, or the other way round.
	function overlaps(q Place) returns bool
		return self.holds(q) or q.holds(self)
	end 'overlaps'
end 'Place'

typealias PlaceList = Array with Place

// placeField is the place of a field of p, if p is not too deep to follow one.
function placeField(p Place, field Count) returns table.Option with Place
	if p.depth == placeDepth 'deep'
		return table.Option.none
	end 'deep'
	var out = p.clone()
	if p.depth == 0 'first'
		out.first = field
	end 'first' else 'second'
		out.second = field
	end 'second'
	out.depth = p.depth + 1
	return table.Option.some(out)
end 'placeField'

// placeCount is the place of the count of the collection at p.
function placeCount(p Place) returns Place
	if p.counted 'twice'
		panic("ranges: a count has no count")
	end 'twice'
	var out = p.clone()
	out.counted = true
	return out
end 'placeCount'

// maxElementCount is more elements than any array holds. No element takes less than a byte of the buffer: a packed byte is
// one, and every other holding at least a word, a record with no fields too (ir.holdingBytes, ir.boxBytes), so there is no
// element of size 0. Every count an array reaches is backed by a buffer of that many elements, whose size the runtime
// computes with a checked product (collectionBytes), and no 64-bit target addresses 2^62 bytes, so a count that grows
// stays below it.
let maxElementCount = 4611686018427387904 as Count

// changedIn is whether a place overlaps one of the places written from since on.
function changedIn(p Place, written PlaceList, since Count) returns bool
	for i in since upto written.count() 'each'
		if p.overlaps(written[i]) 'overlaps'
			return true
		end 'overlaps'
	end 'each'
	return false
end 'changedIn'

// PlaceSpan is what is known of a field.
type PlaceSpan
	export var at as Place
	export var span as Span

	static function make(consumes at Place, consumes span Span) returns PlaceSpan
		return PlaceSpan{at: at, span: span}
	end 'make'
end 'PlaceSpan'

// Relation says that hi - lo >= gap: what 'hi >= lo' or 'hi > lo' proves, which a subtraction of the two reads.
type Relation
	export var hi as Place
	export var lo as Place
	export var gap as ast.I128

	static function make(consumes hi Place, consumes lo Place, consumes gap ast.I128) returns Relation
		return Relation{hi: hi, lo: lo, gap: gap}
	end 'make'
end 'Relation'

// CompareSide is a side of a comparison that a state may prove: a place moved by a constant, with the span the place has
// where it is compared, or a constant, its value the span and at none.
type CompareSide
	export var at as table.Option with Place
	export var span as Span
	export var by as ast.I128

	static function placed(consumes at Place, consumes span Span, consumes by ast.I128) returns CompareSide
		return CompareSide{at: table.Option.some(at), span: span, by: by}
	end 'placed'

	static function constant(value ast.I128) returns CompareSide
		return CompareSide{at: table.Option.none, span: Span.exactly(value), by: ast.I128.zero()}
	end 'constant'

	// place is the place of a side that has one.
	function place() returns Place
		return match at 'at'
			some(p) gives p.clone()
			none panic("ranges: a constant side has no place")
		end 'at'
	end 'place'
end 'CompareSide'

// Gone says which places a state forgets: those that overlap a place that changed, or all but some of them.
union Gone
	overlapping(place Place)
	// besides are the places that overlap a collection but its count, which a count effect adjusts instead.
	besides(collection Place)
	// apart are the places that overlap a place but the place itself, whose facts a move by a known amount keeps.
	apart(place Place)

	function isGone(p Place) returns bool
		return match self 'rule'
			overlapping(q) gives q.overlaps(p)
			besides(q) gives q.overlaps(p) and not p.isCountOf(q)
			apart(q) gives q.overlaps(p) and not q.same(p)
		end 'rule'
	end 'isGone'
end 'Gone'

// RangeState is what the analysis knows at a point of a function: the span of each integer local by its slot, the spans
// of the fields a condition narrowed, how places compare, or that no path reaches the point. A state that something keeps
// to come back to is kept, and is copied before it changes; the current state is changed in place otherwise, so a run of
// statements copies nothing.
type RangeState
	export var spans as SpanList
	export var fields as PlaceSpanList
	export var relations as RelationList
	export var dead as bool
	export var kept as bool

	static function make(n Count, dead bool, kept bool) returns RangeState
		var spans = SpanList.create(0)
		for _ in 0 upto n 'each'
			spans.push(Span.make(ast.I128.zero(), hi: ast.I128.zero()))
		end 'each'
		return RangeState{spans: spans, fields: Array.create(0), relations: Array.create(0), dead: dead, kept: kept}
	end 'make'

	// at is what is known of an integer place, if anything beyond its type.
	function at(p Place) returns table.Option with Span
		if p.isLocal() 'local'
			return table.Option.some(spans[p.root].clone())
		end 'local'
		for i in 0 upto fields.count() 'each'
			if fields[i].at.same(p) 'found'
				return table.Option.some(fields[i].span.clone())
			end 'found'
		end 'each'
		return table.Option.none
	end 'at'

	// refine records what is known of an integer place.
	function refine(mutates self, p Place, v Span)
		if p.isLocal() 'local'
			spans[p.root] = v.clone()
			return
		end 'local'
		for i in 0 upto fields.count() 'each'
			if fields[i].at.same(p) 'found'
				fields[i].span = v.clone()
				return
			end 'found'
		end 'each'
		fields.push(PlaceSpan.make(p.clone(), span: v.clone()))
	end 'refine'

	// relate records that hi - lo >= gap. A state that holds maxRelations already forgets the new one, which knowing less
	// allows.
	function relate(mutates self, hi Place, lo Place, gap ast.I128)
		for i in 0 upto relations.count() 'each'
			if relations[i].hi.same(hi) and relations[i].lo.same(lo) 'found'
				let wider = ast.maxI128(relations[i].gap, b: gap)
				relations[i].gap = wider
				return
			end 'found'
		end 'each'
		if relations.count() < maxRelations 'room'
			relations.push(Relation.make(hi.clone(), lo: lo.clone(), gap: gap.clone()))
		end 'room'
	end 'relate'

	// equate records that v is w + by, as a binding or an assignment of 'w + by' leaves it, which nothing else known names
	// yet: v is as far from every place w is related to as w is, moved by by, so 'hi = mid' keeps a relation of hi itself
	// that a join with a path where hi did not change can find.
	function equate(mutates self, v Place, w Place, by ast.I128)
		let n = relations.count()
		self.relate(v, lo: w, gap: by)
		self.relate(w, lo: v, gap: by.neg())
		for i in 0 upto n 'copies'
			if relations[i].lo.same(w) and not relations[i].hi.overlaps(v) 'above'
				let hi = relations[i].hi.clone()
				let gap = relations[i].gap.sub(by)
				self.relate(hi, lo: v, gap: gap)
			end 'above' else if relations[i].hi.same(w) and not relations[i].lo.overlaps(v) 'below'
				let lo = relations[i].lo.clone()
				let gap = relations[i].gap.add(by)
				self.relate(v, lo: lo, gap: gap)
			end 'below'
		end 'copies'
	end 'equate'

	// gap is how far hi is known to lie above lo, if anything is known of it.
	function gap(hi Place, lo Place) returns table.Option with ast.I128
		for i in 0 upto relations.count() 'each'
			if relations[i].hi.same(hi) and relations[i].lo.same(lo) 'found'
				return table.Option.some(relations[i].gap.clone())
			end 'found'
		end 'each'
		return table.Option.none
	end 'gap'

	// least is the least that hi - lo can be by the relations, along a chain of at most three of them from hi down to lo:
	// each says one place lies at least its gap above the next, so the gaps add. Gaps are bounded by the spans of the
	// words and counts they relate, so three of them add far inside an I128.
	function least(hi Place, lo Place) returns table.Option with ast.I128
		var found = false
		var best = ast.I128.zero()
		for i in 0 upto relations.count() 'first'
			if relations[i].hi.same(hi) 'fromHi'
				if relations[i].lo.same(lo) 'one'
					best = betterGap(found, best: best, gap: relations[i].gap)
					found = true
				end 'one'
				for j in 0 upto relations.count() 'second'
					if relations[j].hi.same(relations[i].lo) 'next'
						let two = relations[i].gap.add(relations[j].gap)
						if relations[j].lo.same(lo) 'two'
							best = betterGap(found, best: best, gap: two)
							found = true
						end 'two'
						for k in 0 upto relations.count() 'third'
							if relations[k].hi.same(relations[j].lo) and relations[k].lo.same(lo) 'three'
								best = betterGap(found, best: best, gap: two.add(relations[k].gap))
								found = true
							end 'three'
						end 'third'
					end 'next'
				end 'second'
			end 'fromHi'
		end 'first'
		if not found 'none'
			return table.Option.none
		end 'none'
		return table.Option.some(best)
	end 'least'

	// knownSpan is what the state knows of a place that a relation names, for bounding another through it: a local's span
	// is always held, and a count lies between 0 and maxElementCount where nothing else is known.
	function knownSpan(p Place) returns table.Option with Span
		if p.isLocal() 'local'
			return table.Option.some(spans[p.root].clone())
		end 'local'
		match consumes self.at(p) 'known'
			some(s) then return table.Option.some(s)
			none then break
		end 'known'
		if p.counted 'count'
			return table.Option.some(Span.make(ast.I128.zero(), hi: ast.I128.fromCount(maxElementCount)))
		end 'count'
		return table.Option.none
	end 'knownSpan'

	// tightened is the span cur of the place p, cut by each relation that bounds p by a place whose span is known: q - p >= g
	// puts p at most q's highest less g, and p - q >= g at least q's lowest plus g.
	function tightened(p Place, cur Span) returns Span
		var lo = cur.lo.clone()
		var hi = cur.hi.clone()
		for i in 0 upto relations.count() 'each'
			if relations[i].lo.same(p) 'below'
				match consumes self.knownSpan(relations[i].hi) 'hi'
					some(s) then hi = ast.minI128(hi, b: s.hi.sub(relations[i].gap))
					none then break
				end 'hi'
			end 'below'
			if relations[i].hi.same(p) 'above'
				match consumes self.knownSpan(relations[i].lo) 'lo'
					some(s) then lo = ast.maxI128(lo, b: s.lo.add(relations[i].gap))
					none then break
				end 'lo'
			end 'above'
		end 'each'
		var out = Span.make(lo, hi: hi)
		out.nonZero = cur.nonZero
		return out
	end 'tightened'

	// sideSpan is the span of a side's place, cut by its relations, or the constant of a side with none.
	function sideSpan(side CompareSide) returns Span
		return match side.at 'at'
			some(p) gives self.tightened(p, cur: side.span)
			none gives side.span.clone()
		end 'at'
	end 'sideSpan'

	// sidesGap is the least that the place of hi lies above the place of lo along a chain of relations, 0 for one place, or
	// none where either side has no place or no chain relates them.
	function sidesGap(hi CompareSide, lo CompareSide) returns table.Option with ast.I128
		if not hi.at.isSome() or not lo.at.isSome() 'constant'
			return table.Option.none
		end 'constant'
		let h = hi.place()
		let l = lo.place()
		if h.same(l) 'same'
			return table.Option.some(ast.I128.zero())
		end 'same'
		return self.least(h, lo: l)
	end 'sidesGap'

	// provesAbove is whether every value the state describes has hi - lo >= gap, for two sides moved by their constants: by
	// the spans of their places, or by the relations between them.
	function provesAbove(hi CompareSide, lo CompareSide, gap ast.I128) returns bool
		var least = self.sideSpan(hi).lo.sub(self.sideSpan(lo).hi)
		match consumes self.sidesGap(hi, lo: lo) 'chain'
			some(g) then least = ast.maxI128(least, b: g)
			none then break
		end 'chain'
		return least.add(hi.by).sub(lo.by).ge(gap)
	end 'provesAbove'

	// provesCompared is whether every value the state describes has 'x op y', a comparison that bounds the difference of its
	// sides, as a loop invariant states one.
	function provesCompared(x CompareSide, op String, y CompareSide) returns bool
		let zero = ast.I128.zero()
		let one = ast.I128.one()
		return match op 'op'
			">" gives self.provesAbove(x, lo: y, gap: one)
			">=" gives self.provesAbove(x, lo: y, gap: zero)
			"<" gives self.provesAbove(y, lo: x, gap: one)
			"<=" gives self.provesAbove(y, lo: x, gap: zero)
			"==" gives self.provesAbove(x, lo: y, gap: zero) and self.provesAbove(y, lo: x, gap: zero)
			default panic("ranges: '{op}' bounds no difference")
		end 'op'
	end 'provesCompared'

	// provesMidpoint is whether 'low + (high - low) / 2' lies from low to high - 1 for every value the state describes: where
	// high - low >= 1, half a difference d >= 1, truncated, is from 0 to d - 1. Then its sum cannot pass its type.
	function provesMidpoint(low CompareSide, high CompareSide) returns bool
		return self.provesAbove(high, lo: low, gap: ast.I128.one())
	end 'provesMidpoint'

	// midpointSpan is the span of the midpoint that provesMidpoint proves: from low's lowest to one under high's highest.
	function midpointSpan(low CompareSide, high CompareSide) returns Span
		return Span.make(self.sideSpan(low).lo.clone(), hi: self.sideSpan(high).hi.sub(ast.I128.one()))
	end 'midpointSpan'

	// relateMidpoint records what a place m that was just given a proven midpoint of low and high knows: m - low >= 0 and
	// high - m >= 1, each only where m is not the place of the other side, which the write changed.
	function relateMidpoint(mutates self, m Place, low Place, high Place)
		if not m.overlaps(low) 'low'
			self.relate(m, lo: low, gap: ast.I128.zero())
		end 'low'
		if not m.overlaps(high) 'high'
			self.relate(high, lo: m, gap: ast.I128.one())
		end 'high'
	end 'relateMidpoint'

	// shiftPlace moves what is known of how p compares with other places by exactly by, as 'p = p + by' does where the sum is
	// exact; what names a place inside p or holding it goes. The caller gives p its new span.
	function shiftPlace(mutates self, p Place, by ast.I128)
		self.drop(Gone.apart(p.clone()))
		for i in 0 upto relations.count() 'each'
			if relations[i].hi.same(p) 'above'
				relations[i].gap = relations[i].gap.add(by)
			end 'above'
			if relations[i].lo.same(p) 'below'
				relations[i].gap = relations[i].gap.sub(by)
			end 'below'
		end 'each'
	end 'shiftPlace'

	// drop forgets the fields and relations that name a place gone says is gone. A local's own span stays: whoever changed
	// it sets the new one.
	function drop(mutates self, gone Gone)
		if fields.count() == 0 and relations.count() == 0 'nothing'
			return
		end 'nothing'
		var keptFields = 0 as Count
		for i in 0 upto fields.count() 'fields'
			if not gone.isGone(fields[i].at) 'stays'
				if keptFields != i 'moves'
					fields[keptFields] = fields[i].clone()
				end 'moves'
				keptFields = keptFields + 1
			end 'stays'
		end 'fields'
		fields.truncate(keptFields)
		self.bridge(gone)
		var keptRelations = 0 as Count
		for i in 0 upto relations.count() 'relations'
			if not gone.isGone(relations[i].hi) and not gone.isGone(relations[i].lo) 'stays'
				if keptRelations != i 'moves'
					relations[keptRelations] = relations[i].clone()
				end 'moves'
				keptRelations = keptRelations + 1
			end 'stays'
		end 'relations'
		relations.truncate(keptRelations)
	end 'drop'

	// bridge keeps what two relations through a place that is gone said of the places on either side of it, which stay: x - d
	// >= g1 and d - y >= g2 give x - y >= g1 + g2, true before d changed and so after. 'hi = mid' in a search then keeps how
	// far the old hi, and so mid, lay below the count.
	function bridge(mutates self, gone Gone)
		let n = relations.count()
		for i in 0 upto n 'above'
			if gone.isGone(relations[i].lo) and not gone.isGone(relations[i].hi) 'through'
				for j in 0 upto n 'below'
					if relations[j].hi.same(relations[i].lo) and not gone.isGone(relations[j].lo) and not relations[j].lo.same(relations[i].hi) 'bridged'
						let hi = relations[i].hi.clone()
						let lo = relations[j].lo.clone()
						let gap = relations[i].gap.add(relations[j].gap)
						self.relate(hi, lo: lo, gap: gap)
					end 'bridged'
				end 'below'
			end 'through'
		end 'above'
	end 'bridge'

	// affect applies what a call that changes nothing else the state follows inside the collection at holder does to its
	// count: a fact on the count that the effect cannot falsify stays, moved by an exact amount, and the others go, as does
	// every fact on a place inside the collection that is not its count.
	function affect(mutates self, holder Place, effect ast.CountEffect)
		if dead 'dead'
			return
		end 'dead'
		match effect 'effect'
			countKeep then self.drop(Gone.besides(holder.clone()))
			countGrow then self.widenCount(holder, grows: true)
			countShrink then self.widenCount(holder, grows: false)
			countGrowOne then self.shiftCount(holder, by: ast.I128.one())
			countShrinkOne then self.shiftCount(holder, by: ast.I128.one().neg())
			countChange then self.drop(Gone.overlapping(holder.clone()))
		end 'effect'
	end 'affect'

	// affectCollection is affect on a collection, whose count lies from 0 to maxElementCount where nothing bounds it: a step
	// up from there leaves the count at least 1, which a pop, a first or a last after a push needs.
	function affectCollection(mutates self, holder Place, effect ast.CountEffect)
		if effect == ast.CountEffect.countGrowOne and not dead 'grows'
			let measure = placeCount(holder)
			if not self.at(measure).isSome() 'unbounded'
				self.refine(measure, v: Span.make(ast.I128.zero(), hi: ast.I128.fromCount(maxElementCount)))
			end 'unbounded'
		end 'grows'
		self.affect(holder, effect: effect)
	end 'affectCollection'

	// widenCount is a count that grows, or shrinks, by an amount not known: a relation that has the count on the side it
	// moves away from stays, and its bound on that side.
	function widenCount(mutates self, holder Place, grows bool)
		self.drop(Gone.besides(holder.clone()))
		let measure = placeCount(holder)
		for i in 0 upto fields.count() 'fields'
			if fields[i].at.same(measure) 'count'
				var moved = Span.make(ast.I128.zero(), hi: fields[i].span.hi.clone())
				if grows 'grows'
					moved = Span.make(fields[i].span.lo.clone(), hi: ast.I128.fromCount(maxElementCount))
				end 'grows'
				fields[i].span = moved
			end 'count'
		end 'fields'
		var stay = 0 as Count
		for i in 0 upto relations.count() 'relations'
			let falsified = relations[i].lo.same(measure) if grows else relations[i].hi.same(measure)
			if not falsified 'stays'
				if stay != i 'moves'
					relations[stay] = relations[i].clone()
				end 'moves'
				stay = stay + 1
			end 'stays'
		end 'relations'
		relations.truncate(stay)
	end 'widenCount'

	// keepThrough makes the state at the top of a loop from the state where the loop is entered: what an effect of the body
	// can falsify goes, and what none can stays. The effects are those of every statement of the body, whatever path runs
	// it, so a fact that none falsifies holds at the start of every iteration, whether the one before ended at the end of
	// the body or at a continue: one pass decides the top, and no iteration is needed, since what it keeps the body keeps.
	// A local the body writes has its type's span again, by wide; a count that only grows keeps its lowest and a relation it
	// lies above, and one that only shrinks keeps its highest and a relation it lies below.
	function keepThrough(mutates self, scans LoopScans, loop Count, mutable ByteArray, wide SpanList)
		if dead 'dead'
			return
		end 'dead'
		var opaque = false
		for i in scans.loops[loop].first upto scans.loops[loop].past 'locals'
			if scans.effects[i].opaque 'opaque'
				opaque = true
			end 'opaque' else if scans.effects[i].at.isLocal() 'written'
				let slot = scans.effects[i].at.root
				spans[slot] = wide[slot].clone()
			end 'written'
		end 'locals'
		if opaque 'assignable'
			for slot in 0 upto spans.count() 'slots'
				if mutable[slot] != 0 'forgotten'
					spans[slot] = wide[slot].clone()
				end 'forgotten'
			end 'slots'
		end 'assignable'
		var keptFields = 0 as Count
		for i in 0 upto fields.count() 'fields'
			let moves = scans.effectOn(loop, q: fields[i].at, mutable: mutable)
			if moves != ast.CountEffect.countChange 'stays'
				if moves == ast.CountEffect.countGrow 'grows'
					fields[i].span = Span.make(fields[i].span.lo.clone(), hi: ast.I128.fromCount(maxElementCount))
				end 'grows' else if moves == ast.CountEffect.countShrink 'shrinks'
					fields[i].span = Span.make(ast.I128.zero(), hi: fields[i].span.hi.clone())
				end 'shrinks'
				if keptFields != i 'moved'
					fields[keptFields] = fields[i].clone()
				end 'moved'
				keptFields = keptFields + 1
			end 'stays'
		end 'fields'
		fields.truncate(keptFields)
		var keptRelations = 0 as Count
		for i in 0 upto relations.count() 'relations'
			if risesOnly(scans.effectOn(loop, q: relations[i].hi, mutable: mutable)) and fallsOnly(scans.effectOn(loop, q: relations[i].lo, mutable: mutable)) 'stays'
				if keptRelations != i 'moved'
					relations[keptRelations] = relations[i].clone()
				end 'moved'
				keptRelations = keptRelations + 1
			end 'stays'
		end 'relations'
		relations.truncate(keptRelations)
	end 'keepThrough'

	// shiftCount is a count that moves by exactly delta: every fact on it moves with it.
	function shiftCount(mutates self, holder Place, by ast.I128)
		self.drop(Gone.besides(holder.clone()))
		let measure = placeCount(holder)
		for i in 0 upto fields.count() 'fields'
			if fields[i].at.same(measure) 'count'
				let lo = ast.maxI128(fields[i].span.lo.add(by), b: ast.I128.zero())
				let hi = ast.minI128(fields[i].span.hi.add(by), b: ast.I128.fromCount(maxElementCount))
				if lo.gt(hi) 'never'
					dead = true
					return
				end 'never'
				fields[i].span = Span.make(lo, hi: hi)
			end 'count'
		end 'fields'
		for i in 0 upto relations.count() 'relations'
			if relations[i].hi.same(measure) 'above'
				relations[i].gap = relations[i].gap.add(by)
			end 'above'
			if relations[i].lo.same(measure) 'below'
				relations[i].gap = relations[i].gap.sub(by)
			end 'below'
		end 'relations'
	end 'shiftCount'
end 'RangeState'

// PlaceEffect is what the body of a loop may do to a place: the count effect of a call on the collection at the place,
// which changes whatever else lies inside it, a write being countChange; or, where opaque, anything to whatever may be
// assigned, for code whose effects the scan cannot name.
type PlaceEffect
	export var at as Place
	export var effect as ast.CountEffect
	export var opaque as bool

	static function make(consumes at Place, effect ast.CountEffect, opaque bool) returns PlaceEffect
		return PlaceEffect{at: at, effect: effect, opaque: opaque}
	end 'make'
end 'PlaceEffect'

typealias PlaceEffectList = Array with PlaceEffect

// LoopScan is a loop whose body the scan has summed up: its effects are those from first until past, the effects of the
// loops nested in it among them.
type LoopScan
	export var node as ast.NodeID
	export var first as Count
	export var past as Count

	static function make(node ast.NodeID, first Count) returns LoopScan
		return LoopScan{node: node, first: first, past: first}
	end 'make'
end 'LoopScan'

typealias LoopScanList = Array with LoopScan

typealias LoopIndexes = Array with Count

// LoopScans are the effects of the bodies of the loops of a function, scanned once each. A loop nested in another is
// scanned while the other is, its effects among the other's, so a nest is scanned once and not once per level.
type LoopScans
	export var effects as PlaceEffectList
	export var loops as LoopScanList
	// open are the loops being scanned, innermost last.
	export var open as LoopIndexes

	static function new() returns LoopScans
		return LoopScans{effects: PlaceEffectList.create(0), loops: LoopScanList.create(0), open: LoopIndexes.create(0)}
	end 'new'

	// find is the loop of the node s, if it was scanned.
	function find(s ast.NodeID) returns table.Option with Count
		for i in 0 upto loops.count() 'each'
			if loops[i].node == s 'found'
				return table.Option.some(i)
			end 'found'
		end 'each'
		return table.Option.none
	end 'find'

	// enter begins the scan of the loop of the node s, inside the loops being scanned, and gives the loop.
	function enter(mutates self, s ast.NodeID) returns Count
		let loop = loops.count()
		loops.push(LoopScan.make(s, first: effects.count()))
		open.push(loop)
		return loop
	end 'enter'

	// leave ends the scan of the innermost loop being scanned: what follows is the loops' around it alone.
	function leave(mutates self)
		let loop = try open.pop() otherwise panic("ranges: a loop scan ended that was never begun")
		loops[loop].past = effects.count()
	end 'leave'

	// change notes that the body may have the count effect effect on the collection at place, and change the rest of it.
	function change(mutates self, place Place, effect ast.CountEffect)
		effects.push(PlaceEffect.make(place.clone(), effect: effect, opaque: false))
	end 'change'

	// opaque notes code that may change whatever may be assigned, in ways the scan cannot name.
	function opaque(mutates self)
		effects.push(PlaceEffect.make(Place.local(0 as Count), effect: ast.CountEffect.countChange, opaque: true))
	end 'opaque'

	// truncate forgets the loops scanned since there were loops of them and effects of them, as the walk of a function ends.
	function truncate(mutates self, loopCount Count, effectCount Count)
		loops.truncate(loopCount)
		effects.truncate(effectCount)
	end 'truncate'

	// effectOn is how the body of loop may move the place q, by every effect of the body: not at all (countKeep), only up
	// (countGrow), only down (countShrink), or any way (countChange). A count moves as the effects on its collection say;
	// anything else that the place of an effect overlaps may become anything, and so may whatever may be assigned where the
	// body is opaque.
	function effectOn(loop Count, q Place, mutable ByteArray) returns ast.CountEffect
		var out = ast.CountEffect.countKeep
		for i in loops[loop].first upto loops[loop].past 'effects'
			var one = ast.CountEffect.countKeep
			if effects[i].opaque 'opaque'
				if mutable[q.root] != 0 'assignable'
					one = ast.CountEffect.countChange
				end 'assignable'
			end 'opaque' else if q.isCountOf(effects[i].at) 'count'
				one = loopDirection(effects[i].effect)
			end 'count' else if effects[i].at.overlaps(q) 'overlaps'
				one = ast.CountEffect.countChange
			end 'overlaps'
			out = mergedDirection(out, b: one)
			if out == ast.CountEffect.countChange 'any'
				return out
			end 'any'
		end 'effects'
		return out
	end 'effectOn'
end 'LoopScans'

// loopDirection is the way a count effect moves a count over any number of iterations: an exact step repeated is a move
// by an amount not known.
function loopDirection(e ast.CountEffect) returns ast.CountEffect
	return match e 'e'
		countKeep gives ast.CountEffect.countKeep
		countGrow or
		countGrowOne gives ast.CountEffect.countGrow
		countShrink or
		countShrinkOne gives ast.CountEffect.countShrink
		countChange gives ast.CountEffect.countChange
	end 'e'
end 'loopDirection'

// mergedDirection is the way a place moves that moves the way a says and the way b says, in any order and number.
function mergedDirection(a ast.CountEffect, b ast.CountEffect) returns ast.CountEffect
	if a == ast.CountEffect.countKeep 'onlyB'
		return b
	end 'onlyB'
	if b == ast.CountEffect.countKeep or a == b 'onlyA'
		return a
	end 'onlyA'
	return ast.CountEffect.countChange
end 'mergedDirection'

// risesOnly is whether a place that moves the way e says is never below where it was: the upper side of a relation stays.
function risesOnly(e ast.CountEffect) returns bool
	return e == ast.CountEffect.countKeep or e == ast.CountEffect.countGrow
end 'risesOnly'

// fallsOnly is whether a place that moves the way e says is never above where it was: the lower side of a relation stays.
function fallsOnly(e ast.CountEffect) returns bool
	return e == ast.CountEffect.countKeep or e == ast.CountEffect.countShrink
end 'fallsOnly'

// provesPrecondition is whether an access's precondition is proved, where least is the least that the collection's count
// lies above the index, or above 0 for an access with no index, and lowest the index's lowest value: then the call is the
// twin that cannot fail, and its count effect, an exact step, holds.
function provesPrecondition(requirement ast.Precondition, least ast.I128, lowest ast.I128) returns bool
	return match requirement 'requirement'
		requiresNone gives panic("ranges: an access with no precondition")
		requiresNonEmpty gives least.ge(ast.I128.one())
		requiresIndexBelow gives not lowest.isNeg() and least.ge(ast.I128.one())
	end 'requirement'
end 'provesPrecondition'

// boundGap is how far a for loop's bound place lies above its counter on every iteration, for a bound written as the place
// plus by, where the body only raises the place or leaves it (risesOnly): 'bound > counter', or 'bound >= counter' for a
// loop that reaches its bound, held by the value the loop evaluated once, which the place never falls under.
function boundGap(by ast.I128, exact bool, inclusive bool) returns table.Option with ast.I128
	return comparedGap(">=" if inclusive else ">", dx: by, dy: ast.I128.zero(), exact: exact)
end 'boundGap'

// startGap is how far a for loop's counter lies above its start place on every iteration, for a start written as the place
// plus by, where the body only lowers the place or leaves it (fallsOnly): the counter only rises from where it started.
function startGap(by ast.I128, exact bool) returns table.Option with ast.I128
	return comparedGap(">=", dx: ast.I128.zero(), dy: by, exact: exact)
end 'startGap'

// narrowedSpan is what 'x op y' leaves of x's span cur, where y has the span other.
function narrowedSpan(cur Span, op String, other Span) returns Span
	var next = cur.clone()
	if op == "<" 'lt'
		next.hi = ast.minI128(cur.hi, b: other.hi.sub(ast.I128.one()))
	end 'lt' else if op == "<=" 'le'
		next.hi = ast.minI128(cur.hi, b: other.hi)
	end 'le' else if op == ">" 'gt'
		next.lo = ast.maxI128(cur.lo, b: other.lo.add(ast.I128.one()))
	end 'gt' else if op == ">=" 'ge'
		next.lo = ast.maxI128(cur.lo, b: other.lo)
	end 'ge' else if op == "==" 'eq'
		next = cur.clamp(other)
		next.nonZero = cur.nonZero or other.excludesZero()
	end 'eq' else if op == "!=" 'ne'
		if not other.lo.eq(other.hi) 'many'
			return next
		end 'many'
		if other.lo.eq(cur.lo) 'atLow'
			next.lo = cur.lo.add(ast.I128.one())
		end 'atLow' else if other.lo.eq(cur.hi) 'atHigh'
			next.hi = cur.hi.sub(ast.I128.one())
		end 'atHigh' else if other.lo.isZero() 'zero'
			next.nonZero = true
		end 'zero'
	end 'ne' else 'unknownOp'
		panic("ranges: '{op}' is no comparison")
	end 'unknownOp'
	return next
end 'narrowedSpan'

// betterGap is the larger of the best gap found so far and gap, or gap where none was found.
function betterGap(found bool, best ast.I128, gap ast.I128) returns ast.I128
	if not found 'first'
		return gap.clone()
	end 'first'
	return ast.maxI128(best, b: gap)
end 'betterGap'

// maxRelations is how many relations a state holds at most, which bounds the chains least follows.
let maxRelations = 32 as Count

// shiftedSpan is the values of s moved by by.
function shiftedSpan(s Span, by ast.I128) returns Span
	if by.isZero() 'same'
		return s.clone()
	end 'same'
	return Span.make(s.lo.add(by), hi: s.hi.add(by))
end 'shiftedSpan'

// comparedGap is what 'x + dx op y + dy' says of x - y, if it says something: the comparison's gap, moved by the offsets.
// Only a sum computed exactly says anything of its operand: one that fails past its word never gets to the comparison, and
// one computed modulo the word (exact is false) may have wrapped.
function comparedGap(op String, dx ast.I128, dy ast.I128, exact bool) returns table.Option with ast.I128
	if not exact and not (dx.isZero() and dy.isZero()) 'wraps'
		return table.Option.none
	end 'wraps'
	return match consumes relationGap(op) 'gap'
		some(g) gives table.Option.some(g.sub(dx).add(dy))
		none gives table.Option.none
	end 'gap'
end 'comparedGap'

// comparedSpan is what 'x + dx op y' leaves of x's span cur, where y's side has the span other, if the sum is exact.
function comparedSpan(cur Span, op String, other Span, dx ast.I128, exact bool) returns table.Option with Span
	if not exact and not dx.isZero() 'wraps'
		return table.Option.none
	end 'wraps'
	return table.Option.some(narrowedSpan(cur, op: op, other: shiftedSpan(other, by: dx.neg())))
end 'comparedSpan'

// rulesOut is whether a span holds no value, so that no path reaches where it is known.
function rulesOut(s Span) returns bool
	return s.isEmpty() or (s.lo.isZero() and s.hi.isZero() and s.nonZero)
end 'rulesOut'

// relationGap is how far 'x op y' puts x above y, for a comparison that bounds x - y from below.
function relationGap(op String) returns table.Option with ast.I128
	if op == ">" 'above'
		return table.Option.some(ast.I128.one())
	end 'above'
	if op == ">=" or op == "==" 'atLeast'
		return table.Option.some(ast.I128.zero())
	end 'atLeast'
	return table.Option.none
end 'relationGap'

// emptyComparison is the comparison of a count with 0 that a test of whether the collection is empty proves when it
// gives truth.
function emptyComparison(truth bool) returns String
	return "==" if truth else "!="
end 'emptyComparison'

// deadState is the state no path reaches, which holds nothing: the first of the arena, which is never released.
let deadState = 0 as Count

// States makes the states of the functions being analysed. Every state of a function is dropped when the function has
// been walked, and a function nested in one, the body of a behaviour, drops its states before the one around it does, so
// the arena is a stack that release cuts back to a mark.
type States
	export var list as RangeStateList

	static function new() returns States
		var list = RangeStateList.create(0)
		list.push(RangeState.make(0 as Count, dead: true, kept: true))
		return States{list: list}
	end 'new'

	// mark is where the arena is, which release goes back to.
	function mark() returns Count
		return list.count()
	end 'mark'

	function release(mutates self, m Count)
		while list.count() > m 'pop'
			_ = list.pop()
		end 'pop'
	end 'release'

	// state is a new state, unkept and reachable, with room for n spans whose values the caller sets.
	function state(mutates self, n Count) returns Count
		let id = list.count()
		list.push(RangeState.make(n, dead: false, kept: false))
		return id
	end 'state'

	function copyOf(mutates self, s Count) returns Count
		var out = list[s].clone()
		out.kept = false
		let id = list.count()
		list.push(out)
		return id
	end 'copyOf'

	// joined is the state where the paths of a and b meet, which may be a or b itself. It knows what both know.
	function joined(mutates self, a Count, b Count) returns Count
		let aDead = list[a].dead
		let bDead = list[b].dead
		if aDead and bDead 'neither'
			return deadState
		end 'neither'
		if aDead 'onlyB'
			return b
		end 'onlyB'
		if bDead or a == b 'onlyA'
			return a
		end 'onlyA'
		let out = self.state(list[a].spans.count())
		for i in 0 upto list[a].spans.count() 'spans'
			let both = list[a].spans[i].unionWith(list[b].spans[i])
			list[out].spans[i] = both
		end 'spans'
		for i in 0 upto list[a].fields.count() 'fields'
			match consumes list[b].at(list[a].fields[i].at) 'other'
				some(other) then joinField(list, out: out, a: a, i: i, other: other)
				none then break
			end 'other'
		end 'fields'
		for i in 0 upto list[a].relations.count() 'relations'
			match consumes list[b].gap(list[a].relations[i].hi, lo: list[a].relations[i].lo) 'other'
				some(gap) then joinRelation(list, out: out, a: a, i: i, other: gap)
				none then break
			end 'other'
		end 'relations'
		return out
	end 'joined'
end 'States'

// joinField gives the joined state out the field i of a, with the span both a and the other state know of it.
function joinField(mutates list RangeStateList, out Count, a Count, i Count, other Span)
	let both = PlaceSpan.make(list[a].fields[i].at.clone(), span: list[a].fields[i].span.unionWith(other))
	list[out].fields.push(both)
end 'joinField'

// joinRelation gives the joined state out the relation i of a, with the gap both a and the other state know of it.
function joinRelation(mutates list RangeStateList, out Count, a Count, i Count, other ast.I128)
	let both = Relation.make(list[a].relations[i].hi.clone(), lo: list[a].relations[i].lo.clone(), gap: ast.minI128(list[a].relations[i].gap, b: other))
	list[out].relations.push(both)
end 'joinRelation'

typealias PlaceSpanList = Array with PlaceSpan

typealias RelationList = Array with Relation

typealias RangeStateList = Array with RangeState
