// checkBodies types the type declarations and the functions of the module, whose signatures declareModule gave. A
// declaration or a function that has an error is refused at its first, and the others are typed all the same. Type
// declarations come first: the calls that a field's default makes are reused by every record literal that leaves the
// field to it.
export function checkBodies(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, declared ast.FuncIDList, mutates errs diag.ErrorList)
	var isDeclared = BoolIntMap.new()
	for i in 0 upto declared.count() 'mark'
		isDeclared.insert(declared[i] as Count, value: true)
	end 'mark'
	for i in 0 upto p.modules[c.modIdx].decls.count() 'types'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many declarations")
		checkDeclBody(c, p: p, ms: ms, ord: ord, errs: errs)
	end 'types'
	checkExtensionConformances(c, p: p, ms: ms, errs: errs)
	for i in 0 upto p.modules[c.modIdx].decls.count() 'functions'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many declarations")
		checkFunctionsOf(c, p: p, ms: ms, ord: ord, isDeclared: isDeclared, errs: errs)
	end 'functions'
end 'checkBodies'

// checkDeclBody checks what a type, a union or an enum declares beyond its signatures.
function checkDeclBody(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ord ast.DeclOrdinal, mutates errs diag.ErrorList)
	let ref = ast.DeclRef.make(c.modID, ordinal: ord)
	match p.modules[c.modIdx].decls[ord as Count].clone() 'k'
		typeDecl(td) then checkRecordBody(c, p: p, ms: ms, td: td, tid: declTypeOf(p, ms: ms, ref: ref), errs: errs)
		unionDecl(ud) then checkNominalBody(c, p: p, ms: ms, id: ud.id, tid: declTypeOf(p, ms: ms, ref: ref), errs: errs)
		enumDecl(ed) then checkConformance(c, p: p, ms: ms, site: ed.id, nt: declTypeOf(p, ms: ms, ref: ref), errs: errs)
		funcDecl(_) then break
		constDecl(_) then break
		aliasDecl(_) then break
		interfaceDecl(_) then break
		extensionDecl(_) then break
	end 'k'
end 'checkDeclBody'

function checkRecordBody(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, td ast.TypeDecl, tid ast.TypeID, mutates errs diag.ErrorList)
	checkFieldDefaults(c, p: p, ms: ms, tid: tid, errs: errs)
	checkNominalBody(c, p: p, ms: ms, id: td.id, tid: tid, errs: errs)
end 'checkRecordBody'

// checkNominalBody checks a type or a union as a whole: that it does not contain itself, that a cown cannot reach itself
// through it, and that it implements what it says.
function checkNominalBody(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, id ast.NodeID, tid ast.TypeID, mutates errs diag.ErrorList)
	checkCycle(c, p: p, ms: ms, site: id, t: tid, errs: errs)
	checkCownCycle(c, p: p, ms: ms, site: id, t: tid, errs: errs)
	checkConformance(c, p: p, ms: ms, site: id, nt: tid, errs: errs)
end 'checkNominalBody'

// checkFunctionsOf types the functions that the declaration at ord has: itself, or its methods.
function checkFunctionsOf(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, ord ast.DeclOrdinal, isDeclared BoolIntMap, mutates errs diag.ErrorList)
	match p.modules[c.modIdx].decls[ord as Count].clone() 'k'
		funcDecl(f) then checkIfDeclared(c, p: p, ms: ms, f: f, isDeclared: isDeclared, errs: errs)
		typeDecl(td) then checkMethodBodies(c, p: p, ms: ms, methods: td.methods, isDeclared: isDeclared, errs: errs)
		unionDecl(ud) then checkMethodBodies(c, p: p, ms: ms, methods: ud.methods, isDeclared: isDeclared, errs: errs)
		enumDecl(ed) then checkMethodBodies(c, p: p, ms: ms, methods: ed.methods, isDeclared: isDeclared, errs: errs)
		constDecl(_) then break
		aliasDecl(_) then break
		interfaceDecl(_) then break
		extensionDecl(xd) then checkMethodBodies(c, p: p, ms: ms, methods: xd.methods, isDeclared: isDeclared, errs: errs)
	end 'k'
end 'checkFunctionsOf'

function checkMethodBodies(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, methods ast.FuncDeclList, isDeclared BoolIntMap, mutates errs diag.ErrorList)
	for i in 0 upto methods.count() 'each'
		checkIfDeclared(c, p: p, ms: ms, f: methods[i], isDeclared: isDeclared, errs: errs)
	end 'each'
end 'checkMethodBodies'

function checkIfDeclared(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, f ast.FuncDecl, isDeclared BoolIntMap, mutates errs diag.ErrorList)
	match consumes ast.nodeFunc(p, ms: ms, module: c.modID, node: f.id) 'entry'
		some(fid) then checkWhenDeclared(c, p: p, ms: ms, f: f, fid: fid, isDeclared: isDeclared, errs: errs)
		none then panic("the function '{f.name}' of module {c.modID} has no entry")
	end 'entry'
end 'checkIfDeclared'

function checkWhenDeclared(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, f ast.FuncDecl, fid ast.FuncID, isDeclared BoolIntMap, mutates errs diag.ErrorList)
	if isDeclared.has(fid as Count) 'declared'
		checkParamDefaults(c, p: p, ms: ms, f: f, fid: fid, errs: errs)
		checkFunction(c, p: p, ms: ms, f: f, fid: fid, errs: errs)
	end 'declared'
end 'checkWhenDeclared'

// checkFieldDefaults types the default of each field of a record as a value of the field's type.
function checkFieldDefaults(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, tid ast.TypeID, mutates errs diag.ErrorList)
	let selfTy = ast.selfType(ms.types, reads: p.types, declTy: tid)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: tid).fields.count() 'each'
		if not ast.typeEntry(ms.types, reads: p.types, t: tid).fields[i].hasDefault 'none'
			continue 'each'
		end 'none'
		let defaultExpr = ast.typeEntry(ms.types, reads: p.types, t: tid).fields[i].defaultExpr
		let fieldTy = ast.typeEntry(ms.types, reads: p.types, t: tid).fields[i].ty
		enterContext(c, p: p, ms: ms, f: ast.noFunc, owner: selfTy, calls: true)
		startUses(c, node: defaultExpr, inField: true)
		let t = checkExpecting(c, p: p, ms: ms, e: defaultExpr, want: fieldTy, errs: errs)
		if t != ast.noType 'typed'
			_ = coerce(c, p: p, ms: ms, node: defaultExpr, at: exprOffset(c, p: p, ms: ms, node: defaultExpr), src: t, target: fieldTy, wrong: Mismatch.expectedGot, errs: errs)
		end 'typed'
		finishUses(c)
	end 'each'
end 'checkFieldDefaults'

// checkParamDefaults types the default of each parameter of a function as a value of the parameter's type. A call that leaves
// the argument out evaluates the default in this module, in the scope of the declaration alone.
function checkParamDefaults(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, f ast.FuncDecl, fid ast.FuncID, mutates errs diag.ErrorList)
	for i in 0 upto f.params.count() 'each'
		let defaultExpr = f.params[i].defaultRef
		if defaultExpr == 0 'none'
			continue 'each'
		end 'none'
		let paramTy = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).paramTypes[i]
		enterContext(c, p: p, ms: ms, f: ast.noFunc, owner: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).ownerTy, calls: true)
		startUses(c, node: defaultExpr, inField: true)
		let t = checkExpecting(c, p: p, ms: ms, e: defaultExpr, want: paramTy, errs: errs)
		if t != ast.noType 'typed'
			_ = coerce(c, p: p, ms: ms, node: defaultExpr, at: exprOffset(c, p: p, ms: ms, node: defaultExpr), src: t, target: paramTy, wrong: Mismatch.expectedGot, errs: errs)
		end 'typed'
		finishUses(c)
	end 'each'
end 'checkParamDefaults'

// startUses makes the calls that need an instance of a generic be recorded on the function, or the field default, at node.
function startUses(mutates c Checker, node ast.NodeID, inField bool)
	c.usesNode = node
	c.usesField = inField
	c.hasUses = true
	c.recorded = ast.NodeIDList.create(0)
end 'startUses'

// finishUses keeps the calls recorded since startUses with the function or the field default they were made in.
function finishUses(mutates c Checker)
	c.hasUses = false
	if c.recorded.count() == 0 'none'
		return
	end 'none'
	if c.usesField 'field'
		c.typing.fieldUses.insert(c.usesNode as Count, value: c.recorded.clone())
		return
	end 'field'
	c.typing.funcUses.insert(c.usesNode as Count, value: c.recorded.clone())
end 'finishUses'

// recordUse notes a call that needs an instance of a generic, on the function or the field default being checked. Code
// after the live statements of its block is never lowered, so its calls make no instance.
function recordUse(mutates c Checker, call ast.NodeID)
	if not c.hasUses 'outside'
		panic("a call is checked outside a function or a field default")
	end 'outside'
	if c.dead 'dead'
		return
	end 'dead'
	noteCaller(c)
	c.recorded.push(call)
end 'recordUse'

// recordFieldUses records the calls that the default of a field made, for a record literal that leaves the field to it.
function recordFieldUses(mutates c Checker, defaultExpr ast.NodeID)
	if not c.hasUses and c.constName != "" 'constant'
		// A constant is built where it is read, so the default runs there, as the rest of the constant's literal does.
		return
	end 'constant'
	if not c.hasUses 'outside'
		panic("a call is checked outside a function or a field default")
	end 'outside'
	if c.dead 'dead'
		return
	end 'dead'
	match consumes c.typing.fieldUses.get(defaultExpr as Count) 'defaultUses'
		some(calls) then recordAll(c, calls: calls)
		none then break
	end 'defaultUses'
end 'recordFieldUses'

function recordAll(mutates c Checker, calls ast.NodeIDList)
	noteCaller(c)
	c.recorded.append(calls)
end 'recordAll'

// noteCaller lists the function being checked among those whose bodies need an instance of a generic, the first time one
// of its calls does.
function noteCaller(mutates c Checker)
	if c.rootFn != ast.noFunc and c.recorded.count() == 0 and not c.callersSeen.has(c.rootFn as Count) 'first'
		c.callersSeen.insert(c.rootFn as Count, value: true)
		c.callers.push(c.rootFn)
	end 'first'
end 'noteCaller'

// checkFunction types the body of a function or a method, whose parameters and receiver are locals of it.
function checkFunction(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, f ast.FuncDecl, fid ast.FuncID, mutates errs diag.ErrorList)
	enterContext(c, p: p, ms: ms, f: fid, owner: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).ownerTy, calls: true)
	startUses(c, node: f.id, inField: false)
	startWaits(c)
	let mark = errs.count()
	declareReceiverAndParams(c, p: p, ms: ms, f: f, fid: fid, errs: errs)
	if failedSince(errs, mark: mark) 'badParams'
		finishFunction(c, node: f.id)
		return
	end 'badParams'
	c.functionBody = f.body
	checkBlock(c, p: p, ms: ms, body: f.body, errs: errs)
	if not failedSince(errs, mark: mark) and lendsInSelf(c, p: p, ms: ms, f: f, fid: fid) 'lendsPlace'
		c.typing.lendsPlace.insert(f.id as Count, value: true)
	end 'lendsPlace'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).retTy != p.builtins.voidTy and not bodyTerminates(ms.tree(), body: f.body) and not endsInEndlessLoop(c, tree: ms.tree(), body: f.body) 'missingReturn'
		failAt(c, p: p, ms: ms, node: f.id, code: diag.errMissingReturn, msg: diag.missingReturn(f.name), errs: errs)
	end 'missingReturn'
	finishFunction(c, node: f.id)
end 'checkFunction'

// lendsInSelf is whether f, a method with a let receiver that returns a borrowed place, lends at every return a place that
// lies in self: a field of self at any depth, or what a call that lends by address (ast.lendsByAddress) gives of such a
// place. Such a method lends with the access its caller has to the receiver, at the place's address. It is decided once
// here, from the body's typing, which the verify of every module that calls it waits on. A receiver passed in registers (a
// scalar, a String), a String or a tuple lent (a view of bytes, a box of borrows), an element of a collection (a byte of a
// byte array and a record held in place have no word of their own), the contents of a frozen value, and a method that meets
// an interface's requirement (whose table calls it as the requirement lends) keep lending the value.
function lendsInSelf(c Checker, p ast.Project, ms ast.ModuleState, f ast.FuncDecl, fid ast.FuncID) returns bool
	let entry = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid)
	if entry.result != ast.ResultConv.resultBorrowed or not entry.hasReceiver or entry.selfConv != ast.Convention.convLet 'notLetLender'
		return false
	end 'notLetLender'
	if ast.typeKind(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: entry.ownerTy)) != ast.TypeKind.record 'notRecord'
		return false
	end 'notRecord'
	if ast.isStringType(ms.types, reads: p.types, t: entry.retTy) or ast.isTupleType(ms.types, reads: p.types, t: entry.retTy) or ast.typeKind(ms.types, reads: p.types, t: entry.retTy) == ast.TypeKind.builtinFrozen 'view'
		return false
	end 'view'
	if meetsRequirement(p, ms: ms, owner: entry.ownerTy, name: entry.name) 'witness'
		return false
	end 'witness'
	let from = ms.tree().startOf(f.id)
	let until = ms.tree().startOf(f.endRef)
	var lent = 0 as Count
	for n in 1 upto ms.tree().records.count() 'nodes'
		let id = try n as ast.NodeID otherwise panic("check: more nodes than a node id holds")
		let at = ms.tree().startOf(id)
		if at < from or at >= until or ms.tree().kindOf(id) != ast.NodeKind.returnStmt 'other'
			continue 'nodes'
		end 'other'
		let value = ast.returnStmtValue(ms.tree(), id: id)
		if value == 0 or not placeInSelf(c, p: p, ms: ms, e: value) 'notPlace'
			return false
		end 'notPlace'
		lent = try lent + 1 otherwise lent
	end 'nodes'
	return lent > 0
end 'lendsInSelf'

// placeInSelf is whether e is a place inside self that has a word of its own: a field of self or of such a place, or what a
// call that lends by address gives of one. Self itself is the caller's, passed as a value.
function placeInSelf(c Checker, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns bool
	var at = ast.through(ms.tree(), e: e)
	var steps = 0 as Count
	while true 'walk'
		if ast.typeKind(ms.types, reads: p.types, t: ast.nodeType(c.typing, node: at)) == ast.TypeKind.builtinFrozen 'frozen'
			return false
		end 'frozen'
		let k = ms.tree().kindOf(at)
		if k == ast.NodeKind.nameExpr 'name'
			return c.typing.names.has(at as Count) and nameInfoOf(c.typing, node: at).kind == ast.NameKind.nameSelfField
		end 'name'
		if k == ast.NodeKind.memberExpr 'member'
			if not c.typing.members.has(at as Count) or c.typing.members.get(at as Count).unwrap().kind != ast.MemberKind.memberField 'notField'
				return false
			end 'notField'
			at = ast.through(ms.tree(), e: ast.memberExprObj(ms.tree(), id: at))
			steps = try steps + 1 otherwise steps
		end 'member' else if k == ast.NodeKind.selfExpr 'self'
			return steps > 0
		end 'self' else if k == ast.NodeKind.callExpr and c.typing.calls.has(at as Count) 'call'
			let info = c.typing.calls.get(at as Count).unwrap()
			if info.kind == ast.CallKind.callBound or not ast.lendsByAddress(p, typing: c.typing, module: c.modID, ft: ms.funcs, funcReads: p.funcs, f: info.fn) 'value'
				return false
			end 'value'
			let receiver = ast.callReceiver(ms.tree(), e: at, kind: info.kind)
			if receiver == 0 'static'
				return false
			end 'static'
			at = ast.through(ms.tree(), e: receiver)
			steps = try steps + 1 otherwise steps
		end 'call' else 'other'
			return false
		end 'other'
	end 'walk'
	return false
end 'placeInSelf'

// meetsRequirement is whether a method called name of the type owner meets a requirement of an interface the type
// implements, whose table calls it as the requirement lends.
function meetsRequirement(p ast.Project, ms ast.ModuleState, owner ast.TypeID, name String) returns bool
	let origin = ast.originOf(ms.types, reads: p.types, t: owner)
	let conforms = ast.typeEntry(ms.types, reads: p.types, t: origin).conforms.clone()
	for i in 0 upto conforms.count() 'interfaces'
		let reqs = ast.requirementsOf(ms.types, reads: p.types, iface: conforms[i])
		for r in 0 upto reqs.count() 'requirements'
			if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: reqs[r].sig).name == name 'met'
				return true
			end 'met'
		end 'requirements'
	end 'interfaces'
	return false
end 'meetsRequirement'

// finishFunction keeps what the check of a function recorded with the function.
function finishFunction(mutates c Checker, node ast.NodeID)
	finishUses(c)
	finishWaits(c)
	if c.fnLocals.count() > 0 'locals'
		c.typing.funcLocals.insert(node as Count, value: c.fnLocals.clone())
	end 'locals'
end 'finishFunction'

function declareReceiverAndParams(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, f ast.FuncDecl, fid ast.FuncID, mutates errs diag.ErrorList)
	var index = 0 as Count
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).hasReceiver 'receiver'
		var receiver = ast.LocalEntry.make("self", ty: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).ownerTy, isVar: false, isParam: true, conv: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).selfConv, definedAt: f.id)
		receiver.isSelf = true
		// A destructor owns its receiver and ends it, so it may change it first: no one else holds it.
		receiver.isVar = receiver.conv == ast.Convention.convDestructs
		receiver.paramIndex = index
		let id = c.typing.allocLocal(receiver)
		c.fnLocals.push(id)
		ast.setReceiverLocal(ms, f: fid, l: id)
		let top = try c.scopes.count() - 1 otherwise panic("a receiver is declared outside every scope")
		c.scopes[top].insert(ast.receiverName, value: id)
		index = 1
	end 'receiver'
	for i in 0 upto f.params.count() 'params'
		if f.params[i].name != "_" 'named'
			var entry = ast.LocalEntry.make(f.params[i].name.clone(), ty: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).paramTypes[i], isVar: false, isParam: true, conv: ast.parseConvention(f.params[i].convention), definedAt: f.params[i].id)
			entry.paramIndex = index
			let id = bindLocal(c, p: p, ms: ms, entry: entry, off: offsetOf(c, p: p, ms: ms, node: f.params[i].id), errs: errs)
			if id == ast.noLocal 'failed'
				return
			end 'failed'
			ast.pushParamLocal(ms, f: fid, l: id)
		end 'named' else 'anonymous'
			ast.pushParamLocal(ms, f: fid, l: ast.noLocal)
		end 'anonymous'
		index = try index + 1 otherwise index
	end 'params'
end 'declareReceiverAndParams'
