// An extension adds methods, and conformances, to a type that another declaration names. They are declarations of the module
// that writes the extension, filed under the extended type in that module (ast/extensions.maxon): the declare stage never
// writes into another module's types.

// declaredExtendedType is the type of the declaration ref names, which an extension may extend when it is a type, an enum,
// a union or an interface.
function declaredExtendedType(c Checker, p ast.Project, ref ast.DeclRef, name String, off diag.U32, mutates errs diag.ErrorList) returns ast.TypeID
	match ast.declKindOf(p, ref: ref) 'k'
		typeDecl then return declTypeOf(p, ref: ref)
		enumDecl then return declTypeOf(p, ref: ref)
		unionDecl then return declTypeOf(p, ref: ref)
		aliasDecl then checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: "Unsupported: `extension {name}` — '{name}' is a typealias, which declares no methods of its own; extend the `type`, `enum`, `union`, `interface` or primitive it names", errs: errs)
		interfaceDecl then return declTypeOf(p, ref: ref)
		funcDecl then panic("the extension of {name} names a function")
		constDecl then panic("the extension of {name} names a constant")
		extensionDecl then panic("the extension of {name} names an extension")
	end 'k'
	return ast.noType
end 'declaredExtendedType'

// extendedType is the type an extension extends, or none after it reported why it extends nothing.
function extendedType(mutates c Checker, mutates p ast.Project, xd ast.ExtensionDecl, mutates errs diag.ErrorList) returns ast.TypeID
	if xd.isInt 'integer'
		return p.builtins.anon64Ty
	end 'integer'
	let name = ast.typeRefName(p.modules[c.modIdx].tree, id: xd.target)
	let off = offsetOf(c, p: p, node: xd.target)
	match consumes p.resolutions[c.modIdx].decls.get(xd.target as Count) 'bound'
		some(ref) then return declaredExtendedType(c, p: p, ref: ref, name: name, off: off, errs: errs)
		none then _ = 0
	end 'bound'
	let unqualified = p.modules[c.modIdx].tree.listLen(ast.typeRefQualifierRef(p.modules[c.modIdx].tree, id: xd.target)) == 0
	if unqualified and name == "bool" 'boolean'
		return p.builtins.boolTy
	end 'boolean'
	if unqualified and name == "String" 'string'
		return p.builtins.stringTy
	end 'string'
	failUnknownType(c, p: p, tr: xd.target, errs: errs)
	return ast.noType
end 'extendedType'

// bindExtensionParams makes the type parameters the extension's code names the parameters of the extended type.
function bindExtensionParams(mutates c Checker, mutates p ast.Project, xd ast.ExtensionDecl, nt ast.TypeID)
	match p.resolutions[c.modIdx].extParams.get(xd.id as Count) 'first'
		some(first) then bindParamsFrom(c, p: p, first: first, nt: nt)
		none then _ = 0
	end 'first'
end 'bindExtensionParams'

function bindParamsFrom(mutates c Checker, mutates p ast.Project, first Count, nt ast.TypeID)
	for i in 0 upto p.types.entries[nt as Count].typeParams.count() 'params'
		let slot = try first + i otherwise panic("too many type parameters")
		let node = p.resolutions[c.modIdx].typeParams[slot].id
		let name = p.resolutions[c.modIdx].typeParams[slot].name.clone()
		match paramNamed(p, owner: nt, name: name) 'shell'
			some(tid) then p.declTypes.insert(ast.typeParamKey(c.modID, node: node), value: tid)
			none then panic("the type parameter '{name}' of an extension is not one of '{p.types.entries[nt as Count].name}'")
		end 'shell'
	end 'params'
end 'bindParamsFrom'

// staticAllowed is whether an extension of the type may add a static function: only a type and a built-in generic type have
// them.
function staticAllowed(p ast.Project, nt ast.TypeID) returns bool
	let kind = p.types.entries[nt as Count].kind
	return kind == ast.TypeKind.record or kind.isBuiltin()
end 'staticAllowed'

// staticRefusal is why an extension of the type nt may not add a static function.
function staticRefusal(p ast.Project, nt ast.TypeID) returns String
	let kind = p.types.entries[nt as Count].kind
	if kind == ast.TypeKind.enumTy or kind == ast.TypeKind.unionTy 'cases'
		var word = unionWord
		if kind == ast.TypeKind.enumTy 'enum'
			word = enumWord
		end 'enum'
		return "Unsupported: a `static function` on `{word} {p.types.entries[nt as Count].name}` (an INSTANCE method is supported — a static one has no receiver to name the {word} through, and no `enum`/`union` in the corpus declares one)"
	end 'cases'
	return "a static function belongs in a 'type'"
end 'staticRefusal'

// addExtensionMethod declares a method that an extension adds to the type nt, filed under key. The extension's 'where'
// is the method's, before its own: the method is one of the instances whose type arguments meet it.
function addExtensionMethod(mutates c Checker, mutates p ast.Project, xd ast.ExtensionDecl, consumes method ast.FuncDecl, nt ast.TypeID, key ast.TypeID, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	var m = method
	var bounds = xd.whereList.clone()
	bounds.append(m.whereList)
	m.whereList = bounds
	let off = offsetOf(c, p: p, node: m.id)
	if m.isStatic and not staticAllowed(p, nt: nt) 'static'
		checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: staticRefusal(p, nt: nt), errs: errs)
		return
	end 'static'
	if m.receiver == ast.Convention.convDestructs.keyword() 'destructor'
		checkFail(c.modID, off: off, code: diag.errUnsupportedFeature, msg: "a destructor belongs in the body of its type, not in an extension", errs: errs)
		return
	end 'destructor'
	if m.name == cloneMethod 'clone'
		checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: "'{cloneMethod}' is built in for every type; name the method something else", errs: errs)
		return
	end 'clone'
	if ast.methodIn(p.modules[c.modIdx], owner: key, name: m.name) != ast.noFunc 'dup'
		checkFail(c.modID, off: off, code: diag.errDuplicateDefinition, msg: diag.duplicateMethod(m.name, typeName: ast.typeName(p.types, t: key)), errs: errs)
		return
	end 'dup'
	let fid = newFuncEntry(c, p: p, f: m, ownerTy: nt, ref: ast.DeclRef.make(c.modID, ordinal: 0 as ast.DeclOrdinal))
	if p.types.entries[key as Count].kind == ast.TypeKind.interfaceTy 'ofInterface'
		p.funcs.entries[fid as Count].extendedIface = key
	end 'ofInterface'
	p.modules[c.modIdx].extMethods.push(ast.ExtMethod.make(key, name: m.name.clone(), func: fid))
	addFunction(c, p: p, f: m, fid: fid, nt: nt, declared: declared, errs: errs)
	var conditional = 0 as Count
	for i in 0 upto xd.whereList.count() 'conditions'
		conditional = try conditional + p.modules[c.modIdx].tree.listLen(xd.whereList[i].bounds) otherwise panic("too many bounds")
	end 'conditions'
	p.funcs.entries[fid as Count].conditionalBounds = conditional
end 'addExtensionMethod'

// declareExtension declares the methods and the conformances an extension adds, under the key of the type it extends.
function declareExtension(mutates c Checker, mutates p ast.Project, xd ast.ExtensionDecl, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	let mark = errs.count()
	let nt = extendedType(c, p: p, xd: xd, errs: errs)
	if failedSince(errs, mark: mark) 'failed'
		return
	end 'failed'
	bindExtensionParams(c, p: p, xd: xd, nt: nt)
	if p.types.entries[nt as Count].kind == ast.TypeKind.interfaceTy 'ofInterface'
		declareInterfaceExtension(c, p: p, xd: xd, iface: nt, declared: declared, errs: errs)
		return
	end 'ofInterface'
	let key = ast.extensionKey(p, t: nt).unwrap()
	let interfaces = conformedInterfaces(c, p: p, interfaces: xd.conforms, capabilities: false, errs: errs)
	for i in 0 upto interfaces.count() 'conforms'
		p.modules[c.modIdx].extConforms.push(ast.ExtConform.make(key, iface: interfaces[i], site: xd.id))
	end 'conforms'
	if failedSince(errs, mark: mark) 'badConforms'
		return
	end 'badConforms'
	for i in 0 upto xd.methods.count() 'methods'
		addExtensionMethod(c, p: p, xd: xd, method: xd.methods[i].clone(), nt: nt, key: key, declared: declared, errs: errs)
	end 'methods'
end 'declareExtension'

// declareInterfaceExtension declares the methods that an extension adds to every type that implements the interface iface.
// As in Hylo, each is generic over that type, a parameter 'Self' of the extension's own bounded by the interface, and over
// the interface's associated types, and its body is checked once against the bound. It is no requirement: a call reaches
// it where the code knows no method of that name of the type.
function declareInterfaceExtension(mutates c Checker, mutates p ast.Project, xd ast.ExtensionDecl, iface ast.TypeID, mutates declared ast.FuncIDList, mutates errs diag.ErrorList)
	let name = p.types.entries[iface as Count].name.clone()
	if p.modules[c.modIdx].tree.listLen(xd.conforms) > 0 'conforms'
		checkFail(c.modID, off: offsetOf(c, p: p, node: xd.id), code: diag.errUnsupportedFeature, msg: "Unsupported: `extension {name} implements ...` — an extension of an interface adds methods to the types that implement it and declares no conformance; let '{name}' extend the other interface, or say `implements` on each type", errs: errs)
		return
	end 'conforms'
	let selfParam = ast.allocType(p.types, e: ast.TypeEntry.make(ast.TypeKind.typeParam, name: "Self"))
	let bound = ast.selfType(p.types, declTy: iface)
	p.types.entries[selfParam as Count].bounds.push(ast.ParamBound.make(selfParam, ifaceTy: bound))
	for i in 0 upto xd.methods.count() 'methods'
		addExtensionMethod(c, p: p, xd: xd, method: xd.methods[i].clone(), nt: selfParam, key: iface, declared: declared, errs: errs)
	end 'methods'
end 'declareInterfaceExtension'

// checkExtensionConformances checks each interface the module's extensions say a type implements against the type's methods,
// which are the type's own and those that extensions add, and refuses one that another declaration the module sees says
// too: a type has one conformance to an interface wherever it is used.
export function checkExtensionConformances(mutates c Checker, mutates p ast.Project, mutates errs diag.ErrorList)
	for i in 0 upto p.modules[c.modIdx].extConforms.count() 'each'
		let entry = p.modules[c.modIdx].extConforms[i].clone()
		let mark = errs.count()
		match consumes ast.conformanceSource(p, from: c.modID, t: entry.owner, iface: entry.iface) 'source'
			ambiguous(first, second) then failAmbiguousConformance(c, p: p, off: offsetOf(c, p: p, node: entry.site), typeName: ast.typeName(p.types, t: entry.owner), ifaceName: spelled(c, p: p, iface: entry.iface), first: first, second: second, errs: errs)
			found(_) then _ = 0
			absent then panic("the conformance of an extension of {ast.typeName(p.types, t: entry.owner)} is not seen from its own module")
		end 'source'
		if failedSince(errs, mark: mark) 'ambiguous'
			continue 'each'
		end 'ambiguous'
		if not requireOnceInModule(c, p: p, index: i, errs: errs) 'twice'
			continue 'each'
		end 'twice'
		var missing = ast.StringList.create(0)
		var wrong = ast.StringList.create(0)
		checkInterface(c, p: p, site: entry.site, nt: entry.owner, iface: entry.iface, missing: missing, wrong: wrong, errs: errs)
		failIncomplete(c, p: p, site: entry.site, typeName: ast.typeName(p.types, t: entry.owner), missing: missing, wrong: wrong, errs: errs)
	end 'each'
end 'checkExtensionConformances'

// requireOnceInModule refuses the index-th conformance that the module's extensions declare where an earlier one of them
// says the same: one of the type to the same interface, or to one that this one extends or that extends it, which would
// give the type two sets of methods for one interface.
function requireOnceInModule(mutates c Checker, mutates p ast.Project, index Count, mutates errs diag.ErrorList) returns bool
	let entry = p.modules[c.modIdx].extConforms[index].clone()
	for j in 0 upto index 'earlier'
		let other = p.modules[c.modIdx].extConforms[j].clone()
		if other.owner == entry.owner and (ast.extendsInterface(p.types, have: other.iface, want: entry.iface) or ast.extendsInterface(p.types, have: entry.iface, want: other.iface)) 'same'
			let typeName = ast.typeName(p.types, t: entry.owner)
			checkFail(c.modID, off: offsetOf(c, p: p, node: entry.site), code: diag.errAmbiguousConformance, msg: "'{typeName}' implements {spelled(c, p: p, iface: entry.iface)} twice in {ast.describeModule(p, modID: c.modID)}: by this extension and by an earlier one, which already says '{typeName}' implements {spelled(c, p: p, iface: other.iface)}; remove one of them", errs: errs)
			return false
		end 'same'
	end 'earlier'
	return true
end 'requireOnceInModule'

// verifyExtensions refuses a method that an extension adds under the name of one the type's own body declares. The type may
// be declared in another module, so this waits for the verify stage, when its methods are declared.
export function verifyExtensions(mutates c Checker, mutates p ast.Project, mutates errs diag.ErrorList)
	for i in 0 upto p.modules[c.modIdx].extMethods.count() 'each'
		let entry = p.modules[c.modIdx].extMethods[i].clone()
		if bodyDeclares(p, owner: entry.owner, name: entry.name) 'dup'
			checkFail(c.modID, off: offsetOf(c, p: p, node: p.funcs.entries[entry.func as Count].nodeID), code: diag.errDuplicateDefinition, msg: diag.duplicateMethod(entry.name, typeName: ast.typeName(p.types, t: entry.owner)), errs: errs)
		end 'dup'
	end 'each'
end 'verifyExtensions'

// bodyDeclares is whether the declaration of the type owner has a method of that name of its own.
function bodyDeclares(p ast.Project, owner ast.TypeID, name String) returns bool
	if owner == p.builtins.stringTy 'string'
		return stringMethodNamed(p, name: name) != ast.noFunc
	end 'string'
	return p.types.entries[owner as Count].findMethod(name).isSome()
end 'bodyDeclares'
