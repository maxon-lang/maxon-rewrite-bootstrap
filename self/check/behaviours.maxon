// What the behaviours of the language need from the bodies check: the 'when' statement, which checks its body as a
// function of its own that captures the variables around it; the checks that 'freeze', 'share' and 'thaw' make of their
// argument; the destructor that a cown ends its content with; and the refusal of a type that can reach itself through a
// cown.

// useLocal is the variable that a name stands for, for code that uses it. A variable of the enclosing function is
// captured: the behaviour's body gets a parameter of its own that holds the value. It gives none after reporting why a
// variable cannot be captured.
function useLocal(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, use ast.NodeID, name String, mutates errs diag.ErrorList) returns ast.LocalID
	let own = lookupScopes(c.scopes, name: name)
	if own != ast.noLocal 'own'
		return own
	end 'own'
	if not c.inBehaviour and not c.inClosure 'plain'
		return ast.noLocal
	end 'plain'
	let level = try c.outers.count() - 1 otherwise panic("a behaviour is checked with no function around it")
	let behaviour = c.activeBehIdx
	return captureFrom(c, p: p, ms: ms, behaviour: behaviour, level: level, use: use, name: name, errs: errs)
end 'useLocal'

// captureFrom finds the name in the function that encloses the behaviour b, which may itself be the body of a behaviour
// that captures it from the one around it, and captures it into b.
function captureFrom(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, behaviour Count, level Count, use ast.NodeID, name String, mutates errs diag.ErrorList) returns ast.LocalID
	var outer = lookupScopes(c.outers[level].scopes, name: name)
	if outer == ast.noLocal and c.outers[level].hasBehaviour 'enclosing'
		let enclosingLevel = try level - 1 otherwise panic("the outermost function is the body of a behaviour")
		let enclosingBehaviour = c.outers[level].behIdx
		outer = captureFrom(c, p: p, ms: ms, behaviour: enclosingBehaviour, level: enclosingLevel, use: use, name: name, errs: errs)
	end 'enclosing'
	if outer == ast.noLocal 'absent'
		return ast.noLocal
	end 'absent'
	for i in 0 upto c.bFrames[behaviour].capturedOuter.count() 'taken'
		if c.bFrames[behaviour].capturedOuter[i] == outer 'again'
			return c.bFrames[behaviour].capturedInner[i]
		end 'again'
	end 'taken'
	if not c.bFrames[behaviour].isClosure and not requireCapturable(c, p: p, ms: ms, use: use, outer: outer, errs: errs) 'refused'
		return ast.noLocal
	end 'refused'
	if c.bFrames[behaviour].isClosure and ast.holdsReply(ms.types, reads: p.types, t: c.typing.locals[outer as Count].ty) 'reply'
		refuseReplyCapture(c, p: p, ms: ms, node: use, name: name, errs: errs)
		return ast.noLocal
	end 'reply'
	let ref = ms.tree().captureRef(use, depth: level)
	c.typing.names.insert(ref as Count, value: ast.NameInfo.localName(outer))
	return captureLocal(c, p: p, ms: ms, behaviour: behaviour, outer: outer, ref: ref, use: use)
end 'captureFrom'

// captureLocal gives the body b a local of its own for the variable outer of the function around it, which ref names
// there. A behaviour takes it as a parameter that it owns. A closure reads it from itself each time it runs, and never
// copies it on its own: a scalar is a value, one that owns its value moves it into the closure, and one that borrows it
// is borrowed by the closure, which then cannot outlive the borrow. Each is a let borrow in the body. A mutating closure
// borrows a mutable variable to change it instead: the closure holds its address, and its 'self' the receiver itself,
// which a method cannot replace. What a mutating closure owns, it changes in place: the value lives in the closure, so
// each call sees the writes of the one before.
function captureLocal(mutates c Checker, p ast.Project, ms ast.ModuleState, behaviour Count, outer ast.LocalID, ref ast.NodeID, use ast.NodeID) returns ast.LocalID
	let source = c.typing.locals[outer as Count].clone()
	ast.setNodeType(c.typing, node: ref, ty: source.ty)
	var conv = ast.Convention.convConsumes
	var inner = ast.LocalEntry.make(source.name.clone(), ty: source.ty, isVar: false, isParam: true, conv: conv, definedAt: use)
	if c.bFrames[behaviour].isClosure 'closure'
		inner.conv = ast.Convention.convLet
		inner.isCapture = true
		inner.paramIndex = c.bFrames[behaviour].captures.count()
		if c.bFrames[behaviour].mutatesCaptures and isMutableLocal(source) 'mutable'
			conv = ast.Convention.convMutates
			inner.conv = ast.Convention.convMutates
			inner.isSelf = source.isSelf
			if not source.isSelf 'byAddress'
				inner.captureConv = ast.Convention.convMutates
			end 'byAddress'
		end 'mutable' else if ast.isManagedType(ms.types, reads: p.types, t: source.ty) and borrowsValue(source) 'borrowed'
			conv = ast.Convention.convLet
		end 'borrowed' else if c.bFrames[behaviour].mutatesCaptures 'owned'
			inner.conv = ast.Convention.convMutates
			inner.captureConv = ast.Convention.convConsumes
		end 'owned'
	end 'closure' else 'behaviour'
		inner.paramIndex = try c.bFrames[behaviour].accesses.count() + c.bFrames[behaviour].captures.count() otherwise panic("too many parameters in a behaviour")
	end 'behaviour'
	let innerLocal = c.typing.allocLocal(inner)
	c.bFrames[behaviour].captures.push(ast.Capture.make(source.name.clone(), refNode: ref, outerLocal: outer, innerLocal: innerLocal, conv: conv))
	c.bFrames[behaviour].capturedOuter.push(outer)
	c.bFrames[behaviour].capturedInner.push(innerLocal)
	return innerLocal
end 'captureLocal'

// requireCapturable refuses a variable that a behaviour cannot take. The behaviour runs later and in another thread, so
// what it takes must be a value of its own: a scalar is copied, and an owner gives its whole value away. A borrow ends
// when its call or match does, long before the behaviour runs.
function requireCapturable(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, use ast.NodeID, outer ast.LocalID, mutates errs diag.ErrorList) returns bool
	let source = c.typing.locals[outer as Count].clone()
	if not ast.isManagedType(ms.types, reads: p.types, t: source.ty) or not borrowsValue(source) 'owned'
		return requireCrossing(c, p: p, ms: ms, use: use, name: source.name, t: source.ty, errs: errs)
	end 'owned'
	var what = "a let or 'mutates' parameter"
	if source.projected and isForVariable(ms.tree(), l: source) 'element'
		what = "the variable of a loop over a collection"
	end 'element' else if isLentLet(ms.tree(), l: source) 'lent'
		what = "a let or a var bound to what a call lends, such as a view of a String"
	end 'lent' else if source.projected 'projected'
		what = "a match binding"
	end 'projected' else if source.isSelf 'receiver'
		what = "the receiver"
	end 'receiver' else if source.isParam and source.conv == ast.Convention.convSets 'sets'
		what = "a 'sets' parameter"
	end 'sets' else if source.isParam and source.conv == ast.Convention.convMutates and isAccess(c, local: outer) 'access'
		what = "the access that a behaviour has to a cown's value, for as long as it runs"
	end 'access'
	var fix = ""
	if ast.isSharedType(ms.types, reads: p.types, t: source.ty) 'shared'
		fix = "take an owner of it first: 'let own = share({source.name})', and use 'own' in the behaviour"
	end 'shared' else 'copy'
		fix = copyAdviceText(c, p: p, ms: ms, t: source.ty, ifCopyable: "give the behaviour a copy: 'let own = {source.name}.clone()' before the 'when', and use 'own'", otherwiseText: "pass what the behaviour needs through a cown")
	end 'copy'
	failAt(c, p: p, ms: ms, node: use, code: diag.errBehaviourBorrow, msg: "'{source.name}' is {what}, so it only borrows its value, and a behaviour runs later in another thread and cannot keep a borrow; {fix}", errs: errs)
	return false
end 'requireCapturable'

// requireCrossing refuses a value a behaviour takes that cannot cross to the thread that runs it, by the rule a message's
// arguments follow (ast.unsendable). A value of a type that mentions a type parameter is judged at each instance of the
// generic code, which the behaviour's statement is recorded for.
function requireCrossing(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, use ast.NodeID, name String, t ast.TypeID, mutates errs diag.ErrorList) returns bool
	if t == ast.noType 'untyped'
		// The variable's declaration failed, and was refused there.
		return true
	end 'untyped'
	if ast.mentionsTypeParam(ms.types, reads: p.types, t: t) 'generic'
		return true
	end 'generic'
	let why = ast.unsendable(ms.types, reads: p.types, t: t)
	if why == "" 'crosses'
		return true
	end 'crosses'
	failAt(c, p: p, ms: ms, node: use, code: diag.errBehaviourBorrow, msg: ast.behaviourCrossingText(name, why: why), errs: errs)
	return false
end 'requireCrossing'

// borrowsValue is whether a local only borrows its value: a match binding, the variable of a loop over a collection, or
// a parameter that does not own what it is given.
function borrowsValue(source ast.LocalEntry) returns bool
	let owns = source.conv == ast.Convention.convConsumes or source.conv == ast.Convention.convDestructs
	return source.projected or (source.isParam and not owns)
end 'borrowsValue'

// isAccess is whether a local is the parameter that gives a behaviour access to the value of a cown.
function isAccess(c Checker, local ast.LocalID) returns bool
	for i in 0 upto c.bFrames.count() 'frames'
		for j in 0 upto c.bFrames[i].accesses.count() 'accesses'
			if c.bFrames[i].accesses[j] == local 'hit'
				return true
			end 'hit'
		end 'accesses'
	end 'frames'
	return false
end 'isAccess'

// refuseBehaviourSelf is the error for 'self', or a field of it, used inside a behaviour: the receiver is borrowed, and a
// field is a part of it. t is the type of what was named.
function refuseBehaviourSelf(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, what String, t ast.TypeID, mutates errs diag.ErrorList) returns ast.TypeID
	let advice = copyAdviceText(c, p: p, ms: ms, t: t, ifCopyable: "copy what it needs into a variable before the 'when': 'let own = ....clone()'", otherwiseText: "pass what the behaviour needs through a cown")
	checkFail(c.modID, off: off, code: diag.errBehaviourBorrow, msg: "{what} belongs to the receiver, which a method only borrows, and a behaviour runs later in another thread; {advice}", errs: errs)
	return ast.noType
end 'refuseBehaviourSelf'

// selfFieldInBehaviour is the type of the field of the enclosing method's record that a bare name stands for, if there is
// one, so that a behaviour naming it is told why it cannot.
function selfFieldInBehaviour(c Checker, p ast.Project, mutates ms ast.ModuleState, name String) returns table.Option with ast.TypeID
	let root = c.outers[0].fn
	if root == ast.noFunc or not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: root).hasReceiver 'notMethod'
		return table.Option.none
	end 'notMethod'
	var rt = ast.noType
	if ast.typeKind(ms.types, reads: p.types, t: c.owner) == ast.TypeKind.record 'record'
		rt = c.owner
	end 'record'
	if rt == ast.noType 'noRecord'
		return table.Option.none
	end 'noRecord'
	match consumes ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: rt)).findField(name) 'field'
		some(index) then return table.Option.some(ast.fieldType(ms.types, reads: p.types, owner: rt, index: index))
		none then return table.Option.none
	end 'field'
end 'selfFieldInBehaviour'

// enterBehaviour starts checking the body of a behaviour as a function of its own, whose first parameters give access to
// the values of the cowns it names. It is false when a name that gives access cannot be bound.
function enterBehaviour(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, stmt ast.NodeID, values ast.TypeIDList, mutates errs diag.ErrorList) returns bool
	var entry = ast.FuncEntry.make(ast.behaviourName(funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: c.fn), index: c.whens), visibility: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.fn).visibility.clone(), module: c.modID, nodeID: stmt)
	entry.bodyRef = ast.whenStmtBodyRef(ms.tree(), id: stmt)
	entry.retTy = p.builtins.voidTy
	let fid = ast.allocFunc(ms.funcs, module: c.modID, f: entry)
	c.whens = try c.whens + 1 otherwise panic("too many behaviours in one function")
	let bi = enterNested(c, fid: fid, closure: false)
	c.inBehaviour = true
	let namesRef = ast.whenStmtNamesRef(ms.tree(), id: stmt)
	for i in 0 upto values.count() 'accesses'
		let name = ms.tree().nameAt(ms.tree().listAt(namesRef, index: i))
		var access = ast.LocalEntry.make(name.clone(), ty: values[i], isVar: false, isParam: true, conv: ast.Convention.convMutates, definedAt: stmt)
		access.paramIndex = i
		let id = bindLocal(c, p: p, ms: ms, entry: access, off: offsetOf(c, p: p, ms: ms, node: stmt), errs: errs)
		if id == ast.noLocal 'unbound'
			return false
		end 'unbound'
		c.bFrames[bi].accesses.push(id)
	end 'accesses'
	return true
end 'enterBehaviour'

// enterNested starts checking the body fid of a behaviour or a closure as a function of its own, inside the one being
// checked, and gives the index of its frame.
function enterNested(mutates c Checker, fid ast.FuncID, closure bool) returns Count
	let scopes = exchange(c.scopes, value: ScopeList.create(0))
	let blocks = exchange(c.blocks, value: BlockFrameList.create(0))
	let locals = exchange(c.fnLocals, value: ast.LocalIDList.create(0))
	let tries = exchange(c.tries, value: TryFrameList.create(0))
	var level = OuterLevel.make(c.fn, scopes: scopes, blocks: blocks, nextSlot: c.nextSlot, whens: c.whens, hasBehaviour: c.inBehaviour or c.inClosure, behIdx: c.activeBehIdx, fnLocals: locals, tries: tries)
	level.closure = c.inClosure
	c.outers.push(level)
	var frame = BehaviourFrame.make(fid)
	frame.isClosure = closure
	c.bFrames.push(frame)
	let bi = try c.bFrames.count() - 1 otherwise panic("a body is entered without its frame")
	c.activeBehIdx = bi
	c.inBehaviour = false
	c.inClosure = closure
	c.fn = fid
	c.scopes.push(LocalScope.new())
	c.nextSlot = 0 as Count
	c.whens = 0 as Count
	return bi
end 'enterNested'

// leaveBehaviour finishes the function of a behaviour body: its parameters are the accesses, then what it captured.
function leaveBehaviour(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, stmt ast.NodeID)
	let frame = try c.bFrames.pop() otherwise panic("a behaviour ended that was never begun")
	for i in 0 upto frame.accesses.count() 'accesses'
		addBehaviourParam(c, p: p, ms: ms, fn: frame.fn, local: frame.accesses[i])
	end 'accesses'
	for i in 0 upto frame.capturedInner.count() 'captures'
		addBehaviourParam(c, p: p, ms: ms, fn: frame.fn, local: frame.capturedInner[i])
		c.fnLocals.push(frame.capturedInner[i])
	end 'captures'
	var info = ast.WhenInfo.new()
	info.fn = frame.fn
	info.captures = frame.captures.clone()
	c.typing.whens.insert(stmt as Count, value: info)
	for i in 0 upto frame.captures.count() 'generic'
		if ast.mentionsTypeParam(ms.types, reads: p.types, t: c.typing.locals[frame.captures[i].outerLocal as Count].ty) 'mentions'
			// Each instance judges what crosses at its own type arguments (ir.requireCrossings).
			recordUse(c, call: stmt)
			break 'generic'
		end 'mentions'
	end 'generic'
	if c.fnLocals.count() > 0 'locals'
		c.typing.funcLocals.insert(stmt as Count, value: c.fnLocals.clone())
	end 'locals'
	let outer = try c.outers.pop() otherwise panic("a behaviour ended that was never begun")
	restoreOuter(c, outer: outer)
end 'leaveBehaviour'

// restoreOuter goes back to checking the function around a behaviour's or a closure's body.
function restoreOuter(mutates c Checker, consumes outer OuterLevel)
	var o = outer
	c.fn = o.fn
	c.scopes = exchange(o.scopes, value: ScopeList.create(0))
	c.blocks = exchange(o.blocks, value: BlockFrameList.create(0))
	c.fnLocals = exchange(o.fnLocals, value: ast.LocalIDList.create(0))
	c.tries = exchange(o.tries, value: TryFrameList.create(0))
	c.nextSlot = o.nextSlot
	c.whens = o.whens
	c.inBehaviour = o.hasBehaviour and not o.closure
	c.inClosure = o.closure
	c.activeBehIdx = o.behIdx
end 'restoreOuter'

function addBehaviourParam(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, fn ast.FuncID, local ast.LocalID)
	let entry = c.typing.locals[local as Count].clone()
	ms.funcs.lists[ast.funcList(ms.funcs, f: fn)][ast.funcIndex(ms.funcs, f: fn)].params.push(ast.ParamSpec.make(entry.name.clone(), ty: entry.ty, conv: entry.conv))
	ms.funcs.lists[ast.funcList(ms.funcs, f: fn)][ast.funcIndex(ms.funcs, f: fn)].paramTypes.push(entry.ty)
	ast.pushParamLocal(ms, f: fn, l: local)
end 'addBehaviourParam'

// checkBehaviour types a behaviour: it names cowns, and its body runs once it has exclusive access to all of them, with
// the names after 'as' giving mutable access to their values.
function checkBehaviour(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, mutates errs diag.ErrorList)
	if not checksLibraryTier(c, p: p) 'outside'
		failAt(c, p: p, ms: ms, node: s, code: diag.errRawSurfaceOutsideLibrary, msg: "'when' written outside the library tiers: a behaviour over cowns is written only in a source file under stdlib/ or runtime/ — keep shared state in a service and send it messages", errs: errs)
		return
	end 'outside'
	let cownsRef = ast.whenStmtCownsRef(ms.tree(), id: s)
	let cownCount = ms.tree().listLen(cownsRef)
	let nameCount = ms.tree().listLen(ast.whenStmtNamesRef(ms.tree(), id: s))
	if cownCount != nameCount 'count'
		failAt(c, p: p, ms: ms, node: s, code: diag.errWhenCowns, msg: "the behaviour names {cownCount} cown(s) but gives {nameCount} name(s) to their values after 'as': one name for each", errs: errs)
		return
	end 'count'
	var values = ast.TypeIDList.create(0)
	for i in 0 upto cownCount 'cowns'
		let cown = ms.tree().listAt(cownsRef, index: i) as ast.NodeID
		let t = checkExpr(c, p: p, ms: ms, e: cown, errs: errs)
		if t == ast.noType 'failed'
			return
		end 'failed'
		let name = ast.nameExprName(ms.tree(), id: cown)
		if not typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.builtinCown) 'notCown'
			failAt(c, p: p, ms: ms, node: cown, code: diag.errWhenCowns, msg: "'{name}' is {describeType(p, ms: ms, t: t)}, and a behaviour names cown references: make one with 'cown(value)'", errs: errs)
			return
		end 'notCown'
		values.push(typeElemType(p, ms: ms, ownerTy: t))
		for j in 0 upto i 'earlier'
			if sameName(c, a: ms.tree().listAt(cownsRef, index: j) as ast.NodeID, b: cown) 'twice'
				failAt(c, p: p, ms: ms, node: cown, code: diag.errWhenSameCown, msg: "'{name}' is named twice by one behaviour, which would give it two mutable names for one value; name each cown once", errs: errs)
				return
			end 'twice'
		end 'earlier'
	end 'cowns'
	if enterBehaviour(c, p: p, ms: ms, stmt: s, values: values, errs: errs) 'entered'
		checkBlock(c, p: p, ms: ms, body: ast.whenStmtBodyRef(ms.tree(), id: s), errs: errs)
	end 'entered'
	leaveBehaviour(c, p: p, ms: ms, stmt: s)
end 'checkBehaviour'

// sameName is whether two cown operands are one variable or one field.
function sameName(c Checker, a ast.NodeID, b ast.NodeID) returns bool
	let x = nameInfoOf(c.typing, node: a)
	let y = nameInfoOf(c.typing, node: b)
	if x.kind != y.kind 'differ'
		return false
	end 'differ'
	if x.kind == ast.NameKind.nameLocal 'local'
		return x.local == y.local
	end 'local'
	return x.kind == ast.NameKind.nameSelfField and x.fieldIndex == y.fieldIndex
end 'sameName'

function describeType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	if isConstInt(p, ms: ms, t: t) 'integer'
		return "an integer"
	end 'integer'
	return "a {nameOfType(p, ms: ms, t: t)}"
end 'describeType'

// checkFreezeArgs refuses a value to freeze that is no managed value and so cannot be frozen.
function checkFreezeArgs(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let arg = soleArg(ordered)
	let t = argumentType(c, node: arg)
	if isConstInt(p, ms: ms, t: t) or (t != p.builtins.neverTy and t != p.builtins.voidTy and not ast.isManagedType(ms.types, reads: p.types, t: t)) 'plain'
		failAt(c, p: p, ms: ms, node: arg, code: diag.errFreezeScalar, msg: "'{nameOfType(p, ms: ms, t: t)}' is a plain value, which is immutable already and copied freely, so there is nothing to freeze: freeze a record, a union, a String or a collection", errs: errs)
		return
	end 'plain'
	requireShareable(c, p: p, ms: ms, call: call, arg: arg, frozen: true, errs: errs)
end 'checkFreezeArgs'

// requireShareable refuses the value given to freeze, when frozen is set, or to a cown, when it cannot cross between
// threads (ast.unsendable): a frozen value is read by every thread that holds it, and a cown's value by its behaviours,
// which run on any thread. A value of a type that mentions a type parameter is judged at each instance of the generic code
// (ir.requireShareable), which the call is recorded for.
function requireShareable(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, arg ast.NodeID, frozen bool, mutates errs diag.ErrorList)
	let t = argumentType(c, node: arg)
	if ast.mentionsTypeParam(ms.types, reads: p.types, t: t) 'generic'
		recordUse(c, call: call)
		return
	end 'generic'
	let why = ast.unsendable(ms.types, reads: p.types, t: t)
	if why != "" 'refused'
		failAt(c, p: p, ms: ms, node: arg, code: diag.errValueNotShareable, msg: ast.sharedCrossingText(nameOfType(p, ms: ms, t: t), why: why, frozen: frozen), errs: errs)
	end 'refused'
end 'requireShareable'

// checkShareArgs refuses a value to share that is neither kind of shared value, which the generic signature allows.
function checkShareArgs(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let arg = soleArg(ordered)
	let t = argumentType(c, node: arg)
	if not ast.isSharedType(ms.types, reads: p.types, t: t) 'owned'
		let advice = copyAdviceText(c, p: p, ms: ms, t: t, ifCopyable: "move it, or copy it with '.clone()'", otherwiseText: "move it")
		failAt(c, p: p, ms: ms, node: arg, code: diag.errShareTarget, msg: "share takes a frozen value or a cown reference, found {nameOfType(p, ms: ms, t: t)}; a value that is not shared has one owner, so {advice}", errs: errs)
	end 'owned'
end 'checkShareArgs'

// checkThawArgs refuses a value to thaw that is not frozen.
function checkThawArgs(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let arg = soleArg(ordered)
	let t = argumentType(c, node: arg)
	if not isFrozenType(p, ms: ms, t: t) 'owned'
		let advice = copyAdviceText(c, p: p, ms: ms, t: t, ifCopyable: "use '.clone()' for another one", otherwiseText: "move it")
		failAt(c, p: p, ms: ms, node: arg, code: diag.errShareTarget, msg: "thaw takes a frozen value, found {nameOfType(p, ms: ms, t: t)}; a value that is not frozen is already owned: {advice}", errs: errs)
	end 'owned'
end 'checkThawArgs'

// soleArg is the one argument of a sharing function, which binding the arguments to its signature has made sure of.
function soleArg(ordered ast.NodeIDList) returns ast.NodeID
	if ordered.count() != 1 'count'
		panic("check: a sharing function given {ordered.count()} arguments")
	end 'count'
	return ordered[0]
end 'soleArg'

function argumentType(c Checker, node ast.NodeID) returns ast.TypeID
	return c.typing.types.expect(node as Count, what: "argument")
end 'argumentType'

// cownCall types cown(x) and cown(x, dropWith: d). The content of the first is dropped with the last reference, so it
// must be Droppable. The content of the second is ended by its destructor d, which is a method name and no value, so the
// argument is taken out of the call before the ordinary arguments are checked.
function cownCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, mutates errs diag.ErrorList) returns ast.TypeID
	let argsRef = ast.callExprArgsRef(ms.tree(), id: call)
	var dropAt = 0 as Count
	var dropArg = 0 as ast.NodeID
	for i in 0 upto ms.tree().listLen(argsRef) 'args'
		let arg = ms.tree().listAt(argsRef, index: i) as ast.NodeID
		if ast.argLabel(ms.tree(), id: arg) == ast.dropWithLabel 'found'
			dropAt = i
			dropArg = arg
			break 'args'
		end 'found'
	end 'args'
	let newFn = p.builtins.cownNewFunc
	let newDropFn = p.builtins.cownNewDropWithFunc
	if dropAt == 0 'plain'
		let plain = callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callFunction, target: newFn, hasGiven: false, given: ast.TypeIDList.create(0), errs: errs)
		if plain != ast.noType 'typed'
			requireCownShareable(c, p: p, ms: ms, call: call, errs: errs)
		end 'typed'
		return plain
	end 'plain'
	c.hasOmitted = true
	c.omittedCall = call
	c.omittedArgIdx = dropAt
	let t = callFunction(c, p: p, ms: ms, call: call, kind: ast.CallKind.callFunction, target: newDropFn, hasGiven: false, given: ast.TypeIDList.create(0), errs: errs)
	c.hasOmitted = false
	if t != ast.noType 'typed'
		checkDropWith(c, p: p, ms: ms, call: call, arg: dropArg, errs: errs)
		requireCownShareable(c, p: p, ms: ms, call: call, errs: errs)
	end 'typed'
	return t
end 'cownCall'

// requireCownShareable refuses the value of a cown that cannot cross between threads, the content argument of the typed
// call.
function requireCownShareable(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, mutates errs diag.ErrorList)
	let content = match consumes c.typing.calls.get(call as Count) 'recorded'
		some(info) gives info.ordered[0]
		none panic("the cown at node {call} was typed without a record of what it calls")
	end 'recorded'
	requireShareable(c, p: p, ms: ms, call: call, arg: content, frozen: false, errs: errs)
end 'requireCownShareable'

// checkDropWith records the destructor named by the 'dropWith:' of a cown, which the call of the constructor leaves out of
// its arguments.
function checkDropWith(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, arg ast.NodeID, mutates errs diag.ErrorList)
	var info as ast.CallInfo
	match consumes c.typing.calls.get(call as Count) 'recorded'
		some(found) then info = found
		none then panic("the cown at node {call} was typed without a record of what it calls")
	end 'recorded'
	let destructor = dropWithCall(c, p: p, ms: ms, call: call, arg: arg, content: argumentType(c, node: info.ordered[0]), errs: errs)
	if destructor == ast.noFunc 'refused'
		return
	end 'refused'
	info.hasDrop = true
	info.dropFn = destructor
	c.typing.calls.insert(call as Count, value: info)
end 'checkDropWith'

// dropWithCall is the destructor that a cown of content ends it with, or none after it reported why there is none. Only
// content that is not Droppable has something to decide, and the destructor takes nothing else, because the cown has
// nothing else to give it.
function dropWithCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, arg ast.NodeID, content ast.TypeID, mutates errs diag.ErrorList) returns ast.FuncID
	let contentName = nameOfType(p, ms: ms, t: content)
	if not lacksCap(c, p: p, ms: ms, wantCopy: false, t: content).missing 'droppable'
		failAt(c, p: p, ms: ms, node: arg, code: diag.errCapabilityMisuse, msg: "'{contentName}' is Droppable, so the cown drops it with its last reference and there is nothing to decide: remove 'dropWith:'", errs: errs)
		return ast.noFunc
	end 'droppable'
	let value = ast.argValue(ms.tree(), id: arg)
	if ms.tree().kindOf(value) != ast.NodeKind.nameExpr 'notName'
		failAt(c, p: p, ms: ms, node: arg, code: diag.errCapabilityMisuse, msg: "'dropWith:' names a destructor of the content by its name alone, as 'dropWith: rollback'", errs: errs)
		return ast.noFunc
	end 'notName'
	if not typeIsNominal(ms.types, reads: p.types, t: content) 'parameter'
		failAt(c, p: p, ms: ms, node: arg, code: diag.errCapabilityMisuse, msg: "'{contentName}' is a type parameter and has no destructor to name: a value that is not Droppable cannot go into a cown in generic code; add the bound 'where {contentName} implements Droppable'", errs: errs)
		return ast.noFunc
	end 'parameter'
	let name = ast.nameExprName(ms.tree(), id: value).clone()
	let method = methodNamed(p, ms: ms, t: content, name: name)
	if method == ast.noFunc or not isNakedDestructor(p, ms: ms, method: method) 'notDestructor'
		failAt(c, p: p, ms: ms, node: arg, code: diag.errCapabilityMisuse, msg: "'{name}' is not a destructor of '{contentName}' that takes no other argument and returns nothing{dropWithCandidates(p, ms: ms, t: content)}", errs: errs)
		return ast.noFunc
	end 'notDestructor'
	if not requireVisible(c, p: p, ms: ms, node: arg, target: method, errs: errs) 'hidden'
		return ast.noFunc
	end 'hidden'
	queueMethodBounds(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: call), method: method, args: ast.typeEntry(ms.types, reads: p.types, t: content).typeArgs.clone())
	return method
end 'dropWithCall'

// isNakedDestructor is whether a method is a destructor that takes nothing else and returns nothing, which is all that a
// cown can call.
function isNakedDestructor(p ast.Project, ms ast.ModuleState, method ast.FuncID) returns bool
	return not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).isStatic and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).isDestructor and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).params.count() == 0 and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).retTy == p.builtins.voidTy
end 'isNakedDestructor'

// dropWithCandidates names the destructors that dropWith: may name, in declaration order, for the error that names another.
function dropWithCandidates(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	var names = ast.StringList.create(0)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).methods.count() 'methods'
		if isNakedDestructor(p, ms: ms, method: ast.typeEntry(ms.types, reads: p.types, t: orig).methods[i].func) 'candidate'
			names.push(ast.typeEntry(ms.types, reads: p.types, t: orig).methods[i].name.clone())
		end 'candidate'
	end 'methods'
	if names.count() == 0 'none'
		return ": '{nameOfType(p, ms: ms, t: t)}' has no such destructor; declare one, as 'function rollback(destructs self)'"
	end 'none'
	return ": name {ast.joinNames(names, sep: " or ")}"
end 'dropWithCandidates'

// checkCownCycle refuses a type that can reach itself through a cown. A cown owns a mutable value, and a behaviour can
// store a cown reference in it, so a type that holds a cown of a type that holds it again lets two cowns refer to each
// other, and counting never frees a cycle. Owned values and frozen values cannot form one: an owner is a tree, and a
// frozen value refers only to values frozen before it.
function checkCownCycle(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, site ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList)
	let own = ast.selfType(ms.types, reads: p.types, declTy: t)
	var path = ast.StringList.create(0)
	var visited = BoolIntMap.new()
	if not reachesThroughCown(p, ms: ms, from: own, target: own, via: false, services: false, path: path, visited: visited) 'acyclic'
		return
	end 'acyclic'
	failAt(c, p: p, ms: ms, node: site, code: diag.errCownCycle, msg: "type '{nameOfType(p, ms: ms, t: t)}' can reach itself through a cown (via {ast.joinNames(path, sep: " -> ")}), so cowns could refer to each other and counting would never free them; store a slot key, or a key into a map, instead of the reference", errs: errs)
end 'checkCownCycle'

// reachesThroughCown is whether a value of type from holds one of type target, with a cown on the way, or, where services
// says, a service's handle, which holds its service's state as a cown holds its value. via is whether the way so far
// already went through one.
function reachesThroughCown(p ast.Project, mutates ms ast.ModuleState, from ast.TypeID, target ast.TypeID, via bool, services bool, mutates path ast.StringList, mutates visited BoolIntMap) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: from)
	let orig = ast.originOf(ms.types, reads: p.types, t: from)
	let holder = nameOfType(p, ms: ms, t: from)
	if kind == ast.TypeKind.record 'record'
		for fi in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).fields.count() 'fields'
			let label = "{holder}.{ast.typeEntry(ms.types, reads: p.types, t: orig).fields[fi].name}"
			let held = ast.fieldType(ms.types, reads: p.types, owner: from, index: fi)
			if followHolding(p, ms: ms, label: label, held: held, isCown: false, target: target, via: via, services: services, path: path, visited: visited) 'found'
				return true
			end 'found'
		end 'fields'
		return false
	end 'record'
	if kind == ast.TypeKind.unionTy 'union'
		for ci in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() 'cases'
			let label = "{holder}.{ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].name}"
			for pi in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload.count() 'payload'
				let held = ast.payloadType(ms.types, reads: p.types, owner: from, caseIndex: ci, index: pi)
				if followHolding(p, ms: ms, label: label, held: held, isCown: false, target: target, via: via, services: services, path: path, visited: visited) 'found'
					return true
				end 'found'
			end 'payload'
		end 'cases'
		return false
	end 'union'
	if services and ast.isInterfaceHandle(ms.types, reads: p.types, t: from) and implementsHandled(p, ms: ms, t: target, handle: from) 'interfaceHandle'
		// An interface handle may hold a handle of any type that implements its interface, the target's among them.
		path.push(holder)
		return true
	end 'interfaceHandle'
	if kind.isBuiltin() and kind != ast.TypeKind.builtinSlotKey 'builtin'
		for ai in 0 upto ast.typeEntry(ms.types, reads: p.types, t: from).typeArgs.count() 'args'
			let held = ast.typeEntry(ms.types, reads: p.types, t: from).typeArgs[ai]
			if followHolding(p, ms: ms, label: holder, held: held, isCown: kind == ast.TypeKind.builtinCown or (services and kind == ast.TypeKind.builtinService), target: target, via: via, services: services, path: path, visited: visited) 'found'
				return true
			end 'found'
		end 'args'
	end 'builtin'
	return false
end 'reachesThroughCown'

// implementsHandled is whether the type t implements the interface of the interface handle handle, by a declaration its
// own module sees, so a handle of a service of t may be behind it.
function implementsHandled(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, handle ast.TypeID) returns bool
	if ast.typeKind(ms.types, reads: p.types, t: t) != ast.TypeKind.record 'notService'
		return false
	end 'notService'
	let iface = ast.serviceState(ms.types, reads: p.types, t: handle)
	return match consumes ast.conformanceSource(p, ms: ms, from: ast.declaringModuleIn(ms.types, reads: p.types, t: t), t: t, iface: iface) 'source'
		found(_) gives true
		ambiguous(_, _) gives true
		absent gives false
	end 'source'
end 'implementsHandled'

// followHolding follows one edge of the search: a field, a payload, an element, or what a frozen value or a cown holds. A
// handle holds nothing.
function followHolding(p ast.Project, mutates ms ast.ModuleState, label String, held ast.TypeID, isCown bool, target ast.TypeID, via bool, services bool, mutates path ast.StringList, mutates visited BoolIntMap) returns bool
	path.push(label.clone())
	let next = via or isCown
	if held == target and next 'found'
		return true
	end 'found'
	if not ast.hasTypeDepthOverflow(ms.types, reads: p.types, t: held, depth: 0 as Count) 'bounded'
		let key = (held as Count) * 2 + (1 if next else 0)
		if not visited.has(key) 'unseen'
			visited.insert(key, value: true)
			if reachesThroughCown(p, ms: ms, from: held, target: target, via: next, services: services, path: path, visited: visited) 'inside'
				return true
			end 'inside'
		end 'unseen'
	end 'bounded'
	_ = try path.pop() otherwise panic("an edge left that was never followed")
	return false
end 'followHolding'
