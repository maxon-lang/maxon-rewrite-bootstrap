// What a declaration owes the rest of the program, checked once its members are known: that a type does not contain
// itself, that it implements the interfaces it names, and that the type arguments of an instance meet the bounds of the
// parameters they stand for.

// checkCycle refuses a type or a union that contains itself, which would have no finite size.
function checkCycle(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, site ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList)
	let own = ast.selfType(ms.types, reads: p.types, declTy: t)
	var path = ast.StringList.create(0)
	var visited = BoolIntMap.new()
	var growing = false
	if not reaches(p, ms: ms, from: own, target: own, path: path, visited: visited, growing: growing) 'finite'
		return
	end 'finite'
	let name = ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: t)).name.clone()
	if growing 'growing'
		failAt(c, p: p, ms: ms, node: site, code: diag.errTypeCycle, msg: "type '{name}' has no finite size: via {path[0]} it contains itself with a larger type argument each time", errs: errs)
		return
	end 'growing'
	failAt(c, p: p, ms: ms, node: site, code: diag.errTypeCycle, msg: diag.typeReferenceCycle(name, path: "{name} → {ast.joinNames(path, sep: " → ")}"), errs: errs)
end 'checkCycle'

// reaches is whether a value of type from contains one of type target. A type that contains itself with a larger type
// argument each time never repeats, so it is found by how deeply its instances nest, and sets growing.
function reaches(p ast.Project, mutates ms ast.ModuleState, from ast.TypeID, target ast.TypeID, mutates path ast.StringList, mutates visited BoolIntMap, mutates growing bool) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: from)
	let orig = ast.originOf(ms.types, reads: p.types, t: from)
	if kind == ast.TypeKind.record 'record'
		for fi in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).fields.count() 'fields'
			let held = ast.fieldType(ms.types, reads: p.types, owner: from, index: fi)
			let edge = "{ast.typeEntry(ms.types, reads: p.types, t: orig).fields[fi].name}: {ast.typeName(ms.types, reads: p.types, t: held)}"
			if followEdge(p, ms: ms, edge: edge, held: held, target: target, path: path, visited: visited, growing: growing) 'found'
				return true
			end 'found'
		end 'fields'
	end 'record' else if kind == ast.TypeKind.unionTy 'union'
		for ci in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases.count() 'cases'
			for pi in 0 upto ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload.count() 'payload'
				let held = ast.payloadType(ms.types, reads: p.types, owner: from, caseIndex: ci, index: pi)
				let edge = "{ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].name}.{ast.typeEntry(ms.types, reads: p.types, t: orig).cases[ci].payload[pi].name}: {ast.typeName(ms.types, reads: p.types, t: held)}"
				if followEdge(p, ms: ms, edge: edge, held: held, target: target, path: path, visited: visited, growing: growing) 'found'
					return true
				end 'found'
			end 'payload'
		end 'cases'
	end 'union'
	return false
end 'reaches'

// followEdge follows one edge of the search for target: a field or a payload that holds the type held.
function followEdge(p ast.Project, mutates ms ast.ModuleState, edge String, held ast.TypeID, target ast.TypeID, mutates path ast.StringList, mutates visited BoolIntMap, mutates growing bool) returns bool
	path.push(edge.clone())
	if held == target 'found'
		return true
	end 'found'
	if ast.hasTypeDepthOverflow(ms.types, reads: p.types, t: held, depth: 0 as Count) 'deep'
		growing = true
		return true
	end 'deep'
	if not visited.has(held as Count) 'unseen'
		visited.insert(held as Count, value: true)
		if reaches(p, ms: ms, from: held, target: target, path: path, visited: visited, growing: growing) 'inside'
			return true
		end 'inside'
	end 'unseen'
	_ = try path.pop() otherwise panic("an edge left that was never followed")
	return false
end 'followEdge'

// checkConformance checks a declaration against each interface it says it implements: every method is there with the
// signature the interface gives, so a bound that the declaration meets is never wrong at an instance.
function checkConformance(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, site ast.NodeID, nt ast.TypeID, mutates errs diag.ErrorList)
	let orig = ast.originOf(ms.types, reads: p.types, t: nt)
	let conforms = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: orig).conforms)
	var lacks = Shortfall.new()
	for iface in conforms 'interfaces'
		let mark = errs.count()
		checkInterface(c, p: p, ms: ms, site: site, nt: nt, iface: iface, conditions: ast.ParamBoundList.create(0), lacks: lacks, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return
		end 'failed'
	end 'interfaces'
	failIncomplete(c, p: p, ms: ms, site: site, typeName: ast.typeEntry(ms.types, reads: p.types, t: orig).name.clone(), lacks: lacks, errs: errs)
end 'checkConformance'

// Shortfall is what a type lacks of the interfaces it implements: the methods it does not have, those whose signature
// differs, and the edits that would mend the differences, of which unfixed have none.
type Shortfall
	var missing as ast.StringList
	var wrong as ast.StringList
	var edits as diag.FixEdits
	var unfixed as Count
	var kind as String

	static function new() returns Shortfall
		return Shortfall{missing: ast.StringList.create(0), wrong: ast.StringList.create(0), edits: diag.FixEdits.create(0), unfixed: 0 as Count, kind: ""}
	end 'new'

	// addWrong records a method whose signature differs, and the fix that mends it, if one does: a requirement that two
	// interfaces of the type share, one extending the other, is recorded once.
	function addWrong(mutates self, consumes text String, fix diag.Fix)
		for i in 0 upto wrong.count() 'known'
			if wrong[i] == text 'again'
				return
			end 'again'
		end 'known'
		wrong.push(text)
		if not fix.isSome() 'none'
			unfixed = try unfixed + 1 otherwise panic("generics: more methods than memory")
			return
		end 'none'
		if kind == "" 'first'
			kind = fix.kind.clone()
		end 'first'
		for i in 0 upto fix.edits.count() 'edits'
			edits.push(fix.edits[i].clone())
		end 'edits'
	end 'addWrong'
end 'Shortfall'

// failIncomplete files the one error for a type that implements an interface incompletely: the methods it lacks, or else the
// methods whose signature differs, with the fix where every difference has one.
function failIncomplete(c Checker, p ast.Project, ms ast.ModuleState, site ast.NodeID, typeName String, lacks Shortfall, mutates errs diag.ErrorList)
	if lacks.missing.count() > 0 'missing'
		failAt(c, p: p, ms: ms, node: site, code: diag.errConformance, msg: "{diag.missingMethods(typeName, count: "{lacks.missing.count()}")}\n{bulletLines(lacks.missing)}", errs: errs)
	end 'missing' else if lacks.wrong.count() > 0 'wrong'
		var fix = diag.Fix.none()
		if lacks.unfixed == 0 'mended'
			fix = diag.Fix.make(lacks.kind.clone(), edits: lacks.edits.clone())
		end 'mended'
		checkFailFixed(c.modID, off: offsetOf(c, p: p, ms: ms, node: site), code: diag.errConformance, msg: "{diag.wrongSignatureMethods(typeName, count: "{lacks.wrong.count()}")}\n{bulletLines(lacks.wrong)}", fix: fix, errs: errs)
	end 'wrong'
end 'failIncomplete'

// bulletLines is the methods of an incomplete implementation, one bulleted line each.
function bulletLines(items ast.StringList) returns String
	var lines = ast.StringList.create(0)
	for i in 0 upto items.count() 'each'
		lines.push("  - {items[i]}")
	end 'each'
	return ast.joinNames(lines, sep: "\n")
end 'bulletLines'

// checkInterface checks a type against one interface it implements, whether its body or an extension says so: each
// requirement is met, up to the first that is not, and what is lacking is collected into missing and wrong. A conditional
// conformance, an extension's with a 'where', is met by the methods that extensions add under that 'where'.
function checkInterface(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, site ast.NodeID, nt ast.TypeID, iface ast.TypeID, conditions ast.ParamBoundList, mutates lacks Shortfall, mutates errs diag.ErrorList)
	let conditional = conditions.count() > 0
	let own = ast.selfType(ms.types, reads: p.types, declTy: nt)
	let orig = ast.originOf(ms.types, reads: p.types, t: nt)
	let ifaceOrig = ast.originOf(ms.types, reads: p.types, t: iface)
	if ast.typeEntry(ms.types, reads: p.types, t: ifaceOrig).typeParams.count() > 0 and ast.typeEntry(ms.types, reads: p.types, t: iface).typeArgs.count() == 0 'unbound'
		let associated = ast.typeEntry(ms.types, reads: p.types, t: ast.typeEntry(ms.types, reads: p.types, t: ifaceOrig).typeParams[0]).name.clone()
		failAt(c, p: p, ms: ms, node: site, code: diag.errConformance, msg: diag.unboundAssociatedType(ast.typeEntry(ms.types, reads: p.types, t: orig).name, associated: associated, interfaceName: ast.typeEntry(ms.types, reads: p.types, t: ifaceOrig).name), errs: errs)
		return
	end 'unbound'
	if not conditionsGiveCapabilities(p, ms: ms, nt: nt, iface: iface, conditions: conditions) and not requireCapabilities(c, p: p, ms: ms, site: site, nt: nt, iface: iface, errs: errs) 'capability'
		return
	end 'capability'
	// The interface's 'where' bounds the types a conformance binds to its associated types, which the verify stage checks
	// here, at the conformance, rather than at each use of it.
	queueBounds(c, p: p, ms: ms, off: offsetOf(c, p: p, ms: ms, node: site), params: requirementParams(p, ms: ms, iface: ifaceOrig), args: requirementArgs(p, ms: ms, iface: iface, own: own))
	let reqs = ast.requirementsOf(ms.types, reads: p.types, iface: iface)
	for req in reqs 'sigs'
		let mark = errs.count()
		requireImplements(c, p: p, ms: ms, site: site, nt: orig, own: own, req: req, inherited: req.iface != iface, conditional: conditional, lacks: lacks, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return
		end 'failed'
	end 'sigs'
end 'checkInterface'

// conditionsGiveCapabilities is whether the conditions of a conditional conformance of nt to iface bound each type parameter
// of nt by an interface that extends what iface extends of Copyable and Droppable, so that every instance the conformance
// holds for has it: an array is Cloneable where its element is.
function conditionsGiveCapabilities(p ast.Project, ms ast.ModuleState, nt ast.TypeID, iface ast.TypeID, conditions ast.ParamBoundList) returns bool
	if conditions.count() == 0 'unconditional'
		return false
	end 'unconditional'
	let copies = ast.reachesInterface(ms.types, reads: p.types, have: iface, want: p.builtins.copyableTy)
	let drops = ast.reachesInterface(ms.types, reads: p.types, have: iface, want: p.builtins.droppableTy)
	for param in ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: nt)).typeParams 'params'
		var copied = not copies
		var dropped = not drops
		for condition in conditions 'conditions'
			if condition.paramTy == param 'bounds'
				copied = copied or ast.reachesInterface(ms.types, reads: p.types, have: condition.ifaceTy, want: p.builtins.copyableTy)
				dropped = dropped or ast.reachesInterface(ms.types, reads: p.types, have: condition.ifaceTy, want: p.builtins.droppableTy)
			end 'bounds'
		end 'conditions'
		if not copied or not dropped 'lacks'
			return false
		end 'lacks'
	end 'params'
	return true
end 'conditionsGiveCapabilities'

// requireCapabilities refuses a type that implements an interface that extends Copyable or Droppable without having it,
// since every value of the interface has what the interface extends.
function requireCapabilities(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, site ast.NodeID, nt ast.TypeID, iface ast.TypeID, mutates errs diag.ErrorList) returns bool
	let ifaceName = ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: iface)).name.clone()
	let copies = ast.reachesInterface(ms.types, reads: p.types, have: iface, want: p.builtins.copyableTy)
	if copies or ast.reachesInterface(ms.types, reads: p.types, have: iface, want: p.builtins.droppableTy) 'extends'
		let capName = "Copyable" if copies else "Droppable"
		let own = ast.selfType(ms.types, reads: p.types, declTy: nt)
		let lacking = lacksCap(c, p: p, ms: ms, wantCopy: copies, t: own)
		if lacking.missing 'lacks'
			let code = diag.errNotCopyable if copies else diag.errNotDroppable
			failAt(c, p: p, ms: ms, node: site, code: code, msg: "'{nameOfType(p, ms: ms, t: own)}' cannot implement {ifaceName}, which extends {capName}: {lackWhyText(ms.types, reads: p.types, info: lacking, capName: capName)}; {lackFixText(ms.types, reads: p.types, info: lacking, capName: capName)}", errs: errs)
			return false
		end 'lacks'
	end 'extends'
	return true
end 'requireCapabilities'

// requireImplements files what an implementation lacks of one requirement: the requirement when the method is missing,
// with the interface it comes from when it is inherited, and the method beside the requirement when its signature differs.
function requireImplements(c Checker, p ast.Project, mutates ms ast.ModuleState, site ast.NodeID, nt ast.TypeID, own ast.TypeID, req ast.Requirement, inherited bool, conditional bool, mutates lacks Shortfall, mutates errs diag.ErrorList)
	let iface = req.iface
	let sig = req.sig
	let selfParams = requirementParams(p, ms: ms, iface: iface)
	let bound = requirementBindings(own, req: req)
	let wantSpecs = applySpecs(p, ms: ms, specs: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).params.clone(), params: selfParams, args: bound)
	let wantReturn = ast.substituteType(ms.types, reads: p.types, t: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).retTy, params: selfParams, args: bound)
	let sigName = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).name.clone()
	let typeName = ast.typeEntry(ms.types, reads: p.types, t: nt).name.clone()
	let ifaceName = ast.typeEntry(ms.types, reads: p.types, t: iface).name.clone()
	let mark = errs.count()
	let m = methodOf(c, p: p, ms: ms, t: nt, name: sigName, node: site, errs: errs)
	if failedSince(errs, mark: mark) 'ambiguous'
		return
	end 'ambiguous'
	if m != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).bounds.count() > 0 and not (conditional and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).bounds.count() == ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).conditionalBounds) 'ownBounds'
		failAt(c, p: p, ms: ms, node: site, code: diag.errConformance, msg: "'{typeName}' says it implements {ifaceName}, but its method '{sigName}' adds a 'where' on the type's parameters, so '{typeName}' would implement {ifaceName} only for some instances: remove the 'where' from the method, or put the bound on the type", errs: errs)
		return
	end 'ownBounds'
	let sigConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).selfConv
	let sigError = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).errTy
	let sigStatic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).isStatic
	let sigResult = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).result
	if m != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).isStatic == sigStatic and (sigStatic or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).selfConv == sigConv) and witnessMatches(c, p: p, ms: ms, m: m, own: own, wantSpecs: wantSpecs, wantReturn: wantReturn, wantError: sigError, wantResult: sigResult) 'matches'
		return
	end 'matches'
	let wanted = signatureText(p, ms: ms, name: sigName, isStatic: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).isStatic, specs: wantSpecs, ret: wantReturn, err: sigError, result: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).result)
	if m == ast.noFunc and inherited 'absentInherited'
		lacks.missing.push("{wanted} (from {ifaceName})")
		return
	end 'absentInherited'
	if m == ast.noFunc 'absent'
		lacks.missing.push(wanted)
		return
	end 'absent'
	// A method that meets the requirement but for a receiver it does not declare mutable is mended by declaring it so, as
	// a body that changes its receiver is: the requirement says the caller lends the receiver to be changed.
	let mStatic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).isStatic
	let mConv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).selfConv
	if not sigStatic and not mStatic and sigConv == ast.Convention.convMutates and mConv == ast.Convention.convLet and witnessMatches(c, p: p, ms: ms, m: m, own: own, wantSpecs: wantSpecs, wantReturn: wantReturn, wantError: sigError, wantResult: sigResult) 'receiver'
		var fix = diag.Fix.none()
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).module == c.modID 'here'
			fix = mutatesSelfFix(ms.tree(), method: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).nodeID)
		end 'here'
		lacks.addWrong("{sigName}() does not declare 'mutates self' (expected {sigName}(mutates self), as {ifaceName} declares it)", fix: fix)
		return
	end 'receiver'
	// One that gives a value where the requirement lends a place is mended by lending it, which its return checks.
	let mResult = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).result
	if mStatic == sigStatic and (sigStatic or mConv == sigConv) and sigResult == ast.ResultConv.resultBorrowed and mResult == ast.ResultConv.resultOwned and witnessMatches(c, p: p, ms: ms, m: m, own: own, wantSpecs: wantSpecs, wantReturn: wantReturn, wantError: sigError, wantResult: mResult) 'lends'
		var fix = diag.Fix.none()
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).module == c.modID 'here'
			fix = borrowedResultFix(ms.tree(), method: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).nodeID)
		end 'here'
		lacks.addWrong("{sigName}() gives a value where {ifaceName} lends a place (expected {wanted})", fix: fix)
		return
	end 'lends'
	lacks.addWrong("{signatureText(p, ms: ms, name: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).name, isStatic: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).isStatic, specs: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).params, ret: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).retTy, err: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).errTy, result: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).result)} (expected {wanted})", fix: diag.Fix.none())
end 'requireImplements'

// witnessMatches is whether the method m, which meets a requirement for the type own, takes and gives what the requirement
// does there. A method that an extension of an interface adds does at its instance for own.
function witnessMatches(c Checker, p ast.Project, mutates ms ast.ModuleState, m ast.FuncID, own ast.TypeID, wantSpecs ast.ParamSpecList, wantReturn ast.TypeID, wantError ast.TypeID, wantResult ast.ResultConv) returns bool
	var specs = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).params.clone()
	// A message that defers its reply meets a requirement by what its header declares, which its senders await.
	var ret = ast.replyTypeOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m))
	var err = ast.replyErrorOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m))
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).extendedIface != ast.noType 'ofInterface'
		let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).generics)
		let args = ast.interfaceExtensionArgs(p, ms: ms, recv: own, have: ast.seenInterfaces(p, ms: ms, from: c.modID, t: own), fid: m)
		specs = applySpecs(p, ms: ms, specs: specs, params: generics, args: args)
		ret = ast.substituteType(ms.types, reads: p.types, t: ret, params: generics, args: args)
		err = ast.substituteType(ms.types, reads: p.types, t: err, params: generics, args: args)
	end 'ofInterface'
	return sameSpecs(specs, b: wantSpecs) and ret == wantReturn and err == wantError and meetsResult(p, ms: ms, have: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m).result, want: wantResult, t: ret)
end 'witnessMatches'

// meetsResult is whether a method whose result is have meets a requirement whose result is want, of the type t. A call
// through the requirement takes the result as want says, the same word whatever method runs: a method that lends a place
// meets only a requirement that lends one, and one that gives a value only one that gives a value, except where the value
// is a scalar that is not a float, which a borrow of it is too.
function meetsResult(p ast.Project, ms ast.ModuleState, have ast.ResultConv, want ast.ResultConv, t ast.TypeID) returns bool
	if have == want 'same'
		return true
	end 'same'
	return want == ast.ResultConv.resultBorrowed and not ast.isManagedType(ms.types, reads: p.types, t: t) and not ast.isFloatType(ms.types, reads: p.types, t: t)
end 'meetsResult'

// requirementsNamed are the requirements of that name that an interface has: one, or none, or two where an interface
// declares again a requirement of one it extends.
function requirementsNamed(p ast.Project, ms ast.ModuleState, iface ast.TypeID, name String) returns ast.RequirementList
	let reqs = ast.requirementsOf(ms.types, reads: p.types, iface: iface)
	var out = ast.RequirementList.create(0)
	for i in 0 upto reqs.count() 'each'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: reqs[i].sig).name == name 'hit'
			out.push(reqs[i].clone())
		end 'hit'
	end 'each'
	return out
end 'requirementsNamed'

// requirementText is a requirement as maxon names it beside another: its interface and its signature.
function requirementText(p ast.Project, ms ast.ModuleState, req ast.Requirement) returns String
	let f = req.sig
	return "{ast.typeEntry(ms.types, reads: p.types, t: req.iface).name}.{signatureText(p, ms: ms, name: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).name, isStatic: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).isStatic, specs: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).params, ret: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).retTy, err: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).errTy, result: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).result)}"
end 'requirementText'

// requirementParams are the types a requirement of iface is written over: 'Self', then the interface's associated types.
function requirementParams(p ast.Project, ms ast.ModuleState, iface ast.TypeID) returns ast.TypeIDList
	let orig = ast.originOf(ms.types, reads: p.types, t: iface)
	var params = oneType(ast.typeEntry(ms.types, reads: p.types, t: orig).selfParam)
	params.append(ast.typeEntry(ms.types, reads: p.types, t: orig).typeParams)
	return params
end 'requirementParams'

// requirementArgs are what requirementParams stand for where the type own implements iface: own, then the types that iface
// binds.
function requirementArgs(p ast.Project, ms ast.ModuleState, iface ast.TypeID, own ast.TypeID) returns ast.TypeIDList
	var args = oneType(own)
	args.append(ast.typeEntry(ms.types, reads: p.types, t: iface).typeArgs)
	return args
end 'requirementArgs'

// requirementBindings are what requirementParams of the interface that declares req stand for where the type own
// implements the interface it was found in: own, then the types that req's interface is bound to there.
function requirementBindings(own ast.TypeID, req ast.Requirement) returns ast.TypeIDList
	var args = oneType(own)
	args.append(req.bindings)
	return args
end 'requirementBindings'

// conformanceTo is the instance of the interface origin that the declaration of t says it implements, at t's type
// arguments, or none: one it names, or one that an interface it names extends, bound as that one binds it.
function conformanceTo(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, iface ast.TypeID) returns ast.TypeID
	let orig = ast.originOf(ms.types, reads: p.types, t: t)
	let conforms = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: orig).conforms)
	let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: orig).typeParams)
	let args = ast.typeArgsOf(ms.types, reads: p.types, t: t)
	for i in 0 upto conforms.count() 'each'
		if ast.originOf(ms.types, reads: p.types, t: conforms[i]) == iface 'hit'
			return ast.substituteType(ms.types, reads: p.types, t: conforms[i], params: params, args: args)
		end 'hit'
	end 'each'
	for i in 0 upto conforms.count() 'inherited'
		let named = ast.substituteType(ms.types, reads: p.types, t: conforms[i], params: params, args: args)
		match consumes ast.ancestorBindings(ms.types, reads: p.types, have: named, want: iface) 'ancestor'
			some(bindings) then return ast.instantiateType(ms.types, reads: p.types, origin: iface, args: bindings)
			none then break
		end 'ancestor'
	end 'inherited'
	return ast.noType
end 'conformanceTo'

function sameSpecs(a ast.ParamSpecList, b ast.ParamSpecList) returns bool
	if a.count() != b.count() 'count'
		return false
	end 'count'
	for i in 0 upto a.count() 'each'
		if a[i].name != b[i].name or a[i].ty != b[i].ty or a[i].conv != b[i].conv 'differs'
			return false
		end 'differs'
	end 'each'
	return true
end 'sameSpecs'

// signatureText is a method as maxon lists it in an incomplete implementation.
function signatureText(p ast.Project, ms ast.ModuleState, name String, isStatic bool, specs ast.ParamSpecList, ret ast.TypeID, err ast.TypeID, result ast.ResultConv) returns String
	var parts = ast.StringList.create(0)
	for i in 0 upto specs.count() 'each'
		if specs[i].conv == ast.Convention.convMutates 'written'
			parts.push("{specs[i].name} mutable {nameOfType(p, ms: ms, t: specs[i].ty)}")
		end 'written' else 'read'
			parts.push("{specs[i].name} {nameOfType(p, ms: ms, t: specs[i].ty)}")
		end 'read'
	end 'each'
	var lent = ""
	if result == ast.ResultConv.resultBorrowed 'lent'
		lent = "borrowed "
	end 'lent'
	var text = "{name}({ast.joinNames(parts, sep: ", ")}) returns {lent}{nameOfType(p, ms: ms, t: ret)}"
	if isStatic 'static'
		text = "static {text}"
	end 'static'
	if err != ast.noType 'throws'
		text = "{text} throws {nameOfType(p, ms: ms, t: err)}"
	end 'throws'
	return text
end 'signatureText'

// verifyBounds checks the type arguments that the module's instances and inferred calls give against their parameters'
// bounds. All the bounds of one argument stop at the first it fails.
export function verifyBounds(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, bounds PendingBoundList, mutates errs diag.ErrorList)
	var failedSame = false
	for i in 0 upto bounds.count() 'each'
		if i > 0 and failedSame and sameArgument(bounds[i], b: bounds[(i - 1)]) 'skipped'
			continue 'each'
		end 'skipped'
		let mark = errs.count()
		c.boundedFn = bounds[i].withinFn
		if bounds[i].receiverTy != ast.noType 'conditional'
			requireCondition(c, p: p, ms: ms, bound: bounds[i], errs: errs)
		end 'conditional' else 'bound'
			requireConforms(c, p: p, ms: ms, off: bounds[i].off, arg: bounds[i].argTy, iface: bounds[i].ifaceTy, param: bounds[i].paramTy, inFn: bounds[i].inFn, errs: errs)
		end 'bound'
		failedSame = failedSince(errs, mark: mark)
	end 'each'
end 'verifyBounds'

// requireCondition checks one bound of the 'where' of a conditional extension at a call of a method it declares. The
// method is one of the instances that meet it, so where the type argument does not, the value has no such method, which
// is how maxon words it.
function requireCondition(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, bound PendingBound, mutates errs diag.ErrorList)
	var refused = diag.ErrorList.create(0)
	requireConforms(c, p: p, ms: ms, off: bound.off, arg: bound.argTy, iface: bound.ifaceTy, param: bound.paramTy, inFn: bound.inFn, errs: refused)
	if refused.count() == 0 'met'
		return
	end 'met'
	if refused[0].code != diag.errBoundNotMet 'other'
		errs.append(refused)
		return
	end 'other'
	var method = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: bound.methodFn).name.clone()
	if ast.builtinOfElementwise(method) != "" 'elementwise'
		// The library's elementwise method of an array, which a call of the array's built-in one runs (ast.runsBuiltin), as
		// maxon names it.
		method = ast.builtinOfElementwise(method)
	end 'elementwise'
	let msg = diag.conditionalExtensionWithheld(nameOfType(p, ms: ms, t: bound.receiverTy), methodName: method, clause: conditionText(p, ms: ms, method: bound.methodFn), bindingName: nameOfType(p, ms: ms, t: bound.argTy), interfaceName: nameOfType(p, ms: ms, t: bound.ifaceTy))
	checkFail(c.modID, off: bound.off, code: diag.errInvalidFieldAccess, msg: msg, errs: errs)
end 'requireCondition'

// conditionText is the 'where' of the conditional extension that declares the method, as it is written.
function conditionText(p ast.Project, ms ast.ModuleState, method ast.FuncID) returns String
	var parts = ast.StringList.create(0)
	var param = ast.noType
	for i in 0 upto ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).conditionalBounds 'each'
		let b = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).bounds[i].clone()
		if b.paramTy == param 'same'
			let last = try parts.count() - 1 otherwise panic("no condition before")
			parts[last] = "{parts[last]} and {nameOfType(p, ms: ms, t: b.ifaceTy)}"
		end 'same' else 'next'
			parts.push("{nameOfType(p, ms: ms, t: b.paramTy)} implements {nameOfType(p, ms: ms, t: b.ifaceTy)}")
			param = b.paramTy
		end 'next'
	end 'each'
	return "where {ast.joinNames(parts, sep: ", ")}"
end 'conditionText'

function sameArgument(a PendingBound, b PendingBound) returns bool
	return a.off == b.off and a.paramTy == b.paramTy and a.argTy == b.argTy and a.hasMethod == b.hasMethod and a.methodFn == b.methodFn
end 'sameArgument'

// requireConforms checks one type argument against one bound of its parameter, which the body of inFn gives.
function requireConforms(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, arg ast.TypeID, iface ast.TypeID, param ast.TypeID, inFn ast.FuncID, mutates errs diag.ErrorList)
	let argName = nameOfType(p, ms: ms, t: arg)
	let paramName = nameOfType(p, ms: ms, t: param)
	let ifaceName = ast.typeEntry(ms.types, reads: p.types, t: iface).name.clone()
	if p.builtins.isCapability(iface) 'structural'
		let lacking = lacksCap(c, p: p, ms: ms, wantCopy: iface == p.builtins.copyableTy, t: arg)
		if lacking.missing 'lacks'
			let why = lackWhyText(ms.types, reads: p.types, info: lacking, capName: ifaceName)
			let fix = lackFixText(ms.types, reads: p.types, info: lacking, capName: ifaceName)
			checkFailFixed(c.modID, off: off, code: diag.errBoundNotMet, msg: "the type argument '{argName}' for '{paramName}' must be {ifaceName}, but {why}: {fix}", fix: lackBoundFix(p, ms: ms, fn: inFn, info: lacking, capName: ifaceName), errs: errs)
		end 'lacks'
		return
	end 'structural'
	if typeHasKind(p, ms: ms, t: arg, kind: ast.TypeKind.interfaceTy) 'interfaceValue'
		// A value of an interface meets a bound of that interface: a call through the bound runs the method of the value it
		// holds, through its table. Of another interface, even one it extends, it has no table.
		if not sameType(ms.types, reads: p.types, a: arg, b: iface) 'other'
			checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "the interface value type '{argName}' must be {ifaceName} for '{paramName}', but a value of an interface meets a bound of that interface alone: pass a value of a type that implements {ifaceName}, or put it in a {ifaceName} value", errs: errs)
		end 'other'
		return
	end 'interfaceValue'
	if typeHasKind(p, ms: ms, t: arg, kind: ast.TypeKind.typeParam) 'parameter'
		if not boundsExtend(p, ms: ms, bounds: boundsOfParam(p, ms: ms, boundedFn: c.boundedFn, paramTy: arg), iface: iface) 'unbounded'
			checkFailFixed(c.modID, off: off, code: diag.errBoundNotMet, msg: "the type parameter '{argName}' is not known to be {ifaceName}, which the type argument for '{paramName}' must be: add the bound, '{argName} implements {ifaceName}'", fix: paramBoundFix(p, ms: ms, fn: inFn, param: arg, bound: ifaceName), errs: errs)
		end 'unbounded'
		return
	end 'parameter'
	if arg != ast.noType and (typeIsNominal(ms.types, reads: p.types, t: arg) or ast.extensionKey(p, ms: ms, t: arg).isSome()) 'implementable'
		requireDeclared(c, p: p, ms: ms, off: off, arg: arg, iface: iface, param: param, errs: errs)
		return
	end 'implementable'
	checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "'{argName}' must be {ifaceName} for '{paramName}', but only a type, enum or union implements an interface", errs: errs)
end 'requireConforms'

// boundsExtend is whether one of the bounds is the interface iface or extends it.
function boundsExtend(p ast.Project, ms ast.ModuleState, bounds ast.TypeIDList, iface ast.TypeID) returns bool
	for i in 0 upto bounds.count() 'each'
		if ast.extendsInterface(ms.types, reads: p.types, have: bounds[i], want: iface) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'boundsExtend'

// requireDeclared refuses a nominal type argument whose declaration does not say it implements the interface.
function requireDeclared(c Checker, p ast.Project, mutates ms ast.ModuleState, off diag.U32, arg ast.TypeID, iface ast.TypeID, param ast.TypeID, mutates errs diag.ErrorList)
	let orig = ast.originOf(ms.types, reads: p.types, t: arg)
	let mark = errs.count()
	match consumes ast.conformanceSource(p, ms: ms, from: c.modID, t: arg, iface: iface) 'source'
		found(_) then return
		ambiguous(first, second) then failAmbiguousConformance(c, p: p, off: off, typeName: nameOfType(p, ms: ms, t: arg), ifaceName: spelled(c, p: p, ms: ms, iface: iface), first: first, second: second, errs: errs)
		absent then break
	end 'source'
	if failedSince(errs, mark: mark) 'ambiguous'
		return
	end 'ambiguous'
	let argName = nameOfType(p, ms: ms, t: arg)
	let paramName = nameOfType(p, ms: ms, t: param)
	let ifaceName = ast.typeEntry(ms.types, reads: p.types, t: iface).name.clone()
	let declared = conformanceTo(p, ms: ms, t: arg, iface: ast.originOf(ms.types, reads: p.types, t: iface))
	if declared != ast.noType 'disagrees'
		failBindingDisagrees(c, p: p, ms: ms, off: off, arg: arg, declared: declared, iface: iface, param: param, errs: errs)
		return
	end 'disagrees'
	if boundsExtend(p, ms: ms, bounds: ast.seenInterfaces(p, ms: ms, from: c.modID, t: arg), iface: iface) 'conditionUnmet'
		checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "'{argName}' must be {ifaceName} for '{paramName}', but the extension that says '{extensionTargetName(p, ms: ms, t: arg)}' implements {spelled(c, p: p, ms: ms, iface: iface)} says it only where its type arguments meet its 'where', and those of '{argName}' do not: give it type arguments that do, or wrap it in a type of your own that implements {spelled(c, p: p, ms: ms, iface: iface)}", errs: errs)
		return
	end 'conditionUnmet'
	if not typeIsNominal(ms.types, reads: p.types, t: arg) or (ast.typeEntry(ms.types, reads: p.types, t: orig).hasDecl and ast.typeEntry(ms.types, reads: p.types, t: orig).decl.module == diag.stdlibID) 'builtIn'
		checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "'{argName}' is built in and implements no interface, so it cannot be {ifaceName} for '{paramName}'; declare 'extension {extensionTargetName(p, ms: ms, t: arg)} implements {spelled(c, p: p, ms: ms, iface: iface)}', or wrap it in a type of your own that declares 'implements {spelled(c, p: p, ms: ms, iface: iface)}'", errs: errs)
		return
	end 'builtIn'
	checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "'{argName}' must be {ifaceName} for '{paramName}': declare '{declarationWord(p, ms: ms, t: arg)} {ast.typeEntry(ms.types, reads: p.types, t: orig).name} implements {spelled(c, p: p, ms: ms, iface: iface)}'{missingMethods(c, p: p, ms: ms, t: arg, iface: iface)}", errs: errs)
end 'requireDeclared'

// failAmbiguousConformance refuses a type argument that two declarations the module sees say implements the interface.
function failAmbiguousConformance(c Checker, p ast.Project, off diag.U32, typeName String, ifaceName String, first ast.Conformance, second ast.Conformance, mutates errs diag.ErrorList)
	checkFail(c.modID, off: off, code: diag.errAmbiguousConformance, msg: ast.ambiguousConformanceText(p, from: c.modID, typeName: typeName, ifaceName: ifaceName, first: first, second: second), errs: errs)
end 'failAmbiguousConformance'

// failBindingDisagrees refuses a type argument whose declaration implements the bound's interface, but binds one of its
// associated types otherwise than the bound says.
function failBindingDisagrees(c Checker, p ast.Project, ms ast.ModuleState, off diag.U32, arg ast.TypeID, declared ast.TypeID, iface ast.TypeID, param ast.TypeID, mutates errs diag.ErrorList)
	let orig = ast.originOf(ms.types, reads: p.types, t: iface)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: iface).typeArgs.count() 'each'
		let claimed = ast.typeEntry(ms.types, reads: p.types, t: iface).typeArgs[i]
		let supplied = ast.typeEntry(ms.types, reads: p.types, t: declared).typeArgs[i]
		if claimed != supplied 'differs'
			let associated = ast.typeEntry(ms.types, reads: p.types, t: ast.typeEntry(ms.types, reads: p.types, t: orig).typeParams[i]).name.clone()
			let msg = diag.boundBindingDisagrees(ast.typeParamOwnerName(ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, param: param), param: nameOfType(p, ms: ms, t: param), claimed: nameOfType(p, ms: ms, t: iface), argName: nameOfType(p, ms: ms, t: arg), interfaceName: ast.typeEntry(ms.types, reads: p.types, t: orig).name, associated: associated, supplied: nameOfType(p, ms: ms, t: supplied))
			checkFail(c.modID, off: off, code: diag.errBoundBindingDisagrees, msg: msg, errs: errs)
			return
		end 'differs'
	end 'each'
	panic("'{nameOfType(p, ms: ms, t: arg)}' binds what '{nameOfType(p, ms: ms, t: iface)}' does, yet does not implement it")
end 'failBindingDisagrees'

// extensionTargetName is how an extension names the type t: an integer is `int`.
function extensionTargetName(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	if ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.intRange 'integer'
		return "int"
	end 'integer'
	return ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: t)).name.clone()
end 'extensionTargetName'

// spelled is how code in this module names an interface: qualified when another module declares it.
function spelled(c Checker, p ast.Project, ms ast.ModuleState, iface ast.TypeID) returns String
	let name = ast.typeEntry(ms.types, reads: p.types, t: iface).name.clone()
	if not ast.typeEntry(ms.types, reads: p.types, t: iface).hasDecl 'none'
		return name
	end 'none'
	let owner = ast.typeEntry(ms.types, reads: p.types, t: iface).decl.module
	if owner != c.modID and owner != diag.stdlibID and p.modules[ast.modIndex(owner)].path != "" 'qualified'
		return "{p.modules[ast.modIndex(owner)].path}.{name}"
	end 'qualified'
	return name
end 'spelled'

function declarationWord(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	if kind == ast.TypeKind.record 'record'
		return "type"
	end 'record'
	if kind == ast.TypeKind.enumTy 'enum'
		return "enum"
	end 'enum'
	if kind == ast.TypeKind.unionTy 'union'
		return "union"
	end 'union'
	panic("{ast.typeName(ms.types, reads: p.types, t: t)} is not declared as a type, enum or union")
end 'declarationWord'

// lacksMethod is whether the name finds no method of the kind that the type t could implement a requirement with. Two
// that extensions add are there, and refused where the conformance is used.
function lacksMethod(c Checker, p ast.Project, ms ast.ModuleState, t ast.TypeID, name String, isStatic bool) returns bool
	match consumes methodLookup(c, p: p, ms: ms, t: t, name: name) 'lookup'
		absent then return true
		found(fid) then return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).isStatic != isStatic
		ambiguous(_, _) then return false
	end 'lookup'
end 'lacksMethod'

// missingMethods names the methods of the interface that the type lacks, for the error that asks it to declare one.
function missingMethods(c Checker, p ast.Project, ms ast.ModuleState, t ast.TypeID, iface ast.TypeID) returns String
	var missing = ast.StringList.create(0)
	let reqs = ast.requirementsOf(ms.types, reads: p.types, iface: iface)
	for i in 0 upto reqs.count() 'each'
		let sig = reqs[i].sig
		let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).name.clone()
		if lacksMethod(c, p: p, ms: ms, t: t, name: name, isStatic: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).isStatic) 'lacking'
			missing.push(name)
		end 'lacking'
	end 'each'
	if missing.count() == 0 'none'
		return ""
	end 'none'
	return " and add the method(s) {ast.joinNames(missing, sep: ", ")}"
end 'missingMethods'
