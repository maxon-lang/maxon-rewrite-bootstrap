// What a declaration owes the rest of the program, checked once its members are known: that a type does not contain
// itself, that it implements the interfaces it names, and that the type arguments of an instance meet the bounds of the
// parameters they stand for.

// checkCycle refuses a type or a union that contains itself, which would have no finite size.
function checkCycle(mutates c Checker, mutates p ast.Project, site ast.NodeID, t ast.TypeID, mutates errs diag.ErrorList)
	let own = ast.selfType(p.types, declTy: t)
	var path = ast.StringList.create(0)
	var visited = BoolIntMap.new()
	var growing = false
	if not reaches(p, from: own, target: own, path: path, visited: visited, growing: growing) 'finite'
		return
	end 'finite'
	let name = p.types.entries[ast.originOf(p.types, t: t) as Count].name.clone()
	if growing 'growing'
		failAt(c, p: p, node: site, code: diag.errTypeCycle, msg: "type '{name}' has no finite size: via {path[0]} it contains itself with a larger type argument each time", errs: errs)
		return
	end 'growing'
	failAt(c, p: p, node: site, code: diag.errTypeCycle, msg: diag.typeReferenceCycle(name, path: "{name} → {ast.joinNames(path, sep: " → ")}"), errs: errs)
end 'checkCycle'

// reaches is whether a value of type from contains one of type target. A type that contains itself with a larger type
// argument each time never repeats, so it is found by how deeply its instances nest, and sets growing.
function reaches(mutates p ast.Project, from ast.TypeID, target ast.TypeID, mutates path ast.StringList, mutates visited BoolIntMap, mutates growing bool) returns bool
	let kind = p.types.entries[from as Count].kind
	let orig = ast.originOf(p.types, t: from)
	if kind == ast.TypeKind.record 'record'
		for fi in 0 upto p.types.entries[orig as Count].fields.count() 'fields'
			let held = ast.fieldType(p.types, owner: from, index: fi)
			let edge = "{p.types.entries[orig as Count].fields[fi].name}: {ast.typeName(p.types, t: held)}"
			if followEdge(p, edge: edge, held: held, target: target, path: path, visited: visited, growing: growing) 'found'
				return true
			end 'found'
		end 'fields'
	end 'record' else if kind == ast.TypeKind.unionTy 'union'
		for ci in 0 upto p.types.entries[orig as Count].cases.count() 'cases'
			for pi in 0 upto p.types.entries[orig as Count].cases[ci].payload.count() 'payload'
				let held = ast.payloadType(p.types, owner: from, caseIndex: ci, index: pi)
				let edge = "{p.types.entries[orig as Count].cases[ci].name}.{p.types.entries[orig as Count].cases[ci].payload[pi].name}: {ast.typeName(p.types, t: held)}"
				if followEdge(p, edge: edge, held: held, target: target, path: path, visited: visited, growing: growing) 'found'
					return true
				end 'found'
			end 'payload'
		end 'cases'
	end 'union'
	return false
end 'reaches'

// followEdge follows one edge of the search for target: a field or a payload that holds the type held.
function followEdge(mutates p ast.Project, edge String, held ast.TypeID, target ast.TypeID, mutates path ast.StringList, mutates visited BoolIntMap, mutates growing bool) returns bool
	path.push(edge.clone())
	if held == target 'found'
		return true
	end 'found'
	if ast.hasTypeDepthOverflow(p.types, t: held, depth: 0 as Count) 'deep'
		growing = true
		return true
	end 'deep'
	if not visited.has(held as Count) 'unseen'
		visited.insert(held as Count, value: true)
		if reaches(p, from: held, target: target, path: path, visited: visited, growing: growing) 'inside'
			return true
		end 'inside'
	end 'unseen'
	_ = try path.pop() otherwise panic("an edge left that was never followed")
	return false
end 'followEdge'

// checkConformance checks a declaration against each interface it says it implements: every method is there with the
// signature the interface gives, so a bound that the declaration meets is never wrong at an instance.
function checkConformance(mutates c Checker, mutates p ast.Project, site ast.NodeID, nt ast.TypeID, mutates errs diag.ErrorList)
	let orig = ast.originOf(p.types, t: nt)
	let conforms = ast.cloneTypeArgs(p.types.entries[orig as Count].conforms)
	var missing = ast.StringList.create(0)
	var wrong = ast.StringList.create(0)
	for i in 0 upto conforms.count() 'interfaces'
		let mark = errs.count()
		checkInterface(c, p: p, site: site, nt: nt, iface: conforms[i], missing: missing, wrong: wrong, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return
		end 'failed'
	end 'interfaces'
	failIncomplete(c, p: p, site: site, typeName: p.types.entries[orig as Count].name.clone(), missing: missing, wrong: wrong, errs: errs)
end 'checkConformance'

// failIncomplete files the one error for a type that implements an interface incompletely: the methods it lacks, or else the
// methods whose signature differs.
function failIncomplete(c Checker, mutates p ast.Project, site ast.NodeID, typeName String, missing ast.StringList, wrong ast.StringList, mutates errs diag.ErrorList)
	if missing.count() > 0 'missing'
		failAt(c, p: p, node: site, code: diag.errConformance, msg: "{diag.missingMethods(typeName, count: "{missing.count()}")}\n{bulletLines(missing)}", errs: errs)
	end 'missing' else if wrong.count() > 0 'wrong'
		failAt(c, p: p, node: site, code: diag.errConformance, msg: "{diag.wrongSignatureMethods(typeName, count: "{wrong.count()}")}\n{bulletLines(wrong)}", errs: errs)
	end 'wrong'
end 'failIncomplete'

// bulletLines is the methods of an incomplete implementation, one bulleted line each.
function bulletLines(items ast.StringList) returns String
	var lines = ast.StringList.create(0)
	for i in 0 upto items.count() 'each'
		lines.push("  - {items[i]}")
	end 'each'
	return ast.joinNames(lines, sep: "\n")
end 'bulletLines'

// checkInterface checks a type against one interface it implements, whether its body or an extension says so: each
// requirement is met, up to the first that is not, and what is lacking is collected into missing and wrong.
function checkInterface(mutates c Checker, mutates p ast.Project, site ast.NodeID, nt ast.TypeID, iface ast.TypeID, mutates missing ast.StringList, mutates wrong ast.StringList, mutates errs diag.ErrorList)
	let own = ast.selfType(p.types, declTy: nt)
	let orig = ast.originOf(p.types, t: nt)
	let ifaceOrig = ast.originOf(p.types, t: iface)
	if p.types.entries[ifaceOrig as Count].typeParams.count() > 0 and p.types.entries[iface as Count].typeArgs.count() == 0 'unbound'
		let associated = p.types.entries[p.types.entries[ifaceOrig as Count].typeParams[0] as Count].name.clone()
		failAt(c, p: p, node: site, code: diag.errConformance, msg: diag.unboundAssociatedType(p.types.entries[orig as Count].name, associated: associated, interfaceName: p.types.entries[ifaceOrig as Count].name), errs: errs)
		return
	end 'unbound'
	let reqs = requirementsOf(p, iface: iface)
	for j in 0 upto reqs.count() 'sigs'
		let mark = errs.count()
		requireImplements(c, p: p, site: site, nt: orig, own: own, iface: reqs[j].iface, sig: reqs[j].sig, inherited: reqs[j].iface != iface, missing: missing, wrong: wrong, errs: errs)
		if failedSince(errs, mark: mark) 'failed'
			return
		end 'failed'
	end 'sigs'
end 'checkInterface'

// requireImplements files what an implementation lacks of one requirement: the requirement when the method is missing,
// with the interface it comes from when it is inherited, and the method beside the requirement when its signature differs.
function requireImplements(c Checker, mutates p ast.Project, site ast.NodeID, nt ast.TypeID, own ast.TypeID, iface ast.TypeID, sig ast.FuncID, inherited bool, mutates missing ast.StringList, mutates wrong ast.StringList, mutates errs diag.ErrorList)
	let selfParams = requirementParams(p, iface: iface)
	let bound = requirementArgs(p, iface: iface, own: own)
	let wantSpecs = applySpecs(p, specs: p.funcs.entries[sig as Count].params.clone(), params: selfParams, args: bound)
	let wantReturn = ast.substituteType(p.types, t: p.funcs.entries[sig as Count].retTy, params: selfParams, args: bound)
	let sigName = p.funcs.entries[sig as Count].name.clone()
	let typeName = p.types.entries[nt as Count].name.clone()
	let ifaceName = p.types.entries[iface as Count].name.clone()
	let m = methodOf(c, p: p, t: nt, name: sigName)
	if m != ast.noFunc and p.funcs.entries[m as Count].bounds.count() > 0 'ownBounds'
		failAt(c, p: p, node: site, code: diag.errConformance, msg: "'{typeName}' says it implements {ifaceName}, but its method '{sigName}' adds a 'where' on the type's parameters, so '{typeName}' would implement {ifaceName} only for some instances: remove the 'where' from the method, or put the bound on the type", errs: errs)
		return
	end 'ownBounds'
	let sigConv = p.funcs.entries[sig as Count].selfConv
	let sigError = p.funcs.entries[sig as Count].errTy
	let sigStatic = p.funcs.entries[sig as Count].isStatic
	if m != ast.noFunc and p.funcs.entries[m as Count].isStatic == sigStatic and (sigStatic or p.funcs.entries[m as Count].selfConv == sigConv) and sameSpecs(p.funcs.entries[m as Count].params, b: wantSpecs) and p.funcs.entries[m as Count].retTy == wantReturn and p.funcs.entries[m as Count].errTy == sigError 'matches'
		return
	end 'matches'
	let wanted = signatureText(p, name: sigName, isStatic: p.funcs.entries[sig as Count].isStatic, specs: wantSpecs, ret: wantReturn, err: sigError)
	if m == ast.noFunc and inherited 'absentInherited'
		missing.push("{wanted} (from {ifaceName})")
		return
	end 'absentInherited'
	if m == ast.noFunc 'absent'
		missing.push(wanted)
		return
	end 'absent'
	wrong.push("{signatureText(p, name: p.funcs.entries[m as Count].name, isStatic: p.funcs.entries[m as Count].isStatic, specs: p.funcs.entries[m as Count].params, ret: p.funcs.entries[m as Count].retTy, err: p.funcs.entries[m as Count].errTy)} (expected {wanted})")
end 'requireImplements'

// A Requirement is a method that an interface requires, with the interface that declares it, which is the interface
// itself or one it extends: its signature is read over that interface's 'Self' and associated types.
type Requirement
	var iface as ast.TypeID
	var sig as ast.FuncID

	static function make(iface ast.TypeID, sig ast.FuncID) returns Requirement
		return Requirement{iface: iface, sig: sig}
	end 'make'
end 'Requirement'

typealias RequirementList = Array with Requirement

// requirementsOf are the methods an interface requires, its own and then those of the interfaces it extends, each once.
// An instance of a generic interface reads them from its declaration.
function requirementsOf(p ast.Project, iface ast.TypeID) returns RequirementList
	var out = RequirementList.create(0)
	collectRequirements(p, iface: iface, out: out)
	return out
end 'requirementsOf'

function collectRequirements(p ast.Project, iface ast.TypeID, mutates out RequirementList)
	let orig = ast.originOf(p.types, t: iface)
	for i in 0 upto p.types.entries[orig as Count].sigs.count() 'own'
		let sig = p.types.entries[orig as Count].sigs[i]
		if not hasRequirement(out, sig: sig) 'new'
			out.push(Requirement.make(iface, sig: sig))
		end 'new'
	end 'own'
	for i in 0 upto p.types.entries[orig as Count].conforms.count() 'parents'
		collectRequirements(p, iface: p.types.entries[orig as Count].conforms[i], out: out)
	end 'parents'
end 'collectRequirements'

function hasRequirement(reqs RequirementList, sig ast.FuncID) returns bool
	for i in 0 upto reqs.count() 'each'
		if reqs[i].sig == sig 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'hasRequirement'

// requirementsNamed are the requirements of that name that an interface has: one, or none, or two where an interface
// declares again a requirement of one it extends.
function requirementsNamed(p ast.Project, iface ast.TypeID, name String) returns RequirementList
	let reqs = requirementsOf(p, iface: iface)
	var out = RequirementList.create(0)
	for i in 0 upto reqs.count() 'each'
		if p.funcs.entries[reqs[i].sig as Count].name == name 'hit'
			out.push(reqs[i].clone())
		end 'hit'
	end 'each'
	return out
end 'requirementsNamed'

// requirementText is a requirement as maxon names it beside another: its interface and its signature.
function requirementText(p ast.Project, req Requirement) returns String
	let f = req.sig as Count
	return "{p.types.entries[req.iface as Count].name}.{signatureText(p, name: p.funcs.entries[f].name, isStatic: p.funcs.entries[f].isStatic, specs: p.funcs.entries[f].params, ret: p.funcs.entries[f].retTy, err: p.funcs.entries[f].errTy)}"
end 'requirementText'

// requirementParams are the types a requirement of iface is written over: 'Self', then the interface's associated types.
function requirementParams(p ast.Project, iface ast.TypeID) returns ast.TypeIDList
	let orig = ast.originOf(p.types, t: iface)
	var params = oneType(p.types.entries[orig as Count].selfParam)
	params.append(p.types.entries[orig as Count].typeParams)
	return params
end 'requirementParams'

// requirementArgs are what requirementParams stand for where the type own implements iface: own, then the types that iface
// binds.
function requirementArgs(p ast.Project, iface ast.TypeID, own ast.TypeID) returns ast.TypeIDList
	var args = oneType(own)
	args.append(p.types.entries[iface as Count].typeArgs)
	return args
end 'requirementArgs'

// declaresConformance is whether the declaration of t says it implements iface, with t's type arguments in what it binds.
function declaresConformance(mutates p ast.Project, t ast.TypeID, iface ast.TypeID) returns bool
	let orig = ast.originOf(p.types, t: t)
	let conforms = ast.cloneTypeArgs(p.types.entries[orig as Count].conforms)
	let params = ast.cloneTypeArgs(p.types.entries[orig as Count].typeParams)
	let args = ast.typeArgsOf(p.types, t: t)
	for i in 0 upto conforms.count() 'each'
		let have = ast.substituteType(p.types, t: conforms[i], params: params, args: args)
		if ast.extendsInterface(p.types, have: have, want: iface) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'declaresConformance'

// conformanceTo is the instance of the interface origin that the declaration of t says it implements, at t's type
// arguments, or none.
function conformanceTo(mutates p ast.Project, t ast.TypeID, iface ast.TypeID) returns ast.TypeID
	let orig = ast.originOf(p.types, t: t)
	let conforms = ast.cloneTypeArgs(p.types.entries[orig as Count].conforms)
	let params = ast.cloneTypeArgs(p.types.entries[orig as Count].typeParams)
	let args = ast.typeArgsOf(p.types, t: t)
	for i in 0 upto conforms.count() 'each'
		if ast.originOf(p.types, t: conforms[i]) == iface 'hit'
			return ast.substituteType(p.types, t: conforms[i], params: params, args: args)
		end 'hit'
	end 'each'
	return ast.noType
end 'conformanceTo'

function sameSpecs(a ast.ParamSpecList, b ast.ParamSpecList) returns bool
	if a.count() != b.count() 'count'
		return false
	end 'count'
	for i in 0 upto a.count() 'each'
		if a[i].name != b[i].name or a[i].ty != b[i].ty or a[i].conv != b[i].conv 'differs'
			return false
		end 'differs'
	end 'each'
	return true
end 'sameSpecs'

// signatureText is a method as maxon lists it in an incomplete implementation.
function signatureText(p ast.Project, name String, isStatic bool, specs ast.ParamSpecList, ret ast.TypeID, err ast.TypeID) returns String
	var parts = ast.StringList.create(0)
	for i in 0 upto specs.count() 'each'
		if specs[i].conv == ast.Convention.convMutates 'written'
			parts.push("{specs[i].name} mutable {nameOfType(p, t: specs[i].ty)}")
		end 'written' else 'read'
			parts.push("{specs[i].name} {nameOfType(p, t: specs[i].ty)}")
		end 'read'
	end 'each'
	var text = "{name}({ast.joinNames(parts, sep: ", ")}) returns {nameOfType(p, t: ret)}"
	if isStatic 'static'
		text = "static {text}"
	end 'static'
	if err != ast.noType 'throws'
		text = "{text} throws {nameOfType(p, t: err)}"
	end 'throws'
	return text
end 'signatureText'

// verifyBounds checks the type arguments that the module's instances and inferred calls give against their parameters'
// bounds. All the bounds of one argument stop at the first it fails.
export function verifyBounds(mutates c Checker, mutates p ast.Project, bounds PendingBoundList, mutates errs diag.ErrorList)
	var failedSame = false
	for i in 0 upto bounds.count() 'each'
		if i > 0 and failedSame and sameArgument(bounds[i], b: bounds[(try i - 1 otherwise 0 as Count)]) 'skipped'
			continue 'each'
		end 'skipped'
		let mark = errs.count()
		c.boundedFn = bounds[i].withinFn
		requireConforms(c, p: p, off: bounds[i].off, arg: bounds[i].argTy, iface: bounds[i].ifaceTy, param: bounds[i].paramTy, errs: errs)
		failedSame = failedSince(errs, mark: mark)
	end 'each'
end 'verifyBounds'

function sameArgument(a PendingBound, b PendingBound) returns bool
	return a.off == b.off and a.paramTy == b.paramTy and a.argTy == b.argTy and a.hasMethod == b.hasMethod and a.methodFn == b.methodFn
end 'sameArgument'

// requireConforms checks one type argument against one bound of its parameter.
function requireConforms(mutates c Checker, mutates p ast.Project, off diag.U32, arg ast.TypeID, iface ast.TypeID, param ast.TypeID, mutates errs diag.ErrorList)
	let argName = nameOfType(p, t: arg)
	let paramName = nameOfType(p, t: param)
	let ifaceName = p.types.entries[iface as Count].name.clone()
	if p.builtins.isCapability(iface) 'structural'
		let lacking = lacksCap(c, p: p, wantCopy: iface == p.builtins.copyableTy, t: arg)
		if lacking.missing 'lacks'
			let why = lackWhyText(p.types, info: lacking, capName: ifaceName)
			let fix = lackFixText(p.types, info: lacking, capName: ifaceName)
			checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "the type argument '{argName}' for '{paramName}' must be {ifaceName}, but {why}: {fix}", errs: errs)
		end 'lacks'
		return
	end 'structural'
	if typeHasKind(p, t: arg, kind: ast.TypeKind.typeParam) 'parameter'
		if not boundsExtend(p, bounds: boundsOfParam(p, boundedFn: c.boundedFn, paramTy: arg), iface: iface) 'unbounded'
			checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "the type parameter '{argName}' is not known to be {ifaceName}, which the type argument for '{paramName}' must be: add the bound, '{argName} implements {ifaceName}'", errs: errs)
		end 'unbounded'
		return
	end 'parameter'
	if arg != ast.noType and (typeIsNominal(p.types, t: arg) or ast.extensionKey(p, t: arg).isSome()) 'implementable'
		requireDeclared(c, p: p, off: off, arg: arg, iface: iface, param: param, errs: errs)
		return
	end 'implementable'
	checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "'{argName}' must be {ifaceName} for '{paramName}', but only a type, enum or union implements an interface", errs: errs)
end 'requireConforms'

// boundsExtend is whether one of the bounds is the interface iface or extends it.
function boundsExtend(p ast.Project, bounds ast.TypeIDList, iface ast.TypeID) returns bool
	for i in 0 upto bounds.count() 'each'
		if ast.extendsInterface(p.types, have: bounds[i], want: iface) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'boundsExtend'

function typeIn(types ast.TypeIDList, t ast.TypeID) returns bool
	return indexOfType(types, t: t).isSome()
end 'typeIn'

// requireDeclared refuses a nominal type argument whose declaration does not say it implements the interface.
function requireDeclared(c Checker, mutates p ast.Project, off diag.U32, arg ast.TypeID, iface ast.TypeID, param ast.TypeID, mutates errs diag.ErrorList)
	let orig = ast.originOf(p.types, t: arg)
	if declaresConformance(p, t: arg, iface: iface) or implementsByExtension(c, p: p, arg: arg, iface: iface) 'declared'
		return
	end 'declared'
	let argName = nameOfType(p, t: arg)
	let paramName = nameOfType(p, t: param)
	let ifaceName = p.types.entries[iface as Count].name.clone()
	let declared = conformanceTo(p, t: arg, iface: ast.originOf(p.types, t: iface))
	if declared != ast.noType 'disagrees'
		failBindingDisagrees(c, p: p, off: off, arg: arg, declared: declared, iface: iface, param: param, errs: errs)
		return
	end 'disagrees'
	if not typeIsNominal(p.types, t: arg) or (p.types.entries[orig as Count].hasDecl and p.types.entries[orig as Count].decl.module == diag.stdlibID) 'builtIn'
		checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "'{argName}' is built in and implements no interface, so it cannot be {ifaceName} for '{paramName}'; declare 'extension {extensionTargetName(p, t: arg)} implements {spelled(c, p: p, iface: iface)}', or wrap it in a type of your own that declares 'implements {spelled(c, p: p, iface: iface)}'", errs: errs)
		return
	end 'builtIn'
	checkFail(c.modID, off: off, code: diag.errBoundNotMet, msg: "'{argName}' must be {ifaceName} for '{paramName}': declare '{declarationWord(p, t: arg)} {p.types.entries[orig as Count].name} implements {spelled(c, p: p, iface: iface)}'{missingMethods(c, p: p, t: arg, iface: iface)}", errs: errs)
end 'requireDeclared'

// failBindingDisagrees refuses a type argument whose declaration implements the bound's interface, but binds one of its
// associated types otherwise than the bound says.
function failBindingDisagrees(c Checker, mutates p ast.Project, off diag.U32, arg ast.TypeID, declared ast.TypeID, iface ast.TypeID, param ast.TypeID, mutates errs diag.ErrorList)
	let orig = ast.originOf(p.types, t: iface)
	for i in 0 upto p.types.entries[iface as Count].typeArgs.count() 'each'
		let claimed = p.types.entries[iface as Count].typeArgs[i]
		let supplied = p.types.entries[declared as Count].typeArgs[i]
		if claimed != supplied 'differs'
			let associated = p.types.entries[p.types.entries[orig as Count].typeParams[i] as Count].name.clone()
			let msg = diag.boundBindingDisagrees(paramOwnerName(p, param: param), param: nameOfType(p, t: param), claimed: nameOfType(p, t: iface), argName: nameOfType(p, t: arg), interfaceName: p.types.entries[orig as Count].name, associated: associated, supplied: nameOfType(p, t: supplied))
			checkFail(c.modID, off: off, code: diag.errBoundBindingDisagrees, msg: msg, errs: errs)
			return
		end 'differs'
	end 'each'
	panic("'{nameOfType(p, t: arg)}' binds what '{nameOfType(p, t: iface)}' does, yet does not implement it")
end 'failBindingDisagrees'

// paramOwnerName is the name of the generic type or function that declares the type parameter param, for a message.
function paramOwnerName(p ast.Project, param ast.TypeID) returns String
	for i in 0 upto p.types.entries.count() 'types'
		if p.types.entries[i].origin == ast.noType and typeIn(p.types.entries[i].typeParams, t: param) 'type'
			return p.types.entries[i].name.clone()
		end 'type'
	end 'types'
	for i in 0 upto p.funcs.entries.count() 'funcs'
		if typeIn(p.funcs.entries[i].generics, t: param) 'func'
			return p.funcs.entries[i].name.clone()
		end 'func'
	end 'funcs'
	panic("the type parameter '{nameOfType(p, t: param)}' is declared by no type or function")
end 'paramOwnerName'

// extensionTargetName is how an extension names the type t: an integer is `int`.
function extensionTargetName(p ast.Project, t ast.TypeID) returns String
	if p.types.entries[t as Count].kind == ast.TypeKind.intRange 'integer'
		return "int"
	end 'integer'
	return p.types.entries[ast.originOf(p.types, t: t) as Count].name.clone()
end 'extensionTargetName'

// implementsByExtension is whether an extension that the module sees says the type arg implements iface.
function implementsByExtension(c Checker, p ast.Project, arg ast.TypeID, iface ast.TypeID) returns bool
	match consumes ast.extensionKey(p, t: arg) 'key'
		some(owner) then return ast.extensionConforms(p, from: c.modID, owner: owner, iface: iface)
		none then return false
	end 'key'
end 'implementsByExtension'

// spelled is how code in this module names an interface: qualified when another module declares it.
function spelled(c Checker, p ast.Project, iface ast.TypeID) returns String
	let name = p.types.entries[iface as Count].name.clone()
	if not p.types.entries[iface as Count].hasDecl 'none'
		return name
	end 'none'
	let owner = p.types.entries[iface as Count].decl.module
	if owner != c.modID and owner != diag.stdlibID and p.modules[ast.modIndex(owner)].path != "" 'qualified'
		return "{p.modules[ast.modIndex(owner)].path}.{name}"
	end 'qualified'
	return name
end 'spelled'

function declarationWord(p ast.Project, t ast.TypeID) returns String
	let kind = p.types.entries[t as Count].kind
	if kind == ast.TypeKind.record 'record'
		return "type"
	end 'record'
	if kind == ast.TypeKind.enumTy 'enum'
		return "enum"
	end 'enum'
	if kind == ast.TypeKind.unionTy 'union'
		return "union"
	end 'union'
	panic("{ast.typeName(p.types, t: t)} is not declared as a type, enum or union")
end 'declarationWord'

// missingMethods names the methods of the interface that the type lacks, for the error that asks it to declare one.
function missingMethods(c Checker, p ast.Project, t ast.TypeID, iface ast.TypeID) returns String
	var missing = ast.StringList.create(0)
	let reqs = requirementsOf(p, iface: iface)
	for i in 0 upto reqs.count() 'each'
		let sig = reqs[i].sig
		let name = p.funcs.entries[sig as Count].name.clone()
		let m = methodOf(c, p: p, t: t, name: name)
		if m == ast.noFunc or p.funcs.entries[m as Count].isStatic != p.funcs.entries[sig as Count].isStatic 'lacking'
			missing.push(name)
		end 'lacking'
	end 'each'
	if missing.count() == 0 'none'
		return ""
	end 'none'
	return " and add the method(s) {ast.joinNames(missing, sep: ", ")}"
end 'missingMethods'
