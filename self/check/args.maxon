// The arguments of a call: put in the order of the parameters, typed, and bound to them. A function here stops at its first
// error, which its caller finds by comparing the number of errors with the mark it took before.

// funcSymbol is how a message names a function: a method is written with its type, in parentheses where the type is an
// instance, and an instance of a generic function with its type arguments.
function funcSymbol(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f ast.FuncID) returns String
	let name = ast.funcEntry(ft, funcReads: funcReads, f: f).name.clone()
	let owner = ast.funcEntry(ft, funcReads: funcReads, f: f).ownerTy
	if ast.funcEntry(ft, funcReads: funcReads, f: f).extendedIface != ast.noType 'ofInterface'
		return ast.interfaceExtensionSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: f)
	end 'ofInterface'
	if owner == ast.noType 'free'
		if ast.funcEntry(ft, funcReads: funcReads, f: f).genericOrigin != ast.noFunc 'instance'
			var names = ast.StringList.create(0)
			for i in 0 upto ast.funcEntry(ft, funcReads: funcReads, f: f).typeArgs.count() 'args'
				names.push(ast.typeName(tt, reads: reads, t: ast.funcEntry(ft, funcReads: funcReads, f: f).typeArgs[i]))
			end 'args'
			return "{name}[{ast.joinNames(names, sep: ", ")}]"
		end 'instance'
		return name
	end 'free'
	let ownerName = ast.typeName(tt, reads: reads, t: owner)
	if ast.typeEntry(tt, reads: reads, t: owner).typeArgs.count() > 0 'instance'
		return "({ownerName}).{name}"
	end 'instance'
	return "{ownerName}.{name}"
end 'funcSymbol'

// argSlot is the parameter that the index-th argument given stands for: one without a label by its place, every other by its
// label. It is none for a label that names no parameter.
function argSlot(index Count, label String, specs ast.ParamSpecList) returns table.Option with Count
	if label == "" 'positional'
		return table.Option.some(index)
	end 'positional'
	for j in 0 upto specs.count() 'each'
		if specs[j].name == label 'named'
			return table.Option.some(j)
		end 'named'
	end 'each'
	return table.Option.none
end 'argSlot'

// omittedIndex is the place among the arguments of the call of the argument that the call's ordering leaves out (the
// 'dropWith:' of a cown), or none.
function omittedIndex(c Checker, call ast.NodeID) returns table.Option with Count
	if c.hasOmitted and c.omittedCall == call 'omitted'
		return table.Option.some(c.omittedArgIdx)
	end 'omitted'
	return table.Option.none
end 'omittedIndex'

function argumentCount(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID) returns Count
	return ms.tree().listLen(ast.callExprArgsRef(ms.tree(), id: call))
end 'argumentCount'

// positionalName is the name of a parameter of a built-in function that its argument fills by its place, never by a label.
let positionalName = "_"

// failArity reports a call whose arguments do not fit the parameters, counting the receiver of a method as an argument, as maxon does.
function failArity(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, callee String, specs ast.ParamSpecList, given Count, receivers Count, mutates errs diag.ErrorList)
	let expectedCount = try specs.count() + receivers otherwise panic("an argument count overflows")
	let givenCount = try given + receivers otherwise panic("an argument count overflows")
	failAt(c, p: p, ms: ms, node: call, code: diag.errCallArgCountMismatch, msg: diag.argArityMismatch(callee, expected: "{expectedCount}", got: "{givenCount}"), errs: errs)
end 'failArity'

// orderArgs puts a call's arguments in the order of the parameters, which labels name after the first. receivers is 1 for a method called on a value, which maxon counts as an argument in the arity message.
function orderArgs(c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, callee String, specs ast.ParamSpecList, receivers Count, mutates errs diag.ErrorList) returns ast.NodeIDList
	var ordered = ast.NodeIDList.create(0)
	let argsRef = ast.callExprArgsRef(ms.tree(), id: call)
	let total = ms.tree().listLen(argsRef)
	let skipped = omittedIndex(c, call: call)
	var given = total
	if skipped.isSome() 'skips'
		given = try total - 1 otherwise 0 as Count
	end 'skips'
	if given > specs.count() 'arity'
		failArity(c, p: p, ms: ms, call: call, callee: callee, specs: specs, given: given, receivers: receivers, errs: errs)
		return ordered
	end 'arity'
	for _ in 0 upto specs.count() 'slots'
		ordered.push(0 as ast.NodeID)
	end 'slots'
	var seen = 0 as Count
	for ai in 0 upto total 'args'
		if omittedAt(skipped, index: ai) 'left'
			continue 'args'
		end 'left'
		let arg = ms.tree().listAt(argsRef, index: ai) as ast.NodeID
		let label = ast.argLabel(ms.tree(), id: arg)
		var slot = seen
		if seen < specs.count() and specs[seen].name == positionalName 'positional'
			if label != "" 'labelled'
				failAt(c, p: p, ms: ms, node: arg, code: diag.errBuiltinArgNamed, msg: diag.builtinArgNamed(), errs: errs)
				return ordered
			end 'labelled'
		end 'positional' else if seen == 0 and label == "" 'first'
			slot = 0
		end 'first' else if label == "" and seen < specs.count() and specs[seen].mayOmitLabel 'placed'
			if ordered[slot] != 0 'taken'
				failAt(c, p: p, ms: ms, node: arg, code: diag.errCallArgMissingLabel, msg: diag.argMissingLabel(), errs: errs)
				return ordered
			end 'taken'
		end 'placed' else 'labelled'
			if seen == 0 and not specs[0].hasDefault() and not specs[0].labelled 'noDefault'
				failAt(c, p: p, ms: ms, node: arg, code: diag.errCallFirstArgNamed, msg: diag.firstArgNamed(), errs: errs)
				return ordered
			end 'noDefault'
			if label == "" 'unlabelled'
				failAt(c, p: p, ms: ms, node: arg, code: diag.errCallArgMissingLabel, msg: diag.argMissingLabel(), errs: errs)
				return ordered
			end 'unlabelled'
			let found = argSlot(seen, label: label, specs: specs)
			if not found.isSome() 'unknown'
				failAt(c, p: p, ms: ms, node: arg, code: diag.errCallUnknownArgLabel, msg: diag.argUnknownLabel(callee, label: label), errs: errs)
				return ordered
			end 'unknown'
			match consumes found 'slotOf'
				some(j) then slot = j
				none then break
			end 'slotOf'
			if ordered[slot] != 0 'duplicate'
				failAt(c, p: p, ms: ms, node: arg, code: diag.errCallDuplicateArg, msg: diag.argDuplicate(label, callee: callee), errs: errs)
				return ordered
			end 'duplicate'
		end 'labelled'
		ordered[slot] = ast.argValue(ms.tree(), id: arg)
		seen = try seen + 1 otherwise seen
	end 'args'
	for j in 0 upto specs.count() 'required'
		if ordered[j] == 0 and not specs[j].hasDefault() 'missing'
			failArity(c, p: p, ms: ms, call: call, callee: callee, specs: specs, given: given, receivers: receivers, errs: errs)
			return ordered
		end 'missing'
	end 'required'
	return ordered
end 'orderArgs'

function omittedAt(skipped table.Option with Count, index Count) returns bool
	return match skipped 'k'
		some(at) gives at == index
		none gives false
	end 'k'
end 'omittedAt'

// checkedArgs orders a call's arguments and types them, before the parameters' types are known: a generic callee's type
// arguments come from them.
function checkedArgs(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, callee String, specs ast.ParamSpecList, receivers Count, mutates errs diag.ErrorList) returns ast.NodeIDList
	let mark = errs.count()
	let ordered = orderArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: receivers, errs: errs)
	if failedSince(errs, mark: mark) 'badOrder'
		return ordered
	end 'badOrder'
	if c.hasUses 'inBody'
		recordDefaults(c, call: call, specs: specs)
	end 'inBody'
	for i in 0 upto ordered.count() 'each'
		if ordered[i] == 0 'defaulted'
			continue 'each'
		end 'defaulted'
		if checkExpr(c, p: p, ms: ms, e: ordered[i], errs: errs) == ast.noType 'failed'
			return ordered
		end 'failed'
	end 'each'
	return ordered
end 'checkedArgs'

// bindArgs orders a call's arguments and checks each against its parameter, typing it first unless it was typed already.
function bindArgs(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, callee String, specs ast.ParamSpecList, receivers Count, argsChecked bool, payload bool, mutates errs diag.ErrorList) returns ast.NodeIDList
	let mark = errs.count()
	let ordered = orderArgs(c, p: p, ms: ms, call: call, callee: callee, specs: specs, receivers: receivers, errs: errs)
	if failedSince(errs, mark: mark) 'badOrder'
		return ordered
	end 'badOrder'
	if c.hasUses 'inBody'
		recordDefaults(c, call: call, specs: specs)
	end 'inBody'
	for i in 0 upto specs.count() 'each'
		if ordered[i] == 0 'defaulted'
			continue 'each'
		end 'defaulted'
		if not argsChecked 'type'
			if checkExpecting(c, p: p, ms: ms, e: ordered[i], want: specs[i].ty, errs: errs) == ast.noType 'failed'
				return ordered
			end 'failed'
		end 'type'
		if not coerceArg(c, p: p, ms: ms, call: call, value: ordered[i], callee: callee, spec: specs[i], payload: payload, errs: errs) 'badArg'
			return ordered
		end 'badArg'
	end 'each'
	return ordered
end 'bindArgs'

// recordDefaults records a call of a function with a parameter that has a default as a use: a call that leaves the
// argument out runs the default, which is code of the function's module, so finding the instances follows the call to
// the calls of the default (ir.visitDefaults), as lowering lowers it there.
function recordDefaults(mutates c Checker, call ast.NodeID, specs ast.ParamSpecList)
	for i in 0 upto specs.count() 'each'
		if specs[i].defaultExpr != 0 'defaulted'
			recordUse(c, call: call)
			return
		end 'defaulted'
	end 'each'
end 'recordDefaults'

// coerceArg checks an argument against its parameter, which a 'mutates' or 'sets' parameter takes exactly, and a let
// parameter takes the contents of a frozen value for. Any other parameter is given a copy of them, which fix writes,
// where they can be copied.
function coerceArg(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, call ast.NodeID, value ast.NodeID, callee String, spec ast.ParamSpec, payload bool, mutates errs diag.ErrorList) returns bool
	let t = ast.nodeType(c.typing, node: value)
	if spec.byteBuffer and fixedBytes(p, ms: ms, t: t) 'fixedBytes'
		return true
	end 'fixedBytes'
	let temporary = ast.isMutatingFunction(ms.types, reads: p.types, t: spec.ty) and not ast.isStorage(ms.tree(), typing: c.typing, node: value)
	if ast.isByAddress(spec.conv) and not temporary 'byAddress'
		if t != spec.ty 'different'
			let expected = nameOfType(p, ms: ms, t: spec.ty)
			let got = nameOfType(p, ms: ms, t: t)
			var msg = diag.argTypeMismatch("'{spec.name}'", expected: expected, got: got)
			if t != ast.noType and ast.isSubtypeOf(ms.types, reads: p.types, sub: t, sup: spec.ty) 'subtype'
				msg = "{msg}: the callee may write any '{expected}' through a by-reference parameter, which a '{got}' variable cannot hold. Declare the variable or field it names as {expected}, or pass a {expected} local"
			end 'subtype' else if ast.isIntType(ms.types, reads: p.types, t: t) and ast.isIntType(ms.types, reads: p.types, t: spec.ty) 'integers'
				msg = diag.argTypeMismatchCast("'{spec.name}'", expected: expected, got: got)
			end 'integers'
			failAt(c, p: p, ms: ms, node: call, code: diag.errTypeMismatch, msg: msg, errs: errs)
			return false
		end 'different'
		return true
	end 'byAddress'
	if lendsContents(p, ms: ms, t: t, want: spec.ty) 'frozen'
		if spec.conv != ast.Convention.convLet 'keeps'
			var fix = diag.Fix.none()
			if not lacksCap(c, p: p, ms: ms, wantCopy: true, t: spec.ty).missing 'copyable'
				fix = thawFix(ms.tree(), e: value)
			end 'copyable'
			checkFailFixed(c.modID, off: offsetOf(c, p: p, ms: ms, node: value), code: diag.errFrozenChange, msg: "the {spec.conv.keyword()} parameter '{spec.name}' of '{callee}' would change or keep the contents of a frozen value, which are immutable and shared; pass an owned copy: 'thaw(...)'", fix: fix, errs: errs)
			return false
		end 'keeps'
		return true
	end 'frozen'
	if payload 'payload'
		return coerce(c, p: p, ms: ms, node: value, at: closingOffset(c, p: p, ms: ms, call: call), src: t, target: spec.ty, wrong: Mismatch.expectedGot, errs: errs)
	end 'payload'
	return coerce(c, p: p, ms: ms, node: value, at: offsetOf(c, p: p, ms: ms, node: call), src: t, target: spec.ty, wrong: Mismatch.argument(argumentLabel(spec.name)), errs: errs)
end 'coerceArg'

// fixedBytes is whether a type is a FixedArray of bytes, of any count (an argument after the element), which a built-in's byte buffer takes as it takes a
// ByteArray: both are an array's box.
function fixedBytes(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	if t == ast.noType or ast.originOf(ms.types, reads: p.types, t: t) != p.builtins.fixedArrayOrigin 'notFixed'
		return false
	end 'notFixed'
	let entry = ast.typeEntry(ms.types, reads: p.types, t: t)
	return entry.typeArgs.count() > 0 and sameType(ms.types, reads: p.types, a: entry.typeArgs[0], b: p.builtins.byteTy)
end 'fixedBytes'

let asciiZero = 48 as Byte

let asciiNine = 57 as Byte

// argumentLabel is how a message names the parameter that an argument goes to: its name in quotes, or its place for the parameter of a\n// function value, which has no name.
function argumentLabel(name String) returns String
	if name.byteLength() > 0 and name.byteAt(0) >= asciiZero and name.byteAt(0) <= asciiNine 'positional'
		return name.clone()
	end 'positional'
	return "'{name}'"
end 'argumentLabel'

// nameable is whether a type can be written as a type argument, so inference may choose it: an integer constant or the
// range of an expression names no alias.
function nameable(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	if isConstInt(p, ms: ms, t: t) or typeIsAnonInt(ms.types, reads: p.types, t: t) 'integer'
		return false
	end 'integer'
	return t != p.builtins.voidTy and t != p.builtins.neverTy
end 'nameable'

function indexOfType(types ast.TypeIDList, t ast.TypeID) returns table.Option with Count
	for i in 0 upto types.count() 'each'
		if types[i] == t 'hit'
			return table.Option.some(i)
		end 'hit'
	end 'each'
	return table.Option.none
end 'indexOfType'

// unifyType fixes the type parameters that the type of an argument gives, where the parameter's type mentions them.
function unifyType(p ast.Project, ms ast.ModuleState, param ast.TypeID, arg ast.TypeID, params ast.TypeIDList, mutates args ast.TypeIDList)
	if param == ast.noType or arg == ast.noType 'none'
		return
	end 'none'
	let kind = ast.typeKind(ms.types, reads: p.types, t: param)
	if kind == ast.TypeKind.typeParam 'parameter'
		match consumes indexOfType(params, t: param) 'index'
			some(i) then fixArg(p, ms: ms, arg: arg, index: i, args: args)
			none then break
		end 'index'
		return
	end 'parameter'
	if kind == ast.TypeKind.record or kind == ast.TypeKind.unionTy or kind.isBuiltin() 'instance'
		if ast.typeKind(ms.types, reads: p.types, t: arg) == kind and ast.originOf(ms.types, reads: p.types, t: param) == ast.originOf(ms.types, reads: p.types, t: arg) 'sameDeclaration'
			unifyAll(p, ms: ms, param: ast.typeEntry(ms.types, reads: p.types, t: param).typeArgs.clone(), arg: ast.typeEntry(ms.types, reads: p.types, t: arg).typeArgs.clone(), params: params, args: args)
		end 'sameDeclaration'
	end 'instance'
end 'unifyType'

function fixArg(p ast.Project, ms ast.ModuleState, arg ast.TypeID, index Count, mutates args ast.TypeIDList)
	if args[index] == ast.noType and nameable(p, ms: ms, t: arg) 'open'
		args[index] = arg
	end 'open'
end 'fixArg'

function unifyAll(p ast.Project, ms ast.ModuleState, param ast.TypeIDList, arg ast.TypeIDList, params ast.TypeIDList, mutates args ast.TypeIDList)
	for i in 0 upto param.count() 'each'
		if i < arg.count() 'both'
			unifyType(p, ms: ms, param: param[i], arg: arg[i], params: params, args: args)
		end 'both'
	end 'each'
end 'unifyAll'

// unifyBounds fixes the type parameters that a bound binds an associated type to, from what the fixed argument's
// declaration binds it to: 'where S implements Cursor with E' takes E from the 'implements Cursor with ...' of S.
function unifyBounds(p ast.Project, mutates ms ast.ModuleState, params ast.TypeIDList, mutates args ast.TypeIDList)
	for i in 0 upto params.count() 'each'
		let arg = args[i]
		if arg == ast.noType or not typeIsNominal(ms.types, reads: p.types, t: arg) 'open'
			continue 'each'
		end 'open'
		let bounds = ast.typeEntry(ms.types, reads: p.types, t: params[i]).bounds.clone()
		for bi in 0 upto bounds.count() 'bounds'
			let bound = bounds[bi].ifaceTy
			if ast.typeEntry(ms.types, reads: p.types, t: bound).typeArgs.count() == 0 'plain'
				continue 'bounds'
			end 'plain'
			let declared = conformanceTo(p, ms: ms, t: arg, iface: ast.originOf(ms.types, reads: p.types, t: bound))
			if declared != ast.noType 'found'
				unifyAll(p, ms: ms, param: ast.typeEntry(ms.types, reads: p.types, t: bound).typeArgs.clone(), arg: ast.typeEntry(ms.types, reads: p.types, t: declared).typeArgs.clone(), params: params, args: args)
			end 'found'
		end 'bounds'
	end 'each'
end 'unifyBounds'

function openArgs(count Count) returns ast.TypeIDList
	var args = ast.TypeIDList.create(0)
	for _ in 0 upto count 'each'
		args.push(ast.noType)
	end 'each'
	return args
end 'openArgs'

// infer chooses the type arguments of a call from its arguments' types, and the ones they leave open from the type the
// context expects of result, the type the call gives before its type arguments are known. code is the refusal of a call
// that fixes some of them by neither.
function infer(c Checker, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID, callee String, params ast.TypeIDList, specs ast.ParamSpecList, ordered ast.NodeIDList, result ast.TypeID, code String, mutates errs diag.ErrorList) returns ast.TypeIDList
	var args = openArgs(params.count())
	for i in 0 upto specs.count() 'each'
		if ordered[i] == 0 'defaulted'
			continue 'each'
		end 'defaulted'
		unifyType(p, ms: ms, param: specs[i].ty, arg: ast.nodeType(c.typing, node: ordered[i]), params: params, args: args)
	end 'each'
	unifyBounds(p, ms: ms, params: params, args: args)
	return inferRest(c, p: p, ms: ms, node: node, callee: callee, params: params, args: args, result: result, code: code, errs: errs)
end 'infer'

// inferRest fills the type arguments that are still open from the type the context expects of result.
function inferRest(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, callee String, params ast.TypeIDList, args ast.TypeIDList, result ast.TypeID, code String, mutates errs diag.ErrorList) returns ast.TypeIDList
	var filled = args.clone()
	if c.expect != ast.noType 'expected'
		unifyType(p, ms: ms, param: result, arg: c.expect, params: params, args: filled)
	end 'expected'
	for i in 0 upto filled.count() 'each'
		if filled[i] == ast.noType 'open'
			failAt(c, p: p, ms: ms, node: node, code: code.clone(), msg: "the type argument '{ast.typeEntry(ms.types, reads: p.types, t: params[i]).name}' of '{callee}' is fixed neither by the arguments nor by where the result goes: pass an argument whose type names it, use the result where its type is declared (a return, an argument, an assignment), or call it through a typealias of the instance", errs: errs)
			return filled
		end 'open'
	end 'each'
	return filled
end 'inferRest'

// applySpecs is the parameters with the type parameters replaced by the arguments.
function applySpecs(p ast.Project, mutates ms ast.ModuleState, specs ast.ParamSpecList, params ast.TypeIDList, args ast.TypeIDList) returns ast.ParamSpecList
	var out = ast.ParamSpecList.create(0)
	for i in 0 upto specs.count() 'each'
		var spec = specs[i].clone()
		spec.ty = ast.substituteType(ms.types, reads: p.types, t: specs[i].ty, params: params, args: args)
		out.push(spec)
	end 'each'
	return out
end 'applySpecs'

// declares is whether a call of the function is checked now: its signature is known, because this module declares it or
// because it is built in. Another module may still be declaring its own, so a call into it waits for the verify phase.
function declares(c Checker, p ast.Project, ms ast.ModuleState, f ast.FuncID) returns bool
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).module == c.modID or ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f).intrinsic != ast.Intrinsic.intrNone
end 'declares'

// requireVisible refuses a function of another module that the module cannot name.
function requireVisible(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID, target ast.FuncID, mutates errs diag.ErrorList) returns bool
	// The library's elementwise method of an array stands for the array's built-in one, which every module sees
	// (ast.runsBuiltin).
	if declares(c, p: p, ms: ms, f: target) or ast.builtinOfElementwise(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).name) != "" 'declared'
		return true
	end 'declared'
	let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).module
	let level = ast.visibilityOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).visibility)
	if ast.isVisibleFrom(p, v: level, owner: owner, from: c.modID) 'visible'
		return true
	end 'visible'
	failAt(c, p: p, ms: ms, node: node, code: diag.errNotExported, msg: ast.notVisible(p, name: funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: target), v: level, owner: owner, from: c.modID), errs: errs)
	return false
end 'requireVisible'

// queuePending leaves a call of a function that another module declares to the verify phase, which binds its arguments to
// the function's parameters once that module's signatures are known.
function queuePending(mutates c Checker, call ast.NodeID, callee String, fn ast.FuncID, specs ast.ParamSpecList)
	if c.hasUses 'inBody'
		recordDefaults(c, call: call, specs: specs)
	end 'inBody'
	let skipped = omittedIndex(c, call: call)
	var at = 0 as Count
	if skipped.isSome() 'omitted'
		at = c.omittedArgIdx
	end 'omitted'
	c.pendingCalls.push(PendingCall.make(c.modID, callNode: call, calleeName: callee.clone(), fnID: fn, params: specs.clone(), hasOmittedArg: skipped.isSome(), omittedArgIdx: at))
end 'queuePending'

// verifyCalls binds the arguments of the calls into other modules to the parameters of their functions, which those
// modules have declared since the calls were checked. A call stops at its first error.
export function verifyCalls(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, calls PendingCallList, mutates errs diag.ErrorList)
	for i in 0 upto calls.count() 'each'
		verifyCall(c, p: p, ms: ms, pending: calls[i], errs: errs)
	end 'each'
end 'verifyCalls'

function verifyCall(mutates c Checker, p ast.Project, mutates ms ast.ModuleState, pending PendingCall, mutates errs diag.ErrorList)
	c.hasOmitted = pending.hasOmittedArg
	c.omittedCall = pending.callNode
	c.omittedArgIdx = pending.omittedArgIdx
	let mark = errs.count()
	let ordered = bindArgs(c, p: p, ms: ms, call: pending.callNode, callee: pending.calleeName, specs: pending.params, receivers: 0, argsChecked: true, payload: false, errs: errs)
	c.hasOmitted = false
	if failedSince(errs, mark: mark) 'failed'
		return
	end 'failed'
	setCallOrdered(c, call: pending.callNode, ordered: ordered)
end 'verifyCall'

function setCallOrdered(mutates c Checker, call ast.NodeID, ordered ast.NodeIDList)
	match consumes c.typing.calls.get(call as Count) 'info'
		some(known) then c.typing.calls.insert(call as Count, value: withOrdered(known, ordered: ordered))
		none then panic("the call at node {call} was verified without a record of what it is")
	end 'info'
end 'setCallOrdered'

function withOrdered(consumes info ast.CallInfo, ordered ast.NodeIDList) returns ast.CallInfo
	var updated = info
	updated.ordered = ordered.clone()
	return updated
end 'withOrdered'
