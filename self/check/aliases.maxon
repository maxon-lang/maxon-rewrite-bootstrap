typealias DeclRefList = Array with ast.DeclRef

export typealias OrdinalList = Array with ast.DeclOrdinal

let aliasUnvisited = 0 as Byte

let aliasVisiting = 1 as Byte

let aliasDone = 2 as Byte

// AliasWalk is where the aliases stage is in a module's typealiases of instances.
type AliasWalk
	// state is by the typealias's place among the module's declarations.
	export var state as ByteArray
	// path is the typealiases being visited, outermost first.
	export var path as OrdinalList

	static function make(declCount Count) returns AliasWalk
		return AliasWalk{state: ByteArray.create(declCount), path: OrdinalList.create(0)}
	end 'make'
end 'AliasWalk'

// positionIn is where the declaration at ord is among those of a path of declarations that is being visited, or the end
// of the path where it is not.
function positionIn(path OrdinalList, ord ast.DeclOrdinal) returns Count
	for i in 0 upto path.count() 'find'
		if path[i] == ord 'hit'
			return i
		end 'hit'
	end 'find'
	return path.count()
end 'positionIn'

// aliasCycle spells the loop that visiting the typealias at ord closes, from the first alias of path that is it: one
// name for an alias that names itself, else each alias in turn and the first again.
function aliasCycle(m ast.Module, path OrdinalList, ord ast.DeclOrdinal) returns String
	let first = positionIn(path, ord: ord)
	var names = ast.StringList.create(0)
	for i in first upto path.count() 'each'
		names.push(m.decls[path[i] as Count].name())
	end 'each'
	if names.count() > 1 'again'
		names.push(names[0].clone())
	end 'again'
	var buf = ByteArray.create(0)
	for i in 0 upto names.count() 'join'
		if i > 0 'sep'
			buf.append(" -> ".toByteArray())
		end 'sep'
		buf.append(names[i].toByteArray())
	end 'join'
	return String.from(buf)
end 'aliasCycle'

// isInstanceAlias is whether the declaration is a typealias of an instance.
function isInstanceAlias(p ast.Project, ref ast.DeclRef) returns bool
	return match ast.moduleDecl(p, ref: ref) 'd'
		aliasDecl(a) gives ast.aliasNamesInstance(a)
		funcDecl(_) gives false
		constDecl(_) gives false
		typeDecl(_) gives false
		enumDecl(_) gives false
		unionDecl(_) gives false
		interfaceDecl(_) gives false
		extensionDecl(_) gives false
	end 'd'
end 'isInstanceAlias'

function pushIfInstanceAlias(p ast.Project, consumes ref ast.DeclRef, mutates out DeclRefList)
	if isInstanceAlias(p, ref: ref) 'alias'
		out.push(ref)
	end 'alias'
end 'pushIfInstanceAlias'

// namedAliases appends the typealiases of instances that a type reference of the module names, itself or in its type
// arguments.
function namedAliases(p ast.Project, modIdx Count, tr ast.NodeID, mutates out DeclRefList)
	match consumes p.resolutions[modIdx].decls.get(tr as Count) 'bound'
		some(ref) then pushIfInstanceAlias(p, ref: ref, out: out)
		none then _ = 0
	end 'bound'
	let argsRef = ast.typeRefTypeArgsRef(p.modules[modIdx].tree, id: tr)
	for i in 0 upto p.modules[modIdx].tree.listLen(argsRef) 'args'
		namedAliases(p, modIdx: modIdx, tr: p.modules[modIdx].tree.listAt(argsRef, index: i) as ast.NodeID, out: out)
	end 'args'
	let elemsRef = ast.typeRefElemsRef(p.modules[modIdx].tree, id: tr)
	for i in 0 upto p.modules[modIdx].tree.listLen(elemsRef) 'elems'
		namedAliases(p, modIdx: modIdx, tr: p.modules[modIdx].tree.listAt(elemsRef, index: i) as ast.NodeID, out: out)
	end 'elems'
end 'namedAliases'

// aliasSelf is the type that 'Self' names in the target of a typealias: the type whose body or extension declares it, at its own
// parameters, or none for a typealias of the module.
function aliasSelf(c Checker, mutates p ast.Project, a ast.AliasDecl, ref ast.DeclRef) returns ast.TypeID
	if ast.isExtensionAlias(p.modules[c.modIdx], ordinal: ref.ordinal) 'extension'
		return ast.selfType(p.types, declTy: ast.extendedBy(p, ref: ref))
	end 'extension'
	match consumes ast.nestedAliasOwner(a.name) 'owner'
		some(ownerName) then return selfOfOwner(c, p: p, ownerName: ownerName)
		none then return ast.noType
	end 'owner'
end 'aliasSelf'

function selfOfOwner(c Checker, mutates p ast.Project, ownerName String) returns ast.TypeID
	match consumes p.modules[c.modIdx].names.get(ownerName) 'declared'
		some(ord) then return selfOfDecl(p, ref: ast.DeclRef.make(c.modID, ordinal: ord))
		none then panic("the owner '{ownerName}' of a nested typealias is not declared")
	end 'declared'
end 'selfOfOwner'

function selfOfDecl(mutates p ast.Project, ref ast.DeclRef) returns ast.TypeID
	match consumes ast.declType(p, ref: ref) 'type'
		some(tid) then return ast.selfType(p.types, declTy: tid)
		none then panic("the declaration at ordinal {ref.ordinal} has no type")
	end 'type'
end 'selfOfDecl'

// funcTypeRefs are the type references a function type names: its parameters' types and its result's.
function funcTypeRefs(p ast.Project, modIdx Count, fn ast.NodeID) returns ast.NodeIDList
	var out = ast.NodeIDList.create(0)
	let paramsRef = ast.funcTypeParamsRef(p.modules[modIdx].tree, id: fn)
	for i in 0 upto p.modules[modIdx].tree.listLen(paramsRef) 'params'
		out.push(ast.funcTypeParamType(p.modules[modIdx].tree, id: p.modules[modIdx].tree.listAt(paramsRef, index: i) as ast.NodeID))
	end 'params'
	let ret = ast.funcTypeReturns(p.modules[modIdx].tree, id: fn)
	if ret != 0 'returns'
		out.push(ret)
	end 'returns'
	return out
end 'funcTypeRefs'

// declareFuncAlias gives a typealias of a function type its type. One at the top of a module, or in the body of a type or an
// extension that is not generic, is a brand, as in maxon: a name an author chose to tell two shapes apart. One in the body of
// a generic type spells the signature that its instances share, and is not.
function declareFuncAlias(mutates c Checker, mutates p ast.Project, a ast.AliasDecl, ref ast.DeclRef, mutates errs diag.ErrorList)
	let selfTy = aliasSelf(c, p: p, a: a, ref: ref)
	let paramsRef = ast.funcTypeParamsRef(p.modules[c.modIdx].tree, id: a.fn)
	var params = ast.TypeIDList.create(0)
	var convs = ast.ConventionList.create(0)
	for i in 0 upto p.modules[c.modIdx].tree.listLen(paramsRef) 'params'
		let param = p.modules[c.modIdx].tree.listAt(paramsRef, index: i) as ast.NodeID
		let t = resolveTypeRef(c, p: p, tr: ast.funcTypeParamType(p.modules[c.modIdx].tree, id: param), selfTy: selfTy, errs: errs)
		if t == ast.noType 'failed'
			return
		end 'failed'
		params.push(t)
		convs.push(ast.parseConvention(ast.funcTypeParamConvention(p.modules[c.modIdx].tree, id: param)))
	end 'params'
	var result = p.builtins.voidTy
	let ret = ast.funcTypeReturns(p.modules[c.modIdx].tree, id: a.fn)
	if ret != 0 'returns'
		result = resolveTypeRef(c, p: p, tr: ret, selfTy: selfTy, errs: errs)
		if result == ast.noType 'failed'
			return
		end 'failed'
	end 'returns'
	var shape = ast.FuncShape.make(convs, mutatesCaptures: ast.funcTypeCapturesRef(p.modules[c.modIdx].tree, id: a.fn) != 0)
	if selfTy == ast.noType or p.types.entries[ast.typeIndex(ast.originOf(p.types, t: selfTy))].typeParams.count() == 0 'brand'
		shape.brand = ast.FuncBrand.make("{ast.declKey(ref)}", name: a.name.clone())
	end 'brand'
	let t = ast.internFuncType(p.types, params: params, shape: shape, result: result)
	ast.setDeclType(p, ref: ref, t: t)
end 'declareFuncAlias'

// declareAlias gives a typealias of an instance its type, the instance, once every typealias it names has its own.
function declareAlias(mutates c Checker, mutates p ast.Project, a ast.AliasDecl, ref ast.DeclRef, mutates errs diag.ErrorList)
	c.bareNumbers = true
	declareAliasType(c, p: p, a: a, ref: ref, errs: errs)
	c.bareNumbers = false
end 'declareAlias'

// declareAliasType is declareAlias with a bare 'int' or 'float' meaning the full range of its kind.
function declareAliasType(mutates c Checker, mutates p ast.Project, a ast.AliasDecl, ref ast.DeclRef, mutates errs diag.ErrorList)
	if a.fn != 0 'function'
		declareFuncAlias(c, p: p, a: a, ref: ref, errs: errs)
		return
	end 'function'
	let off = p.modules[c.modIdx].tree.startOf(a.instance)
	if not ast.typeRefIsTuple(p.modules[c.modIdx].tree, id: a.instance) and p.modules[c.modIdx].tree.listLen(ast.typeRefTypeArgsRef(p.modules[c.modIdx].tree, id: a.instance)) == 0 'plain'
		let target = ast.typeRefName(p.modules[c.modIdx].tree, id: a.instance)
		checkFail(c.modID, off: off, code: diag.errAliasTarget, msg: "a typealias names an integer range, as 'int(0 to 9)', or an instance of a generic type, as 'Box with Count'; write '{target}' itself where '{a.name}' is used", errs: errs)
		return
	end 'plain'
	let selfTy = aliasSelf(c, p: p, a: a, ref: ref)
	let t = resolveTypeRef(c, p: p, tr: a.instance, selfTy: selfTy, errs: errs)
	if t != ast.noType 'named'
		ast.setDeclType(p, ref: ref, t: t)
	end 'named'
end 'declareAliasType'

// visitAlias declares the typealias at ord after the typealiases it names, and refuses one that names itself through
// others. Its own failure leaves it without a type, which the typealiases that name it find.
function visitAlias(mutates w AliasWalk, mutates c Checker, mutates p ast.Project, ord ast.DeclOrdinal, mutates errs diag.ErrorList)
	let st = w.state[ord as Count]
	if st == aliasDone 'done'
		return
	end 'done'
	if st == aliasVisiting 'cycle'
		let off = p.modules[c.modIdx].decls[ord as Count].offset(p.modules[c.modIdx].tree)
		checkFail(c.modID, off: off, code: diag.errDependsOnItself, msg: diag.circularTypealias(aliasCycle(p.modules[c.modIdx], path: w.path, ord: ord)), errs: errs)
		return
	end 'cycle'
	w.state[ord as Count] = aliasVisiting
	w.path.push(ord)
	declareVisitedAlias(w, c: c, p: p, ord: ord, errs: errs)
	w.state[ord as Count] = aliasDone
	try w.path.pop() otherwise ignore
end 'visitAlias'

function declareVisitedAlias(mutates w AliasWalk, mutates c Checker, mutates p ast.Project, ord ast.DeclOrdinal, mutates errs diag.ErrorList)
	let ref = ast.DeclRef.make(c.modID, ordinal: ord)
	var a as ast.AliasDecl
	match p.modules[c.modIdx].decls[ord as Count].clone() 'k'
		aliasDecl(ad) then a = ad.clone()
		funcDecl(_) then panic("the aliases stage visited a function")
		constDecl(_) then panic("the aliases stage visited a constant")
		typeDecl(_) then panic("the aliases stage visited a type")
		enumDecl(_) then panic("the aliases stage visited an enum")
		unionDecl(_) then panic("the aliases stage visited a union")
		interfaceDecl(_) then panic("the aliases stage visited an interface")
		extensionDecl(_) then panic("the aliases stage visited an extension")
	end 'k'
	var named = DeclRefList.create(0)
	if a.fn != 0 'function'
		let refs = funcTypeRefs(p, modIdx: c.modIdx, fn: a.fn)
		for i in 0 upto refs.count() 'refs'
			namedAliases(p, modIdx: c.modIdx, tr: refs[i], out: named)
		end 'refs'
	end 'function' else 'instance'
		namedAliases(p, modIdx: c.modIdx, tr: a.instance, out: named)
	end 'instance'
	for i in 0 upto named.count() 'deps'
		let dep = named[i].clone()
		if dep.module == c.modID 'own'
			visitAlias(w, c: c, p: p, ord: dep.ordinal, errs: errs)
		end 'own'
		if not ast.declType(p, ref: dep).isSome() 'failed'
			return
		end 'failed'
	end 'deps'
	declareAlias(c, p: p, a: a, ref: ref, errs: errs)
end 'declareVisitedAlias'

// declareAliases gives each typealias of an instance that the module declares its type, after the typealiases it names.
// A typealias of another module that it names is done already: the module graph has no cycle, and the module's aliases
// stage waits for those of the modules it names. The module's own go in source order, each after the ones it names, and
// a typealias that names itself through others is refused.
export function declareAliases(mutates c Checker, mutates p ast.Project, mutates errs diag.ErrorList)
	declareExtensionAliases(c, p: p, errs: errs)
	bindMemberRefs(c, p: p, errs: errs)
	var w = AliasWalk.make(p.modules[c.modIdx].decls.count())
	for i in 0 upto p.modules[c.modIdx].decls.count() 'each'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many declarations")
		if isInstanceAlias(p, ref: ast.DeclRef.make(c.modID, ordinal: ord)) and not ast.isRefusedExtensionAlias(p.modules[c.modIdx], ordinal: ord) 'alias'
			visitAlias(w, c: c, p: p, ord: ord, errs: errs)
		end 'alias'
	end 'each'
	for i in 0 upto p.modules[c.modIdx].decls.count() 'supertypes'
		match p.modules[c.modIdx].decls[i].clone() 'k'
			aliasDecl(ad) then declareSupertype(c, p: p, a: ad, ref: ast.DeclRef.make(c.modID, ordinal: try i as ast.DeclOrdinal otherwise panic("too many declarations")), errs: errs)
			funcDecl(_) then _ = 0
			constDecl(_) then _ = 0
			typeDecl(_) then _ = 0
			enumDecl(_) then _ = 0
			unionDecl(_) then _ = 0
			interfaceDecl(_) then _ = 0
			extensionDecl(_) then _ = 0
		end 'k'
	end 'supertypes'
end 'declareAliases'

// declareSupertype links a ranged typealias to the one it implements, which holds its range over the same primitive and
// signedness. The typealiases of the modules it names have their links already, so a chain that comes back to the
// typealias is found within its module.
function declareSupertype(mutates c Checker, mutates p ast.Project, a ast.AliasDecl, ref ast.DeclRef, mutates errs diag.ErrorList)
	if a.parent == 0 'none'
		return
	end 'none'
	var own = ast.noType
	match ast.declType(p, ref: ref) 'own'
		some(t) then own = t
		none then return
	end 'own'
	let off = p.modules[c.modIdx].tree.startOf(a.parent)
	let parentName = ast.typeRefName(p.modules[c.modIdx].tree, id: a.parent)
	var parent = ast.noType
	match p.resolutions[c.modIdx].decls.get(a.parent as Count) 'named'
		some(pref) then parent = declTypeOrNone(p, ref: pref)
		none then return
	end 'named'
	if parent == ast.noType or not isRangedAlias(p, t: parent) 'notRanged'
		checkFail(c.modID, off: off, code: diag.errExpectedType, msg: diag.notARangedAlias(parentName), errs: errs)
		return
	end 'notRanged'
	let ownKind = rangePrimitiveName(p, t: own)
	let parentKind = rangePrimitiveName(p, t: parent)
	if ownKind != parentKind 'primitive'
		checkFail(c.modID, off: off, code: diag.errAliasRangeDoesNotFit, msg: diag.implementsPrimitiveDiffers(a.name, parentName: parentName, own: ownKind, parents: parentKind), errs: errs)
		return
	end 'primitive'
	if not rangeInside(p, inner: own, outer: parent) 'outside'
		checkFail(c.modID, off: off, code: diag.errAliasRangeDoesNotFit, msg: diag.implementsRangeDoesNotFit(a.name, parentName: parentName), errs: errs)
		return
	end 'outside'
	if parent == own or ast.isSubtypeOf(p.types, sub: parent, sup: own) 'cycle'
		checkFail(c.modID, off: p.modules[c.modIdx].tree.reportStartOf(a.id), code: diag.errResolutionCycle, msg: diag.aliasCycle(a.name), errs: errs)
		return
	end 'cycle'
	p.types.entries[ast.typeIndex(own)].supertype = parent
end 'declareSupertype'

function declTypeOrNone(p ast.Project, ref ast.DeclRef) returns ast.TypeID
	match ast.declType(p, ref: ref) 'dt'
		some(t) then return t
		none then return ast.noType
	end 'dt'
end 'declTypeOrNone'

// isRangedAlias is whether t is a typealias of an int or a float range.
function isRangedAlias(p ast.Project, t ast.TypeID) returns bool
	let kind = p.types.entries[ast.typeIndex(t)].kind
	return (kind == ast.TypeKind.intRange or kind == ast.TypeKind.floatRange) and p.types.entries[ast.typeIndex(t)].name != ""
end 'isRangedAlias'

// rangePrimitiveName is the primitive a ranged alias is over, as maxon words it: an int range is unsigned when it holds
// no negative value.
function rangePrimitiveName(p ast.Project, t ast.TypeID) returns String
	if p.types.entries[ast.typeIndex(t)].kind == ast.TypeKind.floatRange 'float'
		return "a `float` range"
	end 'float'
	if p.types.entries[ast.typeIndex(t)].minVal.isNeg() 'signed'
		return "a signed `int` range"
	end 'signed'
	return "an unsigned `int` range"
end 'rangePrimitiveName'

function rangeInside(p ast.Project, inner ast.TypeID, outer ast.TypeID) returns bool
	if p.types.entries[ast.typeIndex(inner)].kind == ast.TypeKind.floatRange 'float'
		return ast.floatRangeCovers(p.types, dst: outer, src: inner)
	end 'float'
	return intRangeCovers(p.types, dst: outer, src: inner)
end 'rangeInside'
