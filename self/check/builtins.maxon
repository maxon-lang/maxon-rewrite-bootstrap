// hasZero is whether the word 0 is a value of t, so that a slot nothing wrote holds one: an integer whose range takes 0, or
// a bool. A managed value, a slot key, an enum (whose 0 is its first case, not its case of raw value 0) and a type parameter
// have none.
function hasZero(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	if t == p.builtins.boolTy 'bool'
		return true
	end 'bool'
	if typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.floatRange) 'float'
		return ast.floatRangeHolds(ms.types, reads: p.types, t: t, bits: 0)
	end 'float'
	if typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.enumTy) 'enum'
		return enumZeroIsRawZero(p, ms: ms, t: t)
	end 'enum'
	return typeHasKind(p, ms: ms, t: t, kind: ast.TypeKind.intRange) and ast.typeEntry(ms.types, reads: p.types, t: t).minVal.le(ast.I128.zero()) and ast.typeEntry(ms.types, reads: p.types, t: t).maxVal.ge(ast.I128.zero())
end 'hasZero'

// enumZeroIsRawZero is whether the zero word of the enum t is the case maxon fills a zeroed slot with, its case of raw
// value 0: a slot holds a case's ordinal, so the zero word is the first case, which is the case of raw value 0 when no
// case writes a raw value.
function enumZeroIsRawZero(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let n = ast.typeEntry(ms.types, reads: p.types, t: t).cases.count()
	if n == 0 'noCases'
		return false
	end 'noCases'
	for i in 0 upto n 'cases'
		if ast.typeEntry(ms.types, reads: p.types, t: t).cases[i].hasRaw or ast.typeEntry(ms.types, reads: p.types, t: t).cases[i].payload.count() > 0 'written'
			return false
		end 'written'
	end 'cases'
	return true
end 'enumZeroIsRawZero'

// checkArrayCreateArgs refuses Array.create(n) of an element that has no zero value, whose n slots would hold no element,
// unless n is the literal 0. A generic body is checked once, so an element of a type parameter has no zero there.
function checkArrayCreateArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let count = ordered[0]
	if ms.tree().kindOf(count) == ast.NodeKind.intLit and ast.intLitMagnitude(ms.tree(), id: count).isZero() 'empty'
		return
	end 'empty'
	let elem = callElement(c, call: call)
	if hasZero(p, ms: ms, t: elem) 'zero'
		return
	end 'zero'
	let name = nameOfType(p, ms: ms, t: elem)
	if typeHasKind(p, ms: ms, t: elem, kind: ast.TypeKind.typeParam) 'parameter'
		failAt(c, p: p, ms: ms, node: count, code: diag.errZeroOutsideElement, msg: "'create(n)' cannot publish zeroed slots of a type parameter: '{name}' may be instantiated with a type that has no zero value (a managed type, a slot key, an enum, or a ranged alias that excludes 0). Create it empty with 'create(0)' and append with 'push(value)'", errs: errs)
		return
	end 'parameter'
	failAt(c, p: p, ms: ms, node: count, code: diag.errZeroOutsideElement, msg: "'create(n)' cannot publish zeroed slots of '{name}': zero is not a value of '{name}'. Create it empty with 'create(0)' and append with 'push(value)'", errs: errs)
end 'checkArrayCreateArgs'

// checkArrayCreateZeroedArgs holds the flag of Array.create(n, zeroed:) to a literal true or false, as maxon does, and gives
// zeroed: true the refusal of create(n) of an element that has no zero value.
function checkArrayCreateZeroedArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let flag = ordered[1]
	if ms.tree().kindOf(flag) != ast.NodeKind.boolLit 'computed'
		failAt(c, p: p, ms: ms, node: flag, code: diag.errExpressionError, msg: "'zeroed:' is the literal true or false: 'create(n, zeroed: false)' makes an empty array with room for n elements, and 'create(n, zeroed: true)' n zero elements", errs: errs)
		return
	end 'computed'
	if ast.boolLitValue(ms.tree(), id: flag) 'zeroed'
		checkArrayCreateArgs(c, p: p, ms: ms, call: call, ordered: ordered, errs: errs)
	end 'zeroed'
end 'checkArrayCreateZeroedArgs'

// checkRawCallImportArgs refuses a DLL import named by anything but a string literal: the name is the import's entry in
// the executable's import table, which the link fixes, so it is never computed.
function checkRawCallImportArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let name = ordered[0]
	if isPlainStringLiteral(c, p: p, ms: ms, node: name) 'literal'
		return
	end 'literal'
	failAt(c, p: p, ms: ms, node: name, code: diag.errExpressionError, msg: "a DLL import is named by a string literal, as in '__Raw.callImport1(\"ExitProcess\", arg1: code)'", errs: errs)
end 'checkRawCallImportArgs'

// checkRawCodeAddressArgs refuses a function named by anything but a string literal, or by a name that the module does
// not declare a function by: the address is the function's symbol, which the link fixes, so it is never computed.
function checkRawCodeAddressArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let name = ordered[0]
	if not isPlainStringLiteral(c, p: p, ms: ms, node: name) 'computed'
		failAt(c, p: p, ms: ms, node: name, code: diag.errExpressionError, msg: "the function whose code is wanted is named by a string literal, as in '__Raw.codeAddress(\"workerMain\")'", errs: errs)
		return
	end 'computed'
	let text = ast.strPartsText(ms.tree(), partsRef: ast.strLitPartsRef(ms.tree(), id: name))
	if ast.functionNamed(p, ms: ms, module: p.modules[c.modIdx].id, name: text) == ast.noFunc 'missing'
		failAt(c, p: p, ms: ms, node: name, code: diag.errUnknownFunction, msg: "this module declares no function '{text}': name a function it declares at its top level", errs: errs)
	end 'missing'
end 'checkRawCodeAddressArgs'

// isPlainStringLiteral is whether the node is a string literal with no interpolation, whose text is known to the compile.
function isPlainStringLiteral(c Checker, p ast.Project, ms ast.ModuleState, node ast.NodeID) returns bool
	return ms.tree().kindOf(node) == ast.NodeKind.strLit and ms.tree().strIsPlain(ast.strLitPartsRef(ms.tree(), id: node))
end 'isPlainStringLiteral'

// callElement is the element type of the array that the call at node is a call on.
function callElement(c Checker, call ast.NodeID) returns ast.TypeID
	return c.typing.calls.expect(call as Count, what: "call").typeArgs[0]
end 'callElement'

// checkArrayResizeArgs refuses Array.resize(n) of an element that has no zero value: growing would publish slots that hold no
// element. It refuses the whole call, since n is not known to grow, which is why truncate exists.
function checkArrayResizeArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let elem = callElement(c, call: call)
	if hasZero(p, ms: ms, t: elem) 'zero'
		return
	end 'zero'
	let name = nameOfType(p, ms: ms, t: elem)
	// The library tiers keep slot tables, whose slots of a managed element are empty until filled (ir.SlotRead), as maxon's
	// library body is the one generic body that may grow an array of its type parameter.
	if typeHasKind(p, ms: ms, t: elem, kind: ast.TypeKind.typeParam) and p.modules[c.modIdx].inLibraryTier() 'slotTable'
		return
	end 'slotTable'
	if typeHasKind(p, ms: ms, t: elem, kind: ast.TypeKind.typeParam) 'parameter'
		failAt(c, p: p, ms: ms, node: call, code: diag.errZeroOutsideElement, msg: "'resize' cannot grow an array of a type parameter: '{name}' is instantiated with a type that has no zero value (a managed type, an enum or union whose raw values include no 0, or a ranged alias that excludes 0), so the grown slots are zero and zero is not a value of it. Append with 'push(value)' or 'growFilled(n, value:)'", errs: errs)
		return
	end 'parameter'
	if ast.isManagedType(ms.types, reads: p.types, t: elem) 'managed'
		failAt(c, p: p, ms: ms, node: call, code: diag.errZeroOutsideElement, msg: "'resize' cannot grow an array of '{name}': a grown slot holds NO element — Maxon has no default constructor — so 'count()' would not agree with 'get()'. Append with 'push(value)'", errs: errs)
		return
	end 'managed'
	failAt(c, p: p, ms: ms, node: call, code: diag.errZeroOutsideElement, msg: "'resize' cannot grow an array of '{name}': the grown slots are zero and zero is not a value of '{name}'. Append with 'push(value)' or 'growFilled(n, value:)'", errs: errs)
end 'checkArrayResizeArgs'

// checkElementsComparable refuses a method that compares elements, for an element that this compiler cannot compare: it
// compares integers, bools, enums and strings, and has no Equatable interface for any other type yet.
function checkElementsComparable(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, method String, mutates errs diag.ErrorList)
	let elem = callElement(c, call: call)
	if typeHasKind(p, ms: ms, t: elem, kind: ast.TypeKind.intRange) or typeHasKind(p, ms: ms, t: elem, kind: ast.TypeKind.primBool) or typeHasKind(p, ms: ms, t: elem, kind: ast.TypeKind.primString) or typeHasKind(p, ms: ms, t: elem, kind: ast.TypeKind.enumTy) 'comparable'
		return
	end 'comparable'
	failAt(c, p: p, ms: ms, node: call, code: diag.errUnsupportedFeature, msg: "Unsupported: '{method}' on an array of '{nameOfType(p, ms: ms, t: elem)}': only an array of integers, bools, enums or strings compares its elements, since there is no Equatable interface yet", errs: errs)
end 'checkElementsComparable'

// checkArrayAwaitAnyArgs refuses awaitAny on an array whose elements are not promises, which has no such method, as maxon's
// has none.
function checkArrayAwaitAnyArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	let elem = callElement(c, call: call)
	if not ast.isPromiseType(ms.types, reads: p.types, t: elem) 'notPromises'
		failAt(c, p: p, ms: ms, node: call, code: diag.errUnknownFunction, msg: undefinedFunctionText("Array with {nameOfType(p, ms: ms, t: elem)}.awaitAny"), errs: errs)
	end 'notPromises'
end 'checkArrayAwaitAnyArgs'

function checkArrayContainsArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	checkElementsComparable(c, p: p, ms: ms, call: call, method: "contains", errs: errs)
end 'checkArrayContainsArgs'

function checkArrayContainsSequenceArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	checkElementsComparable(c, p: p, ms: ms, call: call, method: "containsSequence", errs: errs)
end 'checkArrayContainsSequenceArgs'

function checkArrayEqualsArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	checkElementsComparable(c, p: p, ms: ms, call: call, method: "equals", errs: errs)
end 'checkArrayEqualsArgs'

// orderedWordWidths are the widths in bytes that maxon's ordered-word intrinsics move in one access.
let orderedWordWidthTwo = 2 as Count

let orderedWordWidthFour = 4 as Count

let orderedWordWidthEight = 8 as Count

// checkReadBigEndianArgs and the others of the ordered words refuse a width that is not the literal 2, 4 or 8, as maxon's
// do: the width picks the access, which is fixed where the call is compiled.
function checkReadBigEndianArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	checkOrderedWordWidth(c, p: p, ms: ms, method: "__Builtins.readBigEndian", width: ordered[2], errs: errs)
end 'checkReadBigEndianArgs'

function checkReadLittleEndianArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	checkOrderedWordWidth(c, p: p, ms: ms, method: "__Builtins.readLittleEndian", width: ordered[2], errs: errs)
end 'checkReadLittleEndianArgs'

function checkAppendBigEndianArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	checkOrderedWordWidth(c, p: p, ms: ms, method: "__Builtins.appendBigEndian", width: ordered[2], errs: errs)
end 'checkAppendBigEndianArgs'

function checkAppendLittleEndianArgs(mutates c Checker, p ast.Project, ms ast.ModuleState, call ast.NodeID, ordered ast.NodeIDList, mutates errs diag.ErrorList)
	checkOrderedWordWidth(c, p: p, ms: ms, method: "__Builtins.appendLittleEndian", width: ordered[2], errs: errs)
end 'checkAppendLittleEndianArgs'

// checkOrderedWordWidth refuses a width that is not the literal 2, 4 or 8, in maxon's words.
function checkOrderedWordWidth(mutates c Checker, p ast.Project, ms ast.ModuleState, method String, width ast.NodeID, mutates errs diag.ErrorList)
	if ms.tree().kindOf(width) != ast.NodeKind.intLit 'computed'
		failAt(c, p: p, ms: ms, node: width, code: diag.errTypeMismatch, msg: "'{method}' requires a constant width of 2, 4 or 8, but its argument is a value not known at compile time", errs: errs)
		return
	end 'computed'
	let value = ast.intLitValue(ms.tree(), id: width)
	let known = value.eq(ast.I128.fromCount(orderedWordWidthTwo)) or value.eq(ast.I128.fromCount(orderedWordWidthFour)) or value.eq(ast.I128.fromCount(orderedWordWidthEight))
	if not known 'width'
		failAt(c, p: p, ms: ms, node: width, code: diag.errTypeMismatch, msg: "'{method}' requires a constant width of 2, 4 or 8, but its argument is {value.toString()}", errs: errs)
	end 'width'
end 'checkOrderedWordWidth'
