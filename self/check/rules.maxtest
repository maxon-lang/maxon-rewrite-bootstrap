// The rules of the range analysis, checked by brute force against what the operations do to values. Each rule is the
// function the walk calls; each case is an abstract state over a small universe, an operation, and every concrete
// valuation the state describes: whatever the state after the rule claims must hold of every value the operation can
// give. A rule that claims more than the values allow fails here before it reaches a program.
//
// The universe has three quantities: a, an integer local; count(c), the count of an array local c; and count(g.0), the
// count of an array in field 0 of a record local g. Field 0 of c stands for an array's '__ManagedMemory' storage, and
// field 1 of g for a sibling of g.0. A fourth, g.0, an integer at the path of that array, has a test of its own, so that a
// fact on a count is never taken for a fact on what lives at its collection's path; the others hold it at 0, since none
// of their facts or operations names it. A fifth, n, a second integer local, is what a binding 'let n = c.count()' and the
// guards and assignments with offsets relate to the others; the tests of the other rules hold it at 0 too. Values before an
// operation are 0 to universeTop; an operation may move them to universeTop + spill, which is as far as the rules' amounts
// reach (a grow of unknown amount is sampled to there: the rules are linear, so a fact broken further out is broken by a
// smaller step of the same case).
//
// Besides the facts a state holds, what the analysis derives from them is checked as a claim of its own: least, how far
// apart two quantities are along chains of relations, for every pair, and tightened, the span of each quantity cut by its
// relations.

let universeTop = 2 as Count

let spill = 2 as Count

let quantities = 5 as Count

// The counts are the quantities from firstCount until pastCounts: count(c) and count(g.0).
let firstCount = 1 as Count

let pastCounts = 3 as Count

// atCollection is the quantity that lives at the path of the collection g.0 and is not its count.
let atCollection = 3 as Count

// second is the quantity n, the local in slot 3.
let second = 4 as Count

// wrapWord is how many values the word of a sum computed modulo the word holds in the universe: a sum of a quantity and an
// offset reaches past it, as one of bits(64) reaches past 2^64.
let wrapWord = 3 as Count

typealias Ints = Array with Count

typealias Strings = Array with String

typealias Effects = Array with ast.CountEffect

typealias Gaps = Array with ast.I128

// heldAtCollection and heldSecond are the bits by which Universe.holding holds g.0 and n still.
let heldAtCollection = 8 as Count

let heldSecond = 16 as Count

// Op is an operation on the universe: a guard that holds, a call's count effect on a collection, a write, an assignment,
// the top of a loop where what may be assigned is forgotten, the success of a pop or of a remove at the index the quantity
// index holds, which the analysis proves or not, or a binding of target to the midpoint 'low + (high - low) / 2'. A guard
// with offsets says 'x + dx op y + dy', its sums computed modulo wrapWord where wraps says so; a binding gives target the
// value of source + k.
union Op
	compare(x Count, op String, y Count)
	constant(x Count, op String, k Count)
	shifted(x Count, dx FullRangeInt, op String, y Count, dy FullRangeInt, wraps bool)
	empty(q Count, truth bool)
	effect(holder Count, effect ast.CountEffect)
	write(holder Count)
	assign(target Count, k Count)
	assignAny(target Count)
	bind(target Count, source Count, k FullRangeInt)
	forget(mask Count)
	pop(holder Count)
	removeAt(holder Count, index Count)
	midpoint(target Count, low Count, high Count)
end 'Op'

typealias Ops = Array with Op

// quantityPlace is the place the analysis follows for a quantity.
function quantityPlace(q Count) returns Place
	if q == 0 'a'
		return Place.local(0 as Count)
	end 'a'
	if q == 1 'countC'
		return placeCount(Place.local(1 as Count))
	end 'countC'
	if q == 2 'countG'
		return placeCount(placeField(Place.local(2 as Count), field: 0 as Count).unwrap())
	end 'countG'
	if q == atCollection 'atG'
		return placeField(Place.local(2 as Count), field: 0 as Count).unwrap()
	end 'atG'
	if q == second 'n'
		return Place.local(3 as Count)
	end 'n'
	panic("rules: no quantity {q}")
end 'quantityPlace'

// quantityPlaces are the places of the quantities, by quantity.
function quantityPlaces() returns PlaceList
	var out = PlaceList.create(0)
	for q in 0 upto quantities 'each'
		out.push(quantityPlace(q))
	end 'each'
	return out
end 'quantityPlaces'

// quantityIn is the quantity a fact names, among places, as quantityOf tells it.
function quantityIn(p Place, places PlaceList) returns Count
	for q in 0 upto quantities 'each'
		if places[q].samePath(p) and places[q].counted == p.counted 'found'
			return q
		end 'found'
	end 'each'
	panic("rules: a fact names a place outside the universe")
end 'quantityIn'

// isLocalQuantity is whether a quantity is a local, whose span a state holds by its slot.
function isLocalQuantity(q Count) returns bool
	return q == 0 or q == second
end 'isLocalQuantity'

// storagePaths are where each quantity lives, written out apart from Place so that what a write reaches is not decided
// by the code under test: a count lives in its collection's storage.
function storagePaths() returns Strings
	var out = Strings.create(0)
	out.push("a")
	out.push("c")
	out.push("g.0")
	out.push("g.0")
	out.push("n")
	return out
end 'storagePaths'

// rootOf is the local a storage path starts at, by slot.
function rootOf(path String) returns Count
	if path.startsWith("a") 'a'
		return 0 as Count
	end 'a'
	if path.startsWith("c") 'c'
		return 1 as Count
	end 'c'
	if path.startsWith("n") 'n'
		return 3 as Count
	end 'n'
	return 2 as Count
end 'rootOf'

// holderPaths are the storage that operations write or call methods on: a, c, c's storage, g, g.0 and g.1.
function holderPaths() returns Strings
	var out = Strings.create(0)
	out.push("a")
	out.push("c")
	out.push("c.0")
	out.push("g")
	out.push("g.0")
	out.push("g.1")
	return out
end 'holderPaths'

function holderPlace(h Count) returns Place
	if h == 0 'a'
		return Place.local(0 as Count)
	end 'a'
	if h == 1 'c'
		return Place.local(1 as Count)
	end 'c'
	if h == 2 'cStorage'
		return placeField(Place.local(1 as Count), field: 0 as Count).unwrap()
	end 'cStorage'
	if h == 3 'g'
		return Place.local(2 as Count)
	end 'g'
	if h == 4 'g0'
		return placeField(Place.local(2 as Count), field: 0 as Count).unwrap()
	end 'g0'
	if h == 5 'g1'
		return placeField(Place.local(2 as Count), field: 1 as Count).unwrap()
	end 'g1'
	panic("rules: no holder {h}")
end 'holderPlace'

// pathsOverlap is whether a write to one storage path can change what lives at the other.
function pathsOverlap(x String, y String) returns bool
	return x == y or x.startsWith("{y}.") or y.startsWith("{x}.")
end 'pathsOverlap'

// quantityOf is the quantity a fact names, told apart by its path and by whether it is a count, not by the rules' own
// same, which the test holds to telling them apart.
function quantityOf(p Place) returns Count
	for q in 0 upto quantities 'each'
		if quantityPlace(q).samePath(p) and quantityPlace(q).counted == p.counted 'found'
			return q
		end 'found'
	end 'each'
	panic("rules: a fact names a place outside the universe")
end 'quantityOf'

function isCount(q Count) returns bool
	return q >= firstCount and q < pastCounts
end 'isCount'

function countSpan() returns Span
	return Span.make(ast.I128.zero(), hi: ast.I128.i64Max())
end 'countSpan'

function exact(v Count) returns Span
	return Span.exactly(ast.I128.fromCount(v))
end 'exact'

// spanOf is what a state knows of a quantity, its type's span where it knows nothing, as the walk's rangeSpanAt gives.
function spanOf(st RangeState, p Place) returns Span
	return match consumes st.at(p) 'known'
		some(s) gives s
		none gives countSpan()
	end 'known'
end 'spanOf'

// holdsIn is whether a valuation is one the state describes.
function holdsIn(st RangeState, v Ints) returns bool
	if st.dead 'dead'
		return false
	end 'dead'
	if not st.spans[0].has(ast.I128.fromCount(v[0])) or not st.spans[quantityPlace(second).root].has(ast.I128.fromCount(v[second])) 'local'
		return false
	end 'local'
	for i in 0 upto st.fields.count() 'fields'
		if not st.fields[i].span.has(ast.I128.fromCount(v[quantityOf(st.fields[i].at)])) 'field'
			return false
		end 'field'
	end 'fields'
	for i in 0 upto st.relations.count() 'relations'
		let hi = ast.I128.fromCount(v[quantityOf(st.relations[i].hi)])
		let lo = ast.I128.fromCount(v[quantityOf(st.relations[i].lo)])
		if hi.sub(lo).lt(st.relations[i].gap) 'relation'
			return false
		end 'relation'
	end 'relations'
	return true
end 'holdsIn'

function quantityText(p Place) returns String
	let names = storagePaths()
	let q = quantityOf(p)
	if not isCount(q) 'integer'
		return names[q].clone()
	end 'integer'
	return "count({names[q]})"
end 'quantityText'

function spanText(s Span) returns String
	let nz = " nonzero" if s.nonZero else ""
	return "[{s.lo.toString()}, {s.hi.toString()}{nz}]"
end 'spanText'

function stateText(st RangeState) returns String
	if st.dead 'dead'
		return "dead"
	end 'dead'
	var text = "a in {spanText(st.spans[0])}, n in {spanText(st.spans[quantityPlace(second).root])}"
	for i in 0 upto st.fields.count() 'fields'
		text = "{text}, {quantityText(st.fields[i].at)} in {spanText(st.fields[i].span)}"
	end 'fields'
	for i in 0 upto st.relations.count() 'relations'
		text = "{text}, {quantityText(st.relations[i].hi)} - {quantityText(st.relations[i].lo)} >= {st.relations[i].gap.toString()}"
	end 'relations'
	return text
end 'stateText'

function effectName(e ast.CountEffect) returns String
	return match e 'e'
		countKeep gives "keep"
		countGrow gives "grow"
		countGrowOne gives "growOne"
		countShrink gives "shrink"
		countShrinkOne gives "shrinkOne"
		countChange gives "change"
	end 'e'
end 'effectName'

function opText(op Op) returns String
	let names = storagePaths()
	let holders = holderPaths()
	return match op 'op'
		compare(x, cmp, y) gives "guard {quantityText(quantityPlace(x))} {cmp} {quantityText(quantityPlace(y))}"
		constant(x, cmp, k) gives "guard {quantityText(quantityPlace(x))} {cmp} {k}"
		shifted(x, dx, cmp, y, dy, wraps) gives "guard {quantityText(quantityPlace(x))} + {dx} {cmp} {quantityText(quantityPlace(y))} + {dy}{wrapText(wraps)}"
		empty(q, truth) gives "guard {names[q]}.isEmpty() is {truth}"
		effect(h, e) gives "{effectName(e)} of {holders[h]}"
		write(h) gives "write of {holders[h]}"
		assign(t, k) gives "{names[t]} = {k}"
		assignAny(t) gives "{names[t]} = anything"
		bind(t, source, k) gives "{names[t]} = {quantityText(quantityPlace(source))} + {k}"
		forget(mask) gives "loop top forgetting roots {mask}"
		pop(h) gives "pop of {holders[h]}"
		removeAt(h, i) gives "remove of {holders[h]} at {names[i]}"
		midpoint(t, low, high) gives "{names[t]} = {quantityText(quantityPlace(low))} + ({quantityText(quantityPlace(high))} - {quantityText(quantityPlace(low))}) / 2"
	end 'op'
end 'opText'

function wrapText(wraps bool) returns String
	return " modulo the word" if wraps else ""
end 'wrapText'

// spanChoices are the spans a quantity can start with: unknown, or any lo to hi in the universe.
function spanChoices() returns SpanList
	var out = SpanList.create(0)
	out.push(countSpan())
	for lo in 0 upto universeTop + 1 'lo'
		for hi in lo upto universeTop + 1 'hi'
			out.push(Span.make(ast.I128.fromCount(lo), hi: ast.I128.fromCount(hi)))
		end 'hi'
	end 'lo'
	return out
end 'spanChoices'

// relationChoices are the ordered pairs of the quantities from first until past that a relation can name, as
// hi * quantities + lo.
function relationChoices(first Count, past Count) returns Ints
	var out = Ints.create(0)
	for hi in first upto past 'hi'
		for lo in first upto past 'lo'
			if hi != lo 'apart'
				out.push(try hi * quantities + lo otherwise panic("rules: a quantity past the universe"))
			end 'apart'
		end 'lo'
	end 'hi'
	return out
end 'relationChoices'

// gapChoices are the gaps a relation can start with, as gap + gapBias, from -2 to 2.
let gapBias = 2 as Count

let gapChoices = 5 as Count

function gapOf(choice Count) returns ast.I128
	return ast.I128.fromCount(choice).sub(ast.I128.fromCount(gapBias))
end 'gapOf'

function startState(spans SpanList, pick Ints) returns RangeState
	var st = RangeState.make(quantities, dead: false, kept: false)
	for q in 0 upto quantities 'each'
		if isLocalQuantity(q) 'local'
			st.spans[quantityPlace(q).root] = spans[pick[q]].clone()
		end 'local' else if pick[q] != 0 'known'
			st.refine(quantityPlace(q), v: spans[pick[q]])
		end 'known'
	end 'each'
	return st
end 'startState'

function relateChoice(mutates st RangeState, pair Count, gap Count)
	st.relate(quantityPlace(pair / quantities), lo: quantityPlace(pair mod quantities), gap: gapOf(gap))
end 'relateChoice'

// startStates are every state over the universe with at most one relation, and every state with two relations and no
// span known.
function startStates() returns RangeStateList
	let spans = spanChoices()
	let pairs = relationChoices(0 as Count, past: atCollection)
	var out = RangeStateList.create(0)
	var pick = Ints.create(quantities)
	for s0 in 0 upto spans.count() 'a'
		for s1 in 0 upto spans.count() 'countC'
			for s2 in 0 upto spans.count() 'countG'
				pick[0] = s0
				pick[1] = s1
				pick[2] = s2
				out.push(startState(spans, pick: pick))
				for r in 0 upto pairs.count() 'pair'
					for g in 0 upto gapChoices 'gap'
						var st = startState(spans, pick: pick)
						relateChoice(st, pair: pairs[r], gap: g)
						out.push(st)
					end 'gap'
				end 'pair'
			end 'countG'
		end 'countC'
	end 'a'
	pick[0] = 0
	pick[1] = 0
	pick[2] = 0
	for r1 in 0 upto pairs.count() 'first'
		for r2 in r1 + 1 upto pairs.count() 'second'
			for g1 in 0 upto gapChoices 'firstGap'
				for g2 in 0 upto gapChoices 'secondGap'
					var st = startState(spans, pick: pick)
					relateChoice(st, pair: pairs[r1], gap: g1)
					relateChoice(st, pair: pairs[r2], gap: g2)
					out.push(st)
				end 'secondGap'
			end 'firstGap'
		end 'second'
	end 'first'
	return out
end 'startStates'

function comparisons() returns Strings
	var out = Strings.create(0)
	out.push("<")
	out.push("<=")
	out.push(">")
	out.push(">=")
	out.push("==")
	out.push("!=")
	return out
end 'comparisons'

function countEffects() returns Effects
	var out = Effects.create(0)
	out.push(ast.CountEffect.countKeep)
	out.push(ast.CountEffect.countGrow)
	out.push(ast.CountEffect.countGrowOne)
	out.push(ast.CountEffect.countShrink)
	out.push(ast.CountEffect.countShrinkOne)
	out.push(ast.CountEffect.countChange)
	return out
end 'countEffects'

// allOps are every guard between two quantities and between a quantity and a constant, both tests of emptiness, every
// count effect on each collection and on g, which holds one, a write of each holder, each assignment of a, the top of a loop for each set of
// assignable roots, and a pop of each collection and a remove from it at a.
function allOps() returns Ops
	let cmps = comparisons()
	let effects = countEffects()
	var out = Ops.create(0)
	for x in 0 upto atCollection 'x'
		for i in 0 upto cmps.count() 'cmp'
			for y in 0 upto atCollection 'y'
				if x != y 'apart'
					out.push(Op.compare(x, op: cmps[i].clone(), y: y))
				end 'apart'
			end 'y'
			for k in 0 upto universeTop + 2 'k'
				out.push(Op.constant(x, op: cmps[i].clone(), k: k))
			end 'k'
		end 'cmp'
	end 'x'
	for q in firstCount upto pastCounts 'empty'
		out.push(Op.empty(q, truth: true))
		out.push(Op.empty(q, truth: false))
	end 'empty'
	for i in 0 upto effects.count() 'effects'
		out.push(Op.effect(1 as Count, effect: effects[i]))
		out.push(Op.effect(3 as Count, effect: effects[i]))
		out.push(Op.effect(4 as Count, effect: effects[i]))
	end 'effects'
	for h in 1 upto holderPaths().count() 'writes'
		out.push(Op.write(h))
	end 'writes'
	for k in 0 upto universeTop + 1 'assign'
		out.push(Op.assign(0 as Count, k: k))
	end 'assign'
	out.push(Op.assignAny(0 as Count))
	for mask in 1 upto 8 'masks'
		out.push(Op.forget(mask as Count))
	end 'masks'
	appendAccesses(out, indices: Ints.filled(1, value: 0))
	return out
end 'allOps'

// appendAccesses adds a pop of c and of g.0, and a remove from each at the index each of indices holds.
function appendAccesses(mutates out Ops, indices Ints)
	var collections = Ints.filled(1, value: 1)
	collections.push(4)
	for c in 0 upto collections.count() 'collections'
		out.push(Op.pop(collections[c]))
		for i in 0 upto indices.count() 'indices'
			out.push(Op.removeAt(collections[c], index: indices[i]))
		end 'indices'
	end 'collections'
end 'appendAccesses'

// collectionOps are the operations that reach g.0 or count(g.0): every guard between the two and of each with a
// constant, both tests of emptiness of g.0, every count effect on g.0 and on g, a write of g, g.0 and g.1, the top of a
// loop where g may be assigned, and a pop of g.0.
function collectionOps() returns Ops
	let cmps = comparisons()
	let effects = countEffects()
	let countG = 2 as Count
	let g = 3 as Count
	let g0 = 4 as Count
	let g1 = 5 as Count
	var out = Ops.create(0)
	for i in 0 upto cmps.count() 'cmp'
		out.push(Op.compare(countG, op: cmps[i].clone(), y: atCollection))
		out.push(Op.compare(atCollection, op: cmps[i].clone(), y: countG))
		for k in 0 upto universeTop + 2 'k'
			out.push(Op.constant(countG, op: cmps[i].clone(), k: k))
			out.push(Op.constant(atCollection, op: cmps[i].clone(), k: k))
		end 'k'
	end 'cmp'
	out.push(Op.empty(countG, truth: true))
	out.push(Op.empty(countG, truth: false))
	for i in 0 upto effects.count() 'effects'
		out.push(Op.effect(g, effect: effects[i]))
		out.push(Op.effect(g0, effect: effects[i]))
	end 'effects'
	out.push(Op.write(g))
	out.push(Op.write(g0))
	out.push(Op.write(g1))
	out.push(Op.forget(1 shl 2))
	out.push(Op.pop(g0))
	return out
end 'collectionOps'

// collectionStates are every state whose spans of count(g.0) and g.0 are any of the choices, with at most one relation
// between the two, a and count(c) held at 0.
function collectionStates() returns RangeStateList
	let spans = spanChoices()
	let pairs = relationChoices(2 as Count, past: atCollection + 1)
	var out = RangeStateList.create(0)
	var pick = Ints.create(quantities)
	pick[0] = 1
	pick[1] = 1
	for s2 in 0 upto spans.count() 'countG'
		for s3 in 0 upto spans.count() 'atG'
			pick[2] = s2
			pick[3] = s3
			out.push(startState(spans, pick: pick))
			for r in 0 upto pairs.count() 'pair'
				for g in 0 upto gapChoices 'gap'
					var st = startState(spans, pick: pick)
					relateChoice(st, pair: pairs[r], gap: g)
					out.push(st)
				end 'gap'
			end 'pair'
		end 'atG'
	end 'countG'
	return out
end 'collectionStates'

// guardSide narrows x by 'x + dx op y + dy', as the walk's rangeCompareAt does: the relation the comparison records, then
// x's span by other, the span of y's side as the walk's rangeSidePeek gives it.
function guardSide(mutates st RangeState, x Place, dx ast.I128, op String, y table.Option with Place, dy ast.I128, exact bool, other Span)
	if st.dead 'dead'
		return
	end 'dead'
	match y 'y'
		some(py) then relateShifted(st, x: x, dx: dx, op: op, y: py, dy: dy, exact: exact)
		none then _ = 0
	end 'y'
	let cur = spanOf(st, p: x)
	match consumes comparedSpan(cur, op: op, other: other, dx: dx, exact: exact) 'narrowed'
		some(next) then refineGuarded(st, x: x, cur: cur, next: next)
		none then _ = 0
	end 'narrowed'
end 'guardSide'

// refineGuarded gives x the span a guard leaves it, as the walk's rangeRefineAt does.
function refineGuarded(mutates st RangeState, x Place, cur Span, next Span)
	if next.same(cur) 'unchanged'
		return
	end 'unchanged'
	if rulesOut(next) 'never'
		st.dead = true
		return
	end 'never'
	st.refine(x, v: next)
end 'refineGuarded'

function relateShifted(mutates st RangeState, x Place, dx ast.I128, op String, y Place, dy ast.I128, exact bool)
	match consumes comparedGap(op, dx: dx, dy: dy, exact: exact) 'gap'
		some(gap) then st.relate(x, lo: y, gap: gap)
		none then _ = 0
	end 'gap'
end 'relateShifted'

// sideSpan is the span of the side 'p + d' of a guard, as the walk's rangeOffsetSpan gives it: the place's moved by d, or
// the type's where the sum may have wrapped.
function sideSpan(st RangeState, p Place, d ast.I128, exact bool) returns Span
	if not exact and not d.isZero() 'wraps'
		return countSpan()
	end 'wraps'
	return shiftedSpan(spanOf(st, p: p), by: d)
end 'sideSpan'

// applied is the state after an operation, by the rules the walk calls.
function applied(st RangeState, op Op) returns RangeState
	var out = st.clone()
	let zero = ast.I128.zero()
	match op 'op'
		compare(x, cmp, y) then guardBoth(out, x: x, dx: 0, op: cmp, y: y, dy: 0, wraps: false)
		constant(x, cmp, k) then guardSide(out, x: quantityPlace(x), dx: zero, op: cmp, y: table.Option.none, dy: zero, exact: true, other: exact(k))
		shifted(x, dx, cmp, y, dy, wraps) then guardBoth(out, x: x, dx: dx, op: cmp, y: y, dy: dy, wraps: wraps)
		empty(q, truth) then guardSide(out, x: quantityPlace(q), dx: zero, op: emptyComparison(truth), y: table.Option.none, dy: zero, exact: true, other: exact(0 as Count))
		effect(h, e) then affectHolder(out, holder: h, effect: e)
		write(h) then out.drop(Gone.overlapping(holderPlace(h)))
		assign(t, k) then assignLocal(out, target: t, v: exact(k))
		assignAny(t) then assignLocal(out, target: t, v: countSpan())
		bind(t, source, k) then bindShifted(out, target: t, source: source, k: k)
		forget(mask) then forgetRoots(out, mask: mask)
		pop(h) then accessOn(out, holder: h, index: table.Option.none, checked: ast.Intrinsic.intrArrayPop, twin: ast.Intrinsic.intrArrayPopProven)
		removeAt(h, i) then accessOn(out, holder: h, index: table.Option.some(i), checked: ast.Intrinsic.intrArrayRemove, twin: ast.Intrinsic.intrArrayRemoveProven)
		midpoint(t, low, high) then bindMidpoint(out, target: t, low: low, high: high)
	end 'op'
	return out
end 'applied'

// accessOn is the success of an access on the collection at holder, at the index the quantity index holds or with none,
// as the walk's rangeAccess and rangeCallExpr take it: where the state proves the precondition of the checked row, the call
// is the twin, which moves the count by its exact step, and elsewhere the checked row, whose effect is true of both exits.
function accessOn(mutates st RangeState, holder Count, index table.Option with Count, checked ast.Intrinsic, twin ast.Intrinsic)
	var chosen = checked
	if provenAccess(st, holder: holder, index: index, requirement: ast.intrinsicRequires(checked)) 'proven'
		chosen = twin
	end 'proven'
	affectHolder(st, holder: holder, effect: ast.intrinsicCountEffect(chosen))
end 'accessOn'

// affectHolder is a count effect on what holder holds, as the walk's rangeAffect applies it to a collection whose count it
// follows; a holder that is no collection takes the rule alone.
function affectHolder(mutates st RangeState, holder Count, effect ast.CountEffect)
	if isCollection(holder) 'collection'
		st.affectCollection(holderPlace(holder), effect: effect)
		return
	end 'collection'
	st.affect(holderPlace(holder), effect: effect)
end 'affectHolder'

// isCollection is whether a holder is the storage of a count of the universe.
function isCollection(holder Count) returns bool
	for q in firstCount upto pastCounts 'counts'
		if storagePaths()[q] == holderPaths()[holder] 'found'
			return true
		end 'found'
	end 'counts'
	return false
end 'isCollection'

// provenAccess is whether the state proves an access's requirement on the count of the collection at holder, as the walk's
// rangeProves decides it: from the count's span less the index's, or, for an index, the count's least distance above it.
function provenAccess(st RangeState, holder Count, index table.Option with Count, requirement ast.Precondition) returns bool
	if st.dead 'dead'
		return false
	end 'dead'
	let count = placeCount(holderPlace(holder))
	let known = spanOf(st, p: count)
	return match index 'index'
		some(i) gives provesPrecondition(requirement, least: countAbove(st, count: count, known: known, i: quantityPlace(i)), lowest: spanOf(st, p: quantityPlace(i)).lo)
		none gives provesPrecondition(requirement, least: known.lo.clone(), lowest: ast.I128.zero())
	end 'index'
end 'provenAccess'

// countAbove is the least that count lies above the place i, by their spans and by a chain of relations.
function countAbove(st RangeState, count Place, known Span, i Place) returns ast.I128
	let bySpans = known.lo.sub(spanOf(st, p: i).hi)
	return match consumes st.least(count, lo: i) 'gap'
		some(g) gives ast.maxI128(bySpans, b: g)
		none gives bySpans
	end 'gap'
end 'countAbove'

// countQuantity is the quantity that is the count of the collection at holder.
function countQuantity(holder Count) returns Count
	for q in firstCount upto pastCounts 'counts'
		if storagePaths()[q] == holderPaths()[holder] 'found'
			return q
		end 'found'
	end 'counts'
	panic("rules: the holder {holder} is no collection")
end 'countQuantity'

// guardBoth is a guard 'x + dx op y + dy' that holds, as the walk's rangeNarrow takes it: each side in turn.
function guardBoth(mutates st RangeState, x Count, dx FullRangeInt, op String, y Count, dy FullRangeInt, wraps bool)
	let px = quantityPlace(x)
	let py = quantityPlace(y)
	let ix = ast.I128.fromInt(dx)
	let iy = ast.I128.fromInt(dy)
	let exactSums = not wraps
	let ySide = sideSpan(st, p: py, d: iy, exact: exactSums)
	guardSide(st, x: px, dx: ix, op: op, y: table.Option.some(py.clone()), dy: iy, exact: exactSums, other: ySide)
	let xSide = sideSpan(st, p: px, d: ix, exact: exactSums)
	let flipped = flippedComparison(op)
	guardSide(st, x: py, dx: iy, op: flipped, y: table.Option.some(px.clone()), dy: ix, exact: exactSums, other: xSide)
end 'guardBoth'

// assignLocal writes the local quantity target, as the walk's rangeWrite does.
function assignLocal(mutates st RangeState, target Count, v Span)
	let place = quantityPlace(target)
	st.drop(Gone.overlapping(place.clone()))
	st.refine(place, v: v)
end 'assignLocal'

// bindShifted gives the local quantity target the value of source + k, as the walk's rangeAssignTo does: the span is what
// rangeEval gives the sum, from source's span cut by its relations, within the type; the target moves with what is known of
// it where it is the source, and is related to the source otherwise.
function bindShifted(mutates st RangeState, target Count, source Count, k FullRangeInt)
	let pt = quantityPlace(target)
	let ps = quantityPlace(source)
	let by = ast.I128.fromInt(k)
	var v = spanOf(st, p: ps)
	if k != 0 'sum'
		v = shiftedSpan(st.tightened(ps, cur: v), by: by)
	end 'sum'
	let within = v.clamp(countSpan())
	if pt.same(ps) 'moved'
		st.shiftPlace(pt, by: by)
		st.refine(pt, v: within)
		return
	end 'moved'
	st.drop(Gone.overlapping(pt.clone()))
	st.refine(pt, v: within)
	if not ps.overlaps(pt) 'related'
		st.equate(pt, w: ps, by: by)
	end 'related'
end 'bindShifted'

// bindMidpoint gives the local quantity target the value 'low + (high - low) / 2', as the walk's rangeOperate and
// rangeAssignComputed take it: where the state proves the midpoint, its span and the relations relateMidpoint records, and
// elsewhere what an operation the rule does not bound may give, here any value.
function bindMidpoint(mutates st RangeState, target Count, low Count, high Count)
	let l = quantitySide(st, q: low)
	let h = quantitySide(st, q: high)
	if not st.provesMidpoint(l, high: h) 'unproven'
		assignLocal(st, target: target, v: countSpan())
		return
	end 'unproven'
	let v = st.midpointSpan(l, high: h).clamp(countSpan())
	assignLocal(st, target: target, v: v)
	st.relateMidpoint(quantityPlace(target), low: quantityPlace(low), high: quantityPlace(high))
end 'bindMidpoint'

// quantitySide is the quantity q as a side of a comparison, with the span the state knows of it, as the walk's rangeSideOf
// makes it of a place.
function quantitySide(st RangeState, q Count) returns CompareSide
	let p = quantityPlace(q)
	return CompareSide.placed(p.clone(), span: spanOf(st, p: p), by: ast.I128.zero())
end 'quantitySide'

// midpointOf is what 'low + (high - low) / 2' computes, whose division truncates.
function midpointOf(low Count, high Count) returns FullRangeInt
	let l = signed(low)
	return try l + (signed(high) - l) / 2 otherwise panic("rules: a midpoint past the word")
end 'midpointOf'

// forgetRoots is the top of a loop whose body is opaque, where the roots of mask may be assigned, as the walk's keepThrough
// makes it: the span of an assignable integer local is its type's again, and every fact on an assignable root is gone.
function forgetRoots(mutates st RangeState, mask Count)
	var scans = LoopScans.new()
	let loop = scans.enter(0 as ast.NodeID)
	scans.opaque()
	scans.leave()
	st.keepThrough(scans, loop: loop, mutable: rootMask(mask), wide: wideSpans())
end 'forgetRoots'

// rootMask is the flags by slot of the roots of mask, which may be assigned.
function rootMask(mask Count) returns ByteArray
	var mutable = ByteArray.create(quantities)
	for i in 0 upto quantities 'roots'
		if ((mask shr i) and 1) == 1 'assignable'
			mutable[i] = 1
		end 'assignable'
	end 'roots'
	return mutable
end 'rootMask'

// wideSpans are the spans of the locals' types by slot, the span of a count for every quantity of the universe.
function wideSpans() returns SpanList
	var out = SpanList.create(0)
	for _ in 0 upto quantities 'each'
		out.push(countSpan())
	end 'each'
	return out
end 'wideSpans'

// Reach is the values one quantity can have after an operation, lo to hi, or none.
type Reach
	export var lo as Count
	export var hi as Count
	export var none as bool

	static function to(lo Count, hi Count) returns Reach
		return Reach{lo: lo, hi: hi, none: false}
	end 'to'

	static function nothing() returns Reach
		return Reach{lo: 1 as Count, hi: 0 as Count, none: true}
	end 'nothing'
end 'Reach'

typealias Reaches = Array with Reach

function anyValue() returns Reach
	return Reach.to(0 as Count, hi: universeTop + spill)
end 'anyValue'

// past is the value after v.
function past(v Count) returns Count
	return try v + 1 otherwise panic("rules: a value past the universe")
end 'past'

function held(v Count) returns Reach
	return Reach.to(v, hi: v)
end 'held'

function compares(x Count, op String, y Count) returns bool
	return match op 'op'
		"<" gives x < y
		"<=" gives x <= y
		">" gives x > y
		">=" gives x >= y
		"==" gives x == y
		"!=" gives x != y
		default panic("rules: '{op}' is no comparison")
	end 'op'
end 'compares'

// effectReach is what a count effect lets a count of v become: what the row's call can leave on any of its exits.
function effectReach(e ast.CountEffect, v Count) returns Reach
	return match e 'e'
		countKeep gives held(v)
		countGrow gives Reach.to(v, hi: try v + spill otherwise panic("rules: a count past the universe"))
		countGrowOne gives held(past(v))
		countShrink gives Reach.to(0 as Count, hi: v)
		countShrinkOne gives held(v - 1) if v >= 1 else Reach.nothing()
		countChange gives anyValue()
	end 'e'
end 'effectReach'

// concrete is what the operation does to the valuation v, for each quantity: the values it can have afterwards, every
// one of them reachable, or none for a guard that fails or an operation that cannot run.
function concrete(op Op, v Ints) returns Reaches
	var out = Reaches.create(0)
	for q in 0 upto quantities 'same'
		out.push(held(v[q]))
	end 'same'
	match op 'op'
		compare(x, cmp, y) then keepIf(out, holds: compares(v[x], op: cmp, y: v[y]))
		constant(x, cmp, k) then keepIf(out, holds: compares(v[x], op: cmp, y: k))
		shifted(x, dx, cmp, y, dy, wraps) then keepIf(out, holds: comparesSigned(sumOf(v[x], d: dx, wraps: wraps), op: cmp, y: sumOf(v[y], d: dy, wraps: wraps)))
		empty(q, truth) then keepIf(out, holds: (v[q] == 0) == truth)
		effect(h, e) then effectOn(out, v: v, holder: holderPaths()[h], effect: e)
		write(h) then writeOf(out, holder: holderPaths()[h])
		assign(t, k) then out[t] = held(k)
		assignAny(t) then out[t] = anyValue()
		bind(t, source, k) then bindOf(out, target: t, value: sumOf(v[source], d: k, wraps: false))
		forget(mask) then forgetOf(out, mask: mask)
		pop(h) then effectOn(out, v: v, holder: holderPaths()[h], effect: ast.CountEffect.countShrinkOne)
		removeAt(h, i) then removedAt(out, v: v, holder: h, i: i)
		midpoint(t, low, high) then bindOf(out, target: t, value: midpointOf(v[low], high: v[high]))
	end 'op'
	return out
end 'concrete'

// sumOf is v + d, computed exactly or modulo wrapWord.
function sumOf(v Count, d FullRangeInt, wraps bool) returns FullRangeInt
	let exactSum = try (v as FullRangeInt) + d otherwise panic("rules: a sum past the word")
	if not wraps 'exact'
		return exactSum
	end 'exact'
	let word = wrapWord as FullRangeInt
	let r = exactSum mod word
	return r + word if r < 0 else r
end 'sumOf'

// bindOf gives target the value of a sum, which fails below 0, where a count cannot be.
function bindOf(mutates out Reaches, target Count, value FullRangeInt)
	if value < 0 'fails'
		out[0] = Reach.nothing()
		return
	end 'fails'
	out[target] = held(value as Count)
end 'bindOf'

// effectOn is a call with a count effect on the collection at holder: its count moves as the effect lets it, and
// anything else whose storage the holder overlaps may become anything.
function effectOn(mutates out Reaches, v Ints, holder String, effect ast.CountEffect)
	let paths = storagePaths()
	for q in 0 upto quantities 'quantities'
		if isCount(q) and paths[q] == holder 'itsCount'
			out[q] = effectReach(effect, v: v[q])
		end 'itsCount' else if pathsOverlap(paths[q], y: holder) 'reached'
			out[q] = anyValue()
		end 'reached'
	end 'quantities'
end 'effectOn'

// writeOf is a write of the storage at holder: whatever lives in storage it overlaps may become anything.
function writeOf(mutates out Reaches, holder String)
	let paths = storagePaths()
	for q in 0 upto quantities 'write'
		if pathsOverlap(paths[q], y: holder) 'reached'
			out[q] = anyValue()
		end 'reached'
	end 'write'
end 'writeOf'

// forgetOf is the top of a loop: whatever lives under an assignable root may be anything.
function forgetOf(mutates out Reaches, mask Count)
	let paths = storagePaths()
	for q in 0 upto quantities 'forget'
		if ((mask shr rootOf(paths[q])) and 1) == 1 'assignable'
			out[q] = anyValue()
		end 'assignable'
	end 'forget'
end 'forgetOf'

// removedAt is the success of a remove at the value of the quantity i from the collection at holder: only an index below
// the count succeeds, which leaves the count one less.
function removedAt(mutates out Reaches, v Ints, holder Count, i Count)
	if v[i] >= v[countQuantity(holder)] 'outside'
		keepIf(out, holds: false)
		return
	end 'outside'
	effectOn(out, v: v, holder: holderPaths()[holder], effect: ast.CountEffect.countShrinkOne)
end 'removedAt'

// checkProof fails where the state proves the requirement of an access that a valuation it describes breaks: the twin,
// which has no check, would run where the checked row fails.
function checkProof(st RangeState, op Op, v Ints)
	let broken = match op 'op'
		pop(h) gives provenAccess(st, holder: h, index: table.Option.none, requirement: ast.intrinsicRequires(ast.Intrinsic.intrArrayPop)) and v[countQuantity(h)] == 0
		removeAt(h, i) gives provenAccess(st, holder: h, index: table.Option.some(i), requirement: ast.intrinsicRequires(ast.Intrinsic.intrArrayRemove)) and v[i] >= v[countQuantity(h)]
		midpoint(t, low, high) gives st.provesMidpoint(quantitySide(st, q: low), high: quantitySide(st, q: high)) and v[high] <= v[low]
		compare(x, cmp, y) gives false
		constant(x, cmp, k) gives false
		shifted(x, dx, cmp, y, dy, wraps) gives false
		empty(q, truth) gives false
		effect(h, e) gives false
		write(h) gives false
		assign(t, k) gives false
		assignAny(t) gives false
		bind(t, source, k) gives false
		forget(mask) gives false
	end 'op'
	if broken 'broken'
		panic("rules: {stateText(st)} proves the {opText(op)}, but {valuationText(v)} breaks its requirement")
	end 'broken'
end 'checkProof'

function keepIf(mutates out Reaches, holds bool)
	if not holds 'fails'
		out[0] = Reach.nothing()
	end 'fails'
end 'keepIf'

// Universe is how far each quantity's values go: tops are the most a valuation before an operation gives it, and limits
// the most a value after one is checked at, for a quantity a test holds still.
type Universe
	export var tops as Ints
	export var limits as Ints

	// holding is the universe where the quantities of held, by bit, stay at 0 and the others range over everything.
	static function holding(held Count) returns Universe
		var tops = Ints.create(quantities)
		var limits = Ints.create(quantities)
		for q in 0 upto quantities 'each'
			if ((held shr q) and 1) == 0 'free'
				tops[q] = universeTop
				limits[q] = universeTop + spill
			end 'free'
		end 'each'
		return Universe{tops: tops, limits: limits}
	end 'holding'
end 'Universe'

// nextValuation steps v to the next valuation with each quantity from lo to hi, and says whether there is one.
function nextValuation(mutates v Ints, lo Ints, hi Ints) returns bool
	for q in 0 upto quantities 'each'
		if v[q] < hi[q] 'step'
			v[q] = past(v[q])
			return true
		end 'step'
		v[q] = lo[q]
	end 'each'
	return false
end 'nextValuation'

// described are the valuations within the universe that a state describes, the values of the quantities one after
// another.
function described(st RangeState, u Universe) returns Ints
	var out = Ints.create(0)
	let lo = Ints.create(quantities)
	let bounds = Bounds.of(st, derive: false, places: quantityPlaces())
	var v = Ints.create(quantities)
	var more = true
	while more 'each'
		if bounds.broken(v) == "" 'holds'
			out.append(v)
		end 'holds'
		more = nextValuation(v, lo: lo, hi: u.tops)
	end 'each'
	return out
end 'described'

function valuationText(v Ints) returns String
	return "a = {v[0]}, count(c) = {v[1]}, count(g.0) = {v[2]}, g.0 = {v[3]}, n = {v[second]}"
end 'valuationText'

// Bounds are what a state says of the values of the quantities, as small integers that a valuation is checked against
// fast: the spans and relations it holds, and, where it is derived, what the analysis derives from them beyond its facts,
// least for each ordered pair of quantities where it finds a chain and the tightened span of each quantity. A bound past
// claimLimit either holds of every value of the universe or of none, so it is cut to claimLimit with no change to what it
// allows.
type Bounds
	export var dead as bool
	export var qs as Ints
	export var lows as Smalls
	export var highs as Smalls
	export var nonZero as ByteArray
	export var his as Ints
	export var los as Ints
	export var gaps as Smalls
	// facts is how many of the spans, and of the differences, are facts of the state rather than derived.
	export var spanFacts as Count
	export var gapFacts as Count

	static function of(st RangeState, derive bool, places PlaceList) returns Bounds
		var out = Bounds{dead: st.dead, qs: Ints.create(0), lows: Smalls.create(0), highs: Smalls.create(0), nonZero: ByteArray.create(0), his: Ints.create(0), los: Ints.create(0), gaps: Smalls.create(0), spanFacts: 0, gapFacts: 0}
		if st.dead 'dead'
			return out
		end 'dead'
		for q in 0 upto quantities 'locals'
			if isLocalQuantity(q) 'local'
				out.addSpan(q, s: st.spans[quantityPlace(q).root])
			end 'local'
		end 'locals'
		for i in 0 upto st.fields.count() 'fields'
			out.addSpan(quantityIn(st.fields[i].at, places: places), s: st.fields[i].span)
		end 'fields'
		for i in 0 upto st.relations.count() 'relations'
			out.addGap(quantityIn(st.relations[i].hi, places: places), lo: quantityIn(st.relations[i].lo, places: places), gap: st.relations[i].gap)
		end 'relations'
		out.spanFacts = out.qs.count()
		out.gapFacts = out.his.count()
		if derive and st.relations.count() > 0 'derived'
			out.derive(st, places: places)
		end 'derived'
		return out
	end 'of'

	function derive(mutates self, st RangeState, places PlaceList)
		for hi in 0 upto quantities 'hi'
			for lo in 0 upto quantities 'lo'
				if hi != lo 'apart'
					let found = st.least(places[hi], lo: places[lo])
					if found.isSome() 'found'
						self.addGap(hi, lo: lo, gap: found.unwrap())
					end 'found'
				end 'apart'
			end 'lo'
			self.addSpan(hi, s: st.tightened(places[hi], cur: spanOf(st, p: places[hi])))
		end 'hi'
	end 'derive'

	function addSpan(mutates self, q Count, s Span)
		qs.push(q)
		lows.push(small(s.lo))
		highs.push(small(s.hi))
		nonZero.push(1 if s.nonZero else 0)
	end 'addSpan'

	function addGap(mutates self, hi Count, lo Count, gap ast.I128)
		his.push(hi)
		los.push(lo)
		gaps.push(small(gap))
	end 'addGap'

	// broken says which bound v breaks, or is empty where it breaks none.
	function broken(v Ints) returns String
		if dead 'dead'
			return " (no path)"
		end 'dead'
		for i in 0 upto qs.count() 'spans'
			let x = signed(v[qs[i]])
			if x < lows[i] or x > highs[i] or (x == 0 and nonZero[i] != 0) 'span'
				return ", where {quantityText(quantityPlace(qs[i]))} is {boundKind(i < spanFacts)} [{lows[i]}, {highs[i]}]"
			end 'span'
		end 'spans'
		for i in 0 upto his.count() 'gaps'
			if (try signed(v[his[i]]) - signed(v[los[i]]) otherwise panic("rules: a difference past the word")) < gaps[i] 'gap'
				return ", where {quantityText(quantityPlace(his[i]))} - {quantityText(quantityPlace(los[i]))} >= {gaps[i]} {gapKind(i < gapFacts)}"
			end 'gap'
		end 'gaps'
		return ""
	end 'broken'
end 'Bounds'

function boundKind(fact bool) returns String
	return "known in" if fact else "tightened to"
end 'boundKind'

function gapKind(fact bool) returns String
	return "is known" if fact else "by a chain"
end 'gapKind'

typealias Smalls = Array with FullRangeInt

// claimLimit is past every value and difference of the universe.
let claimLimit = 1000 as FullRangeInt

// signed is a value of the universe as a signed integer.
function signed(v Count) returns FullRangeInt
	return try v as FullRangeInt otherwise panic("rules: a value past the universe")
end 'signed'

// small is v within -claimLimit to claimLimit.
function small(v ast.I128) returns FullRangeInt
	if v.gt(ast.I128.fromInt(claimLimit)) 'above'
		return claimLimit
	end 'above'
	if v.lt(ast.I128.fromInt(-claimLimit)) 'below'
		return -claimLimit
	end 'below'
	return v.toSigned()
end 'small'

// checkReached fails unless every valuation the reaches allow within the universe's limits keeps the bounds of the state
// after.
function checkReached(before RangeState, op Op, from Ints, reaches Reaches, after RangeState, bounds Bounds, u Universe)
	var lo = Ints.create(quantities)
	var hi = Ints.create(quantities)
	for q in 0 upto quantities 'bounds'
		if reaches[q].none 'cannot'
			return
		end 'cannot'
		lo[q] = reaches[q].lo
		hi[q] = minCount(reaches[q].hi, b: u.limits[q])
		if lo[q] > hi[q] 'outside'
			return
		end 'outside'
	end 'bounds'
	var v = lo.clone()
	var more = true
	while more 'each'
		let why = bounds.broken(v)
		if why != "" 'broken'
			panic("rules: from {stateText(before)}, {opText(op)} gives {stateText(after)}{why}, but {valuationText(from)} can become {valuationText(v)}")
		end 'broken'
		more = nextValuation(v, lo: lo, hi: hi)
	end 'each'
end 'checkReached'

function minCount(a Count, b Count) returns Count
	return a if a < b else b
end 'minCount'

// checkAll checks every operation on every state over the valuations it describes.
function checkAll(states RangeStateList, ops Ops, u Universe)
	let places = quantityPlaces()
	var from = Ints.create(quantities)
	for s in 0 upto states.count() 'states'
		let values = described(states[s], u: u)
		if values.count() > 0 'reached'
			for o in 0 upto ops.count() 'ops'
				let after = applied(states[s], op: ops[o])
				let bounds = Bounds.of(after, derive: true, places: places)
				for i in 0 upto values.count() / quantities 'values'
					for q in 0 upto quantities 'from'
						from[q] = values[i * quantities + q]
					end 'from'
					checkProof(states[s], op: ops[o], v: from)
					checkReached(states[s], op: ops[o], from: from, reaches: concrete(ops[o], v: from), after: after, bounds: bounds, u: u)
				end 'values'
			end 'ops'
		end 'reached'
	end 'states'
end 'checkAll'

test 'every rule keeps only what the operation leaves true'
	checkAll(startStates(), ops: allOps(), u: Universe.holding(heldAtCollection or heldSecond))
end 'every rule keeps only what the operation leaves true'

test 'a fact on a count is never taken for one on what lives at the path of its collection'
	var u = Universe.holding(heldSecond)
	u.tops[atCollection] = universeTop + spill
	checkAll(collectionStates(), ops: collectionOps(), u: u)
end 'a fact on a count is never taken for one on what lives at the path of its collection'

// relationQuantities are the quantities the relations of these states name: a, count(c), count(g.0) and n.
function relationQuantities() returns Ints
	var out = Ints.create(0)
	out.push(0 as Count)
	out.push(1 as Count)
	out.push(2 as Count)
	out.push(second)
	return out
end 'relationQuantities'

// sideQuantities are the quantities the guards with offsets and the bindings compare and write: a, count(c) and n.
function sideQuantities() returns Ints
	var out = Ints.create(0)
	out.push(0 as Count)
	out.push(1 as Count)
	out.push(second)
	return out
end 'sideQuantities'

// fewSpans are the spans a quantity of a state with a relation starts with: unknown, or a few within the universe.
function fewSpans() returns SpanList
	var out = SpanList.create(0)
	out.push(countSpan())
	out.push(exact(0 as Count))
	out.push(Span.make(ast.I128.one(), hi: ast.I128.fromCount(universeTop)))
	return out
end 'fewSpans'

// relationPair is the pair of quantities hi and lo as relationChoices numbers it.
function relationPair(hi Count, lo Count) returns Count
	return try hi * quantities + lo otherwise panic("rules: a quantity past the universe")
end 'relationPair'

// relationStates are the states the rules of relations are checked on: any spans of a, count(c) and n; a few of them with one
// relation between two of a, count(c), count(g.0) and n; two relations with no span known; and every chain of three
// relations through all four, with gaps from -1 to 1, which least follows from one end to the other.
function relationStates() returns RangeStateList
	let spans = spanChoices()
	let qs = relationQuantities()
	let pairs = relationPairs(qs)
	var out = RangeStateList.create(0)
	appendSpanStates(out, spans: spans)
	appendOneRelation(out, spans: fewSpans(), pairs: pairs)
	appendTwoRelations(out, spans: spans, pairs: pairs)
	appendChains(out, qs: qs, spans: spans)
	return out
end 'relationStates'

// relationPairs are the ordered pairs of the quantities qs, as relationChoices numbers them.
function relationPairs(qs Ints) returns Ints
	var pairs = Ints.create(0)
	for hi in 0 upto qs.count() 'hi'
		for lo in 0 upto qs.count() 'lo'
			if hi != lo 'apart'
				pairs.push(relationPair(qs[hi], lo: qs[lo]))
			end 'apart'
		end 'lo'
	end 'hi'
	return pairs
end 'relationPairs'

// sidePick is the pick of spans for a, count(c) and n by the three digits of choice, the others unknown.
function sidePick(choice Ints) returns Ints
	var pick = Ints.create(quantities)
	pick[0] = choice[0]
	pick[1] = choice[1]
	pick[second] = choice[2]
	return pick
end 'sidePick'

// appendSpanStates adds every state whose spans of a, count(c) and n are any of spans.
function appendSpanStates(mutates out RangeStateList, spans SpanList)
	var choice = Ints.create(3)
	let top = try spans.count() - 1 otherwise panic("rules: no spans")
	var more = true
	while more 'each'
		out.push(startState(spans, pick: sidePick(choice)))
		more = stepFrom(choice, from: 0 as Count, top: top)
	end 'each'
end 'appendSpanStates'

// appendOneRelation adds every state whose spans of a, count(c) and n are any of spans, with one relation of pairs.
function appendOneRelation(mutates out RangeStateList, spans SpanList, pairs Ints)
	var choice = Ints.create(3)
	let top = try spans.count() - 1 otherwise panic("rules: no spans")
	var more = true
	while more 'each'
		let pick = sidePick(choice)
		for r in 0 upto pairs.count() 'pair'
			for g in 0 upto gapChoices 'gap'
				var st = startState(spans, pick: pick)
				relateChoice(st, pair: pairs[r], gap: g)
				out.push(st)
			end 'gap'
		end 'pair'
		more = stepFrom(choice, from: 0 as Count, top: top)
	end 'each'
end 'appendOneRelation'

// appendTwoRelations adds every state with two relations of pairs and no span known.
function appendTwoRelations(mutates out RangeStateList, spans SpanList, pairs Ints)
	let pick = Ints.create(quantities)
	for r1 in 0 upto pairs.count() 'first'
		for r2 in r1 + 1 upto pairs.count() 'next'
			for g1 in gapBias - 1 upto gapBias + 2 'firstGap'
				for g2 in gapBias - 1 upto gapBias + 2 'nextGap'
					var st = startState(spans, pick: pick)
					relateChoice(st, pair: pairs[r1], gap: g1)
					relateChoice(st, pair: pairs[r2], gap: g2)
					out.push(st)
				end 'nextGap'
			end 'firstGap'
		end 'next'
	end 'first'
end 'appendTwoRelations'

// appendChains adds every chain q0 - q1, q1 - q2, q2 - q3 over the four quantities in each order, with each gap from -1 to 1.
function appendChains(mutates out RangeStateList, qs Ints, spans SpanList)
	let n = qs.count()
	var order = Ints.create(n)
	var more = true
	while more 'orders'
		if order[0] != order[1] and order[0] != order[2] and order[0] != order[3] and order[1] != order[2] and order[1] != order[3] and order[2] != order[3] 'distinct'
			appendChainGaps(out, qs: qs, order: order, spans: spans)
		end 'distinct'
		more = stepFrom(order, from: 0 as Count, top: try n - 1 otherwise panic("rules: no quantities"))
	end 'orders'
end 'appendChains'

// appendChainGaps adds the chain through the quantities in order with each gap from -1 to 1.
function appendChainGaps(mutates out RangeStateList, qs Ints, order Ints, spans SpanList)
	var gaps = Ints.create(3)
	for i in 0 upto 3 'start'
		gaps[i] = gapBias - 1
	end 'start'
	var more = true
	while more 'gaps'
		var st = startState(spans, pick: Ints.create(quantities))
		for i in 0 upto 3 'links'
			relateChoice(st, pair: relationPair(qs[order[i]], lo: qs[order[i + 1]]), gap: gaps[i])
		end 'links'
		out.push(st)
		more = stepFrom(gaps, from: gapBias - 1, top: gapBias + 1)
	end 'gaps'
end 'appendChainGaps'

// stepFrom steps the digits of v, each from from to top, and says whether there is a next.
function stepFrom(mutates v Ints, from Count, top Count) returns bool
	for i in 0 upto v.count() 'each'
		if v[i] < top 'step'
			v[i] = past(v[i])
			return true
		end 'step'
		v[i] = from
	end 'each'
	return false
end 'stepFrom'

// relationOps are every guard between two of a, count(c) and n with offsets on either side, computed exactly and modulo the
// word, every guard of n with a constant, the tests of emptiness of c, the count effects on c and on g, a write of c, g and
// g.0, every assignment of a and n, every binding of a or n to a, count(c), count(g.0) or n plus -2 to 2, the top of a
// loop for each set of assignable roots, a pop of c and of g.0 and a remove from each at a and at n, and the midpoint of
// every two of a, count(c), count(g.0) and n given to a or n.
function relationOps() returns Ops
	let cmps = comparisons()
	let effects = countEffects()
	let sides = sideQuantities()
	var out = Ops.create(0)
	for x in 0 upto sides.count() 'x'
		for y in 0 upto sides.count() 'y'
			if x != y 'apart'
				for i in 0 upto cmps.count() 'cmp'
					appendShifted(out, x: sides[x], op: cmps[i], y: sides[y])
				end 'cmp'
			end 'apart'
		end 'y'
	end 'x'
	for i in 0 upto cmps.count() 'constants'
		for k in 0 upto universeTop + 2 'k'
			out.push(Op.constant(second, op: cmps[i].clone(), k: k))
		end 'k'
	end 'constants'
	out.push(Op.empty(1 as Count, truth: true))
	out.push(Op.empty(1 as Count, truth: false))
	for i in 0 upto effects.count() 'effects'
		out.push(Op.effect(1 as Count, effect: effects[i]))
		out.push(Op.effect(3 as Count, effect: effects[i]))
	end 'effects'
	out.push(Op.write(1 as Count))
	out.push(Op.write(3 as Count))
	out.push(Op.write(4 as Count))
	let qs = relationQuantities()
	for t in 0 upto sides.count() 'targets'
		if isLocalQuantity(sides[t]) 'local'
			for k in 0 upto universeTop + 1 'assign'
				out.push(Op.assign(sides[t], k: k))
			end 'assign'
			out.push(Op.assignAny(sides[t]))
			for s in 0 upto qs.count() 'sources'
				for k in -2 upto 3 'k'
					out.push(Op.bind(sides[t], source: qs[s], k: k))
				end 'k'
			end 'sources'
		end 'local'
	end 'targets'
	for mask in 1 upto 16 'masks'
		out.push(Op.forget(mask as Count))
	end 'masks'
	var indices = Ints.filled(1, value: 0)
	indices.push(second)
	appendAccesses(out, indices: indices)
	for t in 0 upto sides.count() 'midpointTargets'
		if isLocalQuantity(sides[t]) 'local'
			for low in 0 upto qs.count() 'low'
				for high in 0 upto qs.count() 'high'
					if low != high 'apart'
						out.push(Op.midpoint(sides[t], low: qs[low], high: qs[high]))
					end 'apart'
				end 'high'
			end 'low'
		end 'local'
	end 'midpointTargets'
	return out
end 'relationOps'

// appendShifted adds 'x op y' with no offset, with each offset on either side or both computed exactly, and with an offset
// computed modulo the word.
function appendShifted(mutates out Ops, x Count, op String, y Count)
	out.push(Op.compare(x, op: op.clone(), y: y))
	for d in -2 upto 3 'left'
		if d != 0 'offset'
			out.push(Op.shifted(x, dx: d, op: op.clone(), y: y, dy: 0, wraps: false))
		end 'offset'
	end 'left'
	out.push(Op.shifted(x, dx: 0, op: op.clone(), y: y, dy: 1, wraps: false))
	out.push(Op.shifted(x, dx: 1, op: op.clone(), y: y, dy: 1, wraps: false))
	out.push(Op.shifted(x, dx: 1, op: op.clone(), y: y, dy: 0, wraps: true))
	out.push(Op.shifted(x, dx: 0, op: op.clone(), y: y, dy: 1, wraps: true))
end 'appendShifted'

test 'relations follow chains, bindings, offsets and moves only as far as the values do'
	checkAll(relationStates(), ops: relationOps(), u: Universe.holding(heldAtCollection))
end 'relations follow chains, bindings, offsets and moves only as far as the values do'

// joinStates are the states the join is checked on: spans of a and count(c), at most one relation between them, and the
// state no path reaches.
function joinStates() returns RangeStateList
	let spans = spanChoices()
	var out = RangeStateList.create(0)
	out.push(RangeState.make(quantities, dead: true, kept: false))
	var pick = Ints.create(quantities)
	for s0 in 0 upto spans.count() 'a'
		for s1 in 0 upto spans.count() 'countC'
			pick[0] = s0
			pick[1] = s1
			out.push(startState(spans, pick: pick))
			for g in 1 upto 4 'gap'
				var above = startState(spans, pick: pick)
				relateChoice(above, pair: 1 * quantities, gap: g)
				out.push(above)
				var below = startState(spans, pick: pick)
				relateChoice(below, pair: 1, gap: g)
				out.push(below)
			end 'gap'
		end 'countC'
	end 'a'
	return out
end 'joinStates'

test 'a join keeps only what both paths know'
	let starts = joinStates()
	let u = Universe.holding(heldAtCollection or heldSecond)
	var states = States.new()
	var v = Ints.create(quantities)
	for i in 0 upto starts.count() 'first'
		for j in 0 upto starts.count() 'second'
			let m = states.mark()
			let a = states.list.count()
			states.list.push(starts[i].clone())
			let b = states.list.count()
			states.list.push(starts[j].clone())
			let joined = states.joined(a, b: b)
			var values = described(starts[i], u: u)
			values.append(described(starts[j], u: u))
			for k in 0 upto values.count() / quantities 'values'
				for q in 0 upto quantities 'value'
					v[q] = values[k * quantities + q]
				end 'value'
				if not holdsIn(states.list[joined], v: v) 'lost'
					panic("rules: the join of {stateText(starts[i])} and {stateText(starts[j])} is {stateText(states.list[joined])}, which leaves out {valuationText(v)}")
				end 'lost'
			end 'values'
			states.release(m)
		end 'second'
	end 'first'
end 'a join keeps only what both paths know'

// narrowSpans are every span from -2 to 2, with and without 0 ruled out.
function narrowSpans() returns SpanList
	var out = SpanList.create(0)
	for lo in -2 upto 3 'lo'
		for hi in lo upto 3 'hi'
			var s = Span.make(ast.I128.fromInt(lo), hi: ast.I128.fromInt(hi))
			out.push(s.clone())
			s.nonZero = true
			out.push(s)
		end 'hi'
	end 'lo'
	return out
end 'narrowSpans'

function comparesSigned(x FullRangeInt, op String, y FullRangeInt) returns bool
	return match op 'op'
		"<" gives x < y
		"<=" gives x <= y
		">" gives x > y
		">=" gives x >= y
		"==" gives x == y
		"!=" gives x != y
		default panic("rules: '{op}' is no comparison")
	end 'op'
end 'comparesSigned'

// checkGap fails unless the relation 'x op y' records holds of x and y.
function checkGap(op String, x FullRangeInt, y FullRangeInt)
	match consumes relationGap(op) 'gap'
		some(gap) then requireGap(op, x: x, y: y, gap: gap)
		none then _ = 0
	end 'gap'
end 'checkGap'

function requireGap(op String, x FullRangeInt, y FullRangeInt, gap ast.I128)
	if ast.I128.fromInt(x).sub(ast.I128.fromInt(y)).lt(gap) 'gapLost'
		panic("rules: '{op}' relates x - y >= {gap.toString()}, which x = {x}, y = {y} breaks")
	end 'gapLost'
end 'requireGap'

test 'a guard narrows a span to the values that satisfy it, and relates only what it proves'
	let spans = narrowSpans()
	let cmps = comparisons()
	for c in 0 upto cmps.count() 'cmps'
		let op = cmps[c].clone()
		for i in 0 upto spans.count() 'cur'
			for j in 0 upto spans.count() 'other'
				let next = narrowedSpan(spans[i], op: op, other: spans[j])
				for x in -2 upto 3 'x'
					for y in -2 upto 3 'y'
						let xv = ast.I128.fromInt(x)
						let yv = ast.I128.fromInt(y)
						if spans[i].has(xv) and spans[j].has(yv) and comparesSigned(x, op: op, y: y) 'satisfied'
							if rulesOut(next) or not next.has(xv) 'lost'
								panic("rules: x in {spanText(spans[i])} {op} y in {spanText(spans[j])} narrows x to {spanText(next)}, which leaves out x = {x} with y = {y}")
							end 'lost'
							checkGap(op, x: x, y: y)
						end 'satisfied'
					end 'y'
				end 'x'
			end 'other'
		end 'cur'
	end 'cmps'
end 'a guard narrows a span to the values that satisfy it, and relates only what it proves'

// BodyOp is a statement of a loop's body: an operation of the universe; a closure made in the body that captures the root
// at a holder to change it, which its calls change whenever they run; or a call of a closure made before the loop that
// captured it.
union BodyOp
	op(o Op)
	makes(holder Count)
	calls(holder Count)
end 'BodyOp'

typealias BodyOps = Array with BodyOp

// LoopItem is a part of a loop's body: a statement run on every iteration; one run on some iterations only, which then
// continue at once, the rest of the body left out; or a loop nested in the body, which runs its statement 0 to nestedRuns
// times.
union LoopItem
	always(op BodyOp)
	skipping(op BodyOp)
	nested(op BodyOp)
end 'LoopItem'

typealias LoopItems = Array with LoopItem

typealias LoopBodies = Array with LoopItems

// A loop runs its body loopIterations times at most, and the start of each iteration is checked. Values past loopTop are not
// followed, as values past the limits are not in checkAll: the rules are linear, so a fact broken further out is broken
// sooner by the same body. A valuation within loopTop is a number, its quantities a, count(c), count(g.0) and n as digits
// of base loopBase; g.0 is held at 0, as no fact here names it.
let loopIterations = 3 as Count

let loopTop = 5 as Count

let loopBase = 6 as Count

let nestedRuns = 2 as Count

// assignableRoots are a, c, g and n, every root of the universe: each is a var.
let assignableRoots = 15 as Count

function encoded(v Ints) returns Count
	return try v[0] + loopBase * (v[1] + loopBase * (v[2] + loopBase * v[second])) otherwise panic("rules: a valuation past the loop's universe")
end 'encoded'

function decoded(code Count) returns Ints
	var v = Ints.create(quantities)
	var rest = code
	v[0] = rest mod loopBase
	rest = rest / loopBase
	v[1] = rest mod loopBase
	rest = rest / loopBase
	v[2] = rest mod loopBase
	v[second] = rest / loopBase
	return v
end 'decoded'

// Explorer builds sets of valuations by their codes, telling by a mark of each code which are in the set being built.
type Explorer
	export var marks as Ints
	export var generation as Count

	static function new() returns Explorer
		var size = 1 as Count
		for _ in 0 upto 4 'digits'
			size = try size * loopBase otherwise panic("rules: a universe past the word")
		end 'digits'
		return Explorer{marks: Ints.create(size), generation: 0 as Count}
	end 'new'

	function begin(mutates self)
		generation = try generation + 1 otherwise panic("rules: too many sets")
	end 'begin'

	function add(mutates self, code Count, mutates set Ints)
		if marks[code] != generation 'fresh'
			marks[code] = generation
			set.push(code)
		end 'fresh'
	end 'add'
end 'Explorer'

// bodyReach is what a statement can make of the valuation v, quantity by quantity: an operation what concrete says, and a
// closure's call anything under the root it captured.
function bodyReach(b BodyOp, v Ints) returns Reaches
	return match b 'b'
		op(o) gives concrete(o, v: v)
		makes(h) gives capturedReach(h, v: v)
		calls(h) gives capturedReach(h, v: v)
	end 'b'
end 'bodyReach'

function capturedReach(h Count, v Ints) returns Reaches
	var out = Reaches.create(0)
	for q in 0 upto quantities 'same'
		out.push(held(v[q]))
	end 'same'
	writeOf(out, holder: holderPaths()[h])
	return out
end 'capturedReach'

// applyStatement adds to out every valuation within loopTop that the statement b can make of a valuation of set.
function applyStatement(mutates ex Explorer, b BodyOp, set Ints, mutates out Ints)
	var lo = Ints.create(quantities)
	var hi = Ints.create(quantities)
	for i in 0 upto set.count() 'each'
		let reaches = bodyReach(b, v: decoded(set[i]))
		var runs = true
		for q in 0 upto quantities 'bounds'
			if q == atCollection 'held'
				continue 'bounds'
			end 'held'
			if reaches[q].none or reaches[q].lo > loopTop 'cannot'
				runs = false
				break 'bounds'
			end 'cannot'
			lo[q] = reaches[q].lo
			hi[q] = minCount(reaches[q].hi, b: loopTop)
		end 'bounds'
		if runs 'runs'
			var v = lo.clone()
			var more = true
			while more 'values'
				ex.add(encoded(v), set: out)
				more = nextValuation(v, lo: lo, hi: hi)
			end 'values'
		end 'runs'
	end 'each'
end 'applyStatement'

function appliedTo(mutates ex Explorer, b BodyOp, set Ints) returns Ints
	var out = Ints.create(0)
	ex.begin()
	applyStatement(ex, b: b, set: set, out: out)
	return out
end 'appliedTo'

// united is the valuations of a and of b.
function united(mutates ex Explorer, a Ints, b Ints) returns Ints
	var out = Ints.create(0)
	ex.begin()
	for i in 0 upto a.count() 'a'
		ex.add(a[i], set: out)
	end 'a'
	for i in 0 upto b.count() 'b'
		ex.add(b[i], set: out)
	end 'b'
	return out
end 'united'

// ranBody is the valuations at the start of the next iteration from those of set at the start of this one: what reaches the
// end of the body, and what a skipping statement sends to the next iteration at once.
function ranBody(mutates ex Explorer, items LoopItems, set Ints) returns Ints
	var flow = set.clone()
	var skipped = Ints.create(0)
	for i in 0 upto items.count() 'items'
		match items[i] 'item'
			always(b) then flow = appliedTo(ex, b: b, set: flow)
			skipping(b) then skipped = ranSkipping(ex, skipped: skipped, b: b, flow: flow)
			nested(b) then flow = ranNested(ex, b: b, set: flow)
		end 'item'
	end 'items'
	return united(ex, a: flow, b: skipped)
end 'ranBody'

// ranSkipping adds to skipped what a statement run on some iterations only sends to the next one.
function ranSkipping(mutates ex Explorer, skipped Ints, b BodyOp, flow Ints) returns Ints
	let ran = appliedTo(ex, b: b, set: flow)
	return united(ex, a: skipped, b: ran)
end 'ranSkipping'

function ranNested(mutates ex Explorer, b BodyOp, set Ints) returns Ints
	var out = set.clone()
	var runs = set.clone()
	for _ in 0 upto nestedRuns 'runs'
		runs = appliedTo(ex, b: b, set: runs)
		out = united(ex, a: out, b: runs)
	end 'runs'
	return out
end 'ranNested'

// noteBodyOp notes a statement's effects as the scan of a loop's body does (loops.maxon): an operation's count effect on
// its holder, a write's holder and an assignment's local changed, a closure made changing the root it captures, and a call
// of a closure made before the loop opaque.
function noteBodyOp(mutates scans LoopScans, b BodyOp)
	match b 'b'
		op(o) then noteOp(scans, o: o)
		makes(h) then scans.change(holderPlace(h), effect: ast.CountEffect.countChange)
		calls(h) then scans.opaque()
	end 'b'
end 'noteBodyOp'

function noteOp(mutates scans LoopScans, o Op)
	match o 'o'
		effect(h, e) then scans.change(holderPlace(h), effect: e)
		write(h) then scans.change(holderPlace(h), effect: ast.CountEffect.countChange)
		assign(t, k) then scans.change(quantityPlace(t), effect: ast.CountEffect.countChange)
		assignAny(t) then scans.change(quantityPlace(t), effect: ast.CountEffect.countChange)
		bind(t, source, k) then scans.change(quantityPlace(t), effect: ast.CountEffect.countChange)
		compare(x, cmp, y) then panic("rules: a guard is no statement of a body")
		constant(x, cmp, k) then panic("rules: a guard is no statement of a body")
		shifted(x, dx, cmp, y, dy, wraps) then panic("rules: a guard is no statement of a body")
		empty(q, truth) then panic("rules: a guard is no statement of a body")
		forget(mask) then panic("rules: a loop top is no statement of a body")
		pop(h) then scans.change(holderPlace(h), effect: ast.intrinsicCountEffect(ast.Intrinsic.intrArrayPop))
		removeAt(h, i) then scans.change(holderPlace(h), effect: ast.intrinsicCountEffect(ast.Intrinsic.intrArrayRemove))
		midpoint(t, low, high) then scans.change(quantityPlace(t), effect: ast.CountEffect.countChange)
	end 'o'
end 'noteOp'

// scannedBody is the scan of a loop whose body is items, as the walk's scan makes it, and the loop is its first.
function scannedBody(items LoopItems) returns LoopScans
	var scans = LoopScans.new()
	_ = scans.enter(0 as ast.NodeID)
	for i in 0 upto items.count() 'items'
		match items[i] 'item'
			always(b) then noteBodyOp(scans, b: b)
			skipping(b) then noteBodyOp(scans, b: b)
			nested(b) then noteNested(scans, b: b)
		end 'item'
	end 'items'
	scans.leave()
	return scans
end 'scannedBody'

function noteNested(mutates scans LoopScans, b BodyOp)
	_ = scans.enter(1 as ast.NodeID)
	noteBodyOp(scans, b: b)
	scans.leave()
end 'noteNested'

function bodyOpText(b BodyOp) returns String
	let holders = holderPaths()
	return match b 'b'
		op(o) gives opText(o)
		makes(h) gives "make a closure that changes {holders[h]}"
		calls(h) gives "call a closure made before the loop that changes {holders[h]}"
	end 'b'
end 'bodyOpText'

function itemText(item LoopItem) returns String
	return match item 'item'
		always(b) gives bodyOpText(b)
		skipping(b) gives "if any: {bodyOpText(b)}; continue"
		nested(b) gives "a loop of: {bodyOpText(b)}"
	end 'item'
end 'itemText'

function bodyText(items LoopItems) returns String
	var text = ""
	for i in 0 upto items.count() 'items'
		if i > 0 'more'
			text = "{text}; "
		end 'more'
		text = "{text}{itemText(items[i])}"
	end 'items'
	return "[{text}]"
end 'bodyText'

// loopBodyOps are the statements of loop bodies: every count effect on c and on g.0, a call that changes g, which holds
// g.0, a write of each holder, assignments of a and n, a = a + 1, n = count(c), closures made that change a, c or g, and
// calls of closures made before the loop that change c or g.
function loopBodyOps() returns BodyOps
	let effects = countEffects()
	var out = BodyOps.create(0)
	for i in 0 upto effects.count() 'effects'
		out.push(BodyOp.op(Op.effect(1 as Count, effect: effects[i])))
		out.push(BodyOp.op(Op.effect(4 as Count, effect: effects[i])))
	end 'effects'
	out.push(BodyOp.op(Op.effect(3 as Count, effect: ast.CountEffect.countChange)))
	for h in 1 upto holderPaths().count() 'writes'
		out.push(BodyOp.op(Op.write(h)))
	end 'writes'
	out.push(BodyOp.op(Op.assignAny(0 as Count)))
	out.push(BodyOp.op(Op.assignAny(second)))
	out.push(BodyOp.op(Op.bind(0 as Count, source: 0 as Count, k: 1)))
	out.push(BodyOp.op(Op.bind(second, source: 1 as Count, k: 0)))
	out.push(BodyOp.makes(0 as Count))
	out.push(BodyOp.makes(1 as Count))
	out.push(BodyOp.makes(3 as Count))
	out.push(BodyOp.calls(1 as Count))
	out.push(BodyOp.calls(3 as Count))
	return out
end 'loopBodyOps'

// pairedOps are the statements the bodies of two parts are made of: the moves of count(c), a pop of g.0, a write of g.1,
// a = a + 1 and a call of a closure that changes c.
function pairedOps() returns BodyOps
	var out = BodyOps.create(0)
	out.push(BodyOp.op(Op.effect(1 as Count, effect: ast.CountEffect.countGrowOne)))
	out.push(BodyOp.op(Op.effect(1 as Count, effect: ast.CountEffect.countShrinkOne)))
	out.push(BodyOp.op(Op.effect(1 as Count, effect: ast.CountEffect.countGrow)))
	out.push(BodyOp.op(Op.effect(1 as Count, effect: ast.CountEffect.countShrink)))
	out.push(BodyOp.op(Op.effect(1 as Count, effect: ast.CountEffect.countKeep)))
	out.push(BodyOp.op(Op.effect(4 as Count, effect: ast.CountEffect.countShrinkOne)))
	out.push(BodyOp.op(Op.write(5 as Count)))
	out.push(BodyOp.op(Op.bind(0 as Count, source: 0 as Count, k: 1)))
	out.push(BodyOp.calls(1 as Count))
	return out
end 'pairedOps'

function oneItem(consumes item LoopItem) returns LoopItems
	var out = LoopItems.create(0)
	out.push(item)
	return out
end 'oneItem'

function twoItems(consumes first LoopItem, consumes next LoopItem) returns LoopItems
	var out = oneItem(first)
	out.push(next)
	return out
end 'twoItems'

// loopBodies are every statement of loopBodyOps as a body of its own, run always, on some iterations, or in a nested loop;
// and each of pairedOps run so, followed by each of them run always.
function loopBodies() returns LoopBodies
	let ops = loopBodyOps()
	var out = LoopBodies.create(0)
	for i in 0 upto ops.count() 'single'
		out.push(oneItem(LoopItem.always(ops[i].clone())))
		out.push(oneItem(LoopItem.skipping(ops[i].clone())))
		out.push(oneItem(LoopItem.nested(ops[i].clone())))
	end 'single'
	let pairs = pairedOps()
	for i in 0 upto pairs.count() 'first'
		for j in 0 upto pairs.count() 'next'
			out.push(twoItems(LoopItem.always(pairs[i].clone()), next: LoopItem.always(pairs[j].clone())))
			out.push(twoItems(LoopItem.skipping(pairs[i].clone()), next: LoopItem.always(pairs[j].clone())))
			out.push(twoItems(LoopItem.nested(pairs[i].clone()), next: LoopItem.always(pairs[j].clone())))
		end 'next'
	end 'first'
	return out
end 'loopBodies'

// loopStates are the states a loop is entered with: none known, each span of a, count(c), count(g.0) and n, and each
// relation between two of them. A loop's top keeps or forgets each fact by itself, by the effects of the body alone, so a
// fact kept from a state of one fact is kept from every state that holds it, which holds of fewer valuations.
function loopStates() returns RangeStateList
	let spans = spanChoices()
	let qs = relationQuantities()
	let pairs = relationPairs(qs)
	var out = RangeStateList.create(0)
	out.push(startState(spans, pick: Ints.create(quantities)))
	for q in 0 upto qs.count() 'spans'
		for s in 1 upto spans.count() 'span'
			var pick = Ints.create(quantities)
			pick[qs[q]] = s
			out.push(startState(spans, pick: pick))
		end 'span'
	end 'spans'
	for r in 0 upto pairs.count() 'pair'
		for g in 0 upto gapChoices 'gap'
			var st = startState(spans, pick: Ints.create(quantities))
			relateChoice(st, pair: pairs[r], gap: g)
			out.push(st)
		end 'gap'
	end 'pair'
	return out
end 'loopStates'

// loopStarts are the valuations a loop is entered with, each of a, count(c), count(g.0) and n from 0 to universeTop.
function loopStarts() returns Ints
	var out = Ints.create(0)
	var v = Ints.create(quantities)
	var choice = Ints.create(4)
	var more = true
	while more 'each'
		v[0] = choice[0]
		v[1] = choice[1]
		v[2] = choice[2]
		v[second] = choice[3]
		out.push(encoded(v))
		more = stepFrom(choice, from: 0 as Count, top: universeTop)
	end 'each'
	return out
end 'loopStarts'

// Reached are the valuations at the start of each iteration from one valuation where the loop is entered: codes[i] at the
// start of iteration iterations[i], counted from 0.
type Reached
	export var codes as Ints
	export var iterations as Ints

	static function new() returns Reached
		return Reached{codes: Ints.create(0), iterations: Ints.create(0)}
	end 'new'
end 'Reached'

typealias ReachedList = Array with Reached

function reachedFrom(mutates ex Explorer, items LoopItems, start Count) returns Reached
	var out = Reached.new()
	var set = Ints.create(0)
	set.push(start)
	for k in 0 upto loopIterations + 1 'iterations'
		for i in 0 upto set.count() 'codes'
			out.codes.push(set[i])
			out.iterations.push(k)
		end 'codes'
		if k < loopIterations 'more'
			set = ranBody(ex, items: items, set: set)
		end 'more'
	end 'iterations'
	return out
end 'reachedFrom'

// checkLoopTop fails unless every fact the top of a loop with the body items keeps from each state holds at the start of
// every iteration that a valuation the state describes reaches.
function checkLoopTop(items LoopItems, states RangeStateList, starts Ints, reached ReachedList)
	let scans = scannedBody(items)
	let mutable = rootMask(assignableRoots)
	let wide = wideSpans()
	let places = quantityPlaces()
	for s in 0 upto states.count() 'states'
		var top = states[s].clone()
		top.keepThrough(scans, loop: 0 as Count, mutable: mutable, wide: wide)
		let entered = Bounds.of(states[s], derive: false, places: places)
		let kept = Bounds.of(top, derive: true, places: places)
		for i in 0 upto starts.count() 'starts'
			let from = decoded(starts[i])
			if entered.broken(from) == "" 'described'
				for j in 0 upto reached[i].codes.count() 'reached'
					let v = decoded(reached[i].codes[j])
					let why = kept.broken(v)
					if why != "" 'broken'
						panic("rules: a loop of {bodyText(items)} entered with {stateText(states[s])} keeps {stateText(top)} at its top{why}, but {valuationText(from)} reaches {valuationText(v)} at the start of iteration {reached[i].iterations[j]}")
					end 'broken'
				end 'reached'
			end 'described'
		end 'starts'
	end 'states'
end 'checkLoopTop'

// checkCounter fails unless the facts a for loop with the body items records of its counter hold at the start of every
// iteration that runs: below its bound, count(c), count(g.0) or n less 1 or 0, where the body only raises it, and above its
// start, a or count(c) plus 0 or 1, where the body only lowers it. The counter starts at 0 below a bound, and below no bound
// above a start.
function checkCounter(items LoopItems, starts Ints, reached ReachedList)
	let scans = scannedBody(items)
	let mutable = rootMask(assignableRoots)
	let bounds = relationQuantities()
	for b in 1 upto bounds.count() 'bounds'
		let q = bounds[b]
		if risesOnly(scans.effectOn(0 as Count, q: quantityPlace(q), mutable: mutable)) 'rises'
			for by in -1 upto 1 'by'
				checkBound(items, q: q, by: by, inclusive: false, starts: starts, reached: reached)
				checkBound(items, q: q, by: by, inclusive: true, starts: starts, reached: reached)
			end 'by'
		end 'rises'
	end 'bounds'
	for q in 0 upto 2 'starts'
		if fallsOnly(scans.effectOn(0 as Count, q: quantityPlace(q), mutable: mutable)) 'falls'
			for by in 0 upto 2 'by'
				checkStart(items, q: q, by: by, starts: starts, reached: reached)
			end 'by'
		end 'falls'
	end 'starts'
end 'checkCounter'

function checkBound(items LoopItems, q Count, by FullRangeInt, inclusive bool, starts Ints, reached ReachedList)
	let gap = small(boundGap(ast.I128.fromInt(by), exact: true, inclusive: inclusive).unwrap())
	for i in 0 upto starts.count() 'starts'
		let from = decoded(starts[i])
		let bound = try signed(from[q]) + by otherwise panic("rules: a bound past the word")
		for j in 0 upto reached[i].codes.count() 'reached'
			let counter = signed(reached[i].iterations[j])
			let runs = counter <= bound if inclusive else counter < bound
			let v = decoded(reached[i].codes[j])
			if runs and (try signed(v[q]) - counter otherwise panic("rules: a difference past the word")) < gap 'broken'
				panic("rules: a for loop of {bodyText(items)} up to {quantityText(quantityPlace(q))} + {by} (reached: {inclusive}) records the bound at least {gap} above the counter, but {valuationText(from)} reaches {valuationText(v)} with the counter at {counter}")
			end 'broken'
		end 'reached'
	end 'starts'
end 'checkBound'

function checkStart(items LoopItems, q Count, by FullRangeInt, starts Ints, reached ReachedList)
	let gap = small(startGap(ast.I128.fromInt(by), exact: true).unwrap())
	for i in 0 upto starts.count() 'starts'
		let from = decoded(starts[i])
		let start = try signed(from[q]) + by otherwise panic("rules: a start past the word")
		for j in 0 upto reached[i].codes.count() 'reached'
			let counter = try start + signed(reached[i].iterations[j]) otherwise panic("rules: a counter past the word")
			let v = decoded(reached[i].codes[j])
			if (try counter - signed(v[q]) otherwise panic("rules: a difference past the word")) < gap 'broken'
				panic("rules: a for loop of {bodyText(items)} from {quantityText(quantityPlace(q))} + {by} records the counter at least {gap} above it, but {valuationText(from)} reaches {valuationText(v)} with the counter at {counter}")
			end 'broken'
		end 'reached'
	end 'starts'
end 'checkStart'

test 'the top of a loop keeps only what no iteration of its body can falsify'
	let bodies = loopBodies()
	let states = loopStates()
	let starts = loopStarts()
	var ex = Explorer.new()
	for b in 0 upto bodies.count() 'bodies'
		var reached = ReachedList.create(0)
		for i in 0 upto starts.count() 'starts'
			reached.push(reachedFrom(ex, items: bodies[b], start: starts[i]))
		end 'starts'
		checkLoopTop(bodies[b], states: states, starts: starts, reached: reached)
		checkCounter(bodies[b], starts: starts, reached: reached)
	end 'bodies'
end 'the top of a loop keeps only what no iteration of its body can falsify'

// ClaimSide is a side of a comparison a loop invariant states: a quantity moved by a constant, or a constant.
union ClaimSide
	quantity(q Count, by FullRangeInt)
	fixed(k Count)
end 'ClaimSide'

typealias ClaimSides = Array with ClaimSide

// claimSide is the side as the walk's rangeSideOf makes it, with the span the state knows of its quantity.
function claimSide(st RangeState, side ClaimSide) returns CompareSide
	return match side 'side'
		quantity(q, by) gives CompareSide.placed(quantityPlace(q), span: spanOf(st, p: quantityPlace(q)), by: ast.I128.fromInt(by))
		fixed(k) gives CompareSide.constant(ast.I128.fromCount(k))
	end 'side'
end 'claimSide'

function claimValue(side ClaimSide, v Ints) returns FullRangeInt
	return match side 'side'
		quantity(q, by) gives try signed(v[q]) + by otherwise panic("rules: a side past the word")
		fixed(k) gives signed(k)
	end 'side'
end 'claimValue'

function claimText(side ClaimSide) returns String
	return match side 'side'
		quantity(q, by) gives "{quantityText(quantityPlace(q))} + {by}"
		fixed(k) gives "{k}"
	end 'side'
end 'claimText'

function isFixed(side ClaimSide) returns bool
	return match side 'side'
		quantity(q, by) gives false
		fixed(k) gives true
	end 'side'
end 'isFixed'

// claimLefts are the left sides of the claims: a, count(c), count(g.0) and n moved by -1 to 1, and the constants 0 to 3;
// claimRights the same quantities moved by 0 or 1, and the constants.
function claimLefts() returns ClaimSides
	return claimSides(-1, past: 2)
end 'claimLefts'

function claimRights() returns ClaimSides
	return claimSides(0, past: 2)
end 'claimRights'

function claimSides(from FullRangeInt, past FullRangeInt) returns ClaimSides
	let qs = relationQuantities()
	var out = ClaimSides.create(0)
	for i in 0 upto qs.count() 'quantities'
		for by in from upto past 'by'
			out.push(ClaimSide.quantity(qs[i], by: by))
		end 'by'
	end 'quantities'
	for k in 0 upto universeTop + 2 'constants'
		out.push(ClaimSide.fixed(k))
	end 'constants'
	return out
end 'claimSides'

// invariantComparisons are the comparisons a loop invariant may state, every one but '!='.
function invariantComparisons() returns Strings
	var out = Strings.create(0)
	let cmps = comparisons()
	for i in 0 upto cmps.count() 'each'
		if cmps[i] != "!=" 'bounds'
			out.push(cmps[i].clone())
		end 'bounds'
	end 'each'
	return out
end 'invariantComparisons'

// checkClaims fails where the state proves a comparison, as provesCompared decides an invariant at the top of a loop, the end
// of its body or a continue, that a valuation it describes breaks.
function checkClaims(st RangeState, values Ints, lefts ClaimSides, rights ClaimSides, cmps Strings)
	var v = Ints.create(quantities)
	for x in 0 upto lefts.count() 'lefts'
		for y in 0 upto rights.count() 'rights'
			if isFixed(lefts[x]) and isFixed(rights[y]) 'constants'
				continue 'rights'
			end 'constants'
			let sx = claimSide(st, side: lefts[x])
			let sy = claimSide(st, side: rights[y])
			for c in 0 upto cmps.count() 'cmps'
				if st.provesCompared(sx, op: cmps[c], y: sy) 'proven'
					for i in 0 upto values.count() / quantities 'values'
						for q in 0 upto quantities 'value'
							v[q] = values[i * quantities + q]
						end 'value'
						if not comparesSigned(claimValue(lefts[x], v: v), op: cmps[c], y: claimValue(rights[y], v: v)) 'broken'
							panic("rules: {stateText(st)} proves {claimText(lefts[x])} {cmps[c]} {claimText(rights[y])}, which {valuationText(v)} breaks")
						end 'broken'
					end 'values'
				end 'proven'
			end 'cmps'
		end 'rights'
	end 'lefts'
end 'checkClaims'

test 'a loop invariant is proven only where every value the state describes keeps it'
	let lefts = claimLefts()
	let rights = claimRights()
	let cmps = invariantComparisons()
	let u = Universe.holding(heldAtCollection)
	let states = relationStates()
	for s in 0 upto states.count() 'states'
		let values = described(states[s], u: u)
		if values.count() > 0 'reached'
			checkClaims(states[s], values: values, lefts: lefts, rights: rights, cmps: cmps)
		end 'reached'
	end 'states'
end 'a loop invariant is proven only where every value the state describes keeps it'
