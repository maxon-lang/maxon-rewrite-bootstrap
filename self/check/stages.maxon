// The stages of the check, each of one module: the driver runs them as tasks of its graph, a module's stage after the
// module's stage before it and after the same stage of the modules it names. A stage takes its module's state `mutates`
// and the project as the read-only outputs of the modules it waited on.

// EntryRole is what the declare of a module does about the program's entry function, which the declarations of every
// module decide before the declare starts: nothing, check the module's main as the entry, or report it as a second one.
export enum EntryRole
	none
	entry
	second
end 'EntryRole'

// A ModuleState is what a module's check carries from one stage to the next, and what each of its stages writes: the
// model's part of it (unit), which the driver lends the module for each task, and the checker's.
export type ModuleState
	export var unit as ast.ModuleState
	export var checker as Checker
	// paramsOk says for each declaration whether its type parameters were declared without an error.
	export var paramsOk as ByteArray
	// functions are the functions the declare stage declared, whose bodies the bodies stage types.
	export var functions as ast.FuncIDList
	// constants are the module's constants in the order they are typed.
	export var constants as OrdinalList
	export var entryRole as EntryRole
	// entry is the program's entry function, which the declare of the module whose role is entry finds.
	export var entry as ast.FuncID

	export static function make(consumes checker Checker, entryRole EntryRole) returns ModuleState
		let module = checker.modID
		return ModuleState{unit: ast.ModuleState.idle(module), checker: checker, paramsOk: ByteArray.create(0), functions: ast.FuncIDList.create(0), constants: OrdinalList.create(0), entryRole: entryRole, entry: ast.noFunc}
	end 'make'
end 'ModuleState'

// EntryPlan is what the declarations of every module decide about the program's entry function, which the task that orders
// the modules finds: the module whose declare checks it, and whether the program needs one that no module declares.
export type EntryPlan
	export var module as table.Option with Count
	export var missing as bool
	// makesProgram is whether the compile makes an executable, which needs a main even in the runtime's own project.
	export var makesProgram as bool

	export static function none(makesProgram bool) returns EntryPlan
		return EntryPlan{module: table.Option.none, missing: false, makesProgram: makesProgram}
	end 'none'
end 'EntryPlan'

// ModuleChecked is what the check of one module gives the generate stage, its product: the functions its declare declared and
// the ones among them that call a generic or go through a bound, tests left out, and the entry function if its declare found it.
export type ModuleChecked
	export var functions as ast.FuncIDList
	export var callers as ast.FuncIDList
	export var entry as ast.FuncID
	// tests are the module's tests, in order, in a compile of tests, which lowers them with the functions.
	export var tests as ast.FuncIDList

	export static function make(consumes functions ast.FuncIDList, consumes callers ast.FuncIDList, entry ast.FuncID) returns ModuleChecked
		return ModuleChecked{functions: functions, callers: callers, entry: entry, tests: ast.FuncIDList.create(0)}
	end 'make'

	export static function none() returns ModuleChecked
		return ModuleChecked.make(ast.FuncIDList.create(0), callers: ast.FuncIDList.create(0), entry: ast.noFunc)
	end 'none'
end 'ModuleChecked'

// Checked is what the check of a project gives the generate stage: the entry, and by module the functions the declare stage
// declared and the ones among them that call a generic or go through a bound.
export type Checked
	export var entry as ast.FuncID
	export var functions as FuncIDLists
	export var callers as FuncIDLists

	export static function make(entry ast.FuncID, consumes functions FuncIDLists, consumes callers FuncIDLists) returns Checked
		return Checked{entry: entry, functions: functions, callers: callers}
	end 'make'

	export static function none() returns Checked
		return Checked{entry: ast.noFunc, functions: FuncIDLists.create(0), callers: FuncIDLists.create(0)}
	end 'none'

	// add takes in the product of the check of the next module, in module order.
	export function add(mutates self, consumes made ModuleChecked)
		var held = made
		if held.entry != ast.noFunc 'entry'
			entry = held.entry
		end 'entry'
		functions.push(exchange(held.functions, value: ast.FuncIDList.create(0)))
		callers.push(exchange(held.callers, value: ast.FuncIDList.create(0)))
	end 'add'
end 'Checked'

export typealias ModuleOrder = Array with diag.ModuleID

export typealias FuncIDLists = Array with ast.FuncIDList

// planEntry decides from the declarations of the modules of order which of them checks the program's entry function: the one
// whose entry comes first in the order of the program's files.
export function planEntry(p ast.Project, order ModuleOrder, makesProgram bool) returns EntryPlan
	var plan = EntryPlan.none(makesProgram)
	plan.module = firstEntryModule(plan, p: p, order: order)
	plan.missing = not plan.module.isSome() and holdsAnEntryModule(plan, p: p, order: order)
	return plan
end 'planEntry'

// startModule is the check of module as its first stage begins it, from typing, with what its declare does about the entry
// function (entryRoleOf).
export function startModule(module diag.ModuleID, consumes typing ast.Typing, role EntryRole) returns ModuleState
	return ModuleState.make(Checker.make(module, typing: typing), entryRole: role)
end 'startModule'

// entryRoleOf is what the declare of the module does about the program's entry function, which plan decided.
export function entryRoleOf(plan EntryPlan, p ast.Project, modIdx Count) returns EntryRole
	if not mayHoldEntry(plan, p: p, modIdx: modIdx) or not declaresEntry(p, modIdx: modIdx) 'none'
		return EntryRole.none
	end 'none'
	if isModule(plan.module, modIdx: modIdx) 'entry'
		return EntryRole.entry
	end 'entry'
	return EntryRole.second
end 'entryRoleOf'

// withoutTests is the functions that are not tests: a test is checked, and no program is made of it.
function withoutTests(p ast.Project, ms ast.ModuleState, consumes functions ast.FuncIDList) returns ast.FuncIDList
	var kept = ast.FuncIDList.create(0)
	for i in 0 upto functions.count() 'each'
		if not ast.funcEntry(ms.funcs, funcReads: p.funcs, f: functions[i]).isTest 'program'
			kept.push(functions[i])
		end 'program'
	end 'each'
	return kept
end 'withoutTests'

// endModule ends the check of a module, whose state its last stage holds: it gives the module's typing, which the stages
// after the check read of its bodies, and what the generate stage needs of its check.
export function endModule(mutates state ModuleState, p ast.Project, keepsTests bool, sets typing ast.Typing) returns ModuleChecked
	let modID = state.checker.modID
	typing = exchange(state.checker.typing, value: ast.Typing.new(modID))
	var functions = exchange(state.functions, value: ast.FuncIDList.create(0))
	var callers = exchange(state.checker.callers, value: ast.FuncIDList.create(0))
	var tests = ast.FuncIDList.create(0)
	if keepsTests 'tests'
		tests = testsAmong(p, ms: state.unit, functions: functions)
	end 'tests' else 'program'
		functions = withoutTests(p, ms: state.unit, functions: functions)
		callers = withoutTests(p, ms: state.unit, functions: callers)
	end 'program'
	var checked = ModuleChecked.make(functions, callers: callers, entry: entryOf(state))
	checked.tests = tests
	return checked
end 'endModule'

// entryOf is the program's entry function where the module's declare found it, and none elsewhere.
export function entryOf(state ModuleState) returns ast.FuncID
	if state.entryRole == EntryRole.entry 'entry'
		return state.entry
	end 'entry'
	return ast.noFunc
end 'entryOf'

// testsAmong is the tests among functions, in order: a compile of tests lowers them and its executable runs them.
function testsAmong(p ast.Project, ms ast.ModuleState, functions ast.FuncIDList) returns ast.FuncIDList
	var tests = ast.FuncIDList.create(0)
	for i in 0 upto functions.count() 'each'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: functions[i]).isTest 'test'
			tests.push(functions[i])
		end 'test'
	end 'each'
	return tests
end 'testsAmong'

// moduleAliases declares the bounds of the type parameters of the module's types, then its typealiases of instances.
export function moduleAliases(mutates state ModuleState, p ast.Project, mutates errs diag.ErrorList)
	state.paramsOk = declareTypeParamBounds(state.checker, p: p, ms: state.unit, errs: errs)
	declareAliases(state.checker, p: p, ms: state.unit, errs: errs)
end 'moduleAliases'

// moduleDeclare declares the module's members and signatures, and checks the entry function where the module declares one:
// the entry is the one that comes first in the order of the program's files, whatever directory it is in, and another
// module that declares one has a duplicate.
export function moduleDeclare(mutates state ModuleState, p ast.Project, mutates errs diag.ErrorList)
	let paramsOk = state.paramsOk.clone()
	state.functions = declareModule(state.checker, p: p, ms: state.unit, paramsOk: paramsOk, errs: errs)
	match state.entryRole 'role'
		none then return
		entry then state.entry = checkMain(state.checker, p: p, ms: state.unit, errs: errs)
		second then reportSecondEntry(state.checker, p: p, ms: state.unit, errs: errs)
	end 'role'
end 'moduleDeclare'

// projectEntry is the part of the declare that is of no one module: the error of a program in which no module declares the
// entry function.
export function projectEntry(plan EntryPlan, mutates errs diag.ErrorList)
	if plan.missing 'missing'
		reportNoEntry(errs)
	end 'missing'
end 'projectEntry'

// firstEntryModule is the module whose entry function comes first in the order of the program's files, or none where no module
// declares one.
function firstEntryModule(plan EntryPlan, p ast.Project, order ModuleOrder) returns table.Option with Count
	var found = false
	var first = 0 as Count
	var firstOrder = ""
	for i in 0 upto order.count() 'each'
		let m = ast.modIndex(order[i])
		if not mayHoldEntry(plan, p: p, modIdx: m) or not declaresEntry(p, modIdx: m) 'noEntry'
			continue 'each'
		end 'noEntry'
		let order = entryOrder(p, modIdx: m)
		if not found or diag.stringLess(order, b: firstOrder) 'earlier'
			first = m
			firstOrder = order
			found = true
		end 'earlier'
	end 'each'
	if found 'some'
		return table.Option.some(first)
	end 'some'
	return table.Option.none
end 'firstEntryModule'

function isModule(found table.Option with Count, modIdx Count) returns bool
	return match found 'o'
		some(m) gives m == modIdx
		none gives false
	end 'o'
end 'isModule'

// mayHoldEntry is whether the module is where the program's entry function is looked for: every module of the program, and
// the runtime's and the standard library's only when the compile makes an executable, which a check of either does not.
function mayHoldEntry(plan EntryPlan, p ast.Project, modIdx Count) returns bool
	return not p.modules[modIdx].isRuntime and not p.modules[modIdx].isLibrary or plan.makesProgram
end 'mayHoldEntry'

function holdsAnEntryModule(plan EntryPlan, p ast.Project, order ModuleOrder) returns bool
	for i in 0 upto order.count() 'each'
		if mayHoldEntry(plan, p: p, modIdx: ast.modIndex(order[i])) 'may'
			return true
		end 'may'
	end 'each'
	return false
end 'holdsAnEntryModule'

// moduleConstantOrder orders the module's constants and raw values, each after the ones its value names.
export function moduleConstantOrder(mutates state ModuleState, p ast.Project, mutates errs diag.ErrorList)
	state.constants = constantOrder(state.checker, p: p, ms: state.unit, errs: errs)
end 'moduleConstantOrder'

// moduleConstants types the module's constants and the raw values of its enums and unions, each after those it names.
export function moduleConstants(mutates state ModuleState, p ast.Project, mutates errs diag.ErrorList)
	let order = state.constants.clone()
	checkConstants(state.checker, p: p, ms: state.unit, order: order, errs: errs)
end 'moduleConstants'

// moduleBodies types the module's type declarations and functions.
export function moduleBodies(mutates state ModuleState, p ast.Project, mutates errs diag.ErrorList)
	let functions = state.functions.clone()
	checkBodies(state.checker, p: p, ms: state.unit, declared: functions, errs: errs)
end 'moduleBodies'

// moduleVerify checks the calls and the type arguments that the module's bodies left for the modules they reach, then
// follows the values of the module's declarations and functions. The passes that follow values run only on a module that
// has no error yet.
export function moduleVerify(mutates state ModuleState, p ast.Project, mutates errs diag.ErrorList)
	let mark = errs.count()
	verifyExtensions(state.checker, p: p, ms: state.unit, errs: errs)
	let valueTypes = state.checker.pendingValueTypes.clone()
	verifyValueTypes(state.checker, p: p, ms: state.unit, written: valueTypes, errs: errs)
	let calls = state.checker.pendingCalls.clone()
	verifyCalls(state.checker, p: p, ms: state.unit, calls: calls, errs: errs)
	let bounds = state.checker.pendingBounds.clone()
	verifyBounds(state.checker, p: p, ms: state.unit, bounds: bounds, errs: errs)
	let borrowFree = state.checker.pendingBorrowFree.clone()
	verifyBorrowFree(state.checker, p: p, ms: state.unit, pending: borrowFree, errs: errs)
	let boxes = state.checker.pendingBoxes.clone()
	verifyBoxes(state.checker, p: p, ms: state.unit, boxes: boxes, errs: errs)
	verifyAsyncs(state.checker, p: p, ms: state.unit, errs: errs)
	verifyHolders(state.checker, p: p, ms: state.unit, errs: errs)
	let functions = state.functions.clone()
	publishWaits(state.checker, p: p, ms: state.unit, functions: functions)
	if not failedSince(errs, mark: mark) 'ranges'
		checkRanges(state.checker, p: p, ms: state.unit, functions: functions, errs: errs)
	end 'ranges'
	if not failedSince(errs, mark: mark) 'ownership'
		checkOwnership(state.checker, p: p, ms: state.unit, functions: functions, errs: errs)
	end 'ownership'
end 'moduleVerify'
