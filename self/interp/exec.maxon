// slotCell is the cell of a slot of the frame that runs.
function slotCell(vm Vm, slot Count) returns Count
	return try vm.slotBase + slot otherwise panic("interp: a slot past memory")
end 'slotCell'

// copyToReg gives a register the value that a cell holds.
function copyToReg(mutates vm Vm, dst ir.Reg, c Count)
	let at = vm.regAt(dst)
	vm.regN[at] = vm.h.cellN[c]
	vm.regR[at] = vm.h.cellR[c]
end 'copyToReg'

// The exec functions run one operation each. An operation whose check fails leaves
// the block it goes to in failTo.

// execConst gives a number, or, in a managed register, the empty case of a union held as its payload's address: lowering
// writes no other constant there.
function execConst(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	if isManaged(f, r: x.dst) 'none'
		if x.imm != 0 'value'
			panic("interp: a managed register is given the number {x.imm}")
		end 'value'
		let none = noneObject(vm)
		vm.setRef(x.dst, o: none)
		return
	end 'none'
	vm.setNum(x.dst, n: x.imm)
end 'execConst'

function execStr(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let o = literal(vm, text: ir.strText(f, x: x))
	vm.setRef(x.dst, o: o)
end 'execStr'

function execDatum(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let o = constantObject(vm, d: f.datums[ir.datumItem(x)])
	vm.setRef(x.dst, o: o)
end 'execDatum'

function execLoadSlot(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let slot = ir.loadSlotSlot(x)
	let c = slotCell(vm, slot: slot)
	if ir.owning(f.slots[slot]) 'managed'
		_ = try live(vm, o: vm.h.refOf(c), what: "a read of the slot")
	end 'managed'
	copyToReg(vm, dst: x.dst, c: c)
end 'execLoadSlot'

function execStoreSlot(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let c = slotCell(vm, slot: ir.storeSlotSlot(x))
	let src = ir.storeSlotSrc(x)
	if not isManaged(f, r: src) 'scalar'
		let at = vm.regAt(src)
		vm.h.cellN[c] = vm.regN[at]
		vm.h.cellR[c] = vm.regR[at]
		return
	end 'scalar'
	if ir.storeSlotBorrow(x) 'borrow'
		_ = try live(vm, o: vm.ref(src), what: "a binding")
		let at = vm.regAt(src)
		vm.h.cellN[c] = vm.regN[at]
		vm.h.cellR[c] = vm.regR[at]
		return
	end 'borrow'
	try changed(vm, c: c, o: 0)
	let o = vm.ref(src)
	try adopt(vm, c: c, o: o, what: "the store")
end 'execStoreSlot'

function execSlotAddr(mutates vm Vm, x ir.Instr)
	let c = slotCell(vm, slot: ir.slotAddrSlot(x))
	let epoch = vm.fr.epoch[vm.top]
	vm.setAddress(x.dst, c: c, version: epoch)
end 'execSlotAddr'

function execLoadParam(mutates vm Vm, x ir.Instr)
	let from = vm.paramAt(ir.loadParamParam(x))
	let at = vm.regAt(x.dst)
	vm.regN[at] = vm.regN[from]
	vm.regR[at] = vm.regR[from]
end 'execLoadParam'

// fieldOf is the word of a box that an offset names.
function fieldOf(mutates vm Vm, obj ir.Reg, offset Count, what String) returns Count throws Halt
	if vm.address(obj) != 0 'inside'
		// The address of a field whose words are its record's own, the words of a record held in place: its cells are the
		// box's from that field on.
		let c = try target(vm, addr: obj, what: what)
		let holder = vm.h.cellHolder[c]
		if holder == 0 or vm.h.oKind[holder] != kindBox or (offset mod wordBytes) != 0 'outside'
			panic("interp: {what} reaches through an address that is no field of a box, at offset {offset}")
		end 'outside'
		let index = try c - vm.h.oData[holder] + offset / wordBytes otherwise panic("interp: {what} reaches before its box")
		if index >= vm.h.oSize[holder] 'past'
			panic("interp: {what} reaches outside {objectText(vm, o: holder)} at offset {offset}")
		end 'past'
		return vm.h.field(holder, i: index)
	end 'inside'
	let o = try live(vm, o: vm.ref(obj), what: what)
	let kind = vm.h.oKind[o]
	if (kind != kindBox and kind != kindClosure) or (offset mod wordBytes) != 0 or (offset / wordBytes) >= vm.h.oSize[o] 'outside'
		panic("interp: {what} reaches outside {objectText(vm, o: o)} at offset {offset}")
	end 'outside'
	return vm.h.field(o, i: offset / wordBytes)
end 'fieldOf'

function execLoadField(mutates vm Vm, x ir.Instr) throws Halt
	let c = try fieldOf(vm, obj: ir.loadFieldObj(x), offset: ir.loadFieldOffset(x), what: "a field read")
	copyToReg(vm, dst: x.dst, c: c)
end 'execLoadField'

function execStoreField(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let c = try fieldOf(vm, obj: ir.storeFieldObj(x), offset: ir.storeFieldOffset(x), what: "a field write")
	try changed(vm, c: c, o: 0)
	if ir.storeFieldBorrow(x) 'lends'
		let src = ir.storeFieldSrc(x)
		_ = try live(vm, o: vm.ref(src), what: "a value a field borrows")
		let at = vm.regAt(src)
		vm.h.cellN[c] = vm.regN[at]
		vm.h.cellR[c] = vm.regR[at]
		vm.h.cellLent[c] = true
		return
	end 'lends'
	try store(vm, f: f, c: c, src: ir.storeFieldSrc(x), what: "the field store")
end 'execStoreField'

function execFieldAddr(mutates vm Vm, x ir.Instr) throws Halt
	let c = try fieldOf(vm, obj: ir.fieldAddrObj(x), offset: ir.fieldAddrOffset(x), what: "taking the address of a field")
	let version = vm.h.oVersion[vm.h.cellHolder[c]]
	vm.setAddress(x.dst, c: c, version: version)
end 'execFieldAddr'

// addressIsValid is whether the cell an address names is still there: the structure that holds it must be alive and unchanged
// since the address was taken, and the frame of a slot must not have returned.
function addressIsValid(vm Vm, c Count, version ir.Word) returns bool
	let holder = vm.h.cellHolder[c]
	if holder != 0 'held'
		if vm.h.oFreed[holder] 'freed'
			return false
		end 'freed'
		if vm.h.oVersion[holder] != (try version as Count otherwise panic("interp: a version below 0")) 'stale'
			return false
		end 'stale'
	end 'held'
	return slotHolds(vm, c: c, version: version)
end 'addressIsValid'

// slotHolds is whether the cell c, if it is a slot, is still the slot that an address with the version was taken of: its
// frame has not returned, and its block of slots was not given to another frame of its function since, whose epoch differs.
function slotHolds(vm Vm, c Count, version ir.Word) returns bool
	if vm.h.cellFrame[c] == 0 'noSlot'
		return true
	end 'noSlot'
	let frame = slotFrame(vm, c: c)
	return frame != 0 and (try vm.fr.epoch[frame] as ir.Word otherwise panic("interp: an epoch past a word")) == version
end 'slotHolds'

function requireValid(mutates vm Vm, c Count, version ir.Word, what String) throws Halt
	let holder = vm.h.cellHolder[c]
	if holder != 0 'held'
		try requireLive(vm, o: holder, what: what)
		if (try version as Count otherwise panic("interp: a version below 0")) < vm.h.oBorn[holder] 'freed'
			let message = "{what} uses an address into a value that was freed, whose place {objectText(vm, o: holder)} holds now"
			throw violation(vm, kind: useAfterFree, message: message)
		end 'freed'
		if vm.h.oVersion[holder] != (try version as Count otherwise panic("interp: a version below 0")) 'stale'
			let message = "{what} uses an address into {objectText(vm, o: holder)} that was taken before the structure changed"
			throw violation(vm, kind: staleBorrow, message: message)
		end 'stale'
	end 'held'
	if not slotHolds(vm, c: c, version: version) 'returned'
		let message = "{what} uses the address of a slot of {vm.prog.symbols[slotFunction(vm, c: c)]}, which has returned"
		throw violation(vm, kind: staleBorrow, message: message)
	end 'returned'
end 'requireValid'

// target is the cell an address names, which must still be there.
function target(mutates vm Vm, addr ir.Reg, what String) returns Count throws Halt
	let a = vm.address(addr)
	if a == 0 'never'
		throw violation(vm, kind: movedUse, message: "{what} uses an address that was never taken")
	end 'never'
	let version = vm.num(addr)
	if not addressIsValid(vm, c: a, version: version) 'invalid'
		try requireValid(vm, c: a, version: version, what: what)
	end 'invalid'
	if vm.tracking 'tracking'
		try requireReachableCell(vm, c: a, what: what)
	end 'tracking'
	return a
end 'target'

function execLoadAt(mutates vm Vm, x ir.Instr) throws Halt
	let c = try target(vm, addr: ir.loadAtAddr(x), what: "a read through an address")
	if ir.loadAtFilled(x) 'filled'
		try requireFilledCell(vm, c: c, what: "a read of an element through its address")
	end 'filled'
	copyToReg(vm, dst: x.dst, c: c)
end 'execLoadAt'

function execStoreAt(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let c = try target(vm, addr: ir.storeAtAddr(x), what: "a write through an address")
	try changed(vm, c: c, o: 0)
	try store(vm, f: f, c: c, src: ir.storeAtSrc(x), what: "the store")
end 'execStoreAt'

// execLoadByteAt reads a place of a byte-sized type that a call lent (ir.lentInByte): a byte of a byte array's buffer, which
// byteCell made a cell for, or a cell that holds the value, all of which the byte holds, since it is from 0 to 255.
function execLoadByteAt(mutates vm Vm, x ir.Instr) throws Halt
	let c = try target(vm, addr: ir.loadByteAtAddr(x), what: "a read through an address")
	let holder = vm.h.cellHolder[c]
	if holder != 0 and vm.h.oKind[holder] == kindBytes 'buffer'
		vm.setNum(x.dst, n: vm.h.buffers[vm.h.oData[holder]][vm.h.cellIndex[c]] as ir.Word)
		return
	end 'buffer'
	copyToReg(vm, dst: x.dst, c: c)
end 'execLoadByteAt'

// execStoreByteAt writes the low byte of a word to a place of a byte-sized type that a call lent, as execLoadByteAt reads
// it.
function execStoreByteAt(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let c = try target(vm, addr: ir.storeByteAtAddr(x), what: "a write through an address")
	let holder = vm.h.cellHolder[c]
	if holder != 0 and vm.h.oKind[holder] == kindBytes 'buffer'
		vm.h.buffers[vm.h.oData[holder]][vm.h.cellIndex[c]] = lowByte(vm.num(ir.storeByteAtSrc(x)))
		return
	end 'buffer'
	try changed(vm, c: c, o: 0)
	try store(vm, f: f, c: c, src: ir.storeByteAtSrc(x), what: "the store")
end 'execStoreByteAt'

function execLoadGlobal(mutates vm Vm, x ir.Instr)
	let symbol = ir.loadGlobalSymbol(x)
	if symbol == ir.Rt.rtStdout 'stdout'
		vm.setNum(x.dst, n: stdoutHandle)
		return
	end 'stdout'
	if symbol == ir.Rt.rtStderr 'stderr'
		vm.setNum(x.dst, n: stderrHandle)
		return
	end 'stderr'
	if symbol == ir.Rt.rtHeap 'heap'
		vm.setNum(x.dst, n: heapHandle)
		return
	end 'heap'
	panic("interp: unknown global {ir.rtSymbol(symbol)}")
end 'execLoadGlobal'

// execBin computes an operation in a word, and sets failTo when a checked one does not fit. The range analysis proved
// that an operation without a check fits, and a guard before it rules out a divisor of 0 and a negative shift count, so
// finding one is a compiler bug.
function execBin(mutates vm Vm, x ir.Instr)
	var result as ir.Word
	let outcome = ir.evalBin(ir.binOp(x), a: vm.num(x.a), b: vm.num(x.b), unsigned: ir.binUnsigned(x), checked: ir.binHasFail(x), value: result)
	match outcome 'outcome'
		outcomeValue then vm.setNum(x.dst, n: result)
		outcomeFails then vm.failTo = x.c as ir.Word
		outcomeUndefined then panic("interp: {ir.binOpText(ir.binOp(x))} of operands that no guard checked")
	end 'outcome'
end 'execBin'

function execCmp(mutates vm Vm, x ir.Instr)
	var a = vm.num(x.a)
	var b = vm.num(x.b)
	let objectA = nullOf(vm, o: vm.ref(x.a))
	let objectB = nullOf(vm, o: vm.ref(x.b))
	if objectA != 0 or objectB != 0 'objects'
		a = try objectA as ir.Word otherwise panic("interp: a handle past a word")
		b = try objectB as ir.Word otherwise panic("interp: a handle past a word")
	end 'objects'
	vm.setNum(x.dst, n: 1 if ir.evalCmp(ir.cmpOp(x), a: a, b: b, unsigned: ir.cmpUnsigned(x)) else 0)
end 'execCmp'

function execNeg(mutates vm Vm, x ir.Instr)
	var result as ir.Word
	if ir.evalNeg(vm.num(x.a), checked: ir.negHasFail(x), value: result) == ir.Outcome.outcomeFails 'failed'
		vm.failTo = x.c as ir.Word
		return
	end 'failed'
	vm.setNum(x.dst, n: result)
end 'execNeg'

function execNot(mutates vm Vm, x ir.Instr)
	vm.setNum(x.dst, n: ir.evalNot(vm.num(x.a)))
end 'execNot'

function execTrailingZeros(mutates vm Vm, x ir.Instr)
	vm.setNum(x.dst, n: ir.evalTrailingZeros(vm.num(x.a)))
end 'execTrailingZeros'

function execGuard(mutates vm Vm, x ir.Instr)
	if not ir.evalGuard(ir.guardKind(x), a: vm.num(x.a), bound: ir.guardBound(x)) 'failed'
		vm.failTo = x.c as ir.Word
	end 'failed'
end 'execGuard'

function execAlloc(mutates vm Vm, x ir.Instr)
	var words = (ir.allocBytes(x) / wordBytes) as Count
	if words == 0 'empty'
		words = 1
	end 'empty'
	let o = newBox(vm, words: words)
	vm.setRef(x.dst, o: o)
end 'execAlloc'

// execWhen schedules a behaviour.
function execWhen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	try schedule(vm, f: f, x: x)
end 'execWhen'

function execDrop(mutates vm Vm, x ir.Instr) throws Halt
	// A register is written before it is dropped on every path, so one that holds nothing is a drop of a value that was never
	// made: a native frame does not zero its registers, and would free whatever they held.
	let o = vm.ref(x.a)
	if o == 0 'unassigned'
		throw violation(vm, kind: movedUse, message: "a drop of a register that holds no value: it was never assigned on this path")
	end 'unassigned'
	try drop(vm, o: o)
end 'execDrop'

function execCopy(mutates vm Vm, x ir.Instr) throws Halt
	let o = try live(vm, o: vm.ref(ir.copySrc(x)), what: "a copy")
	let copy = try copyObject(vm, o: o)
	vm.setRef(x.dst, o: copy)
end 'execCopy'

function execDropSlot(mutates vm Vm, x ir.Instr) throws Halt
	let c = slotCell(vm, slot: ir.dropSlotSlot(x))
	try dropCell(vm, c: c)
end 'execDropSlot'

function execDropAt(mutates vm Vm, x ir.Instr) throws Halt
	let c = try target(vm, addr: ir.dropAtAddr(x), what: "a drop through an address")
	try dropCell(vm, c: c)
end 'execDropAt'

// moveOut reads the value of a place that owns one and leaves the place empty: the value is in flight until whatever receives
// it takes it.
function moveOut(mutates vm Vm, c Count, dst ir.Reg, what String) throws Halt
	if vm.h.refOf(c) == 0 'empty'
		throw violation(vm, kind: movedUse, message: "{what}, which holds no value: it was moved out already or never assigned")
	end 'empty'
	try changed(vm, c: c, o: 0)
	copyToReg(vm, dst: dst, c: c)
	_ = try release(vm, c: c, what: what)
end 'moveOut'

function execMoveSlot(mutates vm Vm, x ir.Instr) throws Halt
	let c = slotCell(vm, slot: ir.moveSlotSlot(x))
	try moveOut(vm, c: c, dst: x.dst, what: "a move out of the slot")
end 'execMoveSlot'

function execMoveAt(mutates vm Vm, x ir.Instr) throws Halt
	let c = try target(vm, addr: ir.moveAtAddr(x), what: "a move through an address")
	try moveOut(vm, c: c, dst: x.dst, what: "a move out of the place")
end 'execMoveAt'

// argumentConv is how a callee takes its i-th argument, the receiver of a method counting as the first.
function argumentConv(vm Vm, callee Count, i Count) returns Count
	return vm.prog.fnConvs[callee][i]
end 'argumentConv'

// checkArgument refuses an argument that cannot be used: a value that is gone, or a borrow that is stale.
function checkArgument(mutates vm Vm, f ir.IrFunction, callee Count, i Count, r ir.Reg) throws Halt
	let at = vm.regAt(r)
	let word = vm.regR[at]
	if word < 0 'address'
		let c = try (0 - word) as Count otherwise panic("interp: an address past a word")
		let version = vm.regN[at]
		if not addressIsValid(vm, c: c, version: version) 'stale'
			let what = "argument {i} of the call to {vm.prog.symbols[callee]}"
			try requireValid(vm, c: c, version: version, what: what)
		end 'stale'
		return
	end 'address'
	if isManaged(f, r: r) 'managed'
		let o = vm.ref(r)
		if o == 0 or vm.h.oFreed[o] or vm.tracking 'check'
			let what = "argument {i} of the call to {vm.prog.symbols[callee]}"
			_ = try live(vm, o: o, what: what)
		end 'check'
	end 'managed'
end 'checkArgument'

// requireDisjoint is the law of exclusivity at one call: an argument that the callee may change, by address or by owning it,
// must not reach any place that another argument reaches. The arguments are the ones in argN and argR. An argument that is a
// value of no tracked storage, a scalar or a string in the executable or a shared value, reaches nothing.
function requireDisjoint(mutates vm Vm, callee Count, count Count) throws Halt
	if count < 2 'few'
		return
	end 'few'
	var reaches = 0 as Count
	for i in 0 upto count 'each'
		if vm.argR[i] != 0 'reaching'
			reaches = try reaches + 1 otherwise panic("interp: more arguments than memory")
		end 'reaching'
	end 'each'
	if reaches < 2 'alone'
		return
	end 'alone'
	for j in 1 upto count 'second'
		for i in 0 upto j 'first'
			let ai = argumentCell(vm, i: i)
			let ao = argumentObject(vm, i: i)
			let aj = argumentCell(vm, i: j)
			let bo = argumentObject(vm, i: j)
			let valid = (ai != 0 or ao != 0) and (aj != 0 or bo != 0)
			if valid and (ai != 0 or aj != 0 or argumentConv(vm, callee: callee, i: i) != convLet or argumentConv(vm, callee: callee, i: j) != convLet) and vm.h.overlaps(ai, ao: ao, bc: aj, bo: bo) 'overlap'
				let message = "arguments {i} and {j} of the call to {vm.prog.symbols[callee]} reach one place, {regionText(vm, c: ai, o: ao)} and {regionText(vm, c: aj, o: bo)}, and one of them is passed so that the callee may change it"
				throw violation(vm, kind: exclusivity, message: message)
			end 'overlap'
		end 'first'
	end 'second'
end 'requireDisjoint'

// argumentCell is the cell that an argument has the address of, or 0: a cell is always reached by the callee as one it may change.
function argumentCell(vm Vm, i Count) returns Count
	let word = vm.argR[i]
	if word < 0 'address'
		return try (0 - word) as Count otherwise panic("interp: an address past a word")
	end 'address'
	return 0
end 'argumentCell'

// argumentObject is the object that an argument holds when it is storage of the program's: not a string in the executable and
// not a frozen value or a cown, which every thread reaches the same way.
function argumentObject(vm Vm, i Count) returns Count
	let word = vm.argR[i]
	if word > 0 'object'
		let o = word as Count
		if not vm.h.oImmortal[o] and not vm.h.isShared(o) 'tracked'
			return o
		end 'tracked'
	end 'object'
	return 0
end 'argumentObject'

function execCall(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let found = vm.prog.fnByFunc.get(ir.callCallee(f, x: x) as Count)
	let callee = match consumes found 'callee'
		some(fi) gives fi
		none gives panic("interp: a callee has no IR")
	end 'callee'
	let start = ir.callArgsStart(x)
	let count = ir.callArgsCount(x)
	clearArguments(vm)
	for i in 0 upto count 'args'
		let r = f.args[try start + i otherwise panic("interp: an argument past the pool")]
		let at = vm.regAt(r)
		vm.argN.push(vm.regN[at])
		vm.argR.push(vm.regR[at])
		try checkArgument(vm, f: f, callee: callee, i: i, r: r)
	end 'args'
	try requireDisjoint(vm, callee: callee, count: count)
	let call = vm.curIdx
	closeWindows(vm, call: call)
	var err = -1 as ir.Word
	if ir.callHasErrReg(x) 'throws'
		err = x.imm
	end 'throws'
	vm.post = true
	try enterFrame(vm, fn: callee, dst: x.dst as ir.Word, err: err)
end 'execCall'

// execCallValue calls the function a closure holds. The body of a closure takes the closure first, to read what it captured;
// a named function takes only the arguments after it.
function execCallValue(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let start = ir.callValueArgsStart(x)
	let count = ir.callValueArgsCount(x)
	let o = try live(vm, o: vm.ref(f.args[start]), what: "a call through a function value")
	if vm.h.oKind[o] != kindClosure 'notClosure'
		panic("interp: a call through {objectText(vm, o: o)}, which is not a function value")
	end 'notClosure'
	let callee = try vm.h.cellN[vm.h.field(o, i: closureFnWord)] as Count otherwise panic("interp: a closure that calls no function")
	var first = 1 as Count
	if vm.prog.fnTakesClosure[callee] 'closure'
		first = 0
	end 'closure'
	clearArguments(vm)
	for i in first upto count 'args'
		let r = f.args[try start + i otherwise panic("interp: an argument past the pool")]
		let at = vm.regAt(r)
		vm.argN.push(vm.regN[at])
		vm.argR.push(vm.regR[at])
		let index = table.difference(i, b: first)
		try checkArgument(vm, f: f, callee: callee, i: index, r: r)
	end 'args'
	let given = try count - first otherwise panic("interp: a call through a function value without the value")
	try requireDisjoint(vm, callee: callee, count: given)
	let call = vm.curIdx
	closeWindows(vm, call: call)
	vm.post = true
	try enterFrame(vm, fn: callee, dst: x.dst as ir.Word, err: -1)
end 'execCallValue'

// execClosure makes a closure of a body of the function that runs: it owns each capture that the body says it owns, which
// must be in flight, and holds the others as they are, a scalar or a borrow.
function execClosure(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let body = vm.prog.fnChildren[vm.curFn][ir.closureBody(f, x: x)]
	let start = ir.closureCapturesStart(x)
	let count = ir.closureCapturesCount(x)
	let owned = vm.prog.fnCaptureOwned[body].clone()
	let site = vm.site()
	let o = vm.h.newClosure(body, captures: count, owned: owned.clone(), site: site)
	for i in 0 upto count 'captures'
		let r = f.args[try start + i otherwise panic("interp: a capture past the pool")]
		let c = vm.h.field(o, i: captureWord(i))
		if owned[i] 'owned'
			try store(vm, f: f, c: c, src: r, what: "the capture of a closure")
		end 'owned' else 'held'
			if isManaged(f, r: r) 'managed'
				_ = try live(vm, o: vm.ref(r), what: "a value a closure borrows")
			end 'managed'
			let at = vm.regAt(r)
			vm.h.cellN[c] = vm.regN[at]
			vm.h.cellR[c] = vm.regR[at]
		end 'held'
	end 'captures'
	vm.setRef(x.dst, o: o)
end 'execClosure'

// execFuncValue makes a closure of a function named as a value, which captures nothing.
function execFuncValue(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let fn = functionOf(vm, id: ir.funcValueCallee(f, x: x))
	let site = vm.site()
	let o = vm.h.newClosure(fn, captures: 0, owned: BoolList.create(0), site: site)
	vm.setRef(x.dst, o: o)
end 'execFuncValue'

// The box of an interface value is a record of two words: the table, which the interpreter names by its index among the
// program's tables, and the value.
let boxTableWord = (ir.ifaceTableOffset / wordBytes) as Count

let boxValueWord = (ir.ifaceValueOffset / wordBytes) as Count

// tableIndex is the index among the program's tables of the table that a box names by its symbol.
function tableIndex(vm Vm, t ir.WitnessTable) returns ir.Word
	let index = match consumes vm.prog.tables.get(t.symbol) 'table'
		some(i) gives i
		none gives panic("interp: the table {t.symbol} was not indexed")
	end 'table'
	return try index as ir.Word otherwise panic("interp: a table past a word")
end 'tableIndex'

// execBox makes an interface value on the heap, which owns the value: it must be in flight, or a scalar.
function execBox(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = newBox(vm, words: ir.ifaceBoxBytes / wordBytes)
	vm.h.cellN[vm.h.field(o, i: boxTableWord)] = tableIndex(vm, t: ir.boxTable(f, x: x))
	try store(vm, f: f, c: vm.h.field(o, i: boxValueWord), src: ir.boxValue(x), what: "the box of an interface value")
	vm.setRef(x.dst, o: o)
end 'execBox'

// execFrameBox makes an interface value in a frame box of the frame that runs, which holds the value as it is and owns
// nothing: a value lent to a borrow, or a scalar. The frame box is a record of the frame's, made the first time the frame
// reaches it and the same one each time after, as the executable's is the same two words of the frame; it is no heap
// allocation, so nothing frees it, and it ends with its frame.
function execFrameBox(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let src = ir.frameBoxValue(x)
	if isManaged(f, r: src) 'lent'
		_ = try live(vm, o: vm.ref(src), what: "a value that an interface value borrows")
	end 'lent'
	let at = ir.frameBoxBox(x)
	if vm.fr.boxes[vm.top][at] == 0 'first'
		let made = newBox(vm, words: ir.ifaceBoxBytes / wordBytes)
		vm.fr.boxes[vm.top][at] = made
	end 'first'
	let o = vm.fr.boxes[vm.top][at]
	vm.h.cellN[vm.h.field(o, i: boxTableWord)] = tableIndex(vm, t: ir.frameBoxTable(f, x: x))
	let c = vm.h.field(o, i: boxValueWord)
	let r = vm.regAt(src)
	vm.h.cellN[c] = vm.regN[r]
	vm.h.cellR[c] = vm.regR[r]
	vm.setRef(x.dst, o: o)
end 'execFrameBox'

// execFrameArea gives the frame area of the frame that runs, a record of as many words as the tuple it holds the borrows
// of, made the first time the frame reaches it and the same one each time after, as the executable's is the same words of
// the frame. It owns nothing and nothing owns it: the frame keeps it, so a function may lend it, and it ends with its frame
// as a frame box does.
function execFrameArea(mutates vm Vm, x ir.Instr)
	let at = ir.frameAreaBox(x)
	if vm.fr.boxes[vm.top][at] == 0 'first'
		let made = newBox(vm, words: ir.frameAreaWords(x))
		vm.h.oFrameArea[made] = true
		vm.fr.boxes[vm.top][at] = made
	end 'first'
	let o = vm.fr.boxes[vm.top][at]
	vm.setRef(x.dst, o: o)
end 'execFrameArea'

// endFrameBoxes ends the frame boxes of the frame serial as it returns: each is marked freed without being a free of the
// program's, so a use of one after its frame is a use after free.
function endFrameBoxes(mutates vm Vm, serial Count)
	for i in 0 upto vm.fr.boxes[serial].count() 'boxes'
		let o = vm.fr.boxes[serial][i]
		if o != 0 'made'
			vm.h.oFreed[o] = true
			vm.h.oFreedAt[o] = vm.site()
		end 'made'
	end 'boxes'
end 'endFrameBoxes'

// execCallWitness calls the method of the table of an interface value: the receiver is the value the box holds, lent
// or moved out of the box, which is then freed, as the method takes it.
function execCallWitness(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let start = ir.callWitnessArgsStart(x)
	let count = ir.callWitnessArgsCount(x)
	let o = try live(vm, o: vm.ref(f.args[start]), what: "a call through an interface value")
	let index = try vm.h.cellN[vm.h.field(o, i: boxTableWord)] as Count otherwise panic("interp: an interface value with no table")
	let callee = vm.prog.tableMethods[index][ir.callWitnessSlot(x)]
	let c = vm.h.field(o, i: boxValueWord)
	clearArguments(vm)
	let conv = ir.callWitnessRecv(x)
	vm.argN.push(vm.h.cellN[c])
	vm.argR.push(vm.h.cellR[c])
	if conv == ir.ReceiverConv.receiverMoved 'moved'
		if vm.h.refOf(c) != 0 'object'
			try changed(vm, c: c, o: 0)
			_ = try release(vm, c: c, what: "a call that consumes the value of an interface value")
		end 'object'
		vm.h.cellN[c] = 0
		vm.h.cellR[c] = 0
		try drop(vm, o: o)
	end 'moved'
	for i in 1 upto count 'args'
		let r = f.args[try start + i otherwise panic("interp: an argument past the pool")]
		let at = vm.regAt(r)
		vm.argN.push(vm.regN[at])
		vm.argR.push(vm.regR[at])
		try checkArgument(vm, f: f, callee: callee, i: i, r: r)
	end 'args'
	try requireDisjoint(vm, callee: callee, count: count)
	let call = vm.curIdx
	closeWindows(vm, call: call)
	var err = -1 as ir.Word
	if ir.callWitnessHasErrReg(x) 'throws'
		err = x.imm
	end 'throws'
	vm.post = true
	try enterFrame(vm, fn: callee, dst: x.dst as ir.Word, err: err)
end 'execCallWitness'

// execIsType tests the type of the value an interface value holds, which its table names.
function execIsType(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try live(vm, o: vm.ref(ir.isTypeSrc(x)), what: "a cast of an interface value")
	let index = try vm.h.cellN[vm.h.field(o, i: boxTableWord)] as Count otherwise panic("interp: an interface value with no table")
	if vm.prog.tableTypes[index] == ir.isTypeTy(f, x: x) 'same'
		vm.setNum(x.dst, n: 1)
	end 'same' else 'other'
		vm.setNum(x.dst, n: 0)
	end 'other'
end 'execIsType'

// clearArguments empties the arguments of the call being made.
function clearArguments(mutates vm Vm)
	while vm.argN.count() > 0 'each'
		try vm.argN.pop() otherwise ignore
		try vm.argR.pop() otherwise ignore
	end 'each'
end 'clearArguments'
