// A frame is run by a loop over its function's instructions that returns whenever the frame that runs changes: a call makes
// a frame and a return ends one, and the thread that has the turn gives it back after its burst. The loop is outside the type
// because the dispatch takes the visitor to mutate, which a method cannot give of its own self.

// Machine runs the operations of the IR in a Vm: its visit methods are the interpreter's ir.InstrVisitor and
// ir.TermVisitor. A failure that ends the run is left in the Vm, so a method that fails does no more.
type Machine implements ir.InstrVisitor, ir.TermVisitor
	var vm as Vm

	static function new(consumes vm Vm) returns Machine
		return Machine{vm: vm}
	end 'new'

	function visitConst(mutates self, f ir.IrFunction, x ir.Instr)
		execConst(vm, f: f, x: x)
	end 'visitConst'

	function visitStr(mutates self, f ir.IrFunction, x ir.Instr)
		execStr(vm, f: f, x: x)
	end 'visitStr'

	function visitDatum(mutates self, f ir.IrFunction, x ir.Instr)
		execDatum(vm, f: f, x: x)
	end 'visitDatum'

	function visitLoadSlot(mutates self, f ir.IrFunction, x ir.Instr)
		try execLoadSlot(vm, f: f, x: x) otherwise ignore
	end 'visitLoadSlot'

	function visitStoreSlot(mutates self, f ir.IrFunction, x ir.Instr)
		try execStoreSlot(vm, f: f, x: x) otherwise ignore
	end 'visitStoreSlot'

	function visitSlotAddr(mutates self, f ir.IrFunction, x ir.Instr)
		execSlotAddr(vm, x: x)
	end 'visitSlotAddr'

	function visitLoadParam(mutates self, f ir.IrFunction, x ir.Instr)
		execLoadParam(vm, x: x)
	end 'visitLoadParam'

	function visitLoadField(mutates self, f ir.IrFunction, x ir.Instr)
		try execLoadField(vm, x: x) otherwise ignore
	end 'visitLoadField'

	function visitStoreField(mutates self, f ir.IrFunction, x ir.Instr)
		try execStoreField(vm, f: f, x: x) otherwise ignore
	end 'visitStoreField'

	function visitFieldAddr(mutates self, f ir.IrFunction, x ir.Instr)
		try execFieldAddr(vm, x: x) otherwise ignore
	end 'visitFieldAddr'

	function visitLoadAt(mutates self, f ir.IrFunction, x ir.Instr)
		try execLoadAt(vm, x: x) otherwise ignore
	end 'visitLoadAt'

	function visitStoreAt(mutates self, f ir.IrFunction, x ir.Instr)
		try execStoreAt(vm, f: f, x: x) otherwise ignore
	end 'visitStoreAt'

	function visitLoadByteAt(mutates self, f ir.IrFunction, x ir.Instr)
		try execLoadByteAt(vm, x: x) otherwise ignore
	end 'visitLoadByteAt'

	function visitStoreByteAt(mutates self, f ir.IrFunction, x ir.Instr)
		try execStoreByteAt(vm, f: f, x: x) otherwise ignore
	end 'visitStoreByteAt'

	function visitLoadGlobal(mutates self, f ir.IrFunction, x ir.Instr)
		execLoadGlobal(vm, x: x)
	end 'visitLoadGlobal'

	// The raw operations are the runtime's source's, which the interpreter never runs.
	function visitLoadRaw(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: loadraw is the runtime source's, which the interpreter never runs")
	end 'visitLoadRaw'

	function visitStoreRaw(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: storeraw is the runtime source's, which the interpreter never runs")
	end 'visitStoreRaw'

	function visitLoadAcquire(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: loadacquire is the runtime source's, which the interpreter never runs")
	end 'visitLoadAcquire'

	function visitStoreRelease(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: storerelease is the runtime source's, which the interpreter never runs")
	end 'visitStoreRelease'

	function visitGlobalAddr(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: globaladdr is the runtime source's, which the interpreter never runs")
	end 'visitGlobalAddr'

	function visitCallImport(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: import is the runtime source's, which the interpreter never runs")
	end 'visitCallImport'

	function visitSyscall(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: syscall is the runtime source's, which the interpreter never runs")
	end 'visitSyscall'

	function visitAtomicAdd(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: atomicadd is the runtime source's, which the interpreter never runs")
	end 'visitAtomicAdd'

	function visitAtomicExchange(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: atomicxchg is the runtime source's, which the interpreter never runs")
	end 'visitAtomicExchange'

	function visitCompareExchange(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: cmpxchg is the runtime source's, which the interpreter never runs")
	end 'visitCompareExchange'

	function visitSpinPause(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: spinpause is the runtime source's, which the interpreter never runs")
	end 'visitSpinPause'

	function visitThreadContext(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: threadcontext is the runtime source's, which the interpreter never runs")
	end 'visitThreadContext'

	function visitCodeAddress(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: codeaddr is the runtime source's, which the interpreter never runs")
	end 'visitCodeAddress'

	// visitBodyAddress gives the function of a body, which rt.parallelRun runs for each chunk of its loop.
	function visitBodyAddress(mutates self, f ir.IrFunction, x ir.Instr)
		let body = vm.prog.fnChildren[vm.curFn][ir.bodyAddressBody(f, x: x)]
		vm.setNum(x.dst, n: try body as ir.Word otherwise panic("interp: a function past a word"))
	end 'visitBodyAddress'

	function visitCallCode(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: callcode is the runtime source's, which the interpreter never runs")
	end 'visitCallCode'

	function visitCallHost(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: callhost is the runtime source's, which the interpreter never runs")
	end 'visitCallHost'

	function visitBin(mutates self, f ir.IrFunction, x ir.Instr)
		execBin(vm, x: x)
	end 'visitBin'

	function visitCmp(mutates self, f ir.IrFunction, x ir.Instr)
		execCmp(vm, x: x)
	end 'visitCmp'

	function visitFBin(mutates self, f ir.IrFunction, x ir.Instr)
		execFBin(vm, x: x)
	end 'visitFBin'

	function visitFCmp(mutates self, f ir.IrFunction, x ir.Instr)
		execFCmp(vm, x: x)
	end 'visitFCmp'

	function visitFUnary(mutates self, f ir.IrFunction, x ir.Instr)
		execFUnary(vm, x: x)
	end 'visitFUnary'

	function visitIntToFloat(mutates self, f ir.IrFunction, x ir.Instr)
		execIntToFloat(vm, x: x)
	end 'visitIntToFloat'

	function visitFloatToInt(mutates self, f ir.IrFunction, x ir.Instr)
		vm.setNum(x.dst, n: ir.evalFloatToInt(vm.num(ir.floatToIntSrc(x))))
	end 'visitFloatToInt'

	function visitNeg(mutates self, f ir.IrFunction, x ir.Instr)
		execNeg(vm, x: x)
	end 'visitNeg'

	function visitNot(mutates self, f ir.IrFunction, x ir.Instr)
		execNot(vm, x: x)
	end 'visitNot'

	function visitTrailingZeros(mutates self, f ir.IrFunction, x ir.Instr)
		execTrailingZeros(vm, x: x)
	end 'visitTrailingZeros'

	function visitGuard(mutates self, f ir.IrFunction, x ir.Instr)
		execGuard(vm, x: x)
	end 'visitGuard'

	function visitLength(mutates self, f ir.IrFunction, x ir.Instr)
		try execLength(vm, x: x) otherwise ignore
	end 'visitLength'

	function visitBounds(mutates self, f ir.IrFunction, x ir.Instr)
		execBounds(vm, x: x)
	end 'visitBounds'

	function visitElemAddr(mutates self, f ir.IrFunction, x ir.Instr)
		try execElemAddr(vm, x: x) otherwise ignore
	end 'visitElemAddr'

	function visitElemLoad(mutates self, f ir.IrFunction, x ir.Instr)
		try execElemLoad(vm, x: x) otherwise ignore
	end 'visitElemLoad'

	function visitLoadByte(mutates self, f ir.IrFunction, x ir.Instr)
		try execLoadByte(vm, x: x) otherwise ignore
	end 'visitLoadByte'

	// The vector operations are only in the runtime's source, which the interpreter never runs (README, "The runtime").
	function visitVecLoad(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a vector operation, which only the runtime's source has")
	end 'visitVecLoad'

	function visitVecStore(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a vector operation, which only the runtime's source has")
	end 'visitVecStore'

	function visitVecZero(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a vector operation, which only the runtime's source has")
	end 'visitVecZero'

	function visitVecFromWords(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a vector operation, which only the runtime's source has")
	end 'visitVecFromWords'

	function visitVecWord(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a vector operation, which only the runtime's source has")
	end 'visitVecWord'

	function visitVecBin(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a vector operation, which only the runtime's source has")
	end 'visitVecBin'

	function visitVecShift(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a vector operation, which only the runtime's source has")
	end 'visitVecShift'

	function visitLoadWord(mutates self, f ir.IrFunction, x ir.Instr)
		try execLoadWord(vm, x: x) otherwise ignore
	end 'visitLoadWord'

	// Only a native build's optimizer makes a buffer (self/opt/licm.maxon), which the IR the interpreter runs never holds.
	function visitBuffer(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a buffer, which only the native optimizer makes")
	end 'visitBuffer'

	// A strptr is the runtime source's but for the test of an element read, which is whether the slot holds a String: the
	// interpreter's address of a String is 1 when the register holds one, and 0 when it holds nothing, as an empty slot is.
	function visitStrPtr(mutates self, f ir.IrFunction, x ir.Instr)
		let held = 0 as ir.Word if vm.ref(ir.strPtrSrc(x)) == 0 else 1 as ir.Word
		vm.setNum(x.dst, n: held)
	end 'visitStrPtr'

	function visitStrBytes(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: strbytes is the runtime source's, which the interpreter never runs")
	end 'visitStrBytes'

	// A strword is the runtime source's but for the test of an element read too, which ors it with the strptr: the
	// interpreter's word of a String is 0, so the strptr says.
	function visitStrWord(mutates self, f ir.IrFunction, x ir.Instr)
		vm.setNum(x.dst, n: 0 as ir.Word)
	end 'visitStrWord'

	function visitStrMake(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: strmake is the runtime source's, which the interpreter never runs")
	end 'visitStrMake'

	// Only a native build's optimizer makes an elemAt (self/opt/licm.maxon), which the IR the interpreter runs never holds.
	function visitElemAt(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: an elemAt, which only the native optimizer makes")
	end 'visitElemAt'

	// Only a native build's optimizer makes a byteAt (self/opt/buffers.maxon), which the IR the interpreter runs never holds.
	function visitByteAt(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: a byteAt, which only the native optimizer makes")
	end 'visitByteAt'

	function visitElemAddrAt(mutates self, f ir.IrFunction, x ir.Instr)
		panic("interp: an elemAddrAt, which only the native optimizer makes")
	end 'visitElemAddrAt'

	function visitAlloc(mutates self, f ir.IrFunction, x ir.Instr)
		execAlloc(vm, x: x)
	end 'visitAlloc'

	function visitCall(mutates self, f ir.IrFunction, x ir.Instr)
		try execCall(vm, f: f, x: x) otherwise ignore
	end 'visitCall'

	function visitCallRuntime(mutates self, f ir.IrFunction, x ir.Instr)
		try runtimeEntry(vm, f: f, x: x) otherwise ignore
	end 'visitCallRuntime'

	function visitCallValue(mutates self, f ir.IrFunction, x ir.Instr)
		try execCallValue(vm, f: f, x: x) otherwise ignore
	end 'visitCallValue'

	function visitClosure(mutates self, f ir.IrFunction, x ir.Instr)
		try execClosure(vm, f: f, x: x) otherwise ignore
	end 'visitClosure'

	function visitFuncValue(mutates self, f ir.IrFunction, x ir.Instr)
		execFuncValue(vm, f: f, x: x)
	end 'visitFuncValue'

	function visitWhen(mutates self, f ir.IrFunction, x ir.Instr)
		try execWhen(vm, f: f, x: x) otherwise ignore
	end 'visitWhen'

	function visitAsync(mutates self, f ir.IrFunction, x ir.Instr)
		try execAsync(vm, f: f, x: x) otherwise ignore
	end 'visitAsync'

	function visitBox(mutates self, f ir.IrFunction, x ir.Instr)
		try execBox(vm, f: f, x: x) otherwise ignore
	end 'visitBox'

	function visitFrameBox(mutates self, f ir.IrFunction, x ir.Instr)
		try execFrameBox(vm, f: f, x: x) otherwise ignore
	end 'visitFrameBox'

	function visitFrameArea(mutates self, f ir.IrFunction, x ir.Instr)
		execFrameArea(vm, x: x)
	end 'visitFrameArea'

	function visitCallWitness(mutates self, f ir.IrFunction, x ir.Instr)
		try execCallWitness(vm, f: f, x: x) otherwise ignore
	end 'visitCallWitness'

	function visitIsType(mutates self, f ir.IrFunction, x ir.Instr)
		try execIsType(vm, f: f, x: x) otherwise ignore
	end 'visitIsType'

	function visitDrop(mutates self, f ir.IrFunction, x ir.Instr)
		try execDrop(vm, x: x) otherwise ignore
	end 'visitDrop'

	function visitDropSlot(mutates self, f ir.IrFunction, x ir.Instr)
		try execDropSlot(vm, x: x) otherwise ignore
	end 'visitDropSlot'

	function visitDropAt(mutates self, f ir.IrFunction, x ir.Instr)
		try execDropAt(vm, x: x) otherwise ignore
	end 'visitDropAt'

	function visitMoveSlot(mutates self, f ir.IrFunction, x ir.Instr)
		try execMoveSlot(vm, x: x) otherwise ignore
	end 'visitMoveSlot'

	function visitMoveAt(mutates self, f ir.IrFunction, x ir.Instr)
		try execMoveAt(vm, x: x) otherwise ignore
	end 'visitMoveAt'

	function visitCopy(mutates self, f ir.IrFunction, x ir.Instr)
		try execCopy(vm, x: x) otherwise ignore
	end 'visitCopy'

	function visitJump(mutates self, f ir.IrFunction, t ir.Term)
		takeEdge(vm, f: f, target: ir.jumpTarget(t), start: ir.jumpArgsStart(t), count: ir.jumpArgsCount(t))
	end 'visitJump'

	function visitBranch(mutates self, f ir.IrFunction, t ir.Term)
		if vm.num(ir.branchCond(t)) != 0 'taken'
			takeEdge(vm, f: f, target: ir.branchIfTrue(t), start: ir.branchTrueArgsStart(t), count: ir.branchTrueArgsCount(t))
		end 'taken' else 'notTaken'
			takeEdge(vm, f: f, target: ir.branchIfFalse(t), start: ir.branchFalseArgsStart(t), count: ir.branchFalseArgsCount(t))
		end 'notTaken'
	end 'visitBranch'

	function visitSwitch(mutates self, f ir.IrFunction, t ir.Term)
		let v = vm.num(ir.switchValue(t))
		let start = ir.switchCasesStart(t)
		for i in 0 upto ir.switchCasesCount(t) 'cases'
			let at = try start + i otherwise panic("interp: a case past the pool")
			if f.cases[at].value == v 'match'
				takeEdge(vm, f: f, target: f.cases[at].target, start: f.cases[at].argsStart(), count: f.cases[at].argsCount())
				return
			end 'match'
		end 'cases'
		takeEdge(vm, f: f, target: ir.switchFallback(t), start: ir.switchFallbackArgsStart(t), count: ir.switchFallbackArgsCount(t))
	end 'visitSwitch'

	function visitRet(mutates self, f ir.IrFunction, t ir.Term)
		try execRet(vm, f: f, t: t) otherwise ignore
	end 'visitRet'

	function visitThrow(mutates self, f ir.IrFunction, t ir.Term)
		try execThrow(vm, f: f, t: t) otherwise ignore
	end 'visitThrow'

	function visitTrap(mutates self, f ir.IrFunction, t ir.Term)
		vm.stderr.append("trap\n".toByteArray())
		_ = exitWith(vm, code: illegalInstructionExitCode)
	end 'visitTrap'
end 'Machine'

// takeEdge goes to the block target and sets its parameters from the arguments args[start] on, count of them. Every argument
// is read before any parameter is set, since an argument may be a parameter of the same block that another one sets.
function takeEdge(mutates vm Vm, f ir.IrFunction, target ir.BlockID, start Count, count Count)
	let block = try target as Count otherwise panic("interp: an edge to no block")
	if count != f.blocks[block].paramCount 'arity'
		panic("interp: an edge passes {count} arguments to b{block}, which has {f.blocks[block].paramCount} parameters")
	end 'arity'
	if count > 0 'args'
		var ns = ir.WordList.create(0)
		var rs = ir.WordList.create(0)
		for i in 0 upto count 'read'
			let at = vm.regAt(f.args[try start + i otherwise panic("interp: an edge argument past the pool")])
			ns.push(vm.regN[at])
			rs.push(vm.regR[at])
		end 'read'
		for i in 0 upto count 'write'
			let at = vm.regAt(f.blockParam(block, i: i))
			vm.regN[at] = ns[i]
			vm.regR[at] = rs[i]
		end 'write'
	end 'args'
	vm.curBlock = block
	vm.curPc = 0
end 'takeEdge'

// requireSlotsDropped is a violation for each slot that still owns a value when its function returns or fails.
function requireSlotsDropped(mutates vm Vm, f ir.IrFunction) throws Halt
	for i in 0 upto f.slots.count() 'slots'
		let c = slotCell(vm, slot: i)
		let o = vm.h.refOf(c)
		if o != 0 and not vm.h.oImmortal[o] and not vm.h.oFreed[o] and vm.h.heldBy(o, c: c) 'owns'
			let message = "slot s{i} still owns {objectText(vm, o: o)} when the function returns: no drop frees it"
			throw violation(vm, kind: leak, message: message)
		end 'owns'
	end 'slots'
end 'requireSlotsDropped'

// execRet hands the result to the caller. It must be a value that nothing owns, and no slot may still own anything: an owner
// that dies without dropping what it holds leaks it. A function that lends its result returns a live value that an owner
// the caller reaches still holds.
function execRet(mutates vm Vm, f ir.IrFunction, t ir.Term) throws Halt
	endWindows(vm)
	let src = ir.retValue(t)
	if isManaged(f, r: src) and f.lendsResult 'lent'
		try requireLent(vm, src: src)
	end 'lent' else if isManaged(f, r: src) 'managed'
		try requireHandedOn(vm, src: src, verb: "returns")
	end 'managed'
	try requireSlotsDropped(vm, f: f)
	let at = vm.regAt(src)
	let n = vm.regN[at]
	let r = vm.regR[at]
	leaveFrame(vm, n: n, r: r, err: 0, errRef: 0)
end 'execRet'

// requireHandedOn is a violation unless the managed register src holds a live value that nothing owns, which a return
// or a throw moves to the caller; verb is what the function does with it.
function requireHandedOn(mutates vm Vm, src ir.Reg, verb String) throws Halt
	let o = vm.ref(src)
	if o == 0 'moved'
		throw violation(vm, kind: movedUse, message: "the function {verb} a value that was moved out or never assigned")
	end 'moved'
	try requireLive(vm, o: o, what: "handed on")
	if not vm.h.oImmortal[o] and vm.h.oOwner[o] != 0 'owned'
		let message = "the function {verb} {objectText(vm, o: o)}, which {cellText(vm, c: vm.h.oOwner[o])} still owns: a {verb} moves its value"
		throw violation(vm, kind: ownership, message: message)
	end 'owned'
end 'requireHandedOn'

// requireLent is a violation unless the managed register src holds a live value that an owner holds, which a function that
// lends its result gives the caller to read.
function requireLent(mutates vm Vm, src ir.Reg) throws Halt
	let o = vm.ref(src)
	if o == 0 'moved'
		throw violation(vm, kind: movedUse, message: "the function lends a value that was moved out or never assigned")
	end 'moved'
	try requireLive(vm, o: o, what: "lent")
	if not vm.h.oImmortal[o] and not vm.h.oFrameArea[o] and vm.h.oOwner[o] == 0 'unowned'
		throw violation(vm, kind: ownership, message: "the function lends {objectText(vm, o: o)}, which nothing owns, so nothing would drop it: a lent result is a place of the caller's")
	end 'unowned'
end 'requireLent'

// managedErrorMark is the number that the error register of a call holds while it holds the box of an error union, which
// a branch on the register reads as an error.
let managedErrorMark = 1 as ir.Word

// execThrow hands the error to the caller: a case plus 1, or the box of an error union, which the caller then owns.
function execThrow(mutates vm Vm, f ir.IrFunction, t ir.Term) throws Halt
	endWindows(vm)
	let src = ir.throwErr(t)
	var err = vm.num(src)
	if isManaged(f, r: src) 'managed'
		try requireHandedOn(vm, src: src, verb: "throws")
		err = managedErrorMark
	end 'managed'
	try requireSlotsDropped(vm, f: f)
	let errRef = vm.regR[vm.regAt(src)]
	leaveFrame(vm, n: 0, r: 0, err: err, errRef: errRef)
end 'execThrow'

// enterFrame makes a call of a function with the arguments in argN and argR; its result goes to the register dst of the caller
// and its error to the register err, unless they are -1.
function enterFrame(mutates vm Vm, fn Count, dst ir.Word, err ir.Word) throws Halt
	if vm.frames.count() >= maxCallDepth 'deep'
		vm.stderr.append("stack overflow\n".toByteArray())
		throw exitWith(vm, code: stackOverflowExitCode)
	end 'deep'
	if vm.top != 0 'caller'
		vm.fr.block[vm.top] = vm.curBlock
		vm.fr.pc[vm.top] = vm.curPc
		vm.fr.idx[vm.top] = vm.curIdx
		vm.fr.post[vm.top] = vm.post
	end 'caller'
	let params = vm.argN.count()
	let regs = vm.prog.fnRegs[fn]
	let base = vm.stackTop
	let first = try base + params otherwise panic("interp: a frame past memory")
	let top = try first + regs otherwise panic("interp: a frame past memory")
	while vm.regN.count() < top 'grow'
		vm.regN.push(0)
		vm.regR.push(0)
	end 'grow'
	for i in 0 upto params 'params'
		let at = try base + i otherwise panic("interp: a parameter past memory")
		vm.regN[at] = vm.argN[i]
		vm.regR[at] = vm.argR[i]
	end 'params'
	for i in 0 upto regs 'regs'
		let at = try first + i otherwise panic("interp: a register past memory")
		vm.regN[at] = 0
		vm.regR[at] = 0
	end 'regs'
	vm.calls = try vm.calls + 1 otherwise panic("interp: more calls than memory")
	let slots = takeSlots(vm, fn: fn)
	let serial = vm.fr.push(fn, onThread: vm.cur, params: base, regs: first, slots: slots, frameBoxes: vm.prog.fnFrameBoxes[fn], dst: dst, err: err, call: vm.calls)
	for i in 0 upto vm.prog.fnSlots[fn] 'slots'
		let c = try slots + i otherwise panic("interp: a slot past memory")
		vm.h.cellN[c] = 0
		vm.h.cellR[c] = 0
		vm.h.cellLent[c] = false
		vm.h.cellFrame[c] = serial
		vm.h.cellIndex[c] = i
		raceFresh(vm, c: c)
	end 'slots'
	vm.stackTop = top
	vm.frames.push(serial)
	vm.top = serial
	vm.curFn = fn
	vm.curBlock = 0
	vm.curPc = 0
	vm.paramBase = base
	vm.regBase = first
	vm.slotBase = slots
	vm.post = false
	vm.switched = true
end 'enterFrame'

// returnedSlot marks a slot whose frame has returned, plus the frame's function (Heap.cellFrame): it lies above every serial,
// since there are never as many frames running.
let returnedSlot = 1099511627776 as Count

// slotFrame is the frame that the slot c belongs to, or 0 once that frame has returned.
function slotFrame(vm Vm, c Count) returns Count
	if vm.h.cellFrame[c] >= returnedSlot 'returned'
		return 0
	end 'returned'
	return vm.h.cellFrame[c]
end 'slotFrame'

// slotFunction is the function whose slot c is.
function slotFunction(vm Vm, c Count) returns Count
	let frame = vm.h.cellFrame[c]
	if frame >= returnedSlot 'returned'
		return frame - returnedSlot
	end 'returned'
	return vm.fr.fn[frame]
end 'slotFunction'

// takeSlots is the first cell of a block of the slots of a frame of the function fn: one that a frame of the function that
// returned gave back, or new cells.
function takeSlots(mutates vm Vm, fn Count) returns Count
	while vm.slotBlocks.count() <= fn 'functions'
		vm.slotBlocks.push(CountList.create(0))
	end 'functions'
	if vm.slotBlocks[fn].count() > 0 'given'
		return try vm.slotBlocks[fn].pop() otherwise panic("interp: no block of slots")
	end 'given'
	let first = vm.h.cellN.count()
	for _ in 0 upto vm.prog.fnSlots[fn] 'cells'
		_ = vm.h.newCell(0)
	end 'cells'
	return first
end 'takeSlots'

// giveSlotsBack gives the slots of the frame serial, which returns, to the next frame of its function. They name their
// function and no frame from here on, so an address of one taken in this frame is stale, and the next frame's epoch tells its
// own addresses from this frame's.
function giveSlotsBack(mutates vm Vm, serial Count)
	let fn = vm.fr.fn[serial]
	let first = vm.fr.slotBase[serial]
	let returned = try returnedSlot + fn otherwise panic("interp: a function past the mark of a returned slot")
	for i in 0 upto vm.prog.fnSlots[fn] 'slots'
		vm.h.cellFrame[try first + i otherwise panic("interp: a slot past memory")] = returned
	end 'slots'
	if vm.prog.fnSlots[fn] > 0 'block'
		vm.slotBlocks[fn].push(first)
	end 'block'
end 'giveSlotsBack'

// loadTop makes the frame at the top of the thread's stack the one that runs.
function loadTop(mutates vm Vm)
	let top = vm.top
	vm.curFn = vm.fr.fn[top]
	vm.curBlock = vm.fr.block[top]
	vm.curPc = vm.fr.pc[top]
	vm.curIdx = vm.fr.idx[top]
	vm.paramBase = vm.fr.paramBase[top]
	vm.regBase = vm.fr.regBase[top]
	vm.slotBase = vm.fr.slotBase[top]
	vm.post = vm.fr.post[top]
end 'loadTop'

// leaveFrame ends the frame that runs, giving the value n and r to its caller, and the error: its number err and, for an
// error union, the box errRef.
function leaveFrame(mutates vm Vm, n ir.Word, r ir.Word, err ir.Word, errRef ir.Word)
	let serial = vm.top
	let dst = vm.fr.retDst[serial]
	let errReg = vm.fr.retErr[serial]
	endFrameBoxes(vm, serial: serial)
	vm.stackTop = vm.fr.paramBase[serial]
	giveSlotsBack(vm, serial: serial)
	vm.fr.returned(serial)
	try vm.frames.pop() otherwise ignore
	vm.switched = true
	if vm.frames.count() == 0 'base'
		vm.top = 0
		vm.threads[vm.cur].retN = n
		vm.threads[vm.cur].retR = r
		vm.threads[vm.cur].errN = err
		vm.threads[vm.cur].errR = errRef
		return
	end 'base'
	vm.top = vm.frames[try vm.frames.count() - 1 otherwise panic("interp: no frames")]
	loadTop(vm)
	if dst >= 0 'gives'
		let at = try vm.regBase + (dst as Count) otherwise panic("interp: a register past memory")
		vm.regN[at] = n
		vm.regR[at] = r
	end 'gives'
	if errReg >= 0 'throws'
		let at = try vm.regBase + (errReg as Count) otherwise panic("interp: a register past memory")
		vm.regN[at] = err
		vm.regR[at] = errRef
	end 'throws'
end 'leaveFrame'

// runEndings calls the destructors of the cowns that the last instruction freed, in the order they were freed. A destructor that
// frees more cowns runs their destructors in its own instructions, so the list is taken before any runs. The frames are made
// last first, so that the one freed first runs first.
function runEndings(mutates vm Vm) throws Halt
	let fns = exchange(vm.endingFn, value: CountList.create(0))
	let ns = exchange(vm.endingN, value: ir.WordList.create(0))
	let rs = exchange(vm.endingR, value: ir.WordList.create(0))
	var i = fns.count()
	while i > 0 'due'
		i = i - 1
		clearArguments(vm)
		vm.argN.push(ns[i])
		vm.argR.push(rs[i])
		try enterFrame(vm, fn: fns[i], dst: -1, err: -1)
	end 'due'
end 'runEndings'

// finishInstruction is what follows an instruction that has run: the destructors of the cowns it freed, and the windows its
// result opens for the calls that wait for the arguments after it.
function finishInstruction(mutates m Machine, info Count, f ir.IrFunction)
	if m.vm.dropWaits.count() > 0 'dropped'
		let settled = try settleDrops(m.vm) otherwise return
		if not settled 'waits'
			return
		end 'waits'
	end 'dropped'
	if m.vm.endingFn.count() > 0 'endings'
		m.vm.post = true
		try runEndings(m.vm) otherwise ignore
		return
	end 'endings'
	var link = m.vm.prog.infos[info].head[m.vm.curIdx]
	while link != 0 'windows'
		let entry = link - 1
		let call = m.vm.prog.infos[info].calls[entry]
		let callBlock = m.vm.prog.infos[info].blocks[entry]
		let idx = m.vm.curIdx
		let def = m.vm.curBlock
		openWindow(m.vm, f: f, k: idx, call: call, callBlock: callBlock, def: def)
		link = m.vm.prog.infos[info].next[entry]
	end 'windows'
	m.vm.post = false
	m.vm.curPc = try m.vm.curPc + 1 otherwise panic("interp: an instruction past a word")
end 'finishInstruction'

// runFrame runs the frame at the top of the thread, which is of the function f, until the frame that runs changes, the thread
// gives up its turn, or the run ends. Each step counts an instruction: the run ends when the program has used its steps, and
// the thread gives the turn back when its burst is used.
function runFrame(mutates m Machine, f ir.IrFunction)
	let fi = m.vm.curFn
	if not m.vm.prog.infoBuilt[fi] 'info'
		buildInfo(m.vm, f: f, fi: fi)
	end 'info'
	m.vm.switched = false
	var block = m.vm.curBlock
	var first = f.blocks[block].first
	var count = (try f.blocks[block].endAt - first otherwise panic("interp: a block that ends before it starts")) as Count
	while m.vm.fatal == fatalNone and not m.vm.switched and not m.vm.yielded 'run'
		if m.vm.post 'post'
			finishInstruction(m, info: fi, f: f)
			continue 'run'
		end 'post'
		if m.vm.curBlock != block 'entered'
			block = m.vm.curBlock
			first = f.blocks[block].first
			count = try f.blocks[block].endAt - first otherwise panic("interp: a block that ends before it starts")
		end 'entered'
		if m.vm.curPc >= 0 and (m.vm.curPc as Count) >= count 'end'
			m.vm.curPc = terminatorPc
		end 'end'
		if m.vm.ticked 'counted'
			m.vm.ticked = false
		end 'counted' else 'count'
			m.vm.steps = try m.vm.steps + 1 otherwise panic("interp: more steps than a word")
			if m.vm.steps > m.vm.limit 'limit'
				_ = timeout(m.vm)
				return
			end 'limit'
			m.vm.sinceClock = try m.vm.sinceClock + 1 otherwise panic("interp: more instructions than a word since the clock was read")
			if m.vm.sinceClock == clockCheckSteps 'clock'
				m.vm.sinceClock = 0
				if elapsedMillis(m.vm.startedNanos) >= m.vm.deadlineMs 'late'
					_ = timeout(m.vm)
					return
				end 'late'
			end 'clock'
			if m.vm.concurrent 'concurrent'
				m.vm.burst = try m.vm.burst - 1 otherwise panic("interp: a thread ran with no burst left")
				if m.vm.burst == 0 'spent'
					m.vm.yielded = true
					m.vm.ticked = true
					return
				end 'spent'
			end 'concurrent'
		end 'count'
		if m.vm.curPc < 0 'terminator'
			ir.visitTerm(m, f: f, t: f.blocks[block].term)
			continue 'run'
		end 'terminator'
		let idx = try first + (m.vm.curPc as Count) otherwise panic("interp: an instruction past memory")
		m.vm.curIdx = idx
		ir.visitInstr(m, f: f, x: f.instrs[idx])
		if m.vm.fatal != fatalNone or m.vm.switched 'left'
			return
		end 'left'
		if m.vm.failTo >= 0 'failed'
			let target = m.vm.failTo as Count
			m.vm.failTo = noFailure
			skipWindows(m.vm, f: f, target: target)
			m.vm.curBlock = target
			m.vm.curPc = 0
			continue 'run'
		end 'failed'
		if m.vm.endingFn.count() == 0 and m.vm.dropWaits.count() == 0 and m.vm.prog.infos[fi].head[idx] == 0 'plain'
			m.vm.curPc = try m.vm.curPc + 1 otherwise panic("interp: an instruction past a word")
		end 'plain' else 'followed'
			m.vm.post = true
		end 'followed'
	end 'run'
end 'runFrame'
