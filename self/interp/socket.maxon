// The rows of a TCP socket, run on a socket of the system's, which the interpreter has none of: it stops at each with the
// operation's name, never giving a result, and a program that opens a socket says `// native-only`, as one that opens a file
// does (handles.maxon).

// haltSocketRow is the halt of the interpreter at a row of a socket.
function haltSocketRow(mutates vm Vm, row String) returns Halt
	return unmodelled(vm, what: "{row} is not run by the interpreter, which has no sockets: mark the program native-only")
end 'haltSocketRow'

function entrySocketListen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltSocketRow(vm, row: "__Builtins.socketListen")
end 'entrySocketListen'

function entrySocketBoundPort(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltSocketRow(vm, row: "__Builtins.socketBoundPort")
end 'entrySocketBoundPort'

function entrySocketAccept(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
