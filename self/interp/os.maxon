// The interpreter's OS entries do what the native ones do, through the OS functions of this compiler's own runtime. An entry
// that can fail has the address of its error word last: the case plus 1 of the error, or 0 for none.

// errorWord sets the error word of an entry that can fail.
function errorWord(mutates vm Vm, f ir.IrFunction, x ir.Instr, word ir.Word) throws Halt
	let last = try ir.callRuntimeArgsCount(x) - 1 otherwise panic("interp: an entry that can fail has no arguments")
	let cell = try target(vm, addr: argAt(f, x: x, i: last), what: "an OS entry's error")
	try changed(vm, c: cell, o: 0)
	vm.h.cellN[cell] = word
	vm.h.cellR[cell] = 0
end 'errorWord'

// caseWord is the error word of a failure that is a case of the operation's error.
function caseWord(errorCase Count) returns ir.Word
	return try (errorCase + 1) as ir.Word otherwise panic("interp: an error case past a word")
end 'caseWord'

// pathOf is the path that a string names: the paths the program gives are the ones FilePath.from made already.
function pathOf(text String) returns FilePath
	return try FilePath.from(text) otherwise panic("interp: the program gave an OS entry a path that is no path")
end 'pathOf'

// stringArray is a new array of the strings.
function stringArray(mutates vm Vm, texts ast.StringList) returns Count
	let arr = newArray(vm)
	for i in 0 upto texts.count() 'each'
		let s = newString(vm, text: texts[i].clone())
		let cell = vm.h.newCell(arr)
		vm.h.cellR[cell] = try s as ir.Word otherwise panic("interp: a handle past a word")
		vm.h.oOwner[s] = cell
		vm.h.elements[vm.h.oData[arr]].push(cell)
	end 'each'
	return arr
end 'stringArray'

function entryOsArgs(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let args = CommandLine.args()
	var texts = ast.StringList.create(0)
	for i in 0 upto args.count() 'each'
		texts.push(args[i].clone())
	end 'each'
	let made = stringArray(vm, texts: texts)
	giveRef(vm, x: x, o: made)
end 'entryOsArgs'

function entryOsEnvironmentVariable(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "an environment variable's name")
	let name = vm.h.texts[at].clone()
	var word = 0 as ir.Word
	var value = ""
	try 'read'
		value = Process.environmentVariable(name)
	end 'read' otherwise (e) 'failed'
		match e 'kind'
			pathUnavailable then word = caseWord(ast.errorPathUnavailable)
			variableUnset then word = caseWord(ast.errorVariableUnset)
			environmentUnreadable then word = caseWord(ast.errorEnvironmentUnreadable)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
	if word == 0 'found'
		let made = newString(vm, text: value)
		giveRef(vm, x: x, o: made)
	end 'found'
end 'entryOsEnvironmentVariable'

function entryOsExecutablePath(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	var word = 0 as ir.Word
	var value = ""
	try 'read'
		value = Process.executablePath().toString()
	end 'read' otherwise (e) 'failed'
		match e 'kind'
			pathUnavailable then word = caseWord(ast.errorPathUnavailable)
			variableUnset then word = caseWord(ast.errorVariableUnset)
			environmentUnreadable then word = caseWord(ast.errorEnvironmentUnreadable)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
	if word == 0 'found'
		let made = newString(vm, text: value)
		giveRef(vm, x: x, o: made)
	end 'found'
end 'entryOsExecutablePath'

function entryOsCurrentPath(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let made = newString(vm, text: Directory.currentPath().toString())
	giveRef(vm, x: x, o: made)
end 'entryOsCurrentPath'

function entryOsProcessId(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	giveNum(vm, x: x, n: try Process.id() as ir.Word otherwise panic("interp: the process id is past a word"))
end 'entryOsProcessId'

// The interpreter runs one thread at a time, so its scheduler has one worker.
let interpretedWorkers = 1 as ir.Word

function entryOsProcessorCount(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	giveNum(vm, x: x, n: interpretedWorkers)
end 'entryOsProcessorCount'

// clockStepNanos is how far one reading moves the interpreter's clock.
let clockStepNanos = 1000 as ir.Word

function entryOsClockNanos(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let now = stepClock(vm)
	giveNum(vm, x: x, n: now)
end 'entryOsClockNanos'

// stepClock is a reading of the interpreter's clock.
function stepClock(mutates vm Vm) returns ir.Word
	vm.clockNanos = try vm.clockNanos + clockStepNanos otherwise panic("interp: the clock is past a word")
	return vm.clockNanos
end 'stepClock'

let nanosPerMillisecond = 1000000 as ir.Word

let nanosPerSecond = 1000000000 as ir.Word

// interpretedEpochSeconds is the second, since 1970, that the interpreter's calendar starts at, so that a run reads the same
// time every time.
let interpretedEpochSeconds = 1700000000 as ir.Word

function entryOsClockMillis(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let since = stepClock(vm)
	giveNum(vm, x: x, n: since / nanosPerMillisecond)
end 'entryOsClockMillis'

function entryOsTickMillis(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let since = stepClock(vm)
	giveNum(vm, x: x, n: since / nanosPerMillisecond)
end 'entryOsTickMillis'

function entryOsThreadCpuTicks(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let ticks = stepClock(vm)
	giveNum(vm, x: x, n: ticks)
end 'entryOsThreadCpuTicks'

function entryOsUnixNanos(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let since = stepClock(vm)
	giveNum(vm, x: x, n: try interpretedEpochSeconds * nanosPerSecond + since otherwise panic("interp: the calendar is past a word"))
end 'entryOsUnixNanos'

function entryOsUnixSeconds(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let since = stepClock(vm)
	giveNum(vm, x: x, n: interpretedEpochSeconds + since / nanosPerSecond)
end 'entryOsUnixSeconds'

function entryOsSetExitCode(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	vm.setExit = true
	vm.setExitValue = int32Of(argNum(vm, f: f, x: x, i: 0))
end 'entryOsSetExitCode'

function entryOsPathFrom(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let text = vm.h.texts[at].clone()
	var word = 0 as ir.Word
	var value = ""
	try 'convert'
		value = FilePath.from(text).toString()
	end 'convert' otherwise (e) 'failed'
		match e 'kind'
			invalidCharacter then word = caseWord(ast.errorPathInvalidCharacter)
			notFileURL then word = caseWord(ast.errorPathNotFileURL)
			malformedURL then word = caseWord(ast.errorPathMalformedURL)
			noParent then word = caseWord(ast.errorPathNoParent)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
	if word == 0 'converted'
		let made = newString(vm, text: value)
		giveRef(vm, x: x, o: made)
	end 'converted'
end 'entryOsPathFrom'

function entryOsReadText(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let path = pathOf(vm.h.texts[at].clone())
	var word = 0 as ir.Word
	var value = ""
	try 'read'
		value = File.readText(path)
	end 'read' otherwise (e) 'failed'
		match e 'kind'
			notFound then word = caseWord(ast.errorReadNotFound)
			accessDenied then word = caseWord(ast.errorReadAccessDenied)
			busy then word = caseWord(ast.errorReadBusy)
			failed then word = caseWord(ast.errorReadFailed)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
	if word == 0 'read'
		let made = newString(vm, text: value)
		giveRef(vm, x: x, o: made)
	end 'read'
end 'entryOsReadText'

// writeBytes writes a file with the mode and gives the error word of its failure, or 0.
function writeBytes(path FilePath, content ByteArray, mode FilePermission) returns ir.Word
	try 'write'
		File.writeBinary(path, content: content, mode: mode)
	end 'write' otherwise (e) 'failed'
		match e 'kind'
			failed then return caseWord(ast.errorWriteFailed)
			notFound then return caseWord(ast.errorWriteNotFound)
			accessDenied then return caseWord(ast.errorWriteAccessDenied)
			alreadyExists then return caseWord(ast.errorWriteAlreadyExists)
			busy then return caseWord(ast.errorWriteBusy)
			partialFileLeft then return caseWord(ast.errorWritePartialFileLeft)
		end 'kind'
	end 'failed'
	return 0
end 'writeBytes'

// writeMode is the mode a write asks for with the executable flag that it passes at argument i.
function writeMode(vm Vm, f ir.IrFunction, x ir.Instr, i Count) returns FilePermission
	if argNum(vm, f: f, x: x, i: i) != 0 'executable'
		return FilePermission.executable
	end 'executable'
	return FilePermission.normal
end 'writeMode'

// writeTextEntry is the write of a string, which gives the file the mode.
function writeTextEntry(mutates vm Vm, f ir.IrFunction, x ir.Instr, mode FilePermission) throws Halt
	let pathAt = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let path = pathOf(vm.h.texts[pathAt].clone())
	let contentAt = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "a file's content")
	let word = writeBytes(path, content: vm.h.texts[contentAt].toByteArray(), mode: mode)
	try errorWord(vm, f: f, x: x, word: word)
end 'writeTextEntry'

// writeBinaryEntry is the write of a byte array, which gives the file the mode.
function writeBinaryEntry(mutates vm Vm, f ir.IrFunction, x ir.Instr, mode FilePermission) throws Halt
	let pathAt = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let path = pathOf(vm.h.texts[pathAt].clone())
	let bytes = try collection(vm, o: argRef(vm, f: f, x: x, i: 1), kind: kindBytes, what: "a file's content")
	let word = writeBytes(path, content: vm.h.buffers[vm.h.oData[bytes]].clone(), mode: mode)
	try errorWord(vm, f: f, x: x, word: word)
end 'writeBinaryEntry'

function entryOsWriteTextMode(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	try writeTextEntry(vm, f: f, x: x, mode: writeMode(vm, f: f, x: x, i: 2))
end 'entryOsWriteTextMode'

function entryOsWriteBinaryMode(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	try writeBinaryEntry(vm, f: f, x: x, mode: writeMode(vm, f: f, x: x, i: 2))
end 'entryOsWriteBinaryMode'

function entryOsRename(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let fromAt = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let source = pathOf(vm.h.texts[fromAt].clone())
	let toAt = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "a path")
	let dest = pathOf(vm.h.texts[toAt].clone())
	var word = 0 as ir.Word
	try 'rename'
		File.rename(source, to: dest)
	end 'rename' otherwise (e) 'failed'
		match e 'kind'
			failed then word = caseWord(ast.errorRenameFailed)
			notFound then word = caseWord(ast.errorRenameNotFound)
			accessDenied then word = caseWord(ast.errorRenameAccessDenied)
			busy then word = caseWord(ast.errorRenameBusy)
			alreadyExists then word = caseWord(ast.errorRenameAlreadyExists)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
end 'entryOsRename'

function entryOsDelete(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let path = pathOf(vm.h.texts[at].clone())
	var word = 0 as ir.Word
	try 'delete'
		File.delete(path)
	end 'delete' otherwise (e) 'failed'
		match e 'kind'
			notFound then word = caseWord(ast.errorDeleteNotFound)
			accessDenied then word = caseWord(ast.errorDeleteAccessDenied)
			busy then word = caseWord(ast.errorDeleteBusy)
			failed then word = caseWord(ast.errorDeleteFailed)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
end 'entryOsDelete'

// The places of rt.os.fileInfo's arguments that it stores what it found at, and the bits of its attributes word.
let infoSizeArg = 1

let infoCreatedArg = 2

let infoAccessedArg = 3

let infoAttributesArg = 4

let infoDirectoryFlag = 1 as ir.Word

let infoReadOnlyFlag = 2 as ir.Word

// storeNumber stores n at the address that the argument at index of an entry's call gives.
function storeNumber(mutates vm Vm, f ir.IrFunction, x ir.Instr, index Count, n ir.Word) throws Halt
	let cell = try target(vm, addr: argAt(f, x: x, i: index), what: "a word an OS entry stores")
	try changed(vm, c: cell, o: 0)
	vm.h.cellN[cell] = n
	vm.h.cellR[cell] = 0
end 'storeNumber'

// wordOf is a size or a time as the word an entry gives it in.
function wordOf(n Count) returns ir.Word
	return try n as ir.Word otherwise panic("interp: a file's size or time past a word")
end 'wordOf'

function entryOsFileInfo(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let path = pathOf(vm.h.texts[at].clone())
	var word = 0 as ir.Word
	var size = 0 as ir.Word
	var modified = 0 as ir.Word
	var created = 0 as ir.Word
	var accessed = 0 as ir.Word
	var flags = 0 as ir.Word
	try 'info'
		let info = File.info(path)
		size = wordOf(info.size)
		modified = wordOf(info.modifiedTime)
		created = wordOf(info.createdTime)
		accessed = wordOf(info.accessedTime)
		if info.isDirectory 'directory'
			flags = flags or infoDirectoryFlag
		end 'directory'
		if info.isReadOnly 'readOnly'
			flags = flags or infoReadOnlyFlag
		end 'readOnly'
	end 'info' otherwise (e) 'failed'
		match e 'kind'
			notFound then word = caseWord(ast.errorInfoNotFound)
			accessDenied then word = caseWord(ast.errorInfoAccessDenied)
			busy then word = caseWord(ast.errorInfoBusy)
			failed then word = caseWord(ast.errorInfoFailed)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
	if word == 0 'found'
		try storeNumber(vm, f: f, x: x, index: infoSizeArg, n: size)
		try storeNumber(vm, f: f, x: x, index: infoCreatedArg, n: created)
		try storeNumber(vm, f: f, x: x, index: infoAccessedArg, n: accessed)
		try storeNumber(vm, f: f, x: x, index: infoAttributesArg, n: flags)
		giveNum(vm, x: x, n: modified)
	end 'found'
end 'entryOsFileInfo'

// entryOsExists is whether a file or a directory is at a path, which the host can give the information of.
function entryOsExists(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	var there = true
	try 'info'
		_ = File.info(pathOf(vm.h.texts[at].clone()))
	end 'info' otherwise 'missing'
		there = false
	end 'missing'
	giveFlag(vm, x: x, b: there)
end 'entryOsExists'

function entryOsIsDirectory(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	giveFlag(vm, x: x, b: Directory.isDirectory(pathOf(vm.h.texts[at].clone())))
end 'entryOsIsDirectory'

function entryOsCreateDirectory(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	giveFlag(vm, x: x, b: Directory.create(pathOf(vm.h.texts[at].clone())))
end 'entryOsCreateDirectory'

// entryOsDeleteDirectory halts: the interpreter removes no directory, so a program that does says `// native-only`.
function entryOsDeleteDirectory(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	panic("interp: Directory.delete is not run by the interpreter: mark the program native-only")
end 'entryOsDeleteDirectory'

function entryOsList(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a path")
	let path = pathOf(vm.h.texts[at].clone())
	var word = 0 as ir.Word
	var texts = ast.StringList.create(0)
	try 'list'
		let entries = Directory.list(path)
		for i in 0 upto entries.count() 'each'
			texts.push(entries[i].toString())
		end 'each'
	end 'list' otherwise (e) 'failed'
		match e 'kind'
			notFound then word = caseWord(ast.errorListNotFound)
			accessDenied then word = caseWord(ast.errorListAccessDenied)
			listFailed then word = caseWord(ast.errorListFailed)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
	if word == 0 'listed'
		let made = stringArray(vm, texts: texts)
		giveRef(vm, x: x, o: made)
	end 'listed'
end 'entryOsList'

// The arguments of rt.os.run that are the child's deadline and the addresses its output is stored at; rt.os.runIn has the
// directory the child starts in at runDirectoryArg, before them.
let runDeadlineArg = 2 as Count

let runStdoutArg = 3 as Count

let runStderrArg = 4 as Count

let runDirectoryArg = 2 as Count

// runInShift is how far the arguments of rt.os.runIn after its directory are from where rt.os.run has them.
let runInShift = 1 as Count

// childOutput runs the child in directory, or in the interpreter's working directory when that is empty.
function childOutput(executable Executable, arguments ast.StringList, directory String, deadline WaitDeadline) returns CollectedOutput throws SubprocessError
	if directory == "" 'inherited'
		return try Subprocess.runWithDeadline(executable, arguments: arguments, deadline: deadline)
	end 'inherited'
	let at = try FilePath.from(directory) otherwise panic("interp: the working directory {directory} is not a path")
	return try Subprocess.runInDirectory(executable, arguments: arguments, directory: at, deadline: deadline)
end 'childOutput'

// runArg is the index of an argument of rt.os.run in an entry whose arguments are shift past rt.os.run's.
function runArg(index Count, shift Count) returns Count
	return try index + shift otherwise panic("interp: an argument of rt.os.run past memory")
end 'runArg'

// deadlineOf is the deadline that the milliseconds of rt.os.run name.
function deadlineOf(ms ir.Word) returns WaitDeadline
	if ms == ir.noDeadline 'never'
		return WaitDeadline.none
	end 'never'
	return WaitDeadline.within(try ms as Count otherwise panic("interp: a deadline past a count"))
end 'deadlineOf'

// output stores what the child wrote to a stream at the address the argument at index gives.
function output(mutates vm Vm, f ir.IrFunction, x ir.Instr, index Count, consumes text String) throws Halt
	let cell = try target(vm, addr: argAt(f, x: x, i: index), what: "a child's output")
	try changed(vm, c: cell, o: 0)
	let o = newString(vm, text: text)
	try adopt(vm, c: cell, o: o, what: "a child's output")
end 'output'

// isPath is whether the text of an executable says where it is, rather than naming it for the system to search for.
function isPath(text String) returns bool
	for i in 0 upto text.byteLength() 'each'
		let c = text.byteAt(i)
		if c == 92 or c == 47 or c == 58 'separator'
			return true
		end 'separator'
	end 'each'
	return false
end 'isPath'

function entryOsRun(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	try runChild(vm, f: f, x: x, directory: "", shift: 0)
end 'entryOsRun'

function entryOsRunIn(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let directoryAt = try textIndex(vm, o: argRef(vm, f: f, x: x, i: runDirectoryArg), what: "a working directory")
	let directory = vm.h.texts[directoryAt].clone()
	try runChild(vm, f: f, x: x, directory: directory, shift: runInShift)
end 'entryOsRunIn'

// runChild runs the child of rt.os.run, or of rt.os.runIn, whose arguments past the directory are shift from rt.os.run's, in
// directory, or in the interpreter's working directory when that is empty.
function runChild(mutates vm Vm, f ir.IrFunction, x ir.Instr, directory String, shift Count) throws Halt
	let exeAt = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "an executable")
	let exeText = vm.h.texts[exeAt].clone()
	let argsObj = try collection(vm, o: argRef(vm, f: f, x: x, i: 1), kind: kindArray, what: "the arguments")
	var args = ast.StringList.create(0)
	for i in 0 upto vm.h.elements[vm.h.oData[argsObj]].count() 'args'
		let element = vm.h.elements[vm.h.oData[argsObj]][i]
		let textAt = try textIndex(vm, o: vm.h.refOf(element), what: "an argument")
		args.push(vm.h.texts[textAt].clone())
	end 'args'
	var executable = Executable.name(exeText.clone())
	if isPath(exeText) 'path'
		executable = Executable.path(pathOf(exeText.clone()))
	end 'path'
	let deadline = deadlineOf(argNum(vm, f: f, x: x, i: runArg(runDeadlineArg, shift: shift)))
	var word = 0 as ir.Word
	var stdout = ""
	var stderr = ""
	var code = 0 as ir.Word
	try 'run'
		let out = try childOutput(executable, arguments: args, directory: directory, deadline: deadline)
		stdout = out.stdout.clone()
		stderr = out.stderr.clone()
		code = out.exitCode() as ir.Word
	end 'run' otherwise (e) 'failed'
		match e 'kind'
			executableNotFound then word = caseWord(ast.errorExecutableNotFound)
			spawnFailed then word = caseWord(ast.errorSpawnFailed)
			busy then word = caseWord(ast.errorSpawnBusy)
			ioFailed then word = caseWord(ast.errorIoFailed)
			timeout then word = caseWord(ast.errorTimeout)
			treeNotEnded then word = caseWord(ast.errorTreeNotEnded)
			detachRefused then word = caseWord(ast.errorDetachRefused)
			inputTooLarge then word = caseWord(ast.errorInputTooLarge)
			statusLost then word = caseWord(ast.errorStatusLost)
		end 'kind'
	end 'failed'
	try errorWord(vm, f: f, x: x, word: word)
	if word == 0 'ran'
		try output(vm, f: f, x: x, index: runArg(runStdoutArg, shift: shift), text: stdout)
		try output(vm, f: f, x: x, index: runArg(runStderrArg, shift: shift), text: stderr)
		giveNum(vm, x: x, n: code)
	end 'ran'
end 'runChild'

// entryOsRunInput halts: the interpreter gives no child an input of its own, so a program that does says `// native-only`.
function entryOsRunInput(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	panic("interp: Subprocess.runWithInput is not run by the interpreter: mark the program native-only")
end 'entryOsRunInput'

// entryOsReadStdin gives up to the count asked of the standard input the run was given, and nothing at its end.
function entryOsReadStdin(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let most = try argNum(vm, f: f, x: x, i: 0) as Count otherwise panic("interp: a read's count past a count")
	let left = try vm.stdin.count() - vm.stdinRead otherwise panic("interp: the standard input was read past its end")
	let taken = most if most < left else left
	let stop = try vm.stdinRead + taken otherwise panic("interp: the standard input past a count")
	let bytes = try vm.stdin.slice(vm.stdinRead, endIndex: stop) otherwise panic("interp: the standard input was read past its end")
	vm.stdinRead = stop
	let made = newBytes(vm, buf: bytes)
	giveRef(vm, x: x, o: made)
end 'entryOsReadStdin'

// entryOsStdoutWantsColor is false: the interpreter's standard output is a capture, which no escape sequence may go into.
function entryOsStdoutWantsColor(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	giveFlag(vm, x: x, b: false)
end 'entryOsStdoutWantsColor'

// entrySchedPin pins nothing: the interpreter runs one thread, which every green thread is on.
function entrySchedPin(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	giveNum(vm, x: x, n: 1)
end 'entrySchedPin'

function entrySchedUnpin(mutates vm Vm, f ir.IrFunction, x ir.Instr)
end 'entrySchedUnpin'

// The debug port's entries halt: the interpreter drives no debuggee, so a program that does says `// native-only`.
function entryDebugLaunch(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugLaunch'

function entryDebugWaitEvent(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugWaitEvent'

function entryDebugContinueEvent(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugContinueEvent'

function entryDebugReadMemory(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugReadMemory'

function entryDebugWriteCode(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugWriteCode'

function entryDebugReadContext(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugReadContext'

function entryDebugWriteContext(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugWriteContext'

function entryDebugSuspend(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugSuspend'

function entryDebugResume(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugResume'

function entryDebugBreakIn(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugBreakIn'

function entryDebugDetach(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugDetach'

function entryDebugCloseHandle(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugCloseHandle'

function entryDebugTerminate(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	debugPortNotInterpreted()
end 'entryDebugTerminate'

// The interpreter runs inside the process that interprets it, whose priority a program it runs is not to change: a program that
// asks is marked native-only.
function entryOsEnterBackgroundPriority(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	panic("interp: the interpreter does not change the compiler's priority: mark the program native-only")
end 'entryOsEnterBackgroundPriority'

function debugPortNotInterpreted()
	panic("interp: the debug port is not run by the interpreter: mark the program native-only")
end 'debugPortNotInterpreted'
