let i64Max = 9223372036854775807 as ir.Word

function foldRun(label String, mutates p ast.Project, f ir.IrFunction, want ast.StringList, exit ExitCode)
	expectClean("{label} as built", out: runMain(p, main: f), exit: exit as ir.Word)
	var g = f.clone()
	var fold = opt.Fold.new()
	fold.foldFunction(g, raises: true)
	ir.expectIr(label, got: ir.irText(p, tt: ast.TypeSlot.none(), reads: p.types, ft: ast.FuncSlot.none(), funcReads: p.funcs, f: g), want: want)
	let problems = ir.verifyIr(p, tt: ast.TypeSlot.none(), reads: p.types, ft: ast.FuncSlot.none(), funcReads: p.funcs, f: g)
	if problems.count() > 0 'refused'
		panic("{label}: the verifier refuses it: {problems[0]}")
	end 'refused'
	expectClean(label, out: runMain(p, main: g), exit: exit as ir.Word)
	backend.runIr(p, fns: ir.oneFunction(g.clone()), entry: g.decl, count: false, name: "minimaxon_fold_{label}.exe", expectedCode: exit, expectedOutput: "")
end 'foldRun'

// Constants fold through arithmetic and a comparison into the branch, which becomes a jump, and the arm it never takes goes.
test 'constants fold into the branch'
	var p = ir.irProject()
	var b = ir.BpFn.new(p)
	let entry = b.block()
	let yes = b.block()
	let no = b.block()
	let forty = b.konst(entry, value: 40)
	let two = b.konst(entry, value: 2)
	let sum = b.bin(entry, op: ir.BinOp.binAdd, left: forty, right: two, fail: ir.noBlock)
	let want42 = b.konst(entry, value: 42)
	let same = b.cmp(entry, op: ir.CmpOp.cmpEq, left: sum, right: want42)
	b.b.terminate(entry, t: ir.newBranch(same, ifTrue: yes, ifFalse: no))
	b.b.terminate(yes, t: ir.newRet(sum))
	let one = b.konst(no, value: 1)
	b.b.terminate(no, t: ir.newRet(one))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %2 = const 42")
	want.push("  jump b1")
	want.push("b1:")
	want.push("  ret %2")
	want.push("")
	foldRun("branch", p: p, f: b.b.finish(), want: want, exit: 42)
end 'constants fold into the branch'

// A checked addition whose constants overflow is the jump to its failure block, which is then where the function goes;
// nothing after the addition is left.
test 'an overflowing constant addition takes its failure'
	var p = ir.irProject()
	var b = ir.BpFn.new(p)
	let entry = b.block()
	let failed = b.block()
	let max = b.konst(entry, value: i64Max)
	let one = b.konst(entry, value: 1)
	let sum = b.bin(entry, op: ir.BinOp.binAdd, left: max, right: one, fail: failed)
	b.b.terminate(entry, t: ir.newRet(sum))
	let seven = b.konst(failed, value: 7)
	b.b.terminate(failed, t: ir.newRet(seven))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  jump b1")
	want.push("b1:")
	want.push("  %3 = const 7")
	want.push("  ret %3")
	want.push("")
	foldRun("overflow", p: p, f: b.b.finish(), want: want, exit: 7)
end 'an overflowing constant addition takes its failure'

// The guard of a divisor that is the constant 0 fails, so the function goes to its failure block there; the division after
// it, which has no meaning on 0, is never folded and goes with the rest of the block.
test 'a division by a zero constant takes its failure'
	var p = ir.irProject()
	var b = ir.BpFn.new(p)
	let entry = b.block()
	let failed = b.block()
	let ten = b.konst(entry, value: 10)
	let zero = b.konst(entry, value: 0)
	b.b.emit(entry, i: ir.newGuard(zero, kind: ir.GuardKind.guardNonZero, bound: 0, fail: failed))
	let quotient = b.bin(entry, op: ir.BinOp.binDiv, left: ten, right: zero, fail: ir.noBlock)
	b.b.terminate(entry, t: ir.newRet(quotient))
	let three = b.konst(failed, value: 3)
	b.b.terminate(failed, t: ir.newRet(three))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  jump b1")
	want.push("b1:")
	want.push("  %3 = const 3")
	want.push("  ret %3")
	want.push("")
	foldRun("divisionByZero", p: p, f: b.b.finish(), want: want, exit: 3)
end 'a division by a zero constant takes its failure'

// Constants that pass their checks fold: a guard that holds goes, and so does the check of an addition that fits.
test 'checks that constants pass go'
	var p = ir.irProject()
	var b = ir.BpFn.new(p)
	let entry = b.block()
	let failed = b.block()
	let ten = b.konst(entry, value: 10)
	let five = b.konst(entry, value: 5)
	b.b.emit(entry, i: ir.newGuard(five, kind: ir.GuardKind.guardNonZero, bound: 0, fail: failed))
	let quotient = b.bin(entry, op: ir.BinOp.binDiv, left: ten, right: five, fail: ir.noBlock)
	let sum = b.bin(entry, op: ir.BinOp.binAdd, left: quotient, right: ten, fail: failed)
	b.b.terminate(entry, t: ir.newRet(sum))
	let three = b.konst(failed, value: 3)
	b.b.terminate(failed, t: ir.newRet(three))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %3 = const 12")
	want.push("  ret %3")
	want.push("")
	foldRun("checksPass", p: p, f: b.b.finish(), want: want, exit: 12)
end 'checks that constants pass go'

// A checked addition of a value the pass cannot know keeps its check, which fires on the seventh trip of the loop.
test 'a check that may fire stays'
	var p = ir.irProject()
	var b = ir.BpFn.new(p)
	let entry = b.block()
	let header = b.block()
	let body = b.block()
	let exit = b.block()
	let failed = b.block()
	let zero = b.konst(entry, value: 0)
	let entryTerm = b.b.jumpWith(header, args: ir.regs1(zero))
	b.b.terminate(entry, t: entryTerm)
	let i = b.param(header)
	let limit = b.konst(header, value: 10)
	let more = b.cmp(header, op: ir.CmpOp.cmpLt, left: i, right: limit)
	b.b.terminate(header, t: ir.newBranch(more, ifTrue: body, ifFalse: exit))
	let big = b.konst(body, value: 9223372036854775801)
	_ = b.bin(body, op: ir.BinOp.binAdd, left: i, right: big, fail: failed)
	let one = b.konst(body, value: 1)
	let next = b.bin(body, op: ir.BinOp.binAdd, left: i, right: one, fail: ir.noBlock)
	let bodyTerm = b.b.jumpWith(header, args: ir.regs1(next))
	b.b.terminate(body, t: bodyTerm)
	b.b.terminate(exit, t: ir.newRet(zero))
	let nine = b.konst(failed, value: 9)
	b.b.terminate(failed, t: ir.newRet(nine))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %0 = const 0")
	want.push("  jump b1(%0)")
	want.push("b1(%1):")
	want.push("  %2 = const 10")
	want.push("  %3 = cmp.lt %1, %2")
	want.push("  branch %3, b2, b3")
	want.push("b2:")
	want.push("  %4 = const 9223372036854775801")
	want.push("  %5 = add %1, %4 else b4")
	want.push("  %6 = const 1")
	want.push("  %7 = add %1, %6")
	want.push("  jump b1(%7)")
	want.push("b3:")
	want.push("  ret %0")
	want.push("b4:")
	want.push("  %8 = const 9")
	want.push("  ret %8")
	want.push("")
	foldRun("mayFire", p: p, f: b.b.finish(), want: want, exit: 9)
end 'a check that may fire stays'

// A parameter that both edges into its block pass the same value is that value, and one that nothing reads goes.
test 'trivial and dead parameters go'
	var p = ir.irProject()
	var b = ir.BpFn.new(p)
	let entry = b.block()
	let header = b.block()
	let body = b.block()
	let left = b.block()
	let right = b.block()
	let join = b.block()
	let exit = b.block()
	let five = b.konst(entry, value: 5)
	let zero = b.konst(entry, value: 0)
	let start = b.bin(entry, op: ir.BinOp.binAdd, left: five, right: zero, fail: ir.noBlock)
	let entryTerm = b.b.jumpWith(header, args: ir.regs1(zero))
	b.b.terminate(entry, t: entryTerm)
	let i = b.param(header)
	let limit = b.konst(header, value: 3)
	let more = b.cmp(header, op: ir.CmpOp.cmpLt, left: i, right: limit)
	b.b.terminate(header, t: ir.newBranch(more, ifTrue: body, ifFalse: exit))
	let one = b.konst(body, value: 1)
	let isOne = b.cmp(body, op: ir.CmpOp.cmpEq, left: i, right: one)
	b.b.terminate(body, t: ir.newBranch(isOne, ifTrue: left, ifFalse: right))
	var leftArgs = ir.regs1(start)
	leftArgs.push(one)
	let leftTerm = b.b.jumpWith(join, args: leftArgs)
	b.b.terminate(left, t: leftTerm)
	var rightArgs = ir.regs1(start)
	rightArgs.push(i)
	let rightTerm = b.b.jumpWith(join, args: rightArgs)
	b.b.terminate(right, t: rightTerm)
	let same = b.param(join)
	_ = b.param(join)
	let next = b.bin(join, op: ir.BinOp.binAdd, left: i, right: same, fail: ir.noBlock)
	let joinTerm = b.b.jumpWith(header, args: ir.regs1(next))
	b.b.terminate(join, t: joinTerm)
	b.b.terminate(exit, t: ir.newRet(i))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  %1 = const 0")
	want.push("  %2 = const 5")
	want.push("  jump b1(%1)")
	want.push("b1(%3):")
	want.push("  %4 = const 3")
	want.push("  %5 = cmp.lt %3, %4")
	want.push("  branch %5, b2, b6")
	want.push("b2:")
	want.push("  %6 = const 1")
	want.push("  %7 = cmp.eq %3, %6")
	want.push("  branch %7, b3, b4")
	want.push("b3:")
	want.push("  jump b5")
	want.push("b4:")
	want.push("  jump b5")
	want.push("b5:")
	want.push("  %10 = add %3, %2")
	want.push("  jump b1(%10)")
	want.push("b6:")
	want.push("  ret %3")
	want.push("")
	foldRun("params", p: p, f: b.b.finish(), want: want, exit: 5)
end 'trivial and dead parameters go'

// A switch on a constant is a jump to the case it equals.
test 'a switch on a constant is a jump'
	var p = ir.irProject()
	var b = ir.BpFn.new(p)
	let entry = b.block()
	let first = b.block()
	let second = b.block()
	let other = b.block()
	let two = b.konst(entry, value: 2)
	var values = ir.WordList.create(0)
	values.push(1)
	values.push(2)
	var targets = ir.BlockIDList.create(0)
	targets.push(first)
	targets.push(second)
	let entryTerm = b.b.switch(two, values: values, targets: targets, def: other)
	b.b.terminate(entry, t: entryTerm)
	let ten = b.konst(first, value: 10)
	b.b.terminate(first, t: ir.newRet(ten))
	let twenty = b.konst(second, value: 20)
	b.b.terminate(second, t: ir.newRet(twenty))
	let thirty = b.konst(other, value: 30)
	b.b.terminate(other, t: ir.newRet(thirty))
	var want = ast.StringList.create(0)
	want.push("function main params 0")
	want.push("b0:")
	want.push("  jump b1")
	want.push("b1:")
	want.push("  %2 = const 20")
	want.push("  ret %2")
	want.push("")
	foldRun("switch", p: p, f: b.b.finish(), want: want, exit: 20)
end 'a switch on a constant is a jump'
