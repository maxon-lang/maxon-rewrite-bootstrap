// The float operations, on the 64 bits of a double that a register holds, as ir's evaluator computes them (ast's floats,
// exactly as the hardware does), since the interpreter is compiled with no floats of its own.

function execFBin(mutates vm Vm, x ir.Instr)
	vm.setNum(x.dst, n: ir.evalFBin(ir.fBinOp(x), a: vm.num(ir.fBinLeft(x)), b: vm.num(ir.fBinRight(x))))
end 'execFBin'

function execFCmp(mutates vm Vm, x ir.Instr)
	vm.setNum(x.dst, n: 1 if ir.evalFCmp(ir.fCmpOp(x), a: vm.num(ir.fCmpLeft(x)), b: vm.num(ir.fCmpRight(x))) else 0)
end 'execFCmp'

function execFUnary(mutates vm Vm, x ir.Instr)
	vm.setNum(x.dst, n: ir.evalFUnary(ir.fUnaryOp(x), a: vm.num(ir.fUnarySrc(x))))
end 'execFUnary'

function execIntToFloat(mutates vm Vm, x ir.Instr)
	vm.setNum(x.dst, n: ir.evalIntToFloat(vm.num(ir.intToFloatSrc(x)), unsigned: ir.intToFloatUnsigned(x)))
end 'execIntToFloat'
