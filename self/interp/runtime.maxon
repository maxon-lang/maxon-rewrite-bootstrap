// The entries are the primitives that the backend has no code for, and the ones it has, which the interpreter gives their meaning:
// an array, strings, byte arrays, a frozen value and a cown, and standard output. builtins_gen.maxon dispatches a call of an
// entry to the function of its name here.

let indexOutOfRangeMessage = "index out of range"

let missingKeyMessage = "map has no such key"

// argAt is the register of an entry's i-th argument.
function argAt(f ir.IrFunction, x ir.Instr, i Count) returns ir.Reg
	return f.args[try ir.callRuntimeArgsStart(x) + i otherwise panic("interp: an argument past the pool")]
end 'argAt'

function argNum(vm Vm, f ir.IrFunction, x ir.Instr, i Count) returns ir.Word
	return vm.num(argAt(f, x: x, i: i))
end 'argNum'

function argRef(vm Vm, f ir.IrFunction, x ir.Instr, i Count) returns Count
	return vm.ref(argAt(f, x: x, i: i))
end 'argRef'

// result is the register that gets what an entry gives, which must be one that the call receives.
function result(x ir.Instr) returns ir.Reg
	if x.dst == ir.noReg 'unreceived'
		panic("interp: {ir.rtSymbol(ir.callRuntimeSymbol(x))} gives a value that its call does not receive")
	end 'unreceived'
	return x.dst
end 'result'

function giveNum(mutates vm Vm, x ir.Instr, n ir.Word)
	vm.setNum(result(x), n: n)
end 'giveNum'

function giveRef(mutates vm Vm, x ir.Instr, o Count)
	vm.setRef(result(x), o: o)
end 'giveRef'

function giveFlag(mutates vm Vm, x ir.Instr, b bool)
	if b 'yes'
		giveNum(vm, x: x, n: 1)
	end 'yes' else 'no'
		giveNum(vm, x: x, n: 0)
	end 'no'
end 'giveFlag'

// giveCell gives the value that a place holds.
function giveCell(mutates vm Vm, x ir.Instr, c Count)
	copyToReg(vm, dst: result(x), c: c)
end 'giveCell'

// addressOf is the address of an element, valid until its structure changes.
function giveAddress(mutates vm Vm, x ir.Instr, c Count)
	let version = vm.h.oVersion[vm.h.cellHolder[c]]
	vm.setAddress(result(x), c: c, version: version)
end 'giveAddress'

// textIndex is where the contents of a string that must exist and be live are.
function textIndex(mutates vm Vm, o Count, what String) returns Count throws Halt
	let live = try live(vm, o: o, what: what)
	if vm.h.oKind[live] != kindString 'notString'
		panic("interp: {what} reads {objectText(vm, o: live)} as a string")
	end 'notString'
	return vm.h.oData[live]
end 'textIndex'

// collection is an object of a kind that an entry works on.
function collection(mutates vm Vm, o Count, kind Count, what String) returns Count throws Halt
	let live = try live(vm, o: o, what: what)
	if vm.h.oKind[live] != kind 'wrongKind'
		panic("interp: {what} expects a {kindName(kind)}, found {objectText(vm, o: live)}")
	end 'wrongKind'
	return live
end 'collection'

function entryWrite(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "a write")
	let handle = argNum(vm, f: f, x: x, i: 0)
	if handle == stdoutHandle 'stdout'
		vm.stdout.append(vm.h.texts[at].toByteArray())
	end 'stdout' else if handle == stderrHandle 'stderr'
		vm.stderr.append(vm.h.texts[at].toByteArray())
	end 'stderr' else 'unknown'
		panic("interp: write to handle {handle}")
	end 'unknown'
end 'entryWrite'

function entryPanic(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a panic message")
	let message = vm.h.texts[at].clone()
	throw trap(vm, message: message)
end 'entryPanic'

function entryPanicAt(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let place = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a panic location")
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "a panic message")
	let location = vm.h.texts[place].clone()
	let message = vm.h.texts[at].clone()
	throw trapAt(vm, location: location, message: message)
end 'entryPanicAt'

// strKnownSimple is the interpreter's answer to whether a string's ASCII bit is set, which the text operations it shares
// with the runtime ask (textops_gen.maxon): it keeps no bit, so it knows nothing, and those operations take their general
// paths, which give the same answers.
function strKnownSimple(text String) returns bool
	return false
end 'strKnownSimple'

// entryPanicEmptySlot traps with maxon's message of a lent read of an empty slot, as panicUnlessFilled's call says.
function entryPanicEmptySlot(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let place = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a panic location")
	let index = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let location = vm.h.texts[place].clone()
	throw trapAt(vm, location: location, message: ir.emptySlotMessage(index))
end 'entryPanicEmptySlot'

function entryConcat(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a concatenation")
	let b = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "a concatenation")
	let text = "{vm.h.texts[a]}{vm.h.texts[b]}"
	let made = newString(vm, text: text)
	giveRef(vm, x: x, o: made)
end 'entryConcat'

function entryItoa(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let made = newString(vm, text: decimalText(vm, f: f, x: x, at: 0))
	giveRef(vm, x: x, o: made)
end 'entryItoa'

// decimalText is the text of the word that an entry's argument at is, read as signed unless the argument after it says
// unsigned.
function decimalText(vm Vm, f ir.IrFunction, x ir.Instr, at Count) returns String
	let n = argNum(vm, f: f, x: x, i: at)
	if argNum(vm, f: f, x: x, i: try at + 1 otherwise panic("interp: an argument past a word")) != 0 'unsigned'
		return "{ir.bitsOfWord(n)}"
	end 'unsigned'
	return "{n}"
end 'decimalText'

function entryDecimalLength(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let text = decimalText(vm, f: f, x: x, at: 0)
	giveNum(vm, x: x, n: try text.byteLength() as ir.Word otherwise panic("interp: a text past a word"))
end 'entryDecimalLength'

// The entries of the String an interpolation builds, and of one it appends to, take the String they are given over and give
// it back with the text added, which the interpreter keeps in the same object: it has no buffer, so the room these make and
// the owned bit mean nothing to it. An extension is a new object, as a buffer the growth moved is, since a part after it may
// read the old text, and its release drops the old one, which the append moved out of its place.

function entryStrJoinRoom(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let made = newString(vm, text: "")
	giveRef(vm, x: x, o: made)
end 'entryStrJoinRoom'

// appendText adds text to the String object o and gives it back as the entry's value: a literal, which owns no buffer and is
// every copy of itself, is left as it is and the text given in a new object, as the native append copies its bytes.
function appendText(mutates vm Vm, x ir.Instr, o Count, text String) throws Halt
	let at = try textIndex(vm, o: o, what: "an interpolation")
	let joined = "{vm.h.texts[at]}{text}"
	if vm.h.oImmortal[o] 'literal'
		let made = newString(vm, text: joined)
		giveRef(vm, x: x, o: made)
		return
	end 'literal'
	vm.h.texts[at] = joined
	giveRef(vm, x: x, o: o)
end 'appendText'

function entryStrJoinPut(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let part = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "a part of an interpolation")
	let text = vm.h.texts[part].clone()
	try appendText(vm, x: x, o: argRef(vm, f: f, x: x, i: 0), text: text)
end 'entryStrJoinPut'

function entryStrJoinDigits(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let text = decimalText(vm, f: f, x: x, at: 1)
	try appendText(vm, x: x, o: argRef(vm, f: f, x: x, i: 0), text: text)
end 'entryStrJoinDigits'

// entryStrOwned is whether a String is no literal, which is the one String the interpreter has that owns no buffer.
function entryStrOwned(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = argRef(vm, f: f, x: x, i: 0)
	_ = try textIndex(vm, o: o, what: "an owned bit")
	giveFlag(vm, x: x, b: not vm.h.oImmortal[o])
end 'entryStrOwned'

// entryStrAscii is a String's ASCII bit, which the interpreter keeps none of, so it says nothing is known (strKnownSimple).
function entryStrAscii(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	_ = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "an ASCII bit")
	giveFlag(vm, x: x, b: false)
end 'entryStrAscii'

function entryStrExtend(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "an extended string")
	let made = newString(vm, text: vm.h.texts[at].clone())
	giveRef(vm, x: x, o: made)
end 'entryStrExtend'

function entryStrRelease(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let old = argRef(vm, f: f, x: x, i: 0)
	_ = try textIndex(vm, o: old, what: "an extended string")
	_ = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 2), what: "an extended string")
	if argNum(vm, f: f, x: x, i: 1) != 0 'owned'
		try drop(vm, o: old)
	end 'owned'
end 'entryStrRelease'

function entryStrAppend(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let part = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 2), what: "an appended string")
	let text = vm.h.texts[part].clone()
	try appendText(vm, x: x, o: argRef(vm, f: f, x: x, i: 0), text: text)
end 'entryStrAppend'

function entryFtoa(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let made = newString(vm, text: ast.floatText(ir.bitsOfWord(argNum(vm, f: f, x: x, i: 0))))
	giveRef(vm, x: x, o: made)
end 'entryFtoa'

function entryFtoaExact(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let made = newString(vm, text: ast.floatExactText(ir.bitsOfWord(argNum(vm, f: f, x: x, i: 0))))
	giveRef(vm, x: x, o: made)
end 'entryFtoaExact'

function entryStreq(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a comparison")
	let b = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "a comparison")
	giveFlag(vm, x: x, b: vm.h.texts[a] == vm.h.texts[b])
end 'entryStreq'

function entryStrLen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let n = try stringByteCount(vm, o: argRef(vm, f: f, x: x, i: 0))
	giveNum(vm, x: x, n: n)
end 'entryStrLen'

function entryStrByteAt(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a string byteAt")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	if i >= vm.h.texts[at].byteLength() 'outside'
		throw trap(vm, message: "string byte position out of bounds")
	end 'outside'
	giveNum(vm, x: x, n: vm.h.texts[at].byteAt(i) as ir.Word)
end 'entryStrByteAt'

// entryStrView gives a view of a String's bytes, whose bounds the lowering checked, as a String that no one owns and that
// is never freed, as a literal is: the interpreter has no bytes of one String that another can point into.
function entryStrView(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a string view")
	let start = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let stop = try start + ir.bitsOfWord(argNum(vm, f: f, x: x, i: 2)) otherwise panic("interp: a view past memory")
	let made = newString(vm, text: vm.h.texts[at].sliceBytes(start, endPos: stop).clone())
	vm.h.oImmortal[made] = true
	giveRef(vm, x: x, o: made)
end 'entryStrView'

// newShared makes a frozen value or a cown that owns a value the entry takes, with one owner: the reference it returns.
function newShared(mutates vm Vm, f ir.IrFunction, kind Count, src ir.Reg, what String) returns Count throws Halt
	let box = newSharedBox(vm, kind: kind)
	try store(vm, f: f, c: vm.h.field(box, i: 0), src: src, what: what)
	return box
end 'newShared'

// shared is a frozen value or a cown an entry works on.
function shared(mutates vm Vm, o Count, kind Count, what String) returns Count throws Halt
	let live = try live(vm, o: o, what: what)
	if vm.h.oKind[live] != kind 'wrongKind'
		panic("interp: {what} expects a {kindName(kind)}, found {objectText(vm, o: live)}")
	end 'wrongKind'
	return live
end 'shared'

function entryFrozenFreeze(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	vm.tracking = true
	let o = try newShared(vm, f: f, kind: kindFrozen, src: argAt(f, x: x, i: 0), what: "the freeze")
	giveRef(vm, x: x, o: o)
end 'entryFrozenFreeze'

function entryCownNew(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	vm.tracking = true
	let cown = try newShared(vm, f: f, kind: kindCown, src: argAt(f, x: x, i: 0), what: "the new cown")
	match consumes ir.callRuntimeRoutine(f, x: x) 'routine'
		some(routine) then vm.h.shareds[vm.h.oData[cown]].ending = functionOf(vm, id: routine)
		none then _ = 0
	end 'routine'
	giveRef(vm, x: x, o: cown)
end 'entryCownNew'

// functionOf is the index of the function that a declaration has IR for.
function functionOf(vm Vm, id ast.FuncID) returns Count
	return match consumes vm.prog.fnByFunc.get(id as Count) 'found'
		some(fi) gives fi
		none gives panic("interp: a function has no IR")
	end 'found'
end 'functionOf'

function entryFrozenGet(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindFrozen, what: "reading a frozen value")
	giveCell(vm, x: x, c: vm.h.field(o, i: 0))
end 'entryFrozenGet'

function entryShare(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try live(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a share")
	if not vm.h.isShared(o) 'notShared'
		panic("interp: a share of {objectText(vm, o: o)}, which is not a frozen value or a cown")
	end 'notShared'
	let at = vm.h.oData[o]
	vm.h.shareds[at].count = try vm.h.shareds[at].count + 1 otherwise panic("interp: a count past a word")
	giveRef(vm, x: x, o: o)
end 'entryShare'

// restructure is a change to the structure of a collection, which ends every address taken into it.
function restructure(mutates vm Vm, o Count) throws Halt
	try changed(vm, c: 0, o: o)
	let version = vm.h.nextVersion()
	vm.h.oVersion[o] = version
end 'restructure'

// moveIn puts an element that an entry takes in a new place of a collection, which becomes its owner.
function moveIn(mutates vm Vm, f ir.IrFunction, holder Count, src ir.Reg, what String) returns Count throws Halt
	let c = vm.h.elementPlace(holder)
	try store(vm, f: f, c: c, src: src, what: what)
	return c
end 'moveIn'

// moveOutOfCollection gives an element to the caller and empties its place.
function moveOutOfCollection(mutates vm Vm, x ir.Instr, c Count, what String) throws Halt
	giveCell(vm, x: x, c: c)
	_ = try release(vm, c: c, what: what)
end 'moveOutOfCollection'

function entryArrayNew(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let made = newArray(vm)
	giveRef(vm, x: x, o: made)
end 'entryArrayNew'

function entryArrayLen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let n = try arrayCount(vm, o: argRef(vm, f: f, x: x, i: 0))
	giveNum(vm, x: x, n: n)
end 'entryArrayLen'

// The collection operations are the common case of the entries that read a length or an element (self/opt/expand.maxon),
// each run here as its entry runs in range: the same objects, the same cells, the same checks.

// execLength reads the count of a collection: an array's or a byte array's elements, or a string's bytes.
function execLength(mutates vm Vm, x ir.Instr) throws Halt
	let o = vm.ref(ir.lengthSrc(x))
	let n = match ir.lengthOf(x) 'of'
		collectionArray gives try arrayCount(vm, o: o)
		collectionString gives try stringByteCount(vm, o: o)
	end 'of'
	vm.setNum(x.dst, n: n)
end 'execLength'

// arrayCount is the count of the elements of an array or a byte array, whose boxes have one layout.
function arrayCount(mutates vm Vm, o Count) returns ir.Word throws Halt
	let live = try live(vm, o: o, what: "a length")
	let data = vm.h.oData[live]
	if vm.h.oKind[live] == kindArray 'words'
		return try vm.h.elements[data].count() as ir.Word otherwise panic("interp: an array past a word")
	end 'words'
	if vm.h.oKind[live] == kindBytes 'bytes'
		return try vm.h.buffers[data].count() as ir.Word otherwise panic("interp: a buffer past a word")
	end 'bytes'
	panic("interp: a length of an array reads {objectText(vm, o: live)}")
end 'arrayCount'

function stringByteCount(mutates vm Vm, o Count) returns ir.Word throws Halt
	let at = try textIndex(vm, o: o, what: "a string byteLength")
	return try vm.h.texts[at].byteLength() as ir.Word otherwise panic("interp: a string past a word")
end 'stringByteCount'

function execBounds(mutates vm Vm, x ir.Instr)
	if not ir.evalBounds(vm.num(ir.boundsIndex(x)), b: vm.num(ir.boundsLength(x))) 'failed'
		vm.failTo = ir.boundsFail(x) as ir.Word
	end 'failed'
end 'execBounds'

// provenOutside is the violation of an access that no check guards, because the checker proved its index in range, at an
// index that is not: so the proof is wrong.
function provenOutside(mutates vm Vm, what String, index Count, count Count) returns Halt
	return violation(vm, kind: provenAccess, message: "{what} at index {index}, count {count}: the access has no check, and the checker's proof that the index is in range is wrong")
end 'provenOutside'

// outsideAccess is what an entry that reads or moves out an element does at an index past the end: the violation of a
// proof that is wrong, for a call the checker proved (ir.callRuntimeProven), and the entry's trap otherwise.
function outsideAccess(mutates vm Vm, x ir.Instr, what String, index Count, count Count) returns Halt
	if ir.callRuntimeProven(x) 'proven'
		return provenOutside(vm, what: what, index: index, count: count)
	end 'proven'
	return trap(vm, message: indexOutOfRangeMessage)
end 'outsideAccess'

// requireFilledCell goes on when the cell of an element that a read takes to be filled holds one: the read has no test for
// an empty slot, since no slot below the count of an array of its type is empty, so a cell that holds nothing is that
// invariant broken.
function requireFilledCell(mutates vm Vm, c Count, what String) throws Halt
	if vm.h.cellR[c] == 0 'empty'
		throw violation(vm, kind: emptySlotRead, message: "{what} finds its slot empty: the read has no test, since no slot below an array's count is empty, and something emptied this one")
	end 'empty'
end 'requireFilledCell'

// elementCell is the place of the element at an index of an array of words, which a Bounds or the checker has checked: an
// index past the end here is a proof that was wrong.
function elementCell(mutates vm Vm, arr ir.Reg, index ir.Reg, what String) returns Count throws Halt
	let a = try collection(vm, o: vm.ref(arr), kind: kindArray, what: what)
	let i = ir.bitsOfWord(vm.num(index))
	let data = vm.h.oData[a]
	if i >= vm.h.elements[data].count() 'outside'
		throw provenOutside(vm, what: what, index: i, count: vm.h.elements[data].count())
	end 'outside'
	return vm.h.elements[data][i]
end 'elementCell'

// execElemAddr gives the address of an element, as entryArrayElem does in range, or of a byte of a byte array, as
// entryBytesElem does.
function execElemAddr(mutates vm Vm, x ir.Instr) throws Halt
	let o = vm.ref(ir.elemAddrArr(x))
	if vm.h.oKind[o] == kindBytes 'byte'
		let b = try collection(vm, o: o, kind: kindBytes, what: "a byte address")
		let i = ir.bitsOfWord(vm.num(ir.elemAddrIndex(x)))
		if i >= vm.h.buffers[vm.h.oData[b]].count() 'outside'
			panic("interp: a byte address at an index that no check let through")
		end 'outside'
		let c = byteCell(vm, b: b, i: i)
		giveAddress(vm, x: x, c: c)
		return
	end 'byte'
	let c = try elementCell(vm, arr: ir.elemAddrArr(x), index: ir.elemAddrIndex(x), what: "an element address")
	giveAddress(vm, x: x, c: c)
end 'execElemAddr'

// byteCell is a cell that stands for the byte at index i of the byte array b, which a place of a byte-sized type lent by
// address is (ir.lentInByte): held by b, so that a change of b's structure makes its address stale, and naming the byte by
// its index, which LoadByteAt and StoreByteAt read and write. A byte has the one cell, made the first time its address is
// taken, so that two addresses of a byte are one place.
function byteCell(mutates vm Vm, b Count, i Count) returns Count
	let data = vm.h.oData[b]
	while vm.h.byteCells[data].count() <= i 'grow'
		vm.h.byteCells[data].push(0)
	end 'grow'
	if vm.h.byteCells[data][i] == 0 'first'
		let c = vm.h.newCell(b)
		vm.h.cellIndex[c] = i
		vm.h.byteCells[data][i] = c
	end 'first'
	return vm.h.byteCells[data][i]
end 'byteCell'

// execElemLoad reads an element, as a LoadAt reads through the address that ElemAddr gives.
function execElemLoad(mutates vm Vm, x ir.Instr) throws Halt
	let what = "a read of an element"
	let c = try elementCell(vm, arr: ir.elemLoadArr(x), index: ir.elemLoadIndex(x), what: what)
	if ir.elemLoadFilled(x) 'filled'
		try requireFilledCell(vm, c: c, what: "{what} at index {ir.bitsOfWord(vm.num(ir.elemLoadIndex(x)))}")
	end 'filled'
	if vm.tracking 'tracking'
		try requireReachableCell(vm, c: c, what: what)
	end 'tracking'
	copyToReg(vm, dst: x.dst, c: c)
end 'execElemLoad'

// execLoadByte reads a byte of a byte array or of a string, as entryBytesGet and entryStrByteAt do in range.
function execLoadByte(mutates vm Vm, x ir.Instr) throws Halt
	let o = vm.ref(ir.loadByteSrc(x))
	let i = ir.bitsOfWord(vm.num(ir.loadByteIndex(x)))
	let byte = match ir.loadByteOf(x) 'of'
		collectionArray gives try bufferByte(vm, o: o, i: i)
		collectionString gives try textByte(vm, o: o, i: i)
	end 'of'
	vm.setNum(x.dst, n: byte as ir.Word)
end 'execLoadByte'

function bufferByte(mutates vm Vm, o Count, i Count) returns Byte throws Halt
	let b = try collection(vm, o: o, kind: kindBytes, what: "a byte read")
	let data = vm.h.oData[b]
	if i >= vm.h.buffers[data].count() 'outside'
		throw provenOutside(vm, what: "a byte read", index: i, count: vm.h.buffers[data].count())
	end 'outside'
	return vm.h.buffers[data][i]
end 'bufferByte'

function textByte(mutates vm Vm, o Count, i Count) returns Byte throws Halt
	let at = try textIndex(vm, o: o, what: "a string byteAt")
	if i >= vm.h.texts[at].byteLength() 'outside'
		throw provenOutside(vm, what: "a string byte read", index: i, count: vm.h.texts[at].byteLength())
	end 'outside'
	return vm.h.texts[at].byteAt(i)
end 'textByte'

function entryArrayElem(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "an element address")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if i >= vm.h.elements[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	let element = vm.h.elements[data][i]
	giveAddress(vm, x: x, c: element)
end 'entryArrayElem'

function entryArrayInsert(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "an insert")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if i > vm.h.elements[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	let e = try moveIn(vm, f: f, holder: a, src: argAt(f, x: x, i: 2), what: "the insert")
	try restructure(vm, o: a)
	vm.h.elements[data].insert(i, value: e)
end 'entryArrayInsert'

function entryArrayRemove(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "a remove")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if i >= vm.h.elements[data].count() 'outside'
		throw outsideAccess(vm, x: x, what: "a remove", index: i, count: vm.h.elements[data].count())
	end 'outside'
	try restructure(vm, o: a)
	let e = try vm.h.elements[data].remove(i) otherwise panic("interp: an element that was there is gone")
	try moveOutOfCollection(vm, x: x, c: e, what: "the remove")
	vm.h.givePlaceUp(a, c: e)
end 'entryArrayRemove'

// entryArrayPop moves the last element out, which the code checked there is, or the checker proved.
function entryArrayPop(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "a pop")
	let data = vm.h.oData[a]
	if vm.h.elements[data].count() == 0 'empty'
		throw outsideAccess(vm, x: x, what: "a pop", index: 0, count: 0)
	end 'empty'
	try restructure(vm, o: a)
	let e = try vm.h.elements[data].pop() otherwise panic("interp: an element that was there is gone")
	try moveOutOfCollection(vm, x: x, c: e, what: "the pop")
	vm.h.givePlaceUp(a, c: e)
end 'entryArrayPop'

// The entries of an array of strings: its model is an array's, a cell to an element, which the code moves a String in and
// out of through the address of the cell.
function entryStrsElem(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	try entryArrayElem(vm, f: f, x: x)
end 'entryStrsElem'

// entryStrsOpen puts an empty cell at an index, which may be the length, and gives its address.
function entryStrsOpen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "an insert")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if i > vm.h.elements[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	try restructure(vm, o: a)
	let e = vm.h.elementPlace(a)
	vm.h.elements[data].insert(i, value: e)
	giveAddress(vm, x: x, c: e)
end 'entryStrsOpen'

// entryStrsClose takes out the cell at an index, which the code moved the String out of.
function entryStrsClose(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "a remove")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if i >= vm.h.elements[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	try restructure(vm, o: a)
	let e = try vm.h.elements[data].remove(i) otherwise panic("interp: an element that was there is gone")
	if vm.h.refOf(e) != 0 'held'
		throw violation(vm, kind: movedUse, message: "a close of an element of an array of strings that still holds its String")
	end 'held'
	vm.h.givePlaceUp(a, c: e)
end 'entryStrsClose'

// entryStrsFill appends count empty cells.
function entryStrsFill(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "a fill")
	let count = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	try restructure(vm, o: a)
	for _ in 0 upto count 'cells'
		let cell = vm.h.elementPlace(a)
		vm.h.elements[data].push(cell)
	end 'cells'
end 'entryStrsFill'

function entryStrsReserve(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	try entryArrayReserve(vm, f: f, x: x)
end 'entryStrsReserve'

// The entries of an array of records held in place: its model is an array's, a cell to an element, which owns a box of the
// element's words; an address of the element is that box, whose words the code copies in and out.
function entryRecsElem(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "an element address")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if i >= vm.h.elements[data].count() 'outside'
		throw outsideAccess(vm, x: x, what: "an element address", index: i, count: vm.h.elements[data].count())
	end 'outside'
	let element = vm.h.elements[data][i]
	giveCell(vm, x: x, c: element)
end 'entryRecsElem'

// entryRecsOpen puts a cell at an index, which may be the length, that owns a new box of the element's words, 0, and gives
// the box.
function entryRecsOpen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "an insert")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let words = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 2)) / ir.wordBytes
	let data = vm.h.oData[a]
	if i > vm.h.elements[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	try restructure(vm, o: a)
	let e = vm.h.elementPlace(a)
	let box = newBox(vm, words: words)
	try adopt(vm, c: e, o: box, what: "the insert")
	vm.h.elements[data].insert(i, value: e)
	giveCell(vm, x: x, c: e)
end 'entryRecsOpen'

// entryRecsClose takes out the cell at an index, whose words the code copied out, and frees its box.
function entryRecsClose(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "a remove")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if i >= vm.h.elements[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	try restructure(vm, o: a)
	let e = try vm.h.elements[data].remove(i) otherwise panic("interp: an element that was there is gone")
	try dropCell(vm, c: e)
	vm.h.givePlaceUp(a, c: e)
end 'entryRecsClose'

function entryRecsReserve(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	try entryArrayReserve(vm, f: f, x: x)
end 'entryRecsReserve'

// entryRecsShrink sets the length of an array of records held in place, freeing the boxes of the elements above it, which
// need no drop.
function entryRecsShrink(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "a shrink")
	let keep = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	let count = vm.h.elements[data].count()
	if keep > count 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	if keep < count 'shorter'
		try restructure(vm, o: a)
		for i in keep upto count 'above'
			let element = vm.h.elements[data][i]
			try dropCell(vm, c: element)
			vm.h.givePlaceUp(a, c: element)
		end 'above'
		vm.h.elements[data].truncate(keep)
	end 'shorter'
end 'entryRecsShrink'

// entryArrayFill appends count copies of a word, each in a place of its own as an insert's element is.
function entryArrayFill(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "a fill")
	let count = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	try restructure(vm, o: a)
	for _ in 0 upto count 'words'
		let e = try moveIn(vm, f: f, holder: a, src: argAt(f, x: x, i: 2), what: "the fill")
		vm.h.elements[data].push(e)
	end 'words'
end 'entryArrayFill'

// entryArrayReserve changes nothing the interpreter's model of an array has: a buffer's capacity is no part of it.
// entryArrayCapacity is the native runtime's buffer, which the interpreter does not model: an array here is its elements.
function entryArrayCapacity(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw unmodelled(vm, what: "an array's capacity is the native runtime's buffer, which the interpreter does not model")
end 'entryArrayCapacity'

function entryArrayReserve(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try live(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a reserve")
	_ = try collection(vm, o: a, kind: kindArray, what: "a reserve")
end 'entryArrayReserve'

// entryBytesReserve is entryArrayReserve of a byte array.
function entryBytesReserve(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try live(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a reserve")
	_ = try collection(vm, o: a, kind: kindBytes, what: "a reserve")
end 'entryBytesReserve'

// entryArrayShrink sets the length of an array or a byte array. The elements above it were dropped in place by the code
// before it or hold no value that is owned, which a lowering that left one would show as a leak at the end of the run.
function entryArrayShrink(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let a = try live(vm, o: argRef(vm, f: f, x: x, i: 0), what: "a shrink")
	let keep = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[a]
	if vm.h.oKind[a] == kindBytes 'bytes'
		if keep > vm.h.buffers[data].count() 'outside'
			throw trap(vm, message: indexOutOfRangeMessage)
		end 'outside'
		if keep < vm.h.buffers[data].count() 'shorter'
			try restructure(vm, o: a)
			vm.h.buffers[data].truncate(keep)
		end 'shorter'
		return
	end 'bytes'
	let array = try collection(vm, o: a, kind: kindArray, what: "a shrink")
	let count = vm.h.elements[data].count()
	if keep > count 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	if keep < count 'shorter'
		try restructure(vm, o: array)
		for i in keep upto count 'above'
			if vm.h.refOf(vm.h.elements[data][i]) != 0 'owns'
				panic("interp: a shrink leaves element {i} owning a value")
			end 'owns'
			let element = vm.h.elements[data][i]
			vm.h.givePlaceUp(array, c: element)
		end 'above'
		vm.h.elements[data].truncate(keep)
	end 'shorter'
end 'entryArrayShrink'

function entryBytesNew(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let made = newBytes(vm, buf: ByteArray.create(0))
	giveRef(vm, x: x, o: made)
end 'entryBytesNew'

function entryBytesLen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let n = try arrayCount(vm, o: argRef(vm, f: f, x: x, i: 0))
	giveNum(vm, x: x, n: n)
end 'entryBytesLen'

function entryBytesGet(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "a byte read")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[b]
	if i >= vm.h.buffers[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	giveNum(vm, x: x, n: vm.h.buffers[data][i] as ir.Word)
end 'entryBytesGet'

function entryBytesElem(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "a byte address")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	if i >= vm.h.buffers[vm.h.oData[b]].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	let c = byteCell(vm, b: b, i: i)
	giveAddress(vm, x: x, c: c)
end 'entryBytesElem'

// lowByte is the byte a word holds in its low 8 bits.
function lowByte(n ir.Word) returns Byte
	return (ir.bitsOfWord(n) and 255) as Byte
end 'lowByte'

function entryBytesSet(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "a byte write")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[b]
	if i >= vm.h.buffers[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	try restructure(vm, o: b)
	vm.h.buffers[data][i] = lowByte(argNum(vm, f: f, x: x, i: 2))
end 'entryBytesSet'

function entryBytesInsert(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "an insert")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[b]
	if i > vm.h.buffers[data].count() 'outside'
		throw trap(vm, message: indexOutOfRangeMessage)
	end 'outside'
	try restructure(vm, o: b)
	vm.h.buffers[data].insert(i, value: lowByte(argNum(vm, f: f, x: x, i: 2)))
end 'entryBytesInsert'

function entryBytesRemove(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "a remove")
	let i = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let data = vm.h.oData[b]
	if i >= vm.h.buffers[data].count() 'outside'
		throw outsideAccess(vm, x: x, what: "a byte remove", index: i, count: vm.h.buffers[data].count())
	end 'outside'
	try restructure(vm, o: b)
	let removed = try vm.h.buffers[data].remove(i) otherwise panic("interp: a byte that was there is gone")
	giveNum(vm, x: x, n: removed as ir.Word)
end 'entryBytesRemove'

function entryBytesAppend(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "an append")
	let other = try collection(vm, o: argRef(vm, f: f, x: x, i: 1), kind: kindBytes, what: "an append source")
	try restructure(vm, o: b)
	let from = vm.h.buffers[vm.h.oData[other]].clone()
	vm.h.buffers[vm.h.oData[b]].append(from)
end 'entryBytesAppend'

function entryBytesAppendStr(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "an appendString")
	let at = try textIndex(vm, o: argRef(vm, f: f, x: x, i: 1), what: "an appendString source")
	try restructure(vm, o: b)
	let from = vm.h.texts[at].toByteArray()
	vm.h.buffers[vm.h.oData[b]].append(from)
end 'entryBytesAppendStr'

function entryBytesToString(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let b = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindBytes, what: "a toString")
	let text = String.from(vm.h.buffers[vm.h.oData[b]])
	let made = newString(vm, text: text)
	giveRef(vm, x: x, o: made)
end 'entryBytesToString'

// copyObject is a deep copy of an object: a new object for each one inside it, in the same order. A string literal is never
// freed, so it is shared.
function copyObject(mutates vm Vm, o Count) returns Count throws Halt
	try requireLive(vm, o: o, what: "copied")
	let kind = vm.h.oKind[o]
	let data = vm.h.oData[o]
	if vm.h.isShared(o) 'shared'
		// The copy of a shared value is another owner of it.
		vm.h.shareds[data].count = try vm.h.shareds[data].count + 1 otherwise panic("interp: a count past a word")
		return o
	end 'shared'
	if kind == kindNone 'none'
		return o
	end 'none'
	if kind == kindString 'string'
		if vm.h.oImmortal[o] 'immortal'
			return o
		end 'immortal'
		return newString(vm, text: vm.h.texts[data].clone())
	end 'string'
	if kind == kindBytes 'bytes'
		return newBytes(vm, buf: vm.h.buffers[data].clone())
	end 'bytes'
	if kind == kindBox 'box'
		let size = vm.h.oSize[o]
		let out = newBox(vm, words: size)
		// A frame area lends every element of its tuple, whose copy owns a copy of each, as the tuple's copy routine makes.
		let owns = vm.h.oFrameArea[o]
		for i in 0 upto size 'fields'
			let source = vm.h.field(o, i: i)
			let ref = vm.h.refOf(source)
			if owns and ref != 0 'element'
				let copy = try copyObject(vm, o: ref)
				try adopt(vm, c: vm.h.field(out, i: i), o: copy, what: "the copy")
				continue 'fields'
			end 'element'
			try copyCell(vm, dst: vm.h.field(out, i: i), source: source)
		end 'fields'
		return out
	end 'box'
	if kind == kindArray 'array'
		let out = newArray(vm)
		for i in 0 upto vm.h.elements[data].count() 'elements'
			let dst = vm.h.newCell(out)
			let source = vm.h.elements[data][i]
			try copyCell(vm, dst: dst, source: source)
			vm.h.elements[vm.h.oData[out]].push(dst)
		end 'elements'
		return out
	end 'array'
	panic("interp: cannot copy {objectText(vm, o: o)}")
end 'copyObject'

// copyCell fills a new place with a copy of what another place holds: a scalar as it is, an object as a new one that the place
// owns.
function copyCell(mutates vm Vm, dst Count, source Count) throws Halt
	let ref = vm.h.refOf(source)
	if ref == 0 or vm.h.cellLent[source] 'word'
		vm.h.cellN[dst] = vm.h.cellN[source]
		vm.h.cellR[dst] = vm.h.cellR[source]
		vm.h.cellLent[dst] = vm.h.cellLent[source]
		return
	end 'word'
	let copy = try copyObject(vm, o: ref)
	try adopt(vm, c: dst, o: copy, what: "the copy")
end 'copyCell'
