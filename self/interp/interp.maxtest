let seedsToTry = 30 as Count

// holdsItAWhile is how many instructions main runs while it owns what a behaviour reads.
let holdsItAWhile = 200 as Count

// Fn builds the IR of one function the way the Go tests' builder does: in one block, with registers and slots made as they are
// asked for.
type Fn
	var b as ir.Builder
	var cur as ir.BlockID
	var decl as ast.FuncID
	var stringTy as ast.TypeID

	static function new(mutates p ast.Project, name String, convs ir.ConvList) returns Fn
		let decl = ir.interpFunction(p, name: name, convs: convs)
		var b = ir.Builder.new()
		b.start(decl, name: "", paramCount: convs.count())
		let cur = b.newBlock()
		return Fn{b: b, cur: cur, decl: decl, stringTy: p.builtins.stringTy}
	end 'new'

	function reg(mutates self, kind ir.IrKind) returns ir.Reg
		return b.f.newReg(kind)
	end 'reg'

	function emit(mutates self, consumes i ir.Instr)
		b.emit(cur, i: i)
	end 'emit'

	function konst(mutates self, n ir.Word) returns ir.Reg
		let d = self.reg(ir.IrKind.kindScalar)
		self.emit(ir.newConst(d, value: n))
		return d
	end 'konst'

	function alloc(mutates self, words Count) returns ir.Reg
		let d = self.reg(ir.IrKind.kindManaged)
		self.emit(ir.newAlloc(d, bytes: try words * 8 otherwise panic("a box past memory")))
		return d
	end 'alloc'

	function slot(mutates self, kind ir.IrKind) returns Count
		return b.f.newSlot(kind)
	end 'slot'

	function param(mutates self, i Count, kind ir.IrKind) returns ir.Reg
		let d = self.reg(kind)
		self.emit(ir.newLoadParam(d, param: i))
		return d
	end 'param'

	function load(mutates self, slot Count) returns ir.Reg
		let kind = b.f.slots[slot]
		let d = self.reg(kind)
		self.emit(ir.newLoadSlot(d, slot: slot))
		return d
	end 'load'

	function addr(mutates self, slot Count) returns ir.Reg
		let d = self.reg(ir.IrKind.kindScalar)
		self.emit(ir.newSlotAddr(d, slot: slot))
		return d
	end 'addr'

	function store(mutates self, slot Count, v ir.Reg)
		self.emit(ir.newStoreSlot(slot, src: v, borrow: false))
	end 'store'

	function runtime(mutates self, symbol ir.Rt, kind ir.IrKind, args ir.RegList) returns ir.Reg
		let d = self.reg(kind)
		let i = b.callRuntime(d, symbol: symbol, args: args, routine: ast.noFunc, proven: false)
		self.emit(i)
		return d
	end 'runtime'

	function call(mutates self, target ast.FuncID, args ir.RegList)
		let i = b.call(ir.noReg, target: target, args: args, sig: ir.FloatSignature.words())
		self.emit(i)
	end 'call'

	function drop(mutates self, v ir.Reg)
		let i = b.drop(v, ty: stringTy)
		self.emit(i)
	end 'drop'

	function dropSlot(mutates self, slot Count)
		let i = b.dropSlot(slot, ty: stringTy)
		self.emit(i)
	end 'dropSlot'

	function text(mutates self, s String) returns ir.Reg
		let d = self.reg(ir.IrKind.kindManaged)
		let i = b.str(d, text: s.clone())
		self.emit(i)
		return d
	end 'text'

	function write(mutates self, s String)
		let handle = self.reg(ir.IrKind.kindScalar)
		self.emit(ir.newLoadGlobal(handle, symbol: ir.Rt.rtStdout))
		let word = self.text(s)
		let i = b.callRuntime(ir.noReg, symbol: ir.Rt.rtWrite, args: ir.regs2(handle, b: word), routine: ast.noFunc, proven: false)
		self.emit(i)
	end 'write'

	// cown makes a cown that owns a new box, and gives the register that holds the reference.
	function cown(mutates self, words Count) returns ir.Reg
		let box = self.alloc(words)
		return self.runtime(ir.Rt.rtCownNew, kind: ir.IrKind.kindManaged, args: ir.regs1(box))
	end 'cown'

	function schedule(mutates self, consumes body ir.IrFunction, cowns ir.RegList, captures ir.RegList)
		let at = b.body(body)
		let i = b.whenInstr(at, cowns: cowns, captures: captures)
		self.emit(i)
	end 'schedule'

	function ret(mutates self, v ir.Reg) returns ir.IrFunction
		b.terminate(cur, t: ir.newRet(v))
		return b.finish()
	end 'ret'
end 'Fn'

function regs3(a ir.Reg, b ir.Reg, c ir.Reg) returns ir.RegList
	var out = ir.regs2(a, b: b)
	out.push(c)
	return out
end 'regs3'

function convs1(a ast.Convention) returns ir.ConvList
	var out = ir.ConvList.create(0)
	out.push(a)
	return out
end 'convs1'

function convs2(a ast.Convention, b ast.Convention) returns ir.ConvList
	var out = convs1(a)
	out.push(b)
	return out
end 'convs2'

// runWith executes main with the other functions available, under the schedule of a seed.
function runWith(p ast.Project, main ir.IrFunction, others ir.IrFunctionList, seed ir.Word) returns Outcome
	var fns = ir.IrFunctionList.create(0)
	fns.push(main.clone())
	for i in 0 upto others.count() 'others'
		fns.push(others[i].clone())
	end 'others'
	var modules = ModuleFunctions.create(0)
	modules.push(fns)
	return run(p, modules: modules, entry: main.decl, stepLimit: defaultStepLimit, seed: seed, wantFrees: false, stdin: "")
end 'runWith'

function runMain(p ast.Project, main ir.IrFunction) returns Outcome
	return runWith(p, main: main, others: ir.IrFunctionList.create(0), seed: 0)
end 'runMain'

function runAlone(p ast.Project, main ir.IrFunction, other ir.IrFunction) returns Outcome
	var others = ir.IrFunctionList.create(0)
	others.push(other.clone())
	return runWith(p, main: main, others: others, seed: 0)
end 'runAlone'

function runSeed(p ast.Project, main ir.IrFunction, seed ir.Word) returns Outcome
	return runWith(p, main: main, others: ir.IrFunctionList.create(0), seed: seed)
end 'runSeed'

function expectViolation(label String, out Outcome, kind String, fragments ast.StringList)
	if out.violations.count() == 0 'none'
		panic("{label}: no violation; wanted {kind}")
	end 'none'
	let v = out.violations[0].clone()
	if not table.contains(v, fragment: "memory-model violation: {kind} in") 'kind'
		panic("{label}: wanted {kind}:\n{v}")
	end 'kind'
	for i in 0 upto fragments.count() 'fragments'
		if not table.contains(v, fragment: fragments[i]) 'lacks'
			panic("{label}: the report lacks '{fragments[i]}':\n{v}")
		end 'lacks'
	end 'fragments'
end 'expectViolation'

function says(a String, b String, c String, d String) returns ast.StringList
	var out = ast.StringList.create(0)
	if a != "" 'a'
		out.push(a.clone())
	end 'a'
	if b != "" 'b'
		out.push(b.clone())
	end 'b'
	if c != "" 'c'
		out.push(c.clone())
	end 'c'
	if d != "" 'd'
		out.push(d.clone())
	end 'd'
	return out
end 'says'

function expectClean(label String, out Outcome, exit ir.Word)
	if out.violations.count() != 0 or out.exitCode != exit 'unclean'
		panic("{label}: exit {out.exitCode}, {out.violations.count()} violations, {out.stdout}")
	end 'unclean'
end 'expectClean'

test 'a clean program has no violation'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let boxs = b.alloc(2)
	b.store(s, v: boxs)
	b.dropSlot(s)
	let seven = b.konst(7)
	expectClean("clean", out: runMain(p, main: b.ret(seven)), exit: 7)
end 'a clean program has no violation'

test 'use after free'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	b.drop(box)
	let d = b.reg(ir.IrKind.kindScalar)
	b.emit(ir.newLoadField(d, obj: box, offset: 0))
	let zero = b.konst(0)
	expectViolation("use after free", out: runMain(p, main: b.ret(zero)), kind: "use after free", fragments: says("function main", b: "block b0", c: "instruction #2", d: "freed at main b0 #1"))
end 'use after free'

test 'double free'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	b.drop(box)
	b.drop(box)
	let zero = b.konst(0)
	expectViolation("double free", out: runMain(p, main: b.ret(zero)), kind: "double free", fragments: says("instruction #2", b: "", c: "", d: ""))
end 'double free'

test 'freeing an owner frees what it owns once and never twice'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let outer = b.alloc(1)
	let inner = b.alloc(1)
	b.emit(ir.newStoreField(outer, offset: 0, src: inner, borrow: false))
	b.drop(outer)
	b.drop(inner)
	let zero = b.konst(0)
	expectViolation("owner", out: runMain(p, main: b.ret(zero)), kind: "double free", fragments: says("", b: "", c: "", d: ""))
end 'freeing an owner frees what it owns once and never twice'

test 'leak at the end of the program'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	_ = b.alloc(1)
	let zero = b.konst(0)
	expectViolation("leak", out: runMain(p, main: b.ret(zero)), kind: "leak", fragments: says("still live at the end of the program", b: "made in main b0 #0", c: "", d: ""))
end 'leak at the end of the program'

test 'a slot that still owns when the function returns'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let boxs = b.alloc(1)
	b.store(s, v: boxs)
	let zero = b.konst(0)
	expectViolation("slot", out: runMain(p, main: b.ret(zero)), kind: "leak", fragments: says("slot s0 still owns", b: "", c: "", d: ""))
end 'a slot that still owns when the function returns'

test 'using a moved value through its old owner'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let boxs = b.alloc(1)
	b.store(s, v: boxs)
	let moved = b.reg(ir.IrKind.kindManaged)
	b.emit(ir.newMoveSlot(moved, slot: s))
	b.drop(moved)
	_ = b.load(s)
	let zero = b.konst(0)
	expectViolation("moved", out: runMain(p, main: b.ret(zero)), kind: "use of a moved value", fragments: says("moved out or never assigned", b: "", c: "", d: ""))
end 'using a moved value through its old owner'

test 'a value with two owners'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let u = b.slot(ir.IrKind.kindManaged)
	let box = b.alloc(1)
	b.store(s, v: box)
	b.store(u, v: box)
	let zero = b.konst(0)
	expectViolation("two owners", out: runMain(p, main: b.ret(zero)), kind: "ownership", fragments: says("still owns it", b: "must be moved first", c: "", d: ""))
end 'a value with two owners'

test 'overwriting an owned value without dropping it'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let first = b.alloc(1)
	b.store(s, v: first)
	let second = b.alloc(1)
	b.store(s, v: second)
	let zero = b.konst(0)
	expectViolation("overwrite", out: runMain(p, main: b.ret(zero)), kind: "leak", fragments: says("lost without being dropped", b: "", c: "", d: ""))
end 'overwriting an owned value without dropping it'

test 'returning a value that another owner holds'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let box = b.alloc(1)
	b.store(s, v: box)
	expectViolation("return", out: runMain(p, main: b.ret(box)), kind: "ownership", fragments: says("still owns", b: "", c: "", d: ""))
end 'returning a value that another owner holds'

// Two arguments reach the same record, and one of them is passed mutable: the callee would reach one place through two names.
test 'overlapping arguments at a call'
	var p = ir.irProject()
	var callee = Fn.new(p, name: "touch", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convLet))
	let calleeZero = callee.konst(0)
	let calleeFn = callee.ret(calleeZero)
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let boxs = b.alloc(1)
	b.store(s, v: boxs)
	let address = b.addr(s)
	let value = b.load(s)
	b.call(callee.decl, args: ir.regs2(address, b: value))
	b.dropSlot(s)
	let zero = b.konst(0)
	expectViolation("overlap", out: runAlone(p, main: b.ret(zero), other: calleeFn), kind: "exclusivity", fragments: says("arguments 0 and 1 of the call to touch", b: "", c: "", d: ""))
end 'overlapping arguments at a call'

test 'disjoint arguments at a call are fine'
	var p = ir.irProject()
	var callee = Fn.new(p, name: "touch", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convLet))
	let calleeZero = callee.konst(0)
	let calleeFn = callee.ret(calleeZero)
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let u = b.slot(ir.IrKind.kindManaged)
	let first = b.alloc(1)
	b.store(s, v: first)
	let second = b.alloc(1)
	b.store(u, v: second)
	let address = b.addr(s)
	let value = b.load(u)
	b.call(callee.decl, args: ir.regs2(address, b: value))
	b.dropSlot(s)
	b.dropSlot(u)
	let zero = b.konst(0)
	expectClean("disjoint", out: runAlone(p, main: b.ret(zero), other: calleeFn), exit: 0)
end 'disjoint arguments at a call are fine'

// A borrow is taken when its argument is evaluated and used when the call runs. Changing what it borrows in between leaves it
// pointing at what moved.
test 'changing what an argument borrows before the call runs'
	var p = ir.irProject()
	var callee = Fn.new(p, name: "look", convs: convs2(ast.Convention.convLet, b: ast.Convention.convLet))
	let calleeZero = callee.konst(0)
	let calleeFn = callee.ret(calleeZero)
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let box = b.alloc(1)
	b.store(s, v: box)
	let first = b.load(s)
	let three = b.konst(3)
	b.emit(ir.newStoreField(box, offset: 0, src: three, borrow: false))
	let zeroArg = b.konst(0)
	b.call(callee.decl, args: ir.regs2(first, b: zeroArg))
	b.dropSlot(s)
	let zero = b.konst(0)
	expectViolation("borrow", out: runAlone(p, main: b.ret(zero), other: calleeFn), kind: "exclusivity", fragments: says("still waiting to use", b: "", c: "", d: ""))
end 'changing what an argument borrows before the call runs'

test 'an address is stale once the array changes'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let s = b.slot(ir.IrKind.kindManaged)
	let a = b.runtime(ir.Rt.rtArrayNew, kind: ir.IrKind.kindManaged, args: ir.RegList.create(0))
	b.store(s, v: a)
	let zero0 = b.konst(0)
	let one = b.konst(1)
	_ = b.runtime(ir.Rt.rtArrayInsert, kind: ir.IrKind.kindScalar, args: regs3(a, b: zero0, c: one))
	let zero1 = b.konst(0)
	let element = b.runtime(ir.Rt.rtArrayElem, kind: ir.IrKind.kindScalar, args: ir.regs2(a, b: zero1))
	let zero2 = b.konst(0)
	let two = b.konst(2)
	_ = b.runtime(ir.Rt.rtArrayInsert, kind: ir.IrKind.kindScalar, args: regs3(a, b: zero2, c: two))
	let loaded = b.reg(ir.IrKind.kindScalar)
	b.emit(ir.newLoadAt(loaded, addr: element, filled: false))
	let zero = b.konst(0)
	expectViolation("stale", out: runMain(p, main: b.ret(zero)), kind: "stale borrow", fragments: says("before the structure changed", b: "", c: "", d: ""))
end 'an address is stale once the array changes'

test 'an array that is dropped frees its elements'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let a = b.runtime(ir.Rt.rtArrayNew, kind: ir.IrKind.kindManaged, args: ir.RegList.create(0))
	let e = b.alloc(1)
	let zero0 = b.konst(0)
	_ = b.runtime(ir.Rt.rtArrayInsert, kind: ir.IrKind.kindScalar, args: regs3(a, b: zero0, c: e))
	b.drop(a)
	let d = b.reg(ir.IrKind.kindScalar)
	b.emit(ir.newLoadField(d, obj: e, offset: 0))
	let zero = b.konst(0)
	expectViolation("array drop", out: runMain(p, main: b.ret(zero)), kind: "use after free", fragments: says("", b: "", c: "", d: ""))
end 'an array that is dropped frees its elements'

test 'a moved element is owned by the caller'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let a = b.runtime(ir.Rt.rtArrayNew, kind: ir.IrKind.kindManaged, args: ir.RegList.create(0))
	let zero0 = b.konst(0)
	let element = b.alloc(1)
	_ = b.runtime(ir.Rt.rtArrayInsert, kind: ir.IrKind.kindScalar, args: regs3(a, b: zero0, c: element))
	let zero1 = b.konst(0)
	_ = b.runtime(ir.Rt.rtArrayRemove, kind: ir.IrKind.kindManaged, args: ir.regs2(a, b: zero1))
	b.drop(a)
	// The element is the caller's now and leaks unless dropped.
	let zero = b.konst(0)
	expectViolation("moved element", out: runMain(p, main: b.ret(zero)), kind: "leak", fragments: says("", b: "", c: "", d: ""))
end 'a moved element is owned by the caller'

// elementReadAt is main's IR with one element, 7, in an array, and a read of the element at index with no Bounds before it,
// as an access the checker proved in range is lowered.
function elementReadAt(index ir.Word) returns Outcome
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let a = b.runtime(ir.Rt.rtArrayNew, kind: ir.IrKind.kindManaged, args: ir.RegList.create(0))
	let zero = b.konst(0)
	let seven = b.konst(7)
	_ = b.runtime(ir.Rt.rtArrayInsert, kind: ir.IrKind.kindScalar, args: regs3(a, b: zero, c: seven))
	let at = b.konst(index)
	let loaded = b.reg(ir.IrKind.kindScalar)
	b.emit(ir.newElemLoad(loaded, arr: a, index: at, shift: ir.wordElementShift, filled: false))
	b.drop(a)
	return runMain(p, main: b.ret(loaded))
end 'elementReadAt'

test 'a proven access in range reports nothing'
	expectClean("proven in range", out: elementReadAt(0), exit: 7)
end 'a proven access in range reports nothing'

test 'a proven access out of range is a violation that names the access'
	expectViolation("proven past the end", out: elementReadAt(1), kind: "proven access out of range", fragments: says("function main", b: "a read of an element at index 1, count 1", c: "the checker's proof that the index is in range is wrong", d: ""))
end 'a proven access out of range is a violation that names the access'

// filledReadOf is main's IR with one element in an array, a box or nothing (0, as an emptied slot holds), and a read of it
// marked filled, as a read of an array whose slots are never empty is lowered.
function filledReadOf(boxed bool) returns Outcome
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let a = b.runtime(ir.Rt.rtArrayNew, kind: ir.IrKind.kindManaged, args: ir.RegList.create(0))
	let zero = b.konst(0)
	var element = b.konst(0)
	if boxed 'box'
		element = b.alloc(1)
	end 'box'
	_ = b.runtime(ir.Rt.rtArrayInsert, kind: ir.IrKind.kindScalar, args: regs3(a, b: zero, c: element))
	let at = b.konst(0)
	let loaded = b.reg(ir.IrKind.kindScalar)
	b.emit(ir.newElemLoad(loaded, arr: a, index: at, shift: ir.wordElementShift, filled: true))
	b.drop(a)
	let none = b.konst(0)
	return runMain(p, main: b.ret(none))
end 'filledReadOf'

test 'a read of a filled slot that has no test reports nothing'
	expectClean("filled slot", out: filledReadOf(true), exit: 0)
end 'a read of a filled slot that has no test reports nothing'

test 'a read of an empty slot that has no test is a violation that names the access'
	expectViolation("empty slot", out: filledReadOf(false), kind: "read of an empty slot", fragments: says("function main", b: "a read of an element at index 0", c: "finds its slot empty", d: ""))
end 'a read of an empty slot that has no test is a violation that names the access'

test 'a use of what the interpreter does not model ends the run as unmodelled'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let a = b.runtime(ir.Rt.rtArrayNew, kind: ir.IrKind.kindManaged, args: ir.RegList.create(0))
	_ = b.runtime(ir.Rt.rtArrayCapacity, kind: ir.IrKind.kindScalar, args: ir.regs1(a))
	let zero = b.konst(0)
	let out = runMain(p, main: b.ret(zero))
	if not out.unmodelled or out.violations.count() != 0 or not table.contains(out.stderr, fragment: "capacity") 'wrong'
		panic("unmodelled: {out.unmodelled}, {out.violations.count()} violations, stderr {out.stderr}")
	end 'wrong'
end 'a use of what the interpreter does not model ends the run as unmodelled'

test 'a checked add that overflows goes to its failure block'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let failed = b.b.newBlock()
	let max = b.konst(9223372036854775807)
	let sum = b.reg(ir.IrKind.kindScalar)
	let one = b.konst(1)
	b.emit(ir.newBin(sum, op: ir.BinOp.binAdd, left: max, right: one, unsigned: false, fail: failed))
	b.b.terminate(b.cur, t: ir.newRet(sum))
	b.cur = failed
	let seven = b.konst(7)
	expectClean("overflow", out: runMain(p, main: b.ret(seven)), exit: 7)
end 'a checked add that overflows goes to its failure block'

// writer is a behaviour on one cown that writes a word to standard output.
function writer(mutates p ast.Project, name String, word String) returns ir.IrFunction
	var b = Fn.new(p, name: name, convs: convs1(ast.Convention.convMutates))
	b.write(word)
	let zero = b.konst(0)
	return b.ret(zero)
end 'writer'

function seedOfTest(seed Count) returns ir.Word
	return try seed as ir.Word otherwise panic("a seed past a word")
end 'seedOfTest'

test 'a behaviour runs after main has returned and mains exit code is kept'
	var p = ir.irProject()
	let body = writer(p, name: "body", word: "ran;")
	for seed in 0 upto seedsToTry 'seeds'
		var b = Fn.new(p, name: "main", convs: ir.convs0())
		let c = b.cown(1)
		b.schedule(body.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
		b.drop(c)
		let seven = b.konst(7)
		let out = runSeed(p, main: b.ret(seven), seed: seedOfTest(seed))
		if out.violations.count() != 0 or out.exitCode != 7 or out.stdout != "ran;" or out.behaviours != 1 'wrong'
			panic("seed {seed}: exit {out.exitCode}, {out.violations.count()} violations, {out.stdout}, {out.behaviours} behaviours")
		end 'wrong'
	end 'seeds'
end 'a behaviour runs after main has returned and mains exit code is kept'

// Behaviours on one cown run in the order they were scheduled, whatever the interleaving.
test 'behaviours on one cown run in the order they were scheduled'
	var p = ir.irProject()
	let first = writer(p, name: "first", word: "1")
	let second = writer(p, name: "second", word: "2")
	let third = writer(p, name: "third", word: "3")
	for seed in 0 upto seedsToTry 'seeds'
		var b = Fn.new(p, name: "main", convs: ir.convs0())
		let c = b.cown(1)
		b.schedule(first.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
		b.schedule(second.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
		b.schedule(third.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
		b.drop(c)
		let zero = b.konst(0)
		let out = runSeed(p, main: b.ret(zero), seed: seedOfTest(seed))
		if out.violations.count() != 0 or out.stdout != "123" 'wrong'
			panic("seed {seed}: {out.violations.count()} violations, {out.stdout}")
		end 'wrong'
	end 'seeds'
end 'behaviours on one cown run in the order they were scheduled'

// Behaviours on disjoint cowns have no order, so the seeds between them find both.
test 'behaviours on disjoint cowns run in either order'
	var p = ir.irProject()
	let left = writer(p, name: "left", word: "L")
	let right = writer(p, name: "right", word: "R")
	var leftFirst = 0 as Count
	var rightFirst = 0 as Count
	for seed in 0 upto seedsToTry 'seeds'
		var b = Fn.new(p, name: "main", convs: ir.convs0())
		let a = b.cown(1)
		let c = b.cown(1)
		b.schedule(left.clone(), cowns: ir.regs1(a), captures: ir.RegList.create(0))
		b.schedule(right.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
		b.drop(a)
		b.drop(c)
		let zero = b.konst(0)
		let out = runSeed(p, main: b.ret(zero), seed: seedOfTest(seed))
		if out.violations.count() != 0 'violated'
			panic("seed {seed}: {out.violations[0]}")
		end 'violated'
		if out.stdout == "LR" 'lr'
			leftFirst = try leftFirst + 1 otherwise panic("count")
		end 'lr' else if out.stdout == "RL" 'rl'
			rightFirst = try rightFirst + 1 otherwise panic("count")
		end 'rl' else 'other'
			panic("seed {seed}: the schedule gave {out.stdout}")
		end 'other'
	end 'seeds'
	if leftFirst == 0 or rightFirst == 0 'one'
		panic("the schedules gave LR {leftFirst} times and RL {rightFirst} times, wanted both orders")
	end 'one'
end 'behaviours on disjoint cowns run in either order'

// A behaviour that names two cowns waits for both, so it runs after the earlier behaviours on either one.
test 'a behaviour on two cowns waits for earlier ones on either'
	var p = ir.irProject()
	let onA = writer(p, name: "onA", word: "A")
	let onB = writer(p, name: "onB", word: "B")
	var both = Fn.new(p, name: "both", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convMutates))
	both.write("+")
	let bothZero = both.konst(0)
	let bothFn = both.ret(bothZero)
	for seed in 0 upto seedsToTry 'seeds'
		var b = Fn.new(p, name: "main", convs: ir.convs0())
		let a = b.cown(1)
		let c = b.cown(1)
		b.schedule(onA.clone(), cowns: ir.regs1(a), captures: ir.RegList.create(0))
		b.schedule(onB.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
		b.schedule(bothFn.clone(), cowns: ir.regs2(a, b: c), captures: ir.RegList.create(0))
		b.schedule(onA.clone(), cowns: ir.regs1(a), captures: ir.RegList.create(0))
		b.drop(a)
		b.drop(c)
		let zero = b.konst(0)
		let out = runSeed(p, main: b.ret(zero), seed: seedOfTest(seed))
		if out.violations.count() != 0 or not (out.stdout == "AB+A" or out.stdout == "BA+A") 'wrong'
			panic("seed {seed}: {out.violations.count()} violations, {out.stdout}")
		end 'wrong'
	end 'seeds'
end 'a behaviour on two cowns waits for earlier ones on either'

function twoCownMain(mutates p ast.Project, left ir.IrFunction, right ir.IrFunction) returns ir.IrFunction
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let a = b.cown(1)
	let c = b.cown(1)
	b.schedule(left.clone(), cowns: ir.regs1(a), captures: ir.RegList.create(0))
	b.schedule(right.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
	b.drop(a)
	b.drop(c)
	let zero = b.konst(0)
	return b.ret(zero)
end 'twoCownMain'

test 'the same seed gives the same schedule'
	var p = ir.irProject()
	let left = writer(p, name: "left", word: "L")
	let right = writer(p, name: "right", word: "R")
	for seed in 0 upto seedsToTry 'seeds'
		let mainOne = twoCownMain(p, left: left, right: right)
		let mainTwo = twoCownMain(p, left: left, right: right)
		let first = runSeed(p, main: mainOne, seed: seedOfTest(seed))
		let second = runSeed(p, main: mainTwo, seed: seedOfTest(seed))
		if first.stdout != second.stdout or first.steps != second.steps 'differs'
			panic("seed {seed} gave {first.stdout} and {second.stdout}")
		end 'differs'
	end 'seeds'
end 'the same seed gives the same schedule'

test 'a behaviour that names one cown twice traps'
	var p = ir.irProject()
	var body = Fn.new(p, name: "body", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convMutates))
	let bodyZero = body.konst(0)
	let bodyFn = body.ret(bodyZero)
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let c = b.cown(1)
	b.schedule(bodyFn, cowns: ir.regs2(c, b: c), captures: ir.RegList.create(0))
	let zero = b.konst(0)
	let out = runSeed(p, main: b.ret(zero), seed: 0)
	if out.exitCode != 1 or out.violations.count() != 0 or not table.contains(out.stderr, fragment: "names the same cown twice") 'wrong'
		panic("same cown twice: exit {out.exitCode}, {out.violations.count()} violations, {out.stderr}")
	end 'wrong'
end 'a behaviour that names one cown twice traps'

// A behaviour that was handed a value which its scheduler still owns shares it: that is the data race that the capture rules of
// the checker rule out.
test 'a captured value that the scheduler still owns'
	var p = ir.irProject()
	var body = Fn.new(p, name: "body", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convLet))
	let bodyZero = body.konst(0)
	let bodyFn = body.ret(bodyZero)
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let c = b.cown(1)
	let s = b.slot(ir.IrKind.kindManaged)
	let boxs = b.alloc(1)
	b.store(s, v: boxs)
	let captured = b.load(s)
	b.schedule(bodyFn, cowns: ir.regs1(c), captures: ir.regs1(captured))
	let zero = b.konst(0)
	expectViolation("captured", out: runSeed(p, main: b.ret(zero), seed: 0), kind: "data race", fragments: says("captures", b: "still owns", c: "", d: ""))
end 'a captured value that the scheduler still owns'

// A value that was in flight when the behaviour was scheduled and then became main's belongs to main: the behaviour that reads
// it, whenever it runs after that, races with main.
test 'a thread reading what another thread owns'
	var p = ir.irProject()
	var body = Fn.new(p, name: "body", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convLet))
	let box = body.param(1, kind: ir.IrKind.kindManaged)
	let field = body.reg(ir.IrKind.kindScalar)
	body.emit(ir.newLoadField(field, obj: box, offset: 0))
	let bodyZero = body.konst(0)
	let bodyFn = body.ret(bodyZero)
	var raced = 0 as Count
	for seed in 0 upto seedsToTry 'seeds'
		var b = Fn.new(p, name: "main", convs: ir.convs0())
		let c = b.cown(1)
		let s = b.slot(ir.IrKind.kindManaged)
		let captured = b.alloc(1)
		b.schedule(bodyFn.clone(), cowns: ir.regs1(c), captures: ir.regs1(captured))
		b.store(s, v: captured)
		for _ in 0 upto holdsItAWhile 'wait'
			_ = b.konst(0)
		end 'wait'
		b.dropSlot(s)
		b.drop(c)
		let zero = b.konst(0)
		let out = runSeed(p, main: b.ret(zero), seed: seedOfTest(seed))
		for i in 0 upto out.violations.count() 'violations'
			if table.contains(out.violations[i], fragment: "memory-model violation: data race") and table.contains(out.violations[i], fragment: "belongs to the thread") 'race'
				raced = try raced + 1 otherwise panic("count")
			end 'race'
		end 'violations'
	end 'seeds'
	if raced == 0 'none'
		panic("no schedule of the program showed the race")
	end 'none'
end 'a thread reading what another thread owns'

test 'changing a value that is part of a frozen value'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	let frozen = b.runtime(ir.Rt.rtFrozenFreeze, kind: ir.IrKind.kindManaged, args: ir.regs1(box))
	let inner = b.runtime(ir.Rt.rtFrozenGet, kind: ir.IrKind.kindManaged, args: ir.regs1(frozen))
	let nine = b.konst(9)
	b.emit(ir.newStoreField(inner, offset: 0, src: nine, borrow: false))
	let zero = b.konst(0)
	expectViolation("frozen change", out: runMain(p, main: b.ret(zero)), kind: "change to a frozen value", fragments: says("part of a frozen value", b: "", c: "", d: ""))
end 'changing a value that is part of a frozen value'

test 'reading a frozen value is fine'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	let frozen = b.runtime(ir.Rt.rtFrozenFreeze, kind: ir.IrKind.kindManaged, args: ir.regs1(box))
	let inner = b.runtime(ir.Rt.rtFrozenGet, kind: ir.IrKind.kindManaged, args: ir.regs1(frozen))
	let field = b.reg(ir.IrKind.kindScalar)
	b.emit(ir.newLoadField(field, obj: inner, offset: 0))
	b.drop(frozen)
	let zero = b.konst(0)
	expectClean("frozen read", out: runMain(p, main: b.ret(zero)), exit: 0)
end 'reading a frozen value is fine'

// One count for a frozen value, however many objects it holds: the value is freed with its last owner.
test 'a frozen value is freed with its last owner'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let outer = b.alloc(1)
	let inner = b.alloc(1)
	b.emit(ir.newStoreField(outer, offset: 0, src: inner, borrow: false))
	let frozen = b.runtime(ir.Rt.rtFrozenFreeze, kind: ir.IrKind.kindManaged, args: ir.regs1(outer))
	let other = b.runtime(ir.Rt.rtShare, kind: ir.IrKind.kindManaged, args: ir.regs1(frozen))
	b.drop(frozen)
	b.drop(other)
	let zero = b.konst(0)
	var fns = ir.IrFunctionList.create(0)
	fns.push(b.ret(zero))
	var modules = ModuleFunctions.create(0)
	modules.push(fns)
	let out = run(p, modules: modules, entry: modules[0][0].decl, stepLimit: defaultStepLimit, seed: 0, wantFrees: true, stdin: "")
	if out.violations.count() != 0 'violated'
		panic("{out.violations[0]}")
	end 'violated'
	if out.frees.count() != 3 or out.frees[0] != "frozen value" or out.frees[1] != "record" or out.frees[2] != "record" 'order'
		panic("freed {out.frees.count()} values, the first {out.frees[0]}")
	end 'order'
end 'a frozen value is freed with its last owner'

test 'a frozen value is still there while an owner holds it'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	let frozen = b.runtime(ir.Rt.rtFrozenFreeze, kind: ir.IrKind.kindManaged, args: ir.regs1(box))
	let other = b.runtime(ir.Rt.rtShare, kind: ir.IrKind.kindManaged, args: ir.regs1(frozen))
	b.drop(frozen)
	let inner = b.runtime(ir.Rt.rtFrozenGet, kind: ir.IrKind.kindManaged, args: ir.regs1(other))
	let field = b.reg(ir.IrKind.kindScalar)
	b.emit(ir.newLoadField(field, obj: inner, offset: 0))
	b.drop(other)
	let zero = b.konst(0)
	expectClean("frozen held", out: runMain(p, main: b.ret(zero)), exit: 0)
end 'a frozen value is still there while an owner holds it'

test 'a dropped frozen value that a place still holds'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	let frozen = b.runtime(ir.Rt.rtFrozenFreeze, kind: ir.IrKind.kindManaged, args: ir.regs1(box))
	let s = b.slot(ir.IrKind.kindManaged)
	b.store(s, v: frozen)
	b.drop(frozen)
	let zero = b.konst(0)
	expectViolation("frozen held by a place", out: runMain(p, main: b.ret(zero)), kind: "reference count", fragments: says("still referenced", b: "", c: "", d: ""))
end 'a dropped frozen value that a place still holds'

test 'a frozen value that no one drops leaks'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	_ = b.runtime(ir.Rt.rtFrozenFreeze, kind: ir.IrKind.kindManaged, args: ir.regs1(box))
	let zero = b.konst(0)
	expectViolation("frozen leak", out: runMain(p, main: b.ret(zero)), kind: "leak", fragments: says("frozen value", b: "", c: "", d: ""))
end 'a frozen value that no one drops leaks'

test 'a cown that no one drops leaks'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	_ = b.cown(1)
	let zero = b.konst(0)
	expectViolation("cown leak", out: runMain(p, main: b.ret(zero)), kind: "leak", fragments: says("cown", b: "", c: "", d: ""))
end 'a cown that no one drops leaks'

test 'dropping a frozen value once too often'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let box = b.alloc(1)
	let frozen = b.runtime(ir.Rt.rtFrozenFreeze, kind: ir.IrKind.kindManaged, args: ir.regs1(box))
	b.drop(frozen)
	b.drop(frozen)
	let zero = b.konst(0)
	expectViolation("frozen twice", out: runMain(p, main: b.ret(zero)), kind: "double free", fragments: says("", b: "", c: "", d: ""))
end 'dropping a frozen value once too often'

// A cown is freed when its last reference is dropped and no behaviour holds it: a behaviour that is still waiting keeps it, and
// the value it owns, alive.
test 'a behaviour keeps its cown alive after every reference is dropped'
	var p = ir.irProject()
	var body = Fn.new(p, name: "body", convs: convs1(ast.Convention.convMutates))
	let addr = body.param(0, kind: ir.IrKind.kindScalar)
	let value = body.reg(ir.IrKind.kindManaged)
	body.emit(ir.newLoadAt(value, addr: addr, filled: false))
	let field = body.reg(ir.IrKind.kindScalar)
	body.emit(ir.newLoadField(field, obj: value, offset: 0))
	let bodyZero = body.konst(0)
	let bodyFn = body.ret(bodyZero)
	for seed in 0 upto seedsToTry 'seeds'
		var b = Fn.new(p, name: "main", convs: ir.convs0())
		let c = b.cown(1)
		b.schedule(bodyFn.clone(), cowns: ir.regs1(c), captures: ir.RegList.create(0))
		b.drop(c)
		let zero = b.konst(0)
		let out = runSeed(p, main: b.ret(zero), seed: seedOfTest(seed))
		if out.violations.count() != 0 'violated'
			panic("seed {seed}: {out.violations[0]}")
		end 'violated'
	end 'seeds'
end 'a behaviour keeps its cown alive after every reference is dropped'

// A behaviour owns what it captures, and frees it when it ends.
test 'a captured value is freed by the behaviour'
	var p = ir.irProject()
	var body = Fn.new(p, name: "body", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convConsumes))
	let slot = body.slot(ir.IrKind.kindManaged)
	let param = body.param(1, kind: ir.IrKind.kindManaged)
	body.store(slot, v: param)
	body.dropSlot(slot)
	let bodyZero = body.konst(0)
	let bodyFn = body.ret(bodyZero)
	for seed in 0 upto seedsToTry 'seeds'
		var b = Fn.new(p, name: "main", convs: ir.convs0())
		let c = b.cown(1)
		let captured = b.alloc(2)
		b.schedule(bodyFn.clone(), cowns: ir.regs1(c), captures: ir.regs1(captured))
		b.drop(c)
		let zero = b.konst(0)
		let out = runSeed(p, main: b.ret(zero), seed: seedOfTest(seed))
		if out.violations.count() != 0 'violated'
			panic("seed {seed}: {out.violations[0]}")
		end 'violated'
	end 'seeds'
end 'a captured value is freed by the behaviour'

test 'a captured value that the behaviour never frees'
	var p = ir.irProject()
	var body = Fn.new(p, name: "body", convs: convs2(ast.Convention.convMutates, b: ast.Convention.convConsumes))
	let slot = body.slot(ir.IrKind.kindManaged)
	let param = body.param(1, kind: ir.IrKind.kindManaged)
	body.store(slot, v: param)
	let bodyZero = body.konst(0)
	let bodyFn = body.ret(bodyZero)
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let c = b.cown(1)
	let captured = b.alloc(2)
	b.schedule(bodyFn, cowns: ir.regs1(c), captures: ir.regs1(captured))
	b.drop(c)
	let zero = b.konst(0)
	expectViolation("never freed", out: runSeed(p, main: b.ret(zero), seed: 0), kind: "leak", fragments: says("slot s0 still owns", b: "", c: "", d: ""))
end 'a captured value that the behaviour never frees'
