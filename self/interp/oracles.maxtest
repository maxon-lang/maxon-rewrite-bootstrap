// Each oracle of backpressure fires: on a run of IR that no compiled send makes, or on a trace built by hand.

// seedOfTurn4 draws a turn of four messages (turnLimitOf), so two places taken in a row slow nothing.
let seedOfTurn4 = 3 as Count

function runOracles(p ast.Project, main ir.IrFunction, others ir.IrFunctionList, seed ir.Word) returns Outcome
	var fns = ir.IrFunctionList.create(0)
	fns.push(main.clone())
	for i in 0 upto others.count() 'others'
		fns.push(others[i].clone())
	end 'others'
	var modules = ModuleFunctions.create(0)
	modules.push(fns)
	return runChecked(p, modules: modules, entry: main.decl, stepLimit: defaultStepLimit, seed: seed, wantFrees: false, stdin: "")
end 'runOracles'

function expectOracle(label String, out Outcome, oracle String, fragment String)
	if out.oracleFailures.count() == 0 'none'
		panic("{label}: no oracle failed; wanted {oracle}; exit {out.exitCode}, {out.violations.count()} violations, {out.stderr}")
	end 'none'
	let text = out.oracleFailures[0].clone()
	if not table.contains(text, fragment: "the {oracle} oracle failed") or not table.contains(text, fragment: fragment) 'other'
		panic("{label}: wanted {oracle} saying '{fragment}':\n{text}")
	end 'other'
end 'expectOracle'

// mainSending is main sending one message, the body, to a new service, after taking places in its mailbox.
function mainSending(mutates p ast.Project, body ir.IrFunction, places Count) returns ir.IrFunction
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let state = b.alloc(1)
	let service = b.runtime(ir.Rt.rtServiceNew, kind: ir.IrKind.kindManaged, args: ir.regs1(state))
	for i in 0 upto places 'places'
		_ = b.runtime(ir.Rt.rtServiceReserve, kind: ir.IrKind.kindScalar, args: ir.regs1(service))
	end 'places'
	b.schedule(body.clone(), cowns: ir.regs1(service), captures: ir.RegList.create(0))
	let zero = b.konst(0)
	return b.ret(zero)
end 'mainSending'

function others1(f ir.IrFunction) returns ir.IrFunctionList
	var out = ir.IrFunctionList.create(0)
	out.push(f.clone())
	return out
end 'others1'

test 'a message whose handler starts twice fails exactly once'
	var p = ir.irProject()
	var m = Fn.new(p, name: "twice", convs: convs1(ast.Convention.convMutates))
	let state = m.param(0, kind: ir.IrKind.kindScalar)
	_ = m.runtime(ir.Rt.rtServiceStart, kind: ir.IrKind.kindScalar, args: ir.regs1(state))
	_ = m.runtime(ir.Rt.rtServiceStart, kind: ir.IrKind.kindScalar, args: ir.regs1(state))
	let zero = m.konst(0)
	let body = m.ret(zero)
	let main = mainSending(p, body: body, places: 2)
	let out = runOracles(p, main: main, others: others1(body), seed: seedOfTest(seedOfTurn4))
	expectOracle("twice", out: out, oracle: oracleOnce, fragment: "is handled after it was handled or dropped")
end 'a message whose handler starts twice fails exactly once'

test 'a message whose handler never starts fails exactly once'
	var p = ir.irProject()
	var m = Fn.new(p, name: "never", convs: convs1(ast.Convention.convMutates))
	let zero = m.konst(0)
	let body = m.ret(zero)
	let main = mainSending(p, body: body, places: 1)
	let out = runOracles(p, main: main, others: others1(body), seed: seedOfTest(seedOfTurn4))
	expectOracle("never", out: out, oracle: oracleOnce, fragment: "was never handled")
end 'a message whose handler never starts fails exactly once'

// Under seed 0 a turn is one message: main's second place finds one queued and parks main, and no message is ever queued
// to let it go.
test 'a run that backpressure alone holds fails progress'
	var p = ir.irProject()
	var b = Fn.new(p, name: "main", convs: ir.convs0())
	let state = b.alloc(1)
	let service = b.runtime(ir.Rt.rtServiceNew, kind: ir.IrKind.kindManaged, args: ir.regs1(state))
	_ = b.runtime(ir.Rt.rtServiceReserve, kind: ir.IrKind.kindScalar, args: ir.regs1(service))
	_ = b.runtime(ir.Rt.rtServiceReserve, kind: ir.IrKind.kindScalar, args: ir.regs1(service))
	let zero = b.konst(0)
	let out = runOracles(p, main: b.ret(zero), others: ir.IrFunctionList.create(0), seed: 0)
	expectOracle("held", out: out, oracle: oracleProgress, fragment: "every task parked at a send")
end 'a run that backpressure alone holds fails progress'

test 'a message handled before the one sent before it fails sender order'
	var d = Deliveries.new()
	let pair = d.pairOf(taskSender(1), to: 7)
	let first = d.send(pair)
	let second = d.send(pair)
	if first != 1 or second != 2 or d.handle(pair, seq: second) 'kept'
		panic("the second message of a pair, handled first, came in its turn")
	end 'kept'
end 'a message handled before the one sent before it fails sender order'

// The bounds of runtime/service.maxon's header, by the shape of a service's senders and receivers: none where it states none.
test 'the queue bound follows the shape of the senders'
	var d = Deliveries.new()
	let turn = 3 as Count
	_ = d.pairOf(taskSender(1), to: 7)
	_ = d.pairOf(serviceSender(7), to: 8)
	_ = d.pairOf(taskSender(2), to: 9)
	_ = d.pairOf(taskSender(1), to: 9)
	let relay = queueBound(d, service: 7, turn: turn)
	let consumer = queueBound(d, service: 8, turn: turn)
	let leaf = queueBound(d, service: 9, turn: turn)
	if not relay.isSome() or relay.unwrap() != turn + 2 or not consumer.isSome() or consumer.unwrap() != 2 * turn + 4 or not leaf.isSome() or leaf.unwrap() != turn + 2 'wrong'
		panic("the bounds of a relay, its consumer and a leaf of two tasks are wrong")
	end 'wrong'
	_ = d.pairOf(taskSender(2), to: 8)
	if queueBound(d, service: 8, turn: turn).isSome() 'stated'
		panic("a consumer that a task sends to beside the relay has a bound")
	end 'stated'
end 'the queue bound follows the shape of the senders'
