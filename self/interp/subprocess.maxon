// The subprocess rows run children of their own, through handles of the runtime's table, which the interpreter has none of: a program that
// calls one says `// native-only`.

// haltSubprocessRow is the halt of the interpreter at a subprocess row: what it does not model, which a run of the spec tests
// under the interpreter meets in a test that passes natively.
function haltSubprocessRow(mutates vm Vm, row String) returns Halt
	return unmodelled(vm, what: "{row} is not run by the interpreter: mark the program native-only")
end 'haltSubprocessRow'

function entrySubprocessSpawn(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltSubprocessRow(vm, row: "__Builtins.subprocessSpawn")
end 'entrySubprocessSpawn'

function entrySubprocessGetPid(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltSubprocessRow(vm, row: "__Builtins.subprocessGetPid")
end 'entrySubprocessGetPid'

