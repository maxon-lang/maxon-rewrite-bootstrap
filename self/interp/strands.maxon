// Strands, coroutines, timers and services, as the runtime runs them (runtime/strand.maxon, green.maxon, timers.maxon,
// service.maxon). A coroutine is a thread of its own that runs only while it holds its strand: a strand is the thread that
// made a first coroutine (its root) and the coroutines it and they make, and only its holder runs. A member gives the
// strand up where it waits (it parks), where it yields and where it finishes, to the member that waited first, never
// where its burst ends, so two members never interleave. A thread that waits is parked: the entry that waited leaves the
// thread at its instruction, which runs again once the thread is readied and holds its strand. Time is the interpreter's
// clock, which a sleep's timer is set on and which the scheduler moves to the earliest timer when no thread can run, so a
// run of sleeps takes no time and orders its timers as their deadlines do.

// longestSleepNanos is the most a sleep waits, as the runtime's: about 146 years, so a deadline stays inside a word.
let longestSleepNanos = 4611686018427387904 as Count

// serviceClosed is what a shutdown adds to a service's gate, above every count of messages.
let serviceClosed = 4611686018427387904 as Count

// strandOf is the strand of a thread, which it becomes the root and holder of when it has none yet.
function strandOf(mutates vm Vm, t Count) returns Count
	if vm.threads[t].strand == 0 'first'
		let s = vm.strands.root.count()
		vm.strands.root.push(t)
		vm.strands.holder.push(t)
		vm.strands.queue.push(CountList.create(0))
		vm.threads[t].strand = s
	end 'first'
	return vm.threads[t].strand
end 'strandOf'

// holdsTurn is whether a thread may run as far as its strand goes: it is no member of one, or it holds its strand.
function holdsTurn(vm Vm, t Count) returns bool
	let s = vm.threads[t].strand
	return s == 0 or vm.strands.holder[s] == t
end 'holdsTurn'

// familyRoot is the thread whose data a thread reaches as its own: up from a coroutine to the root of its strand, and up
// from a parallel loop's worker to the loop's caller, as far as either goes, so that a coroutine a worker started and the
// worker's own coroutines and workers are of the caller's family.
function familyRoot(vm Vm, t Count) returns Count
	var at = t
	while true 'up'
		let s = vm.threads[at].strand
		if s != 0 and vm.strands.root[s] != at 'member'
			at = vm.strands.root[s]
		end 'member' else if vm.threads[at].job != 0 'worker'
			at = vm.parallels.caller[vm.threads[at].job]
		end 'worker' else 'root'
			return at
		end 'root'
	end 'up'
	panic("interp: the family of a thread does not end")
end 'familyRoot'

// sameStrand is whether two threads reach the same data without a race: they are of one family, whose members never run
// at once or, as a loop's workers, touch only what the race oracle (race.maxon) holds apart.
function sameStrand(vm Vm, a Count, b Count) returns bool
	return familyRoot(vm, t: a) == familyRoot(vm, t: b)
end 'sameStrand'

// behaviourOf is the behaviour whose cowns a thread may touch: its family root's.
function behaviourOf(vm Vm, t Count) returns Count
	return vm.threads[familyRoot(vm, t: t)].behaviour
end 'behaviourOf'

// releaseStrand is a thread giving up the strand it holds, to the member that waited first, or to none.
function releaseStrand(mutates vm Vm, t Count)
	let s = vm.threads[t].strand
	if s == 0 or vm.strands.holder[s] != t 'notHeld'
		return
	end 'notHeld'
	var next = 0 as Count
	if vm.strands.queue[s].count() > 0 'waiting'
		next = vm.strands.queue[s][0]
		try vm.strands.queue[s].remove(0) otherwise ignore
	end 'waiting'
	vm.strands.holder[s] = next
end 'releaseStrand'

// readyThread ends the wait of a parked thread: it takes its strand when no member holds it, and else waits behind the
// members queued already.
function readyThread(mutates vm Vm, t Count)
	if not vm.threads[t].parked 'running'
		return
	end 'running'
	vm.threads[t].parked = false
	let s = vm.threads[t].strand
	if s == 0 'alone'
		return
	end 'alone'
	if vm.strands.holder[s] == 0 'free'
		vm.strands.holder[s] = t
		return
	end 'free'
	vm.strands.queue[s].push(t)
end 'readyThread'

// parkThread parks the thread that runs, which gives up its strand and its turn.
function parkThread(mutates vm Vm)
	let t = vm.cur
	vm.threads[t].parked = true
	releaseStrand(vm, t: t)
	vm.yielded = true
	vm.switched = true
end 'parkThread'

// waitHere parks the thread at the instruction that runs, which runs again, uncounted, once the thread goes on.
function waitHere(mutates vm Vm)
	parkThread(vm)
	vm.ticked = true
end 'waitHere'

// yieldStrand gives the strand of the thread that runs to the member that waited first, which the thread waits behind,
// and gives true; with no member waiting it gives its turn back to the scheduler and gives false, the yield done.
function yieldStrand(mutates vm Vm) returns bool
	let t = vm.cur
	let s = vm.threads[t].strand
	vm.yielded = true
	if s == 0 or vm.strands.queue[s].count() == 0 'alone'
		return false
	end 'alone'
	let next = vm.strands.queue[s][0]
	try vm.strands.queue[s].remove(0) otherwise ignore
	vm.strands.queue[s].push(t)
	vm.strands.holder[s] = next
	vm.threads[t].yielding = true
	vm.switched = true
	vm.ticked = true
	return true
end 'yieldStrand'

// wakeDue readies every sleeper whose timer is due, in the order they went to sleep.
function wakeDue(mutates vm Vm)
	var i = 0 as Count
	while i < vm.sleepers.count() 'sleepers'
		let t = vm.sleepers[i]
		if vm.threads[t].wakeAt <= vm.clockNanos 'due'
			vm.sleepers.remove(i)
			vm.threads[t].wakeAt = noTimer
			vm.threads[t].woke = true
			readyThread(vm, t: t)
		end 'due' else 'later'
			i = i + 1
		end 'later'
	end 'sleepers'
end 'wakeDue'

// advanceClock moves the clock to the earliest timer, which is what time does when nothing can run.
function advanceClock(mutates vm Vm)
	var earliest = vm.threads[vm.sleepers[0]].wakeAt
	for i in 1 upto vm.sleepers.count() 'sleepers'
		let at = vm.threads[vm.sleepers[i]].wakeAt
		if at < earliest 'earlier'
			earliest = at
		end 'earlier'
	end 'sleepers'
	if earliest > vm.clockNanos 'later'
		vm.clockNanos = earliest
	end 'later'
end 'advanceClock'

// execAsync starts a call as a coroutine of the strand of the thread that runs: its arguments are taken as the call's
// would be, and it waits in the strand's queue until the members before it wait.
function execAsync(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let callee = functionOf(vm, id: ir.asyncCallee(f, x: x))
	let start = ir.asyncArgsStart(x)
	let count = ir.asyncArgsCount(x)
	clearArguments(vm)
	for i in 0 upto count 'args'
		let r = f.args[try start + i otherwise panic("interp: an argument past the pool")]
		let at = vm.regAt(r)
		vm.argN.push(vm.regN[at])
		vm.argR.push(vm.regR[at])
		try checkArgument(vm, f: f, callee: callee, i: i, r: r)
	end 'args'
	try requireDisjoint(vm, callee: callee, count: count)
	let caller = vm.cur
	let s = strandOf(vm, t: caller)
	let t = vm.threads.count()
	let row = vm.promises.add(t)
	var thread = Thread.new(callee, behaviour: 0)
	thread.promise = row
	thread.strand = s
	thread.startN = vm.argN.clone()
	thread.startR = vm.argR.clone()
	vm.threads.push(thread)
	vm.strands.queue[s].push(t)
	raceFork(vm, k: t, row: row)
	let site = vm.site()
	let o = vm.h.newObject(kindPromise, site: site)
	vm.h.oData[o] = row
	vm.setRef(x.dst, o: o)
end 'execAsync'

// beginCoroutine makes the first frame of a coroutine, with the arguments its async call gave; one whose promise was
// cancelled before it started never calls its function, and drops what the function was given to own.
function beginCoroutine(mutates vm Vm, t Count, row Count) throws Halt
	let callee = vm.threads[t].name
	if vm.promises.cancelled[row] 'cancelled'
		for i in 0 upto vm.threads[t].startR.count() 'owned'
			let r = vm.threads[t].startR[i]
			if r > 0 and ownsArgument(argumentConv(vm, callee: callee, i: i)) 'drop'
				try drop(vm, o: r as Count)
			end 'drop'
		end 'owned'
		return
	end 'cancelled'
	vm.promises.started[row] = true
	clearArguments(vm)
	for i in 0 upto vm.threads[t].startN.count() 'args'
		vm.argN.push(vm.threads[t].startN[i])
		vm.argR.push(vm.threads[t].startR[i])
	end 'args'
	try enterFrame(vm, fn: callee, dst: -1, err: -1)
end 'beginCoroutine'

// keepOutcome puts what a coroutine's function gave in its promise, for the await.
function keepOutcome(mutates vm Vm, t Count, row Count)
	vm.promises.valueN[row] = vm.threads[t].retN
	vm.promises.valueR[row] = vm.threads[t].retR
	vm.promises.errN[row] = vm.threads[t].errN
	vm.promises.errR[row] = vm.threads[t].errR
end 'keepOutcome'

// finishPromise marks a promise finished and readies the thread that waits for it.
function finishPromise(mutates vm Vm, row Count)
	vm.promises.finished[row] = true
	let w = vm.promises.waiter[row]
	vm.promises.waiter[row] = 0
	if w != 0 'waited'
		readyThread(vm, t: w)
	end 'waited'
end 'finishPromise'

// finishThread ends a thread whose last frame has returned and whose drops are done: a coroutine finishes its promise,
// and a member gives up its strand.
function finishThread(mutates vm Vm, t Count)
	vm.threads[t].done = true
	let row = vm.threads[t].promise
	if row != 0 'coroutine'
		finishPromise(vm, row: row)
	end 'coroutine'
	releaseStrand(vm, t: t)
end 'finishThread'

// waitFor parks the thread that runs until a promise finishes. Only its owner waits for a promise, so one that another
// thread waits for already is a broken invariant.
function waitFor(mutates vm Vm, row Count)
	let w = vm.promises.waiter[row]
	if w != 0 and w != vm.cur 'other'
		panic("interp: a promise that {describeThread(vm, t: w)} waits for is waited for by {describeThread(vm, t: vm.cur)}")
	end 'other'
	vm.promises.waiter[row] = vm.cur
	parkThread(vm)
end 'waitFor'

// cancelPromise marks a promise cancelled: its coroutine does not start a function that has not started, and the sleep it is
// in ends now. A reply is marked too, and its message runs on.
function cancelPromise(mutates vm Vm, row Count)
	vm.promises.cancelled[row] = true
	if vm.promises.watches[row] != 0 and not vm.promises.finished[row] 'watch'
		unwatch(vm, row: row)
	end 'watch'
	let t = vm.promises.thread[row]
	if t != 0 and vm.threads[t].wakeAt > vm.clockNanos 'sleeping'
		vm.threads[t].wakeAt = vm.clockNanos
	end 'sleeping'
end 'cancelPromise'

// dropOutcome drops what a finished promise's function or message gave that no await took: its value and its error.
function dropOutcome(mutates vm Vm, row Count) throws Halt
	raceJoin(vm, row: row)
	let value = vm.promises.valueR[row]
	vm.promises.valueR[row] = 0
	if value > 0 'value'
		try drop(vm, o: value as Count)
	end 'value'
	let err = vm.promises.errR[row]
	vm.promises.errR[row] = 0
	if err > 0 'error'
		try drop(vm, o: err as Count)
	end 'error'
end 'dropOutcome'

// dropPromise is the drop of a promise that nothing awaited, as its drop routine cancels it, waits for it and drops what it
// gave: the cancel is at once, so a drop of many cancels each before it waits for any, and the wait follows the
// instruction that dropped (settleDrops).
function dropPromise(mutates vm Vm, row Count) throws Halt
	cancelPromise(vm, row: row)
	if vm.promises.finished[row] 'finished'
		try dropOutcome(vm, row: row)
		return
	end 'finished'
	vm.dropWaits.push(row)
end 'dropPromise'

// settleDrops waits for each promise a drop of the thread that runs cancelled, in the order they were dropped, and drops what
// each gave; it gives false while the thread waits for one.
function settleDrops(mutates vm Vm) returns bool throws Halt
	while vm.dropWaits.count() > 0 'waits'
		let row = vm.dropWaits[0]
		if not vm.promises.finished[row] 'running'
			waitFor(vm, row: row)
			return false
		end 'running'
		vm.dropWaits.remove(0)
		try dropOutcome(vm, row: row)
	end 'waits'
	return true
end 'settleDrops'

// freePromise frees the record of a promise that an await has taken what it gave from.
function freePromise(mutates vm Vm, o Count)
	let row = vm.h.oData[o]
	raceJoin(vm, row: row)
	vm.h.oFreed[o] = true
	vm.h.oFreedAt[o] = vm.site()
	vm.h.oOwner[o] = 0
	vm.frees.push(o)
end 'freePromise'

// promiseArg is the promise an entry is given, which must be live and the thread's to use.
function promiseArg(mutates vm Vm, f ir.IrFunction, x ir.Instr, what String) returns Count throws Halt
	let o = try live(vm, o: argRef(vm, f: f, x: x, i: 0), what: what)
	if vm.h.oKind[o] != kindPromise 'notPromise'
		panic("interp: {what} of {objectText(vm, o: o)}, which is no promise")
	end 'notPromise'
	return o
end 'promiseArg'

// requireFinished is the invariant of the entries that read a promise after rt.async.wait waited for it.
function requireFinished(vm Vm, row Count, what String)
	if not vm.promises.finished[row] 'running'
		panic("interp: {what} of a promise that has not finished")
	end 'running'
end 'requireFinished'

// giveValue gives the value of a finished promise to the entry's register, which then holds it. A coroutine that a cancel
// kept from starting gave none, which a managed register holds as the empty object, as native code holds it as 0.
function giveValue(mutates vm Vm, f ir.IrFunction, x ir.Instr, row Count)
	if x.dst == ir.noReg 'unreceived'
		return
	end 'unreceived'
	if not vm.promises.started[row] and isManaged(f, r: x.dst) 'none'
		let none = noneObject(vm)
		vm.setRef(x.dst, o: none)
		return
	end 'none'
	let at = vm.regAt(x.dst)
	vm.regN[at] = vm.promises.valueN[row]
	vm.regR[at] = vm.promises.valueR[row]
	vm.promises.valueR[row] = 0
end 'giveValue'

function entryAsyncAwait(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try promiseArg(vm, f: f, x: x, what: "an await")
	let row = vm.h.oData[o]
	if not vm.promises.finished[row] 'running'
		waitFor(vm, row: row)
		vm.ticked = true
		return
	end 'running'
	giveValue(vm, f: f, x: x, row: row)
	freePromise(vm, o: o)
end 'entryAsyncAwait'

function entryAsyncWait(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try promiseArg(vm, f: f, x: x, what: "an await")
	let row = vm.h.oData[o]
	if not vm.promises.finished[row] 'running'
		waitFor(vm, row: row)
		vm.ticked = true
	end 'running'
end 'entryAsyncWait'

function entryAsyncError(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try promiseArg(vm, f: f, x: x, what: "the error of an await")
	let row = vm.h.oData[o]
	requireFinished(vm, row: row, what: "the error")
	let at = vm.regAt(result(x))
	vm.regN[at] = vm.promises.errN[row]
	vm.regR[at] = vm.promises.errR[row]
	vm.promises.errR[row] = 0
end 'entryAsyncError'

function entryAsyncTake(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try promiseArg(vm, f: f, x: x, what: "an await")
	let row = vm.h.oData[o]
	requireFinished(vm, row: row, what: "the take")
	giveValue(vm, f: f, x: x, row: row)
	freePromise(vm, o: o)
end 'entryAsyncTake'

function entryAsyncCancel(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try promiseArg(vm, f: f, x: x, what: "a cancel")
	let row = vm.h.oData[o]
	cancelPromise(vm, row: row)
end 'entryAsyncCancel'

function entryAsyncComplete(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = try promiseArg(vm, f: f, x: x, what: "isComplete")
	let finished = vm.promises.finished[vm.h.oData[o]]
	giveFlag(vm, x: x, b: finished)
end 'entryAsyncComplete'

// elementPromise is the promise an element of an array of them holds, or 0 where a take left the element empty.
function elementPromise(vm Vm, data Count, i Count) returns Count
	let p = vm.h.refOf(vm.h.elements[data][i])
	if p != 0 and vm.h.oKind[p] != kindPromise 'notPromise'
		panic("interp: awaitAny of an array that holds {objectText(vm, o: p)}, which is no promise")
	end 'notPromise'
	return p
end 'elementPromise'

// entryAsyncAwaitAny gives the index of the first promise of an array that has finished, and else waits as the waiter of
// each, as the runtime's select does; once readied it takes itself off every promise before it looks again.
function entryAsyncAwaitAny(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let arr = try collection(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindArray, what: "awaitAny")
	let data = vm.h.oData[arr]
	let n = vm.h.elements[data].count()
	for i in 0 upto n 'deregister'
		let p = elementPromise(vm, data: data, i: i)
		if p != 0 and vm.promises.waiter[vm.h.oData[p]] == vm.cur 'mine'
			vm.promises.waiter[vm.h.oData[p]] = 0
		end 'mine'
	end 'deregister'
	for i in 0 upto n 'scan'
		let p = elementPromise(vm, data: data, i: i)
		if p != 0 and vm.promises.finished[vm.h.oData[p]] 'finished'
			giveNum(vm, x: x, n: try i as ir.Word otherwise panic("interp: an index past a word"))
			return
		end 'finished'
	end 'scan'
	for i in 0 upto n 'register'
		let p = elementPromise(vm, data: data, i: i)
		if p != 0 'held'
			let row = vm.h.oData[p]
			if vm.promises.waiter[row] != 0 'waited'
				panic("interp: a promise that awaitAny waits on has another waiter")
			end 'waited'
			vm.promises.waiter[row] = vm.cur
		end 'held'
	end 'register'
	waitHere(vm)
end 'entryAsyncAwaitAny'

// entrySleep parks the thread that runs on a timer of the clock; a cancelled coroutine's sleep ends at once, after a
// yield that lets its strand's other members run.
function entrySleep(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let t = vm.cur
	if vm.threads[t].woke or vm.threads[t].yielding 'ended'
		vm.threads[t].woke = false
		vm.threads[t].yielding = false
		return
	end 'ended'
	let row = vm.threads[t].promise
	if row != 0 and vm.promises.cancelled[row] 'cancelled'
		_ = yieldStrand(vm)
		return
	end 'cancelled'
	let ms = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 0))
	var nanos = try ms * (nanosPerMillisecond as Count) otherwise longestSleepNanos
	if nanos > longestSleepNanos 'long'
		nanos = longestSleepNanos
	end 'long'
	vm.threads[t].wakeAt = try vm.clockNanos + (nanos as ir.Word) otherwise panic("interp: a sleep past the end of the clock")
	vm.sleepers.push(t)
	waitHere(vm)
end 'entrySleep'

// entryYield lets the members of the strand that wait run first, else the other threads.
function entryYield(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let t = vm.cur
	if vm.threads[t].yielding 'ended'
		vm.threads[t].yielding = false
		return
	end 'ended'
	_ = yieldStrand(vm)
end 'entryYield'

// entryServiceNew makes a service: a cown that holds its state, or nothing until its factory's behaviour stores it, with an
// empty mailbox.
function entryServiceNew(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	vm.tracking = true
	let service = try newShared(vm, f: f, kind: kindCown, src: argAt(f, x: x, i: 0), what: "the new service")
	giveRef(vm, x: x, o: service)
end 'entryServiceNew'

// entryServiceReserve takes a place in a service's mailbox for a message, unless the service is shut down, which it gives as
// the case of SendError plus 1, and slows the sender of a service that is behind or muted (senderSlowed).
function entryServiceReserve(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a send")
	let at = vm.h.oData[service]
	let gate = vm.h.shareds[at].gate
	if gate >= serviceClosed 'closed'
		giveNum(vm, x: x, n: caseWord(ast.sendServiceStopped))
		return
	end 'closed'
	let queued = gate + 1
	vm.h.shareds[at].gate = queued
	giveNum(vm, x: x, n: 0)
	noteReserved(vm, receiver: service)
	if slowsSenders(vm, at: at, queued: gate) 'slowing'
		if queued > vm.h.shareds[at].most 'most'
			vm.h.shareds[at].most = queued
		end 'most'
		senderSlowed(vm, receiver: service)
	end 'slowing'
end 'entryServiceReserve'

// entryServiceMostQueued gives the most messages a slowed send to a service found queued with its own.
function entryServiceMostQueued(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a service's queue")
	giveNum(vm, x: x, n: ir.wordOfBits(vm.h.shareds[vm.h.oData[service]].most))
end 'entryServiceMostQueued'

// The words of a send of a kind with a policy (rt.service.tryReserve): a place taken, and the service behind, so that the
// policy is asked and no place is taken.
let sendBehind = 3 as ir.Word

// entryServiceNewPending makes a service whose type has kinds of a coalescing policy, each with its pending word, empty.
function entryServiceNewPending(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	vm.tracking = true
	let service = try newShared(vm, f: f, kind: kindCown, src: argAt(f, x: x, i: 0), what: "the new service")
	let words = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let at = vm.h.oData[service]
	for i in 0 upto words 'words'
		vm.h.shareds[at].pending.push(0)
	end 'words'
	giveRef(vm, x: x, o: service)
end 'entryServiceNewPending'

// entryServiceTryReserve is the send of a kind with a policy: a place is taken as entryServiceReserve takes it while the
// service is not behind, and while it is, none is, and the send asks the policy (sendBehind).
function entryServiceTryReserve(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a send")
	let at = vm.h.oData[service]
	let gate = vm.h.shareds[at].gate
	if gate >= serviceClosed 'closed'
		giveNum(vm, x: x, n: caseWord(ast.sendServiceStopped))
		return
	end 'closed'
	if slowsSenders(vm, at: at, queued: gate) or coinBehind(vm) 'behind'
		giveNum(vm, x: x, n: sendBehind)
		return
	end 'behind'
	vm.h.shareds[at].gate = gate + 1
	giveNum(vm, x: x, n: 0)
	noteReserved(vm, receiver: service)
end 'entryServiceTryReserve'

// entryServiceQueued gives the messages a service holds, shut down or not.
function entryServiceQueued(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a service's queue")
	giveNum(vm, x: x, n: ir.wordOfBits(vm.h.shareds[vm.h.oData[service]].gate mod serviceClosed))
end 'entryServiceQueued'

function entryServiceTurn(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	giveNum(vm, x: x, n: ir.wordOfBits(vm.turnLimit))
end 'entryServiceTurn'

// entryServicePlace takes a place for the message of a pending word, which never slows its sender.
function entryServicePlace(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a send")
	let at = vm.h.oData[service]
	let gate = vm.h.shareds[at].gate
	if gate >= serviceClosed 'closed'
		giveNum(vm, x: x, n: caseWord(ast.sendServiceStopped))
		return
	end 'closed'
	vm.h.shareds[at].gate = gate + 1
	giveNum(vm, x: x, n: 0)
	noteReserved(vm, receiver: service)
end 'entryServicePlace'

// entryServiceUnplace gives back the place of a message that replaced a pending one, which no behaviour is scheduled for.
function entryServiceUnplace(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a send")
	let at = vm.h.oData[service]
	vm.h.shareds[at].gate = try vm.h.shareds[at].gate - 1 otherwise panic("interp: a place given back that no send took")
	vm.threads[vm.cur].sendTo = 0
end 'entryServiceUnplace'

// entryServicePutPending puts a message's box in a pending word and gives the box it held, or 0.
function entryServicePutPending(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a send")
	let slot = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let at = vm.h.oData[service]
	let old = vm.h.shareds[at].pending[slot]
	vm.h.shareds[at].pending[slot] = argRef(vm, f: f, x: x, i: 2)
	giveRef(vm, x: x, o: old)
end 'entryServicePutPending'

// entryServiceTakePending gives the box of a pending word, given the address of the service's state, and leaves it empty.
function entryServiceTakePending(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let c = vm.address(argAt(f, x: x, i: 0))
	let service = vm.h.cellHolder[c]
	if c == 0 or vm.h.oKind[service] != kindCown 'notState'
		panic("interp: rt.service.takePending is given no service's state")
	end 'notState'
	let slot = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let at = vm.h.oData[service]
	let box = exchange(vm.h.shareds[at].pending[slot], value: 0)
	if box == 0 'empty'
		panic("interp: a pending message's behaviour found its word empty")
	end 'empty'
	giveRef(vm, x: x, o: box)
end 'entryServiceTakePending'

// entryServicePendingHeld gives whether a pending word holds a message.
function entryServicePendingHeld(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a send")
	let slot = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	giveFlag(vm, x: x, b: vm.h.shareds[vm.h.oData[service]].pending[slot] != 0)
end 'entryServicePendingHeld'

// entryServiceUnderLoad gives whether the service whose message the thread runs is behind, and false off a message.
function entryServiceUnderLoad(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let service = messageOf(vm, t: vm.cur)
	if service == 0 'task'
		giveFlag(vm, x: x, b: false)
		return
	end 'task'
	let at = vm.h.oData[service]
	giveFlag(vm, x: x, b: slowsSenders(vm, at: at, queued: vm.h.shareds[at].gate mod serviceClosed))
end 'entryServiceUnderLoad'

// slowsSenders is whether a service whose mailbox holds queued messages, before a send's, is behind or muted.
function slowsSenders(vm Vm, at Count, queued Count) returns bool
	return not vm.h.shareds[at].stoppedNow and (vm.h.shareds[at].behind or vm.h.shareds[at].muted or queued >= vm.turnLimit)
end 'slowsSenders'

// entryServiceStart gives a message's place in the mailbox back as its behaviour starts, given the address of the state, and
// names the service as the one the thread runs a message of.
function entryServiceStart(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let c = vm.address(argAt(f, x: x, i: 0))
	let service = vm.h.cellHolder[c]
	if c == 0 or vm.h.oKind[service] != kindCown 'notState'
		panic("interp: rt.service.start is given no service's state")
	end 'notState'
	let at = vm.h.oData[service]
	let passed = startTaken(vm.h.shareds[at])
	try unmuteEntries(vm, senders: passed)
	vm.threads[vm.cur].service = service
	let b = vm.threads[vm.cur].behaviour
	noteHandled(vm, b: b)
end 'entryServiceStart'

// Backpressure, as the runtime's (runtime/service.maxon), with vm.turnLimit for its turn: a service is behind when a send
// finds a turn's worth of its messages queued, counting its own; once a turn of its messages has run with more queued, until
// its queue empties; and while it is muted. Another service whose message sends to it is listed on it, with a mark, and
// muted at the end of a handler unless it drains on (drainsOn): its behaviour keeps its cowns until it is let go, and a
// service that is muted lets go the senders listed on it. A task, a thread that runs no message, parks at the send, with a
// mark. A sender's mark is how many of the receiver's messages will have started once those counted ahead of it have: the
// places of the gate, less those of the tasks parked on it, which are queued only once they are let go (listSender); a
// listed service's send to the same receiver moves its mark to that send's (markAgain). A start that passes the oldest
// marks lets those senders go, in order, unless the receiver is listed on another itself (startTaken), and a service whose
// queue empties lets them all go. The interpreter has no posted messages, so a mark counts none.
let muteNone = 0 as Count

let muteKept = 1 as Count

// turnLimits is how many turn limits a run may draw, from 1 up; turnLimitOf draws one from a seed without the run's random
// numbers, so the interleavings a seed gives do not move.
let turnLimits = 4 as Count

function turnLimitOf(seed ir.Word) returns Count
	return (ir.bitsOfWord(seed) mod turnLimits) + 1
end 'turnLimitOf'

// An entry of a service's senders is a service, senderTag times its object, or a thread, senderTag times its id plus 1.
let senderTag = 2 as Count

// senderSlowed lists the service whose message the thread runs on a receiver that is behind, once, however many it sends
// to, and never on itself; a task parks on the receiver.
function senderSlowed(mutates vm Vm, receiver Count)
	let t = vm.cur
	let sender = messageOf(vm, t: t)
	let at = vm.h.oData[receiver]
	if sender != 0 'message'
		let own = vm.h.oData[sender]
		let on = vm.h.shareds[own].listedOn
		let entry = try sender * senderTag otherwise panic("interp: an object past a word")
		if sender == receiver 'self'
			return
		end 'self'
		if on == receiver 'again'
			markAgain(vm.h.shareds[at], entry: entry)
			return
		end 'again'
		if on != 0 'listed'
			return
		end 'listed'
		listSender(vm.h.shareds[at], entry: entry, own: 0)
		vm.h.shareds[own].listedOn = receiver
		return
	end 'message'
	listSender(vm.h.shareds[at], entry: try t * senderTag + 1 otherwise panic("interp: a thread past a word"), own: 1)
	// The send has its place, so the task goes on after it once readied, and does not take another.
	vm.post = true
	parkThread(vm)
end 'senderSlowed'

// countedAhead is what a mark counts ahead of a sender slowed on a service: the places of its gate, less those of the tasks
// parked on it, whose messages are not queued.
function countedAhead(d SharedData) returns Count
	var parked = 0 as Count
	for e in d.senders 'senders'
		if e mod senderTag == 1 'task'
			parked = try parked + 1 otherwise panic("interp: a count of tasks past a word")
		end 'task'
	end 'senders'
	return try d.gate mod serviceClosed - parked otherwise panic("interp: more tasks parked than places")
end 'countedAhead'

// listSender lists entry on a service with its mark, no earlier than the mark of the entry before: a task (own 1) has its own
// place in the gate and not queued, which its mark leaves out. A task parks even where nothing is counted ahead of it, as
// the runtime's does (parkSender).
function listSender(mutates d SharedData, entry Count, own Count)
	let ahead = try countedAhead(d) - own otherwise panic("interp: a parked task without its place")
	var mark = (try d.handled + ahead otherwise panic("interp: a mark past a word")) as Count
	if not d.marks.isEmpty() 'before'
		let last = d.marks.last()
		if last > mark 'later'
			mark = last
		end 'later'
	end 'before'
	d.senders.push(entry)
	d.marks.push(mark)
end 'listSender'

// markAgain moves the mark of a listed service to what its receiver holds now, in its place on the list.
function markAgain(mutates d SharedData, entry Count)
	let mark = try d.handled + countedAhead(d) otherwise panic("interp: a mark past a word")
	var marks = CountList.create(0)
	for i in 0 upto d.senders.count() 'senders'
		let e = d.senders.get(i)
		marks.push(mark if e == entry else try d.marks.get(i) otherwise 0)
	end 'senders'
	d.marks = marks
end 'markAgain'

// startTaken is a message's start on a service: its place is given back and the count of those started steps, and the senders
// whose marks that count has passed are taken off the list, oldest first, to be let go, unless the service is listed on
// another, whose catching up or the service's own mute lets them go.
function startTaken(mutates d SharedData) returns CountList
	d.gate = try d.gate - 1 otherwise panic("interp: a message taken that no send reserved")
	d.handled = try d.handled + 1 otherwise panic("interp: a count of starts past a word")
	var passed = CountList.create(0)
	if d.listedOn != 0 'listed'
		return passed
	end 'listed'
	while not d.marks.isEmpty() 'marks'
		let mark = d.marks.first()
		if mark > d.handled 'ahead'
			break 'marks'
		end 'ahead'
		_ = d.marks.remove(0)
		passed.push(try d.senders.remove(0) otherwise panic("interp: a mark without its sender"))
	end 'marks'
	return passed
end 'startTaken'

// takeSenders takes every sender off a service's list, with their marks.
function takeSenders(mutates d SharedData) returns CountList
	d.marks = CountList.create(0)
	return exchange(d.senders, value: CountList.create(0))
end 'takeSenders'

// messageOf is the service whose message thread t runs, or 0 for a task.
function messageOf(vm Vm, t Count) returns Count
	let b = vm.threads[t].behaviour
	let service = vm.threads[t].service
	if b == 0 or service == 0 or not isMessageOf(vm, b: b, service: service) 'task'
		return 0
	end 'task'
	return service
end 'messageOf'

function isMessageOf(vm Vm, b Count, service Count) returns bool
	return vm.behaviours.cowns[b].count() == 1 and vm.behaviours.cowns[b][0] == service
end 'isMessageOf'

// mutes is whether behaviour b, a message of service that has run, is muted as its handler ends: its service is listed on
// a receiver and does not drain on.
function mutes(vm Vm, b Count, service Count) returns bool
	if service == 0 or not isMessageOf(vm, b: b, service: service) 'other'
		return false
	end 'other'
	let at = vm.h.oData[service]
	return vm.h.shareds[at].listedOn != 0 and not drainsOn(vm, at: at)
end 'mutes'

// drainsOn is whether a listed service runs on instead of being muted: messages are queued behind the one that ran, the
// first of its queue, and it is behind itself, by its turns or the length of its queue, or has senders waiting on it. The
// queue is read and not the gate, which holds the message of a task parked at its send before it is queued.
function drainsOn(vm Vm, at Count) returns bool
	return vm.h.shareds[at].queue.count() > 1 and (vm.h.shareds[at].behind or vm.h.shareds[at].gate mod serviceClosed >= vm.turnLimit or vm.h.shareds[at].senders.count() > 0)
end 'drainsOn'

// drainsBehind makes a listed service that drains on because it holds a turn's worth behind, as the runtime's does: its
// senders stay slowed until it empties.
function drainsBehind(mutates d SharedData, turn Count)
	if d.listedOn != 0 and d.queue.count() > 1 and not d.behind and d.gate mod serviceClosed >= turn 'length'
		d.behind = true
	end 'length'
end 'drainsBehind'

// keepMuted mutes a service as its message's handler ends, and says whether it did: it lets go the senders listed on it so
// far (the progress argument), which may make the receiver it waits on catch up first. Muted, its behaviour keeps its
// cowns and its service runs no message.
function keepMuted(mutates vm Vm, b Count, service Count) returns bool throws Halt
	let at = vm.h.oData[service]
	vm.h.shareds[at].muted = true
	try unmuteSenders(vm, service: service)
	if vm.h.shareds[at].listedOn == 0 'caughtUp'
		vm.h.shareds[at].muted = false
		return false
	end 'caughtUp'
	vm.h.shareds[at].kept = b
	vm.behaviours.mute[b] = muteKept
	vm.behaviours.mutedOn[b] = vm.h.shareds[at].listedOn
	vm.h.shareds[at].running = 0
	return true
end 'keepMuted'

// countTurn counts a message of a service that has run: with none left the service catches up, and after vm.turnLimit with
// more queued it is behind.
function countTurn(mutates vm Vm, service Count) throws Halt
	let at = vm.h.oData[service]
	if vm.h.shareds[at].queue.count() == 0 'drained'
		vm.h.shareds[at].turn = 0
		try caughtUp(vm, service: service)
		return
	end 'drained'
	vm.h.shareds[at].turn = try vm.h.shareds[at].turn + 1 otherwise panic("interp: a turn past a word")
	if vm.h.shareds[at].turn >= vm.turnLimit 'full'
		vm.h.shareds[at].turn = 0
		vm.h.shareds[at].behind = true
	end 'full'
end 'countTurn'

// caughtUp is a service that is no longer behind: its senders are unmuted in order.
function caughtUp(mutates vm Vm, service Count) throws Halt
	vm.h.shareds[vm.h.oData[service]].behind = false
	try unmuteSenders(vm, service: service)
end 'caughtUp'

// unmuteSenders unmutes the senders listed on a service, in order: a muted one's kept behaviour releases its cowns, a running
// one is no longer listed, and a parked task is readied. A kept message's release counts as its service's own messages' do:
// one that empties the queue makes the service catch up, which a task parked on it while it was muted waits for.
function unmuteSenders(mutates vm Vm, service Count) throws Halt
	let at = vm.h.oData[service]
	let senders = takeSenders(vm.h.shareds[at])
	try unmuteEntries(vm, senders: senders)
end 'unmuteSenders'

// unmuteEntries lets go the senders taken off a list, in order.
function unmuteEntries(mutates vm Vm, senders CountList) throws Halt
	for e in senders 'senders'
		if e mod senderTag == 1 'task'
			readyThread(vm, t: e / senderTag)
			continue 'senders'
		end 'task'
		let s = e / senderTag
		let sat = vm.h.oData[s]
		vm.h.shareds[sat].listedOn = 0
		let b = vm.h.shareds[sat].kept
		if b == 0 'running'
			continue 'senders'
		end 'running'
		vm.h.shareds[sat].kept = 0
		vm.h.shareds[sat].muted = false
		vm.behaviours.mute[b] = muteNone
		try releaseBehaviour(vm, b: b, service: s)
	end 'senders'
end 'unmuteEntries'

// mutedBehaviours are the behaviours that backpressure keeps muted, in the order they were scheduled.
function mutedBehaviours(vm Vm) returns CountList
	var kept = CountList.create(0)
	for b in 1 upto vm.behaviours.mute.count() 'behaviours'
		if vm.behaviours.mute[b] == muteKept 'kept'
			kept.push(b)
		end 'kept'
	end 'behaviours'
	return kept
end 'mutedBehaviours'

function entryServiceShutdown(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a shutdown")
	closeService(vm, service: service)
end 'entryServiceShutdown'

// closeService closes a service's mailbox once, so every later send fails with serviceStopped, and gives its watches where it
// holds no message.
function closeService(mutates vm Vm, service Count)
	let at = vm.h.oData[service]
	if vm.h.shareds[at].gate < serviceClosed 'open'
		vm.h.shareds[at].gate = try vm.h.shareds[at].gate + serviceClosed otherwise panic("interp: a gate past a word")
	end 'open'
	endedIfClosed(vm, service: service)
end 'closeService'

// Watching a stop, as the runtime's (runtime/service.maxon, "Watching a stop"): a watch is a promise that no coroutine
// finishes, listed on its service, which the end of the service finishes: once it is closed and holds no message, or once it
// is freed. Its cancel finishes it and takes it off.
function entryServiceStopped(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a watch of a stop")
	let row = vm.promises.add(0)
	vm.promises.started[row] = true
	vm.promises.watches[row] = service
	let o = vm.h.newObject(kindPromise, site: vm.site())
	vm.h.oData[o] = row
	vm.h.shareds[vm.h.oData[service]].watchers.push(row)
	endedIfClosed(vm, service: service)
	giveRef(vm, x: x, o: o)
end 'entryServiceStopped'

// endedIfClosed gives the watches of a service that is closed and holds no message: none sent and not started, none queued,
// none running and none kept muted.
function endedIfClosed(mutates vm Vm, service Count)
	let at = vm.h.oData[service]
	if vm.h.shareds[at].gate == serviceClosed and vm.h.shareds[at].queue.count() == 0 and vm.h.shareds[at].running == 0 and vm.h.shareds[at].kept == 0 'ended'
		serviceEnded(vm, service: service)
	end 'ended'
end 'endedIfClosed'

// serviceEnded finishes every watch of a service that has ended.
function serviceEnded(mutates vm Vm, service Count)
	let at = vm.h.oData[service]
	let rows = exchange(vm.h.shareds[at].watchers, value: CountList.create(0))
	for i in 0 upto rows.count() 'rows'
		finishPromise(vm, row: rows[i])
	end 'rows'
end 'serviceEnded'

// entryServiceFreed is the runtime's call from the drop of a service's last handle, which the interpreter makes itself where
// it frees a cown (unref).
function entryServiceFreed(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a freed service")
	serviceEnded(vm, service: service)
end 'entryServiceFreed'

// unwatch is the cancel of a watch that its service has not finished: it is taken off and finished.
function unwatch(mutates vm Vm, row Count)
	let at = vm.h.oData[vm.promises.watches[row]]
	var kept = CountList.create(0)
	for i in 0 upto vm.h.shareds[at].watchers.count() 'rows'
		if vm.h.shareds[at].watchers[i] != row 'other'
			kept.push(vm.h.shareds[at].watchers[i])
		end 'other'
	end 'rows'
	vm.h.shareds[at].watchers = kept
	finishPromise(vm, row: row)
end 'unwatch'

// Stops, as the runtime's (runtime/service.maxon, "Stops"): a service stopped at once is closed, its messages queued start
// and are not handled, each counted delivered once as a dropped one, and the senders it slows are let go at once and never
// slowed by it again.
let stopStoppedWord = 1 as ir.Word

let shedStoppedWord = 3 as ir.Word

function entryServiceStopNow(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "a stop")
	try stopServiceNow(vm, service: service)
end 'entryServiceStopNow'

function stopServiceNow(mutates vm Vm, service Count) throws Halt
	let at = vm.h.oData[service]
	if vm.h.shareds[at].stoppedNow 'again'
		return
	end 'again'
	closeService(vm, service: service)
	vm.h.shareds[at].stoppedNow = true
	try caughtUp(vm, service: service)
end 'stopServiceNow'

// entryServiceStopSelf and entryServiceStopNowSelf stop the service whose message the thread runs, and nothing off a message.
function entryServiceStopSelf(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let service = messageOf(vm, t: vm.cur)
	if service != 0 'message'
		closeService(vm, service: service)
	end 'message'
end 'entryServiceStopSelf'

function entryServiceStopNowSelf(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = messageOf(vm, t: vm.cur)
	if service != 0 'message'
		try stopServiceNow(vm, service: service)
	end 'message'
end 'entryServiceStopNowSelf'

// Posted messages (runtime/service.maxon, "Posted messages") are not modelled yet: a program that makes one stops, as one that
// opens a socket does, and says `// native-only`.
function haltPosted(mutates vm Vm, what String) returns Halt
	return unmodelled(vm, what: "{what} is not run by the interpreter, which does not model posted messages yet: mark the program native-only")
end 'haltPosted'

function entryServiceNotifyStopped(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "notifyStopped")
end 'entryServiceNotifyStopped'

function entryServicePostedNew(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a posted message")
end 'entryServicePostedNew'

function entryServicePostedCancel(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a posted message")
end 'entryServicePostedCancel'

function entryTimerNew(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a timer")
end 'entryTimerNew'

function entryTimerRearm(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a timer")
end 'entryTimerRearm'

function entryTimerNext(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a timer")
end 'entryTimerNext'

function entryTimerReset(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a timer")
end 'entryTimerReset'

function entryTimerCancel(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a timer")
end 'entryTimerCancel'

function entryServicePostedStart(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	throw haltPosted(vm, what: "a posted message")
end 'entryServicePostedStart'

// entryServiceSelfHandle is `self.handle`: another owner of the service whose message the thread runs.
function entryServiceSelfHandle(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let service = messageOf(vm, t: vm.cur)
	if service == 0 'off'
		panic("interp: self.handle off a message of its service")
	end 'off'
	let at = vm.h.oData[service]
	vm.h.shareds[at].count = try vm.h.shareds[at].count + 1 otherwise panic("interp: a count past a word")
	giveRef(vm, x: x, o: service)
end 'entryServiceSelfHandle'

// entryServiceStopStart is entryServiceStart of a message of a type that implements StopsNow, and says whether its service was
// stopped at once, so that it is not handled.
function entryServiceStopStart(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = stateService(vm, f: f, x: x, what: "rt.service.stopStart")
	let at = vm.h.oData[service]
	let passed = startTaken(vm.h.shareds[at])
	try unmuteEntries(vm, senders: passed)
	vm.threads[vm.cur].service = service
	let b = vm.threads[vm.cur].behaviour
	if vm.h.shareds[at].stoppedNow 'stopped'
		noteStopped(vm, b: b)
		giveNum(vm, x: x, n: stopStoppedWord)
		return
	end 'stopped'
	noteHandled(vm, b: b)
	giveNum(vm, x: x, n: 0)
end 'entryServiceStopStart'

// entryReplyNew makes the cell a message's reply comes back in, a promise that no coroutine finishes.
function entryReplyNew(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let row = vm.promises.add(0)
	vm.promises.started[row] = true
	let site = vm.site()
	let o = vm.h.newObject(kindPromise, site: site)
	vm.h.oData[o] = row
	giveRef(vm, x: x, o: o)
end 'entryReplyNew'

// entryReplyGive finishes a reply with what the handler returned and failed with, each handed on to the reply. The sender
// owns the cell, which the message reaches as the runtime's message reaches its green thread's record.
function entryReplyGive(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = argRef(vm, f: f, x: x, i: 0)
	try requireLive(vm, o: o, what: "a reply")
	if vm.h.oKind[o] != kindPromise 'notPromise'
		panic("interp: a reply into {objectText(vm, o: o)}, which is no promise")
	end 'notPromise'
	let row = vm.h.oData[o]
	if vm.promises.finished[row] 'twice'
		panic("interp: a reply given twice")
	end 'twice'
	let value = argAt(f, x: x, i: 1)
	let err = argAt(f, x: x, i: 2)
	if isManaged(f, r: value) 'value'
		try requireHandedOn(vm, src: value, verb: "replies with")
	end 'value'
	if isManaged(f, r: err) 'error'
		try requireHandedOn(vm, src: err, verb: "replies with")
	end 'error'
	let v = vm.regAt(value)
	let e = vm.regAt(err)
	vm.promises.valueN[row] = vm.regN[v]
	vm.promises.valueR[row] = vm.regR[v]
	vm.promises.errN[row] = vm.regN[e]
	vm.promises.errR[row] = vm.regR[e]
	finishPromise(vm, row: row)
end 'entryReplyGive'

// entryServiceStateHeld is whether a service still holds its state, given the address of the state: the cown's place.
function entryServiceStateHeld(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let c = vm.address(argAt(f, x: x, i: 0))
	if c == 0 or vm.h.oKind[vm.h.cellHolder[c]] != kindCown 'notState'
		panic("interp: rt.service.stateHeld is given no service's state")
	end 'notState'
	giveFlag(vm, x: x, b: vm.h.refOf(c) != 0)
end 'entryServiceStateHeld'

// entryServiceEnding gives a service whose state type implements Ends its finish, which ends the state in place of its drop
// where the service is freed with the state still in it, as a cown's dropWith: destructor ends its value.
function entryServiceEnding(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = try shared(vm, o: argRef(vm, f: f, x: x, i: 0), kind: kindCown, what: "the ending of a service")
	giveEnding(vm, f: f, x: x, cown: service)
end 'entryServiceEnding'

// entryServiceBehaviourStart makes the service of a behaviour that is no message, its factory's or the one a stop queues to
// drop its state, the one the thread runs a message of, as a message's start does with no place in the mailbox to give back,
// so that its release is the service's (releaseBehaviour).
function entryServiceBehaviourStart(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = stateService(vm, f: f, x: x, what: "rt.service.behaviourStart")
	vm.threads[vm.cur].service = service
end 'entryServiceBehaviourStart'

// entryServiceStateEnds is whether the behaviour that runs is the last of its service, which drops a state that can hold a
// Reply: the service is closed, its gate counts no message still to start, from its send's reservation on, and it holds its
// state.
function entryServiceStateEnds(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = stateService(vm, f: f, x: x, what: "rt.service.stateEnds")
	let at = vm.h.oData[service]
	let c = vm.address(argAt(f, x: x, i: 0))
	giveFlag(vm, x: x, b: vm.h.shareds[at].gate == serviceClosed and vm.h.refOf(c) != 0)
end 'entryServiceStateEnds'

// entryServiceCurrent is the service whose message the thread runs.
function entryServiceCurrent(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = messageOf(vm, t: vm.cur)
	if service == 0 'off'
		panic("interp: rt.service.current off a message")
	end 'off'
	giveRef(vm, x: x, o: service)
end 'entryServiceCurrent'

// replyStoppedError is the error word a deferred reply dropped unanswered fails its sender's await with: the case
// ReplyStopped.serviceStopped, the first of the library's enum, plus 1, which is its word in every error of such an await.
let replyStoppedError = 1 as ir.Word

// entryReplyDefer makes the Reply of a message whose handler deferred its reply, of the cell its sender awaits: an object of
// its own, which the handler owns, of the cell's promise row, or of none where the sender dropped the reply, which native code
// holds as 0.
function entryReplyDefer(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let cell = argRef(vm, f: f, x: x, i: 0)
	var row = 0 as Count
	if cell != 0 'kept'
		try requireLive(vm, o: cell, what: "a reply")
		if vm.h.oKind[cell] != kindPromise 'notPromise'
			panic("interp: a reply deferred from {objectText(vm, o: cell)}, which is no promise")
		end 'notPromise'
		row = vm.h.oData[cell]
	end 'kept'
	let o = vm.h.newObject(kindReply, site: vm.site())
	vm.h.oData[o] = row
	giveRef(vm, x: x, o: o)
end 'entryReplyDefer'

// entryReplyHeld is whether a Reply holds the cell of a reply its sender awaits, a promise row.
function entryReplyHeld(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let o = argRef(vm, f: f, x: x, i: 0)
	try requireLive(vm, o: o, what: "a deferred reply")
	if vm.h.oKind[o] != kindReply 'notReply'
		panic("interp: rt.reply.held of {objectText(vm, o: o)}, which is no deferred reply")
	end 'notReply'
	giveFlag(vm, x: x, b: vm.h.oData[o] != 0)
end 'entryReplyHeld'

// entryReplyAnswer finishes a deferred reply with the value its answer gives, which is handed on to the reply, and frees the
// Reply, which the answer consumes.
function entryReplyAnswer(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let reply = argAt(f, x: x, i: 0)
	try requireHandedOn(vm, src: reply, verb: "answers")
	let o = vm.ref(reply)
	if vm.h.oKind[o] != kindReply 'notReply'
		panic("interp: an answer of {objectText(vm, o: o)}, which is no deferred reply")
	end 'notReply'
	let row = vm.h.oData[o]
	if row == 0 'dropped'
		panic("interp: an answer of a deferred reply whose sender dropped it, which rt.reply.held tells the compiled code")
	end 'dropped'
	let value = argAt(f, x: x, i: 1)
	if isManaged(f, r: value) 'value'
		try requireHandedOn(vm, src: value, verb: "answers with")
	end 'value'
	if vm.promises.finished[row] 'twice'
		oracleFails(vm, oracle: oracleOnce, found: "a deferred reply (promise row {row}) was answered after it was answered or failed")
	end 'twice' else 'first'
		let v = vm.regAt(value)
		vm.promises.valueN[row] = vm.regN[v]
		vm.promises.valueR[row] = vm.regR[v]
		vm.promises.errN[row] = 0
		vm.promises.errR[row] = 0
		finishPromise(vm, row: row)
	end 'first'
	try drop(vm, o: o)
end 'entryReplyAnswer'

// entryReplyDrop is a native drop routine's call of the runtime, which the interpreter's free of a Reply does.
function entryReplyDrop(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	panic("interp: rt.reply.drop is called by a drop routine, which the interpreter's free of a deferred reply stands for")
end 'entryReplyDrop'

// entryReplyDropString is a native drop routine's call of the runtime, which the interpreter's free of a deferred reply
// stands for.
function entryReplyDropString(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	panic("interp: rt.reply.dropString is called by a drop routine, which the interpreter's free of a deferred reply stands for")
end 'entryReplyDropString'

// dropDeferredReply is the free of a Reply: one that no answer finished fails its sender's await with
// ReplyStopped.serviceStopped.
function dropDeferredReply(mutates vm Vm, row Count)
	if row == 0 or vm.promises.finished[row] 'answered'
		return
	end 'answered'
	vm.promises.valueN[row] = 0
	vm.promises.valueR[row] = 0
	vm.promises.errN[row] = replyStoppedError
	vm.promises.errR[row] = 0
	finishPromise(vm, row: row)
end 'dropDeferredReply'

// waitingText says what a thread that cannot go on waits for, and where, for a report of a deadlock.
function waitingText(vm Vm, t Count) returns String
	var place = "before its first frame"
	let frames = vm.threads[t].frames.count()
	if frames > 0 'framed'
		let top = vm.threads[t].frames[frames - 1]
		place = "at {siteText(vm, site: packSite(vm.fr.fn[top], block: vm.fr.block[top], pc: vm.fr.pc[top]))}"
	end 'framed'
	return "{describeThread(vm, t: t)} waits {place}"
end 'waitingText'

// reportDeadlock is a run in which nothing can go on: no thread can run and no timer is set, while threads wait,
// behaviours are queued, or backpressure keeps behaviours muted with nothing left to unmute them (the progress check).
// It is placed where the first thread that waits is.
function reportDeadlock(mutates vm Vm)
	var text = "no thread can run and no timer is set"
	var v = Violation.make(deadlock, fn: 0, block: 0, instr: 0, message: "")
	var placed = false
	for t in 1 upto vm.threads.count() 'threads'
		if vm.threads[t].done 'done'
			continue 'threads'
		end 'done'
		text = "{text}; {waitingText(vm, t: t)}"
		let frames = vm.threads[t].frames.count()
		if not placed and frames > 0 'place'
			let top = vm.threads[t].frames[frames - 1]
			v.fn = vm.fr.fn[top]
			v.block = vm.fr.block[top]
			v.instr = vm.fr.pc[top]
			placed = true
		end 'place'
	end 'threads'
	if vm.pending.count() > 0 'queued'
		text = "{text}; {vm.pending.count()} behaviour(s) wait for cowns that never come free"
	end 'queued'
	let muted = mutedBehaviours(vm)
	for i in 0 upto muted.count() 'muted'
		let b = muted[i]
		text = "{text}; behaviour #{vm.behaviours.seq[b]} is muted until {objectText(vm, o: vm.behaviours.mutedOn[b])} catches up, which nothing left can make it do"
	end 'muted'
	v.message = text
	vm.violations.push(v)
	vm.fatal = fatalViolation
end 'reportDeadlock'

// Shedding, as the runtime's (runtime/service.maxon, "Shedding"): a behaviour of a service whose type has shedding kinds holds
// its mark as its first capture, and the service's last pending word is its horizon, the behaviour that ends the last views.
// The coin makes a start due where the service is not behind, one in coinSides, so that shed runs in ordinary programs.
let coinSides = 4 as Count

let shedRun = 0 as ir.Word

let shedDropped = 1 as ir.Word

let shedDue = 2 as ir.Word

let markPolicyUnit = 4294967296 as Count

// The captures of a behaviour of a type with shedding kinds: its mark, then its case of the message union, then the
// arguments, which with the case are the union's value a view lends.
let messageCapture = 1 as Count

// coinBehind is whether the coin makes a service behind that is not.
function coinBehind(mutates vm Vm) returns bool
	return vm.coin.intN(coinSides) == 0
end 'coinBehind'

function markOf(vm Vm, b Count) returns Count
	return ir.bitsOfWord(vm.behaviours.capturesN[b][0])
end 'markOf'

// stateService is the service whose state the address an entry is given is.
function stateService(mutates vm Vm, f ir.IrFunction, x ir.Instr, what String) returns Count
	let c = vm.address(argAt(f, x: x, i: 0))
	let service = vm.h.cellHolder[c]
	if c == 0 or vm.h.oKind[service] != kindCown 'notState'
		panic("interp: {what} is given no service's state")
	end 'notState'
	return service
end 'stateService'

// markedOf is what becomes of behaviour b, a message that starts: it runs, or it was shed, which counts it delivered once.
function markedOf(mutates vm Vm, b Count) returns ir.Word
	if markOf(vm, b: b) mod 2 == 1 'shed'
		noteShed(vm, b: b)
		return shedDropped
	end 'shed'
	noteHandled(vm, b: b)
	return shedRun
end 'markedOf'

// entryServiceShedStart is entryServiceStart of a message of a type with shedding kinds, and says whether it runs, was shed,
// or the policies' shed is due first, which is where the service is behind, or the coin says so, and no view holds it.
function entryServiceShedStart(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = stateService(vm, f: f, x: x, what: "rt.service.shedStart")
	let at = vm.h.oData[service]
	let passed = startTaken(vm.h.shareds[at])
	try unmuteEntries(vm, senders: passed)
	vm.h.shareds[at].sheds = true
	vm.threads[vm.cur].service = service
	let b = vm.threads[vm.cur].behaviour
	if vm.h.shareds[at].stoppedNow 'stopped'
		noteStopped(vm, b: b)
		giveNum(vm, x: x, n: shedStoppedWord)
		return
	end 'stopped'
	let slot = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let horizon = vm.h.shareds[at].pending[slot]
	if horizon == b 'last'
		vm.h.shareds[at].pending[slot] = 0
		let answer = markedOf(vm, b: b)
		giveNum(vm, x: x, n: answer)
		return
	end 'last'
	if horizon == 0 and (slowsSenders(vm, at: at, queued: vm.h.shareds[at].gate mod serviceClosed) or coinBehind(vm)) 'due'
		// A message of a kind no shedding policy names is never shed, so it is delivered now; another is once its mark is
		// read after the policies' shed (entryServiceShedMarked).
		if markOf(vm, b: b) / markPolicyUnit == 0 'kept'
			noteHandled(vm, b: b)
		end 'kept'
		giveNum(vm, x: x, n: shedDue)
		return
	end 'due'
	let answer = markedOf(vm, b: b)
	giveNum(vm, x: x, n: answer)
end 'entryServiceShedStart'

// entryServiceShedMarked is what becomes of the message that starts once the policies' shed has run.
function entryServiceShedMarked(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let b = vm.threads[vm.cur].behaviour
	let answer = markedOf(vm, b: b)
	giveFlag(vm, x: x, b: answer == shedDropped)
end 'entryServiceShedMarked'

// entryServiceViewOpen gives a view of the behaviours of a shedding policy's kinds queued on the service, from the one that
// starts up to the horizon, which the first view of a start sets to the newest queued.
function entryServiceViewOpen(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let service = stateService(vm, f: f, x: x, what: "rt.service.viewOpen")
	let at = vm.h.oData[service]
	let slot = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	let policy = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 2))
	let queue = vm.h.shareds[at].queue.clone()
	if queue.count() == 0 or queue[0] != vm.threads[vm.cur].behaviour 'head'
		panic("interp: a view of a service whose message that starts is not first in its queue")
	end 'head'
	if vm.h.shareds[at].pending[slot] == 0 'tail'
		vm.h.shareds[at].pending[slot] = queue[try queue.count() - 1 otherwise panic("interp: a view of an empty queue")]
	end 'tail'
	let last = vm.h.shareds[at].pending[slot]
	var held = CountList.create(0)
	for i in 0 upto queue.count() 'queue'
		let b = queue[i]
		if markOf(vm, b: b) / markPolicyUnit == policy 'mine'
			held.push(b)
		end 'mine'
		if b == last 'end'
			break 'queue'
		end 'end'
	end 'queue'
	let view = vm.views.count()
	vm.views.push(held)
	giveNum(vm, x: x, n: ir.wordOfBits(view))
end 'entryServiceViewOpen'

function entryServiceViewCount(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let view = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 0))
	giveNum(vm, x: x, n: ir.wordOfBits(vm.views[view].count()))
end 'entryServiceViewCount'

// entryServiceViewMessages gives the messages of a view as the runtime does, an array of values of the message union: a box
// for each, of its case and the arguments its behaviour holds, which its cells hold until the view is closed.
function entryServiceViewMessages(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let view = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 0))
	let arr = newArray(vm)
	for i in 0 upto vm.views[view].count() 'messages'
		let b = vm.views[view][i]
		let message = try messageBox(vm, b: b)
		let cell = vm.h.newCell(arr)
		vm.h.cellR[cell] = try message as ir.Word otherwise panic("interp: a handle past a word")
		vm.h.oOwner[message] = cell
		vm.h.elements[vm.h.oData[arr]].push(cell)
	end 'messages'
	while vm.viewArrays.count() <= view 'grow'
		vm.viewArrays.push(0)
	end 'grow'
	vm.viewArrays[view] = arr
	giveRef(vm, x: x, o: arr)
end 'entryServiceViewMessages'

// messageBox is a box of the message behaviour b holds: its case, and then each argument at the word the union's layout
// gives it, two for a String and one for any other. The arguments are in flight in the behaviour, so the box's cells hold
// them while the view lends the box, and a clone of the message copies them as the executable's does.
function messageBox(mutates vm Vm, b Count) returns Count throws Halt
	var words = 1 as Count
	let past = argumentsPast(vm, b: b)
	for k in messageCapture + 1 upto past 'size'
		words = try words + capturedWords(vm, b: b, k: k) otherwise panic("interp: a message past memory")
	end 'size'
	let message = vm.h.newBox(words, site: vm.site())
	vm.h.cellN[vm.h.field(message, i: 0)] = vm.behaviours.capturesN[b][messageCapture]
	var at = 1 as Count
	for k in messageCapture + 1 upto past 'args'
		let c = vm.h.field(message, i: at)
		let r = vm.behaviours.capturesR[b][k]
		if r > 0 'held'
			try adopt(vm, c: c, o: r as Count, what: "a view's message")
		end 'held' else 'word'
			vm.h.cellN[c] = vm.behaviours.capturesN[b][k]
			vm.h.cellR[c] = r
		end 'word'
		at = try at + capturedWords(vm, b: b, k: k) otherwise panic("interp: a message past memory")
	end 'args'
	return message
end 'messageBox'

// argumentsPast is where the arguments of the message behaviour b holds end among its captures: at the cell of its reply, the
// one promise a message's behaviour holds, since no argument is or holds one.
function argumentsPast(vm Vm, b Count) returns Count
	let n = vm.behaviours.capturesR[b].count()
	if n > messageCapture + 1 'some'
		let last = vm.behaviours.capturesR[b][n - 1]
		if last > 0 and vm.h.oKind[last as Count] == kindPromise 'cell'
			return n - 1
		end 'cell'
	end 'some'
	return n
end 'argumentsPast'

// capturedWords is how many words the capture k of behaviour b takes in a box: two for a String, one for any other value.
function capturedWords(vm Vm, b Count, k Count) returns Count
	let r = vm.behaviours.capturesR[b][k]
	if r > 0 and vm.h.oKind[r as Count] == kindString 'string'
		return 2
	end 'string'
	return 1
end 'capturedWords'

// entryServiceViewClose ends a view: its messages, which the array of its messages lends, leave the array, which the drop of
// the view frees then, as the runtime's does.
function entryServiceViewClose(mutates vm Vm, f ir.IrFunction, x ir.Instr) throws Halt
	let view = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 0))
	vm.views[view] = CountList.create(0)
	if view >= vm.viewArrays.count() or vm.viewArrays[view] == 0 'none'
		return
	end 'none'
	let arr = vm.viewArrays[view]
	vm.viewArrays[view] = 0
	let data = vm.h.oData[arr]
	let cells = vm.h.elements[data].clone()
	vm.h.elements[data] = CountList.create(0)
	let version = vm.h.nextVersion()
	vm.h.oVersion[arr] = version
	for i in 0 upto cells.count() 'messages'
		let c = cells[i]
		let message = vm.h.refOf(c)
		vm.h.cellN[c] = 0
		vm.h.cellR[c] = 0
		giveBackArguments(vm, message: message)
		try free(vm, o: message)
		vm.h.givePlaceUp(arr, c: c)
	end 'messages'
end 'entryServiceViewClose'

// giveBackArguments empties the cells of a view's message, whose arguments go back in flight in their behaviour, which
// drops or runs them.
function giveBackArguments(mutates vm Vm, message Count)
	for i in 1 upto vm.h.oSize[message] 'cells'
		let c = vm.h.field(message, i: i)
		let o = vm.h.refOf(c)
		if o != 0 and not vm.h.oImmortal[o] 'held'
			if vm.h.isShared(o) 'shared'
				vm.h.removeHolder(o, c: c)
			end 'shared' else 'owned'
				vm.h.oOwner[o] = 0
			end 'owned'
		end 'held'
		vm.h.cellN[c] = 0
		vm.h.cellR[c] = 0
	end 'cells'
end 'giveBackArguments'

// viewBehaviour is the behaviour of a view at an index, which the library holds below the view's count.
function viewBehaviour(vm Vm, f ir.IrFunction, x ir.Instr) returns Count
	let view = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 0))
	let index = ir.bitsOfWord(argNum(vm, f: f, x: x, i: 1))
	if index >= vm.views[view].count() 'past'
		panic("interp: a view's message past its count")
	end 'past'
	return vm.views[view][index]
end 'viewBehaviour'

function entryServiceViewMark(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let b = viewBehaviour(vm, f: f, x: x)
	let mark = markOf(vm, b: b)
	let kept = try mark - mark mod 2 otherwise panic("interp: a mark below its own bit")
	if argNum(vm, f: f, x: x, i: 2) != 0 'shed'
		vm.behaviours.capturesN[b][0] = ir.wordOfBits(try kept + 1 otherwise panic("interp: a mark past a word"))
		return
	end 'shed'
	vm.behaviours.capturesN[b][0] = ir.wordOfBits(kept)
end 'entryServiceViewMark'

function entryServiceViewMarked(mutates vm Vm, f ir.IrFunction, x ir.Instr)
	let b = viewBehaviour(vm, f: f, x: x)
	giveFlag(vm, x: x, b: markOf(vm, b: b) mod 2 == 1)
end 'entryServiceViewMarked'
