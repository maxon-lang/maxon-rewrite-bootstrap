// Spilling's tests: functions written by hand in machine IR, each a shape of the allocator study in miniature, go through
// backend.spillFunction; the result is held to verifyPressure (every instruction fits its free registers, and no spill
// code stands in a loop that neither defines nor reads its value) and to the number of stores and reloads it may have,
// on the hot path and in all; then colouring finishes it and it runs, which shows the values came through.

typealias WordList = Array with FullRangeInt

// spillIterations is how many times the loops of these tests run.
let spillIterations = 10

// exitMask keeps a sum within an exit code.
let exitMask = 255

// mirValue is a register holding n that is not a constant: the sum of a constant and 0, so spilling must store it.
function mirValue(mutates fn backend.MirFunction, n FullRangeInt) returns backend.MReg
	let c = mirConst(fn, value: n)
	return mirAddImm(fn, left: c, imm: 0)
end 'mirValue'

function mirSar(mutates fn backend.MirFunction, src backend.MReg) returns backend.MReg
	return mirDef(fn, form: backend.X64Form.sarRegImm8, b: src, c: backend.noMReg, imm: 1)
end 'mirSar'

// mirReturnMasked returns the low byte of a value.
function mirReturnMasked(mutates fn backend.MirFunction, value backend.MReg)
	let masked = mirDef(fn, form: backend.chooseAndRegImm(exitMask), b: value, c: backend.noMReg, imm: exitMask)
	mirReturn(fn, value: masked)
end 'mirReturnMasked'

function exitOf(n FullRangeInt) returns ExitCode
	let low = try (n and exitMask) as Count otherwise panic("a negative sum")
	return try low as ExitCode otherwise panic("an exit code past a byte")
end 'exitOf'

function wrapAdd(a FullRangeInt, b FullRangeInt) returns FullRangeInt
	return try a + b otherwise panic("a test sum past 64 bits")
end 'wrapAdd'

// spillOf spills a function and requires it to fit and to have no refusal.
function spillOf(label String, mutates fn backend.MirFunction) returns backend.SpillResult
	var s = backend.Spiller.new()
	let result = backend.spillFunction(fn, s: s)
	if result.refusals.count() > 0 'refused'
		panic("{label}: refused with E5001: {backend.pressureRefusalMessage(result.refusals[0], place: label, target: "x64")}")
	end 'refused'
	let problems = backend.verifyPressure(fn)
	if problems.count() > 0 'problems'
		panic("{label}: {problems[0]}")
	end 'problems'
	return result
end 'spillOf'

function expectCount(label String, what String, got Count, want Count)
	if got != want 'differs'
		panic("{label}: {got} {what}, not {want}")
	end 'differs'
end 'expectCount'

// expectSpillCode requires a spilled function's spills and reloads, in all and on the hot path, and its restores.
function expectSpillCode(label String, fn backend.MirFunction, spills Count, reloads Count, hotSpills Count, hotReloads Count, restores Count)
	let counts = backend.spillCodeCounts(fn)
	expectCount(label, what: "spills", got: counts.spills, want: spills)
	expectCount(label, what: "reloads", got: counts.reloads, want: reloads)
	expectCount(label, what: "spills on the hot path", got: counts.hotSpills, want: hotSpills)
	expectCount(label, what: "reloads on the hot path", got: counts.hotReloads, want: hotReloads)
	expectCount(label, what: "restores", got: counts.restores, want: restores)
end 'expectSpillCode'

// LoopShape is a counted loop with accumulators, as the study's kernels are: before the loop, `idle` values that only
// the code after it reads, and a bound in a register; in it, accumulator j becomes itself plus half of accumulator j + 1
// (the last one taking the first's new value), `memory` of them kept in spill slots by hand; and after it, the sum of
// everything. call puts a call of mir.double in the loop (in a cold block of its own with coldCall), whose result the
// first accumulator adds; coldUse is a value defined before the loop that only a cold block in it reads.
type LoopShape
	var accs as Count
	var memory as Count
	var idle as Count
	var call as bool
	var coldCall as bool
	var coldUse as bool

	static function make(accs Count, memory Count, idle Count) returns LoopShape
		return LoopShape{accs: accs, memory: memory, idle: idle, call: false, coldCall: false, coldUse: false}
	end 'make'
end 'LoopShape'

function accStart(j Count) returns FullRangeInt
	return try (j * 3 + 1) as FullRangeInt otherwise panic("an accumulator past 64 bits")
end 'accStart'

function idleStart(j Count) returns FullRangeInt
	return try (j * 7 + 2) as FullRangeInt otherwise panic("a value past 64 bits")
end 'idleStart'

// coldEvery is the bit of the counter that sends an iteration through the cold block.
let coldEvery = 4

// loopExpected is what the loop of a shape returns, worked out directly.
function loopExpected(shape LoopShape) returns ExitCode
	var a = WordList.create(0)
	for j in 0 upto shape.accs 'start'
		a.push(accStart(j))
	end 'start'
	for i in 0 upto spillIterations 'iterations'
		for j in 0 upto shape.accs 'accs'
			let next = nextAcc(j, accs: shape.accs)
			a[j] = wrapAdd(a[j], b: a[next] / 2)
		end 'accs'
		if shape.call and (not shape.coldCall or (i / coldEvery) mod 2 == 1) 'call'
			a[0] = wrapAdd(a[0], b: try (i * 2) as FullRangeInt otherwise panic("a counter past 64 bits"))
		end 'call'
	end 'iterations'
	var sum = 0 as FullRangeInt
	for j in 0 upto shape.accs 'sum'
		sum = wrapAdd(sum, b: a[j])
	end 'sum'
	for j in 0 upto shape.idle 'idle'
		sum = wrapAdd(sum, b: idleStart(j))
	end 'idle'
	if shape.coldUse 'coldUse'
		sum = wrapAdd(sum, b: coldUseValue)
	end 'coldUse'
	return exitOf(sum)
end 'loopExpected'

let coldUseValue = 5

// mirShapedLoop builds the loop of a shape.
function mirShapedLoop(symbol String, shape LoopShape) returns backend.MirFunction
	var fn = backend.MirFunction.new(symbol, canThrow: false)
	let header = 1 as backend.MBlockID
	let body = 2 as backend.MBlockID
	let exit = 3 as backend.MBlockID
	let cold = 4 as backend.MBlockID
	let rejoin = 5 as backend.MBlockID
	let registers = try shape.accs - shape.memory otherwise panic("more accumulators in memory than there are")
	fn.spillSlots = shape.memory
	_ = fn.startBlock()
	fn.emit(backend.newFrameSetup())
	var idle = backend.MRegList.create(0)
	for j in 0 upto shape.idle 'idle'
		idle.push(mirValue(fn, n: idleStart(j)))
	end 'idle'
	var coldValue = backend.noMReg
	if shape.coldUse 'coldValue'
		coldValue = mirValue(fn, n: coldUseValue)
	end 'coldValue'
	let bound = mirValue(fn, n: spillIterations as FullRangeInt)
	var args = backend.MRegList.create(0)
	args.push(mirConst(fn, value: 0))
	for j in 0 upto shape.accs 'start'
		let v = mirValue(fn, n: accStart(j))
		if j < registers 'register'
			args.push(v)
		end 'register' else 'memory'
			fn.emit(backend.newSpill(v, slot: try (j - registers) as backend.SpillSlot otherwise panic("a slot below 0")))
		end 'memory'
	end 'start'
	mirJump(fn, target: header, args: args)
	_ = fn.startBlock()
	let i = fn.addParam(backend.RegClass.gpr)
	var acc = backend.MRegList.create(0)
	for j in 0 upto registers 'params'
		acc.push(fn.addParam(backend.RegClass.gpr))
	end 'params'
	mirOp(fn, form: backend.X64Form.cmpRegReg, a: i, b: bound, c: backend.noMReg, imm: 0)
	mirBranch(fn, cond: backend.X64CondCode.greaterEqual, target: exit, args: backend.MRegList.create(0))
	mirJump(fn, target: body, args: backend.MRegList.create(0))
	_ = fn.startBlock()
	var current = acc.clone()
	for j in 0 upto shape.accs 'update'
		let next = nextAcc(j, accs: shape.accs)
		let source = accRead(fn, current: current, j: next, registers: registers)
		let half = mirSar(fn, src: source)
		let old = accRead(fn, current: current, j: j, registers: registers)
		let sum = mirAdd(fn, left: old, right: half)
		if j < registers 'register'
			current[j] = sum
		end 'register' else 'memory'
			fn.emit(backend.newSpill(sum, slot: try (j - registers) as backend.SpillSlot otherwise panic("a slot below 0")))
		end 'memory'
	end 'update'
	let step = mirAddImm(fn, left: i, imm: 1)
	if shape.call or shape.coldUse 'branches'
		var through = backend.MRegList.create(0)
		through.push(step)
		for j in 0 upto registers 'through'
			through.push(current[j])
		end 'through'
		if shape.call and not shape.coldCall 'hotCall'
			let doubled = mirCallDouble(fn, value: i)
			current[0] = mirAdd(fn, left: current[0], right: doubled)
			through[1] = current[0]
			mirJump(fn, target: header, args: through)
		end 'hotCall' else 'cold'
			let bit = mirDef(fn, form: backend.chooseAndRegImm(coldEvery), b: i, c: backend.noMReg, imm: coldEvery as FullRangeInt)
			mirOp(fn, form: backend.chooseCmpRegImm(0), a: bit, b: backend.noMReg, c: backend.noMReg, imm: 0)
			mirBranch(fn, cond: backend.X64CondCode.notEqual, target: cold, args: backend.MRegList.create(0))
			mirJump(fn, target: header, args: through)
		end 'cold'
	end 'branches' else 'plain'
		var back = backend.MRegList.create(0)
		back.push(step)
		for j in 0 upto registers 'back'
			back.push(current[j])
		end 'back'
		mirJump(fn, target: header, args: back)
	end 'plain'
	_ = fn.startBlock()
	var total = mirConst(fn, value: 0)
	for j in 0 upto shape.accs 'sum'
		let value = accRead(fn, current: acc, j: j, registers: registers)
		total = mirAdd(fn, left: total, right: value)
	end 'sum'
	for j in 0 upto idle.count() 'idleSum'
		total = mirAdd(fn, left: total, right: idle[j])
	end 'idleSum'
	if shape.coldUse 'coldSum'
		total = mirAdd(fn, left: total, right: coldValue)
	end 'coldSum'
	mirReturnMasked(fn, value: total)
	if (shape.call and shape.coldCall) or shape.coldUse 'coldBlock'
		_ = fn.startBlock()
		fn.blocks[cold as Count].likelihood = backend.Likelihood.cold
		var extra = mirConst(fn, value: 0)
		if shape.call 'call'
			extra = mirCallDouble(fn, value: i)
		end 'call'
		if shape.coldUse 'use'
			let junk = mirAdd(fn, left: coldValue, right: coldValue)
			let none = mirDef(fn, form: backend.chooseAndRegImm(0), b: junk, c: backend.noMReg, imm: 0)
			extra = mirAdd(fn, left: extra, right: none)
		end 'use'
		let first = mirAdd(fn, left: current[0], right: extra)
		var through = backend.MRegList.create(0)
		through.push(step)
		through.push(first)
		for j in 1 upto registers 'through'
			through.push(current[j])
		end 'through'
		mirJump(fn, target: rejoin, args: through)
		_ = fn.startBlock()
		var params = backend.MRegList.create(0)
		for j in 0 upto nextOf(registers) 'params'
			params.push(fn.addParam(backend.RegClass.gpr))
		end 'params'
		mirJump(fn, target: header, args: params)
	end 'coldBlock'
	fn.endBlock()
	return fn
end 'mirShapedLoop'

// nextAcc is the accumulator whose half accumulator j adds: the next one, the first after the last.
function nextAcc(j Count, accs Count) returns Count
	let next = nextOf(j)
	if next == accs 'wrap'
		return 0
	end 'wrap'
	return next
end 'nextAcc'

function addCounts2(a Count, b Count) returns Count
	return try a + b otherwise panic("a count past memory")
end 'addCounts2'

function nextOf(n Count) returns Count
	return try n + 1 otherwise panic("a count past memory")
end 'nextOf'

// accRead is the current value of accumulator j: its register, or a reload of its slot.
function accRead(mutates fn backend.MirFunction, current backend.MRegList, j Count, registers Count) returns backend.MReg
	if j < registers 'register'
		return current[j]
	end 'register'
	let v = mirGpr(fn)
	fn.emit(backend.newReload(v, slot: try (j - registers) as backend.SpillSlot otherwise panic("a slot below 0")))
	return v
end 'accRead'

// mirCallDouble calls mir.double on a value, which the internal convention passes on the stack, and gives its result.
function mirCallDouble(mutates fn backend.MirFunction, value backend.MReg) returns backend.MReg
	mirOp(fn, form: backend.X64Form.pushReg, a: value, b: backend.noMReg, c: backend.noMReg, imm: 0)
	let callee = fn.addSymbol(mirDoubleSymbol)
	fn.emit(backend.newReferring(backend.X64Form.callRel32, a: backend.noMReg, ref: backend.MRef.symbol, aux: callee))
	let rsp = mirPhys(backend.X64Register.rsp)
	mirOp(fn, form: backend.chooseAddRegImm(8), a: rsp, b: rsp, c: backend.noMReg, imm: 8)
	return mirCopyOut(fn, src: backend.X64Register.rax)
end 'mirCallDouble'

// runSpilledLoop spills a shape's loop, holds it to its spill code, and runs it.
function runSpilledLoop(mutates p ast.Project, label String, shape LoopShape, spills Count, reloads Count, hotSpills Count, hotReloads Count, restores Count) returns backend.SpillResult
	let entry = addFunction(p, name: "main", errTy: ast.noType)
	var fn = mirShapedLoop(ast.funcLinkName(p, fid: entry), shape: shape)
	let result = spillOf(label, fn: fn)
	expectSpillCode(label, fn: fn, spills: spills, reloads: reloads, hotSpills: hotSpills, hotReloads: hotReloads, restores: restores)
	var fns = oneMir(fn)
	if shape.call 'callee'
		fns.push(mirDouble())
	end 'callee'
	runSpilledMir(p, fns: fns, entry: entry, name: "minimaxon_spill_{label}.exe", expectedCode: loopExpected(shape))
	return result
end 'runSpilledLoop'

// refusalOf spills a shape's loop and gives its refusal, which it requires there to be.
function refusalOfShape(label String, shape LoopShape) returns backend.PressureRefusal
	var fn = mirShapedLoop("refused", shape: shape)
	var s = backend.Spiller.new()
	let result = backend.spillFunction(fn, s: s)
	if result.refusals.count() != 1 'one'
		panic("{label}: {result.refusals.count()} refusals, not one")
	end 'one'
	return result.refusals[0].clone()
end 'refusalOfShape'

// The fourteen general registers x64 gives values: rsp and rbp hold the stack and the frame.
let x64Pool = 14

function testSpillFits(mutates p ast.Project)
	// Six accumulators, the counter, the bound and the half in flight: nine values, no spill at all.
	_ = runSpilledLoop(p, label: "fits", shape: LoopShape.make(6, memory: 0, idle: 0), spills: 0, reloads: 0, hotSpills: 0, hotReloads: 0, restores: 0)
	let entry = addFunction(p, name: "main", errTy: ast.noType)
	var fn = mirLoop(ast.funcLinkName(p, fid: entry))
	_ = spillOf("mirLoop", fn: fn)
	expectSpillCode("mirLoop", fn: fn, spills: 0, reloads: 0, hotSpills: 0, hotReloads: 0, restores: 0)
	runSpilledMir(p, fns: oneMir(fn), entry: entry, name: "minimaxon_spill_mirloop.exe", expectedCode: 136)
end 'testSpillFits'

function testSpillIdleAcrossLoop(mutates p ast.Project)
	// Ten accumulators, the counter, the bound and the half are thirteen in the loop; six values idle across it make
	// nineteen, so the five read last after the loop are stored where they are defined and reloaded after it.
	_ = runSpilledLoop(p, label: "idle", shape: LoopShape.make(10, memory: 0, idle: 6), spills: 5, reloads: 5, hotSpills: 0, hotReloads: 0, restores: 0)
end 'testSpillIdleAcrossLoop'

function testSpillColdUse(mutates p ast.Project)
	// Eleven accumulators with the counter, the bound and the half are fourteen, and a value read only by a cold block
	// of the loop would make fifteen: it is stored before the loop and reloaded in the cold block and after the loop,
	// off the hot path. The cold block itself then holds fifteen at one point, so it lends the bound's register for
	// it with a bracket, which leaves the hot path alone.
	var shape = LoopShape.make(11, memory: 0, idle: 0)
	shape.coldUse = true
	_ = runSpilledLoop(p, label: "colduse", shape: shape, spills: 2, reloads: 2, hotSpills: 0, hotReloads: 0, restores: 1)
end 'testSpillColdUse'

function testSpillCallInLoop(mutates p ast.Project)
	// A call keeps no register of the internal convention, so every value live across it is stored where it is defined
	// and reloaded after it: the four accumulators, the bound and the step, in the loop.
	var shape = LoopShape.make(4, memory: 0, idle: 0)
	shape.call = true
	_ = runSpilledLoop(p, label: "call", shape: shape, spills: 6, reloads: 6, hotSpills: 5, hotReloads: 6, restores: 0)
	// In a cold block the same call brackets the values live across it, and the hot path keeps them in registers.
	var cold = LoopShape.make(4, memory: 0, idle: 0)
	cold.call = true
	cold.coldCall = true
	_ = runSpilledLoop(p, label: "coldcall", shape: cold, spills: 6, reloads: 0, hotSpills: 0, hotReloads: 0, restores: 6)
end 'testSpillCallInLoop'

function testSpillRefusal(mutates p ast.Project)
	// Sixteen accumulators, the counter and the bound are eighteen, and the half makes nineteen at the worst point,
	// five over x64's fourteen. An accumulator in memory still needs a register where it is read and where it is
	// written, so at its own update it frees none: six must go, and five do not do.
	let shape = LoopShape.make(16, memory: 0, idle: 0)
	let r = refusalOfShape("press", shape: shape)
	expectCount("press", what: "registers held at the worst point", got: r.held, want: 19)
	expectCount("press", what: "registers available", got: r.available, want: x64Pool)
	expectCount("press", what: "values the lower bound asks for", got: r.bound, want: 5)
	expectCount("press", what: "values that must go", got: r.needed, want: 6)
	let text = backend.pressureRefusalMessage(r, place: "press.maxon:3", target: "x64")
	let want = "the loop at press.maxon:3 needs 5 more register(s) than are available: 19 values must be held in general-purpose registers at once inside this loop, but x64 has only 14; remove 6 of them from the loop, for example by holding them in an array that the loop indexes"
	if text != want 'message'
		panic("press: the message is '{text}'")
	end 'message'
	let short = refusalOfShape("press5", shape: LoopShape.make(16, memory: 5, idle: 0))
	expectCount("press5", what: "values that must go", got: short.needed, want: 1)
	// With six in memory it fits, and spilling adds nothing to the spill code written by hand: six stores before the
	// loop and six in it, and per accumulator in memory two reloads in the loop and one after it.
	let fits = runSpilledLoop(p, label: "press6", shape: LoopShape.make(16, memory: 6, idle: 0), spills: 12, reloads: 18, hotSpills: 6, hotReloads: 12, restores: 0)
	expectCount("press6", what: "stores spilling added", got: fits.stores, want: 0)
	expectCount("press6", what: "reloads spilling added", got: addCounts2(fits.reloads, b: fits.remats), want: 0)
end 'testSpillRefusal'

// nestedAccs is how many accumulators the inner loop of the nested test carries: with its counter, the outer counter
// it reads, the half in flight and the outer-only value, fifteen values, one over x64's pool.
let nestedAccs = 11

// outerIterations is how many times the outer loop of the nested test runs.
let outerIterations = 3

// mirNested is two loops: the inner one updates the accumulators and reads the outer counter; the outer one carries a
// value w that only it reads, after the inner loop, idle across the inner loop's peak.
function mirNested(symbol String) returns backend.MirFunction
	var fn = backend.MirFunction.new(symbol, canThrow: false)
	let outer = 1 as backend.MBlockID
	let inner = 2 as backend.MBlockID
	let body = 3 as backend.MBlockID
	let latch = 4 as backend.MBlockID
	let exit = 5 as backend.MBlockID
	_ = fn.startBlock()
	fn.emit(backend.newFrameSetup())
	var args = backend.MRegList.create(0)
	args.push(mirConst(fn, value: 0))
	args.push(mirValue(fn, n: 1))
	for j in 0 upto nestedAccs 'start'
		args.push(mirValue(fn, n: accStart(j)))
	end 'start'
	mirJump(fn, target: outer, args: args)
	_ = fn.startBlock()
	let j = fn.addParam(backend.RegClass.gpr)
	let w = fn.addParam(backend.RegClass.gpr)
	var outerAcc = backend.MRegList.create(0)
	for k in 0 upto nestedAccs 'outerParams'
		outerAcc.push(fn.addParam(backend.RegClass.gpr))
	end 'outerParams'
	fn.emit(backend.newTarget(backend.chooseCmpRegImm(outerIterations), a: j, b: backend.noMReg, c: backend.noMReg, aux: 0, imm: outerIterations as FullRangeInt))
	mirBranch(fn, cond: backend.X64CondCode.greaterEqual, target: exit, args: backend.MRegList.create(0))
	var into = backend.MRegList.create(0)
	into.push(mirConst(fn, value: 0))
	for k in 0 upto nestedAccs 'into'
		into.push(outerAcc[k])
	end 'into'
	mirJump(fn, target: inner, args: into)
	_ = fn.startBlock()
	let i = fn.addParam(backend.RegClass.gpr)
	var acc = backend.MRegList.create(0)
	for k in 0 upto nestedAccs 'innerParams'
		acc.push(fn.addParam(backend.RegClass.gpr))
	end 'innerParams'
	fn.emit(backend.newTarget(backend.chooseCmpRegImm(spillIterations), a: i, b: backend.noMReg, c: backend.noMReg, aux: 0, imm: spillIterations as FullRangeInt))
	mirBranch(fn, cond: backend.X64CondCode.greaterEqual, target: latch, args: backend.MRegList.create(0))
	mirJump(fn, target: body, args: backend.MRegList.create(0))
	_ = fn.startBlock()
	var current = acc.clone()
	for k in 0 upto nestedAccs 'update'
		let half = mirSar(fn, src: current[(k + 1) mod nestedAccs])
		current[k] = mirAdd(fn, left: current[k], right: half)
	end 'update'
	current[0] = mirAdd(fn, left: current[0], right: j)
	var back = backend.MRegList.create(0)
	back.push(mirAddImm(fn, left: i, imm: 1))
	for k in 0 upto nestedAccs 'back'
		back.push(current[k])
	end 'back'
	mirJump(fn, target: inner, args: back)
	_ = fn.startBlock()
	let nextW = mirAdd(fn, left: w, right: j)
	var round = backend.MRegList.create(0)
	round.push(mirAddImm(fn, left: j, imm: 1))
	round.push(nextW)
	for k in 0 upto nestedAccs 'round'
		round.push(acc[k])
	end 'round'
	mirJump(fn, target: outer, args: round)
	_ = fn.startBlock()
	var total = w
	for k in 0 upto nestedAccs 'sum'
		total = mirAdd(fn, left: total, right: outerAcc[k])
	end 'sum'
	mirReturnMasked(fn, value: total)
	fn.endBlock()
	return fn
end 'mirNested'

function nestedExpected() returns ExitCode
	var a = WordList.create(0)
	for k in 0 upto nestedAccs 'start'
		a.push(accStart(k))
	end 'start'
	var w = 1 as FullRangeInt
	for j in 0 upto outerIterations 'outer'
		for i in 0 upto spillIterations 'inner'
			for k in 0 upto nestedAccs 'update'
				a[k] = wrapAdd(a[k], b: a[(k + 1) mod nestedAccs] / 2)
			end 'update'
			a[0] = wrapAdd(a[0], b: j as FullRangeInt)
		end 'inner'
		w = wrapAdd(w, b: j as FullRangeInt)
	end 'outer'
	var total = w
	for k in 0 upto nestedAccs 'sum'
		total = wrapAdd(total, b: a[k])
	end 'sum'
	return exitOf(total)
end 'nestedExpected'

function testSpillNested(mutates p ast.Project)
	// The outer-only value is idle across the inner loop: it is stored where the outer loop defines it and reloaded
	// after the inner loop, so the inner loop fits and nothing is spilled in it.
	let entry = addFunction(p, name: "main", errTy: ast.noType)
	var fn = mirNested(ast.funcLinkName(p, fid: entry))
	_ = spillOf("nested", fn: fn)
	expectSpillCode("nested", fn: fn, spills: 1, reloads: 1, hotSpills: 1, hotReloads: 1, restores: 0)
	runSpilledMir(p, fns: oneMir(fn), entry: entry, name: "minimaxon_spill_nested.exe", expectedCode: nestedExpected())
end 'testSpillNested'

// straightValues is how many values the straight-line test holds at once.
let straightValues = 24

function testSpillStraightLine(mutates p ast.Project)
	// x1 to x24, each x(k) + k, then their sum from x24 down: at its peak 24 values are live, so the ten read last are
	// spilled by farthest next use, each stored once and reloaded once.
	let entry = addFunction(p, name: "main", errTy: ast.noType)
	var fn = backend.MirFunction.new(ast.funcLinkName(p, fid: entry), canThrow: false)
	_ = fn.startBlock()
	fn.emit(backend.newFrameSetup())
	var xs = backend.MRegList.create(0)
	xs.push(mirValue(fn, n: 1))
	var expected = 1 as FullRangeInt
	var x = 1 as FullRangeInt
	for k in 1 upto straightValues 'values'
		xs.push(mirAddImm(fn, left: xs[k - 1], imm: try k as backend.Imm32 otherwise panic("a step past 32 bits")))
		x = wrapAdd(x, b: k as FullRangeInt)
		expected = wrapAdd(expected, b: x)
	end 'values'
	var total = xs[straightValues - 1]
	var k = (straightValues - 1) as Count
	while k > 0 'sum'
		k = k - 1
		total = mirAdd(fn, left: total, right: xs[k])
	end 'sum'
	mirReturnMasked(fn, value: total)
	fn.endBlock()
	let result = spillOf("straight", fn: fn)
	expectSpillCode("straight", fn: fn, spills: 10, reloads: 10, hotSpills: 0, hotReloads: 0, restores: 0)
	expectCount("straight", what: "slots", got: fn.spillSlots, want: 10)
	expectCount("straight", what: "stores counted", got: result.stores, want: 10)
	runSpilledMir(p, fns: oneMir(fn), entry: entry, name: "minimaxon_spill_straight.exe", expectedCode: exitOf(expected))
end 'testSpillStraightLine'

// fixedLive is how many values the tests of fixed registers keep live across them: with the operands, one over what a
// division (rax and rdx fixed) or a shift (rcx fixed) leaves.
let fixedLive = 13

function testSpillFixedRegisters(mutates p ast.Project)
	// Thirteen values live across a division by a register: rax and rdx hold the dividend and the result, and two of
	// the values are spilled.
	let entry = addFunction(p, name: "main", errTy: ast.noType)
	var fn = backend.MirFunction.new(ast.funcLinkName(p, fid: entry), canThrow: false)
	_ = fn.startBlock()
	fn.emit(backend.newFrameSetup())
	var live = backend.MRegList.create(0)
	var expected = 0 as FullRangeInt
	for k in 0 upto fixedLive 'values'
		live.push(mirValue(fn, n: idleStart(k)))
		expected = wrapAdd(expected, b: idleStart(k))
	end 'values'
	let dividend = mirValue(fn, n: 100)
	let divisor = mirValue(fn, n: 7)
	mirCopyIn(fn, dst: backend.X64Register.rax, src: dividend)
	mirOp(fn, form: backend.X64Form.cqo, a: backend.noMReg, b: backend.noMReg, c: backend.noMReg, imm: 0)
	mirOp(fn, form: backend.X64Form.idivReg, a: divisor, b: backend.noMReg, c: backend.noMReg, imm: 0)
	let quotient = mirCopyOut(fn, src: backend.X64Register.rax)
	let remainder = mirCopyOut(fn, src: backend.X64Register.rdx)
	var total = mirAdd(fn, left: quotient, right: remainder)
	for k in 0 upto fixedLive 'sum'
		total = mirAdd(fn, left: total, right: live[k])
	end 'sum'
	mirReturnMasked(fn, value: total)
	fn.endBlock()
	_ = spillOf("division", fn: fn)
	expectSpillCode("division", fn: fn, spills: 2, reloads: 2, hotSpills: 0, hotReloads: 0, restores: 0)
	runSpilledMir(p, fns: oneMir(fn), entry: entry, name: "minimaxon_spill_division.exe", expectedCode: exitOf(wrapAdd(expected, b: 16)))
	// The same with a shift by a count in rcx.
	let shiftEntry = addFunction(p, name: "main", errTy: ast.noType)
	var shift = backend.MirFunction.new(ast.funcLinkName(p, fid: shiftEntry), canThrow: false)
	_ = shift.startBlock()
	shift.emit(backend.newFrameSetup())
	var held = backend.MRegList.create(0)
	for k in 0 upto fixedLive 'values'
		held.push(mirValue(shift, n: idleStart(k)))
	end 'values'
	let five = mirValue(shift, n: 5)
	let count = mirValue(shift, n: 3)
	mirCopyIn(shift, dst: backend.X64Register.rcx, src: count)
	let shifted = mirDef(shift, form: backend.X64Form.shlRegCl, b: five, c: backend.noMReg, imm: 0)
	var sum = shifted
	for k in 0 upto fixedLive 'sum'
		sum = mirAdd(shift, left: sum, right: held[k])
	end 'sum'
	mirReturnMasked(shift, value: sum)
	shift.endBlock()
	_ = spillOf("shift", fn: shift)
	expectSpillCode("shift", fn: shift, spills: 2, reloads: 2, hotSpills: 0, hotReloads: 0, restores: 0)
	runSpilledMir(p, fns: oneMir(shift), entry: shiftEntry, name: "minimaxon_spill_shift.exe", expectedCode: exitOf(wrapAdd(expected, b: 40)))
end 'testSpillFixedRegisters'

function testSpilling()
	var p = ast.Project.new("self")
	_ = ast.addModule(p, m: ast.Module.new(0 as diag.ModuleID, path: "", text: "", files: ast.FileSpanList.create(0)))
	testSpillFits(p)
	testSpillIdleAcrossLoop(p)
	testSpillColdUse(p)
	testSpillCallInLoop(p)
	testSpillRefusal(p)
	testSpillNested(p)
	testSpillStraightLine(p)
	testSpillFixedRegisters(p)
	testSpillScale()
end 'testSpilling'

// scaleSegments is how many segments the synthetic function of the scale test has, and scaleAccs and scaleStraight
// how many accumulators its loops carry and how many values its straight-line code holds at once.
let scaleSegments = 100

let scaleAccs = 8

let scaleStraight = 20

// scaleBlocks is how many blocks a segment of the scale test adds: a loop's header and body, straight-line code that
// branches, a cold block that calls, and the join.
let scaleBlocks = 5

// mirScale is a synthetic function of many segments, each a loop that fits, straight-line code over its pool, and a
// cold call, which the scale test spills to see that the work stays near linear.
function mirScale(segments Count, straight Count) returns backend.MirFunction
	var fn = backend.MirFunction.new("scale", canThrow: false)
	_ = fn.startBlock()
	fn.emit(backend.newFrameSetup())
	var carry = mirValue(fn, n: 1)
	for seg in 0 upto segments 'segments'
		let base = try 1 + seg * scaleBlocks otherwise panic("a block past memory")
		let header = try base as backend.MBlockID otherwise panic("a block past a branch")
		let body = try (base + 1) as backend.MBlockID otherwise panic("a block past a branch")
		let after = try (base + 2) as backend.MBlockID otherwise panic("a block past a branch")
		let cold = try (base + 3) as backend.MBlockID otherwise panic("a block past a branch")
		let join = try (base + 4) as backend.MBlockID otherwise panic("a block past a branch")
		var args = backend.MRegList.create(0)
		args.push(mirConst(fn, value: 0))
		for j in 0 upto scaleAccs 'start'
			args.push(mirAddImm(fn, left: carry, imm: try j as backend.Imm32 otherwise panic("a step past 32 bits")))
		end 'start'
		mirJump(fn, target: header, args: args)
		_ = fn.startBlock()
		let i = fn.addParam(backend.RegClass.gpr)
		var acc = backend.MRegList.create(0)
		for j in 0 upto scaleAccs 'params'
			acc.push(fn.addParam(backend.RegClass.gpr))
		end 'params'
		fn.emit(backend.newTarget(backend.chooseCmpRegImm(spillIterations), a: i, b: backend.noMReg, c: backend.noMReg, aux: 0, imm: spillIterations as FullRangeInt))
		mirBranch(fn, cond: backend.X64CondCode.greaterEqual, target: after, args: backend.MRegList.create(0))
		mirJump(fn, target: body, args: backend.MRegList.create(0))
		_ = fn.startBlock()
		var back = backend.MRegList.create(0)
		back.push(mirAddImm(fn, left: i, imm: 1))
		for j in 0 upto scaleAccs 'update'
			let half = mirSar(fn, src: acc[nextAcc(j, accs: scaleAccs)])
			back.push(mirAdd(fn, left: acc[j], right: half))
		end 'update'
		mirJump(fn, target: header, args: back)
		_ = fn.startBlock()
		var sum = acc[0]
		for j in 1 upto scaleAccs 'sum'
			sum = mirAdd(fn, left: sum, right: acc[j])
		end 'sum'
		var xs = backend.MRegList.create(0)
		xs.push(sum)
		for k in 1 upto straight 'values'
			xs.push(mirAddImm(fn, left: xs[k - 1], imm: try k as backend.Imm32 otherwise panic("a step past 32 bits")))
		end 'values'
		let last = try straight - 1 otherwise panic("no straight-line values")
		var total = xs[last]
		var k = last as Count
		while k > 0 'fold'
			k = k - 1
			total = mirAdd(fn, left: total, right: xs[k])
		end 'fold'
		mirOp(fn, form: backend.chooseCmpRegImm(0), a: total, b: backend.noMReg, c: backend.noMReg, imm: 0)
		mirBranch(fn, cond: backend.X64CondCode.equal, target: cold, args: backend.MRegList.create(0))
		var through = backend.MRegList.create(0)
		through.push(total)
		mirJump(fn, target: join, args: through)
		_ = fn.startBlock()
		fn.blocks[cold as Count].likelihood = backend.Likelihood.cold
		var called = backend.MRegList.create(0)
		called.push(mirCallDouble(fn, value: total))
		mirJump(fn, target: join, args: called)
		_ = fn.startBlock()
		carry = fn.addParam(backend.RegClass.gpr)
	end 'segments'
	mirReturnMasked(fn, value: carry)
	fn.endBlock()
	return fn
end 'mirScale'

function testSpillScale()
	var fn = mirScale(scaleSegments, straight: scaleStraight)
	var s = backend.Spiller.new()
	let result = backend.spillFunction(fn, s: s)
	if result.refusals.count() > 0 'refused'
		panic("scale: refused")
	end 'refused'
	// Each segment's straight-line code holds six values over the pool, which cost a store and a reload each; a round
	// that spills them all and one that finds nothing left are all it takes.
	let over = try scaleStraight - x64Pool otherwise panic("a pool past the values")
	expectCount("scale", what: "stores", got: result.stores, want: scaleSegments * over)
	expectCount("scale", what: "reloads", got: result.reloads, want: scaleSegments * over)
	expectCount("scale", what: "rounds", got: result.rounds, want: 2)
	let problems = backend.verifyPressure(fn)
	if problems.count() > 0 'problems'
		panic("scale: {problems[0]}")
	end 'problems'
end 'testSpillScale'
