export typealias NodeID = int(0 to 4294967295)

export typealias U16 = int(0 to 65535)

export typealias U32List = Array with diag.U32

export typealias StringList = Array with String

export type Record
	export var kind as NodeKind
	export var flags as Byte
	export var aux as U16
	export var start as diag.U32
	export var a as diag.U32
	export var b as diag.U32

	export static function make(kind NodeKind, start diag.U32) returns Record
		return Record{kind: kind, flags: 0 as Byte, aux: 0 as U16, start: start, a: 0 as diag.U32, b: 0 as diag.U32}
	end 'make'
end 'Record'

export typealias RecordList = Array with Record

function isIdentByte(b Byte) returns bool
	if b >= 65 and b <= 90 'upper'
		return true
	end 'upper'
	if b >= 97 and b <= 122 'lower'
		return true
	end 'lower'
	if b >= 48 and b <= 57 'digit'
		return true
	end 'digit'
	return b == 95
end 'isIdentByte'

// textRef is what a record holds for the name or label that starts at offset: 0 is none.
export function textRef(offset diag.U32) returns diag.U32
	return try offset + 1 otherwise panic("a text offset exceeds U32")
end 'textRef'

// The parts of a string literal are pairs of words in the tree's list array: an interpolated expression is
// partExprTag and its node, text that an escape changed is partDecodedTag and its index in the tree's strings, and a
// run of the module's text is its length plus partRunTag and its offset. An interpolated expression with a format
// specifier is partFormatTag plus the index in the tree's strings of the specifier's text, and its node, so that every tag
// from partFormatTag up is an interpolation and a run is shorter than it.
let partExprTag = 0 as diag.U32

let partDecodedTag = 1 as diag.U32

let partRunTag = 2 as diag.U32

let partFormatTag = 2147483648 as diag.U32

// StrPartsBuilder makes the parts of a string literal in a tree.
export type StrPartsBuilder
	var words as U32List

	export static function new() returns StrPartsBuilder
		return StrPartsBuilder{words: U32List.create(0)}
	end 'new'

	// run adds a run of the module's text, from offset to offset+length.
	export function run(mutates self, offset diag.U32, length diag.U32)
		let tag = try (length + partRunTag) as diag.U32 otherwise panic("a string part exceeds U32")
		if tag >= partFormatTag 'long'
			panic("a string part exceeds 2 GB")
		end 'long'
		words.push(tag)
		words.push(offset)
	end 'run'

	// decoded adds text that is not the module's text, as a string with an escape in it.
	export function decoded(mutates self, mutates t Tree, consumes text String)
		words.push(partDecodedTag)
		words.push(t.addString(text))
	end 'decoded'

	// interpolation adds an interpolated expression.
	export function interpolation(mutates self, e NodeID)
		words.push(partExprTag)
		words.push(e as diag.U32)
	end 'interpolation'

	// formatted adds an interpolated expression with the text of its format specifier.
	export function formatted(mutates self, mutates t Tree, e NodeID, consumes spec String)
		words.push(try partFormatTag + t.addString(spec) otherwise panic("a format specifier index exceeds U32"))
		words.push(e as diag.U32)
	end 'formatted'

	// finish adds the parts to the tree and gives the reference that names them.
	export function finish(consumes self, mutates t Tree) returns diag.U32
		return t.pushList(words)
	end 'finish'
end 'StrPartsBuilder'

// endKeywordToLabelName is how many bytes an end label's name lies after the 'end' that it closes: 'end', a space and an apostrophe.
let endKeywordToLabelName = 5 as diag.U32

// asKeywordToType is how many bytes the type of a cast lies after its 'as': 'as' and a space.
let asKeywordToType = 3 as diag.U32

// isDeclarationKind is whether a node declares a name that a diagnostic about it points at.
function isDeclarationKind(kind NodeKind) returns bool
	return kind == NodeKind.funcDecl or kind == NodeKind.constDecl or kind == NodeKind.typeDecl or kind == NodeKind.fieldDecl or kind == NodeKind.enumDecl or kind == NodeKind.unionDecl or kind == NodeKind.aliasDecl or kind == NodeKind.interfaceDecl or kind == NodeKind.extensionDecl
end 'isDeclarationKind'

// Tree holds a module's flat AST records, list words, escaped strings, and source text.
export type Tree
	export var module as diag.ModuleID
	export var text as String
	export var records as RecordList
	export var lists as U32List
	export var strings as StringList

	export static function new(module diag.ModuleID, consumes text String) returns Tree
		var recs = RecordList.create(0)
		recs.push(Record.make(NodeKind.none, start: 0 as diag.U32))
		var ls = U32List.create(0)
		ls.push(0 as diag.U32)
		return Tree{module: module, text: text, records: recs, lists: ls, strings: StringList.create(0)}
	end 'new'

	export function alloc(mutates self, kind NodeKind, start diag.U32) returns NodeID
		let id = try records.count() as NodeID otherwise panic("AST node count exceeded U32")
		records.push(Record.make(kind, start: start))
		return id
	end 'alloc'

	export function reserve(mutates self, words Count) returns diag.U32
		let base = try lists.count() as diag.U32 otherwise panic("AST list count exceeded U32")
		for _ in 0 upto words 'zero'
			lists.push(0 as diag.U32)
		end 'zero'
		return base
	end 'reserve'

	export function pushList(mutates self, items U32List) returns diag.U32
		let n = items.count()
		if n == 0 'empty'
			return 0 as diag.U32
		end 'empty'
		let ref = try lists.count() as diag.U32 otherwise panic("AST list count exceeded U32")
		let n32 = try n as diag.U32 otherwise panic("AST list length exceeded U32")
		lists.push(n32)
		for i in 0 upto n 'each'
			lists.push(items[i])
		end 'each'
		return ref
	end 'pushList'

	export function listLen(ref diag.U32) returns Count
		if ref == 0 'empty'
			return 0 as Count
		end 'empty'
		return lists[ref as Count] as Count
	end 'listLen'

	export function listAt(ref diag.U32, index Count) returns diag.U32
		let pos = try (ref as Count) + 1 + index otherwise panic("AST list index overflow")
		return lists[pos]
	end 'listAt'

	export function nameAt(ref diag.U32) returns String
		if ref == 0 'empty'
			return ""
		end 'empty'
		let start = (ref - 1) as Count
		var endPos = start
		let n = text.byteLength()
		while endPos < n and isIdentByte(text.byteAt(endPos)) 'scan'
			endPos = endPos + 1
		end 'scan'
		return text.sliceBytes(start, endPos: endPos)
	end 'nameAt'

	export function labelAt(ref diag.U32) returns String
		if ref == 0 'empty'
			return ""
		end 'empty'
		let start = (ref - 1) as Count
		var endPos = start
		let n = text.byteLength()
		while endPos < n and text.byteAt(endPos) != 39 'scan'
			endPos = endPos + 1
		end 'scan'
		return text.sliceBytes(start, endPos: endPos)
	end 'labelAt'

	export function kindOf(id NodeID) returns NodeKind
		return records[id as Count].kind
	end 'kindOf'

	export function startOf(id NodeID) returns diag.U32
		return records[id as Count].start
	end 'startOf'

	// reportStartOf is where a diagnostic about a node points, as maxon places it: a call at the name it calls, a
	// declaration at its name, and any other node at its start.
	export function reportStartOf(id NodeID) returns diag.U32
		if isDeclarationKind(records[id as Count].kind) 'declaration'
			return self.declNameStart(id)
		end 'declaration'
		if records[id as Count].kind != NodeKind.callExpr 'plain'
			return records[id as Count].start
		end 'plain'
		let callee = records[id as Count].a as Count
		if records[callee].kind == NodeKind.memberExpr 'member'
			return self.memberNameStart(callee as NodeID)
		end 'member'
		return records[callee].start
	end 'reportStartOf'

	// endKeywordStart is where the 'end' that an end label closes starts: the layout puts one space between it and the label's
	// apostrophe, which comes before the label's name.
	export function endKeywordStart(id NodeID) returns diag.U32
		return try records[id as Count].start - endKeywordToLabelName otherwise panic("an end label starts before its 'end'")
	end 'endKeywordStart'

	// castKeywordStart is where the 'as' of a cast starts, given the type it names.
	export function castKeywordStart(typeRef NodeID) returns diag.U32
		return try records[typeRef as Count].start - asKeywordToType otherwise panic("a cast's type starts before its 'as'")
	end 'castKeywordStart'

	// declNameStart is where the name of a declaration starts, after its modifiers and its keyword.
	export function declNameStart(id NodeID) returns diag.U32
		var at = records[id as Count].start as Count
		var after = wordEnd(text, at: at)
		while isReserved(text.sliceBytes(at, endPos: after)) 'leaders'
			at = skipSpace(text, at: after)
			after = wordEnd(text, at: at)
		end 'leaders'
		return try at as diag.U32 otherwise panic("a declaration starts past the end of its module")
	end 'declNameStart'

	// memberNameStart is where the name of a member expression starts.
	export function memberNameStart(id NodeID) returns diag.U32
		return try records[id as Count].b - 1 otherwise panic("a member expression names nothing")
	end 'memberNameStart'

	export function posOf(id NodeID) returns diag.Site
		return diag.Site.make(module, offset: records[id as Count].start)
	end 'posOf'

	export function wordAt(id NodeID, word Count) returns diag.U32
		if word == 0 'w0'
			return records[id as Count].a
		end 'w0'
		let base = records[id as Count].b as Count
		if word == 1 'w1'
			return records[id as Count].b
		end 'w1'
		let idx = try base + (word - 1) otherwise panic("AST word index overflow")
		return lists[idx]
	end 'wordAt'

	export function setWordAt(mutates self, id NodeID, word Count, value diag.U32)
		if word == 0 'w0'
			records[id as Count].a = value
			return
		end 'w0'
		let idx = try (records[id as Count].b as Count) + (word - 1) otherwise panic("AST word index overflow")
		lists[idx] = value
	end 'setWordAt'

	export function blockWordAt(id NodeID, offset Count) returns diag.U32
		let idx = try (records[id as Count].b as Count) + offset otherwise panic("AST block index overflow")
		return lists[idx]
	end 'blockWordAt'

	export function setBlockWordAt(mutates self, id NodeID, offset Count, value diag.U32)
		let idx = try (records[id as Count].b as Count) + offset otherwise panic("AST block index overflow")
		lists[idx] = value
	end 'setBlockWordAt'

	export function addString(mutates self, consumes s String) returns diag.U32
		let idx = try strings.count() as diag.U32 otherwise panic("AST string count overflow")
		strings.push(s)
		return idx
	end 'addString'

	export function strPartCount(partsRef diag.U32) returns Count
		let words = self.listLen(partsRef)
		return words / 2
	end 'strPartCount'

	export function strPartIsExpr(partsRef diag.U32, index Count) returns bool
		let tag = self.listAt(partsRef, index: try index * 2 otherwise panic("strPart index"))
		return tag == partExprTag or tag >= partFormatTag
	end 'strPartIsExpr'

	// strPartFormat is the text of the format specifier of an interpolated part, and "" for a part that has none.
	export function strPartFormat(partsRef diag.U32, index Count) returns String
		let tag = self.listAt(partsRef, index: try index * 2 otherwise panic("strPart index"))
		if tag < partFormatTag 'none'
			return ""
		end 'none'
		return strings[try (tag - partFormatTag) as Count otherwise panic("strPart format tag")].clone()
	end 'strPartFormat'

	export function strPartExpr(partsRef diag.U32, index Count) returns NodeID
		let arg = self.listAt(partsRef, index: try index * 2 + 1 otherwise panic("strPart index"))
		return arg as NodeID
	end 'strPartExpr'

	export function strPartText(partsRef diag.U32, index Count) returns String
		let base = try index * 2 otherwise panic("strPart index")
		let tag = self.listAt(partsRef, index: base)
		let arg = self.listAt(partsRef, index: try base + 1 otherwise panic("strPart index"))
		if tag == partDecodedTag 'decoded'
			return strings[arg as Count].clone()
		end 'decoded'
		let n = try (tag - partRunTag) as Count otherwise panic("strPart raw tag")
		let off = arg as Count
		return text.sliceBytes(off, endPos: try off + n otherwise panic("strPart slice overflow"))
	end 'strPartText'

	export function strIsPlain(partsRef diag.U32) returns bool
		let n = self.strPartCount(partsRef)
		for i in 0 upto n 'chk'
			if self.strPartIsExpr(partsRef, index: i) 'expr'
				return false
			end 'expr'
		end 'chk'
		return true
	end 'strIsPlain'

	export function becomeName(mutates self, target NodeID, head NodeID)
		let nameRef = records[target as Count].b
		let headStart = records[head as Count].start
		var rec = Record.make(NodeKind.nameExpr, start: headStart)
		rec.a = nameRef
		records[target as Count] = rec
	end 'becomeName'

	// becomeSelfName makes the 'self' at target a name, which a closure captures as it does any other.
	export function becomeSelfName(mutates self, target NodeID)
		let start = records[target as Count].start
		var rec = Record.make(NodeKind.nameExpr, start: start)
		rec.a = try start + 1 otherwise panic("AST name offset overflow")
		records[target as Count] = rec
	end 'becomeSelfName'

	export function appendCaptureRefs(mutates self, useNode NodeID, depth Count)
		let first = try records.count() as diag.U32 otherwise panic("AST node count overflow")
		let nRef = records[useNode as Count].a
		let st = records[useNode as Count].start
		for _ in 0 upto depth 'cap'
			let cID = self.alloc(NodeKind.nameExpr, start: st)
			records[cID as Count].a = nRef
		end 'cap'
		records[useNode as Count].b = first
	end 'appendCaptureRefs'

	export function captureRef(useNode NodeID, depth Count) returns NodeID
		let first = records[useNode as Count].b
		if first == 0 'miss'
			panic("missing capture ref")
		end 'miss'
		return try (first + (depth as diag.U32)) as NodeID otherwise panic("capture ref overflow")
	end 'captureRef'
end 'Tree'
