export type ErrorLocation
	export var file as String
	export var line as Count
	export var col as Count

	export static function make(consumes file String, line Count, col Count) returns ErrorLocation
		return ErrorLocation{file: file, line: line, col: col}
	end 'make'
end 'ErrorLocation'

// findFileIndex is the index of the file that holds offset.
export function findFileIndex(files FileSpanList, offset diag.U32) returns Count
	let n = files.count()
	if n <= 1 'one'
		return 0 as Count
	end 'one'
	var lo = 0 as Count
	var hi = n
	while lo < hi 'bs'
		let mid = try lo + (hi - lo) / 2 otherwise lo
		if files[mid].start <= offset 'le'
			lo = try mid + 1 otherwise n
		end 'le' else 'gt'
			hi = mid
		end 'gt'
	end 'bs'
	if lo == 0 'first'
		return 0 as Count
	end 'first'
	return lo - 1
end 'findFileIndex'

export function locateTextOffset(text String, files FileSpanList, offset diag.U32) returns ErrorLocation
	if files.count() == 0 'synth'
		return ErrorLocation.make("<stdlib>", line: 0 as Count, col: 0 as Count)
	end 'synth'
	return locateInFile(text, files: files, file: findFileIndex(files, offset: offset), offset: offset)
end 'locateTextOffset'

// locateInFile is the line and column of an offset in the file of the index, which is where a lexer or a parser that
// knows its file is: at the end of a file, the offset is also where the next one starts.
export function locateInFile(text String, files FileSpanList, file Count, offset diag.U32) returns ErrorLocation
	var target = offset as Count
	let beginPos = files[file].start as Count
	var endPos = files[file].endOff as Count
	let textLen = text.byteLength()
	if endPos > textLen 'clampText'
		endPos = textLen
	end 'clampText'
	if target < beginPos 'clampLo'
		target = beginPos
	end 'clampLo'
	if target > endPos 'clampHi'
		target = endPos
	end 'clampHi'
	// The line is the last whose start is at or before target; the first starts at beginPos.
	var lo = 0 as Count
	var hi = files[file].lineStarts.count()
	while hi > lo and hi - lo > 1 'search'
		let mid = try lo + (hi - lo) / 2 otherwise panic("positions: a search past its bounds")
		if files[file].lineStarts[mid] <= target 'atOrBefore'
			lo = mid
		end 'atOrBefore' else 'after'
			hi = mid
		end 'after'
	end 'search'
	let line = try lo + 1 otherwise panic("positions: a line past memory")
	let col = try (target - files[file].lineStarts[lo]) + 1 otherwise panic("positions: an offset before its line")
	return ErrorLocation.make(files[file].path.clone(), line: line, col: col)
end 'locateInFile'

export function locateModuleOffset(m Module, offset diag.U32) returns ErrorLocation
	if m.id == diag.stdlibID or m.files.count() == 0 'synth'
		return ErrorLocation.make("<stdlib>", line: 0 as Count, col: 0 as Count)
	end 'synth'
	return locateTextOffset(m.tree.text, files: m.files, offset: offset)
end 'locateModuleOffset'

// panicLocation is where a panic of the program is, as maxon's runtime names it: the last component of the file's path,
// whichever separator it uses, and the line.
export function panicLocation(m Module, offset diag.U32) returns String
	let loc = locateModuleOffset(m, offset: offset)
	return "{fileNameOf(loc.file)}:{loc.line}"
end 'panicLocation'

// fileNameOf is the last component of a path, whichever separator it uses.
export function fileNameOf(path String) returns borrowed String
	var at = path.byteLength()
	while at > 0 'back'
		let before = try at - 1 otherwise 0
		let c = path.byteAt(before)
		if c == backslashByte or c == slashByte 'separator'
			break 'back'
		end 'separator'
		at = before
	end 'back'
	return path.sliceBytes(at, endPos: path.byteLength())
end 'fileNameOf'

export function locateSite(mods ModuleList, site diag.Site) returns ErrorLocation
	if site.module < 0 'std'
		return ErrorLocation.make("<stdlib>", line: 0 as Count, col: 0 as Count)
	end 'std'
	let idx = site.module as Count
	if idx >= mods.count() 'oob'
		return ErrorLocation.make("<unknown>", line: 0 as Count, col: 0 as Count)
	end 'oob'
	return locateModuleOffset(mods[idx], offset: site.offset)
end 'locateSite'

// qualifierOf is how a name is qualified by the module that declares it, from the root its qualified names start from: the
// project's, or the library's for a module of the standard library, whose path starts with the library's.
export function qualifierOf(m Module) returns String
	if isQualifierRoot(m) 'root'
		return rootQualifier
	end 'root'
	if m.isLibrary 'library'
		let skip = try stdlibQualifier.byteLength() + 1 otherwise panic("positions: a library path past memory")
		return m.path.sliceBytes(skip, endPos: m.path.byteLength()).clone()
	end 'library'
	return m.path.clone()
end 'qualifierOf'

// isQualifierRoot is whether m is the root that its qualified names start from, which `export` names.
function isQualifierRoot(m Module) returns bool
	if m.isLibrary 'library'
		return m.path == stdlibQualifier
	end 'library'
	return m.path == ""
end 'isQualifierRoot'

// sameTier is whether the module at index i is named from the module m by a qualified name: a module of the standard library
// names only the library's, and a program's module only the program's.
function sameTier(mods ModuleList, i Count, m diag.ModuleID) returns bool
	if m == diag.stdlibID or modIndex(m) >= mods.count() 'unplaced'
		return not mods[i].isLibrary
	end 'unplaced'
	return mods[i].isLibrary == mods[modIndex(m)].isLibrary
end 'sameTier'

// NameOwner says which module a bare name of another module's declaration means: none when no other module declares it, an
// empty qualifier when more than one could be meant.
export type NameOwner
	export var declared as bool
	export var qualifier as String

	export static function none() returns NameOwner
		return NameOwner{declared: false, qualifier: ""}
	end 'none'

	export static function ambiguous() returns NameOwner
		return NameOwner{declared: true, qualifier: ""}
	end 'ambiguous'

	export static function of(consumes qualifier String) returns NameOwner
		return NameOwner{declared: true, qualifier: qualifier}
	end 'of'
end 'NameOwner'

// isExportedBy is whether the module declares an exported declaration of the name.
function isExportedBy(module Module, name String) returns bool
	return module.names.has(name) and levelOf(module, name: name) != Visibility.unexported
end 'isExportedBy'

// owningModule is the qualifier of the declaration a bare name in module m means, as Maxon's bare lookup finds it: the root
// module's, else the one exported declaration of that name in the project.
export function owningModule(mods ModuleList, m diag.ModuleID, name String) returns NameOwner
	var found = 0 as Count
	var qualifier = ""
	var rootDeclares = false
	for i in 0 upto mods.count() 'modules'
		if mods[i].id == m or not sameTier(mods, i: i, m: m) 'self'
			continue 'modules'
		end 'self'
		if isQualifierRoot(mods[i]) 'root'
			rootDeclares = mods[i].names.has(name)
			continue 'modules'
		end 'root'
		if isExportedBy(mods[i], name: name) 'other'
			found = try found + 1 otherwise panic("positions: more modules than memory")
			qualifier = qualifierOf(mods[i])
		end 'other'
	end 'modules'
	if rootDeclares 'root'
		return NameOwner.of(rootQualifier)
	end 'root'
	if found == 0 'none'
		return NameOwner.none()
	end 'none'
	if found == 1 'one'
		return NameOwner.of(qualifier)
	end 'one'
	return NameOwner.ambiguous()
end 'owningModule'

// fixKindQualify is the kind of the fix that writes the module of a declaration before a bare name that means it.
export let fixKindQualify = "qualify"

// qualifyFix writes the module path before the bare name that the error did not find, when the name means one declaration of
// another module, and is no fix when it could mean more than one or none.
function qualifyFix(mods ModuleList, e diag.CompileError) returns diag.Fix
	let owner = owningModule(mods, m: e.site.module, name: e.unqualified)
	if not owner.declared or owner.qualifier == "" 'unplaced'
		return diag.Fix.none()
	end 'unplaced'
	var edits = diag.FixEdits.create(0)
	edits.push(diag.FixEdit.insert(e.site.module, at: e.unqualifiedAt, text: "{owner.qualifier}."))
	return diag.Fix.make(fixKindQualify, edits: edits)
end 'qualifyFix'

// qualifyHint is how to name the declarations of the bare name that an error did not find that other modules declare, or
// "" if none does: another module's declarations are always qualified.
function qualifyHint(mods ModuleList, e diag.CompileError) returns String
	if e.unqualified == "" 'none'
		return ""
	end 'none'
	var spellings = StringList.create(0)
	for i in 0 upto mods.count() 'each'
		if mods[i].names.has(e.unqualified) and mods[i].id != e.site.module and sameTier(mods, i: i, m: e.site.module) 'declared'
			spellings.push("'{qualifierOf(mods[i])}.{e.unqualified}'")
		end 'declared'
	end 'each'
	if spellings.count() == 0 'noOther'
		return ""
	end 'noOther'
	var buf = ByteArray.create(0)
	for i in 0 upto spellings.count() 'join'
		if i > 0 'sep'
			buf.append(" or ".toByteArray())
		end 'sep'
		buf.append(spellings[i].toByteArray())
	end 'join'
	return ": a declaration of another module is named with its module, as {String.from(buf)}"
end 'qualifyHint'

// hiddenElsewhere is why a bare name that an error did not find cannot name what the other modules of the program declare
// under it, when each such declaration is one that its visibility keeps from the module of the error, or "" when another
// module declares none or one that the module could name qualified. That module names it from where the name is written,
// as maxon refuses a declaration that its visibility does not reach (E3008).
function hiddenElsewhere(mods ModuleList, e diag.CompileError) returns String
	let m = e.site.module
	if e.unqualified == "" or m == diag.stdlibID or modIndex(m) >= mods.count() or mods[modIndex(m)].isLibrary 'notProgram'
		return ""
	end 'notProgram'
	let from = modIndex(m)
	var why = ""
	for i in 0 upto mods.count() 'each'
		if i == from or mods[i].isLibrary 'self'
			continue 'each'
		end 'self'
		if not mods[i].names.has(e.unqualified) 'undeclared'
			continue 'each'
		end 'undeclared'
		let level = levelOf(mods[i], name: e.unqualified)
		if declaresConstant(mods[i], name: e.unqualified) or isVisible(level, owner: mods[i].id, ownerPath: mods[i].path, from: m, fromPath: mods[from].path) 'reached'
			return ""
		end 'reached'
		if why == "" 'first'
			why = notVisibleText(e.unqualified, v: level, ownerWord: describeModuleOf(mods[i]), tree: parentPath(mods[i].path), fromWord: describeModuleOf(mods[from]))
		end 'first'
	end 'each'
	return why
end 'hiddenElsewhere'

// declaresConstant is whether what the module declares under the name is a module-level 'let' or 'var', which maxon does not
// find from where its visibility does not reach, so its bare name stays unknown there.
function declaresConstant(module Module, name String) returns bool
	return match module.names.get(name) 'declared'
		some(ordinal) gives module.decls[ordinal as Count].isConst()
		none gives false
	end 'declared'
end 'declaresConstant'

// levelOf is the visibility of the declaration that the module declares under the name.
function levelOf(module Module, name String) returns Visibility
	return match module.names.get(name) 'declared'
		some(ordinal) gives module.decls[ordinal as Count].level()
		none panic("positions: module '{module.path}' declares no '{name}'")
	end 'declared'
end 'levelOf'

export function locateError(mods ModuleList, mutates e diag.CompileError)
	if e.located 'already'
		return
	end 'already'
	let hidden = hiddenElsewhere(mods, e: e)
	if hidden != "" 'hidden'
		e.code = diag.errNotExported
		e.message = hidden
		e.site.offset = e.unqualifiedAt
		e.unqualified = ""
	end 'hidden'
	e.message = "{e.message}{qualifyHint(mods, e: e)}"
	if e.unqualified != "" and not e.fix.isSome() 'bare'
		e.fix = qualifyFix(mods, e: e)
	end 'bare'
	e.unqualified = ""
	let loc = locateSite(mods, site: e.site)
	e.file = loc.file
	e.line = loc.line
	e.col = loc.col
	e.located = true
	if not locateFix(mods, fix: e.fix) 'unplaced'
		e.fix = diag.Fix.none()
	end 'unplaced'
end 'locateError'

// locateFix places each edit of a fix in its file, and is false when one lies in no file of the program, which a tool cannot
// edit.
function locateFix(mods ModuleList, mutates fix diag.Fix) returns bool
	for i in 0 upto fix.edits.count() 'edits'
		let module = fix.edits[i].module
		if module < 0 or module as Count >= mods.count() 'outside'
			return false
		end 'outside'
		let m = module as Count
		if mods[m].files.count() == 0 'synthetic'
			return false
		end 'synthetic'
		let file = findFileIndex(mods[m].files, offset: fix.edits[i].begin)
		let start = mods[m].files[file].start as Count
		fix.edits[i].file = mods[m].files[file].path.clone()
		fix.edits[i].fileBegin = try (fix.edits[i].begin as Count) - start otherwise panic("positions: a fix before its file")
		fix.edits[i].fileUntil = try (fix.edits[i].until as Count) - start otherwise panic("positions: a fix before its file")
	end 'edits'
	return true
end 'locateFix'

export function locateAllErrors(mods ModuleList, mutates errs diag.ErrorList)
	var shown = diag.ErrorList.create(0)
	for i in 0 upto errs.count() 'each'
		if not errs[i].consequence 'shown'
			var e = errs[i].clone()
			locateError(mods, e: e)
			shown.push(e)
		end 'shown'
	end 'each'
	errs = shown
	diag.sortErrors(errs)
end 'locateAllErrors'
