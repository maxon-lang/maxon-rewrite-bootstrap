export function isReserved(word String) returns bool
	return match word 'kw'
		"export" or
		"public" or
		"static" or
		"function" or
		"mutates" or
		"consumes" or
		"destructs" or
		"self" or
		"returns" or
		"throws" or
		"end" or
		"sets" or
		"_" or
		"let" or
		"type" or
		"is" or
		"noncopyable" or
		"var" or
		"as" or
		"enum" or
		"union" or
		"typealias" or
		"int" or
		"to" or
		"upto" or
		"Self" or
		"with" or
		"uses" or
		"where" or
		"implements" or
		"and" or
		"interface" or
		"if" or
		"else" or
		"try" or
		"while" or
		"for" or
		"in" or
		"otherwise" or
		"throw" or
		"return" or
		"break" or
		"continue" or
		"when" or
		"match" or
		"default" or
		"or" or
		"then" or
		"gives" or
		"not" or
		"mod" or
		"shl" or
		"shr" or
		"xor" or
		"ignore" or
		"true" or
		"false" or
		"panic" gives true
		default gives false
	end 'kw'
end 'isReserved'

