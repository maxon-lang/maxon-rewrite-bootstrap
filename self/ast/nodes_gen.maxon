export function numberSlots(tree Tree, mutates slots U32List) returns Slots
	var count = Slots.zero()
	for id in 1 upto tree.records.count() 'each'
		let k = tree.records[id].kind
		if k == NodeKind.letStmt or k == NodeKind.ifTryStmt or k == NodeKind.forStmt or k == NodeKind.tryStmt or k == NodeKind.handlerBlock 'c_localSlots'
			count.localSlots = try count.localSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.localSlots
		end 'c_localSlots'
		if k == NodeKind.breakStmt or k == NodeKind.continueStmt 'c_jumpSlots'
			count.jumpSlots = try count.jumpSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.jumpSlots
		end 'c_jumpSlots'
		if k == NodeKind.whenStmt 'c_whenSlots'
			count.whenSlots = try count.whenSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.whenSlots
		end 'c_whenSlots'
		if k == NodeKind.pattern 'c_patternSlots'
			count.patternSlots = try count.patternSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.patternSlots
		end 'c_patternSlots'
		if k == NodeKind.memberExpr 'c_memberSlots'
			count.memberSlots = try count.memberSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.memberSlots
		end 'c_memberSlots'
		if k == NodeKind.callExpr 'c_callSlots'
			count.callSlots = try count.callSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.callSlots
		end 'c_callSlots'
		if k == NodeKind.unaryExpr or k == NodeKind.castExpr or k == NodeKind.binaryExpr 'c_arithSlots'
			count.arithSlots = try count.arithSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.arithSlots
		end 'c_arithSlots'
		if k == NodeKind.nameExpr 'c_nameSlots'
			count.nameSlots = try count.nameSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.nameSlots
		end 'c_nameSlots'
		if k == NodeKind.structLitExpr 'c_structLitSlots'
			count.structLitSlots = try count.structLitSlots + 1 otherwise panic("slot overflow")
			slots[id] = count.structLitSlots
		end 'c_structLitSlots'
	end 'each'
	return count
end 'numberSlots'

