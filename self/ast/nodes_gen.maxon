export function newUnaryExpr(mutates t Tree, start diag.U32) returns NodeID
	let id = t.alloc(NodeKind.unaryExpr, start: start)
	return id
end 'newUnaryExpr'

export function unaryExprOp(t Tree, id NodeID) returns String
	let code = (t.records[id as Count].aux and (255 as U16)) as Count
	return match code 'lit'
		1 gives "-"
		2 gives "not"
		default gives ""
	end 'lit'
end 'unaryExprOp'

export function setUnaryExprOp(mutates t Tree, id NodeID, text String)
	let code = match text 'lit'
		"-" gives 1 as U16
		"not" gives 2 as U16
		default panic("invalid enum text")
	end 'lit'
	t.records[id as Count].aux = (t.records[id as Count].aux and (65280 as U16)) or code
end 'setUnaryExprOp'

export function unaryExprE(t Tree, id NodeID) returns NodeID
	return t.records[id as Count].a as NodeID
end 'unaryExprE'

export function setUnaryExprE(mutates t Tree, id NodeID, value NodeID)
	t.records[id as Count].a = value as diag.U32
end 'setUnaryExprE'

