	return id
end 'newBinaryExpr'

export function binaryExprL(t Tree, id NodeID) returns NodeID
	return t.records[id as Count].a as NodeID
end 'binaryExprL'

export function setBinaryExprL(mutates t Tree, id NodeID, value NodeID)
	t.records[id as Count].a = value as diag.U32
end 'setBinaryExprL'

export function binaryExprOp(t Tree, id NodeID) returns String
	let code = (t.records[id as Count].aux and (255 as U16)) as Count
	return match code 'lit'
		1 gives "*"
		2 gives "/"
		3 gives "mod"
		4 gives "+"
		5 gives "-"
		6 gives "shl"
		7 gives "shr"
		8 gives "=="
		9 gives "!="
		10 gives "<"
		11 gives "<="
		12 gives ">"
		13 gives ">="
		14 gives "and"
		15 gives "xor"
		16 gives "or"
		default gives ""
	end 'lit'
end 'binaryExprOp'

export function setBinaryExprOp(mutates t Tree, id NodeID, text String)
	let code = match text 'lit'
		"*" gives 1 as U16
		"/" gives 2 as U16
		"mod" gives 3 as U16
		"+" gives 4 as U16
		"-" gives 5 as U16
		"shl" gives 6 as U16
		"shr" gives 7 as U16
		"==" gives 8 as U16
		"!=" gives 9 as U16
		"<" gives 10 as U16
		"<=" gives 11 as U16
		">" gives 12 as U16
		">=" gives 13 as U16
		"and" gives 14 as U16
		"xor" gives 15 as U16
		"or" gives 16 as U16
		default panic("invalid enum text")
	end 'lit'
	t.records[id as Count].aux = (t.records[id as Count].aux and (65280 as U16)) or code
end 'setBinaryExprOp'

export function binaryExprR(t Tree, id NodeID) returns NodeID
	return t.records[id as Count].b as NodeID
end 'binaryExprR'

