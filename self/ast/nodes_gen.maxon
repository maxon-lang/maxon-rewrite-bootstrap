	t.records[id as Count].flags = t.records[id as Count].flags or (1 as Byte)
end 'setIntLitNegative'

export function intLitMagnitude(t Tree, id NodeID) returns I128
	let lo = t.records[id as Count].a as Count
	let hi = t.records[id as Count].b as Count
	return I128.fromCount(lo or (try hi shl 32 otherwise 0 as Count))
end 'intLitMagnitude'

export function setIntLitMagnitude(mutates t Tree, id NodeID, value I128)
	t.records[id as Count].a = (value.lo and (4294967295 as Count)) as diag.U32
	t.records[id as Count].b = ((value.lo shr 32) and (4294967295 as Count)) as diag.U32
end 'setIntLitMagnitude'

