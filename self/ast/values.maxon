// intLitValue is the value an integer literal writes, which its sign decides.
// floatLitBits is the double of a float literal, its sign flipped when it is written with a minus.
export function floatLitBits(t Tree, id NodeID) returns Count
	let magnitude = floatLitMagnitude(t, id: id).lo
	if floatLitNegative(t, id: id) 'neg'
		return floatNegate(magnitude)
	end 'neg'
	return magnitude
end 'floatLitBits'

export function intLitValue(t Tree, id NodeID) returns I128
	let magnitude = intLitMagnitude(t, id: id)
	if intLitNegative(t, id: id) 'neg'
		return magnitude.neg()
	end 'neg'
	return magnitude
end 'intLitValue'
