// strPartsText is the text of the parts of a string literal that has no interpolation.
export function strPartsText(t Tree, partsRef diag.U32) returns String
	let count = t.strPartCount(partsRef)
	if count == 1 'one'
		return t.strPartText(partsRef, index: 0 as Count)
	end 'one'
	var text = ByteArray.create(0)
	for i in 0 upto count 'parts'
		text.append(t.strPartText(partsRef, index: i).toByteArray())
	end 'parts'
	return String.from(text)
end 'strPartsText'

// floatLitBits is the double of a float literal, its sign flipped when it is written with a minus.
export function floatLitBits(t Tree, id NodeID) returns Count
	let magnitude = floatLitMagnitude(t, id: id).lo
	if floatLitNegative(t, id: id) 'neg'
		return floatNegate(magnitude)
	end 'neg'
	return magnitude
end 'floatLitBits'

// intLitValue is the value an integer literal writes, which its sign decides.
export function intLitValue(t Tree, id NodeID) returns I128
	let magnitude = intLitMagnitude(t, id: id)
	if intLitNegative(t, id: id) 'neg'
		return magnitude.neg()
	end 'neg'
	return magnitude
end 'intLitValue'
