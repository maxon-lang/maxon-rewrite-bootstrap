// A structural type is one whose identity is its structure, which any module may make: an integer or float range, an
// integer or float constant, an instance, the origin of a function type and the record of a tuple with its type
// parameters. Each is interned under its word: structuralBit, its kind in the bits from shapeKindShift, and a 57-bit hash of
// its structure, which is its handle. A part of the structure that is a type is hashed by its handle: a structural part
// by its own word, a nominal one by its module's slot and its place there, so that the hash depends on nothing but the
// structure.
//
// The hash runs two lanes of 32 and 25 bits, packed in one Count: each step mixes 32 bits of input into both with an
// xor-shift and multiply finalizer whose operands keep every product inside a Count.

let shapeLaneMask = 4294967295 as Count

let shapeLaneShift = 32 as Count

let shapeHighLaneMask = 33554431 as Count

let shapeHashMask = 144115188075855871 as Count

let shapeKindShift = 57 as Count

// shapeKindMask keeps the bits of the kind of a handle shifted down by shapeKindShift.
let shapeKindMask = 31 as Count

let structuralBit = 4611686018427387904 as Count

let shapeSeed = 625341585 as Count

// ShapeMultiplier is a multiplier of the mix, below 2^29, so that its product with 32 bits fits a Count.
typealias ShapeMultiplier = int(0 to 536870911)

let shapeMixLow = 73244475 as ShapeMultiplier

let shapeMixHigh = 295559667 as ShapeMultiplier

let shapeFoldShift = 16 as Count

// ShapeForm tells apart the structures that share a kind: an instance of a function type and the origin it is an
// instance of are both function types, and a tuple's type parameters are type parameters.
enum ShapeForm
	range
	constant
	instance
	funcOrigin
	tupleOrigin
	tupleParam
end 'ShapeForm'

function shapeMix(x Count, m ShapeMultiplier) returns Count
	let a = (((x xor (x shr shapeFoldShift)) and shapeLaneMask) * (m as Count)) and shapeLaneMask
	let b = ((a xor (a shr shapeFoldShift)) * (m as Count)) and shapeLaneMask
	return b xor (b shr shapeFoldShift)
end 'shapeMix'

// shapeStep mixes w, of 32 bits, into the hash h.
function shapeStep(h Count, w Count) returns Count
	let low = h and shapeLaneMask
	let high = h shr shapeLaneShift
	let nextLow = shapeMix(low xor w, m: shapeMixLow)
	let nextHigh = shapeMix(high xor w xor low, m: shapeMixHigh) and shapeHighLaneMask
	return (nextHigh shl shapeLaneShift) or nextLow
end 'shapeStep'

function shapeWordStep(h Count, w Count) returns Count
	return shapeStep(shapeStep(h, w: w and shapeLaneMask), w: w shr shapeLaneShift)
end 'shapeWordStep'

function shapeFlagStep(h Count, b bool) returns Count
	if b 'set'
		return shapeStep(h, w: 1 as Count)
	end 'set'
	return shapeStep(h, w: 0 as Count)
end 'shapeFlagStep'

function shapeTextStep(h Count, s String) returns Count
	var x = h
	let n = s.byteLength()
	for i in 0 upto n 'each'
		x = shapeStep(x, w: s.byteAt(i) as Count)
	end 'each'
	return shapeWordStep(x, w: n as Count)
end 'shapeTextStep'

function shapeI128Step(h Count, v I128) returns Count
	let x = shapeWordStep(h, w: v.lo)
	if v.hi < 0 'negative'
		return shapeWordStep(shapeStep(x, w: 1 as Count), w: (try -(v.hi + 1) as Count otherwise panic("the high word of a negative I128 has no magnitude")))
	end 'negative'
	return shapeWordStep(shapeStep(x, w: 0 as Count), w: v.hi as Count)
end 'shapeI128Step'

function shapeStart(kind TypeKind, form ShapeForm) returns Count
	return shapeStep(shapeStep(shapeSeed, w: kind.ordinal as Count), w: form.ordinal as Count)
end 'shapeStart'

// shapeWordOf is the word of a structure of kind whose hash is h.
function shapeWordOf(kind TypeKind, h Count) returns Count
	let kindBits = try (kind.ordinal as Count) shl shapeKindShift otherwise panic("a type kind past the bits of a handle")
	return structuralBit or kindBits or (h and shapeHashMask)
end 'shapeWordOf'

// shapeID is the handle of the structure of word.
function shapeID(word Count) returns TypeID
	return try word as TypeID otherwise panic("a structural word past the bits of a handle")
end 'shapeID'

// ShapeHit is what a lookup of a structure under a word finds: no type, the type of that structure, or a type of another
// structure under the same word. That is an internal error and never a merge, since the two would be one type.
export union ShapeHit
	absent
	same(id TypeID, place Count)
	clash(message String)
end 'ShapeHit'

function shapeClash(tt TypeTable, word Count, existing TypeID, other String) returns ShapeHit
	return ShapeHit.clash(clashMessage(tt, word: word, existing: existing, other: other))
end 'shapeClash'

function clashMessage(tt TypeTable, word Count, existing TypeID, other String) returns String
	return "internal error: the types '{typeName(tt, t: existing)}' and '{other}' have one structural hash, {word}"
end 'clashMessage'

// takeShape is the type a lookup found, which the running task's slot then holds, or none where it found nothing; it stops
// the compile at a clash.
function takeShape(mutates tt TypeTable, consumes hit ShapeHit) returns table.Option with TypeID
	match consumes hit 'hit'
		absent then return table.Option.none
		same(id, place) then return adoptedShape(tt, id: id, place: place)
		clash(message) then panic("{message}")
	end 'hit'
end 'takeShape'

function adoptedShape(mutates tt TypeTable, id TypeID, place Count) returns table.Option with TypeID
	adoptShape(tt, place: place, word: id as Count)
	return table.Option.some(id)
end 'adoptedShape'

function intRangeWord(aliasName String, minVal I128, maxVal I128, inferred bool) returns Count
	let h = shapeFlagStep(shapeI128Step(shapeI128Step(shapeTextStep(shapeStart(TypeKind.intRange, form: ShapeForm.range), s: aliasName), v: minVal), v: maxVal), b: inferred)
	return shapeWordOf(TypeKind.intRange, h: h)
end 'intRangeWord'

function intRangeUnder(tt TypeTable, word Count, aliasName String, minVal I128, maxVal I128, inferred bool) returns ShapeHit
	var place as Count
	if not findShape(tt, word: word, place: place) 'absent'
		return ShapeHit.absent
	end 'absent'
	let id = shapeID(word)
	let s = shapeList(handleSlot(place))
	let i = handleIndex(place)
	if tt.lists[s][i].kind == TypeKind.intRange and tt.lists[s][i].name == aliasName and tt.lists[s][i].minVal.eq(minVal) and tt.lists[s][i].maxVal.eq(maxVal) and tt.lists[s][i].inferred == inferred 'same'
		return ShapeHit.same(id, place: place)
	end 'same'
	return shapeClash(tt, word: word, existing: id, other: "{aliasName} int({minVal.toString()} to {maxVal.toString()})")
end 'intRangeUnder'

function floatRangeWord(aliasName String, lo Count, hi Count) returns Count
	let h = shapeWordStep(shapeWordStep(shapeTextStep(shapeStart(TypeKind.floatRange, form: ShapeForm.range), s: aliasName), w: lo), w: hi)
	return shapeWordOf(TypeKind.floatRange, h: h)
end 'floatRangeWord'

function floatRangeUnder(tt TypeTable, word Count, aliasName String, lo Count, hi Count) returns ShapeHit
	var place as Count
	if not findShape(tt, word: word, place: place) 'absent'
		return ShapeHit.absent
	end 'absent'
	let id = shapeID(word)
	let s = shapeList(handleSlot(place))
	let i = handleIndex(place)
	if tt.lists[s][i].kind == TypeKind.floatRange and tt.lists[s][i].name == aliasName and tt.lists[s][i].minVal.eq(I128.fromCount(lo)) and tt.lists[s][i].maxVal.eq(I128.fromCount(hi)) 'same'
		return ShapeHit.same(id, place: place)
	end 'same'
	return shapeClash(tt, word: word, existing: id, other: "{aliasName} float with the bits {lo} to {hi}")
end 'floatRangeUnder'

function constIntWord(val I128) returns Count
	return shapeWordOf(TypeKind.constInt, h: shapeI128Step(shapeStart(TypeKind.constInt, form: ShapeForm.constant), v: val))
end 'constIntWord'

function constIntUnder(tt TypeTable, word Count, val I128) returns ShapeHit
	var place as Count
	if not findShape(tt, word: word, place: place) 'absent'
		return ShapeHit.absent
	end 'absent'
	let id = shapeID(word)
	let s = shapeList(handleSlot(place))
	let i = handleIndex(place)
	if tt.lists[s][i].kind == TypeKind.constInt and tt.lists[s][i].minVal.eq(val) 'same'
		return ShapeHit.same(id, place: place)
	end 'same'
	return shapeClash(tt, word: word, existing: id, other: "const({val.toString()})")
end 'constIntUnder'

function constFloatWord(bits Count) returns Count
	return shapeWordOf(TypeKind.constFloat, h: shapeWordStep(shapeStart(TypeKind.constFloat, form: ShapeForm.constant), w: bits))
end 'constFloatWord'

function constFloatUnder(tt TypeTable, word Count, bits Count) returns ShapeHit
	var place as Count
	if not findShape(tt, word: word, place: place) 'absent'
		return ShapeHit.absent
	end 'absent'
	let id = shapeID(word)
	let s = shapeList(handleSlot(place))
	let i = handleIndex(place)
	if tt.lists[s][i].kind == TypeKind.constFloat and tt.lists[s][i].minVal.eq(I128.fromCount(bits)) 'same'
		return ShapeHit.same(id, place: place)
	end 'same'
	return shapeClash(tt, word: word, existing: id, other: "the float constant of the bits {bits}")
end 'constFloatUnder'

// instanceWord is the word of the instance of origin at args, whose kind is the origin's.
export function instanceWord(tt TypeTable, origin TypeID, args TypeIDList) returns Count
	let kind = typeKind(tt, t: origin)
	var h = shapeWordStep(shapeStart(kind, form: ShapeForm.instance), w: (origin as Count))
	h = shapeWordStep(h, w: args.count())
	for i in 0 upto args.count() 'each'
		h = shapeWordStep(h, w: (args[i] as Count))
	end 'each'
	return shapeWordOf(kind, h: h)
end 'instanceWord'

// instanceUnder looks up the instance of origin at args under word, which a test gives to make two instances clash.
export function instanceUnder(tt TypeTable, word Count, origin TypeID, args TypeIDList) returns ShapeHit
	var place as Count
	if not findShape(tt, word: word, place: place) 'absent'
		return ShapeHit.absent
	end 'absent'
	let id = shapeID(word)
	let s = shapeList(handleSlot(place))
	let i = handleIndex(place)
	if tt.lists[s][i].origin == origin and tt.lists[s][i].typeArgs.equals(args) 'same'
		return ShapeHit.same(id, place: place)
	end 'same'
	var names = StringList.create(0)
	for j in 0 upto args.count() 'names'
		names.push(typeName(tt, t: args[j]))
	end 'names'
	return shapeClash(tt, word: word, existing: id, other: instanceSpelling(typeName(tt, t: origin), args: names))
end 'instanceUnder'

function funcOriginWord(shape FuncShape) returns Count
	var h = shapeWordStep(shapeStart(TypeKind.funcTy, form: ShapeForm.funcOrigin), w: shape.convs.count())
	for i in 0 upto shape.convs.count() 'each'
		h = shapeStep(h, w: shape.convs[i].ordinal as Count)
	end 'each'
	h = shapeTextStep(shapeFlagStep(h, b: shape.mutatesCaptures), s: shape.brand.key)
	return shapeWordOf(TypeKind.funcTy, h: h)
end 'funcOriginWord'

function funcOriginUnder(tt TypeTable, word Count, shape FuncShape) returns ShapeHit
	var place as Count
	if not findShape(tt, word: word, place: place) 'absent'
		return ShapeHit.absent
	end 'absent'
	let id = shapeID(word)
	let s = shapeList(handleSlot(place))
	let i = handleIndex(place)
	if tt.lists[s][i].kind == TypeKind.funcTy and tt.lists[s][i].origin == noType and tt.lists[s][i].paramConvs.equals(shape.convs) and tt.lists[s][i].mutatesCaptures == shape.mutatesCaptures and tt.lists[s][i].brandKey == shape.brand.key 'same'
		return ShapeHit.same(id, place: place)
	end 'same'
	return shapeClash(tt, word: word, existing: id, other: "the origin of the function types with {shape.convs.count()} parameters of the brand '{shape.brand.key}'")
end 'funcOriginUnder'

function tupleOriginWord(arity Count) returns Count
	return shapeWordOf(TypeKind.record, h: shapeWordStep(shapeStart(TypeKind.record, form: ShapeForm.tupleOrigin), w: arity))
end 'tupleOriginWord'

function tupleOriginUnder(tt TypeTable, word Count, arity Count) returns ShapeHit
	var place as Count
	if not findShape(tt, word: word, place: place) 'absent'
		return ShapeHit.absent
	end 'absent'
	let id = shapeID(word)
	let s = shapeList(handleSlot(place))
	let i = handleIndex(place)
	if tt.lists[s][i].isTuple and tt.lists[s][i].origin == noType and tt.lists[s][i].typeParams.count() == arity 'same'
		return ShapeHit.same(id, place: place)
	end 'same'
	return shapeClash(tt, word: word, existing: id, other: "Tuple{arity}")
end 'tupleOriginUnder'

// tupleParamWord is the word of the type parameter at index of the tuple record whose word is origin.
function tupleParamWord(origin Count, index Count) returns Count
	return shapeWordOf(TypeKind.typeParam, h: shapeWordStep(shapeWordStep(shapeStart(TypeKind.typeParam, form: ShapeForm.tupleParam), w: origin), w: index))
end 'tupleParamWord'

// emptyWord marks a free place of a ShapeIndex: no structural handle is 0, since its structuralBit is set.
let emptyWord = 0 as Count

let shapeIndexStart = 64 as Count

// shapeLoadParts and shapeLoadFull are the share of its places a ShapeIndex fills before it doubles: 7 in 10.
let shapeLoadParts = 7 as Count

let shapeLoadFull = 10 as Count

// shapeCell is how many words of its cells a place of a ShapeIndex takes: the handle, then where its entry is, so that a
// probe reads both from one line of the cache.
let shapeCell = 2 as Count

typealias ShapeWords = Array with Count

// ShapeIndex finds a structural type among the shapes of one slot by its handle: open addressing on the low bits of the
// handle, which are its hash, to the place of its entry: among the slot's own shapes or those of a slot it reads. A place
// is the index of its first cell, so mask keeps it even.
type ShapeIndex
	var cells as ShapeWords
	var mask as Count
	var used as Count

	static function new() returns ShapeIndex
		return ShapeIndex{cells: ShapeWords.filled(shapeIndexStart * shapeCell, value: emptyWord), mask: (shapeIndexStart - 1) * shapeCell, used: 0 as Count}
	end 'new'

	// probe is the place of word in the index, or the free place where it would go.
	function probe(word Count) returns Count
		var at = word and mask
		while cells[at] != emptyWord and cells[at] != word 'next'
			at = (try at + shapeCell otherwise 0 as Count) and mask
		end 'next'
		return at
	end 'probe'

	// holds is whether the place at, which probe gave for word, holds it.
	function holds(at Count, word Count) returns bool
		return cells[at] == word
	end 'holds'

	// placeAt is where the entry of the word at the place at is: its slot and its position among that slot's shapes.
	function placeAt(at Count) returns Count
		return cells[try at + 1 otherwise panic("a place past the cells of a shape index")]
	end 'placeAt'

	// insert records the place of a structure the slot makes, which no slot it reads holds.
	function insert(mutates self, word Count, place Count)
		let at = self.room(word)
		if cells[at] == word 'taken'
			panic("internal error: the structure of the word {word} is made twice in one slot")
		end 'taken'
		self.fill(at, word: word, place: place)
	end 'insert'

	// include records the place of a structure of a slot the slot reads, where the index finds it nowhere yet.
	function include(mutates self, word Count, place Count)
		let at = self.room(word)
		if cells[at] != word 'new'
			self.fill(at, word: word, place: place)
		end 'new'
	end 'include'

	// repoint records the place of the slot's own copy of a structure of a slot it reads, which the index may find there.
	function repoint(mutates self, word Count, place Count)
		let at = self.room(word)
		if cells[at] != word 'new'
			self.fill(at, word: word, place: place)
			return
		end 'new'
		cells[try at + 1 otherwise panic("a place past the cells of a shape index")] = place
	end 'repoint'

	// room is the place of word, or the free place it would take, once the index has room for one more.
	function room(mutates self, word Count) returns Count
		if (try (used + 1) * shapeLoadFull * shapeCell otherwise panic("a shape index past memory")) >= (try cells.count() * shapeLoadParts otherwise panic("a shape index past memory")) 'full'
			self.grow()
		end 'full'
		return self.probe(word)
	end 'room'

	function fill(mutates self, at Count, word Count, place Count)
		cells[at] = word
		cells[try at + 1 otherwise panic("a place past the cells of a shape index")] = place
		used = try used + 1 otherwise panic("a shape index past memory")
	end 'fill'

	function grow(mutates self)
		let old = exchange(cells, value: ShapeWords.create(0))
		let size = try old.count() * 2 otherwise panic("a shape index past memory")
		cells = ShapeWords.filled(size, value: emptyWord)
		mask = try size - shapeCell otherwise panic("a shape index of no places")
		var i = 0 as Count
		while i < old.count() 'rehash'
			if old[i] != emptyWord 'held'
				let at = self.probe(old[i])
				cells[at] = old[i]
				cells[try at + 1 otherwise panic("a place past the cells of a shape index")] = old[try i + 1 otherwise panic("a place past the cells of a shape index")]
			end 'held'
			i = try i + shapeCell otherwise panic("a shape index past memory")
		end 'rehash'
	end 'grow'
end 'ShapeIndex'

typealias ShapeIndexes = Array with ShapeIndex
