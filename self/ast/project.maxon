// ConstValue is a constant's type, and its value once the range analysis (or the type, for an integer constant, which
// holds its value) knows it.
export type ConstValue
	export var ty as TypeID
	export var hasValue as bool
	export var isBool as bool
	export var boolVal as bool
	export var isStr as bool
	export var strVal as String
	export var intVal as I128
	// low and high are the span the range analysis gave an integer constant's value, which a name of the constant has
	// wherever it is used.
	export var low as I128
	export var high as I128

	export static function typed(ty TypeID) returns ConstValue
		return ConstValue{ty: ty, hasValue: false, isBool: false, boolVal: false, isStr: false, strVal: "", intVal: I128.zero(), low: I128.zero(), high: I128.zero()}
	end 'typed'

	export static function makeInt(ty TypeID, consumes v I128) returns ConstValue
		return ConstValue{ty: ty, hasValue: true, isBool: false, boolVal: false, isStr: false, strVal: "", intVal: v.clone(), low: v.clone(), high: v}
	end 'makeInt'

	export static function makeBool(ty TypeID, v bool) returns ConstValue
		return ConstValue{ty: ty, hasValue: true, isBool: true, boolVal: v, isStr: false, strVal: "", intVal: I128.zero(), low: I128.zero(), high: I128.zero()}
	end 'makeBool'

	export static function makeString(ty TypeID, consumes v String) returns ConstValue
		return ConstValue{ty: ty, hasValue: true, isBool: false, boolVal: false, isStr: true, strVal: v, intVal: I128.zero(), low: I128.zero(), high: I128.zero()}
	end 'makeString'
end 'ConstValue'

export function declKey(ref DeclRef) returns Count
	let m = (ref.module + 1) as Count
	return (try m shl 32 otherwise 0 as Count) or (ref.ordinal as Count)
end 'declKey'

// inModule is a name preceded by the path of the module that declares it, as maxon names a declaration of another module in a message.
export function inModule(p Project, modID diag.ModuleID, name String) returns String
	if modID == diag.stdlibID 'library'
		return name.clone()
	end 'library'
	let path = p.modules[modIndex(modID)].path.clone()
	if path.byteLength() == 0 'root'
		return name.clone()
	end 'root'
	return "{path}.{name}"
end 'inModule'

export function modIndex(m diag.ModuleID) returns Count
	if m < 0 'neg'
		panic("negative ModuleID")
	end 'neg'
	return m as Count
end 'modIndex'

export typealias NodeTypeMap = table.IntMap with TypeID

export typealias NodeFuncMap = table.IntMap with FuncID

export typealias OrdinalConstMap = table.IntMap with ConstValue

export typealias TypeRawMap = table.IntMap with TypeID

export typealias FuncLocalsMap = table.IntMap with Count

// FuncLocals are the locals that the bodies stage bound to a function's receiver and parameters: noLocal for a receiver it
// has none of and for a parameter named `_`.
export type FuncLocals
	export var receiver as LocalID
	export var params as LocalIDList

	export static function new() returns Self
		return Self{receiver: noLocal, params: LocalIDList.create(0)}
	end 'new'
end 'FuncLocals'

export typealias FuncLocalsList = Array with FuncLocals

// ModuleTables are what the stages of one module decide about its declarations, by the stage that decided it (Phase): each
// stage writes only its own part, so that a part is complete, and could be frozen and shared, when its stage ends. Only
// that module's stages write them, and a stage of another module reads the parts of the stages it waited on. A read finds
// the latest part that holds the entry, as a stage after another overrides what it decided.
export type ModuleTables
	// sealed are the parts of the stages that ended, frozen, which a task that waited on them shares; open are the parts after
	// them, the one at k being open[k - sealed.count()], which the holder may still write.
	var sealed as Array with frozen with TablesPart
	var open as Array with TablesPart
	// phase is the part that the task holding the tables writes.
	var phase as Count
	// lent is whether these are the tables a project holds while a task of the module holds the module's own: no stage reads
	// them, as the task reads its module's tables in its state.
	var lent as bool

	export static function new() returns Self
		return Self{sealed: Array.create(0), open: Array.create(0), phase: Phase.builtins.ordinal, lent: false}
	end 'new'

	export static function lentOut() returns Self
		var t = Self.new()
		t.lent = true
		return t
	end 'lentOut'

	// requireHeld panics where the tables are lent to a task: a read of them is one of a module the task holds, which it
	// reads in its state.
	export function requireHeld()
		if lent 'lent'
			panic("a module's tables are read in the project while a task of the module holds them")
		end 'lent'
	end 'requireHeld'

	// written is the index in open of the part the holder writes, made with the parts before it where the tables have none yet.
	function written(mutates self) returns Count
		while partCount() <= phase 'room'
			open.push(TablesPart.new())
		end 'room'
		return try phase - sealed.count() otherwise panic("part {phase} of a module's tables is written after it was sealed")
	end 'written'

	// partCount is how many parts the tables have, which is how many a read looks through.
	export function partCount() returns Count
		return try sealed.count() + open.count() otherwise panic("more parts than memory")
	end 'partCount'

	// part is the part at k, sealed or open.
	function part(k Count) returns borrowed TablesPart
		let n = sealed.count()
		if k < n 'sealed'
			return sealed[k]
		end 'sealed'
		return open[k - n]
	end 'part'

	// seal freezes the parts before upTo, whose stages ended, making the ones the tables have none of yet.
	export function seal(mutates self, upTo Count)
		if upTo <= sealed.count() 'sealed'
			return
		end 'sealed'
		let n = try upTo - sealed.count() otherwise panic("a seal before the parts sealed already")
		var rest = TablesParts.create(0)
		for i in 0 upto open.count() 'open'
			let part = exchange(open[i], value: TablesPart.new())
			if i < n 'complete'
				sealed.push(freeze(part))
			end 'complete' else 'later'
				rest.push(part)
			end 'later'
		end 'open'
		while sealed.count() < upTo 'empty'
			sealed.push(freeze(TablesPart.new()))
		end 'empty'
		open = rest
	end 'seal'

	// viewOf is the tables as a task that waited on the stages of the first count parts reads them: those parts, shared. The
	// tables a task holds are read in its state, so a view of them refuses a read (requireHeld).
	export function viewOf(count Count) returns ModuleTables
		if lent 'lent'
			return ModuleTables.lentOut()
		end 'lent'
		var view = ModuleTables.new()
		var n = sealed.count()
		if count < n 'fewer'
			n = count
		end 'fewer'
		for k in 0 upto n 'parts'
			view.sealed.push(share(sealed[k]))
		end 'parts'
		return view
	end 'viewOf'

	// sealWritten seals the part the holder wrote, whose stage ends.
	export function sealWritten(mutates self)
		let upTo = try phase + 1 otherwise panic("a part past memory")
		seal(upTo)
	end 'sealWritten'

	// sealAll seals every part, which work outside the tasks wrote, when a compile begins.
	export function sealAll(mutates self)
		let n = partCount()
		seal(n)
	end 'sealAll'

	export function declType(ord DeclOrdinal) returns table.Option with TypeID
		let i = ord as Count
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if i < part(k).declTypes.count() and part(k).declTypes[i] != noType 'hit'
				return table.Option.some(part(k).declTypes[i])
			end 'hit'
		end 'parts'
		return table.Option.none
	end 'declType'

	export function setDeclType(mutates self, ord DeclOrdinal, t TypeID)
		let k = written()
		open[k].setDeclType(ord, t: t)
	end 'setDeclType'

	export function paramType(node NodeID) returns table.Option with TypeID
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if part(k).paramTypes.isEmpty() 'none'
				continue 'parts'
			end 'none'
			let found = part(k).paramTypes.get(node as Count)
			if found.isSome() 'hit'
				return found
			end 'hit'
		end 'parts'
		return table.Option.none
	end 'paramType'

	export function setParamType(mutates self, node NodeID, t TypeID)
		let k = written()
		open[k].paramTypes.insert(node as Count, value: t)
	end 'setParamType'

	export function declFunc(ord DeclOrdinal) returns table.Option with FuncID
		let i = ord as Count
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if i < part(k).declFuncs.count() and part(k).declFuncs[i] != noFunc 'hit'
				return table.Option.some(part(k).declFuncs[i])
			end 'hit'
		end 'parts'
		return table.Option.none
	end 'declFunc'

	export function setDeclFunc(mutates self, ord DeclOrdinal, f FuncID)
		let k = written()
		open[k].setDeclFunc(ord, f: f)
	end 'setDeclFunc'

	export function nodeFunc(node NodeID) returns table.Option with FuncID
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if part(k).nodeFuncs.isEmpty() 'none'
				continue 'parts'
			end 'none'
			let found = part(k).nodeFuncs.get(node as Count)
			if found.isSome() 'hit'
				return found
			end 'hit'
		end 'parts'
		return table.Option.none
	end 'nodeFunc'

	export function setNodeFunc(mutates self, node NodeID, f FuncID)
		let k = written()
		open[k].nodeFuncs.insert(node as Count, value: f)
	end 'setNodeFunc'

	export function declConst(ord DeclOrdinal) returns table.Option with ConstValue
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if part(k).declConsts.has(ord as Count) 'hit'
				return part(k).declConsts.get(ord as Count)
			end 'hit'
		end 'parts'
		return table.Option.none
	end 'declConst'

	export function setDeclConst(mutates self, ord DeclOrdinal, consumes value ConstValue)
		let k = written()
		open[k].declConsts.insert(ord as Count, value: value)
	end 'setDeclConst'

	export function rawType(t TypeID) returns TypeID
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if part(k).rawTypes.isEmpty() 'none'
				continue 'parts'
			end 'none'
			let found = part(k).rawTypes.get(t as Count)
			if found.isSome() 'hit'
				return found.unwrap()
			end 'hit'
		end 'parts'
		return noType
	end 'rawType'

	export function setRawType(mutates self, t TypeID, raw TypeID)
		let k = written()
		open[k].rawTypes.insert(t as Count, value: raw)
	end 'setRawType'

	// localsPart is the part that holds the locals the bodies stage bound to the function f, where it bound any, and sets at
	// to their place in it.
	function localsPart(f FuncID, sets at Count) returns table.Option with Count
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if part(k).localsAt.isEmpty() 'none'
				continue 'parts'
			end 'none'
			let found = part(k).localsAt.get(f as Count)
			if found.isSome() 'hit'
				at = found.unwrap()
				return table.Option.some(k)
			end 'hit'
		end 'parts'
		at = 0 as Count
		return table.Option.none
	end 'localsPart'

	export function receiverLocal(f FuncID) returns LocalID
		var at as Count
		match localsPart(f, at: at) 'part'
			some(k) then return part(k).funcLocals[at].receiver
			none then return noLocal
		end 'part'
	end 'receiverLocal'

	export function paramLocal(f FuncID, index Count) returns LocalID
		var at as Count
		match localsPart(f, at: at) 'part'
			some(k) then return part(k).funcLocals[at].params[index]
			none then panic("a parameter is read of a function whose body has bound none")
		end 'part'
	end 'paramLocal'

	export function setReceiverLocal(mutates self, f FuncID, l LocalID)
		let k = written()
		let at = open[k].localsFor(f)
		open[k].funcLocals[at].receiver = l
	end 'setReceiverLocal'

	export function pushParamLocal(mutates self, f FuncID, l LocalID)
		let k = written()
		let at = open[k].localsFor(f)
		open[k].funcLocals[at].params.push(l)
	end 'pushParamLocal'

	// memberDecl is the typealias that a check stage bound the type written Owner.member at node to.
	export function memberDecl(node Count) returns table.Option with DeclRef
		var k = partCount()
		while k > 0 'parts'
			k = k - 1
			if not part(k).memberDecls.isEmpty() and part(k).memberDecls.has(node) 'hit'
				return part(k).memberDecls.get(node)
			end 'hit'
		end 'parts'
		return table.Option.none
	end 'memberDecl'

	export function bindMemberDecl(mutates self, node NodeID, consumes d DeclRef)
		let k = written()
		open[k].memberDecls.insert(node as Count, value: d)
	end 'bindMemberDecl'

	export function pushExtMethod(mutates self, consumes e ExtMethod)
		let k = written()
		open[k].extMethods.push(e)
	end 'pushExtMethod'

	export function pushExtAlias(mutates self, consumes e ExtAlias)
		let k = written()
		open[k].extAliases.push(e)
	end 'pushExtAlias'

	export function pushExtConform(mutates self, consumes e ExtConform)
		let k = written()
		open[k].extConforms.push(e)
	end 'pushExtConform'

	// extMethodCount and the rest read what the module's extensions add, all parts as one list in the order of the parts, an
	// index running through them; a part past seen stops the read.
	export function extMethodCount() returns Count
		return extCount(ExtList.methods)
	end 'extMethodCount'

	export function extAliasCount() returns Count
		return extCount(ExtList.aliases)
	end 'extAliasCount'

	export function extConformCount() returns Count
		return extCount(ExtList.conforms)
	end 'extConformCount'

	export function extMethod(i Count) returns borrowed ExtMethod
		var at = i
		let k = extPart(ExtList.methods, at: at)
		return part(k).extMethods[at]
	end 'extMethod'

	export function extAlias(i Count) returns borrowed ExtAlias
		var at = i
		let k = extPart(ExtList.aliases, at: at)
		return part(k).extAliases[at]
	end 'extAlias'

	export function extConform(i Count) returns borrowed ExtConform
		var at = i
		let k = extPart(ExtList.conforms, at: at)
		return part(k).extConforms[at]
	end 'extConform'

	function extCount(list ExtList) returns Count
		var n = 0 as Count
		for k in 0 upto partCount() 'parts'
			n = try n + part(k).extLength(list) otherwise panic("more extensions than memory")
		end 'parts'
		return n
	end 'extCount'

	// extPart is the part that holds the i-th entry of the list, and makes at its index in that part.
	function extPart(list ExtList, mutates at Count) returns Count
		for k in 0 upto partCount() 'parts'
			let n = part(k).extLength(list)
			if at < n 'here'
				return k
			end 'here'
			at = at - n
		end 'parts'
		panic("an extension past those the module's tables hold")
	end 'extPart'
end 'ModuleTables'

typealias TablesParts = Array with TablesPart

// ExtList names a list of what a module's extensions add.
enum ExtList
	methods
	aliases
	conforms
end 'ExtList'

// TablesPart is what one stage of a module decided about its declarations.
type TablesPart
	// declTypes is the type of each declaration, by its ordinal; noType is a declaration that has none.
	var declTypes as TypeIDList
	// paramTypes is the type of each type parameter the module declares, by its node.
	var paramTypes as NodeTypeMap
	// declFuncs is the function of each declaration, by its ordinal; noFunc is a declaration that is none.
	var declFuncs as FuncIDList
	// nodeFuncs is the function of each function declaration the declare stage declared, at the top level or as a method, by
	// its node.
	var nodeFuncs as NodeFuncMap
	// declConsts is the value of each constant, by its ordinal.
	var declConsts as OrdinalConstMap
	// rawTypes is the type of the raw values of each enum and union the module declares whose cases write values that are no
	// literals, by the type's handle, once the constants stage has typed them all.
	var rawTypes as TypeRawMap
	// localsAt is where in funcLocals the locals of each function the module has checked the body of are, by the function's
	// handle.
	var localsAt as FuncLocalsMap
	var funcLocals as FuncLocalsList
	// extMethods, extAliases and extConforms are what the module's extensions add to types, whichever module declares them.
	var extMethods as ExtMethodList
	var extAliases as ExtAliasList
	var extConforms as ExtConformList
	// memberDecls are the typealiases that the types written Owner.member are bound to, by their node, which a check stage
	// finds after the resolve, as an extension of Owner may add them.
	var memberDecls as NodeDeclMap

	static function new() returns Self
		return Self{declTypes: TypeIDList.create(0), paramTypes: NodeTypeMap.new(), declFuncs: FuncIDList.create(0), nodeFuncs: NodeFuncMap.new(), declConsts: OrdinalConstMap.new(), rawTypes: TypeRawMap.new(), localsAt: FuncLocalsMap.new(), funcLocals: FuncLocalsList.create(0), extMethods: ExtMethodList.create(0), extAliases: ExtAliasList.create(0), extConforms: ExtConformList.create(0), memberDecls: NodeDeclMap.new()}
	end 'new'

	function setDeclType(mutates self, ord DeclOrdinal, t TypeID)
		if t == noType 'none'
			panic("a declaration is given no type")
		end 'none'
		let i = ord as Count
		while declTypes.count() <= i 'room'
			declTypes.push(noType)
		end 'room'
		declTypes[i] = t
	end 'setDeclType'

	function setDeclFunc(mutates self, ord DeclOrdinal, f FuncID)
		if f == noFunc 'none'
			panic("a declaration is given no function")
		end 'none'
		let i = ord as Count
		while declFuncs.count() <= i 'room'
			declFuncs.push(noFunc)
		end 'room'
		declFuncs[i] = f
	end 'setDeclFunc'

	function localsFor(mutates self, f FuncID) returns Count
		match localsAt.get(f as Count) 'at'
			some(at) then return at
			none then _ = 0
		end 'at'
		let at = funcLocals.count()
		localsAt.insert(f as Count, value: at)
		funcLocals.push(FuncLocals.new())
		return at
	end 'localsFor'

	function extLength(list ExtList) returns Count
		return match list 'l'
			methods gives extMethods.count()
			aliases gives extAliases.count()
			conforms gives extConforms.count()
		end 'l'
	end 'extLength'
end 'TablesPart'

// The accessors of the module tables read the tables of the module that decides the entry: the standard library's in the
// project, the task's own module's in its state, and another module's in the project once the task waited for it. Only a
// task of the module writes them, in its state.

// requireOwn panics where a stage writes the tables of a module other than its own.
function requireOwn(ms ModuleState, module diag.ModuleID)
	if module != ms.module 'other'
		panic("a stage of module {ms.module} writes the tables of module {module}")
	end 'other'
end 'requireOwn'

// declType is the type that the module which declares ref gave it.
export function declType(p Project, ms ModuleState, ref DeclRef) returns table.Option with TypeID
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.tables.declType(ref.ordinal)
	end 'std'
	if ref.module == ms.module 'own'
		return ms.tables.declType(ref.ordinal)
	end 'own'
	p.modules[modIndex(ref.module)].tables.requireHeld()
	return p.modules[modIndex(ref.module)].tables.declType(ref.ordinal)
end 'declType'

export function setDeclType(mutates ms ModuleState, ref DeclRef, t TypeID)
	requireOwn(ms, module: ref.module)
	ms.tables.setDeclType(ref.ordinal, t: t)
end 'setDeclType'

// paramType is the type of the type parameter that module declares at node.
export function paramType(p Project, ms ModuleState, module diag.ModuleID, node NodeID) returns table.Option with TypeID
	if module == ms.module 'own'
		return ms.tables.paramType(node)
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return p.modules[modIndex(module)].tables.paramType(node)
end 'paramType'

export function setParamType(mutates ms ModuleState, module diag.ModuleID, node NodeID, t TypeID)
	requireOwn(ms, module: module)
	ms.tables.setParamType(node, t: t)
end 'setParamType'

// declFunc is the function that the declaration ref is.
export function declFunc(p Project, ms ModuleState, ref DeclRef) returns table.Option with FuncID
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.tables.declFunc(ref.ordinal)
	end 'std'
	if ref.module == ms.module 'own'
		return ms.tables.declFunc(ref.ordinal)
	end 'own'
	p.modules[modIndex(ref.module)].tables.requireHeld()
	return p.modules[modIndex(ref.module)].tables.declFunc(ref.ordinal)
end 'declFunc'

export function setDeclFunc(mutates ms ModuleState, ref DeclRef, f FuncID)
	requireOwn(ms, module: ref.module)
	ms.tables.setDeclFunc(ref.ordinal, f: f)
end 'setDeclFunc'

// nodeFunc is the function that the function declaration module declares at node is.
export function nodeFunc(p Project, ms ModuleState, module diag.ModuleID, node NodeID) returns table.Option with FuncID
	if module == ms.module 'own'
		return ms.tables.nodeFunc(node)
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return p.modules[modIndex(module)].tables.nodeFunc(node)
end 'nodeFunc'

export function setNodeFunc(mutates ms ModuleState, module diag.ModuleID, node NodeID, f FuncID)
	requireOwn(ms, module: module)
	ms.tables.setNodeFunc(node, f: f)
end 'setNodeFunc'

// declConst is the value of the constant ref, once the module that declares it has typed it.
export function declConst(p Project, ms ModuleState, ref DeclRef) returns table.Option with ConstValue
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.tables.declConst(ref.ordinal)
	end 'std'
	if ref.module == ms.module 'own'
		return ms.tables.declConst(ref.ordinal)
	end 'own'
	p.modules[modIndex(ref.module)].tables.requireHeld()
	return p.modules[modIndex(ref.module)].tables.declConst(ref.ordinal)
end 'declConst'

export function setDeclConst(mutates ms ModuleState, ref DeclRef, consumes value ConstValue)
	requireOwn(ms, module: ref.module)
	ms.tables.setDeclConst(ref.ordinal, value: value)
end 'setDeclConst'

typealias Reached = Array with bool

// setModuleReads records, for each module the compile compiles from first on, the slots whose shapes its stages read:
// those of the modules it names, directly or through others, whose stages its own wait on, and of the modules an
// earlier compile compiled, which are done.
export function setModuleReads(mutates p Project, first Count)
	for m in first upto p.modules.count() 'modules'
		var reached = Reached.filled(p.modules.count(), value: false)
		for e in 0 upto first 'earlier'
			reached[e] = true
		end 'earlier'
		var pending = SlotList.create(0)
		pending.push(m)
		while pending.count() > 0 'reach'
			let at = try pending.pop() otherwise panic("a module was taken off an empty list")
			for j in 0 upto p.resolutions[at].deps.count() 'deps'
				let d = modIndex(p.resolutions[at].deps[j].module)
				if not reached[d] 'new'
					reached[d] = true
					pending.push(d)
				end 'new'
			end 'deps'
		end 'reach'
		var slots = SlotList.create(0)
		for d in 0 upto p.modules.count() 'slots'
			if reached[d] and d != m 'read'
				slots.push(moduleSlot(p.modules[d].id))
			end 'read'
		end 'slots'
		setShapeReads(p.types, module: p.modules[m].id, slots: slots)
	end 'modules'
end 'setModuleReads'

// rawTypeOf is the type of the raw values of the enum or union t, an origin, once the constants stage of the module that
// declares it has typed them, and noType before then or where its cases write literals.
export function rawTypeOf(p Project, ms ModuleState, t TypeID) returns TypeID
	if not typeEntry(ms.types, reads: p.types, t: t).hasDecl 'undeclared'
		return noType
	end 'undeclared'
	let module = typeEntry(ms.types, reads: p.types, t: t).decl.module
	if module == diag.stdlibID 'std'
		return p.stdlib.tables.rawType(t)
	end 'std'
	if module == ms.module 'own'
		return ms.tables.rawType(t)
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return p.modules[modIndex(module)].tables.rawType(t)
end 'rawTypeOf'

// setRawType records the type of the raw values of t, which the module that declares it has typed: one of the slot its
// task holds.
export function setRawType(mutates ms ModuleState, t TypeID, raw TypeID)
	if not heldTypeEntry(ms.types, t: t).hasDecl 'undeclared'
		panic("raw values are typed for '{heldTypeEntry(ms.types, t: t).name}', which no module declares")
	end 'undeclared'
	requireOwn(ms, module: heldTypeEntry(ms.types, t: t).decl.module)
	ms.tables.setRawType(t, raw: raw)
end 'setRawType'

// receiverLocal is the local the body of f binds its receiver to, or noLocal.
export function receiverLocal(p Project, ms ModuleState, f FuncID) returns LocalID
	let module = funcEntry(ms.funcs, funcReads: p.funcs, f: f).module
	if module == diag.stdlibID 'std'
		return p.stdlib.tables.receiverLocal(f)
	end 'std'
	if module == ms.module 'own'
		return ms.tables.receiverLocal(f)
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return p.modules[modIndex(module)].tables.receiverLocal(f)
end 'receiverLocal'

// paramLocal is the local the body of f binds its parameter at index to, or noLocal for one named `_`.
export function paramLocal(p Project, ms ModuleState, f FuncID, index Count) returns LocalID
	let module = funcEntry(ms.funcs, funcReads: p.funcs, f: f).module
	if module == diag.stdlibID 'std'
		return p.stdlib.tables.paramLocal(f, index: index)
	end 'std'
	if module == ms.module 'own'
		return ms.tables.paramLocal(f, index: index)
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return p.modules[modIndex(module)].tables.paramLocal(f, index: index)
end 'paramLocal'

export function setReceiverLocal(mutates ms ModuleState, f FuncID, l LocalID)
	requireOwn(ms, module: heldFuncEntry(ms.funcs, f: f).module)
	ms.tables.setReceiverLocal(f, l: l)
end 'setReceiverLocal'

export function pushParamLocal(mutates ms ModuleState, f FuncID, l LocalID)
	requireOwn(ms, module: heldFuncEntry(ms.funcs, f: f).module)
	ms.tables.pushParamLocal(f, l: l)
end 'pushParamLocal'

export typealias PathModMap = table.StringMap with diag.ModuleID

export type Project
	export var root as String
	export var target as Target
	export var rootModule as diag.ModuleID
	export var modules as ModuleList
	export var stdlib as Module
	export var byPath as frozen with PathModMap
	export var types as TypeTable
	export var funcs as FuncTable
	export var builtins as frozen with Builtins
	// resolutions and typings are the products of each module's resolve and verify, by module.
	export var resolutions as Array with frozen with Resolution
	export var typings as Array with frozen with Typing

	export static function new(consumes root String) returns Project
		var tt = TypeTable.new()
		var ft = FuncTable.new()
		var built = ParsedModule.new(diag.stdlibID, text: "", files: FileSpanList.create(0))
		var shared = lendTypeSlot(tt, module: diag.stdlibID, segment: Phase.builtins.ordinal, inputs: Inputs.new())
		var sharedFuncs = lendFuncSlot(ft, module: diag.stdlibID, segment: Phase.builtins.ordinal)
		let bs = initBuiltins(shared, reads: tt, ft: sharedFuncs, funcReads: ft, std: built)
		var std = Module.new(diag.stdlibID, path: "", text: "", files: FileSpanList.create(0))
		std.takeParsed(built)
		returnTypeSlot(tt, held: shared)
		returnFuncSlot(ft, held: sharedFuncs)
		let bp = PathModMap.new()
		var p = Project{root: root, target: Target.windowsX64(), rootModule: 0 as diag.ModuleID, modules: ModuleList.create(0), stdlib: std, byPath: freeze(bp), types: tt, funcs: ft, builtins: freeze(bs), resolutions: Array.create(0), typings: Array.create(0)}
		for i in 0 upto p.stdlib.decls.count() 'stdReg'
			let ord = try i as DeclOrdinal otherwise 0 as DeclOrdinal
			let name = p.stdlib.decls[i].name()
			match p.builtins.stdlibTypeMap.get(name) 'tm'
				some(tid) then p.stdlib.tables.setDeclType(ord, t: tid)
				none then _ = 0
			end 'tm'
			match p.builtins.stdlibFuncMap.get(name) 'fm'
				some(fid) then p.stdlib.tables.setDeclFunc(ord, f: fid)
				none then _ = 0
			end 'fm'
		end 'stdReg'
		return p
	end 'new'

	static function view(consumes root String, consumes target Target, rootModule diag.ModuleID, consumes modules ModuleList, consumes stdlib Module, consumes byPath frozen with PathModMap, consumes types TypeTable, consumes funcs FuncTable, consumes builtins frozen with Builtins, consumes resolutions Array with frozen with Resolution, consumes typings Array with frozen with Typing) returns Project
		return Project{root: root, target: target, rootModule: rootModule, modules: modules, stdlib: stdlib, byPath: byPath, types: types, funcs: funcs, builtins: builtins, resolutions: resolutions, typings: typings}
	end 'view'
end 'Project'

// viewOf is the project as a task of a module reads it, made of shares of the products of the stages it waited on: modules,
// the tables of types and functions, resolutions and typings, each a view or a share, and the rest of p shared.
export function viewOf(p Project, consumes modules ModuleList, consumes types TypeTable, consumes funcs FuncTable, consumes resolutions Array with frozen with Resolution, consumes typings Array with frozen with Typing) returns Project
	let stdlib = p.stdlib.viewOf(share(p.stdlib.tree), parsed: true, viewTables: p.stdlib.tables.viewOf(everySegment))
	return Project.view(p.root.clone(), target: p.target.clone(), rootModule: p.rootModule, modules: modules, stdlib: stdlib, byPath: share(p.byPath), types: types, funcs: funcs, builtins: share(p.builtins), resolutions: resolutions, typings: typings)
end 'viewOf'

export function addModule(mutates p Project, consumes m Module) returns diag.ModuleID
	let id = try p.modules.count() as diag.ModuleID otherwise panic("too many modules")
	var copyM = m
	copyM.id = id
	var tree = thaw(copyM.tree)
	tree.module = id
	copyM.tree = freeze(tree)
	var byPath = thaw(p.byPath)
	byPath.insert(copyM.path, value: id)
	p.byPath = freeze(byPath)
	p.modules.push(copyM)
	addSlots(p.types, ft: p.funcs)
	p.resolutions.push(freeze(Resolution.new(id)))
	p.typings.push(freeze(Typing.new(id)))
	return id
end 'addModule'

// ModuleBody is what a module holds of its source and of its check: the parts that only a compile of the module itself
// reads, and that a compile of another module never does.
export type ModuleBody
	export var files as frozen with FileSpanList
	export var tree as frozen with Tree
	export var decls as frozen with DeclList
	export var names as frozen with DeclIndex
	export var resolution as frozen with Resolution
	export var typing as frozen with Typing

	export static function make(consumes files frozen with FileSpanList, consumes tree frozen with Tree, consumes decls frozen with DeclList, consumes names frozen with DeclIndex, consumes resolution frozen with Resolution, consumes typing frozen with Typing) returns ModuleBody
		return ModuleBody{files: files, tree: tree, decls: decls, names: names, resolution: resolution, typing: typing}
	end 'make'
end 'ModuleBody'

// takeBody takes the body of a module out of the project, which keeps the module with an empty one.
export function takeBody(mutates p Project, module diag.ModuleID) returns ModuleBody
	let m = modIndex(module)
	let files = exchange(p.modules[m].files, value: freeze(FileSpanList.create(0)))
	let tree = exchange(p.modules[m].tree, value: freeze(Tree.new(module, text: "")))
	let decls = exchange(p.modules[m].decls, value: freeze(DeclList.create(0)))
	let names = exchange(p.modules[m].names, value: freeze(DeclIndex.new()))
	let resolution = exchange(p.resolutions[m], value: freeze(Resolution.new(module)))
	let typing = exchange(p.typings[m], value: freeze(Typing.new(module)))
	return ModuleBody.make(files, tree: tree, decls: decls, names: names, resolution: resolution, typing: typing)
end 'takeBody'

// putBody gives a module the body that takeBody took.
export function putBody(mutates p Project, module diag.ModuleID, consumes body ModuleBody)
	let m = modIndex(module)
	var held = body
	p.modules[m].files = exchange(held.files, value: freeze(FileSpanList.create(0)))
	p.modules[m].tree = exchange(held.tree, value: freeze(Tree.new(module, text: "")))
	p.modules[m].decls = exchange(held.decls, value: freeze(DeclList.create(0)))
	p.modules[m].names = exchange(held.names, value: freeze(DeclIndex.new()))
	p.resolutions[m] = exchange(held.resolution, value: freeze(Resolution.new(module)))
	p.typings[m] = exchange(held.typing, value: freeze(Typing.new(module)))
end 'putBody'

// rootQualifier and stdlibQualifier start a qualified name of the root module's and of the standard library's
// declarations; every other module is qualified by its path.
export let rootQualifier = "export"

export let stdlibQualifier = "stdlib"

// runtimeQualifier names the runtime module wherever it is compiled, so that its functions have the symbols the compiler
// calls them by (ir.rtSymbol).
export let runtimeQualifier = "runtime"

// moduleDecl is a copy of a declaration, with everything in it: a caller that needs one fact of it asks the accessor of that
// fact below, which reads the declaration where it is.
export function moduleDecl(p Project, ref DeclRef) returns Decl
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].clone()
	end 'std'
	return p.modules[ref.module as Count].decls[ref.ordinal as Count].clone()
end 'moduleDecl'

// declKindOf is what kind of declaration ref is.
export function declKindOf(p Project, ref DeclRef) returns DeclKind
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].kind()
	end 'std'
	return p.modules[ref.module as Count].decls[ref.ordinal as Count].kind()
end 'declKindOf'

export function declName(p Project, ref DeclRef) returns String
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].name()
	end 'std'
	return p.modules[ref.module as Count].decls[ref.ordinal as Count].name()
end 'declName'

export function declLevel(p Project, ref DeclRef) returns Visibility
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].level()
	end 'std'
	return p.modules[ref.module as Count].decls[ref.ordinal as Count].level()
end 'declLevel'

export function declNodeID(p Project, ref DeclRef) returns NodeID
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].nodeID()
	end 'std'
	return p.modules[ref.module as Count].decls[ref.ordinal as Count].nodeID()
end 'declNodeID'

export function declIsType(p Project, ref DeclRef) returns bool
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].isType()
	end 'std'
	return p.modules[ref.module as Count].decls[ref.ordinal as Count].isType()
end 'declIsType'

export function declIsConst(p Project, ref DeclRef) returns bool
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].isConst()
	end 'std'
	return p.modules[ref.module as Count].decls[ref.ordinal as Count].isConst()
end 'declIsConst'

// joinNames is the items with sep between each two.
export function joinNames(items StringList, sep String) returns String
	var buf = ByteArray.create(0)
	for i in 0 upto items.count() 'each'
		if i > 0 'sep'
			buf.append(sep.toByteArray())
		end 'sep'
		buf.append(items[i].toByteArray())
	end 'each'
	return String.from(buf)
end 'joinNames'

// A link name is the text that a code unit names a function or a type by, and the linker resolves symbols by it. It starts
// with the module that declares what it names, so two modules may each declare a `helper` or a `Counter`, and a generic
// instance applied to one of them is not the one applied to the other. It is formed so:
//
//	function      geometry::area             export::main
//	method        export::Counter.inc        (export::Box with stdlib::Count).make
//	instance      export::swap[stdlib::Count, export::Counter]
//	extension     geometry::extension export::Counter.reset: a method that a module other than the type's adds to it
//	type          export::Counter            export::Box with (geometry::Shape, Count=int(0 to 18446744073709551615))
export let linkSeparator = "::"

let intLinkAliasMark = "="

// moduleLinkPath is how a link name names the module that declares something.
export function moduleLinkPath(p Project, modID diag.ModuleID) returns String
	if modID == diag.stdlibID 'std'
		return stdlibQualifier
	end 'std'
	if p.modules[modIndex(modID)].isRuntime 'runtime'
		return runtimeQualifier
	end 'runtime'
	let path = p.modules[modIndex(modID)].path.clone()
	if path == "" 'root'
		return rootQualifier
	end 'root'
	return path
end 'moduleLinkPath'

function typeLinkNamesIn(p Project, tt TypeSlot, reads TypeTable, args TypeIDList) returns StringList
	var names = StringList.create(0)
	for i in 0 upto args.count() 'each'
		names.push(typeLinkNameIn(p, tt: tt, reads: reads, t: args[i]))
	end 'each'
	return names
end 'typeLinkNamesIn'

// nominalLinkName is the link name of a declared type, and of an instance of a generic one.
function nominalLinkName(p Project, tt TypeSlot, reads TypeTable, t TypeID) returns String
	let origin = typeEntry(tt, reads: reads, t: t).effectiveOrigin()
	if typeEntry(tt, reads: reads, t: origin).isTuple 'tuple'
		return "({joinNames(typeLinkNamesIn(p, tt: tt, reads: reads, args: typeEntry(tt, reads: reads, t: t).typeArgs), sep: ", ")})"
	end 'tuple'
	if not typeEntry(tt, reads: reads, t: origin).hasDecl 'undeclared'
		panic("the type {typeEntry(tt, reads: reads, t: origin).name} has no declaration, so no module can be named for its code")
	end 'undeclared'
	let declaring = typeEntry(tt, reads: reads, t: origin).decl.module
	let base = "{moduleLinkPath(p, modID: declaring)}{linkSeparator}{typeEntry(tt, reads: reads, t: origin).name}"
	if typeEntry(tt, reads: reads, t: t).typeArgs.count() == 0 'plain'
		return base
	end 'plain'
	if statesCount(tt, reads: reads, t: t) 'counted'
		return countedSpelling(base, count: "{statedCount(tt, reads: reads, t: t)}", element: typeLinkNameIn(p, tt: tt, reads: reads, t: typeEntry(tt, reads: reads, t: t).typeArgs[0]))
	end 'counted'
	return instanceSpelling(base, args: typeLinkNamesIn(p, tt: tt, reads: reads, args: typeEntry(tt, reads: reads, t: t).typeArgs))
end 'nominalLinkName'

// typeLinkName is the link name of a type. Two integer aliases of one name are told apart by their ranges, which is all the
// code for an integer type depends on.
export function typeLinkNameIn(p Project, tt TypeSlot, reads TypeTable, t TypeID) returns String
	return match typeKind(tt, reads: reads, t: t) 'k'
		invalid gives typeEntry(tt, reads: reads, t: t).name.clone()
		primBool gives typeEntry(tt, reads: reads, t: t).name.clone()
		primString gives typeEntry(tt, reads: reads, t: t).name.clone()
		primVoid gives typeEntry(tt, reads: reads, t: t).name.clone()
		primNever gives typeEntry(tt, reads: reads, t: t).name.clone()
		typeParam gives typeEntry(tt, reads: reads, t: t).name.clone()
		interfaceTy gives typeEntry(tt, reads: reads, t: t).name.clone()
		intRange gives intLinkName(tt, reads: reads, t: t)
		constInt gives "integer constant {typeEntry(tt, reads: reads, t: t).minVal.toString()}"
		floatRange gives floatLinkName(tt, reads: reads, t: t)
		constFloat gives "float constant {floatLowBits(tt, reads: reads, t: t)}"
		record gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		enumTy gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		unionTy gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		builtinArray gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		builtinMap gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		builtinList gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		builtinPool gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		builtinHandle gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		builtinFrozen gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		builtinCown gives nominalLinkName(p, tt: tt, reads: reads, t: t)
		funcTy gives funcTypeLinkName(p, tt: tt, reads: reads, t: t)
	end 'k'
end 'typeLinkNameIn'

// funcTypeLinkName is the link name of a function type: its conventions, its parameters and its result.
function funcTypeLinkName(p Project, tt TypeSlot, reads TypeTable, t TypeID) returns String
	var b = ByteArray.create(0)
	b.append("function(".toByteArray())
	for i in 0 upto funcParamCount(tt, reads: reads, t: t) 'params'
		if i > 0 'sep'
			b.append(", ".toByteArray())
		end 'sep'
		b.append("{funcParamConv(tt, reads: reads, t: t, index: i).keyword()} {typeLinkNameIn(p, tt: tt, reads: reads, t: funcParamType(tt, reads: reads, t: t, index: i))}".toByteArray())
	end 'params'
	b.append(") {typeLinkNameIn(p, tt: tt, reads: reads, t: funcResult(tt, reads: reads, t: t))}".toByteArray())
	return String.from(b)
end 'funcTypeLinkName'

function floatLinkName(tt TypeSlot, reads TypeTable, t TypeID) returns String
	let spelling = "float({floatLowBits(tt, reads: reads, t: t)} to {floatHighBits(tt, reads: reads, t: t)})"
	if typeEntry(tt, reads: reads, t: t).name == "" 'anonymous'
		return spelling
	end 'anonymous'
	return "{typeEntry(tt, reads: reads, t: t).name}{intLinkAliasMark}{spelling}"
end 'floatLinkName'

function intLinkName(tt TypeSlot, reads TypeTable, t TypeID) returns String
	let spelling = intSpelling(tt, reads: reads, t: t)
	if typeEntry(tt, reads: reads, t: t).name == "" 'anonymous'
		return spelling
	end 'anonymous'
	return "{typeEntry(tt, reads: reads, t: t).name}{intLinkAliasMark}{spelling}"
end 'intLinkName'

let extensionLinkWord = "extension"

// declaringModule is the module that declares the type t, which is the standard library for one that has no declaration.
export function declaringModuleIn(tt TypeSlot, reads TypeTable, t TypeID) returns diag.ModuleID
	let origin = typeEntry(tt, reads: reads, t: t).effectiveOrigin()
	if typeEntry(tt, reads: reads, t: origin).hasDecl 'declared'
		return typeEntry(tt, reads: reads, t: origin).decl.module
	end 'declared'
	return diag.stdlibID
end 'declaringModuleIn'

// funcLinkName is the link name of a function: the module and the name of a free function, with the type arguments of an
// instance, and the type and the name of a method, in parentheses where the type is an instance; an instance given a
// conformance outside its type argument's module ends with the modules of its conformances. A method that an extension of
// an interface adds is named by its module and the interface, with the type it was made for among its type arguments,
// so it never takes the name of a method of that type.
export function funcLinkNameIn(p Project, tt TypeSlot, reads TypeTable, ft FuncSlot, funcReads FuncTable, fid FuncID) returns String
	let name = funcEntry(ft, funcReads: funcReads, f: fid).name.clone()
	let owner = funcEntry(ft, funcReads: funcReads, f: fid).ownerTy
	let iface = funcEntry(ft, funcReads: funcReads, f: fid).extendedIface
	if iface != noType 'ofInterface'
		let args = joinNames(typeLinkNamesIn(p, tt: tt, reads: reads, args: funcEntry(ft, funcReads: funcReads, f: fid).typeArgs), sep: ", ")
		return "{moduleLinkPath(p, modID: funcEntry(ft, funcReads: funcReads, f: fid).module)}{linkSeparator}{extensionLinkWord} {typeLinkNameIn(p, tt: tt, reads: reads, t: iface)}.{name}[{args}]{witnessSuffix(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid)}"
	end 'ofInterface'
	if owner != noType 'method'
		let ownerName = typeLinkNameIn(p, tt: tt, reads: reads, t: owner)
		var text = "{ownerName}.{name}"
		if typeEntry(tt, reads: reads, t: owner).typeArgs.count() > 0 'instance'
			text = "({ownerName}).{name}"
		end 'instance'
		let declaring = funcEntry(ft, funcReads: funcReads, f: fid).module
		if declaring != declaringModuleIn(tt, reads: reads, t: owner) 'extension'
			return "{moduleLinkPath(p, modID: declaring)}{linkSeparator}{extensionLinkWord} {text}{witnessSuffix(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid)}"
		end 'extension'
		return "{text}{witnessSuffix(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid)}"
	end 'method'
	let base = "{moduleLinkPath(p, modID: funcEntry(ft, funcReads: funcReads, f: fid).module)}{linkSeparator}{name}"
	if funcEntry(ft, funcReads: funcReads, f: fid).typeArgs.count() > 0 'instance'
		return "{base}[{joinNames(typeLinkNamesIn(p, tt: tt, reads: reads, args: funcEntry(ft, funcReads: funcReads, f: fid).typeArgs), sep: ", ")}]{witnessSuffix(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid)}"
	end 'instance'
	return base
end 'funcLinkNameIn'

// modulePath is the path of a module, which the standard library has none of.
function modulePath(p Project, modID diag.ModuleID) returns String
	if modID == diag.stdlibID 'std'
		return ""
	end 'std'
	return p.modules[modIndex(modID)].path.clone()
end 'modulePath'

// describeModule names a module in a sentence.
export function describeModule(p Project, modID diag.ModuleID) returns String
	if modID != diag.stdlibID and p.modules[modIndex(modID)].path == "" 'rt'
		return "the project root"
	end 'rt'
	if modID == diag.stdlibID 'std'
		return "module {p.stdlib.display()}"
	end 'std'
	return "module {p.modules[modIndex(modID)].display()}"
end 'describeModule'

// isVisibleFrom is whether something that the module owner declares with the visibility v can be named from the module
// from.
export function isVisibleFrom(p Project, v Visibility, owner diag.ModuleID, from diag.ModuleID) returns bool
	return isVisible(v, owner: owner, ownerPath: modulePath(p, modID: owner), from: from, fromPath: modulePath(p, modID: from))
end 'isVisibleFrom'

// notVisible is the message for naming, from the module from, something named name that owner declares with the
// visibility v, which isVisibleFrom refused.
export function notVisible(p Project, name String, v Visibility, owner diag.ModuleID, from diag.ModuleID) returns String
	let fromWord = describeModule(p, modID: from)
	if v == Visibility.unexported 'priv'
		return "'{name}' is not exported from {describeModule(p, modID: owner)}: mark it 'export' to use it from {fromWord}"
	end 'priv'
	return "'{name}' is exported only to module {parentPath(modulePath(p, modID: owner))} and the modules under it: mark it 'public' to use it from {fromWord}"
end 'notVisible'

// functionNamed is the function that a module declares by name at its top level, or noFunc when the name is not one.
export function functionNamed(p Project, ms ModuleState, module diag.ModuleID, name String) returns FuncID
	return match p.modules[modIndex(module)].names.get(name) 'declared'
		some(ord) gives declaredFunction(p, ms: ms, module: module, ord: ord)
		none gives noFunc
	end 'declared'
end 'functionNamed'

// declaredFunction is the function that a module's declaration at ord is, or noFunc when it is not a function.
export function declaredFunction(p Project, ms ModuleState, module diag.ModuleID, ord DeclOrdinal) returns FuncID
	let isFunction = match p.modules[modIndex(module)].decls[ord as Count] 'kind'
		funcDecl(_) gives true
		typeDecl(_) gives false
		enumDecl(_) gives false
		unionDecl(_) gives false
		interfaceDecl(_) gives false
		extensionDecl(_) gives false
		aliasDecl(_) gives false
		constDecl(_) gives false
	end 'kind'
	if not isFunction 'other'
		return noFunc
	end 'other'
	return match declFunc(p, ms: ms, ref: DeclRef.make(module, ordinal: ord)) 'fid'
		some(fid) gives fid
		none gives noFunc
	end 'fid'
end 'declaredFunction'

// typeLinkName is the link name of the type t, read in the project's tables by work that holds no slot of them: what
// runs outside the tasks of a compile.
export function typeLinkName(p Project, t TypeID) returns String
	return typeLinkNameIn(p, tt: TypeSlot.none(), reads: p.types, t: t)
end 'typeLinkName'

// funcLinkName is the link name of the function fid, read in the project's tables by work that holds no slot of them.
export function funcLinkName(p Project, fid FuncID) returns String
	return funcLinkNameIn(p, tt: TypeSlot.none(), reads: p.types, ft: FuncSlot.none(), funcReads: p.funcs, fid: fid)
end 'funcLinkName'
