// An extension adds methods, and conformances, to a type that another declaration names. They belong to the module that
// writes the extension: a module's declare stage never writes into another module's types. As Hylo scopes them, what an
// extension adds is seen from its own module and from the modules that name it, which are the ones whose check can have
// waited for it. Two declarations seen at one place that give a type one method, or one conformance, are ambiguous: no
// order of search settles between them.

// extensionKey is the key under which the extensions of the type t are filed, or none for a type no extension can name:
// the declaration of a type, an enum, a union or a built-in generic type, String, bool, for every integer the one
// anonymous integer type that `int` names, and for every float the one that `float` names.
export function extensionKey(p Project, ms ModuleState, t TypeID) returns table.Option with TypeID
	return match typeKind(ms.types, reads: p.types, t: t) 'k'
		record gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		enumTy gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		unionTy gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinArray gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinList gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinPool gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinHandle gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinFrozen gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinCown gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinCursor gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinGroups gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinPromise gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		builtinService gives table.Option.some(originOf(ms.types, reads: p.types, t: t))
		primBool gives table.Option.some(p.builtins.boolTy)
		primString gives table.Option.some(p.builtins.stringTy)
		primCharacter gives table.Option.some(p.builtins.characterTy)
		intRange gives table.Option.some(p.builtins.anon64Ty)
		constInt gives table.Option.some(p.builtins.anon64Ty)
		invalid gives table.Option.none
		primVoid gives table.Option.none
		primNever gives table.Option.none
		typeParam gives table.Option.none
		interfaceTy gives table.Option.none
		floatRange gives table.Option.some(p.builtins.anonFloatTy)
		constFloat gives table.Option.some(p.builtins.anonFloatTy)
		funcTy gives table.Option.none
	end 'k'
end 'extensionKey'

// methodIn is the method of that name that the module's extensions add to the type owner, or none.
export function methodIn(tables ModuleTables, owner TypeID, name String) returns FuncID
	for i in 0 upto tables.extMethodCount() 'each'
		if tables.extMethod(i).owner == owner and tables.extMethod(i).name == name 'hit'
			return tables.extMethod(i).func
		end 'hit'
	end 'each'
	return noFunc
end 'methodIn'

// aliasIn is the typealias of that name that the module's extensions add to the type owner, or none.
function aliasIn(module diag.ModuleID, tables ModuleTables, owner TypeID, name String) returns table.Option with DeclRef
	for i in 0 upto tables.extAliasCount() 'each'
		if tables.extAlias(i).owner == owner and tables.extAlias(i).name == name 'hit'
			return table.Option.some(DeclRef.make(module, ordinal: tables.extAlias(i).ordinal))
		end 'hit'
	end 'each'
	return table.Option.none
end 'aliasIn'

// bodyAlias is the typealias that the body of the declaration of the type t declares under that name, or none: a type that
// has no declaration, as Array, declares none.
export function bodyAlias(p Project, ms ModuleState, t TypeID, member String) returns table.Option with DeclRef
	let origin = originOf(ms.types, reads: p.types, t: t)
	if not typeEntry(ms.types, reads: p.types, t: origin).hasDecl 'undeclared'
		return table.Option.none
	end 'undeclared'
	let owner = typeEntry(ms.types, reads: p.types, t: origin).decl.clone()
	let key = nestedAliasName(typeEntry(ms.types, reads: p.types, t: origin).name, name: member)
	var found as table.Option with DeclOrdinal
	if owner.module == diag.stdlibID 'std'
		found = p.stdlib.names.get(key)
	end 'std' else 'module'
		found = p.modules[modIndex(owner.module)].names.get(key)
	end 'module'
	match consumes found 'declared'
		some(ord) then return aliasOfBody(p, owner: owner, ref: DeclRef.make(owner.module, ordinal: ord))
		none then return table.Option.none
	end 'declared'
end 'bodyAlias'

// aliasOfBody is the declaration at ref, when it is a typealias that the body of the declaration owner declares, and not one of
// its extensions.
function aliasOfBody(p Project, owner DeclRef, ref DeclRef) returns table.Option with DeclRef
	if declKindOf(p, ref: ref) == DeclKind.aliasDecl and declaresAliasNode(moduleDecl(p, ref: owner), id: declNodeID(p, ref: ref)) 'alias'
		return table.Option.some(ref.clone())
	end 'alias'
	return table.Option.none
end 'aliasOfBody'

// isRefusedExtensionAlias is whether the typealias at the ordinal is one that an extension declares and that was refused, which
// gives it no type: a type that the extension does not extend, or a name that is taken.
export function isRefusedExtensionAlias(tables ModuleTables, ordinal DeclOrdinal) returns bool
	for i in 0 upto tables.extAliasCount() 'each'
		if tables.extAlias(i).ordinal == ordinal and tables.extAlias(i).extended == noType 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'isRefusedExtensionAlias'

// extendedBy is the type that the extension adding the typealias at ref extends, whichever module writes it.
export function extendedBy(p Project, ms ModuleState, ref DeclRef) returns TypeID
	if ref.module == ms.module 'own'
		return extendedIn(ms.tables, ref: ref)
	end 'own'
	p.modules[modIndex(ref.module)].tables.requireHeld()
	return extendedIn(p.modules[modIndex(ref.module)].tables, ref: ref)
end 'extendedBy'

function extendedIn(tables ModuleTables, ref DeclRef) returns TypeID
	for i in 0 upto tables.extAliasCount() 'each'
		if tables.extAlias(i).ordinal == ref.ordinal 'hit'
			return tables.extAlias(i).extended
		end 'hit'
	end 'each'
	panic("the typealias at ordinal {ref.ordinal} is added by no extension")
end 'extendedIn'

// isExtensionAlias is whether an extension of the module declares the typealias at the ordinal.
export function isExtensionAlias(tables ModuleTables, ordinal DeclOrdinal) returns bool
	for i in 0 upto tables.extAliasCount() 'each'
		if tables.extAlias(i).ordinal == ordinal 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'isExtensionAlias'

// conformanceAt is the interface that an extension says t implements, which the extension writes over the parameters of t's
// declaration, as t's type arguments bind them.
function conformanceAt(p Project, mutates ms ModuleState, written TypeID, t TypeID) returns TypeID
	let params = cloneTypeArgs(typeEntry(ms.types, reads: p.types, t: originOf(ms.types, reads: p.types, t: t)).typeParams)
	if params.count() == 0 'plain'
		return written
	end 'plain'
	return substituteType(ms.types, reads: p.types, t: written, params: params, args: typeArgsOf(ms.types, reads: p.types, t: t))
end 'conformanceAt'

// givesConformance is whether the index-th conformance that the extensions of the module m declare holds where code sees
// it: everywhere in m, and outside it only where m declares the type or the interface.
function givesConformance(p Project, ms ModuleState, module diag.ModuleID, tables ModuleTables, index Count, outside bool) returns bool
	return not outside or declaringModuleIn(ms.types, reads: p.types, t: tables.extConform(index).owner) == module or declaringModuleIn(ms.types, reads: p.types, t: tables.extConform(index).iface) == module
end 'givesConformance'

// seenInterfaces are the interfaces that the declarations code in the module from sees say t implements, as they are
// written, over the parameters of t's declaration: its own declaration's, then those of the extensions of from and of the
// modules from names that give it one.
export function seenInterfaces(p Project, ms ModuleState, from diag.ModuleID, t TypeID) returns TypeIDList
	var out = TypeIDList.create(0)
	if typeKind(ms.types, reads: p.types, t: t) == TypeKind.interfaceTy or typeKind(ms.types, reads: p.types, t: t) == TypeKind.typeParam 'abstract'
		return out
	end 'abstract'
	out.append(typeEntry(ms.types, reads: p.types, t: originOf(ms.types, reads: p.types, t: t)).conforms)
	let key = extensionKey(p, ms: ms, t: t)
	if key.isSome() and from != diag.stdlibID 'extensions'
		let owner = key.unwrap()
		appendConformsOf(p, ms: ms, module: from, owner: owner, outside: false, out: out)
		for i in 0 upto namedCount(p, ms: ms, module: from) 'deps'
			let dep = namedModule(p, ms: ms, module: from, index: i)
			if dep != from 'other'
				appendConformsOf(p, ms: ms, module: dep, owner: owner, outside: true, out: out)
			end 'other'
		end 'deps'
	end 'extensions'
	return out
end 'seenInterfaces'

function appendConformsInModule(p Project, ms ModuleState, module diag.ModuleID, tables ModuleTables, owner TypeID, outside bool, mutates out TypeIDList)
	for i in 0 upto tables.extConformCount() 'each'
		if tables.extConform(i).owner == owner and givesConformance(p, ms: ms, module: module, tables: tables, index: i, outside: outside) 'hit'
			out.push(tables.extConform(i).iface)
		end 'hit'
	end 'each'
end 'appendConformsInModule'

// interfaceExtensionMethod is what the name finds among the methods that extensions of interfaces add, where code in the
// module from sees them, for a value whose type implements the interfaces have: one of an interface that one of them is or
// extends. A method of an interface outranks one of an interface it extends, as a type's own method outranks one an
// extension adds; two that neither outranks are ambiguous. The standard library sees none.
export function interfaceExtensionMethod(p Project, ms ModuleState, from diag.ModuleID, have TypeIDList, name String) returns MethodLookup
	if from == diag.stdlibID or have.count() == 0 'none'
		return MethodLookup.absent
	end 'none'
	var found = FuncIDList.create(0)
	collectInterfaceMethodsOf(p, ms: ms, module: from, have: have, name: name, found: found)
	for i in 0 upto namedCount(p, ms: ms, module: from) 'deps'
		collectInterfaceMethodsOf(p, ms: ms, module: namedModule(p, ms: ms, module: from, index: i), have: have, name: name, found: found)
	end 'deps'
	var best = FuncIDList.create(0)
	for i in 0 upto found.count() 'rank'
		if not outranked(p, ms: ms, found: found, index: i) 'kept'
			best.push(found[i])
		end 'kept'
	end 'rank'
	if best.count() == 0 'absent'
		return MethodLookup.absent
	end 'absent'
	if best.count() == 1 'one'
		return MethodLookup.found(best[0])
	end 'one'
	return MethodLookup.ambiguous(best[0], second: best[1])
end 'interfaceExtensionMethod'

function collectInterfaceMethods(p Project, ms ModuleState, tables ModuleTables, have TypeIDList, name String, mutates found FuncIDList)
	for i in 0 upto tables.extMethodCount() 'each'
		let owner = tables.extMethod(i).owner
		if tables.extMethod(i).name == name and typeKind(ms.types, reads: p.types, t: owner) == TypeKind.interfaceTy and reachedBy(ms.types, reads: p.types, have: have, want: owner) and not found.contains(tables.extMethod(i).func) 'hit'
			found.push(tables.extMethod(i).func)
		end 'hit'
	end 'each'
end 'collectInterfaceMethods'

// reachedBy is whether one of the interfaces have is an instance of the interface declaration want, or extends one.
function reachedBy(tt TypeSlot, reads TypeTable, have TypeIDList, want TypeID) returns bool
	for i in 0 upto have.count() 'each'
		if reachesInterface(tt, reads: reads, have: have[i], want: want) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'reachedBy'

// outranked is whether another of the methods found is one of an interface that extends the interface of the index-th.
function outranked(p Project, ms ModuleState, found FuncIDList, index Count) returns bool
	let mine = funcEntry(ms.funcs, funcReads: p.funcs, f: found[index]).extendedIface
	for j in 0 upto found.count() 'others'
		let theirs = funcEntry(ms.funcs, funcReads: p.funcs, f: found[j]).extendedIface
		if theirs != mine and reachesInterface(ms.types, reads: p.types, have: theirs, want: mine) 'more'
			return true
		end 'more'
	end 'others'
	return false
end 'outranked'

// interfaceExtensionArgs are the type arguments of the method fid that an extension of an interface adds, called on a
// value of the type recv, which implements the interfaces have: recv, then the associated types that the one of them that
// is the extended interface binds, at recv's type arguments.
export function interfaceExtensionArgs(p Project, mutates ms ModuleState, recv TypeID, have TypeIDList, fid FuncID) returns TypeIDList
	let origin = funcEntry(ms.funcs, funcReads: p.funcs, f: fid).extendedIface
	var args = TypeIDList.create(0)
	args.push(recv)
	for i in 0 upto have.count() 'each'
		if originOf(ms.types, reads: p.types, t: have[i]) == origin 'direct'
			let declared = originOf(ms.types, reads: p.types, t: recv)
			let params = cloneTypeArgs(typeEntry(ms.types, reads: p.types, t: declared).typeParams)
			let bound = substituteType(ms.types, reads: p.types, t: have[i], params: params, args: typeArgsOf(ms.types, reads: p.types, t: recv))
			args.append(typeEntry(ms.types, reads: p.types, t: bound).typeArgs)
			return args
		end 'direct'
	end 'each'
	for i in 0 upto have.count() 'inherited'
		let declared = originOf(ms.types, reads: p.types, t: recv)
		let params = cloneTypeArgs(typeEntry(ms.types, reads: p.types, t: declared).typeParams)
		let bound = substituteType(ms.types, reads: p.types, t: have[i], params: params, args: typeArgsOf(ms.types, reads: p.types, t: recv))
		let ancestor = ancestorBindings(ms.types, reads: p.types, have: bound, want: origin)
		if ancestor.isSome() 'found'
			args.append(ancestor.unwrap())
			return args
		end 'found'
	end 'inherited'
	return args
end 'interfaceExtensionArgs'

// interfaceExtensionSymbol is how a message names a method that an extension of an interface adds: by the interface, and
// for an instance with the type arguments it was made for.
export function interfaceExtensionSymbol(p Project, tt TypeSlot, reads TypeTable, ft FuncSlot, funcReads FuncTable, fid FuncID) returns String
	let name = "{typeName(tt, reads: reads, t: funcEntry(ft, funcReads: funcReads, f: fid).extendedIface)}.{funcEntry(ft, funcReads: funcReads, f: fid).name}"
	if funcEntry(ft, funcReads: funcReads, f: fid).typeArgs.count() == 0 'origin'
		return name
	end 'origin'
	var names = StringList.create(0)
	for i in 0 upto funcEntry(ft, funcReads: funcReads, f: fid).typeArgs.count() 'args'
		names.push(typeName(tt, reads: reads, t: funcEntry(ft, funcReads: funcReads, f: fid).typeArgs[i]))
	end 'args'
	return "{name}[{joinNames(names, sep: ", ")}]"
end 'interfaceExtensionSymbol'

// A MethodLookup is what a method's name finds among the methods that extensions add to a type: nothing, one method, or two
// of different extensions, which is ambiguous.
export union MethodLookup
	absent
	found(fid FuncID)
	ambiguous(first FuncID, second FuncID)

	export function isAbsent() returns bool
		return match self 'k'
			absent gives true
			found(_) gives false
			ambiguous(_, _) gives false
		end 'k'
	end 'isAbsent'
end 'MethodLookup'

// extensionMethod is what the name finds among the methods that extensions add to the type owner where code in the module
// from sees them: its own module's, and the modules it names. The standard library sees none.
export function extensionMethod(p Project, ms ModuleState, from diag.ModuleID, owner TypeID, name String) returns MethodLookup
	if from == diag.stdlibID 'library'
		return MethodLookup.absent
	end 'library'
	var seen = methodOf(p, ms: ms, module: from, owner: owner, name: name)
	for i in 0 upto namedCount(p, ms: ms, module: from) 'deps'
		let hit = methodOf(p, ms: ms, module: namedModule(p, ms: ms, module: from, index: i), owner: owner, name: name)
		if seen == noFunc 'first'
			seen = hit
		end 'first' else if hit != noFunc and hit != seen 'second'
			return MethodLookup.ambiguous(seen, second: hit)
		end 'second'
	end 'deps'
	if seen == noFunc 'none'
		return MethodLookup.absent
	end 'none'
	return MethodLookup.found(seen)
end 'extensionMethod'

// An AliasLookup is what a typealias's name finds among the ones that extensions add to a type: nothing, one, or two of
// different modules, which is ambiguous.
export union AliasLookup
	absent
	found(ref DeclRef)
	ambiguous(first DeclRef, second DeclRef)
end 'AliasLookup'

// extensionAlias is what the name finds among the typealiases that extensions add to the type owner where code in the module
// from sees them, by the rule of their methods: its own module's, and the modules it names. The standard library sees none.
export function extensionAlias(p Project, ms ModuleState, from diag.ModuleID, owner TypeID, name String) returns AliasLookup
	if from == diag.stdlibID 'library'
		return AliasLookup.absent
	end 'library'
	var seen = aliasOf(p, ms: ms, module: from, owner: owner, name: name)
	for i in 0 upto namedCount(p, ms: ms, module: from) 'deps'
		let hit = aliasOf(p, ms: ms, module: namedModule(p, ms: ms, module: from, index: i), owner: owner, name: name)
		if not hit.isSome() 'none'
			continue 'deps'
		end 'none'
		if not seen.isSome() 'first'
			seen = hit.clone()
			continue 'deps'
		end 'first'
		return AliasLookup.ambiguous(seen.unwrap(), second: hit.unwrap())
	end 'deps'
	match consumes seen 'k'
		some(ref) then return AliasLookup.found(ref)
		none then return AliasLookup.absent
	end 'k'
end 'extensionAlias'

// A Conformance is a declaration that says a type implements an interface: the type's own, in its module, or an extension
// of a module.
export type Conformance
	export var module as diag.ModuleID
	export var inBody as bool

	export static function make(module diag.ModuleID, inBody bool) returns Conformance
		return Conformance{module: module, inBody: inBody}
	end 'make'
end 'Conformance'

export typealias ConformanceList = Array with Conformance

// A ConformanceLookup is which declarations that code sees say a type implements an interface: none, one, or two, which
// is ambiguous.
export union ConformanceLookup
	absent
	found(conformance Conformance)
	ambiguous(first Conformance, second Conformance)
end 'ConformanceLookup'

// conformanceSource is the declaration that says t implements iface (or an interface that extends it) where code in the
// module from sees it: the type's own declaration, which is seen wherever the type is, or an extension of from, or of a
// module from names that declares the type or the interface. The standard library sees no extension.
export function conformanceSource(p Project, mutates ms ModuleState, from diag.ModuleID, t TypeID, iface TypeID) returns ConformanceLookup
	var seen = ConformanceList.create(0)
	if declaresConformance(p, ms: ms, t: t, iface: iface) 'body'
		seen.push(Conformance.make(declaringModuleIn(ms.types, reads: p.types, t: t), inBody: true))
	end 'body'
	let key = extensionKey(p, ms: ms, t: t)
	if key.isSome() and from != diag.stdlibID 'extensions'
		let owner = key.unwrap()
		if conformsOf(p, ms: ms, module: from, t: t, owner: owner, iface: iface, outside: false) 'own'
			seen.push(Conformance.make(from, inBody: false))
		end 'own'
		for i in 0 upto namedCount(p, ms: ms, module: from) 'deps'
			let dep = namedModule(p, ms: ms, module: from, index: i)
			if dep != from and conformsOf(p, ms: ms, module: dep, t: t, owner: owner, iface: iface, outside: true) 'hit'
				seen.push(Conformance.make(dep, inBody: false))
			end 'hit'
		end 'deps'
	end 'extensions'
	if seen.count() == 0 'none'
		return ConformanceLookup.absent
	end 'none'
	if seen.count() == 1 'one'
		return ConformanceLookup.found(seen[0].clone())
	end 'one'
	return ConformanceLookup.ambiguous(seen[0].clone(), second: seen[1].clone())
end 'conformanceSource'

// declaresConformance is whether the declaration of t says it implements iface, with t's type arguments in what it binds.
export function declaresConformance(p Project, mutates ms ModuleState, t TypeID, iface TypeID) returns bool
	let orig = originOf(ms.types, reads: p.types, t: t)
	let conforms = cloneTypeArgs(typeEntry(ms.types, reads: p.types, t: orig).conforms)
	let params = cloneTypeArgs(typeEntry(ms.types, reads: p.types, t: orig).typeParams)
	let args = typeArgsOf(ms.types, reads: p.types, t: t)
	for i in 0 upto conforms.count() 'each'
		let have = substituteType(ms.types, reads: p.types, t: conforms[i], params: params, args: args)
		if extendsInterface(ms.types, reads: p.types, have: have, want: iface) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'declaresConformance'

// describeConformance names a conformance of the type typeName in a message.
export function describeConformance(p Project, c Conformance, typeName String) returns String
	if c.inBody 'body'
		return "the declaration of '{typeName}' in {describeModule(p, modID: c.module)}"
	end 'body'
	return "an extension in {describeModule(p, modID: c.module)}"
end 'describeConformance'

// ambiguousConformanceText is the message for a type that two declarations the module from sees say implements the
// interface: a generic is given one conformance, and no order chooses between them.
export function ambiguousConformanceText(p Project, from diag.ModuleID, typeName String, ifaceName String, first Conformance, second Conformance) returns String
	let firstText = describeConformance(p, c: first, typeName: typeName)
	let secondText = describeConformance(p, c: second, typeName: typeName)
	let text = "'{typeName}' implements {ifaceName} twice where {describeModule(p, modID: from)} sees it: by {firstText} and by {secondText}, and a generic is given one conformance; remove one of them"
	if first.module != from and second.module != from 'elsewhere'
		return "{text}, or let this module name only one of the modules that declare them"
	end 'elsewhere'
	return text
end 'ambiguousConformanceText'

// boundSlots are the bounds of a generic function that an instance is given a conformance for: those of each of its type
// parameters, in order, then the 'where' of a method on its type's parameters. A capability is met by what the type is
// made of, so it needs none.
export function boundSlots(p Project, ms ModuleState, fn FuncID) returns ParamBoundList
	var out = ParamBoundList.create(0)
	for i in 0 upto funcEntry(ms.funcs, funcReads: p.funcs, f: fn).generics.count() 'params'
		let param = funcEntry(ms.funcs, funcReads: p.funcs, f: fn).generics[i]
		for j in 0 upto typeEntry(ms.types, reads: p.types, t: param).bounds.count() 'bounds'
			if not p.builtins.isCapability(typeEntry(ms.types, reads: p.types, t: param).bounds[j].ifaceTy) 'interface'
				out.push(typeEntry(ms.types, reads: p.types, t: param).bounds[j].clone())
			end 'interface'
		end 'bounds'
	end 'params'
	for i in 0 upto funcEntry(ms.funcs, funcReads: p.funcs, f: fn).bounds.count() 'own'
		if not p.builtins.isCapability(funcEntry(ms.funcs, funcReads: p.funcs, f: fn).bounds[i].ifaceTy) 'interface'
			out.push(funcEntry(ms.funcs, funcReads: p.funcs, f: fn).bounds[i].clone())
		end 'interface'
	end 'own'
	return out
end 'boundSlots'

// reachesInterface is whether the interface have is an instance of the interface declaration want, or extends one.
export function reachesInterface(tt TypeSlot, reads TypeTable, have TypeID, want TypeID) returns bool
	let orig = typeEntry(tt, reads: reads, t: have).effectiveOrigin()
	if orig == want 'same'
		return true
	end 'same'
	for i in 0 upto typeEntry(tt, reads: reads, t: orig).conforms.count() 'parents'
		if reachesInterface(tt, reads: reads, have: typeEntry(tt, reads: reads, t: orig).conforms[i], want: want) 'hit'
			return true
		end 'hit'
	end 'parents'
	return false
end 'reachesInterface'

// witnessLinkWord starts the modules of the conformances in the link name of an instance.
let witnessLinkWord = "using"

// witnessSuffix tells apart, in a link name and in the IR, the instances of one generic at the same type arguments that
// were given conformances of different modules: it is empty where each conformance is in its type argument's own module,
// and else names the module of each.
export function witnessSuffix(p Project, tt TypeSlot, reads TypeTable, ft FuncSlot, funcReads FuncTable, fid FuncID) returns String
	let count = funcEntry(ft, funcReads: funcReads, f: fid).witnesses.count()
	if count == 0 'none'
		return ""
	end 'none'
	let origin = funcEntry(ft, funcReads: funcReads, f: fid).genericOrigin
	var foreign = false
	var paths = StringList.create(0)
	for i in 0 upto count 'each'
		let module = funcEntry(ft, funcReads: funcReads, f: fid).witnesses[i].module
		paths.push(moduleLinkPath(p, modID: module))
		for gi in 0 upto funcEntry(ft, funcReads: funcReads, f: origin).generics.count() 'param'
			if funcEntry(ft, funcReads: funcReads, f: origin).generics[gi] == funcEntry(ft, funcReads: funcReads, f: fid).witnesses[i].paramTy and module != declaringModuleIn(tt, reads: reads, t: funcEntry(ft, funcReads: funcReads, f: fid).typeArgs[gi]) 'foreign'
				foreign = true
			end 'foreign'
		end 'param'
	end 'each'
	if not foreign 'own'
		return ""
	end 'own'
	return " {witnessLinkWord} {joinNames(paths, sep: ", ")}"
end 'witnessSuffix'

// A Requirement is a method that an interface requires, with the interface that declares it, which is the interface
// itself or one it extends: its signature is read over that interface's 'Self' and associated types, which bindings are
// what they stand for where the interface asked about is bound (none where it is not).
export type Requirement
	export var iface as TypeID
	export var sig as FuncID
	export var bindings as TypeIDList

	export static function make(iface TypeID, sig FuncID, consumes bindings TypeIDList) returns Requirement
		return Requirement{iface: iface, sig: sig, bindings: bindings}
	end 'make'
end 'Requirement'

export typealias RequirementList = Array with Requirement

// requirementsOf are the methods an interface requires, its own and then those of the interfaces it extends, each once.
// An instance of a generic interface reads them from its declaration. Their order is the order of the methods in the
// table of an interface value, so a call through one and the table agree on where each method is.
export function requirementsOf(tt TypeSlot, reads TypeTable, iface TypeID) returns RequirementList
	var out = RequirementList.create(0)
	collectRequirements(tt, reads: reads, iface: iface, bindings: typeArgsOf(tt, reads: reads, t: iface), out: out)
	return out
end 'requirementsOf'

function collectRequirements(tt TypeSlot, reads TypeTable, iface TypeID, bindings TypeIDList, mutates out RequirementList)
	let orig = originOf(tt, reads: reads, t: iface)
	for i in 0 upto typeEntry(tt, reads: reads, t: orig).sigs.count() 'own'
		let sig = typeEntry(tt, reads: reads, t: orig).sigs[i]
		if not requirementIndex(out, sig: sig).isSome() 'new'
			out.push(Requirement.make(iface, sig: sig, bindings: cloneTypeArgs(bindings)))
		end 'new'
	end 'own'
	for i in 0 upto typeEntry(tt, reads: reads, t: orig).conforms.count() 'parents'
		let parent = typeEntry(tt, reads: reads, t: orig).conforms[i]
		collectRequirements(tt, reads: reads, iface: parent, bindings: inheritedBindings(tt, reads: reads, child: orig, bindings: bindings, parent: parent), out: out)
	end 'parents'
end 'collectRequirements'

// inheritedBindings are what the associated types of parent, an interface that the interface child extends, stand for
// where child's stand for bindings: each is the one of child's of the same name, which child inherits where it does not
// declare it (README, "Generics"). Unbound, child binds none of them either.
export function inheritedBindings(tt TypeSlot, reads TypeTable, child TypeID, bindings TypeIDList, parent TypeID) returns TypeIDList
	var out = TypeIDList.create(0)
	if bindings.count() == 0 'unbound'
		return out
	end 'unbound'
	let childParams = typeEntry(tt, reads: reads, t: child).typeParams.clone()
	let parentParams = typeEntry(tt, reads: reads, t: parent).typeParams.clone()
	for i in 0 upto parentParams.count() 'each'
		let name = typeEntry(tt, reads: reads, t: parentParams[i]).name.clone()
		var found = false
		for j in 0 upto childParams.count() 'child'
			if typeEntry(tt, reads: reads, t: childParams[j]).name == name 'same'
				out.push(bindings[j])
				found = true
				break 'child'
			end 'same'
		end 'child'
		if not found 'missing'
			panic("the interface '{typeEntry(tt, reads: reads, t: child).name}' extends '{typeEntry(tt, reads: reads, t: parent).name}' without its associated type '{name}'")
		end 'missing'
	end 'each'
	return out
end 'inheritedBindings'

// requirementIndex is the place of the requirement sig among reqs, or none.
export function requirementIndex(reqs RequirementList, sig FuncID) returns table.Option with Count
	for i in 0 upto reqs.count() 'each'
		if reqs[i].sig == sig 'hit'
			return table.Option.some(i)
		end 'hit'
	end 'each'
	return table.Option.none
end 'requirementIndex'

// requirementSlot is the place of the requirement sig in the table of a value of the interface iface.
export function requirementSlot(tt TypeSlot, reads TypeTable, iface TypeID, sig FuncID) returns Count
	match consumes requirementIndex(requirementsOf(tt, reads: reads, iface: iface), sig: sig) 'slot'
		some(i) then return i
		none then panic("a call through a value of '{typeName(tt, reads: reads, t: iface)}' names a method that it does not require")
	end 'slot'
end 'requirementSlot'

// namedCount is how many modules the module names, and namedModule the one at index: the module's own resolution is read
// in the task's state, another's in the project.
export function namedCount(p Project, ms ModuleState, module diag.ModuleID) returns Count
	if module == ms.module 'own'
		return resolutionOf(p, ms: ms).deps.count()
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return p.resolutions[modIndex(module)].deps.count()
end 'namedCount'

export function namedModule(p Project, ms ModuleState, module diag.ModuleID, index Count) returns diag.ModuleID
	if module == ms.module 'own'
		return resolutionOf(p, ms: ms).deps[index].module
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return p.resolutions[modIndex(module)].deps[index].module
end 'namedModule'

// The functions below read what the extensions of a module add in its tables: the task's own module's in its state,
// another's in the project.

function methodOf(p Project, ms ModuleState, module diag.ModuleID, owner TypeID, name String) returns FuncID
	if module == ms.module 'own'
		return methodIn(ms.tables, owner: owner, name: name)
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return methodIn(p.modules[modIndex(module)].tables, owner: owner, name: name)
end 'methodOf'

function aliasOf(p Project, ms ModuleState, module diag.ModuleID, owner TypeID, name String) returns table.Option with DeclRef
	if module == ms.module 'own'
		return aliasIn(module, tables: ms.tables, owner: owner, name: name)
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	return aliasIn(module, tables: p.modules[modIndex(module)].tables, owner: owner, name: name)
end 'aliasOf'

// conformsOf is whether an extension of the module m says the type t, whose extensions are filed under owner, implements
// iface, or an interface that extends it. Seen from another module, only a conformance that m may give counts: one of a type or
// to an interface that m declares (Hylo's rule for orphans), so a module cannot change what a type it does not own means to
// an interface it does not own anywhere but in itself.
function conformsOf(p Project, mutates ms ModuleState, module diag.ModuleID, t TypeID, owner TypeID, iface TypeID, outside bool) returns bool
	var written = TypeIDList.create(0)
	if module == ms.module 'own'
		appendConformsInModule(p, ms: ms, module: module, tables: ms.tables, owner: owner, outside: outside, out: written)
	end 'own' else 'other'
		p.modules[modIndex(module)].tables.requireHeld()
		appendConformsInModule(p, ms: ms, module: module, tables: p.modules[modIndex(module)].tables, owner: owner, outside: outside, out: written)
	end 'other'
	for i in 0 upto written.count() 'each'
		let have = conformanceAt(p, ms: ms, written: written[i], t: t)
		if extendsInterface(ms.types, reads: p.types, have: have, want: iface) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'conformsOf'

function appendConformsOf(p Project, ms ModuleState, module diag.ModuleID, owner TypeID, outside bool, mutates out TypeIDList)
	if module == ms.module 'own'
		appendConformsInModule(p, ms: ms, module: module, tables: ms.tables, owner: owner, outside: outside, out: out)
		return
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	appendConformsInModule(p, ms: ms, module: module, tables: p.modules[modIndex(module)].tables, owner: owner, outside: outside, out: out)
end 'appendConformsOf'

function collectInterfaceMethodsOf(p Project, ms ModuleState, module diag.ModuleID, have TypeIDList, name String, mutates found FuncIDList)
	if module == ms.module 'own'
		collectInterfaceMethods(p, ms: ms, tables: ms.tables, have: have, name: name, found: found)
		return
	end 'own'
	p.modules[modIndex(module)].tables.requireHeld()
	collectInterfaceMethods(p, ms: ms, tables: p.modules[modIndex(module)].tables, have: have, name: name, found: found)
end 'collectInterfaceMethodsOf'
