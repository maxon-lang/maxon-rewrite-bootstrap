// An extension adds methods, and conformances, to a type that another declaration names. They belong to the module that
// writes the extension: a module's declare stage never writes into another module's types. As Hylo scopes them, what an
// extension adds is seen from its own module and from the modules that name it, which are the ones whose check can have
// waited for it. Two declarations seen at one place that give a type one method, or one conformance, are ambiguous: no
// order of search settles between them.

// extensionKey is the key under which the extensions of the type t are filed, or none for a type no extension can name:
// the declaration of a type, an enum, a union or a built-in generic type, String, bool, and for every integer the one
// anonymous integer type that `int` names.
export function extensionKey(p Project, t TypeID) returns table.Option with TypeID
	return match p.types.entries[t as Count].kind 'k'
		record gives table.Option.some(originOf(p.types, t: t))
		enumTy gives table.Option.some(originOf(p.types, t: t))
		unionTy gives table.Option.some(originOf(p.types, t: t))
		builtinArray gives table.Option.some(originOf(p.types, t: t))
		builtinMap gives table.Option.some(originOf(p.types, t: t))
		builtinList gives table.Option.some(originOf(p.types, t: t))
		builtinPool gives table.Option.some(originOf(p.types, t: t))
		builtinHandle gives table.Option.some(originOf(p.types, t: t))
		builtinFrozen gives table.Option.some(originOf(p.types, t: t))
		builtinCown gives table.Option.some(originOf(p.types, t: t))
		primBool gives table.Option.some(p.builtins.boolTy)
		primString gives table.Option.some(p.builtins.stringTy)
		intRange gives table.Option.some(p.builtins.anon64Ty)
		constInt gives table.Option.some(p.builtins.anon64Ty)
		invalid gives table.Option.none
		primVoid gives table.Option.none
		primNever gives table.Option.none
		typeParam gives table.Option.none
		interfaceTy gives table.Option.none
		floatRange gives table.Option.none
		constFloat gives table.Option.none
		funcTy gives table.Option.none
	end 'k'
end 'extensionKey'

// methodIn is the method of that name that the module's extensions add to the type owner, or none.
export function methodIn(m Module, owner TypeID, name String) returns FuncID
	for i in 0 upto m.extMethods.count() 'each'
		if m.extMethods[i].owner == owner and m.extMethods[i].name == name 'hit'
			return m.extMethods[i].func
		end 'hit'
	end 'each'
	return noFunc
end 'methodIn'

// conformsInModule is whether an extension of the module m says the type owner implements iface, or an interface that
// extends it. Seen from another module, only a conformance that m may give counts: one of a type or to an interface
// that m declares (Hylo's rule for orphans), so a module cannot change what a type it does not own means to an interface
// it does not own anywhere but in itself.
function conformsInModule(p Project, m Module, owner TypeID, iface TypeID, outside bool) returns bool
	for i in 0 upto m.extConforms.count() 'each'
		if m.extConforms[i].owner == owner and extendsInterface(p.types, have: m.extConforms[i].iface, want: iface) 'hit'
			if not outside or declaringModule(p, t: owner) == m.id or declaringModule(p, t: m.extConforms[i].iface) == m.id 'given'
				return true
			end 'given'
		end 'hit'
	end 'each'
	return false
end 'conformsInModule'

// A MethodLookup is what a method's name finds among the methods that extensions add to a type: nothing, one method, or two
// of different extensions, which is ambiguous.
export union MethodLookup
	absent
	found(fid FuncID)
	ambiguous(first FuncID, second FuncID)
end 'MethodLookup'

// extensionMethod is what the name finds among the methods that extensions add to the type owner where code in the module
// from sees them: its own module's, and the modules it names. The standard library sees none.
export function extensionMethod(p Project, from diag.ModuleID, owner TypeID, name String) returns MethodLookup
	if from == diag.stdlibID 'library'
		return MethodLookup.absent
	end 'library'
	var seen = methodIn(p.modules[modIndex(from)], owner: owner, name: name)
	for i in 0 upto p.resolutions[modIndex(from)].deps.count() 'deps'
		let hit = methodIn(p.modules[modIndex(p.resolutions[modIndex(from)].deps[i].module)], owner: owner, name: name)
		if seen == noFunc 'first'
			seen = hit
		end 'first' else if hit != noFunc and hit != seen 'second'
			return MethodLookup.ambiguous(seen, second: hit)
		end 'second'
	end 'deps'
	if seen == noFunc 'none'
		return MethodLookup.absent
	end 'none'
	return MethodLookup.found(seen)
end 'extensionMethod'

// A Conformance is a declaration that says a type implements an interface: the type's own, in its module, or an extension
// of a module.
export type Conformance
	export var module as diag.ModuleID
	export var inBody as bool

	export static function make(module diag.ModuleID, inBody bool) returns Conformance
		return Conformance{module: module, inBody: inBody}
	end 'make'
end 'Conformance'

export typealias ConformanceList = Array with Conformance

// A ConformanceLookup is which declarations that code sees say a type implements an interface: none, one, or two, which
// is ambiguous.
export union ConformanceLookup
	absent
	found(conformance Conformance)
	ambiguous(first Conformance, second Conformance)
end 'ConformanceLookup'

// conformanceSource is the declaration that says t implements iface (or an interface that extends it) where code in the
// module from sees it: the type's own declaration, which is seen wherever the type is, or an extension of from, or of a
// module from names that declares the type or the interface. The standard library sees no extension.
export function conformanceSource(mutates p Project, from diag.ModuleID, t TypeID, iface TypeID) returns ConformanceLookup
	var seen = ConformanceList.create(0)
	if declaresConformance(p, t: t, iface: iface) 'body'
		seen.push(Conformance.make(declaringModule(p, t: t), inBody: true))
	end 'body'
	let key = extensionKey(p, t: t)
	if key.isSome() and from != diag.stdlibID 'extensions'
		let owner = key.unwrap()
		if conformsInModule(p, m: p.modules[modIndex(from)], owner: owner, iface: iface, outside: false) 'own'
			seen.push(Conformance.make(from, inBody: false))
		end 'own'
		for i in 0 upto p.resolutions[modIndex(from)].deps.count() 'deps'
			let dep = p.resolutions[modIndex(from)].deps[i].module
			if dep != from and conformsInModule(p, m: p.modules[modIndex(dep)], owner: owner, iface: iface, outside: true) 'hit'
				seen.push(Conformance.make(dep, inBody: false))
			end 'hit'
		end 'deps'
	end 'extensions'
	if seen.count() == 0 'none'
		return ConformanceLookup.absent
	end 'none'
	if seen.count() == 1 'one'
		return ConformanceLookup.found(seen[0].clone())
	end 'one'
	return ConformanceLookup.ambiguous(seen[0].clone(), second: seen[1].clone())
end 'conformanceSource'

// declaresConformance is whether the declaration of t says it implements iface, with t's type arguments in what it binds.
export function declaresConformance(mutates p Project, t TypeID, iface TypeID) returns bool
	let orig = originOf(p.types, t: t)
	let conforms = cloneTypeArgs(p.types.entries[orig as Count].conforms)
	let params = cloneTypeArgs(p.types.entries[orig as Count].typeParams)
	let args = typeArgsOf(p.types, t: t)
	for i in 0 upto conforms.count() 'each'
		let have = substituteType(p.types, t: conforms[i], params: params, args: args)
		if extendsInterface(p.types, have: have, want: iface) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'declaresConformance'

// describeConformance names a conformance of the type typeName in a message.
export function describeConformance(p Project, c Conformance, typeName String) returns String
	if c.inBody 'body'
		return "the declaration of '{typeName}' in {describeModule(p, modID: c.module)}"
	end 'body'
	return "an extension in {describeModule(p, modID: c.module)}"
end 'describeConformance'

// ambiguousConformanceText is the message for a type that two declarations the module from sees say implements the
// interface: a generic is given one conformance, and no order chooses between them.
export function ambiguousConformanceText(p Project, from diag.ModuleID, typeName String, ifaceName String, first Conformance, second Conformance) returns String
	let firstText = describeConformance(p, c: first, typeName: typeName)
	let secondText = describeConformance(p, c: second, typeName: typeName)
	let text = "'{typeName}' implements {ifaceName} twice where {describeModule(p, modID: from)} sees it: by {firstText} and by {secondText}, and a generic is given one conformance; remove one of them"
	if first.module != from and second.module != from 'elsewhere'
		return "{text}, or let this module name only one of the modules that declare them"
	end 'elsewhere'
	return text
end 'ambiguousConformanceText'

// boundSlots are the bounds of a generic function that an instance is given a conformance for: those of each of its type
// parameters, in order, then the 'where' of a method on its type's parameters. A capability is met by what the type is
// made of, so it needs none.
export function boundSlots(p Project, fn FuncID) returns ParamBoundList
	var out = ParamBoundList.create(0)
	for i in 0 upto p.funcs.entries[fn as Count].generics.count() 'params'
		let param = p.funcs.entries[fn as Count].generics[i]
		for j in 0 upto p.types.entries[param as Count].bounds.count() 'bounds'
			if not p.builtins.isCapability(p.types.entries[param as Count].bounds[j].ifaceTy) 'interface'
				out.push(p.types.entries[param as Count].bounds[j].clone())
			end 'interface'
		end 'bounds'
	end 'params'
	for i in 0 upto p.funcs.entries[fn as Count].bounds.count() 'own'
		if not p.builtins.isCapability(p.funcs.entries[fn as Count].bounds[i].ifaceTy) 'interface'
			out.push(p.funcs.entries[fn as Count].bounds[i].clone())
		end 'interface'
	end 'own'
	return out
end 'boundSlots'

// reachesInterface is whether the interface have is an instance of the interface declaration want, or extends one.
export function reachesInterface(tt TypeTable, have TypeID, want TypeID) returns bool
	let orig = tt.entries[have as Count].effectiveOrigin()
	if orig == want 'same'
		return true
	end 'same'
	for i in 0 upto tt.entries[orig as Count].conforms.count() 'parents'
		if reachesInterface(tt, have: tt.entries[orig as Count].conforms[i], want: want) 'hit'
			return true
		end 'hit'
	end 'parents'
	return false
end 'reachesInterface'

// witnessLinkWord starts the modules of the conformances in the link name of an instance.
let witnessLinkWord = "using"

// witnessSuffix tells apart, in a link name and in the IR, the instances of one generic at the same type arguments that
// were given conformances of different modules: it is empty where each conformance is in its type argument's own module,
// and else names the module of each.
export function witnessSuffix(p Project, fid FuncID) returns String
	let count = p.funcs.entries[fid as Count].witnesses.count()
	if count == 0 'none'
		return ""
	end 'none'
	let origin = p.funcs.entries[fid as Count].genericOrigin
	var foreign = false
	var paths = StringList.create(0)
	for i in 0 upto count 'each'
		let module = p.funcs.entries[fid as Count].witnesses[i].module
		paths.push(moduleLinkPath(p, modID: module))
		for gi in 0 upto p.funcs.entries[origin as Count].generics.count() 'param'
			if p.funcs.entries[origin as Count].generics[gi] == p.funcs.entries[fid as Count].witnesses[i].paramTy and module != declaringModule(p, t: p.funcs.entries[fid as Count].typeArgs[gi]) 'foreign'
				foreign = true
			end 'foreign'
		end 'param'
	end 'each'
	if not foreign 'own'
		return ""
	end 'own'
	return " {witnessLinkWord} {joinNames(paths, sep: ", ")}"
end 'witnessSuffix'

// A Requirement is a method that an interface requires, with the interface that declares it, which is the interface
// itself or one it extends: its signature is read over that interface's 'Self' and associated types.
export type Requirement
	export var iface as TypeID
	export var sig as FuncID

	export static function make(iface TypeID, sig FuncID) returns Requirement
		return Requirement{iface: iface, sig: sig}
	end 'make'
end 'Requirement'

export typealias RequirementList = Array with Requirement

// requirementsOf are the methods an interface requires, its own and then those of the interfaces it extends, each once.
// An instance of a generic interface reads them from its declaration. Their order is the order of the methods in the
// table of an interface value, so a call through one and the table agree on where each method is.
export function requirementsOf(tt TypeTable, iface TypeID) returns RequirementList
	var out = RequirementList.create(0)
	collectRequirements(tt, iface: iface, out: out)
	return out
end 'requirementsOf'

function collectRequirements(tt TypeTable, iface TypeID, mutates out RequirementList)
	let orig = originOf(tt, t: iface)
	for i in 0 upto tt.entries[orig as Count].sigs.count() 'own'
		let sig = tt.entries[orig as Count].sigs[i]
		if not requirementIndex(out, sig: sig).isSome() 'new'
			out.push(Requirement.make(iface, sig: sig))
		end 'new'
	end 'own'
	for i in 0 upto tt.entries[orig as Count].conforms.count() 'parents'
		collectRequirements(tt, iface: tt.entries[orig as Count].conforms[i], out: out)
	end 'parents'
end 'collectRequirements'

// requirementIndex is the place of the requirement sig among reqs, or none.
export function requirementIndex(reqs RequirementList, sig FuncID) returns table.Option with Count
	for i in 0 upto reqs.count() 'each'
		if reqs[i].sig == sig 'hit'
			return table.Option.some(i)
		end 'hit'
	end 'each'
	return table.Option.none
end 'requirementIndex'

// requirementSlot is the place of the requirement sig in the table of a value of the interface iface.
export function requirementSlot(tt TypeTable, iface TypeID, sig FuncID) returns Count
	match consumes requirementIndex(requirementsOf(tt, iface: iface), sig: sig) 'slot'
		some(i) then return i
		none then panic("a call through a value of '{typeName(tt, t: iface)}' names a method that it does not require")
	end 'slot'
end 'requirementSlot'
