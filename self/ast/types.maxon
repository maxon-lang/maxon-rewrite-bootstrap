export typealias TypeID = int(0 to 9223372036854775807)

export typealias TypeIDList = Array with TypeID

export typealias FuncID = int(0 to 9223372036854775807)

export typealias FuncIDList = Array with FuncID

export typealias LocalID = int(0 to 2147483647)

export typealias LocalIDList = Array with LocalID

export let noType = 0 as TypeID

export let noFunc = 0 as FuncID

export let noLocal = 0 as LocalID

// SlotIndex is the place of a local among the slots of its function's frame, or noSlot for a parameter, which has none.
export typealias SlotIndex = int(-1 to 2147483647)

export let noSlot = -1 as SlotIndex

export let maxTypeDepth = 16 as Count

export enum TypeKind
	invalid
	primBool
	primString
	primVoid
	primNever
	intRange
	constInt
	floatRange
	constFloat
	record
	enumTy
	unionTy
	builtinArray
	builtinList
	builtinPool
	builtinHandle
	builtinFrozen
	builtinCown
	builtinCursor
	builtinPromise
	builtinService
	typeParam
	interfaceTy
	funcTy

	export function isBuiltin() returns bool
		return match self 'k'
			builtinArray gives true
			builtinList gives true
			builtinPool gives true
			builtinHandle gives true
			builtinFrozen gives true
			builtinCown gives true
			builtinCursor gives true
			builtinPromise gives true
			builtinService gives true
			invalid gives false
			primBool gives false
			primString gives false
			primVoid gives false
			primNever gives false
			intRange gives false
			constInt gives false
			floatRange gives false
			constFloat gives false
			record gives false
			enumTy gives false
			unionTy gives false
			typeParam gives false
			interfaceTy gives false
			funcTy gives false
		end 'k'
	end 'isBuiltin'
end 'TypeKind'

export enum Convention
	convLet
	convMutates
	convSets
	convConsumes
	convDestructs

	export function keyword() returns String
		return match self 'c'
			convLet gives "let"
			convMutates gives "mutates"
			convSets gives "sets"
			convConsumes gives "consumes"
			convDestructs gives "destructs"
		end 'c'
	end 'keyword'
end 'Convention'

export typealias ConventionList = Array with Convention

// ResultConv is how a function gives its result: a value the caller owns, or a place that the function borrows from its
// arguments and the caller only reads (`returns borrowed T`), as a let parameter lends one. A borrowed place the caller
// may change would be the next member.
export enum ResultConv
	resultOwned
	resultBorrowed
end 'ResultConv'

// borrowedWord is the word after `returns` that makes a function's result a borrowed place.
export let borrowedWord = "borrowed"

// parseResultConv is the convention that the word after `returns` gives a function's result: none for an owned value.
export function parseResultConv(word String) returns ResultConv
	if word == "" 'owned'
		return ResultConv.resultOwned
	end 'owned'
	if word == borrowedWord 'borrowed'
		return ResultConv.resultBorrowed
	end 'borrowed'
	panic("ast: '{word}' is no convention of a result")
end 'parseResultConv'

export function parseConvention(kw String) returns Convention
	if kw == "mutates" 'm'
		return Convention.convMutates
	end 'm'
	if kw == "sets" 's'
		return Convention.convSets
	end 's'
	if kw == "consumes" 'c'
		return Convention.convConsumes
	end 'c'
	if kw == "destructs" 'd'
		return Convention.convDestructs
	end 'd'
	return Convention.convLet
end 'parseConvention'

export type FieldInfo
	export var name as String
	export var ty as TypeID
	export var isVar as bool
	export var exported as bool
	export var level as Visibility
	export var hasDefault as bool
	export var defaultExpr as NodeID
	export var index as Count

	export static function make(consumes name String, ty TypeID, isVar bool, exported bool, hasDefault bool, defaultExpr NodeID, index Count) returns FieldInfo
		var level = Visibility.unexported
		if exported 'wide'
			level = Visibility.exported
		end 'wide'
		return FieldInfo{name: name, ty: ty, isVar: isVar, exported: exported, level: level, hasDefault: hasDefault, defaultExpr: defaultExpr, index: index}
	end 'make'
end 'FieldInfo'

export typealias FieldInfoList = Array with FieldInfo

export type CaseFieldInfo
	export var name as String
	export var ty as TypeID

	export static function make(consumes name String, ty TypeID) returns CaseFieldInfo
		return CaseFieldInfo{name: name, ty: ty}
	end 'make'
end 'CaseFieldInfo'

export typealias CaseFieldList = Array with CaseFieldInfo

// RawKind is what the raw values of an enum or a union are: the integers that count up from the case before, the floats and
// the strings that every case writes, or values that are not literals: a record, a function, anything an expression builds,
// which every case writes as the same type (the type of `rawTypeOf`).
export enum RawKind
	integer
	float
	string
	value

	// noun is how a message names a kind of literal, as maxon does; a value is named by its type.
	export function noun() returns String
		return match self 'k'
			integer gives "int"
			float gives "float"
			string gives "String"
			value gives panic("a raw value that is no literal is named by its type")
		end 'k'
	end 'noun'
end 'RawKind'

export type CaseInfo
	export var name as String
	export var payload as CaseFieldList
	export var hasRaw as bool
	// rawValue is the integer of a case, or the bits of its float.
	export var rawValue as I128
	// rawText is the text of the case whose raw value is a string.
	export var rawText as String
	// rawExpr is the expression of a case whose raw value is not a literal, in the module that declares the type, and 0 for any other.
	export var rawExpr as NodeID

	export static function make(consumes name String, consumes payload CaseFieldList, hasRaw bool, consumes rawValue I128) returns CaseInfo
		return CaseInfo{name: name, payload: payload, hasRaw: hasRaw, rawValue: rawValue, rawText: "", rawExpr: 0 as NodeID}
	end 'make'
end 'CaseInfo'

export typealias CaseInfoList = Array with CaseInfo

export type ParamSpec
	export var name as String
	export var ty as TypeID
	export var conv as Convention
	// defaultExpr is the node of the parameter's default in the tree of the module that declares the function, or 0.
	export var defaultExpr as NodeID
	// labelled is whether a call names the argument with its label even where it is the first, as a built-in's whose
	// first parameter the form of the call leaves out does: `Vec3.create(value: 0)`.
	export var labelled as bool
	// hasCaseDefault is whether a built-in's enum parameter takes the case defaultCase where a call leaves the argument out:
	// a built-in has no tree to hold a default expression in.
	export var hasCaseDefault as bool
	export var defaultCase as Count

	export static function make(consumes name String, ty TypeID, conv Convention) returns ParamSpec
		return ParamSpec{name: name, ty: ty, conv: conv, defaultExpr: 0 as NodeID, labelled: false, hasCaseDefault: false, defaultCase: 0}
	end 'make'

	export static function withDefault(consumes name String, ty TypeID, conv Convention, defaultExpr NodeID) returns ParamSpec
		return ParamSpec{name: name, ty: ty, conv: conv, defaultExpr: defaultExpr, labelled: false, hasCaseDefault: false, defaultCase: 0}
	end 'withDefault'

	export static function withCaseDefault(consumes name String, ty TypeID, conv Convention, defaultCase Count) returns ParamSpec
		return ParamSpec{name: name, ty: ty, conv: conv, defaultExpr: 0 as NodeID, labelled: false, hasCaseDefault: true, defaultCase: defaultCase}
	end 'withCaseDefault'

	export static function labelledFirst(consumes name String, ty TypeID, conv Convention) returns ParamSpec
		return ParamSpec{name: name, ty: ty, conv: conv, defaultExpr: 0 as NodeID, labelled: true, hasCaseDefault: false, defaultCase: 0}
	end 'labelledFirst'

	// hasDefault is whether a call may leave the argument out.
	export function hasDefault() returns bool
		return self.defaultExpr != 0 or self.hasCaseDefault
	end 'hasDefault'
end 'ParamSpec'

export typealias ParamSpecList = Array with ParamSpec

export type ParamBound
	export var paramTy as TypeID
	export var ifaceTy as TypeID

	export static function make(paramTy TypeID, ifaceTy TypeID) returns ParamBound
		return ParamBound{paramTy: paramTy, ifaceTy: ifaceTy}
	end 'make'
end 'ParamBound'

export typealias ParamBoundList = Array with ParamBound

export type MethodRef
	export var name as String
	export var func as FuncID

	export static function make(consumes name String, func FuncID) returns MethodRef
		return MethodRef{name: name, func: func}
	end 'make'
end 'MethodRef'

export typealias MethodRefList = Array with MethodRef

// ExtMethod is a method that an extension adds to the type owner, which is the key of the extended type
// (ast.extensionKey). It belongs to the module that writes the extension, never to the type's own entry.
export type ExtMethod
	export var owner as TypeID
	export var name as String
	export var func as FuncID

	export static function make(owner TypeID, consumes name String, func FuncID) returns ExtMethod
		return ExtMethod{owner: owner, name: name, func: func}
	end 'make'
end 'ExtMethod'

export typealias ExtMethodList = Array with ExtMethod

// ExtAlias is a typealias that an extension adds to the type owner, which is the key of the extended type
// (ast.extensionKey). It belongs to the module that writes the extension, as its methods do. extended is the type the
// extension extends, whose own parameters its target names.
export type ExtAlias
	export var owner as TypeID
	export var name as String
	export var ordinal as DeclOrdinal
	export var extended as TypeID

	export static function make(owner TypeID, consumes name String, ordinal DeclOrdinal, extended TypeID) returns ExtAlias
		return ExtAlias{owner: owner, name: name, ordinal: ordinal, extended: extended}
	end 'make'
end 'ExtAlias'

export typealias ExtAliasList = Array with ExtAlias

// ExtConform is an interface that an extension says the type owner implements.
export type ExtConform
	export var owner as TypeID
	export var iface as TypeID
	// site is the extension that says it.
	export var site as NodeID

	export static function make(owner TypeID, iface TypeID, site NodeID) returns ExtConform
		return ExtConform{owner: owner, iface: iface, site: site}
	end 'make'
end 'ExtConform'

export typealias ExtConformList = Array with ExtConform

// A Witness is the conformance that an instance of a generic function uses for one bound of its type parameters: the
// parameter and the interface as the generic declares them, and the module whose declaration says the type argument
// implements it (the type's own module for its body). The methods that meet the bound are those that module sees, so
// two instances given conformances of different modules are two instances.
export type Witness
	export var paramTy as TypeID
	export var ifaceTy as TypeID
	export var module as diag.ModuleID

	export static function make(paramTy TypeID, ifaceTy TypeID, module diag.ModuleID) returns Witness
		return Witness{paramTy: paramTy, ifaceTy: ifaceTy, module: module}
	end 'make'
end 'Witness'

export typealias WitnessList = Array with Witness

export type TypeEntry
	export var id as TypeID
	export var kind as TypeKind
	export var name as String
	export var inferred as bool
	export var minVal as I128
	export var maxVal as I128
	// bitsWidth is the width of a bits(n) typealias, a raw bit pattern, and 0 for every other type.
	export var bitsWidth as Count
	export var hasDecl as bool
	export var decl as DeclRef
	export var isNoncopyable as bool
	export var origin as TypeID
	export var declaring as bool
	export var typeParams as TypeIDList
	export var typeArgs as TypeIDList
	export var conforms as TypeIDList
	export var bounds as ParamBoundList
	export var fields as FieldInfoList
	export var cases as CaseInfoList
	export var hasExplicitRaw as bool
	export var rawKind as RawKind
	export var methods as MethodRefList
	export var sigs as FuncIDList
	export var boundIface as TypeID
	export var dropFunc as FuncID
	export var selfParam as TypeID
	// paramConvs are the conventions of the parameters of a function type, on the origin that every function type with
	// them is an instance of: its type arguments are the parameters' types and then the result's.
	export var paramConvs as ConventionList
	export var isTuple as bool
	// mutatesCaptures is, on the origin of a function type, whether a value of it may write what it captured, and isBrand
	// whether a typealias named it as a brand of its own (see FuncBrand).
	export var mutatesCaptures as bool
	export var isBrand as bool
	// brandKey is, on the origin of a function type that is a brand, the key of the brand (FuncBrand), and "" on any other.
	export var brandKey as String
	// supertype is the ranged alias that a ranged alias implements, whose places take its values with no cast.
	export var supertype as TypeID
	// mayBorrow is, on a type parameter, whether the type it stands for may hold a borrow (README, "Borrowing values"): the
	// 'Self' of an extension of an interface, and an associated type that the interface's 'where' bounds. Code over one is
	// checked as code over a value that holds a borrow.
	export var mayBorrow as bool

	export static function make(kind TypeKind, consumes name String) returns TypeEntry
		let z = I128.zero()
		return TypeEntry{id: noType, kind: kind, name: name, inferred: false, minVal: z.clone(), maxVal: z, bitsWidth: 0 as Count, hasDecl: false, decl: DeclRef.make(0 as diag.ModuleID, ordinal: 0 as DeclOrdinal), isNoncopyable: false, origin: noType, declaring: false, typeParams: TypeIDList.create(0), typeArgs: TypeIDList.create(0), conforms: TypeIDList.create(0), bounds: ParamBoundList.create(0), fields: FieldInfoList.create(0), cases: CaseInfoList.create(0), hasExplicitRaw: false, rawKind: RawKind.integer, methods: MethodRefList.create(0), sigs: FuncIDList.create(0), boundIface: noType, dropFunc: noFunc, selfParam: noType, paramConvs: ConventionList.create(0), isTuple: false, mutatesCaptures: false, isBrand: false, brandKey: "", supertype: noType, mayBorrow: false}
	end 'make'

	export function findMethod(methodName String) returns table.Option with FuncID
		for i in 0 upto methods.count() 'each'
			if methods[i].name == methodName 'hit'
				return table.Option.some(methods[i].func)
			end 'hit'
		end 'each'
		return table.Option.none
	end 'findMethod'

	export function findField(fieldName String) returns table.Option with Count
		for i in 0 upto fields.count() 'each'
			if fields[i].name == fieldName 'hit'
				return table.Option.some(i)
			end 'hit'
		end 'each'
		return table.Option.none
	end 'findField'

	export function findCase(caseName String) returns table.Option with Count
		for i in 0 upto cases.count() 'each'
			if cases[i].name == caseName 'hit'
				return table.Option.some(i)
			end 'hit'
		end 'each'
		return table.Option.none
	end 'findCase'

	export function effectiveOrigin() returns TypeID
		if origin != noType 'inst'
			return origin
		end 'inst'
		return id
	end 'effectiveOrigin'
end 'TypeEntry'

export typealias TypeEntryList = Array with TypeEntry

export typealias TypeEntryLists = Array with TypeEntryList

export type FuncEntry
	export var id as FuncID
	export var name as String
	export var visibility as String
	export var hasDecl as bool
	export var decl as DeclRef
	export var module as diag.ModuleID
	export var nodeID as NodeID
	export var isStatic as bool
	export var isDestructor as bool
	export var hasReceiver as bool
	// isClosure is whether the function is the body of a closure, which takes the closure itself first, before its
	// parameters, to read what it captured.
	export var isClosure as bool
	export var ownerTy as TypeID
	export var selfConv as Convention
	export var generics as TypeIDList
	export var bounds as ParamBoundList
	export var params as ParamSpecList
	export var paramTypes as TypeIDList
	export var retTy as TypeID
	// result says whether the function gives a value of retTy or a place of it that it borrows from its arguments.
	export var result as ResultConv
	export var errTy as TypeID
	export var genericOrigin as FuncID
	export var typeArgs as TypeIDList
	// witnesses are, on an instance, the conformances it was given for the bounds of its type parameters.
	export var witnesses as WitnessList
	export var intrinsic as Intrinsic
	export var linkName as String
	export var bodyRef as diag.U32
	// isTest is whether the function is a test, which is checked but never compiled into a program.
	export var isTest as bool
	// extendedIface is, for a method that an extension of an interface adds, that interface's declaration: the method is
	// generic over the type that implements it, which is its first type parameter.
	export var extendedIface as TypeID
	// conditionalBounds is how many of its bounds, first among them, the 'where' of the extension that declares it gives.
	export var conditionalBounds as Count

	export static function make(consumes name String, consumes visibility String, module diag.ModuleID, nodeID NodeID) returns FuncEntry
		return FuncEntry{id: noFunc, name: name, visibility: visibility, hasDecl: false, decl: DeclRef.make(module, ordinal: 0 as DeclOrdinal), module: module, nodeID: nodeID, isStatic: false, isDestructor: false, hasReceiver: false, isClosure: false, ownerTy: noType, selfConv: Convention.convLet, generics: TypeIDList.create(0), bounds: ParamBoundList.create(0), params: ParamSpecList.create(0), paramTypes: TypeIDList.create(0), retTy: noType, result: ResultConv.resultOwned, errTy: noType, genericOrigin: noFunc, typeArgs: TypeIDList.create(0), witnesses: WitnessList.create(0), intrinsic: Intrinsic.intrNone, linkName: "", bodyRef: 0 as diag.U32, isTest: false, extendedIface: noType, conditionalBounds: 0 as Count}
	end 'make'
end 'FuncEntry'

export typealias FuncEntryList = Array with FuncEntry

export typealias FuncEntryLists = Array with FuncEntryList

export type LocalEntry
	export var id as LocalID
	export var name as String
	export var ty as TypeID
	export var isVar as bool
	export var isParam as bool
	export var isSelf as bool
	export var projected as bool
	export var paramIndex as Count
	export var conv as Convention
	export var definedAt as NodeID
	export var isUninitialized as bool
	export var isCapture as bool
	// captureConv is, for a capture, how the closure holds it: as its value, which the body only reads (let), as the
	// address of the variable that a mutating closure changes (mutates), or as a value the closure owns and a mutating
	// closure changes in place, so that each call sees the last one's writes (consumes).
	export var captureConv as Convention
	// slot is the place of a local that is not a parameter among the slots of its function's IR: dense from 0, in the
	// order the checker declared them.
	export var slot as SlotIndex

	export static function make(consumes name String, ty TypeID, isVar bool, isParam bool, conv Convention, definedAt NodeID) returns LocalEntry
		return LocalEntry{id: noLocal, name: name, ty: ty, isVar: isVar, isParam: isParam, isSelf: false, projected: false, paramIndex: 0 as Count, conv: conv, definedAt: definedAt, isUninitialized: false, isCapture: false, captureConv: Convention.convLet, slot: noSlot}
	end 'make'
end 'LocalEntry'

export typealias LocalEntryList = Array with LocalEntry

export typealias SlotList = Array with Count

export typealias FuncInternMap = table.StringMap with FuncID

/// Phase is a stage whose product is a segment of a slot: the entries that its task, or an earlier one of its module, made in
// the slot for it to complete, which no later task writes, so that each segment is a value that is complete, and could be
// frozen and shared, when its stage ends. A module's slot has the segment of each of its stages at the phase's ordinal;
// sharedSlot has the built-ins' at builtins and, from project on, one for each task of the project, in the order they ran.
export enum Phase
	// builtins is what the project holds before any task runs: the built-ins and the stdlib.
	builtins
	parse
	resolve
	aliases
	declare
	constantOrder
	constants
	bodies
	verify
	lower
	emit
	// project is the first segment of the tasks of the project as a whole.
	project
end 'Phase'

// TypeSlot is one slot of the type table: the entries of the types that one module's stages make, or, in sharedSlot, the
// built-ins', the stdlib's and those of the stages of the project. A task holds its module's slot `mutates`, which is all
// that it can make or write an entry in, and reads every other slot in the project's table, which it is given read-only.
export type TypeSlot
	// slot is the slot these are, by which a handle names them.
	var slot as Count
	// The entries are by segment: at the list nominalTypes of a segment the nominal types whose entries its stage completes,
	// in the order they were made, and at shapeTypes the structural types its stage made or took from a slot it read
	// (segmentList). sealed are the lists of the segments that are complete, frozen when their stage ended, so that a task
	// that waited on the stage shares them; lists are the ones after them, which the task holding the slot may still write:
	// the list at l is lists[l - sealed.count()] (typeList gives that index).
	var sealed as Array with frozen with TypeEntryList
	export var lists as TypeEntryLists
	// phase is the segment the task that holds the slot writes: the segments before it are complete.
	var phase as Count
	// shapeIndex finds, by handle, the shapes of the slot and those of the slots it reads that the stages its tasks waited
	// on made (importShapes): the place of each, as the bits of a nominal handle are.
	var shapeIndex as ShapeIndex
	// reads are the slots of other modules whose shapes the stages of the slot's module read besides sharedSlot: those of
	// the modules it names, directly or through others, and of the modules an earlier compile compiled.
	var reads as SlotList
	// imported are how many segments of each slot it reads its index finds the shapes of.
	var imported as SlotList
	// shells are the lists of later segments as the tasks of earlier stages left them, part of those stages' products.
	var shells as ShellList

	static function make(slot Count) returns TypeSlot
		var lists = TypeEntryLists.create(0)
		lists.push(TypeEntryList.create(0))
		lists.push(TypeEntryList.create(0))
		return TypeSlot{slot: slot, sealed: Array.create(0), lists: lists, phase: Phase.builtins.ordinal, shapeIndex: ShapeIndex.new(), reads: SlotList.create(0), imported: SlotList.create(0), shells: ShellList.create(0)}
	end 'make'

	// none is the slot of no module: what the project's table holds in place of a slot that a task holds, and what work that
	// makes no type holds, which reads every slot in the project's table.
	export static function none() returns TypeSlot
		return TypeSlot{slot: noneSlot, sealed: Array.create(0), lists: TypeEntryLists.create(0), phase: Phase.builtins.ordinal, shapeIndex: ShapeIndex.empty(), reads: SlotList.create(0), imported: SlotList.create(0), shells: ShellList.create(0)}
	end 'none'

	// seen is the slot slot as a task that holds another reads it: the lists it sees, complete.
	static function seen(slot Count, consumes lists Array with frozen with TypeEntryList) returns TypeSlot
		var view = TypeSlot.none()
		view.slot = slot
		view.sealed = lists
		return view
	end 'seen'

	// segments is how many segments the slot has.
	function segments() returns Count
		return listCount() / listsPerSegment
	end 'segments'

	// listCount is how many lists the slot has, sealed and open.
	function listCount() returns Count
		return try sealed.count() + lists.count() otherwise panic("more lists than memory")
	end 'listCount'

	// listLength is how many entries the list l holds, none for a list past the slot's.
	function listLength(l Count) returns Count
		let n = sealed.count()
		if l < n 'sealed'
			return sealed[l].count()
		end 'sealed'
		if l >= listCount() 'past'
			return 0
		end 'past'
		return lists[l - n].count()
	end 'listLength'

	// entryIn is the entry at index of the list l.
	function entryIn(l Count, index Count) returns borrowed TypeEntry
		let n = sealed.count()
		if l < n 'sealed'
			return sealed[l][index]
		end 'sealed'
		return lists[l - n][index]
	end 'entryIn'

	// seal freezes the lists before upTo, which are complete, making the lists before it that the slot has none of yet.
	function seal(mutates self, upTo Count)
		if upTo <= sealed.count() 'sealed'
			return
		end 'sealed'
		let n = try upTo - sealed.count() otherwise panic("a seal before the lists sealed already")
		var rest = TypeEntryLists.create(0)
		for i in 0 upto lists.count() 'lists'
			let entries = exchange(lists[i], value: TypeEntryList.create(0))
			if i < n 'complete'
				sealed.push(freeze(entries))
			end 'complete' else 'open'
				rest.push(entries)
			end 'open'
		end 'lists'
		while sealed.count() < upTo 'empty'
			sealed.push(freeze(TypeEntryList.create(0)))
		end 'empty'
		lists = rest
	end 'seal'
end 'TypeSlot'

export typealias TypeSlots = Array with TypeSlot

// Shell is a list of a segment as the task of an earlier stage left it, which is part of that stage's product: the shells of
// the types that stage made and whose entries the segment's stage completes. A task that waited on the earlier stage and
// not on the segment's reads the shell in place of the list.
type Shell
	// stage is the segment whose product the shell is.
	var stage as Count
	var list as Count
	var entries as frozen with TypeEntryList

	static function make(stage Count, list Count, consumes entries frozen with TypeEntryList) returns Shell
		return Shell{stage: stage, list: list, entries: entries}
	end 'make'
end 'Shell'

typealias ShellList = Array with Shell

export type TypeTable
	// slots are the slots by number. While a compile's tasks run, the project holds none of the slots of the modules they
	// compile (ModuleHome), and the table a task reads is a view (viewTypes): of each slot it does not hold, the lists of the
	// segments it waited on, shared, and of each later list the shell the last of those stages left, or nothing, as the
	// products of those stages give them.
	var slots as TypeSlots
	// kinds are the kinds by their ordinal, which a structural handle holds.
	var kinds as Array with TypeKind
	// verifies is whether a read of an entry that the view does not hold stops the compile with the reader's name, visible
	// (--verify-reads), rather than at the bound of a list.
	var verifies as bool
	var visible as Inputs

	export static function new() returns TypeTable
		var shared = TypeSlot.make(sharedSlot)
		shared.lists[nominalTypes].push(TypeEntry.make(TypeKind.invalid, name: "<invalid>"))
		var slots = TypeSlots.create(0)
		slots.push(shared)
		return TypeTable{slots: slots, kinds: TypeKind.allCases, verifies: false, visible: Inputs.new()}
	end 'new'

	static function view(consumes slots TypeSlots, verifies bool, consumes visible Inputs) returns TypeTable
		return TypeTable{slots: slots, kinds: TypeKind.allCases, verifies: verifies, visible: visible}
	end 'view'
end 'TypeTable'

// Inputs are what of each slot a task reads: by slot, how many of its segments, which are the products of the stages it
// waited on. A slot past the list, or at everySegment, is read whole: what its module's stages made is complete before the
// task's stage begins.
export type Inputs
	var segments as SlotList
	// reader names the task, for a read that its view refuses.
	export var reader as String

	export static function new() returns Inputs
		return Inputs{segments: SlotList.create(0), reader: ""}
	end 'new'

	export function copy() returns Inputs
		return Inputs{segments: segments.clone(), reader: reader.clone()}
	end 'copy'

	// waited records that the task waited on the first count segments of slot.
	export function waited(mutates self, slot Count, count Count)
		while segments.count() <= slot 'room'
			segments.push(everySegment)
		end 'room'
		segments[slot] = count
	end 'waited'

	// raise records that the task waited on the first count segments of slot, a slot it reads in part, unless it waited on
	// more already.
	export function raise(mutates self, slot Count, count Count)
		if slot < segments.count() and segments[slot] != everySegment and segments[slot] < count 'more'
			segments[slot] = count
		end 'more'
	end 'raise'

	// merge records that the task waited on what other says another task waited on.
	export function merge(mutates self, other Inputs)
		for s in 0 upto other.segments.count() 'slots'
			if other.segments[s] != everySegment 'waited'
				raise(s, count: other.segments[s])
			end 'waited'
		end 'slots'
	end 'merge'

	// of is how many of the segments of slot, which has present, the task reads.
	export function of(slot Count, present Count) returns Count
		if slot >= segments.count() or segments[slot] > present 'whole'
			return present
		end 'whole'
		return segments[slot]
	end 'of'
end 'Inputs'

// everySegment marks a slot of Inputs that the task reads whole.
export let everySegment = 4294967295 as Count

// A nominal type's handle and every function's name the slot that holds its entry, in the bits from handleSlotShift, the
// list of the slot it is in, in the bits from handleListShift, and its place in that list, in the bits below: sharedSlot is
// the stdlib's and the built-ins', and slot 1 + m is module m's. A structural type's handle is its word (shapes.maxon), the
// same in every module, and each slot whose stages make it holds a copy of its entry. Every read of an entry goes through
// typeEntry and funcEntry, and every write through typeList and typeIndex or funcList and funcIndex of the slot the task
// holds, so only ast knows how a handle and an entry relate. A module's slot is written only by its own stages, so its
// handles are a function of its source.
let handleIndexMask = 4294967295 as Count

let handleSlotShift = 32 as Count

let handleSlotMask = 65535 as Count

let handleListShift = 48 as Count

let handleListMask = 255 as Count

// nominalTypes and shapeTypes are the lists of a segment of a TypeSlot that hold its nominal and its structural types.
let nominalTypes = 0 as Count

let shapeTypes = 1 as Count

let listsPerSegment = 2 as Count

// segmentList is the list of a TypeSlot that holds the entries of kind (nominalTypes or shapeTypes) of segment.
function segmentList(segment Count, kind Count) returns Count
	return try segment * listsPerSegment + kind otherwise panic("a segment past the lists of a slot")
end 'segmentList'

// handleWord is the handle of the entry at index in list of slot.
function handleWord(slot Count, list Count, index Count) returns Count
	if index > handleIndexMask or slot > handleSlotMask or list > handleListMask 'past'
		panic("a slot of more than {handleIndexMask} entries, {handleListMask} lists, or more than {handleSlotMask} modules")
	end 'past'
	return (list shl handleListShift) or (slot shl handleSlotShift) or index
end 'handleWord'

// sharedSlot holds the built-ins and the stdlib, and what the stages of the project make.
let sharedSlot = 0 as Count

// noneSlot is the slot of TypeSlot.none and FuncSlot.none, which no handle names.
export let noneSlot = 65536 as Count

// requireHeld stops the compile where a task makes or writes an entry of a slot other than the one it holds, held: which the
// type of what it is given rules out, so that this is an internal error.
function requireHeld(held Count, slot Count)
	if slot != held 'foreign'
		panic("an entry of slot {slot} is made or written by a task that holds slot {held}")
	end 'foreign'
end 'requireHeld'

// requireOpen stops the compile where the task that writes segment phase of slot writes an entry of an earlier segment,
// which is complete since its stage ended.
function requireOpen(slot Count, phase Count, segment Count)
	if segment < phase 'complete'
		panic("an entry of segment {segment} of slot {slot} is written by the task of segment {phase}, after the stage that completes it ended")
	end 'complete'
end 'requireOpen'

// requireVisible stops the compile where a task reads the entry at index of list of slot, which the view of the products of
// the stages it waited on holds count of: an entry that a stage it did not wait on made (--verify-reads).
function requireVisible(visible Inputs, slot Count, list Count, index Count, count Count)
	if index >= count 'unwaited'
		panic("{visible.reader} reads entry {index} of list {list} of slot {slot}, which no product of a stage it waited on holds")
	end 'unwaited'
end 'requireVisible'

// moduleSlot is the slot of the entries that module makes.
export function moduleSlot(module diag.ModuleID) returns Count
	if module == diag.stdlibID 'std'
		return sharedSlot
	end 'std'
	return try modIndex(module) + 1 otherwise panic("a module past the slots of a handle")
end 'moduleSlot'

// isModuleSlot is whether the slot holds the entries of a module, which every slot but sharedSlot does.
export function isModuleSlot(slot Count) returns bool
	return slot != sharedSlot
end 'isModuleSlot'

// slotModuleIndex is the index of the module whose entries the slot holds, for a slot of a module.
export function slotModuleIndex(slot Count) returns Count
	return try slot - 1 otherwise panic("sharedSlot is the slot of no module")
end 'slotModuleIndex'

function handleSlot(h Count) returns Count
	return (h shr handleSlotShift) and handleSlotMask
end 'handleSlot'

function handleList(h Count) returns Count
	return (h shr handleListShift) and handleListMask
end 'handleList'

function handleIndex(h Count) returns Count
	return h and handleIndexMask
end 'handleIndex'

// heldShapePlace is where the entry of the structural type of handle word is among the shapes of the slot tt, which holds it.
function heldShapePlace(tt TypeSlot, word Count) returns Count
	let at = tt.shapeIndex.probe(word)
	if not tt.shapeIndex.holds(at, word: word) 'absent'
		panic("the structural type {word} is written by a task whose slot {tt.slot} does not hold it")
	end 'absent'
	let place = tt.shapeIndex.placeAt(at)
	requireHeld(tt.slot, slot: handleSlot(place))
	return place
end 'heldShapePlace'

// typeList is the list of the slot tt that holds the entry of the type t, which a task writes: one of the slot it holds, of
// the segment it writes or of a later one.
export function typeList(tt TypeSlot, t TypeID) returns Count
	var h = t as Count
	if (h and structuralBit) != 0 'shape'
		h = heldShapePlace(tt, word: h)
	end 'shape'
	requireHeld(tt.slot, slot: handleSlot(h))
	let list = handleList(h)
	requireOpen(tt.slot, phase: tt.phase, segment: list / listsPerSegment)
	return try list - tt.sealed.count() otherwise panic("an entry of list {list} of slot {tt.slot} is written after its segment was sealed")
end 'typeList'

// typeIndex is the position of the type t in the list typeList gives.
export function typeIndex(tt TypeSlot, t TypeID) returns Count
	let h = t as Count
	if (h and structuralBit) != 0 'shape'
		return handleIndex(heldShapePlace(tt, word: h))
	end 'shape'
	requireHeld(tt.slot, slot: handleSlot(h))
	return handleIndex(h)
end 'typeIndex'

// heldTypeEntry is the entry of the type t, of the slot tt that the task holds, in whichever segment it is.
function heldTypeEntry(tt TypeSlot, t TypeID) returns borrowed TypeEntry
	var h = t as Count
	if (h and structuralBit) != 0 'shape'
		h = heldShapePlace(tt, word: h)
	end 'shape'
	requireHeld(tt.slot, slot: handleSlot(h))
	return tt.entryIn(handleList(h), index: handleIndex(h))
end 'heldTypeEntry'

// typeKind is the kind of the type t, which a structural type's handle holds, so that reading it reads no entry.
export function typeKind(tt TypeSlot, reads TypeTable, t TypeID) returns TypeKind
	let h = t as Count
	if (h and structuralBit) != 0 'shape'
		return reads.kinds[(h shr shapeKindShift) and shapeKindMask]
	end 'shape'
	return typeEntry(tt, reads: reads, t: t).kind
end 'typeKind'

// typeEntry is the entry of the type t, read in place: in tt, the slot the task holds, or in another slot of the project's
// table, reads. Every read of an entry goes through it and funcEntry, so only they know where the entry of a handle is.
export function typeEntry(tt TypeSlot, reads TypeTable, t TypeID) returns borrowed TypeEntry
	let h = t as Count
	if (h and structuralBit) != 0 'shape'
		return shapeAt(tt, reads: reads, place: shapePlace(tt, reads: reads, word: h))
	end 'shape'
	return entryAt(tt, reads: reads, place: h)
end 'typeEntry'

// entryAt is the entry at place, its slot, list and position there, as the bits of a nominal handle are.
function entryAt(tt TypeSlot, reads TypeTable, place Count) returns borrowed TypeEntry
	let s = handleSlot(place)
	if s == tt.slot 'held'
		return tt.entryIn(handleList(place), index: handleIndex(place))
	end 'held'
	if reads.verifies 'verify'
		requireVisible(reads.visible, slot: s, list: handleList(place), index: handleIndex(place), count: reads.slots[s].listLength(handleList(place)))
	end 'verify'
	return reads.slots[s].entryIn(handleList(place), index: handleIndex(place))
end 'entryAt'

// shapeAt is the entry of the shape at place.
function shapeAt(tt TypeSlot, reads TypeTable, place Count) returns borrowed TypeEntry
	return entryAt(tt, reads: reads, place: place)
end 'shapeAt'

// leadingReads are the slots a module's stages look a shape up in before those it reads: its own and sharedSlot.
let leadingReads = 2 as Count

// readCount is how many slots the stages of the slot tt read shapes from: every slot of the project's table reads for
// sharedSlot, whose stages are those of the project, and otherwise its own, sharedSlot and the slots it reads.
function readCount(tt TypeSlot, reads TypeTable) returns Count
	if tt.slot == sharedSlot 'project'
		return reads.slots.count()
	end 'project'
	return try tt.reads.count() + leadingReads otherwise panic("more slots than memory")
end 'readCount'

// readAt is the slot at k in the order the stages of the slot tt look a shape up in: its own first, then sharedSlot, then
// the slots it reads.
function readAt(tt TypeSlot, k Count) returns Count
	if tt.slot == sharedSlot 'project'
		return k
	end 'project'
	if k == 0 'own'
		return tt.slot
	end 'own'
	if k == 1 'shared'
		return sharedSlot
	end 'shared'
	return tt.reads[try k - leadingReads otherwise panic("a read before the slots own reads")]
end 'readAt'

// findShape finds the entry of the structure under word in a slot the running task reads, and sets place to its slot and
// position, as the bits of a nominal handle are.
function findShape(tt TypeSlot, reads TypeTable, word Count, sets place Count) returns bool
	let at = tt.shapeIndex.probe(word)
	if tt.shapeIndex.holds(at, word: word) 'own'
		place = tt.shapeIndex.placeAt(at)
		return true
	end 'own'
	// A task of a module took in at its start every shape it may read. A stage of the project, and work that holds no slot,
	// read every slot as it stands.
	if tt.slot != sharedSlot and tt.slot != noneSlot 'frozen'
		place = 0 as Count
		return false
	end 'frozen'
	for s in 0 upto reads.slots.count() 'slots'
		if s != tt.slot 'other'
			let other = reads.slots[s].shapeIndex.probe(word)
			if reads.slots[s].shapeIndex.holds(other, word: word) 'hit'
				place = reads.slots[s].shapeIndex.placeAt(other)
				return true
			end 'hit'
		end 'other'
	end 'slots'
	place = 0 as Count
	return false
end 'findShape'

// shapePlace is where the entry of the structural type of handle word is: the task that reads it got it from its own
// stages or from a module it waited on, so one of the slots it reads holds it. The task's own index finds nearly every
// one, which it probes in place as findShape does.
function shapePlace(tt TypeSlot, reads TypeTable, word Count) returns Count
	let mask = tt.shapeIndex.mask
	var at = word and mask
	while tt.shapeIndex.cells[at] != emptyWord 'probe'
		if tt.shapeIndex.cells[at] == word 'hit'
			return tt.shapeIndex.cells[try at + 1 otherwise panic("a place past the cells of a shape index")]
		end 'hit'
		at = (try at + shapeCell otherwise 0 as Count) and mask
	end 'probe'
	var place as Count
	if not findShape(tt, reads: reads, word: word, place: place) 'lost'
		panic("the structural type {word} is in none of the slots that slot {tt.slot} reads")
	end 'lost'
	return place
end 'shapePlace'

// openList is the index in tt.lists of the list of kind of segment of the slot tt, made with the lists before it where the
// slot has none yet.
function openList(mutates tt TypeSlot, segment Count, kind Count) returns Count
	requireOpen(tt.slot, phase: tt.phase, segment: segment)
	let whole = segmentList(try segment + 1 otherwise panic("a segment past memory"), kind: nominalTypes)
	while tt.listCount() < whole 'room'
		tt.lists.push(TypeEntryList.create(0))
	end 'room'
	return try segmentList(segment, kind: kind) - tt.sealed.count() otherwise panic("a list of slot {tt.slot} is written after its segment was sealed")
end 'openList'

// openHandle is the handle of the next entry of the list at open in tt.lists.
function openHandle(tt TypeSlot, open Count) returns Count
	let list = try tt.sealed.count() + open otherwise panic("more lists than memory")
	return handleWord(tt.slot, list: list, index: tt.lists[open].count())
end 'openHandle'

// allocType makes a nominal type that module declares, in the slot tt, which is its module's, and in the segment its task
// writes.
export function allocType(mutates tt TypeSlot, module diag.ModuleID, consumes e TypeEntry) returns TypeID
	let segment = tt.phase
	return allocTypeIn(tt, module: module, e: e, segment: segment)
end 'allocType'

// allocShell makes a nominal type that module declares and whose entry the stage of completer fills in, a later stage than
// the one that makes it: the entry is of that stage's segment, so that no stage writes an entry of a segment that is complete.
export function allocShell(mutates tt TypeSlot, module diag.ModuleID, consumes e TypeEntry, completer Phase) returns TypeID
	return allocTypeIn(tt, module: module, e: e, segment: completer.ordinal)
end 'allocShell'

function allocTypeIn(mutates tt TypeSlot, module diag.ModuleID, consumes e TypeEntry, segment Count) returns TypeID
	requireHeld(tt.slot, slot: moduleSlot(module))
	let open = openList(tt, segment: segment, kind: nominalTypes)
	let id = try openHandle(tt, open: open) as TypeID otherwise panic("a type handle past its bits")
	var copyE = e
	copyE.id = id
	tt.lists[open].push(copyE)
	return id
end 'allocTypeIn'

// allocShape makes the structural type of word in the shapes of the slot tt, which no slot it reads holds.
function allocShape(mutates tt TypeSlot, consumes e TypeEntry, word Count) returns TypeID
	let segment = tt.phase
	let open = openList(tt, segment: segment, kind: shapeTypes)
	let place = openHandle(tt, open: open)
	let id = try word as TypeID otherwise panic("a structural word past the bits of a handle")
	var copyE = e
	copyE.id = id
	tt.lists[open].push(copyE)
	tt.shapeIndex.insert(word, place: place)
	return id
end 'allocShape'

// adoptShape copies the entry of the structure at place, which another slot the running task reads holds, into the
// task's own shapes, so that its slot holds every structure its stages made or used.
function adoptShape(mutates tt TypeSlot, reads TypeTable, place Count, word Count)
	if handleSlot(place) == tt.slot 'held'
		return
	end 'held'
	let segment = tt.phase
	let open = openList(tt, segment: segment, kind: shapeTypes)
	let own = openHandle(tt, open: open)
	let e = shapeAt(tt, reads: reads, place: place).clone()
	tt.lists[open].push(e)
	tt.shapeIndex.repoint(word, place: own)
end 'adoptShape'

// indexOwnShapes makes the index of the slot tt find every shape its own lists hold, at the place its stages left it: where a
// slot loaded from the build cache starts, whose index holds no other slot's shapes until a task of its module imports them.
export function indexOwnShapes(mutates tt TypeSlot)
	for g in 0 upto tt.segments() 'segments'
		let list = segmentList(g, kind: shapeTypes)
		for i in 0 upto tt.listLength(list) 'shapes'
			let word = tt.entryIn(list, index: i).id as Count
			let place = handleWord(tt.slot, list: list, index: i)
			tt.shapeIndex.insert(word, place: place)
		end 'shapes'
	end 'segments'
end 'indexOwnShapes'

// importShapes makes the index of the slot tt, whose task begins, find the shapes of the segments of each slot it reads that
// the task waited on (inputs) and that it did not find already, so that one probe finds any shape the task reads. A
// segment is complete once its stage ended, so it is taken in whole and once. A word the index finds already keeps its place.
function importShapes(mutates tt TypeSlot, reads TypeTable, inputs Inputs)
	let n = readCount(tt, reads: reads)
	for k in 1 upto n 'slots'
		let r = readAt(tt, k: k)
		if r == tt.slot 'own'
			continue 'slots'
		end 'own'
		while tt.imported.count() <= r 'mark'
			tt.imported.push(0 as Count)
		end 'mark'
		let from = tt.imported[r]
		let waited = inputs.of(r, present: reads.slots[r].segments())
		for g in from upto waited 'segments'
			let list = segmentList(g, kind: shapeTypes)
			for i in 0 upto reads.slots[r].listLength(list) 'shapes'
				let word = reads.slots[r].entryIn(list, index: i).id as Count
				tt.shapeIndex.include(word, place: handleWord(r, list: list, index: i))
			end 'shapes'
		end 'segments'
		if waited > from 'more'
			tt.imported[r] = waited
		end 'more'
	end 'slots'
end 'importShapes'

// addSlots makes the slots of a module added to the project, which come after those of the modules before it.
export function addSlots(mutates tt TypeTable, mutates ft FuncTable)
	let slot = tt.slots.count()
	tt.slots.push(TypeSlot.make(slot))
	ft.slots.push(FuncSlot.make(slot))
end 'addSlots'

// lendTypeSlot takes the slot of module out of the table for its task, which writes segment: the segments before it are
// complete, so they are sealed, and its index finds the shapes of what the task waited on, inputs.
export function lendTypeSlot(mutates tt TypeTable, module diag.ModuleID, segment Count, inputs Inputs) returns TypeSlot
	var held = exchange(tt.slots[moduleSlot(module)], value: TypeSlot.none())
	beginTypeSegment(held, segment: segment, reads: tt, inputs: inputs)
	return held
end 'lendTypeSlot'

// beginTypeSegment readies the slot held for a task that writes segment: the segments before it are complete, so they are
// sealed, and its index finds the shapes of what the task waited on, inputs, which reads holds.
function beginTypeSegment(mutates held TypeSlot, segment Count, reads TypeTable, inputs Inputs)
	held.phase = segment
	held.seal(segmentList(segment, kind: nominalTypes))
	importShapes(held, reads: reads, inputs: inputs)
end 'beginTypeSegment'

// returnTypeSlot puts a slot that lendTypeSlot lent back in the table once its task's stage ended (endTypeSegment).
export function returnTypeSlot(mutates tt TypeTable, consumes held TypeSlot)
	var back = held
	endTypeSegment(back)
	let s = back.slot
	tt.slots[s] = back
end 'returnTypeSlot'

// endTypeSegment completes the segment that the task holding the slot wrote, once its stage ended, so the slot seals it, with
// the shells its task made or wrote: the lists of later segments as the task left them, which a task that waits on its stage
// and not on theirs reads.
function endTypeSegment(mutates back TypeSlot)
	let phase = back.phase
	let later = segmentList(try phase + 1 otherwise panic("a segment past memory"), kind: nominalTypes)
	let n = back.sealed.count()
	for open in 0 upto back.lists.count() 'later'
		let l = try n + open otherwise panic("more lists than memory")
		if l >= later and back.lists[open].count() > 0 'shells'
			back.shells.push(Shell.make(phase, list: l, entries: freeze(back.lists[open].clone())))
		end 'shells'
	end 'later'
	back.seal(later)
end 'endTypeSegment'

// keepTypeSlot puts back a slot that work outside the tasks lent, which may make more entries in the same segment later
// (outsideSegment), so it stays open.
export function keepTypeSlot(mutates tt TypeTable, consumes held TypeSlot)
	let s = held.slot
	tt.slots[s] = held
end 'keepTypeSlot'

// sealTables seals every list of sharedSlot and of the slots of the modules before first, which a compile of the modules
// from first on begins: what work outside its tasks made there is complete, so that its tasks share it. The tasks of a
// module the compile compiles seal its slot's segments as their stages end, and those of the stages still to come are open.
export function sealTables(mutates tt TypeTable, mutates ft FuncTable, first Count)
	let firstSlot = try first + 1 otherwise panic("a module past the slots of a handle")
	for s in 0 upto tt.slots.count() 'types'
		if s == sharedSlot or s < firstSlot 'done'
			let n = tt.slots[s].listCount()
			tt.slots[s].seal(n)
		end 'done'
	end 'types'
	for s in 0 upto ft.slots.count() 'funcs'
		if s == sharedSlot or s < firstSlot 'done'
			let n = ft.slots[s].listCount()
			ft.slots[s].seal(n)
		end 'done'
	end 'funcs'
end 'sealTables'

// typeListsSeen are the lists of the slot that a task that waited on its first waited segments reads: those of the segments
// it waited on, shared, and of each later list the shell that the last of those stages left, or an empty list, so that what
// a stage it did not wait on made is never seen.
function typeListsSeen(slot TypeSlot, waited Count) returns Array with frozen with TypeEntryList
	var segments = waited
	if segments > slot.segments() 'whole'
		segments = slot.segments()
	end 'whole'
	let shared = segmentList(segments, kind: nominalTypes)
	if shared > slot.sealed.count() 'open'
		panic("a task waited on {segments} segments of slot {slot.slot}, of which only {slot.sealed.count()} lists are sealed")
	end 'open'
	let empty = freeze(TypeEntryList.create(0))
	var lists as Array with frozen with TypeEntryList
	lists = Array.create(0)
	for l in 0 upto shared 'complete'
		lists.push(share(slot.sealed[l]))
	end 'complete'
	for l in shared upto slot.listCount() 'later'
		var shell as Count
		if latestShell(slot, list: l, before: segments, at: shell) 'shell'
			lists.push(share(slot.shells[shell].entries))
		end 'shell' else 'none'
			lists.push(share(empty))
		end 'none'
	end 'later'
	return lists
end 'typeListsSeen'

// latestShell finds the shell of list of slot that the last stage before segment before left, and sets at to its place.
function latestShell(slot TypeSlot, list Count, before Count, sets at Count) returns bool
	at = 0 as Count
	var found = false
	for k in 0 upto slot.shells.count() 'shells'
		if slot.shells[k].list == list and slot.shells[k].stage < before 'earlier'
			if not found or slot.shells[k].stage >= slot.shells[at].stage 'later'
				at = k
				found = true
			end 'later'
		end 'earlier'
	end 'shells'
	return found
end 'latestShell'

// funcListsSeen are the lists of the function slot that a task that waited on its first waited segments reads, shared.
function funcListsSeen(slot FuncSlot, waited Count) returns Array with frozen with FuncEntryList
	var segments = waited
	if segments > slot.listCount() 'whole'
		segments = slot.listCount()
	end 'whole'
	if segments > slot.sealed.count() 'open'
		panic("a task waited on {segments} segments of function slot {slot.slot}, of which only {slot.sealed.count()} are sealed")
	end 'open'
	var lists as Array with frozen with FuncEntryList
	lists = Array.create(0)
	for l in 0 upto segments 'complete'
		lists.push(share(slot.sealed[l]))
	end 'complete'
	return lists
end 'funcListsSeen'

// viewTypes is the type table a task reads, as an executor of behaviours gives it what it captured: every slot of base,
// which holds the slots of the work that ran before the compile, whole, and of each module the compile compiles, from slot
// firstSlot on, the lists of that module's product (products) that the task waited on; the slot held, which the task holds
// itself, is empty, as is every slot for noneSlot. A read of an entry that the view does not hold stops the compile, naming
// the reader in visible where verifies.
function viewTypes(base TypeTable, firstSlot Count, products Array with frozen with ModuleProducts, held Count, visible Inputs, verifies bool) returns TypeTable
	var slots = TypeSlots.create(0)
	for s in 0 upto firstSlot 'base'
		slots.push(TypeSlot.seen(s, lists: base.slots[s].sealed.clone()))
	end 'base'
	for k in 0 upto products.count() 'compiled'
		let s = try firstSlot + k otherwise panic("a slot past memory")
		if s == held 'held'
			slots.push(TypeSlot.seen(s, lists: Array.create(0)))
		end 'held' else 'read'
			slots.push(TypeSlot.seen(s, lists: products[k].types.clone()))
		end 'read'
	end 'compiled'
	return TypeTable.view(slots, verifies: verifies, visible: visible.copy())
end 'viewTypes'

// viewFuncs is the function table a task reads, as viewTypes is the type table.
function viewFuncs(base FuncTable, firstSlot Count, products Array with frozen with ModuleProducts, held Count, visible Inputs, verifies bool) returns FuncTable
	var slots = FuncSlots.create(0)
	for s in 0 upto firstSlot 'base'
		slots.push(FuncSlot.seen(s, lists: base.slots[s].sealed.clone()))
	end 'base'
	for k in 0 upto products.count() 'compiled'
		let s = try firstSlot + k otherwise panic("a slot past memory")
		if s == held 'held'
			slots.push(FuncSlot.seen(s, lists: Array.create(0)))
		end 'held' else 'read'
			slots.push(FuncSlot.seen(s, lists: products[k].funcs.clone()))
		end 'read'
	end 'compiled'
	return FuncTable.view(slots, verifies: verifies, visible: visible.copy())
end 'viewFuncs'

// baseTypes is the type table of the work that ran before a compile of the modules from firstSlot on, which every task of the
// compile reads whole: the slots before firstSlot, sealed when the compile began (sealTables), shared.
function baseTypes(tt TypeTable, firstSlot Count) returns TypeTable
	var slots = TypeSlots.create(0)
	for s in 0 upto firstSlot 'base'
		slots.push(TypeSlot.seen(s, lists: typeListsSeen(tt.slots[s], waited: everySegment)))
	end 'base'
	return TypeTable.view(slots, verifies: false, visible: Inputs.new())
end 'baseTypes'

// baseFuncs is the function table of the work that ran before a compile, as baseTypes is the type table.
function baseFuncs(ft FuncTable, firstSlot Count) returns FuncTable
	var slots = FuncSlots.create(0)
	for s in 0 upto firstSlot 'base'
		slots.push(FuncSlot.seen(s, lists: funcListsSeen(ft.slots[s], waited: everySegment)))
	end 'base'
	return FuncTable.view(slots, verifies: false, visible: Inputs.new())
end 'baseFuncs'

// laterSegment is a segment of the slot of module after every one it has, and not before from: that of work that runs
// after the stages that wrote the others, a task of the project among it.
export function laterSegment(tt TypeTable, ft FuncTable, module diag.ModuleID, from Phase) returns Count
	let slot = moduleSlot(module)
	var segment = from.ordinal
	if tt.slots[slot].segments() > segment 'types'
		segment = tt.slots[slot].segments()
	end 'types'
	if ft.slots[slot].listCount() > segment 'funcs'
		segment = ft.slots[slot].listCount()
	end 'funcs'
	return segment
end 'laterSegment'

// outsideSegment is the segment of the slot of module that work outside the tasks of a compile writes: the last the slot
// has, when that is one of such work already and still open, so that making entries one at a time does not use a segment
// for each.
export function outsideSegment(tt TypeTable, ft FuncTable, module diag.ModuleID) returns Count
	let later = laterSegment(tt, ft: ft, module: module, from: Phase.project)
	if later > Phase.project.ordinal 'after'
		let last = later - 1
		let slot = moduleSlot(module)
		if tt.slots[slot].sealed.count() <= segmentList(last, kind: nominalTypes) and ft.slots[slot].sealed.count() <= last 'open'
			return last
		end 'open'
	end 'after'
	return later
end 'outsideSegment'

export function cloneTypeArgs(args TypeIDList) returns TypeIDList
	return args.clone()
end 'cloneTypeArgs'

export function internIntRange(mutates tt TypeSlot, reads TypeTable, consumes aliasName String, consumes minVal I128, consumes maxVal I128, inferred bool) returns TypeID
	let word = intRangeWord(aliasName, minVal: minVal, maxVal: maxVal, inferred: inferred)
	let found = intRangeUnder(tt, reads: reads, word: word, aliasName: aliasName, minVal: minVal, maxVal: maxVal, inferred: inferred)
	match takeShape(tt, reads: reads, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.intRange, name: aliasName)
	e.inferred = inferred
	e.minVal = minVal
	e.maxVal = maxVal
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internIntRange'

export function internConstInt(mutates tt TypeSlot, reads TypeTable, consumes val I128) returns TypeID
	let word = constIntWord(val)
	let found = constIntUnder(tt, reads: reads, word: word, val: val)
	match takeShape(tt, reads: reads, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.constInt, name: "const({val.toString()})")
	e.minVal = val.clone()
	e.maxVal = val
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internConstInt'

// internFloatRange is the float type of a range, whose bounds are the bits of the doubles that end it. One that runs from
// f64.min to f64.max holds every double, the infinities and NaN among them.
export function internFloatRange(mutates tt TypeSlot, reads TypeTable, consumes aliasName String, lo Count, hi Count) returns TypeID
	let word = floatRangeWord(aliasName, lo: lo, hi: hi)
	let found = floatRangeUnder(tt, reads: reads, word: word, aliasName: aliasName, lo: lo, hi: hi)
	match takeShape(tt, reads: reads, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.floatRange, name: aliasName)
	e.minVal = I128.fromCount(lo)
	e.maxVal = I128.fromCount(hi)
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internFloatRange'

// internConstFloat is the type of a float constant, whose value is the bits of its double.
export function internConstFloat(mutates tt TypeSlot, reads TypeTable, bits Count) returns TypeID
	let word = constFloatWord(bits)
	let found = constFloatUnder(tt, reads: reads, word: word, bits: bits)
	match takeShape(tt, reads: reads, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.constFloat, name: "float")
	e.minVal = I128.fromCount(bits)
	e.maxVal = I128.fromCount(bits)
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internConstFloat'

export function isFloatType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	let k = typeKind(tt, reads: reads, t: t)
	return k == TypeKind.floatRange or k == TypeKind.constFloat
end 'isFloatType'

// floatBits is the double of a float constant, or a bound of a float range: minVal for the low one.
export function floatLowBits(tt TypeSlot, reads TypeTable, t TypeID) returns Count
	return typeEntry(tt, reads: reads, t: t).minVal.lo
end 'floatLowBits'

export function floatHighBits(tt TypeSlot, reads TypeTable, t TypeID) returns Count
	return typeEntry(tt, reads: reads, t: t).maxVal.lo
end 'floatHighBits'

// isFullFloatRange is whether a float range runs from f64.min to f64.max, and so holds every double.
export function isFullFloatRange(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return typeKind(tt, reads: reads, t: t) == TypeKind.floatRange and floatLowBits(tt, reads: reads, t: t) == floatNegate(floatMaxBits) and floatHighBits(tt, reads: reads, t: t) == floatMaxBits
end 'isFullFloatRange'

// floatRangeHolds is whether the float range t holds the double of the bits.
export function floatRangeHolds(tt TypeSlot, reads TypeTable, t TypeID, bits Count) returns bool
	if isFullFloatRange(tt, reads: reads, t: t) 'all'
		return true
	end 'all'
	let low = floatCompare(bits, b: floatLowBits(tt, reads: reads, t: t))
	let high = floatCompare(bits, b: floatHighBits(tt, reads: reads, t: t))
	return (low == FloatOrder.greater or low == FloatOrder.equal) and (high == FloatOrder.less or high == FloatOrder.equal)
end 'floatRangeHolds'

// floatRangeCovers is whether the float range dst holds every value of the float range src.
export function floatRangeCovers(tt TypeSlot, reads TypeTable, dst TypeID, src TypeID) returns bool
	if isFullFloatRange(tt, reads: reads, t: dst) 'all'
		return true
	end 'all'
	if isFullFloatRange(tt, reads: reads, t: src) 'none'
		return false
	end 'none'
	return floatRangeHolds(tt, reads: reads, t: dst, bits: floatLowBits(tt, reads: reads, t: src)) and floatRangeHolds(tt, reads: reads, t: dst, bits: floatHighBits(tt, reads: reads, t: src))
end 'floatRangeCovers'

// floatSpelling is how a float type's range is written: FullRangeFloat for the whole of it, as maxon names it.
function floatSpelling(tt TypeSlot, reads TypeTable, t TypeID) returns String
	if isFullFloatRange(tt, reads: reads, t: t) 'full'
		return "FullRangeFloat"
	end 'full'
	return "float({floatDiagnosticText(floatLowBits(tt, reads: reads, t: t))} to {floatDiagnosticText(floatHighBits(tt, reads: reads, t: t))})"
end 'floatSpelling'

// extendsInterface is whether an implementation of the interface have is one of want: have is want, or extends it,
// directly or through the interfaces it extends, at the associated types that have binds. The interfaces an interface
// extends are held in its conforms as declarations, whose associated types are bound by name by the extending one's.
export function extendsInterface(tt TypeSlot, reads TypeTable, have TypeID, want TypeID) returns bool
	if have == want 'same'
		return true
	end 'same'
	let wantOrig = typeEntry(tt, reads: reads, t: want).effectiveOrigin()
	return match consumes ancestorBindings(tt, reads: reads, have: have, want: wantOrig) 'ancestor'
		some(bindings) gives want == wantOrig or bindings.equals(typeEntry(tt, reads: reads, t: want).typeArgs)
		none gives false
	end 'ancestor'
end 'extendsInterface'

// ancestorBindings are what the associated types of the interface declaration want stand for where it is an interface that
// the interface have extends, directly or through others, at the associated types that have binds; none where have does not
// extend it.
export function ancestorBindings(tt TypeSlot, reads TypeTable, have TypeID, want TypeID) returns table.Option with TypeIDList
	return ancestorBindingsOf(tt, reads: reads, orig: typeEntry(tt, reads: reads, t: have).effectiveOrigin(), bindings: typeArgsOf(tt, reads: reads, t: have), want: want)
end 'ancestorBindings'

function ancestorBindingsOf(tt TypeSlot, reads TypeTable, orig TypeID, bindings TypeIDList, want TypeID) returns table.Option with TypeIDList
	for i in 0 upto typeEntry(tt, reads: reads, t: orig).conforms.count() 'parents'
		let parent = typeEntry(tt, reads: reads, t: orig).conforms[i]
		let parentBindings = inheritedBindings(tt, reads: reads, child: orig, bindings: bindings, parent: parent)
		if parent == want 'hit'
			return table.Option.some(parentBindings)
		end 'hit'
		match consumes ancestorBindingsOf(tt, reads: reads, orig: parent, bindings: parentBindings, want: want) 'deeper'
			some(found) then return table.Option.some(found)
			none then _ = 0
		end 'deeper'
	end 'parents'
	return table.Option.none
end 'ancestorBindingsOf'

// isSubtypeOf is whether the ranged alias sub implements sup, directly or through the aliases it implements.
export function isSubtypeOf(tt TypeSlot, reads TypeTable, sub TypeID, sup TypeID) returns bool
	var t = typeEntry(tt, reads: reads, t: sub).supertype
	while t != noType 'up'
		if t == sup 'hit'
			return true
		end 'hit'
		t = typeEntry(tt, reads: reads, t: t).supertype
	end 'up'
	return false
end 'isSubtypeOf'

// commonSupertype is the nearest alias that both ranged aliases a and b are or implement, or none.
export function commonSupertype(tt TypeSlot, reads TypeTable, a TypeID, b TypeID) returns TypeID
	var t = a
	while t != noType 'up'
		if t == b or isSubtypeOf(tt, reads: reads, sub: b, sup: t) 'hit'
			return t
		end 'hit'
		t = typeEntry(tt, reads: reads, t: t).supertype
	end 'up'
	return noType
end 'commonSupertype'

export function instanceKey(origin TypeID, args TypeIDList) returns String
	var b = ByteArray.create(0)
	b.append("{origin}:".toByteArray())
	for i in 0 upto args.count() 'each'
		if i > 0 'sep'
			b.push(44 as Byte)
		end 'sep'
		b.append("{args[i]}".toByteArray())
	end 'each'
	return String.from(b)
end 'instanceKey'

// funcInstanceKey is instanceKey with the modules of the conformances an instance of a function is given.
function funcInstanceKey(origin FuncID, args TypeIDList, witnesses WitnessList) returns String
	var b = instanceKey(origin as TypeID, args: args).toByteArray()
	for i in 0 upto witnesses.count() 'each'
		b.append(";{witnesses[i].module}".toByteArray())
	end 'each'
	return String.from(b)
end 'funcInstanceKey'

export function instantiateType(mutates tt TypeSlot, reads TypeTable, origin TypeID, args TypeIDList) returns TypeID
	let baseOrigin = typeEntry(tt, reads: reads, t: origin).effectiveOrigin()
	if args.count() == 0 'none'
		return baseOrigin
	end 'none'
	let word = instanceWord(tt, reads: reads, origin: baseOrigin, args: args)
	let found = instanceUnder(tt, reads: reads, word: word, origin: baseOrigin, args: args)
	match takeShape(tt, reads: reads, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	let origKind = typeKind(tt, reads: reads, t: baseOrigin)
	let origName = typeEntry(tt, reads: reads, t: baseOrigin).name.clone()
	let origNoncopyable = typeEntry(tt, reads: reads, t: baseOrigin).isNoncopyable
	let hasOrigDecl = typeEntry(tt, reads: reads, t: baseOrigin).hasDecl
	let origDecl = typeEntry(tt, reads: reads, t: baseOrigin).decl.clone()
	var e = TypeEntry.make(origKind, name: origName)
	e.origin = baseOrigin
	e.typeArgs = cloneTypeArgs(args)
	e.isTuple = typeEntry(tt, reads: reads, t: baseOrigin).isTuple
	e.isNoncopyable = origNoncopyable
	e.hasDecl = hasOrigDecl
	e.decl = origDecl
	let id = allocShape(tt, e: e, word: word)
	if statesCount(tt, reads: reads, t: id) 'counted'
		// A fixed array whose type states its count is one of the runtime-sized type of its element, which a place of that
		// type takes and a join of the two gives.
		let elements = typeEntry(tt, reads: reads, t: baseOrigin).typeParams.count()
		var unsized = TypeIDList.create(0)
		for i in 0 upto elements 'elements'
			unsized.push(args[i])
		end 'elements'
		let sup = instantiateType(tt, reads: reads, origin: baseOrigin, args: unsized)
		tt.lists[typeList(tt, t: id)][typeIndex(tt, t: id)].supertype = sup
	end 'counted'
	return id
end 'instantiateType'

// sizeofWord is what sizeof gives for a value held in one word: an integer, a float, an enum, a handle, a function, and
// the box of a value the place refers to.
let sizeofWord = 8 as Count

// sizeofBool is what sizeof gives for a bool, maxon's one byte.
let sizeofBool = 1 as Count

// byteSize is what sizeof(t) gives: a bool's byte, a record's box of a word to each field (a word for one with none), and
// a word for any other value, which is a word in every place. t is concrete: a type parameter has its argument's size,
// which an instance knows.
export function byteSize(tt TypeSlot, reads TypeTable, t TypeID) returns Count
	return match typeKind(tt, reads: reads, t: t) 'k'
		primBool gives sizeofBool
		record gives recordByteSize(tt, reads: reads, t: t)
		typeParam gives panic("the size of a type parameter is its argument's")
		invalid gives panic("an invalid type has no size")
		primVoid gives panic("Void has no size")
		primNever gives panic("Never has no size")
		interfaceTy gives panic("an interface has no size")
		primString gives sizeofWord
		intRange gives sizeofWord
		constInt gives sizeofWord
		floatRange gives sizeofWord
		constFloat gives sizeofWord
		enumTy gives sizeofWord
		unionTy gives sizeofWord
		builtinArray gives sizeofWord
		builtinList gives sizeofWord
		builtinPool gives sizeofWord
		builtinHandle gives sizeofWord
		builtinFrozen gives sizeofWord
		builtinCown gives sizeofWord
		builtinCursor gives sizeofWord
		builtinPromise gives sizeofWord
		builtinService gives sizeofWord
		funcTy gives sizeofWord
	end 'k'
end 'byteSize'

function recordByteSize(tt TypeSlot, reads TypeTable, t TypeID) returns Count
	let origin = typeEntry(tt, reads: reads, t: t).effectiveOrigin()
	let fields = typeEntry(tt, reads: reads, t: origin).fields.count()
	if fields == 0 'empty'
		return sizeofWord
	end 'empty'
	return try sizeofWord * fields otherwise panic("a record has fewer fields than a word counts bytes")
end 'recordByteSize'

// countedType is the instance of a fixed array of the element of unsized, a runtime-sized one, that states count.
export function countedType(mutates tt TypeSlot, reads TypeTable, unsized TypeID, count Count) returns TypeID
	var args = cloneTypeArgs(typeEntry(tt, reads: reads, t: unsized).typeArgs)
	args.push(internConstInt(tt, reads: reads, val: I128.fromCount(count)))
	return instantiateType(tt, reads: reads, origin: typeEntry(tt, reads: reads, t: unsized).effectiveOrigin(), args: args)
end 'countedType'

// statesCount is whether t is an instance of a fixed array that states its count, a type argument after its element.
export function statesCount(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if typeKind(tt, reads: reads, t: t) != TypeKind.builtinArray 'notArray'
		return false
	end 'notArray'
	let origin = typeEntry(tt, reads: reads, t: t).effectiveOrigin()
	return typeEntry(tt, reads: reads, t: t).typeArgs.count() > typeEntry(tt, reads: reads, t: origin).typeParams.count()
end 'statesCount'

// statedCount is the count that the type of a fixed array states (statesCount).
export function statedCount(tt TypeSlot, reads TypeTable, t TypeID) returns Count
	if not statesCount(tt, reads: reads, t: t) 'none'
		panic("the type {typeName(tt, reads: reads, t: t)} states no count")
	end 'none'
	let origin = typeEntry(tt, reads: reads, t: t).effectiveOrigin()
	let arg = typeEntry(tt, reads: reads, t: t).typeArgs[typeEntry(tt, reads: reads, t: origin).typeParams.count()]
	return typeEntry(tt, reads: reads, t: arg).minVal.lo
end 'statedCount'

// countedSpelling is how an instance of a fixed array that states its count is written: the count before the element.
export function countedSpelling(base String, count String, element String) returns String
	if element.contains(" with ") 'nested'
		return "{base} with {count} ({element})"
	end 'nested'
	return "{base} with {count} {element}"
end 'countedSpelling'

// tupleOrigin is the record of which every tuple of arity elements is an instance: its fields are named by their places, 0, 1,
// and so on, so that an element is read and written as a field is, and it has one type parameter for each, so that a tuple
// has the layout, the copy and drop routines and the ownership rules of a record with those fields.
export function tupleOrigin(mutates tt TypeSlot, reads TypeTable, arity Count) returns TypeID
	let word = tupleOriginWord(arity)
	let found = tupleOriginUnder(tt, reads: reads, word: word, arity: arity)
	match takeShape(tt, reads: reads, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.record, name: "Tuple{arity}")
	e.isTuple = true
	let origin = allocShape(tt, e: e, word: word)
	for i in 0 upto arity 'each'
		var tp = TypeEntry.make(TypeKind.typeParam, name: "T{i}")
		let param = allocShape(tt, e: tp, word: tupleParamWord(word, index: i))
		tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].typeParams.push(param)
		tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].fields.push(FieldInfo.make("{i}", ty: param, isVar: true, exported: true, hasDefault: false, defaultExpr: 0 as NodeID, index: i))
	end 'each'
	return origin
end 'tupleOrigin'

// tupleType is the tuple of the element types, which is one type however it is written.
export function tupleType(mutates tt TypeSlot, reads TypeTable, elems TypeIDList) returns TypeID
	let origin = tupleOrigin(tt, reads: reads, arity: elems.count())
	return instantiateType(tt, reads: reads, origin: origin, args: elems)
end 'tupleType'

export function isTupleType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return t != noType and typeEntry(tt, reads: reads, t: t).isTuple
end 'isTupleType'

export function selfType(mutates tt TypeSlot, reads TypeTable, declTy TypeID) returns TypeID
	let orig = typeEntry(tt, reads: reads, t: declTy).effectiveOrigin()
	if typeEntry(tt, reads: reads, t: orig).declaring or typeEntry(tt, reads: reads, t: orig).typeParams.count() == 0 'self'
		return orig
	end 'self'
	let args = cloneTypeArgs(typeEntry(tt, reads: reads, t: orig).typeParams)
	return instantiateType(tt, reads: reads, origin: orig, args: args)
end 'selfType'

export function typeArgsOf(tt TypeSlot, reads TypeTable, t TypeID) returns TypeIDList
	if typeEntry(tt, reads: reads, t: t).typeArgs.count() > 0 'hasArgs'
		return cloneTypeArgs(typeEntry(tt, reads: reads, t: t).typeArgs)
	end 'hasArgs'
	return cloneTypeArgs(typeEntry(tt, reads: reads, t: t).typeParams)
end 'typeArgsOf'

// typeArgAt is the type argument at an index of what typeArgsOf gives, read in place.
export function typeArgAt(tt TypeSlot, reads TypeTable, t TypeID, index Count) returns TypeID
	if typeEntry(tt, reads: reads, t: t).typeArgs.count() > 0 'hasArgs'
		return typeEntry(tt, reads: reads, t: t).typeArgs[index]
	end 'hasArgs'
	return typeEntry(tt, reads: reads, t: t).typeParams[index]
end 'typeArgAt'

export function originOf(tt TypeSlot, reads TypeTable, t TypeID) returns TypeID
	return typeEntry(tt, reads: reads, t: t).effectiveOrigin()
end 'originOf'

export function substituteType(mutates tt TypeSlot, reads TypeTable, t TypeID, params TypeIDList, args TypeIDList) returns TypeID
	if t == noType or params.count() == 0 'noop'
		return t
	end 'noop'
	let kind = typeKind(tt, reads: reads, t: t)
	if kind == TypeKind.typeParam 'tp'
		for i in 0 upto params.count() 'each'
			if params[i] == t and i < args.count() 'hit'
				return args[i]
			end 'hit'
		end 'each'
		return t
	end 'tp'
	let origArgs = cloneTypeArgs(typeEntry(tt, reads: reads, t: t).typeArgs)
	if origArgs.count() == 0 'nonInst'
		return t
	end 'nonInst'
	let selfOrigin = typeEntry(tt, reads: reads, t: t).effectiveOrigin()
	if args.count() > params.count() and origArgs.equals(params) and typeEntry(tt, reads: reads, t: selfOrigin).typeParams.equals(params) 'countedSelf'
		// Self of a fixed array at the arguments of an instance that states its count is that instance.
		return instantiateType(tt, reads: reads, origin: selfOrigin, args: args)
	end 'countedSelf'
	var nextArgs = TypeIDList.create(0)
	var changed = false
	for i in 0 upto origArgs.count() 'eachArg'
		let sub = substituteType(tt, reads: reads, t: origArgs[i], params: params, args: args)
		if sub != origArgs[i] 'diff'
			changed = true
		end 'diff'
		nextArgs.push(sub)
	end 'eachArg'
	if not changed 'same'
		return t
	end 'same'
	let orig = typeEntry(tt, reads: reads, t: t).effectiveOrigin()
	return instantiateType(tt, reads: reads, origin: orig, args: nextArgs)
end 'substituteType'

// FuncBrand is the typealias that makes a function type a brand of its own, as in maxon: a typealias at the top of a
// module, whose values flow into no other alias of the same shape without a cast. key tells two declarations apart and
// name is how the type is spelled; an empty key is no brand, the type of a closure, a named function and a typealias in a
// type's body.
export type FuncBrand
	export var key as String
	export var name as String

	export static function none() returns FuncBrand
		return FuncBrand{key: "", name: ""}
	end 'none'

	export static function make(consumes key String, consumes name String) returns FuncBrand
		return FuncBrand{key: key, name: name}
	end 'make'
end 'FuncBrand'

// FuncShape is what a function type says besides its parameters' types and its result: the conventions of its
// parameters, whether it mutates what it captures, and its brand.
export type FuncShape
	export var convs as ConventionList
	export var mutatesCaptures as bool
	export var brand as FuncBrand

	export static function make(consumes convs ConventionList, mutatesCaptures bool) returns FuncShape
		return FuncShape{convs: convs, mutatesCaptures: mutatesCaptures, brand: FuncBrand.none()}
	end 'make'
end 'FuncShape'

// internFuncType is the function type with these parameters and result: an instance of the origin of its shape, so
// that two spellings of one shape are one type and a generic one is substituted as any instance is. A brand is an origin
// of its own.
export function internFuncType(mutates tt TypeSlot, reads TypeTable, params TypeIDList, shape FuncShape, result TypeID) returns TypeID
	let word = funcOriginWord(shape)
	var origin = noType
	let found = funcOriginUnder(tt, reads: reads, word: word, shape: shape)
	match takeShape(tt, reads: reads, hit: found) 'hit'
		some(id) then origin = id
		none then _ = 0
	end 'hit'
	if origin == noType 'new'
		var name = "function"
		if shape.brand.key != "" 'branded'
			name = shape.brand.name.clone()
		end 'branded'
		var e = TypeEntry.make(TypeKind.funcTy, name: name)
		e.paramConvs = shape.convs.clone()
		e.mutatesCaptures = shape.mutatesCaptures
		e.isBrand = shape.brand.key != ""
		e.brandKey = shape.brand.key.clone()
		origin = allocShape(tt, e: e, word: word)
	end 'new'
	var args = params.clone()
	args.push(result)
	return instantiateType(tt, reads: reads, origin: origin, args: args)
end 'internFuncType'

// funcMutatesCaptures is whether a value of the function type may write what it captured.
export function funcMutatesCaptures(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: t)).mutatesCaptures
end 'funcMutatesCaptures'

// funcIsBrand is whether a typealias made the function type a brand of its own.
export function funcIsBrand(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: t)).isBrand
end 'funcIsBrand'

// funcParamCount is how many parameters a function type takes.
export function funcParamCount(tt TypeSlot, reads TypeTable, t TypeID) returns Count
	return typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: t)).paramConvs.count()
end 'funcParamCount'

export function funcParamType(tt TypeSlot, reads TypeTable, t TypeID, index Count) returns TypeID
	return typeEntry(tt, reads: reads, t: t).typeArgs[index]
end 'funcParamType'

export function funcParamConv(tt TypeSlot, reads TypeTable, t TypeID, index Count) returns Convention
	return typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: t)).paramConvs[index]
end 'funcParamConv'

// funcResult is what a function type returns, void for nothing.
export function funcResult(tt TypeSlot, reads TypeTable, t TypeID) returns TypeID
	return typeEntry(tt, reads: reads, t: t).typeArgs[funcParamCount(tt, reads: reads, t: t)]
end 'funcResult'

// funcTypeSpelling is how a message spells a function type, as maxon's do: its brand's name, or its shape.
function funcTypeSpelling(tt TypeSlot, reads TypeTable, t TypeID) returns String
	if funcIsBrand(tt, reads: reads, t: t) 'brand'
		return typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: t)).name.clone()
	end 'brand'
	return funcShapeSpelling(tt, reads: reads, t: t)
end 'funcTypeSpelling'

// funcShapeSpelling is the shape of a function type, 'fn(Count, mutates Box) returns Count', which a message names
// where two function types differ by more than their brands.
export function funcShapeSpelling(tt TypeSlot, reads TypeTable, t TypeID) returns String
	var b = ByteArray.create(0)
	b.append("fn(".toByteArray())
	for i in 0 upto funcParamCount(tt, reads: reads, t: t) 'params'
		if i > 0 'sep'
			b.append(", ".toByteArray())
		end 'sep'
		let conv = funcParamConv(tt, reads: reads, t: t, index: i)
		if conv != Convention.convLet 'marked'
			b.append("{conv.keyword()} ".toByteArray())
		end 'marked'
		b.append(typeName(tt, reads: reads, t: funcParamType(tt, reads: reads, t: t, index: i)).toByteArray())
	end 'params'
	b.push(41 as Byte)
	let result = funcResult(tt, reads: reads, t: t)
	if typeKind(tt, reads: reads, t: result) != TypeKind.primVoid 'returns'
		b.append(" returns {typeName(tt, reads: reads, t: result)}".toByteArray())
	end 'returns'
	if funcMutatesCaptures(tt, reads: reads, t: t) 'captures'
		b.append(" mutates captures".toByteArray())
	end 'captures'
	return String.from(b)
end 'funcShapeSpelling'

// mentionsType is whether the type t is target or an instance with target anywhere in its arguments.
export function mentionsType(tt TypeSlot, reads TypeTable, t TypeID, target TypeID) returns bool
	if t == target 'same'
		return true
	end 'same'
	for i in 0 upto typeEntry(tt, reads: reads, t: t).typeArgs.count() 'each'
		if mentionsType(tt, reads: reads, t: typeEntry(tt, reads: reads, t: t).typeArgs[i], target: target) 'inside'
			return true
		end 'inside'
	end 'each'
	return false
end 'mentionsType'

// mentionsTypeParam is whether the type is a type parameter or an instance with one anywhere in its arguments.
export function mentionsTypeParam(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if typeKind(tt, reads: reads, t: t) == TypeKind.typeParam 'param'
		return true
	end 'param'
	for i in 0 upto typeEntry(tt, reads: reads, t: t).typeArgs.count() 'each'
		if mentionsTypeParam(tt, reads: reads, t: typeEntry(tt, reads: reads, t: t).typeArgs[i]) 'inside'
			return true
		end 'inside'
	end 'each'
	return false
end 'mentionsTypeParam'

// holdsGrowingInstance is whether the type holds an instance of origin, itself or in its arguments, over an argument that
// is built from type parameters without being one: the instances of origin that a program needs are then never all
// found, since each holds a larger one. An argument that is a type parameter, as in a type that holds itself with its
// parameters swapped, repeats.
export function holdsGrowingInstance(tt TypeSlot, reads TypeTable, t TypeID, origin TypeID) returns bool
	let isInstanceOfOrigin = typeEntry(tt, reads: reads, t: t).typeArgs.count() > 0 and typeEntry(tt, reads: reads, t: t).effectiveOrigin() == origin
	for i in 0 upto typeEntry(tt, reads: reads, t: t).typeArgs.count() 'each'
		let arg = typeEntry(tt, reads: reads, t: t).typeArgs[i]
		if isInstanceOfOrigin and typeKind(tt, reads: reads, t: arg) != TypeKind.typeParam and mentionsTypeParam(tt, reads: reads, t: arg) 'grows'
			return true
		end 'grows'
		if holdsGrowingInstance(tt, reads: reads, t: arg, origin: origin) 'inside'
			return true
		end 'inside'
	end 'each'
	return false
end 'holdsGrowingInstance'

export function hasTypeDepthOverflow(tt TypeSlot, reads TypeTable, t TypeID, depth Count) returns bool
	if depth > maxTypeDepth 'over'
		return true
	end 'over'
	let n = typeEntry(tt, reads: reads, t: t).typeArgs.count()
	if n == 0 'leaf'
		return false
	end 'leaf'
	let nextDepth = try depth + 1 otherwise maxTypeDepth
	for i in 0 upto n 'each'
		let child = typeEntry(tt, reads: reads, t: t).typeArgs[i]
		if hasTypeDepthOverflow(tt, reads: reads, t: child, depth: nextDepth) 'deep'
			return true
		end 'deep'
	end 'each'
	return false
end 'hasTypeDepthOverflow'

export function isIntType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	let k = typeKind(tt, reads: reads, t: t)
	return k == TypeKind.intRange or k == TypeKind.constInt
end 'isIntType'

// isBitPattern is whether the type is that of a bits(n) typealias, a raw bit pattern.
export function isBitPattern(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return typeEntry(tt, reads: reads, t: t).bitsWidth != 0
end 'isBitPattern'

// isWordPattern is whether the type is that of a bits(64) typealias: a pattern as wide as the word that arithmetic
// computes in, so that its operations wrap and every integer converts to it.
export function isWordPattern(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return typeEntry(tt, reads: reads, t: t).bitsWidth == 64
end 'isWordPattern'

// isErrorType is whether a function can throw the type: an enum, whose case is the error, or a union, whose value is.
export function isErrorType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return typeKind(tt, reads: reads, t: t) == TypeKind.enumTy or typeKind(tt, reads: reads, t: t) == TypeKind.unionTy
end 'isErrorType'

// isUnionError is whether the type is an error union: its error is a heap box that the failing function hands to its
// caller, which owns it, and not a case number.
export function isUnionError(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return typeKind(tt, reads: reads, t: t) == TypeKind.unionTy
end 'isUnionError'

export function isUnsignedInt(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	if typeKind(tt, reads: reads, t: t) != TypeKind.intRange 'notRange'
		return false
	end 'notRange'
	return not typeEntry(tt, reads: reads, t: t).minVal.isNeg() and not typeEntry(tt, reads: reads, t: t).maxVal.fitsI64()
end 'isUnsignedInt'

export function isSharedType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	let k = typeKind(tt, reads: reads, t: t)
	return k == TypeKind.builtinFrozen or k == TypeKind.builtinCown or k == TypeKind.builtinService
end 'isSharedType'

// isFunctionType is whether the type is a function type, whose values are closures that may hold borrows.
export function isFunctionType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return t != noType and typeKind(tt, reads: reads, t: t) == TypeKind.funcTy
end 'isFunctionType'

// castRebrands is whether a cast to target changes only the type of its value: a cast to anything but a number converts
// nothing, so its value is the operand's.
export function castRebrands(tt TypeSlot, reads TypeTable, target TypeID) returns bool
	let k = typeKind(tt, reads: reads, t: target)
	return k != TypeKind.intRange and k != TypeKind.floatRange
end 'castRebrands'

// sharesOnCopy is whether a value of the type is never moved: a function value whose closure is immutable, so that every
// place that would take it takes another value that shares the closure. A value of a type that mutates its captures has
// state of its own in its closure, so it has one owner and moves as a record does.
export function sharesOnCopy(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return isFunctionType(tt, reads: reads, t: t) and not funcMutatesCaptures(tt, reads: reads, t: t)
end 'sharesOnCopy'

// isMutatingFunction is whether the type is a function type whose values mutate their captures.
export function isMutatingFunction(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return isFunctionType(tt, reads: reads, t: t) and funcMutatesCaptures(tt, reads: reads, t: t)
end 'isMutatingFunction'

export function isManagedType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return match typeKind(tt, reads: reads, t: t) 'k'
		primString gives true
		record gives true
		unionTy gives true
		builtinArray gives true
		builtinList gives true
		builtinPool gives true
		builtinFrozen gives true
		builtinCown gives true
		builtinCursor gives true
		builtinPromise gives true
		builtinService gives true
		typeParam gives true
		funcTy gives true
		invalid gives false
		primBool gives false
		primVoid gives false
		primNever gives false
		intRange gives false
		constInt gives false
		floatRange gives false
		constFloat gives false
		enumTy gives false
		builtinHandle gives false
		interfaceTy gives true
	end 'k'
end 'isManagedType'

export function contentType(tt TypeSlot, reads TypeTable, t TypeID) returns TypeID
	var cur = t
	while cur != noType and typeKind(tt, reads: reads, t: cur) == TypeKind.builtinFrozen 'unwrap'
		if typeEntry(tt, reads: reads, t: cur).typeArgs.count() > 0 'arg'
			cur = typeEntry(tt, reads: reads, t: cur).typeArgs[0]
		end 'arg' else if typeEntry(tt, reads: reads, t: cur).typeParams.count() > 0 'tp'
			cur = typeEntry(tt, reads: reads, t: cur).typeParams[0]
		end 'tp' else 'stop'
			break 'unwrap'
		end 'stop'
	end 'unwrap'
	return cur
end 'contentType'

export function instanceSpelling(base String, args Array with String) returns String
	if args.count() == 1 'one'
		var hasWith = false
		let s = args[0].clone()
		let sn = s.byteLength()
		if sn >= 6 'chk'
			for i in 0 upto (sn - 5) 'scan'
				if s.sliceBytes(i, endPos: try i + 6 otherwise i) == " with " 'hit'
					hasWith = true
					break 'scan'
				end 'hit'
			end 'scan'
		end 'chk'
		if not hasWith 'plain'
			return "{base} with {s}"
		end 'plain'
	end 'one'
	var b = ByteArray.create(0)
	b.append("{base} with (".toByteArray())
	for i in 0 upto args.count() 'each'
		if i > 0 'sep'
			b.append(", ".toByteArray())
		end 'sep'
		b.append(args[i].toByteArray())
	end 'each'
	b.push(41 as Byte)
	return String.from(b)
end 'instanceSpelling'

// intSpelling is how an integer type's range is written.
function intSpelling(tt TypeSlot, reads TypeTable, t TypeID) returns String
	return "int({typeEntry(tt, reads: reads, t: t).minVal.toString()} to {typeEntry(tt, reads: reads, t: t).maxVal.toString()})"
end 'intSpelling'

export function typeName(tt TypeSlot, reads TypeTable, t TypeID) returns String
	if t == noType 'none'
		return "<invalid>"
	end 'none'
	let k = typeKind(tt, reads: reads, t: t)
	if k == TypeKind.funcTy 'function'
		return funcTypeSpelling(tt, reads: reads, t: t)
	end 'function'
	if k == TypeKind.builtinService and typeEntry(tt, reads: reads, t: t).typeArgs.count() == 1 'service'
		return "{typeName(tt, reads: reads, t: typeEntry(tt, reads: reads, t: t).typeArgs[0])}.{serviceHandleMember}"
	end 'service'
	if k == TypeKind.intRange 'rng'
		if typeEntry(tt, reads: reads, t: t).name != "" 'named'
			return typeEntry(tt, reads: reads, t: t).name.clone()
		end 'named'
		return intSpelling(tt, reads: reads, t: t)
	end 'rng'
	if k == TypeKind.floatRange and typeEntry(tt, reads: reads, t: t).name == "" 'anonFloat'
		return floatSpelling(tt, reads: reads, t: t)
	end 'anonFloat'
	if isTupleType(tt, reads: reads, t: t) and typeEntry(tt, reads: reads, t: t).typeArgs.count() > 0 'tuple'
		var parts = ByteArray.create(0)
		parts.push(40 as Byte)
		for i in 0 upto typeEntry(tt, reads: reads, t: t).typeArgs.count() 'each'
			if i > 0 'sep'
				parts.append(", ".toByteArray())
			end 'sep'
			parts.append(typeName(tt, reads: reads, t: typeEntry(tt, reads: reads, t: t).typeArgs[i]).toByteArray())
		end 'each'
		parts.push(41 as Byte)
		return String.from(parts)
	end 'tuple'
	if statesCount(tt, reads: reads, t: t) 'counted'
		return countedSpelling(typeEntry(tt, reads: reads, t: t).name, count: "{statedCount(tt, reads: reads, t: t)}", element: typeName(tt, reads: reads, t: typeEntry(tt, reads: reads, t: t).typeArgs[0]))
	end 'counted'
	if typeEntry(tt, reads: reads, t: t).typeArgs.count() > 0 'inst'
		var argNames = StringList.create(0)
		var spelled = typeEntry(tt, reads: reads, t: t).typeArgs.count()
		if isPromiseType(tt, reads: reads, t: t) and promiseError(tt, reads: reads, t: t) == noType 'unthrowing'
			spelled = 1
		end 'unthrowing'
		for i in 0 upto spelled 'each'
			argNames.push(typeName(tt, reads: reads, t: typeEntry(tt, reads: reads, t: t).typeArgs[i]))
		end 'each'
		return instanceSpelling(typeEntry(tt, reads: reads, t: t).name, args: argNames)
	end 'inst'
	return typeEntry(tt, reads: reads, t: t).name.clone()
end 'typeName'

/// FuncSlot is one slot of the function table: the built-ins' in sharedSlot, and each module's functions, methods,
// signatures, closures and behaviours and the instances its stages ask for in its own. A task holds its module's slot
// `mutates` and reads every other slot in the project's table.
export type FuncSlot
	// slot is the slot these are, by which a handle names them.
	var slot as Count
	// The functions are by segment (Phase), each in the order its stage made them: sealed are the lists of the segments that
	// are complete, frozen when their stage ended, and lists the ones after them, the list at l being lists[l -
	// sealed.count()] (funcList gives that index), as TypeSlot keeps its lists.
	var sealed as Array with frozen with FuncEntryList
	export var lists as FuncEntryLists
	// phase is the segment the task that holds the slot writes: the segments before it are complete.
	var phase as Count
	// instCache are the instances of generic functions that the stages of the slot's module made, by their key.
	var instCache as FuncInternMap

	static function make(slot Count) returns FuncSlot
		var lists = FuncEntryLists.create(0)
		lists.push(FuncEntryList.create(0))
		return FuncSlot{slot: slot, sealed: Array.create(0), lists: lists, phase: Phase.builtins.ordinal, instCache: FuncInternMap.new()}
	end 'make'

	// none is the slot of no module, as TypeSlot.none is.
	export static function none() returns FuncSlot
		return FuncSlot{slot: noneSlot, sealed: Array.create(0), lists: FuncEntryLists.create(0), phase: Phase.builtins.ordinal, instCache: FuncInternMap.new()}
	end 'none'

	// seen is the slot slot as a task that holds another reads it, as TypeSlot.seen is.
	static function seen(slot Count, consumes lists Array with frozen with FuncEntryList) returns FuncSlot
		var view = FuncSlot.none()
		view.slot = slot
		view.sealed = lists
		return view
	end 'seen'

	// listCount is how many lists the slot has, sealed and open.
	function listCount() returns Count
		return try sealed.count() + lists.count() otherwise panic("more lists than memory")
	end 'listCount'

	// listLength is how many entries the list l holds, none for a list past the slot's.
	function listLength(l Count) returns Count
		let n = sealed.count()
		if l < n 'sealed'
			return sealed[l].count()
		end 'sealed'
		if l >= listCount() 'past'
			return 0
		end 'past'
		return lists[l - n].count()
	end 'listLength'

	// entryIn is the entry at index of the list l.
	function entryIn(l Count, index Count) returns borrowed FuncEntry
		let n = sealed.count()
		if l < n 'sealed'
			return sealed[l][index]
		end 'sealed'
		return lists[l - n][index]
	end 'entryIn'

	// seal freezes the lists before upTo, which are complete, as TypeSlot.seal does.
	function seal(mutates self, upTo Count)
		if upTo <= sealed.count() 'sealed'
			return
		end 'sealed'
		let n = try upTo - sealed.count() otherwise panic("a seal before the lists sealed already")
		var rest = FuncEntryLists.create(0)
		for i in 0 upto lists.count() 'lists'
			let entries = exchange(lists[i], value: FuncEntryList.create(0))
			if i < n 'complete'
				sealed.push(freeze(entries))
			end 'complete' else 'open'
				rest.push(entries)
			end 'open'
		end 'lists'
		while sealed.count() < upTo 'empty'
			sealed.push(freeze(FuncEntryList.create(0)))
		end 'empty'
		lists = rest
	end 'seal'
end 'FuncSlot'

export typealias FuncSlots = Array with FuncSlot

export type FuncTable
	// slots are the slots by number, each of them here but the one a running task holds; a task of a module reads a view
	// (viewFuncs), as it reads the type table.
	var slots as FuncSlots
	// verifies and visible are those of the type table (TypeTable).
	var verifies as bool
	var visible as Inputs

	export static function new() returns FuncTable
		var shared = FuncSlot.make(sharedSlot)
		shared.lists[0].push(FuncEntry.make("<invalid>", visibility: "", module: 0 as diag.ModuleID, nodeID: 0 as NodeID))
		var slots = FuncSlots.create(0)
		slots.push(shared)
		return FuncTable{slots: slots, verifies: false, visible: Inputs.new()}
	end 'new'

	static function view(consumes slots FuncSlots, verifies bool, consumes visible Inputs) returns FuncTable
		return FuncTable{slots: slots, verifies: verifies, visible: visible}
	end 'view'
end 'FuncTable'

// funcEntry is the entry of the function f, read in place: in ft, the slot the task holds, or in another slot of the
// project's table, funcReads.
export function funcEntry(ft FuncSlot, funcReads FuncTable, f FuncID) returns borrowed FuncEntry
	let h = f as Count
	let s = handleSlot(h)
	if s == ft.slot 'held'
		return ft.entryIn(handleList(h), index: handleIndex(h))
	end 'held'
	if funcReads.verifies 'verify'
		requireVisible(funcReads.visible, slot: s, list: handleList(h), index: handleIndex(h), count: funcReads.slots[s].listLength(handleList(h)))
	end 'verify'
	return funcReads.slots[s].entryIn(handleList(h), index: handleIndex(h))
end 'funcEntry'

// funcList is the index in ft.lists of the list that holds the entry of the function f, which a task writes: one of the
// slot it holds, of the segment it writes or of a later one.
export function funcList(ft FuncSlot, f FuncID) returns Count
	let h = f as Count
	requireHeld(ft.slot, slot: handleSlot(h))
	let list = handleList(h)
	requireOpen(ft.slot, phase: ft.phase, segment: list)
	return try list - ft.sealed.count() otherwise panic("a function of list {list} of slot {ft.slot} is written after its segment was sealed")
end 'funcList'

// heldFuncEntry is the entry of the function f, of the slot ft that the task holds, in whichever segment it is.
function heldFuncEntry(ft FuncSlot, f FuncID) returns borrowed FuncEntry
	let h = f as Count
	requireHeld(ft.slot, slot: handleSlot(h))
	return ft.entryIn(handleList(h), index: handleIndex(h))
end 'heldFuncEntry'

// funcIndex is the position of the function f in the list funcList gives.
export function funcIndex(ft FuncSlot, f FuncID) returns Count
	requireHeld(ft.slot, slot: handleSlot(f as Count))
	return handleIndex(f as Count)
end 'funcIndex'

// funcSlotOf is the number of the slot that holds the entry of the function f, for a stage that holds no slot of the
// function table.
export function funcSlotOf(f FuncID) returns Count
	return handleSlot(f as Count)
end 'funcSlotOf'

// funcListOf is the number of the list (the segment) of its slot that holds the entry of the function f.
export function funcListOf(f FuncID) returns Count
	return handleList(f as Count)
end 'funcListOf'

// funcPlaceOf is the position of the entry of the function f in its list, which funcListOf and funcSlotOf name: two
// functions of one slot share a position when they are in different lists.
export function funcPlaceOf(f FuncID) returns Count
	return handleIndex(f as Count)
end 'funcPlaceOf'

// allocFunc makes a function that module declares, or that its bodies make: a closure or a behaviour.
export function allocFunc(mutates ft FuncSlot, module diag.ModuleID, consumes f FuncEntry) returns FuncID
	requireHeld(ft.slot, slot: moduleSlot(module))
	return allocFuncIn(ft, f: f)
end 'allocFunc'

function allocFuncIn(mutates ft FuncSlot, consumes f FuncEntry) returns FuncID
	let list = ft.phase
	while ft.listCount() <= list 'room'
		ft.lists.push(FuncEntryList.create(0))
	end 'room'
	let open = try list - ft.sealed.count() otherwise panic("a function is made in list {list} of slot {ft.slot} after its segment was sealed")
	let id = try handleWord(ft.slot, list: list, index: ft.lists[open].count()) as FuncID otherwise panic("a function handle past its bits")
	var copyF = f
	copyF.id = id
	ft.lists[open].push(copyF)
	return id
end 'allocFuncIn'

// lendFuncSlot takes the slot of module out of the table for its task, which writes segment: the segments before it are
// complete, so they are sealed.
export function lendFuncSlot(mutates ft FuncTable, module diag.ModuleID, segment Count) returns FuncSlot
	var held = exchange(ft.slots[moduleSlot(module)], value: FuncSlot.none())
	beginFuncSegment(held, segment: segment)
	return held
end 'lendFuncSlot'

// beginFuncSegment readies the slot held for a task that writes segment: the segments before it are complete, so they are
// sealed.
function beginFuncSegment(mutates held FuncSlot, segment Count)
	held.phase = segment
	held.seal(segment)
end 'beginFuncSegment'

// returnFuncSlot puts a slot that lendFuncSlot lent back in the table once its task's stage ended (endFuncSegment).
export function returnFuncSlot(mutates ft FuncTable, consumes held FuncSlot)
	var back = held
	endFuncSegment(back)
	let s = back.slot
	ft.slots[s] = back
end 'returnFuncSlot'

// endFuncSegment seals the segment that the task holding the slot wrote, once its stage ended.
function endFuncSegment(mutates back FuncSlot)
	let later = try back.phase + 1 otherwise panic("a segment past memory")
	back.seal(later)
end 'endFuncSegment'

// keepFuncSlot puts back a slot that work outside the tasks lent, which stays open, as keepTypeSlot does.
export function keepFuncSlot(mutates ft FuncTable, consumes held FuncSlot)
	let s = held.slot
	ft.slots[s] = held
end 'keepFuncSlot'

// typeParamOwnerName is the name of the generic type or function that declares the type parameter param, for a message.
export function typeParamOwnerName(tt TypeSlot, reads TypeTable, ft FuncSlot, funcReads FuncTable, param TypeID) returns String
	match consumes typeParamOwnerIn(tt, param: param) 'held'
		some(name) then return name
		none then _ = 0
	end 'held'
	for s in 0 upto reads.slots.count() 'typeSlots'
		match consumes typeParamOwnerIn(reads.slots[s], param: param) 'read'
			some(name) then return name
			none then _ = 0
		end 'read'
	end 'typeSlots'
	match consumes funcParamOwnerIn(ft, param: param) 'heldFunc'
		some(name) then return name
		none then _ = 0
	end 'heldFunc'
	for s in 0 upto funcReads.slots.count() 'funcSlots'
		match consumes funcParamOwnerIn(funcReads.slots[s], param: param) 'readFunc'
			some(name) then return name
			none then _ = 0
		end 'readFunc'
	end 'funcSlots'
	panic("the type parameter '{typeName(tt, reads: reads, t: param)}' is declared by no type or function")
end 'typeParamOwnerName'

function typeParamOwnerIn(slot TypeSlot, param TypeID) returns table.Option with String
	for l in 0 upto slot.listCount() 'lists'
		for i in 0 upto slot.listLength(l) 'types'
			if slot.entryIn(l, index: i).origin == noType and slot.entryIn(l, index: i).typeParams.contains(param) 'type'
				return table.Option.some(slot.entryIn(l, index: i).name.clone())
			end 'type'
		end 'types'
	end 'lists'
	return table.Option.none
end 'typeParamOwnerIn'

function funcParamOwnerIn(slot FuncSlot, param TypeID) returns table.Option with String
	for l in 0 upto slot.listCount() 'lists'
		for i in 0 upto slot.listLength(l) 'funcs'
			if slot.entryIn(l, index: i).generics.contains(param) 'func'
				return table.Option.some(slot.entryIn(l, index: i).name.clone())
			end 'func'
		end 'funcs'
	end 'lists'
	return table.Option.none
end 'funcParamOwnerIn'

// instantiateFunc is the instance of the generic function origin at the type arguments args, given the conformances
// witnesses for its bounds: one instance for each in the slot of the module whose stage asks for it, since no two
// modules compare their instances and the link keeps one definition of each link name.
export function instantiateFunc(mutates ft FuncSlot, funcReads FuncTable, mutates tt TypeSlot, reads TypeTable, origin FuncID, args TypeIDList, witnesses WitnessList) returns FuncID
	if args.count() == 0 'none'
		return origin
	end 'none'
	let key = funcInstanceKey(origin, args: args, witnesses: witnesses)
	match ft.instCache.get(key) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	let origName = funcEntry(ft, funcReads: funcReads, f: origin).name.clone()
	let origVis = funcEntry(ft, funcReads: funcReads, f: origin).visibility.clone()
	let origMod = funcEntry(ft, funcReads: funcReads, f: origin).module
	let origNode = funcEntry(ft, funcReads: funcReads, f: origin).nodeID
	var inst = FuncEntry.make(origName, visibility: origVis, module: origMod, nodeID: origNode)
	inst.hasDecl = funcEntry(ft, funcReads: funcReads, f: origin).hasDecl
	inst.decl = funcEntry(ft, funcReads: funcReads, f: origin).decl.clone()
	inst.isStatic = funcEntry(ft, funcReads: funcReads, f: origin).isStatic
	inst.isDestructor = funcEntry(ft, funcReads: funcReads, f: origin).isDestructor
	inst.hasReceiver = funcEntry(ft, funcReads: funcReads, f: origin).hasReceiver
	inst.selfConv = funcEntry(ft, funcReads: funcReads, f: origin).selfConv
	inst.intrinsic = funcEntry(ft, funcReads: funcReads, f: origin).intrinsic
	inst.errTy = funcEntry(ft, funcReads: funcReads, f: origin).errTy
	inst.result = funcEntry(ft, funcReads: funcReads, f: origin).result
	inst.genericOrigin = origin
	inst.extendedIface = funcEntry(ft, funcReads: funcReads, f: origin).extendedIface
	inst.typeArgs = cloneTypeArgs(args)
	inst.witnesses = witnesses.clone()
	let origParams = cloneTypeArgs(funcEntry(ft, funcReads: funcReads, f: origin).generics)
	if funcEntry(ft, funcReads: funcReads, f: origin).ownerTy != noType 'own'
		inst.ownerTy = substituteType(tt, reads: reads, t: funcEntry(ft, funcReads: funcReads, f: origin).ownerTy, params: origParams, args: args)
	end 'own'
	inst.retTy = substituteType(tt, reads: reads, t: funcEntry(ft, funcReads: funcReads, f: origin).retTy, params: origParams, args: args)
	for i in 0 upto funcEntry(ft, funcReads: funcReads, f: origin).params.count() 'eachP'
		let pTy = substituteType(tt, reads: reads, t: funcEntry(ft, funcReads: funcReads, f: origin).params[i].ty, params: origParams, args: args)
		var spec = funcEntry(ft, funcReads: funcReads, f: origin).params[i].clone()
		spec.ty = pTy
		inst.params.push(spec)
		inst.paramTypes.push(pTy)
	end 'eachP'
	let id = allocFuncIn(ft, f: inst)
	ft.instCache.insert(key, value: id)
	return id
end 'instantiateFunc'

// memberType is the type of a field or a payload that its declaration gives as declared, in the instance owner.
export function memberType(mutates tt TypeSlot, reads TypeTable, owner TypeID, declared TypeID) returns TypeID
	let origin = originOf(tt, reads: reads, t: owner)
	if owner == origin or typeEntry(tt, reads: reads, t: owner).typeArgs.count() == 0 'declared'
		return declared
	end 'declared'
	let params = cloneTypeArgs(typeEntry(tt, reads: reads, t: origin).typeParams)
	let args = cloneTypeArgs(typeEntry(tt, reads: reads, t: owner).typeArgs)
	return substituteType(tt, reads: reads, t: declared, params: params, args: args)
end 'memberType'

// fieldType is the type of the field at index of the record owner, an instance's with its arguments applied.
export function fieldType(mutates tt TypeSlot, reads TypeTable, owner TypeID, index Count) returns TypeID
	let declared = typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: owner)).fields[index].ty
	return memberType(tt, reads: reads, owner: owner, declared: declared)
end 'fieldType'

// payloadType is the type of the payload at index of a case of the union owner, an instance's with its arguments applied.
export function payloadType(mutates tt TypeSlot, reads TypeTable, owner TypeID, caseIndex Count, index Count) returns TypeID
	let declared = typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: owner)).cases[caseIndex].payload[index].ty
	return memberType(tt, reads: reads, owner: owner, declared: declared)
end 'payloadType'

// packsBytes is whether t is an array whose box holds each element in one byte: an array of an integer type whose range
// fits in a Byte, as Array with Byte (ByteArray) is, or of an enum, whose value is its case's ordinal, of at most
// byteEnumCases cases, so that a table of slot states is an eighth of the memory a probe reads. Every other array holds
// a word to an element. Every operation on an array asks this, so the two boxes are never mistaken for each other.
export function packsBytes(tt TypeSlot, reads TypeTable, b Builtins, t TypeID) returns bool
	if typeKind(tt, reads: reads, t: t) != TypeKind.builtinArray 'notArray'
		return false
	end 'notArray'
	return packsByte(tt, reads: reads, b: b, elem: typeEntry(tt, reads: reads, t: t).typeArgs[0])
end 'packsBytes'

// packsByte is whether a collection of elements of type elem holds each in one byte (packsBytes): an array, and the
// memory and cursors over its buffer.
export function packsByte(tt TypeSlot, reads TypeTable, b Builtins, elem TypeID) returns bool
	let kind = typeKind(tt, reads: reads, t: elem)
	if kind == TypeKind.enumTy 'enum'
		return typeEntry(tt, reads: reads, t: originOf(tt, reads: reads, t: elem)).cases.count() <= byteEnumCases
	end 'enum'
	if kind != TypeKind.intRange 'notInt'
		return false
	end 'notInt'
	let byteTy = b.byteTy
	return typeEntry(tt, reads: reads, t: elem).minVal.ge(typeEntry(tt, reads: reads, t: byteTy).minVal) and typeEntry(tt, reads: reads, t: elem).maxVal.le(typeEntry(tt, reads: reads, t: byteTy).maxVal)
end 'packsByte'

// byteEnumCases is the most cases an enum whose values a byte holds has: ordinals 0 to 255.
let byteEnumCases = 256 as Count

// leadingParams is how many words a call of the function passes before its parameters: the receiver of a method, or the
// closure that a closure's body reads its captures from.
export function leadingParams(f FuncEntry) returns Count
	if f.hasReceiver or f.isClosure 'leading'
		return 1
	end 'leading'
	return 0
end 'leadingParams'

// libraryMapName is the type a map literal makes, the standard library root's Map, as maxon's makes the type that implements
// BuiltinDictionaryLiteral (README, "Where it differs from Maxon").
export let libraryMapName = "Map"

// lentTupleElements is how many elements the tuple has that a function lends, 0 for one that lends no tuple. A tuple it
// lends is a box of borrows, one word for each element, in the caller's frame: the caller passes its address after the
// parameters, and the function writes the borrows there and returns it (README, "Tuples"). An instance has its types
// substituted, so every call of it and its own body read the same count.
export function lentTupleElements(tt TypeSlot, reads TypeTable, f FuncEntry) returns Count
	if f.result != ResultConv.resultBorrowed or not isTupleType(tt, reads: reads, t: f.retTy) 'none'
		return 0
	end 'none'
	return typeEntry(tt, reads: reads, t: f.retTy).typeArgs.count()
end 'lentTupleElements'

// isByAddress is whether a parameter of the convention is passed as the address of the caller's place.
export function isByAddress(conv Convention) returns bool
	return conv == Convention.convMutates or conv == Convention.convSets
end 'isByAddress'

// ownsValue is whether the callee owns what it is given: the caller's value moves in.
export function ownsValue(conv Convention) returns bool
	return conv == Convention.convConsumes or conv == Convention.convDestructs
end 'ownsValue'

// callReceiver is the object a call of a method names before its dot, the left operand of an operator that calls a method
// (an '==' of a type parameter calls 'equals'), or 0 for a call that has none.
export function callReceiver(tree Tree, e NodeID, kind CallKind) returns NodeID
	if tree.kindOf(e) == NodeKind.binaryExpr 'operator'
		return binaryExprL(tree, id: e)
	end 'operator'
	if kind == CallKind.callMethod or kind == CallKind.callBound or kind == CallKind.callCopy or kind == CallKind.callSend 'member'
		let callee = callExprCallee(tree, id: e)
		if tree.kindOf(callee) == NodeKind.memberExpr 'named'
			return memberExprObj(tree, id: callee)
		end 'named'
	end 'member'
	return 0 as NodeID
end 'callReceiver'

// isStorage is whether an expression reads a value that already lives somewhere, in a variable, a field or an element,
// and so borrows it, as opposed to making a new value. typing is the module's, as far as the check has typed it.
export function isStorage(tree Tree, typing Typing, node NodeID) returns bool
	let e = through(tree, e: node)
	let k = tree.kindOf(e)
	if k == NodeKind.nameExpr 'name'
		let kind = match typing.names.get(e as Count) 'hit'
			some(info) gives info.kind
			none panic("ast: the name at node {e} was not recorded by the check")
		end 'hit'
		return kind == NameKind.nameLocal or kind == NameKind.nameSelfField
	end 'name'
	if k == NodeKind.selfExpr or k == NodeKind.indexExpr 'place'
		return true
	end 'place'
	if k == NodeKind.memberExpr 'member'
		// A view of a value (`xs.managed`) is the value itself, so it is storage where the value is.
		return match typing.members.get(e as Count) 'hit'
			some(info) gives info.kind == MemberKind.memberField or (info.kind == MemberKind.memberView and isStorage(tree, typing: typing, node: memberExprObj(tree, id: e)))
			none panic("ast: the member at node {e} was not recorded by the check")
		end 'hit'
	end 'member'
	if k == NodeKind.callExpr 'call'
		return isProjectionCall(typing, call: e)
	end 'call'
	return false
end 'isStorage'

// isProjectionCall is whether a call gives a place that its callee borrows from the arguments, as a subscript gives an
// element of its collection, rather than a value of its own.
export function isProjectionCall(typing Typing, call NodeID) returns bool
	return match typing.calls.get(call as Count) 'hit'
		some(info) gives info.result == ResultConv.resultBorrowed
		none gives false
	end 'hit'
end 'isProjectionCall'

// isPromiseType is whether a type is a `Promise with ...`: what an async call gives, which an await consumes.
export function isPromiseType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return t != noType and typeKind(tt, reads: reads, t: t) == TypeKind.builtinPromise
end 'isPromiseType'

// promiseResult is the type of what the function of a promise's coroutine returns, which its await gives.
export function promiseResult(tt TypeSlot, reads TypeTable, t TypeID) returns TypeID
	return typeEntry(tt, reads: reads, t: t).typeArgs[0]
end 'promiseResult'

// promiseError is the error the function of a promise's coroutine throws, which its await fails with: noType for a
// `Promise with T`, whose error argument is void.
export function promiseError(tt TypeSlot, reads TypeTable, t TypeID) returns TypeID
	let e = typeEntry(tt, reads: reads, t: t).typeArgs[1]
	if typeKind(tt, reads: reads, t: e) == TypeKind.primVoid 'none'
		return noType
	end 'none'
	return e
end 'promiseError'

// serviceHandleMember is the member that names the type of a service's handle after the service's type: `Calc.handle`.
export let serviceHandleMember = "handle"

// defaultMailboxCapacity is maxon's DefaultMailboxCapacity: how many messages a mailbox holds when the spawn names none.
export let defaultMailboxCapacity = 1024 as Count

// isServiceType is whether a type is the handle of a service, which `spawn` gives and a send goes through.
export function isServiceType(tt TypeSlot, reads TypeTable, t TypeID) returns bool
	return t != noType and typeKind(tt, reads: reads, t: t) == TypeKind.builtinService
end 'isServiceType'

// serviceState is the type of the state of the service a handle reaches: the type the service was spawned from.
export function serviceState(tt TypeSlot, reads TypeTable, t TypeID) returns TypeID
	return typeEntry(tt, reads: reads, t: t).typeArgs[0]
end 'serviceState'
