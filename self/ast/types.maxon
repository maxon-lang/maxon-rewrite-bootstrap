export typealias TypeID = int(0 to 9223372036854775807)

export typealias TypeIDList = Array with TypeID

export typealias FuncID = int(0 to 9223372036854775807)

export typealias FuncIDList = Array with FuncID

export typealias LocalID = int(0 to 2147483647)

export typealias LocalIDList = Array with LocalID

export let noType = 0 as TypeID

export let noFunc = 0 as FuncID

export let noLocal = 0 as LocalID

// SlotIndex is the place of a local among the slots of its function's frame, or noSlot for a parameter, which has none.
export typealias SlotIndex = int(-1 to 2147483647)

export let noSlot = -1 as SlotIndex

export let maxTypeDepth = 16 as Count

export enum TypeKind
	invalid
	primBool
	primString
	primVoid
	primNever
	intRange
	constInt
	floatRange
	constFloat
	record
	enumTy
	unionTy
	builtinArray
	builtinMap
	builtinList
	builtinPool
	builtinHandle
	builtinFrozen
	builtinCown
	typeParam
	interfaceTy
	funcTy

	export function isBuiltin() returns bool
		return match self 'k'
			builtinArray gives true
			builtinMap gives true
			builtinList gives true
			builtinPool gives true
			builtinHandle gives true
			builtinFrozen gives true
			builtinCown gives true
			invalid gives false
			primBool gives false
			primString gives false
			primVoid gives false
			primNever gives false
			intRange gives false
			constInt gives false
			floatRange gives false
			constFloat gives false
			record gives false
			enumTy gives false
			unionTy gives false
			typeParam gives false
			interfaceTy gives false
			funcTy gives false
		end 'k'
	end 'isBuiltin'
end 'TypeKind'

export enum Convention
	convLet
	convMutates
	convSets
	convConsumes
	convDestructs

	export function keyword() returns String
		return match self 'c'
			convLet gives "let"
			convMutates gives "mutates"
			convSets gives "sets"
			convConsumes gives "consumes"
			convDestructs gives "destructs"
		end 'c'
	end 'keyword'
end 'Convention'

export typealias ConventionList = Array with Convention

// ResultConv is how a function gives its result: a value the caller owns, or a place that the function borrows from its
// arguments and the caller only reads (`returns borrowed T`), as a let parameter lends one. A borrowed place the caller
// may change would be the next member.
export enum ResultConv
	resultOwned
	resultBorrowed
end 'ResultConv'

// borrowedWord is the word after `returns` that makes a function's result a borrowed place.
export let borrowedWord = "borrowed"

// parseResultConv is the convention that the word after `returns` gives a function's result: none for an owned value.
export function parseResultConv(word String) returns ResultConv
	if word == "" 'owned'
		return ResultConv.resultOwned
	end 'owned'
	if word == borrowedWord 'borrowed'
		return ResultConv.resultBorrowed
	end 'borrowed'
	panic("ast: '{word}' is no convention of a result")
end 'parseResultConv'

export function parseConvention(kw String) returns Convention
	if kw == "mutates" 'm'
		return Convention.convMutates
	end 'm'
	if kw == "sets" 's'
		return Convention.convSets
	end 's'
	if kw == "consumes" 'c'
		return Convention.convConsumes
	end 'c'
	if kw == "destructs" 'd'
		return Convention.convDestructs
	end 'd'
	return Convention.convLet
end 'parseConvention'

export type FieldInfo
	export var name as String
	export var ty as TypeID
	export var isVar as bool
	export var exported as bool
	export var level as Visibility
	export var hasDefault as bool
	export var defaultExpr as NodeID
	export var index as Count

	export static function make(consumes name String, ty TypeID, isVar bool, exported bool, hasDefault bool, defaultExpr NodeID, index Count) returns FieldInfo
		var level = Visibility.unexported
		if exported 'wide'
			level = Visibility.exported
		end 'wide'
		return FieldInfo{name: name, ty: ty, isVar: isVar, exported: exported, level: level, hasDefault: hasDefault, defaultExpr: defaultExpr, index: index}
	end 'make'
end 'FieldInfo'

export typealias FieldInfoList = Array with FieldInfo

export type CaseFieldInfo
	export var name as String
	export var ty as TypeID

	export static function make(consumes name String, ty TypeID) returns CaseFieldInfo
		return CaseFieldInfo{name: name, ty: ty}
	end 'make'
end 'CaseFieldInfo'

export typealias CaseFieldList = Array with CaseFieldInfo

// RawKind is what the raw values of an enum or a union are: the integers that count up from the case before, the floats and
// the strings that every case writes, or values that are not literals: a record, a function, anything an expression builds,
// which every case writes as the same type (the type of `rawTypeOf`).
export enum RawKind
	integer
	float
	string
	value

	// noun is how a message names a kind of literal, as maxon does; a value is named by its type.
	export function noun() returns String
		return match self 'k'
			integer gives "int"
			float gives "float"
			string gives "String"
			value gives panic("a raw value that is no literal is named by its type")
		end 'k'
	end 'noun'
end 'RawKind'

export type CaseInfo
	export var name as String
	export var payload as CaseFieldList
	export var hasRaw as bool
	// rawValue is the integer of a case, or the bits of its float.
	export var rawValue as I128
	// rawText is the text of the case whose raw value is a string.
	export var rawText as String
	// rawExpr is the expression of a case whose raw value is not a literal, in the module that declares the type, and 0 for any other.
	export var rawExpr as NodeID

	export static function make(consumes name String, consumes payload CaseFieldList, hasRaw bool, consumes rawValue I128) returns CaseInfo
		return CaseInfo{name: name, payload: payload, hasRaw: hasRaw, rawValue: rawValue, rawText: "", rawExpr: 0 as NodeID}
	end 'make'
end 'CaseInfo'

export typealias CaseInfoList = Array with CaseInfo

export type ParamSpec
	export var name as String
	export var ty as TypeID
	export var conv as Convention
	// defaultExpr is the node of the parameter's default in the tree of the module that declares the function, or 0.
	export var defaultExpr as NodeID
	// labelled is whether a call names the argument with its label even where it is the first, as a built-in's whose
	// first parameter the form of the call leaves out does: `Vec3.create(value: 0)`.
	export var labelled as bool

	export static function make(consumes name String, ty TypeID, conv Convention) returns ParamSpec
		return ParamSpec{name: name, ty: ty, conv: conv, defaultExpr: 0 as NodeID, labelled: false}
	end 'make'

	export static function withDefault(consumes name String, ty TypeID, conv Convention, defaultExpr NodeID) returns ParamSpec
		return ParamSpec{name: name, ty: ty, conv: conv, defaultExpr: defaultExpr, labelled: false}
	end 'withDefault'

	export static function labelledFirst(consumes name String, ty TypeID, conv Convention) returns ParamSpec
		return ParamSpec{name: name, ty: ty, conv: conv, defaultExpr: 0 as NodeID, labelled: true}
	end 'labelledFirst'
end 'ParamSpec'

export typealias ParamSpecList = Array with ParamSpec

export type ParamBound
	export var paramTy as TypeID
	export var ifaceTy as TypeID

	export static function make(paramTy TypeID, ifaceTy TypeID) returns ParamBound
		return ParamBound{paramTy: paramTy, ifaceTy: ifaceTy}
	end 'make'
end 'ParamBound'

export typealias ParamBoundList = Array with ParamBound

export type MethodRef
	export var name as String
	export var func as FuncID

	export static function make(consumes name String, func FuncID) returns MethodRef
		return MethodRef{name: name, func: func}
	end 'make'
end 'MethodRef'

export typealias MethodRefList = Array with MethodRef

// ExtMethod is a method that an extension adds to the type owner, which is the key of the extended type
// (ast.extensionKey). It belongs to the module that writes the extension, never to the type's own entry.
export type ExtMethod
	export var owner as TypeID
	export var name as String
	export var func as FuncID

	export static function make(owner TypeID, consumes name String, func FuncID) returns ExtMethod
		return ExtMethod{owner: owner, name: name, func: func}
	end 'make'
end 'ExtMethod'

export typealias ExtMethodList = Array with ExtMethod

// ExtAlias is a typealias that an extension adds to the type owner, which is the key of the extended type
// (ast.extensionKey). It belongs to the module that writes the extension, as its methods do. extended is the type the
// extension extends, whose own parameters its target names.
export type ExtAlias
	export var owner as TypeID
	export var name as String
	export var ordinal as DeclOrdinal
	export var extended as TypeID

	export static function make(owner TypeID, consumes name String, ordinal DeclOrdinal, extended TypeID) returns ExtAlias
		return ExtAlias{owner: owner, name: name, ordinal: ordinal, extended: extended}
	end 'make'
end 'ExtAlias'

export typealias ExtAliasList = Array with ExtAlias

// ExtConform is an interface that an extension says the type owner implements.
export type ExtConform
	export var owner as TypeID
	export var iface as TypeID
	// site is the extension that says it.
	export var site as NodeID

	export static function make(owner TypeID, iface TypeID, site NodeID) returns ExtConform
		return ExtConform{owner: owner, iface: iface, site: site}
	end 'make'
end 'ExtConform'

export typealias ExtConformList = Array with ExtConform

// A Witness is the conformance that an instance of a generic function uses for one bound of its type parameters: the
// parameter and the interface as the generic declares them, and the module whose declaration says the type argument
// implements it (the type's own module for its body). The methods that meet the bound are those that module sees, so
// two instances given conformances of different modules are two instances.
export type Witness
	export var paramTy as TypeID
	export var ifaceTy as TypeID
	export var module as diag.ModuleID

	export static function make(paramTy TypeID, ifaceTy TypeID, module diag.ModuleID) returns Witness
		return Witness{paramTy: paramTy, ifaceTy: ifaceTy, module: module}
	end 'make'
end 'Witness'

export typealias WitnessList = Array with Witness

export type TypeEntry
	export var id as TypeID
	export var kind as TypeKind
	export var name as String
	export var inferred as bool
	export var minVal as I128
	export var maxVal as I128
	// bitsWidth is the width of a bits(n) typealias, a raw bit pattern, and 0 for every other type.
	export var bitsWidth as Count
	export var hasDecl as bool
	export var decl as DeclRef
	export var isNoncopyable as bool
	export var origin as TypeID
	export var declaring as bool
	export var typeParams as TypeIDList
	export var typeArgs as TypeIDList
	export var conforms as TypeIDList
	export var bounds as ParamBoundList
	export var fields as FieldInfoList
	export var cases as CaseInfoList
	export var hasExplicitRaw as bool
	export var rawKind as RawKind
	export var methods as MethodRefList
	export var sigs as FuncIDList
	export var boundIface as TypeID
	export var dropFunc as FuncID
	export var selfParam as TypeID
	// paramConvs are the conventions of the parameters of a function type, on the origin that every function type with
	// them is an instance of: its type arguments are the parameters' types and then the result's.
	export var paramConvs as ConventionList
	export var isTuple as bool
	// mutatesCaptures is, on the origin of a function type, whether a value of it may write what it captured, and isBrand
	// whether a typealias named it as a brand of its own (see FuncBrand).
	export var mutatesCaptures as bool
	export var isBrand as bool
	// brandKey is, on the origin of a function type that is a brand, the key of the brand (FuncBrand), and "" on any other.
	export var brandKey as String
	// supertype is the ranged alias that a ranged alias implements, whose places take its values with no cast.
	export var supertype as TypeID

	export static function make(kind TypeKind, consumes name String) returns TypeEntry
		let z = I128.zero()
		return TypeEntry{id: noType, kind: kind, name: name, inferred: false, minVal: z.clone(), maxVal: z, bitsWidth: 0 as Count, hasDecl: false, decl: DeclRef.make(0 as diag.ModuleID, ordinal: 0 as DeclOrdinal), isNoncopyable: false, origin: noType, declaring: false, typeParams: TypeIDList.create(0), typeArgs: TypeIDList.create(0), conforms: TypeIDList.create(0), bounds: ParamBoundList.create(0), fields: FieldInfoList.create(0), cases: CaseInfoList.create(0), hasExplicitRaw: false, rawKind: RawKind.integer, methods: MethodRefList.create(0), sigs: FuncIDList.create(0), boundIface: noType, dropFunc: noFunc, selfParam: noType, paramConvs: ConventionList.create(0), isTuple: false, mutatesCaptures: false, isBrand: false, brandKey: "", supertype: noType}
	end 'make'

	export function findMethod(methodName String) returns table.Option with FuncID
		for i in 0 upto methods.count() 'each'
			if methods[i].name == methodName 'hit'
				return table.Option.some(methods[i].func)
			end 'hit'
		end 'each'
		return table.Option.none
	end 'findMethod'

	export function findField(fieldName String) returns table.Option with Count
		for i in 0 upto fields.count() 'each'
			if fields[i].name == fieldName 'hit'
				return table.Option.some(i)
			end 'hit'
		end 'each'
		return table.Option.none
	end 'findField'

	export function findCase(caseName String) returns table.Option with Count
		for i in 0 upto cases.count() 'each'
			if cases[i].name == caseName 'hit'
				return table.Option.some(i)
			end 'hit'
		end 'each'
		return table.Option.none
	end 'findCase'

	export function effectiveOrigin() returns TypeID
		if origin != noType 'inst'
			return origin
		end 'inst'
		return id
	end 'effectiveOrigin'
end 'TypeEntry'

export typealias TypeEntryList = Array with TypeEntry

export typealias TypeEntryLists = Array with TypeEntryList

export type FuncEntry
	export var id as FuncID
	export var name as String
	export var visibility as String
	export var hasDecl as bool
	export var decl as DeclRef
	export var module as diag.ModuleID
	export var nodeID as NodeID
	export var isStatic as bool
	export var isDestructor as bool
	export var hasReceiver as bool
	// isClosure is whether the function is the body of a closure, which takes the closure itself first, before its
	// parameters, to read what it captured.
	export var isClosure as bool
	export var ownerTy as TypeID
	export var selfConv as Convention
	export var generics as TypeIDList
	export var bounds as ParamBoundList
	export var params as ParamSpecList
	export var paramTypes as TypeIDList
	export var retTy as TypeID
	// result says whether the function gives a value of retTy or a place of it that it borrows from its arguments.
	export var result as ResultConv
	export var errTy as TypeID
	export var genericOrigin as FuncID
	export var typeArgs as TypeIDList
	// witnesses are, on an instance, the conformances it was given for the bounds of its type parameters.
	export var witnesses as WitnessList
	export var intrinsic as Intrinsic
	export var linkName as String
	export var bodyRef as diag.U32
	// isTest is whether the function is a test, which is checked but never compiled into a program.
	export var isTest as bool
	// extendedIface is, for a method that an extension of an interface adds, that interface's declaration: the method is
	// generic over the type that implements it, which is its first type parameter.
	export var extendedIface as TypeID
	// conditionalBounds is how many of its bounds, first among them, the 'where' of the extension that declares it gives.
	export var conditionalBounds as Count

	export static function make(consumes name String, consumes visibility String, module diag.ModuleID, nodeID NodeID) returns FuncEntry
		return FuncEntry{id: noFunc, name: name, visibility: visibility, hasDecl: false, decl: DeclRef.make(module, ordinal: 0 as DeclOrdinal), module: module, nodeID: nodeID, isStatic: false, isDestructor: false, hasReceiver: false, isClosure: false, ownerTy: noType, selfConv: Convention.convLet, generics: TypeIDList.create(0), bounds: ParamBoundList.create(0), params: ParamSpecList.create(0), paramTypes: TypeIDList.create(0), retTy: noType, result: ResultConv.resultOwned, errTy: noType, genericOrigin: noFunc, typeArgs: TypeIDList.create(0), witnesses: WitnessList.create(0), intrinsic: Intrinsic.intrNone, linkName: "", bodyRef: 0 as diag.U32, isTest: false, extendedIface: noType, conditionalBounds: 0 as Count}
	end 'make'
end 'FuncEntry'

export typealias FuncEntryList = Array with FuncEntry

export typealias FuncEntryLists = Array with FuncEntryList

export type LocalEntry
	export var id as LocalID
	export var name as String
	export var ty as TypeID
	export var isVar as bool
	export var isParam as bool
	export var isSelf as bool
	export var projected as bool
	export var paramIndex as Count
	export var conv as Convention
	export var definedAt as NodeID
	export var isUninitialized as bool
	export var isCapture as bool
	// captureConv is, for a capture, how the closure holds it: as its value, which the body only reads (let), as the
	// address of the variable that a mutating closure changes (mutates), or as a value the closure owns and a mutating
	// closure changes in place, so that each call sees the last one's writes (consumes).
	export var captureConv as Convention
	// slot is the place of a local that is not a parameter among the slots of its function's IR: dense from 0, in the
	// order the checker declared them.
	export var slot as SlotIndex

	export static function make(consumes name String, ty TypeID, isVar bool, isParam bool, conv Convention, definedAt NodeID) returns LocalEntry
		return LocalEntry{id: noLocal, name: name, ty: ty, isVar: isVar, isParam: isParam, isSelf: false, projected: false, paramIndex: 0 as Count, conv: conv, definedAt: definedAt, isUninitialized: false, isCapture: false, captureConv: Convention.convLet, slot: noSlot}
	end 'make'
end 'LocalEntry'

export typealias LocalEntryList = Array with LocalEntry

export typealias SlotList = Array with Count

export typealias SlotLists = Array with SlotList

export typealias FuncInternMap = table.StringMap with FuncID

export typealias FuncInternMaps = Array with FuncInternMap

export type TypeTable
	// lists are the entries of the types, two lists to a slot: at nominalList(slot) the slot's nominal types, in the order
	// its stages made them, and at shapeList(slot) the structural types its stages made or took from a slot they read.
	export var lists as TypeEntryLists
	// shapeIndexes find, by slot and by handle, the shapes of the slot and those of the slots it reads that they held when
	// its running task began (importShapes): the place of each, as the bits of a nominal handle are.
	var shapeIndexes as ShapeIndexes
	// reads are, by slot, the slots of other modules whose shapes the stages of the slot's module read besides sharedSlot:
	// those of the modules it names, directly or through others, and of the modules an earlier compile compiled.
	var reads as SlotLists
	// imported are, by slot, how many of the shapes of each slot it reads its index finds.
	var imported as SlotLists
	// ends are, by slot and by phase, how many shapes the slot held when the task of its module's stage of that phase ended:
	// what a task that waited on that stage reads of the slot, whatever the module's later stages have made since.
	var ends as SlotLists
	// writer is the slot that the running task may make types in (see beginModuleTask).
	var writer as Count
	// kinds are the kinds by their ordinal, which a structural handle holds.
	var kinds as Array with TypeKind

	export static function new() returns TypeTable
		var es = TypeEntryList.create(0)
		es.push(TypeEntry.make(TypeKind.invalid, name: "<invalid>"))
		var lists = TypeEntryLists.create(0)
		lists.push(es)
		lists.push(TypeEntryList.create(0))
		var indexes = ShapeIndexes.create(0)
		indexes.push(ShapeIndex.new())
		var reads = SlotLists.create(0)
		reads.push(SlotList.create(0))
		var imported = SlotLists.create(0)
		imported.push(SlotList.create(0))
		var ends = SlotLists.create(0)
		ends.push(SlotList.create(0))
		return TypeTable{lists: lists, shapeIndexes: indexes, reads: reads, imported: imported, ends: ends, writer: unscheduled, kinds: TypeKind.allCases}
	end 'new'

	// lent is the table a project holds while a task holds its own: one with no slots, which no handle reads.
	export static function lent() returns TypeTable
		return TypeTable{lists: TypeEntryLists.create(0), shapeIndexes: ShapeIndexes.create(0), reads: SlotLists.create(0), imported: SlotLists.create(0), ends: SlotLists.create(0), writer: unscheduled, kinds: Array.create(0)}
	end 'lent'
end 'TypeTable'

// A nominal type's handle and every function's name the slot that holds its entry, in the bits from handleSlotShift, and
// its place there, in the bits below: sharedSlot is the stdlib's and the built-ins', and slot 1 + m is module m's. A
// structural type's handle is its word (shapes.maxon), the same in every module, and each slot whose stages make it
// holds a copy of its entry. Every read of an entry goes through typeList and typeIndex, so only ast knows how a handle
// and an entry relate. A module's slot is written only by its own stages, so its handles are a function of its source.
let handleIndexMask = 4294967295 as Count

let handleSlotShift = 32 as Count

let handleSlotMask = 65535 as Count

// listsPerSlot is how many lists of entries a slot of the type table has: its nominal types and its shapes.
let listsPerSlot = 2 as Count

// handleWord is the handle of the entry at index in slot.
function handleWord(slot Count, index Count) returns Count
	if index > handleIndexMask or slot > handleSlotMask 'past'
		panic("a slot of more than {handleIndexMask} entries, or more than {handleSlotMask} modules")
	end 'past'
	return (slot shl handleSlotShift) or index
end 'handleWord'

// sharedSlot holds the built-ins and the stdlib, and what the stages of the project make.
let sharedSlot = 0 as Count

// unscheduled is the writer of the tables outside the tasks of a compile, where the project is set up and tests make
// entries in any slot.
let unscheduled = 65536 as Count

// requireWriter stops the compile where a task makes an entry in a slot other than its own: in the slot of a module it is no
// stage of, whose handles would then depend on the order the tasks run in, or, for a task of a module, in sharedSlot, which
// the tasks of every module read and which only what runs before them and the tasks of the project write.
function requireWriter(writer Count, slot Count)
	if writer != unscheduled and slot != writer 'foreign'
		panic("an entry is made in slot {slot} by a task that may make them only in slot {writer}")
	end 'foreign'
end 'requireWriter'

// ownSlot is the slot whose shapes and function instances the running task makes: its module's, or sharedSlot for a
// stage of the project and outside the tasks.
function ownSlot(writer Count) returns Count
	if writer == unscheduled 'outside'
		return sharedSlot
	end 'outside'
	return writer
end 'ownSlot'

// moduleSlot is the slot of the entries that module makes.
export function moduleSlot(module diag.ModuleID) returns Count
	if module == diag.stdlibID 'std'
		return sharedSlot
	end 'std'
	return try modIndex(module) + 1 otherwise panic("a module past the slots of a handle")
end 'moduleSlot'

function handleSlot(h Count) returns Count
	return (h shr handleSlotShift) and handleSlotMask
end 'handleSlot'

function handleIndex(h Count) returns Count
	return h and handleIndexMask
end 'handleIndex'

function nominalList(slot Count) returns Count
	return try slot * listsPerSlot otherwise panic("a slot past the lists of the type table")
end 'nominalList'

function shapeList(slot Count) returns Count
	return try slot * listsPerSlot + 1 otherwise panic("a slot past the lists of the type table")
end 'shapeList'

// typeList is the list of the type table that holds the entry of the type t. It and typeIndex run for every read of an
// entry, so they read the bits of the handle in place.
export function typeList(tt TypeTable, t TypeID) returns Count
	let h = t as Count
	if (h and structuralBit) != 0 'shape'
		return shapeList((shapePlace(tt, word: h) shr handleSlotShift) and handleSlotMask)
	end 'shape'
	return ((h shr handleSlotShift) and handleSlotMask) * listsPerSlot
end 'typeList'

// typePlace is where the entry of the type t is, its list in the bits from handleSlotShift and its position there below,
// for a function that reads an entry more than once to find it once.
function typePlace(tt TypeTable, t TypeID) returns Count
	let h = t as Count
	if (h and structuralBit) != 0 'shape'
		let place = shapePlace(tt, word: h)
		return listPlace(shapeList((place shr handleSlotShift) and handleSlotMask), index: place and handleIndexMask)
	end 'shape'
	return listPlace(nominalList((h shr handleSlotShift) and handleSlotMask), index: h and handleIndexMask)
end 'typePlace'

function listPlace(list Count, index Count) returns Count
	return (try list shl handleSlotShift otherwise panic("a list past the bits of a place")) or index
end 'listPlace'

function placeList(at Count) returns Count
	return at shr handleSlotShift
end 'placeList'

function placeIndex(at Count) returns Count
	return at and handleIndexMask
end 'placeIndex'

// typeKind is the kind of the type t, which a structural type's handle holds, so that reading it reads no entry.
export function typeKind(tt TypeTable, t TypeID) returns TypeKind
	let h = t as Count
	if (h and structuralBit) != 0 'shape'
		return tt.kinds[(h shr shapeKindShift) and shapeKindMask]
	end 'shape'
	return tt.lists[((h shr handleSlotShift) and handleSlotMask) * listsPerSlot][h and handleIndexMask].kind
end 'typeKind'

// typeIndex is the position of the type t in the list typeList gives.
export function typeIndex(tt TypeTable, t TypeID) returns Count
	let h = t as Count
	if (h and structuralBit) != 0 'shape'
		return shapePlace(tt, word: h) and handleIndexMask
	end 'shape'
	return h and handleIndexMask
end 'typeIndex'

// leadingReads are the slots a module's stages look a shape up in before those it reads: its own and sharedSlot.
let leadingReads = 2 as Count

// readCount is how many slots the stages of the slot own read shapes from: every slot for sharedSlot, whose stages are
// those of the project, and otherwise own, sharedSlot and the slots it reads.
function readCount(tt TypeTable, own Count) returns Count
	if own == sharedSlot 'project'
		return tt.shapeIndexes.count()
	end 'project'
	return try tt.reads[own].count() + leadingReads otherwise panic("more slots than memory")
end 'readCount'

// readAt is the slot at k in the order the stages of own look a shape up in: own first, then sharedSlot, then the slots
// own reads.
function readAt(tt TypeTable, own Count, k Count) returns Count
	if own == sharedSlot 'project'
		return k
	end 'project'
	if k == 0 'own'
		return own
	end 'own'
	if k == 1 'shared'
		return sharedSlot
	end 'shared'
	return tt.reads[own][try k - leadingReads otherwise panic("a read before the slots own reads")]
end 'readAt'

// findShape finds the entry of the structure under word in a slot the running task reads, and sets place to its slot and
// position, as the bits of a nominal handle are.
function findShape(tt TypeTable, word Count, sets place Count) returns bool
	let own = ownSlot(tt.writer)
	let at = tt.shapeIndexes[own].probe(word)
	if tt.shapeIndexes[own].holds(at, word: word) 'own'
		place = tt.shapeIndexes[own].placeAt(at)
		return true
	end 'own'
	// A task of a module took in at its start every shape it may read. A stage of the project, and what runs outside the
	// tasks, read every slot as it stands.
	if tt.writer != unscheduled and own != sharedSlot 'frozen'
		place = 0 as Count
		return false
	end 'frozen'
	let n = readCount(tt, own: own)
	for k in 1 upto n 'slots'
		let s = readAt(tt, own: own, k: k)
		let other = tt.shapeIndexes[s].probe(word)
		if tt.shapeIndexes[s].holds(other, word: word) 'hit'
			place = tt.shapeIndexes[s].placeAt(other)
			return true
		end 'hit'
	end 'slots'
	place = 0 as Count
	return false
end 'findShape'

// shapePlace is where the entry of the structural type of handle word is: the task that reads it got it from its own
// stages or from a module it waited on, so one of the slots it reads holds it. The task's own index finds nearly every
// one, which it probes in place as findShape does.
function shapePlace(tt TypeTable, word Count) returns Count
	var own = tt.writer
	if own == unscheduled 'outside'
		own = sharedSlot
	end 'outside'
	let mask = tt.shapeIndexes[own].mask
	var at = word and mask
	while tt.shapeIndexes[own].cells[at] != emptyWord 'probe'
		if tt.shapeIndexes[own].cells[at] == word 'hit'
			return tt.shapeIndexes[own].cells[try at + 1 otherwise panic("a place past the cells of a shape index")]
		end 'hit'
		at = (try at + shapeCell otherwise 0 as Count) and mask
	end 'probe'
	var place as Count
	if not findShape(tt, word: word, place: place) 'lost'
		panic("the structural type {word} is in none of the slots that slot {ownSlot(tt.writer)} reads")
	end 'lost'
	return place
end 'shapePlace'

// allocType makes a nominal type that module declares.
export function allocType(mutates tt TypeTable, module diag.ModuleID, consumes e TypeEntry) returns TypeID
	let slot = moduleSlot(module)
	requireWriter(tt.writer, slot: slot)
	let list = nominalList(slot)
	let id = try handleWord(slot, index: tt.lists[list].count()) as TypeID otherwise panic("a type handle past its bits")
	var copyE = e
	copyE.id = id
	tt.lists[list].push(copyE)
	return id
end 'allocType'

// allocShape makes the structural type of word in the shapes of the running task's slot, which no slot it reads holds.
function allocShape(mutates tt TypeTable, consumes e TypeEntry, word Count) returns TypeID
	let own = ownSlot(tt.writer)
	let list = shapeList(own)
	let index = tt.lists[list].count()
	let id = try word as TypeID otherwise panic("a structural word past the bits of a handle")
	var copyE = e
	copyE.id = id
	tt.lists[list].push(copyE)
	tt.shapeIndexes[own].insert(word, place: handleWord(own, index: index))
	return id
end 'allocShape'

// adoptShape copies the entry of the structure at place, which another slot the running task reads holds, into the
// task's own shapes, so that its slot holds every structure its stages made or used.
function adoptShape(mutates tt TypeTable, place Count, word Count)
	if handleSlot(place) == ownSlot(tt.writer) 'held'
		return
	end 'held'
	let own = ownSlot(tt.writer)
	let list = shapeList(own)
	let index = tt.lists[list].count()
	let e = tt.lists[shapeList(handleSlot(place))][handleIndex(place)].clone()
	tt.lists[list].push(e)
	tt.shapeIndexes[own].repoint(word, place: handleWord(own, index: index))
end 'adoptShape'

// importShapes makes the index of the slot own find the shapes that the slots it reads made since it last did, up to what
// the stage of phase made of each (shapesAt), so that one probe finds any shape its task reads. A word the index finds
// already keeps its place.
function importShapes(mutates tt TypeTable, own Count, phase Count)
	let n = readCount(tt, own: own)
	for k in 1 upto n 'slots'
		let r = readAt(tt, own: own, k: k)
		while tt.imported[own].count() <= r 'mark'
			tt.imported[own].push(0 as Count)
		end 'mark'
		let from = tt.imported[own][r]
		let list = shapeList(r)
		let made = shapesAt(tt, slot: r, phase: phase)
		for i in from upto made 'shapes'
			let word = tt.lists[list][i].id as Count
			tt.shapeIndexes[own].include(word, place: handleWord(r, index: i))
		end 'shapes'
		tt.imported[own][r] = made
	end 'slots'
end 'importShapes'

// unrecorded marks a phase whose task of a slot's module has not ended.
let unrecorded = 4294967295 as Count

// shapesAt is how many of the shapes of slot a task that waited on the stage of phase of its module reads: what that stage
// had made when it ended, or every one for a slot whose module an earlier compile compiled, or that a stage of the project
// reads, which runs once every module's stage before it has ended.
function shapesAt(tt TypeTable, slot Count, phase Count) returns Count
	if phase < tt.ends[slot].count() and tt.ends[slot][phase] != unrecorded 'recorded'
		return tt.ends[slot][phase]
	end 'recorded'
	return tt.lists[shapeList(slot)].count()
end 'shapesAt'

// endModuleTask records what the task of the stage of phase of module, which ends, made of its slot's shapes.
export function endModuleTask(mutates tt TypeTable, module diag.ModuleID, phase Count)
	let slot = moduleSlot(module)
	while tt.ends[slot].count() <= phase 'room'
		tt.ends[slot].push(unrecorded)
	end 'room'
	tt.ends[slot][phase] = tt.lists[shapeList(slot)].count()
end 'endModuleTask'

// beginModuleTask lets the task of a stage of module, which begins, make entries in its slot only, and read
// the shapes that the stage of phase made of each module it waited on.
export function beginModuleTask(mutates tt TypeTable, mutates ft FuncTable, module diag.ModuleID, phase Count)
	let slot = moduleSlot(module)
	tt.writer = slot
	ft.writer = slot
	importShapes(tt, own: slot, phase: phase)
end 'beginModuleTask'

// beginProjectTask lets the task of a stage of the project, which begins, make entries in sharedSlot only.
export function beginProjectTask(mutates tt TypeTable, mutates ft FuncTable)
	tt.writer = sharedSlot
	ft.writer = sharedSlot
	importShapes(tt, own: sharedSlot, phase: unrecorded)
end 'beginProjectTask'

// endTasks lets what runs after the tasks of a compile make entries in any slot again.
export function endTasks(mutates tt TypeTable, mutates ft FuncTable)
	tt.writer = unscheduled
	ft.writer = unscheduled
	for s in 0 upto tt.ends.count() 'slots'
		tt.ends[s] = SlotList.create(0)
	end 'slots'
end 'endTasks'

// addSlots makes the slots of a module added to the project, which come after those of the modules before it.
export function addSlots(mutates tt TypeTable, mutates ft FuncTable)
	tt.lists.push(TypeEntryList.create(0))
	tt.lists.push(TypeEntryList.create(0))
	tt.shapeIndexes.push(ShapeIndex.new())
	tt.reads.push(SlotList.create(0))
	tt.imported.push(SlotList.create(0))
	tt.ends.push(SlotList.create(0))
	ft.slots.push(FuncEntryList.create(0))
	ft.instCaches.push(FuncInternMap.new())
end 'addSlots'

// setShapeReads records the slots of the modules whose shapes the stages of module read besides its own and sharedSlot:
// those of the modules it waits on, in slot order.
export function setShapeReads(mutates tt TypeTable, module diag.ModuleID, consumes slots SlotList)
	tt.reads[moduleSlot(module)] = slots
end 'setShapeReads'

export function cloneTypeArgs(args TypeIDList) returns TypeIDList
	return args.clone()
end 'cloneTypeArgs'

export function internIntRange(mutates tt TypeTable, consumes aliasName String, consumes minVal I128, consumes maxVal I128, inferred bool) returns TypeID
	let word = intRangeWord(aliasName, minVal: minVal, maxVal: maxVal, inferred: inferred)
	let found = intRangeUnder(tt, word: word, aliasName: aliasName, minVal: minVal, maxVal: maxVal, inferred: inferred)
	match takeShape(tt, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.intRange, name: aliasName)
	e.inferred = inferred
	e.minVal = minVal
	e.maxVal = maxVal
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internIntRange'

export function internConstInt(mutates tt TypeTable, consumes val I128) returns TypeID
	let word = constIntWord(val)
	let found = constIntUnder(tt, word: word, val: val)
	match takeShape(tt, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.constInt, name: "const({val.toString()})")
	e.minVal = val.clone()
	e.maxVal = val
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internConstInt'

// internFloatRange is the float type of a range, whose bounds are the bits of the doubles that end it. One that runs from
// f64.min to f64.max holds every double, the infinities and NaN among them.
export function internFloatRange(mutates tt TypeTable, consumes aliasName String, lo Count, hi Count) returns TypeID
	let word = floatRangeWord(aliasName, lo: lo, hi: hi)
	let found = floatRangeUnder(tt, word: word, aliasName: aliasName, lo: lo, hi: hi)
	match takeShape(tt, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.floatRange, name: aliasName)
	e.minVal = I128.fromCount(lo)
	e.maxVal = I128.fromCount(hi)
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internFloatRange'

// internConstFloat is the type of a float constant, whose value is the bits of its double.
export function internConstFloat(mutates tt TypeTable, bits Count) returns TypeID
	let word = constFloatWord(bits)
	let found = constFloatUnder(tt, word: word, bits: bits)
	match takeShape(tt, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.constFloat, name: "float")
	e.minVal = I128.fromCount(bits)
	e.maxVal = I128.fromCount(bits)
	let id = allocShape(tt, e: e, word: word)
	return id
end 'internConstFloat'

export function isFloatType(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	let k = typeKind(tt, t: t)
	return k == TypeKind.floatRange or k == TypeKind.constFloat
end 'isFloatType'

// floatBits is the double of a float constant, or a bound of a float range: minVal for the low one.
export function floatLowBits(tt TypeTable, t TypeID) returns Count
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].minVal.lo
end 'floatLowBits'

export function floatHighBits(tt TypeTable, t TypeID) returns Count
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].maxVal.lo
end 'floatHighBits'

// isFullFloatRange is whether a float range runs from f64.min to f64.max, and so holds every double.
export function isFullFloatRange(tt TypeTable, t TypeID) returns bool
	return typeKind(tt, t: t) == TypeKind.floatRange and floatLowBits(tt, t: t) == floatNegate(floatMaxBits) and floatHighBits(tt, t: t) == floatMaxBits
end 'isFullFloatRange'

// floatRangeHolds is whether the float range t holds the double of the bits.
export function floatRangeHolds(tt TypeTable, t TypeID, bits Count) returns bool
	if isFullFloatRange(tt, t: t) 'all'
		return true
	end 'all'
	let low = floatCompare(bits, b: floatLowBits(tt, t: t))
	let high = floatCompare(bits, b: floatHighBits(tt, t: t))
	return (low == FloatOrder.greater or low == FloatOrder.equal) and (high == FloatOrder.less or high == FloatOrder.equal)
end 'floatRangeHolds'

// floatRangeCovers is whether the float range dst holds every value of the float range src.
export function floatRangeCovers(tt TypeTable, dst TypeID, src TypeID) returns bool
	if isFullFloatRange(tt, t: dst) 'all'
		return true
	end 'all'
	if isFullFloatRange(tt, t: src) 'none'
		return false
	end 'none'
	return floatRangeHolds(tt, t: dst, bits: floatLowBits(tt, t: src)) and floatRangeHolds(tt, t: dst, bits: floatHighBits(tt, t: src))
end 'floatRangeCovers'

// floatSpelling is how a float type's range is written: FullRangeFloat for the whole of it, as maxon names it.
function floatSpelling(tt TypeTable, t TypeID) returns String
	if isFullFloatRange(tt, t: t) 'full'
		return "FullRangeFloat"
	end 'full'
	return "float({floatDiagnosticText(floatLowBits(tt, t: t))} to {floatDiagnosticText(floatHighBits(tt, t: t))})"
end 'floatSpelling'

// extendsInterface is whether an implementation of the interface have is one of want: have is want, or extends it,
// directly or through the interfaces it extends. The interfaces an interface extends are held in its conforms, and take
// no type arguments.
export function extendsInterface(tt TypeTable, have TypeID, want TypeID) returns bool
	if have == want 'same'
		return true
	end 'same'
	let orig = tt.lists[typeList(tt, t: have)][typeIndex(tt, t: have)].effectiveOrigin()
	for i in 0 upto tt.lists[typeList(tt, t: orig)][typeIndex(tt, t: orig)].conforms.count() 'parents'
		if extendsInterface(tt, have: tt.lists[typeList(tt, t: orig)][typeIndex(tt, t: orig)].conforms[i], want: want) 'hit'
			return true
		end 'hit'
	end 'parents'
	return false
end 'extendsInterface'

// isSubtypeOf is whether the ranged alias sub implements sup, directly or through the aliases it implements.
export function isSubtypeOf(tt TypeTable, sub TypeID, sup TypeID) returns bool
	var t = tt.lists[typeList(tt, t: sub)][typeIndex(tt, t: sub)].supertype
	while t != noType 'up'
		if t == sup 'hit'
			return true
		end 'hit'
		t = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].supertype
	end 'up'
	return false
end 'isSubtypeOf'

// commonSupertype is the nearest alias that both ranged aliases a and b are or implement, or none.
export function commonSupertype(tt TypeTable, a TypeID, b TypeID) returns TypeID
	var t = a
	while t != noType 'up'
		if t == b or isSubtypeOf(tt, sub: b, sup: t) 'hit'
			return t
		end 'hit'
		t = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].supertype
	end 'up'
	return noType
end 'commonSupertype'

export function instanceKey(origin TypeID, args TypeIDList) returns String
	var b = ByteArray.create(0)
	b.append("{origin}:".toByteArray())
	for i in 0 upto args.count() 'each'
		if i > 0 'sep'
			b.push(44 as Byte)
		end 'sep'
		b.append("{args[i]}".toByteArray())
	end 'each'
	return String.from(b)
end 'instanceKey'

// funcInstanceKey is instanceKey with the modules of the conformances an instance of a function is given.
function funcInstanceKey(origin FuncID, args TypeIDList, witnesses WitnessList) returns String
	var b = instanceKey(origin as TypeID, args: args).toByteArray()
	for i in 0 upto witnesses.count() 'each'
		b.append(";{witnesses[i].module}".toByteArray())
	end 'each'
	return String.from(b)
end 'funcInstanceKey'

export function instantiateType(mutates tt TypeTable, origin TypeID, args TypeIDList) returns TypeID
	let baseOrigin = tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].effectiveOrigin()
	if args.count() == 0 'none'
		return baseOrigin
	end 'none'
	let word = instanceWord(tt, origin: baseOrigin, args: args)
	let found = instanceUnder(tt, word: word, origin: baseOrigin, args: args)
	match takeShape(tt, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	let origKind = typeKind(tt, t: baseOrigin)
	let origName = tt.lists[typeList(tt, t: baseOrigin)][typeIndex(tt, t: baseOrigin)].name.clone()
	let origNoncopyable = tt.lists[typeList(tt, t: baseOrigin)][typeIndex(tt, t: baseOrigin)].isNoncopyable
	let hasOrigDecl = tt.lists[typeList(tt, t: baseOrigin)][typeIndex(tt, t: baseOrigin)].hasDecl
	let origDecl = tt.lists[typeList(tt, t: baseOrigin)][typeIndex(tt, t: baseOrigin)].decl.clone()
	var e = TypeEntry.make(origKind, name: origName)
	e.origin = baseOrigin
	e.typeArgs = cloneTypeArgs(args)
	e.isTuple = tt.lists[typeList(tt, t: baseOrigin)][typeIndex(tt, t: baseOrigin)].isTuple
	e.isNoncopyable = origNoncopyable
	e.hasDecl = hasOrigDecl
	e.decl = origDecl
	let id = allocShape(tt, e: e, word: word)
	if statesCount(tt, t: id) 'counted'
		// A fixed array whose type states its count is one of the runtime-sized type of its element, which a place of that
		// type takes and a join of the two gives.
		let elements = tt.lists[typeList(tt, t: baseOrigin)][typeIndex(tt, t: baseOrigin)].typeParams.count()
		var unsized = TypeIDList.create(0)
		for i in 0 upto elements 'elements'
			unsized.push(args[i])
		end 'elements'
		let sup = instantiateType(tt, origin: baseOrigin, args: unsized)
		tt.lists[typeList(tt, t: id)][typeIndex(tt, t: id)].supertype = sup
	end 'counted'
	return id
end 'instantiateType'

// sizeofWord is what sizeof gives for a value held in one word: an integer, a float, an enum, a handle, a function, and
// the box of a value the place refers to.
let sizeofWord = 8 as Count

// sizeofBool is what sizeof gives for a bool, maxon's one byte.
let sizeofBool = 1 as Count

// byteSize is what sizeof(t) gives: a bool's byte, a record's box of a word to each field (a word for one with none), and
// a word for any other value, which is a word in every place. t is concrete: a type parameter has its argument's size,
// which an instance knows.
export function byteSize(tt TypeTable, t TypeID) returns Count
	return match typeKind(tt, t: t) 'k'
		primBool gives sizeofBool
		record gives recordByteSize(tt, t: t)
		typeParam gives panic("the size of a type parameter is its argument's")
		invalid gives panic("an invalid type has no size")
		primVoid gives panic("Void has no size")
		primNever gives panic("Never has no size")
		interfaceTy gives panic("an interface has no size")
		primString gives sizeofWord
		intRange gives sizeofWord
		constInt gives sizeofWord
		floatRange gives sizeofWord
		constFloat gives sizeofWord
		enumTy gives sizeofWord
		unionTy gives sizeofWord
		builtinArray gives sizeofWord
		builtinMap gives sizeofWord
		builtinList gives sizeofWord
		builtinPool gives sizeofWord
		builtinHandle gives sizeofWord
		builtinFrozen gives sizeofWord
		builtinCown gives sizeofWord
		funcTy gives sizeofWord
	end 'k'
end 'byteSize'

function recordByteSize(tt TypeTable, t TypeID) returns Count
	let origin = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].effectiveOrigin()
	let fields = tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].fields.count()
	if fields == 0 'empty'
		return sizeofWord
	end 'empty'
	return try sizeofWord * fields otherwise panic("a record has fewer fields than a word counts bytes")
end 'recordByteSize'

// countedType is the instance of a fixed array of the element of unsized, a runtime-sized one, that states count.
export function countedType(mutates tt TypeTable, unsized TypeID, count Count) returns TypeID
	var args = cloneTypeArgs(tt.lists[typeList(tt, t: unsized)][typeIndex(tt, t: unsized)].typeArgs)
	args.push(internConstInt(tt, val: I128.fromCount(count)))
	return instantiateType(tt, origin: tt.lists[typeList(tt, t: unsized)][typeIndex(tt, t: unsized)].effectiveOrigin(), args: args)
end 'countedType'

// statesCount is whether t is an instance of a fixed array that states its count, a type argument after its element.
export function statesCount(tt TypeTable, t TypeID) returns bool
	let at = typePlace(tt, t: t)
	if typeKind(tt, t: t) != TypeKind.builtinArray 'notArray'
		return false
	end 'notArray'
	let origin = tt.lists[placeList(at)][placeIndex(at)].effectiveOrigin()
	return tt.lists[placeList(at)][placeIndex(at)].typeArgs.count() > tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].typeParams.count()
end 'statesCount'

// statedCount is the count that the type of a fixed array states (statesCount).
export function statedCount(tt TypeTable, t TypeID) returns Count
	if not statesCount(tt, t: t) 'none'
		panic("the type {typeName(tt, t: t)} states no count")
	end 'none'
	let origin = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].effectiveOrigin()
	let arg = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].typeParams.count()]
	return tt.lists[typeList(tt, t: arg)][typeIndex(tt, t: arg)].minVal.lo
end 'statedCount'

// countedSpelling is how an instance of a fixed array that states its count is written: the count before the element.
export function countedSpelling(base String, count String, element String) returns String
	if element.contains(" with ") 'nested'
		return "{base} with {count} ({element})"
	end 'nested'
	return "{base} with {count} {element}"
end 'countedSpelling'

// tupleOrigin is the record of which every tuple of arity elements is an instance: its fields are named by their places, 0, 1,
// and so on, so that an element is read and written as a field is, and it has one type parameter for each, so that a tuple
// has the layout, the copy and drop routines and the ownership rules of a record with those fields.
export function tupleOrigin(mutates tt TypeTable, arity Count) returns TypeID
	let word = tupleOriginWord(arity)
	let found = tupleOriginUnder(tt, word: word, arity: arity)
	match takeShape(tt, hit: found) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	var e = TypeEntry.make(TypeKind.record, name: "Tuple{arity}")
	e.isTuple = true
	let origin = allocShape(tt, e: e, word: word)
	for i in 0 upto arity 'each'
		var tp = TypeEntry.make(TypeKind.typeParam, name: "T{i}")
		let param = allocShape(tt, e: tp, word: tupleParamWord(word, index: i))
		tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].typeParams.push(param)
		tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].fields.push(FieldInfo.make("{i}", ty: param, isVar: true, exported: true, hasDefault: false, defaultExpr: 0 as NodeID, index: i))
	end 'each'
	return origin
end 'tupleOrigin'

// tupleType is the tuple of the element types, which is one type however it is written.
export function tupleType(mutates tt TypeTable, elems TypeIDList) returns TypeID
	let origin = tupleOrigin(tt, arity: elems.count())
	return instantiateType(tt, origin: origin, args: elems)
end 'tupleType'

export function isTupleType(tt TypeTable, t TypeID) returns bool
	return t != noType and tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].isTuple
end 'isTupleType'

export function selfType(mutates tt TypeTable, declTy TypeID) returns TypeID
	let orig = tt.lists[typeList(tt, t: declTy)][typeIndex(tt, t: declTy)].effectiveOrigin()
	if tt.lists[typeList(tt, t: orig)][typeIndex(tt, t: orig)].declaring or tt.lists[typeList(tt, t: orig)][typeIndex(tt, t: orig)].typeParams.count() == 0 'self'
		return orig
	end 'self'
	let args = cloneTypeArgs(tt.lists[typeList(tt, t: orig)][typeIndex(tt, t: orig)].typeParams)
	return instantiateType(tt, origin: orig, args: args)
end 'selfType'

export function typeArgsOf(tt TypeTable, t TypeID) returns TypeIDList
	let at = typePlace(tt, t: t)
	if tt.lists[placeList(at)][placeIndex(at)].typeArgs.count() > 0 'hasArgs'
		return cloneTypeArgs(tt.lists[placeList(at)][placeIndex(at)].typeArgs)
	end 'hasArgs'
	return cloneTypeArgs(tt.lists[placeList(at)][placeIndex(at)].typeParams)
end 'typeArgsOf'

// typeArgAt is the type argument at an index of what typeArgsOf gives, read in place.
export function typeArgAt(tt TypeTable, t TypeID, index Count) returns TypeID
	let at = typePlace(tt, t: t)
	if tt.lists[placeList(at)][placeIndex(at)].typeArgs.count() > 0 'hasArgs'
		return tt.lists[placeList(at)][placeIndex(at)].typeArgs[index]
	end 'hasArgs'
	return tt.lists[placeList(at)][placeIndex(at)].typeParams[index]
end 'typeArgAt'

export function originOf(tt TypeTable, t TypeID) returns TypeID
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].effectiveOrigin()
end 'originOf'

export function substituteType(mutates tt TypeTable, t TypeID, params TypeIDList, args TypeIDList) returns TypeID
	let at = typePlace(tt, t: t)
	if t == noType or params.count() == 0 'noop'
		return t
	end 'noop'
	let kind = typeKind(tt, t: t)
	if kind == TypeKind.typeParam 'tp'
		for i in 0 upto params.count() 'each'
			if params[i] == t and i < args.count() 'hit'
				return args[i]
			end 'hit'
		end 'each'
		return t
	end 'tp'
	let origArgs = cloneTypeArgs(tt.lists[placeList(at)][placeIndex(at)].typeArgs)
	if origArgs.count() == 0 'nonInst'
		return t
	end 'nonInst'
	let selfOrigin = tt.lists[placeList(at)][placeIndex(at)].effectiveOrigin()
	if args.count() > params.count() and origArgs.equals(params) and tt.lists[typeList(tt, t: selfOrigin)][typeIndex(tt, t: selfOrigin)].typeParams.equals(params) 'countedSelf'
		// Self of a fixed array at the arguments of an instance that states its count is that instance.
		return instantiateType(tt, origin: selfOrigin, args: args)
	end 'countedSelf'
	var nextArgs = TypeIDList.create(0)
	var changed = false
	for i in 0 upto origArgs.count() 'eachArg'
		let sub = substituteType(tt, t: origArgs[i], params: params, args: args)
		if sub != origArgs[i] 'diff'
			changed = true
		end 'diff'
		nextArgs.push(sub)
	end 'eachArg'
	if not changed 'same'
		return t
	end 'same'
	let orig = tt.lists[placeList(at)][placeIndex(at)].effectiveOrigin()
	return instantiateType(tt, origin: orig, args: nextArgs)
end 'substituteType'

// FuncBrand is the typealias that makes a function type a brand of its own, as in maxon: a typealias at the top of a
// module, whose values flow into no other alias of the same shape without a cast. key tells two declarations apart and
// name is how the type is spelled; an empty key is no brand, the type of a closure, a named function and a typealias in a
// type's body.
export type FuncBrand
	export var key as String
	export var name as String

	export static function none() returns FuncBrand
		return FuncBrand{key: "", name: ""}
	end 'none'

	export static function make(consumes key String, consumes name String) returns FuncBrand
		return FuncBrand{key: key, name: name}
	end 'make'
end 'FuncBrand'

// FuncShape is what a function type says besides its parameters' types and its result: the conventions of its
// parameters, whether it mutates what it captures, and its brand.
export type FuncShape
	export var convs as ConventionList
	export var mutatesCaptures as bool
	export var brand as FuncBrand

	export static function make(consumes convs ConventionList, mutatesCaptures bool) returns FuncShape
		return FuncShape{convs: convs, mutatesCaptures: mutatesCaptures, brand: FuncBrand.none()}
	end 'make'
end 'FuncShape'

// internFuncType is the function type with these parameters and result: an instance of the origin of its shape, so
// that two spellings of one shape are one type and a generic one is substituted as any instance is. A brand is an origin
// of its own.
export function internFuncType(mutates tt TypeTable, params TypeIDList, shape FuncShape, result TypeID) returns TypeID
	let word = funcOriginWord(shape)
	var origin = noType
	let found = funcOriginUnder(tt, word: word, shape: shape)
	match takeShape(tt, hit: found) 'hit'
		some(id) then origin = id
		none then _ = 0
	end 'hit'
	if origin == noType 'new'
		var name = "function"
		if shape.brand.key != "" 'branded'
			name = shape.brand.name.clone()
		end 'branded'
		var e = TypeEntry.make(TypeKind.funcTy, name: name)
		e.paramConvs = shape.convs.clone()
		e.mutatesCaptures = shape.mutatesCaptures
		e.isBrand = shape.brand.key != ""
		e.brandKey = shape.brand.key.clone()
		origin = allocShape(tt, e: e, word: word)
	end 'new'
	var args = params.clone()
	args.push(result)
	return instantiateType(tt, origin: origin, args: args)
end 'internFuncType'

// funcMutatesCaptures is whether a value of the function type may write what it captured.
export function funcMutatesCaptures(tt TypeTable, t TypeID) returns bool
	return tt.lists[typeList(tt, t: originOf(tt, t: t))][typeIndex(tt, t: originOf(tt, t: t))].mutatesCaptures
end 'funcMutatesCaptures'

// funcIsBrand is whether a typealias made the function type a brand of its own.
export function funcIsBrand(tt TypeTable, t TypeID) returns bool
	return tt.lists[typeList(tt, t: originOf(tt, t: t))][typeIndex(tt, t: originOf(tt, t: t))].isBrand
end 'funcIsBrand'

// funcParamCount is how many parameters a function type takes.
export function funcParamCount(tt TypeTable, t TypeID) returns Count
	return tt.lists[typeList(tt, t: originOf(tt, t: t))][typeIndex(tt, t: originOf(tt, t: t))].paramConvs.count()
end 'funcParamCount'

export function funcParamType(tt TypeTable, t TypeID, index Count) returns TypeID
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[index]
end 'funcParamType'

export function funcParamConv(tt TypeTable, t TypeID, index Count) returns Convention
	return tt.lists[typeList(tt, t: originOf(tt, t: t))][typeIndex(tt, t: originOf(tt, t: t))].paramConvs[index]
end 'funcParamConv'

// funcResult is what a function type returns, void for nothing.
export function funcResult(tt TypeTable, t TypeID) returns TypeID
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[funcParamCount(tt, t: t)]
end 'funcResult'

// funcTypeSpelling is how a message spells a function type, as maxon's do: its brand's name, or its shape.
function funcTypeSpelling(tt TypeTable, t TypeID) returns String
	if funcIsBrand(tt, t: t) 'brand'
		return tt.lists[typeList(tt, t: originOf(tt, t: t))][typeIndex(tt, t: originOf(tt, t: t))].name.clone()
	end 'brand'
	return funcShapeSpelling(tt, t: t)
end 'funcTypeSpelling'

// funcShapeSpelling is the shape of a function type, 'fn(Count, mutates Box) returns Count', which a message names
// where two function types differ by more than their brands.
export function funcShapeSpelling(tt TypeTable, t TypeID) returns String
	var b = ByteArray.create(0)
	b.append("fn(".toByteArray())
	for i in 0 upto funcParamCount(tt, t: t) 'params'
		if i > 0 'sep'
			b.append(", ".toByteArray())
		end 'sep'
		let conv = funcParamConv(tt, t: t, index: i)
		if conv != Convention.convLet 'marked'
			b.append("{conv.keyword()} ".toByteArray())
		end 'marked'
		b.append(typeName(tt, t: funcParamType(tt, t: t, index: i)).toByteArray())
	end 'params'
	b.push(41 as Byte)
	let result = funcResult(tt, t: t)
	if typeKind(tt, t: result) != TypeKind.primVoid 'returns'
		b.append(" returns {typeName(tt, t: result)}".toByteArray())
	end 'returns'
	if funcMutatesCaptures(tt, t: t) 'captures'
		b.append(" mutates captures".toByteArray())
	end 'captures'
	return String.from(b)
end 'funcShapeSpelling'

// mentionsType is whether the type t is target or an instance with target anywhere in its arguments.
export function mentionsType(tt TypeTable, t TypeID, target TypeID) returns bool
	if t == target 'same'
		return true
	end 'same'
	for i in 0 upto tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() 'each'
		if mentionsType(tt, t: tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[i], target: target) 'inside'
			return true
		end 'inside'
	end 'each'
	return false
end 'mentionsType'

// mentionsTypeParam is whether the type is a type parameter or an instance with one anywhere in its arguments.
export function mentionsTypeParam(tt TypeTable, t TypeID) returns bool
	if typeKind(tt, t: t) == TypeKind.typeParam 'param'
		return true
	end 'param'
	for i in 0 upto tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() 'each'
		if mentionsTypeParam(tt, t: tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[i]) 'inside'
			return true
		end 'inside'
	end 'each'
	return false
end 'mentionsTypeParam'

// holdsGrowingInstance is whether the type holds an instance of origin, itself or in its arguments, over an argument that
// is built from type parameters without being one: the instances of origin that a program needs are then never all
// found, since each holds a larger one. An argument that is a type parameter, as in a type that holds itself with its
// parameters swapped, repeats.
export function holdsGrowingInstance(tt TypeTable, t TypeID, origin TypeID) returns bool
	let isInstanceOfOrigin = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() > 0 and tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].effectiveOrigin() == origin
	for i in 0 upto tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() 'each'
		let arg = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[i]
		if isInstanceOfOrigin and typeKind(tt, t: arg) != TypeKind.typeParam and mentionsTypeParam(tt, t: arg) 'grows'
			return true
		end 'grows'
		if holdsGrowingInstance(tt, t: arg, origin: origin) 'inside'
			return true
		end 'inside'
	end 'each'
	return false
end 'holdsGrowingInstance'

export function hasTypeDepthOverflow(tt TypeTable, t TypeID, depth Count) returns bool
	if depth > maxTypeDepth 'over'
		return true
	end 'over'
	let n = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count()
	if n == 0 'leaf'
		return false
	end 'leaf'
	let nextDepth = try depth + 1 otherwise maxTypeDepth
	for i in 0 upto n 'each'
		let child = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[i]
		if hasTypeDepthOverflow(tt, t: child, depth: nextDepth) 'deep'
			return true
		end 'deep'
	end 'each'
	return false
end 'hasTypeDepthOverflow'

export function isIntType(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	let k = typeKind(tt, t: t)
	return k == TypeKind.intRange or k == TypeKind.constInt
end 'isIntType'

// isBitPattern is whether the type is that of a bits(n) typealias, a raw bit pattern.
export function isBitPattern(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].bitsWidth != 0
end 'isBitPattern'

// isWordPattern is whether the type is that of a bits(64) typealias: a pattern as wide as the word that arithmetic
// computes in, so that its operations wrap and every integer converts to it.
export function isWordPattern(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].bitsWidth == 64
end 'isWordPattern'

// isErrorType is whether a function can throw the type: an enum, whose case is the error, or a union, whose value is.
export function isErrorType(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return typeKind(tt, t: t) == TypeKind.enumTy or typeKind(tt, t: t) == TypeKind.unionTy
end 'isErrorType'

// isUnionError is whether the type is an error union: its error is a heap box that the failing function hands to its
// caller, which owns it, and not a case number.
export function isUnionError(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return typeKind(tt, t: t) == TypeKind.unionTy
end 'isUnionError'

export function isUnsignedInt(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	if typeKind(tt, t: t) != TypeKind.intRange 'notRange'
		return false
	end 'notRange'
	return not tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].minVal.isNeg() and not tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].maxVal.fitsI64()
end 'isUnsignedInt'

export function isSharedType(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	let k = typeKind(tt, t: t)
	return k == TypeKind.builtinFrozen or k == TypeKind.builtinCown
end 'isSharedType'

// isFunctionType is whether the type is a function type, whose values are closures that may hold borrows.
export function isFunctionType(tt TypeTable, t TypeID) returns bool
	return t != noType and typeKind(tt, t: t) == TypeKind.funcTy
end 'isFunctionType'

// castRebrands is whether a cast to target changes only the type of its value: a cast to anything but a number converts
// nothing, so its value is the operand's.
export function castRebrands(tt TypeTable, target TypeID) returns bool
	let k = typeKind(tt, t: target)
	return k != TypeKind.intRange and k != TypeKind.floatRange
end 'castRebrands'

// sharesOnCopy is whether a value of the type is never moved: a function value whose closure is immutable, so that every
// place that would take it takes another value that shares the closure. A value of a type that mutates its captures has
// state of its own in its closure, so it has one owner and moves as a record does.
export function sharesOnCopy(tt TypeTable, t TypeID) returns bool
	return isFunctionType(tt, t: t) and not funcMutatesCaptures(tt, t: t)
end 'sharesOnCopy'

// isMutatingFunction is whether the type is a function type whose values mutate their captures.
export function isMutatingFunction(tt TypeTable, t TypeID) returns bool
	return isFunctionType(tt, t: t) and funcMutatesCaptures(tt, t: t)
end 'isMutatingFunction'

export function isManagedType(tt TypeTable, t TypeID) returns bool
	if t == noType 'no'
		return false
	end 'no'
	return match typeKind(tt, t: t) 'k'
		primString gives true
		record gives true
		unionTy gives true
		builtinArray gives true
		builtinMap gives true
		builtinList gives true
		builtinPool gives true
		builtinFrozen gives true
		builtinCown gives true
		typeParam gives true
		funcTy gives true
		invalid gives false
		primBool gives false
		primVoid gives false
		primNever gives false
		intRange gives false
		constInt gives false
		floatRange gives false
		constFloat gives false
		enumTy gives false
		builtinHandle gives false
		interfaceTy gives true
	end 'k'
end 'isManagedType'

export function contentType(tt TypeTable, t TypeID) returns TypeID
	var cur = t
	while cur != noType and typeKind(tt, t: cur) == TypeKind.builtinFrozen 'unwrap'
		if tt.lists[typeList(tt, t: cur)][typeIndex(tt, t: cur)].typeArgs.count() > 0 'arg'
			cur = tt.lists[typeList(tt, t: cur)][typeIndex(tt, t: cur)].typeArgs[0]
		end 'arg' else if tt.lists[typeList(tt, t: cur)][typeIndex(tt, t: cur)].typeParams.count() > 0 'tp'
			cur = tt.lists[typeList(tt, t: cur)][typeIndex(tt, t: cur)].typeParams[0]
		end 'tp' else 'stop'
			break 'unwrap'
		end 'stop'
	end 'unwrap'
	return cur
end 'contentType'

export function instanceSpelling(base String, args Array with String) returns String
	if args.count() == 1 'one'
		var hasWith = false
		let s = args[0].clone()
		let sn = s.byteLength()
		if sn >= 6 'chk'
			for i in 0 upto (sn - 5) 'scan'
				if s.sliceBytes(i, endPos: try i + 6 otherwise i) == " with " 'hit'
					hasWith = true
					break 'scan'
				end 'hit'
			end 'scan'
		end 'chk'
		if not hasWith 'plain'
			return "{base} with {s}"
		end 'plain'
	end 'one'
	var b = ByteArray.create(0)
	b.append("{base} with (".toByteArray())
	for i in 0 upto args.count() 'each'
		if i > 0 'sep'
			b.append(", ".toByteArray())
		end 'sep'
		b.append(args[i].toByteArray())
	end 'each'
	b.push(41 as Byte)
	return String.from(b)
end 'instanceSpelling'

// intSpelling is how an integer type's range is written.
function intSpelling(tt TypeTable, t TypeID) returns String
	return "int({tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].minVal.toString()} to {tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].maxVal.toString()})"
end 'intSpelling'

export function typeName(tt TypeTable, t TypeID) returns String
	if t == noType 'none'
		return "<invalid>"
	end 'none'
	let k = typeKind(tt, t: t)
	if k == TypeKind.funcTy 'function'
		return funcTypeSpelling(tt, t: t)
	end 'function'
	if k == TypeKind.intRange 'rng'
		if tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].name != "" 'named'
			return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].name.clone()
		end 'named'
		return intSpelling(tt, t: t)
	end 'rng'
	if k == TypeKind.floatRange and tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].name == "" 'anonFloat'
		return floatSpelling(tt, t: t)
	end 'anonFloat'
	if isTupleType(tt, t: t) and tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() > 0 'tuple'
		var parts = ByteArray.create(0)
		parts.push(40 as Byte)
		for i in 0 upto tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() 'each'
			if i > 0 'sep'
				parts.append(", ".toByteArray())
			end 'sep'
			parts.append(typeName(tt, t: tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[i]).toByteArray())
		end 'each'
		parts.push(41 as Byte)
		return String.from(parts)
	end 'tuple'
	if statesCount(tt, t: t) 'counted'
		return countedSpelling(tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].name, count: "{statedCount(tt, t: t)}", element: typeName(tt, t: tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[0]))
	end 'counted'
	if tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() > 0 'inst'
		var argNames = StringList.create(0)
		for i in 0 upto tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs.count() 'each'
			argNames.push(typeName(tt, t: tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[i]))
		end 'each'
		return instanceSpelling(tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].name, args: argNames)
	end 'inst'
	return tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].name.clone()
end 'typeName'

export type FuncTable
	// slots are the entries of the functions by slot: the built-ins' in sharedSlot, and each module's functions, methods,
	// signatures, closures and behaviours and the instances its stages ask for in its own.
	export var slots as FuncEntryLists
	// instCaches are, by slot, the instances of generic functions that the stages of the slot's module made, by their key.
	var instCaches as FuncInternMaps
	// writer is the slot that the running task may make functions in (see beginModuleTask).
	var writer as Count

	export static function new() returns FuncTable
		var es = FuncEntryList.create(0)
		es.push(FuncEntry.make("<invalid>", visibility: "", module: 0 as diag.ModuleID, nodeID: 0 as NodeID))
		var slots = FuncEntryLists.create(0)
		slots.push(es)
		var caches = FuncInternMaps.create(0)
		caches.push(FuncInternMap.new())
		return FuncTable{slots: slots, instCaches: caches, writer: unscheduled}
	end 'new'

	// lent is the table a project holds while a task holds its own.
	export static function lent() returns FuncTable
		return FuncTable{slots: FuncEntryLists.create(0), instCaches: FuncInternMaps.create(0), writer: unscheduled}
	end 'lent'
end 'FuncTable'

// funcSlot is the slot that holds the entry of the function f.
export function funcSlot(f FuncID) returns Count
	return handleSlot(f as Count)
end 'funcSlot'

// funcIndex is the position of the function f in the entries of its slot.
export function funcIndex(f FuncID) returns Count
	return (f as Count) and handleIndexMask
end 'funcIndex'

// allocFunc makes a function that module declares, or that its bodies make: a closure or a behaviour.
export function allocFunc(mutates ft FuncTable, module diag.ModuleID, consumes f FuncEntry) returns FuncID
	return allocFuncIn(ft, slot: moduleSlot(module), f: f)
end 'allocFunc'

function allocFuncIn(mutates ft FuncTable, slot Count, consumes f FuncEntry) returns FuncID
	requireWriter(ft.writer, slot: slot)
	let id = try handleWord(slot, index: ft.slots[slot].count()) as FuncID otherwise panic("a function handle past its bits")
	var copyF = f
	copyF.id = id
	ft.slots[slot].push(copyF)
	return id
end 'allocFuncIn'

// typeParamOwnerName is the name of the generic type or function that declares the type parameter param, for a message.
export function typeParamOwnerName(tt TypeTable, ft FuncTable, param TypeID) returns String
	for l in 0 upto tt.lists.count() 'typeLists'
		for i in 0 upto tt.lists[l].count() 'types'
			if tt.lists[l][i].origin == noType and tt.lists[l][i].typeParams.contains(param) 'type'
				return tt.lists[l][i].name.clone()
			end 'type'
		end 'types'
	end 'typeLists'
	for s in 0 upto ft.slots.count() 'funcSlots'
		for i in 0 upto ft.slots[s].count() 'funcs'
			if ft.slots[s][i].generics.contains(param) 'func'
				return ft.slots[s][i].name.clone()
			end 'func'
		end 'funcs'
	end 'funcSlots'
	panic("the type parameter '{typeName(tt, t: param)}' is declared by no type or function")
end 'typeParamOwnerName'

// instantiateFunc is the instance of the generic function origin at the type arguments args, given the conformances
// witnesses for its bounds: one instance for each in the slot of the module whose stage asks for it, since no two
// modules compare their instances and the link keeps one definition of each link name.
export function instantiateFunc(mutates ft FuncTable, mutates tt TypeTable, origin FuncID, args TypeIDList, witnesses WitnessList) returns FuncID
	if args.count() == 0 'none'
		return origin
	end 'none'
	let key = funcInstanceKey(origin, args: args, witnesses: witnesses)
	let own = ownSlot(ft.writer)
	match ft.instCaches[own].get(key) 'hit'
		some(id) then return id
		none then _ = 0
	end 'hit'
	let origName = ft.slots[funcSlot(origin)][funcIndex(origin)].name.clone()
	let origVis = ft.slots[funcSlot(origin)][funcIndex(origin)].visibility.clone()
	let origMod = ft.slots[funcSlot(origin)][funcIndex(origin)].module
	let origNode = ft.slots[funcSlot(origin)][funcIndex(origin)].nodeID
	var inst = FuncEntry.make(origName, visibility: origVis, module: origMod, nodeID: origNode)
	inst.hasDecl = ft.slots[funcSlot(origin)][funcIndex(origin)].hasDecl
	inst.decl = ft.slots[funcSlot(origin)][funcIndex(origin)].decl.clone()
	inst.isStatic = ft.slots[funcSlot(origin)][funcIndex(origin)].isStatic
	inst.isDestructor = ft.slots[funcSlot(origin)][funcIndex(origin)].isDestructor
	inst.hasReceiver = ft.slots[funcSlot(origin)][funcIndex(origin)].hasReceiver
	inst.selfConv = ft.slots[funcSlot(origin)][funcIndex(origin)].selfConv
	inst.intrinsic = ft.slots[funcSlot(origin)][funcIndex(origin)].intrinsic
	inst.errTy = ft.slots[funcSlot(origin)][funcIndex(origin)].errTy
	inst.result = ft.slots[funcSlot(origin)][funcIndex(origin)].result
	inst.genericOrigin = origin
	inst.extendedIface = ft.slots[funcSlot(origin)][funcIndex(origin)].extendedIface
	inst.typeArgs = cloneTypeArgs(args)
	inst.witnesses = witnesses.clone()
	let origParams = cloneTypeArgs(ft.slots[funcSlot(origin)][funcIndex(origin)].generics)
	if ft.slots[funcSlot(origin)][funcIndex(origin)].ownerTy != noType 'own'
		inst.ownerTy = substituteType(tt, t: ft.slots[funcSlot(origin)][funcIndex(origin)].ownerTy, params: origParams, args: args)
	end 'own'
	inst.retTy = substituteType(tt, t: ft.slots[funcSlot(origin)][funcIndex(origin)].retTy, params: origParams, args: args)
	for i in 0 upto ft.slots[funcSlot(origin)][funcIndex(origin)].params.count() 'eachP'
		let pTy = substituteType(tt, t: ft.slots[funcSlot(origin)][funcIndex(origin)].params[i].ty, params: origParams, args: args)
		var spec = ft.slots[funcSlot(origin)][funcIndex(origin)].params[i].clone()
		spec.ty = pTy
		inst.params.push(spec)
		inst.paramTypes.push(pTy)
	end 'eachP'
	let id = allocFuncIn(ft, slot: own, f: inst)
	ft.instCaches[own].insert(key, value: id)
	return id
end 'instantiateFunc'

// memberType is the type of a field or a payload that its declaration gives as declared, in the instance owner.
export function memberType(mutates tt TypeTable, owner TypeID, declared TypeID) returns TypeID
	let at = typePlace(tt, t: owner)
	let origin = originOf(tt, t: owner)
	if owner == origin or tt.lists[placeList(at)][placeIndex(at)].typeArgs.count() == 0 'declared'
		return declared
	end 'declared'
	let params = cloneTypeArgs(tt.lists[typeList(tt, t: origin)][typeIndex(tt, t: origin)].typeParams)
	let args = cloneTypeArgs(tt.lists[placeList(at)][placeIndex(at)].typeArgs)
	return substituteType(tt, t: declared, params: params, args: args)
end 'memberType'

// fieldType is the type of the field at index of the record owner, an instance's with its arguments applied.
export function fieldType(mutates tt TypeTable, owner TypeID, index Count) returns TypeID
	let declared = tt.lists[typeList(tt, t: originOf(tt, t: owner))][typeIndex(tt, t: originOf(tt, t: owner))].fields[index].ty
	return memberType(tt, owner: owner, declared: declared)
end 'fieldType'

// payloadType is the type of the payload at index of a case of the union owner, an instance's with its arguments applied.
export function payloadType(mutates tt TypeTable, owner TypeID, caseIndex Count, index Count) returns TypeID
	let declared = tt.lists[typeList(tt, t: originOf(tt, t: owner))][typeIndex(tt, t: originOf(tt, t: owner))].cases[caseIndex].payload[index].ty
	return memberType(tt, owner: owner, declared: declared)
end 'payloadType'

// packsBytes is whether t is an array whose box holds each element in one byte: an array of an integer type whose range
// fits in a Byte, as Array with Byte (ByteArray) is. Every other array holds a word to an element. Every operation on an
// array asks this, so the two boxes are never mistaken for each other.
export function packsBytes(tt TypeTable, b Builtins, t TypeID) returns bool
	if typeKind(tt, t: t) != TypeKind.builtinArray 'notArray'
		return false
	end 'notArray'
	let elem = tt.lists[typeList(tt, t: t)][typeIndex(tt, t: t)].typeArgs[0]
	if typeKind(tt, t: elem) != TypeKind.intRange 'notInt'
		return false
	end 'notInt'
	let byteTy = b.byteTy
	return tt.lists[typeList(tt, t: elem)][typeIndex(tt, t: elem)].minVal.ge(tt.lists[typeList(tt, t: byteTy)][typeIndex(tt, t: byteTy)].minVal) and tt.lists[typeList(tt, t: elem)][typeIndex(tt, t: elem)].maxVal.le(tt.lists[typeList(tt, t: byteTy)][typeIndex(tt, t: byteTy)].maxVal)
end 'packsBytes'

// leadingParams is how many words a call of the function passes before its parameters: the receiver of a method, or the
// closure that a closure's body reads its captures from.
export function leadingParams(f FuncEntry) returns Count
	if f.hasReceiver or f.isClosure 'leading'
		return 1
	end 'leading'
	return 0
end 'leadingParams'

// isByAddress is whether a parameter of the convention is passed as the address of the caller's place.
export function isByAddress(conv Convention) returns bool
	return conv == Convention.convMutates or conv == Convention.convSets
end 'isByAddress'

// ownsValue is whether the callee owns what it is given: the caller's value moves in.
export function ownsValue(conv Convention) returns bool
	return conv == Convention.convConsumes or conv == Convention.convDestructs
end 'ownsValue'

// callReceiver is the object a call of a method names before its dot, or 0 for a call that has none.
export function callReceiver(tree Tree, e NodeID, kind CallKind) returns NodeID
	if kind == CallKind.callMethod or kind == CallKind.callBound or kind == CallKind.callCopy 'member'
		let callee = callExprCallee(tree, id: e)
		if tree.kindOf(callee) == NodeKind.memberExpr 'named'
			return memberExprObj(tree, id: callee)
		end 'named'
	end 'member'
	return 0 as NodeID
end 'callReceiver'

// isStorage is whether an expression reads a value that already lives somewhere, in a variable, a field or an element,
// and so borrows it, as opposed to making a new value. typing is the module's, as far as the check has typed it.
export function isStorage(tree Tree, typing Typing, node NodeID) returns bool
	let e = through(tree, e: node)
	let k = tree.kindOf(e)
	if k == NodeKind.nameExpr 'name'
		let kind = match typing.names.get(e as Count) 'hit'
			some(info) gives info.kind
			none panic("ast: the name at node {e} was not recorded by the check")
		end 'hit'
		return kind == NameKind.nameLocal or kind == NameKind.nameSelfField
	end 'name'
	if k == NodeKind.selfExpr or k == NodeKind.indexExpr 'place'
		return true
	end 'place'
	if k == NodeKind.memberExpr 'member'
		return match typing.members.get(e as Count) 'hit'
			some(info) gives info.kind == MemberKind.memberField
			none panic("ast: the member at node {e} was not recorded by the check")
		end 'hit'
	end 'member'
	if k == NodeKind.callExpr 'call'
		return isProjectionCall(typing, call: e)
	end 'call'
	return false
end 'isStorage'

// isProjectionCall is whether a call gives a place that its callee borrows from the arguments, as a subscript gives an
// element of its collection, rather than a value of its own.
export function isProjectionCall(typing Typing, call NodeID) returns bool
	return match typing.calls.get(call as Count) 'hit'
		some(info) gives info.result == ResultConv.resultBorrowed
		none gives false
	end 'hit'
end 'isProjectionCall'
