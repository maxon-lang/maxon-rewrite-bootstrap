// patternForm is whether a pattern is a case, a range or a literal.
export function patternForm(t Tree, id NodeID) returns PatternKind
	if patternCaseName(t, id: id) != "" 'case'
		return PatternKind.patCase
	end 'case'
	if patternHigh(t, id: id) != 0 'range'
		return PatternKind.patRange
	end 'range'
	return PatternKind.patLiteral
end 'patternForm'

// matchArmForm is what a match arm does when it matches: it runs a statement, gives a value or panics.
export function matchArmForm(t Tree, id NodeID) returns ArmKind
	if matchArmAction(t, id: id) != 0 'then'
		return ArmKind.armThen
	end 'then'
	if matchArmGives(t, id: id) 'gives'
		return ArmKind.armGives
	end 'gives'
	return ArmKind.armPanic
end 'matchArmForm'

// forStmtIsRange is whether a for counts through a range (`for i in a to b`) rather than walking the elements of a
// collection (`for x in xs`).
export function forStmtIsRange(t Tree, id NodeID) returns bool
	return forStmtTo(t, id: id) != 0
end 'forStmtIsRange'

// matchArmThrows is whether an arm throws an error instead of giving a value: 'default throws E' is the statement 'throw E'
// as the whole of an arm.
export function matchArmThrows(t Tree, id NodeID) returns bool
	let action = matchArmAction(t, id: id)
	return action != 0 and t.kindOf(action) == NodeKind.throwStmt
end 'matchArmThrows'
