	b.millisecondsTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "Milliseconds", lo: I128.zero(), hi: I128.u64Max())
	b.orderedWordTy = registerStdBitsAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "OrderedWord", width: 64)
	b.hashDigestTy = registerStdBitsAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "HashDigest", width: 64)
	b.mailboxCapacityTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "MailboxCapacity", lo: I128.fromCount(1 as Count), hi: I128.fromCount(2147483648 as Count))
