		intrRawProcessStartAddress or
		intrRawPreemptHandlerAddress or
		intrRawSignalReturnAddress or
		intrEnumHash or
		intrEnumEquals or
		intrEnumFromRawValue gives MeasureKind.measureNone
		intrArrayCount or
		intrFixedArrayCount gives MeasureKind.measureCount
		intrArrayIsEmpty gives MeasureKind.measureIsEmpty
	end 'op'
end 'intrinsicMeasure'

// provenTwin is the row that does what a built-in row does where the checker proved what the row requires, with no failure
// exit, or none for a row that has no such twin.
export function provenTwin(b Builtins, f FuncID) returns table.Option with FuncID
	if f == b.arrayGetFunc 'arrayGet'
		return table.Option.some(b.arrayGetProvenFunc)
	end 'arrayGet'
	if f == b.arraySetFunc 'arraySet'
		return table.Option.some(b.arraySetProvenFunc)
	end 'arraySet'
	if f == b.arrayRemoveFunc 'arrayRemove'
		return table.Option.some(b.arrayRemoveProvenFunc)
	end 'arrayRemove'
	if f == b.arrayPopFunc 'arrayPop'
		return table.Option.some(b.arrayPopProvenFunc)
	end 'arrayPop'
	if f == b.arrayFirstFunc 'arrayFirst'
		return table.Option.some(b.arrayFirstProvenFunc)
	end 'arrayFirst'
	if f == b.arrayLastFunc 'arrayLast'
		return table.Option.some(b.arrayLastProvenFunc)
	end 'arrayLast'
	if f == b.fixedArrayGetFunc 'fixedArrayGet'
		return table.Option.some(b.fixedArrayGetProvenFunc)
	end 'fixedArrayGet'
	if f == b.fixedArraySetFunc 'fixedArraySet'
		return table.Option.some(b.fixedArraySetProvenFunc)
	end 'fixedArraySet'
	return table.Option.none
end 'provenTwin'

// RawSurface is a door of maxon's raw surface, which only the library tiers may go through (E3185): what it is or reaches,
// and what a program uses instead.
export type RawSurface
	export var what as String
	export var instead as String

	static function make(consumes what String, consumes instead String) returns RawSurface
		return RawSurface{what: what, instead: instead}
	end 'make'
end 'RawSurface'

// rawTypeSurface is the door of the raw surface that naming a type of the table is, or none for a type that is no part of it.
export function rawTypeSurface(b Builtins, origin TypeID) returns table.Option with RawSurface
	if origin == b.managedMemoryOrigin 'rawManagedMemory'
		return table.Option.some(RawSurface.make("the raw buffer type is nameable", instead: "use 'Array'"))
	end 'rawManagedMemory'
	if origin == b.slotArrayOrigin 'rawSlotArray'
		return table.Option.some(RawSurface.make("the slot array of the library's slot tables is nameable", instead: "use 'Array', or a 'SlotMap' to keep elements by key"))
	end 'rawSlotArray'
	if origin == b.managedMemoryCursorOrigin 'rawManagedMemoryCursor'
		return table.Option.some(RawSurface.make("the raw buffer cursor type is nameable", instead: "walk an 'Array' with 'for'"))
	end 'rawManagedMemoryCursor'
	if origin == b.slotArrayCursorOrigin 'rawSlotArrayCursor'
		return table.Option.some(RawSurface.make("the cursor of the library's slot arrays is nameable", instead: "walk an 'Array' with 'for'"))
	end 'rawSlotArrayCursor'
	if origin == b.stringCursorTy 'rawStringCursor'
		return table.Option.some(RawSurface.make("the raw string cursor type is nameable", instead: "walk a 'String' with 'for'"))
	end 'rawStringCursor'
	if origin == b.groupMemoryOrigin 'rawGroupMemory'
		return table.Option.some(RawSurface.make("the raw buffer of a table's groups is nameable", instead: "use 'Map'"))
	end 'rawGroupMemory'
	if origin == b.cownOrigin 'rawCown'
		return table.Option.some(RawSurface.make("the cown type is nameable", instead: "keep shared state in a service and send it messages"))
	end 'rawCown'
	if origin == b.serviceOrigin 'rawService'
		return table.Option.some(RawSurface.make("the handle type of a service is nameable by its built-in name", instead: "write 'T.handle'"))
	end 'rawService'
	if origin == b.cStringTy 'rawCString'
		return table.Option.some(RawSurface.make("the NUL-terminated pointer type is nameable", instead: "use 'String'"))
	end 'rawCString'
	return table.Option.none
end 'rawTypeSurface'

// rawMethodSurface is the door of the raw surface that calling a method of a type of the table is, or none for a type that is no part of it.
export function rawMethodSurface(b Builtins, origin TypeID) returns table.Option with RawSurface
	if origin == b.managedMemoryOrigin 'rawManagedMemory'
		return table.Option.some(RawSurface.make("a raw '__ManagedMemory' buffer is reachable", instead: "use the 'Array' methods"))
	end 'rawManagedMemory'
	if origin == b.slotArrayOrigin 'rawSlotArray'
		return table.Option.some(RawSurface.make("a raw '__SlotArray' is reachable", instead: "use the 'Array' methods"))
	end 'rawSlotArray'
	if origin == b.managedMemoryCursorOrigin 'rawManagedMemoryCursor'
		return table.Option.some(RawSurface.make("a raw '__ManagedMemoryCursor' is reachable", instead: "walk an 'Array' with 'for'"))
	end 'rawManagedMemoryCursor'
	if origin == b.slotArrayCursorOrigin 'rawSlotArrayCursor'
		return table.Option.some(RawSurface.make("a raw '__SlotArrayCursor' is reachable", instead: "walk an 'Array' with 'for'"))
	end 'rawSlotArrayCursor'
	if origin == b.stringCursorTy 'rawStringCursor'
		return table.Option.some(RawSurface.make("a raw '__StringCursor' is reachable", instead: "walk a 'String' with 'for'"))
	end 'rawStringCursor'
	if origin == b.groupMemoryOrigin 'rawGroupMemory'
		return table.Option.some(RawSurface.make("a raw '__GroupMemory' buffer is reachable", instead: "use 'Map'"))
	end 'rawGroupMemory'
	return table.Option.none
end 'rawMethodSurface'

// rawLibraryTypeSurface is the door of the raw surface that naming a type the library declares by the name is, or none for
// a name that is no part of it.
export function rawLibraryTypeSurface(name String) returns table.Option with RawSurface
	if name == "__ManagedFile" 'rawManagedFile'
		return table.Option.some(RawSurface.make("the raw OS file handle type is nameable", instead: "use 'File'"))
	end 'rawManagedFile'
	if name == "__ManagedSocket" 'rawManagedSocket'
		return table.Option.some(RawSurface.make("the raw OS socket type is nameable", instead: "use 'TcpClient' or 'TcpListener'"))
	end 'rawManagedSocket'
	return table.Option.none
end 'rawLibraryTypeSurface'

// rawCallInstead is what a program calls in place of a static function of a record of the table whose calls are raw, or
// none for a function of any other owner.
export function rawCallInstead(b Builtins, owner TypeID, name String) returns table.Option with String
	if owner == b.builtinsTy 'rawBuiltins'
		if name == "sleep" 'sleep'
			return table.Option.some("sleep(milliseconds)")
		end 'sleep'
		if name == "serviceUnderLoad" 'serviceUnderLoad'
			return table.Option.some("underLoad()")
		end 'serviceUnderLoad'
		if name == "serviceStop" 'serviceStop'
			return table.Option.some("self.stop()")
		end 'serviceStop'
		if name == "serviceStopNow" 'serviceStopNow'
			return table.Option.some("self.stopNow()")
		end 'serviceStopNow'
		if name == "serviceViewMark" 'serviceViewMark'
			return table.Option.some("pending.shed(i) or pending.keep(i)")
		end 'serviceViewMark'
		if name == "serviceViewMarked" 'serviceViewMarked'
			return table.Option.some("pending.isShed(i)")
