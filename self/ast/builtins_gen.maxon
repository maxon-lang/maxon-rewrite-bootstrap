// RawSurface is a door of maxon's raw surface, which only the library tiers may go through (E3185): what it is or reaches,
// and what a program uses instead.
export type RawSurface
	export var what as String
	export var instead as String

	static function make(consumes what String, consumes instead String) returns RawSurface
		return RawSurface{what: what, instead: instead}
	end 'make'
end 'RawSurface'

// rawTypeSurface is the door of the raw surface that naming a type of the table is, or none for a type that is no part of it.
export function rawTypeSurface(b Builtins, origin TypeID) returns table.Option with RawSurface
	if origin == b.managedMemoryOrigin 'rawManagedMemory'
		return table.Option.some(RawSurface.make("the raw buffer type is nameable", instead: "use 'Array'"))
	end 'rawManagedMemory'
	if origin == b.managedMemoryCursorOrigin 'rawManagedMemoryCursor'
		return table.Option.some(RawSurface.make("the raw buffer cursor type is nameable", instead: "walk an 'Array' with 'for'"))
	end 'rawManagedMemoryCursor'
	if origin == b.stringCursorTy 'rawStringCursor'
		return table.Option.some(RawSurface.make("the raw string cursor type is nameable", instead: "walk a 'String' with 'for'"))
	end 'rawStringCursor'
	if origin == b.groupMemoryOrigin 'rawGroupMemory'
		return table.Option.some(RawSurface.make("the raw buffer of a table's groups is nameable", instead: "use 'Map'"))
	end 'rawGroupMemory'
	if origin == b.cownOrigin 'rawCown'
		return table.Option.some(RawSurface.make("the cown type is nameable", instead: "keep shared state in a service and send it messages"))
	end 'rawCown'
	if origin == b.serviceOrigin 'rawService'
		return table.Option.some(RawSurface.make("the handle type of a service is nameable by its built-in name", instead: "write 'T.handle'"))
	end 'rawService'
	if origin == b.cStringTy 'rawCString'
		return table.Option.some(RawSurface.make("the NUL-terminated pointer type is nameable", instead: "use 'String'"))
	end 'rawCString'
	return table.Option.none
end 'rawTypeSurface'

// rawMethodSurface is the door of the raw surface that calling a method of a type of the table is, or none for a type that is no part of it.
export function rawMethodSurface(b Builtins, origin TypeID) returns table.Option with RawSurface
	if origin == b.managedMemoryOrigin 'rawManagedMemory'
		return table.Option.some(RawSurface.make("a raw '__ManagedMemory' buffer is reachable", instead: "use the 'Array' methods"))
	end 'rawManagedMemory'
	if origin == b.managedMemoryCursorOrigin 'rawManagedMemoryCursor'
		return table.Option.some(RawSurface.make("a raw '__ManagedMemoryCursor' is reachable", instead: "walk an 'Array' with 'for'"))
	end 'rawManagedMemoryCursor'
	if origin == b.stringCursorTy 'rawStringCursor'
		return table.Option.some(RawSurface.make("a raw '__StringCursor' is reachable", instead: "walk a 'String' with 'for'"))
	end 'rawStringCursor'
	if origin == b.groupMemoryOrigin 'rawGroupMemory'
		return table.Option.some(RawSurface.make("a raw '__GroupMemory' buffer is reachable", instead: "use 'Map'"))
	end 'rawGroupMemory'
	return table.Option.none
end 'rawMethodSurface'

