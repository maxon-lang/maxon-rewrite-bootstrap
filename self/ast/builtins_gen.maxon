		if name == "subprocessWaitExit" 'subprocessWaitExit'
			return table.Option.some("StreamingSubprocess")
		end 'subprocessWaitExit'
		if name == "subprocessPollExit" 'subprocessPollExit'
			return table.Option.some("StreamingSubprocess")
		end 'subprocessPollExit'
		if name == "subprocessExitSignal" 'subprocessExitSignal'
			return table.Option.some("StreamingSubprocess")
		end 'subprocessExitSignal'
		if name == "subprocessLastErrorCode" 'subprocessLastErrorCode'
			return table.Option.some("Subprocess.run or a Configuration's run()")
		end 'subprocessLastErrorCode'
		if name == "subprocessLastErrorMessage" 'subprocessLastErrorMessage'
			return table.Option.some("Subprocess.run or a Configuration's run()")
		end 'subprocessLastErrorMessage'
		if name == "subprocessResolveOnPath" 'subprocessResolveOnPath'
			return table.Option.some("Subprocess.run or a Configuration's run()")
		end 'subprocessResolveOnPath'
		if name == "runWithInput" 'runWithInput'
			return table.Option.some("a Configuration whose standardInput is InputSource.bytes(text)")
		end 'runWithInput'
		if name == "stdoutWantsAnsiColor" 'stdoutWantsAnsiColor'
			return table.Option.some("Console.stdoutWantsColor()")
		end 'stdoutWantsAnsiColor'
		if name == "floatToBits" 'floatToBits'
			return table.Option.some("the float's own operations")
		end 'floatToBits'
		if name == "fillRandom" 'fillRandom'
			return table.Option.some("Random.bytes(count)")
		end 'fillRandom'
		if name == "bitsToFloat" 'bitsToFloat'
			return table.Option.some("the float's own operations")
		end 'bitsToFloat'
		if name == "trailingZeros" 'trailingZeros'
			return table.Option.some("a loop over the word's bits")
		end 'trailingZeros'
		if name == "mmAllocTotal" 'mmAllocTotal'
			return table.Option.some("HeapStats.allocationsMade()")
		end 'mmAllocTotal'
		if name == "mmAllocLive" 'mmAllocLive'
			return table.Option.some("HeapStats.allocationsLive()")
		end 'mmAllocLive'
		if name == "mmAllocBytes" 'mmAllocBytes'
			return table.Option.some("HeapStats.bytesAllocated()")
		end 'mmAllocBytes'
		if name == "mmAllocTotalByTag" 'mmAllocTotalByTag'
			return table.Option.some("HeapStats.allocationsTagged(tag)")
		end 'mmAllocTotalByTag'
		if name == "mmAllocBytesByTag" 'mmAllocBytesByTag'
			return table.Option.some("HeapStats.bytesTagged(tag)")
		end 'mmAllocBytesByTag'
		if name == "threadAllocTotal" 'threadAllocTotal'
			return table.Option.some("HeapStats.threadAllocations()")
		end 'threadAllocTotal'
		if name == "threadFreeTotal" 'threadFreeTotal'
			return table.Option.some("HeapStats.threadFrees()")
		end 'threadFreeTotal'
		if name == "threadAllocBytes" 'threadAllocBytes'
			return table.Option.some("HeapStats.threadBytes()")
		end 'threadAllocBytes'
		if name == "processAllocTotal" 'processAllocTotal'
			return table.Option.some("HeapStats.processAllocations()")
		end 'processAllocTotal'
		if name == "processFreeTotal" 'processFreeTotal'
			return table.Option.some("HeapStats.processFrees()")
		end 'processFreeTotal'
		if name == "processAllocBytes" 'processAllocBytes'
			return table.Option.some("HeapStats.processBytes()")
		end 'processAllocBytes'
		if name == "scavengeMemory" 'scavengeMemory'
			return table.Option.some("HeapStats.scavenge()")
		end 'scavengeMemory'
		if name == "hashSeed" 'hashSeed'
			return table.Option.some("Hasher.create()")
		end 'hashSeed'
		if name == "drawHashSeed" 'drawHashSeed'
			return table.Option.some("HashSeed.random()")
		end 'drawHashSeed'
		if name == "hashWord" 'hashWord'
			return table.Option.some("a Hasher's combine(value)")
		end 'hashWord'
		if name == "hashBytes" 'hashBytes'
			return table.Option.some("a Hasher's combineBytes(bytes)")
		end 'hashBytes'
		if name == "hashBytes" 'hashBytes'
			return table.Option.some("a Hasher's combineBytes(bytes)")
		end 'hashBytes'
		if name == "hashCharacter" 'hashCharacter'
			return table.Option.some("the character's hash()")
		end 'hashCharacter'
		if name == "readBigEndian" 'readBigEndian'
			return table.Option.some("readOrderedWord")
		end 'readBigEndian'
		if name == "readLittleEndian" 'readLittleEndian'
			return table.Option.some("readOrderedWord")
		end 'readLittleEndian'
		if name == "appendBigEndian" 'appendBigEndian'
			return table.Option.some("appendOrderedWord")
		end 'appendBigEndian'
		if name == "appendLittleEndian" 'appendLittleEndian'
			return table.Option.some("appendOrderedWord")
		end 'appendLittleEndian'
		panic("'{name}' is no static function of __Builtins")
	end 'rawBuiltins'
	return table.Option.none
end 'rawCallInstead'

// rawMemberSurface is the door of the raw surface that calling a method of that name of a type of the table is, for a
// method that is one, or none.
export function rawMemberSurface(b Builtins, owner TypeID, name String) returns table.Option with RawSurface
	if owner == b.arrayOrigin and name == "clearSlot" 'arrayClearSlot'
		return table.Option.some(RawSurface.make("an array's slot is emptied in place", instead: "use 'remove(at)'"))
	end 'arrayClearSlot'
	if owner == b.arrayOrigin and name == "fillSlot" 'arrayFillSlot'
		return table.Option.some(RawSurface.make("an array's empty slot is filled in place", instead: "use 'set(i, value: v)'"))
	end 'arrayFillSlot'
	if owner == b.arrayOrigin and name == "takeSlot" 'arrayTakeSlot'
		return table.Option.some(RawSurface.make("an element is taken out of an array's slot, which is left empty", instead: "use 'remove(at)'"))
	end 'arrayTakeSlot'
	if owner == b.arrayOrigin and name == "lendSlot" 'arrayLendSlot'
		return table.Option.some(RawSurface.make("an array's element is lent in place", instead: "use a subscript, 'a[i]'"))
	end 'arrayLendSlot'
	if owner == b.arrayOrigin and name == "hashesAsStorage" 'arrayHashesAsStorage'
		return table.Option.some(RawSurface.make("an array is asked whether it hashes as its storage", instead: "use 'hash()'"))
	end 'arrayHashesAsStorage'
	if owner == b.arrayOrigin and name == "storageHash" 'arrayStorageHash'
		return table.Option.some(RawSurface.make("the storage of an array is hashed", instead: "use 'hash()'"))
	end 'arrayStorageHash'
	if owner == b.slotKeyOrigin and name == "fromWord" 'slotKeyFromWord'
		return table.Option.some(RawSurface.make("a slot key is made of a word", instead: "use the slot key a slot map's 'insert' gives"))
	end 'slotKeyFromWord'
	if owner == b.slotKeyOrigin and name == "word" 'slotKeyWord'
		return table.Option.some(RawSurface.make("a slot key's word is read", instead: "compare slot keys with '=='"))
	end 'slotKeyWord'
	if owner == b.stringTy and name == "addressableBytes" 'stringAddressableBytes'
		return table.Option.some(RawSurface.make("a String's bytes are taken as a raw '__ManagedMemory' buffer", instead: "use 'toByteArray()' or 'bytes()'"))
	end 'stringAddressableBytes'
	if owner == b.stringTy and name == "init" 'stringInit'
		return table.Option.some(RawSurface.make("a String is made of a raw '__ManagedMemory' buffer", instead: "use 'String.from(bytes)'"))
	end 'stringInit'
	if owner == b.stringTy and name == "cstr" 'stringCstr'
		return table.Option.some(RawSurface.make("a String's bytes are taken as a NUL-terminated 'cstring'", instead: "pass the String itself"))
	end 'stringCstr'
	if owner == b.stringTy and name == "fromCString" 'stringFromCString'
		return table.Option.some(RawSurface.make("a String is made of a NUL-terminated 'cstring'", instead: "use 'String.from(bytes)'"))
	end 'stringFromCString'
	if owner == b.serviceOrigin and name == "mostQueued" 'serviceMostQueued'
		return table.Option.some(RawSurface.make("a service's queue length is read", instead: "let the runtime's backpressure bound it"))
	end 'serviceMostQueued'
	return table.Option.none
end 'rawMemberSurface'

// BuiltinView is a member of a built-in generic type that is the same value seen as an instance of another type of the
// table, at the same type arguments, and the door of the raw surface that reading it is.
export type BuiltinView
	export var origin as TypeID
	export var surface as RawSurface

	static function make(origin TypeID, consumes surface RawSurface) returns BuiltinView
		return BuiltinView{origin: origin, surface: surface}
	end 'make'
end 'BuiltinView'

// builtinView is the view of that name of a built-in generic type, or none.
export function builtinView(b Builtins, owner TypeID, name String) returns table.Option with BuiltinView
	if owner == b.arrayOrigin and name == "managed" 'arrayManaged'
		return table.Option.some(BuiltinView.make(b.managedMemoryOrigin, surface: RawSurface.make("a value's raw '__ManagedMemory' buffer is reachable", instead: "use the 'Array' methods")))
	end 'arrayManaged'
	return table.Option.none
end 'builtinView'

function declareStdAliases(mutates tt TypeSlot, reads TypeTable, mutates std ParsedModule, mutates b Builtins, mutates typeMap TypeIDMap)
	b.exitCodeTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "ExitCode", lo: I128.zero(), hi: I128.fromCount(4294967295 as Count))
	b.countTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "Count", lo: I128.zero(), hi: I128.u64Max())
	b.elementIndexTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "ElementIndex", lo: I128.zero(), hi: I128.u64Max())
	b.bytePosTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "BytePos", lo: I128.zero(), hi: I128.u64Max())
	b.fullRangeIntTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "FullRangeInt", lo: I128.i64Min(), hi: I128.i64Max())
	b.reportedCapacityTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "ReportedCapacity", lo: I128.i64Min(), hi: I128.i64Max())
	b.byteTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "Byte", lo: I128.zero(), hi: I128.fromCount(255 as Count))
	b.fullRangeFloatTy = registerStdFloatAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "FullRangeFloat", lo: floatNegate(floatMaxBits), hi: floatMaxBits)
	b.codepointTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "Codepoint", lo: I128.zero(), hi: I128.fromCount(1114111 as Count))
	b.asciiValueTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "AsciiValue", lo: I128.zero(), hi: I128.fromCount(127 as Count))
	b.codepointDeltaTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "CodepointDelta", lo: I128.fromCount(1114111 as Count).neg(), hi: I128.fromCount(1114111 as Count))
	b.networkPortTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "NetworkPort", lo: I128.zero(), hi: I128.fromCount(65535 as Count))
	b.codeUnit16Ty = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "CodeUnit16", lo: I128.zero(), hi: I128.fromCount(65535 as Count))
	b.instantNanosTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "InstantNanos", lo: I128.zero(), hi: I128.u64Max())
	b.instantMsTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "InstantMs", lo: I128.zero(), hi: I128.u64Max())
	b.threadCpuTicksTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "ThreadCpuTicks", lo: I128.zero(), hi: I128.u64Max())
	b.unixSecondsTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "UnixSeconds", lo: I128.i64Min(), hi: I128.i64Max())
	b.unixNanosTy = registerStdAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "UnixNanos", lo: I128.i64Min(), hi: I128.i64Max())
	b.orderedWordTy = registerStdBitsAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "OrderedWord", width: 64)
	b.hashDigestTy = registerStdBitsAlias(tt, reads: reads, std: std, typeMap: typeMap, name: "HashDigest", width: 64)
end 'declareStdAliases'

function declareBuiltinTable(mutates tt TypeSlot, reads TypeTable, mutates ft FuncSlot, funcReads FuncTable, mutates std ParsedModule, mutates b Builtins, mutates typeMap TypeIDMap, mutates funcMap FuncIDMap)
	declareBuiltinTypes(tt, reads: reads, std: std, b: b, typeMap: typeMap)
	declareArrayMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareFixedArrayMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareManagedMemoryMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareManagedMemoryCursorMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareStringCursorMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareGroupMemoryMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareSlotKeyMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareStringMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareByteViewMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareByteIteratorMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareCodepointViewMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareCodepointIteratorMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareUtf16ViewMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareUtf16IteratorMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareCharacterMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareStringIndexMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareBuiltinFunctions(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareCommandLineMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareProcessMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareClockMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareSchedulerMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareServiceMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declarePromiseMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareFilePathMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareFileMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareDirectoryMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareSubprocessMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareCollectedOutputMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareDebuggeeMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareBuiltinsMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
	declareRawMethods(tt, reads: reads, ft: ft, funcReads: funcReads, std: std, b: b, funcMap: funcMap)
end 'declareBuiltinTable'

function declareBuiltinTypes(mutates tt TypeSlot, reads TypeTable, mutates std ParsedModule, mutates b Builtins, mutates typeMap TypeIDMap)
	var names1 = StringList.create(0)
	names1.push("T")
	b.arrayOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinArray, name: "Array", paramNames: names1)
	var names2 = StringList.create(0)
	names2.push("T")
	b.fixedArrayOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinArray, name: "FixedArray", paramNames: names2)
	var names3 = StringList.create(0)
	names3.push("T")
	b.managedMemoryOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinArray, name: "__ManagedMemory", paramNames: names3)
	var names4 = StringList.create(0)
	names4.push("T")
	b.managedMemoryCursorOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinCursor, name: "__ManagedMemoryCursor", paramNames: names4)
	b.stringCursorTy = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinCursor, name: "__StringCursor", paramNames: StringList.create(0))
	var names5 = StringList.create(0)
	names5.push("A")
	names5.push("B")
	b.groupMemoryOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinGroups, name: "__GroupMemory", paramNames: names5)
	var names6 = StringList.create(0)
	names6.push("T")
	b.slotKeyOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinSlotKey, name: "SlotKey", paramNames: names6)
	var names7 = StringList.create(0)
	names7.push("T")
	b.frozenOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinFrozen, name: "frozen", paramNames: names7)
	var names8 = StringList.create(0)
	names8.push("T")
	b.cownOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinCown, name: "cown", paramNames: names8)
	var names9 = StringList.create(0)
	names9.push("T")
	names9.push("E")
	b.promiseOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinPromise, name: "Promise", paramNames: names9)
	var names10 = StringList.create(0)
	names10.push("T")
	b.serviceOrigin = registerPrimType(tt, reads: reads, std: std, typeMap: typeMap, kind: TypeKind.builtinService, name: "__ServiceHandle", paramNames: names10)
	b.commandLineTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "CommandLine")
	b.processTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "Process")
	b.clockTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "Clock")
	b.schedulerTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "Scheduler")
	b.filePathTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "FilePath")
	b.fileTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "File")
	b.directoryTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "Directory")
	b.stringIndexTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "StringIndex")
	b.byteViewTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "ByteView")
	b.byteIteratorTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "ByteIterator")
	b.codepointViewTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "CodepointView")
	b.codepointIteratorTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "CodepointIterator")
	b.utf16ViewTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "UTF16View")
	b.utf16IteratorTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "UTF16Iterator")
	b.collectedOutputTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "CollectedOutput")
	b.fileInfoTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "FileInfo")
	b.subprocessTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "Subprocess")
	b.debuggeeTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "Debuggee")
	b.rawTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "__Raw")
	b.builtinsTy = registerRecordType(tt, reads: reads, std: std, typeMap: typeMap, name: "__Builtins")
	addRecordField(tt, reads: reads, owner: b.filePathTy, name: "path", ty: b.stringTy, isVar: false, exported: true)
	addRecordField(tt, reads: reads, owner: b.stringIndexTy, name: "charIdx", ty: b.countTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.stringIndexTy, name: "bytePosition", ty: b.countTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.byteViewTy, name: "text", ty: b.stringTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.byteIteratorTy, name: "text", ty: b.stringTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.byteIteratorTy, name: "position", ty: b.countTy, isVar: true, exported: false)
	addRecordField(tt, reads: reads, owner: b.codepointViewTy, name: "text", ty: b.stringTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.codepointIteratorTy, name: "text", ty: b.stringTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.codepointIteratorTy, name: "position", ty: b.countTy, isVar: true, exported: false)
	addRecordField(tt, reads: reads, owner: b.utf16ViewTy, name: "text", ty: b.stringTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.utf16IteratorTy, name: "text", ty: b.stringTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.utf16IteratorTy, name: "position", ty: b.countTy, isVar: true, exported: false)
	addRecordField(tt, reads: reads, owner: b.collectedOutputTy, name: "stdout", ty: b.stringTy, isVar: true, exported: true)
	addRecordField(tt, reads: reads, owner: b.collectedOutputTy, name: "stderr", ty: b.stringTy, isVar: true, exported: true)
	addRecordField(tt, reads: reads, owner: b.collectedOutputTy, name: "code", ty: b.exitCodeTy, isVar: false, exported: false)
	addRecordField(tt, reads: reads, owner: b.fileInfoTy, name: "size", ty: b.countTy, isVar: false, exported: true)
	addRecordField(tt, reads: reads, owner: b.fileInfoTy, name: "modifiedTime", ty: b.countTy, isVar: false, exported: true)
	addRecordField(tt, reads: reads, owner: b.fileInfoTy, name: "createdTime", ty: b.countTy, isVar: false, exported: true)
	addRecordField(tt, reads: reads, owner: b.fileInfoTy, name: "accessedTime", ty: b.countTy, isVar: false, exported: true)
	addRecordField(tt, reads: reads, owner: b.fileInfoTy, name: "isDirectory", ty: b.boolTy, isVar: false, exported: true)
	addRecordField(tt, reads: reads, owner: b.fileInfoTy, name: "isReadOnly", ty: b.boolTy, isVar: false, exported: true)
	b.executableTy = registerUnionType(tt, reads: reads, std: std, typeMap: typeMap, name: "Executable", paramNames: StringList.create(0))
	var payload11 = CaseFieldList.create(0)
	payload11.push(CaseFieldInfo.make("value", ty: b.stringTy))
	addUnionCase(tt, reads: reads, owner: b.executableTy, name: "name", payload: payload11)
	var payload12 = CaseFieldList.create(0)
	payload12.push(CaseFieldInfo.make("value", ty: b.filePathTy))
