	end 'make'
end 'RawSurface'

// rawTypeSurface is the door of the raw surface that naming a type of the table is, or none for a type that is no part of it.
export function rawTypeSurface(b Builtins, origin TypeID) returns table.Option with RawSurface
	if origin == b.managedMemoryOrigin 'rawManagedMemory'
		return table.Option.some(RawSurface.make("the raw buffer type is nameable", instead: "use 'Array'"))
	end 'rawManagedMemory'
	if origin == b.managedMemoryCursorOrigin 'rawManagedMemoryCursor'
		return table.Option.some(RawSurface.make("the raw buffer cursor type is nameable", instead: "walk an 'Array' with 'for'"))
	end 'rawManagedMemoryCursor'
	if origin == b.groupMemoryOrigin 'rawGroupMemory'
		return table.Option.some(RawSurface.make("the raw buffer of a table's groups is nameable", instead: "use 'Map'"))
	end 'rawGroupMemory'
	if origin == b.serviceOrigin 'rawService'
		return table.Option.some(RawSurface.make("the handle type of a service is nameable by its built-in name", instead: "write 'T.handle'"))
	end 'rawService'
	return table.Option.none
end 'rawTypeSurface'

// rawMethodSurface is the door of the raw surface that calling a method of a type of the table is, or none for a type that is no part of it.
export function rawMethodSurface(b Builtins, origin TypeID) returns table.Option with RawSurface
	if origin == b.managedMemoryOrigin 'rawManagedMemory'
		return table.Option.some(RawSurface.make("a raw '__ManagedMemory' buffer is reachable", instead: "use the 'Array' methods"))
	end 'rawManagedMemory'
	if origin == b.managedMemoryCursorOrigin 'rawManagedMemoryCursor'
		return table.Option.some(RawSurface.make("a raw '__ManagedMemoryCursor' is reachable", instead: "walk an 'Array' with 'for'"))
	end 'rawManagedMemoryCursor'
	if origin == b.groupMemoryOrigin 'rawGroupMemory'
		return table.Option.some(RawSurface.make("a raw '__GroupMemory' buffer is reachable", instead: "use 'Map'"))
	end 'rawGroupMemory'
	return table.Option.none
end 'rawMethodSurface'

// rawCallInstead is what a program calls in place of a static function of a record of the table whose calls are raw, or
// none for a function of any other owner.
export function rawCallInstead(b Builtins, owner TypeID, name String) returns table.Option with String
	if owner == b.builtinsTy 'rawBuiltins'
		if name == "currentProcessId" 'currentProcessId'
			return table.Option.some("Process.id()")
		end 'currentProcessId'
		if name == "currentTimeNanos" 'currentTimeNanos'
			return table.Option.some("Clock.nowNanos()")
		end 'currentTimeNanos'
		if name == "floatToBits" 'floatToBits'
			return table.Option.some("the float's own operations")
		end 'floatToBits'
		if name == "trailingZeros" 'trailingZeros'
			return table.Option.some("a loop over the word's bits")
		end 'trailingZeros'
		if name == "hashSeed" 'hashSeed'
			return table.Option.some("Hasher.create()")
		end 'hashSeed'
		if name == "drawHashSeed" 'drawHashSeed'
			return table.Option.some("HashSeed.random()")
		end 'drawHashSeed'
		if name == "hashWord" 'hashWord'
			return table.Option.some("a Hasher's combine(value)")
		end 'hashWord'
		if name == "hashBytes" 'hashBytes'
			return table.Option.some("a Hasher's combineBytes(bytes)")
		end 'hashBytes'
		if name == "hashBytes" 'hashBytes'
			return table.Option.some("a Hasher's combineBytes(bytes)")
		end 'hashBytes'
		if name == "readBigEndian" 'readBigEndian'
			return table.Option.some("readOrderedWord")
		end 'readBigEndian'
		if name == "readLittleEndian" 'readLittleEndian'
			return table.Option.some("readOrderedWord")
		end 'readLittleEndian'
		if name == "appendBigEndian" 'appendBigEndian'
			return table.Option.some("appendOrderedWord")
		end 'appendBigEndian'
		if name == "appendLittleEndian" 'appendLittleEndian'
			return table.Option.some("appendOrderedWord")
		end 'appendLittleEndian'
		panic("'{name}' is no static function of __Builtins")
	end 'rawBuiltins'
	return table.Option.none
end 'rawCallInstead'

// rawMemberSurface is the door of the raw surface that calling a method of that name of a type of the table is, for a
// method that is one, or none.
export function rawMemberSurface(b Builtins, owner TypeID, name String) returns table.Option with RawSurface
	if owner == b.arrayOrigin and name == "clearSlot" 'arrayClearSlot'
		return table.Option.some(RawSurface.make("an array's slot is emptied in place", instead: "use 'remove(at)'"))
	end 'arrayClearSlot'
	return table.Option.none
end 'rawMemberSurface'

// BuiltinView is a member of a built-in generic type that is the same value seen as an instance of another type of the
// table, at the same type arguments, and the door of the raw surface that reading it is.
export type BuiltinView
	export var origin as TypeID
	export var surface as RawSurface

	static function make(origin TypeID, consumes surface RawSurface) returns BuiltinView
		return BuiltinView{origin: origin, surface: surface}
	end 'make'
end 'BuiltinView'

// builtinView is the view of that name of a built-in generic type, or none.
export function builtinView(b Builtins, owner TypeID, name String) returns table.Option with BuiltinView
	if owner == b.arrayOrigin and name == "managed" 'arrayManaged'
		return table.Option.some(BuiltinView.make(b.managedMemoryOrigin, surface: RawSurface.make("a value's raw '__ManagedMemory' buffer is reachable", instead: "use the 'Array' methods")))
	end 'arrayManaged'
	return table.Option.none
end 'builtinView'

function declareStdAliases(mutates tt TypeSlot, reads TypeTable, mutates std ParsedModule, mutates b Builtins, mutates typeMap TypeIDMap)
