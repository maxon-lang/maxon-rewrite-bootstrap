export typealias DeclOrdinal = int(0 to 4294967295)

export enum DeclKind
	funcDecl
	constDecl
	typeDecl
	enumDecl
	unionDecl
	aliasDecl
	interfaceDecl
	extensionDecl
end 'DeclKind'

export type DeclRef
	export var module as diag.ModuleID
	export var ordinal as DeclOrdinal

	export static function make(module diag.ModuleID, ordinal DeclOrdinal) returns DeclRef
		return DeclRef{module: module, ordinal: ordinal}
	end 'make'
end 'DeclRef'

// methodNamesOf are the names of the methods and the static lets that an extension declares and another module may call: a
// member with no visibility is the declaring module's own, which no other module names, so it reaches nothing.
function methodNamesOf(xd ExtensionDecl) returns StringList
	var names = StringList.create(0)
	for method in xd.methods 'methods'
		if visibilityOf(method.visibility) != Visibility.unexported 'seen'
			names.push(method.name.clone())
		end 'seen'
	end 'methods'
	for member in xd.statics 'statics'
		if visibilityOf(member.visibility) != Visibility.unexported 'seen'
			names.push(member.name.clone())
		end 'seen'
	end 'statics'
	return names
end 'methodNamesOf'

// typeMethodNamesOf are the names of the methods that a type declares and another module may call.
function typeMethodNamesOf(td TypeDecl) returns StringList
	var names = StringList.create(0)
	for method in td.methods 'methods'
		if visibilityOf(method.visibility) != Visibility.unexported 'seen'
			names.push(method.name.clone())
		end 'seen'
	end 'methods'
	return names
end 'typeMethodNamesOf'

export union Decl
	funcDecl(value FuncDecl)
	constDecl(value ConstDecl)
	typeDecl(value TypeDecl)
	enumDecl(value EnumDecl)
	unionDecl(value UnionDecl)
	aliasDecl(value AliasDecl)
	interfaceDecl(value InterfaceDecl)
	extensionDecl(value ExtensionDecl)

	export function name() returns String
		return match self 'd'
			funcDecl(v) gives v.name.clone()
			constDecl(v) gives v.name.clone()
			typeDecl(v) gives v.name.clone()
			enumDecl(v) gives v.name.clone()
			unionDecl(v) gives v.name.clone()
			aliasDecl(v) gives v.name.clone()
			interfaceDecl(v) gives v.name.clone()
			extensionDecl(_) gives extensionName.clone()
		end 'd'
	end 'name'

	export function visibility() returns String
		return match self 'd'
			funcDecl(v) gives v.visibility.clone()
			constDecl(v) gives v.visibility.clone()
			typeDecl(v) gives v.visibility.clone()
			enumDecl(v) gives v.visibility.clone()
			unionDecl(v) gives v.visibility.clone()
			aliasDecl(v) gives v.visibility.clone()
			interfaceDecl(v) gives v.visibility.clone()
			extensionDecl(v) gives v.visibility.clone()
		end 'd'
	end 'visibility'

	// keyword is the word that opens the declaration, as a diagnostic names its kind.
	export function keyword() returns String
		return match self 'd'
			funcDecl(_) gives "function"
			constDecl(_) gives "let"
			typeDecl(_) gives "type"
			enumDecl(_) gives "enum"
			unionDecl(_) gives "union"
			aliasDecl(_) gives "typealias"
			interfaceDecl(_) gives "interface"
			extensionDecl(_) gives "extension"
		end 'd'
	end 'keyword'

	// testName is the prose name of a test, and empty for any other declaration.
	export function testName() returns String
		return match self 'd'
			funcDecl(f) gives f.testName.clone()
			constDecl(_) gives ""
			typeDecl(_) gives ""
			enumDecl(_) gives ""
			unionDecl(_) gives ""
			aliasDecl(_) gives ""
			interfaceDecl(_) gives ""
			extensionDecl(_) gives ""
		end 'd'
	end 'testName'

	export function nodeID() returns NodeID
		return match self 'd'
			funcDecl(v) gives v.id
			constDecl(v) gives v.id
			typeDecl(v) gives v.id
			enumDecl(v) gives v.id
			unionDecl(v) gives v.id
			aliasDecl(v) gives v.id
			interfaceDecl(v) gives v.id
			extensionDecl(v) gives v.id
		end 'd'
	end 'nodeID'

	// memberNames are the names of the methods that the declaration adds to a type: an extension's, or a type's own.
	export function memberNames() returns StringList
		return match self 'd'
			extensionDecl(v) gives methodNamesOf(v)
			typeDecl(v) gives typeMethodNamesOf(v)
			funcDecl(_) gives StringList.create(0)
			constDecl(_) gives StringList.create(0)
			enumDecl(_) gives StringList.create(0)
			unionDecl(_) gives StringList.create(0)
			aliasDecl(_) gives StringList.create(0)
			interfaceDecl(_) gives StringList.create(0)
		end 'd'
	end 'memberNames'

	// staticLets are the static lets that the body of a type, an enum or a union declares, or that an extension adds.
	export function staticLets() returns ConstDeclList
		return match self 'd'
			typeDecl(v) gives v.statics.clone()
			enumDecl(v) gives v.statics.clone()
			unionDecl(v) gives v.statics.clone()
			extensionDecl(v) gives v.statics.clone()
			funcDecl(_) gives ConstDeclList.create(0)
			constDecl(_) gives ConstDeclList.create(0)
			aliasDecl(_) gives ConstDeclList.create(0)
			interfaceDecl(_) gives ConstDeclList.create(0)
		end 'd'
	end 'staticLets'

	export function level() returns Visibility
		return visibilityOf(self.visibility())
	end 'level'

	// constValue is the expression a constant is declared with, which only a constant has.
	export function constValue() returns NodeID
		return match self 'd'
			constDecl(cd) gives cd.value
			funcDecl(_) panic("ast: a function has no constant value")
			typeDecl(_) panic("ast: a type has no constant value")
			enumDecl(_) panic("ast: an enum has no constant value")
			unionDecl(_) panic("ast: a union has no constant value")
			aliasDecl(_) panic("ast: a typealias has no constant value")
			interfaceDecl(_) panic("ast: an interface has no constant value")
			extensionDecl(_) panic("ast: an extension has no constant value")
		end 'd'
	end 'constValue'

	export function isExported() returns bool
		return self.level() != Visibility.unexported
	end 'isExported'

	export function isType() returns bool
		return match self 'd'
			funcDecl(_) gives false
			constDecl(_) gives false
			typeDecl(_) gives true
			enumDecl(_) gives true
			unionDecl(_) gives true
			aliasDecl(_) gives true
			interfaceDecl(_) gives true
			extensionDecl(_) gives false
		end 'd'
	end 'isType'

	export function isConst() returns bool
		return match self 'd'
			constDecl(_) gives true
			funcDecl(_) gives false
			typeDecl(_) gives false
			enumDecl(_) gives false
			unionDecl(_) gives false
			aliasDecl(_) gives false
			interfaceDecl(_) gives false
			extensionDecl(_) gives false
		end 'd'
	end 'isConst'

	export function kind() returns DeclKind
		return match self 'd'
			funcDecl(_) gives DeclKind.funcDecl
			constDecl(_) gives DeclKind.constDecl
			typeDecl(_) gives DeclKind.typeDecl
			enumDecl(_) gives DeclKind.enumDecl
			unionDecl(_) gives DeclKind.unionDecl
			aliasDecl(_) gives DeclKind.aliasDecl
			interfaceDecl(_) gives DeclKind.interfaceDecl
			extensionDecl(_) gives DeclKind.extensionDecl
		end 'd'
	end 'kind'

	export function isExtension() returns bool
		return match self 'd'
			extensionDecl(_) gives true
			funcDecl(_) gives false
			constDecl(_) gives false
			typeDecl(_) gives false
			enumDecl(_) gives false
			unionDecl(_) gives false
			aliasDecl(_) gives false
			interfaceDecl(_) gives false
		end 'd'
	end 'isExtension'

	export function offset(t Tree) returns diag.U32
		return t.reportStartOf(self.nodeID())
	end 'offset'
end 'Decl'

// extensionName is what an extension is called where a declaration has a name: an extension declares none, so no module's
// names hold it.
export let extensionName = "extension"

export typealias DeclList = Array with Decl

// Visibility is how far a declaration, field or method can be named from, narrowest first: the declaring module only;
// the tree rooted at the declaring module's parent, as Go's internal/, which is the whole project for a top-level module
// or the root; everyone, programs that use the project as a library included.
export enum Visibility
	unexported
	exported
	everyone
end 'Visibility'

export function visibilityOf(modifier String) returns Visibility
	if modifier == "" 'none'
		return Visibility.unexported
	end 'none'
	if modifier == "export" 'exp'
		return Visibility.exported
	end 'exp'
	if modifier == "public" 'pub'
		return Visibility.everyone
	end 'pub'
	panic("'{modifier}' is not a visibility modifier")
end 'visibilityOf'

// visibilityWord is the visibility as a diagnostic names it, which is Maxon's.
export function visibilityWord(v Visibility) returns String
	return match v 'v'
		unexported gives "unexported"
		exported gives "exported"
		everyone gives "public"
	end 'v'
end 'visibilityWord'

// visibilityModifier is what a declaration writes to have the visibility.
export function visibilityModifier(v Visibility) returns String
	return match v 'v'
		unexported gives ""
		exported gives "export"
		everyone gives "public"
	end 'v'
end 'visibilityModifier'

// parentPath is the path of the module a module's path is under; the root's and a top-level module's is the root's.
export function parentPath(path String) returns borrowed String
	var i = path.byteLength()
	while i > 0 'back'
		i = i - 1
		if path.byteAt(i) == 46 'dot'
			return path.sliceBytes(0 as Count, endPos: i)
		end 'dot'
	end 'back'
	return path.sliceBytes(0 as Count, endPos: 0 as Count)
end 'parentPath'

// isWithin is whether the module at path is the one at under or one under it.
export function isWithin(path String, under String) returns bool
	if under == "" or path == under 'same'
		return true
	end 'same'
	let n = under.byteLength()
	return path.byteLength() > n and path.byteAt(n) == 46 and path.sliceBytes(0 as Count, endPos: n) == under
end 'isWithin'

// isVisible is whether something that the module owner declares with the visibility v can be named from the module
// from. This is the one place that decides it.
export function isVisible(v Visibility, owner diag.ModuleID, ownerPath String, from diag.ModuleID, fromPath String) returns bool
	return match v 'v'
		everyone gives true
		exported gives owner == diag.stdlibID or isWithin(fromPath, under: parentPath(ownerPath))
		unexported gives owner == from
	end 'v'
end 'isVisible'

export typealias DeclIndex = table.StringMap with DeclOrdinal

export typealias DeclRefIndex = table.StringMap with DeclRef

// NestedAlias is a typealias that the body of a type, or an extension, declares: its owner as that spells it, the name it
// has there, and its place among the module's declarations.
export type NestedAlias
	export var owner as String
	export var member as String
	export var ordinal as DeclOrdinal

	export static function make(consumes owner String, consumes member String, ordinal DeclOrdinal) returns NestedAlias
		return NestedAlias{owner: owner, member: member, ordinal: ordinal}
	end 'make'
end 'NestedAlias'

export typealias NestedAliasList = Array with NestedAlias

export typealias LineStarts = Array with Count

export type FileSpan
	export var path as String
	export var start as diag.U32
	export var endOff as diag.U32
	// lineStarts are the offsets in the module's text where the file's lines start, the first at start, so that an offset
	// is located by a search of them rather than a walk of the file before it, which every panic of the program asks for.
	export var lineStarts as LineStarts

	// make is the file at start up to endOff of the module's text.
	export static function make(consumes path String, text String, start diag.U32, endOff diag.U32) returns FileSpan
		var lineStarts = LineStarts.create(0)
		lineStarts.push(start as Count)
		for pos in start as Count upto endOff as Count 'bytes'
			if text.byteAt(pos) == newlineByte 'newline'
				lineStarts.push(pos + 1)
			end 'newline'
		end 'bytes'
		return FileSpan{path: path, start: start, endOff: endOff, lineStarts: lineStarts}
	end 'make'
end 'FileSpan'

export typealias FileSpanList = Array with FileSpan

// Module is a module of the project: where it is and the modules under it, and the products of its parse (its files,
// declarations, their names and the typealiases its types nest) and of its resolve or its bodies (its tree), frozen when the
// stage that made them ended, so that a task that waited on the stage shares them.
export type Module
	export var id as diag.ModuleID
	export var path as String
	export var dir as String
	// isRuntime is whether the module is the runtime's source, the one module that may call the __Raw intrinsics.
	export var isRuntime as bool
	// isLibrary is whether the module is part of the standard library, whose qualified names start from the library's root and
	// whose declarations short of public no program module sees.
	export var isLibrary as bool
	// stagedInLibrary is whether a module of the program is compiled in the library tier, as maxon's spec runner compiles a case
	// marked `tier: stdlib`: it may name maxon's raw surface, as the runtime and the library may (E3185).
	export var stagedInLibrary as bool
	// isCompiler is whether the module is the compiler's own source, which reads its input and runs its tests' children through
	// the library tiers' built-ins (__Builtins.readStdin, __Builtins.runWithInput) and so goes through the doors they do.
	export var isCompiler as bool
	export var filePaths as StringList
	export var childNames as StringList
	export var childIDs as Array with diag.ModuleID
	export var files as frozen with FileSpanList
	export var tree as frozen with Tree
	export var decls as frozen with DeclList
	export var names as frozen with DeclIndex
	// nested are the typealiases that the module's type bodies and extensions declare, which a bare name finds in an extension of
	// their owner.
	export var nested as frozen with NestedAliasList
	export var tables as ModuleTables

	export static function new(id diag.ModuleID, consumes path String, consumes text String, consumes files FileSpanList) returns Module
		return Module{id: id, path: path, dir: "", isRuntime: false, isLibrary: false, stagedInLibrary: false, isCompiler: false, filePaths: StringList.create(0), childNames: StringList.create(0), childIDs: Array.create(0), files: freeze(files), tree: freeze(Tree.new(id, text: text)), decls: freeze(DeclList.create(0)), names: freeze(DeclIndex.new()), nested: freeze(NestedAliasList.create(0)), tables: ModuleTables.new()}
	end 'new'

	export function display() returns String
		if id == diag.stdlibID 'std'
			return "<stdlib>"
		end 'std'
		if path == "" 'rt'
			return "root module"
		end 'rt'
		return path.clone()
	end 'display'

	// isQualifierRoot is whether the module is the root that its qualified names start from, which `export` names: the
	// project's root, or the library's, which holds no file.
	export function isQualifierRoot() returns bool
		if isLibrary 'library'
			return path == stdlibQualifier
		end 'library'
		return path == ""
	end 'isQualifierRoot'

	// inLibraryTier is whether the module may name maxon's raw surface (E3185).
	export function inLibraryTier() returns bool
		return isRuntime or isLibrary or stagedInLibrary or isCompiler
	end 'inLibraryTier'

	export function findChild(name String) returns table.Option with diag.ModuleID
		for i in 0 upto childNames.count() 'each'
			if childNames[i] == name 'hit'
				return table.Option.some(childIDs[i])
			end 'hit'
		end 'each'
		return table.Option.none
	end 'findChild'

	// viewOf is the module as a task sees it that waited on the stages that made tree and, where parsed, on its parse: where it
	// is, and those products, shared, with tables, a view of its tables.
	export function viewOf(consumes viewTree frozen with Tree, parsed bool, consumes viewTables ModuleTables) returns Module
		var view = Module{id: id, path: path.clone(), dir: dir.clone(), isRuntime: isRuntime, isLibrary: isLibrary, stagedInLibrary: stagedInLibrary, isCompiler: isCompiler, filePaths: filePaths.clone(), childNames: childNames.clone(), childIDs: childIDs.clone(), files: share(files), tree: viewTree, decls: share(decls), names: share(names), nested: share(nested), tables: viewTables}
		if not parsed 'unparsed'
			view.files = freeze(FileSpanList.create(0))
			view.decls = freeze(DeclList.create(0))
			view.names = freeze(DeclIndex.new())
			view.nested = freeze(NestedAliasList.create(0))
		end 'unparsed'
		return view
	end 'viewOf'

	// takeParsed makes what the parse made of the module its products.
	export function takeParsed(mutates self, consumes parsed ParsedModule)
		var made = parsed
		tree = freeze(exchange(made.tree, value: Tree.new(id, text: "")))
		files = freeze(exchange(made.files, value: FileSpanList.create(0)))
		decls = freeze(exchange(made.decls, value: DeclList.create(0)))
		names = freeze(exchange(made.names, value: DeclIndex.new()))
		nested = freeze(exchange(made.nested, value: NestedAliasList.create(0)))
	end 'takeParsed'
end 'Module'

// NameUse is a name that a module's code writes, by its place in the module's text.
export type NameUse
	export var start as diag.U32
	export var length as diag.U32

	export static function make(start diag.U32, length diag.U32) returns NameUse
		return NameUse{start: start, length: length}
	end 'make'

	export function endOffset() returns Count
		return (start as Count) + (length as Count)
	end 'endOffset'
end 'NameUse'

export typealias NameUses = Array with NameUse

// ParsedModule is a module's source as its parse makes it, which the parse owns and writes: its files, its tree, its
// declarations, their names and the typealiases its types nest.
export type ParsedModule
	export var files as FileSpanList
	export var tree as Tree
	export var decls as DeclList
	export var names as DeclIndex
	export var nested as NestedAliasList
	// skimmed is how many bodies of functions the parse skimmed, which it holds empty (syntax.parseModuleFilesSkimming).
	export var skimmed as Count
	// sourceDigest is the digest of the module's source (project.sourceDigest) when the parse was asked for it, and none otherwise.
	export var sourceDigest as table.Digest
	// nameUses are the names that the module's code writes, its interpolations included, in neither its comments nor the text of
	// its strings, which the driver reads the module's words of the library from (libindex.maxon) and lets go.
	export var nameUses as NameUses

	export static function new(id diag.ModuleID, consumes text String, consumes files FileSpanList) returns ParsedModule
		return ParsedModule{files: files, tree: Tree.new(id, text: text), decls: DeclList.create(0), names: DeclIndex.new(), nested: NestedAliasList.create(0), skimmed: 0, sourceDigest: table.Digest.none(), nameUses: NameUses.create(0)}
	end 'new'

	export function appendRawDecl(mutates self, consumes d Decl)
		decls.push(d)
	end 'appendRawDecl'

	export function indexDecl(mutates self, ord DeclOrdinal) returns table.Option with DeclOrdinal
		if decls[ord as Count].isExtension() 'extension'
			return table.Option.none
		end 'extension'
		let n = decls[ord as Count].name()
		let prev = names.get(n)
		match prev 'dup'
			some(_) then return prev
			none then names.insert(n, value: ord)
		end 'dup'
		return table.Option.none
	end 'indexDecl'

	export function declare(mutates self, consumes d Decl) returns bool
		let n = d.name()
		if names.has(n) 'dup'
			return false
		end 'dup'
		let ord = try decls.count() as DeclOrdinal otherwise panic("too many declarations")
		names.insert(n, value: ord)
		decls.push(d)
		return true
	end 'declare'
end 'ParsedModule'

export typealias ModuleList = Array with Module
