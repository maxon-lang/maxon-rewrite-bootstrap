export typealias DeclOrdinal = int(0 to 4294967295)

export enum DeclKind
	funcDecl
	constDecl
	typeDecl
	enumDecl
	unionDecl
	aliasDecl
	interfaceDecl
end 'DeclKind'

export type DeclRef
	export var module as diag.ModuleID
	export var ordinal as DeclOrdinal

	export static function make(module diag.ModuleID, ordinal DeclOrdinal) returns DeclRef
		return DeclRef{module: module, ordinal: ordinal}
	end 'make'
end 'DeclRef'

export type Param
	export var id as NodeID
	export var convention as String
	export var name as String
	export var typeRef as NodeID

	export static function make(id NodeID, consumes convention String, consumes name String, typeRef NodeID) returns Param
		return Param{id: id, convention: convention, name: name, typeRef: typeRef}
	end 'make'
end 'Param'

export typealias ParamList = Array with Param

export type TypeParam
	export var id as NodeID
	export var name as String

	export static function make(id NodeID, consumes name String) returns TypeParam
		return TypeParam{id: id, name: name}
	end 'make'
end 'TypeParam'

export typealias TypeParamList = Array with TypeParam

export type Constraint
	export var id as NodeID
	export var paramName as String
	export var bounds as U32List

	export static function make(id NodeID, consumes paramName String, consumes bounds U32List) returns Constraint
		return Constraint{id: id, paramName: paramName, bounds: bounds}
	end 'make'
end 'Constraint'

export typealias ConstraintList = Array with Constraint

export type FieldDecl
	export var id as NodeID
	export var visibility as String
	export var isVar as bool
	export var name as String
	export var typeRef as NodeID
	export var defaultExpr as NodeID

	export static function make(id NodeID, consumes visibility String, isVar bool, consumes name String, typeRef NodeID, defaultExpr NodeID) returns FieldDecl
		return FieldDecl{id: id, visibility: visibility, isVar: isVar, name: name, typeRef: typeRef, defaultExpr: defaultExpr}
	end 'make'
end 'FieldDecl'

export typealias FieldDeclList = Array with FieldDecl

export type EnumCaseDecl
	export var id as NodeID
	export var name as String
	export var rawExpr as NodeID

	export static function make(id NodeID, consumes name String, rawExpr NodeID) returns EnumCaseDecl
		return EnumCaseDecl{id: id, name: name, rawExpr: rawExpr}
	end 'make'
end 'EnumCaseDecl'

export typealias EnumCaseList = Array with EnumCaseDecl

export type UnionCaseDecl
	export var id as NodeID
	export var name as String
	export var fields as ParamList

	export static function make(id NodeID, consumes name String, consumes fields ParamList) returns UnionCaseDecl
		return UnionCaseDecl{id: id, name: name, fields: fields}
	end 'make'
end 'UnionCaseDecl'

export typealias UnionCaseList = Array with UnionCaseDecl

export type FuncSig
	export var id as NodeID
	export var name as String
	export var receiver as String
	export var params as ParamList
	export var returnsRef as NodeID
	export var throwsRef as NodeID

	export static function make(id NodeID, consumes name String, consumes receiver String, consumes params ParamList, returnsRef NodeID, throwsRef NodeID) returns FuncSig
		return FuncSig{id: id, name: name, receiver: receiver, params: params, returnsRef: returnsRef, throwsRef: throwsRef}
	end 'make'
end 'FuncSig'

export typealias FuncSigList = Array with FuncSig

export type FuncDecl
	export var id as NodeID
	export var ordinal as DeclOrdinal
	export var visibility as String
	export var isStatic as bool
	export var name as String
	export var receiver as String
	export var params as ParamList
	export var typeParams as TypeParamList
	export var returnsRef as NodeID
	export var throwsRef as NodeID
	export var constraints as ConstraintList
	export var bodyRef as diag.U32
	export var endLabel as NodeID

	export static function make(id NodeID, consumes visibility String, isStatic bool, consumes name String, consumes receiver String, consumes params ParamList, consumes typeParams TypeParamList, returnsRef NodeID, throwsRef NodeID, consumes constraints ConstraintList, bodyRef diag.U32, endLabel NodeID) returns FuncDecl
		return FuncDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, isStatic: isStatic, name: name, receiver: receiver, params: params, typeParams: typeParams, returnsRef: returnsRef, throwsRef: throwsRef, constraints: constraints, bodyRef: bodyRef, endLabel: endLabel}
	end 'make'
end 'FuncDecl'

export typealias FuncDeclList = Array with FuncDecl

export type ConstDecl
	export var id as NodeID
	export var ordinal as DeclOrdinal
	export var visibility as String
	export var name as String
	export var valueExpr as NodeID

	export static function make(id NodeID, consumes visibility String, consumes name String, valueExpr NodeID) returns ConstDecl
		return ConstDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, name: name, valueExpr: valueExpr}
	end 'make'
end 'ConstDecl'

export type TypeDecl
	export var id as NodeID
	export var ordinal as DeclOrdinal
	export var visibility as String
	export var name as String
	export var isNoncopyable as bool
	export var typeParams as TypeParamList
	export var conforms as U32List
	export var constraints as ConstraintList
	export var fields as FieldDeclList
	export var methods as FuncDeclList
	export var endLabel as NodeID

	export static function make(id NodeID, consumes visibility String, consumes name String, isNoncopyable bool, consumes typeParams TypeParamList, consumes conforms U32List, consumes constraints ConstraintList, consumes fields FieldDeclList, consumes methods FuncDeclList, endLabel NodeID) returns TypeDecl
		return TypeDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, name: name, isNoncopyable: isNoncopyable, typeParams: typeParams, conforms: conforms, constraints: constraints, fields: fields, methods: methods, endLabel: endLabel}
	end 'make'
end 'TypeDecl'

export type EnumDecl
	export var id as NodeID
	export var ordinal as DeclOrdinal
	export var visibility as String
	export var name as String
	export var conforms as U32List
	export var cases as EnumCaseList
	export var methods as FuncDeclList
	export var endLabel as NodeID

	export static function make(id NodeID, consumes visibility String, consumes name String, consumes conforms U32List, consumes cases EnumCaseList, consumes methods FuncDeclList, endLabel NodeID) returns EnumDecl
		return EnumDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, name: name, conforms: conforms, cases: cases, methods: methods, endLabel: endLabel}
	end 'make'
end 'EnumDecl'

export type UnionDecl
	export var id as NodeID
	export var ordinal as DeclOrdinal
	export var visibility as String
	export var name as String
	export var isNoncopyable as bool
	export var typeParams as TypeParamList
	export var conforms as U32List
	export var constraints as ConstraintList
	export var cases as UnionCaseList
	export var methods as FuncDeclList
	export var endLabel as NodeID

	export static function make(id NodeID, consumes visibility String, consumes name String, isNoncopyable bool, consumes typeParams TypeParamList, consumes conforms U32List, consumes constraints ConstraintList, consumes cases UnionCaseList, consumes methods FuncDeclList, endLabel NodeID) returns UnionDecl
		return UnionDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, name: name, isNoncopyable: isNoncopyable, typeParams: typeParams, conforms: conforms, constraints: constraints, cases: cases, methods: methods, endLabel: endLabel}
	end 'make'
end 'UnionDecl'

export type Bound
	export var id as NodeID
	export var negative as bool
	export var isSized as bool
	export var sizedName as String
	export var limitName as String
	export var value as I128

	export static function makeInt(id NodeID, negative bool, consumes value I128) returns Bound
		return Bound{id: id, negative: negative, isSized: false, sizedName: "", limitName: "", value: value}
	end 'makeInt'

	export static function makeSized(id NodeID, negative bool, consumes sizedName String, consumes limitName String) returns Bound
		return Bound{id: id, negative: negative, isSized: true, sizedName: sizedName, limitName: limitName, value: I128.fromCount(0 as Count)}
	end 'makeSized'
end 'Bound'

export type AliasDecl
	export var id as NodeID
	export var ordinal as DeclOrdinal
	export var visibility as String
	export var name as String
	export var isRange as bool
	export var inclusive as bool
	export var low as Bound
	export var high as Bound
	export var instanceRef as NodeID

	export static function makeRange(id NodeID, consumes visibility String, consumes name String, inclusive bool, consumes low Bound, consumes high Bound) returns AliasDecl
		return AliasDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, name: name, isRange: true, inclusive: inclusive, low: low, high: high, instanceRef: 0 as NodeID}
	end 'makeRange'

	export static function makeInstance(id NodeID, consumes visibility String, consumes name String, instanceRef NodeID) returns AliasDecl
		let zero = Bound.makeInt(0 as NodeID, negative: false, value: I128.fromCount(0 as Count))
		return AliasDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, name: name, isRange: false, inclusive: false, low: zero.clone(), high: zero, instanceRef: instanceRef}
	end 'makeInstance'
end 'AliasDecl'

export type InterfaceDecl
	export var id as NodeID
	export var ordinal as DeclOrdinal
	export var visibility as String
	export var name as String
	export var methods as FuncSigList
	export var endLabel as NodeID

	export static function make(id NodeID, consumes visibility String, consumes name String, consumes methods FuncSigList, endLabel NodeID) returns InterfaceDecl
		return InterfaceDecl{id: id, ordinal: 0 as DeclOrdinal, visibility: visibility, name: name, methods: methods, endLabel: endLabel}
	end 'make'
end 'InterfaceDecl'

export union Decl
	funcDecl(value FuncDecl)
	constDecl(value ConstDecl)
	typeDecl(value TypeDecl)
	enumDecl(value EnumDecl)
	unionDecl(value UnionDecl)
	aliasDecl(value AliasDecl)
	interfaceDecl(value InterfaceDecl)

	export function name() returns String
		return match self 'd'
			funcDecl(v) gives v.name.clone()
			constDecl(v) gives v.name.clone()
			typeDecl(v) gives v.name.clone()
			enumDecl(v) gives v.name.clone()
			unionDecl(v) gives v.name.clone()
			aliasDecl(v) gives v.name.clone()
			interfaceDecl(v) gives v.name.clone()
		end 'd'
	end 'name'

	export function visibility() returns String
		return match self 'd'
			funcDecl(v) gives v.visibility.clone()
			constDecl(v) gives v.visibility.clone()
			typeDecl(v) gives v.visibility.clone()
			enumDecl(v) gives v.visibility.clone()
			unionDecl(v) gives v.visibility.clone()
			aliasDecl(v) gives v.visibility.clone()
			interfaceDecl(v) gives v.visibility.clone()
		end 'd'
	end 'visibility'

	export function nodeID() returns NodeID
		return match self 'd'
			funcDecl(v) gives v.id
			constDecl(v) gives v.id
			typeDecl(v) gives v.id
			enumDecl(v) gives v.id
			unionDecl(v) gives v.id
			aliasDecl(v) gives v.id
			interfaceDecl(v) gives v.id
		end 'd'
	end 'nodeID'

	export function level() returns Visibility
		return visibilityOf(self.visibility())
	end 'level'

	export function isExported() returns bool
		return self.level() != Visibility.unexported
	end 'isExported'

	export function isType() returns bool
		return match self 'd'
			funcDecl(_) gives false
			constDecl(_) gives false
			typeDecl(_) gives true
			enumDecl(_) gives true
			unionDecl(_) gives true
			aliasDecl(_) gives true
			interfaceDecl(_) gives true
		end 'd'
	end 'isType'

	export function offset(t Tree) returns diag.U32
		let id = self.nodeID() as Count
		return t.records[id].start
	end 'offset'
end 'Decl'

export typealias DeclList = Array with Decl

// Visibility is how far a declaration, field or method can be named from, narrowest first: the declaring module only;
// the tree rooted at the declaring module's parent, as Go's internal/, which is the whole project for a top-level module
// or the root; everyone, programs that use the project as a library included.
export enum Visibility
	unexported
	exported
	everyone
end 'Visibility'

export function visibilityOf(modifier String) returns Visibility
	if modifier == "" 'none'
		return Visibility.unexported
	end 'none'
	if modifier == "export" 'exp'
		return Visibility.exported
	end 'exp'
	if modifier == "public" 'pub'
		return Visibility.everyone
	end 'pub'
	panic("'{modifier}' is not a visibility modifier")
end 'visibilityOf'

// visibilityWord is the visibility as a diagnostic names it, which is Maxon's.
export function visibilityWord(v Visibility) returns String
	return match v 'v'
		unexported gives "unexported"
		exported gives "exported"
		everyone gives "public"
	end 'v'
end 'visibilityWord'

// visibilityModifier is what a declaration writes to have the visibility.
export function visibilityModifier(v Visibility) returns String
	return match v 'v'
		unexported gives ""
		exported gives "export"
		everyone gives "public"
	end 'v'
end 'visibilityModifier'

// parentPath is the path of the module a module's path is under; the root's and a top-level module's is the root's.
export function parentPath(path String) returns String
	var i = path.byteLength()
	while i > 0 'back'
		i = try i - 1 otherwise 0 as Count
		if path.byteAt(i) == 46 'dot'
			return path.sliceBytes(0 as Count, endPos: i)
		end 'dot'
	end 'back'
	return ""
end 'parentPath'

// isWithin is whether the module at path is the one at under or one under it.
export function isWithin(path String, under String) returns bool
	if under == "" or path == under 'same'
		return true
	end 'same'
	let n = under.byteLength()
	return path.byteLength() > n and path.byteAt(n) == 46 and path.sliceBytes(0 as Count, endPos: n) == under
end 'isWithin'

// isVisible is whether something that the module owner declares with the visibility v can be named from the module
// from. This is the one place that decides it.
export function isVisible(v Visibility, owner diag.ModuleID, ownerPath String, from diag.ModuleID, fromPath String) returns bool
	return match v 'v'
		everyone gives true
		exported gives owner == diag.stdlibID or isWithin(fromPath, under: parentPath(ownerPath))
		unexported gives owner == from
	end 'v'
end 'isVisible'

export typealias DeclIndex = table.StringMap with DeclOrdinal

export type FileSpan
	export var path as String
	export var start as diag.U32
	export var endOff as diag.U32

	export static function make(consumes path String, start diag.U32, endOff diag.U32) returns FileSpan
		return FileSpan{path: path, start: start, endOff: endOff}
	end 'make'
end 'FileSpan'

export typealias FileSpanList = Array with FileSpan

export type Module
	export var id as diag.ModuleID
	export var path as String
	export var dir as String
	export var filePaths as StringList
	export var childNames as StringList
	export var childIDs as Array with diag.ModuleID
	export var files as FileSpanList
	export var tree as Tree
	export var decls as DeclList
	export var names as DeclIndex

	export static function new(id diag.ModuleID, consumes path String, consumes text String, consumes files FileSpanList) returns Module
		return Module{id: id, path: path, dir: "", filePaths: StringList.create(0), childNames: StringList.create(0), childIDs: Array.create(0), files: files, tree: Tree.new(id, text: text), decls: DeclList.create(0), names: DeclIndex.new()}
	end 'new'

	export function display() returns String
		if id == diag.stdlibID 'std'
			return "<stdlib>"
		end 'std'
		if path == "" 'rt'
			return "root module"
		end 'rt'
		return path.clone()
	end 'display'

	export function findChild(name String) returns Option with diag.ModuleID
		for i in 0 upto childNames.count() 'each'
			if childNames[i] == name 'hit'
				return Option.some(childIDs[i])
			end 'hit'
		end 'each'
		return Option.none
	end 'findChild'

	export function appendRawDecl(mutates self, consumes d Decl)
		decls.push(d)
	end 'appendRawDecl'

	export function indexDecl(mutates self, ord DeclOrdinal) returns Option with DeclOrdinal
		let n = decls[ord as Count].name()
		let prev = names.get(n)
		match prev 'dup'
			some(_) then return prev
			none then names.insert(n, value: ord)
		end 'dup'
		return Option.none
	end 'indexDecl'

	export function declare(mutates self, consumes d Decl) returns bool
		let n = d.name()
		if names.has(n) 'dup'
			return false
		end 'dup'
		let ord = try decls.count() as DeclOrdinal otherwise panic("too many declarations")
		names.insert(n, value: ord)
		decls.push(d)
		return true
	end 'declare'
end 'Module'

export typealias ModuleList = Array with Module
