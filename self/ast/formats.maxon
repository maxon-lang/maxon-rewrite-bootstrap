// The format specifier of an interpolation, `{value:08x}`, as maxon reads it. What it means depends on the type of the value:
// a width, a zero fill and a base decorate an integer, a width, a zero fill and a precision a float, and a width and a
// quote a String. Every reading takes the same prefix, so the text is given its meaning once, here.

// formatFieldBound is the largest width or precision a specifier writes, which is maxon's FormatFieldWidth.
export let formatFieldBound = 4294967295 as Count

let formatFill = 48 as Byte

let formatPoint = 46 as Byte

let formatZero = 48 as Byte

let formatNine = 57 as Byte

let formatDecimalRadix = 10 as Count

let formatHexRadix = 16 as Count

let formatOctalRadix = 8 as Count

let formatBinaryRadix = 2 as Count

// FormatSpec is what a specifier asks for. A letter that names no base means decimal, so that a specifier that only a
// type of the program reads is not refused here.
export type FormatSpec
	// present is whether the interpolation has a specifier at all.
	export var present as bool
	export var zeroFill as bool
	export var width as Count
	export var hasPrecision as bool
	export var precision as Count
	// radix is the base of an integer: 10, 16, 8 or 2.
	export var radix as Count
	export var uppercase as bool
	// quotes is whether the specifier ends in the letter q, which quotes a String.
	export var quotes as bool

	static function make(zeroFill bool, width Count, hasPrecision bool, precision Count, radix Count, uppercase bool, quotes bool) returns FormatSpec
		return FormatSpec{present: true, zeroFill: zeroFill, width: width, hasPrecision: hasPrecision, precision: precision, radix: radix, uppercase: uppercase, quotes: quotes}
	end 'make'

	// absent is the specifier of an interpolation that has none, which asks for nothing.
	export static function absent() returns FormatSpec
		return FormatSpec{present: false, zeroFill: false, width: 0 as Count, hasPrecision: false, precision: 0 as Count, radix: formatDecimalRadix, uppercase: false, quotes: false}
	end 'absent'

	// spellsASign is whether an integer in this base writes a sign: only decimal does, since the others spell the bit pattern.
	export function spellsASign() returns bool
		return radix == formatDecimalRadix
	end 'spellsASign'
end 'FormatSpec'

// parseFormatSpec reads the text between the colon of an interpolation and its brace, or gives none when a width or a
// precision is past formatFieldBound.
export function parseFormatSpec(text String) returns table.Option with FormatSpec
	let size = text.byteLength()
	var at = 0 as Count
	let zeroFill = size > 0 and text.byteAt(0) == formatFill
	if zeroFill 'fill'
		at = 1
	end 'fill'
	let widthEnd = formatDigitsEnd(text, from: at)
	var width = 0 as Count
	match consumes formatNumber(text, from: at, until: widthEnd) 'width'
		some(n) then width = n
		none then return table.Option.none
	end 'width'
	var hasPrecision = false
	var precision = 0 as Count
	if widthEnd < size and text.byteAt(widthEnd) == formatPoint 'point'
		let precisionStart = widthEnd + 1
		match consumes formatNumber(text, from: precisionStart, until: formatDigitsEnd(text, from: precisionStart)) 'precision'
			some(n) then precision = n
			none then return table.Option.none
		end 'precision'
		hasPrecision = true
	end 'point'
	var radix = formatDecimalRadix
	var uppercase = false
	var quotes = false
	if widthEnd < size 'letter'
		let letter = text.byteAt(widthEnd)
		if letter == 120 or letter == 88 'hex'
			radix = formatHexRadix
			uppercase = letter == 88
		end 'hex' else if letter == 111 'octal'
			radix = formatOctalRadix
		end 'octal' else if letter == 98 'binary'
			radix = formatBinaryRadix
		end 'binary' else if letter == 113 'quote'
			quotes = true
		end 'quote'
	end 'letter'
	return table.Option.some(FormatSpec.make(zeroFill, width: width, hasPrecision: hasPrecision, precision: precision, radix: radix, uppercase: uppercase, quotes: quotes))
end 'parseFormatSpec'

// formatDigitsEnd is where the run of decimal digits that starts at from ends: from itself where there is none.
function formatDigitsEnd(text String, from Count) returns Count
	var at = from
	while at < text.byteLength() 'scan'
		let b = text.byteAt(at)
		if b < formatZero or b > formatNine 'stop'
			return at
		end 'stop'
		at = at + 1
	end 'scan'
	return at
end 'formatDigitsEnd'

// formatNumber is the number that the digits from from to until write, or none past formatFieldBound; an empty run is 0.
function formatNumber(text String, from Count, until Count) returns table.Option with Count
	var value = 0 as Count
	for i in from upto until 'digits'
		value = (try value * 10 + ((text.byteAt(i) - formatZero) as Count) otherwise formatFieldBound + 1)
		if value > formatFieldBound 'past'
			return table.Option.none
		end 'past'
	end 'digits'
	return table.Option.some(value)
end 'formatNumber'

// partFormatSpec is the format specifier of a part of a string literal, which asks for nothing for a part that has none. The
// parser refused a specifier that does not read, so every one reads here.
export function partFormatSpec(t Tree, partsRef diag.U32, index Count) returns FormatSpec
	let text = t.strPartFormat(partsRef, index: index)
	if text.byteLength() == 0 'none'
		return FormatSpec.absent()
	end 'none'
	return match consumes parseFormatSpec(text) 'spec'
		some(s) gives s
		none panic("ast: the format specifier '{text}' was not read by the parser")
	end 'spec'
end 'partFormatSpec'

// textPartBorrows is whether an interpolated literal is joined from the String that a part of content type t reads, rather
// than from a String made for the part: an unquoted String, and a FilePath's text. Lowering keeps every such String until
// the one join after the last part, and ownership holds the place the part reads until then, so that no later part may
// change or move it. A type parameter may be a String in an instance, so ownership, which checks the generic body once,
// holds a part of one too; lowering sees only the instance's types.
export function textPartBorrows(b Builtins, tt TypeSlot, reads TypeTable, t TypeID, spec FormatSpec) returns bool
	if t == b.stringTy or typeKind(tt, reads: reads, t: t) == TypeKind.typeParam 'string'
		return not spec.quotes
	end 'string'
	return t == b.filePathTy
end 'textPartBorrows'
