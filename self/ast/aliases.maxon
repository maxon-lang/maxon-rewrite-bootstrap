// sizedBounds are the ranges a bound can name as, for example i64.min: the sized integer's lowest and highest value.
function sizedBounds(name String) returns table.Option with I128Pair
	return match name 'sized'
		"u8" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.fromCount(255 as Count)))
		"u16" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.fromCount(65535 as Count)))
		"u32" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.fromCount(4294967295 as Count)))
		"u64" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.u64Max()))
		"i8" gives table.Option.some(I128Pair.make(I128.fromInt(-128 as FullRangeInt), hi: I128.fromInt(127 as FullRangeInt)))
		"i16" gives table.Option.some(I128Pair.make(I128.fromInt(-32768 as FullRangeInt), hi: I128.fromInt(32767 as FullRangeInt)))
		"i32" gives table.Option.some(I128Pair.make(I128.fromInt(-2147483648 as FullRangeInt), hi: I128.fromInt(2147483647 as FullRangeInt)))
		"i64" gives table.Option.some(I128Pair.make(I128.i64Min(), hi: I128.i64Max()))
		default gives table.Option.none
	end 'sized'
end 'sizedBounds'

type I128Pair
	export var lo as I128
	export var hi as I128

	static function make(consumes lo I128, consumes hi I128) returns I128Pair
		return I128Pair{lo: lo, hi: hi}
	end 'make'
end 'I128Pair'

// sizedLimit is the value that a bound written as a sized integer's limit names, or none after it reported why it names
// none.
function sizedLimit(modID diag.ModuleID, off diag.U32, b Bound, mutates errs diag.ErrorList) returns table.Option with I128
	match consumes sizedBounds(b.sized) 'range'
		some(r) then return sizedLimitOf(modID, off: off, b: b, r: r, errs: errs)
		none then _ = 0
	end 'range'
	diag.pushSiteError(errs, code: diag.errUnknownType, message: "'{b.sized}' is not a sized integer; a bound names one of u8, u16, u32, u64, i8, i16, i32 or i64", module: modID, offset: off)
	return table.Option.none
end 'sizedLimit'

function sizedLimitOf(modID diag.ModuleID, off diag.U32, b Bound, r I128Pair, mutates errs diag.ErrorList) returns table.Option with I128
	match consumes limitOf(r, member: b.limit) 'limit'
		some(v) then return table.Option.some(v)
		none then _ = 0
	end 'limit'
	diag.pushSiteError(errs, code: diag.errUnknownField, message: "'{b.sized}.{b.limit}' is not a bound; write '{b.sized}.min' or '{b.sized}.max'", module: modID, offset: off)
	return table.Option.none
end 'sizedLimitOf'

// boundValue is the value a bound of a range alias writes, or none after it reported why the bound names none.
function boundValue(modID diag.ModuleID, tree Tree, b Bound, mutates errs diag.ErrorList) returns table.Option with I128
	var v = b.value.clone()
	if b.sized != "" 'sized'
		match consumes sizedLimit(modID, off: tree.startOf(b.id), b: b, errs: errs) 'limit'
			some(limit) then v = limit
			none then return table.Option.none
		end 'limit'
	end 'sized'
	if b.negative 'neg'
		return table.Option.some(v.neg())
	end 'neg'
	return table.Option.some(v)
end 'boundValue'

// aliasNamesInstance is whether a typealias names an instance of a generic type or a function type, as against an integer
// range: a type made of the types it names.
export function aliasNamesInstance(ad AliasDecl) returns bool
	return ad.instance != 0 or ad.fn != 0
end 'aliasNamesInstance'

// isGenericOwned is whether the typealias of the name is declared in the body of a generic type, where a range would be a
// distinct type for each instance.
function isGenericOwned(p Project, modIdx Count, name String) returns bool
	match consumes nestedAliasOwner(name) 'owner'
		some(ownerName) then return typeParamCountOf(p, modIdx: modIdx, name: ownerName) > 0
		none then return false
	end 'owner'
end 'isGenericOwned'

function typeParamCountOf(p Project, modIdx Count, name String) returns Count
	match consumes p.modules[modIdx].names.get(name) 'declared'
		some(ord) then return typeParamCountOfDecl(p.modules[modIdx].decls[ord as Count])
		none then return 0
	end 'declared'
end 'typeParamCountOf'

function typeParamCountOfDecl(d Decl) returns Count
	return match d 'k'
		typeDecl(td) gives td.typeParams.count()
		unionDecl(ud) gives ud.typeParams.count()
		funcDecl(_) gives 0
		constDecl(_) gives 0
		enumDecl(_) gives 0
		aliasDecl(_) gives 0
		interfaceDecl(_) gives 0
	end 'k'
end 'typeParamCountOfDecl'

// declareRangeAlias gives a typealias of a range its integer type, which is its own even where another alias has the
// same range. A typealias of an instance has none yet: its type is the instance, which the checker's aliases stage
// finds once the types it names are known.
export function declareRangeAlias(mutates p Project, ref DeclRef, ad AliasDecl, mutates errs diag.ErrorList)
	if aliasNamesInstance(ad) 'instance'
		return
	end 'instance'
	let modIdx = modIndex(ref.module)
	let off = p.modules[modIdx].tree.startOf(ad.id)
	if isGenericOwned(p, modIdx: modIdx, name: ad.name) 'perInstance'
		diag.pushSiteError(errs, code: diag.errUnsupportedFeature, message: "the ranged typealias '{ad.name}' is declared in a generic type, where each instance would have a type of its own, which this compiler does not implement: declare it outside the type", module: ref.module, offset: off)
		return
	end 'perInstance'
	var lo as I128
	match consumes boundValue(ref.module, tree: p.modules[modIdx].tree, b: ad.low, errs: errs) 'low'
		some(v) then lo = v
		none then return
	end 'low'
	var hi as I128
	match consumes boundValue(ref.module, tree: p.modules[modIdx].tree, b: ad.high, errs: errs) 'high'
		some(v) then hi = v
		none then return
	end 'high'
	if not ad.inclusive 'exclusive'
		hi = hi.sub(I128.one())
	end 'exclusive'
	if lo.gt(hi) 'empty'
		diag.pushSiteError(errs, code: diag.errTypeMismatch, message: diag.emptyIntegerRange(lo.toString(), high: hi.toString()), module: ref.module, offset: off)
		return
	end 'empty'
	if lo.isNeg() and hi.gt(I128.i64Max()) 'unrepresentable'
		diag.pushSiteError(errs, code: diag.errTypeMismatch, message: diag.unrepresentableIntegerRange(lo.toString(), high: hi.toString()), module: ref.module, offset: off)
		return
	end 'unrepresentable'
	var e = TypeEntry.make(TypeKind.intRange, name: ad.name.clone())
	e.minVal = lo
	e.maxVal = hi
	e.hasDecl = true
	e.decl = ref.clone()
	p.declTypes.insert(declKey(ref), value: allocType(p.types, e: e))
end 'declareRangeAlias'

// nestedOwnerSeparator is the dot that ends the owner's name in the name of a typealias declared in a type's body.
let nestedOwnerSeparator = 46 as Byte

// nestedAliasName is the name a typealias declared in the body of the type owner has in its module, which is how
// messages name it. No name written in a source file has a dot, so it names nothing else.
export function nestedAliasName(owner String, name String) returns String
	return "{owner}.{name}"
end 'nestedAliasName'

// nestedOwnerLength is where the dot is in the name of a nested typealias: the length of its owner's name, or none for
// a name that is not one.
function nestedOwnerLength(name String) returns table.Option with Count
	for i in 0 upto name.byteLength() 'each'
		if name.byteAt(i) == nestedOwnerSeparator 'dot'
			return table.Option.some(i)
		end 'dot'
	end 'each'
	return table.Option.none
end 'nestedOwnerLength'

// isNestedAlias is whether the name is that of a typealias declared in a type's body.
export function isNestedAlias(name String) returns bool
	return nestedOwnerLength(name).isSome()
end 'isNestedAlias'

// nestedAliasMember is the name a nested typealias is declared by in its type's body.
export function nestedAliasMember(name String) returns String
	match nestedOwnerLength(name) 'dot'
		some(n) then return name.sliceBytes(try n + 1 otherwise n, endPos: name.byteLength())
		none then return name.clone()
	end 'dot'
end 'nestedAliasMember'

// nestedVisibility is the visibility modifier a typealias has that a type's body declares with the modifier member: the
// narrower of the type's and its own, since it is named through the type.
export function nestedVisibility(owner String, member String) returns String
	if visibilityOf(member).ordinal < visibilityOf(owner).ordinal 'own'
		return member.clone()
	end 'own'
	return owner.clone()
end 'nestedVisibility'

// nestedAliasOwner is the name of the type whose body declares the typealias of the name, or none for a name that is
// no nested typealias's.
export function nestedAliasOwner(name String) returns table.Option with String
	match nestedOwnerLength(name) 'dot'
		some(n) then return table.Option.some(name.sliceBytes(0 as Count, endPos: n))
		none then return table.Option.none
	end 'dot'
end 'nestedAliasOwner'

// sizedLimitValue is the value that `name.member` is in an expression, as in `u64.max`, or none when name is no sized
// integer or member is neither of its limits.
export function sizedLimitValue(name String, member String) returns table.Option with I128
	match consumes sizedBounds(name) 'range'
		some(r) then return limitOf(r, member: member)
		none then return table.Option.none
	end 'range'
	return table.Option.none
end 'sizedLimitValue'

function limitOf(r I128Pair, member String) returns table.Option with I128
	if member == "min" 'min'
		return table.Option.some(r.lo.clone())
	end 'min'
	if member == "max" 'max'
		return table.Option.some(r.hi.clone())
	end 'max'
	return table.Option.none
end 'limitOf'
