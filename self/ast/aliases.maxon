// sizedBounds are the ranges a bound can name as, for example i64.min: the sized integer's lowest and highest value.
function sizedBounds(name String) returns table.Option with I128Pair
	return match name 'sized'
		"u8" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.fromCount(255 as Count)))
		"u16" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.fromCount(65535 as Count)))
		"u32" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.fromCount(4294967295 as Count)))
		"u64" gives table.Option.some(I128Pair.make(I128.zero(), hi: I128.u64Max()))
		"i8" gives table.Option.some(I128Pair.make(I128.fromInt(-128 as FullRangeInt), hi: I128.fromInt(127 as FullRangeInt)))
		"i16" gives table.Option.some(I128Pair.make(I128.fromInt(-32768 as FullRangeInt), hi: I128.fromInt(32767 as FullRangeInt)))
		"i32" gives table.Option.some(I128Pair.make(I128.fromInt(-2147483648 as FullRangeInt), hi: I128.fromInt(2147483647 as FullRangeInt)))
		"i64" gives table.Option.some(I128Pair.make(I128.i64Min(), hi: I128.i64Max()))
		default gives table.Option.none
	end 'sized'
end 'sizedBounds'

type I128Pair
	export var lo as I128
	export var hi as I128

	static function make(consumes lo I128, consumes hi I128) returns I128Pair
		return I128Pair{lo: lo, hi: hi}
	end 'make'
end 'I128Pair'

// sizedLimit is the value that a bound written as a sized integer's limit names, or none after it reported why it names
// none.
function sizedLimit(modID diag.ModuleID, off diag.U32, b Bound, mutates errs diag.ErrorList) returns table.Option with I128
	match consumes sizedBounds(b.sized) 'range'
		some(r) then return sizedLimitOf(modID, off: off, b: b, r: r, errs: errs)
		none then break
	end 'range'
	diag.pushSiteError(errs, code: diag.errUnknownType, message: "'{b.sized}' is not a sized integer; a bound names one of u8, u16, u32, u64, i8, i16, i32 or i64", module: modID, offset: off)
	return table.Option.none
end 'sizedLimit'

function sizedLimitOf(modID diag.ModuleID, off diag.U32, b Bound, r I128Pair, mutates errs diag.ErrorList) returns table.Option with I128
	match consumes limitOf(r, member: b.limit) 'limit'
		some(v) then return table.Option.some(v)
		none then break
	end 'limit'
	diag.pushSiteError(errs, code: diag.errUnknownField, message: "'{b.sized}.{b.limit}' is not a bound; write '{b.sized}.min' or '{b.sized}.max'", module: modID, offset: off)
	return table.Option.none
end 'sizedLimitOf'

// boundValue is the value a bound of a range alias writes, or none after it reported why the bound names none.
function boundValue(modID diag.ModuleID, tree Tree, b Bound, mutates errs diag.ErrorList) returns table.Option with I128
	var v = b.value.clone()
	if b.sized != "" 'sized'
		match consumes sizedLimit(modID, off: tree.startOf(b.id), b: b, errs: errs) 'limit'
			some(limit) then v = limit
			none then return table.Option.none
		end 'limit'
	end 'sized'
	if b.negative 'neg'
		return table.Option.some(v.neg())
	end 'neg'
	return table.Option.some(v)
end 'boundValue'

// aliasNamesInstance is whether a typealias names an instance of a generic type or a function type, as against an integer
// range: a type made of the types it names.
export function aliasNamesInstance(ad AliasDecl) returns bool
	return ad.instance != 0 or ad.fn != 0
end 'aliasNamesInstance'

// isGenericOwned is whether the typealias of the name is declared in the body of a generic type, where a range would be a
// distinct type for each instance.
function isGenericOwned(m ParsedModule, name String) returns bool
	match consumes nestedAliasOwner(name) 'owner'
		some(ownerName) then return typeParamCountOf(m, name: ownerName) > 0
		none then return false
	end 'owner'
end 'isGenericOwned'

function typeParamCountOf(m ParsedModule, name String) returns Count
	match consumes m.names.get(name) 'declared'
		some(ord) then return typeParamCountOfDecl(m.decls[ord as Count])
		none then return 0
	end 'declared'
end 'typeParamCountOf'

function typeParamCountOfDecl(d Decl) returns Count
	return match d 'k'
		typeDecl(td) gives td.typeParams.count()
		unionDecl(ud) gives ud.typeParams.count()
		funcDecl(_) gives 0
		constDecl(_) gives 0
		enumDecl(_) gives 0
		aliasDecl(_) gives 0
		interfaceDecl(ifd) gives ifd.typeParams.count()
		extensionDecl(_) gives 0
	end 'k'
end 'typeParamCountOfDecl'

// perInstanceRangeRefusal is why a ranged typealias may not be declared in a generic type, or in an extension of one.
export function perInstanceRangeRefusal(name String) returns String
	return "the ranged typealias '{name}' is declared in a generic type, where each instance would have a type of its own, which this compiler does not implement: declare it outside the type"
end 'perInstanceRangeRefusal'

// declareRangeAlias gives a typealias of a range its integer type, which is its own even where another alias has the
// same range. A typealias of an instance has none yet: its type is the instance, which the checker's aliases stage
// finds once the types it names are known.
export function declareRangeAlias(mutates ms ModuleState, p Project, ref DeclRef, ad AliasDecl, mutates errs diag.ErrorList)
	if aliasNamesInstance(ad) 'instance'
		return
	end 'instance'
	let off = ms.parsed.tree.startOf(ad.id)
	// A fault of the range is reported at the range, where maxon points.
	let rangeOff = ms.parsed.tree.aliasTypeStart(ad.id)
	if isGenericOwned(ms.parsed, name: ad.name) 'perInstance'
		diag.pushSiteError(errs, code: diag.errUnsupportedFeature, message: perInstanceRangeRefusal(ad.name), module: ref.module, offset: off)
		return
	end 'perInstance'
	if ad.high.id == (0 as NodeID) 'noHigh'
		declareBitsAlias(ms, p: p, ref: ref, ad: ad, errs: errs)
		return
	end 'noHigh'
	if ad.number == "float" 'float'
		declareFloatAlias(ms, p: p, ref: ref, ad: ad, errs: errs)
		return
	end 'float'
	if ad.number != "" 'otherNumber'
		diag.pushSiteError(errs, code: diag.errUnknownType, message: "'{ad.number}' is no number type to take a range of; write int(low to high) or float(low to high)", module: ref.module, offset: rangeOff)
		return
	end 'otherNumber'
	var lo as I128
	match consumes boundValue(ref.module, tree: ms.parsed.tree, b: ad.low, errs: errs) 'low'
		some(v) then lo = v
		none then return
	end 'low'
	var hi as I128
	match consumes boundValue(ref.module, tree: ms.parsed.tree, b: ad.high, errs: errs) 'high'
		some(v) then hi = v
		none then return
	end 'high'
	if not ad.inclusive 'exclusive'
		hi = hi.sub(I128.one())
	end 'exclusive'
	if lo.gt(hi) 'empty'
		diag.pushSiteError(errs, code: diag.errTypeMismatch, message: diag.emptyIntegerRange(lo.toString(), high: hi.toString()), module: ref.module, offset: rangeOff)
		return
	end 'empty'
	if lo.isNeg() and hi.gt(I128.i64Max()) 'unrepresentable'
		diag.pushSiteError(errs, code: diag.errTypeMismatch, message: diag.unrepresentableIntegerRange(lo.toString(), high: hi.toString()), module: ref.module, offset: rangeOff)
		return
	end 'unrepresentable'
	var e = TypeEntry.make(TypeKind.intRange, name: ad.name.clone())
	e.minVal = lo
	e.maxVal = hi
	e.hasDecl = true
	e.decl = ref.clone()
	let t = allocShell(ms.types, module: ref.module, e: e, completer: Phase.aliases)
	setDeclType(ms, ref: ref, t: t)
end 'declareRangeAlias'

// bitsKeyword is the name of a typealias of a raw bit pattern: bits(64), whose width is its only argument.
let bitsKeyword = "bits"

// legalBitWidths are the widths of a bit pattern: those a slot or a sub-byte packed field can hold.
let legalBitWidths = [1 as Count, 2 as Count, 4 as Count, 8 as Count, 16 as Count, 32 as Count, 64 as Count]

// isLegalBitWidth is whether a bits(n) typealias can have the width n.
export function isLegalBitWidth(width I128) returns bool
	for i in 0 upto legalBitWidths.count() 'each'
		if width.eq(I128.fromCount(legalBitWidths[i])) 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'isLegalBitWidth'

// boundText is a bound as it was written.
function boundText(b Bound) returns String
	var text = b.value.toString()
	if b.sized != "" 'sized'
		text = "{b.sized}.{b.limit}"
	end 'sized'
	if b.negative 'negative'
		return "-{text}"
	end 'negative'
	return text
end 'boundText'

// declareBitsAlias gives a typealias of a bit pattern its type: an unsigned integer of the pattern's width, which every
// bit pattern of that width is a value of. A range written with one argument, other than bits, is a syntax error.
function declareBitsAlias(mutates ms ModuleState, p Project, ref DeclRef, ad AliasDecl, mutates errs diag.ErrorList)
	if ad.number != bitsKeyword 'notBits'
		diag.pushSiteError(errs, code: diag.errExpectedToken, message: diag.expectedToken("'to' or 'upto'", got: ")"), module: ref.module, offset: ms.parsed.tree.startOf(ad.low.id))
		return
	end 'notBits'
	if ad.low.sized != "" or ad.low.negative or not isLegalBitWidth(ad.low.value) 'illegal'
		diag.pushSiteError(errs, code: diag.errIllegalBitWidth, message: diag.illegalBitWidth(boundText(ad.low)), module: ref.module, offset: ms.parsed.tree.startOf(ad.low.id))
		return
	end 'illegal'
	let width = ad.low.value.lo
	var e = TypeEntry.make(TypeKind.intRange, name: ad.name.clone())
	e.maxVal = I128.fromCount(u64MaxCount shr (try 64 - width otherwise 0 as Count))
	e.bitsWidth = width
	e.hasDecl = true
	e.decl = ref.clone()
	let t = allocShell(ms.types, module: ref.module, e: e, completer: Phase.aliases)
	setDeclType(ms, ref: ref, t: t)
end 'declareBitsAlias'

// declareFloatAlias gives a typealias of a float range its type, whose bounds are doubles: a float or an integer
// literal, or the limit of f64 or f32.
function declareFloatAlias(mutates ms ModuleState, p Project, ref DeclRef, ad AliasDecl, mutates errs diag.ErrorList)
	// A fault of the range is reported at the range, where maxon points.
	let rangeOff = ms.parsed.tree.aliasTypeStart(ad.id)
	if not ad.inclusive 'exclusive'
		diag.pushSiteError(errs, code: diag.errTypeMismatch, message: "a float range includes its upper bound: write 'to' in place of 'upto'", module: ref.module, offset: rangeOff)
		return
	end 'exclusive'
	var lo = 0 as Count
	match floatBound(ref.module, tree: ms.parsed.tree, b: ad.low, errs: errs) 'low'
		some(v) then lo = v
		none then return
	end 'low'
	var hi = 0 as Count
	match floatBound(ref.module, tree: ms.parsed.tree, b: ad.high, errs: errs) 'high'
		some(v) then hi = v
		none then return
	end 'high'
	if floatCompare(lo, b: hi) == FloatOrder.greater 'empty'
		diag.pushSiteError(errs, code: diag.errTypeMismatch, message: "the range float({floatDiagnosticText(lo)} to {floatDiagnosticText(hi)}) is empty: its lower bound is above its upper bound", module: ref.module, offset: rangeOff)
		return
	end 'empty'
	var e = TypeEntry.make(TypeKind.floatRange, name: ad.name.clone())
	e.minVal = I128.fromCount(lo)
	e.maxVal = I128.fromCount(hi)
	e.hasDecl = true
	e.decl = ref.clone()
	let t = allocShell(ms.types, module: ref.module, e: e, completer: Phase.aliases)
	setDeclType(ms, ref: ref, t: t)
end 'declareFloatAlias'

// floatBound is the double a bound of a float range writes, or none after it reported why it names none. A bound that
// is no float literal is an integer literal, whose double it is; both read 0 for 0.
function floatBound(modID diag.ModuleID, tree Tree, b Bound, mutates errs diag.ErrorList) returns table.Option with Count
	var bits = b.real.lo
	if b.sized != "" 'sized'
		let limit = floatMaxBits if b.sized == "f64" else f32MaxBits
		if (b.sized != "f64" and b.sized != "f32") or (b.limit != "min" and b.limit != "max") 'unknown'
			diag.pushSiteError(errs, code: diag.errUnknownField, message: "'{b.sized}.{b.limit}' is not a bound of a float range; write f64.min, f64.max, f32.min or f32.max", module: modID, offset: tree.startOf(b.id))
			return table.Option.none
		end 'unknown'
		bits = limit if b.limit == "max" else floatNegate(limit)
	end 'sized' else if bits == 0 'integer'
		bits = floatFromInt(b.value)
	end 'integer'
	if b.negative 'neg'
		return table.Option.some(floatNegate(bits))
	end 'neg'
	return table.Option.some(bits)
end 'floatBound'

// nestedOwnerSeparator is the dot that ends the owner's name in the name of a typealias declared in the body of a type or in
// an extension.
let nestedOwnerSeparator = 46 as Byte

// nestedAliasName is the name a typealias declared in the body of the type owner, or in an extension of it, has in its
// module, which is how messages name it. No name written in a source file has a dot, so it names nothing else. An
// extension spells its owner as it names the type, with the module in front where it has one.
export function nestedAliasName(owner String, name String) returns String
	return "{owner}.{name}"
end 'nestedAliasName'

// extensionOwnerName is the name an extension's nested typealiases are filed under: the type it extends, as it writes it.
export function extensionOwnerName(t Tree, xd ExtensionDecl) returns String
	if xd.isInt 'integer'
		return "int"
	end 'integer'
	var buf = ByteArray.create(0)
	let qualRef = typeRefQualifierRef(t, id: xd.target)
	for i in 0 upto t.listLen(qualRef) 'qualifiers'
		buf.append(t.nameAt(t.listAt(qualRef, index: i)).toByteArray())
		buf.push(nestedOwnerSeparator)
	end 'qualifiers'
	buf.append(typeRefName(t, id: xd.target).toByteArray())
	return String.from(buf)
end 'extensionOwnerName'

// nestedOwnerLength is where the last dot is in the name of a nested typealias: the length of its owner's name, or none for
// a name that is not one.
function nestedOwnerLength(name String) returns table.Option with Count
	var last as table.Option with Count
	last = table.Option.none
	for i in 0 upto name.byteLength() 'each'
		if name.byteAt(i) == nestedOwnerSeparator 'dot'
			last = table.Option.some(i)
		end 'dot'
	end 'each'
	return last
end 'nestedOwnerLength'

// nestedMembers adds to out the typealiases that the body of the type owner, or an extension of it, declares in the module
// declaring, by the name the owner's code writes, as far as code of the module from may name them.
export function nestedMembers(p Project, declaring diag.ModuleID, owner String, from diag.ModuleID, mutates out DeclRefIndex)
	if declaring == diag.stdlibID 'std'
		addNestedMembers(p, declaring: declaring, nested: p.stdlib.nested, owner: owner, from: from, out: out)
		return
	end 'std'
	addNestedMembers(p, declaring: declaring, nested: p.modules[modIndex(declaring)].nested, owner: owner, from: from, out: out)
end 'nestedMembers'

function addNestedMembers(p Project, declaring diag.ModuleID, nested NestedAliasList, owner String, from diag.ModuleID, mutates out DeclRefIndex)
	for i in 0 upto nested.count() 'each'
		if nested[i].owner != owner 'other'
			continue 'each'
		end 'other'
		let ref = DeclRef.make(declaring, ordinal: nested[i].ordinal)
		if declaring == from or isVisibleFrom(p, v: declLevel(p, ref: ref), owner: declaring, from: from) 'seen'
			out.insert(nested[i].member.clone(), value: ref)
		end 'seen'
	end 'each'
end 'addNestedMembers'

// declaresAliasNode is whether the declaration is a type whose body declares the typealias with the node id.
export function declaresAliasNode(d Decl, id NodeID) returns bool
	return match d 'k'
		typeDecl(td) gives bodyHasAlias(td.aliases, id: id)
		interfaceDecl(ifd) gives bodyHasAlias(ifd.aliases, id: id)
		funcDecl(_) gives false
		constDecl(_) gives false
		enumDecl(_) gives false
		unionDecl(_) gives false
		aliasDecl(_) gives false
		extensionDecl(_) gives false
	end 'k'
end 'declaresAliasNode'

function bodyHasAlias(aliases AliasDeclList, id NodeID) returns bool
	for i in 0 upto aliases.count() 'each'
		if aliases[i].id == id 'hit'
			return true
		end 'hit'
	end 'each'
	return false
end 'bodyHasAlias'

// isNestedAlias is whether the name is that of a typealias declared in a type's body.
export function isNestedAlias(name String) returns bool
	return nestedOwnerLength(name).isSome()
end 'isNestedAlias'

// nestedAliasMember is the name a nested typealias is declared by in its type's body.
export function nestedAliasMember(name String) returns borrowed String
	match nestedOwnerLength(name) 'dot'
		some(n) then return name.sliceBytes(try n + 1 otherwise n, endPos: name.byteLength())
		none then return name
	end 'dot'
end 'nestedAliasMember'

// nestedVisibility is the visibility modifier a typealias has that a type's body declares with the modifier member: the
// narrower of the type's and its own, since it is named through the type.
export function nestedVisibility(owner String, member String) returns String
	if visibilityOf(member).ordinal < visibilityOf(owner).ordinal 'own'
		return member.clone()
	end 'own'
	return owner.clone()
end 'nestedVisibility'

// nestedAliasOwner is the name of the type whose body declares the typealias of the name, or none for a name that is
// no nested typealias's.
export function nestedAliasOwner(name String) returns table.Option with String
	match nestedOwnerLength(name) 'dot'
		some(n) then return table.Option.some(name.sliceBytes(0 as Count, endPos: n).clone())
		none then return table.Option.none
	end 'dot'
end 'nestedAliasOwner'

// sizedLimitValue is the value that `name.member` is in an expression, as in `u64.max`, or none when name is no sized
// integer or member is neither of its limits.
export function sizedLimitValue(name String, member String) returns table.Option with I128
	match consumes sizedBounds(name) 'range'
		some(r) then return limitOf(r, member: member)
		none then return table.Option.none
	end 'range'
	return table.Option.none
end 'sizedLimitValue'

function limitOf(r I128Pair, member String) returns table.Option with I128
	if member == "min" 'min'
		return table.Option.some(r.lo.clone())
	end 'min'
	if member == "max" 'max'
		return table.Option.some(r.hi.clone())
	end 'max'
	return table.Option.none
end 'limitOf'
