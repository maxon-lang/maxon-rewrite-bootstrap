export enum PatternKind
	patLiteral
	patRange
	patCase
end 'PatternKind'

export enum ArmKind
	armThen
	armGives
	armPanic
end 'ArmKind'

export enum NameKind
	nameUnresolved
	nameLocal
	nameConst
	nameSelfField
	nameFunc
end 'NameKind'

export enum CallKind
	callUnresolved
	callFunction
	callMethod
	callStatic
	callUnionCtor
	callPrint
	callPrintError
	callCopy
	callBound
	callValue
	// callSend is a message to a service through its handle: fn is the handler, the export method of the service's type,
	// and body the behaviour that runs it on the service's state.
	callSend
end 'CallKind'

export enum MemberKind
	memberUnresolved
	memberField
	memberEnumCase
	memberUnionCase
	memberEnumName
	memberEnumOrdinal
	memberEnumRaw
	memberUnionName
	memberUnionOrdinal
	memberUnionRaw
	// memberRawField is a field of the raw value of an enum or a union value, read as the value's own: `op.latency` is
	// `op.rawValue.latency`.
	memberRawField
	// The member case kinds read the name, the ordinal, the raw value or a field of the raw value of the case that a union type
	// names (`Op.mul.latency`), which has a payload, so that no value of it is made: the case is the tag.
	memberCaseName
	memberCaseOrdinal
	memberCaseRaw
	memberCaseRawField
	memberAllCases
	memberAllCaseNames
	memberLimit
	// memberView is a view of a built-in generic value (`xs.managed`): the value itself, as an instance of another type.
	memberView
end 'MemberKind'

// memberOfType is whether a member is read from a type that the expression names, never from a value, so there is no
// object to evaluate.
export function memberOfType(kind MemberKind) returns bool
	return kind == MemberKind.memberEnumCase or kind == MemberKind.memberUnionCase or kind == MemberKind.memberAllCases or kind == MemberKind.memberAllCaseNames or kind == MemberKind.memberLimit or kind == MemberKind.memberCaseName or kind == MemberKind.memberCaseOrdinal or kind == MemberKind.memberCaseRaw or kind == MemberKind.memberCaseRawField
end 'memberOfType'

export let failNone = 0 as Byte

export let failOverflow = 1 as Byte

export let failDivZero = 2 as Byte

export let failShift = 4 as Byte

export let failRange = 8 as Byte

export let failArithmetic = 7 as Byte

// failBelow is a result below the minimum of its type that the word still holds.
export let failBelow = 16 as Byte

// failAbove is a result above the maximum of its type that the word still holds.
export let failAbove = 32 as Byte

export type ArithInfo
	export var operand as TypeID
	export var word as TypeID
	export var fails as Byte
	export var unreached as bool
	export var checkedFail as bool

	export static function make(operand TypeID, word TypeID, fails Byte, unreached bool, checkedFail bool) returns ArithInfo
		return ArithInfo{operand: operand, word: word, fails: fails, unreached: unreached, checkedFail: checkedFail}
	end 'make'
end 'ArithInfo'

export type NameInfo
	export var kind as NameKind
	export var local as LocalID
	export var hasDecl as bool
	export var decl as DeclRef
	export var fieldName as String
	export var fieldIndex as Count
	// func is the function that a name used as a value stands for.
	export var func as FuncID

	export static function localName(local LocalID) returns NameInfo
		return NameInfo{kind: NameKind.nameLocal, local: local, hasDecl: false, decl: DeclRef.make(0 as diag.ModuleID, ordinal: 0 as DeclOrdinal), fieldName: "", fieldIndex: 0 as Count, func: noFunc}
	end 'localName'

	export static function constName(consumes decl DeclRef) returns NameInfo
		return NameInfo{kind: NameKind.nameConst, local: noLocal, hasDecl: true, decl: decl, fieldName: "", fieldIndex: 0 as Count, func: noFunc}
	end 'constName'

	export static function selfFieldName(consumes fieldName String, fieldIndex Count) returns NameInfo
		return NameInfo{kind: NameKind.nameSelfField, local: noLocal, hasDecl: false, decl: DeclRef.make(0 as diag.ModuleID, ordinal: 0 as DeclOrdinal), fieldName: fieldName, fieldIndex: fieldIndex, func: noFunc}
	end 'selfFieldName'

	// funcName is a function named as a value, which it is not called where it is named.
	export static function funcName(consumes decl DeclRef, func FuncID) returns NameInfo
		return NameInfo{kind: NameKind.nameFunc, local: noLocal, hasDecl: true, decl: decl, fieldName: "", fieldIndex: 0 as Count, func: func}
	end 'funcName'
end 'NameInfo'

export type MemberInfo
	export var kind as MemberKind
	export var hasMethod as bool
	export var method as FuncID
	export var ownerTy as TypeID
	export var fieldIndex as Count
	export var enumCase as Count
	export var typeArgs as TypeIDList

	export static function make(kind MemberKind, ownerTy TypeID) returns MemberInfo
		return MemberInfo{kind: kind, hasMethod: false, method: noFunc, ownerTy: ownerTy, fieldIndex: 0 as Count, enumCase: 0 as Count, typeArgs: TypeIDList.create(0)}
	end 'make'
end 'MemberInfo'

export type CallInfo
	export var kind as CallKind
	export var fn as FuncID
	export var typeArgs as TypeIDList
	export var paramSpecs as ParamSpecList
	export var selfConv as Convention
	export var receiverTy as TypeID
	export var ordered as NodeIDList
	export var method as FuncID
	export var unionTy as TypeID
	export var unionCase as Count
	export var hasDrop as bool
	export var dropFn as FuncID
	export var dropOrdered as NodeIDList
	export var intrinsic as Intrinsic
	// result is the callee's: whether the call gives a value or a place it borrows from the arguments.
	export var result as ResultConv
	// body is, for a send or a spawn whose factory runs on the service, the function of the behaviour that runs it there.
	export var body as FuncID
	// replyKept is, for a send whose handler replies, whether the sender keeps the reply as a promise; a send discarded
	// with `_ =` drops it on the service.
	export var replyKept as bool

	export static function make(kind CallKind, fn FuncID, receiverTy TypeID) returns CallInfo
		return CallInfo{kind: kind, fn: fn, typeArgs: TypeIDList.create(0), paramSpecs: ParamSpecList.create(0), selfConv: Convention.convLet, receiverTy: receiverTy, ordered: NodeIDList.create(0), method: noFunc, unionTy: noType, unionCase: 0 as Count, hasDrop: false, dropFn: noFunc, dropOrdered: NodeIDList.create(0), intrinsic: Intrinsic.intrNone, result: ResultConv.resultOwned, body: noFunc, replyKept: false}
	end 'make'
end 'CallInfo'

// IterationInfo is how a for walks a value of a type that declares maxon's iteration protocol: the call that makes a
// cursor of the collection, when the collection is not one itself, and the calls that read the cursor's element and
// move it on, which throw IterationError where there is none.
export type IterationInfo
	export var hasFactory as bool
	export var factory as CallInfo
	export var current as CallInfo
	export var advance as CallInfo
	export var cursorTy as TypeID

	export static function make(cursorTy TypeID, consumes current CallInfo, consumes advance CallInfo) returns IterationInfo
		return IterationInfo{hasFactory: false, factory: CallInfo.make(CallKind.callMethod, fn: noFunc, receiverTy: noType), current: current, advance: advance, cursorTy: cursorTy}
	end 'make'

	// calls are the calls a loop makes, the factory first where there is one.
	export function calls() returns CallInfoList
		var out = CallInfoList.create(0)
		if hasFactory 'factory'
			out.push(factory.clone())
		end 'factory'
		out.push(current.clone())
		out.push(advance.clone())
		return out
	end 'calls'
end 'IterationInfo'

export typealias CallInfoList = Array with CallInfo

export type StructLitInfo
	export var ty as TypeID
	// ordered are the value expressions of the fields in the order of the record's fields; a field the literal leaves to
	// its default has none (the node 0).
	export var ordered as NodeIDList

	export static function make(ty TypeID, consumes ordered NodeIDList) returns StructLitInfo
		return StructLitInfo{ty: ty, ordered: ordered}
	end 'make'
end 'StructLitInfo'

export type PatternInfo
	export var kind as PatternKind
	export var caseIdx as Count
	export var bindings as LocalIDList
	export var hasConstInt as bool
	export var constVal as I128

	export static function makeCase(caseIdx Count, consumes bindings LocalIDList) returns PatternInfo
		return PatternInfo{kind: PatternKind.patCase, caseIdx: caseIdx, bindings: bindings, hasConstInt: false, constVal: I128.zero()}
	end 'makeCase'

	// makeValue is a pattern that matches a value or a range of values, which binds nothing.
	export static function makeValue(kind PatternKind) returns PatternInfo
		return PatternInfo{kind: kind, caseIdx: 0 as Count, bindings: LocalIDList.create(0), hasConstInt: false, constVal: I128.zero()}
	end 'makeValue'
end 'PatternInfo'

export type Capture
	export var name as String
	export var refNode as NodeID
	export var outerLocal as LocalID
	export var innerLocal as LocalID
	export var conv as Convention

	export static function make(consumes name String, refNode NodeID, outerLocal LocalID, innerLocal LocalID, conv Convention) returns Capture
		return Capture{name: name, refNode: refNode, outerLocal: outerLocal, innerLocal: innerLocal, conv: conv}
	end 'make'
end 'Capture'

export typealias CaptureList = Array with Capture

// behaviourSuffix joins the name of a function to the number of a behaviour body in it.
export let behaviourSuffix = "$when"

// behaviourName is the name of the function that a behaviour's body becomes, numbered in the order the bodies are met in
// the enclosing function.
export function behaviourName(enclosing String, index Count) returns String
	return "{enclosing}{behaviourSuffix}{index}"
end 'behaviourName'

export type WhenInfo
	export var fn as FuncID
	export var cowns as TypeIDList
	export var captures as CaptureList
	export var dropFuncs as FuncIDList

	export static function new() returns WhenInfo
		return WhenInfo{fn: noFunc, cowns: TypeIDList.create(0), captures: CaptureList.create(0), dropFuncs: FuncIDList.create(0)}
	end 'new'
end 'WhenInfo'

// receiverName is the name a method's receiver is bound by, which is how a closure in the method captures it.
export let receiverName = "self"

// closureSuffix joins the name of a function to the number of a closure in it.
export let closureSuffix = "$fn"

// closureName is the name of the function that a closure's body becomes, numbered in the order the closures are met in the
// enclosing function.
export function closureName(enclosing String, index Count) returns String
	return "{enclosing}{closureSuffix}{index}"
end 'closureName'

// ClosureInfo is what the check found of a closure: the function its body is, its function type, and what it captures. A
// capture whose convention is consumes moves into the closure, or is copied when it is a scalar; one whose convention is
// let is a value the code around the closure only borrows, which the closure borrows too; and one whose convention is
// mutates is a variable that a mutating closure borrows to change.
export type ClosureInfo
	export var fn as FuncID
	export var ty as TypeID
	export var captures as CaptureList

	export static function make(fn FuncID, ty TypeID, consumes captures CaptureList) returns ClosureInfo
		return ClosureInfo{fn: fn, ty: ty, captures: captures}
	end 'make'
end 'ClosureInfo'

export typealias NodeClosureMap = table.IntMap with ClosureInfo

export typealias NodeDeclMap = table.IntMap with DeclRef

export typealias NodeModMap = table.IntMap with diag.ModuleID

export typealias NodeBoolMap = table.IntMap with bool

export typealias NodeStrMap = table.IntMap with String

export typealias NodeStrListMap = table.IntMap with StringList

// NodeTypes is the type of each node, indexed by the node as Go's Typing.types is, so that a lookup is an index and no
// hash; noType is a node the checker never typed, which no type the checker gives is.
export type NodeTypes
	var entries as TypeIDList

	export static function new() returns Self
		return Self{entries: TypeIDList.create(0)}
	end 'new'

	export function at(key Count) returns TypeID
		if key >= entries.count() 'past'
			return noType
		end 'past'
		return entries[key]
	end 'at'

	export function get(key Count) returns table.Option with TypeID
		let t = self.at(key)
		if t == noType 'untyped'
			return table.Option.none
		end 'untyped'
		return table.Option.some(t)
	end 'get'

	export function insert(mutates self, key Count, value TypeID)
		while entries.count() <= key 'grow'
			entries.push(noType)
		end 'grow'
		entries[key] = value
	end 'insert'
end 'NodeTypes'

export typealias NodeArithMap = table.IntMap with ArithInfo

export typealias NodeNameMap = table.IntMap with NameInfo

export typealias NodeMemberMap = table.IntMap with MemberInfo

export typealias NodeCallMap = table.IntMap with CallInfo

export typealias NodeStructLitMap = table.IntMap with StructLitInfo

export typealias NodePatternMap = table.IntMap with PatternInfo

export typealias NodeArmMap = table.IntMap with ArmKind

export typealias NodeWhenMap = table.IntMap with WhenInfo

export typealias NodeIterationMap = table.IntMap with IterationInfo

export typealias NodeLocalMap = table.IntMap with LocalID

// NodeExpansionMap holds the statements that a destructuring or a tuple assignment is made of, which the check makes up: a
// let for the tuple where it is not a variable, and then one let or assignment for each element, in the order that they run.
export typealias NodeExpansionMap = table.IntMap with NodeIDList

export typealias NodeLocalListMap = table.IntMap with LocalIDList

export type ModuleDep
	export var module as diag.ModuleID
	export var offset as diag.U32

	export static function make(module diag.ModuleID, offset diag.U32) returns ModuleDep
		return ModuleDep{module: module, offset: offset}
	end 'make'
end 'ModuleDep'

export typealias ModuleDepList = Array with ModuleDep

export typealias NodeSlotMap = table.IntMap with Count

// UnboundName is a name written without a module that no declaration of the module or built-in has: a name of another module
// that the source has not qualified, which the qualify command qualifies, or a name the checker refuses.
export type UnboundName
	export var name as String
	export var offset as diag.U32

	export static function make(consumes name String, offset diag.U32) returns UnboundName
		return UnboundName{name: name, offset: offset}
	end 'make'
end 'UnboundName'

export typealias UnboundNameList = Array with UnboundName

// MemberRef is a type written as Owner.member, a typealias that the declaration of a type, or an extension of it, declares: the
// resolver notes the type and the name, and the check finds the typealias once it knows which extensions the module sees.
export type MemberRef
	export var node as NodeID
	export var owner as DeclRef
	export var member as String

	export static function make(node NodeID, consumes owner DeclRef, consumes member String) returns MemberRef
		return MemberRef{node: node, owner: owner, member: member}
	end 'make'
end 'MemberRef'

export typealias MemberRefList = Array with MemberRef

export type Resolution
	export var module as diag.ModuleID
	export var decls as NodeDeclMap
	export var modules as NodeModMap
	export var becomeNames as NodeBoolMap
	export var typeParams as TypeParamList
	export var typeParamSlots as NodeSlotMap
	// extParams gives for an extension, by its node, the slot of the first of the type parameters it takes from the type it
	// extends: one for each parameter of that type, in order, each with a node of its own that the extension's code names it by.
	export var extParams as NodeSlotMap
	export var deps as ModuleDepList
	export var depSeen as NodeBoolMap
	export var captures as NodeStrListMap
	export var unbound as UnboundNameList
	export var memberRefs as MemberRefList

	export static function new(module diag.ModuleID) returns Resolution
		let dm = NodeDeclMap.new()
		let mm = NodeModMap.new()
		let bm = NodeBoolMap.new()
		let tps = TypeParamList.create(0)
		let tpsm = NodeSlotMap.new()
		let eps = NodeSlotMap.new()
		let ds = NodeBoolMap.new()
		let cm = NodeStrListMap.new()
		return Resolution{module: module, decls: dm, modules: mm, becomeNames: bm, typeParams: tps, typeParamSlots: tpsm, extParams: eps, deps: ModuleDepList.create(0), depSeen: ds, captures: cm, unbound: UnboundNameList.create(0), memberRefs: MemberRefList.create(0)}
	end 'new'

	export function addTypeParam(mutates self, consumes tp TypeParam) returns Count
		let slot = typeParams.count()
		typeParams.push(tp)
		return slot
	end 'addTypeParam'

	export function bindTypeParam(mutates self, node NodeID, slot Count)
		typeParamSlots.insert(node as Count, value: slot)
	end 'bindTypeParam'

	export function bindDecl(mutates self, node NodeID, consumes d DeclRef)
		decls.insert(node as Count, value: d)
	end 'bindDecl'

	export function addDep(mutates self, dep diag.ModuleID, offset diag.U32)
		if dep == module or dep == diag.stdlibID 'skip'
			return
		end 'skip'
		let key = dep as Count
		if depSeen.has(key) 'dup'
			return
		end 'dup'
		depSeen.insert(key, value: true)
		let entry = ModuleDep.make(dep, offset: offset)
		deps.push(entry)
		// Keep deps ascending by module ID for deterministic Graph order
		var i = deps.count()
		while i > 1 'ins'
			let cur = try i - 1 otherwise 0 as Count
			let prev = try i - 2 otherwise 0 as Count
			if deps[cur].module < deps[prev].module 'swap'
				let tmp = deps[cur].clone()
				deps[cur] = deps[prev].clone()
				deps[prev] = tmp
				i = cur
			end 'swap' else 'done'
				break 'ins'
			end 'done'
		end 'ins'
	end 'addDep'
end 'Resolution'

export typealias NodeJumpMap = table.IntMap with NodeID

export typealias NodeIDList = Array with NodeID

export typealias NodeUsesMap = table.IntMap with NodeIDList

// NodeBoxMap is, for each expression whose value is put in an interface value, the interface.
export typealias NodeBoxMap = table.IntMap with TypeID

// expansionOf is the statements that the check made a destructuring or a tuple assignment out of, in the order they run.
export function expansionOf(tp Typing, node NodeID) returns NodeIDList
	return match consumes tp.expansions.get(node as Count) 'hit'
		some(steps) gives steps
		none panic("ast: the statement at node {node} was checked into no statements")
	end 'hit'
end 'expansionOf'

export type Typing
	export var module as diag.ModuleID
	export var types as NodeTypes
	export var arith as NodeArithMap
	export var names as NodeNameMap
	export var members as NodeMemberMap
	export var calls as NodeCallMap
	export var structLits as NodeStructLitMap
	export var patterns as NodePatternMap
	export var arms as NodeArmMap
	export var whens as NodeWhenMap
	export var closures as NodeClosureMap
	export var iterations as NodeIterationMap
	export var jumps as NodeJumpMap
	export var locals as LocalEntryList
	export var nodeLocals as NodeLocalMap
	// indexes are the variables that the `for (i, x) in xs.enumerated()` loops bind the index of each element to, by loop.
	export var indexes as NodeLocalMap
	export var expansions as NodeExpansionMap
	export var funcLocals as NodeLocalListMap
	export var funcUses as NodeUsesMap
	export var fieldUses as NodeUsesMap
	export var consumed as NodeBoolMap
	// boxes are the expressions whose value goes where an interface value is expected, each with that interface: the value
	// moves into the box of an interface value there, or the box lends it where the place only borrows.
	export var boxes as NodeBoxMap
	// declared is whether the declare stage reached the module, which is what gives its nodes their results: a module that it
	// did not reach has none.
	export var declared as bool

	export static function new(module diag.ModuleID) returns Typing
		var ls = LocalEntryList.create(0)
		ls.push(LocalEntry.make("<invalid>", ty: noType, isVar: false, isParam: false, conv: Convention.convLet, definedAt: 0 as NodeID))
		let tm = NodeTypes.new()
		let am = NodeArithMap.new()
		let nm = NodeNameMap.new()
		let mm = NodeMemberMap.new()
		let cm = NodeCallMap.new()
		let sm = NodeStructLitMap.new()
		let pm = NodePatternMap.new()
		let ak = NodeArmMap.new()
		let wm = NodeWhenMap.new()
		let clm = NodeClosureMap.new()
		let im = NodeIterationMap.new()
		let jm = NodeJumpMap.new()
		let nlm = NodeLocalMap.new()
		let ixm = NodeLocalMap.new()
		let exm = NodeExpansionMap.new()
		let flm = NodeLocalListMap.new()
		let fum = NodeUsesMap.new()
		let fdum = NodeUsesMap.new()
		let con = NodeBoolMap.new()
		let bx = NodeBoxMap.new()
		return Typing{module: module, types: tm, arith: am, names: nm, members: mm, calls: cm, structLits: sm, patterns: pm, arms: ak, whens: wm, closures: clm, iterations: im, jumps: jm, locals: ls, nodeLocals: nlm, indexes: ixm, expansions: exm, funcLocals: flm, funcUses: fum, fieldUses: fdum, consumed: con, boxes: bx, declared: false}
	end 'new'

	export function allocLocal(mutates self, consumes entry LocalEntry) returns LocalID
		let id = try locals.count() as LocalID otherwise panic("too many locals")
		var e = entry
		e.id = id
		locals.push(e)
		return id
	end 'allocLocal'
end 'Typing'

export function setNodeType(mutates tp Typing, node NodeID, ty TypeID)
	tp.types.insert(node as Count, value: ty)
end 'setNodeType'

// boxedTo is the interface that the value of node is put in an interface value of, or none.
export function boxedTo(tp Typing, node NodeID) returns TypeID
	return match tp.boxes.get(node as Count) 'box'
		some(iface) gives iface
		none gives noType
	end 'box'
end 'boxedTo'

export function nodeType(tp Typing, node NodeID) returns TypeID
	return tp.types.at(node as Count)
end 'nodeType'
