function storeStringMapOfFuncID(mutates w table.CacheWriter, v table.StringMap with FuncID)
	let slots = v.capacity()
	w.word64(slots as table.Word64)
	for i in 0 upto slots 'states'
		w.word8(v.stateAt(i) as table.Word64)
	end 'states'
	for i in 0 upto slots 'entries'
		if table.mapSlotOccupied(v.stateAt(i)) 'occupied'
			w.text(v.keyAt(i))
			w.word64(v.valueAt(i) as table.Word64)
		end 'occupied'
	end 'entries'
	w.word64(v.count() as table.Word64)
	w.word64(v.usedSlots() as table.Word64)
end 'storeStringMapOfFuncID'

function loadStringMapOfFuncID(mutates r table.CacheReader) returns table.StringMap with FuncID
	let slots = r.items()
	var states = ByteArray.create(0)
	for _ in 0 upto slots 'states'
		states.push(try (r.word8() as Byte) otherwise panic("cache: a stored state of a map is no byte"))
	end 'states'
	var keys as Array with String
	keys = Array.create(0)
	var values as Array with FuncID
	values = Array.create(0)
	for i in 0 upto slots 'entries'
		if table.mapSlotOccupied(states[i] as Count) 'occupied'
			keys.push(r.text())
			values.push(try (r.word64() as FuncID) otherwise panic("cache: a stored FuncID is out of its range"))
		end 'occupied' else 'free'
			keys.push("")
		end 'free'
	end 'entries'
	let length = r.word64() as Count
	let used = r.word64() as Count
	return table.StringMap.restored(states, keys: keys, values: values, length: length, used: used)
end 'loadStringMapOfFuncID'

function storeStructLitInfo(mutates w table.CacheWriter, v StructLitInfo)
