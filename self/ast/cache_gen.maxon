		let theModule = try (r.int64() as diag.ModuleID) otherwise panic("cache: a stored diag.ModuleID is out of its range")
		let theNodeID = try (r.word32() as NodeID) otherwise panic("cache: a stored NodeID is out of its range")
		let theIsStatic = r.flag()
		let theIsDestructor = r.flag()
		let theHasReceiver = r.flag()
		let theIsClosure = r.flag()
		let theOwnerTy = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theSelfConv = Convention.allCases[r.word8() as Count]
		let theGenerics = loadArrayOfTypeID(r)
		let theBounds = loadArrayOfParamBound(r)
		let theParams = loadArrayOfParamSpec(r)
		let theParamTypes = loadArrayOfTypeID(r)
		let theRetTy = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theResult = ResultConv.allCases[r.word8() as Count]
		let theLendsPlace = r.flag()
		let theErrTy = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theGenericOrigin = try (r.word64() as FuncID) otherwise panic("cache: a stored FuncID is out of its range")
		let theTypeArgs = loadArrayOfTypeID(r)
		let theWitnesses = loadArrayOfWitness(r)
		let theIntrinsic = Intrinsic.allCases[r.word16() as Count]
		let theLinkName = r.text()
		let theBodyRef = try (r.word32() as diag.U32) otherwise panic("cache: a stored diag.U32 is out of its range")
		let theIsTest = r.flag()
		let theExtendedIface = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theConditionalBounds = r.word64() as Count
		return FuncEntry{id: theId, name: theName, visibility: theVisibility, hasDecl: theHasDecl, decl: theDecl, module: theModule, nodeID: theNodeID, isStatic: theIsStatic, isDestructor: theIsDestructor, hasReceiver: theHasReceiver, isClosure: theIsClosure, ownerTy: theOwnerTy, selfConv: theSelfConv, generics: theGenerics, bounds: theBounds, params: theParams, paramTypes: theParamTypes, retTy: theRetTy, result: theResult, lendsPlace: theLendsPlace, errTy: theErrTy, genericOrigin: theGenericOrigin, typeArgs: theTypeArgs, witnesses: theWitnesses, intrinsic: theIntrinsic, linkName: theLinkName, bodyRef: theBodyRef, isTest: theIsTest, extendedIface: theExtendedIface, conditionalBounds: theConditionalBounds}
	end 'cacheLoad'
