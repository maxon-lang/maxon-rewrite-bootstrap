function storeIntMapOfArithInfo(mutates w table.CacheWriter, v table.IntMap with ArithInfo)
	let slots = v.capacity()
	w.word64(slots as table.Word64)
	for i in 0 upto slots 'states'
		w.word8(v.stateAt(i) as table.Word64)
	end 'states'
	for i in 0 upto slots 'entries'
		if table.mapSlotOccupied(v.stateAt(i)) 'occupied'
			w.word64(v.keyAt(i) as table.Word64)
			storeArithInfo(w, v: v.valueAt(i))
		end 'occupied'
	end 'entries'
	w.word64(v.count() as table.Word64)
	w.word64(v.usedSlots() as table.Word64)
end 'storeIntMapOfArithInfo'

function loadIntMapOfArithInfo(mutates r table.CacheReader) returns table.IntMap with ArithInfo
	let slots = r.items()
	var states = ByteArray.create(0)
	for _ in 0 upto slots 'states'
		states.push(try (r.word8() as Byte) otherwise panic("cache: a stored state of a map is no byte"))
	end 'states'
	var keys as Array with Count
	keys = Array.create(0)
	var values as Array with ArithInfo
	values = Array.create(0)
	for i in 0 upto slots 'entries'
		if table.mapSlotOccupied(states[i] as Count) 'occupied'
			keys.push(r.word64() as Count)
			values.push(ArithInfo.cacheLoad(r))
		end 'occupied' else 'free'
			keys.push(0)
		end 'free'
	end 'entries'
	let length = r.word64() as Count
	let used = r.word64() as Count
	return table.IntMap.restored(states, keys: keys, values: values, length: length, used: used)
end 'loadIntMapOfArithInfo'

