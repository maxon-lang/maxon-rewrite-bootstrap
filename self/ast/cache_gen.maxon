function storeIterationInfo(mutates w table.CacheWriter, v IterationInfo)
	w.flag(v.hasFactory)
	storeCallInfo(w, v: v.factory)
	storeCallInfo(w, v: v.current)
	storeCallInfo(w, v: v.advance)
	w.word64(v.cursorTy as table.Word64)
end 'storeIterationInfo'

extension IterationInfo
	static function cacheLoad(mutates r table.CacheReader) returns IterationInfo
		let theHasFactory = r.flag()
		let theFactory = CallInfo.cacheLoad(r)
		let theCurrent = CallInfo.cacheLoad(r)
		let theAdvance = CallInfo.cacheLoad(r)
		let theCursorTy = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		return IterationInfo{hasFactory: theHasFactory, factory: theFactory, current: theCurrent, advance: theAdvance, cursorTy: theCursorTy}
	end 'cacheLoad'
end 'IterationInfo'

function storeLocalEntry(mutates w table.CacheWriter, v LocalEntry)
