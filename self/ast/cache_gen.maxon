	storeIntMapOfNameInfo(w, v: v.names)
	storeIntMapOfMemberInfo(w, v: v.members)
	storeIntMapOfCallInfo(w, v: v.calls)
	storeIntMapOfStructLitInfo(w, v: v.structLits)
	storeIntMapOfPatternInfo(w, v: v.patterns)
	storeIntMapOfArmKind(w, v: v.arms)
	storeIntMapOfWhenInfo(w, v: v.whens)
	storeIntMapOfClosureInfo(w, v: v.closures)
	storeIntMapOfIterationInfo(w, v: v.iterations)
	storeIntMapOfCallInfo(w, v: v.hooks)
	storeIntMapOfNodeID(w, v: v.jumps)
	storeArrayOfLocalEntry(w, v: v.locals)
	storeIntMapOfLocalID(w, v: v.nodeLocals)
	storeIntMapOfLocalID(w, v: v.indexes)
	storeIntMapOfBool(w, v: v.drains)
	storeIntMapOfArrayOfNodeID(w, v: v.expansions)
	storeIntMapOfArrayOfLocalID(w, v: v.funcLocals)
	storeIntMapOfArrayOfNodeID(w, v: v.funcUses)
	storeIntMapOfArrayOfNodeID(w, v: v.fieldUses)
	storeIntMapOfBool(w, v: v.consumed)
	storeIntMapOfBool(w, v: v.slotTakes)
	storeIntMapOfBool(w, v: v.lendsPlace)
	storeIntMapOfBool(w, v: v.lentTries)
	storeIntMapOfTypeID(w, v: v.boxes)
	storeIntMapOfTypeID(w, v: v.staticInstances)
	storeIntMapOfBool(w, v: v.rawReads)
	storeIntMapOfBool(w, v: v.subscripts)
	storeIntMapOfWaiting(w, v: v.waiting)
	w.flag(v.declared)
end 'storeTyping'

extension Typing
	export static function cacheLoad(mutates r table.CacheReader) returns Typing
		let theModule = try (r.int64() as diag.ModuleID) otherwise panic("cache: a stored diag.ModuleID is out of its range")
		let theTypes = NodeTypes.cacheLoad(r)
		let theArith = loadIntMapOfArithInfo(r)
		let theNames = loadIntMapOfNameInfo(r)
		let theMembers = loadIntMapOfMemberInfo(r)
		let theCalls = loadIntMapOfCallInfo(r)
		let theStructLits = loadIntMapOfStructLitInfo(r)
		let thePatterns = loadIntMapOfPatternInfo(r)
		let theArms = loadIntMapOfArmKind(r)
		let theWhens = loadIntMapOfWhenInfo(r)
		let theClosures = loadIntMapOfClosureInfo(r)
		let theIterations = loadIntMapOfIterationInfo(r)
		let theHooks = loadIntMapOfCallInfo(r)
		let theJumps = loadIntMapOfNodeID(r)
		let theLocals = loadArrayOfLocalEntry(r)
		let theNodeLocals = loadIntMapOfLocalID(r)
		let theIndexes = loadIntMapOfLocalID(r)
		let theDrains = loadIntMapOfBool(r)
		let theExpansions = loadIntMapOfArrayOfNodeID(r)
		let theFuncLocals = loadIntMapOfArrayOfLocalID(r)
		let theFuncUses = loadIntMapOfArrayOfNodeID(r)
		let theFieldUses = loadIntMapOfArrayOfNodeID(r)
		let theConsumed = loadIntMapOfBool(r)
		let theSlotTakes = loadIntMapOfBool(r)
		let theLendsPlace = loadIntMapOfBool(r)
		let theLentTries = loadIntMapOfBool(r)
		let theBoxes = loadIntMapOfTypeID(r)
		let theStaticInstances = loadIntMapOfTypeID(r)
		let theRawReads = loadIntMapOfBool(r)
		let theSubscripts = loadIntMapOfBool(r)
		let theWaiting = loadIntMapOfWaiting(r)
		let theDeclared = r.flag()
		return Typing{module: theModule, types: theTypes, arith: theArith, names: theNames, members: theMembers, calls: theCalls, structLits: theStructLits, patterns: thePatterns, arms: theArms, whens: theWhens, closures: theClosures, iterations: theIterations, hooks: theHooks, jumps: theJumps, locals: theLocals, nodeLocals: theNodeLocals, indexes: theIndexes, drains: theDrains, expansions: theExpansions, funcLocals: theFuncLocals, funcUses: theFuncUses, fieldUses: theFieldUses, consumed: theConsumed, slotTakes: theSlotTakes, lendsPlace: theLendsPlace, lentTries: theLentTries, boxes: theBoxes, staticInstances: theStaticInstances, rawReads: theRawReads, subscripts: theSubscripts, waiting: theWaiting, declared: theDeclared}
	end 'cacheLoad'
end 'Typing'

function storeWhenInfo(mutates w table.CacheWriter, v WhenInfo)
	w.word64(v.fn as table.Word64)
	storeArrayOfTypeID(w, v: v.cowns)
	storeArrayOfCapture(w, v: v.captures)
	storeArrayOfFuncID(w, v: v.dropFuncs)
end 'storeWhenInfo'

extension WhenInfo
	static function cacheLoad(mutates r table.CacheReader) returns WhenInfo
		let theFn = try (r.word64() as FuncID) otherwise panic("cache: a stored FuncID is out of its range")
		let theCowns = loadArrayOfTypeID(r)
		let theCaptures = loadArrayOfCapture(r)
		let theDropFuncs = loadArrayOfFuncID(r)
		return WhenInfo{fn: theFn, cowns: theCowns, captures: theCaptures, dropFuncs: theDropFuncs}
	end 'cacheLoad'
end 'WhenInfo'

function storeWitness(mutates w table.CacheWriter, v Witness)
	w.word64(v.paramTy as table.Word64)
	w.word64(v.ifaceTy as table.Word64)
	w.word64(v.module as table.Word64)
end 'storeWitness'

extension Witness
	static function cacheLoad(mutates r table.CacheReader) returns Witness
		let theParamTy = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theIfaceTy = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theModule = try (r.int64() as diag.ModuleID) otherwise panic("cache: a stored diag.ModuleID is out of its range")
		return Witness{paramTy: theParamTy, ifaceTy: theIfaceTy, module: theModule}
	end 'cacheLoad'
end 'Witness'
