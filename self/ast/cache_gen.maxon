function storeFuncEntry(mutates w table.CacheWriter, v FuncEntry)
	w.word64(v.id as table.Word64)
	w.text(v.name)
	w.text(v.visibility)
	w.flag(v.hasDecl)
	storeDeclRef(w, v: v.decl)
	w.word64(v.module as table.Word64)
	w.word32(v.nodeID as table.Word64)
	w.flag(v.isStatic)
	w.flag(v.isDestructor)
	w.flag(v.hasReceiver)
	w.flag(v.isClosure)
	w.word64(v.ownerTy as table.Word64)
	w.word8(v.selfConv.ordinal as table.Word64)
	storeArrayOfTypeID(w, v: v.generics)
	storeArrayOfParamBound(w, v: v.bounds)
	storeArrayOfParamSpec(w, v: v.params)
	storeArrayOfTypeID(w, v: v.paramTypes)
	w.word64(v.retTy as table.Word64)
	w.word8(v.result.ordinal as table.Word64)
	w.flag(v.lendsPlace)
	w.word64(v.errTy as table.Word64)
	w.word64(v.genericOrigin as table.Word64)
	storeArrayOfTypeID(w, v: v.typeArgs)
	storeArrayOfWitness(w, v: v.witnesses)
	w.word16(v.intrinsic.ordinal as table.Word64)
	w.text(v.linkName)
	w.word32(v.bodyRef as table.Word64)
	w.flag(v.isTest)
	w.word64(v.extendedIface as table.Word64)
	w.word64(v.conditionalBounds as table.Word64)
end 'storeFuncEntry'

extension FuncEntry
	static function cacheLoad(mutates r table.CacheReader) returns FuncEntry
		let theId = try (r.word64() as FuncID) otherwise panic("cache: a stored FuncID is out of its range")
		let theName = r.text()
