function storeTypeEntry(mutates w table.CacheWriter, v TypeEntry)
	w.word64(v.id as table.Word64)
	w.word8(v.kind.ordinal as table.Word64)
	w.text(v.name)
	w.flag(v.inferred)
	storeI128(w, v: v.minVal)
	storeI128(w, v: v.maxVal)
	w.word64(v.bitsWidth as table.Word64)
	w.flag(v.hasDecl)
	storeDeclRef(w, v: v.decl)
	w.flag(v.isNoncopyable)
	w.word64(v.origin as table.Word64)
	w.flag(v.declaring)
	storeArrayOfTypeID(w, v: v.typeParams)
	storeArrayOfTypeID(w, v: v.typeArgs)
	storeArrayOfTypeID(w, v: v.conforms)
	storeArrayOfParamBound(w, v: v.bounds)
	storeArrayOfFieldInfo(w, v: v.fields)
	storeArrayOfCaseInfo(w, v: v.cases)
	w.flag(v.hasExplicitRaw)
	w.word8(v.rawKind.ordinal as table.Word64)
	storeArrayOfMethodRef(w, v: v.methods)
	storeArrayOfFuncID(w, v: v.sigs)
	w.word64(v.boundIface as table.Word64)
	w.word64(v.dropFunc as table.Word64)
	w.word64(v.selfParam as table.Word64)
	storeArrayOfConvention(w, v: v.paramConvs)
	w.flag(v.isTuple)
	w.flag(v.mutatesCaptures)
	w.flag(v.isBrand)
	w.text(v.brandKey)
	w.word64(v.supertype as table.Word64)
	w.flag(v.mayBorrow)
	w.word64(v.family as table.Word64)
end 'storeTypeEntry'

extension TypeEntry
	static function cacheLoad(mutates r table.CacheReader) returns TypeEntry
		let theId = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theKind = TypeKind.allCases[r.word8() as Count]
		let theName = r.text()
		let theInferred = r.flag()
		let theMinVal = I128.cacheLoad(r)
		let theMaxVal = I128.cacheLoad(r)
		let theBitsWidth = r.word64() as Count
		let theHasDecl = r.flag()
		let theDecl = DeclRef.cacheLoad(r)
		let theIsNoncopyable = r.flag()
		let theOrigin = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theDeclaring = r.flag()
		let theTypeParams = loadArrayOfTypeID(r)
		let theTypeArgs = loadArrayOfTypeID(r)
		let theConforms = loadArrayOfTypeID(r)
		let theBounds = loadArrayOfParamBound(r)
		let theFields = loadArrayOfFieldInfo(r)
		let theCases = loadArrayOfCaseInfo(r)
		let theHasExplicitRaw = r.flag()
		let theRawKind = RawKind.allCases[r.word8() as Count]
		let theMethods = loadArrayOfMethodRef(r)
		let theSigs = loadArrayOfFuncID(r)
		let theBoundIface = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theDropFunc = try (r.word64() as FuncID) otherwise panic("cache: a stored FuncID is out of its range")
		let theSelfParam = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theParamConvs = loadArrayOfConvention(r)
		let theIsTuple = r.flag()
		let theMutatesCaptures = r.flag()
		let theIsBrand = r.flag()
		let theBrandKey = r.text()
		let theSupertype = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theMayBorrow = r.flag()
		let theFamily = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		return TypeEntry{id: theId, kind: theKind, name: theName, inferred: theInferred, minVal: theMinVal, maxVal: theMaxVal, bitsWidth: theBitsWidth, hasDecl: theHasDecl, decl: theDecl, isNoncopyable: theIsNoncopyable, origin: theOrigin, declaring: theDeclaring, typeParams: theTypeParams, typeArgs: theTypeArgs, conforms: theConforms, bounds: theBounds, fields: theFields, cases: theCases, hasExplicitRaw: theHasExplicitRaw, rawKind: theRawKind, methods: theMethods, sigs: theSigs, boundIface: theBoundIface, dropFunc: theDropFunc, selfParam: theSelfParam, paramConvs: theParamConvs, isTuple: theIsTuple, mutatesCaptures: theMutatesCaptures, isBrand: theIsBrand, brandKey: theBrandKey, supertype: theSupertype, mayBorrow: theMayBorrow, family: theFamily}
	end 'cacheLoad'
end 'TypeEntry'

export function storeTypeSlot(mutates w table.CacheWriter, v TypeSlot)
	w.word64(v.slot as table.Word64)
	storeArrayOfFrozenArrayOfTypeEntry(w, v: v.sealed)
	storeArrayOfArrayOfTypeEntry(w, v: v.lists)
	w.word64(v.phase as table.Word64)
	storeArrayOfCount(w, v: v.reads)
	storeArrayOfShell(w, v: v.shells)
