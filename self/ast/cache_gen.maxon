extension TypeSlot
	export static function cacheLoad(mutates r table.CacheReader) returns TypeSlot
		let theSlot = r.word64() as Count
		let theSealed = loadArrayOfFrozenArrayOfTypeEntry(r)
		let theLists = loadArrayOfArrayOfTypeEntry(r)
		let thePhase = r.word64() as Count
		let theShapeIndex = ShapeIndex.new()
		let theReads = loadArrayOfCount(r)
		let theImported = SlotList.create(0)
		let theShells = loadArrayOfShell(r)
		return TypeSlot{slot: theSlot, sealed: theSealed, lists: theLists, phase: thePhase, shapeIndex: theShapeIndex, reads: theReads, imported: theImported, shells: theShells}
	end 'cacheLoad'
end 'TypeSlot'

export function storeTyping(mutates w table.CacheWriter, v Typing)
	w.word64(v.module as table.Word64)
	storeNodeTypes(w, v: v.types)
