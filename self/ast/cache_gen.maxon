extension LocalEntry
	static function cacheLoad(mutates r table.CacheReader) returns LocalEntry
		let theId = try (r.word32() as LocalID) otherwise panic("cache: a stored LocalID is out of its range")
		let theName = r.text()
		let theTy = try (r.word64() as TypeID) otherwise panic("cache: a stored TypeID is out of its range")
		let theIsVar = r.flag()
		let theIsParam = r.flag()
		let theIsSelf = r.flag()
		let theProjected = r.flag()
		let theParamIndex = r.word64() as Count
		let theConv = Convention.allCases[r.word8() as Count]
		let theDefinedAt = try (r.word32() as NodeID) otherwise panic("cache: a stored NodeID is out of its range")
		let theIsUninitialized = r.flag()
		let theIsCapture = r.flag()
		let theCaptureConv = Convention.allCases[r.word8() as Count]
		let theSlot = try (r.int64() as SlotIndex) otherwise panic("cache: a stored SlotIndex is out of its range")
		return LocalEntry{id: theId, name: theName, ty: theTy, isVar: theIsVar, isParam: theIsParam, isSelf: theIsSelf, projected: theProjected, paramIndex: theParamIndex, conv: theConv, definedAt: theDefinedAt, isUninitialized: theIsUninitialized, isCapture: theIsCapture, captureConv: theCaptureConv, slot: theSlot}
	end 'cacheLoad'
end 'LocalEntry'

