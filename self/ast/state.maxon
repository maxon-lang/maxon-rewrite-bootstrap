// Lent is what of its module a task holds, beyond the type and function tables: what its stage writes, so that it reads
// that part of its module in its state and every other module's in the project.
export enum Lent
	// none is a module between its tasks, or work of the project as a whole.
	none
	// tables are the module's tables, which a task of the lower reads and nothing after the check writes.
	tables
	// tree adds the module's tree, which the bodies of the check rewrite, and which the check reads.
	tree
	// resolution adds the module's resolution to its tree, which the resolve makes: every later stage reads it in the project,
	// as the resolve's product.
	resolution
	// source is the module the parse makes, whole, with the tables its shells are declared in.
	source
end 'Lent'

// ModuleState is what a task of one module's stage writes: its module's slot of the type and of the function table, the
// only slots it can make or fill an entry in (sharedSlot for a task of the project); the module's tables of what its
// stages decide about its declarations; its resolution; and what else of the module its stage writes (lent). A stage takes
// it `mutates` and the project `p` as the read-only outputs of the modules it waited on, the other slots of the tables
// among them, so that nothing a stage is given lets it write another module's declarations or types. The parts are lent
// out of the project for the task and given back when it ends (lendModule, giveBack), so that the project holds them
// between tasks.
export type ModuleState
	export var module as diag.ModuleID
	export var lent as Lent
	export var types as TypeSlot
	export var funcs as FuncSlot
	export var tables as ModuleTables
	export var resolution as Resolution
	// ownTree is the module's tree when the task's stage writes it (the parse, the resolve and the bodies), and sharedTree the
	// tree it reads, frozen, when it does not: the product of the stage that made it, which other modules' tasks share. A
	// stage reads its tree, whichever it holds, through tree().
	export var ownTree as Tree
	var sharedTree as frozen with Tree
	var sharesTree as bool
	// source is the module a task of the parse makes, but for its tables, which are the state's, and parsed what the parse
	// makes of its source, which becomes the module's products when the task ends (Module.takeParsed).
	export var source as Module
	export var parsed as ParsedModule

	// idle is the state of a module between its tasks, which holds none of its parts.
	export static function idle(module diag.ModuleID) returns ModuleState
		return ModuleState{module: module, lent: Lent.none, types: TypeSlot.none(), funcs: FuncSlot.none(), tables: ModuleTables.lentOut(), resolution: Resolution.new(module), ownTree: Tree.new(module, text: ""), sharedTree: freeze(Tree.new(module, text: "")), sharesTree: false, source: Module.new(module, path: "", text: "", files: FileSpanList.create(0)), parsed: ParsedModule.new(module, text: "", files: FileSpanList.create(0))}
	end 'idle'

	// tree is the module's tree as the task's stage reads it.
	export function tree() returns borrowed Tree
		if sharesTree 'shared'
			return sharedTree
		end 'shared'
		return ownTree
	end 'tree'

	// readsSharedTree is whether the task's stage reads its module's tree as a product it shares, rather than writing its own.
	export function readsSharedTree() returns bool
		return sharesTree
	end 'readsSharedTree'

	// ofProject is the state of work of the project as a whole, which holds no module's parts: what it reads of a module, it
	// reads in the project.
	export static function ofProject() returns ModuleState
		return ModuleState.idle(diag.stdlibID)
	end 'ofProject'
end 'ModuleState'

// lendModule lends the task of the stage of phase of module the module's slots of the tables, in which it writes the
// segment of phase, and what lent says of the module. inputs are what of each slot the task waited on, which its slot's
// index of shapes takes in.
export function lendModule(mutates p Project, module diag.ModuleID, lent Lent, phase Phase, inputs Inputs) returns ModuleState
	let m = modIndex(module)
	var ms = ModuleState.idle(module)
	ms.lent = lent
	ms.types = lendTypeSlot(p.types, module: module, segment: phase.ordinal, inputs: inputs)
	ms.funcs = lendFuncSlot(p.funcs, module: module, segment: phase.ordinal)
	match lent 'lent'
		none then return ms
		tables then _ = 0
		tree then lendTree(ms, p: p, phase: phase)
		resolution then lendTree(ms, p: p, phase: phase)
		source then ms.source = exchange(p.modules[m], value: Module.new(module, path: "", text: "", files: FileSpanList.create(0)))
	end 'lent'
	if lent == Lent.source 'source'
		ms.tables = exchange(ms.source.tables, value: ModuleTables.lentOut())
	end 'source' else 'held'
		ms.tables = exchange(p.modules[m].tables, value: ModuleTables.lentOut())
	end 'held'
	ms.tables.phase = phase.ordinal
	if lent == Lent.resolution 'resolution'
		ms.resolution = thaw(p.resolutions[m])
	end 'resolution'
	return ms
end 'lendModule'

// resolutionOf is the resolution of the module of ms, which its resolve made: a product every later stage of the module
// reads in the project.
export function resolutionOf(p Project, ms ModuleState) returns borrowed Resolution
	return p.resolutions[modIndex(ms.module)]
end 'resolutionOf'

// nodeDecl is the declaration that the name or the type written at node, in the module of ms, is bound to: by the resolve,
// or, for a type written Owner.member, which the resolve leaves unbound, by the stage of the check that found the typealias
// it names.
export function nodeDecl(p Project, ms ModuleState, node Count) returns table.Option with DeclRef
	let bound = p.resolutions[modIndex(ms.module)].decls.get(node)
	if bound.isSome() 'bound'
		return bound
	end 'bound'
	return ms.tables.memberDecl(node)
end 'nodeDecl'

// lendTree gives the task of the stage of phase the tree of its module. Each stage's tree is frozen when the stage ends, its
// product, which tasks that waited on it share: a stage that reads it shares it, and one that writes it, the resolve, which
// rewrites qualified names, and the bodies, which desugar, writes a copy of it, which becomes its own product.
function lendTree(mutates ms ModuleState, p Project, phase Phase)
	let m = modIndex(ms.module)
	if phase == Phase.resolve or phase == Phase.bodies 'writes'
		ms.ownTree = thaw(p.modules[m].tree)
		return
	end 'writes'
	ms.sharedTree = share(p.modules[m].tree)
	ms.sharesTree = true
end 'lendTree'

// lendProject lends sharedSlot of the tables to work of the project as a whole, which reads every other slot and holds no
// module's parts.
export function lendProject(mutates p Project) returns ModuleState
	var ms = ModuleState.ofProject()
	let segment = laterSegment(p.types, ft: p.funcs, module: diag.stdlibID, from: Phase.project)
	ms.types = lendTypeSlot(p.types, module: diag.stdlibID, segment: segment, inputs: Inputs.new())
	ms.funcs = lendFuncSlot(p.funcs, module: diag.stdlibID, segment: segment)
	return ms
end 'lendProject'

// giveBack gives the project back what lendModule or lendProject lent.
export function giveBack(mutates p Project, consumes ms ModuleState)
	var held = ms
	returnTypeSlot(p.types, held: exchange(held.types, value: TypeSlot.none()))
	returnFuncSlot(p.funcs, held: exchange(held.funcs, value: FuncSlot.none()))
	if held.lent == Lent.none 'none'
		return
	end 'none'
	let m = modIndex(held.module)
	if held.lent == Lent.source 'source'
		held.source.takeParsed(exchange(held.parsed, value: ParsedModule.new(held.module, text: "", files: FileSpanList.create(0))))
		p.modules[m] = exchange(held.source, value: Module.new(held.module, path: "", text: "", files: FileSpanList.create(0)))
	end 'source'
	if (held.lent == Lent.tree or held.lent == Lent.resolution) and not held.sharesTree 'tree'
		p.modules[m].tree = freeze(exchange(held.ownTree, value: Tree.new(held.module, text: "")))
	end 'tree'
	held.tables.sealWritten()
	p.modules[m].tables = exchange(held.tables, value: ModuleTables.lentOut())
	if held.lent == Lent.resolution 'resolution'
		p.resolutions[m] = freeze(exchange(held.resolution, value: Resolution.new(held.module)))
	end 'resolution'
end 'giveBack'

// makeType makes a nominal type that module declares from work outside the tasks of a compile, which holds no slot of the
// tables: it lends the module's slot for the one entry.
export function makeType(mutates p Project, module diag.ModuleID, consumes e TypeEntry) returns TypeID
	let segment = outsideSegment(p.types, ft: p.funcs, module: module)
	var held = lendTypeSlot(p.types, module: module, segment: segment, inputs: Inputs.new())
	let id = allocType(held, module: module, e: e)
	keepTypeSlot(p.types, held: held)
	return id
end 'makeType'

// makeFunc makes a function that module declares from work outside the tasks of a compile, as makeType makes a type.
export function makeFunc(mutates p Project, module diag.ModuleID, consumes f FuncEntry) returns FuncID
	let segment = outsideSegment(p.types, ft: p.funcs, module: module)
	var held = lendFuncSlot(p.funcs, module: module, segment: segment)
	let id = allocFunc(held, module: module, f: f)
	keepFuncSlot(p.funcs, held: held)
	return id
end 'makeFunc'

// sealProject seals what work outside the tasks made, which a compile of the modules from first on begins with: the tables
// of the standard library and of the modules before first, and their slots and sharedSlot's (sealTables).
export function sealProject(mutates p Project, first Count)
	sealTables(p.types, ft: p.funcs, first: first)
	p.stdlib.tables.sealAll()
	for m in 0 upto first 'earlier'
		p.modules[m].tables.sealAll()
	end 'earlier'
end 'sealProject'
