// Lent is what of its module a task holds, beyond the type and function tables: what its stage writes, so that it reads
// that part of its module in its state and every other module's in the project.
export enum Lent
	// none is a module between its tasks, or work of the project as a whole.
	none
	// tables are the module's tables, which a task of the lower reads and nothing after the check writes.
	tables
	// tree adds the module's tree, which the bodies of the check rewrite, and which the check reads.
	tree
	// resolution adds the module's resolution to its tree, which the resolve makes: every later stage reads it in the project,
	// as the resolve's product.
	resolution
	// source is the module the parse makes, whole, with the tables its shells are declared in.
	source
end 'Lent'

// ModuleState is what a task of one module's stage writes: its module's slot of the type and of the function table, the
// only slots it can make or fill an entry in (sharedSlot for a task of the project); the module's tables of what its
// stages decide about its declarations; its resolution; and what else of the module its stage writes (lent). A stage takes
// it `mutates` and the project `p` as the read-only outputs of the modules it waited on, the other slots of the tables
// among them, so that nothing a stage is given lets it write another module's declarations or types. The parts are lent
// out of the project for the task and given back when it ends (lendModule, giveBack), so that the project holds them
// between tasks.
export type ModuleState
	export var module as diag.ModuleID
	export var lent as Lent
	export var types as TypeSlot
	export var funcs as FuncSlot
	export var tables as ModuleTables
	export var resolution as Resolution
	export var tree as Tree
	// source is the module a task of the parse makes, but for its tables, which are the state's.
	export var source as Module

	// idle is the state of a module between its tasks, which holds none of its parts.
	export static function idle(module diag.ModuleID) returns ModuleState
		return ModuleState{module: module, lent: Lent.none, types: TypeSlot.none(), funcs: FuncSlot.none(), tables: ModuleTables.lentOut(), resolution: Resolution.new(module), tree: Tree.new(module, text: ""), source: Module.new(module, path: "", text: "", files: FileSpanList.create(0))}
	end 'idle'

	// ofProject is the state of work of the project as a whole, which holds no module's parts: what it reads of a module, it
	// reads in the project.
	export static function ofProject() returns ModuleState
		return ModuleState.idle(diag.stdlibID)
	end 'ofProject'
end 'ModuleState'

// lendModule lends the task of the stage of phase of module the module's slots of the tables, in which it writes the
// segment of phase, and what lent says of the module. inputs are what of each slot the task waited on, which its slot's
// index of shapes takes in.
export function lendModule(mutates p Project, module diag.ModuleID, lent Lent, phase Phase, inputs Inputs) returns ModuleState
	let m = modIndex(module)
	var ms = ModuleState.idle(module)
	ms.lent = lent
	ms.types = lendTypeSlot(p.types, module: module, segment: phase.ordinal, inputs: inputs)
	ms.funcs = lendFuncSlot(p.funcs, module: module, segment: phase.ordinal)
	match lent 'lent'
		none then return ms
		tables then _ = 0
		tree then ms.tree = lendTree(p, module: module, phase: phase)
		resolution then ms.tree = lendTree(p, module: module, phase: phase)
		source then ms.source = exchange(p.modules[m], value: Module.new(module, path: "", text: "", files: FileSpanList.create(0)))
	end 'lent'
	if lent == Lent.source 'source'
		ms.tables = exchange(ms.source.tables, value: ModuleTables.lentOut())
	end 'source' else 'held'
		ms.tables = exchange(p.modules[m].tables, value: ModuleTables.lentOut())
	end 'held'
	ms.tables.phase = phase.ordinal
	if lent == Lent.resolution 'resolution'
		ms.resolution = exchange(p.resolutions[m], value: Resolution.new(module))
	end 'resolution'
	return ms
end 'lendModule'

// resolutionOf is the resolution of the module of ms, which its resolve made: a product every later stage of the module
// reads in the project.
export function resolutionOf(p Project, ms ModuleState) returns borrowed Resolution
	return p.resolutions[modIndex(ms.module)]
end 'resolutionOf'

// nodeDecl is the declaration that the name or the type written at node, in the module of ms, is bound to: by the resolve,
// or, for a type written Owner.member, which the resolve leaves unbound, by the stage of the check that found the typealias
// it names.
export function nodeDecl(p Project, ms ModuleState, node Count) returns table.Option with DeclRef
	let bound = p.resolutions[modIndex(ms.module)].decls.get(node)
	if bound.isSome() 'bound'
		return bound
	end 'bound'
	return ms.tables.memberDecl(node)
end 'nodeDecl'

// lendTree is the tree of module for the task of the stage of phase to write. The bodies stage desugars into a copy of the
// tree that the resolve made, which is that stage's product, so that a task that waited on the resolve and not on the bodies
// reads it unchanged while the bodies' copy is written, and the copy is the bodies' product.
function lendTree(mutates p Project, module diag.ModuleID, phase Phase) returns Tree
	let m = modIndex(module)
	if phase == Phase.bodies 'copy'
		return p.modules[m].tree.clone()
	end 'copy'
	return exchange(p.modules[m].tree, value: Tree.new(module, text: ""))
end 'lendTree'

// lendProject lends sharedSlot of the tables to work of the project as a whole, which reads every other slot and holds no
// module's parts.
export function lendProject(mutates p Project) returns ModuleState
	var ms = ModuleState.ofProject()
	let segment = laterSegment(p.types, ft: p.funcs, module: diag.stdlibID, from: Phase.project)
	ms.types = lendTypeSlot(p.types, module: diag.stdlibID, segment: segment, inputs: Inputs.new())
	ms.funcs = lendFuncSlot(p.funcs, module: diag.stdlibID, segment: segment)
	return ms
end 'lendProject'

// giveBack gives the project back what lendModule or lendProject lent.
export function giveBack(mutates p Project, consumes ms ModuleState)
	var held = ms
	returnTypeSlot(p.types, held: exchange(held.types, value: TypeSlot.none()))
	returnFuncSlot(p.funcs, held: exchange(held.funcs, value: FuncSlot.none()))
	if held.lent == Lent.none 'none'
		return
	end 'none'
	let m = modIndex(held.module)
	if held.lent == Lent.source 'source'
		p.modules[m] = exchange(held.source, value: Module.new(held.module, path: "", text: "", files: FileSpanList.create(0)))
	end 'source'
	if held.lent == Lent.tree or held.lent == Lent.resolution 'tree'
		p.modules[m].tree = exchange(held.tree, value: Tree.new(held.module, text: ""))
	end 'tree'
	p.modules[m].tables = exchange(held.tables, value: ModuleTables.lentOut())
	if held.lent == Lent.resolution 'resolution'
		p.resolutions[m] = exchange(held.resolution, value: Resolution.new(held.module))
	end 'resolution'
end 'giveBack'

// makeType makes a nominal type that module declares from work outside the tasks of a compile, which holds no slot of the
// tables: it lends the module's slot for the one entry.
export function makeType(mutates p Project, module diag.ModuleID, consumes e TypeEntry) returns TypeID
	let segment = outsideSegment(p.types, ft: p.funcs, module: module)
	var held = lendTypeSlot(p.types, module: module, segment: segment, inputs: Inputs.new())
	let id = allocType(held, module: module, e: e)
	keepTypeSlot(p.types, held: held)
	return id
end 'makeType'

// makeFunc makes a function that module declares from work outside the tasks of a compile, as makeType makes a type.
export function makeFunc(mutates p Project, module diag.ModuleID, consumes f FuncEntry) returns FuncID
	let segment = outsideSegment(p.types, ft: p.funcs, module: module)
	var held = lendFuncSlot(p.funcs, module: module, segment: segment)
	let id = allocFunc(held, module: module, f: f)
	keepFuncSlot(p.funcs, held: held)
	return id
end 'makeFunc'

// HiddenModule is what a view of the products of the stages the running task waited on (--verify-reads) holds out of the
// project of a module whose parse or resolve the task did not wait on: its declarations and their names, which the parse
// made, and its resolution, which the resolve made.
export type HiddenModule
	var module as Count
	var hidesDecls as bool
	var decls as DeclList
	var names as DeclIndex
	var hidesResolution as bool
	var resolution as Resolution

	static function make(module Count) returns HiddenModule
		return HiddenModule{module: module, hidesDecls: false, decls: DeclList.create(0), names: DeclIndex.new(), hidesResolution: false, resolution: Resolution.new(0 as diag.ModuleID)}
	end 'make'
end 'HiddenModule'

export typealias HiddenModules = Array with HiddenModule

// enterModulesView makes the project show the running task, of a stage of module own, only the products of the stages it
// waited on, visible, of each other module the compile compiles from first on: the parts of its tables (a read of another
// stops the compile), and, of a module whose parse or resolve it did not wait on, no declarations or no resolution. It
// gives what it hid, which leaveModulesView puts back.
export function enterModulesView(mutates p Project, own diag.ModuleID, first Count, visible Inputs) returns HiddenModules
	var hidden = HiddenModules.create(0)
	// A task that waited on a module's parse reads the segments before the resolve's, and one that waited on its resolve
	// those before the aliases'.
	let parsed = Phase.resolve.ordinal
	let resolved = Phase.aliases.ordinal
	for a in first upto p.modules.count() 'modules'
		if a == modIndex(own) 'own'
			continue 'modules'
		end 'own'
		let waited = visible.of(moduleSlot(p.modules[a].id), present: everySegment)
		p.modules[a].tables.setSeen(waited, by: visible.reader.clone())
		if waited >= resolved 'whole'
			continue 'modules'
		end 'whole'
		var h = HiddenModule.make(a)
		h.hidesResolution = true
		h.resolution = exchange(p.resolutions[a], value: Resolution.new(p.modules[a].id))
		if waited < parsed 'unparsed'
			h.hidesDecls = true
			h.decls = exchange(p.modules[a].decls, value: DeclList.create(0))
			h.names = exchange(p.modules[a].names, value: DeclIndex.new())
		end 'unparsed'
		hidden.push(h)
	end 'modules'
	return hidden
end 'enterModulesView'

// leaveModulesView puts back what enterModulesView hid, and lets every read of the tables read every part again.
export function leaveModulesView(mutates p Project, first Count, consumes hidden HiddenModules)
	for a in first upto p.modules.count() 'modules'
		p.modules[a].tables.setSeen(everySegment, by: "")
	end 'modules'
	var held = hidden
	while held.count() > 0 'hidden'
		var h = try held.pop() otherwise panic("a hidden module was taken off an empty list")
		let a = h.module
		if h.hidesResolution 'resolution'
			p.resolutions[a] = exchange(h.resolution, value: Resolution.new(p.modules[a].id))
		end 'resolution'
		if h.hidesDecls 'decls'
			p.modules[a].decls = exchange(h.decls, value: DeclList.create(0))
			p.modules[a].names = exchange(h.names, value: DeclIndex.new())
		end 'decls'
	end 'hidden'
end 'leaveModulesView'

// HeldTables are the project's tables while a task of a module runs, in whose place the project holds the task's view of them
// (enterTaskView).
export type HeldTables
	var types as TypeTable
	var funcs as FuncTable

	export static function none() returns HeldTables
		return HeldTables{types: TypeTable.new(), funcs: FuncTable.new()}
	end 'none'

	static function make(consumes types TypeTable, consumes funcs FuncTable) returns HeldTables
		return HeldTables{types: types, funcs: funcs}
	end 'make'
end 'HeldTables'

// enterTaskView makes the project's tables, for the running task of a stage of module own, the view of the products of the
// stages it waited on, visible (viewTypes, viewFuncs), and gives the tables it holds in their place, which leaveTaskView puts
// back. verifies names the reader of an entry the view does not hold.
export function enterTaskView(mutates p Project, own diag.ModuleID, visible Inputs, verifies bool) returns HeldTables
	let types = viewTypes(p.types, own: own, visible: visible, verifies: verifies)
	let funcs = viewFuncs(p.funcs, own: own, visible: visible, verifies: verifies)
	let heldTypes = exchange(p.types, value: types)
	let heldFuncs = exchange(p.funcs, value: funcs)
	return HeldTables.make(heldTypes, funcs: heldFuncs)
end 'enterTaskView'

// leaveTaskView puts back the tables that enterTaskView held, dropping the view.
export function leaveTaskView(mutates p Project, consumes held HeldTables)
	var back = held
	p.types = exchange(back.types, value: TypeTable.new())
	p.funcs = exchange(back.funcs, value: FuncTable.new())
end 'leaveTaskView'
