// Where an expression lies in its module's text, from its first byte to past its last. A node records where it starts, which
// for an operator is the operator, so the extent is found from the nodes at its two ends and the tokens that close them.
// Only a fix of a diagnostic asks, so the text is scanned when it does, and an expression whose end this does not know
// (a match, or a try that leaves with a statement) has no extent.

// Extent is the bytes of a module's text from begin until until.
export type Extent
	export var begin as diag.U32
	export var until as diag.U32

	export static function make(begin diag.U32, until diag.U32) returns Extent
		return Extent{begin: begin, until: until}
	end 'make'
end 'Extent'

let quoteByte = 34 as Byte

let apostropheByte = 39 as Byte

let backslashByte = 92 as Byte

let slashByte = 47 as Byte

let newlineByte = 10 as Byte

let openParenByte = 40 as Byte

let closeParenByte = 41 as Byte

let openBracketByte = 91 as Byte

let closeBracketByte = 93 as Byte

let openBraceByte = 123 as Byte

let closeBraceByte = 125 as Byte

let dotByte = 46 as Byte

let minusByte = 45 as Byte

let underscoreByte = 95 as Byte

let intTypeWord = "int"

let withWord = "with"

function stepOn(at Count) returns Count
	return try at + 1 otherwise panic("extents: a text longer than memory")
end 'stepOn'

function stepBack(at Count) returns Count
	return try at - 1 otherwise panic("extents: a step back from the start of the text")
end 'stepBack'

function isWordByte(c Byte) returns bool
	return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == underscoreByte or c >= 128
end 'isWordByte'

function isSpaceByte(c Byte) returns bool
	return c == 32 or c == 9 or c == 13 or c == newlineByte
end 'isSpaceByte'

function isOpening(c Byte) returns bool
	return c == openParenByte or c == openBracketByte or c == openBraceByte
end 'isOpening'

function isClosing(c Byte) returns bool
	return c == closeParenByte or c == closeBracketByte or c == closeBraceByte
end 'isClosing'

// skipSpace is the first byte at or after at that is not white space.
export function skipSpace(text String, at Count) returns Count
	var i = at
	while i < text.byteLength() and isSpaceByte(text.byteAt(i)) 'space'
		i = stepOn(i)
	end 'space'
	return i
end 'skipSpace'

// wordEnd is past the run of word bytes at at.
export function wordEnd(text String, at Count) returns Count
	var i = at
	while i < text.byteLength() and isWordByte(text.byteAt(i)) 'word'
		i = stepOn(i)
	end 'word'
	return i
end 'wordEnd'

// dottedEnd is past a word and the dotted words after it, as a qualified name or a number with a fraction is written.
function dottedEnd(text String, at Count) returns Count
	var i = wordEnd(text, at: at)
	while i < text.byteLength() and text.byteAt(i) == dotByte and stepOn(i) < text.byteLength() and isWordByte(text.byteAt(stepOn(i))) 'dots'
		i = wordEnd(text, at: stepOn(i))
	end 'dots'
	return i
end 'dottedEnd'

// stringEnd is past the string literal whose opening quote is at at, with the interpolations in it.
function stringEnd(text String, at Count) returns Count
	var i = stepOn(at)
	let n = text.byteLength()
	while i < n 'chars'
		let c = text.byteAt(i)
		if c == backslashByte 'escape'
			i = stepOn(stepOn(i))
		end 'escape' else if c == quoteByte 'close'
			return stepOn(i)
		end 'close' else if c == openBraceByte 'interpolation'
			i = closingEnd(text, at: i)
		end 'interpolation' else if c == newlineByte 'unclosed'
			return i
		end 'unclosed' else 'plain'
			i = stepOn(i)
		end 'plain'
	end 'chars'
	return n
end 'stringEnd'

// byteStringEnd is past the byte string literal that starts with its b at at: its text has no interpolation, and a newline
// is part of it.
function byteStringEnd(text String, at Count) returns Count
	var i = stepOn(stepOn(at))
	let n = text.byteLength()
	while i < n 'chars'
		let c = text.byteAt(i)
		if c == backslashByte 'escape'
			i = stepOn(stepOn(i))
		end 'escape' else if c == quoteByte 'close'
			return stepOn(i)
		end 'close' else 'plain'
			i = stepOn(i)
		end 'plain'
	end 'chars'
	return n
end 'byteStringEnd'

// labelEnd is past the quoted label whose opening apostrophe is at at.
function labelEnd(text String, at Count) returns Count
	var i = stepOn(at)
	while i < text.byteLength() and text.byteAt(i) != apostropheByte and text.byteAt(i) != newlineByte 'chars'
		i = stepOn(i)
	end 'chars'
	if i < text.byteLength() and text.byteAt(i) == apostropheByte 'closed'
		return stepOn(i)
	end 'closed'
	return i
end 'labelEnd'

// lineEnd is the newline that ends the line at at, or the end of the text.
function lineEnd(text String, at Count) returns Count
	var i = at
	while i < text.byteLength() and text.byteAt(i) != newlineByte 'line'
		i = stepOn(i)
	end 'line'
	return i
end 'lineEnd'

// tokenEnd is past the token at at: a string, a label, a comment, a word or one byte.
function tokenEnd(text String, at Count) returns Count
	let c = text.byteAt(at)
	if c == quoteByte 'string'
		return stringEnd(text, at: at)
	end 'string'
	if c == apostropheByte 'label'
		return labelEnd(text, at: at)
	end 'label'
	if c == slashByte and stepOn(at) < text.byteLength() and text.byteAt(stepOn(at)) == slashByte 'comment'
		return lineEnd(text, at: at)
	end 'comment'
	if isWordByte(c) 'word'
		return wordEnd(text, at: at)
	end 'word'
	return stepOn(at)
end 'tokenEnd'

// closingEnd is past the bracket that closes the one at at, skipping strings, labels and comments.
function closingEnd(text String, at Count) returns Count
	var depth = 0 as Count
	var i = at
	let n = text.byteLength()
	while i < n 'tokens'
		let c = text.byteAt(i)
		if isOpening(c) 'open'
			depth = stepOn(depth)
		end 'open' else if isClosing(c) 'close'
			depth = try depth - 1 otherwise 0 as Count
			if depth == 0 'matched'
				return stepOn(i)
			end 'matched'
		end 'close'
		i = tokenEnd(text, at: i)
	end 'tokens'
	return n
end 'closingEnd'

// typeEnd is past the type written at at: a name, which may be qualified, an int range, and the type arguments after with.
function typeEnd(text String, at Count) returns Count
	let start = skipSpace(text, at: at)
	var i = dottedEnd(text, at: start)
	if text.sliceBytes(start, endPos: i) == intTypeWord 'range'
		let open = skipSpace(text, at: i)
		if open < text.byteLength() and text.byteAt(open) == openParenByte 'bounds'
			return closingEnd(text, at: open)
		end 'bounds'
	end 'range'
	let after = skipSpace(text, at: i)
	let word = wordEnd(text, at: after)
	if text.sliceBytes(after, endPos: word) == withWord 'arguments'
		return typeEnd(text, at: word)
	end 'arguments'
	return i
end 'typeEnd'

// exprStart is where the expression's first token starts, before any parenthesis around its first operand.
export function exprStart(t Tree, e NodeID) returns Count
	let k = t.kindOf(e)
	if k == NodeKind.binaryExpr 'binary'
		return exprStart(t, e: binaryExprL(t, id: e))
	end 'binary'
	if k == NodeKind.castExpr 'cast'
		return exprStart(t, e: castExprE(t, id: e))
	end 'cast'
	if k == NodeKind.memberExpr 'member'
		return exprStart(t, e: memberExprObj(t, id: e))
	end 'member'
	if k == NodeKind.indexExpr 'index'
		return exprStart(t, e: indexExprObj(t, id: e))
	end 'index'
	if k == NodeKind.callExpr 'call'
		return exprStart(t, e: callExprCallee(t, id: e))
	end 'call'
	if k == NodeKind.condExpr 'cond'
		return exprStart(t, e: condExprThen(t, id: e))
	end 'cond'
	if k == NodeKind.fromExpr 'from'
		return exprStart(t, e: fromExprHead(t, id: e))
	end 'from'
	return t.startOf(e) as Count
end 'exprStart'

// exprEnd is past the expression's last token, or nothing for an expression whose end it does not know.
export function exprEnd(t Tree, e NodeID) returns table.Option with Count
	let k = t.kindOf(e)
	let start = t.startOf(e) as Count
	if k == NodeKind.binaryExpr 'binary'
		return exprEnd(t, e: binaryExprR(t, id: e))
	end 'binary'
	if k == NodeKind.unaryExpr 'unary'
		return exprEnd(t, e: unaryExprE(t, id: e))
	end 'unary'
	if k == NodeKind.condExpr 'cond'
		return exprEnd(t, e: condExprElse(t, id: e))
	end 'cond'
	if k == NodeKind.fromExpr 'from'
		return exprEnd(t, e: fromExprValue(t, id: e))
	end 'from'
	if k == NodeKind.castExpr 'cast'
		return table.Option.some(typeEnd(t.text, at: wordEnd(t.text, at: start)))
	end 'cast'
	if k == NodeKind.memberExpr 'member'
		return table.Option.some(wordEnd(t.text, at: skipSpace(t.text, at: stepOn(start))))
	end 'member'
	if k == NodeKind.indexExpr or k == NodeKind.callExpr or k == NodeKind.collectionLitExpr 'bracketed'
		return table.Option.some(closingEnd(t.text, at: start))
	end 'bracketed'
	if k == NodeKind.intLit and t.text.byteAt(start) == minusByte 'negative'
		return table.Option.some(dottedEnd(t.text, at: skipSpace(t.text, at: stepOn(start))))
	end 'negative'
	if k == NodeKind.nameExpr or k == NodeKind.selfExpr or k == NodeKind.boolLit or k == NodeKind.intLit 'word'
		return table.Option.some(dottedEnd(t.text, at: start))
	end 'word'
	if k == NodeKind.strLit 'string'
		return table.Option.some(stringEnd(t.text, at: start))
	end 'string'
	if k == NodeKind.byteStrLit 'byteString'
		return table.Option.some(byteStringEnd(t.text, at: start))
	end 'byteString'
	if k == NodeKind.panicExpr or k == NodeKind.structLitExpr 'opened'
		return table.Option.some(closingEnd(t.text, at: openingAfter(t.text, at: start)))
	end 'opened'
	if k == NodeKind.tryExpr 'try'
		if tryFallback(t, e: e) != 0 'fallback'
			return exprEnd(t, e: tryFallback(t, e: e))
		end 'fallback'
		if tryExprIgnore(t, id: e) or tryExprHandler(t, id: e) != 0 or tryExprRet(t, id: e) != 0 or tryExprBrk(t, id: e) != 0 or tryExprCont(t, id: e) != 0 or tryExprThr(t, id: e) != 0 'leaves'
			return table.Option.none
		end 'leaves'
		return exprEnd(t, e: tryExprE(t, id: e))
	end 'try'
	return table.Option.none
end 'exprEnd'

// openingAfter is the first opening bracket at or after at, which starts the arguments of a panic or the fields of a struct
// literal.
export function openingAfter(text String, at Count) returns Count
	var i = at
	while i < text.byteLength() and not isOpening(text.byteAt(i)) 'scan'
		i = tokenEnd(text, at: i)
	end 'scan'
	return i
end 'openingAfter'

// exprExtent is the bytes of the expression, with the parentheses that its first or last operand stands in when they hold
// it whole, or nothing when its end is not known.
export function exprExtent(t Tree, e NodeID) returns table.Option with Extent
	let found = exprEnd(t, e: e)
	if not found.isSome() 'unknown'
		return table.Option.none
	end 'unknown'
	var begin = exprStart(t, e: e)
	var until = found.unwrap()
	var unopened = 0 as Count
	var unclosed = 0 as Count
	var i = begin
	while i < until 'balance'
		let c = t.text.byteAt(i)
		if c == openParenByte 'open'
			unclosed = stepOn(unclosed)
		end 'open' else if c == closeParenByte 'close'
			if unclosed > 0 'paired'
				unclosed = try unclosed - 1 otherwise 0 as Count
			end 'paired' else 'unpaired'
				unopened = stepOn(unopened)
			end 'unpaired'
		end 'close'
		i = tokenEnd(t.text, at: i)
	end 'balance'
	while unopened > 0 'opens'
		var back = begin
		while back > 0 and isSpaceByte(t.text.byteAt(stepBack(back))) 'space'
			back = stepBack(back)
		end 'space'
		if back == 0 or t.text.byteAt(stepBack(back)) != openParenByte 'unbalanced'
			return table.Option.none
		end 'unbalanced'
		begin = stepBack(back)
		unopened = try unopened - 1 otherwise 0 as Count
	end 'opens'
	while unclosed > 0 'closes'
		let next = skipSpace(t.text, at: until)
		if next >= t.text.byteLength() or t.text.byteAt(next) != closeParenByte 'unbalanced'
			return table.Option.none
		end 'unbalanced'
		until = stepOn(next)
		unclosed = try unclosed - 1 otherwise 0 as Count
	end 'closes'
	return table.Option.some(Extent.make(try begin as diag.U32 otherwise panic("extents: an offset past a module"), until: try until as diag.U32 otherwise panic("extents: an offset past a module")))
end 'exprExtent'

// isOperand is whether the expression stands as an operand of an operator or the value of a cast, which is to say it is not
// written whole where an expression ends: whether a word or a symbol of an operator stands just before it or just after it.
// An expression that is wrapped there needs parentheses around the whole, since the wrapping would take the operator's
// other operand into it.
export function isOperand(t Tree, extent Extent) returns bool
	return operatorBefore(t.text, at: extent.begin as Count) or continuesAfter(t.text, at: extent.until as Count)
end 'isOperand'

let operatorBytes = "+-*/<>=!"

let operatorWords = "and or not xor mod shl shr as if else"

let assignText = "="

function operatorBefore(text String, at Count) returns bool
	var i = at
	while i > 0 and (text.byteAt(stepBack(i)) == 32 or text.byteAt(stepBack(i)) == 9) 'space'
		i = stepBack(i)
	end 'space'
	if i == 0 'start'
		return false
	end 'start'
	let last = stepBack(i)
	if isWordByte(text.byteAt(last)) 'word'
		var first = last
		while first > 0 and isWordByte(text.byteAt(stepBack(first))) 'back'
			first = stepBack(first)
		end 'back'
		return holdsWord(operatorWords, word: text.sliceBytes(first, endPos: i))
	end 'word'
	var first = i
	while first > 0 and holdsByte(operatorBytes, c: text.byteAt(stepBack(first))) 'symbols'
		first = stepBack(first)
	end 'symbols'
	return first < i and text.sliceBytes(first, endPos: i) != assignText
end 'operatorBefore'

function continuesAfter(text String, at Count) returns bool
	var i = at
	while i < text.byteLength() and (text.byteAt(i) == 32 or text.byteAt(i) == 9) 'space'
		i = stepOn(i)
	end 'space'
	if i >= text.byteLength() 'end'
		return false
	end 'end'
	let c = text.byteAt(i)
	if isWordByte(c) 'word'
		return holdsWord(operatorWords, word: text.sliceBytes(i, endPos: wordEnd(text, at: i)))
	end 'word'
	return holdsByte(operatorBytes, c: c) or c == dotByte or c == openBracketByte or c == openParenByte
end 'continuesAfter'

function holdsByte(set String, c Byte) returns bool
	for i in 0 upto set.byteLength() 'each'
		if set.byteAt(i) == c 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'holdsByte'

// holdsWord is whether the space-separated list of words holds word.
function holdsWord(list String, word String) returns bool
	var start = 0 as Count
	let n = list.byteLength()
	for i in 0 upto stepOn(n) 'scan'
		if i == n or list.byteAt(i) == 32 'cut'
			if list.sliceBytes(start, endPos: i) == word 'found'
				return true
			end 'found'
			start = stepOn(i)
		end 'cut'
	end 'scan'
	return false
end 'holdsWord'

// arithmeticParent is the operation or the cast that takes e as an operand, or 0 when e is not one: a failure of e is
// covered by a try around the whole arithmetic expression it is part of, as a person writes one.
export function arithmeticParent(t Tree, e NodeID) returns NodeID
	for id in 1 upto t.records.count() 'records'
		let k = t.records[id].kind
		let node = try id as NodeID otherwise panic("extents: more nodes than a NodeID holds")
		if k == NodeKind.binaryExpr and isArithmetic(binaryExprOp(t, id: node)) and (binaryExprL(t, id: node) == e or binaryExprR(t, id: node) == e) 'binary'
			return node
		end 'binary'
		if k == NodeKind.unaryExpr and unaryExprOp(t, id: node) == "-" and unaryExprE(t, id: node) == e 'negation'
			return node
		end 'negation'
		if k == NodeKind.castExpr and castExprE(t, id: node) == e 'cast'
			return node
		end 'cast'
	end 'records'
	return 0 as NodeID
end 'arithmeticParent'

function isArithmetic(op String) returns bool
	return op == "+" or op == "-" or op == "*" or op == "/" or op == "mod" or op == "shl" or op == "shr"
end 'isArithmetic'

// outermostArithmetic is the whole arithmetic expression that e is part of.
export function outermostArithmetic(t Tree, e NodeID) returns NodeID
	var at = e
	var parent = arithmeticParent(t, e: at)
	while parent != 0 'climb'
		at = parent
		parent = arithmeticParent(t, e: at)
	end 'climb'
	return at
end 'outermostArithmetic'
