// ownsOperands is whether the lowering of an intrinsic evaluates its receiver and arguments itself.
export function ownsOperands(op ast.Intrinsic) returns bool
	if op == ast.Intrinsic.intrArrayCreate 'intrArrayCreate'
		return false
	end 'intrArrayCreate'
	if op == ast.Intrinsic.intrArrayCreateZeroed 'intrArrayCreateZeroed'
		return false
	end 'intrArrayCreateZeroed'
	if op == ast.Intrinsic.intrArrayFilled 'intrArrayFilled'
		return false
	end 'intrArrayFilled'
	if op == ast.Intrinsic.intrArrayCount 'intrArrayCount'
		return false
