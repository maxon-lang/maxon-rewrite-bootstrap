		return false
	end 'intrArrayGet'
	if op == ast.Intrinsic.intrArraySet 'intrArraySet'
		return false
	end 'intrArraySet'
	if op == ast.Intrinsic.intrArrayPush 'intrArrayPush'
		return false
	end 'intrArrayPush'
	if op == ast.Intrinsic.intrArrayAppend 'intrArrayAppend'
		return false
	end 'intrArrayAppend'
	if op == ast.Intrinsic.intrArrayInsert 'intrArrayInsert'
		return false
	end 'intrArrayInsert'
	if op == ast.Intrinsic.intrArrayRemove 'intrArrayRemove'
		return false
	end 'intrArrayRemove'
	if op == ast.Intrinsic.intrArrayPop 'intrArrayPop'
		return false
	end 'intrArrayPop'
	if op == ast.Intrinsic.intrArrayDropEmpty 'intrArrayDropEmpty'
		return false
	end 'intrArrayDropEmpty'
	if op == ast.Intrinsic.intrArrayClear 'intrArrayClear'
		return false
	end 'intrArrayClear'
	if op == ast.Intrinsic.intrArrayTruncate 'intrArrayTruncate'
		return false
	end 'intrArrayTruncate'
	if op == ast.Intrinsic.intrArrayReserve 'intrArrayReserve'
		return false
	end 'intrArrayReserve'
	if op == ast.Intrinsic.intrArrayResize 'intrArrayResize'
		return false
	end 'intrArrayResize'
	if op == ast.Intrinsic.intrArraySlice 'intrArraySlice'
