// irFunction declares a function of the project's module, which the lowering reads its parameters from, and gives the
// node it is declared at.
function irFunction(mutates p ast.Project, name String, params Count) returns ast.FuncID
	var tree = thaw(p.modules[0].tree)
	let node = tree.alloc(ast.NodeKind.funcDecl, start: 0 as diag.U32)
	p.modules[0].tree = freeze(tree)
	var entry = ast.FuncEntry.make(name.clone(), visibility: "export", module: 0 as diag.ModuleID, nodeID: node)
	for i in 0 upto params 'params'
		entry.params.push(ast.ParamSpec.make("p{i}", ty: p.builtins.countTy, conv: ast.Convention.convLet))
		entry.paramTypes.push(p.builtins.countTy)
	end 'params'
	let module = p.rootModule
	return ast.makeFunc(p, module: module, f: entry)
end 'irFunction'

// irLocal declares a local of a function that is not a parameter, in the slot it is given.
function irLocal(mutates p ast.Project, fn ast.FuncID, name String, ty ast.TypeID, slot ast.SlotIndex)
	var entry = ast.LocalEntry.make(name.clone(), ty: ty, isVar: true, isParam: false, conv: ast.Convention.convLet, definedAt: 0 as ast.NodeID)
	entry.slot = slot
	var typing = thaw(p.typings[0])
	let id = typing.allocLocal(entry)
	let node = ast.funcEntry(ast.FuncSlot.none(), funcReads: p.funcs, f: fn).nodeID
	var ids = ast.LocalIDList.create(0)
	match consumes typing.funcLocals.get(node as Count) 'known'
		some(list) then ids = list
		none then _ = 0
	end 'known'
	ids.push(id)
	typing.funcLocals.insert(node as Count, value: ids)
	p.typings[0] = freeze(typing)
end 'irLocal'

// irNode makes a node of the module that the checker typed.
function irNode(mutates p ast.Project, kind ast.NodeKind, ty ast.TypeID) returns ast.NodeID
	var tree = thaw(p.modules[0].tree)
	let node = tree.alloc(kind, start: 0 as diag.U32)
	p.modules[0].tree = freeze(tree)
	var typing = thaw(p.typings[0])
	ast.setNodeType(typing, node: node, ty: ty)
	p.typings[0] = freeze(typing)
	return node
end 'irNode'

// The function `sum`: the sum of its two parameters, or 0 when it does not fit.
//
//	function sum(a Count, b Count) returns Count
//		return try a + b otherwise 0
//	end 'sum'
test 'sum'
	var p = irProject()
	let sum = irFunction(p, name: "sum", params: 2 as Count)
	var l = Lowerer.new(InstanceSet.new())
	var ms = ast.lendProject(p)
	begin(l, p: p, ms: ms, fn: sum, bindParams: ast.TypeIDList.create(0), bindArgs: ast.TypeIDList.create(0), bindWitnesses: ast.WitnessList.create(0), name: "")
	pushScope(l, block: true)
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let other = l.b.newBlock()
	let join = l.b.newBlock()
	_ = enterTry(l, target: other, binding: noSlot)
	pushScope(l, block: false)
	let a = paramReg(l, index: 0 as Count, kind: IrKind.kindScalar)
	let b = paramReg(l, index: 1 as Count, kind: IrKind.kindScalar)
	let d = newReg(l, kind: IrKind.kindScalar)
	let stub = failure(l, p: p, ms: ms, errorCase: ast.errorOverflow, err: noReg, errDrop: ast.noType)
	emit(l, i: newBin(d, op: BinOp.binAdd, left: a, right: b, unsigned: true, fail: stub))
	emit(l, i: newStoreSlot(result, src: d, borrow: false))
	popScope(l, p: p)
	leaveTry(l)
	goTo(l, target: join)
	l.cur = other
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: zero, borrow: false))
	goTo(l, target: join)
	let value = fetch(l, slot: result)
	unwind(l, p: p, depth: 0 as Count)
	seal(l, t: newRet(value))
	popScope(l, p: p)
	let tail = konst(l, value: 0 as Word)
	l.b.terminate(l.cur, t: newRet(tail))
	let f = l.b.finish()
	var want = ast.StringList.create(0)
	want.push("function sum params 2 slots [s0 scalar]")
	want.push("b0:")
	want.push("  %0 = param 0")
	want.push("  %1 = param 1")
	want.push("  %2 = add.u %0, %1 else b3")
	want.push("  store s0, %2")
	want.push("  jump b2")
	want.push("b1:")
	want.push("  %3 = const 0")
	want.push("  store s0, %3")
	want.push("  jump b2")
	want.push("b2:")
	want.push("  %4 = load s0")
	want.push("  ret %4")
	want.push("b3:")
	want.push("  jump b1")
	want.push("")
	expectIr("sum", got: irText(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: f), want: want)
end 'sum'

// A switch's cases live in a pool, so the blocks that nothing reaches are dropped from the numbering of its targets too.
test 'switch'
	var p = irProject()
	let f = irFunction(p, name: "f", params: 0 as Count)
	var b = Builder.new()
	b.start(f, name: "", paramCount: 0 as Count)
	let entry = b.newBlock()
	let dead = b.newBlock()
	let one = b.newBlock()
	let other = b.newBlock()
	let v = b.f.newReg(IrKind.kindScalar)
	b.emit(entry, i: newConst(v, value: 1 as Word))
	b.emit(dead, i: newConst(v, value: 2 as Word))
	b.emit(other, i: newConst(v, value: 3 as Word))
	b.emit(one, i: newConst(v, value: 4 as Word))
	var values = WordList.create(0)
	values.push(7 as Word)
	var targets = BlockIDList.create(0)
	targets.push(one)
	let sw = b.switch(v, values: values, targets: targets, def: other)
	b.terminate(entry, t: sw)
	b.terminate(dead, t: newTrap())
	b.terminate(one, t: newRet(v))
	b.terminate(other, t: newRet(v))
	let done = b.finish()
	var want = ast.StringList.create(0)
	want.push("function f params 0")
	want.push("b0:")
	want.push("  %0 = const 1")
	want.push("  switch %0 [7: b1] default b2")
	want.push("b1:")
	want.push("  %0 = const 4")
	want.push("  ret %0")
	want.push("b2:")
	want.push("  %0 = const 3")
	want.push("  ret %0")
	want.push("")
	expectIr("switch", got: irText(p, tt: ast.TypeSlot.none(), reads: p.types, ft: ast.FuncSlot.none(), funcReads: p.funcs, f: done), want: want)
end 'switch'

// A call, a branch, an array made by one fill, a push and a drop: the function `main` of
//
//	function helper(a Count, b Count) returns Count
//		return a
//	end 'helper'
//
//	function main() returns ExitCode
//		var xs as Array with Count
//		xs = Array.create(3)
//		xs.push(7)
//		let h = helper(1, b: 2)
//		if h == 1 'one'
//			print("x")
//		end 'one'
//		return 0
//	end 'main'
test 'main'
	var p = irProject()
	let helper = irFunction(p, name: "helper", params: 2 as Count)
	let main = irFunction(p, name: "main", params: 0 as Count)
	var ofCount = ast.TypeIDList.create(0)
	let countTy = p.builtins.countTy
	ofCount.push(countTy)
	let arrayOrigin = p.builtins.arrayOrigin
	var shared = ast.lendProject(p)
	let arrayTy = ast.instantiateType(shared.types, reads: p.types, origin: arrayOrigin, args: ofCount)
	ast.giveBack(p, ms: shared)
	irLocal(p, fn: main, name: "xs", ty: arrayTy, slot: 0 as ast.SlotIndex)
	irLocal(p, fn: main, name: "h", ty: countTy, slot: 1 as ast.SlotIndex)
	let createNode = irNode(p, kind: ast.NodeKind.callExpr, ty: arrayTy)
	let receiverNode = irNode(p, kind: ast.NodeKind.nameExpr, ty: arrayTy)
	let createSite = CallSite.make(createNode, info: ast.CallInfo.make(ast.CallKind.callStatic, fn: ast.noFunc, receiverTy: ast.noType), receiver: 0 as ast.NodeID, ordered: ast.NodeIDList.create(0))
	let pushSite = CallSite.make(createNode, info: ast.CallInfo.make(ast.CallKind.callMethod, fn: ast.noFunc, receiverTy: arrayTy), receiver: receiverNode, ordered: ast.NodeIDList.create(0))
	var l = Lowerer.new(InstanceSet.new())
	var ms = ast.lendProject(p)
	begin(l, p: p, ms: ms, fn: main, bindParams: ast.TypeIDList.create(0), bindArgs: ast.TypeIDList.create(0), bindWitnesses: ast.WitnessList.create(0), name: "")
	pushScope(l, block: true)
	// xs = Array.create(3)
	pushScope(l, block: false)
	let count = konst(l, value: 3 as Word)
	let created = lowerArrayCreate(l, p: p, ms: ms, c: createSite, recv: noReg, args: argsOf1(count))
	emitDropSlot(l, slot: 0 as Count, ty: arrayTy)
	emit(l, i: newStoreSlot(0 as Count, src: created, borrow: false))
	popScope(l, p: p)
	ownLocal(l, p: p, ms: ms, slot: 0 as Count, t: arrayTy)
	// xs.push(7)
	pushScope(l, block: false)
	let xs = load(l, slot: 0 as Count)
	let seven = konst(l, value: 7 as Word)
	_ = lowerArrayPush(l, p: p, ms: ms, c: pushSite, recv: xs, args: argsOf1(seven))
	popScope(l, p: p)
	// let h = helper(1, b: 2)
	pushScope(l, block: false)
	let argA = konst(l, value: 1 as Word)
	let argB = konst(l, value: 2 as Word)
	let h = newReg(l, kind: IrKind.kindScalar)
	emitCall(l, p: p, ms: ms, dst: h, target: helper, args: argsOf2(argA, b: argB))
	emit(l, i: newStoreSlot(1 as Count, src: h, borrow: false))
	popScope(l, p: p)
	// if h == 1 'one'
	pushScope(l, block: false)
	let thenBlock = l.b.newBlock()
	let join = l.b.newBlock()
	let hv = load(l, slot: 1 as Count)
	let one = konst(l, value: 1 as Word)
	let same = compare(l, op: CmpOp.cmpEq, a: hv, b: one, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(same, ifTrue: thenBlock, ifFalse: join))
	l.cur = thenBlock
	pushScope(l, block: true)
	let text = strReg(l, value: "x")
	let handle = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadGlobal(handle, symbol: Rt.rtStdout))
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtWrite, args: argsOf2(handle, b: text), routine: ast.noFunc)
	_ = konst(l, value: 0 as Word)
	popScope(l, p: p)
	goTo(l, target: join)
	popScope(l, p: p)
	// return 0
	pushScope(l, block: false)
	let status = konst(l, value: 0 as Word)
	unwind(l, p: p, depth: 0 as Count)
	seal(l, t: newRet(status))
	popScope(l, p: p)
	popScope(l, p: p)
	let tail = konst(l, value: 0 as Word)
	l.b.terminate(l.cur, t: newRet(tail))
	let f = l.b.finish()
	var want = ast.StringList.create(0)
	want.push("function main params 0 slots [s0 managed, s1 scalar]")
	want.push("b0:")
	want.push("  %0 = const 3")
	want.push("  %1 = runtime rt.array.new()")
	want.push("  runtime rt.array.reserve(%1, %0)")
	want.push("  %2 = const 0")
	want.push("  runtime rt.array.fill(%1, %0, %2)")
	want.push("  dropslot s0 Array with Count")
	want.push("  store s0, %1")
	want.push("  %3 = load s0")
	want.push("  %4 = const 7")
	want.push("  %5 = runtime rt.array.len(%3)")
	want.push("  runtime rt.array.insert(%3, %5, %4)")
	want.push("  %6 = const 0")
	want.push("  %7 = const 1")
	want.push("  %8 = const 2")
	want.push("  %9 = call helper(%7, %8)")
	want.push("  store s1, %9")
	want.push("  %10 = load s1")
	want.push("  %11 = const 1")
	want.push("  %12 = cmp.eq.u %10, %11")
	want.push("  branch %12, b1, b2")
	want.push("b1:")
	want.push("  %13 = str \"x\"")
	want.push("  %14 = global g.stdout")
	want.push("  runtime rt.write(%14, %13)")
	want.push("  %15 = const 0")
	want.push("  jump b2")
	want.push("b2:")
	want.push("  %16 = const 0")
	want.push("  dropslot s0 Array with Count")
	want.push("  ret %16")
	want.push("")
	expectIr("main", got: irText(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: f), want: want)
end 'main'

// rawSite is a call of a raw intrinsic whose operands the lowering evaluates itself: the nodes of its arguments in the order
// of its parameters, each parameter a Count after the name.
function rawSite(p ast.Project, first ast.NodeID, consumes ordered ast.NodeIDList) returns CallSite
	var info = ast.CallInfo.make(ast.CallKind.callStatic, fn: ast.noFunc, receiverTy: ast.noType)
	for i in 0 upto ordered.count() 'specs'
		info.paramSpecs.push(ast.ParamSpec.make("arg{i}", ty: p.builtins.countTy, conv: ast.Convention.convLet))
	end 'specs'
	return CallSite.make(first, info: info, receiver: 0 as ast.NodeID, ordered: ordered)
end 'rawSite'

// The runtime's raw intrinsics, lowered through the dispatch the lowering of a call goes through, in the function
// below. The text is written from the printer's templates.
//
//	function probe() returns Count
//		var w as Count
//		let address = 4096
//		let offset = 8
//		let byte = __Raw.loadByte(address, offset: offset)
//		__Raw.storeWord(address, offset: offset, value: byte)
//		let sum = __Raw.wrappingAdd(address, right: offset)
//		let at = __Raw.addressOf(w)
//		return __Raw.callImport1("Sleep", arg1: 5)
//	end 'probe'
test 'raw'
	var p = irProject()
	let probe = irFunction(p, name: "probe", params: 0 as Count)
	let countTy = p.builtins.countTy
	var local = ast.LocalEntry.make("w", ty: countTy, isVar: true, isParam: false, conv: ast.Convention.convLet, definedAt: 0 as ast.NodeID)
	local.slot = 0 as ast.SlotIndex
	var typing = thaw(p.typings[0])
	let wID = typing.allocLocal(local)
	var ids = ast.LocalIDList.create(0)
	ids.push(wID)
	typing.funcLocals.insert(ast.funcEntry(ast.FuncSlot.none(), funcReads: p.funcs, f: probe).nodeID as Count, value: ids)
	p.typings[0] = freeze(typing)
	let wNode = irNode(p, kind: ast.NodeKind.nameExpr, ty: countTy)
	var named = thaw(p.typings[0])
	named.names.insert(wNode as Count, value: ast.NameInfo.localName(wID))
	p.typings[0] = freeze(named)
	var tree = thaw(p.modules[0].tree)
	let nameNode = ast.newStrLit(tree, start: 0 as diag.U32)
	var parts = ast.StrPartsBuilder.new()
	parts.decoded(tree, text: "Sleep")
	let partsRef = parts.finish(tree)
	ast.setStrLitPartsRef(tree, id: nameNode, ref: partsRef)
	p.modules[0].tree = freeze(tree)
	let five = irNode(p, kind: ast.NodeKind.intLit, ty: countTy)
	var literal = thaw(p.modules[0].tree)
	ast.setIntLitMagnitude(literal, id: five, value: ast.I128.fromCount(5 as Count))
	p.modules[0].tree = freeze(literal)
	var addressOperands = ast.NodeIDList.create(0)
	addressOperands.push(wNode)
	var importOperands = ast.NodeIDList.create(0)
	importOperands.push(nameNode)
	importOperands.push(five)
	let addressSite = rawSite(p, first: wNode, ordered: addressOperands)
	let importSite = rawSite(p, first: nameNode, ordered: importOperands)
	var l = Lowerer.new(InstanceSet.new())
	var ms = ast.lendProject(p)
	begin(l, p: p, ms: ms, fn: probe, bindParams: ast.TypeIDList.create(0), bindArgs: ast.TypeIDList.create(0), bindWitnesses: ast.WitnessList.create(0), name: "")
	pushScope(l, block: true)
	let address = konst(l, value: 4096 as Word)
	let offset = konst(l, value: 8 as Word)
	let byte = intrinsicCall(l, p: p, ms: ms, op: ast.Intrinsic.intrRawLoad8, c: addressSite, recv: noReg, args: argsOf2(address, b: offset))
	var storeArgs = argsOf2(address, b: offset)
	storeArgs.push(byte)
	_ = intrinsicCall(l, p: p, ms: ms, op: ast.Intrinsic.intrRawStore64, c: addressSite, recv: noReg, args: storeArgs)
	_ = intrinsicCall(l, p: p, ms: ms, op: ast.Intrinsic.intrRawWrappingAdd, c: addressSite, recv: noReg, args: argsOf2(address, b: offset))
	_ = intrinsicCall(l, p: p, ms: ms, op: ast.Intrinsic.intrRawAddressOf, c: addressSite, recv: noReg, args: RegList.create(0))
	let status = intrinsicCall(l, p: p, ms: ms, op: ast.Intrinsic.intrRawCallImport, c: importSite, recv: noReg, args: RegList.create(0))
	unwind(l, p: p, depth: 0 as Count)
	seal(l, t: newRet(status))
	popScope(l, p: p)
	let tail = konst(l, value: 0 as Word)
	l.b.terminate(l.cur, t: newRet(tail))
	let f = l.b.finish()
	var want = ast.StringList.create(0)
	want.push("function probe params 0 slots [s0 scalar]")
	want.push("b0:")
	want.push("  %0 = const 4096")
	want.push("  %1 = const 8")
	want.push("  %2 = add.u %0, %1")
	want.push("  %3 = loadraw.8 %2")
	want.push("  %4 = add.u %0, %1")
	want.push("  storeraw.64 %4, %3")
	want.push("  %5 = const 0")
	want.push("  %6 = add.u %0, %1")
	want.push("  %7 = addr s0")
	want.push("  %8 = const 5")
	want.push("  %9 = import \"Sleep\"(%8)")
	want.push("  ret %9")
	want.push("")
	expectIr("raw", got: irText(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: f), want: want)
end 'raw'

// The body of a test handles an operation that can fail, as the check lets it: the sum below may leave Count's range.
function termOfTheTestSum() returns Count
	return 3
end 'termOfTheTestSum'

test 'a test body lowers an operation that can fail'
	let sum = termOfTheTestSum() + termOfTheTestSum()
	if sum != 6 'sum'
		panic("3 and 3 make 6")
	end 'sum'
end 'a test body lowers an operation that can fail'
