// What the arithmetic of the IR computes, on the 64 bits of a word: the one meaning of each operation that both the
// interpreter, which runs it, and the optimizer, which folds it on constants, use. What each operation computes is in the
// IR table, which evaluate_gen.maxon is written from; this file has the algorithms the table names. A register holds a
// word as a signed number, and an unsigned one is the same bits read as one that may be past i64.max; the wrap of 64-bit
// arithmetic is made by hand on the bits as a Count, since a number here is only ever in range. The floats are ast's,
// which compute exactly what the hardware does.

let signBit = 9223372036854775808 as Count

let maxWordBits = 9223372036854775807 as Count

let allBits = 18446744073709551615 as Count

let lowHalf = 4294967295 as Count

let halfBits = 32 as Count

let minWord = -9223372036854775808 as Word

let maxWord = 9223372036854775807 as Word

// wordBits is the width of a word, which a shift of that much or more clears.
let wordBits = 64 as Word

// Outcome is what an operation on given operands does: gives its value, fails its check (only a checked operation can),
// or has no meaning, which a guard before it or the range analysis rules out, so lowering never lets it run.
export enum Outcome
	outcomeValue
	outcomeFails
	outcomeUndefined
end 'Outcome'

// bitsOfWord is the 64 bits of a word, as the unsigned number they spell.
export function bitsOfWord(x Word) returns Count
	if x >= 0 'positive'
		return x as Count
	end 'positive'
	let low = (x + maxWord + 1) as Count
	return low or signBit
end 'bitsOfWord'

// wordOfBits is the word that 64 bits spell, as a signed number.
export function wordOfBits(c Count) returns Word
	if c <= maxWordBits 'positive'
		return c as Word
	end 'positive'
	let low = (c and maxWordBits) as Word
	return low + minWord
end 'wordOfBits'

// wrapAdd is a + b modulo 2^64.
export function wrapAdd(a Count, b Count) returns Count
	let room = allBits - b
	if a <= room 'fits'
		return try a + b otherwise panic("ir: an addition that fits overflows")
	end 'fits'
	let over = a - room
	return over - 1
end 'wrapAdd'

// wrapSub is a - b modulo 2^64.
export function wrapSub(a Count, b Count) returns Count
	if a >= b 'fits'
		return a - b
	end 'fits'
	let under = (b - a) - 1
	return allBits - under
end 'wrapSub'

// Wide is a 128-bit product, as its high 64 bits and its low 64 bits.
export type Wide
	export var hi as Count
	export var lo as Count

	export static function make(hi Count, lo Count) returns Wide
		return Wide{hi: hi, lo: lo}
	end 'make'
end 'Wide'

// mulWide is the full 128-bit product of two 64-bit numbers.
export function mulWide(a Count, b Count) returns Wide
	let a0 = a and lowHalf
	let a1 = a shr halfBits
	let b0 = b and lowHalf
	let b1 = b shr halfBits
	let p00 = a0 * b0
	let p01 = try a0 * b1 otherwise panic("ir: a product of halves overflows")
	let p10 = try a1 * b0 otherwise panic("ir: a product of halves overflows")
	let p11 = try a1 * b1 otherwise panic("ir: a product of halves overflows")
	let mid = (p00 shr halfBits) + (p01 and lowHalf) + (p10 and lowHalf)
	let lo = ((mid and lowHalf) shl halfBits) + (p00 and lowHalf)
	let hi = try p11 + (p01 shr halfBits) + (p10 shr halfBits) + (mid shr halfBits) otherwise panic("ir: a high half overflows")
	return Wide.make(hi, lo: lo)
end 'mulWide'

// wrapMul is a * b modulo 2^64.
export function wrapMul(a Count, b Count) returns Count
	return mulWide(a, b: b).lo
end 'wrapMul'

// mulHigh is the high 64 bits of the 128-bit product of a and b, read as unsigned numbers or as signed ones. Read as
// signed, a negative a stands for its bits less 2^64, which takes b * 2^64 from the product, and so b from its high
// word; a negative b takes a.
function mulHigh(a Word, b Word, unsigned bool) returns Word
	let bitsA = bitsOfWord(a)
	let bitsB = bitsOfWord(b)
	var hi = mulWide(bitsA, b: bitsB).hi
	if not unsigned 'signed'
		if a < 0 'negativeA'
			hi = wrapSub(hi, b: bitsB)
		end 'negativeA'
		if b < 0 'negativeB'
			hi = wrapSub(hi, b: bitsA)
		end 'negativeB'
	end 'signed'
	return wordOfBits(hi)
end 'mulHigh'

// powerOfTwo is 2^n for an n from 0 to 63.
function powerOfTwo(n Word) returns Count
	let shift = try n as Count otherwise panic("ir: a power of two below 1")
	return try (1 as Count) shl shift otherwise panic("ir: a power of two past 2^63")
end 'powerOfTwo'

function addOverflows(a Word, b Word) returns bool
	if b > 0 'positive'
		return a > (maxWord - b)
	end 'positive'
	if b < 0 'negative'
		return a < (minWord - b)
	end 'negative'
	return false
end 'addOverflows'

function subOverflows(a Word, b Word) returns bool
	if b < 0 'negative'
		return a > (maxWord + b)
	end 'negative'
	if b > 0 'positive'
		return a < (minWord + b)
	end 'positive'
	return false
end 'subOverflows'

// mulOverflows is whether a * b is past a signed word, where product is the word its bits spell.
function mulOverflows(a Word, b Word, product Word) returns bool
	if a == 0 'zero'
		return false
	end 'zero'
	if a == -1 'minusOne'
		return b == minWord
	end 'minusOne'
	return (try product / a otherwise panic("ir: a quotient of a word by a nonzero word")) != b
end 'mulOverflows'

// shiftWord moves the bits of a word by a count from 0 on: a shift of the width or more clears all but the sign of a
// signed right shift.
function shiftWord(left bool, unsigned bool, x Word, count Word) returns Word
	if left and count >= wordBits 'cleared'
		return 0
	end 'cleared'
	if left 'shl'
		return wordOfBits(wrapMul(bitsOfWord(x), b: powerOfTwo(count)))
	end 'shl'
	if count >= wordBits and unsigned 'clearedUnsigned'
		return 0
	end 'clearedUnsigned'
	if count >= wordBits 'sign'
		if x < 0 'negative'
			return -1
		end 'negative'
		return 0
	end 'sign'
	let divisor = powerOfTwo(count)
	if unsigned or x >= 0 'logical'
		return wordOfBits(try bitsOfWord(x) / divisor otherwise panic("ir: a power of two that is 0"))
	end 'logical'
	// An arithmetic shift of a negative number is the logical shift of its complement, complemented.
	return wordOfBits(allBits - (try (allBits - bitsOfWord(x)) / divisor otherwise panic("ir: a power of two that is 0")))
end 'shiftWord'

// addFitsUnsigned is whether the sum of a and b, read as unsigned numbers, is no more than the 64 bits hold.
function addFitsUnsigned(a Word, b Word, result Word) returns bool
	return bitsOfWord(a) <= allBits - bitsOfWord(b)
end 'addFitsUnsigned'

// addFitsSigned is whether the sum of a and b is no more than a signed word holds.
function addFitsSigned(a Word, b Word, result Word) returns bool
	return not addOverflows(a, b: b)
end 'addFitsSigned'

// subFitsUnsigned is whether the difference of a and b, read as unsigned numbers, is not below 0.
function subFitsUnsigned(a Word, b Word, result Word) returns bool
	return bitsOfWord(a) >= bitsOfWord(b)
end 'subFitsUnsigned'

// subFitsSigned is whether the difference of a and b is no more than a signed word holds.
function subFitsSigned(a Word, b Word, result Word) returns bool
	return not subOverflows(a, b: b)
end 'subFitsSigned'

// mulFitsUnsigned is whether the product of a and b, read as unsigned numbers, is no more than the 64 bits hold.
function mulFitsUnsigned(a Word, b Word, result Word) returns bool
	return mulWide(bitsOfWord(a), b: bitsOfWord(b)).hi == 0
end 'mulFitsUnsigned'

// mulFitsSigned is whether the product of a and b, which result holds the low 64 bits of, is no more than a signed word
// holds.
function mulFitsSigned(a Word, b Word, result Word) returns bool
	return not mulOverflows(a, b: b, product: result)
end 'mulFitsSigned'

// negateWord is -a, which wraps for i64.min.
function negateWord(a Word) returns Word
	return wordOfBits(wrapSub(0, b: bitsOfWord(a)))
end 'negateWord'

// negateFits is whether -a is no more than a signed word holds.
function negateFits(a Word) returns bool
	return a != minWord
end 'negateFits'

// indexBelow is whether the index a is below the length b, both read as unsigned, so that a negative index is past every
// length.
function indexBelow(a Word, b Word) returns bool
	return bitsOfWord(a) < bitsOfWord(b)
end 'indexBelow'

// notWord is a with every bit inverted.
function notWord(a Word) returns Word
	return wordOfBits(allBits - bitsOfWord(a))
end 'notWord'

// trailingZeros is the number of 0 bits below the lowest 1 bit of a, and wordBits when a is 0.
function trailingZeros(a Word) returns Word
	var bits = bitsOfWord(a)
	if bits == 0 'zero'
		return wordBits as Word
	end 'zero'
	var count = 0 as Word
	while (bits and 1) == 0 'low'
		bits = bits shr 1
		count = try count + 1 otherwise panic("ir: a word with more than its bits")
	end 'low'
	return count
end 'trailingZeros'

// roundNearest is the double x rounded to an integer, ties to even.
function roundNearest(x Count) returns Count
	return ast.floatRound(x, mode: ast.FloatRounding.nearest)
end 'roundNearest'

// roundDown is the double x rounded to an integer toward negative infinity.
function roundDown(x Count) returns Count
	return ast.floatRound(x, mode: ast.FloatRounding.down)
end 'roundDown'

// roundUp is the double x rounded to an integer toward positive infinity.
function roundUp(x Count) returns Count
	return ast.floatRound(x, mode: ast.FloatRounding.up)
end 'roundUp'

// intToFloat is the double nearest the integer n, read as unsigned when unsigned is set.
function intToFloat(n Word, unsigned bool) returns Word
	var v = ast.I128.fromInt(n as FullRangeInt)
	if unsigned 'unsigned'
		v = ast.I128.fromCount(bitsOfWord(n))
	end 'unsigned'
	return wordOfBits(ast.floatFromInt(v))
end 'intToFloat'

// floatToInt is the double a truncated toward zero, or i64.min for a NaN or a double past the word.
function floatToInt(a Word) returns Word
	return ast.floatTrunc(bitsOfWord(a)) as Word
end 'floatToInt'
