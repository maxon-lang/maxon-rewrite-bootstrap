// The layout table (README, "Layouts"): the one place that says how a value of a type is held and where the parts of a
// box lie. Lowering, the backend's routines, the datums, the groups of a map and the debug info all ask it, so they agree,
// and a change of layout is a change of its answers. Every answer is computed from the type's declaration as it is asked
// for, and allocates nothing.
//
// A value is held wherever a value is (a register, a slot, a field, an element, a payload, a capture) in its form: a word
// of nothing to drop, a managed word (the address of a box it owns or counts, where 0 is the empty place a move leaves), or
// a String's two words. A record is a managed word: the address of its box of values, one after another, each in its form.
// A union is held as its UnionForm says: a box of its case index and payload, or a word of nothing to drop.

// ValueForm is how a value is held.
export enum ValueForm
	formScalar
	formManaged
	formString
end 'ValueForm'

// Niche is the spare bit pattern of a value's form that no value of the type has, which a layout may give a meaning of its
// own: the 0 of a managed word, a ranged integer's word below its least value, an enum's word past its last case, a bool's
// word past true.
export enum Niche
	nicheNone
	nicheNull
	nicheBelow
	nicheEnum
	nicheBool
end 'Niche'

// UnionForm is how a value of a union is held: the address of a box of its case index and its payload; its case index
// alone, where no case carries a payload; where one case carries one integer, enum or bool that has a niche and the only
// other case carries nothing, that payload, with the niche standing for the other case; or, where that one payload is of
// the union's type parameter and a record or an array in the instance, the payload's address, with 0 standing for the
// other case. The two word forms hold nothing to drop,
// and the null form drops and copies as its payload, so Option.none and an Option of a number or of a box allocate nothing.
export enum UnionForm
	unionBoxed
	unionCases
	unionNiche
	unionNull
end 'UnionForm'

// valueForm is how a value of the type is held.
export function valueForm(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns ValueForm
	if ast.isStringType(tt, reads: reads, t: t) 'string'
		return ValueForm.formString
	end 'string'
	if ast.typeKind(tt, reads: reads, t: t) == ast.TypeKind.unionTy and heldAsScalar(unionForm(tt, reads: reads, t: t)) 'word'
		return ValueForm.formScalar
	end 'word'
	if ast.isManagedType(tt, reads: reads, t: t) 'managed'
		return ValueForm.formManaged
	end 'managed'
	return ValueForm.formScalar
end 'valueForm'

// heldInPlace is whether a value of the type t is held in place where a function holds it: a record whose every field is a
// word of nothing to drop, and which has no destructor. Its value in a register is the address of its words, which drops
// nothing: a frame area of the function that made it, the caller's place for a parameter, or the box of a part. A local
// holds it in a frame area of its own, a result is written to an area the caller passes, and any other holder (a field, an
// element, a payload, a capture, the contents of an interface value, a frozen value or a cown) holds it as a managed word,
// the address of a box of its words, which the holder owns, as before.
export function heldInPlace(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	let kind = ast.typeKind(tt, reads: reads, t: t)
	if kind != ast.TypeKind.record or ast.isTupleType(tt, reads: reads, t: t) 'record'
		return false
	end 'record'
	let origin = ast.originOf(tt, reads: reads, t: t)
	if ast.typeEntry(tt, reads: reads, t: origin).dropFunc != ast.noFunc 'destructor'
		return false
	end 'destructor'
	for i in 0 upto ast.typeEntry(tt, reads: reads, t: origin).fields.count() 'fields'
		let field = boundType(tt, reads: reads, owner: t, declared: ast.typeEntry(tt, reads: reads, t: origin).fields[i].ty)
		if valueForm(tt, reads: reads, t: field) != ValueForm.formScalar 'managed'
			return false
		end 'managed'
	end 'fields'
	return true
end 'heldInPlace'

// inPlaceWords is how many words a value held in place takes: one for each field, and one for a record of none, as its box.
export function inPlaceWords(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Count
	return boxBytes(fieldWordsBefore(tt, reads: reads, owner: t, index: fieldsOf(tt, reads: reads, owner: t)), tagged: false) / wordBytes
end 'inPlaceWords'

// heldAsScalar is whether a union of the form is held as a word of nothing to drop.
export function heldAsScalar(form UnionForm) returns bool
	return match form 'form'
		unionBoxed gives false
		unionCases gives true
		unionNiche gives true
		unionNull gives false
	end 'form'
end 'heldAsScalar'

// holdsManaged is whether a value of the type holds something to drop and to copy: a managed word or a String.
export function holdsManaged(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	return valueForm(tt, reads: reads, t: t) != ValueForm.formScalar
end 'holdsManaged'

// valueWords is how many words a value of the type takes where it is held.
export function valueWords(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Count
	if valueForm(tt, reads: reads, t: t) == ValueForm.formString 'string'
		return stringValueBytes / wordBytes
	end 'string'
	return 1
end 'valueWords'

// zeroIsEmpty is whether the value whose words are all 0 is no value of the type, so that an empty slot of an array, which
// is zeroed, can be told from a filled one: true of a managed word and a String, false of a scalar, whose 0 is a value, and
// of a union in the null form, whose 0 is its case without a payload.
export function zeroIsEmpty(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	return holdsManaged(tt, reads: reads, t: t) and not heldAsNull(tt, reads: reads, t: t)
end 'zeroIsEmpty'

// heldAsNull is whether t is a union held in the null form.
export function heldAsNull(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	return ast.typeKind(tt, reads: reads, t: t) == ast.TypeKind.unionTy and unionForm(tt, reads: reads, t: t) == UnionForm.unionNull
end 'heldAsNull'

// nicheOf is the niche of a value of the type.
export function nicheOf(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Niche
	let form = valueForm(tt, reads: reads, t: t)
	if form == ValueForm.formManaged 'managed'
		if heldAsNull(tt, reads: reads, t: t) 'null'
			return Niche.nicheNone
		end 'null'
		return Niche.nicheNull
	end 'managed'
	if form == ValueForm.formString 'string'
		return Niche.nicheNone
	end 'string'
	return scalarNiche(tt, reads: reads, t: t)
end 'nicheOf'

// scalarNiche is the niche of a scalar of the type: an integer's whose least value is no further from 0 than an immediate
// reaches, so that a test of the niche is one compare with an immediate, an enum's and a bool's.
function scalarNiche(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Niche
	let kind = ast.typeKind(tt, reads: reads, t: t)
	if kind == ast.TypeKind.primBool 'bool'
		return Niche.nicheBool
	end 'bool'
	if kind == ast.TypeKind.enumTy 'enum'
		return Niche.nicheEnum
	end 'enum'
	if kind == ast.TypeKind.intRange and hasWordBelow(ast.typeEntry(tt, reads: reads, t: t)) 'below'
		return Niche.nicheBelow
	end 'below'
	return Niche.nicheNone
end 'scalarNiche'

// leastImmediate and greatestImmediate bound the niche of an integer: the words an immediate of a compare reaches.
let leastImmediate = -2147483648 as Word

let greatestImmediate = 2147483647 as Word

// greatestSignedWord is the greatest signed word.
let greatestSignedWord = 9223372036854775807 as Count

// hasWordBelow is whether a ranged integer is held as a signed word whose least value has a word below it that an
// immediate reaches.
function hasWordBelow(entry ast.TypeEntry) returns bool
	let mostSigned = entry.maxVal.hi < 0 or (entry.maxVal.hi == 0 and entry.maxVal.lo <= greatestSignedWord)
	let leastSigned = (entry.minVal.hi == 0 and entry.minVal.lo <= greatestSignedWord) or (entry.minVal.hi == -1 and entry.minVal.lo > greatestSignedWord)
	if not mostSigned or not leastSigned 'unsigned'
		return false
	end 'unsigned'
	let least = wordOf(entry.minVal)
	return least > leastImmediate and least <= greatestImmediate
end 'hasWordBelow'

// nicheWord is the word of the niche of a scalar of the type.
export function nicheWord(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Word
	return match scalarNiche(tt, reads: reads, t: t) 'niche'
		nicheBelow gives try wordOf(ast.typeEntry(tt, reads: reads, t: t).minVal) - 1 otherwise panic("ir: a niche below the least word")
		nicheEnum gives try ast.typeEntry(tt, reads: reads, t: t).cases.count() as Word otherwise panic("ir: an enum past a word")
		nicheBool gives 2 as Word
		nicheNone gives panic("ir: a niche of a type that has none")
		nicheNull gives panic("ir: the niche of a scalar is never null")
	end 'niche'
end 'nicheWord'

// leastWord is the least word a scalar of the type, or its niche, can be: what a thrown error's word is counted from
// (errorBias).
export function leastWord(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Word
	if scalarNiche(tt, reads: reads, t: t) == Niche.nicheBelow 'below'
		return nicheWord(tt, reads: reads, t: t)
	end 'below'
	return 0 as Word
end 'leastWord'

// unionForm is how a value of the union t is held. A case that carries more than one value, or one value in a union of
// more cases than two, makes it a box at once, so most unions are decided by their first cases.
export function unionForm(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns UnionForm
	let origin = ast.originOf(tt, reads: reads, t: t)
	let cases = ast.typeEntry(tt, reads: reads, t: origin).cases.count()
	var carrier = cases
	for c in 0 upto cases 'cases'
		let payloads = ast.typeEntry(tt, reads: reads, t: origin).cases[c].payload.count()
		if payloads > 1 or (payloads == 1 and cases != 2) 'box'
			return UnionForm.unionBoxed
		end 'box'
		if payloads == 1 'one'
			if carrier != cases 'second'
				return UnionForm.unionBoxed
			end 'second'
			carrier = c
		end 'one'
	end 'cases'
	if carrier == cases 'bare'
		return UnionForm.unionCases
	end 'bare'
	let declared = ast.typeEntry(tt, reads: reads, t: origin).cases[carrier].payload[0].ty
	let payload = boundType(tt, reads: reads, owner: t, declared: declared)
	if scalarNiche(tt, reads: reads, t: payload) != Niche.nicheNone 'scalar'
		return UnionForm.unionNiche
	end 'scalar'
	// The null form is a container's, an Option: a payload of the union's type parameter. A union that names its payload's
	// type may be thrown, and the error channel's 0 says no failure.
	let kind = ast.typeKind(tt, reads: reads, t: payload)
	let generic = ast.typeKind(tt, reads: reads, t: declared) == ast.TypeKind.typeParam
	if generic and (kind == ast.TypeKind.record or kind == ast.TypeKind.builtinArray) 'box'
		return UnionForm.unionNull
	end 'box'
	return UnionForm.unionBoxed
end 'unionForm'

// boundType is the type a member of owner declared as declared has where that is the type's own form: a type parameter's
// argument in an instance, and otherwise the declared type itself. A declared instance of other types (Array with T) is
// left as it is, which is enough for what the layout asks of it here (whether it is a String, whether it has a scalar
// niche), and costs no substitution.
function boundType(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, declared ast.TypeID) returns ast.TypeID
	if ast.typeKind(tt, reads: reads, t: declared) != ast.TypeKind.typeParam 'declared'
		return declared
	end 'declared'
	let origin = ast.originOf(tt, reads: reads, t: owner)
	let params = ast.typeEntry(tt, reads: reads, t: origin).typeParams.count()
	for i in 0 upto params 'params'
		if ast.typeEntry(tt, reads: reads, t: origin).typeParams[i] == declared and i < ast.typeEntry(tt, reads: reads, t: owner).typeArgs.count() 'bound'
			return ast.typeEntry(tt, reads: reads, t: owner).typeArgs[i]
		end 'bound'
	end 'params'
	return declared
end 'boundType'

// nichePayload is the type of the one payload of the case caseIndex of the union owner, as boundType gives it.
function nichePayload(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count) returns ast.TypeID
	let declared = ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).cases[caseIndex].payload[0].ty
	return boundType(tt, reads: reads, owner: owner, declared: declared)
end 'nichePayload'

// payloadCase is the case of a union in the niche form that carries the payload, and emptyCase the one the niche stands for.
export function payloadCase(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Count
	if payloadsOf(tt, reads: reads, owner: t, caseIndex: 0) == 1 'first'
		return 0
	end 'first'
	return 1
end 'payloadCase'

export function emptyCase(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Count
	if payloadCase(tt, reads: reads, t: t) == 0 'second'
		return 1
	end 'second'
	return 0
end 'emptyCase'

// unionNicheWord is the word that stands for the empty case of a union in the niche form: its payload's niche.
export function unionNicheWord(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Word
	return nicheWord(tt, reads: reads, t: nichePayload(tt, reads: reads, owner: t, caseIndex: payloadCase(tt, reads: reads, t: t)))
end 'unionNicheWord'

// errorInBox is whether a thrown error of the type t is the address of a box, which the failure hands to its caller to own:
// a union held in a box. Any other error is a word plus its errorBias.
export function errorInBox(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns bool
	if not ast.isUnionError(tt, reads: reads, t: t) 'enum'
		return false
	end 'enum'
	return match unionForm(tt, reads: reads, t: t) 'form'
		unionBoxed gives true
		unionCases gives false
		unionNiche gives false
		unionNull gives panic("ir: an error of {ast.typeName(tt, reads: reads, t: t)}, a union held as its payload's address, whose 0 would say no failure")
	end 'form'
end 'errorInBox'

// errorBias is what a thrown error of the union or enum t adds to its word, so that the word a failure hands on is never 0,
// which says no failure: 1 for a case index, and past the least word of a union held as a word. It is 0 for a union held in
// a box, whose address is never 0.
export function errorBias(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Word
	if ast.typeKind(tt, reads: reads, t: t) != ast.TypeKind.unionTy 'cases'
		return 1
	end 'cases'
	return match unionForm(tt, reads: reads, t: t) 'form'
		unionBoxed gives 0 as Word
		unionCases gives 1 as Word
		unionNiche gives try 1 - leastWord(tt, reads: reads, t: nichePayload(tt, reads: reads, owner: t, caseIndex: payloadCase(tt, reads: reads, t: t))) otherwise panic("ir: an error bias past a word")
		unionNull gives panic("ir: an error bias of a union held as its payload's address")
	end 'form'
end 'errorBias'

// boxBytes is the size of a box of a number of words of values (one for a box of none), and a first word for a union's
// case index when tagged.
export function boxBytes(values Count, tagged bool) returns Count
	var words = values
	if words < 1 'one'
		words = 1
	end 'one'
	if tagged 'tag'
		words = succ(words)
	end 'tag'
	return wordOffset(words)
end 'boxBytes'

// fieldOffset is where a value sits in a box after a number of words of the values before it: after the case index when
// the box is a union's.
export function fieldOffset(word Count, tagged bool) returns Count
	if tagged 'tag'
		return wordOffset(succ(word))
	end 'tag'
	return wordOffset(word)
end 'fieldOffset'

// fieldsOf is how many fields the record owner has, an instance's as its origin declares them.
export function fieldsOf(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).fields.count()
end 'fieldsOf'

// casesOf is how many cases the union owner has.
export function casesOf(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).cases.count()
end 'casesOf'

// payloadsOf is how many values the case caseIndex of the union owner carries.
export function payloadsOf(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).cases[caseIndex].payload.count()
end 'payloadsOf'

// fieldWordsBefore is how many words the fields of the record owner before index take.
function fieldWordsBefore(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, index Count) returns Count
	let origin = ast.originOf(tt, reads: reads, t: owner)
	var words = 0 as Count
	for i in 0 upto index 'each'
		let field = boundType(tt, reads: reads, owner: owner, declared: ast.typeEntry(tt, reads: reads, t: origin).fields[i].ty)
		words = try words + valueWords(tt, reads: reads, t: field) otherwise panic("ir: a box past memory")
	end 'each'
	return words
end 'fieldWordsBefore'

// payloadWordsBefore is how many words the payload of the case caseIndex of the union owner before index takes.
function payloadWordsBefore(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count, index Count) returns Count
	let origin = ast.originOf(tt, reads: reads, t: owner)
	var words = 0 as Count
	for i in 0 upto index 'each'
		let payload = boundType(tt, reads: reads, owner: owner, declared: ast.typeEntry(tt, reads: reads, t: origin).cases[caseIndex].payload[i].ty)
		words = try words + valueWords(tt, reads: reads, t: payload) otherwise panic("ir: a box past memory")
	end 'each'
	return words
end 'payloadWordsBefore'

// recordBoxBytes is the size of the box of the record owner, an instance's with its arguments applied.
export function recordBoxBytes(mutates tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns Count
	return boxBytes(fieldWordsBefore(tt, reads: reads, owner: owner, index: fieldsOf(tt, reads: reads, owner: owner)), tagged: false)
end 'recordBoxBytes'

// caseBoxBytes is the size of the box of the case caseIndex of the union owner.
export function caseBoxBytes(mutates tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count) returns Count
	return boxBytes(payloadWordsBefore(tt, reads: reads, owner: owner, caseIndex: caseIndex, index: payloadsOf(tt, reads: reads, owner: owner, caseIndex: caseIndex)), tagged: true)
end 'caseBoxBytes'

// recordFieldOffset is where the field at index of a box of the record owner sits.
export function recordFieldOffset(mutates tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, index Count) returns Count
	return fieldOffset(fieldWordsBefore(tt, reads: reads, owner: owner, index: index), tagged: false)
end 'recordFieldOffset'

// payloadOffset is where the payload at index of a box of the case caseIndex of the union owner sits.
export function payloadOffset(mutates tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count, index Count) returns Count
	return fieldOffset(payloadWordsBefore(tt, reads: reads, owner: owner, caseIndex: caseIndex, index: index), tagged: true)
end 'payloadOffset'
