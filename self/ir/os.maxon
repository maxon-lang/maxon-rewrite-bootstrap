// OsFailure is why an OS operation failed, as the runtime tells it from the operating system's error; the entry of the
// operation reports it as the case of the error the operation throws (failureCase).
export enum OsFailure
	failureNotFound
	failureAccessDenied
	failureBusy
	failureAlreadyExists
	failureOther
end 'OsFailure'

// The Win32 errors the runtime tells apart, the ones maxon's runtime does.
export let win32FileNotFound = 2 as Count

export let win32PathNotFound = 3 as Count

export let win32AccessDenied = 5 as Count

export let win32SharingViolation = 32 as Count

export let win32FileExists = 80 as Count

// failureOfWin32 is the failure a Win32 error is; any error the runtime does not tell apart is failureOther.
export function failureOfWin32(code Count) returns OsFailure
	return match code 'code'
		2 gives OsFailure.failureNotFound
		3 gives OsFailure.failureNotFound
		5 gives OsFailure.failureAccessDenied
		32 gives OsFailure.failureBusy
		80 gives OsFailure.failureAlreadyExists
		default gives OsFailure.failureOther
	end 'code'
end 'failureOfWin32'

// OsOperation is an operation whose failures are cases of an error of its own.
export enum OsOperation
	opRead
	opWrite
	opRename
	opDelete
	opList
	opSpawn
end 'OsOperation'

// failureCase is the case of an operation's error that each failure is.
export function failureCase(op OsOperation, failure OsFailure) returns Count
	if op == OsOperation.opRead 'read'
		return match failure 'f'
			failureNotFound gives ast.errorReadNotFound
			failureAccessDenied gives ast.errorReadAccessDenied
			failureBusy gives ast.errorReadBusy
			failureAlreadyExists gives ast.errorReadFailed
			failureOther gives ast.errorReadFailed
		end 'f'
	end 'read'
	if op == OsOperation.opWrite 'write'
		return match failure 'f'
			failureNotFound gives ast.errorWriteNotFound
			failureAccessDenied gives ast.errorWriteAccessDenied
			failureBusy gives ast.errorWriteBusy
			failureAlreadyExists gives ast.errorWriteAlreadyExists
			failureOther gives ast.errorWriteFailed
		end 'f'
	end 'write'
	if op == OsOperation.opRename 'rename'
		return match failure 'f'
			failureNotFound gives ast.errorRenameNotFound
			failureAccessDenied gives ast.errorRenameAccessDenied
			failureBusy gives ast.errorRenameBusy
			failureAlreadyExists gives ast.errorRenameAlreadyExists
			failureOther gives ast.errorRenameFailed
		end 'f'
	end 'rename'
	if op == OsOperation.opDelete 'delete'
		return match failure 'f'
			failureNotFound gives ast.errorDeleteNotFound
			failureAccessDenied gives ast.errorDeleteAccessDenied
			failureBusy gives ast.errorDeleteBusy
			failureAlreadyExists gives ast.errorDeleteFailed
			failureOther gives ast.errorDeleteFailed
		end 'f'
	end 'delete'
	if op == OsOperation.opList 'list'
		return match failure 'f'
			failureNotFound gives ast.errorListNotFound
			failureAccessDenied gives ast.errorListAccessDenied
			failureBusy gives ast.errorListFailed
			failureAlreadyExists gives ast.errorListFailed
			failureOther gives ast.errorListFailed
		end 'f'
	end 'list'
	return match failure 'f'
		failureNotFound gives ast.errorExecutableNotFound
		failureAccessDenied gives ast.errorSpawnFailed
		failureBusy gives ast.errorSpawnBusy
		failureAlreadyExists gives ast.errorSpawnFailed
		failureOther gives ast.errorSpawnFailed
	end 'f'
end 'failureCase'

// payloadField is the index, in the payload of a case of Executable or WaitDeadline, of the one field it has.
export let payloadField = 0 as Count

// Path characters that FilePath.from refuses besides the control characters, as maxon's does on Windows.
// lastControlByte is the highest byte that is a control character.
export let lastControlByte = 31 as Count

// invalidPathBytes are the printable bytes Windows refuses in a path.
export let invalidPathBytes = "<>\"|?*"

// pathSeparator is the native separator, which FilePath.from writes for otherSeparator.
export let pathSeparator = 92 as Byte

export let otherSeparator = 47 as Byte

// failing calls an OS entry that can fail, giving it the address of its error word last, and goes on only when the entry
// did not fail; dst is noReg for an entry that returns nothing.
function failing(mutates l Lowerer, p ast.Project, ms ast.ModuleState, site diag.Site, dst Reg, symbol Rt, args RegList) returns Reg
	let errSlot = l.b.f.newSlot(IrKind.kindScalar)
	var all = args.clone()
	all.push(slotAddr(l, slot: errSlot))
	emitEntry(l, p: p, site: site, dst: dst, symbol: symbol, args: all, routine: ast.noFunc)
	let err = load(l, slot: errSlot)
	let ok = l.b.newBlock()
	let clear = isZero(l, v: err)
	let stub = failure(l, p: p, ms: ms, errorCase: 0 as Count, err: err, errDrop: ast.noType)
	l.b.terminate(l.cur, t: newBranch(clear, ifTrue: ok, ifFalse: stub))
	l.cur = ok
	return dst
end 'failing'

function slotAddr(mutates l Lowerer, slot Count) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newSlotAddr(d, slot: slot))
	return d
end 'slotAddr'

// pathText is the String a FilePath holds, lent for as long as the path is.
function pathText(mutates l Lowerer, path Reg) returns Reg
	let d = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newLoadField(d, obj: path, offset: fieldOffset(ast.filePathPathField, tagged: false)))
	return d
end 'pathText'

// builtinRecord is a new box of a record of the table, whose fields are the values by index.
function builtinRecord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, values RegList) returns Reg
	let ty = applyType(l, p: p, ms: ms, t: t)
	let origin = ms.types.lists[ast.typeList(ms.types, t: ty)][ast.typeIndex(ms.types, t: ty)].effectiveOrigin()
	if ast.typeKind(ms.types, t: ty) != ast.TypeKind.record or ms.types.lists[ast.typeList(ms.types, t: origin)][ast.typeIndex(ms.types, t: origin)].fields.count() != values.count() 'shape'
		panic("lower: {ast.typeName(ms.types, t: t)} is not a record of {values.count()} fields")
	end 'shape'
	let box = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newAlloc(box, bytes: boxBytes(values.count(), tagged: false)))
	for i in 0 upto values.count() 'each'
		emit(l, i: newStoreField(box, offset: fieldOffset(i, tagged: false), src: values[i]))
	end 'each'
	return box
end 'builtinRecord'

function lowerCommandLineArgs(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsArgs, kind: IrKind.kindManaged, args: RegList.create(0))
end 'lowerCommandLineArgs'

function lowerProcessEnvironmentVariable(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let dst = newReg(l, kind: IrKind.kindManaged)
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtOsEnvironmentVariable, args: argsOf1(args[0]))
end 'lowerProcessEnvironmentVariable'

function lowerProcessExecutablePath(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let dst = newReg(l, kind: IrKind.kindManaged)
	let text = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtOsExecutablePath, args: RegList.create(0))
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: argsOf1(text))
end 'lowerProcessExecutablePath'

function lowerProcessId(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsProcessId, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerProcessId'

function lowerClockNowNanos(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsClockNanos, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerClockNowNanos'

function lowerProcessSetExitCode(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsSetExitCode, args: argsOf1(args[0]))
	return konst(l, value: 0 as Word)
end 'lowerProcessSetExitCode'

function lowerDirectoryCurrentPath(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let text = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsCurrentPath, kind: IrKind.kindManaged, args: RegList.create(0))
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: argsOf1(text))
end 'lowerDirectoryCurrentPath'

function lowerFilePathFrom(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let dst = newReg(l, kind: IrKind.kindManaged)
	let text = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtOsPathFrom, args: argsOf1(args[0]))
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: argsOf1(text))
end 'lowerFilePathFrom'

// invalidPathText is what the program says when a path written as `FilePath from "..."` is one the OS refuses.
let invalidPathText = "FilePath: invalid path"

// lowerFilePathInit is `FilePath from "text"`: FilePath.from, which stops the program where it would throw.
function lowerFilePathInit(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let errSlot = l.b.f.newSlot(IrKind.kindScalar)
	let dst = newReg(l, kind: IrKind.kindManaged)
	var all = argsOf1(args[0])
	all.push(slotAddr(l, slot: errSlot))
	emitEntry(l, p: p, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtOsPathFrom, args: all, routine: ast.noFunc)
	let err = load(l, slot: errSlot)
	let ok = l.b.newBlock()
	let refused = l.b.newBlock()
	let clear = isZero(l, v: err)
	l.b.terminate(l.cur, t: newBranch(clear, ifTrue: ok, ifFalse: refused))
	l.cur = refused
	let message = strReg(l, value: invalidPathText.clone())
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanic, args: argsOf1(message), routine: ast.noFunc)
	l.b.terminate(l.cur, t: newTrap())
	l.cur = ok
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: argsOf1(dst))
end 'lowerFilePathInit'

function lowerFilePathToString(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let text = pathText(l, path: recv)
	let string = p.builtins.stringTy
	return copyValue(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), v: text, t: string)
end 'lowerFilePathToString'

function lowerFileReadText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let dst = newReg(l, kind: IrKind.kindManaged)
	let path = pathText(l, path: args[0])
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtOsReadText, args: argsOf1(path))
end 'lowerFileReadText'

function lowerFileWriteText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsWriteText, args: argsOf2(path, b: args[1]))
	return konst(l, value: 0 as Word)
end 'lowerFileWriteText'

function lowerFileWriteBinary(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsWriteBinary, args: argsOf2(path, b: args[1]))
	return konst(l, value: 0 as Word)
end 'lowerFileWriteBinary'

function lowerFileRename(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let from = pathText(l, path: args[0])
	let target = pathText(l, path: args[1])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsRename, args: argsOf2(from, b: target))
	return konst(l, value: 0 as Word)
end 'lowerFileRename'

function lowerFileDelete(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsDelete, args: argsOf1(path))
	return konst(l, value: 0 as Word)
end 'lowerFileDelete'

function lowerDirectoryIsDirectory(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsIsDirectory, kind: IrKind.kindScalar, args: argsOf1(path))
end 'lowerDirectoryIsDirectory'

function lowerDirectoryCreate(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsCreateDirectory, kind: IrKind.kindScalar, args: argsOf1(path))
end 'lowerDirectoryCreate'

// lowerDirectoryList makes a FilePath of each String the entry gives, in its place in the array, so the array the entry
// made is the one returned.
function lowerDirectoryList(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let dst = newReg(l, kind: IrKind.kindManaged)
	let path = pathText(l, path: args[0])
	let paths = failing(l, p: p, ms: ms, site: site, dst: dst, symbol: Rt.rtOsList, args: argsOf1(path))
	let listTy = builtinOf(l, p: p, ms: ms, collection: exprType(p, module: l.module, node: c.node))
	let pathTy = elementType(p, ms: ms, bt: listTy)
	let n = entry(l, p: p, site: site, symbol: Rt.rtArrayLen, kind: IrKind.kindScalar, args: argsOf1(paths))
	let loop = countedLoopBegin(l, limit: n)
	let i = countedLoopIndex(l, loop: loop)
	let addr = entry(l, p: p, site: site, symbol: Rt.rtArrayElem, kind: IrKind.kindScalar, args: argsOf2(paths, b: i))
	let text = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newMoveAt(text, addr: addr))
	let made = builtinRecord(l, p: p, ms: ms, t: pathTy, values: argsOf1(text))
	emit(l, i: newStoreAt(addr, src: made))
	countedLoopEnd(l, loop: loop)
	return paths
end 'lowerDirectoryList'

// noDeadline is the deadline of rt.os.run that never passes.
export let noDeadline = 0 as Word

function lowerSubprocessRun(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let never = konst(l, value: noDeadline)
	return runSubprocess(l, p: p, ms: ms, c: c, executable: args[0], arguments: args[1], deadlineMs: never)
end 'lowerSubprocessRun'

function lowerSubprocessRunWithDeadline(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let millis = deadlineMs(l, p: p, deadline: args[2])
	return runSubprocess(l, p: p, ms: ms, c: c, executable: args[0], arguments: args[1], deadlineMs: millis)
end 'lowerSubprocessRunWithDeadline'

// deadlineMs is the milliseconds a WaitDeadline gives, noDeadline for none.
function deadlineMs(mutates l Lowerer, p ast.Project, deadline Reg) returns Reg
	let millis = l.b.f.newSlot(IrKind.kindScalar)
	let never = konst(l, value: noDeadline)
	emit(l, i: newStoreSlot(millis, src: never, borrow: false))
	let within = l.b.newBlock()
	let join = l.b.newBlock()
	let tag = tagReg(l, box: deadline)
	let withinCase = konst(l, value: try ast.waitDeadlineWithin as Word otherwise panic("ir: a case index is out of range"))
	let isWithin = compare(l, op: CmpOp.cmpEq, a: tag, b: withinCase, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(isWithin, ifTrue: within, ifFalse: join))
	l.cur = within
	let payload = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadField(payload, obj: deadline, offset: fieldOffset(payloadField, tagged: true)))
	emit(l, i: newStoreSlot(millis, src: payload, borrow: false))
	goTo(l, target: join)
	return load(l, slot: millis)
end 'deadlineMs'

// runSubprocess runs the child and makes the CollectedOutput of what the entry stored and returned.
function runSubprocess(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, executable Reg, arguments Reg, deadlineMs Reg) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let stdout = l.b.f.newSlot(IrKind.kindManaged)
	let stderr = l.b.f.newSlot(IrKind.kindManaged)
	let dst = newReg(l, kind: IrKind.kindScalar)
	let exe = executableText(l, p: p, exe: executable)
	var all = RegList.create(0)
	all.push(exe)
	all.push(arguments)
	all.push(deadlineMs)
	all.push(slotAddr(l, slot: stdout))
	all.push(slotAddr(l, slot: stderr))
	let code = failing(l, p: p, ms: ms, site: site, dst: dst, symbol: Rt.rtOsRun, args: all)
	var fields = RegList.create(0)
	for i in 0 upto succ(ast.collectedOutputCodeField) 'fields'
		fields.push(noReg)
	end 'fields'
	fields[ast.collectedOutputStdoutField] = fetch(l, slot: stdout)
	fields[ast.collectedOutputStderrField] = fetch(l, slot: stderr)
	fields[ast.collectedOutputCodeField] = code
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: fields)
end 'runSubprocess'

// executableText is the String an Executable names, a name or a path's, lent for as long as the Executable is.
function executableText(mutates l Lowerer, p ast.Project, exe Reg) returns Reg
	let text = l.b.f.newSlot(IrKind.kindManaged)
	let payload = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newLoadField(payload, obj: exe, offset: fieldOffset(payloadField, tagged: true)))
	let path = l.b.newBlock()
	let name = l.b.newBlock()
	let join = l.b.newBlock()
	let tag = tagReg(l, box: exe)
	let pathCase = konst(l, value: try ast.executablePath as Word otherwise panic("ir: a case index is out of range"))
	let isPath = compare(l, op: CmpOp.cmpEq, a: tag, b: pathCase, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(isPath, ifTrue: path, ifFalse: name))
	l.cur = path
	let pathString = pathText(l, path: payload)
	emit(l, i: newStoreSlot(text, src: pathString, borrow: true))
	goTo(l, target: join)
	l.cur = name
	emit(l, i: newStoreSlot(text, src: payload, borrow: true))
	goTo(l, target: join)
	l.cur = join
	return load(l, slot: text)
end 'executableText'

function lowerCollectedOutputExitCode(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadField(d, obj: recv, offset: fieldOffset(ast.collectedOutputCodeField, tagged: false)))
	return d
end 'lowerCollectedOutputExitCode'

function lowerCollectedOutputSucceeded(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let code = lowerCollectedOutputExitCode(l, p: p, ms: ms, c: c, recv: recv, args: args)
	return isZero(l, v: code)
end 'lowerCollectedOutputSucceeded'
