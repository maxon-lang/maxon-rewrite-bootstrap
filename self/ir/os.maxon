	let dst = newReg(l, kind: IrKind.kindManaged)
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtDebugReadMemory, args: argsOf3(args[0], b: args[1], c: args[2]))
