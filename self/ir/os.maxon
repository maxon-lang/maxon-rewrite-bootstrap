function lowerDebuggeeWriteContext(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtDebugWriteContext, args: argsOf2(args[0], b: args[1]))
	return konst(l, value: 0 as Word)
