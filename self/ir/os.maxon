// The debug port's functions call their entries with their words, byte arrays and the executable's text as they are.
function lowerDebuggeeLaunch(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let exe = executableText(l, p: p, ms: ms, exe: args[0])
	let dst = newReg(l, kind: IrKind.kindScalar)
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtDebugLaunch, args: argsOf3(exe, b: args[1], c: args[2]))
end 'lowerDebuggeeLaunch'

function lowerDebuggeeWaitEvent(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtDebugWaitEvent, kind: IrKind.kindManaged, args: argsOf1(args[0]))
end 'lowerDebuggeeWaitEvent'

function lowerDebuggeeContinueEvent(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let unhandledCase = konst(l, value: try ast.dispositionUnhandled as Word otherwise panic("ir: a case index is out of range"))
	let unhandled = compare(l, op: CmpOp.cmpEq, a: args[2], b: unhandledCase, unsigned: false)
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtDebugContinueEvent, kind: IrKind.kindScalar, args: argsOf3(args[0], b: args[1], c: unhandled))
end 'lowerDebuggeeContinueEvent'

