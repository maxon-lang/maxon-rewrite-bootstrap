function lowerSchedulerYield(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtYield, args: RegList.create(0))
	return konst(l, value: 0 as Word)
end 'lowerSchedulerYield'

function lowerSleep(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtSleep, args: argsOf1(args[0]))
	return konst(l, value: 0 as Word)
end 'lowerSleep'

function lowerProcessSetExitCode(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsSetExitCode, args: argsOf1(args[0]))
	return konst(l, value: 0 as Word)
end 'lowerProcessSetExitCode'

// lowerProcessExitAtOnce is Process.exit: it ends the process with the code at once (rt.os.exitAtOnce), which never
// returns, so the block ends there, as after a panic.
function lowerProcessExitAtOnce(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsExitAtOnce, args: argsOf1(args[0]))
	seal(l, t: newTrap())
	return konst(l, value: 0 as Word)
end 'lowerProcessExitAtOnce'

// lowerReadStdin is a fresh byte array of what one read of standard input gave: the box of an array of bytes, which a
// __ManagedMemory of bytes is.
function lowerReadStdin(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsReadStdin, kind: IrKind.kindManaged, args: argsOf1(args[0]))
end 'lowerReadStdin'

// lowerOsEnvironmentEntry is a fresh byte array of the environment's entry at an index: the box of an array of bytes, which a
// __ManagedMemory of bytes is.
function lowerOsEnvironmentEntry(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsEnvironmentEntry, kind: IrKind.kindManaged, args: argsOf1(try args.get(0) otherwise panic("osEnvironmentEntry takes one argument, which the checker has seen")))
end 'lowerOsEnvironmentEntry'

function lowerStdoutWantsColor(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsStdoutWantsColor, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerStdoutWantsColor'

function lowerDirectoryCurrentPath(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let text = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsCurrentPath, kind: IrKind.kindManaged, args: RegList.create(0))
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: argsOf1(text))
end 'lowerDirectoryCurrentPath'

function lowerFilePathFrom(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let dst = newReg(l, kind: IrKind.kindString)
	let text = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtOsPathFrom, args: argsOf1(args[0]))
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: argsOf1(text))
end 'lowerFilePathFrom'

// invalidPathText is what the program says when a path written as `FilePath from "..."` is one the OS refuses.
let invalidPathText = "FilePath: invalid path"

// lowerFilePathInit is `FilePath from "text"`: FilePath.from, which stops the program where it would throw.
function lowerFilePathInit(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let errSlot = l.b.f.newSlot(IrKind.kindScalar)
	let dst = newReg(l, kind: IrKind.kindString)
	var all = argsOf1(args[0])
	all.push(slotAddr(l, slot: errSlot))
	emitEntry(l, p: p, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtOsPathFrom, args: all, routine: ast.noFunc)
	let err = load(l, slot: errSlot)
	let ok = l.b.newBlock()
	let refused = l.b.newBlock()
	let clear = isZero(l, v: err)
	l.b.terminate(l.cur, t: newBranch(clear, ifTrue: ok, ifFalse: refused))
	l.cur = refused
	let message = strReg(l, value: invalidPathText.clone())
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanic, args: argsOf1(message), routine: ast.noFunc)
	l.b.terminate(l.cur, t: newTrap())
	l.cur = ok
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: argsOf1(dst))
end 'lowerFilePathInit'

function lowerFilePathToString(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let text = pathText(l, path: recv)
	let string = p.builtins.stringTy
	return copyValue(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), v: text, t: string)
end 'lowerFilePathToString'

function lowerFileReadText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return lowerFileRead(l, p: p, ms: ms, c: c, args: args, kind: IrKind.kindString, symbol: Rt.rtOsReadText)
end 'lowerFileReadText'

function lowerFileReadBinary(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return lowerFileRead(l, p: p, ms: ms, c: c, args: args, kind: IrKind.kindManaged, symbol: Rt.rtOsReadBinary)
end 'lowerFileReadBinary'

// lowerFileRead is a whole read of the file at the path that is the call's one argument, by the runtime's entry, into a value of a kind.
function lowerFileRead(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, args RegList, kind IrKind, symbol Rt) returns Reg
	let dst = newReg(l, kind: kind)
	let path = pathText(l, path: try args.get(0) otherwise panic("a read of a file takes one argument, which the checker has seen"))
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: symbol, args: argsOf1(path))
end 'lowerFileRead'

// isExecutable is whether a FilePermission is the executable case, as the flag the runtime's write takes.
function isExecutable(mutates l Lowerer, mode Reg) returns Reg
	let executable = konst(l, value: try ast.filePermissionExecutable as Word otherwise panic("ir: a case index is out of range"))
	return compare(l, op: CmpOp.cmpEq, a: mode, b: executable, unsigned: false)
end 'isExecutable'

function lowerFileWriteText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	let executable = isExecutable(l, mode: args[2])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsWriteTextMode, args: argsOf3(path, b: args[1], c: executable))
	return konst(l, value: 0 as Word)
end 'lowerFileWriteText'

function lowerManagedFileOpenRead(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return openHandle(l, p: p, ms: ms, c: c, args: args, symbol: Rt.rtFileOpenRead)
end 'lowerManagedFileOpenRead'

function lowerManagedFileOpenWrite(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return openHandle(l, p: p, ms: ms, c: c, args: args, symbol: Rt.rtFileOpenWrite)
end 'lowerManagedFileOpenWrite'

function lowerManagedFileOpenWriteExecutable(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return openHandle(l, p: p, ms: ms, c: c, args: args, symbol: Rt.rtFileOpenWriteExecutable)
end 'lowerManagedFileOpenWriteExecutable'

function lowerManagedFileOpenCreateNew(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return openHandle(l, p: p, ms: ms, c: c, args: args, symbol: Rt.rtFileOpenCreateNew)
end 'lowerManagedFileOpenCreateNew'

// openHandle is an open of the file whose path is the bytes of the call's one argument, by the runtime's entry, which gives the
// handle's word, which the library's __ManagedFile holds until its close, and whose error word is a __ManagedFileError's.
function openHandle(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, args RegList, symbol Rt) returns Reg
	let dst = newReg(l, kind: IrKind.kindScalar)
	let path = try args.get(0) otherwise panic("an open of a file takes a path, which the checker has seen")
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: symbol, args: argsOf1(path))
end 'openHandle'

// lowerManagedFileReadAppending reads into the buffer that the call's second argument changes, after its length, by the runtime's
// entry, which grows the length and gives the count.
function lowerManagedFileReadAppending(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let handle = try args.get(0) otherwise panic("a read of a file takes its handle's word, which the checker has seen")
	let buffer = try args.get(1) otherwise panic("a read of a file takes a buffer, which the checker has seen")
	let most = try args.get(2) otherwise panic("a read of a file takes a count, which the checker has seen")
	let dst = newReg(l, kind: IrKind.kindScalar)
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtFileReadAppending, args: argsOf3(handle, b: buffer, c: most))
end 'lowerManagedFileReadAppending'

// lowerManagedFileWrite writes the whole of the buffer that is the call's second argument by the runtime's entry.
function lowerManagedFileWrite(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let handle = try args.get(0) otherwise panic("a write of a file takes its handle's word, which the checker has seen")
	let buffer = try args.get(1) otherwise panic("a write of a file takes a buffer, which the checker has seen")
	let dst = newReg(l, kind: IrKind.kindScalar)
	return failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: dst, symbol: Rt.rtFileWrite, args: argsOf2(handle, b: buffer))
end 'lowerManagedFileWrite'

// lowerManagedFileClose ends the handle whose word is the call's one argument, which the library's __ManagedFile.close gives up:
// the runtime's close, which closes it whether or not it fails and sets the error word with writeFailed when the system's
// close reports an error, as Go's Close does.
function lowerManagedFileClose(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let handle = try args.get(0) otherwise panic("a close of a file takes its handle's word, which the checker has seen")
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtFileClose, args: argsOf1(handle))
	return konst(l, value: 0 as Word)
end 'lowerManagedFileClose'

function lowerFileWriteBinary(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	let executable = isExecutable(l, mode: args[2])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsWriteBinaryMode, args: argsOf3(path, b: args[1], c: executable))
	return konst(l, value: 0 as Word)
end 'lowerFileWriteBinary'

function lowerFileRename(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let from = pathText(l, path: args[0])
	let target = pathText(l, path: args[1])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsRename, args: argsOf2(from, b: target))
	return konst(l, value: 0 as Word)
end 'lowerFileRename'

function lowerFileDelete(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsDelete, args: argsOf1(path))
	return konst(l, value: 0 as Word)
end 'lowerFileDelete'

// fileInfoDirectoryBit and fileInfoReadOnlyShift are where rt.os.fileInfo's attributes word holds its two flags.
let fileInfoDirectoryBit = 1 as Word

let fileInfoReadOnlyShift = 1 as Word

// lowerFileInfo makes the FileInfo of what the entry stored and returned: the times and the size as they are, and each flag
// as its bit of the attributes word, which is 0 or 1 as a bool is.
function lowerFileInfo(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let size = l.b.f.newSlot(IrKind.kindScalar)
	let created = l.b.f.newSlot(IrKind.kindScalar)
	let accessed = l.b.f.newSlot(IrKind.kindScalar)
	let attributes = l.b.f.newSlot(IrKind.kindScalar)
	let dst = newReg(l, kind: IrKind.kindScalar)
	var all = RegList.create(0)
	all.push(pathText(l, path: args[0]))
	all.push(slotAddr(l, slot: size))
	all.push(slotAddr(l, slot: created))
	all.push(slotAddr(l, slot: accessed))
	all.push(slotAddr(l, slot: attributes))
	let modified = failing(l, p: p, ms: ms, site: site, dst: dst, symbol: Rt.rtOsFileInfo, args: all)
	let flags = load(l, slot: attributes)
	let directoryBit = konst(l, value: fileInfoDirectoryBit)
	let isDirectory = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(isDirectory, op: BinOp.binAnd, left: flags, right: directoryBit, unsigned: true, fail: noBlock))
	let readOnlyShift = konst(l, value: fileInfoReadOnlyShift)
	let isReadOnly = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(isReadOnly, op: BinOp.binShr, left: flags, right: readOnlyShift, unsigned: true, fail: noBlock))
	var fields = RegList.create(0)
	for i in 0 upto succ(ast.fileInfoIsReadOnlyField) 'fields'
		fields.push(noReg)
	end 'fields'
	fields[ast.fileInfoSizeField] = load(l, slot: size)
	fields[ast.fileInfoModifiedTimeField] = modified
	fields[ast.fileInfoCreatedTimeField] = load(l, slot: created)
	fields[ast.fileInfoAccessedTimeField] = load(l, slot: accessed)
	fields[ast.fileInfoIsDirectoryField] = isDirectory
	fields[ast.fileInfoIsReadOnlyField] = isReadOnly
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: fields)
end 'lowerFileInfo'

function lowerFileExists(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsExists, kind: IrKind.kindScalar, args: argsOf1(path))
end 'lowerFileExists'

function lowerDirectoryIsDirectory(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsIsDirectory, kind: IrKind.kindScalar, args: argsOf1(path))
end 'lowerDirectoryIsDirectory'

function lowerDirectoryCreate(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtOsCreateDirectory, kind: IrKind.kindScalar, args: argsOf1(path))
end 'lowerDirectoryCreate'

function lowerDirectoryDelete(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let path = pathText(l, path: args[0])
	_ = failing(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), dst: noReg, symbol: Rt.rtOsDeleteDirectory, args: argsOf1(path))
	return konst(l, value: 0 as Word)
end 'lowerDirectoryDelete'

// lowerDirectoryList makes a FilePath of each String the entry gives, moved out of the array of strings the entry made,
// which is then dropped empty.
function lowerDirectoryList(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let dst = newReg(l, kind: IrKind.kindManaged)
	let path = pathText(l, path: args[0])
	let paths = failing(l, p: p, ms: ms, site: site, dst: dst, symbol: Rt.rtOsList, args: argsOf1(path))
	let listTy = builtinOf(l, p: p, ms: ms, collection: exprType(p, module: l.module, node: c.node))
	let pathTy = elementType(p, ms: ms, bt: listTy)
	let n = entry(l, p: p, site: site, symbol: Rt.rtArrayLen, kind: IrKind.kindScalar, args: argsOf1(paths))
	let out = entry(l, p: p, site: site, symbol: Rt.rtArrayNew, kind: IrKind.kindManaged, args: RegList.create(0))
	entryVoid(l, p: p, site: site, symbol: Rt.rtArrayReserve, args: argsOf2(out, b: n))
	let loop = countedLoopBegin(l, limit: n)
	let i = countedLoopIndex(l, loop: loop)
	let addr = entry(l, p: p, site: site, symbol: Rt.rtStrsElem, kind: IrKind.kindScalar, args: argsOf2(paths, b: i))
	let text = newReg(l, kind: IrKind.kindString)
	emit(l, i: newMoveAt(text, addr: addr))
	let made = builtinRecord(l, p: p, ms: ms, t: pathTy, values: argsOf1(text))
	entryVoid(l, p: p, site: site, symbol: Rt.rtArrayInsert, args: argsOf3(out, b: i, c: made))
	countedLoopEnd(l, loop: loop)
	var stringArgs = ast.TypeIDList.create(0)
	stringArgs.push(p.builtins.stringTy)
	let strings = ast.instantiateType(ms.types, reads: p.types, origin: p.builtins.arrayOrigin, args: stringArgs)
	dropValue(l, p: p, ms: ms, v: paths, t: strings)
	return out
end 'lowerDirectoryList'

// noDeadline is the deadline of rt.os.run that never passes.
export let noDeadline = 0 as Word

function lowerSubprocessRun(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let never = konst(l, value: noDeadline)
	return runSubprocess(l, p: p, ms: ms, c: c, executable: args[0], arguments: args[1], directory: noReg, input: noReg, deadlineMs: never)
end 'lowerSubprocessRun'

function lowerSubprocessRunWithDeadline(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let millis = deadlineMs(l, p: p, ms: ms, deadline: args[2])
	return runSubprocess(l, p: p, ms: ms, c: c, executable: args[0], arguments: args[1], directory: noReg, input: noReg, deadlineMs: millis)
end 'lowerSubprocessRunWithDeadline'

function lowerSubprocessRunInDirectory(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let millis = deadlineMs(l, p: p, ms: ms, deadline: args[3])
	let directory = pathText(l, path: args[2])
	return runSubprocess(l, p: p, ms: ms, c: c, executable: args[0], arguments: args[1], directory: directory, input: noReg, deadlineMs: millis)
end 'lowerSubprocessRunInDirectory'

function lowerSubprocessRunWithInput(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let millis = deadlineMs(l, p: p, ms: ms, deadline: args[3])
	return runSubprocess(l, p: p, ms: ms, c: c, executable: args[0], arguments: args[1], directory: noReg, input: args[2], deadlineMs: millis)
end 'lowerSubprocessRunWithInput'

// deadlineMs is the milliseconds a WaitDeadline gives, noDeadline for none.
function deadlineMs(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, deadline Reg) returns Reg
	let millis = l.b.f.newSlot(IrKind.kindScalar)
	let never = konst(l, value: noDeadline)
	emit(l, i: newStoreSlot(millis, src: never, borrow: false))
	let within = l.b.newBlock()
	let join = l.b.newBlock()
	let tag = tagReg(l, p: p, ms: ms, t: p.builtins.waitDeadlineTy, v: deadline)
	let withinCase = konst(l, value: try ast.waitDeadlineWithin as Word otherwise panic("ir: a case index is out of range"))
	let isWithin = compare(l, op: CmpOp.cmpEq, a: tag, b: withinCase, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(isWithin, ifTrue: within, ifFalse: join))
	l.cur = within
	let payload = unionPayload(l, p: p, ms: ms, t: p.builtins.waitDeadlineTy, v: deadline, caseIndex: ast.waitDeadlineWithin, index: payloadField, kind: IrKind.kindScalar)
	emit(l, i: newStoreSlot(millis, src: payload, borrow: false))
	goTo(l, target: join)
	return load(l, slot: millis)
end 'deadlineMs'

// runSubprocess runs the child and makes the CollectedOutput of what the entry stored and returned. A run in a directory, which
// is noReg for the caller's working directory, uses rt.os.runIn; a run with input, which is noReg for none, gives the child the
// input as its standard input by rt.os.runInput. No run has both.
function runSubprocess(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, executable Reg, arguments Reg, directory Reg, input Reg, deadlineMs Reg) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let stdout = l.b.f.newSlot(IrKind.kindString)
	let stderr = l.b.f.newSlot(IrKind.kindString)
	let dst = newReg(l, kind: IrKind.kindScalar)
	let exe = executableText(l, p: p, ms: ms, exe: executable)
	var all = RegList.create(0)
	all.push(exe)
	all.push(arguments)
	var symbol = Rt.rtOsRun
	if directory != noReg 'directory'
		all.push(directory)
		symbol = Rt.rtOsRunIn
	end 'directory'
	if input != noReg 'input'
		all.push(input)
		symbol = Rt.rtOsRunInput
	end 'input'
	all.push(deadlineMs)
	all.push(slotAddr(l, slot: stdout))
	all.push(slotAddr(l, slot: stderr))
	let code = failing(l, p: p, ms: ms, site: site, dst: dst, symbol: symbol, args: all)
	var fields = RegList.create(0)
	for i in 0 upto succ(ast.collectedOutputCodeField) 'fields'
		fields.push(noReg)
	end 'fields'
	fields[ast.collectedOutputStdoutField] = fetch(l, slot: stdout)
	fields[ast.collectedOutputStderrField] = fetch(l, slot: stderr)
	fields[ast.collectedOutputCodeField] = code
	return builtinRecord(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node), values: fields)
end 'runSubprocess'

// executableText is the String an Executable names, a name or a path's, lent for as long as the Executable is.
function executableText(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, exe Reg) returns Reg
	let text = l.b.f.newSlot(IrKind.kindString)
	let path = l.b.newBlock()
	let name = l.b.newBlock()
	let join = l.b.newBlock()
	let tag = tagReg(l, p: p, ms: ms, t: p.builtins.executableTy, v: exe)
	let pathCase = konst(l, value: try ast.executablePath as Word otherwise panic("ir: a case index is out of range"))
	let isPath = compare(l, op: CmpOp.cmpEq, a: tag, b: pathCase, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(isPath, ifTrue: path, ifFalse: name))
	l.cur = path
	let filePath = unionPayload(l, p: p, ms: ms, t: p.builtins.executableTy, v: exe, caseIndex: ast.executablePath, index: payloadField, kind: IrKind.kindManaged)
	let pathString = pathText(l, path: filePath)
	emit(l, i: newStoreSlot(text, src: pathString, borrow: true))
	goTo(l, target: join)
	l.cur = name
	let nameString = unionPayload(l, p: p, ms: ms, t: p.builtins.executableTy, v: exe, caseIndex: ast.executableName, index: payloadField, kind: IrKind.kindString)
	emit(l, i: newStoreSlot(text, src: nameString, borrow: true))
	goTo(l, target: join)
	l.cur = join
	return load(l, slot: text)
end 'executableText'

function lowerCollectedOutputExitCode(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	let offset = fieldAt(l, p: p, ms: ms, owner: exprType(p, module: l.module, node: c.receiver), index: ast.collectedOutputCodeField)
	emit(l, i: newLoadField(d, obj: recv, offset: offset))
	return d
end 'lowerCollectedOutputExitCode'

function lowerCollectedOutputSucceeded(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let code = lowerCollectedOutputExitCode(l, p: p, ms: ms, c: c, recv: recv, args: args)
	return isZero(l, v: code)
end 'lowerCollectedOutputSucceeded'

