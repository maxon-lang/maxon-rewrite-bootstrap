// pushScope opens a scope.
export function pushScope(mutates l Lowerer, block bool)
	l.scopes.push(Scope.make(block))
end 'pushScope'

// popScope leaves the innermost scope, dropping what it holds.
export function popScope(mutates l Lowerer, p ast.Project)
	unwind(l, p: p, depth: pred(l.scopes.count()))
	try l.scopes.pop() otherwise ignore
end 'popScope'

// unwind drops what the scopes from depth inwards hold, innermost first, and keeps them open: it is the code of a jump
// out of them, and the code after the jump is still inside.
export function unwind(mutates l Lowerer, p ast.Project, depth Count)
	var i = l.scopes.count()
	while i > depth 'scopes'
		i = pred(i)
		var n = l.scopes[i].drops.count()
		while n > 0 'drops'
			n = pred(n)
			emitDrop(l, d: l.scopes[i].drops[n].clone())
		end 'drops'
	end 'scopes'
end 'unwind'

function emitDrop(mutates l Lowerer, d PendingDrop)
	if d.inSlot 'slot'
		emitDropSlot(l, slot: d.slot, ty: d.ty)
	end 'slot' else 'reg'
		emitDropReg(l, src: d.reg, ty: d.ty)
	end 'reg'
end 'emitDrop'

// ownLocal makes the block that is open drop a local when it ends. The slot holds nothing until the local is given a
// value, and nothing again once it is moved from, and dropping an empty slot does nothing, so the drop needs no knowledge
// of which path ran.
export function ownLocal(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, slot Count, t ast.TypeID)
	if not owning(kindOf(l, p: p, ms: ms, t: t)) 'scalar'
		return
	end 'scalar'
	var i = l.scopes.count()
	while i > 0 'scopes'
		i = pred(i)
		if l.scopes[i].block 'block'
			let ty = dropType(l, p: p, ms: ms, t: t)
			l.scopes[i].drops.push(PendingDrop.ofSlot(slot, ty: ty))
			return
		end 'block'
	end 'scopes'
	panic("lower: a local outside any block")
end 'ownLocal'

// ownTemp makes the innermost scope drop a fresh value that nothing owns.
function ownTemp(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg, t ast.TypeID)
	let top = pred(l.scopes.count())
	let ty = dropType(l, p: p, ms: ms, t: t)
	l.scopes[top].drops.push(PendingDrop.ofReg(v, ty: ty))
end 'ownTemp'

// dropValue drops an owned value now.
function dropValue(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg, t ast.TypeID)
	if owning(regKind(l, v: v)) 'managed'
		let ty = dropType(l, p: p, ms: ms, t: t)
		emitDropReg(l, src: v, ty: ty)
	end 'managed'
end 'dropValue'

// dropAt drops the value held at an address that is about to be assigned: the old value of a field, an element or an
// mutates parameter.
function dropAt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, addr Reg, t ast.TypeID)
	if holderOwns(l, p: p, ms: ms, t: t) 'managed'
		let ty = dropType(l, p: p, ms: ms, t: t)
		emitDropAt(l, addr: addr, ty: ty)
	end 'managed'
end 'dropAt'

// storeField assigns a field of the type t at offset, held as h, dropping its old value first; a field whose words are the
// record's own is given a copy of v's words, and holds nothing to drop.
function storeField(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, obj Reg, offset Count, h Holding, t ast.TypeID, v Reg)
	match h 'holding'
		heldInline(words) then copyWordsAt(l, dst: obj, at: offset, src: v, words: words)
		heldWord or
		heldString or
		heldBox then storeOwnField(l, p: p, ms: ms, obj: obj, offset: offset, t: t, v: v)
		heldAddress(_) panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
		heldPacked panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
	end 'holding'
end 'storeField'

// storeOwnField assigns a field that the record holds in its form, as storeField says.
function storeOwnField(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, obj Reg, offset Count, t ast.TypeID, v Reg)
	let kept = boxed(l, p: p, ms: ms, v: v, t: t)
	if holderOwns(l, p: p, ms: ms, t: t) 'managed'
		let addr = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newFieldAddr(addr, obj: obj, offset: offset))
		dropAt(l, p: p, ms: ms, addr: addr, t: t)
	end 'managed'
	emit(l, i: newStoreField(obj, offset: offset, src: kept, borrow: false))
end 'storeOwnField'

// fetch reads a slot that held a value only on its way from one place to another, such as the result of a conditional. A
// managed value is moved out, so the slot is empty again and nothing drops it twice.
export function fetch(mutates l Lowerer, slot Count) returns Reg
	let d = newReg(l, kind: slotKind(l, slot: slot))
	if owning(slotKind(l, slot: slot)) 'managed'
		emit(l, i: newMoveSlot(d, slot: slot))
	end 'managed' else 'scalar'
		emit(l, i: newLoadSlot(d, slot: slot))
	end 'scalar'
	return d
end 'fetch'

// dropType is the type a drop names: the type the body writes, with the instance's arguments applied.
function dropType(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	return applyType(l, p: p, ms: ms, t: t)
end 'dropType'
