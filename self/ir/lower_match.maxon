// lowerMatch lowers a match, as a statement when resultType is none and as an expression of that type otherwise.
function lowerMatch(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, core ast.NodeID, resultType ast.TypeID) returns Reg
	let subjectNode = ast.matchCoreSubject(p.modules[l.mi].tree, id: core)
	let applied = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: subjectNode))
	let st = ast.contentType(ms.types, reads: p.types, t: applied)
	let mark = l.pending.count()
	let subject = lowerRead(l, p: p, ms: ms, e: subjectNode)
	// A subject that the match consumes is the match's from here: each arm takes it apart before anything can fail.
	popPending(l, n: mark)
	let join = l.b.newBlock()
	pushJumps(l, node: core, brk: join, cont: noBlock)
	var hasResult = false
	var result = 0 as Count
	if resultType != ast.noType 'valued'
		hasResult = true
		result = l.b.f.newSlot(kindOf(l, p: p, ms: ms, t: resultType))
	end 'valued'
	let takesApart = ast.matchCoreConsumes(p.modules[l.mi].tree, id: core)
	let armsRef = ast.matchCoreArmsRef(p.modules[l.mi].tree, id: core)
	// carried is the body of the next arm, once the arm before it falls through into it.
	var carried = noBlock
	for a in 0 upto p.modules[l.mi].tree.listLen(armsRef) 'arms'
		let arm = p.modules[l.mi].tree.listAt(armsRef, index: a) as ast.NodeID
		let patternsRef = ast.matchArmPatternsRef(p.modules[l.mi].tree, id: arm)
		var body = carried
		if body == noBlock 'fresh'
			body = l.b.newBlock()
		end 'fresh'
		carried = noBlock
		let next = l.b.newBlock()
		let last = a + 1 == p.modules[l.mi].tree.listLen(armsRef)
		if ast.matchArmIsDefault(p.modules[l.mi].tree, id: arm) or (last and closedSubject(p, ms: ms, st: st)) 'default'
			goTo(l, target: body)
		end 'default' else 'patterns'
			for i in 0 upto p.modules[l.mi].tree.listLen(patternsRef) 'each'
				testPattern(l, p: p, ms: ms, pat: p.modules[l.mi].tree.listAt(patternsRef, index: i) as ast.NodeID, st: st, subject: subject, body: body)
			end 'each'
			goTo(l, target: next)
		end 'patterns'
		l.cur = body
		if takesApart 'takeApart'
			pushScope(l, block: true)
			takeApart(l, p: p, ms: ms, arm: arm, subject: subject, st: st)
		end 'takeApart' else 'borrow'
			borrowPayloads(l, p: p, ms: ms, arm: arm, subject: subject, st: st)
		end 'borrow'
		let form = ast.matchArmForm(p.modules[l.mi].tree, id: arm)
		if form == ast.ArmKind.armThen 'then'
			lowerStmt(l, p: p, ms: ms, s: ast.matchArmAction(p.modules[l.mi].tree, id: arm))
		end 'then' else if form == ast.ArmKind.armGives 'gives'
			pushScope(l, block: false)
			storeConverted(l, p: p, ms: ms, slot: result, e: ast.matchArmValue(p.modules[l.mi].tree, id: arm), target: resultType)
			popScope(l, p: p, ms: ms)
		end 'gives' else if form == ast.ArmKind.armPanic 'panics'
			pushScope(l, block: false)
			_ = lowerExpr(l, p: p, ms: ms, e: ast.matchArmValue(p.modules[l.mi].tree, id: arm))
			popScope(l, p: p, ms: ms)
		end 'panics' else 'other'
			panic("lower: unhandled match arm kind")
		end 'other'
		if takesApart 'popApart'
			popScope(l, p: p, ms: ms)
		end 'popApart'
		if ast.matchArmFalls(p.modules[l.mi].tree, id: arm) and a + 1 < p.modules[l.mi].tree.listLen(armsRef) 'falls'
			carried = l.b.newBlock()
			goTo(l, target: carried)
		end 'falls' else 'leaves'
			goTo(l, target: join)
		end 'leaves'
		l.cur = next
	end 'arms'
	if not l.b.terminated(l.cur) 'open'
		l.b.terminate(l.cur, t: newTrap())
	end 'open'
	popJumps(l)
	l.cur = join
	if not hasResult 'noResult'
		return konst(l, value: 0 as Word)
	end 'noResult'
	return fetch(l, slot: result)
end 'lowerMatch'

// closedSubject is whether a match on a value of type st that has no default arm names every value st can hold, which the
// checker holds an enum, a union and a bool to: its last arm then takes what no arm before it took, untested.
function closedSubject(p ast.Project, ms ast.ModuleState, st ast.TypeID) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: st)
	return kind == ast.TypeKind.enumTy or kind == ast.TypeKind.unionTy or st == p.builtins.boolTy
end 'closedSubject'

// payloadAt is where the payload at index of the case caseIndex of a box of the union st, a type the body names, sits.
function payloadAt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, st ast.TypeID, caseIndex Count, index Count) returns Count
	let applied = applyType(l, p: p, ms: ms, t: st)
	return payloadOffset(ms.types, reads: p.types, owner: applied, caseIndex: caseIndex, index: index)
end 'payloadAt'

// heldAsWord is whether the subject of a match, of type st, is a union held as a word, whose payload is the word itself.
function heldAsWord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, st ast.TypeID) returns bool
	let applied = applyType(l, p: p, ms: ms, t: st)
	return ast.typeKind(ms.types, reads: p.types, t: applied) == ast.TypeKind.unionTy and unionForm(ms.types, reads: p.types, t: applied) != UnionForm.unionBoxed
end 'heldAsWord'

// borrowPayloads binds the payload an arm names to a borrow of the subject's box.
function borrowPayloads(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, arm ast.NodeID, subject Reg, st ast.TypeID)
	let patternsRef = ast.matchArmPatternsRef(p.modules[l.mi].tree, id: arm)
	for i in 0 upto p.modules[l.mi].tree.listLen(patternsRef) 'patterns'
		let pat = p.modules[l.mi].tree.listAt(patternsRef, index: i) as ast.NodeID
		let info = patternInfoAt(p, module: l.module, node: pat)
		for j in 0 upto info.bindings.count() 'bindings'
			if info.bindings[j] != ast.noLocal 'named'
				let local = localEntry(p, module: l.fnModule, id: info.bindings[j])
				let kind = kindOf(l, p: p, ms: ms, t: local.ty)
				let d = unionPayload(l, p: p, ms: ms, t: st, v: subject, caseIndex: info.caseIdx, index: j, kind: kind)
				// A payload held in place may be the managed word of its box, which the binding borrows as any managed payload.
				emit(l, i: newStoreSlot(slotOf(local), src: d, borrow: owning(regKind(l, v: d))))
			end 'named'
		end 'bindings'
	end 'patterns'
end 'borrowPayloads'

// takeApart is the start of an arm of a match that consumes its subject: each payload the arm names moves out of the box
// into a local that owns it, which leaves the field empty, and then the box is dropped, which skips the empty fields and
// drops the payloads the arm does not name.
function takeApart(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, arm ast.NodeID, subject Reg, st ast.TypeID)
	let patternsRef = ast.matchArmPatternsRef(p.modules[l.mi].tree, id: arm)
	// A union held as its payload's address is that payload, which a binding takes whole, leaving nothing to drop.
	var taken = false
	for i in 0 upto p.modules[l.mi].tree.listLen(patternsRef) 'patterns'
		let pat = p.modules[l.mi].tree.listAt(patternsRef, index: i) as ast.NodeID
		let info = patternInfoAt(p, module: l.module, node: pat)
		for j in 0 upto info.bindings.count() 'bindings'
			if info.bindings[j] != ast.noLocal 'named'
				let local = localEntry(p, module: l.fnModule, id: info.bindings[j])
				let kind = kindOf(l, p: p, ms: ms, t: local.ty)
				if heldAsWord(l, p: p, ms: ms, st: st) 'word'
					emit(l, i: newStoreSlot(slotOf(local), src: subject, borrow: false))
					ownLocal(l, p: p, ms: ms, slot: slotOf(local), t: local.ty)
					taken = owning(kind)
					continue 'bindings'
				end 'word'
				let offset = payloadAt(l, p: p, ms: ms, st: st, caseIndex: info.caseIdx, index: j)
				let d = newReg(l, kind: kind)
				if owning(kind) 'managed'
					let addr = newReg(l, kind: IrKind.kindScalar)
					emit(l, i: newFieldAddr(addr, obj: subject, offset: offset))
					emit(l, i: newMoveAt(d, addr: addr))
				end 'managed' else 'scalar'
					emit(l, i: newLoadField(d, obj: subject, offset: offset))
				end 'scalar'
				emit(l, i: newStoreSlot(slotOf(local), src: d, borrow: false))
				ownLocal(l, p: p, ms: ms, slot: slotOf(local), t: local.ty)
			end 'named'
		end 'bindings'
	end 'patterns'
	if not taken 'drop'
		dropValue(l, p: p, ms: ms, v: subject, t: st)
	end 'drop'
end 'takeApart'

function testPattern(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, pat ast.NodeID, st ast.TypeID, subject Reg, body BlockID)
	let unsigned = ast.isUnsignedInt(ms.types, reads: p.types, t: st)
	let fail = l.b.newBlock()
	let form = ast.patternForm(p.modules[l.mi].tree, id: pat)
	if form == ast.PatternKind.patCase 'case'
		var scrutinee = subject
		if ast.typeKind(ms.types, reads: p.types, t: st) == ast.TypeKind.unionTy 'union'
			scrutinee = tagReg(l, p: p, ms: ms, t: st, v: subject)
		end 'union'
		let idx = konst(l, value: try patternInfoAt(p, module: l.module, node: pat).caseIdx as Word otherwise panic("ir: a case index is out of range"))
		let cmp = compare(l, op: CmpOp.cmpEq, a: scrutinee, b: idx, unsigned: false)
		l.b.terminate(l.cur, t: newBranch(cmp, ifTrue: body, ifFalse: fail))
	end 'case' else if form == ast.PatternKind.patLiteral and st == p.builtins.stringTy 'string'
		let testBlock = l.cur
		let lit = lowerExpr(l, p: p, ms: ms, e: ast.patternValue(p.modules[l.mi].tree, id: pat))
		let eq = runtime(l, symbol: Rt.rtStreq, kind: IrKind.kindScalar, args: argsOf2(subject, b: lit))
		l.b.terminate(testBlock, t: newBranch(eq, ifTrue: body, ifFalse: fail))
	end 'string' else if form == ast.PatternKind.patLiteral and st == p.builtins.characterTy 'character'
		let testBlock = l.cur
		let lit = lowerExpr(l, p: p, ms: ms, e: ast.patternValue(p.modules[l.mi].tree, id: pat))
		let eq = characterEquals(l, left: subject, right: lit)
		l.b.terminate(testBlock, t: newBranch(eq, ifTrue: body, ifFalse: fail))
	end 'character' else if form == ast.PatternKind.patRange and st == p.builtins.characterTy 'characters'
		let lo = lowerExpr(l, p: p, ms: ms, e: ast.patternValue(p.modules[l.mi].tree, id: pat))
		let atLeast = characterOrder(l, op: CmpOp.cmpGe, left: subject, right: lo)
		let upper = l.b.newBlock()
		l.b.terminate(l.cur, t: newBranch(atLeast, ifTrue: upper, ifFalse: fail))
		l.cur = upper
		let hi = lowerExpr(l, p: p, ms: ms, e: ast.patternHigh(p.modules[l.mi].tree, id: pat))
		var below = CmpOp.cmpLt
		if ast.patternInclusive(p.modules[l.mi].tree, id: pat) 'inclusive'
			below = CmpOp.cmpLe
		end 'inclusive'
		let atMost = characterOrder(l, op: below, left: subject, right: hi)
		l.b.terminate(l.cur, t: newBranch(atMost, ifTrue: body, ifFalse: fail))
	end 'characters' else if form == ast.PatternKind.patLiteral 'literal'
		let valueNode = ast.patternValue(p.modules[l.mi].tree, id: pat)
		var value = 0 as Word
		if p.modules[l.mi].tree.kindOf(valueNode) == ast.NodeKind.boolLit 'bool'
			if ast.boolLitValue(p.modules[l.mi].tree, id: valueNode) 'true'
				value = 1
			end 'true'
		end 'bool' else 'int'
			value = constBits(p, ms: ms, t: exprType(p, module: l.module, node: valueNode))
		end 'int'
		let c = konst(l, value: value)
		let cmp = compare(l, op: CmpOp.cmpEq, a: subject, b: c, unsigned: unsigned)
		l.b.terminate(l.cur, t: newBranch(cmp, ifTrue: body, ifFalse: fail))
	end 'literal' else if form == ast.PatternKind.patRange 'range'
		let lo = constValueOf(p, ms: ms, t: exprType(p, module: l.module, node: ast.patternValue(p.modules[l.mi].tree, id: pat)))
		var hi = constValueOf(p, ms: ms, t: exprType(p, module: l.module, node: ast.patternHigh(p.modules[l.mi].tree, id: pat)))
		if not ast.patternInclusive(p.modules[l.mi].tree, id: pat) 'exclusive'
			hi = hi.sub(ast.I128.one())
		end 'exclusive'
		let upper = l.b.newBlock()
		let loC = konst(l, value: wordOf(lo))
		let geCmp = compare(l, op: CmpOp.cmpGe, a: subject, b: loC, unsigned: unsigned)
		l.b.terminate(l.cur, t: newBranch(geCmp, ifTrue: upper, ifFalse: fail))
		l.cur = upper
		let hiC = konst(l, value: wordOf(hi))
		let leCmp = compare(l, op: CmpOp.cmpLe, a: subject, b: hiC, unsigned: unsigned)
		l.b.terminate(l.cur, t: newBranch(leCmp, ifTrue: body, ifFalse: fail))
	end 'range' else 'other'
		panic("lower: unhandled pattern kind")
	end 'other'
	l.cur = fail
end 'testPattern'

// constValueOf is the value of an integer constant, which is the type the checker gave the expression that writes it.
function constValueOf(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.I128
	if ast.typeKind(ms.types, reads: p.types, t: t) != ast.TypeKind.constInt 'notConst'
		panic("lower: {ast.typeName(ms.types, reads: p.types, t: t)} is not an integer constant")
	end 'notConst'
	return ast.typeEntry(ms.types, reads: p.types, t: t).minVal.clone()
end 'constValueOf'

function constBits(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns Word
	return wordOf(constValueOf(p, ms: ms, t: t))
end 'constBits'
