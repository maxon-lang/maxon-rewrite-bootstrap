// The verifier: the rules that the IR of every function keeps, which a pass that changes it must keep too. Each register is
// defined once, by an instruction or as a block parameter; every definition dominates its uses; an edge passes as many
// arguments, of the kinds, as its target has parameters, and the entry has none; and an edge that leaves its block before
// its end (an instruction's `else`) passes none and is the only edge into the block it goes to.
//
// Dominance is over segments: a block is cut after each instruction that can fail, since its failure edge leaves from
// there, and the result of that instruction is defined only where it did not fail, at the start of the next segment.

// verifyIr is what is wrong with the IR of a function and of its bodies, a line for each rule it breaks.
export function verifyIr(p ast.Project, f IrFunction) returns ast.StringList
	var problems = ast.StringList.create(0)
	verifyInto(p, f: f, problems: problems)
	return problems
end 'verifyIr'

function verifyInto(p ast.Project, f IrFunction, mutates problems ast.StringList)
	var v = Verifier.new(irSymbol(p, f: f))
	v.run(f)
	problems.append(v.problems)
	for i in 0 upto f.bodies.count() 'bodies'
		verifyInto(p, f: f.bodies[i], problems: problems)
	end 'bodies'
end 'verifyInto'

function plusOne(n Count) returns Count
	return try n + 1 otherwise panic("ir: a count past memory")
end 'plusOne'

function regIndex(r Reg) returns Count
	return try r as Count otherwise panic("ir: a register that is not one")
end 'regIndex'

// Verifier checks one function. The segments of block b are segBase[b] up to segBase[b + 1]; a register's definition is
// in the segment defSeg, at the place defKey: 0 for a block parameter, k + 1 for the instruction instrs[k], and a use
// in that segment must come at a later place, the terminator's being endAt + 1.
type Verifier
	var name as String
	var problems as ast.StringList
	var segBase as Array with Count
	var defCount as Array with Count
	var defSeg as Array with Count
	var defKey as Array with Count
	var defBlock as Array with Count
	// The edges between segments, and the same edges by target: succ[succStart[s]] up to succ[succStart[s + 1]] are where
	// segment s goes, and pred likewise where segment s is entered from.
	var edgeFrom as Array with Count
	var edgeTo as Array with Count
	var predStart as Array with Count
	var pred as Array with Count
	var succStart as Array with Count
	var succ as Array with Count
	// predCount is how many edges enter each block, the entry's from the function's caller too; failFrom and failTo are
	// the edges that leave a block before its end.
	var predCount as Array with Count
	var failFrom as Array with Count
	var failTo as Array with Count
	// reached is whether the entry reaches a segment, rpo its number in reverse postorder, and idom its immediate dominator
	// once known says it has one.
	var reached as Array with bool
	var rpo as Array with Count
	var order as Array with Count
	var idom as Array with Count
	var known as Array with bool

	static function new(consumes name String) returns Verifier
		return Verifier{name: name, problems: ast.StringList.create(0), segBase: Array.create(0), defCount: Array.create(0), defSeg: Array.create(0), defKey: Array.create(0), defBlock: Array.create(0), edgeFrom: Array.create(0), edgeTo: Array.create(0), predStart: Array.create(0), pred: Array.create(0), succStart: Array.create(0), succ: Array.create(0), predCount: Array.create(0), failFrom: Array.create(0), failTo: Array.create(0), reached: Array.create(0), rpo: Array.create(0), order: Array.create(0), idom: Array.create(0), known: Array.create(0)}
	end 'new'

	function problem(mutates self, text String)
		problems.push("{name}: {text}")
	end 'problem'

	function run(mutates self, f IrFunction)
		if f.blocks.count() == 0 'empty'
			self.problem("the function has no blocks")
			return
		end 'empty'
		if not self.checkShape(f) 'malformed'
			return
		end 'malformed'
		self.segments(f)
		self.definitions(f)
		self.edges(f)
		self.dominators()
		self.checkReads(f)
		self.midBlockEdges()
	end 'run'

	// regOk is whether a register is one of the function's, which a problem names if it is not.
	function regOk(mutates self, f IrFunction, r Reg, block Count) returns bool
		if r < 0 or regIndex(r) >= f.regs.count() 'outside'
			self.problem("b{block} names %{r}, which the function does not have")
			return false
		end 'outside'
		return true
	end 'regOk'

	function regsOk(mutates self, f IrFunction, regs RegList, block Count) returns bool
		var ok = true
		for i in 0 upto regs.count() 'each'
			if not self.regOk(f, r: regs[i], block: block) 'bad'
				ok = false
			end 'bad'
		end 'each'
		return ok
	end 'regsOk'

	// checkShape checks that every block, register and argument that the function names is there and that every edge
	// passes what its target takes; the analyses after it index by them.
	function checkShape(mutates self, f IrFunction) returns bool
		var ok = true
		let n = f.blocks.count()
		if f.blocks[0].paramCount > 0 'entryParams'
			self.problem("the entry b0 has parameters, which no edge sets")
			ok = false
		end 'entryParams'
		for b in 0 upto n 'blocks'
			var params = RegList.create(0)
			for i in 0 upto f.blocks[b].paramCount 'params'
				params.push(f.blockParam(b, i: i))
			end 'params'
			if not self.regsOk(f, regs: params, block: b) 'badParams'
				ok = false
			end 'badParams'
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				var regs = RegList.create(0)
				instrReads(f, x: f.instrs[k], out: regs)
				instrWrites(f.instrs[k], out: regs)
				if not self.regsOk(f, regs: regs, block: b) 'badRegs'
					ok = false
				end 'badRegs'
				let fail = failTarget(f.instrs[k])
				if fail != noBlock and (fail < 0 or blockIndex(fail) >= n) 'badFail'
					self.problem("an instruction of b{b} fails to b{fail}, which the function does not have")
					ok = false
				end 'badFail'
			end 'instrs'
			var regs = RegList.create(0)
			termReads(f, t: f.blocks[b].term, out: regs)
			if not self.regsOk(f, regs: regs, block: b) 'badTermRegs'
				ok = false
			end 'badTermRegs'
			var next = SuccessorVisitor.new()
			visitTerm(next, f: f, t: f.blocks[b].term)
			for e in 0 upto next.out.count() 'edges'
				let target = next.out[e]
				if target < 0 or blockIndex(target) >= n 'badTarget'
					self.problem("b{b} goes to b{target}, which the function does not have")
					ok = false
					continue 'edges'
				end 'badTarget'
				if not self.edgeArgsOk(f, source: b, target: blockIndex(target), start: next.argsStart[e], count: next.argsCount[e]) 'badArgs'
					ok = false
				end 'badArgs'
			end 'edges'
		end 'blocks'
		return ok
	end 'checkShape'

	// edgeArgsOk checks the arguments that an edge from block source passes to target: one of each parameter's kind.
	function edgeArgsOk(mutates self, f IrFunction, source Count, target Count, start Count, count Count) returns bool
		let params = f.blocks[target].paramCount
		if count != params 'arity'
			self.problem("b{source} passes {count} arguments to b{target}, which has {params} parameters")
			return false
		end 'arity'
		let stop = try start + count otherwise panic("ir: an edge's arguments past memory")
		if stop > f.args.count() 'pool'
			self.problem("the arguments that b{source} passes to b{target} lie past the pool")
			return false
		end 'pool'
		var ok = true
		for i in 0 upto count 'each'
			let arg = f.args[try start + i otherwise panic("ir: an edge's arguments past memory")]
			let param = f.blockParam(target, i: i)
			if not self.regOk(f, r: arg, block: source) 'bad'
				ok = false
				continue 'each'
			end 'bad'
			if f.regs[regIndex(arg)] != f.regs[regIndex(param)] 'kind'
				self.problem("b{source} passes the {kindName(f.regs[regIndex(arg)])} %{arg} to the {kindName(f.regs[regIndex(param)])} parameter %{param} of b{target}")
				ok = false
			end 'kind'
		end 'each'
		return ok
	end 'edgeArgsOk'

	// segments numbers the segments of every block.
	function segments(mutates self, f IrFunction)
		segBase = Array.create(0)
		var total = 0 as Count
		for b in 0 upto f.blocks.count() 'blocks'
			segBase.push(total)
			total = plusOne(total)
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				if failTarget(f.instrs[k]) != noBlock 'fails'
					total = plusOne(total)
				end 'fails'
			end 'instrs'
		end 'blocks'
		segBase.push(total)
	end 'segments'

	function define(mutates self, r Reg, seg Count, key Count, block Count)
		let i = regIndex(r)
		if defCount[i] > 0 'twice'
			self.problem("%{r} is defined in b{defBlock[i]} and again in b{block}: a register is defined once")
		end 'twice'
		defCount[i] = plusOne(defCount[i])
		defSeg[i] = seg
		defKey[i] = key
		defBlock[i] = block
	end 'define'

	// definitions finds where each register is defined.
	function definitions(mutates self, f IrFunction)
		let m = f.regs.count()
		defCount = Array.create(m)
		defSeg = Array.create(m)
		defKey = Array.create(m)
		defBlock = Array.create(m)
		for b in 0 upto f.blocks.count() 'blocks'
			var seg = segBase[b]
			for i in 0 upto f.blocks[b].paramCount 'params'
				self.define(f.blockParam(b, i: i), seg: seg, key: 0, block: b)
			end 'params'
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				if failTarget(f.instrs[k]) != noBlock 'fails'
					seg = plusOne(seg)
				end 'fails'
				var writes = RegList.create(0)
				instrWrites(f.instrs[k], out: writes)
				for w in 0 upto writes.count() 'writes'
					self.define(writes[w], seg: seg, key: plusOne(k), block: b)
				end 'writes'
			end 'instrs'
		end 'blocks'
	end 'definitions'

	function edge(mutates self, source Count, dest Count)
		edgeFrom.push(source)
		edgeTo.push(dest)
	end 'edge'

	// edges lists the edges between segments, by source and by target, and counts the edges into each block.
	function edges(mutates self, f IrFunction)
		let n = f.blocks.count()
		predCount = Array.create(n)
		predCount[0] = 1
		for b in 0 upto n 'blocks'
			var seg = segBase[b]
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				let fail = failTarget(f.instrs[k])
				if fail != noBlock 'fails'
					let target = blockIndex(fail)
					let entry = segBase[target]
					self.edge(seg, dest: entry)
					predCount[target] = plusOne(predCount[target])
					failFrom.push(b)
					failTo.push(target)
					self.edge(seg, dest: plusOne(seg))
					seg = plusOne(seg)
				end 'fails'
			end 'instrs'
			var next = SuccessorVisitor.new()
			visitTerm(next, f: f, t: f.blocks[b].term)
			for e in 0 upto next.out.count() 'edges'
				let target = blockIndex(next.out[e])
				let entry = segBase[target]
				self.edge(seg, dest: entry)
				predCount[target] = plusOne(predCount[target])
			end 'edges'
		end 'blocks'
		let segs = segBase[n]
		succStart = csrStarts(edgeFrom, nodes: segs)
		succ = csrFill(edgeFrom, values: edgeTo, starts: succStart)
		predStart = csrStarts(edgeTo, nodes: segs)
		pred = csrFill(edgeTo, values: edgeFrom, starts: predStart)
	end 'edges'

	// dominators numbers the segments the entry reaches in reverse postorder and finds the immediate dominator of each,
	// by Cooper, Harvey and Kennedy's iteration.
	function dominators(mutates self)
		let segs = try succStart.count() - 1 otherwise panic("ir: a function with no segments")
		reached = Array.create(segs)
		rpo = Array.create(segs)
		idom = Array.create(segs)
		known = Array.create(segs)
		order = reversePostorder(succStart, succ: succ, nodes: segs)
		for i in 0 upto order.count() 'number'
			reached[order[i]] = true
			rpo[order[i]] = i
		end 'number'
		known[0] = true
		var changed = true
		while changed 'fixpoint'
			changed = false
			for i in 1 upto order.count() 'each'
				let s = order[i]
				var found = false
				var best = 0 as Count
				for e in predStart[s] upto predStart[plusOne(s)] 'preds'
					let q = pred[e]
					if not known[q] 'unknown'
						continue 'preds'
					end 'unknown'
					if not found 'first'
						best = q
						found = true
					end 'first' else 'meet'
						best = self.intersect(q, b: best)
					end 'meet'
				end 'preds'
				if found and (not known[s] or idom[s] != best) 'moved'
					idom[s] = best
					known[s] = true
					changed = true
				end 'moved'
			end 'each'
		end 'fixpoint'
	end 'dominators'

	function intersect(a Count, b Count) returns Count
		var x = a
		var y = b
		while x != y 'meet'
			while rpo[x] > rpo[y] 'upX'
				x = idom[x]
			end 'upX'
			while rpo[y] > rpo[x] 'upY'
				y = idom[y]
			end 'upY'
		end 'meet'
		return x
	end 'intersect'

	// dominates is whether every path from the entry to the segment b passes through the segment a, both reached.
	function dominates(a Count, b Count) returns bool
		var x = b
		while rpo[x] > rpo[a] 'up'
			x = idom[x]
		end 'up'
		return x == a
	end 'dominates'

	function checkRead(mutates self, r Reg, seg Count, key Count, block Count)
		let i = regIndex(r)
		if defCount[i] == 0 'undefined'
			self.problem("%{r} is used in b{block} and defined nowhere")
			return
		end 'undefined'
		if defSeg[i] == seg 'sameSegment'
			if defKey[i] >= key 'early'
				self.problem("%{r} is used in b{block} before its definition")
			end 'early'
			return
		end 'sameSegment'
		if not reached[defSeg[i]] or not self.dominates(defSeg[i], b: seg) 'undominated'
			self.problem("%{r} is used in b{block}, which its definition in b{defBlock[i]} does not dominate")
		end 'undominated'
	end 'checkRead'

	// checkReads checks that the definition of each register that a reached instruction or terminator reads comes before it on
	// every path.
	function checkReads(mutates self, f IrFunction)
		for b in 0 upto f.blocks.count() 'blocks'
			var seg = segBase[b]
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				if reached[seg] 'live'
					var reads = RegList.create(0)
					instrReads(f, x: f.instrs[k], out: reads)
					for r in 0 upto reads.count() 'reads'
						self.checkRead(reads[r], seg: seg, key: plusOne(k), block: b)
					end 'reads'
				end 'live'
				if failTarget(f.instrs[k]) != noBlock 'fails'
					seg = plusOne(seg)
				end 'fails'
			end 'instrs'
			if reached[seg] 'liveTerm'
				var reads = RegList.create(0)
				termReads(f, t: f.blocks[b].term, out: reads)
				for r in 0 upto reads.count() 'reads'
					self.checkRead(reads[r], seg: seg, key: plusOne(f.blocks[b].endAt), block: b)
				end 'reads'
			end 'liveTerm'
		end 'blocks'
	end 'checkReads'

	// midBlockEdges checks that the block each failure edge goes to has that edge as its only one in, which keeps what is
	// defined there a matter of where in its block the instruction is.
	function midBlockEdges(mutates self)
		var reported as Array with bool
		reported = Array.create(predCount.count())
		for i in 0 upto failTo.count() 'each'
			let target = failTo[i]
			if predCount[target] != 1 and not reported[target] 'shared'
				reported[target] = true
				self.problem("b{target}, where an instruction of b{failFrom[i]} fails to, has {predCount[target]} edges in: a block that an instruction's failure goes to has that edge as its only one")
			end 'shared'
		end 'each'
	end 'midBlockEdges'
end 'Verifier'

// csrStarts are where the entries of each node start when the entries keyed by keys are grouped by node, with the total
// at the end.
function csrStarts(keys Array with Count, nodes Count) returns Array with Count
	var starts as Array with Count
	starts = Array.create(plusOne(nodes))
	for i in 0 upto keys.count() 'count'
		let at = plusOne(keys[i])
		starts[at] = plusOne(starts[at])
	end 'count'
	for s in 0 upto nodes 'sum'
		starts[s + 1] = try starts[s + 1] + starts[s] otherwise panic("ir: more edges than memory")
	end 'sum'
	return starts
end 'csrStarts'

// csrFill groups values by the node in keys of each, in the order they come, at the places csrStarts gave.
function csrFill(keys Array with Count, values Array with Count, starts Array with Count) returns Array with Count
	var out as Array with Count
	out = Array.create(keys.count())
	var fill = starts.clone()
	for i in 0 upto keys.count() 'each'
		let k = keys[i]
		out[fill[k]] = values[i]
		fill[k] = plusOne(fill[k])
	end 'each'
	return out
end 'csrFill'

// reversePostorder lists the nodes that node 0 reaches, each before its successors but along a back edge, by a depth-first
// walk that takes the edges of a node in their order.
function reversePostorder(starts Array with Count, succ Array with Count, nodes Count) returns Array with Count
	var seen as Array with bool
	seen = Array.create(nodes)
	var post as Array with Count
	post = Array.create(0)
	var stack as Array with Count
	stack = Array.create(0)
	var cursor as Array with Count
	cursor = Array.create(0)
	stack.push(0)
	cursor.push(starts[0])
	seen[0] = true
	while stack.count() > 0 'walk'
		let top = try stack.count() - 1 otherwise panic("ir: an empty walk")
		let node = stack[top]
		let at = cursor[top]
		if at < starts[plusOne(node)] 'more'
			cursor[top] = plusOne(at)
			let next = succ[at]
			if not seen[next] 'unseen'
				seen[next] = true
				stack.push(next)
				cursor.push(starts[next])
			end 'unseen'
		end 'more' else 'done'
			post.push(node)
			_ = try stack.pop() otherwise panic("ir: an empty walk")
			_ = try cursor.pop() otherwise panic("ir: an empty walk")
		end 'done'
	end 'walk'
	var order as Array with Count
	order = Array.create(0)
	var i = post.count()
	while i > 0 'reverse'
		i = try i - 1 otherwise panic("ir: an empty walk")
		order.push(post[i])
	end 'reverse'
	return order
end 'reversePostorder'
