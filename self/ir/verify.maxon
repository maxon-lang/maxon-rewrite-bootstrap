// The verifier: the rules that the IR of every function keeps, which a pass that changes it must keep too. Each register is
// defined once, by an instruction or as a block parameter; every definition dominates its uses; an edge passes as many
// arguments, of the kinds, as its target has parameters, and the entry has none; and an edge that leaves its block before
// its end (an instruction's `else`) passes none and is the only edge into the block it goes to.
//
// Dominance is over the segments of Flow (flow.maxon), the blocks cut after each instruction that can fail.

// verifyIr is what is wrong with the IR of a function and of its bodies, a line for each rule it breaks.
export function verifyIr(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction) returns ast.StringList
	var problems = ast.StringList.create(0)
	verifyInto(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: f, problems: problems)
	return problems
end 'verifyIr'

function verifyInto(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction, mutates problems ast.StringList)
	var v = Verifier.new(irSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: f))
	v.run(f)
	if v.problems.count() == 0 'whole'
		v.checkFloats(tt, reads: reads, ft: ft, funcReads: funcReads, f: f)
	end 'whole'
	problems.append(v.problems)
	for i in 0 upto f.bodies.count() 'bodies'
		verifyInto(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: f.bodies[i], problems: problems)
	end 'bodies'
end 'verifyInto'

function plusOne(n Count) returns Count
	return try n + 1 otherwise panic("ir: a count past memory")
end 'plusOne'

function regIndex(r Reg) returns Count
	return try r as Count otherwise panic("ir: a register that is not one")
end 'regIndex'

// Verifier checks one function over its Flow.
type Verifier
	var name as String
	var problems as ast.StringList
	var flow as Flow
	var scratch as RegList

	static function new(consumes name String) returns Verifier
		return Verifier{name: name, problems: ast.StringList.create(0), flow: Flow.new(), scratch: RegList.create(0)}
	end 'new'

	function problem(mutates self, text String)
		problems.push("{name}: {text}")
	end 'problem'

	function run(mutates self, f IrFunction)
		if f.blocks.count() == 0 'empty'
			self.problem("the function has no blocks")
			return
		end 'empty'
		if not self.checkShape(f) 'malformed'
			return
		end 'malformed'
		flow.build(f)
		self.definedOnce()
		self.checkReads(f)
		self.midBlockEdges()
	end 'run'

	// regOk is whether a register is one of the function's, which a problem names if it is not.
	function regOk(mutates self, f IrFunction, r Reg, block Count) returns bool
		if r < 0 or regIndex(r) >= f.regs.count() 'outside'
			self.problem("b{block} names %{r}, which the function does not have")
			return false
		end 'outside'
		return true
	end 'regOk'

	function regsOk(mutates self, f IrFunction, regs RegList, block Count) returns bool
		var ok = true
		for i in 0 upto regs.count() 'each'
			if not self.regOk(f, r: regs[i], block: block) 'bad'
				ok = false
			end 'bad'
		end 'each'
		return ok
	end 'regsOk'

	// checkFloats holds each call to the float signature of the code it reaches, where the function shows that code
	// (convention.maxon): a direct call to its callee's declaration; a callvalue of a closure that the function makes to
	// the closure's body, and of a named function made a value to the function's declaration; and a callwitness on an
	// interface value that the function boxes to the method in the box's table. A function value or an interface value
	// that comes from elsewhere (a parameter, a field, a block's parameter) shows no code, and is held only where it is
	// made.
	function checkFloats(mutates self, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction)
		for k in 0 upto f.instrs.count() 'instrs'
			let op = f.instrs[k].op
			if op == Opcode.opCall 'call'
				let sig = funcSignatureIn(tt, reads: reads, ft: ft, funcReads: funcReads, fid: callCallee(f, x: f.instrs[k]))
				self.expectFloats(f, k: k, args: sig.args, result: sig.result, shift: 0, of: "its callee's declaration")
			end 'call' else if op == Opcode.opCallValue 'value'
				let made = flow.defs.instr[regIndex(f.args[try callValueArgsStart(f.instrs[k]) as Count otherwise panic("ir: arguments before the pool")])]
				if made != noDef 'shown'
					let at = try made as Count otherwise panic("ir: a definition before the instructions")
					if f.instrs[at].op == Opcode.opClosure 'closure'
						let body = closureBody(f, x: f.instrs[at])
						self.expectFloats(f, k: k, args: f.bodies[body].floatParams, result: f.bodies[body].floatResult, shift: 0, of: "its closure's body")
					end 'closure' else if f.instrs[at].op == Opcode.opFuncValue 'named'
						let sig = funcSignatureIn(tt, reads: reads, ft: ft, funcReads: funcReads, fid: funcValueCallee(f, x: f.instrs[at]))
						self.expectFloats(f, k: k, args: sig.args, result: sig.result, shift: 1, of: "the declaration of the function it holds")
					end 'named'
				end 'shown'
			end 'value' else if op == Opcode.opCallWitness 'witness'
				let made = flow.defs.instr[regIndex(f.args[try callWitnessArgsStart(f.instrs[k]) as Count otherwise panic("ir: arguments before the pool")])]
				if made != noDef 'shown'
					let at = try made as Count otherwise panic("ir: a definition before the instructions")
					if f.instrs[at].op == Opcode.opBox 'box'
						self.expectMethodFloats(tt, reads: reads, ft: ft, funcReads: funcReads, f: f, k: k, t: boxTable(f, x: f.instrs[at]))
					end 'box' else if f.instrs[at].op == Opcode.opFrameBox 'frameBox'
						self.expectMethodFloats(tt, reads: reads, ft: ft, funcReads: funcReads, f: f, k: k, t: frameBoxTable(f, x: f.instrs[at]))
					end 'frameBox'
				end 'shown'
			end 'witness'
		end 'instrs'
	end 'checkFloats'

	// expectMethodFloats holds the callwitness f.instrs[k] to the method that its slot names in the table t.
	function expectMethodFloats(mutates self, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction, k Count, t WitnessTable)
		let sig = funcSignatureIn(tt, reads: reads, ft: ft, funcReads: funcReads, fid: t.methods[callWitnessSlot(f.instrs[k])])
		self.expectFloats(f, k: k, args: sig.args, result: sig.result, shift: 0, of: "the method of its interface value's table")
	end 'expectMethodFloats'

	// expectFloats holds the call f.instrs[k] to the signature args and result of the code it reaches, whose parameter
	// i is the call's argument i + shift (the closure a named function's code does not take).
	function expectFloats(mutates self, f IrFunction, k Count, args FloatMask, result bool, shift Count, of String)
		let mask = callFloats(f, x: f.instrs[k])
		for i in shift upto callArgCount(f.instrs[k]) 'args'
			if isFloatAt(mask, place: i) != isFloatAt(args, place: try i - shift otherwise panic("ir: an argument below the shift")) 'differs'
				self.problem("instruction {k} passes the floats {floatsText(mask)}, which {of} does not take")
				return
			end 'differs'
		end 'args'
		if callReturnsFloat(f.instrs[k]) != result 'result'
			self.problem("instruction {k} takes its result as a {floatOrWord(callReturnsFloat(f.instrs[k]))}, which {of} gives as a {floatOrWord(result)}")
		end 'result'
	end 'expectFloats'

	// checkShape checks that every block, register and argument that the function names is there and that every edge
	// passes what its target takes; the analyses after it index by them.
	function checkShape(mutates self, f IrFunction) returns bool
		var ok = true
		let n = f.blocks.count()
		if f.blocks[0].paramCount > 0 'entryParams'
			self.problem("the entry b0 has parameters, which no edge sets")
			ok = false
		end 'entryParams'
		for b in 0 upto n 'blocks'
			var params = RegList.create(0)
			for i in 0 upto f.blocks[b].paramCount 'params'
				params.push(f.blockParam(b, i: i))
			end 'params'
			if not self.regsOk(f, regs: params, block: b) 'badParams'
				ok = false
			end 'badParams'
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				var regs = RegList.create(0)
				instrReads(f, x: f.instrs[k], out: regs)
				instrWrites(f.instrs[k], out: regs)
				if not self.regsOk(f, regs: regs, block: b) 'badRegs'
					ok = false
				end 'badRegs'
				let fail = failTarget(f.instrs[k])
				if fail != noBlock and (fail < 0 or blockIndex(fail) >= n) 'badFail'
					self.problem("an instruction of b{b} fails to b{fail}, which the function does not have")
					ok = false
				end 'badFail'
			end 'instrs'
			var regs = RegList.create(0)
			termReads(f, t: f.blocks[b].term, out: regs)
			if not self.regsOk(f, regs: regs, block: b) 'badTermRegs'
				ok = false
			end 'badTermRegs'
			var next = SuccessorVisitor.new()
			visitTerm(next, f: f, t: f.blocks[b].term)
			for e in 0 upto next.out.count() 'edges'
				let target = next.out[e]
				if target < 0 or blockIndex(target) >= n 'badTarget'
					self.problem("b{b} goes to b{target}, which the function does not have")
					ok = false
					continue 'edges'
				end 'badTarget'
				if not self.edgeArgsOk(f, source: b, target: blockIndex(target), start: next.argsStart[e], count: next.argsCount[e]) 'badArgs'
					ok = false
				end 'badArgs'
			end 'edges'
		end 'blocks'
		return ok
	end 'checkShape'

	// edgeArgsOk checks the arguments that an edge from block source passes to target: one of each parameter's kind.
	function edgeArgsOk(mutates self, f IrFunction, source Count, target Count, start Count, count Count) returns bool
		let params = f.blocks[target].paramCount
		if count != params 'arity'
			self.problem("b{source} passes {count} arguments to b{target}, which has {params} parameters")
			return false
		end 'arity'
		let stop = try start + count otherwise panic("ir: an edge's arguments past memory")
		if stop > f.args.count() 'pool'
			self.problem("the arguments that b{source} passes to b{target} lie past the pool")
			return false
		end 'pool'
		var ok = true
		for i in 0 upto count 'each'
			let arg = f.args[try start + i otherwise panic("ir: an edge's arguments past memory")]
			let param = f.blockParam(target, i: i)
			if not self.regOk(f, r: arg, block: source) 'bad'
				ok = false
				continue 'each'
			end 'bad'
			if f.regs[regIndex(arg)] != f.regs[regIndex(param)] 'kind'
				self.problem("b{source} passes the {kindName(f.regs[regIndex(arg)])} %{arg} to the {kindName(f.regs[regIndex(param)])} parameter %{param} of b{target}")
				ok = false
			end 'kind'
		end 'each'
		return ok
	end 'edgeArgsOk'

	// definedOnce checks that no register is defined twice.
	function definedOnce(mutates self)
		for i in 0 upto flow.defs.againReg.count() 'each'
			let r = flow.defs.againReg[i]
			let first = flow.segBlock[flow.defs.seg[regIndex(r)]]
			let again = flow.segBlock[flow.defs.againSeg[i]]
			self.problem("%{r} is defined in b{first} and again in b{again}: a register is defined once")
		end 'each'
	end 'definedOnce'

	function checkRead(mutates self, r Reg, seg Count, key Count, block Count)
		let i = regIndex(r)
		if not flow.defs.defined[i] 'undefined'
			self.problem("%{r} is used in b{block} and defined nowhere")
			return
		end 'undefined'
		let home = flow.defs.seg[i]
		if home == seg 'sameSegment'
			if flow.defs.place(r) >= key 'early'
				self.problem("%{r} is used in b{block} before its definition")
			end 'early'
			return
		end 'sameSegment'
		if not flow.reached[home] or not flow.dominates(home, b: seg) 'undominated'
			self.problem("%{r} is used in b{block}, which its definition in b{flow.segBlock[home]} does not dominate")
		end 'undominated'
	end 'checkRead'

	// checkReads checks that the definition of each register that a reached instruction or terminator reads comes before it on
	// every path.
	function checkReads(mutates self, f IrFunction)
		for s in 0 upto flow.segCount() 'segs'
			if not flow.reached[s] 'dead'
				continue 'segs'
			end 'dead'
			let b = flow.segBlock[s]
			for k in flow.segFirst[s] upto flow.segEnd[s] 'instrs'
				scratch.clear()
				instrReads(f, x: f.instrs[k], out: scratch)
				for r in 0 upto scratch.count() 'reads'
					let read = scratch[r]
					self.checkRead(read, seg: s, key: plusOne(k), block: b)
				end 'reads'
			end 'instrs'
			if not flow.endsInFailure(s) 'term'
				scratch.clear()
				termReads(f, t: f.blocks[b].term, out: scratch)
				for r in 0 upto scratch.count() 'reads'
					let read = scratch[r]
					self.checkRead(read, seg: s, key: plusOne(f.blocks[b].endAt), block: b)
				end 'reads'
			end 'term'
		end 'segs'
	end 'checkReads'

	// midBlockEdges checks that the block each failure edge goes to has that edge as its only one in, which keeps what is
	// defined there a matter of where in its block the instruction is. The entry is entered from the function's caller too.
	function midBlockEdges(mutates self)
		var reported as Array with bool
		reported = Array.create(flow.segCount())
		for s in 0 upto flow.segCount() 'segs'
			if not flow.endsInFailure(s) 'term'
				continue 'segs'
			end 'term'
			let target = flow.succ[flow.succStart[s]]
			let edgesIn = try flow.predStart[plusOne(target)] - flow.predStart[target] otherwise panic("ir: edges out of order")
			var entering = edgesIn as Count
			if target == 0 'entry'
				entering = plusOne(entering)
			end 'entry'
			if entering != 1 and not reported[target] 'shared'
				reported[target] = true
				self.problem("b{flow.segBlock[target]}, where an instruction of b{flow.segBlock[s]} fails to, has {entering} edges in: a block that an instruction's failure goes to has that edge as its only one")
			end 'shared'
		end 'segs'
	end 'midBlockEdges'
end 'Verifier'
