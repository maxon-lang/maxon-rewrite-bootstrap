// blockIndex is the place of a block in the lists a builder keeps by block.
export function blockIndex(b BlockID) returns Count
	return try b as Count otherwise panic("ir: a block that does not exist is used")
end 'blockIndex'

// SuccessorVisitor collects the edges of a terminator, in the order of its operands: the block each goes to, in out, and
// the arguments it passes, args[argsStart[i]] on, argsCount[i] of them.
export type SuccessorVisitor implements TermVisitor
	export var out as BlockIDList
	export var argsStart as Array with Count
	export var argsCount as Array with Count

	export static function new() returns SuccessorVisitor
		return SuccessorVisitor{out: BlockIDList.create(0), argsStart: Array.create(0), argsCount: Array.create(0)}
	end 'new'

	export function clear(mutates self)
		out.clear()
		argsStart.clear()
		argsCount.clear()
	end 'clear'

	function edge(mutates self, target BlockID, start Count, count Count)
		out.push(target)
		argsStart.push(start)
		argsCount.push(count)
	end 'edge'

	export function visitJump(mutates self, f IrFunction, t Term)
		self.edge(jumpTarget(t), start: jumpArgsStart(t), count: jumpArgsCount(t))
	end 'visitJump'

	export function visitBranch(mutates self, f IrFunction, t Term)
		self.edge(branchIfTrue(t), start: branchTrueArgsStart(t), count: branchTrueArgsCount(t))
		self.edge(branchIfFalse(t), start: branchFalseArgsStart(t), count: branchFalseArgsCount(t))
	end 'visitBranch'

	export function visitSwitch(mutates self, f IrFunction, t Term)
		let start = switchCasesStart(t)
		for i in 0 upto switchCasesCount(t) 'each'
			let at = try start + i otherwise panic("ir: a case list is out of range")
			self.edge(f.cases[at].target, start: f.cases[at].argsStart(), count: f.cases[at].argsCount())
		end 'each'
		self.edge(switchFallback(t), start: switchFallbackArgsStart(t), count: switchFallbackArgsCount(t))
	end 'visitSwitch'

	export function visitRet(mutates self, f IrFunction, t Term)
		_ = 0
	end 'visitRet'

	export function visitTrap(mutates self, f IrFunction, t Term)
		_ = 0
	end 'visitTrap'

	export function visitThrow(mutates self, f IrFunction, t Term)
		_ = 0
	end 'visitThrow'
end 'SuccessorVisitor'

// RenumberVisitor makes a terminator with the blocks it names in its record, not in the cases pool, renumbered.
export type RenumberVisitor implements TermVisitor
	export var newID as BlockIDList
	export var out as Term

	export static function new(consumes newID BlockIDList, consumes t Term) returns RenumberVisitor
		return RenumberVisitor{newID: newID, out: t}
	end 'new'

	export function visitJump(mutates self, f IrFunction, t Term)
		out.target = newID[blockIndex(t.target)]
	end 'visitJump'

	export function visitBranch(mutates self, f IrFunction, t Term)
		out.target = newID[blockIndex(t.target)]
		out.other = newID[blockIndex(t.other)]
	end 'visitBranch'

	export function visitSwitch(mutates self, f IrFunction, t Term)
		out.target = newID[blockIndex(t.target)]
	end 'visitSwitch'

	export function visitRet(mutates self, f IrFunction, t Term)
		_ = 0
	end 'visitRet'

	export function visitTrap(mutates self, f IrFunction, t Term)
		_ = 0
	end 'visitTrap'

	export function visitThrow(mutates self, f IrFunction, t Term)
		_ = 0
	end 'visitThrow'
end 'RenumberVisitor'

// failTarget is the block an instruction goes to when its check fails, or noBlock for one that has no check.
export function failTarget(x Instr) returns BlockID
	// Most instructions cannot fail, and asking instrCanFail first spares them the Option.
	if not instrCanFail(x) 'cannot'
		return noBlock
	end 'cannot'
	return match consumes instrFail(x) 'fail'
		some(target) gives target
		none gives noBlock
	end 'fail'
end 'failTarget'

// setFail changes the block an instruction that can fail goes to.
export function setFail(mutates x Instr, fail BlockID)
	if not instrFail(x).isSome() 'has'
		panic("ir: an instruction that cannot fail has no failure block")
	end 'has'
	x.c = fail as Index
end 'setFail'

// Builder makes the IR of one function at a time. Instructions go into the block that is named, in any order of blocks,
// and finish gives the function with its blocks in the order they were made, one after another in a single list, minus
// the blocks nothing reaches.
export type Builder
	// f is the function under construction: its slots and registers are made as it goes, and the rest is filled in by
	// finish.
	export var f as IrFunction
	export var instrs as InstrList
	export var instrBlock as BlockIDList
	export var terms as TermList
	// paramRegs are the parameters of the blocks, in the order they were made, and paramBlock the block of each.
	export var paramRegs as RegList
	export var paramBlock as BlockIDList
	// keepsSpans is whether the functions it makes keep their instructions' spans: then pos is the span of what is being
	// lowered, which emit gives each instruction, in spans.
	export var keepsSpans as bool
	export var pos as Word
	var spans as SpanList

	export static function new() returns Builder
		return Builder{f: IrFunction.new(ast.noFunc, name: "", paramCount: 0 as Count), instrs: InstrList.create(0), instrBlock: BlockIDList.create(0), terms: TermList.create(0), paramRegs: RegList.create(0), paramBlock: BlockIDList.create(0), keepsSpans: false, pos: noSpan, spans: SpanList.create(0)}
	end 'new'

	// start begins a function, forgetting the one before it.
	export function start(mutates self, decl ast.FuncID, consumes name String, paramCount Count)
		f = IrFunction.new(decl, name: name, paramCount: paramCount)
		instrs = InstrList.create(0)
		instrBlock = BlockIDList.create(0)
		terms = TermList.create(0)
		paramRegs = RegList.create(0)
		paramBlock = BlockIDList.create(0)
		f.keepsSpans = keepsSpans
		pos = noSpan
		if keepsSpans 'spans'
			spans = SpanList.create(0)
		end 'spans'
	end 'start'

	// blockParam adds a parameter to the end of a block's parameters, a register that each edge into the block sets.
	export function blockParam(mutates self, block BlockID, kind IrKind) returns Reg
		let r = f.newReg(kind)
		paramRegs.push(r)
		paramBlock.push(block)
		return r
	end 'blockParam'

	// newBlock makes a block, which comes after the blocks made before it.
	export function newBlock(mutates self) returns BlockID
		let n = terms.count()
		terms.push(Term.make(TermKind.termNone))
		return blockOf(n)
	end 'newBlock'

	// emit adds an instruction to the end of a block.
	export function emit(mutates self, block BlockID, consumes i Instr)
		instrs.push(i)
		instrBlock.push(block)
		if keepsSpans 'span'
			spans.push(pos)
		end 'span'
	end 'emit'

	// terminate ends a block.
	export function terminate(mutates self, block BlockID, consumes t Term)
		terms[blockIndex(block)] = t
	end 'terminate'

	// terminated is whether a block has been ended.
	export function terminated(block BlockID) returns bool
		return terms[blockIndex(block)].kind != TermKind.termNone
	end 'terminated'

	export function str(mutates self, dst Reg, consumes text String) returns Instr
		let n = f.strings.count()
		f.strings.push(text)
		return newStr(dst, text: indexOf(n), character: false)
	end 'str'

	// character is a Str of a character literal's text (runtime/characters.maxon).
	export function character(mutates self, dst Reg, consumes text String) returns Instr
		let n = f.strings.count()
		f.strings.push(text)
		return newStr(dst, text: indexOf(n), character: true)
	end 'character'

	// callImport calls the DLL import name with the words args; the name is one of the function's strings.
	export function callImport(mutates self, dst Reg, name String, args RegList) returns Instr
		let n = f.strings.count()
		f.strings.push(name.clone())
		let start = self.arguments(args)
		return newCallImport(dst, name: indexOf(n), argsStart: start, argsCount: regOf(args.count()))
	end 'callImport'

	// compareExchange compares and exchanges the word at an address: args are the address, the word expected and the word
	// desired.
	export function compareExchange(mutates self, dst Reg, args RegList) returns Instr
		let start = self.arguments(args)
		return newCompareExchange(dst, argsStart: start, argsCount: regOf(args.count()))
	end 'compareExchange'

	// syscall calls the kernel: args are the system call's number and then its words.
	export function syscall(mutates self, dst Reg, args RegList) returns Instr
		let start = self.arguments(args)
		return newSyscall(dst, argsStart: start, argsCount: regOf(args.count()))
	end 'syscall'

	// callCode calls the code at an address with words: args are the address and then the words.
	export function callCode(mutates self, dst Reg, args RegList) returns Instr
		let start = self.arguments(args)
		return newCallCode(dst, argsStart: start, argsCount: regOf(args.count()))
	end 'callCode'

	// callHost calls the code at an address by the host's convention: args are the address and then the words.
	export function callHost(mutates self, dst Reg, args RegList) returns Instr
		let start = self.arguments(args)
		return newCallHost(dst, argsStart: start, argsCount: regOf(args.count()))
	end 'callHost'

	// arguments adds the registers of a call to the pool and gives where they start.
	function arguments(mutates self, args RegList) returns Reg
		let start = regOf(f.args.count())
		f.args.append(args)
		return start
	end 'arguments'

	// callArguments adds the arguments of a call of a function to the pool, with which of them are floats to the float
	// pool, and gives where they start.
	function callArguments(mutates self, args RegList, floats FloatMask) returns Reg
		let start = self.arguments(args)
		if args.count() > 0 'some'
			f.keepFloats(try start as Count otherwise panic("ir: arguments before the pool"), mask: floats)
		end 'some'
		return start
	end 'callArguments'

	// edgeArguments adds the arguments of an edge to the pool and gives where they start.
	function edgeArguments(mutates self, args RegList) returns Index
		let start = indexOf(f.args.count())
		f.args.append(args)
		return start
	end 'edgeArguments'

	// jumpWith is a jump to target that passes args to its parameters.
	export function jumpWith(mutates self, target BlockID, args RegList) returns Term
		return newJumpWith(target, argsStart: self.edgeArguments(args), argsCount: indexOf(args.count()))
	end 'jumpWith'

	// branchWith is a branch on cond to ifTrue, passing trueArgs, or to ifFalse, passing falseArgs.
	export function branchWith(mutates self, cond Reg, ifTrue BlockID, trueArgs RegList, ifFalse BlockID, falseArgs RegList) returns Term
		let start = self.edgeArguments(trueArgs)
		_ = self.edgeArguments(falseArgs)
		return newBranchWith(cond, ifTrue: ifTrue, trueArgsStart: start, trueArgsCount: indexOf(trueArgs.count()), ifFalse: ifFalse, falseArgsCount: indexOf(falseArgs.count()))
	end 'branchWith'

	function callee(mutates self, target ast.FuncID) returns Index
		let n = f.callees.count()
		f.callees.push(target)
		return indexOf(n)
	end 'callee'

	export function typed(mutates self, ty ast.TypeID) returns Index
		let n = f.types.count()
		f.types.push(ty)
		return indexOf(n)
	end 'typed'

	// call calls a function, whose float signature is sig; dst is noReg for one whose value nothing reads.
	export function call(mutates self, dst Reg, target ast.FuncID, args RegList, sig FloatSignature) returns Instr
		return self.throwingCall(dst, target: target, args: args, err: noReg, sig: sig)
	end 'call'

	// throwingCall calls a function that throws, whose error err receives.
	export function throwingCall(mutates self, dst Reg, target ast.FuncID, args RegList, err Reg, sig FloatSignature) returns Instr
		let at = self.callee(target)
		let start = self.callArguments(args, floats: sig.args)
		return newCall(dst, callee: at, argsStart: start, argsCount: regOf(args.count()), errReg: err, floatResult: sig.result)
	end 'throwingCall'

	// callRuntime calls a runtime entry. routine is the function the entry stores to call later, noFunc for every entry
	// but the one that makes a cown; proven is the flag of an element's entry whose index is proved in range.
	export function callRuntime(mutates self, dst Reg, symbol Rt, args RegList, routine ast.FuncID, proven bool) returns Instr
		let start = self.arguments(args)
		var stored = noRoutine
		if routine != ast.noFunc 'stored'
			stored = self.callee(routine)
		end 'stored'
		return newCallRuntime(dst, symbol: symbol, argsStart: start, argsCount: regOf(args.count()), routine: stored, proven: proven)
	end 'callRuntime'

	// body adds the body of a `when` or of a closure to the function, which the instruction that schedules or makes it
	// names by the index this gives.
	export function body(mutates self, consumes body IrFunction) returns Count
		let n = f.bodies.count()
		f.bodies.push(body)
		return n
	end 'body'

	// closureInstr makes a closure of a body that body added, holding the captures.
	export function closureInstr(mutates self, dst Reg, body Count, captures RegList) returns Instr
		let start = self.arguments(captures)
		return newClosure(dst, body: body, capturesStart: start, capturesCount: regOf(captures.count()))
	end 'closureInstr'

	// funcValueInstr makes a closure of a function, which captures nothing.
	export function funcValueInstr(mutates self, dst Reg, fn ast.FuncID) returns Instr
		return newFuncValue(dst, callee: self.callee(fn))
	end 'funcValueInstr'

	// codeAddressInstr gives the address of a function's code.
	export function codeAddressInstr(mutates self, dst Reg, fn ast.FuncID) returns Instr
		return newCodeAddress(dst, callee: self.callee(fn))
	end 'codeAddressInstr'

	// callValueInstr calls the closure in target with args, by the float signature sig of its function type.
	export function callValueInstr(mutates self, dst Reg, target Reg, args RegList, sig FloatSignature) returns Instr
		var all = RegList.create(0)
		all.push(target)
		all.append(args)
		let start = self.callArguments(all, floats: sig.args)
		return newCallValue(dst, argsStart: start, argsCount: regOf(all.count()), floatResult: sig.result)
	end 'callValueInstr'

	// asyncInstr starts target with args as a coroutine and gives its promise in dst. Its arguments are words, which the
	// checker holds to: no float is passed to a coroutine.
	export function asyncInstr(mutates self, dst Reg, target ast.FuncID, args RegList) returns Instr
		let at = self.callee(target)
		let start = self.arguments(args)
		return newAsync(dst, callee: at, argsStart: start, argsCount: regOf(args.count()))
	end 'asyncInstr'

	// whenInstr schedules a behaviour that body added.
	export function whenInstr(mutates self, behaviour Count, cowns RegList, captures RegList) returns Instr
		let start = self.arguments(cowns)
		for i in 0 upto captures.count() 'each'
			f.args.push(captures[i])
		end 'each'
		return newWhen(noReg, body: behaviour, cownsStart: start, cownsCount: regOf(cowns.count()), capturesCount: indexOf(captures.count()))
	end 'whenInstr'

	// postedWhenInstr makes the record of a posted message's behaviour that body added, which it gives in dst: no acquire
	// queues it.
	export function postedWhenInstr(mutates self, dst Reg, behaviour Count, cowns RegList, captures RegList) returns Instr
		let start = self.arguments(cowns)
		for i in 0 upto captures.count() 'each'
			f.args.push(captures[i])
		end 'each'
		return newWhen(dst, body: behaviour, cownsStart: start, cownsCount: regOf(cowns.count()), capturesCount: indexOf(captures.count()))
	end 'postedWhenInstr'

	// table adds the table of an interface value to the function, once however many boxes name it.
	function table(mutates self, consumes t WitnessTable) returns Index
		return indexOf(f.tableIndex(t))
	end 'table'

	// datum gives the constant d, which the function holds once however many reads name it.
	export function datum(mutates self, dst Reg, consumes d Datum) returns Instr
		return newDatum(dst, item: f.datumIndex(d))
	end 'datum'

	// box makes an interface value of the table t and the value in src, which the box owns.
	export function box(mutates self, dst Reg, consumes t WitnessTable, src Reg) returns Instr
		return newBox(dst, table: self.table(t), value: src)
	end 'box'

	// frameBox makes an interface value of the table t and the value src in a frame box of its own.
	export function frameBox(mutates self, dst Reg, consumes t WitnessTable, src Reg) returns Instr
		let index = self.table(t)
		return newFrameBox(dst, table: index, value: src, box: f.newFrameBox())
	end 'frameBox'

	// frameArea gives the address of a frame area of words words of its own, the box of a lent tuple of as many elements.
	export function frameArea(mutates self, dst Reg, words Count) returns Instr
		return newFrameArea(dst, words: words, box: f.newFrameBoxes(frameAreaBoxes(words)))
	end 'frameArea'

	// callWitness calls the method in place slot of the table of the interface value recv, with the value it holds given as
	// conv says, and args, by the float signature sig of the requirement; err is noReg for a method that does not throw.
	export function callWitness(mutates self, dst Reg, conv ReceiverConv, slot Count, recv Reg, args RegList, err Reg, sig FloatSignature) returns Instr
		var all = RegList.create(0)
		all.push(recv)
		all.append(args)
		let start = self.callArguments(all, floats: sig.args)
		return newCallWitness(dst, recv: conv, slot: slot, argsStart: start, argsCount: regOf(all.count()), errReg: err, floatResult: sig.result)
	end 'callWitness'

	// drop drops the owned value in a register, such as a temporary that nothing took, a removed element, or the old
	// value of a place just read. Dropping a value drops what it owns, deeply by type, and a place that holds no value
	// is dropped as a no-op, so a drop at the end of a scope needs no knowledge of the path that led there.
	export function drop(mutates self, src Reg, ty ast.TypeID) returns Instr
		return newDrop(src, ty: self.typed(ty))
	end 'drop'

	// dropSlot drops what a slot owns, if anything, and leaves it empty.
	export function dropSlot(mutates self, slot Count, ty ast.TypeID) returns Instr
		return newDropSlot(slot, ty: self.typed(ty))
	end 'dropSlot'

	// dropAt drops what the address holds, if anything, and leaves it empty: the old value of a field, an element or a
	// mutates parameter that is about to be assigned.
	export function dropAt(mutates self, addr Reg, ty ast.TypeID) returns Instr
		return newDropAt(addr, ty: self.typed(ty))
	end 'dropAt'

	// copy is a deep copy of the owned value in src, which is left as it is: a new box for each record, union and array
	// inside it, and a new string for each string that is not in the executable, so every part of the copy has an owner
	// of its own to free it. A frozen value or a cown reference copies as another owner of the same box. ty is the type of
	// the value, with an instance's type arguments applied, which is what tells the copy where the managed words of each
	// box are.
	export function copy(mutates self, dst Reg, src Reg, ty ast.TypeID) returns Instr
		return newCopy(dst, src: src, ty: self.typed(ty))
	end 'copy'

	// switch is a terminator that goes to the target of the value that matches, or to def, passing no arguments.
	export function switch(mutates self, value Reg, values WordList, targets BlockIDList, def BlockID) returns Term
		var counts as Array with Count
		counts = Array.create(values.count())
		return self.switchWith(value, values: values, targets: targets, caseArgs: RegList.create(0), caseArgCounts: counts, def: def, defArgs: RegList.create(0))
	end 'switch'

	// switchWith is a switch whose case i passes the next caseArgCounts[i] of caseArgs to its target, and whose fallback
	// passes defArgs to def.
	export function switchWith(mutates self, value Reg, values WordList, targets BlockIDList, caseArgs RegList, caseArgCounts Array with Count, def BlockID, defArgs RegList) returns Term
		let first = f.cases.count()
		var at = self.edgeArguments(caseArgs)
		for i in 0 upto values.count() 'each'
			let count = indexOf(caseArgCounts[i])
			f.cases.push(SwitchCase.make(values[i], target: targets[i], args: at, argCount: count))
			at = try at + count otherwise panic("ir: a switch passes more arguments than an index can name")
		end 'each'
		let defStart = self.edgeArguments(defArgs)
		return newSwitchWith(value, casesFirst: indexOf(first), casesCount: indexOf(values.count()), fallback: def, fallbackArgsStart: defStart, fallbackArgsCount: indexOf(defArgs.count()))
	end 'switchWith'

	// groupParams lists the parameters of the blocks block by block, in the order each block's were made: those of block b
	// are out[start[b]] up to, not including, out[start[b + 1]].
	function groupParams(start Array with Count) returns RegList
		let n = terms.count()
		var out = RegList.create(start[n])
		var fill as Array with Count
		fill = Array.create(0)
		for blk in 0 upto n 'starts'
			fill.push(start[blk])
		end 'starts'
		for i in 0 upto paramRegs.count() 'each'
			let blk = blockIndex(paramBlock[i])
			out[fill[blk]] = paramRegs[i]
			fill[blk] = try fill[blk] + 1 otherwise panic("ir: a function has too many block parameters")
		end 'each'
		return out
	end 'groupParams'

	// paramStarts are where the parameters of each block start in the list groupParams makes, and how many there are in all
	// at the end.
	function paramStarts() returns Array with Count
		let n = terms.count()
		var start as Array with Count
		start = Array.create(n + 1)
		for i in 0 upto paramBlock.count() 'count'
			let at = try blockIndex(paramBlock[i]) + 1 otherwise panic("ir: too many blocks")
			start[at] = try start[at] + 1 otherwise panic("ir: a block has too many parameters")
		end 'count'
		for blk in 0 upto n 'sum'
			start[blk + 1] = try start[blk + 1] + start[blk] otherwise panic("ir: a function has too many block parameters")
		end 'sum'
		return start
	end 'paramStarts'

	// failEdges lists, for each block, the blocks its instructions can fail to: those of block b are
	// edges[edgeStart[b]] up to, not including, edges[edgeStart[b + 1]].
	function failEdges(edgeStart Array with Count) returns BlockIDList
		let n = terms.count()
		var edges = BlockIDList.create(edgeStart[n])
		var fill as Array with Count
		fill = Array.create(0)
		for blk in 0 upto n 'starts'
			fill.push(edgeStart[blk])
		end 'starts'
		for i in 0 upto instrs.count() 'each'
			let target = failTarget(instrs[i])
			if target != noBlock 'fails'
				let blk = blockIndex(instrBlock[i])
				let at = fill[blk]
				edges[at] = target
				fill[blk] = try at + 1 otherwise panic("ir: a function has too many failure edges")
			end 'fails'
		end 'each'
		return edges
	end 'failEdges'

	// markReachable finds the blocks that the entry reaches.
	function markReachable() returns Array with bool
		let n = terms.count()
		if n == 0 'empty'
			panic("ir: a function has no blocks")
		end 'empty'
		var edgeStart as Array with Count
		edgeStart = Array.create(n + 1)
		for i in 0 upto instrs.count() 'count'
			if failTarget(instrs[i]) != noBlock 'fails'
				let at = try blockIndex(instrBlock[i]) + 1 otherwise panic("ir: too many blocks")
				edgeStart[at] = try edgeStart[at] + 1 otherwise panic("ir: a block has too many failure edges")
			end 'fails'
		end 'count'
		for blk in 0 upto n 'sum'
			edgeStart[blk + 1] = try edgeStart[blk + 1] + edgeStart[blk] otherwise panic("ir: a function has too many failure edges")
		end 'sum'
		let edges = self.failEdges(edgeStart)
		var reached as Array with bool
		reached = Array.create(n)
		var work = BlockIDList.create(0)
		work.push(0 as BlockID)
		reached[0] = true
		var next = SuccessorVisitor.new()
		while work.count() > 0 'walk'
			let blk = blockIndex(work.pop())
			next.clear()
			visitTerm(next, f: f, t: terms[blk])
			let after = try blk + 1 otherwise panic("ir: too many blocks")
			for at in edgeStart[blk] upto edgeStart[after] 'fails'
				next.out.push(edges[at])
			end 'fails'
			for i in 0 upto next.out.count() 'visit'
				let target = blockIndex(next.out[i])
				if not reached[target] 'new'
					reached[target] = true
					work.push(next.out[i])
				end 'new'
			end 'visit'
		end 'walk'
		return reached
	end 'markReachable'

	// edgesInto counts the edges into each block from the reached blocks, the entry's from the caller too.
	function edgesInto(reached Array with bool) returns Array with Count
		let n = terms.count()
		var into as Array with Count
		into = Array.create(n)
		into[0] = 1
		var next = SuccessorVisitor.new()
		for blk in 0 upto n 'blocks'
			if reached[blk] 'live'
				next.clear()
				visitTerm(next, f: f, t: terms[blk])
				for e in 0 upto next.out.count() 'edges'
					let target = blockIndex(next.out[e])
					into[target] = try into[target] + 1 otherwise panic("ir: a block has too many edges in")
				end 'edges'
			end 'live'
		end 'blocks'
		for i in 0 upto instrs.count() 'fails'
			let target = failTarget(instrs[i])
			if target != noBlock 'jumps'
				if reached[blockIndex(instrBlock[i])] 'live'
					let at = blockIndex(target)
					into[at] = try into[at] + 1 otherwise panic("ir: a block has too many edges in")
				end 'live'
			end 'jumps'
		end 'fails'
		return into
	end 'edgesInto'

	// splitSharedFailures gives each failure edge into a block that another edge also enters a block of its own that jumps
	// there, since the block an instruction's failure goes to has that edge as its only one in (see verify.maxon), and
	// gives which blocks are reached, the new ones too.
	function splitSharedFailures(mutates self, reached Array with bool) returns Array with bool
		let into = self.edgesInto(reached)
		var live = reached.clone()
		for i in 0 upto instrs.count() 'each'
			let target = failTarget(instrs[i])
			if target != noBlock 'fails'
				if reached[blockIndex(instrBlock[i])] and into[blockIndex(target)] > 1 'shared'
					let own = self.newBlock()
					self.terminate(own, t: newJump(target))
					var x = instrs[i].clone()
					setFail(x, fail: own)
					instrs[i] = x
					live.push(true)
				end 'shared'
			end 'fails'
		end 'each'
		return live
	end 'splitSharedFailures'

	// finish ends the function: the blocks that nothing reaches are dropped, a failure edge into a block that another
	// edge enters gets a block of its own (splitSharedFailures), and the blocks keep their order and are
	// numbered from 0. The builder can start another function.
	export function finish(mutates self) returns IrFunction
		let found = self.markReachable()
		let reached = self.splitSharedFailures(found)
		let n = terms.count()
		var counts as Array with Count
		counts = Array.create(n)
		for i in 0 upto instrs.count() 'perBlock'
			let blk = blockIndex(instrBlock[i])
			counts[blk] = try counts[blk] + 1 otherwise panic("ir: a block has too many instructions")
		end 'perBlock'
		var newID = BlockIDList.create(n)
		var places as Array with Count
		places = Array.create(n)
		var kept = 0 as Count
		var total = 0 as Count
		for blk in 0 upto n 'number'
			if reached[blk] 'live'
				newID[blk] = blockOf(kept)
				places[blk] = total
				kept = try kept + 1 otherwise panic("ir: too many blocks")
				total = try total + counts[blk] otherwise panic("ir: a function has too many instructions")
			end 'live'
		end 'number'
		let paramStart = self.paramStarts()
		let grouped = self.groupParams(paramStart)
		var blockParams = RegList.create(0)
		var blocks = BlockList.create(0)
		for blk in 0 upto n 'blocks'
			if reached[blk] 'live'
				var renumber = RenumberVisitor.new(newID.clone(), t: terms[blk].clone())
				visitTerm(renumber, f: f, t: terms[blk])
				let stop = try places[blk] + counts[blk] otherwise panic("ir: a function has too many instructions")
				let params = blockParams.count()
				for at in paramStart[blk] upto paramStart[blk + 1] 'params'
					blockParams.push(grouped[at])
				end 'params'
				let paramCount = blockParams.count() - params
				blocks.push(Block.make(places[blk], endAt: stop, params: params, paramCount: paramCount, term: renumber.out.clone()))
			end 'live'
		end 'blocks'
		var order as Array with Count
		order = Array.create(total)
		for i in 0 upto instrs.count() 'order'
			let blk = blockIndex(instrBlock[i])
			if reached[blk] 'live'
				order[places[blk]] = i
				places[blk] = try places[blk] + 1 otherwise panic("ir: a function has too many instructions")
			end 'live'
		end 'order'
		var done = exchange(f, value: IrFunction.new(ast.noFunc, name: "", paramCount: 0 as Count))
		if keepsSpans 'spans'
			for k in 0 upto total 'place'
				done.spans.push(spans[order[k]])
			end 'place'
		end 'spans'
		var listed as Array with bool
		listed = Array.create(0)
		table.arrange(instrs, source: order, taken: listed)
		var spare = Instr.make(Opcode.opNone)
		for k in 0 upto total 'renumber'
			var x = exchange(instrs[k], value: spare)
			let target = failTarget(x)
			if target != noBlock 'fails'
				setFail(x, fail: newID[blockIndex(target)])
			end 'fails'
			spare = exchange(instrs[k], value: x)
		end 'renumber'
		done.instrs = exchange(instrs, value: InstrList.create(0))
		done.blocks = blocks
		done.blockParams = blockParams
		renumberCases(done, newID: newID)
		return done
	end 'finish'
end 'Builder'

// renumberCases numbers the targets of the cases that the kept switches use.
function renumberCases(mutates f IrFunction, newID BlockIDList)
	for blk in 0 upto f.blocks.count() 'each'
		let t = f.blocks[blk].term.clone()
		if t.kind == TermKind.termSwitch 'switch'
			let start = switchCasesStart(t)
			for i in 0 upto switchCasesCount(t) 'cases'
				let at = try start + i otherwise panic("ir: a case list is out of range")
				f.cases[at].target = newID[blockIndex(f.cases[at].target)]
			end 'cases'
		end 'switch'
	end 'each'
end 'renumberCases'
