// Interface values in the IR (README, "Interface values"): a box of two words, the address of a table and the value. The
// table is that of the value's type for the interface, by the conformance that the module where the value is boxed sees,
// and holds a method for each requirement of the interface, in the order of ast.requirementsOf.

// tableWord starts the link name of a table, which no function's link name starts with, as a routine's starts with its
// kind.
let tableWord = "table"

// widenedWord tells apart the table of a value widened to an interface instance (ast.Widening), by the types the instance
// binds, from that of its own conformance, which the link name of an interface instance does not.
let widenedWord = "widened to"

// tableConcrete is the type whose table a value of the type t is boxed with: t itself, but an integer constant is a value
// of the integer type that its extensions add methods to.
function tableConcrete(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	if ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.constInt 'constant'
		return p.builtins.anon64Ty
	end 'constant'
	return t
end 'tableConcrete'

// standsForInterface is whether a value of the type t, with the code's type parameters bound, is an interface value
// already, which a place of an interface takes as it is.
function standsForInterface(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	return ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.interfaceTy
end 'standsForInterface'

// witnessTable is the table that a value of the type src, written at site in the code of module, is boxed with to be a
// value of iface, with the code's type parameters bound: the conformance is the one the code was given for a type
// parameter, and for any other type the one that module sees. It is none after it refused a conformance that the module
// does not see, or sees twice, which the verify stage reports first wherever the type is known there.
export function witnessTable(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, src ast.TypeID, iface ast.TypeID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates errs diag.ErrorList) returns table.Option with WitnessTable
	let applied = ast.substituteType(ms.types, reads: p.types, t: src, params: bindParams, args: bindArgs)
	let concrete = tableConcrete(p, ms: ms, t: applied)
	let wanted = ast.substituteType(ms.types, reads: p.types, t: iface, params: bindParams, args: bindArgs)
	if ast.isInterfaceHandle(ms.types, reads: p.types, t: wanted) 'handle'
		return handleTable(p, ms: ms, module: module, site: site, concrete: concrete, wanted: wanted, errs: errs)
	end 'handle'
	var conformance = module
	var widened as table.Option with ast.Widening
	widened = table.Option.none
	if ast.typeKind(ms.types, reads: p.types, t: src) == ast.TypeKind.typeParam 'passed'
		conformance = passedWitness(p, ms: ms, enclosing: bindWitnesses, param: src, iface: wanted)
	end 'passed' else 'seen'
		let mark = errs.count()
		let concreteName = ast.typeName(ms.types, reads: p.types, t: concrete)
		let ifaceName = ast.typeName(ms.types, reads: p.types, t: wanted)
		match consumes ast.conformanceSource(p, ms: ms, from: module, t: concrete, iface: wanted) 'source'
			found(c) then conformance = c.module
			ambiguous(first, second) then pushInstanceError(p, module: module, site: site, code: diag.errAmbiguousConformance, message: ast.ambiguousConformanceText(p, from: module, typeName: concreteName, ifaceName: ifaceName, first: first, second: second), errs: errs)
			absent then widened = widenedOrRefused(p, ms: ms, module: module, site: site, concrete: concrete, wanted: wanted, errs: errs)
		end 'source'
		if widened.isSome() 'widened'
			conformance = widened.clone().unwrap().source.module
		end 'widened'
		if errs.count() > mark 'refused'
			return table.Option.none
		end 'refused'
	end 'seen'
	let reqs = ast.requirementsOf(ms.types, reads: p.types, iface: wanted)
	var methods = ast.FuncIDList.create(0)
	for i in 0 upto reqs.count() 'methods'
		let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: reqs[i].sig).name.clone()
		match consumes tableMethod(p, ms: ms, module: module, site: site, concrete: concrete, name: name, conformance: conformance, widened: widened, index: i, errs: errs) 'method'
			some(fid) then methods.push(fid)
			none then return table.Option.none
		end 'method'
		if lendsByAddressIn(p, ms: ms, f: methods[pred(methods.count())]) != lendsByAddressIn(p, ms: ms, f: reqs[i].sig) 'lending'
			panic("lower: '{name}' lends by address and its requirement does not, or the other way about (check.lendsInSelf)")
		end 'lending'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: methods[pred(methods.count())]).intrinsic != ast.Intrinsic.intrNone 'builtin'
			pushInstanceError(p, module: module, site: site, code: diag.errUnsupported, message: "Unsupported: an interface value of a '{ast.typeName(ms.types, reads: p.types, t: concrete)}', whose '{name}' is built in, has no code to call through its table; call it on the value, or through a bound of a type parameter", errs: errs)
			return table.Option.none
		end 'builtin'
		if ast.defers(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: methods[pred(methods.count())])) 'deferring'
			pushInstanceError(p, module: module, site: site, code: diag.errUnsupported, message: "Unsupported: an interface value of a '{ast.typeName(ms.types, reads: p.types, t: concrete)}', whose '{name}' defers its reply, which only a send runs: send it through a handle of the service, a '{ast.typeName(ms.types, reads: p.types, t: concrete)}.handle' or the interface's handle", errs: errs)
			return table.Option.none
		end 'deferring'
	end 'methods'
	var symbol = "{tableWord} {ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: concrete)} as {ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: wanted)} by {ast.moduleLinkPath(p, modID: conformance)}"
	if widened.isSome() 'widened'
		// The table of a value widened to an instance has stubs where the conformance's own has the methods.
		symbol = "{symbol} {widenedWord} {boundLinkName(p, ms: ms, t: wanted)}"
	end 'widened'
	return table.Option.some(WitnessTable.make(symbol, concrete: concrete, iface: wanted, methods: methods))
end 'witnessTable'

// boundLinkName names the type t in a link name with what each interface instance in it binds, which the link name of an
// interface instance leaves out.
function boundLinkName(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	let name = ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: t)
	if ast.typeKind(ms.types, reads: p.types, t: t) != ast.TypeKind.interfaceTy 'other'
		return name
	end 'other'
	var args = ast.StringList.create(0)
	for arg in ast.typeArgsOf(ms.types, reads: p.types, t: t) 'args'
		args.push(boundLinkName(p, ms: ms, t: arg))
	end 'args'
	return "{name}[{ast.joinNames(args, sep: ", ")}]"
end 'boundLinkName'

// widenedOrRefused is how a value of concrete, which no declaration the module sees says implements wanted, is widened to
// it, or none after it refused the conformance.
function widenedOrRefused(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, concrete ast.TypeID, wanted ast.TypeID, mutates errs diag.ErrorList) returns table.Option with ast.Widening
	let widened = ast.widening(p, ms: ms, from: module, t: concrete, iface: wanted)
	if not widened.isSome() 'refused'
		pushInstanceError(p, module: module, site: site, code: diag.errTypeMismatch, message: diag.notConforming(ast.typeName(ms.types, reads: p.types, t: concrete), iface: ast.typeName(ms.types, reads: p.types, t: wanted)), errs: errs)
	end 'refused'
	return widened
end 'widenedOrRefused'

// tableMethod is the method in place index of the table of a value of concrete, which the conformance's method name meets:
// that method, or where the value is widened and the requirement's result boxed, the stub that boxes it. It is none after
// it refused one.
function tableMethod(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, concrete ast.TypeID, name String, conformance diag.ModuleID, widened table.Option with ast.Widening, index Count, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let found = witnessFor(p, ms: ms, module: module, site: site, recv: concrete, name: name, conformance: conformance, errs: errs)
	if not found.isSome() or not widened.isSome() 'asItIs'
		return found
	end 'asItIs'
	let w = widened.clone().unwrap()
	let from = try w.from.get(index) otherwise panic("lower: a widening has no result for the requirement {index}")
	if from == ast.noType 'unboxed'
		return found
	end 'unboxed'
	let heldAt = try w.heldAt.get(index) otherwise panic("lower: a widening has no interface for the requirement {index}")
	return widenedMethod(p, ms: ms, module: module, site: site, method: found.unwrap(), concrete: concrete, from: from, heldAt: heldAt, errs: errs)
end 'tableMethod'

// widenedMethod is the stub that a table of a value widened to an interface calls for method, which gives a value of the
// type from that the table puts in a value of heldAt (ast.widenStub), or none after it refused the table of that box.
function widenedMethod(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, method ast.FuncID, concrete ast.TypeID, from ast.TypeID, heldAt ast.TypeID, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let unbound = ast.TypeIDList.create(0)
	return match consumes witnessTable(p, ms: ms, module: module, site: site, src: from, iface: heldAt, bindParams: unbound.clone(), bindArgs: unbound.clone(), bindWitnesses: ast.WitnessList.create(0), errs: errs) 'held'
		some(t) gives table.Option.some(ast.widenStub(ms.funcs, funcReads: p.funcs, tt: ms.types, reads: p.types, module: module, method: method, owner: concrete, from: from, heldAt: heldAt, heldTable: t.symbol))
		none gives table.Option.none
	end 'held'
end 'widenedMethod'

// tableOfBox is the table that lowering boxes the value of e with, which the module's instances were found for.
function tableOfBox(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, src ast.TypeID, iface ast.TypeID) returns WitnessTable
	var refused = diag.ErrorList.create(0)
	match consumes witnessTable(p, ms: ms, module: l.module, site: e, src: src, iface: iface, bindParams: l.bindParams, bindArgs: l.bindArgs, bindWitnesses: l.bindWitnesses, errs: refused) 'table'
		some(t) then return checkedTable(l, p: p, ms: ms, t: t)
		none then panic("lower: a value was boxed with a conformance that its module's instances refused")
	end 'table'
end 'tableOfBox'

function checkedTable(l Lowerer, p ast.Project, ms ast.ModuleState, consumes t WitnessTable) returns WitnessTable
	for i in 0 upto t.methods.count() 'methods'
		_ = checkedCallee(l, p: p, ms: ms, target: t.methods[i])
	end 'methods'
	return t
end 'checkedTable'

// lowerBoxed lowers the value v of e, of the type ty, put in a value of the interface iface. A value that is consumed moves
// into a new box on the heap, which is in flight to what takes it. One that is not is only borrowed, by a `let` parameter
// or a receiver, so its box goes in the frame and owns nothing: a managed value, a place or a temporary, is lent, its owner
// keeping it, and a scalar is copied in. A borrow cannot outlive the call it is lent to, and the frame outlives the call.
function lowerBoxed(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, v Reg, ty ast.TypeID, iface ast.TypeID) returns Reg
	let table = tableOfBox(l, p: p, ms: ms, e: e, src: ty, iface: iface)
	let consumed = isConsumed(p, module: l.module, node: e)
	var value = v
	if owning(regKind(l, v: v)) 'settle'
		value = settle(l, p: p, ms: ms, e: e, v: v, ty: ty, consumed: consumed)
	end 'settle'
	let box = newReg(l, kind: IrKind.kindManaged)
	if consumed 'inFlight'
		let held = boxed(l, p: p, ms: ms, v: value, t: ty)
		let instr = l.b.box(box, t: table, src: held)
		emit(l, i: instr)
		let dropTy = dropType(l, p: p, ms: ms, t: iface)
		l.pending.push(PendingDrop.ofReg(box, ty: dropTy))
	end 'inFlight' else 'lent'
		let instr = l.b.frameBox(box, t: table, src: value)
		emit(l, i: instr)
	end 'lent'
	return box
end 'lowerBoxed'

// isRecoveryCast is whether the cast e takes a value of a type out of an interface value.
function isRecoveryCast(l Lowerer, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns bool
	let castTy = exprType(p, module: l.module, node: e)
	if ast.typeKind(ms.types, reads: p.types, t: castTy) == ast.TypeKind.interfaceTy 'boxes'
		return false
	end 'boxes'
	let operandTy = exprType(p, module: l.module, node: ast.castExprE(p.modules[l.mi].tree, id: e))
	return ast.typeKind(ms.types, reads: p.types, t: operandTy) == ast.TypeKind.interfaceTy
end 'isRecoveryCast'

// lowerRecoveryCast takes the value out of the interface value inner, which the cast consumes, when the box holds a value
// of the type target, and frees the box; otherwise the cast fails with CastError.otherType, and the box is dropped with
// what it holds, as any value in flight is where an operation fails.
function lowerRecoveryCast(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, inner ast.NodeID, target ast.TypeID) returns Reg
	let mark = l.pending.count()
	let box = lowerExpr(l, p: p, ms: ms, e: inner)
	let ty = applyType(l, p: p, ms: ms, t: target)
	let iface = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: inner))
	let holds = newReg(l, kind: IrKind.kindScalar)
	let typed = l.b.typed(ty)
	emit(l, i: newIsType(holds, src: box, ty: typed))
	let fail = failure(l, p: p, ms: ms, errorCase: ast.errorCastOtherType, err: noReg, errDrop: ast.noType)
	let pass = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(holds, ifTrue: pass, ifFalse: fail))
	l.cur = pass
	let addr = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newFieldAddr(addr, obj: box, offset: ifaceValueOffset))
	let kind = holderKind(l, p: p, ms: ms, t: ty)
	let v = newReg(l, kind: kind)
	if owning(kind) 'managed'
		emit(l, i: newMoveAt(v, addr: addr))
	end 'managed' else 'scalar'
		emit(l, i: newLoadAt(v, addr: addr, filled: false))
	end 'scalar'
	let dropTy = dropType(l, p: p, ms: ms, t: iface)
	emitDropReg(l, src: box, ty: dropTy)
	popPending(l, n: mark)
	return unboxed(l, p: p, ms: ms, v: v, t: ty)
end 'lowerRecoveryCast'

// receiverConv is how a call through an interface value gives the method the value its box holds, for a method whose
// receiver has the convention conv.
function receiverConv(conv ast.Convention) returns ReceiverConv
	return match conv 'c'
		convLet gives ReceiverConv.receiverLent
		convMutates gives ReceiverConv.receiverLent
		convConsumes gives ReceiverConv.receiverMoved
		convDestructs gives ReceiverConv.receiverMoved
		convSets gives panic("lower: a method takes its receiver as 'sets'")
	end 'c'
end 'receiverConv'

// witnessInterface is the interface of the value a call through a bound is made on, with the code's type parameters
// bound, or none for a call that runs the method of a type the code knows.
export function witnessInterface(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, receiver ast.NodeID, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList) returns ast.TypeID
	if info.kind != ast.CallKind.callBound 'other'
		return ast.noType
	end 'other'
	return interfaceOfReceiver(p, ms: ms, t: exprType(p, module: module, node: receiver), bindParams: bindParams, args: bindArgs)
end 'witnessInterface'

// dispatchedInterface is witnessInterface for a call that no node of the source writes, which a for makes of the iteration
// protocol: its receiver is a value of the type the call records.
function dispatchedInterface(p ast.Project, mutates ms ast.ModuleState, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList) returns ast.TypeID
	if info.kind != ast.CallKind.callBound 'other'
		return ast.noType
	end 'other'
	return interfaceOfReceiver(p, ms: ms, t: info.receiverTy, bindParams: bindParams, args: bindArgs)
end 'dispatchedInterface'

// interfaceOfReceiver is the interface of a receiver of the type t, with the code's type parameters bound, where it is an
// interface value, or none.
function interfaceOfReceiver(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, bindParams ast.TypeIDList, args ast.TypeIDList) returns ast.TypeID
	let received = ast.substituteType(ms.types, reads: p.types, t: t, params: bindParams, args: args)
	let recv = ast.contentType(ms.types, reads: p.types, t: received)
	if standsForInterface(p, ms: ms, t: recv) 'interface'
		return recv
	end 'interface'
	return ast.noType
end 'interfaceOfReceiver'

// lowerWidenStub is the IR of a widening stub (ast.widenStub): it passes what it is given to its method as it was given,
// and puts the value the method gives in a new box on the heap, with the table of its type as the stub's interface, which
// it gives. A method that fails fails the stub with its error, which is the requirement's, and has dropped what it took.
function lowerWidenStub(p ast.Project, mutates ms ast.ModuleState, fn ast.FuncID, mutates instances InstanceSet) returns IrFunction
	var l = Lowerer.new(exchange(instances, value: InstanceSet.new()))
	let stub = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).clone()
	let unbound = ast.TypeIDList.create(0)
	begin(l, p: p, ms: ms, fn: fn, bindParams: unbound.clone(), bindArgs: unbound.clone(), bindWitnesses: ast.WitnessList.create(0), name: "")
	_ = enterPropagating(l)
	var args = RegList.create(0)
	var index = 0 as Count
	if stub.hasReceiver 'receiver'
		let kind = passedKind(l, p: p, ms: ms, conv: stub.selfConv, t: stub.ownerTy)
		args.push(paramReg(l, index: index, kind: kind))
		index = succ(index)
	end 'receiver'
	for param in stub.params 'params'
		let kind = passedKind(l, p: p, ms: ms, conv: param.conv, t: param.ty)
		args.push(paramReg(l, index: index, kind: kind))
		index = succ(index)
	end 'params'
	let from = stub.widenedFrom
	let v = newReg(l, kind: kindOf(l, p: p, ms: ms, t: from))
	if stub.errTy == ast.noType 'plain'
		emitCall(l, p: p, ms: ms, dst: v, target: stub.widens, args: args)
	end 'plain' else 'throwing'
		var errKind = IrKind.kindScalar
		if errorInBox(ms.types, reads: p.types, t: stub.errTy) 'union'
			errKind = IrKind.kindManaged
		end 'union'
		let err = newReg(l, kind: errKind)
		emitThrowingCall(l, p: p, ms: ms, dst: v, target: stub.widens, args: args, err: err)
		let ok = l.b.newBlock()
		let zero = konst(l, value: 0 as Word)
		let failed = compare(l, op: CmpOp.cmpNe, a: err, b: zero, unsigned: false)
		let errDrop = errorDropType(l, p: p, ms: ms, t: stub.errTy)
		let thrown = failureBiased(l, p: p, ms: ms, errorCase: 0 as Count, err: err, errDrop: errDrop, bias: errorBias(ms.types, reads: p.types, t: stub.errTy))
		l.b.terminate(l.cur, t: newBranch(failed, ifTrue: thrown, ifFalse: ok))
		l.cur = ok
	end 'throwing'
	let table = tableOfBox(l, p: p, ms: ms, e: 0 as ast.NodeID, src: from, iface: stub.retTy)
	let box = newReg(l, kind: IrKind.kindManaged)
	let held = boxed(l, p: p, ms: ms, v: v, t: from)
	let instr = l.b.box(box, t: table, src: held)
	emit(l, i: instr)
	return finishStub(l, p: p, ms: ms, fn: fn, result: box, instances: instances)
end 'lowerWidenStub'

// passedKind is the kind of the register that a function is given for a parameter of the type t that it takes as conv: the
// box of a value held in place that it consumes, which its caller boxed (argValue), and otherwise the value's own.
function passedKind(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, conv ast.Convention, t ast.TypeID) returns IrKind
	if conv == ast.Convention.convConsumes or conv == ast.Convention.convDestructs 'consumed'
		return holderKind(l, p: p, ms: ms, t: t)
	end 'consumed'
	return kindOf(l, p: p, ms: ms, t: t)
end 'passedKind'
