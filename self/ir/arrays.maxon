// writtenInPlace is whether the backend writes the common case of a call of the runtime entry symbol in place, so that the
// call costs no more than the instructions around it: reading the length of an array, a byte array or a string, or what a
// frozen value holds, is a load, and reading, writing or pushing one element calls the entry only for an index out of range
// or a buffer that has to grow.
export function writtenInPlace(symbol Rt) returns bool
	return symbol == Rt.rtArrayLen or symbol == Rt.rtBytesLen or symbol == Rt.rtStrLen or symbol == Rt.rtFrozenGet or symbol == Rt.rtArrayElem or symbol == Rt.rtStrsElem or symbol == Rt.rtBytesGet or symbol == Rt.rtStrByteAt or symbol == Rt.rtBytesSet or symbol == Rt.rtArrayInsert or symbol == Rt.rtStrsOpen or symbol == Rt.rtBytesInsert
end 'writtenInPlace'

// onlyReads is whether a call of the runtime entry symbol changes nothing its caller can read: it reads its arguments and
// what they reach, and gives a scalar or a new box. So it ends no read of the caller (opt.motionOf), and a value it is
// lent may be a borrow of one that nothing else changes.
export function onlyReads(symbol Rt) returns bool
	return symbol == Rt.rtConcat or symbol == Rt.rtItoa or symbol == Rt.rtDecimalLength or symbol == Rt.rtStrJoinRoom or symbol == Rt.rtStrOwned or symbol == Rt.rtArrayCapacity or symbol == Rt.rtFtoa or symbol == Rt.rtFtoaExact or symbol == Rt.rtFmtInt or symbol == Rt.rtFmtPad or symbol == Rt.rtFmtQuoted or symbol == Rt.rtFmtFixed or symbol == Rt.rtStreq or symbol == Rt.rtStrLen or symbol == Rt.rtStrByteAt or symbol == Rt.rtStrView or symbol == Rt.rtStrCount or symbol == Rt.rtStrGraphemeIndex or symbol == Rt.rtStrGraphemeBytePos or symbol == Rt.rtStrFind or symbol == Rt.rtStrFindLast or symbol == Rt.rtStrHasAffix or symbol == Rt.rtStrReplace or symbol == Rt.rtStrTrimFirst or symbol == Rt.rtStrTrimLast or symbol == Rt.rtStrMapCase or symbol == Rt.rtStrCodePointAt or symbol == Rt.rtStrCodePointNext or symbol == Rt.rtStrCodePointCount or symbol == Rt.rtStrUtf16Unit or symbol == Rt.rtStrUtf16Next or symbol == Rt.rtStrUtf16Count or symbol == Rt.rtHashWord or symbol == Rt.rtHashBytes or symbol == Rt.rtHashStringBytes or symbol == Rt.rtArrayNew or symbol == Rt.rtArrayLen or symbol == Rt.rtArrayElem or symbol == Rt.rtStrsElem or symbol == Rt.rtBytesNew or symbol == Rt.rtBytesLen or symbol == Rt.rtBytesGet or symbol == Rt.rtBytesToString
end 'onlyReads'

// arrayOf is the runtime of the array type t, read through the binding and through a frozen value.
function arrayOf(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, t ast.TypeID) returns ArrayBox
	let bt = builtinOf(l, p: p, ms: ms, collection: t)
	if ast.typeKind(ms.types, reads: p.types, t: bt) != ast.TypeKind.builtinArray 'notArray'
		panic("lower: {ast.typeName(ms.types, reads: p.types, t: t)} is not an array")
	end 'notArray'
	return ArrayBox.make(site.clone(), ty: bt)
end 'arrayOf'

// arrayPacked is whether the box of the array, or of the memory or cursor over its buffer, holds each element in one byte
// (ast.packsBytes).
function arrayPacked(p ast.Project, ms ast.ModuleState, box ArrayBox) returns bool
	return ast.packsByte(ms.types, reads: p.types, b: p.builtins, elem: ast.typeArgAt(ms.types, reads: p.types, t: box.ty, index: 0))
end 'arrayPacked'

// arrayOfStrings is whether the array holds Strings, two words to an element, which the rt.strs entries address.
function arrayOfStrings(p ast.Project, ms ast.ModuleState, box ArrayBox) returns bool
	return ast.isStringType(ms.types, reads: p.types, t: arrayElem(p, ms: ms, box: box))
end 'arrayOfStrings'

function arrayElem(p ast.Project, ms ast.ModuleState, box ArrayBox) returns ast.TypeID
	return ast.typeArgAt(ms.types, reads: p.types, t: box.ty, index: 0)
end 'arrayElem'

function arrayNew(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox) returns Reg
	if arrayPacked(p, ms: ms, box: box) 'packed'
		return entry(l, p: p, site: box.site, symbol: Rt.rtBytesNew, kind: IrKind.kindManaged, args: RegList.create(0))
	end 'packed'
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayNew, kind: IrKind.kindManaged, args: RegList.create(0))
end 'arrayNew'

// arrayReserve makes the buffer of an array hold count elements, where a lowering knows how many it is about to push: an
// array of words reserves them, and an array of bytes grows as it is pushed to.
function arrayReserve(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, count Reg)
	if arrayOfStrings(p, ms: ms, box: box) 'strings'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtStrsReserve, args: argsOf2(arr, b: count))
	end 'strings' else if not arrayPacked(p, ms: ms, box: box) 'words'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayReserve, args: argsOf2(arr, b: count))
	end 'words'
end 'arrayReserve'

// arrayFill appends count copies of v, a word that needs no copy of its own, to an array that is not packed, in one call
// that writes them in a pass where as many inserts would each check the buffer. An array of strings is filled with empty
// elements, the String that the empty place v is.
function arrayFill(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, count Reg, v Reg)
	if arrayPacked(p, ms: ms, box: box) 'packed'
		panic("lower: a fill of an array of bytes")
	end 'packed'
	if arrayOfStrings(p, ms: ms, box: box) 'strings'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtStrsFill, args: argsOf2(arr, b: count))
		return
	end 'strings'
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayFill, args: argsOf3(arr, b: count, c: v))
end 'arrayFill'

function arrayLength(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg) returns Reg
	if arrayPacked(p, ms: ms, box: box) 'packed'
		return entry(l, p: p, site: box.site, symbol: Rt.rtBytesLen, kind: IrKind.kindScalar, args: argsOf1(arr))
	end 'packed'
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayLen, kind: IrKind.kindScalar, args: argsOf1(arr))
end 'arrayLength'

// arrayInsert moves v in at index, which may be the length.
function arrayInsert(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg)
	if arrayPacked(p, ms: ms, box: box) 'packed'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesInsert, args: argsOf3(arr, b: index, c: v))
		return
	end 'packed'
	if arrayOfStrings(p, ms: ms, box: box) 'strings'
		let at = entry(l, p: p, site: box.site, symbol: Rt.rtStrsOpen, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
		emit(l, i: newStoreAt(at, src: v))
		return
	end 'strings'
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayInsert, args: argsOf3(arr, b: index, c: v))
end 'arrayInsert'

function arrayPush(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, v Reg)
	let n = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	arrayInsert(l, p: p, ms: ms, box: box, arr: arr, index: n, v: v)
end 'arrayPush'

// arrayRemove moves the element at index out.
function arrayRemove(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	if arrayPacked(p, ms: ms, box: box) 'packed'
		return entry(l, p: p, site: box.site, symbol: Rt.rtBytesRemove, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
	end 'packed'
	let elem = arrayElem(p, ms: ms, box: box)
	let kind = kindOf(l, p: p, ms: ms, t: elem)
	if arrayOfStrings(p, ms: ms, box: box) 'strings'
		let at = entry(l, p: p, site: box.site, symbol: Rt.rtStrsElem, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
		let d = newReg(l, kind: kind)
		emit(l, i: newMoveAt(d, addr: at))
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtStrsClose, args: argsOf2(arr, b: index))
		return d
	end 'strings'
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayRemove, kind: kind, args: argsOf2(arr, b: index))
end 'arrayRemove'

// arrayLoad reads the element at index: a byte, a scalar, or a managed element lent for as long as the array is not
// changed.
function arrayLoad(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	return arrayRead(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true, read: SlotRead.slotLent)
end 'arrayLoad'

// SlotRead is what a read of an element does at a slot that holds none: an empty slot, which only the library tiers make
// (resize of an array of a type parameter, clearSlot), and which is 0 for a managed element, as maxon's is. A read that
// lends the element panics there, with maxon's message, rather than lend a box that is not there; a read that gives a
// copy fails with emptySlot, the case of ArrayError and of __ManagedMemoryError that maxon's get throws.
export enum SlotRead
	slotLent
	slotCopied
end 'SlotRead'

// emptySlotMessage is maxon's message of a lent read of an empty slot at an index, which the runtime's panicEmptySlot
// writes too.
export function emptySlotMessage(index Count) returns String
	return "empty slot: element {index} of the array was never filled"
end 'emptySlotMessage'

// requireFilled goes on only when the element read from a slot is there: a managed element of an empty slot is 0, and a
// scalar has no empty slot, since 0 is a value of it.
function requireFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, elem ast.TypeID, element Reg, index Reg, read SlotRead)
	if not ast.isManagedType(ms.types, reads: p.types, t: elem) 'scalar'
		return
	end 'scalar'
	var word = element
	if ast.isStringType(ms.types, reads: p.types, t: elem) 'string'
		word = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newStrPtr(word, src: element))
	end 'string'
	let empty = konst(l, value: 0 as Word)
	let filled = compare(l, op: CmpOp.cmpNe, a: word, b: empty, unsigned: true)
	match read 'read'
		slotCopied then failUnless(l, p: p, ms: ms, cond: filled, errorCase: ast.errorEmptySlot)
		slotLent then panicUnlessFilled(l, p: p, site: site, filled: filled, index: index)
	end 'read'
end 'requireFilled'

// panicUnlessFilled goes on when the slot is filled, and panics with maxon's message of the slot otherwise.
function panicUnlessFilled(mutates l Lowerer, p ast.Project, site diag.Site, filled Reg, index Reg)
	let ok = l.b.newBlock()
	let bad = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(filled, ifTrue: ok, ifFalse: bad))
	l.cur = bad
	let location = strReg(l, value: ast.panicLocation(p.modules[ast.modIndex(site.module)], offset: site.offset))
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanicEmptySlot, args: argsOf2(location, b: index), routine: ast.noFunc)
	seal(l, t: newTrap())
	l.cur = ok
end 'panicUnlessFilled'

// arrayRead reads the element at index as arrayLoad does; where the checker or a check before it has proved the index
// inside the array (not checked), the entry's call is proven, which the expansion of the primitives makes the read alone.
// It stays a call until then: a function's source form is its IR from before the expansion (opt.sourceOf), whose loops
// decide E5001, as the program wrote them with the call.
function arrayRead(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, checked bool, read SlotRead) returns Reg
	if arrayPacked(p, ms: ms, box: box) 'packed'
		return elementEntry(l, p: p, site: box.site, symbol: Rt.rtBytesGet, args: argsOf2(arr, b: index), checked: checked)
	end 'packed'
	let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: arrayElem(p, ms: ms, box: box)))
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked)
	emit(l, i: newLoadAt(d, addr: addr))
	requireFilled(l, p: p, ms: ms, site: box.site, elem: arrayElem(p, ms: ms, box: box), element: d, index: index, read: read)
	return d
end 'arrayRead'

// arrayClearSlot drops the element at an index and leaves its slot empty, 0, which fails with indexOutOfBounds past the
// end.
function arrayClearSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg)
	arrayInBounds(l, p: p, ms: ms, box: box, arr: arr, index: index)
	let elem = arrayElem(p, ms: ms, box: box)
	if owning(kindOf(l, p: p, ms: ms, t: elem)) and not arrayPacked(p, ms: ms, box: box) 'owning'
		let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false)
		dropAt(l, p: p, ms: ms, addr: addr, t: elem)
		return
	end 'owning'
	let empty = konst(l, value: 0 as Word)
	arrayWrite(l, p: p, ms: ms, box: box, arr: arr, index: index, v: empty, checked: false)
end 'arrayClearSlot'

// arrayWrite writes v to the element at index as arrayStore does, through a proven address where the index is proved
// inside the array (not checked). A byte is written by its entry either way.
function arrayWrite(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg, checked bool)
	if arrayPacked(p, ms: ms, box: box) 'packed'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesSet, args: argsOf3(arr, b: index, c: v))
		return
	end 'packed'
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked)
	dropAt(l, p: p, ms: ms, addr: addr, t: arrayElem(p, ms: ms, box: box))
	emit(l, i: newStoreAt(addr, src: v))
end 'arrayWrite'

// arrayStore writes v to the element at index, dropping the element it replaces.
function arrayStore(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg)
	arrayWrite(l, p: p, ms: ms, box: box, arr: arr, index: index, v: v, checked: true)
end 'arrayStore'

// arrayAddress is where the element at index of an array of words is, a proven call where the index is proved inside the
// array (not checked). A byte has no address a word can be read through: its place is a slot instead.
function arrayAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, checked bool) returns Reg
	if arrayPacked(p, ms: ms, box: box) 'packed'
		panic("lower: an element of {ast.typeName(ms.types, reads: p.types, t: box.ty)} has no word address")
	end 'packed'
	if arrayOfStrings(p, ms: ms, box: box) 'strings'
		return elementEntry(l, p: p, site: box.site, symbol: Rt.rtStrsElem, args: argsOf2(arr, b: index), checked: checked)
	end 'strings'
	return elementEntry(l, p: p, site: box.site, symbol: Rt.rtArrayElem, args: argsOf2(arr, b: index), checked: checked)
end 'arrayAddress'

// arrayPlace is the address a call that takes the element at index by address is given: the element's own for an array of
// words, and for an array of bytes a slot that holds the element until writeBack stores it back.
function arrayPlace(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	if not arrayPacked(p, ms: ms, box: box) 'words'
		return arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
	end 'words'
	let slot = l.b.f.newSlot(IrKind.kindScalar)
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: index)
	emit(l, i: newStoreSlot(slot, src: element, borrow: false))
	l.writeBacks.push(WriteBack.make(box.clone(), arr: arr, index: index, slot: slot))
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newSlotAddr(d, slot: slot))
	return d
end 'arrayPlace'

// writeBack stores the slots of the places taken since mark back into their elements.
function writeBack(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, mark Count)
	for i in mark upto l.writeBacks.count() 'each'
		let w = l.writeBacks[i].clone()
		let v = load(l, slot: w.slot)
		arrayStore(l, p: p, ms: ms, box: w.box, arr: w.arr, index: w.index, v: v)
	end 'each'
	l.writeBacks.truncate(mark)
end 'writeBack'

// arrayAppendCopy pushes a copy of each element of other, which is only read. The length of other is read once, before
// the first push.
function arrayAppendCopy(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, other Reg)
	if arrayPacked(p, ms: ms, box: box) 'packed'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesAppend, args: argsOf2(arr, b: other))
		return
	end 'packed'
	let n = arrayLength(l, p: p, ms: ms, box: box, arr: other)
	let loop = countedLoopBegin(l, limit: n)
	let i = countedLoopIndex(l, loop: loop)
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: other, index: i)
	let copy = copyValue(l, p: p, ms: ms, site: box.site, v: element, t: arrayElem(p, ms: ms, box: box))
	arrayPush(l, p: p, ms: ms, box: box, arr: arr, v: copy)
	countedLoopEnd(l, loop: loop)
end 'arrayAppendCopy'

function requirePacked(p ast.Project, ms ast.ModuleState, box ArrayBox)
	if not arrayPacked(p, ms: ms, box: box) 'words'
		panic("lower: {ast.typeName(ms.types, reads: p.types, t: box.ty)} holds no bytes")
	end 'words'
end 'requirePacked'

// arrayAppendText pushes the UTF-8 bytes of a String, which only an array of bytes holds as they are.
function arrayAppendText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, text Reg)
	requirePacked(p, ms: ms, box: box)
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesAppendStr, args: argsOf2(arr, b: text))
end 'arrayAppendText'

// arrayText is a String of the bytes of an array of bytes.
function arrayText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg) returns Reg
	requirePacked(p, ms: ms, box: box)
	return entry(l, p: p, site: box.site, symbol: Rt.rtBytesToString, kind: IrKind.kindManaged, args: argsOf1(arr))
end 'arrayText'

// arrayBoundsBegin fails with indexOutOfBounds unless index is below the length; the block it gives is where the operation
// goes on, and the one being lowered is where it fails, which failUnlessEnd ends after the code between them has dropped
// what the operation was given.
function arrayBoundsBegin(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns BlockID
	let n = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let below = compare(l, op: CmpOp.cmpLt, a: index, b: n, unsigned: true)
	return failUnlessBegin(l, cond: below)
end 'arrayBoundsBegin'

// arrayInBounds fails with indexOutOfBounds unless index is below the length.
function arrayInBounds(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg)
	let ok = arrayBoundsBegin(l, p: p, ms: ms, box: box, arr: arr, index: index)
	failUnlessEnd(l, p: p, ms: ms, errorCase: ast.errorIndexOutOfBounds, ok: ok)
end 'arrayInBounds'

// saturatingSub is a - b, or 0 when b is above a.
function saturatingSub(mutates l Lowerer, a Reg, b Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: zero, borrow: false))
	let above = l.b.newBlock()
	let join = l.b.newBlock()
	let higher = compare(l, op: CmpOp.cmpGt, a: a, b: b, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(higher, ifTrue: above, ifFalse: join))
	l.cur = above
	let difference = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(difference, op: BinOp.binSub, left: a, right: b, unsigned: true, fail: noBlock))
	emit(l, i: newStoreSlot(result, src: difference, borrow: false))
	goTo(l, target: join)
	return load(l, slot: result)
end 'saturatingSub'

// arrayShrinkTo makes the array keep elements long, which is at most its length, and drops the elements above that, last
// first. An element that needs no drop is not visited: the length is all that changes, so clearing an array of numbers is
// one entry whatever its length. An element that owns something is dropped in place, one loop with one lookup of its address
// each, before the length is set.
function arrayShrinkTo(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, keep Reg)
	let elem = arrayElem(p, ms: ms, box: box)
	if owning(kindOf(l, p: p, ms: ms, t: elem)) 'owning'
		let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
		let extra = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newBin(extra, op: BinOp.binSub, left: length, right: keep, unsigned: true, fail: noBlock))
		let one = konst(l, value: 1 as Word)
		let last = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newBin(last, op: BinOp.binSub, left: length, right: one, unsigned: true, fail: noBlock))
		let loop = countedLoopBegin(l, limit: extra)
		let offset = countedLoopIndex(l, loop: loop)
		let index = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newBin(index, op: BinOp.binSub, left: last, right: offset, unsigned: true, fail: noBlock))
		let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
		dropAt(l, p: p, ms: ms, addr: addr, t: elem)
		countedLoopEnd(l, loop: loop)
	end 'owning'
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayShrink, args: argsOf2(arr, b: keep))
end 'arrayShrinkTo'

// arrayClear drops every element and keeps the buffer.
function arrayClear(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg)
	let none = konst(l, value: 0 as Word)
	arrayShrinkTo(l, p: p, ms: ms, box: box, arr: arr, keep: none)
end 'arrayClear'

// arrayTruncate drops the elements at and above newLength, and does nothing for a newLength that is not below the length.
function arrayTruncate(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let extra = saturatingSub(l, a: length, b: newLength)
	let keep = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(keep, op: BinOp.binSub, left: length, right: extra, unsigned: true, fail: noBlock))
	arrayShrinkTo(l, p: p, ms: ms, box: box, arr: arr, keep: keep)
end 'arrayTruncate'

// arrayGrowZero pushes zero elements until the array has newLength of them, which the checker has held to an element that has a zero.
function arrayGrowZero(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let missing = saturatingSub(l, a: newLength, b: length)
	let loop = countedLoopBegin(l, limit: missing)
	if arrayOfStrings(p, ms: ms, box: box) 'strings'
		let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
		_ = entry(l, p: p, site: box.site, symbol: Rt.rtStrsOpen, kind: IrKind.kindScalar, args: argsOf2(arr, b: length))
	end 'strings' else 'words'
		let zero = konst(l, value: 0 as Word)
		arrayPush(l, p: p, ms: ms, box: box, arr: arr, v: zero)
	end 'words'
	countedLoopEnd(l, loop: loop)
end 'arrayGrowZero'

// arraySlice is a new array of copies of the elements from start to below endIndex, which fails with indexOutOfBounds unless
// start is not above endIndex and endIndex is not above the length, as maxon's slice does.
function arraySlice(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, start Reg, endIndex Reg) returns Reg
	let ordered = compare(l, op: CmpOp.cmpLe, a: start, b: endIndex, unsigned: true)
	failUnless(l, p: p, ms: ms, cond: ordered, errorCase: ast.errorIndexOutOfBounds)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let within = compare(l, op: CmpOp.cmpLe, a: endIndex, b: length, unsigned: true)
	failUnless(l, p: p, ms: ms, cond: within, errorCase: ast.errorIndexOutOfBounds)
	let out = arrayNew(l, p: p, ms: ms, box: box)
	let span = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(span, op: BinOp.binSub, left: endIndex, right: start, unsigned: true, fail: noBlock))
	let loop = countedLoopBegin(l, limit: span)
	let offset = countedLoopIndex(l, loop: loop)
	let index = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(index, op: BinOp.binAdd, left: start, right: offset, unsigned: true, fail: noBlock))
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: index)
	let copy = copyValue(l, p: p, ms: ms, site: box.site, v: element, t: arrayElem(p, ms: ms, box: box))
	arrayPush(l, p: p, ms: ms, box: box, arr: out, v: copy)
	countedLoopEnd(l, loop: loop)
	return out
end 'arraySlice'

// arrayCopyAt is a copy of the element at index, which fails with indexOutOfBounds past the end.
function arrayCopyAt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	arrayInBounds(l, p: p, ms: ms, box: box, arr: arr, index: index)
	let element = arrayRead(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false, read: SlotRead.slotCopied)
	return copyValue(l, p: p, ms: ms, site: box.site, v: element, t: arrayElem(p, ms: ms, box: box))
end 'arrayCopyAt'

// arrayPushCopies pushes n copies of value, which the call only reads.
function arrayPushCopies(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, n Reg, value Reg)
	let loop = countedLoopBegin(l, limit: n)
	let copy = copyValue(l, p: p, ms: ms, site: box.site, v: value, t: arrayElem(p, ms: ms, box: box))
	arrayPush(l, p: p, ms: ms, box: box, arr: arr, v: copy)
	countedLoopEnd(l, loop: loop)
end 'arrayPushCopies'

// arrayGrowFilled pushes copies of value until the array has newLength elements, and does nothing for a newLength that is
// not above the length.
function arrayGrowFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg, value Reg)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let missing = saturatingSub(l, a: newLength, b: length)
	arrayPushCopies(l, p: p, ms: ms, box: box, arr: arr, n: missing, value: value)
end 'arrayGrowFilled'

// arrayRefill makes the array newLength copies of value: every element it held is dropped.
function arrayRefill(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg, value Reg)
	arrayClear(l, p: p, ms: ms, box: box, arr: arr)
	arrayPushCopies(l, p: p, ms: ms, box: box, arr: arr, n: newLength, value: value)
end 'arrayRefill'

// elementsEqual is whether two values of the element type are equal: strings by their bytes, anything else that the checker
// lets through (checkElementsComparable) by its word.
function elementsEqual(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, a Reg, b Reg) returns Reg
	if arrayElem(p, ms: ms, box: box) == p.builtins.stringTy 'string'
		return runtime(l, symbol: Rt.rtStreq, kind: IrKind.kindScalar, args: argsOf2(a, b: b))
	end 'string'
	return compare(l, op: CmpOp.cmpEq, a: a, b: b, unsigned: false)
end 'elementsEqual'

// storeIf stores value in a slot where cond holds.
function storeIf(mutates l Lowerer, slot Count, cond Reg, value Word)
	let set = l.b.newBlock()
	let join = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: set, ifFalse: join))
	l.cur = set
	let v = konst(l, value: value)
	emit(l, i: newStoreSlot(slot, src: v, borrow: false))
	goTo(l, target: join)
end 'storeIf'

// arrayContains is whether some element equals value.
function arrayContains(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, value Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let loop = countedLoopBegin(l, limit: length)
	let i = countedLoopIndex(l, loop: loop)
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: i)
	let same = elementsEqual(l, p: p, ms: ms, box: box, a: element, b: value)
	storeIf(l, slot: result, cond: same, value: 1 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: result)
end 'arrayContains'

// arrayRunMatches is whether the elements of the sequence are the ones of the array from index on, which the array has room
// for.
function arrayRunMatches(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, sequence Reg, index Reg, length Reg) returns Reg
	let matched = l.b.f.newSlot(IrKind.kindScalar)
	let yes = konst(l, value: 1 as Word)
	emit(l, i: newStoreSlot(matched, src: yes, borrow: false))
	let loop = countedLoopBegin(l, limit: length)
	let j = countedLoopIndex(l, loop: loop)
	let at = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(at, op: BinOp.binAdd, left: index, right: j, unsigned: true, fail: noBlock))
	let ours = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: at)
	let theirs = arrayLoad(l, p: p, ms: ms, box: box, arr: sequence, index: j)
	let same = elementsEqual(l, p: p, ms: ms, box: box, a: ours, b: theirs)
	let differ = isZero(l, v: same)
	storeIf(l, slot: matched, cond: differ, value: 0 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: matched)
end 'arrayRunMatches'

// arrayContainsSequence is whether the elements of the sequence follow one another somewhere in the array; the empty sequence
// always does.
function arrayContainsSequence(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, sequence Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let wanted = arrayLength(l, p: p, ms: ms, box: box, arr: sequence)
	let one = konst(l, value: 1 as Word)
	let room = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(room, op: BinOp.binAdd, left: length, right: one, unsigned: true, fail: noBlock))
	let starts = saturatingSub(l, a: room, b: wanted)
	let loop = countedLoopBegin(l, limit: starts)
	let i = countedLoopIndex(l, loop: loop)
	let found = arrayRunMatches(l, p: p, ms: ms, box: box, arr: arr, sequence: sequence, index: i, length: wanted)
	storeIf(l, slot: result, cond: found, value: 1 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: result)
end 'arrayContainsSequence'

// arrayEquals is whether the arrays have the same length and equal elements in order.
function arrayEquals(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, other Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let otherLength = arrayLength(l, p: p, ms: ms, box: box, arr: other)
	let sameLength = compare(l, op: CmpOp.cmpEq, a: length, b: otherLength, unsigned: true)
	let compared = l.b.newBlock()
	let done = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(sameLength, ifTrue: compared, ifFalse: done))
	l.cur = compared
	let zero = konst(l, value: 0 as Word)
	let equal = arrayRunMatches(l, p: p, ms: ms, box: box, arr: arr, sequence: other, index: zero, length: length)
	emit(l, i: newStoreSlot(result, src: equal, borrow: false))
	goTo(l, target: done)
	return load(l, slot: result)
end 'arrayEquals'
