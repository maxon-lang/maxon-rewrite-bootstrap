// arrayOf is the runtime of the array type t, read through the binding and through a frozen value.
function arrayOf(mutates l Lowerer, mutates p ast.Project, site diag.Site, t ast.TypeID) returns ArrayBox
	let bt = builtinOf(l, p: p, collection: t)
	if p.types.slots[ast.typeSlot(bt)][ast.typeIndex(bt)].kind != ast.TypeKind.builtinArray 'notArray'
		panic("lower: {ast.typeName(p.types, t: t)} is not an array")
	end 'notArray'
	return ArrayBox.make(site.clone(), ty: bt)
end 'arrayOf'

// arrayPacked is whether the array's box holds each element in one byte: an array of an integer type whose range fits in
// a Byte, as Array with Byte (ByteArray) is. Every other array holds a word to an element. Every operation on an array
// asks this, so the two boxes are never mistaken for each other.
function arrayPacked(p ast.Project, box ArrayBox) returns bool
	let elem = ast.typeArgAt(p.types, t: box.ty, index: 0)
	if p.types.slots[ast.typeSlot(elem)][ast.typeIndex(elem)].kind != ast.TypeKind.intRange 'notInt'
		return false
	end 'notInt'
	let byte = p.builtins.byteTy
	return p.types.slots[ast.typeSlot(byte)][ast.typeIndex(byte)].minVal.le(p.types.slots[ast.typeSlot(elem)][ast.typeIndex(elem)].minVal) and p.types.slots[ast.typeSlot(byte)][ast.typeIndex(byte)].maxVal.ge(p.types.slots[ast.typeSlot(elem)][ast.typeIndex(elem)].maxVal)
end 'arrayPacked'

function arrayElem(p ast.Project, box ArrayBox) returns ast.TypeID
	return ast.typeArgAt(p.types, t: box.ty, index: 0)
end 'arrayElem'

function arrayNew(mutates l Lowerer, mutates p ast.Project, box ArrayBox) returns Reg
	if arrayPacked(p, box: box) 'packed'
		return entry(l, p: p, site: box.site, symbol: Rt.rtBytesNew, kind: IrKind.kindManaged, args: RegList.create(0))
	end 'packed'
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayNew, kind: IrKind.kindManaged, args: RegList.create(0))
end 'arrayNew'

function arrayLength(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg) returns Reg
	if arrayPacked(p, box: box) 'packed'
		return entry(l, p: p, site: box.site, symbol: Rt.rtBytesLen, kind: IrKind.kindScalar, args: argsOf1(arr))
	end 'packed'
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayLen, kind: IrKind.kindScalar, args: argsOf1(arr))
end 'arrayLength'

// arrayInsert moves v in at index, which may be the length.
function arrayInsert(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg, v Reg)
	if arrayPacked(p, box: box) 'packed'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesInsert, args: argsOf3(arr, b: index, c: v))
		return
	end 'packed'
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayInsert, args: argsOf3(arr, b: index, c: v))
end 'arrayInsert'

function arrayPush(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, v Reg)
	let n = arrayLength(l, p: p, box: box, arr: arr)
	arrayInsert(l, p: p, box: box, arr: arr, index: n, v: v)
end 'arrayPush'

// arrayRemove moves the element at index out.
function arrayRemove(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg) returns Reg
	if arrayPacked(p, box: box) 'packed'
		return entry(l, p: p, site: box.site, symbol: Rt.rtBytesRemove, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
	end 'packed'
	let elem = arrayElem(p, box: box)
	let kind = kindOf(l, p: p, t: elem)
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayRemove, kind: kind, args: argsOf2(arr, b: index))
end 'arrayRemove'

// arrayLoad reads the element at index: a byte, a scalar, or a managed element lent for as long as the array is not
// changed.
function arrayLoad(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg) returns Reg
	if arrayPacked(p, box: box) 'packed'
		return entry(l, p: p, site: box.site, symbol: Rt.rtBytesGet, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
	end 'packed'
	let d = newReg(l, kind: kindOf(l, p: p, t: arrayElem(p, box: box)))
	let addr = arrayAddress(l, p: p, box: box, arr: arr, index: index)
	emit(l, i: newLoadAt(d, addr: addr))
	return d
end 'arrayLoad'

// arrayStore writes v to the element at index, dropping the element it replaces.
function arrayStore(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg, v Reg)
	if arrayPacked(p, box: box) 'packed'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesSet, args: argsOf3(arr, b: index, c: v))
		return
	end 'packed'
	let addr = arrayAddress(l, p: p, box: box, arr: arr, index: index)
	dropAt(l, p: p, addr: addr, t: arrayElem(p, box: box))
	emit(l, i: newStoreAt(addr, src: v))
end 'arrayStore'

// arrayAddress is where the element at index of an array of words is. A byte has no address a word can be read through:
// its place is a slot instead.
function arrayAddress(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg) returns Reg
	if arrayPacked(p, box: box) 'packed'
		panic("lower: an element of {ast.typeName(p.types, t: box.ty)} has no word address")
	end 'packed'
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayElem, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
end 'arrayAddress'

// arrayPlace is the address a call that takes the element at index by address is given: the element's own for an array of
// words, and for an array of bytes a slot that holds the element until writeBack stores it back.
function arrayPlace(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg) returns Reg
	if not arrayPacked(p, box: box) 'words'
		return arrayAddress(l, p: p, box: box, arr: arr, index: index)
	end 'words'
	let slot = l.b.f.newSlot(IrKind.kindScalar)
	let element = arrayLoad(l, p: p, box: box, arr: arr, index: index)
	emit(l, i: newStoreSlot(slot, src: element, borrow: false))
	l.writeBacks.push(WriteBack.make(box.clone(), arr: arr, index: index, slot: slot))
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newSlotAddr(d, slot: slot))
	return d
end 'arrayPlace'

// writeBack stores the slots of the places taken since mark back into their elements.
function writeBack(mutates l Lowerer, mutates p ast.Project, mark Count)
	for i in mark upto l.writeBacks.count() 'each'
		let w = l.writeBacks[i].clone()
		let v = load(l, slot: w.slot)
		arrayStore(l, p: p, box: w.box, arr: w.arr, index: w.index, v: v)
	end 'each'
	while l.writeBacks.count() > mark 'cut'
		try l.writeBacks.pop() otherwise ignore
	end 'cut'
end 'writeBack'

// arrayAppendCopy pushes a copy of each element of other, which is only read. The length of other is read once, before
// the first push.
function arrayAppendCopy(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, other Reg)
	if arrayPacked(p, box: box) 'packed'
		entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesAppend, args: argsOf2(arr, b: other))
		return
	end 'packed'
	let n = arrayLength(l, p: p, box: box, arr: other)
	let loop = countedLoopBegin(l, limit: n)
	let i = countedLoopIndex(l, loop: loop)
	let element = arrayLoad(l, p: p, box: box, arr: other, index: i)
	let copy = copyValue(l, p: p, site: box.site, v: element, t: arrayElem(p, box: box))
	arrayPush(l, p: p, box: box, arr: arr, v: copy)
	countedLoopEnd(l, loop: loop)
end 'arrayAppendCopy'

function requirePacked(p ast.Project, box ArrayBox)
	if not arrayPacked(p, box: box) 'words'
		panic("lower: {ast.typeName(p.types, t: box.ty)} holds no bytes")
	end 'words'
end 'requirePacked'

// arrayAppendText pushes the UTF-8 bytes of a String, which only an array of bytes holds as they are.
function arrayAppendText(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, text Reg)
	requirePacked(p, box: box)
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesAppendStr, args: argsOf2(arr, b: text))
end 'arrayAppendText'

// arrayText is a String of the bytes of an array of bytes.
function arrayText(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg) returns Reg
	requirePacked(p, box: box)
	return entry(l, p: p, site: box.site, symbol: Rt.rtBytesToString, kind: IrKind.kindManaged, args: argsOf1(arr))
end 'arrayText'

// arrayBoundsBegin fails with indexOutOfBounds unless index is below the length; the block it gives is where the operation
// goes on, and the one being lowered is where it fails, which failUnlessEnd ends after the code between them has dropped
// what the operation was given.
function arrayBoundsBegin(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg) returns BlockID
	let n = arrayLength(l, p: p, box: box, arr: arr)
	let below = compare(l, op: CmpOp.cmpLt, a: index, b: n, unsigned: true)
	return failUnlessBegin(l, cond: below)
end 'arrayBoundsBegin'

// arrayInBounds fails with indexOutOfBounds unless index is below the length.
function arrayInBounds(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg)
	let ok = arrayBoundsBegin(l, p: p, box: box, arr: arr, index: index)
	failUnlessEnd(l, p: p, errorCase: ast.errorIndexOutOfBounds, ok: ok)
end 'arrayInBounds'

// saturatingSub is a - b, or 0 when b is above a.
function saturatingSub(mutates l Lowerer, a Reg, b Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: zero, borrow: false))
	let above = l.b.newBlock()
	let join = l.b.newBlock()
	let higher = compare(l, op: CmpOp.cmpGt, a: a, b: b, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(higher, ifTrue: above, ifFalse: join))
	l.cur = above
	let difference = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(difference, op: BinOp.binSub, left: a, right: b, unsigned: true, fail: noBlock))
	emit(l, i: newStoreSlot(result, src: difference, borrow: false))
	goTo(l, target: join)
	return load(l, slot: result)
end 'saturatingSub'

// arrayDropLast removes the last n elements, n at most the length, and drops them.
function arrayDropLast(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, n Reg)
	let loop = countedLoopBegin(l, limit: n)
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let one = konst(l, value: 1 as Word)
	let last = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(last, op: BinOp.binSub, left: length, right: one, unsigned: true, fail: noBlock))
	let element = arrayRemove(l, p: p, box: box, arr: arr, index: last)
	dropValue(l, p: p, v: element, t: arrayElem(p, box: box))
	countedLoopEnd(l, loop: loop)
end 'arrayDropLast'

// arrayTruncate drops the elements at and above newLength, and does nothing for a newLength that is not below the length.
function arrayTruncate(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, newLength Reg)
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let extra = saturatingSub(l, a: length, b: newLength)
	arrayDropLast(l, p: p, box: box, arr: arr, n: extra)
end 'arrayTruncate'

// arrayGrowZero pushes zero elements until the array has newLength of them, which the checker has held to an element that has a zero.
function arrayGrowZero(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, newLength Reg)
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let missing = saturatingSub(l, a: newLength, b: length)
	let loop = countedLoopBegin(l, limit: missing)
	let zero = konst(l, value: 0 as Word)
	arrayPush(l, p: p, box: box, arr: arr, v: zero)
	countedLoopEnd(l, loop: loop)
end 'arrayGrowZero'

// arraySlice is a new array of copies of the elements from start to below endIndex, which fails with indexOutOfBounds unless
// start is not above endIndex and endIndex is not above the length, as maxon's slice does.
function arraySlice(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, start Reg, endIndex Reg) returns Reg
	let ordered = compare(l, op: CmpOp.cmpLe, a: start, b: endIndex, unsigned: true)
	failUnless(l, p: p, cond: ordered, errorCase: ast.errorIndexOutOfBounds)
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let within = compare(l, op: CmpOp.cmpLe, a: endIndex, b: length, unsigned: true)
	failUnless(l, p: p, cond: within, errorCase: ast.errorIndexOutOfBounds)
	let out = arrayNew(l, p: p, box: box)
	let span = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(span, op: BinOp.binSub, left: endIndex, right: start, unsigned: true, fail: noBlock))
	let loop = countedLoopBegin(l, limit: span)
	let offset = countedLoopIndex(l, loop: loop)
	let index = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(index, op: BinOp.binAdd, left: start, right: offset, unsigned: true, fail: noBlock))
	let element = arrayLoad(l, p: p, box: box, arr: arr, index: index)
	let copy = copyValue(l, p: p, site: box.site, v: element, t: arrayElem(p, box: box))
	arrayPush(l, p: p, box: box, arr: out, v: copy)
	countedLoopEnd(l, loop: loop)
	return out
end 'arraySlice'

// arrayCopyAt is a copy of the element at index, which fails with indexOutOfBounds past the end.
function arrayCopyAt(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, index Reg) returns Reg
	arrayInBounds(l, p: p, box: box, arr: arr, index: index)
	let element = arrayLoad(l, p: p, box: box, arr: arr, index: index)
	return copyValue(l, p: p, site: box.site, v: element, t: arrayElem(p, box: box))
end 'arrayCopyAt'

// arrayPushCopies pushes n copies of value, which the call only reads.
function arrayPushCopies(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, n Reg, value Reg)
	let loop = countedLoopBegin(l, limit: n)
	let copy = copyValue(l, p: p, site: box.site, v: value, t: arrayElem(p, box: box))
	arrayPush(l, p: p, box: box, arr: arr, v: copy)
	countedLoopEnd(l, loop: loop)
end 'arrayPushCopies'

// arrayGrowFilled pushes copies of value until the array has newLength elements, and does nothing for a newLength that is
// not above the length.
function arrayGrowFilled(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, newLength Reg, value Reg)
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let missing = saturatingSub(l, a: newLength, b: length)
	arrayPushCopies(l, p: p, box: box, arr: arr, n: missing, value: value)
end 'arrayGrowFilled'

// arrayRefill makes the array newLength copies of value: every element it held is dropped.
function arrayRefill(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, newLength Reg, value Reg)
	let length = arrayLength(l, p: p, box: box, arr: arr)
	arrayDropLast(l, p: p, box: box, arr: arr, n: length)
	arrayPushCopies(l, p: p, box: box, arr: arr, n: newLength, value: value)
end 'arrayRefill'

// elementsEqual is whether two values of the element type are equal: strings by their bytes, anything else that the checker
// lets through (checkElementsComparable) by its word.
function elementsEqual(mutates l Lowerer, mutates p ast.Project, box ArrayBox, a Reg, b Reg) returns Reg
	if arrayElem(p, box: box) == p.builtins.stringTy 'string'
		return runtime(l, symbol: Rt.rtStreq, kind: IrKind.kindScalar, args: argsOf2(a, b: b))
	end 'string'
	return compare(l, op: CmpOp.cmpEq, a: a, b: b, unsigned: false)
end 'elementsEqual'

// storeIf stores value in a slot where cond holds.
function storeIf(mutates l Lowerer, slot Count, cond Reg, value Word)
	let set = l.b.newBlock()
	let join = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: set, ifFalse: join))
	l.cur = set
	let v = konst(l, value: value)
	emit(l, i: newStoreSlot(slot, src: v, borrow: false))
	goTo(l, target: join)
end 'storeIf'

// arrayContains is whether some element equals value.
function arrayContains(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, value Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let loop = countedLoopBegin(l, limit: length)
	let i = countedLoopIndex(l, loop: loop)
	let element = arrayLoad(l, p: p, box: box, arr: arr, index: i)
	let same = elementsEqual(l, p: p, box: box, a: element, b: value)
	storeIf(l, slot: result, cond: same, value: 1 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: result)
end 'arrayContains'

// arrayRunMatches is whether the elements of the sequence are the ones of the array from index on, which the array has room
// for.
function arrayRunMatches(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, sequence Reg, index Reg, length Reg) returns Reg
	let matched = l.b.f.newSlot(IrKind.kindScalar)
	let yes = konst(l, value: 1 as Word)
	emit(l, i: newStoreSlot(matched, src: yes, borrow: false))
	let loop = countedLoopBegin(l, limit: length)
	let j = countedLoopIndex(l, loop: loop)
	let at = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(at, op: BinOp.binAdd, left: index, right: j, unsigned: true, fail: noBlock))
	let ours = arrayLoad(l, p: p, box: box, arr: arr, index: at)
	let theirs = arrayLoad(l, p: p, box: box, arr: sequence, index: j)
	let same = elementsEqual(l, p: p, box: box, a: ours, b: theirs)
	let differ = isZero(l, v: same)
	storeIf(l, slot: matched, cond: differ, value: 0 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: matched)
end 'arrayRunMatches'

// arrayContainsSequence is whether the elements of the sequence follow one another somewhere in the array; the empty sequence
// always does.
function arrayContainsSequence(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, sequence Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let wanted = arrayLength(l, p: p, box: box, arr: sequence)
	let one = konst(l, value: 1 as Word)
	let room = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(room, op: BinOp.binAdd, left: length, right: one, unsigned: true, fail: noBlock))
	let starts = saturatingSub(l, a: room, b: wanted)
	let loop = countedLoopBegin(l, limit: starts)
	let i = countedLoopIndex(l, loop: loop)
	let found = arrayRunMatches(l, p: p, box: box, arr: arr, sequence: sequence, index: i, length: wanted)
	storeIf(l, slot: result, cond: found, value: 1 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: result)
end 'arrayContainsSequence'

// arrayEquals is whether the arrays have the same length and equal elements in order.
function arrayEquals(mutates l Lowerer, mutates p ast.Project, box ArrayBox, arr Reg, other Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, box: box, arr: arr)
	let otherLength = arrayLength(l, p: p, box: box, arr: other)
	let sameLength = compare(l, op: CmpOp.cmpEq, a: length, b: otherLength, unsigned: true)
	let compared = l.b.newBlock()
	let done = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(sameLength, ifTrue: compared, ifFalse: done))
	l.cur = compared
	let zero = konst(l, value: 0 as Word)
	let equal = arrayRunMatches(l, p: p, box: box, arr: arr, sequence: other, index: zero, length: length)
	emit(l, i: newStoreSlot(result, src: equal, borrow: false))
	goTo(l, target: done)
	return load(l, slot: result)
end 'arrayEquals'
