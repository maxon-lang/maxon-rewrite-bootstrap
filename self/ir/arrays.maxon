// writtenInPlace is whether the backend writes the common case of a call of the runtime entry symbol in place, so that the
// call costs no more than the instructions around it: reading the length of an array, a byte array or a string, or what a
// frozen value holds, is a load, and reading, writing or pushing one element calls the entry only for an index out of range
// or a buffer that has to grow.
export function writtenInPlace(symbol Rt) returns bool
	return symbol == Rt.rtArrayLen or symbol == Rt.rtBytesLen or symbol == Rt.rtStrLen or symbol == Rt.rtFrozenGet or symbol == Rt.rtArrayElem or symbol == Rt.rtStrsElem or symbol == Rt.rtBytesGet or symbol == Rt.rtStrByteAt or symbol == Rt.rtBytesSet or symbol == Rt.rtArrayInsert or symbol == Rt.rtStrsOpen or symbol == Rt.rtBytesInsert or symbol == Rt.rtRecsElem or symbol == Rt.rtRecsOpen
end 'writtenInPlace'

// onlyReads is whether a call of the runtime entry symbol changes nothing its caller can read: it reads its arguments and
// what they reach, and gives a scalar or a new box. So it ends no read of the caller (opt.motionOf), and a value it is
// lent may be a borrow of one that nothing else changes.
export function onlyReads(symbol Rt) returns bool
	return symbol == Rt.rtConcat or symbol == Rt.rtItoa or symbol == Rt.rtDecimalLength or symbol == Rt.rtStrJoinRoom or symbol == Rt.rtStrOwned or symbol == Rt.rtStrAscii or symbol == Rt.rtArrayCapacity or symbol == Rt.rtFtoa or symbol == Rt.rtFtoaExact or symbol == Rt.rtFmtInt or symbol == Rt.rtFmtPad or symbol == Rt.rtFmtQuoted or symbol == Rt.rtFmtFixed or symbol == Rt.rtStreq or symbol == Rt.rtStrLen or symbol == Rt.rtStrByteAt or symbol == Rt.rtStrView or symbol == Rt.rtStrCount or symbol == Rt.rtStrGraphemeIndex or symbol == Rt.rtStrGraphemeBytePos or symbol == Rt.rtStrFind or symbol == Rt.rtStrFindLast or symbol == Rt.rtStrHasAffix or symbol == Rt.rtStrReplace or symbol == Rt.rtStrTrimFirst or symbol == Rt.rtStrTrimLast or symbol == Rt.rtStrMapCase or symbol == Rt.rtStrCodePointAt or symbol == Rt.rtStrCodePointNext or symbol == Rt.rtStrCodePointCount or symbol == Rt.rtStrUtf16Unit or symbol == Rt.rtStrUtf16Next or symbol == Rt.rtStrUtf16Count or symbol == Rt.rtHashWord or symbol == Rt.rtHashBytes or symbol == Rt.rtHashStringBytes or symbol == Rt.rtArrayNew or symbol == Rt.rtArrayLen or symbol == Rt.rtArrayElem or symbol == Rt.rtStrsElem or symbol == Rt.rtRecsElem or symbol == Rt.rtBytesNew or symbol == Rt.rtBytesLen or symbol == Rt.rtBytesGet or symbol == Rt.rtBytesToString
end 'onlyReads'

// arrayOf is the runtime of the array type t, read through the binding and through a frozen value.
function arrayOf(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, t ast.TypeID) returns ArrayBox
	let bt = builtinOf(l, p: p, ms: ms, collection: t)
	if ast.typeKind(ms.types, reads: p.types, t: bt) != ast.TypeKind.builtinArray 'notArray'
		panic("lower: {ast.typeName(ms.types, reads: p.types, t: t)} is not an array")
	end 'notArray'
	return ArrayBox.make(site.clone(), ty: bt)
end 'arrayOf'

// elementWay is how the buffer of the array, or of the memory or cursor over it, keeps an element (holding): a byte
// (ast.packsBytes), the words of a record held in place, which the rt.recs entries address with the element's size, a
// String's two words, which the rt.strs entries address, or a word.
function elementWay(p ast.Project, ms ast.ModuleState, box ArrayBox) returns Holding
	return holding(ms.types, reads: p.types, b: p.builtins, t: arrayElem(p, ms: ms, box: box), holder: Holder.inElement)
end 'elementWay'

// elementBytes is the size of an element of words words, as the rt.recs entries take it.
function elementBytes(mutates l Lowerer, words Count) returns Reg
	return konst(l, value: try wordOffset(words) as Word otherwise panic("lower: an element past a word"))
end 'elementBytes'

// zeroWords writes 0 to words words at the address at.
function zeroWords(mutates l Lowerer, at Reg, words Count)
	let zero = konst(l, value: 0 as Word)
	for i in 0 upto words 'words'
		emit(l, i: newStoreField(at, offset: wordOffset(i), src: zero, borrow: false))
	end 'words'
end 'zeroWords'

function arrayElem(p ast.Project, ms ast.ModuleState, box ArrayBox) returns ast.TypeID
	return ast.typeArgAt(ms.types, reads: p.types, t: box.ty, index: 0)
end 'arrayElem'

function arrayNew(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox) returns Reg
	let symbol = match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives Rt.rtBytesNew
		heldInline(_) gives Rt.rtArrayNew
		heldString gives Rt.rtArrayNew
		heldWord gives Rt.rtArrayNew
		heldBox gives Rt.rtArrayNew
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
	return entry(l, p: p, site: box.site, symbol: symbol, kind: IrKind.kindManaged, args: RegList.create(0))
end 'arrayNew'

// arrayReserve makes the buffer of an array hold count elements, where a lowering knows how many it is about to push: an
// array of words reserves them, and an array of bytes grows as it is pushed to.
function arrayReserve(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, count Reg)
	match elementWay(p, ms: ms, box: box) 'way'
		heldInline(words) then recordsCall(l, p: p, box: box, symbol: Rt.rtRecsReserve, arr: arr, n: count, words: words)
		heldString then entryVoid(l, p: p, site: box.site, symbol: Rt.rtStrsReserve, args: argsOf2(arr, b: count))
		heldWord or
		heldBox then entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayReserve, args: argsOf2(arr, b: count))
		heldPacked then _ = 0
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayReserve'

// arrayFill appends count copies of v, a word that needs no copy of its own, to an array that is not packed, in one call
// that writes them in a pass where as many inserts would each check the buffer. An array of strings is filled with empty
// elements, the String that the empty place v is.
function arrayFill(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, count Reg, v Reg)
	match elementWay(p, ms: ms, box: box) 'way'
		heldPacked panic("lower: a fill of an array of bytes")
		heldInline(_) panic("lower: a fill of an array of records held in place, whose element is no word")
		heldString then entryVoid(l, p: p, site: box.site, symbol: Rt.rtStrsFill, args: argsOf2(arr, b: count))
		heldWord or
		heldBox then entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayFill, args: argsOf3(arr, b: count, c: v))
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayFill'

function arrayLength(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg) returns Reg
	let symbol = match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives Rt.rtBytesLen
		heldInline(_) gives Rt.rtArrayLen
		heldString gives Rt.rtArrayLen
		heldWord gives Rt.rtArrayLen
		heldBox gives Rt.rtArrayLen
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
	return entry(l, p: p, site: box.site, symbol: symbol, kind: IrKind.kindScalar, args: argsOf1(arr))
end 'arrayLength'

// arrayInsert moves v in at index, which may be the length: for an array held in place, v is the address of the words it
// copies in.
function arrayInsert(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg)
	match elementWay(p, ms: ms, box: box) 'way'
		heldPacked then entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesInsert, args: argsOf3(arr, b: index, c: v))
		heldInline(words) then insertWords(l, p: p, box: box, arr: arr, index: index, v: v, words: words)
		heldString then insertString(l, p: p, box: box, arr: arr, index: index, v: v)
		heldWord or
		heldBox then entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayInsert, args: argsOf3(arr, b: index, c: v))
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayInsert'

// openRoom is the address of a new, zeroed element of words words at index of an array held in place.
function openRoom(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, index Reg, words Count) returns Reg
	let bytes = elementBytes(l, words: words)
	return entry(l, p: p, site: box.site, symbol: Rt.rtRecsOpen, kind: IrKind.kindScalar, args: argsOf3(arr, b: index, c: bytes))
end 'openRoom'

function arrayPush(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, v Reg)
	let n = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	arrayInsert(l, p: p, ms: ms, box: box, arr: arr, index: n, v: v)
end 'arrayPush'

// arrayRemove moves the element at index out.
function arrayRemove(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	return match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives entry(l, p: p, site: box.site, symbol: Rt.rtBytesRemove, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
		heldInline(words) gives removeWords(l, p: p, box: box, arr: arr, index: index, words: words)
		heldString gives removeString(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldWord gives removeWord(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldBox gives removeWord(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayRemove'

// arrayPop moves the last element out, which the caller has checked there is: nothing follows it, so nothing moves. An
// array of strings or of records held in place takes the element's address and then closes its room, which moves nothing
// for the last.
function arrayPop(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, last Reg) returns Reg
	return match elementWay(p, ms: ms, box: box) 'way'
		heldInline(_) gives arrayRemove(l, p: p, ms: ms, box: box, arr: arr, index: last)
		heldString gives arrayRemove(l, p: p, ms: ms, box: box, arr: arr, index: last)
		heldWord gives popWord(l, p: p, ms: ms, box: box, arr: arr)
		heldBox gives popWord(l, p: p, ms: ms, box: box, arr: arr)
		heldPacked gives popWord(l, p: p, ms: ms, box: box, arr: arr)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayPop'

// popWord moves the last word of an array out.
function popWord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg) returns Reg
	let kind = kindOf(l, p: p, ms: ms, t: arrayElem(p, ms: ms, box: box))
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayPop, kind: kind, args: argsOf1(arr))
end 'popWord'

// removeWords moves the element of words words at index of an array held in place out, to a frame area of its own.
function removeWords(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, index Reg, words Count) returns Reg
	let bytes = elementBytes(l, words: words)
	let at = entry(l, p: p, site: box.site, symbol: Rt.rtRecsElem, kind: IrKind.kindScalar, args: argsOf3(arr, b: index, c: bytes))
	let d = placedCopy(l, words: words, v: at)
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtRecsClose, args: argsOf3(arr, b: index, c: bytes))
	return d
end 'removeWords'

// removeString moves the String at index of an array of Strings out.
function removeString(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	let at = entry(l, p: p, site: box.site, symbol: Rt.rtStrsElem, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
	let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: arrayElem(p, ms: ms, box: box)))
	emit(l, i: newMoveAt(d, addr: at))
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtStrsClose, args: argsOf2(arr, b: index))
	return d
end 'removeString'

// removeWord moves the word at index of an array of words out.
function removeWord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	let kind = kindOf(l, p: p, ms: ms, t: arrayElem(p, ms: ms, box: box))
	return entry(l, p: p, site: box.site, symbol: Rt.rtArrayRemove, kind: kind, args: argsOf2(arr, b: index))
end 'removeWord'

// arrayLoad reads the element at index: a byte, a scalar, or a managed element lent for as long as the array is not
// changed.
function arrayLoad(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	return arrayRead(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true, read: SlotRead.slotLent)
end 'arrayLoad'

// SlotRead is what a read of an element does at a slot that holds none: an empty slot, which only the library tiers make
// (resize of an array of a type parameter, clearSlot), and which is 0 for a managed element, as maxon's is. A read that
// lends the element panics there, with maxon's message, rather than lend a box that is not there; a read that gives a
// copy fails with emptySlot, the case of ArrayError and of __ManagedMemoryError that maxon's get throws.
export enum SlotRead
	slotLent
	slotCopied
end 'SlotRead'

// emptySlotMessage is maxon's message of a lent read of an empty slot at an index, which the runtime's panicEmptySlot
// writes too.
export function emptySlotMessage(index Count) returns String
	return "empty slot: element {index} of the array was never filled"
end 'emptySlotMessage'

// requireFilled goes on only when the element read from a slot is there: an empty slot is zeroed, which tells where the
// zero value is no value of the element's type (zeroIsEmpty), and is a value otherwise.
function requireFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, elem ast.TypeID, element Reg, index Reg, read SlotRead)
	if not zeroIsEmpty(ms.types, reads: p.types, t: elem) 'value'
		return
	end 'value'
	let filled = notZero(l, p: p, ms: ms, elem: elem, element: element)
	match read 'read'
		slotCopied then failUnless(l, p: p, ms: ms, cond: filled, errorCase: ast.errorEmptySlot)
		slotLent then panicUnlessFilled(l, p: p, site: site, filled: filled, index: index)
	end 'read'
end 'requireFilled'

// notZero is whether an element loaded from a slot of a word or a String is not the slot's zero, the empty slot.
function notZero(mutates l Lowerer, p ast.Project, ms ast.ModuleState, elem ast.TypeID, element Reg) returns Reg
	let word = slotWord(l, p: p, ms: ms, elem: elem, element: element)
	let empty = konst(l, value: 0 as Word)
	return compare(l, op: CmpOp.cmpNe, a: word, b: empty, unsigned: true)
end 'notZero'

// slotWord is a word that is 0 exactly where an element loaded from a slot of a word or a String is the empty slot.
function slotWord(mutates l Lowerer, p ast.Project, ms ast.ModuleState, elem ast.TypeID, element Reg) returns Reg
	var word = element
	if valueForm(ms.types, reads: p.types, t: elem) == ValueForm.formString 'string'
		// A String that holds its bytes in its words may have a first word of 0, but never a word of 0 then.
		let first = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newStrPtr(first, src: element))
		let second = stringWord(l, text: element)
		word = wrappingBin(l, op: BinOp.binOr, a: first, b: second, kind: IrKind.kindScalar)
	end 'string'
	return word
end 'slotWord'

// slotFilled is whether the slot at index, which is inside the array, holds an element: a slot is empty where it is all 0,
// as resize and clearSlot leave it, so over a scalar an empty slot and an element 0 are the same.
function slotFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	let empty = konst(l, value: 0 as Word)
	return match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives byteFilled(l, p: p, box: box, arr: arr, index: index, empty: empty)
		heldInline(words) gives wordsFilled(l, p: p, ms: ms, box: box, arr: arr, index: index, words: words, empty: empty)
		heldString gives formFilled(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldWord gives formFilled(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldBox gives formFilled(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'slotFilled'

// byteFilled is whether the byte at index of an array of bytes is not 0.
function byteFilled(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, index Reg, empty Reg) returns Reg
	let byte = elementEntry(l, p: p, site: box.site, symbol: Rt.rtBytesGet, args: argsOf2(arr, b: index), checked: false)
	return compare(l, op: CmpOp.cmpNe, a: byte, b: empty, unsigned: true)
end 'byteFilled'

// wordsFilled is whether some one of the words words of the element at index of an array held in place is not 0.
function wordsFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, words Count, empty Reg) returns Reg
	let at = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false)
	var any = empty
	for w in 0 upto words 'words'
		let word = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newLoadField(word, obj: at, offset: wordOffset(w)))
		any = wrappingBin(l, op: BinOp.binOr, a: any, b: word, kind: IrKind.kindScalar)
	end 'words'
	return compare(l, op: CmpOp.cmpNe, a: any, b: empty, unsigned: true)
end 'wordsFilled'

// formFilled is whether the slot at index of an array of words or Strings is not its empty slot.
function formFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false)
	let elem = arrayElem(p, ms: ms, box: box)
	let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: elem))
	emit(l, i: newLoadAt(d, addr: addr))
	return notZero(l, p: p, ms: ms, elem: elem, element: d)
end 'formFilled'

// arrayAnyFilled is 1 where some slot of the array holds an element, and 0 where every slot is empty.
function arrayAnyFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let loop = countedLoopBegin(l, limit: length)
	let i = countedLoopIndex(l, loop: loop)
	let filled = slotFilled(l, p: p, ms: ms, box: box, arr: arr, index: i)
	storeIf(l, slot: result, cond: filled, value: 1 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: result)
end 'arrayAnyFilled'

// panicUnlessFilled goes on when the slot is filled, and panics with maxon's message of the slot otherwise.
function panicUnlessFilled(mutates l Lowerer, p ast.Project, site diag.Site, filled Reg, index Reg)
	let ok = l.b.newBlock()
	let bad = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(filled, ifTrue: ok, ifFalse: bad))
	l.cur = bad
	let location = strReg(l, value: ast.panicLocation(p.modules[ast.modIndex(site.module)], offset: site.offset))
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanicEmptySlot, args: argsOf2(location, b: index), routine: ast.noFunc)
	seal(l, t: newTrap())
	l.cur = ok
end 'panicUnlessFilled'

// arrayRead reads the element at index as arrayLoad does; where the checker or a check before it has proved the index
// inside the array (not checked), the entry's call is proven, which the expansion of the primitives makes the read alone.
// It stays a call until then: a function's source form is its IR from before the expansion (opt.sourceOf), whose loops
// decide E5001, as the program wrote them with the call. An element held in place is its words' address; one that nothing
// filled reads as its words 0.
function arrayRead(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, checked bool, read SlotRead) returns Reg
	return match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives elementEntry(l, p: p, site: box.site, symbol: Rt.rtBytesGet, args: argsOf2(arr, b: index), checked: checked)
		heldInline(_) gives arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked)
		heldString gives readForm(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked, read: read)
		heldWord gives readForm(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked, read: read)
		heldBox gives readForm(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked, read: read)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayRead'

// readForm reads the element at index of an array of words or Strings, as arrayRead says.
function readForm(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, checked bool, read SlotRead) returns Reg
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked)
	let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: arrayElem(p, ms: ms, box: box)))
	emit(l, i: newLoadAt(d, addr: addr))
	requireFilled(l, p: p, ms: ms, site: box.site, elem: arrayElem(p, ms: ms, box: box), element: d, index: index, read: read)
	return d
end 'readForm'

// arrayClearSlot drops the element at an index and leaves its slot empty, 0, which fails with indexOutOfBounds past the
// end.
function arrayClearSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg)
	arrayInBounds(l, p: p, ms: ms, box: box, arr: arr, index: index)
	match elementWay(p, ms: ms, box: box) 'way'
		heldInline(words) then zeroElement(l, p: p, ms: ms, box: box, arr: arr, index: index, words: words)
		heldPacked then clearByte(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldString or
		heldWord or
		heldBox then clearFormSlot(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayClearSlot'

// clearFormSlot drops the word or String at an index and leaves its slot 0.
function clearFormSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg)
	let elem = arrayElem(p, ms: ms, box: box)
	if owning(kindOf(l, p: p, ms: ms, t: elem)) 'owning'
		let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false)
		dropAt(l, p: p, ms: ms, addr: addr, t: elem)
		return
	end 'owning'
	let empty = konst(l, value: 0 as Word)
	arrayWrite(l, p: p, ms: ms, box: box, arr: arr, index: index, v: empty, checked: false)
end 'clearFormSlot'

// arrayLend is the place of the element at index that lendSlot lends, trapping past the end and at an empty slot: the
// address of its word, for a record held in place the address of its words, and for a packed element the address of its
// byte, through rt.bytes.elem as a word's is through rt.array.elem: one entry, checked the same way, which the expansion
// makes the same bounds check and address (opt/expand.maxon).
function arrayLend(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	return match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives elementEntry(l, p: p, site: box.site, symbol: Rt.rtBytesElem, args: argsOf2(arr, b: index), checked: true)
		heldInline(_) gives arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
		heldString or
		heldWord or
		heldBox gives lendFormSlot(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayLend'

// lendFormSlot is the address of the word or String at index, trapping at an empty slot as a lent read does.
function lendFormSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
	let elem = arrayElem(p, ms: ms, box: box)
	if zeroIsEmpty(ms.types, reads: p.types, t: elem) 'mayBeEmpty'
		let held = newReg(l, kind: kindOf(l, p: p, ms: ms, t: elem))
		emit(l, i: newLoadAt(held, addr: addr))
		requireFilled(l, p: p, ms: ms, site: box.site, elem: elem, element: held, index: index, read: SlotRead.slotLent)
	end 'mayBeEmpty'
	return addr
end 'lendFormSlot'

// fillSlotMessage is the trap of a fillSlot of a slot that holds an element, which it would have to drop.
let fillSlotMessage = "fillSlot of a slot that holds an element"

// arrayFillSlot moves v into the empty slot at index and drops nothing, so it fills a slot of an element without Droppable:
// it traps past the end, as a subscript does, and where the slot holds an element. Where the zero is a value of the
// element, a scalar or a record held in place, no slot holds anything to drop, and it writes over what is there.
function arrayFillSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg)
	match elementWay(p, ms: ms, box: box) 'way'
		heldPacked then entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesSet, args: argsOf3(arr, b: index, c: v))
		heldInline(words) then writeWords(l, p: p, ms: ms, box: box, arr: arr, index: index, v: v, words: words, checked: true)
		heldString or
		heldWord or
		heldBox then fillFormSlot(l, p: p, ms: ms, box: box, arr: arr, index: index, v: v)
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayFillSlot'

// fillFormSlot moves the word or String v into the empty slot at index, as arrayFillSlot says.
function fillFormSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg)
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
	let elem = arrayElem(p, ms: ms, box: box)
	if zeroIsEmpty(ms.types, reads: p.types, t: elem) 'mayHold'
		let held = newReg(l, kind: kindOf(l, p: p, ms: ms, t: elem))
		emit(l, i: newLoadAt(held, addr: addr))
		let word = slotWord(l, p: p, ms: ms, elem: elem, element: held)
		let none = konst(l, value: 0 as Word)
		let empty = compare(l, op: CmpOp.cmpEq, a: word, b: none, unsigned: true)
		requireOrTrap(l, cond: empty, message: fillSlotMessage)
	end 'mayHold'
	emit(l, i: newStoreAt(addr, src: v))
end 'fillFormSlot'

// arrayTakeSlot moves the element at index out and leaves its slot empty, all 0, so a type without Droppable can be taken
// out of a slot table. It fails with indexOutOfBounds past the end and with emptySlot at an empty slot.
function arrayTakeSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	arrayInBounds(l, p: p, ms: ms, box: box, arr: arr, index: index)
	let zero = konst(l, value: 0 as Word)
	return match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives takeByte(l, p: p, box: box, arr: arr, index: index, zero: zero)
		heldInline(words) gives takeWords(l, p: p, ms: ms, box: box, arr: arr, index: index, words: words)
		heldString gives takeForm(l, p: p, ms: ms, box: box, arr: arr, index: index, zero: zero)
		heldWord gives takeForm(l, p: p, ms: ms, box: box, arr: arr, index: index, zero: zero)
		heldBox gives takeForm(l, p: p, ms: ms, box: box, arr: arr, index: index, zero: zero)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayTakeSlot'

// takeByte reads the byte at index of an array of bytes and leaves it 0.
function takeByte(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, index Reg, zero Reg) returns Reg
	let byte = elementEntry(l, p: p, site: box.site, symbol: Rt.rtBytesGet, args: argsOf2(arr, b: index), checked: false)
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesSet, args: argsOf3(arr, b: index, c: zero))
	return byte
end 'takeByte'

// takeWords copies the words words of the element at index of an array held in place to a frame area of their own and
// leaves them 0.
function takeWords(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, words Count) returns Reg
	let at = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false)
	let taken = placedCopy(l, words: words, v: at)
	zeroWords(l, at: at, words: words)
	return taken
end 'takeWords'

// takeForm moves the word or String at index out, as arrayTakeSlot says.
function takeForm(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, zero Reg) returns Reg
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false)
	let elem = arrayElem(p, ms: ms, box: box)
	let kind = kindOf(l, p: p, ms: ms, t: elem)
	if zeroIsEmpty(ms.types, reads: p.types, t: elem) 'mayBeEmpty'
		let held = newReg(l, kind: kind)
		emit(l, i: newLoadAt(held, addr: addr))
		let filled = notZero(l, p: p, ms: ms, elem: elem, element: held)
		failUnless(l, p: p, ms: ms, cond: filled, errorCase: ast.errorEmptySlot)
	end 'mayBeEmpty'
	if owning(kind) 'owned'
		let moved = newReg(l, kind: kind)
		emit(l, i: newMoveAt(moved, addr: addr))
		return moved
	end 'owned'
	let value = newReg(l, kind: kind)
	emit(l, i: newLoadAt(value, addr: addr))
	emit(l, i: newStoreAt(addr, src: zero))
	return value
end 'takeForm'

// arraySwap exchanges the elements at two indexes where they are: each is loaded and stored into the other's slot, so neither
// is copied or dropped, and a slot that is empty stays empty. An index past the end fails with indexOutOfBounds, as a read's does.
function arraySwap(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, i Reg, j Reg)
	arrayInBounds(l, p: p, ms: ms, box: box, arr: arr, index: i)
	arrayInBounds(l, p: p, ms: ms, box: box, arr: arr, index: j)
	match elementWay(p, ms: ms, box: box) 'way'
		heldPacked then swapBytes(l, p: p, box: box, arr: arr, i: i, j: j)
		heldInline(words) then swapWords(l, p: p, ms: ms, box: box, arr: arr, i: i, j: j, words: words)
		heldString or
		heldWord or
		heldBox then swapForms(l, p: p, ms: ms, box: box, arr: arr, i: i, j: j)
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arraySwap'

// swapBytes exchanges the bytes at two indexes of an array of bytes.
function swapBytes(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, i Reg, j Reg)
	let first = elementEntry(l, p: p, site: box.site, symbol: Rt.rtBytesGet, args: argsOf2(arr, b: i), checked: false)
	let second = elementEntry(l, p: p, site: box.site, symbol: Rt.rtBytesGet, args: argsOf2(arr, b: j), checked: false)
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesSet, args: argsOf3(arr, b: i, c: second))
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesSet, args: argsOf3(arr, b: j, c: first))
end 'swapBytes'

// swapWords exchanges the words words of the elements at two indexes of an array held in place, word by word.
function swapWords(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, i Reg, j Reg, words Count)
	let addrI = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: i, checked: false)
	let addrJ = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: j, checked: false)
	for w in 0 upto words 'words'
		let first = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newLoadField(first, obj: addrI, offset: wordOffset(w)))
		let second = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newLoadField(second, obj: addrJ, offset: wordOffset(w)))
		emit(l, i: newStoreField(addrI, offset: wordOffset(w), src: second, borrow: false))
		emit(l, i: newStoreField(addrJ, offset: wordOffset(w), src: first, borrow: false))
	end 'words'
end 'swapWords'

// swapForms exchanges the words or Strings at two indexes.
function swapForms(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, i Reg, j Reg)
	let addrI = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: i, checked: false)
	let addrJ = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: j, checked: false)
	let kind = kindOf(l, p: p, ms: ms, t: arrayElem(p, ms: ms, box: box))
	let first = newReg(l, kind: kind)
	emit(l, i: newLoadAt(first, addr: addrI))
	let second = newReg(l, kind: kind)
	emit(l, i: newLoadAt(second, addr: addrJ))
	emit(l, i: newStoreAt(addrI, src: second))
	emit(l, i: newStoreAt(addrJ, src: first))
end 'swapForms'

// arrayWrite writes v to the element at index as arrayStore does, through a proven address where the index is proved
// inside the array (not checked). A byte is written by its entry either way.
function arrayWrite(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg, checked bool)
	match elementWay(p, ms: ms, box: box) 'way'
		heldPacked then entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesSet, args: argsOf3(arr, b: index, c: v))
		heldInline(words) then writeWords(l, p: p, ms: ms, box: box, arr: arr, index: index, v: v, words: words, checked: checked)
		heldString or
		heldWord or
		heldBox then writeForm(l, p: p, ms: ms, box: box, arr: arr, index: index, v: v, checked: checked)
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayWrite'

// writeForm writes the word or String v to the element at index, dropping the one it replaces.
function writeForm(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg, checked bool)
	let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked)
	dropAt(l, p: p, ms: ms, addr: addr, t: arrayElem(p, ms: ms, box: box))
	emit(l, i: newStoreAt(addr, src: v))
end 'writeForm'

// arrayStore writes v to the element at index, dropping the element it replaces.
function arrayStore(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg)
	arrayWrite(l, p: p, ms: ms, box: box, arr: arr, index: index, v: v, checked: true)
end 'arrayStore'

// arrayAddress is where the element at index of an array of words is, a proven call where the index is proved inside the
// array (not checked). A byte has no address a word can be read through: its place is a slot instead.
function arrayAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, checked bool) returns Reg
	return match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives panic("lower: an element of {ast.typeName(ms.types, reads: p.types, t: box.ty)} has no word address")
		heldInline(words) gives recordAddress(l, p: p, box: box, arr: arr, index: index, words: words, checked: checked)
		heldString gives elementEntry(l, p: p, site: box.site, symbol: Rt.rtStrsElem, args: argsOf2(arr, b: index), checked: checked)
		heldWord gives elementEntry(l, p: p, site: box.site, symbol: Rt.rtArrayElem, args: argsOf2(arr, b: index), checked: checked)
		heldBox gives elementEntry(l, p: p, site: box.site, symbol: Rt.rtArrayElem, args: argsOf2(arr, b: index), checked: checked)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayAddress'

// arrayPlace is the address a call that takes the element at index by address is given: the element's own for an array of
// words, and for an array of bytes a slot that holds the element until writeBack stores it back.
function arrayPlace(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	return match elementWay(p, ms: ms, box: box) 'way'
		heldInline(_) gives recordPlace(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldString gives arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
		heldWord gives arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
		heldBox gives arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
		heldPacked gives bytePlace(l, p: p, ms: ms, box: box, arr: arr, index: index)
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayPlace'

// bytePlace is a slot that holds the byte at index of an array of bytes until writeBack stores it back.
function bytePlace(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	let slot = l.b.f.newSlot(IrKind.kindScalar)
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: index)
	emit(l, i: newStoreSlot(slot, src: element, borrow: false))
	l.writeBacks.push(WriteBack.make(box.clone(), arr: arr, index: index, slot: slot))
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newSlotAddr(d, slot: slot))
	return d
end 'bytePlace'

// lentBytePlace is a slot that holds the byte at at, a place of a byte-sized type that a call lent (lentInByte), until
// writeBack stores it back, so that a callee that takes the place by address writes a word of its own.
function lentBytePlace(mutates l Lowerer, site diag.Site, t ast.TypeID, at Reg) returns Reg
	let slot = l.b.f.newSlot(IrKind.kindScalar)
	let element = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadByteAt(element, addr: at))
	emit(l, i: newStoreSlot(slot, src: element, borrow: false))
	l.writeBacks.push(WriteBack.makeAt(ArrayBox.make(site.clone(), ty: t), at: at, slot: slot))
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newSlotAddr(d, slot: slot))
	return d
end 'lentBytePlace'

// writeBack stores the slots of the places taken since mark back into their elements.
function writeBack(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, mark Count)
	for i in mark upto l.writeBacks.count() 'each'
		let w = l.writeBacks[i].clone()
		let v = load(l, slot: w.slot)
		if w.at != noReg 'lent'
			emit(l, i: newStoreByteAt(w.at, src: v))
		end 'lent' else 'element'
			arrayStore(l, p: p, ms: ms, box: w.box, arr: w.arr, index: w.index, v: v)
		end 'element'
	end 'each'
	l.writeBacks.truncate(mark)
end 'writeBack'

// arrayAppendCopy pushes a copy of each element of other, which is only read. The length of other is read once, before
// the first push.
function arrayAppendCopy(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, other Reg)
	match elementWay(p, ms: ms, box: box) 'way'
		heldPacked then entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesAppend, args: argsOf2(arr, b: other))
		heldInline(_) then appendCopies(l, p: p, ms: ms, box: box, arr: arr, other: other)
		heldString then appendCopies(l, p: p, ms: ms, box: box, arr: arr, other: other)
		heldWord then appendCopies(l, p: p, ms: ms, box: box, arr: arr, other: other)
		heldBox then appendCopies(l, p: p, ms: ms, box: box, arr: arr, other: other)
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayAppendCopy'

// appendCopies pushes a copy of each element of other one at a time, as arrayAppendCopy says.
function appendCopies(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, other Reg)
	let n = arrayLength(l, p: p, ms: ms, box: box, arr: other)
	let loop = countedLoopBegin(l, limit: n)
	let i = countedLoopIndex(l, loop: loop)
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: other, index: i)
	let copy = elementCopy(l, p: p, ms: ms, site: box.site, v: element, t: arrayElem(p, ms: ms, box: box))
	arrayPush(l, p: p, ms: ms, box: box, arr: arr, v: copy)
	countedLoopEnd(l, loop: loop)
end 'appendCopies'

// arrayPacked is whether the buffer of the array keeps each element in one byte.
function arrayPacked(p ast.Project, ms ast.ModuleState, box ArrayBox) returns bool
	return match elementWay(p, ms: ms, box: box) 'way'
		heldPacked gives true
		heldInline(_) gives false
		heldString gives false
		heldWord gives false
		heldBox gives false
		heldAddress(_) gives panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayPacked'

function requirePacked(p ast.Project, ms ast.ModuleState, box ArrayBox)
	if not arrayPacked(p, ms: ms, box: box) 'words'
		panic("lower: {ast.typeName(ms.types, reads: p.types, t: box.ty)} holds no bytes")
	end 'words'
end 'requirePacked'

// arrayAppendText pushes the UTF-8 bytes of a String, which only an array of bytes holds as they are.
function arrayAppendText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, text Reg)
	requirePacked(p, ms: ms, box: box)
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtBytesAppendStr, args: argsOf2(arr, b: text))
end 'arrayAppendText'

// arrayText is a String of the bytes of an array of bytes.
function arrayText(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg) returns Reg
	requirePacked(p, ms: ms, box: box)
	return entry(l, p: p, site: box.site, symbol: Rt.rtBytesToString, kind: IrKind.kindManaged, args: argsOf1(arr))
end 'arrayText'

// arrayBoundsBegin fails with indexOutOfBounds unless index is below the length; the block it gives is where the operation
// goes on, and the one being lowered is where it fails, which failUnlessEnd ends after the code between them has dropped
// what the operation was given.
function arrayBoundsBegin(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns BlockID
	let n = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let below = compare(l, op: CmpOp.cmpLt, a: index, b: n, unsigned: true)
	return failUnlessBegin(l, cond: below)
end 'arrayBoundsBegin'

// arrayInBounds fails with indexOutOfBounds unless index is below the length.
function arrayInBounds(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, arr Reg, index Reg)
	let ok = arrayBoundsBegin(l, p: p, ms: ms, box: box, arr: arr, index: index)
	failUnlessEnd(l, p: p, ms: ms, errorCase: ast.errorIndexOutOfBounds, ok: ok)
end 'arrayInBounds'

// saturatingSub is a - b, or 0 when b is above a.
function saturatingSub(mutates l Lowerer, a Reg, b Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: zero, borrow: false))
	let above = l.b.newBlock()
	let join = l.b.newBlock()
	let higher = compare(l, op: CmpOp.cmpGt, a: a, b: b, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(higher, ifTrue: above, ifFalse: join))
	l.cur = above
	let difference = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(difference, op: BinOp.binSub, left: a, right: b, unsigned: true, fail: noBlock))
	emit(l, i: newStoreSlot(result, src: difference, borrow: false))
	goTo(l, target: join)
	return load(l, slot: result)
end 'saturatingSub'

// arrayShrinkTo makes the array keep elements long, which is at most its length, and drops the elements above that, last
// first. An element that needs no drop is not visited: the length is all that changes, so clearing an array of numbers is
// one entry whatever its length. An element that owns something is dropped in place, one loop with one lookup of its address
// each, before the length is set.
function arrayShrinkTo(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, keep Reg)
	match elementWay(p, ms: ms, box: box) 'way'
		heldInline(words) then recordsCall(l, p: p, box: box, symbol: Rt.rtRecsShrink, arr: arr, n: keep, words: words)
		heldPacked or
		heldString or
		heldWord or
		heldBox then shrinkForms(l, p: p, ms: ms, box: box, arr: arr, keep: keep)
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
end 'arrayShrinkTo'

// shrinkForms makes an array of bytes, words or Strings keep elements long, as arrayShrinkTo says.
function shrinkForms(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, keep Reg)
	let elem = arrayElem(p, ms: ms, box: box)
	if owning(kindOf(l, p: p, ms: ms, t: elem)) 'owning'
		let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
		let extra = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newBin(extra, op: BinOp.binSub, left: length, right: keep, unsigned: true, fail: noBlock))
		let one = konst(l, value: 1 as Word)
		let last = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newBin(last, op: BinOp.binSub, left: length, right: one, unsigned: true, fail: noBlock))
		let loop = countedLoopBegin(l, limit: extra)
		let offset = countedLoopIndex(l, loop: loop)
		let index = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newBin(index, op: BinOp.binSub, left: last, right: offset, unsigned: true, fail: noBlock))
		let addr = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
		dropAt(l, p: p, ms: ms, addr: addr, t: elem)
		countedLoopEnd(l, loop: loop)
	end 'owning'
	entryVoid(l, p: p, site: box.site, symbol: Rt.rtArrayShrink, args: argsOf2(arr, b: keep))
end 'shrinkForms'

// arrayClear drops every element and keeps the buffer.
function arrayClear(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg)
	let none = konst(l, value: 0 as Word)
	arrayShrinkTo(l, p: p, ms: ms, box: box, arr: arr, keep: none)
end 'arrayClear'

// arrayTruncate drops the elements at and above newLength, and does nothing for a newLength that is not below the length.
function arrayTruncate(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let extra = saturatingSub(l, a: length, b: newLength)
	let keep = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(keep, op: BinOp.binSub, left: length, right: extra, unsigned: true, fail: noBlock))
	arrayShrinkTo(l, p: p, ms: ms, box: box, arr: arr, keep: keep)
end 'arrayTruncate'

// arrayGrowZero pushes zero elements until the array has newLength of them, which the checker has held to an element that has a zero.
function arrayGrowZero(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let missing = saturatingSub(l, a: newLength, b: length)
	let loop = countedLoopBegin(l, limit: missing)
	match elementWay(p, ms: ms, box: box) 'way'
		heldInline(words) then growRecord(l, p: p, ms: ms, box: box, arr: arr, words: words)
		heldString then growString(l, p: p, ms: ms, box: box, arr: arr)
		heldPacked or
		heldWord or
		heldBox then pushZero(l, p: p, ms: ms, box: box, arr: arr)
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
	countedLoopEnd(l, loop: loop)
end 'arrayGrowZero'

// arraySlice is a new array of copies of the elements from start to below endIndex, which fails with indexOutOfBounds unless
// start is not above endIndex and endIndex is not above the length, as maxon's slice does.
function arraySlice(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, start Reg, endIndex Reg) returns Reg
	let ordered = compare(l, op: CmpOp.cmpLe, a: start, b: endIndex, unsigned: true)
	failUnless(l, p: p, ms: ms, cond: ordered, errorCase: ast.errorIndexOutOfBounds)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let within = compare(l, op: CmpOp.cmpLe, a: endIndex, b: length, unsigned: true)
	failUnless(l, p: p, ms: ms, cond: within, errorCase: ast.errorIndexOutOfBounds)
	let out = arrayNew(l, p: p, ms: ms, box: box)
	let span = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(span, op: BinOp.binSub, left: endIndex, right: start, unsigned: true, fail: noBlock))
	let loop = countedLoopBegin(l, limit: span)
	let offset = countedLoopIndex(l, loop: loop)
	let index = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(index, op: BinOp.binAdd, left: start, right: offset, unsigned: true, fail: noBlock))
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: index)
	let copy = elementCopy(l, p: p, ms: ms, site: box.site, v: element, t: arrayElem(p, ms: ms, box: box))
	arrayPush(l, p: p, ms: ms, box: box, arr: out, v: copy)
	countedLoopEnd(l, loop: loop)
	return out
end 'arraySlice'

// arrayCopyAt is a copy of the element at index, which fails with indexOutOfBounds past the end.
function arrayCopyAt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	arrayInBounds(l, p: p, ms: ms, box: box, arr: arr, index: index)
	let element = arrayRead(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false, read: SlotRead.slotCopied)
	return copyValue(l, p: p, ms: ms, site: box.site, v: element, t: arrayElem(p, ms: ms, box: box))
end 'arrayCopyAt'

// arrayPushCopies pushes n copies of value, which the call only reads.
function arrayPushCopies(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, n Reg, value Reg)
	let loop = countedLoopBegin(l, limit: n)
	let copy = elementCopy(l, p: p, ms: ms, site: box.site, v: value, t: arrayElem(p, ms: ms, box: box))
	arrayPush(l, p: p, ms: ms, box: box, arr: arr, v: copy)
	countedLoopEnd(l, loop: loop)
end 'arrayPushCopies'

// arrayGrowFilled pushes copies of value until the array has newLength elements, and does nothing for a newLength that is
// not above the length.
function arrayGrowFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg, value Reg)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let missing = saturatingSub(l, a: newLength, b: length)
	arrayPushCopies(l, p: p, ms: ms, box: box, arr: arr, n: missing, value: value)
end 'arrayGrowFilled'

// arrayRefill makes the array newLength copies of value: every element it held is dropped.
function arrayRefill(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, newLength Reg, value Reg)
	arrayClear(l, p: p, ms: ms, box: box, arr: arr)
	arrayPushCopies(l, p: p, ms: ms, box: box, arr: arr, n: newLength, value: value)
end 'arrayRefill'

// elementsEqual is whether two values of the element type are equal: strings by their bytes, anything else that the checker
// lets through (checkElementsComparable) by its word.
function elementsEqual(mutates l Lowerer, p ast.Project, ms ast.ModuleState, box ArrayBox, a Reg, b Reg) returns Reg
	if arrayElem(p, ms: ms, box: box) == p.builtins.stringTy 'string'
		return runtime(l, symbol: Rt.rtStreq, kind: IrKind.kindScalar, args: argsOf2(a, b: b))
	end 'string'
	return compare(l, op: CmpOp.cmpEq, a: a, b: b, unsigned: false)
end 'elementsEqual'

// storeIf stores value in a slot where cond holds.
function storeIf(mutates l Lowerer, slot Count, cond Reg, value Word)
	let set = l.b.newBlock()
	let join = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: set, ifFalse: join))
	l.cur = set
	let v = konst(l, value: value)
	emit(l, i: newStoreSlot(slot, src: v, borrow: false))
	goTo(l, target: join)
end 'storeIf'

// arrayContains is whether some element equals value.
function arrayContains(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, value Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let loop = countedLoopBegin(l, limit: length)
	let i = countedLoopIndex(l, loop: loop)
	let element = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: i)
	let same = elementsEqual(l, p: p, ms: ms, box: box, a: element, b: value)
	storeIf(l, slot: result, cond: same, value: 1 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: result)
end 'arrayContains'

// arrayRunMatches is whether the elements of the sequence are the ones of the array from index on, which the array has room
// for.
function arrayRunMatches(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, sequence Reg, index Reg, length Reg) returns Reg
	let matched = l.b.f.newSlot(IrKind.kindScalar)
	let yes = konst(l, value: 1 as Word)
	emit(l, i: newStoreSlot(matched, src: yes, borrow: false))
	let loop = countedLoopBegin(l, limit: length)
	let j = countedLoopIndex(l, loop: loop)
	let at = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(at, op: BinOp.binAdd, left: index, right: j, unsigned: true, fail: noBlock))
	let ours = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: at)
	let theirs = arrayLoad(l, p: p, ms: ms, box: box, arr: sequence, index: j)
	let same = elementsEqual(l, p: p, ms: ms, box: box, a: ours, b: theirs)
	let differ = isZero(l, v: same)
	storeIf(l, slot: matched, cond: differ, value: 0 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: matched)
end 'arrayRunMatches'

// arrayContainsSequence is whether the elements of the sequence follow one another somewhere in the array; the empty sequence
// always does.
function arrayContainsSequence(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, sequence Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let wanted = arrayLength(l, p: p, ms: ms, box: box, arr: sequence)
	let one = konst(l, value: 1 as Word)
	let room = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(room, op: BinOp.binAdd, left: length, right: one, unsigned: true, fail: noBlock))
	let starts = saturatingSub(l, a: room, b: wanted)
	let loop = countedLoopBegin(l, limit: starts)
	let i = countedLoopIndex(l, loop: loop)
	let found = arrayRunMatches(l, p: p, ms: ms, box: box, arr: arr, sequence: sequence, index: i, length: wanted)
	storeIf(l, slot: result, cond: found, value: 1 as Word)
	countedLoopEnd(l, loop: loop)
	return load(l, slot: result)
end 'arrayContainsSequence'

// arrayEquals is whether the arrays have the same length and equal elements in order.
function arrayEquals(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, other Reg) returns Reg
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let none = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(result, src: none, borrow: false))
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	let otherLength = arrayLength(l, p: p, ms: ms, box: box, arr: other)
	let sameLength = compare(l, op: CmpOp.cmpEq, a: length, b: otherLength, unsigned: true)
	let compared = l.b.newBlock()
	let done = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(sameLength, ifTrue: compared, ifFalse: done))
	l.cur = compared
	let zero = konst(l, value: 0 as Word)
	let equal = arrayRunMatches(l, p: p, ms: ms, box: box, arr: arr, sequence: other, index: zero, length: length)
	emit(l, i: newStoreSlot(result, src: equal, borrow: false))
	goTo(l, target: done)
	return load(l, slot: result)
end 'arrayEquals'

// recordsCall calls the rt.recs entry symbol that takes the array, a count n and the size of an element of words words.
function recordsCall(mutates l Lowerer, p ast.Project, box ArrayBox, symbol Rt, arr Reg, n Reg, words Count)
	let bytes = elementBytes(l, words: words)
	entryVoid(l, p: p, site: box.site, symbol: symbol, args: argsOf3(arr, b: n, c: bytes))
end 'recordsCall'

// insertWords copies the words words at v into a new element at index of an array held in place.
function insertWords(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, index Reg, v Reg, words Count)
	let at = openRoom(l, p: p, box: box, arr: arr, index: index, words: words)
	copyWords(l, dst: at, src: v, words: words)
end 'insertWords'

// insertString moves the String v into a new element at index of an array of Strings.
function insertString(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, index Reg, v Reg)
	let at = entry(l, p: p, site: box.site, symbol: Rt.rtStrsOpen, kind: IrKind.kindScalar, args: argsOf2(arr, b: index))
	emit(l, i: newStoreAt(at, src: v))
end 'insertString'

// zeroElement writes 0 to the words words of the element at index of an array held in place.
function zeroElement(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, words Count)
	let at = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: false)
	zeroWords(l, at: at, words: words)
end 'zeroElement'

// clearByte writes 0 to the byte at index of an array of bytes.
function clearByte(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg)
	let empty = konst(l, value: 0 as Word)
	arrayWrite(l, p: p, ms: ms, box: box, arr: arr, index: index, v: empty, checked: false)
end 'clearByte'

// writeWords copies the words words at v over the element at index of an array held in place, through a proven address
// where the index is proved inside the array (not checked).
function writeWords(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg, v Reg, words Count, checked bool)
	let at = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: checked)
	copyWords(l, dst: at, src: v, words: words)
end 'writeWords'

// recordAddress is where the element of words words at index of an array held in place is.
function recordAddress(mutates l Lowerer, p ast.Project, box ArrayBox, arr Reg, index Reg, words Count, checked bool) returns Reg
	let bytes = elementBytes(l, words: words)
	return elementEntry(l, p: p, site: box.site, symbol: Rt.rtRecsElem, args: argsOf3(arr, b: index, c: bytes), checked: checked)
end 'recordAddress'

// recordPlace is the place of the element at index of an array held in place, which holds the address of its words.
function recordPlace(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, index Reg) returns Reg
	let at = arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: index, checked: true)
	return heldPlace(l, words: at)
end 'recordPlace'

// growRecord pushes a zeroed element of words words to an array held in place.
function growRecord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg, words Count)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	_ = openRoom(l, p: p, box: box, arr: arr, index: length, words: words)
end 'growRecord'

// growString pushes an empty String to an array of Strings.
function growString(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg)
	let length = arrayLength(l, p: p, ms: ms, box: box, arr: arr)
	_ = entry(l, p: p, site: box.site, symbol: Rt.rtStrsOpen, kind: IrKind.kindScalar, args: argsOf2(arr, b: length))
end 'growString'

// pushZero pushes the word 0 to an array of words or bytes.
function pushZero(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, box ArrayBox, arr Reg)
	let zero = konst(l, value: 0 as Word)
	arrayPush(l, p: p, ms: ms, box: box, arr: arr, v: zero)
end 'pushZero'
