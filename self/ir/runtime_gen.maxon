// RtParam is a parameter of an RtFunction.
export type RtParam
	export var conv as ast.Convention
	export var name as String
	export var ty as ast.TypeID

	static function make(conv ast.Convention, consumes name String, ty ast.TypeID) returns RtParam
		return RtParam{conv: conv, name: name, ty: ty}
	end 'make'
end 'RtParam'

export typealias RtParamList = Array with RtParam

// RtFunction is the function of the runtime's source that defines an entry (README, "The runtime"): code calls the
// entry as it calls any function, so its signature is the entry's calling convention.
export type RtFunction
	export var entry as Rt
	export var name as String
	export var params as RtParamList
	export var result as ast.TypeID

	static function make(entry Rt, consumes name String, consumes params RtParamList, result ast.TypeID) returns RtFunction
		return RtFunction{entry: entry, name: name, params: params, result: result}
	end 'make'
end 'RtFunction'

export typealias RtFunctionList = Array with RtFunction

// rtFunctions are the functions of the runtime's source that define entries, in the table's order.
export function rtFunctions(b ast.Builtins) returns RtFunctionList
	var fns = RtFunctionList.create(0)
	var params0 = RtParamList.create(0)
	params0.push(RtParam.make(ast.Convention.convLet, name: "bytes", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtAlloc, name: "alloc", params: params0, result: b.countTy))
	var params1 = RtParamList.create(0)
	params1.push(RtParam.make(ast.Convention.convLet, name: "box", ty: b.countTy))
