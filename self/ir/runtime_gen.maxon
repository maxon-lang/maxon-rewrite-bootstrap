// RtUnit is where a runtime symbol is defined.
export enum RtUnit
	rtUnitRuntime
	rtUnitArrays
	rtUnitBytes
	rtUnitOs
	rtUnitLinker
	rtUnitShared
	rtUnitInterpreter
	rtUnitSource
end 'RtUnit'

// rtUnit is where the symbol is defined.
export function rtUnit(r Rt) returns RtUnit
	if r == Rt.rtEntry 'rtEntry'
		return RtUnit.rtUnitRuntime
	end 'rtEntry'
	if r == Rt.rtAlloc 'rtAlloc'
		return RtUnit.rtUnitRuntime
	end 'rtAlloc'
	if r == Rt.rtFree 'rtFree'
		return RtUnit.rtUnitRuntime
	end 'rtFree'
	if r == Rt.rtWrite 'rtWrite'
		return RtUnit.rtUnitRuntime
