	end 'rtPanicEmptySlot'
	if r == Rt.rtConcat 'rtConcat'
		return "rt.concat"
	end 'rtConcat'
	if r == Rt.rtItoa 'rtItoa'
		return "rt.itoa"
	end 'rtItoa'
	if r == Rt.rtDecimalLength 'rtDecimalLength'
		return "rt.decimalLength"
	end 'rtDecimalLength'
