		61 gives Rt.rtListMoveToFront
		62 gives Rt.rtListCopy
		63 gives Rt.rtPoolNew
		64 gives Rt.rtPoolLen
		65 gives Rt.rtPoolContains
		66 gives Rt.rtPoolElem
		67 gives Rt.rtPoolInsert
		68 gives Rt.rtPoolRemove
		69 gives Rt.rtPoolCopy
		70 gives Rt.rtFrozenFreeze
		71 gives Rt.rtFrozenGet
		72 gives Rt.rtShare
		73 gives Rt.rtCownNew
		74 gives Rt.rtBytesNew
		75 gives Rt.rtBytesLen
		76 gives Rt.rtBytesGet
		77 gives Rt.rtBytesSet
		78 gives Rt.rtBytesInsert
		79 gives Rt.rtBytesRemove
		80 gives Rt.rtBytesAppend
		81 gives Rt.rtBytesAppendStr
		82 gives Rt.rtBytesToString
		83 gives Rt.rtOsArgs
		84 gives Rt.rtOsEnvironmentVariable
		85 gives Rt.rtOsExecutablePath
		86 gives Rt.rtOsCurrentPath
		87 gives Rt.rtOsProcessId
		88 gives Rt.rtOsPathFrom
		89 gives Rt.rtOsReadText
		90 gives Rt.rtOsWriteText
		91 gives Rt.rtOsWriteBinary
		92 gives Rt.rtOsRename
		93 gives Rt.rtOsDelete
		94 gives Rt.rtOsIsDirectory
		95 gives Rt.rtOsCreateDirectory
		96 gives Rt.rtOsList
		97 gives Rt.rtOsRun
		default panic("ir: a number that is no runtime symbol")
	end 'code'
end 'rtOf'

// RtUnit is where a runtime symbol is defined.
export enum RtUnit
	rtUnitRuntime
	rtUnitArrays
	rtUnitBytes
	rtUnitOs
	rtUnitLinker
	rtUnitInterpreter
	rtUnitSource
end 'RtUnit'

