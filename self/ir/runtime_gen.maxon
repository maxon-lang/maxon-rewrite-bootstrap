// rtOf is the symbol an instruction holds as a number.
export function rtOf(code Count) returns Rt
	return match code 'code'
		1 gives Rt.rtEntry
		2 gives Rt.rtAlloc
		3 gives Rt.rtFree
		4 gives Rt.rtWrite
		5 gives Rt.rtPanic
		6 gives Rt.rtConcat
		7 gives Rt.rtItoa
		8 gives Rt.rtStreq
		9 gives Rt.rtStrLen
		10 gives Rt.rtStrByteAt
		11 gives Rt.rtStrSlice
		12 gives Rt.rtStrCount
		13 gives Rt.rtStrGraphemeIndex
		14 gives Rt.rtStrGraphemeBytePos
		15 gives Rt.rtStrFind
		16 gives Rt.rtStrFindLast
		17 gives Rt.rtStrHasAffix
		18 gives Rt.rtStrReplace
		19 gives Rt.rtStrTrim
		20 gives Rt.rtStrMapCase
		21 gives Rt.rtPanicIndex
		22 gives Rt.rtHeap
		23 gives Rt.rtStdout
		24 gives Rt.rtStderr
		25 gives Rt.rtLive
		26 gives Rt.rtImageDataStart
		27 gives Rt.rtImageDataEnd
		28 gives Rt.rtCheckLeaks
		29 gives Rt.rtArrayNew
		30 gives Rt.rtArrayLen
		31 gives Rt.rtArrayElem
		32 gives Rt.rtArrayInsert
		33 gives Rt.rtArrayRemove
		34 gives Rt.rtMapNew
		35 gives Rt.rtMapLen
		36 gives Rt.rtMapHas
		37 gives Rt.rtMapElem
		38 gives Rt.rtMapInsert
		39 gives Rt.rtMapRemove
		40 gives Rt.rtMapCopy
		41 gives Rt.rtListNew
		42 gives Rt.rtListLen
		43 gives Rt.rtListContains
		44 gives Rt.rtListElem
		45 gives Rt.rtListPushFront
		46 gives Rt.rtListPushBack
		47 gives Rt.rtListPopFront
		48 gives Rt.rtListPopBack
		49 gives Rt.rtListFirst
		50 gives Rt.rtListLast
		51 gives Rt.rtListNext
		52 gives Rt.rtListPrev
		53 gives Rt.rtListRemove
		54 gives Rt.rtListMoveToFront
		55 gives Rt.rtListCopy
		56 gives Rt.rtPoolNew
		57 gives Rt.rtPoolLen
		58 gives Rt.rtPoolContains
		59 gives Rt.rtPoolElem
		60 gives Rt.rtPoolInsert
		61 gives Rt.rtPoolRemove
		62 gives Rt.rtPoolCopy
		63 gives Rt.rtFrozenFreeze
		64 gives Rt.rtFrozenGet
		65 gives Rt.rtShare
		66 gives Rt.rtCownNew
		67 gives Rt.rtBytesNew
		68 gives Rt.rtBytesLen
		69 gives Rt.rtBytesGet
		70 gives Rt.rtBytesSet
		71 gives Rt.rtBytesInsert
		72 gives Rt.rtBytesRemove
		73 gives Rt.rtBytesAppend
		74 gives Rt.rtBytesAppendStr
		75 gives Rt.rtBytesToString
		76 gives Rt.rtOsArgs
		77 gives Rt.rtOsEnvironmentVariable
		78 gives Rt.rtOsExecutablePath
		79 gives Rt.rtOsCurrentPath
		80 gives Rt.rtOsProcessId
		81 gives Rt.rtOsPathFrom
		82 gives Rt.rtOsReadText
		83 gives Rt.rtOsWriteText
		84 gives Rt.rtOsWriteBinary
		85 gives Rt.rtOsRename
		86 gives Rt.rtOsDelete
		87 gives Rt.rtOsIsDirectory
		88 gives Rt.rtOsCreateDirectory
		89 gives Rt.rtOsList
		90 gives Rt.rtOsRun
		default panic("ir: a number that is no runtime symbol")
	end 'code'
end 'rtOf'

// RtUnit is where a runtime symbol is defined.
export enum RtUnit
	rtUnitRuntime
	rtUnitArrays
	rtUnitBytes
	rtUnitOs
	rtUnitLinker
	rtUnitInterpreter
	rtUnitSource
end 'RtUnit'

