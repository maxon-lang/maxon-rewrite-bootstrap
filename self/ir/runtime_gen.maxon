// RtUnit is where a runtime symbol is defined.
export enum RtUnit
	rtUnitRuntime
	rtUnitArrays
	rtUnitBytes
	rtUnitOs
	rtUnitLinker
	rtUnitShared
	rtUnitSource
end 'RtUnit'

