// rtGivesString is whether the function that defines an entry returns a String, which a call of it gives in a
// register of that kind.
export function rtGivesString(r Rt) returns bool
	return match r 'entry'
		rtConcat or
		rtItoa or
		rtStrJoinRoom or
		rtStrJoinPut or
		rtStrJoinDigits or
		rtStrExtend or
		rtStrAppend or
		rtFtoa or
		rtFtoaExact or
		rtFmtInt or
		rtFmtPad or
		rtFmtQuoted or
		rtFmtFixed or
		rtStrSlice or
		rtStrReplace or
		rtStrTrim or
		rtStrMapCase or
		rtBytesToString or
		rtOsEnvironmentVariable or
		rtOsExecutablePath or
		rtOsCurrentPath or
		rtOsPathFrom or
		rtOsReadText gives true
		rtNone or
		rtEntry or
		rtAlloc or
		rtFree or
		rtWrite or
		rtPanic or
		rtPanicAt or
		rtCheckSimpleBytes or
		rtPanicEmptySlot or
		rtDecimalLength or
		rtStrOwned or
		rtStrRelease or
		rtStreq or
		rtStrLen or
		rtStrByteAt or
		rtStrCount or
		rtStrGraphemeIndex or
		rtStrGraphemeBytePos or
		rtStrFind or
		rtStrFindLast or
		rtStrHasAffix or
		rtStrCodePointAt or
		rtStrCodePointNext or
		rtStrCodePointCount or
		rtStrUtf16Unit or
		rtStrUtf16Next or
		rtStrUtf16Count or
		rtPanicIndex or
		rtHeap or
		rtStdout or
		rtStderr or
		rtCheckLeaks or
		rtTlsSlot or
		rtTlsOffset or
		rtMainContext or
		rtProcessStart or
		rtThreadStart or
		rtStackSwitch or
		rtGreenStart or
		rtAsyncPreempt or
		rtPreemptHandler or
		rtSigreturn or
		rtPreemptibleCode or
		rtSchedDrain or
		rtWorkerMain or
		rtEnterBlocking or
		rtExitBlocking or
		rtExitClaim or
		rtCownAcquire or
		rtCownRelease or
		rtMainRun or
		rtMainGreen or
		rtAsyncNew or
		rtAsyncStart or
		rtAsyncAwait or
		rtAsyncWait or
		rtAsyncError or
		rtAsyncTake or
		rtAsyncCancel or
		rtAsyncAwaitAny or
		rtAsyncComplete or
		rtSleep or
		rtYield or
		rtHashSeed or
		rtHashSeedDraw or
		rtHashWord or
		rtHashBytes or
		rtHashStringBytes or
		rtBytesReadWord or
		rtBytesAppendWord or
		rtServiceNew or
		rtServiceReserve or
		rtServiceTaken or
		rtServiceShutdown or
		rtReplyNew or
		rtReplyGive or
		rtArrayNew or
		rtArrayLen or
		rtArrayElem or
		rtArrayInsert or
		rtArrayRemove or
		rtArrayFill or
		rtArrayCapacity or
		rtArrayReserve or
		rtStrsElem or
		rtStrsOpen or
		rtStrsClose or
		rtStrsFill or
		rtStrsReserve or
		rtArrayShrink or
		rtListNew or
		rtListLen or
		rtListContains or
		rtListElem or
		rtListPushFront or
		rtListPushBack or
		rtListPopFront or
		rtListPopBack or
		rtListFirst or
		rtListLast or
		rtListNext or
		rtListPrev or
		rtListRemove or
		rtListMoveToFront or
		rtListCopy or
		rtPoolNew or
		rtPoolLen or
		rtPoolContains or
		rtPoolElem or
		rtPoolInsert or
		rtPoolRemove or
		rtPoolCopy or
		rtFrozenFreeze or
		rtFrozenGet or
		rtShare or
		rtCownNew or
		rtBytesNew or
		rtBytesLen or
		rtBytesGet or
		rtBytesSet or
		rtBytesInsert or
		rtBytesRemove or
		rtBytesAppend or
		rtBytesAppendStr or
		rtOsArgs or
		rtOsProcessId or
		rtOsSetExitCode or
		rtOsClockNanos or
		rtOsProcessorCount or
		rtOsWriteTextMode or
		rtOsWriteBinaryMode or
		rtOsRename or
		rtOsDelete or
		rtOsFileInfo or
		rtOsIsDirectory or
		rtOsExists or
		rtOsCreateDirectory or
		rtOsDeleteDirectory or
		rtOsList or
		rtOsRun gives false
	end 'entry'
end 'rtGivesString'
