	end 'rtPanicAt'
	if r == Rt.rtConcat 'rtConcat'
		return RtUnit.rtUnitRuntime
	end 'rtConcat'
	if r == Rt.rtItoa 'rtItoa'
		return RtUnit.rtUnitRuntime
	end 'rtItoa'
	if r == Rt.rtFtoa 'rtFtoa'
		return RtUnit.rtUnitRuntime
	end 'rtFtoa'
	if r == Rt.rtFtoaExact 'rtFtoaExact'
		return RtUnit.rtUnitRuntime
