// rtOf is the symbol an instruction holds as a number.
export function rtOf(code Count) returns Rt
	return match code 'code'
		1 gives Rt.rtEntry
		2 gives Rt.rtAlloc
		3 gives Rt.rtFree
		4 gives Rt.rtWrite
		5 gives Rt.rtPanic
		6 gives Rt.rtPanicAt
		7 gives Rt.rtConcat
