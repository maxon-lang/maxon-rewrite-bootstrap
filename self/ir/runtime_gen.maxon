		44 gives Rt.rtThreadStart
		45 gives Rt.rtSchedDrain
		46 gives Rt.rtWorkerMain
		47 gives Rt.rtCownAcquire
		48 gives Rt.rtCownRelease
		49 gives Rt.rtArrayNew
		50 gives Rt.rtArrayLen
		51 gives Rt.rtArrayElem
		52 gives Rt.rtArrayInsert
		53 gives Rt.rtArrayRemove
		54 gives Rt.rtArrayShrink
		55 gives Rt.rtMapNew
