// rtOf is the symbol an instruction holds as a number.
export function rtOf(code Count) returns Rt
	return match code 'code'
		1 gives Rt.rtEntry
		2 gives Rt.rtAlloc
		3 gives Rt.rtFree
		4 gives Rt.rtWrite
		5 gives Rt.rtPanic
		6 gives Rt.rtConcat
		7 gives Rt.rtItoa
		8 gives Rt.rtStreq
		9 gives Rt.rtStrLen
		10 gives Rt.rtStrByteAt
		11 gives Rt.rtStrSlice
		12 gives Rt.rtPanicIndex
		13 gives Rt.rtHeap
		14 gives Rt.rtStdout
		15 gives Rt.rtStderr
		16 gives Rt.rtLive
		17 gives Rt.rtImageDataStart
		18 gives Rt.rtImageDataEnd
		19 gives Rt.rtCheckLeaks
		20 gives Rt.rtArrayNew
		21 gives Rt.rtArrayLen
		22 gives Rt.rtArrayElem
		23 gives Rt.rtArrayInsert
		24 gives Rt.rtArrayRemove
		25 gives Rt.rtMapNew
		26 gives Rt.rtMapLen
		27 gives Rt.rtMapHas
		28 gives Rt.rtMapElem
		29 gives Rt.rtMapInsert
		30 gives Rt.rtMapRemove
		31 gives Rt.rtMapCopy
		32 gives Rt.rtListNew
		33 gives Rt.rtListLen
		34 gives Rt.rtListContains
		35 gives Rt.rtListElem
		36 gives Rt.rtListPushFront
		37 gives Rt.rtListPushBack
		38 gives Rt.rtListPopFront
		39 gives Rt.rtListPopBack
		40 gives Rt.rtListFirst
		41 gives Rt.rtListLast
		42 gives Rt.rtListNext
		43 gives Rt.rtListPrev
		44 gives Rt.rtListRemove
		45 gives Rt.rtListMoveToFront
		46 gives Rt.rtListCopy
		47 gives Rt.rtPoolNew
		48 gives Rt.rtPoolLen
		49 gives Rt.rtPoolContains
		50 gives Rt.rtPoolElem
		51 gives Rt.rtPoolInsert
		52 gives Rt.rtPoolRemove
		53 gives Rt.rtPoolCopy
		54 gives Rt.rtFrozenFreeze
		55 gives Rt.rtFrozenGet
		56 gives Rt.rtShare
		57 gives Rt.rtCownNew
		58 gives Rt.rtBytesNew
		59 gives Rt.rtBytesLen
		60 gives Rt.rtBytesGet
		61 gives Rt.rtBytesSet
		62 gives Rt.rtBytesInsert
		63 gives Rt.rtBytesRemove
		64 gives Rt.rtBytesAppend
		65 gives Rt.rtBytesAppendStr
		66 gives Rt.rtBytesToString
		67 gives Rt.rtOsArgs
		68 gives Rt.rtOsEnvironmentVariable
		69 gives Rt.rtOsPathFrom
		70 gives Rt.rtOsReadText
		71 gives Rt.rtOsWriteText
		72 gives Rt.rtOsWriteBinary
		73 gives Rt.rtOsRename
		74 gives Rt.rtOsDelete
		75 gives Rt.rtOsIsDirectory
		76 gives Rt.rtOsCreateDirectory
		77 gives Rt.rtOsList
		78 gives Rt.rtOsRun
		default panic("ir: a number that is no runtime symbol")
	end 'code'
end 'rtOf'

// RtUnit is where a runtime symbol is defined.
export enum RtUnit
	rtUnitRuntime
	rtUnitArrays
	rtUnitBytes
	rtUnitOs
	rtUnitLinker
	rtUnitInterpreter
	rtUnitSource
end 'RtUnit'

// rtUnit is where the symbol is defined.
export function rtUnit(r Rt) returns RtUnit
	if r == Rt.rtEntry 'rtEntry'
		return RtUnit.rtUnitRuntime
	end 'rtEntry'
	if r == Rt.rtAlloc 'rtAlloc'
		return RtUnit.rtUnitRuntime
	end 'rtAlloc'
	if r == Rt.rtFree 'rtFree'
