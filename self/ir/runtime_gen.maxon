		23 gives Rt.rtStrCodePointNext
		24 gives Rt.rtStrCodePointCount
		25 gives Rt.rtStrUtf16Unit
		26 gives Rt.rtStrUtf16Next
		27 gives Rt.rtStrUtf16Count
		28 gives Rt.rtPanicIndex
		29 gives Rt.rtHeap
		30 gives Rt.rtStdout
		31 gives Rt.rtStderr
		32 gives Rt.rtLive
		33 gives Rt.rtImageDataStart
		34 gives Rt.rtImageDataEnd
		35 gives Rt.rtCheckLeaks
		36 gives Rt.rtArrayNew
		37 gives Rt.rtArrayLen
		38 gives Rt.rtArrayElem
		39 gives Rt.rtArrayInsert
		40 gives Rt.rtArrayRemove
		41 gives Rt.rtMapNew
		42 gives Rt.rtMapLen
		43 gives Rt.rtMapHas
		44 gives Rt.rtMapElem
		45 gives Rt.rtMapInsert
		46 gives Rt.rtMapRemove
		47 gives Rt.rtMapCopy
		48 gives Rt.rtListNew
		49 gives Rt.rtListLen
		50 gives Rt.rtListContains
		51 gives Rt.rtListElem
		52 gives Rt.rtListPushFront
		53 gives Rt.rtListPushBack
		54 gives Rt.rtListPopFront
		55 gives Rt.rtListPopBack
