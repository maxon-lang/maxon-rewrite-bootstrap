	if r == Rt.rtBytesInsert 'rtBytesInsert'
		return RtUnit.rtUnitBytes
	end 'rtBytesInsert'
	if r == Rt.rtBytesRemove 'rtBytesRemove'
		return RtUnit.rtUnitBytes
	end 'rtBytesRemove'
	if r == Rt.rtBytesAppend 'rtBytesAppend'
		return RtUnit.rtUnitBytes
	end 'rtBytesAppend'
	if r == Rt.rtBytesAppendStr 'rtBytesAppendStr'
		return RtUnit.rtUnitBytes
	end 'rtBytesAppendStr'
	if r == Rt.rtBytesToString 'rtBytesToString'
		return RtUnit.rtUnitBytes
	end 'rtBytesToString'
	if r == Rt.rtOsArgs 'rtOsArgs'
		return RtUnit.rtUnitOs
	end 'rtOsArgs'
	if r == Rt.rtOsEnvironmentVariable 'rtOsEnvironmentVariable'
