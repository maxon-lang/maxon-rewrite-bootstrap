// rtGivesString is whether the function that defines an entry returns a String, which a call of it gives in a
// register of that kind.
export function rtGivesString(r Rt) returns bool
	return match r 'entry'
		rtConcat or
		rtItoa or
		rtFtoa or
		rtFtoaExact or
		rtFmtInt or
		rtFmtPad or
		rtFmtQuoted or
		rtFmtFixed or
		rtStrSlice or
		rtStrReplace or
		rtStrTrim or
		rtStrMapCase or
		rtBytesToString or
		rtOsEnvironmentVariable or
		rtOsExecutablePath or
		rtOsCurrentPath or
		rtOsPathFrom or
		rtOsReadText gives true
		rtNone or
		rtEntry or
