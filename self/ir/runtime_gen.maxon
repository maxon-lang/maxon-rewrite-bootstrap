// rtText is the name the IR text and a report give a symbol, which is the same in either compiler.
export function rtText(r Rt) returns String
	if r == Rt.rtEntry 'rtEntry'
		return "rt.entry"
	end 'rtEntry'
	if r == Rt.rtAlloc 'rtAlloc'
		return "rt.alloc"
	end 'rtAlloc'
