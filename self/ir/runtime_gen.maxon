		rtStrMapCase or
		rtBytesToString or
		rtOsEnvironmentVariable or
		rtOsExecutablePath or
		rtOsCurrentPath or
		rtOsPathFrom or
		rtOsReadText gives true
		rtNone or
		rtEntry or
		rtAlloc or
		rtFree or
		rtWrite or
		rtPanic or
