// RtParam is a parameter of an RtFunction.
export type RtParam
	export var conv as ast.Convention
	export var name as String
	export var ty as ast.TypeID

	static function make(conv ast.Convention, consumes name String, ty ast.TypeID) returns RtParam
		return RtParam{conv: conv, name: name, ty: ty}
	end 'make'
end 'RtParam'

export typealias RtParamList = Array with RtParam

// RtFunction is the function of the runtime's source that defines an entry (README, "The runtime"): code calls the
// entry as it calls any function, so its signature is the entry's calling convention.
export type RtFunction
	export var entry as Rt
	export var name as String
	export var params as RtParamList
	export var result as ast.TypeID

	static function make(entry Rt, consumes name String, consumes params RtParamList, result ast.TypeID) returns RtFunction
		return RtFunction{entry: entry, name: name, params: params, result: result}
	end 'make'
end 'RtFunction'

export typealias RtFunctionList = Array with RtFunction

// rtFunctions are the functions of the runtime's source that define entries, in the table's order.
export function rtFunctions(b ast.Builtins) returns RtFunctionList
	var fns = RtFunctionList.create(0)
	var params0 = RtParamList.create(0)
	params0.push(RtParam.make(ast.Convention.convLet, name: "bytes", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtAlloc, name: "alloc", params: params0, result: b.countTy))
	var params1 = RtParamList.create(0)
	params1.push(RtParam.make(ast.Convention.convLet, name: "box", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtFree, name: "free", params: params1, result: b.voidTy))
	var params2 = RtParamList.create(0)
	params2.push(RtParam.make(ast.Convention.convLet, name: "handle", ty: b.countTy))
	params2.push(RtParam.make(ast.Convention.convLet, name: "text", ty: b.stringTy))
	fns.push(RtFunction.make(Rt.rtWrite, name: "write", params: params2, result: b.voidTy))
	var params3 = RtParamList.create(0)
	params3.push(RtParam.make(ast.Convention.convLet, name: "message", ty: b.stringTy))
	fns.push(RtFunction.make(Rt.rtPanic, name: "panicWith", params: params3, result: b.voidTy))
	var params4 = RtParamList.create(0)
	params4.push(RtParam.make(ast.Convention.convLet, name: "location", ty: b.stringTy))
	params4.push(RtParam.make(ast.Convention.convLet, name: "message", ty: b.stringTy))
	fns.push(RtFunction.make(Rt.rtPanicAt, name: "panicAt", params: params4, result: b.voidTy))
	var params5 = RtParamList.create(0)
	params5.push(RtParam.make(ast.Convention.convLet, name: "bytes", ty: b.countTy))
	params5.push(RtParam.make(ast.Convention.convLet, name: "length", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtCheckSimpleBytes, name: "checkSimpleBytes", params: params5, result: b.voidTy))
	var params6 = RtParamList.create(0)
	params6.push(RtParam.make(ast.Convention.convLet, name: "location", ty: b.stringTy))
	params6.push(RtParam.make(ast.Convention.convLet, name: "index", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtPanicEmptySlot, name: "panicEmptySlot", params: params6, result: b.voidTy))
	var params7 = RtParamList.create(0)
	params7.push(RtParam.make(ast.Convention.convLet, name: "left", ty: b.stringTy))
	params7.push(RtParam.make(ast.Convention.convLet, name: "right", ty: b.stringTy))
	fns.push(RtFunction.make(Rt.rtConcat, name: "concat", params: params7, result: b.stringTy))
	var params8 = RtParamList.create(0)
	params8.push(RtParam.make(ast.Convention.convLet, name: "n", ty: b.countTy))
	params8.push(RtParam.make(ast.Convention.convLet, name: "unsigned", ty: b.boolTy))
	fns.push(RtFunction.make(Rt.rtItoa, name: "itoa", params: params8, result: b.stringTy))
	var params9 = RtParamList.create(0)
	params9.push(RtParam.make(ast.Convention.convLet, name: "n", ty: b.countTy))
	params9.push(RtParam.make(ast.Convention.convLet, name: "unsigned", ty: b.boolTy))
	fns.push(RtFunction.make(Rt.rtDecimalLength, name: "decimalLength", params: params9, result: b.countTy))
	var params10 = RtParamList.create(0)
	params10.push(RtParam.make(ast.Convention.convLet, name: "length", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtStrJoinRoom, name: "stringJoinRoom", params: params10, result: b.stringTy))
	var params11 = RtParamList.create(0)
	params11.push(RtParam.make(ast.Convention.convLet, name: "text", ty: b.stringTy))
	params11.push(RtParam.make(ast.Convention.convLet, name: "part", ty: b.stringTy))
	fns.push(RtFunction.make(Rt.rtStrJoinPut, name: "stringJoinPut", params: params11, result: b.stringTy))
	var params12 = RtParamList.create(0)
	params12.push(RtParam.make(ast.Convention.convLet, name: "text", ty: b.stringTy))
	params12.push(RtParam.make(ast.Convention.convLet, name: "n", ty: b.countTy))
	params12.push(RtParam.make(ast.Convention.convLet, name: "unsigned", ty: b.boolTy))
	params12.push(RtParam.make(ast.Convention.convLet, name: "length", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtStrJoinDigits, name: "stringJoinDigits", params: params12, result: b.stringTy))
	var params13 = RtParamList.create(0)
	params13.push(RtParam.make(ast.Convention.convLet, name: "text", ty: b.stringTy))
	params13.push(RtParam.make(ast.Convention.convLet, name: "owned", ty: b.boolTy))
	params13.push(RtParam.make(ast.Convention.convLet, name: "extra", ty: b.countTy))
	fns.push(RtFunction.make(Rt.rtStrExtend, name: "stringExtend", params: params13, result: b.stringTy))
	var params14 = RtParamList.create(0)
	params14.push(RtParam.make(ast.Convention.convLet, name: "text", ty: b.stringTy))
	params14.push(RtParam.make(ast.Convention.convLet, name: "owned", ty: b.boolTy))
	params14.push(RtParam.make(ast.Convention.convLet, name: "grown", ty: b.stringTy))
