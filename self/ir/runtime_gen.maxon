// rtGivesString is whether the function that defines an entry returns a String, which a call of it gives in a
// register of that kind.
export function rtGivesString(r Rt) returns bool
	return match r 'entry'
		rtConcat or
		rtItoa or
		rtStrJoinRoom or
		rtStrJoinPut or
		rtStrJoinDigits or
		rtStrExtend or
		rtStrAppend or
		rtFtoa or
		rtFtoaExact or
		rtFmtInt or
		rtFmtPad or
		rtFmtQuoted or
		rtFmtFixed or
		rtCharToString or
		rtCharFromCodepoint or
		rtCharAdvanceBy or
		rtCharOfBytes or
		rtStrView or
		rtStrCStr or
		rtStrFromCString or
		rtStrReplace or
		rtStrMapCase or
		rtBytesToString or
		rtOsEnvironmentVariable or
		rtOsExecutablePath or
		rtOsCurrentPath or
		rtOsPathFrom or
		rtOsReadText gives true
		rtNone or
		rtEntry or
		rtAlloc or
		rtFree or
		rtWrite or
		rtPanic or
		rtPanicAt or
		rtCheckSimpleBytes or
		rtPanicEmptySlot or
		rtDecimalLength or
		rtStrOwned or
		rtStrAscii or
		rtStrRelease or
		rtStreq or
		rtStrLen or
		rtCharEquals or
		rtCharCompare or
		rtCharLength or
		rtCharCodepoint or
		rtCharHash or
		rtCharNextScalar or
		rtStrByteAt or
		rtStrCount or
		rtStrGraphemeIndex or
		rtStrGraphemeBytePos or
		rtStrFind or
		rtStrFindLast or
		rtStrHasAffix or
		rtStrTrimFirst or
		rtStrTrimLast or
		rtStrCodePointAt or
		rtStrCodePointNext or
		rtStrCodePointCount or
		rtStrUtf16Unit or
		rtStrUtf16Next or
		rtStrUtf16Count or
		rtPanicIndex or
		rtHeap or
		rtStdout or
		rtStderr or
		rtCheckLeaks or
		rtTlsSlot or
		rtTlsOffset or
		rtMainContext or
		rtProcessStart or
		rtThreadStart or
		rtStackSwitch or
		rtCopyBytes or
		rtGreenStart or
		rtAsyncPreempt or
		rtPreemptHandler or
		rtSigreturn or
		rtPreemptibleCode or
		rtSchedDrain or
		rtWorkerMain or
		rtEnterBlocking or
		rtExitBlocking or
		rtExitClaim or
		rtCownAcquire or
		rtCownRelease or
		rtMainRun or
		rtMainGreen or
		rtAsyncNew or
		rtAsyncStart or
		rtAsyncAwait or
		rtAsyncWait or
		rtAsyncError or
		rtAsyncTake or
		rtAsyncCancel or
		rtAsyncAwaitAny or
		rtAsyncComplete or
		rtSleep or
		rtYield or
		rtSchedPin or
		rtSchedUnpin or
		rtHashSeed or
		rtHashSeedDraw or
		rtHeapThreadAllocs or
		rtHeapThreadFrees or
		rtHeapThreadBytes or
		rtHeapProcessAllocs or
		rtHeapProcessFrees or
		rtHeapProcessLive or
		rtHeapProcessBytes or
		rtHeapScavenge or
		rtRandomFill or
		rtHashWord or
		rtHashBytes or
		rtHashStringBytes or
		rtBytesReadWord or
		rtBytesAppendWord or
		rtServiceNew or
		rtServiceReserve or
		rtServiceTaken or
		rtServiceShutdown or
		rtReplyNew or
		rtReplyGive or
		rtArrayNew or
		rtArrayLen or
		rtArrayElem or
		rtArrayInsert or
		rtArrayRemove or
		rtArrayPop or
		rtArrayFill or
		rtArrayCapacity or
		rtArrayReserve or
		rtStrsElem or
		rtStrsOpen or
		rtStrsClose or
		rtStrsFill or
		rtStrsReserve or
		rtRecsElem or
		rtRecsOpen or
		rtRecsClose or
		rtRecsReserve or
		rtRecsShrink or
		rtArrayShrink or
		rtFrozenFreeze or
		rtFrozenGet or
		rtShare or
		rtCownNew or
		rtBytesNew or
		rtBytesLen or
		rtBytesGet or
		rtBytesElem or
		rtBytesSet or
		rtBytesInsert or
		rtBytesRemove or
		rtBytesAppend or
		rtBytesAppendStr or
		rtOsArgs or
		rtOsProcessId or
		rtOsSetExitCode or
		rtOsExitAtOnce or
		rtOsEnvironmentEntry or
		rtOsEnterBackgroundPriority or
		rtOsClockNanos or
		rtOsClockMillis or
		rtOsTickMillis or
		rtOsThreadCpuTicks or
		rtOsUnixNanos or
		rtOsUnixSeconds or
		rtOsProcessorCount or
		rtOsWriteTextMode or
		rtOsWriteBinaryMode or
		rtOsRename or
		rtOsDelete or
		rtOsFileInfo or
		rtOsIsDirectory or
		rtOsExists or
		rtOsCreateDirectory or
		rtOsDeleteDirectory or
		rtOsList or
		rtDebugLaunch or
		rtDebugWaitEvent or
		rtDebugContinueEvent or
		rtDebugReadMemory or
		rtDebugWriteCode or
		rtDebugReadContext or
		rtDebugWriteContext or
		rtDebugSuspend or
		rtDebugResume or
		rtDebugBreakIn or
		rtDebugDetach or
		rtDebugCloseHandle or
		rtDebugTerminate or
		rtOsRun or
		rtOsRunIn or
		rtOsRunInput or
		rtSubprocessSpawn or
		rtSubprocessGetPid or
		rtSubprocessWaitCollect or
		rtSubprocessResultStatusKind or
		rtSubprocessResultStatusCode or
		rtSubprocessResultStdout or
		rtSubprocessResultStderr or
		rtSubprocessResultDurationMs or
		rtSubprocessResultRelease or
		rtSubprocessReleaseHandle or
		rtSubprocessEndTree or
		rtSubprocessLastErrorCode or
		rtSubprocessLastErrorMessage or
		rtSubprocessResolveOnPath or
		rtOsReadStdin or
		rtOsStdoutWantsColor gives false
	end 'entry'
end 'rtGivesString'
