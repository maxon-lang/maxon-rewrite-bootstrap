// A value held in place (heldInPlace) is the address of its words in a register: borrowed, so nothing drops it, and every
// holder that keeps it copies the words. A local keeps them in a frame area of its own (storeLocal), a result in the area
// its caller passes (returnPlaced), and any other holder in a box of its own (boxed), which it owns and drops as before, and
// which it gives up as a copy in a frame area (unboxed).

// held is how a variable keeps a value of the type t, which the body names.
function held(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns Holding
	let ty = applyType(l, p: p, ms: ms, t: t)
	return heldAs(p, ms: ms, t: ty)
end 'held'

// heldAs is how a variable keeps a value of the type t, an instance's.
function heldAs(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns Holding
	return holding(ms.types, reads: p.types, b: p.builtins, t: t, holder: Holder.inVariable)
end 'heldAs'

// fieldHeld is how the record owner, a type the body names, keeps its field at index, of the type t that the body names.
function fieldHeld(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, index Count, t ast.TypeID) returns Holding
	let applied = applyType(l, p: p, ms: ms, t: owner)
	let record = ast.contentType(ms.types, reads: p.types, t: applied)
	let ty = applyType(l, p: p, ms: ms, t: t)
	return holding(ms.types, reads: p.types, b: p.builtins, t: ty, holder: Holder.inField(record, index: index))
end 'fieldHeld'

// newArea is a frame area of words words of its own.
function newArea(mutates l Lowerer, words Count) returns Reg
	let area = newReg(l, kind: IrKind.kindScalar)
	let instr = l.b.frameArea(area, words: words)
	emit(l, i: instr)
	return area
end 'newArea'

// copyWords copies words words from the address src to the address dst, two at a time: the loads of a pair of words
// before their stores, which arm64 makes one ldp and one stp. dst and src are one place or places that do not overlap,
// so the order of a pair's accesses leaves what is copied as it was.
function copyWords(mutates l Lowerer, dst Reg, src Reg, words Count)
	copyWordsAt(l, dst: dst, at: 0, src: src, words: words)
end 'copyWords'

// copyWordsAt copies words words from the address src to the bytes at offset at of the address dst: a record's field whose
// words are its own. It copies them two at a time, as copyWords says.
function copyWordsAt(mutates l Lowerer, dst Reg, at Count, src Reg, words Count)
	var i = 0 as Count
	while i < words 'words'
		let pair = words - i >= copyPairWords
		let after = nextWord(i)
		let w = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newLoadField(w, obj: src, offset: wordOffset(i)))
		if pair 'pairLoad'
			let v = newReg(l, kind: IrKind.kindScalar)
			emit(l, i: newLoadField(v, obj: src, offset: wordOffset(after)))
			emit(l, i: newStoreField(dst, offset: fieldWordOffset(at, i: i), src: w, borrow: false))
			emit(l, i: newStoreField(dst, offset: fieldWordOffset(at, i: after), src: v, borrow: false))
			i = nextWord(after)
		end 'pairLoad' else 'single'
			emit(l, i: newStoreField(dst, offset: fieldWordOffset(at, i: i), src: w, borrow: false))
			i = after
		end 'single'
	end 'words'
end 'copyWordsAt'

// heldPlace is the place of a value held in place whose words are at the address words, as a callee given its address
// takes it: a slot that holds that address, as a local's slot holds its frame area's. The words stay where they are, so
// nothing is written back.
function heldPlace(mutates l Lowerer, words Reg) returns Reg
	let held = l.b.f.newSlot(IrKind.kindScalar)
	emit(l, i: newStoreSlot(held, src: words, borrow: false))
	let place = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newSlotAddr(place, slot: held))
	return place
end 'heldPlace'

// fieldWordOffset is the offset of word i of a field at offset at.
function fieldWordOffset(at Count, i Count) returns Count
	return try at + wordOffset(i) otherwise panic("ir: a field past memory")
end 'fieldWordOffset'

function nextWord(i Count) returns Count
	return try i + 1 otherwise panic("ir: a record past memory")
end 'nextWord'

// copyPairWords is how many words copyWords loads before it stores them.
let copyPairWords = 2 as Count

// pushResultArea gives the arguments args of a call whose result, of the type t that is an instance's, is not lent, the
// frame area the callee writes the result to where it is held in place.
function pushResultArea(mutates l Lowerer, p ast.Project, ms ast.ModuleState, mutates args RegList, t ast.TypeID)
	match heldAs(p, ms: ms, t: t) 'holding'
		heldAddress(words) then args.push(newArea(l, words: words))
		heldWord or
		heldString or
		heldBox then break
		heldInline(_) panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'pushResultArea'

// placedCopy is a copy of the words words at v in a frame area of its own.
function placedCopy(mutates l Lowerer, words Count, v Reg) returns Reg
	let area = newArea(l, words: words)
	copyWords(l, dst: area, src: v, words: words)
	return area
end 'placedCopy'

// boxed is the value v of the type t as a holder other than a local or a result keeps it: for a value held in place, a new
// box of its words, which the holder owns; any other value as it is. The words are copied in place rather than by the
// type's copy routine, since v may be the address of words inside another record, which is no box.
function boxed(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg, t ast.TypeID) returns Reg
	return match held(l, p: p, ms: ms, t: t) 'holding'
		heldAddress(words) gives boxOfWords(l, v: v, words: words)
		heldWord gives v
		heldString gives v
		heldBox gives v
		heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'boxed'

// boxOfWords is a new box of the words words at v.
function boxOfWords(mutates l Lowerer, v Reg, words Count) returns Reg
	let d = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newAlloc(d, bytes: wordOffset(words)))
	copyWords(l, dst: d, src: v, words: words)
	return d
end 'boxOfWords'

// unboxed is the value of the box v of the type t that a holder gave up: for a value held in place, its words copied to a
// frame area of their own, and the box dropped; any other value as it is.
function unboxed(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg, t ast.TypeID) returns Reg
	return match held(l, p: p, ms: ms, t: t) 'holding'
		heldAddress(words) gives unboxWords(l, p: p, ms: ms, v: v, words: words, t: t)
		heldWord gives v
		heldString gives v
		heldBox gives v
		heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'unboxed'

// unboxWords is a copy of the words words of the box v of the type t, which the body names, in a frame area of their own,
// the box dropped.
function unboxWords(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg, words Count, t ast.TypeID) returns Reg
	let area = placedCopy(l, words: words, v: v)
	emitDropReg(l, src: v, ty: applyType(l, p: p, ms: ms, t: t))
	return area
end 'unboxWords'

// elementCopy is a copy of the value v of the type t that an array is given to keep: for a value held in place, v itself,
// whose words the array copies in; any other value copied.
function elementCopy(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, v Reg, t ast.TypeID) returns Reg
	return match held(l, p: p, ms: ms, t: t) 'holding'
		heldAddress(_) gives v
		heldWord gives copyValue(l, p: p, ms: ms, site: site, v: v, t: t)
		heldString gives copyValue(l, p: p, ms: ms, site: site, v: v, t: t)
		heldBox gives copyValue(l, p: p, ms: ms, site: site, v: v, t: t)
		heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'elementCopy'

// arrayHeld is the value v of the type t as the holder of the type holder keeps it: an array holds the words of a value
// held in place itself, and every other holder a box of its own (boxed).
function arrayHeld(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg, t ast.TypeID, holder ast.TypeID) returns Reg
	if isArray(l, p: p, ms: ms, collection: holder) 'array'
		return v
	end 'array'
	return boxed(l, p: p, ms: ms, v: v, t: t)
end 'arrayHeld'

// holderKind is the kind of a value of the type t as a holder other than a local keeps it: the managed word of its box for
// a value held in place, and its kind otherwise.
function holderKind(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns IrKind
	return match held(l, p: p, ms: ms, t: t) 'holding'
		heldAddress(_) gives IrKind.kindManaged
		heldWord gives kindOf(l, p: p, ms: ms, t: t)
		heldString gives kindOf(l, p: p, ms: ms, t: t)
		heldBox gives kindOf(l, p: p, ms: ms, t: t)
		heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'holderKind'

// holderOwns is whether a holder other than a local owns what it keeps of a value of the type t, which it drops.
function holderOwns(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns bool
	return owning(holderKind(l, p: p, ms: ms, t: t))
end 'holderOwns'

// noArea is the frame area of a local slot that has not been given one.
let noArea = -1 as Index

// placeLocal makes the slot slot one of a local held in place of words words, which storeLocal gives its values.
function placeLocal(mutates l Lowerer, slot Count, words Count)
	while l.slotWords.count() <= slot 'grow'
		l.slotWords.push(0)
		l.slotAreas.push(noArea)
	end 'grow'
	l.slotWords[slot] = words
end 'placeLocal'

// localArea is the frame area of the local slot slot, which holds a value held in place of words words: the same words at
// every store to the slot, so that the slot holds their address.
function localArea(mutates l Lowerer, slot Count, words Count) returns Reg
	if l.slotAreas[slot] == noArea 'first'
		l.slotAreas[slot] = indexOf(l.b.f.newFrameBoxes(frameAreaBoxes(words)))
	end 'first'
	let area = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newFrameArea(area, words: words, box: slotIndex(l.slotAreas[slot])))
	return area
end 'localArea'

// storeLocal gives a local slot that holds a value held in place of words words the value v: its words are copied to the
// slot's frame area, whose address the slot then holds.
function storeLocal(mutates l Lowerer, slot Count, words Count, v Reg)
	let area = localArea(l, slot: slot, words: words)
	copyWords(l, dst: area, src: v, words: words)
	l.b.emit(l.cur, i: newStoreSlot(slot, src: area, borrow: false))
end 'storeLocal'

// placeSlot gives a local slot held in place the address of its frame area before a callee is given the slot's address,
// which writes the words there: a sets parameter is given a slot that holds no value yet.
function placeSlot(mutates l Lowerer, slot Count)
	if slot >= l.slotWords.count() or l.slotWords[slot] == 0 'other'
		return
	end 'other'
	let words = l.slotWords[slot]
	let area = localArea(l, slot: slot, words: words)
	emit(l, i: newStoreSlot(slot, src: area, borrow: true))
end 'placeSlot'

// resultWords is how many words the result of the function f takes where it writes it to an area its caller passes after
// its arguments, a result held in place that it does not lend, and 0 otherwise. An instance has its types substituted, so
// every call of it and its own body read the same count (as ast.lentTupleElements).
export function resultWords(tt ast.TypeSlot, reads ast.TypeTable, b ast.Builtins, f ast.FuncEntry) returns Count
	if f.result == ast.ResultConv.resultBorrowed or f.retTy == ast.noType 'none'
		return 0
	end 'none'
	return match holding(tt, reads: reads, b: b, t: f.retTy, holder: Holder.inVariable) 'holding'
		heldAddress(words) gives words
		heldWord gives 0
		heldString gives 0
		heldBox gives 0
		heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'resultWords'

// resultAreas is how many words the function f takes after its parameters for the address of an area its caller passes
// for the result, a lent tuple's (ast.lentTupleElements) or one held in place (resultWords): 1 or 0. Every convention that
// places a function's words beyond its parameters counts it from here.
export function resultAreas(tt ast.TypeSlot, reads ast.TypeTable, b ast.Builtins, f ast.FuncEntry) returns Count
	if ast.lentTupleElements(tt, reads: reads, f: f) > 0 or resultWords(tt, reads: reads, b: b, f: f) > 0 'area'
		return 1
	end 'area'
	return 0
end 'resultAreas'
