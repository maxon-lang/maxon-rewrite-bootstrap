// enterTry starts a try whose failures go to target, naming the error in the slot binding (noSlot for none).
export function enterTry(mutates l Lowerer, target BlockID, binding Index) returns TryHandler
	let depth = l.scopes.count()
	let mark = l.scopes[pred(depth)].drops.count()
	let h = TryHandler.make(false, target: target, depth: depth, mark: mark, pending: l.pending.count(), binding: binding)
	l.handlers.push(h.clone())
	return h
end 'enterTry'

// enterPropagating starts a try that passes its failures to the caller, and gives whether it added a handler: inside
// another try, its failures go to that one's.
function enterPropagating(mutates l Lowerer) returns bool
	if l.handlers.count() > 0 'inside'
		return false
	end 'inside'
	l.handlers.push(TryHandler.make(true, target: noBlock, depth: 0 as Count, mark: 0 as Count, pending: 0 as Count, binding: noSlot))
	return true
end 'enterPropagating'

export function leaveTry(mutates l Lowerer)
	try l.handlers.pop() otherwise ignore
end 'leaveTry'

// failure is the block an operation goes to when it fails with the error errorCase, or with the error in the register err
// when that is not noReg: a word plus its bias (errorBias), as a function that throws an enum or a union held as a word
// gives it, or the box of an error union, whose drop type is then errDrop (noType for a word, see errorDropType). bias is
// the bias of the error the handler binds. The box is the failure's own, which a handler that names no error drops.
export function failure(mutates l Lowerer, p ast.Project, ms ast.ModuleState, errorCase Count, err Reg, errDrop ast.TypeID) returns BlockID
	return failureBiased(l, p: p, ms: ms, errorCase: errorCase, err: err, errDrop: errDrop, bias: 1 as Word)
end 'failure'

// failureBiased is failure of an error whose word is counted from bias.
export function failureBiased(mutates l Lowerer, p ast.Project, ms ast.ModuleState, errorCase Count, err Reg, errDrop ast.TypeID, bias Word) returns BlockID
	if l.handlers.count() == 0 'unhandled'
		panic("lower: an operation of {funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: l.fn)} that can fail is outside every try; the range analysis should have refused it")
	end 'unhandled'
	let h = l.handlers[pred(l.handlers.count())].clone()
	var error = err
	let stub = l.b.newBlock()
	let resume = l.cur
	l.cur = stub
	if h.propagates 'propagates'
		dropPending(l, first: 0 as Count, past: l.pending.count())
		unwind(l, p: p, depth: 0 as Count)
		if error == noReg 'literal'
			error = konst(l, value: try (succ(errorCase)) as Word otherwise panic("ir: an error case is out of range"))
		end 'literal'
		l.b.terminate(l.cur, t: newThrow(error))
	end 'propagates' else 'handled'
		dropPending(l, first: h.pending, past: l.pending.count())
		unwindTo(l, p: p, depth: h.depth, mark: h.mark)
		if errDrop != ast.noType 'union'
			if h.binding != noSlot 'unionBinding'
				emit(l, i: newStoreSlot(slotIndex(h.binding), src: error, borrow: false))
			end 'unionBinding' else 'unionDropped'
				emitDrop(l, d: PendingDrop.ofReg(error, ty: errDrop))
			end 'unionDropped'
		end 'union' else if h.binding != noSlot 'binding'
			var v = noReg
			if error == noReg 'literal'
				v = konst(l, value: try errorCase as Word otherwise panic("ir: an error case is out of range"))
			end 'literal' else 'register'
				let biasReg = konst(l, value: bias)
				v = wrappingBin(l, op: BinOp.binSub, a: error, b: biasReg, kind: IrKind.kindScalar)
			end 'register'
			emit(l, i: newStoreSlot(slotIndex(h.binding), src: v, borrow: false))
		end 'binding'
		l.b.terminate(l.cur, t: newJump(h.target))
	end 'handled'
	l.cur = resume
	return stub
end 'failureBiased'

// dropPending drops the values in flight from index from to index to, newest first.
function dropPending(mutates l Lowerer, first Count, past Count)
	var i = past
	while i > first 'back'
		i = pred(i)
		emitDrop(l, d: l.pending[i].clone())
	end 'back'
end 'dropPending'

// unwindTo drops what the scopes from depth inwards hold, and what the scope below them took on after it held mark drops.
function unwindTo(mutates l Lowerer, p ast.Project, depth Count, mark Count)
	unwind(l, p: p, depth: depth)
	let below = pred(depth)
	var i = l.scopes[below].drops.count()
	while i > mark 'back'
		i = pred(i)
		emitDrop(l, d: l.scopes[below].drops[i].clone())
	end 'back'
end 'unwindTo'

// visitThrowStmt lowers a throw: a failure with the error its value is a case of, which goes to the innermost try's
// handler, or with none out of the function.
function visitThrowStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let valueNode = ast.throwStmtValue(p.modules[l.mi].tree, id: s)
	let thrown = exprType(p, module: l.module, node: valueNode)
	let mark = l.pending.count()
	let value = lowerExpr(l, p: p, ms: ms, e: valueNode)
	// The throw takes the value: a failure from here on hands it to the caller or to a handler, and drops nothing of it.
	popPending(l, n: mark)
	var err = value
	let applied = applyType(l, p: p, ms: ms, t: thrown)
	if not errorInBox(ms.types, reads: p.types, t: applied) 'word'
		let biasReg = konst(l, value: errorBias(ms.types, reads: p.types, t: applied))
		err = wrappingBin(l, op: BinOp.binAdd, a: value, b: biasReg, kind: IrKind.kindScalar)
	end 'word'
	let added = enterPropagating(l)
	let errDrop = errorDropType(l, p: p, ms: ms, t: thrown)
	let stub = failureBiased(l, p: p, ms: ms, errorCase: 0 as Count, err: err, errDrop: errDrop, bias: errorBias(ms.types, reads: p.types, t: applied))
	seal(l, t: newJump(stub))
	if added 'leave'
		leaveTry(l)
	end 'leave'
end 'visitThrowStmt'

// errorDropType is the type that drops the error of the type t, which is noType for an enum: its errors are numbers.
export function errorDropType(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	let ty = dropType(l, p: p, ms: ms, t: t)
	if not errorInBox(ms.types, reads: p.types, t: ty) 'word'
		return ast.noType
	end 'word'
	return ty
end 'errorDropType'

// tryBindingSlot is the slot of the error that the handler of the try at node names, noSlot for one that names none.
function tryBindingSlot(l Lowerer, p ast.Project, node ast.NodeID) returns Index
	let local = localOfNode(p, module: l.module, node: node)
	if local == ast.noLocal 'none'
		return noSlot
	end 'none'
	return indexOf(slotOf(localEntry(p, module: l.fnModule, id: local)))
end 'tryBindingSlot'

// visitTryStmt lowers a try block: the body with its failures going to the handler, or, with no handler, onwards.
function visitTryStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	if not ast.tryStmtHasOtherwise(p.modules[l.mi].tree, id: s) 'plain'
		let added = enterPropagating(l)
		lowerBlock(l, p: p, ms: ms, ref: ast.tryStmtBodyRef(p.modules[l.mi].tree, id: s))
		if added 'leave'
			leaveTry(l)
		end 'leave'
		return
	end 'plain'
	let handler = l.b.newBlock()
	let join = l.b.newBlock()
	_ = enterTry(l, target: handler, binding: tryBindingSlot(l, p: p, node: s))
	lowerBlock(l, p: p, ms: ms, ref: ast.tryStmtBodyRef(p.modules[l.mi].tree, id: s))
	leaveTry(l)
	goTo(l, target: join)
	l.cur = handler
	lowerBlockOwning(l, p: p, ms: ms, ref: ast.tryStmtHandlerRef(p.modules[l.mi].tree, id: s), owned: localOfNode(p, module: l.module, node: s))
	goTo(l, target: join)
	l.cur = join
end 'visitTryStmt'

// visitIfTryStmt lowers a conditional try: its call with the failures going to the else block, and then the block that
// runs when the call succeeds, which owns the result the call gave. A failure of that block is not the call's, so the try
// ends before it. The temporaries of the call are a scope of their own, which a failure drops and the block that runs on
// success ends: both paths go on to the same join, which would drop them a second time on the failure's if the statement
// held them.
function visitIfTryStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let call = ast.ifTryStmtCall(p.modules[l.mi].tree, id: s)
	let failed = l.b.newBlock()
	let join = l.b.newBlock()
	_ = enterTry(l, target: failed, binding: tryBindingSlot(l, p: p, node: call))
	pushScope(l, block: false)
	let v = lowerExpr(l, p: p, ms: ms, e: call)
	if ast.ifTryStmtName(p.modules[l.mi].tree, id: s) != "" 'bind'
		let sym = localEntry(p, module: l.fnModule, id: localOfNode(p, module: l.module, node: s))
		emit(l, i: newStoreSlot(slotOf(sym), src: v, borrow: false))
		leaveTry(l)
		pushScope(l, block: true)
		ownLocal(l, p: p, ms: ms, slot: slotOf(sym), t: sym.ty)
	end 'bind' else 'bare'
		leaveTry(l)
		pushScope(l, block: true)
	end 'bare'
	lowerBlock(l, p: p, ms: ms, ref: ast.ifTryStmtThenRef(p.modules[l.mi].tree, id: s))
	popScope(l, p: p)
	popScope(l, p: p)
	goTo(l, target: join)
	l.cur = failed
	if ast.ifTryStmtHasElse(p.modules[l.mi].tree, id: s) 'else'
		lowerBlockOwning(l, p: p, ms: ms, ref: ast.ifTryStmtElseRef(p.modules[l.mi].tree, id: s), owned: localOfNode(p, module: l.module, node: call))
	end 'else'
	goTo(l, target: join)
	l.cur = join
end 'visitIfTryStmt'

// visitTryExpr lowers a try that gives a value on a failure: its expression and the value 'otherwise' gives are the two
// branches of a value, as a conditional's are. One that ignores a failure has no value, and its failure goes on after it.
function visitTryExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	if ast.tryExprIgnore(p.modules[l.mi].tree, id: e) 'ignore'
		let join = l.b.newBlock()
		_ = enterTry(l, target: join, binding: noSlot)
		pushScope(l, block: false)
		_ = lowerExpr(l, p: p, ms: ms, e: ast.tryExprE(p.modules[l.mi].tree, id: e))
		popScope(l, p: p)
		leaveTry(l)
		goTo(l, target: join)
		return konst(l, value: 0 as Word)
	end 'ignore'
	let handler = ast.tryExprHandler(p.modules[l.mi].tree, id: e)
	if handler != 0 'handler'
		let onFailure = l.b.newBlock()
		let join = l.b.newBlock()
		_ = enterTry(l, target: onFailure, binding: tryBindingSlot(l, p: p, node: e))
		pushScope(l, block: false)
		_ = lowerExpr(l, p: p, ms: ms, e: ast.tryExprE(p.modules[l.mi].tree, id: e))
		popScope(l, p: p)
		leaveTry(l)
		goTo(l, target: join)
		l.cur = onFailure
		lowerBlockOwning(l, p: p, ms: ms, ref: ast.handlerBlockBodyRef(p.modules[l.mi].tree, id: handler), owned: localOfNode(p, module: l.module, node: e))
		goTo(l, target: join)
		return konst(l, value: 0 as Word)
	end 'handler'
	let typ = exprType(p, module: l.module, node: e)
	let result = l.b.f.newSlot(kindOf(l, p: p, ms: ms, t: typ))
	let other = l.b.newBlock()
	let join = l.b.newBlock()
	_ = enterTry(l, target: other, binding: noSlot)
	pushScope(l, block: false)
	storeConverted(l, p: p, ms: ms, slot: result, e: ast.tryExprE(p.modules[l.mi].tree, id: e), target: typ)
	popScope(l, p: p)
	leaveTry(l)
	goTo(l, target: join)
	l.cur = other
	pushScope(l, block: false)
	storeConverted(l, p: p, ms: ms, slot: result, e: ast.tryExprValue(p.modules[l.mi].tree, id: e), target: typ)
	popScope(l, p: p)
	goTo(l, target: join)
	return fetch(l, slot: result)
end 'visitTryExpr'

// lowerThrough lowers a try whose value is its expression's, which passes a failure on or leaves the statement with a
// return, a break, a continue or a throw, or with a handler block that leaves.
function lowerThrough(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.NodeID) returns Reg
	if ast.propagates(p.modules[l.mi].tree, e: t) 'propagates'
		let added = enterPropagating(l)
		let v = lowerExpr(l, p: p, ms: ms, e: ast.tryExprE(p.modules[l.mi].tree, id: t))
		if added 'leave'
			leaveTry(l)
		end 'leave'
		return v
	end 'propagates'
	let exit = l.b.newBlock()
	let h = enterTry(l, target: exit, binding: tryBindingSlot(l, p: p, node: t))
	let v = lowerExpr(l, p: p, ms: ms, e: ast.tryExprE(p.modules[l.mi].tree, id: t))
	leaveTry(l)
	let resume = l.cur
	l.cur = exit
	let saved = atTryStartBegin(l, p: p, h: h)
	let ret = ast.tryExprRet(p.modules[l.mi].tree, id: t)
	let brk = ast.tryExprBrk(p.modules[l.mi].tree, id: t)
	let cont = ast.tryExprCont(p.modules[l.mi].tree, id: t)
	let thr = ast.tryExprThr(p.modules[l.mi].tree, id: t)
	let handler = ast.tryExprHandler(p.modules[l.mi].tree, id: t)
	if handler != 0 'handler'
		lowerBlockOwning(l, p: p, ms: ms, ref: ast.handlerBlockBodyRef(p.modules[l.mi].tree, id: handler), owned: localOfNode(p, module: l.module, node: t))
	end 'handler' else if ret != 0 'ret'
		visitReturnStmt(l, p: p, ms: ms, s: ret)
	end 'ret' else if brk != 0 'brk'
		visitBreakStmt(l, p: p, s: brk)
	end 'brk' else if cont != 0 'cont'
		visitContinueStmt(l, p: p, s: cont)
	end 'cont' else if thr != 0 'thr'
		visitThrowStmt(l, p: p, ms: ms, s: thr)
	end 'thr' else 'none'
		panic("lower: a try with no handler is lowered as one that passes its failures on")
	end 'none'
	atTryStartEnd(l, h: h, saved: saved)
	l.cur = resume
	return v
end 'lowerThrough'

// TrySaved is what code that runs after a failure sets aside: the values in flight where the failure happened, and the
// drops the try's code made in the scope below it.
export type TrySaved
	export var inFlight as PendingList
	export var made as PendingList

	export static function make(consumes inFlight PendingList, consumes made PendingList) returns TrySaved
		return TrySaved{inFlight: inFlight, made: made}
	end 'make'
end 'TrySaved'

// atTryStartBegin starts lowering code that runs after a failure has left what the try covered: it leaves the statement
// too, so the values in flight where the try began are dropped, and what the try's code made, which the failure dropped
// already, is not dropped again.
function atTryStartBegin(mutates l Lowerer, p ast.Project, h TryHandler) returns TrySaved
	let inFlight = l.pending.clone()
	dropPending(l, first: 0 as Count, past: h.pending)
	l.pending = PendingList.create(0)
	let below = pred(h.depth)
	var made = PendingList.create(0)
	for i in h.mark upto l.scopes[below].drops.count() 'made'
		made.push(l.scopes[below].drops[i].clone())
	end 'made'
	while l.scopes[below].drops.count() > h.mark 'cut'
		try l.scopes[below].drops.pop() otherwise ignore
	end 'cut'
	return TrySaved.make(inFlight, made: made)
end 'atTryStartBegin'

// atTryStartEnd puts back what atTryStartBegin set aside.
function atTryStartEnd(mutates l Lowerer, h TryHandler, saved TrySaved)
	let below = pred(h.depth)
	while l.scopes[below].drops.count() > h.mark 'cut'
		try l.scopes[below].drops.pop() otherwise ignore
	end 'cut'
	for i in 0 upto saved.made.count() 'made'
		l.scopes[below].drops.push(saved.made[i].clone())
	end 'made'
	l.pending = saved.inFlight.clone()
end 'atTryStartEnd'
