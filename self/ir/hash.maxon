function lowerHeapScavenge(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHeapScavenge, kind: IrKind.kindScalar, args: RegList.create(0))
