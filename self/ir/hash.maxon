function lowerHeapProcessLive(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHeapProcessLive, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerHeapProcessLive'

function lowerHeapProcessBytes(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHeapProcessBytes, kind: IrKind.kindScalar, args: RegList.create(0))
