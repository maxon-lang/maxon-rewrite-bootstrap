// The seeded hash and the ordered words of maxon's library (__Builtins): each is a call of its runtime entry, whose source
// is runtime/hash.maxon.

function lowerHashSeed(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHashSeed, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerHashSeed'

function lowerHashSeedDraw(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHashSeedDraw, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerHashSeedDraw'

function lowerRandomFill(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtRandomFill, kind: IrKind.kindScalar, args: argsOf1(args[0]))
end 'lowerRandomFill'

function lowerHashWord(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHashWord, kind: IrKind.kindScalar, args: argsOf2(args[0], b: args[1]))
end 'lowerHashWord'

function lowerHashBytes(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHashBytes, kind: IrKind.kindScalar, args: argsOf4(args[0], b: args[1], c: args[2], d: args[3]))
end 'lowerHashBytes'

// lowerArrayHashesAsStorage is whether the array hashes as the fold of the bytes of its storage (ast.storageHashes), which
// its instance knows.
function lowerArrayHashesAsStorage(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	if ast.storageHashes(ms.types, reads: p.types, b: p.builtins, elem: arrayElem(p, ms: ms, box: a)) 'storage'
		return konst(l, value: 1 as Word)
	end 'storage'
	return konst(l, value: 0 as Word)
end 'lowerArrayHashesAsStorage'

// lowerArrayStorageHash is the fold of the bytes of an array that hashes as its storage under a seed, the hashBytes of all
// of them. Of any other array it is never reached, since the library asks hashesAsStorage first, and traps.
function lowerArrayStorageHash(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	if not ast.storageHashes(ms.types, reads: p.types, b: p.builtins, elem: arrayElem(p, ms: ms, box: a)) 'elements'
		seal(l, t: newTrap())
		return konst(l, value: 0 as Word)
	end 'elements'
	let length = arrayLength(l, p: p, ms: ms, box: a, arr: recv)
	let from = konst(l, value: 0 as Word)
	for seed in args 'seed'
		return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHashBytes, kind: IrKind.kindScalar, args: argsOf4(recv, b: from, c: length, d: seed))
	end 'seed'
	panic("lower: an array's storageHash is given no seed")
end 'lowerArrayStorageHash'

function lowerHashStringBytes(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHashStringBytes, kind: IrKind.kindScalar, args: argsOf4(args[0], b: args[1], c: args[2], d: args[3]))
end 'lowerHashStringBytes'

function lowerReadBigEndian(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return readOrderedWord(l, p: p, ms: ms, c: c, args: args, bigEndian: true)
end 'lowerReadBigEndian'

function lowerReadLittleEndian(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return readOrderedWord(l, p: p, ms: ms, c: c, args: args, bigEndian: false)
end 'lowerReadLittleEndian'

function lowerAppendBigEndian(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return appendOrderedWord(l, p: p, c: c, args: args, bigEndian: true)
end 'lowerAppendBigEndian'

function lowerAppendLittleEndian(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return appendOrderedWord(l, p: p, c: c, args: args, bigEndian: false)
end 'lowerAppendLittleEndian'

// readOrderedWord reads the width bytes at an index of an array as a word, which fails with indexOutOfBounds when they are
// not all inside it. A little-endian word of a constant width of 1, 2, 4 or 8 bytes is read whole where its bytes are inside
// the array, which every target reads little-endian and unaligned, and the entry reads every other and fails.
function readOrderedWord(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, args RegList, bigEndian bool) returns Reg
	let bytes = constantWordBytes(p, ms: ms, module: l.module, e: c.ordered[2])
	if bigEndian or bytes == 0 'entry'
		return readOrderedWordByEntry(l, p: p, ms: ms, c: c, args: args, bigEndian: bigEndian)
	end 'entry'
	let src = args[0]
	let index = args[1]
	let length = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLength(length, src: src, of: Collection.collectionArray))
	// The index is below the length, which is below 2^63, so the index of the last byte does not wrap.
	let lastOffset = konst(l, value: try (bytes - 1) as Word otherwise panic("lower: a width of a word past a word"))
	let last = wrappingBin(l, op: BinOp.binAdd, a: index, b: lastOffset, kind: IrKind.kindScalar)
	let firstInside = compare(l, op: CmpOp.cmpLt, a: index, b: length, unsigned: true)
	let lastInside = compare(l, op: CmpOp.cmpLt, a: last, b: length, unsigned: true)
	let inside = wrappingBin(l, op: BinOp.binAnd, a: firstInside, b: lastInside, kind: IrKind.kindScalar)
	let result = l.b.f.newSlot(IrKind.kindScalar)
	let whole = l.b.newBlock()
	let byEntry = l.b.newBlock()
	let join = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(inside, ifTrue: whole, ifFalse: byEntry))
	l.cur = whole
	let word = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadWord(word, src: src, index: index, width: rawWidthOfBytes(bytes)))
	emit(l, i: newStoreSlot(result, src: word, borrow: false))
	goTo(l, target: join)
	l.cur = byEntry
	let read = readOrderedWordByEntry(l, p: p, ms: ms, c: c, args: args, bigEndian: bigEndian)
	emit(l, i: newStoreSlot(result, src: read, borrow: false))
	goTo(l, target: join)
	return fetch(l, slot: result)
end 'readOrderedWord'

function readOrderedWordByEntry(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, args RegList, bigEndian bool) returns Reg
	let dst = newReg(l, kind: IrKind.kindScalar)
	let order = orderFlag(l, bigEndian: bigEndian)
	let site = siteOf(l, p: p, node: c.node)
	return failing(l, p: p, ms: ms, site: site, dst: dst, symbol: Rt.rtBytesReadWord, args: argsOf4(args[0], b: args[1], c: args[2], d: order))
end 'readOrderedWordByEntry'

// constantWordBytes is the width in bytes that the expression e writes as a constant, where it is one a load reads whole
// (1, 2, 4 or 8), and 0 otherwise.
function constantWordBytes(p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID) returns Count
	let t = exprType(p, module: module, node: e)
	if ast.typeKind(ms.types, reads: p.types, t: t) != ast.TypeKind.constInt 'notConstant'
		return 0
	end 'notConstant'
	let bytes = constBits(p, ms: ms, t: t)
	if bytes == 1 or bytes == 2 or bytes == 4 or bytes == 8 'whole'
		return try bytes as Count otherwise panic("lower: a width of a word past a word")
	end 'whole'
	return 0
end 'constantWordBytes'

// rawWidthOfBytes is the width of a load of 1, 2, 4 or 8 bytes.
function rawWidthOfBytes(bytes Count) returns RawWidth
	if bytes == 1 'byte'
		return RawWidth.width8
	end 'byte'
	if bytes == 2 'half'
		return RawWidth.width16
	end 'half'
	if bytes == 4 'word32'
		return RawWidth.width32
	end 'word32'
	if bytes == 8 'word64'
		return RawWidth.width64
	end 'word64'
	panic("lower: a load of {bytes} bytes has no width")
end 'rawWidthOfBytes'

// appendOrderedWord appends the width low bytes of a word to an array in an order.
function appendOrderedWord(mutates l Lowerer, p ast.Project, c CallSite, args RegList, bigEndian bool) returns Reg
	let order = orderFlag(l, bigEndian: bigEndian)
	let site = siteOf(l, p: p, node: c.node)
	entryVoid(l, p: p, site: site, symbol: Rt.rtBytesAppendWord, args: argsOf4(args[0], b: args[1], c: args[2], d: order))
	return konst(l, value: 0 as Word)
end 'appendOrderedWord'

// orderFlag is the bool an ordered-word entry takes: whether the first byte is the most significant.
function orderFlag(mutates l Lowerer, bigEndian bool) returns Reg
	if bigEndian 'big'
		return konst(l, value: 1 as Word)
	end 'big'
	return konst(l, value: 0 as Word)
end 'orderFlag'

// lowerEnumHash is the hash() that a payload-free enum is given: its ordinal, which is its value, as int's hash() gives
// any value of 32 bits or fewer.
function lowerEnumHash(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return recv
end 'lowerEnumHash'

// lowerEnumEquals is the equals(other) that a payload-free enum is given: whether the two are one case.
function lowerEnumEquals(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return compare(l, op: CmpOp.cmpEq, a: recv, b: args[0], unsigned: true)
end 'lowerEnumEquals'

// The counters of the heap that maxon's HeapStats reads (runtime/heap.maxon): each a call of its runtime entry, but the
// counts by tag, which are 0 with no allocation tags, as maxon's are outside a --debugstream build.

function lowerHeapThreadAllocs(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHeapThreadAllocs, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerHeapThreadAllocs'

function lowerHeapThreadFrees(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHeapThreadFrees, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerHeapThreadFrees'

function lowerHeapThreadBytes(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtHeapThreadBytes, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerHeapThreadBytes'

