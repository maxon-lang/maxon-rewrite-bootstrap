// The parts of the IR that ir_gen.maxon reads: a function's records and the pools that they index, and the texts the
// printer puts together.

// IrKind is what a register or a slot holds: a word that owns nothing, a word that may own what it points at (a box, or
// 0 for nothing), or a String, two words (README, "The IR") whose bytes it may own.
export enum IrKind
	kindScalar
	kindManaged
	kindString
end 'IrKind'

export typealias IrKindList = Array with IrKind

export typealias RegList = Array with Reg

export typealias BlockIDList = Array with BlockID

export typealias WordList = Array with Word

// kindName is how the printer writes the kind of a slot.
export function kindName(k IrKind) returns String
	return match k 'k'
		kindManaged gives "managed"
		kindScalar gives "scalar"
		kindString gives "string"
	end 'k'
end 'kindName'

// owning is whether a register or a slot of the kind may own a value, which a drop then frees: a managed word or a String.
export function owning(k IrKind) returns bool
	return match k 'k'
		kindManaged gives true
		kindString gives true
		kindScalar gives false
	end 'k'
end 'owning'

// regOf is the register that a count of the registers made so far names.
// frameAreaBoxes is how many frame boxes a frame area of that many words takes.
export function frameAreaBoxes(words Count) returns Count
	let boxWords = ifaceBoxBytes / wordBytes
	return try (words + boxWords - 1) / boxWords otherwise panic("ir: a frame area past memory")
end 'frameAreaBoxes'

export function regOf(n Count) returns Reg
	return try n as Reg otherwise panic("ir: a function has more registers than a register can name")
end 'regOf'

// blockOf is the block that a count of the blocks made so far names.
export function blockOf(n Count) returns BlockID
	return try n as BlockID otherwise panic("ir: a function has more blocks than a block can name")
end 'blockOf'

// indexOf is the index into a pool that a count of its elements names.
export function indexOf(n Count) returns Index
	return try n as Index otherwise panic("ir: a pool has more elements than an index can name")
end 'indexOf'

// SwitchCase is a value of a switch, the block it goes to and the arguments it passes to that block's parameters,
// args[args] on, argCount of them.
export type SwitchCase
	export var value as Word
	export var target as BlockID
	export var args as Index
	export var argCount as Index

	export static function make(value Word, target BlockID, args Index, argCount Index) returns SwitchCase
		return SwitchCase{value: value, target: target, args: args, argCount: argCount}
	end 'make'

	export function argsStart() returns Count
		return try args as Count otherwise panic("ir: a case's arguments are out of range")
	end 'argsStart'

	export function argsCount() returns Count
		return try argCount as Count otherwise panic("ir: a case's arguments are out of range")
	end 'argsCount'
end 'SwitchCase'

export typealias CaseList = Array with SwitchCase

// Block is a run of instructions, instrs[first] up to but not including instrs[endAt], of its function, and how it ends. Its
// parameters are blockParams[params] on, paramCount of them: registers that every edge into the block sets, all at once,
// from the arguments it passes.
export type Block
	export var first as Count
	export var endAt as Count
	export var params as Count
	export var paramCount as Count
	export var term as Term

	export static function make(first Count, endAt Count, params Count, paramCount Count, consumes term Term) returns Block
		return Block{first: first, endAt: endAt, params: params, paramCount: paramCount, term: term}
	end 'make'
end 'Block'

export typealias BlockList = Array with Block

// Refusal is a place in the source that lowered to something the backend cannot run yet. Lowering still completes, so
// the IR stays whole for the interpreter, and the driver turns the first refusal of each function into an error before
// any code is generated.
export type Refusal
	export var module as diag.ModuleID
	export var offset as diag.U32
	export var code as String
	export var message as String

	export static function make(module diag.ModuleID, offset diag.U32, consumes code String, consumes message String) returns Refusal
		return Refusal{module: module, offset: offset, code: code, message: message}
	end 'make'
end 'Refusal'

export typealias RefusalList = Array with Refusal

// WitnessTable is the table of an interface value: the code that a value of the type concrete has for the interface iface,
// by the conformance of a module. It is named by symbol, which says all three, so every function that boxes a value of
// that type with that conformance names one table.
export type WitnessTable
	export var symbol as String
	export var concrete as ast.TypeID
	export var iface as ast.TypeID
	// methods are the functions that meet the interface's requirements, in the order of ast.requirementsOf.
	export var methods as ast.FuncIDList

	export static function make(consumes symbol String, concrete ast.TypeID, iface ast.TypeID, consumes methods ast.FuncIDList) returns WitnessTable
		return WitnessTable{symbol: symbol, concrete: concrete, iface: iface, methods: methods}
	end 'make'
end 'WitnessTable'

export typealias WitnessTableList = Array with WitnessTable

// IrFunction is a function's IR: the instructions of all its blocks in one list, block after block, and the pools that
// the instructions index.
export type IrFunction
	export var decl as ast.FuncID
	// name is what the function is called when that is not its declaration's symbol: a behaviour body is named for the
	// function it is in, and an instance of a generic function that holds one has one for each instance.
	export var name as String
	export var paramCount as Count
	export var slots as IrKindList
	export var regs as IrKindList
	// frameBoxes is how many frame boxes the function's frame holds, the boxes of two words of the interface values that
	// only lend a value to a borrow, which need no heap.
	export var frameBoxes as Count
	export var instrs as InstrList
	export var blocks as BlockList
	// The pools, which the c of an instruction and a range of its a and b index, and blockParams, which a block's range
	// indexes.
	export var args as RegList
	export var blockParams as RegList
	export var types as ast.TypeIDList
	export var callees as ast.FuncIDList
	export var strings as ast.StringList
	export var cases as CaseList
	// tables are the tables of the interface values that the function makes, each once.
	export var tables as WitnessTableList
	// datums are the constants laid out in the executable that the function reads, each once.
	export var datums as DatumList
	// refusals are the places in the source that cannot be compiled yet, in source order.
	export var refusals as RefusalList
	// usesArrays is whether the function calls an array entry, which the backend then links the array runtime for.
	export var usesArrays as bool
	// usesBytes is whether the function calls a byte array entry, which the backend then links the byte array runtime for.
	export var usesBytes as bool
	// usesOs is whether the function calls an OS entry, which the backend then links the OS runtime for.
	export var usesOs as bool
	// bodies are the bodies of the `when` statements and the closures in the function, in source order. One in one of them
	// has its body in that one.
	export var bodies as IrFunctionList
	// captureTypes are what the body of a closure captures, in the order the closure holds them, and captureOwned whether
	// the closure owns each, which the drop of the closure drops, or only borrows it. Every other function has none.
	export var captureTypes as ast.TypeIDList
	export var captureOwned as Array with bool
	// cownTypes are the types of the cowns that the `when` of a behaviour's body names, in source order, whose holds its
	// thunk drops after the body has run. Every other function has none.
	export var cownTypes as ast.TypeIDList
	// lendsResult is whether the function returns a place that it borrows from its arguments, a word that the caller only
	// reads and never owns, rather than a value it hands on.
	export var lendsResult as bool
	// floatParams are which of the function's parameters, by their place, and floatResult whether its result, are floats,
	// which every call that reaches it says alike (convention.maxon). A behaviour's body takes none: its thunk passes the
	// words of the behaviour's record.
	export var floatParams as FloatMask
	export var floatResult as bool
	// stringParams are which of the function's parameters, by their place, and stringResult whether its result, are
	// Strings, two words each, which every call that reaches it passes alike. A behaviour's body has its captures'.
	export var stringParams as FloatMask
	export var stringResult as bool
	// The float pool: floatMasks[i] is the float signature's mask of the call whose arguments start at floatStarts[i] in
	// args, in the order of the starts, for each call that passes a float; a call that passes none has no entry.
	export var floatStarts as Array with Count
	export var floatMasks as Array with FloatMask
	// keepsSpans is whether the build writes debug info, and then spans holds the source position of each instruction, by
	// its index, and sites the calls whose copies the function holds (spans.maxon). A build that writes none keeps both
	// empty, and no pass reads or writes them.
	export var keepsSpans as bool
	export var spans as SpanList
	export var sites as InlineSiteList

	export static function new(decl ast.FuncID, consumes name String, paramCount Count) returns IrFunction
		return IrFunction{decl: decl, name: name, paramCount: paramCount, slots: IrKindList.create(0), regs: IrKindList.create(0), frameBoxes: 0, instrs: InstrList.create(0), blocks: BlockList.create(0), args: RegList.create(0), blockParams: RegList.create(0), types: ast.TypeIDList.create(0), callees: ast.FuncIDList.create(0), strings: ast.StringList.create(0), cases: CaseList.create(0), tables: WitnessTableList.create(0), datums: DatumList.create(0), refusals: RefusalList.create(0), usesArrays: false, usesBytes: false, usesOs: false, bodies: IrFunctionList.create(0), captureTypes: ast.TypeIDList.create(0), captureOwned: Array.create(0), cownTypes: ast.TypeIDList.create(0), lendsResult: false, floatParams: 0 as FloatMask, floatResult: false, stringParams: 0 as FloatMask, stringResult: false, floatStarts: Array.create(0), floatMasks: Array.create(0), keepsSpans: false, spans: SpanList.create(0), sites: InlineSiteList.create(0)}
	end 'new'

	// keepFloats puts in the float pool the mask of the call whose arguments start at start, the last of the pool's, if it
	// passes a float.
	export function keepFloats(mutates self, start Count, mask FloatMask)
		if mask == 0 'words'
			return
		end 'words'
		let kept = floatStarts.count()
		if kept > 0 and floatStarts[try kept - 1 otherwise panic("ir: a float pool below empty")] >= start 'order'
			panic("ir: a call's float signature kept before one whose arguments start later")
		end 'order'
		floatStarts.push(start)
		floatMasks.push(mask)
	end 'keepFloats'

	// floatsAt is the mask of the call whose arguments start at start, 0 for one that passes no float.
	export function floatsAt(start Count) returns FloatMask
		var low = 0 as Count
		var high = floatStarts.count()
		while low < high 'search'
			let mid = try low + (high - low) / 2 otherwise panic("ir: a float pool past memory")
			let at = floatStarts[mid]
			if at == start 'found'
				return floatMasks[mid]
			end 'found'
			if at < start 'above'
				low = try mid + 1 otherwise panic("ir: a float pool past memory")
			end 'above' else 'below'
				high = mid
			end 'below'
		end 'search'
		return 0 as FloatMask
	end 'floatsAt'

	// takeSignature makes the function's float signature sig.
	export function takeSignature(mutates self, sig FloatSignature)
		floatParams = sig.args
		floatResult = sig.result
		stringParams = sig.strings
		stringResult = sig.stringResult
	end 'takeSignature'

	export function newReg(mutates self, kind IrKind) returns Reg
		let n = regs.count()
		regs.push(kind)
		return regOf(n)
	end 'newReg'

	export function newSlot(mutates self, kind IrKind) returns Count
		let n = slots.count()
		slots.push(kind)
		return n
	end 'newSlot'

	export function newFrameBox(mutates self) returns Count
		return self.newFrameBoxes(1)
	end 'newFrameBox'

	// newFrameBoxes reserves count frame boxes in a row, the first of which it gives.
	export function newFrameBoxes(mutates self, count Count) returns Count
		let n = frameBoxes
		frameBoxes = try frameBoxes + count otherwise panic("ir: more frame boxes than memory")
		return n
	end 'newFrameBoxes'

	export function stringAt(i Index) returns String
		return strings[try i as Count otherwise panic("ir: a string index is out of range")].clone()
	end 'stringAt'

	export function typeAt(i Index) returns ast.TypeID
		return types[try i as Count otherwise panic("ir: a type index is out of range")]
	end 'typeAt'

	export function calleeAt(i Index) returns ast.FuncID
		return callees[try i as Count otherwise panic("ir: a callee index is out of range")]
	end 'calleeAt'

	export function tableAt(i Index) returns WitnessTable
		return tables[try i as Count otherwise panic("ir: a table index is out of range")].clone()
	end 'tableAt'

	// datumIndex is where the function holds the constant d, which it holds once however many reads name it.
	export function datumIndex(mutates self, consumes d Datum) returns Count
		for i in 0 upto datums.count() 'known'
			if datums[i].symbol == d.symbol 'same'
				return i
			end 'same'
		end 'known'
		let n = datums.count()
		datums.push(d)
		return n
	end 'datumIndex'

	// tableIndex is where the function holds the table t of an interface value, which it holds once however many boxes name
	// it.
	export function tableIndex(mutates self, consumes t WitnessTable) returns Count
		for i in 0 upto tables.count() 'known'
			if tables[i].symbol == t.symbol 'same'
				return i
			end 'same'
		end 'known'
		let n = tables.count()
		tables.push(t)
		return n
	end 'tableIndex'

	export function bodyName(i Count) returns String
		return bodies[i].name.clone()
	end 'bodyName'

	export function regsText(start Count, count Count) returns String
		var b = ByteArray.create(0)
		for i in 0 upto count 'each'
			if i > 0 'sep'
				b.append(", ".toByteArray())
			end 'sep'
			let at = try start + i otherwise panic("ir: a register list is out of range")
			b.append("%{args[at]}".toByteArray())
		end 'each'
		return String.from(b)
	end 'regsText'

	export function casesText(start Count, count Count) returns String
		var b = ByteArray.create(0)
		for i in 0 upto count 'each'
			if i > 0 'sep'
				b.append(", ".toByteArray())
			end 'sep'
			let at = try start + i otherwise panic("ir: a case list is out of range")
			b.append("{cases[at].value}: b{cases[at].target}".toByteArray())
			if cases[at].argCount > 0 'args'
				b.append("({self.regsText(cases[at].argsStart(), count: cases[at].argsCount())})".toByteArray())
			end 'args'
		end 'each'
		return String.from(b)
	end 'casesText'

	// regsInto appends args[start] on, count of them, to out.
	export function regsInto(start Count, count Count, mutates out RegList)
		for i in 0 upto count 'each'
			out.push(args[try start + i otherwise panic("ir: a register list is out of range")])
		end 'each'
	end 'regsInto'

	// caseArgsInto appends the arguments of cases[start] on, count of them, to out, case after case.
	export function caseArgsInto(start Count, count Count, mutates out RegList)
		for i in 0 upto count 'each'
			let at = try start + i otherwise panic("ir: a case list is out of range")
			self.regsInto(cases[at].argsStart(), count: cases[at].argsCount(), out: out)
		end 'each'
	end 'caseArgsInto'

	// blockParam is the parameter i of block b.
	export function blockParam(b Count, i Count) returns Reg
		return blockParams[try blocks[b].params + i otherwise panic("ir: a block parameter is out of range")]
	end 'blockParam'

	// blockHeader is how the printer writes a block's label: its number, and its parameters when it has any.
	export function blockHeader(b Count) returns String
		if blocks[b].paramCount == 0 'none'
			return "b{b}"
		end 'none'
		var list = ByteArray.create(0)
		for i in 0 upto blocks[b].paramCount 'each'
			if i > 0 'sep'
				list.append(", ".toByteArray())
			end 'sep'
			list.append("%{self.blockParam(b, i: i)}".toByteArray())
		end 'each'
		return "b{b}({String.from(list)})"
	end 'blockHeader'
end 'IrFunction'

export typealias IrFunctionList = Array with IrFunction

// renamedReg is the register that names puts in place of r.
export function renamedReg(names RegList, r Reg) returns Reg
	return names[try r as Count otherwise panic("ir: a register that does not exist is renamed")]
end 'renamedReg'

// renameRegs replaces each register r of args[start] on, count of them, with names[r].
export function renameRegs(mutates args RegList, start Count, count Count, names RegList)
	for i in 0 upto count 'each'
		let at = try start + i otherwise panic("ir: a register list is out of range")
		args[at] = renamedReg(names, r: args[at])
	end 'each'
end 'renameRegs'

// renameCaseArgs replaces each register r that cases[start] on, count of them, pass with names[r].
export function renameCaseArgs(mutates args RegList, cases CaseList, start Count, count Count, names RegList)
	for i in 0 upto count 'each'
		let at = try start + i otherwise panic("ir: a case list is out of range")
		renameRegs(args, start: cases[at].argsStart(), count: cases[at].argsCount(), names: names)
	end 'each'
end 'renameCaseArgs'

// resultText is what comes before an operation that gives a value, and nothing for a call whose value nothing reads.
export function resultText(dst Reg) returns String
	if dst == noReg 'none'
		return ""
	end 'none'
	return "%{dst} = "
end 'resultText'

// quote is a string as the printer writes it, between quotes with a backslash before a quote or a backslash and a
// newline as \n.
export function quote(s String) returns String
	var b = ByteArray.create(0)
	b.push(34 as Byte)
	let bytes = s.toByteArray()
	for i in 0 upto bytes.count() 'each'
		let c = bytes[i]
		if c == 92 or c == 34 'escaped'
			b.push(92 as Byte)
			b.push(c)
		end 'escaped' else 'other'
			if c == 10 'newline'
				b.push(92 as Byte)
				b.push(110 as Byte)
			end 'newline' else 'plain'
				b.push(c)
			end 'plain'
		end 'other'
	end 'each'
	b.push(34 as Byte)
	return String.from(b)
end 'quote'

// symbol is the name of the function in the IR text and in a report.
export function irSymbol(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction) returns String
	if f.name != "" 'named'
		return f.name.clone()
	end 'named'
	return funcSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: f.decl)
end 'irSymbol'

function putText(mutates out ByteArray, s String)
	out.append(s.toByteArray())
end 'putText'

// printIr writes the text of a function and of the bodies of its behaviours and closures, as --emit-ir does.
export function printIr(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction, mutates out ByteArray)
	putText(out, s: "function {irSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: f)} params {f.paramCount}")
	if f.slots.count() > 0 'slots'
		putText(out, s: " slots [")
		for i in 0 upto f.slots.count() 'each'
			if i > 0 'sep'
				putText(out, s: ", ")
			end 'sep'
			putText(out, s: "s{i} {kindName(f.slots[i])}")
		end 'each'
		putText(out, s: "]")
	end 'slots'
	if f.frameBoxes > 0 'frameBoxes'
		putText(out, s: " frame boxes {f.frameBoxes}")
	end 'frameBoxes'
	putText(out, s: "\n")
	for b in 0 upto f.blocks.count() 'blocks'
		putText(out, s: "{f.blockHeader(b)}:\n")
		for at in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
			putText(out, s: "  {instrText(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: f, x: f.instrs[at])}\n")
		end 'instrs'
		putText(out, s: "  {termText(f, t: f.blocks[b].term)}\n")
	end 'blocks'
	putText(out, s: "\n")
	for i in 0 upto f.bodies.count() 'bodies'
		printIr(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: f.bodies[i], out: out)
	end 'bodies'
end 'printIr'

// irText is the text of a function.
export function irText(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction) returns String
	var out = ByteArray.create(0)
	printIr(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: f, out: out)
	return String.from(out)
end 'irText'
