// What the check pass recorded about the nodes of a module's bodies, read the way the lowering needs it. A node is looked
// up in the typing of the module it is in, and one the checker recorded nothing about is a hole in the checker, never a
// default.

// exprType is the type the checker gave an expression.
export function exprType(p ast.Project, module diag.ModuleID, node ast.NodeID) returns ast.TypeID
	return p.typings[ast.modIndex(module)].types.expect(node as Count, what: "expression")
end 'exprType'

// isConsumed is whether the ownership pass found the expression consuming its value.
export function isConsumed(p ast.Project, module diag.ModuleID, node ast.NodeID) returns bool
	return p.typings[ast.modIndex(module)].consumed.getOr(node as Count, fallback: false)
end 'isConsumed'

// movesOut is whether the expression's value leaves the place that holds it: one the ownership pass found consuming it,
// unless it is a function value, which the place keeps and the consumer shares.
export function movesOut(p ast.Project, ms ast.ModuleState, module diag.ModuleID, node ast.NodeID) returns bool
	return isConsumed(p, module: module, node: node) and not ast.sharesOnCopy(ms.types, reads: p.types, t: exprType(p, module: module, node: node))
end 'movesOut'

export function nameInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.NameInfo
	return p.typings[ast.modIndex(module)].names.expect(node as Count, what: "name")
end 'nameInfoAt'

export function memberInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.MemberInfo
	return p.typings[ast.modIndex(module)].members.expect(node as Count, what: "member")
end 'memberInfoAt'

export function callInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.CallInfo
	return p.typings[ast.modIndex(module)].calls.expect(node as Count, what: "call")
end 'callInfoAt'

// hookInfoAt is the call of `toString()` that the interpolation of the part at node makes.
export function hookInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.CallInfo
	return p.typings[ast.modIndex(module)].hooks.expect(node as Count, what: "interpolation")
end 'hookInfoAt'

export function iterationInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.IterationInfo
	return p.typings[ast.modIndex(module)].iterations.expect(node as Count, what: "iteration of a for")
end 'iterationInfoAt'

export function structLitInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.StructLitInfo
	return p.typings[ast.modIndex(module)].structLits.expect(node as Count, what: "struct literal")
end 'structLitInfoAt'

export function patternInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.PatternInfo
	return p.typings[ast.modIndex(module)].patterns.expect(node as Count, what: "pattern")
end 'patternInfoAt'

export function whenInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.WhenInfo
	return p.typings[ast.modIndex(module)].whens.expect(node as Count, what: "behaviour")
end 'whenInfoAt'

export function closureInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.ClosureInfo
	return p.typings[ast.modIndex(module)].closures.expect(node as Count, what: "closure")
end 'closureInfoAt'

export function arithInfoAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns borrowed ast.ArithInfo
	return p.typings[ast.modIndex(module)].arith.expect(node as Count, what: "arithmetic")
end 'arithInfoAt'

// convertsAtReturn is whether the return statement converts its value to the declared type of the function, which the
// range analysis proved fits.
export function convertsAtReturn(p ast.Project, module diag.ModuleID, node ast.NodeID) returns bool
	return p.typings[ast.modIndex(module)].arith.has(node as Count)
end 'convertsAtReturn'

// localOfNode is the local a let, a for or the handler of a try declares: none for a 'for' named '_' and for a handler
// that binds no error.
export function localOfNode(p ast.Project, module diag.ModuleID, node ast.NodeID) returns ast.LocalID
	return p.typings[ast.modIndex(module)].nodeLocals.getOr(node as Count, fallback: ast.noLocal)
end 'localOfNode'

// indexLocalOf is the variable that a `for (i, x) in xs.enumerated()` gives each element's index to, or none for any other for.
export function indexLocalOf(p ast.Project, module diag.ModuleID, node ast.NodeID) returns ast.LocalID
	return p.typings[ast.modIndex(module)].indexes.getOr(node as Count, fallback: ast.noLocal)
end 'indexLocalOf'

// drainsAt is whether a for is a walk of `xs.drain()`, which moves each element of the array out.
export function drainsAt(p ast.Project, module diag.ModuleID, node ast.NodeID) returns bool
	return p.typings[ast.modIndex(module)].drains.has(node as Count)
end 'drainsAt'

// jumpTargetOf is the loop or match that a break or a continue leaves or repeats.
export function jumpTargetOf(p ast.Project, module diag.ModuleID, node ast.NodeID) returns ast.NodeID
	return p.typings[ast.modIndex(module)].jumps.expect(node as Count, what: "jump target")
end 'jumpTargetOf'

// localEntry is a local of the function whose body is in the module.
export function localEntry(p ast.Project, module diag.ModuleID, id ast.LocalID) returns borrowed ast.LocalEntry
	return p.typings[ast.modIndex(module)].locals[id as Count]
end 'localEntry'

// isByRef is whether the local is the address of the caller's storage.
export function isByRef(local ast.LocalEntry) returns bool
	return local.isParam and not local.isSelf and (local.conv == ast.Convention.convMutates or local.conv == ast.Convention.convSets)
end 'isByRef'
