// The lowerings of the runtime's raw intrinsics (README, "The runtime"): the machine operations that only the runtime's
// source says. Each is one or two instructions; the checker admits them in no other module.

// rawAddress is the address that a load or a store works at: the address and the offset added, modulo 2^64.
function rawAddress(mutates l Lowerer, address Reg, offset Reg) returns Reg
	return wrappingBin(l, op: BinOp.binAdd, a: address, b: offset, kind: IrKind.kindScalar)
end 'rawAddress'

// wrappingBin is an operation on two words that cannot fail: it has no failure block, so the result wraps.
function wrappingBin(mutates l Lowerer, op BinOp, a Reg, b Reg, kind IrKind) returns Reg
	let d = newReg(l, kind: kind)
	emit(l, i: newBin(d, op: op, left: a, right: b, unsigned: true, fail: noBlock))
	return d
end 'wrappingBin'

// rawLoad is the width bits at address + offset, zero-extended.
function rawLoad(mutates l Lowerer, args RegList, width RawWidth) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadRaw(d, addr: at, width: width))
	return d
end 'rawLoad'

// rawStore writes the low width bits of the value at address + offset. A call has a value, which a store gives as 0.
function rawStore(mutates l Lowerer, args RegList, width RawWidth) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	emit(l, i: newStoreRaw(at, src: args[2], width: width))
	return konst(l, value: 0 as Word)
end 'rawStore'

// globalAddress is the address of a symbol of the entry stub: a global, or the code a thread starts at.
function globalAddress(mutates l Lowerer, symbol Rt) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newGlobalAddr(d, symbol: symbol))
	return d
end 'globalAddress'

function lowerRawLoad8(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawLoad(l, args: args, width: RawWidth.width8)
end 'lowerRawLoad8'

function lowerRawLoad16(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawLoad(l, args: args, width: RawWidth.width16)
end 'lowerRawLoad16'

function lowerRawLoad32(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawLoad(l, args: args, width: RawWidth.width32)
end 'lowerRawLoad32'

function lowerRawLoad64(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawLoad(l, args: args, width: RawWidth.width64)
end 'lowerRawLoad64'

function lowerRawStore8(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawStore(l, args: args, width: RawWidth.width8)
end 'lowerRawStore8'

function lowerRawStore16(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawStore(l, args: args, width: RawWidth.width16)
end 'lowerRawStore16'

function lowerRawStore32(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawStore(l, args: args, width: RawWidth.width32)
end 'lowerRawStore32'

function lowerRawStore64(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return rawStore(l, args: args, width: RawWidth.width64)
end 'lowerRawStore64'

function lowerRawLoadAcquire(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadAcquire(d, addr: at))
	return d
end 'lowerRawLoadAcquire'

function lowerRawStoreRelease(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	emit(l, i: newStoreRelease(at, src: args[2]))
	return konst(l, value: 0 as Word)
end 'lowerRawStoreRelease'

function lowerRawWrappingAdd(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return wrappingBin(l, op: BinOp.binAdd, a: args[0], b: args[1], kind: IrKind.kindScalar)
end 'lowerRawWrappingAdd'

function lowerRawWrappingSub(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return wrappingBin(l, op: BinOp.binSub, a: args[0], b: args[1], kind: IrKind.kindScalar)
end 'lowerRawWrappingSub'

function lowerRawMulHigh(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return wrappingBin(l, op: BinOp.binMulHi, a: args[0], b: args[1], kind: IrKind.kindScalar)
end 'lowerRawMulHigh'

// lowerRawAddressOf is the address of the local that the call is given as its place. The call evaluates its operand
// itself, since the value of the place is not what it is given.
function lowerRawAddressOf(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return address(l, p: p, ms: ms, e: c.ordered[0])
end 'lowerRawAddressOf'

// The String intrinsics, which say nothing of the layout to the runtime's source: a String is its two words in one register
// (strptr, strword, strmake), its room a box of runtime::alloc that the String owns once stringOf makes it.

// shifted is the word w moved by a constant of the layout: plus it for binAdd, less it for binSub.
function shifted(mutates l Lowerer, w Reg, op BinOp, offset Count) returns Reg
	let k = konst(l, value: countWord(offset))
	return wrappingBin(l, op: op, a: w, b: k, kind: IrKind.kindScalar)
end 'shifted'

// loadWordAt is the word at w plus a constant of the layout.
function loadWordAt(mutates l Lowerer, w Reg, offset Count) returns Reg
	let at = shifted(l, w: w, op: BinOp.binAdd, offset: offset)
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadRaw(d, addr: at, width: RawWidth.width64))
	return d
end 'loadWordAt'

// ownedWord is the word of a String that owns its bytes, of a length and an ascii flag, 0 or 1.
function ownedWord(mutates l Lowerer, length Reg, ascii Reg) returns Reg
	let shift = konst(l, value: countWord(stringLengthShift))
	let shiftedLength = wrappingBin(l, op: BinOp.binShl, a: length, b: shift, kind: IrKind.kindScalar)
	let one = konst(l, value: 1 as Word)
	let flag = wrappingBin(l, op: BinOp.binShl, a: ascii, b: one, kind: IrKind.kindScalar)
	let flags = shifted(l, w: flag, op: BinOp.binAdd, offset: stringOwnedBit)
	return wrappingBin(l, op: BinOp.binOr, a: shiftedLength, b: flags, kind: IrKind.kindScalar)
end 'ownedWord'

// stringWord is the word of a String.
function stringWord(mutates l Lowerer, text Reg) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newStrWord(d, src: text))
	return d
end 'stringWord'

// stringBytes is the address of the first byte of a String: its first word, or, where it holds its bytes in its words, a
// frame box of its own that it writes them to, which lives as long as the frame.
function stringBytes(mutates l Lowerer, text Reg) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	let box = l.b.f.newFrameBox()
	emit(l, i: newStrBytes(d, src: text, box: box))
	return d
end 'stringBytes'

// stringLength is the length of a String, which its word holds one way or another.
function stringLength(mutates l Lowerer, text Reg) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLength(d, src: text, of: Collection.collectionString))
	return d
end 'stringLength'

function lowerRawStringBytes(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return stringBytes(l, text: args[0])
end 'lowerRawStringBytes'

function lowerRawStringLength(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return stringLength(l, text: args[0])
end 'lowerRawStringLength'

function lowerRawStringFirstWord(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newStrPtr(d, src: args[0]))
	return d
end 'lowerRawStringFirstWord'

function lowerRawStringSecondWord(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return stringWord(l, text: args[0])
end 'lowerRawStringSecondWord'

function lowerRawStringOfWords(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindString)
	emit(l, i: newStrMake(d, bytes: args[0], word: args[1]))
	return d
end 'lowerRawStringOfWords'

// stringAt is the String held at an address, which stays there.
function stringAt(mutates l Lowerer, at Reg) returns Reg
	let first = loadWordAt(l, w: at, offset: stringBytesOffset)
	let word = loadWordAt(l, w: at, offset: stringWordOffset)
	let d = newReg(l, kind: IrKind.kindString)
	emit(l, i: newStrMake(d, bytes: first, word: word))
	return d
end 'stringAt'

function lowerRawStringAscii(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let word = stringWord(l, text: args[0])
	let one = konst(l, value: 1 as Word)
	let down = wrappingBin(l, op: BinOp.binShr, a: word, b: one, kind: IrKind.kindScalar)
	return wrappingBin(l, op: BinOp.binAnd, a: down, b: one, kind: IrKind.kindScalar)
end 'lowerRawStringAscii'

function lowerRawStringRoom(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return runtime(l, symbol: Rt.rtAlloc, kind: IrKind.kindScalar, args: argsOf1(args[0]))
end 'lowerRawStringRoom'

// lowerRawFreeStringRoom gives 0 as its value, as a store does.
function lowerRawFreeStringRoom(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	_ = runtime(l, symbol: Rt.rtFree, kind: IrKind.kindScalar, args: argsOf1(args[0]))
	return konst(l, value: 0 as Word)
end 'lowerRawFreeStringRoom'

// lowerRawStringOf is the string that owns the room, so the one the call gives is dropped like any other.
function lowerRawStringOf(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let word = ownedWord(l, length: args[1], ascii: args[2])
	let d = newReg(l, kind: IrKind.kindString)
	emit(l, i: newStrMake(d, bytes: args[0], word: word))
	return d
end 'lowerRawStringOf'

function lowerRawStringSize(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return konst(l, value: countWord(stringValueBytes))
end 'lowerRawStringSize'

// lowerRawStoreString gives 0 as its value, as a store does.
function lowerRawStoreString(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let word = ownedWord(l, length: args[3], ascii: args[4])
	let at = rawAddress(l, address: args[0], offset: args[1])
	let bytesAt = shifted(l, w: at, op: BinOp.binAdd, offset: stringBytesOffset)
	emit(l, i: newStoreRaw(bytesAt, src: args[2], width: RawWidth.width64))
	let wordAt = shifted(l, w: at, op: BinOp.binAdd, offset: stringWordOffset)
	emit(l, i: newStoreRaw(wordAt, src: word, width: RawWidth.width64))
	return konst(l, value: 0 as Word)
end 'lowerRawStoreString'

function lowerRawStringBytesAt(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	let text = stringAt(l, at: at)
	return stringBytes(l, text: text)
end 'lowerRawStringBytesAt'

function lowerRawStringLengthAt(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	let text = stringAt(l, at: at)
	return stringLength(l, text: text)
end 'lowerRawStringLengthAt'

function lowerRawHeapAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtHeap)
end 'lowerRawHeapAddress'

function lowerRawStdoutAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtStdout)
end 'lowerRawStdoutAddress'

function lowerRawStderrAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtStderr)
end 'lowerRawStderrAddress'

function lowerRawAtomicAdd(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newAtomicAdd(d, addr: at, src: args[2]))
	return d
end 'lowerRawAtomicAdd'

function lowerRawAtomicExchange(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let at = rawAddress(l, address: args[0], offset: args[1])
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newAtomicExchange(d, addr: at, src: args[2]))
	return d
end 'lowerRawAtomicExchange'

function lowerRawCompareExchange(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	var words = RegList.create(0)
	words.push(rawAddress(l, address: args[0], offset: args[1]))
	words.push(args[2])
	words.push(args[3])
	let d = newReg(l, kind: IrKind.kindScalar)
	let instr = l.b.compareExchange(d, args: words)
	emit(l, i: instr)
	return d
end 'lowerRawCompareExchange'

// lowerRawSpinPause gives 0 as its value, as a store does.
function lowerRawSpinPause(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	emit(l, i: newSpinPause())
	return konst(l, value: 0 as Word)
end 'lowerRawSpinPause'

function lowerRawThreadContext(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newThreadContext(d))
	return d
end 'lowerRawThreadContext'

function lowerRawCallCode(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	let instr = l.b.callCode(d, args: args)
	emit(l, i: instr)
	return d
end 'lowerRawCallCode'

// lowerRawCodeAddress is the address of the code of the function of this module that its operand, a string literal,
// names, which the checker made sure it declares.
function lowerRawCodeAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let fn = ast.functionNamed(p, ms: ms, module: p.modules[l.mi].id, name: plainText(l, p: p, e: c.ordered[0]))
	if fn == ast.noFunc 'missing'
		panic("lower: the code of a function that the module does not declare")
	end 'missing'
	let d = newReg(l, kind: IrKind.kindScalar)
	let instr = l.b.codeAddressInstr(d, fn: fn)
	emit(l, i: instr)
	return d
end 'lowerRawCodeAddress'

// lowerRawThreadStartAddress is the address of the code a thread the runtime makes starts at, which the entry stub's
// unit defines.
function lowerRawThreadStartAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtThreadStart)
end 'lowerRawThreadStartAddress'

// The addresses of the entry stub's code that green threads switch stacks and are stopped through, and of the table
// of preemptible code that the link writes.
function lowerRawStackSwitchAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtStackSwitch)
end 'lowerRawStackSwitchAddress'

function lowerRawGreenStartAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtGreenStart)
end 'lowerRawGreenStartAddress'

function lowerRawAsyncPreemptAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtAsyncPreempt)
end 'lowerRawAsyncPreemptAddress'

function lowerRawPreemptibleCodeAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtPreemptibleCode)
end 'lowerRawPreemptibleCodeAddress'

function lowerRawPreemptHandlerAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtPreemptHandler)
end 'lowerRawPreemptHandlerAddress'

function lowerRawSignalReturnAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtSigreturn)
end 'lowerRawSignalReturnAddress'

// lowerRawSyscall calls the kernel with the number and the words, all of them values.
function lowerRawSyscall(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	let instr = l.b.syscall(d, args: args)
	emit(l, i: instr)
	return d
end 'lowerRawSyscall'

// lowerRawProcessStartAddress is the address of the global where the entry of a Linux executable keeps the stack pointer
// the process started with.
function lowerRawProcessStartAddress(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return globalAddress(l, symbol: Rt.rtProcessStart)
end 'lowerRawProcessStartAddress'

// lowerRawCallImport calls the DLL function that its first operand, a string literal, names. The call evaluates its
// operands itself, since the name is read as text and is no value.
function lowerRawCallImport(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	var words = RegList.create(0)
	for i in 1 upto c.ordered.count() 'words'
		words.push(lowerConverted(l, p: p, ms: ms, e: c.ordered[i], target: c.info.paramSpecs[i].ty))
	end 'words'
	let d = newReg(l, kind: IrKind.kindScalar)
	let instr = l.b.callImport(d, name: plainText(l, p: p, e: c.ordered[0]), args: words)
	emit(l, i: instr)
	return d
end 'lowerRawCallImport'

function lowerRawCallHost(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	let instr = l.b.callHost(d, args: args)
	emit(l, i: instr)
	return d
end 'lowerRawCallHost'
