function lowerSubprocessResultRelease(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtSubprocessResultRelease, args: args)
