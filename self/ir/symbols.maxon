// funcSymbol is the name of a function in the IR text and in a report: the plain name of a free function, the instance
// of a generic one with its type arguments (and the modules of its conformances, as its link name has them), and a method
// with the type it belongs to.
export function funcSymbol(p ast.Project, tt ast.TypeTable, ft ast.FuncTable, fid ast.FuncID) returns String
	let name = ft.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].name.clone()
	let owner = ft.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].ownerTy
	if ft.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].extendedIface != ast.noType 'ofInterface'
		return "{ast.interfaceExtensionSymbol(p, tt: tt, ft: ft, fid: fid)}{ast.witnessSuffix(p, tt: tt, ft: ft, fid: fid)}"
	end 'ofInterface'
	if owner == ast.noType 'free'
		let args = ft.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].typeArgs.count()
		if args == 0 'plain'
			return name
		end 'plain'
		var b = ByteArray.create(0)
		b.append("{name}[".toByteArray())
		for i in 0 upto args 'each'
			if i > 0 'sep'
				b.append(", ".toByteArray())
			end 'sep'
			b.append(ast.typeName(tt, t: ft.slots[ast.funcSlot(fid)][ast.funcIndex(fid)].typeArgs[i]).toByteArray())
		end 'each'
		b.push(93 as Byte)
		b.append(ast.witnessSuffix(p, tt: tt, ft: ft, fid: fid).toByteArray())
		return String.from(b)
	end 'free'
	let ownerName = ast.typeName(tt, t: owner)
	if tt.lists[ast.typeList(tt, t: owner)][ast.typeIndex(tt, t: owner)].typeArgs.count() > 0 'instance'
		return "({ownerName}).{name}{ast.witnessSuffix(p, tt: tt, ft: ft, fid: fid)}"
	end 'instance'
	return "{ownerName}.{name}"
end 'funcSymbol'

// isNativeEntry is whether the backend implements a primitive's runtime entry.
export function isNativeEntry(symbol Rt) returns bool
	let unit = rtUnit(symbol)
	return unit == RtUnit.rtUnitArrays or unit == RtUnit.rtUnitBytes or unit == RtUnit.rtUnitOs or unit == RtUnit.rtUnitShared
end 'isNativeEntry'

// isBytesEntry is whether symbol lives in the bytes runtime unit.
export function isBytesEntry(symbol Rt) returns bool
	return rtUnit(symbol) == RtUnit.rtUnitBytes
end 'isBytesEntry'

// isOsEntry is whether symbol lives in the OS runtime unit.
export function isOsEntry(symbol Rt) returns bool
	return rtUnit(symbol) == RtUnit.rtUnitOs
end 'isOsEntry'
