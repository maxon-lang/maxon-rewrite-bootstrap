// funcSymbol is the name of a function in the IR text and in a report: the plain name of a free function, the instance
// of a generic one with its type arguments (and the modules of its conformances, as its link name has them), and a method
// with the type it belongs to.
export function funcSymbol(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, fid ast.FuncID) returns String
	let name = ast.funcEntry(ft, funcReads: funcReads, f: fid).name.clone()
	let owner = ast.funcEntry(ft, funcReads: funcReads, f: fid).ownerTy
	if ast.funcEntry(ft, funcReads: funcReads, f: fid).extendedIface != ast.noType 'ofInterface'
		return "{ast.interfaceExtensionSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid)}{ast.witnessSuffix(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid)}"
	end 'ofInterface'
	if owner == ast.noType 'free'
		let args = ast.funcEntry(ft, funcReads: funcReads, f: fid).typeArgs.count()
		if args == 0 'plain'
			return name
		end 'plain'
		var b = ByteArray.create(0)
		b.append("{name}[".toByteArray())
		for i in 0 upto args 'each'
			if i > 0 'sep'
				b.append(", ".toByteArray())
			end 'sep'
			b.append(ast.typeName(tt, reads: reads, t: ast.funcEntry(ft, funcReads: funcReads, f: fid).typeArgs[i]).toByteArray())
		end 'each'
		b.push(93 as Byte)
		b.append(ast.witnessSuffix(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid).toByteArray())
		return String.from(b)
	end 'free'
	let ownerName = ast.typeName(tt, reads: reads, t: owner)
	if ast.typeEntry(tt, reads: reads, t: owner).typeArgs.count() > 0 'instance'
		return "({ownerName}).{name}{ast.witnessSuffix(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: fid)}"
	end 'instance'
	return "{ownerName}.{name}"
end 'funcSymbol'

// isNativeEntry is whether the backend implements a primitive's runtime entry.
export function isNativeEntry(symbol Rt) returns bool
	let unit = rtUnit(symbol)
	return unit == RtUnit.rtUnitArrays or unit == RtUnit.rtUnitBytes or unit == RtUnit.rtUnitOs or unit == RtUnit.rtUnitShared
end 'isNativeEntry'

// isBytesEntry is whether symbol lives in the bytes runtime unit.
export function isBytesEntry(symbol Rt) returns bool
	return rtUnit(symbol) == RtUnit.rtUnitBytes
end 'isBytesEntry'

// isOsEntry is whether symbol lives in the OS runtime unit.
export function isOsEntry(symbol Rt) returns bool
	return rtUnit(symbol) == RtUnit.rtUnitOs
end 'isOsEntry'
