// begin starts the IR of a function, forgetting the one before it. bindParams and bindArgs give the type parameters their
// arguments, and bindWitnesses the conformances for their bounds; they are the function's own when it is an instance of a
// generic function, and the ones of the function around it for the body of a behaviour.
export function begin(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, fn ast.FuncID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, consumes name String)
	var paramCount = try (ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).params.count() + ast.leadingParams(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn))) as Count otherwise panic("ir: too many parameters")
	l.lentElements = ast.lentTupleElements(ms.types, reads: p.types, f: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn))
	if l.lentElements > 0 'lentTuple'
		paramCount = succ(paramCount)
	end 'lentTuple'
	l.resultWords = resultWords(ms.types, reads: p.types, f: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn))
	if l.resultWords > 0 'inPlace'
		paramCount = succ(paramCount)
	end 'inPlace'
	l.b.keepsSpans = p.keepsSpans
	l.b.start(fn, name: name, paramCount: paramCount)
	l.b.f.lendsResult = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).result == ast.ResultConv.resultBorrowed
	l.fn = fn
	l.origin = fn
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).genericOrigin != ast.noFunc 'instance'
		l.origin = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).genericOrigin
	end 'instance'
	l.fnModule = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).module
	let own = l.fnModule
	setModule(l, m: own)
	// The code that is no statement's, the parameters taken and the return at the end, is the declaration's.
	let declared = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.origin).nodeID
	positionAt(l, p: p, node: declared)
	l.bindParams = bindParams.clone()
	l.bindArgs = bindArgs.clone()
	l.bindWitnesses = bindWitnesses.clone()
	l.jumps = JumpFrameList.create(0)
	l.scopes = ScopeList.create(0)
	l.ownerSlots = OwnerSlotList.create(0)
	l.args = RegList.create(0)
	l.handlers = HandlerList.create(0)
	l.pending = PendingList.create(0)
	l.writeBacks = WriteBackList.create(0)
	l.slotWords = Array.create(0)
	l.slotAreas = Array.create(0)
	l.selfOwner = noSlot
	declareSlots(l, p: p, ms: ms)
	l.cur = l.b.newBlock()
end 'begin'

// functionLocals are the locals of the function whose body the lowerer is lowering, by handle.
function functionLocals(l Lowerer, p ast.Project, ms ast.ModuleState) returns ast.LocalIDList
	let node = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.origin).nodeID
	return match consumes p.typings[ast.modIndex(l.fnModule)].funcLocals.get(node as Count) 'hit'
		some(ids) gives ids
		none gives ast.LocalIDList.create(0)
	end 'hit'
end 'functionLocals'

// slotOf is the slot of a local that is not a parameter, which the checker numbered from 0.
function slotOf(e ast.LocalEntry) returns Count
	return try e.slot as Count otherwise panic("lower: a parameter has no slot")
end 'slotOf'

// declareSlots makes a slot for each local that is not a parameter, at the index the checker gave it.
function declareSlots(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState)
	let ids = functionLocals(l, p: p, ms: ms)
	var count = 0 as Count
	for i in 0 upto ids.count() 'count'
		if not localEntry(p, module: l.fnModule, id: ids[i]).isParam 'slotted'
			count = succ(count)
		end 'slotted'
	end 'count'
	var filled as Array with bool
	filled = Array.create(count)
	for i in 0 upto count 'make'
		_ = l.b.f.newSlot(IrKind.kindScalar)
	end 'make'
	for i in 0 upto ids.count() 'each'
		let loc = localEntry(p, module: l.fnModule, id: ids[i])
		if not loc.isParam 'slotted'
			if slotOf(loc) >= count or filled[slotOf(loc)] 'dense'
				panic("lower: local slots of {funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: l.fn)} are not dense")
			end 'dense'
			filled[slotOf(loc)] = true
			l.b.f.slots[slotOf(loc)] = kindOf(l, p: p, ms: ms, t: loc.ty)
			// A local that borrows (a binding of a part, a let of a lent result) holds the lender's address as it is.
			if not loc.projected and inPlace(l, p: p, ms: ms, t: loc.ty) 'inPlace'
				let words = placeWords(l, p: p, ms: ms, t: loc.ty)
				placeLocal(l, slot: slotOf(loc), words: words)
			end 'inPlace'
		end 'slotted'
	end 'each'
	if l.b.keepsSpans 'bindings'
		declareBindings(l, p: p, ms: ms, ids: ids)
	end 'bindings'
end 'declareSlots'

// declareBindings names, for the debug info, each local of the function that a parameter or a slot holds, with its type as
// the instance has it (bindings.maxon).
function declareBindings(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, ids ast.LocalIDList)
	for i in 0 upto ids.count() 'each'
		let loc = localEntry(p, module: l.fnModule, id: ids[i])
		if loc.name == "_" 'unnamed'
			continue 'each'
		end 'unnamed'
		let ty = applyType(l, p: p, ms: ms, t: loc.ty)
		if loc.isParam 'param'
			l.b.f.debug.push(DebugEntry.local(loc.name.clone(), ty: ty, param: loc.paramIndex, slot: noBinding))
		end 'param' else if loc.slot != ast.noSlot 'slotted'
			l.b.f.debug.push(DebugEntry.local(loc.name.clone(), ty: ty, param: noBinding, slot: slotOf(loc)))
		end 'slotted'
	end 'each'
end 'declareBindings'

// lowerBody lowers the statements of the function that begin started, and finishes it.
function lowerBody(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState) returns IrFunction
	pushScope(l, block: true)
	adoptParams(l, p: p, ms: ms)
	let bodyRef = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.origin).bodyRef
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.origin).isTest 'test'
		lowerTestBody(l, p: p, ms: ms, ref: bodyRef)
	end 'test' else 'function'
		lowerBlock(l, p: p, ms: ms, ref: bodyRef)
	end 'function'
	popScope(l, p: p)
	if not l.b.terminated(l.cur) 'open'
		let zero = konst(l, value: 0 as Word)
		l.b.terminate(l.cur, t: newRet(zero))
	end 'open'
	return l.b.finish()
end 'lowerBody'

// lowerTestBody lowers the body of a test, which handles every error it raises (the check gives it that handler): a failure
// that reaches it ends the executable of tests with a panic that names the test, since a test throws nothing to its caller.
function lowerTestBody(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, ref diag.U32)
	let failed = l.b.newBlock()
	let done = l.b.newBlock()
	_ = enterTry(l, target: failed, binding: noSlot)
	lowerBlock(l, p: p, ms: ms, ref: ref)
	leaveTry(l)
	goTo(l, target: done)
	l.cur = failed
	let message = strReg(l, value: "{funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: l.fn)} raised an error that it does not handle")
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanic, args: argsOf1(message), routine: ast.noFunc)
	seal(l, t: newTrap())
	l.cur = done
end 'lowerTestBody'

// adoptParams moves each consumes parameter into a slot, which owns it from there on. A parameter the body does not name
// (`_`) is dropped all the same, because the caller gave it away. The locals are the origin's, whose body an instance is;
// the types are the instance's.
function adoptParams(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState)
	let hasReceiver = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).hasReceiver
	if hasReceiver and ast.receiverLocal(p, ms: ms, f: l.origin) != ast.noLocal 'self'
		let selfLocal = localEntry(p, module: l.fnModule, id: ast.receiverLocal(p, ms: ms, f: l.origin))
		if ast.ownsValue(selfLocal.conv) and inPlace(l, p: p, ms: ms, t: selfLocal.ty) 'placed'
			let slot = adoptPlaced(l, p: p, ms: ms, index: selfLocal.paramIndex, t: selfLocal.ty)
			l.selfOwner = indexOf(slot)
		end 'placed' else if ast.ownsValue(selfLocal.conv) and owning(kindOf(l, p: p, ms: ms, t: selfLocal.ty)) 'owned'
			let slot = adopt(l, p: p, ms: ms, index: selfLocal.paramIndex, t: selfLocal.ty)
			l.selfOwner = indexOf(slot)
		end 'owned'
	end 'self'
	let first = ast.leadingParams(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn))
	for i in 0 upto ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).params.count() 'each'
		let ty = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).paramTypes[i]
		let consumed = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).params[i].conv == ast.Convention.convConsumes
		if consumed and inPlace(l, p: p, ms: ms, t: ty) 'placed'
			let slot = adoptPlaced(l, p: p, ms: ms, index: try first + i otherwise panic("ir: too many parameters"), t: ty)
			let local = ast.paramLocal(p, ms: ms, f: l.origin, index: i)
			if local != ast.noLocal 'named'
				l.ownerSlots.push(OwnerSlot.make(local, slot: slot))
			end 'named'
		end 'placed' else if consumed and owning(kindOf(l, p: p, ms: ms, t: ty)) 'consumed'
			let slot = adopt(l, p: p, ms: ms, index: try first + i otherwise panic("ir: too many parameters"), t: ty)
			let local = ast.paramLocal(p, ms: ms, f: l.origin, index: i)
			if local != ast.noLocal 'named'
				l.ownerSlots.push(OwnerSlot.make(local, slot: slot))
			end 'named'
		end 'consumed'
	end 'each'
end 'adoptParams'

function adopt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, index Count, t ast.TypeID) returns Count
	let kind = kindOf(l, p: p, ms: ms, t: t)
	let slot = l.b.f.newSlot(kind)
	let v = paramReg(l, index: index, kind: kind)
	emit(l, i: newStoreSlot(slot, src: v, borrow: false))
	ownLocal(l, p: p, ms: ms, slot: slot, t: t)
	return slot
end 'adopt'

// adoptPlaced takes the box of a consumes parameter held in place, the parameter at index, out to a frame area of its own,
// whose address a new slot holds, and drops the box: the caller boxes what a callee consumes (argValue).
function adoptPlaced(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, index Count, t ast.TypeID) returns Count
	let box = paramReg(l, index: index, kind: IrKind.kindManaged)
	let area = unboxed(l, p: p, ms: ms, v: box, t: t)
	let slot = l.b.f.newSlot(IrKind.kindScalar)
	emit(l, i: newStoreSlot(slot, src: area, borrow: true))
	return slot
end 'adoptPlaced'

// ownerOf is the slot that owns a consumes parameter, or noSlot for a local that no slot owns.
function ownerOf(l Lowerer, id ast.LocalID, isSelf bool) returns Index
	if isSelf 'self'
		return l.selfOwner
	end 'self'
	for i in 0 upto l.ownerSlots.count() 'each'
		if l.ownerSlots[i].local == id 'hit'
			return indexOf(l.ownerSlots[i].slot)
		end 'hit'
	end 'each'
	return noSlot
end 'ownerOf'

// ownedRead is the value of a slot that owns what it holds: a move out of it when the expression moves it out, and a
// borrow otherwise.
function ownedRead(mutates l Lowerer, p ast.Project, ms ast.ModuleState, slot Count, e ast.NodeID) returns Reg
	if movesOut(p, ms: ms, module: l.module, node: e) and owning(slotKind(l, slot: slot)) 'move'
		let d = newReg(l, kind: slotKind(l, slot: slot))
		emit(l, i: newMoveSlot(d, slot: slot))
		return d
	end 'move'
	return load(l, slot: slot)
end 'ownedRead'

function pushJumps(mutates l Lowerer, node ast.NodeID, brk BlockID, cont BlockID)
	l.jumps.push(JumpFrame.make(node, brk: brk, cont: cont, depth: l.scopes.count()))
end 'pushJumps'

function popJumps(mutates l Lowerer)
	try l.jumps.pop() otherwise ignore
end 'popJumps'

// jumpsOf is where a break or a continue of the loop or match goes.
function jumpsOf(l Lowerer, node ast.NodeID) returns JumpFrame
	var i = l.jumps.count()
	while i > 0 'back'
		i = pred(i)
		if l.jumps[i].node == node 'hit'
			return l.jumps[i].clone()
		end 'hit'
	end 'back'
	panic("lower: a break or a continue names a loop or a match that is not being lowered")
end 'jumpsOf'

// self is the receiver, borrowed: a consumes self lives in the slot that owns it.
// selfType is the type of the receiver of the function being lowered.
function selfType(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState) returns ast.TypeID
	return localEntry(p, module: l.fnModule, id: ast.receiverLocal(p, ms: ms, f: l.origin)).ty
end 'selfType'

// fieldAt is where the field at index of a box of the record owner, a type the body names, sits: the record a frozen value
// holds, for one read through it.
function fieldAt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, index Count) returns Count
	let applied = applyType(l, p: p, ms: ms, t: owner)
	let record = ast.contentType(ms.types, reads: p.types, t: applied)
	return recordFieldOffset(ms.types, reads: p.types, owner: record, index: index)
end 'fieldAt'

// fieldWords is how many words the field at index of the record owner, a type the body names, takes among the record's own
// words, where it is a record held in place that the record holds that way (inlineFieldWords), and 0 otherwise.
function fieldWords(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, index Count) returns Count
	let applied = applyType(l, p: p, ms: ms, t: owner)
	let record = ast.contentType(ms.types, reads: p.types, t: applied)
	return inlineFieldWords(ms.types, reads: p.types, owner: record, index: index)
end 'fieldWords'

// fieldPlace is the place of the field at index of the record owner, whose address is addr, as a call that takes it by
// address is given it: the field itself, or, where its words are the record's own, a place that holds their address
// (heldPlace), as every place of a value held in place does.
function fieldPlace(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, index Count, addr Reg) returns Reg
	if fieldWords(l, p: p, ms: ms, owner: owner, index: index) == 0 'held'
		return addr
	end 'held'
	return heldPlace(l, words: addr)
end 'fieldPlace'

function selfReg(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState) returns Reg
	if l.selfOwner != noSlot 'owned'
		return load(l, slot: slotIndex(l.selfOwner))
	end 'owned'
	let selfLocal = localEntry(p, module: l.fnModule, id: ast.receiverLocal(p, ms: ms, f: l.origin))
	return paramReg(l, index: selfLocal.paramIndex, kind: kindOf(l, p: p, ms: ms, t: selfLocal.ty))
end 'selfReg'

// lowerBlock lowers the live statements of a block, which owns the locals they declare.
function lowerBlock(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, ref diag.U32)
	lowerBlockOwning(l, p: p, ms: ms, ref: ref, owned: ast.noLocal)
end 'lowerBlock'

// lowerBlockOwning lowers a block that ends the local owned, which the code before it gave a value: the error that a
// handler names, when the error is a value of a union. A local that holds a number needs no drop.
function lowerBlockOwning(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, ref diag.U32, owned ast.LocalID)
	pushScope(l, block: true)
	if owned != ast.noLocal 'owned'
		let sym = localEntry(p, module: l.fnModule, id: owned)
		ownLocal(l, p: p, ms: ms, slot: slotOf(sym), t: sym.ty)
	end 'owned'
	let n = ast.liveCount(p.modules[l.mi].tree, ref: ref)
	for i in 0 upto n 'each'
		lowerStmt(l, p: p, ms: ms, s: p.modules[l.mi].tree.listAt(ref, index: i) as ast.NodeID)
	end 'each'
	popScope(l, p: p)
end 'lowerBlockOwning'

// lowerStmt lowers a statement, which owns the temporaries it makes: they are dropped when it ends, and every value it
// computes for something to take has been taken by then.
function lowerStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let mark = l.pending.count()
	let around = l.b.pos
	positionAt(l, p: p, node: s)
	pushScope(l, block: false)
	visitStmt(l, p: p, ms: ms, s: s)
	popScope(l, p: p)
	popPending(l, n: mark)
	l.b.pos = around
end 'lowerStmt'

// positionAt makes the source at node the span of the instructions emitted next, when the function keeps spans.
function positionAt(mutates l Lowerer, p ast.Project, node ast.NodeID)
	if l.b.keepsSpans and l.module >= 0 'kept'
		l.b.pos = spanOf(l.module, offset: p.modules[l.mi].tree.startOf(node))
	end 'kept'
end 'positionAt'

function visitStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let k = p.modules[l.mi].tree.kindOf(s)
	if k == ast.NodeKind.letStmt 'letStmt'
		visitLetStmt(l, p: p, ms: ms, s: s)
		return
	end 'letStmt'
	if k == ast.NodeKind.destructStmt or k == ast.NodeKind.tupleAssignStmt 'expansion'
		let steps = ast.expansionOf(p.typings[l.mi], node: s)
		for i in 0 upto steps.count() 'steps'
			lowerStmt(l, p: p, ms: ms, s: steps[i])
		end 'steps'
		return
	end 'expansion'
	if k == ast.NodeKind.discardStmt 'discardStmt'
		_ = lowerExpr(l, p: p, ms: ms, e: ast.discardStmtValue(p.modules[l.mi].tree, id: s))
		return
	end 'discardStmt'
	if k == ast.NodeKind.exprStmt 'exprStmt'
		_ = lowerExpr(l, p: p, ms: ms, e: ast.exprStmtE(p.modules[l.mi].tree, id: s))
		return
	end 'exprStmt'
	if k == ast.NodeKind.ifStmt 'ifStmt'
		visitIfStmt(l, p: p, ms: ms, s: s)
		return
	end 'ifStmt'
	if k == ast.NodeKind.ifTryStmt 'ifTryStmt'
		visitIfTryStmt(l, p: p, ms: ms, s: s)
		return
	end 'ifTryStmt'
	if k == ast.NodeKind.whileStmt 'whileStmt'
		visitWhileStmt(l, p: p, ms: ms, s: s)
		return
	end 'whileStmt'
	if k == ast.NodeKind.matchStmt 'matchStmt'
		_ = lowerMatch(l, p: p, ms: ms, core: ast.matchStmtMatch(p.modules[l.mi].tree, id: s), resultType: ast.noType)
		return
	end 'matchStmt'
	if k == ast.NodeKind.returnStmt 'returnStmt'
		visitReturnStmt(l, p: p, ms: ms, s: s)
		return
	end 'returnStmt'
	if k == ast.NodeKind.breakStmt 'breakStmt'
		visitBreakStmt(l, p: p, s: s)
		return
	end 'breakStmt'
	if k == ast.NodeKind.continueStmt 'continueStmt'
		visitContinueStmt(l, p: p, s: s)
		return
	end 'continueStmt'
	if k == ast.NodeKind.assignStmt 'assignStmt'
		visitAssignStmt(l, p: p, ms: ms, s: s)
		return
	end 'assignStmt'
	if k == ast.NodeKind.forStmt 'forStmt'
		visitForStmt(l, p: p, ms: ms, s: s)
		return
	end 'forStmt'
	if k == ast.NodeKind.tryStmt 'tryStmt'
		visitTryStmt(l, p: p, ms: ms, s: s)
		return
	end 'tryStmt'
	if k == ast.NodeKind.throwStmt 'throwStmt'
		visitThrowStmt(l, p: p, ms: ms, s: s)
		return
	end 'throwStmt'
	if k == ast.NodeKind.whenStmt 'whenStmt'
		visitWhenStmt(l, p: p, ms: ms, s: s)
		return
	end 'whenStmt'
	panic("lower: the node {s} of kind {k.name} is no statement")
end 'visitStmt'

// condition lowers a condition, dropping its temporaries before the branch: the value it gives is a scalar.
function condition(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	pushScope(l, block: false)
	let v = lowerExpr(l, p: p, ms: ms, e: e)
	popScope(l, p: p)
	return v
end 'condition'

function visitLetStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let sym = localEntry(p, module: l.fnModule, id: localOfNode(p, module: l.module, node: s))
	let init = ast.letStmtInit(p.modules[l.mi].tree, id: s)
	// A let that a destructuring of a lent tuple makes borrows what it is bound to, and owns nothing.
	if sym.projected 'lent'
		let v = lowerExpr(l, p: p, ms: ms, e: init)
		emit(l, i: newStoreSlot(slotOf(sym), src: v, borrow: owning(regKind(l, v: v))))
		return
	end 'lent'
	if init != 0 'init'
		let v = lowerExpr(l, p: p, ms: ms, e: init)
		emit(l, i: newStoreSlot(slotOf(sym), src: v, borrow: false))
	end 'init'
	ownLocal(l, p: p, ms: ms, slot: slotOf(sym), t: sym.ty)
end 'visitLetStmt'

function visitIfStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let thenBlock = l.b.newBlock()
	let join = l.b.newBlock()
	var els = join
	let hasElse = ast.ifStmtHasElse(p.modules[l.mi].tree, id: s)
	if hasElse 'else'
		els = l.b.newBlock()
	end 'else'
	let cond = condition(l, p: p, ms: ms, e: ast.ifStmtCond(p.modules[l.mi].tree, id: s))
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: thenBlock, ifFalse: els))
	l.cur = thenBlock
	lowerBlock(l, p: p, ms: ms, ref: ast.ifStmtThenRef(p.modules[l.mi].tree, id: s))
	goTo(l, target: join)
	if hasElse 'else2'
		l.cur = els
		lowerBlock(l, p: p, ms: ms, ref: ast.ifStmtElseRef(p.modules[l.mi].tree, id: s))
		goTo(l, target: join)
	end 'else2'
	l.cur = join
end 'visitIfStmt'

function visitWhileStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let top = l.b.newBlock()
	let body = l.b.newBlock()
	let join = l.b.newBlock()
	pushJumps(l, node: s, brk: join, cont: top)
	goTo(l, target: top)
	let cond = condition(l, p: p, ms: ms, e: ast.whileStmtCond(p.modules[l.mi].tree, id: s))
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: body, ifFalse: join))
	l.cur = body
	lowerBlock(l, p: p, ms: ms, ref: ast.whileStmtBodyRef(p.modules[l.mi].tree, id: s))
	goTo(l, target: top)
	popJumps(l)
	l.cur = join
end 'visitWhileStmt'

function visitReturnStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	var v = noReg
	let value = ast.returnStmtValue(p.modules[l.mi].tree, id: s)
	if value == 0 'none'
		v = konst(l, value: 0 as Word)
	end 'none' else if l.lentElements > 0 'lentTuple'
		v = lentTuple(l, p: p, ms: ms, value: value)
	end 'lentTuple' else 'some'
		v = lowerExpr(l, p: p, ms: ms, e: value)
		if l.b.f.lendsResult 'lent'
			let have = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: value))
			let declared = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).retTy
			let want = applyType(l, p: p, ms: ms, t: declared)
			v = contentsLent(l, p: p, ms: ms, e: value, v: v, have: have, want: want)
		end 'lent'
		if convertsAtReturn(p, module: l.module, node: s) 'converts'
			v = convertReturned(l, p: p, ms: ms, s: s, value: value, v: v)
		end 'converts'
		if l.resultWords > 0 'inPlace'
			returnPlaced(l, p: p, ms: ms, v: v)
			return
		end 'inPlace'
	end 'some'
	unwind(l, p: p, depth: 0 as Count)
	seal(l, t: newRet(v))
end 'visitReturnStmt'

// returnPlaced returns the value v of a function whose result is held in place (resultWords): its words go to the area
// the caller passed, which the function returns, or, where the caller passed 0, to a box of their own, which the caller
// owns: an async call's coroutine hands the box to its promise, since no frame of the caller's outlives it. The words are
// taken before the scopes end, whose drops may free the box they are read from.
function returnPlaced(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg)
	let area = paramReg(l, index: pred(l.b.f.paramCount), kind: IrKind.kindScalar)
	let given = nonZero(l, v: area)
	let copied = l.b.newBlock()
	let owned = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(given, ifTrue: copied, ifFalse: owned))
	l.cur = copied
	let words = l.resultWords
	copyWords(l, dst: area, src: v, words: words)
	unwind(l, p: p, depth: 0 as Count)
	l.b.terminate(l.cur, t: newRet(area))
	l.cur = owned
	let result = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).retTy
	let box = boxed(l, p: p, ms: ms, v: v, t: result)
	unwind(l, p: p, depth: 0 as Count)
	seal(l, t: newRet(box))
end 'returnPlaced'

// lentTuple writes the tuple that a function lends into the frame area its caller passed, a borrow of each element, and
// gives the area: the elements of a tuple written in the return, or the words of the tuple box it lends a place of. The
// elements of a written tuple are all read before any is stored, since a store ends every read the optimizer could
// otherwise share between them (motion.maxon), and no element reads the area.
function lentTuple(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, value ast.NodeID) returns Reg
	let area = paramReg(l, index: pred(l.b.f.paramCount), kind: IrKind.kindManaged)
	let declared = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).retTy
	let tuple = applyType(l, p: p, ms: ms, t: declared)
	if p.modules[l.mi].tree.kindOf(value) == ast.NodeKind.tupleExpr 'written'
		let lit = structLitInfoAt(p, module: l.module, node: value)
		var elements = RegList.create(0)
		for i in 0 upto lit.ordered.count() 'elements'
			elements.push(lowerExpr(l, p: p, ms: ms, e: lit.ordered[i]))
		end 'elements'
		for i in 0 upto elements.count() 'stores'
			let offset = recordFieldOffset(ms.types, reads: p.types, owner: tuple, index: i)
			emit(l, i: newStoreField(area, offset: offset, src: elements[i], borrow: owning(regKind(l, v: elements[i]))))
		end 'stores'
		return area
	end 'written'
	let box = lowerExpr(l, p: p, ms: ms, e: value)
	for i in 0 upto l.lentElements 'words'
		let element = ast.typeEntry(ms.types, reads: p.types, t: tuple).typeArgs[i]
		let word = newReg(l, kind: kindOf(l, p: p, ms: ms, t: element))
		let offset = recordFieldOffset(ms.types, reads: p.types, owner: tuple, index: i)
		emit(l, i: newLoadField(word, obj: box, offset: offset))
		emit(l, i: newStoreField(area, offset: offset, src: word, borrow: owning(regKind(l, v: word))))
	end 'words'
	return area
end 'lentTuple'

// convertReturned converts the value of a return to the declared type of the function as the cast 'value as T' does.
function convertReturned(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, value ast.NodeID, v Reg) returns Reg
	let fails = arithInfoAt(p, module: l.module, node: s).fails
	let target = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: l.fn).retTy
	if ast.typeKind(ms.types, reads: p.types, t: target) == ast.TypeKind.floatRange 'float'
		return floatConverted(l, p: p, ms: ms, v: v, e: value, target: target, fails: fails)
	end 'float'
	let fail = overflowTo(l, p: p, ms: ms, fails: fails)
	requireInt(p, ms: ms, t: target)
	fit(l, p: p, ms: ms, v: v, target: target, source: exprType(p, module: l.module, node: value), fails: fails, fail: fail)
	return v
end 'convertReturned'

function visitBreakStmt(mutates l Lowerer, p ast.Project, s ast.NodeID)
	let target = jumpsOf(l, node: jumpTargetOf(p, module: l.module, node: s))
	unwind(l, p: p, depth: target.depth)
	seal(l, t: newJump(target.brk))
end 'visitBreakStmt'

function visitContinueStmt(mutates l Lowerer, p ast.Project, s ast.NodeID)
	let target = jumpsOf(l, node: jumpTargetOf(p, module: l.module, node: s))
	unwind(l, p: p, depth: target.depth)
	seal(l, t: newJump(target.cont))
end 'visitContinueStmt'

// visitAssignStmt stores a value into a place, dropping the value the place held: the assignment is where that owner's
// value dies. The value is computed first, so it may read the old one.
function visitAssignStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let target = ast.assignStmtTarget(p.modules[l.mi].tree, id: s)
	let value = ast.assignStmtValue(p.modules[l.mi].tree, id: s)
	if appendsTo(l, p: p, ms: ms, target: target, value: value) 'append'
		lowerAppend(l, p: p, ms: ms, target: target, value: value)
		return
	end 'append'
	let k = p.modules[l.mi].tree.kindOf(target)
	if k == ast.NodeKind.nameExpr 'name'
		let name = nameInfoAt(p, module: l.module, node: target)
		if name.kind == ast.NameKind.nameLocal 'local'
			let v = lowerExpr(l, p: p, ms: ms, e: value)
			let loc = localEntry(p, module: l.fnModule, id: name.local)
			// A var bound to a borrowed result owns nothing: it is given another, which it borrows as its binding did.
			if loc.isView() 'view'
				emit(l, i: newStoreSlot(slotOf(loc), src: v, borrow: owning(regKind(l, v: v))))
				return
			end 'view'
			if isByRef(loc) and inPlace(l, p: p, ms: ms, t: loc.ty) 'placed'
				// The caller's place holds the address of the words, a frame area's or a box's, whichever it keeps them in.
				let addr = refAddress(l, p: p, ms: ms, loc: loc)
				let words = newReg(l, kind: IrKind.kindScalar)
				emit(l, i: newLoadAt(words, addr: addr))
				let n = placeWords(l, p: p, ms: ms, t: loc.ty)
				copyWords(l, dst: words, src: v, words: n)
			end 'placed' else if isByRef(loc) 'byRef'
				let addr = refAddress(l, p: p, ms: ms, loc: loc)
				dropAt(l, p: p, ms: ms, addr: addr, t: loc.ty)
				emit(l, i: newStoreAt(addr, src: v))
			end 'byRef' else 'slot'
				if owning(kindOf(l, p: p, ms: ms, t: loc.ty)) 'managed'
					let ty = dropType(l, p: p, ms: ms, t: loc.ty)
					emitDropSlot(l, slot: slotOf(loc), ty: ty)
				end 'managed'
				emit(l, i: newStoreSlot(slotOf(loc), src: v, borrow: false))
			end 'slot'
			return
		end 'local'
		if name.kind == ast.NameKind.nameSelfField 'field'
			let v = lowerExpr(l, p: p, ms: ms, e: value)
			let obj = selfReg(l, p: p, ms: ms)
			let owner = selfType(l, p: p, ms: ms)
			let offset = fieldAt(l, p: p, ms: ms, owner: owner, index: name.fieldIndex)
			let inline = fieldWords(l, p: p, ms: ms, owner: owner, index: name.fieldIndex)
			storeField(l, p: p, ms: ms, obj: obj, offset: offset, inline: inline, t: exprType(p, module: l.module, node: target), v: v)
			return
		end 'field'
	end 'name'
	if k == ast.NodeKind.memberExpr 'member'
		let member = memberInfoAt(p, module: l.module, node: target)
		if member.kind == ast.MemberKind.memberField 'field'
			let objExpr = ast.memberExprObj(p.modules[l.mi].tree, id: target)
			let obj = lowerExpr(l, p: p, ms: ms, e: objExpr)
			let v = lowerExpr(l, p: p, ms: ms, e: value)
			let owner = exprType(p, module: l.module, node: objExpr)
			let offset = fieldAt(l, p: p, ms: ms, owner: owner, index: member.fieldIndex)
			let inline = fieldWords(l, p: p, ms: ms, owner: owner, index: member.fieldIndex)
			storeField(l, p: p, ms: ms, obj: obj, offset: offset, inline: inline, t: exprType(p, module: l.module, node: target), v: v)
			return
		end 'field'
	end 'member'
	if k == ast.NodeKind.indexExpr 'index'
		assignElement(l, p: p, ms: ms, target: target, value: value)
		return
	end 'index'
	panic("lower: unhandled assignment target")
end 'visitAssignStmt'

function visitForStmt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	if not ast.forStmtIsRange(p.modules[l.mi].tree, id: s) and p.typings[l.mi].iterations.has(s as Count) 'cursor'
		visitForCursor(l, p: p, ms: ms, s: s)
		return
	end 'cursor'
	if not ast.forStmtIsRange(p.modules[l.mi].tree, id: s) 'forEach'
		let collection = builtinOf(l, p: p, ms: ms, collection: exprType(p, module: l.module, node: ast.forStmtFrom(p.modules[l.mi].tree, id: s)))
		let walked = ast.typeKind(ms.types, reads: p.types, t: collection)
		if walked == ast.TypeKind.primString 'clusters'
			visitForClusters(l, p: p, ms: ms, s: s)
			return
		end 'clusters'
		if walked == ast.TypeKind.builtinList 'list'
			visitForList(l, p: p, ms: ms, s: s)
			return
		end 'list'
		visitForEach(l, p: p, ms: ms, s: s)
		return
	end 'forEach'
	let sym = localEntry(p, module: l.fnModule, id: localOfNode(p, module: l.module, node: s))
	let slot = slotOf(sym)
	// A range of characters counts through the scalar values of its bounds, and its variable is the character of each.
	let characters = ast.forStmtIsCharacterRange(p.modules[l.mi].tree, id: s)
	var counter = slot
	if characters 'characters'
		counter = l.b.f.newSlot(IrKind.kindScalar)
	end 'characters'
	let limit = l.b.f.newSlot(IrKind.kindScalar)
	let unsigned = ast.isUnsignedInt(ms.types, reads: p.types, t: sym.ty)
	let body = l.b.newBlock()
	let cont = l.b.newBlock()
	let step = l.b.newBlock()
	let exit = l.b.newBlock()
	pushJumps(l, node: s, brk: exit, cont: cont)
	let inclusive = ast.forStmtInclusive(p.modules[l.mi].tree, id: s)
	let from = rangeBound(l, p: p, ms: ms, e: ast.forStmtFrom(p.modules[l.mi].tree, id: s), characters: characters)
	emit(l, i: newStoreSlot(counter, src: from, borrow: false))
	let upper = rangeBound(l, p: p, ms: ms, e: ast.forStmtTo(p.modules[l.mi].tree, id: s), characters: characters)
	emit(l, i: newStoreSlot(limit, src: upper, borrow: false))
	var pastOp = CmpOp.cmpGe
	if inclusive 'inclusive'
		pastOp = CmpOp.cmpGt
	end 'inclusive'
	let pastA = load(l, slot: counter)
	let pastB = load(l, slot: limit)
	let past = compare(l, op: pastOp, a: pastA, b: pastB, unsigned: unsigned)
	l.b.terminate(l.cur, t: newBranch(past, ifTrue: exit, ifFalse: body))
	l.cur = body
	if characters 'character'
		// Each pass owns its character, which its scope drops, as a cursor's element is.
		pushScope(l, block: true)
		let code = load(l, slot: counter)
		let character = runtime(l, symbol: Rt.rtCharFromCodepoint, kind: IrKind.kindString, args: argsOf1(code))
		emit(l, i: newStoreSlot(slot, src: character, borrow: false))
		ownLocal(l, p: p, ms: ms, slot: slot, t: sym.ty)
	end 'character'
	lowerBlock(l, p: p, ms: ms, ref: ast.forStmtBodyRef(p.modules[l.mi].tree, id: s))
	if characters 'passEnds'
		popScope(l, p: p)
	end 'passEnds'
	goTo(l, target: cont)
	if inclusive 'inclusiveStep'
		let a = load(l, slot: counter)
		let b = load(l, slot: limit)
		let done = compare(l, op: CmpOp.cmpEq, a: a, b: b, unsigned: unsigned)
		l.b.terminate(l.cur, t: newBranch(done, ifTrue: exit, ifFalse: step))
		l.cur = step
	end 'inclusiveStep' else 'exclusiveStep'
		goTo(l, target: step)
	end 'exclusiveStep'
	let cur = load(l, slot: counter)
	let next = rangeNext(l, cur: cur, characters: characters, unsigned: unsigned)
	emit(l, i: newStoreSlot(counter, src: next, borrow: false))
	if inclusive 'inclusiveJump'
		l.b.terminate(l.cur, t: newJump(body))
	end 'inclusiveJump' else 'exclusiveJump'
		let lim = load(l, slot: limit)
		let over = compare(l, op: CmpOp.cmpGe, a: next, b: lim, unsigned: unsigned)
		l.b.terminate(l.cur, t: newBranch(over, ifTrue: exit, ifFalse: body))
	end 'exclusiveJump'
	popJumps(l)
	l.cur = exit
end 'visitForStmt'

// rangeBound is the value a range for counts from or to: an integer, or the code point of a bound of a range of characters,
// which is a character literal.
function rangeBound(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, characters bool) returns Reg
	if characters 'character'
		let cp = ast.charLitCodepoint(p.modules[l.mi].tree, id: e)
		return konst(l, value: countWord(cp.unwrap()))
	end 'character'
	return lowerExpr(l, p: p, ms: ms, e: e)
end 'rangeBound'

// rangeNext is the value a range for counts to after cur: the next integer, or the next scalar value of a range of
// characters, which steps over the surrogates.
function rangeNext(mutates l Lowerer, cur Reg, characters bool, unsigned bool) returns Reg
	if characters 'scalar'
		return runtime(l, symbol: Rt.rtCharNextScalar, kind: IrKind.kindScalar, args: argsOf1(cur))
	end 'scalar'
	let next = newReg(l, kind: IrKind.kindScalar)
	let one = konst(l, value: 1 as Word)
	emit(l, i: newBin(next, op: BinOp.binAdd, left: cur, right: one, unsigned: unsigned, fail: noBlock))
	return next
end 'rangeNext'

// visitForEach lowers a for over an array to a loop over its indexes. The array is read once, and the ownership pass keeps
// the body from changing it. Each element is lent to the variable, as a subscript lends it, and a loop over `enumerated()`
// also gives the index to its variable.
function visitForEach(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let source = ast.forStmtFrom(p.modules[l.mi].tree, id: s)
	let box = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: s), t: exprType(p, module: l.module, node: source))
	let sym = localEntry(p, module: l.fnModule, id: localOfNode(p, module: l.module, node: s))
	let held = l.b.f.newSlot(IrKind.kindManaged)
	let index = l.b.f.newSlot(IrKind.kindScalar)
	let top = l.b.newBlock()
	let body = l.b.newBlock()
	let cont = l.b.newBlock()
	let exit = l.b.newBlock()
	let coll = lowerRead(l, p: p, ms: ms, e: source)
	emit(l, i: newStoreSlot(held, src: coll, borrow: true))
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(index, src: zero, borrow: false))
	goTo(l, target: top)
	let whole = load(l, slot: held)
	let n = arrayLength(l, p: p, ms: ms, box: box, arr: whole)
	let at = load(l, slot: index)
	let below = compare(l, op: CmpOp.cmpLt, a: at, b: n, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(below, ifTrue: body, ifFalse: exit))
	l.cur = body
	let arr = load(l, slot: held)
	let i = load(l, slot: index)
	let elem = arrayLoad(l, p: p, ms: ms, box: box, arr: arr, index: i)
	let lent = owning(regKind(l, v: elem))
	emit(l, i: newStoreSlot(slotOf(sym), src: elem, borrow: lent))
	let indexLocal = indexLocalOf(p, module: l.module, node: s)
	if indexLocal != ast.noLocal 'enumerated'
		let position = load(l, slot: index)
		emit(l, i: newStoreSlot(slotOf(localEntry(p, module: l.fnModule, id: indexLocal)), src: position, borrow: false))
	end 'enumerated'
	pushJumps(l, node: s, brk: exit, cont: cont)
	let element = applyType(l, p: p, ms: ms, t: arrayElem(p, ms: ms, box: box))
	let walksSlots = ast.isPromiseType(ms.types, reads: p.types, t: element)
	if walksSlots 'slots'
		l.slotLoops.push(SlotLoop.make(localOfNode(p, module: l.module, node: s), held: held, index: index, box: box.clone()))
	end 'slots'
	lowerBlock(l, p: p, ms: ms, ref: ast.forStmtBodyRef(p.modules[l.mi].tree, id: s))
	if walksSlots 'slotsEnd'
		_ = try l.slotLoops.pop() otherwise panic("lower: a for over slots ended that was never begun")
	end 'slotsEnd'
	goTo(l, target: cont)
	popJumps(l)
	let next = newReg(l, kind: IrKind.kindScalar)
	let cur = load(l, slot: index)
	let one = konst(l, value: 1 as Word)
	emit(l, i: newBin(next, op: BinOp.binAdd, left: cur, right: one, unsigned: true, fail: noBlock))
	emit(l, i: newStoreSlot(index, src: next, borrow: false))
	goTo(l, target: top)
	l.cur = exit
end 'visitForEach'

// visitForClusters lowers a for over the grapheme clusters of a String to a loop over byte positions. The String is read
// once, and the ownership pass keeps the body from changing it. Each cluster is lent to the variable as a view of the
// String's bytes, so a pass allocates nothing. Where the String's ASCII bit says that every cluster is one byte, read once
// before the loop, a cluster ends at the next byte; elsewhere the runtime finds where it ends, as count() does.
function visitForClusters(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let source = ast.forStmtFrom(p.modules[l.mi].tree, id: s)
	let sym = localEntry(p, module: l.fnModule, id: localOfNode(p, module: l.module, node: s))
	let held = l.b.f.newSlot(IrKind.kindString)
	let position = l.b.f.newSlot(IrKind.kindScalar)
	let after = l.b.f.newSlot(IrKind.kindScalar)
	let simple = l.b.f.newSlot(IrKind.kindScalar)
	let top = l.b.newBlock()
	let body = l.b.newBlock()
	let byByte = l.b.newBlock()
	let byCluster = l.b.newBlock()
	let lend = l.b.newBlock()
	let cont = l.b.newBlock()
	let exit = l.b.newBlock()
	let text = lowerRead(l, p: p, ms: ms, e: source)
	emit(l, i: newStoreSlot(held, src: text, borrow: true))
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(position, src: zero, borrow: false))
	let bit = runtime(l, symbol: Rt.rtStrAscii, kind: IrKind.kindScalar, args: argsOf1(text))
	let isAscii = nonZero(l, v: bit)
	emit(l, i: newStoreSlot(simple, src: isAscii, borrow: false))
	startCount(l, p: p, s: s)
	goTo(l, target: top)
	let whole = load(l, slot: held)
	let size = runtime(l, symbol: Rt.rtStrLen, kind: IrKind.kindScalar, args: argsOf1(whole))
	let at = load(l, slot: position)
	let below = compare(l, op: CmpOp.cmpLt, a: at, b: size, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(below, ifTrue: body, ifFalse: exit))
	l.cur = body
	let isSimple = load(l, slot: simple)
	l.b.terminate(l.cur, t: newBranch(isSimple, ifTrue: byByte, ifFalse: byCluster))
	l.cur = byByte
	let from = load(l, slot: position)
	let one = konst(l, value: 1 as Word)
	let nextByte = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(nextByte, op: BinOp.binAdd, left: from, right: one, unsigned: true, fail: noBlock))
	emit(l, i: newStoreSlot(after, src: nextByte, borrow: false))
	goTo(l, target: lend)
	l.cur = byCluster
	let all = load(l, slot: held)
	let start = load(l, slot: position)
	let count = konst(l, value: 1 as Word)
	let clusterEnd = runtime(l, symbol: Rt.rtStrGraphemeBytePos, kind: IrKind.kindScalar, args: argsOf3(all, b: start, c: count))
	emit(l, i: newStoreSlot(after, src: clusterEnd, borrow: false))
	goTo(l, target: lend)
	l.cur = lend
	let lending = load(l, slot: held)
	let first = load(l, slot: position)
	let last = load(l, slot: after)
	let cluster = stringView(l, text: lending, from: first, until: last, checked: false)
	emit(l, i: newStoreSlot(slotOf(sym), src: cluster, borrow: true))
	pushJumps(l, node: s, brk: exit, cont: cont)
	lowerBlock(l, p: p, ms: ms, ref: ast.forStmtBodyRef(p.modules[l.mi].tree, id: s))
	goTo(l, target: cont)
	popJumps(l)
	countPass(l, p: p, s: s)
	let next = load(l, slot: after)
	emit(l, i: newStoreSlot(position, src: next, borrow: false))
	goTo(l, target: top)
	l.cur = exit
end 'visitForClusters'

// startCount and countPass keep the index of a `for (i, x) in xs.enumerated()` over a collection whose loop walks no
// indexes, a String's, a List's or a cursor's: its variable is 0 before the first pass and counts each pass that ends.
function startCount(mutates l Lowerer, p ast.Project, s ast.NodeID)
	let index = indexLocalOf(p, module: l.module, node: s)
	if index == ast.noLocal 'none'
		return
	end 'none'
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(slotOf(localEntry(p, module: l.fnModule, id: index)), src: zero, borrow: false))
end 'startCount'

function countPass(mutates l Lowerer, p ast.Project, s ast.NodeID)
	let index = indexLocalOf(p, module: l.module, node: s)
	if index == ast.noLocal 'none'
		return
	end 'none'
	let slot = slotOf(localEntry(p, module: l.fnModule, id: index))
	let passed = load(l, slot: slot)
	let one = konst(l, value: 1 as Word)
	let next = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(next, op: BinOp.binAdd, left: passed, right: one, unsigned: true, fail: noBlock))
	emit(l, i: newStoreSlot(slot, src: next, borrow: false))
end 'countPass'

// visitForList lowers a for over a List to a walk of its slot keys, from the first to the one with no next. The list is read
// once, and the ownership pass keeps the body from changing it. Each element is lent to the variable, as a subscript lends
// it.
function visitForList(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let source = ast.forStmtFrom(p.modules[l.mi].tree, id: s)
	let site = siteOf(l, p: p, node: s)
	let sym = localEntry(p, module: l.fnModule, id: localOfNode(p, module: l.module, node: s))
	let held = l.b.f.newSlot(IrKind.kindManaged)
	let handle = l.b.f.newSlot(IrKind.kindScalar)
	let top = l.b.newBlock()
	let body = l.b.newBlock()
	let cont = l.b.newBlock()
	let exit = l.b.newBlock()
	let list = lowerRead(l, p: p, ms: ms, e: source)
	emit(l, i: newStoreSlot(held, src: list, borrow: true))
	let first = entry(l, p: p, site: site, symbol: Rt.rtListFirst, kind: IrKind.kindScalar, args: argsOf1(list))
	emit(l, i: newStoreSlot(handle, src: first, borrow: false))
	startCount(l, p: p, s: s)
	goTo(l, target: top)
	let at = load(l, slot: handle)
	let more = nonZero(l, v: at)
	l.b.terminate(l.cur, t: newBranch(more, ifTrue: body, ifFalse: exit))
	l.cur = body
	let whole = load(l, slot: held)
	let current = load(l, slot: handle)
	let addr = entry(l, p: p, site: site, symbol: Rt.rtListElem, kind: IrKind.kindScalar, args: argsOf2(whole, b: current))
	let elem = newReg(l, kind: kindOf(l, p: p, ms: ms, t: sym.ty))
	emit(l, i: newLoadAt(elem, addr: addr))
	emit(l, i: newStoreSlot(slotOf(sym), src: elem, borrow: owning(regKind(l, v: elem))))
	pushJumps(l, node: s, brk: exit, cont: cont)
	lowerBlock(l, p: p, ms: ms, ref: ast.forStmtBodyRef(p.modules[l.mi].tree, id: s))
	goTo(l, target: cont)
	popJumps(l)
	countPass(l, p: p, s: s)
	let walked = load(l, slot: held)
	let passed = load(l, slot: handle)
	let next = entry(l, p: p, site: site, symbol: Rt.rtListNext, kind: IrKind.kindScalar, args: argsOf2(walked, b: passed))
	emit(l, i: newStoreSlot(handle, src: next, borrow: false))
	goTo(l, target: top)
	l.cur = exit
end 'visitForList'

// visitForCursor lowers a for over a type with the iteration protocol. The cursor is made once, by the collection's
// createIterator(), and owned by the statement, or is the collection itself, borrowed. Each pass reads the element with
// current() into the variable, which owns it until the pass ends, and advance() moves the cursor on. A throw of either
// protocol call that throws ends the loop: an empty collection has no cursor, and the last element has no next one.
function visitForCursor(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID)
	let info = iterationInfoAt(p, module: l.module, node: s)
	let source = ast.forStmtFrom(p.modules[l.mi].tree, id: s)
	let sym = localEntry(p, module: l.fnModule, id: localOfNode(p, module: l.module, node: s))
	let placed = info.hasFactory and inPlace(l, p: p, ms: ms, t: info.cursorTy)
	let cursor = l.b.f.newSlot(IrKind.kindScalar if placed else IrKind.kindManaged)
	let body = l.b.newBlock()
	let cont = l.b.newBlock()
	let exit = l.b.newBlock()
	let collection = lowerRead(l, p: p, ms: ms, e: source)
	if placed 'placed'
		// A cursor held in place lives in the slot's frame area, which drops nothing.
		let words = placeWords(l, p: p, ms: ms, t: info.cursorTy)
		placeLocal(l, slot: cursor, words: words)
		let fresh = newReg(l, kind: IrKind.kindScalar)
		let made = protocolCall(l, p: p, ms: ms, s: s, info: info.factory, recv: collection, dst: fresh, resultTy: info.cursorTy, exit: exit)
		emit(l, i: newStoreSlot(cursor, src: made, borrow: false))
	end 'placed' else if info.hasFactory 'factory'
		let fresh = newReg(l, kind: IrKind.kindManaged)
		let made = protocolCall(l, p: p, ms: ms, s: s, info: info.factory, recv: collection, dst: fresh, resultTy: info.cursorTy, exit: exit)
		emit(l, i: newStoreSlot(cursor, src: made, borrow: false))
		let top = pred(l.scopes.count())
		let ty = dropType(l, p: p, ms: ms, t: info.cursorTy)
		l.scopes[top].drops.push(PendingDrop.ofSlot(cursor, ty: ty))
	end 'factory' else 'itself'
		emit(l, i: newStoreSlot(cursor, src: collection, borrow: true))
	end 'itself'
	startCount(l, p: p, s: s)
	goTo(l, target: body)
	pushJumps(l, node: s, brk: exit, cont: cont)
	pushScope(l, block: true)
	let reading = load(l, slot: cursor)
	let slotValue = newReg(l, kind: kindOf(l, p: p, ms: ms, t: sym.ty))
	let elem = protocolCall(l, p: p, ms: ms, s: s, info: info.current, recv: reading, dst: slotValue, resultTy: sym.ty, exit: exit)
	// An element that current() lends stays the cursor's, which outlives the pass.
	let lent = info.current.result == ast.ResultConv.resultBorrowed
	emit(l, i: newStoreSlot(slotOf(sym), src: elem, borrow: lent))
	if not lent 'owned'
		ownLocal(l, p: p, ms: ms, slot: slotOf(sym), t: sym.ty)
	end 'owned'
	lowerBlock(l, p: p, ms: ms, ref: ast.forStmtBodyRef(p.modules[l.mi].tree, id: s))
	popScope(l, p: p)
	goTo(l, target: cont)
	popJumps(l)
	countPass(l, p: p, s: s)
	let moving = load(l, slot: cursor)
	_ = protocolCall(l, p: p, ms: ms, s: s, info: info.advance, recv: moving, dst: noReg, resultTy: ast.noType, exit: exit)
	goTo(l, target: body)
	l.cur = exit
end 'visitForCursor'

// protocolCall calls a method of the iteration protocol on recv and gives the register that has its result: dst, or the
// register of an operation that a built-in iterator's method lowers to in place. One that throws goes to exit when it
// fails: the error is IterationError, which carries nothing to drop. resultTy is the type of the value the method gives.
function protocolCall(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, s ast.NodeID, info ast.CallInfo, recv Reg, dst Reg, resultTy ast.TypeID, exit BlockID) returns Reg
	var op = ast.Intrinsic.intrNone
	if info.kind != ast.CallKind.callBound 'method'
		op = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).intrinsic
	end 'method'
	if op != ast.Intrinsic.intrNone 'intrinsic'
		return lowerViewMethod(l, p: p, ms: ms, op: op, site: siteOf(l, p: p, node: s), t: resultTy, recv: recv, exit: exit)
	end 'intrinsic'
	let iface = dispatchedInterface(p, ms: ms, info: info, bindParams: l.bindParams, bindArgs: l.bindArgs)
	let dispatched = iface != ast.noType
	var target = ast.noFunc
	var fails = false
	if dispatched 'witness'
		fails = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.method).errTy != ast.noType
	end 'witness' else 'direct'
		target = callee(l, p: p, ms: ms, node: s, info: info, receiver: 0 as ast.NodeID)
		fails = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).errTy != ast.noType
	end 'direct'
	var err = noReg
	if fails 'fails'
		err = newReg(l, kind: IrKind.kindScalar)
	end 'fails'
	if dispatched 'table'
		// An interface value walks through the table it carries: each call is an indirect call of the slot of the requirement.
		let lends = info.result == ast.ResultConv.resultBorrowed
		let given = applyType(l, p: p, ms: ms, t: resultTy)
		let sig = FloatSignature.make(0 as FloatMask, result: not lends and ast.isFloatType(ms.types, reads: p.types, t: given))
		let slot = ast.requirementSlot(ms.types, reads: p.types, iface: iface, sig: info.method)
		var rest = RegList.create(0)
		if not lends and heldInPlace(ms.types, reads: p.types, t: given) 'inPlace'
			rest.push(newArea(l, words: inPlaceWords(ms.types, reads: p.types, t: given)))
		end 'inPlace'
		let call = l.b.callWitness(dst, conv: receiverConv(info.selfConv), slot: slot, recv: recv, args: rest, err: err, sig: sig)
		emit(l, i: call)
	end 'table' else if not fails 'plain'
		emitCall(l, p: p, ms: ms, dst: dst, target: target, args: argsOf1(recv))
	end 'plain' else 'throwing'
		emitThrowingCall(l, p: p, ms: ms, dst: dst, target: target, args: argsOf1(recv), err: err)
	end 'throwing'
	if not fails 'done'
		return dst
	end 'done'
	let ok = l.b.newBlock()
	let zero = konst(l, value: 0 as Word)
	let failed = compare(l, op: CmpOp.cmpNe, a: err, b: zero, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(failed, ifTrue: exit, ifFalse: ok))
	l.cur = ok
	return dst
end 'protocolCall'

// lowerFunction is the IR of a function, or of an instance of a generic one. instances are the ones the function's module
// needs, which every generic call in the body must be one of.
export function lowerFunction(p ast.Project, mutates ms ast.ModuleState, fn ast.FuncID, mutates instances InstanceSet) returns IrFunction
	var l = Lowerer.new(exchange(instances, value: InstanceSet.new()))
	var bindParams = ast.TypeIDList.create(0)
	var bindArgs = ast.TypeIDList.create(0)
	let origin = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).genericOrigin
	if origin != ast.noFunc 'instance'
		bindParams = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).generics)
		bindArgs = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).typeArgs)
	end 'instance'
	begin(l, p: p, ms: ms, fn: fn, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).witnesses.clone(), name: "")
	var f = lowerBody(l, p: p, ms: ms)
	f.takeSignature(funcSignature(p, ms: ms, fid: fn))
	instances = exchange(l.instances, value: InstanceSet.new())
	return f
end 'lowerFunction'

// lowerModule finds the instances of generic functions that a module needs, and lowers the module's functions that are
// not generic, in source order, and then those instances, in the order they were found. functions are the module's
// functions and methods, and callers the ones among them that call a generic or go through a bound, as the check pass
// recorded them.
export function lowerModule(p ast.Project, mutates ms ast.ModuleState, functions ast.FuncIDList, callers ast.FuncIDList, mutates errs diag.ErrorList) returns IrFunctionList
	var lowered = IrFunctionList.create(0)
	var instances = findInstances(p, ms: ms, callers: callers, errs: errs)
	if errs.count() > 0 'unfinite'
		return lowered
	end 'unfinite'
	for i in 0 upto functions.count() 'functions'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: functions[i]).generics.count() == 0 'plain'
			lowered.push(lowerFunction(p, ms: ms, fn: functions[i], instances: instances))
		end 'plain'
	end 'functions'
	let found = instances.list.clone()
	for i in 0 upto found.count() 'instances'
		lowered.push(lowerFunction(p, ms: ms, fn: found[i], instances: instances))
	end 'instances'
	return lowered
end 'lowerModule'

typealias PlaceMap = table.IntMap with Count

typealias SeenMap = table.IntMap with bool

// lowerReached is lowerModule for only what the program reaches of the module: of its functions that are not generic, those
// that demanded names and those that one it lowered calls, directly or through others, in source order, then the instances
// that those need, in the order they were found. Every function of another module that one of them names, which that module's
// lower is given in turn, is added to calls once.
export function lowerReached(p ast.Project, mutates ms ast.ModuleState, functions ast.FuncIDList, callers ast.FuncIDList, demanded ast.FuncIDList, mutates calls ast.FuncIDList, mutates errs diag.ErrorList) returns IrFunctionList
	var reach = Reach.new(functions)
	var calling = SeenMap.new()
	for i in 0 upto callers.count() 'callers'
		calling.insert(callers[i] as Count, value: true)
	end 'callers'
	for i in 0 upto demanded.count() 'demanded'
		reach.note(p, ms: ms, fn: demanded[i], calls: calls)
	end 'demanded'
	var instances = InstanceSet.new()
	var plain = IrFunctionList.create(0)
	var made = IrFunctionList.create(0)
	while reach.pending.count() > 0 or made.count() < instances.list.count() 'reach'
		if reach.pending.count() > 0 'plain'
			let fn = functions[try reach.pending.pop() otherwise panic("ir: the pending functions ran out")]
			if calling.has(fn as Count) and not addInstancesOf(p, ms: ms, caller: fn, found: instances, errs: errs) 'deep'
				return IrFunctionList.create(0)
			end 'deep'
			let f = lowerFunction(p, ms: ms, fn: fn, instances: instances)
			reach.noteCalls(p, ms: ms, f: f, calls: calls)
			plain.push(f)
		end 'plain' else 'instance'
			let instance = instances.list[made.count()]
			let f = lowerFunction(p, ms: ms, fn: instance, instances: instances)
			reach.noteCalls(p, ms: ms, f: f, calls: calls)
			made.push(f)
		end 'instance'
	end 'reach'
	var lowered = inSourceOrder(plain, place: reach.place)
	lowered.append(made)
	return lowered
end 'lowerReached'

// inSourceOrder is fns, functions of a module that are not generic, in the order of their places among its functions.
function inSourceOrder(consumes fns IrFunctionList, place PlaceMap) returns IrFunctionList
	var held = fns
	var at = PlaceMap.new()
	for i in 0 upto held.count() 'places'
		at.insert(place.expect(held[i].decl as Count, what: "the place of a lowered function"), value: i)
	end 'places'
	var ordered = IrFunctionList.create(0)
	var p = 0 as Count
	while ordered.count() < held.count() 'order'
		var slot as Count
		if at.find(p, slot: slot) 'lowered'
			let i = at.valueAt(slot)
			let decl = held[i].decl
			ordered.push(exchange(held[i], value: IrFunction.new(decl, name: "", paramCount: 0)))
		end 'lowered'
		p = succ(p)
	end 'order'
	return ordered
end 'inSourceOrder'

// Reach is what lowerReached has reached of a module's functions: the place of each that is not generic among them, whether
// it was queued, and those queued and not yet lowered; and the functions of other modules noted in calls.
type Reach
	var place as PlaceMap
	var queued as SeenMap
	var pending as Array with Count
	var outside as SeenMap

	static function new(functions ast.FuncIDList) returns Reach
		var place = PlaceMap.new()
		for i in 0 upto functions.count() 'places'
			place.insert(functions[i] as Count, value: i)
		end 'places'
		return Reach{place: place, queued: SeenMap.new(), pending: Array.create(0), outside: SeenMap.new()}
	end 'new'

	// note queues fn where it is a function of the module that is not generic and not queued yet, adds it to calls where it
	// is another module's, and leaves out an instance, which the module makes itself when a function it lowers needs it.
	function note(mutates self, p ast.Project, ms ast.ModuleState, fn ast.FuncID, mutates calls ast.FuncIDList)
		let key = fn as Count
		var slot as Count
		if place.find(key, slot: slot) 'own'
			if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).generics.count() == 0 and not queued.has(key) 'new'
				queued.insert(key, value: true)
				pending.push(place.valueAt(slot))
			end 'new'
			return
		end 'own'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).genericOrigin != ast.noFunc or outside.has(key) 'kept'
			return
		end 'kept'
		outside.insert(key, value: true)
		calls.push(fn)
	end 'note'

	// noteCalls notes every function that f names: what it calls or takes the address of, the methods of the tables of the
	// interface values it makes, and the same of the bodies of its behaviours and closures.
	function noteCalls(mutates self, p ast.Project, ms ast.ModuleState, f IrFunction, mutates calls ast.FuncIDList)
		for i in 0 upto f.callees.count() 'callees'
			note(p, ms: ms, fn: f.callees[i], calls: calls)
		end 'callees'
		for i in 0 upto f.tables.count() 'tables'
			for j in 0 upto f.tables[i].methods.count() 'methods'
				note(p, ms: ms, fn: f.tables[i].methods[j], calls: calls)
			end 'methods'
		end 'tables'
		for i in 0 upto f.bodies.count() 'bodies'
			noteCalls(p, ms: ms, f: f.bodies[i], calls: calls)
		end 'bodies'
	end 'noteCalls'
end 'Reach'

// callsOutside are the functions of other modules that fns, a module's functions, name (Reach.noteCalls), each once.
export function callsOutside(p ast.Project, ms ast.ModuleState, fns IrFunctionList) returns ast.FuncIDList
	var decls = ast.FuncIDList.create(0)
	for i in 0 upto fns.count() 'decls'
		decls.push(fns[i].decl)
	end 'decls'
	var reach = Reach.new(decls)
	var calls = ast.FuncIDList.create(0)
	for i in 0 upto fns.count() 'functions'
		reach.noteCalls(p, ms: ms, f: fns[i], calls: calls)
	end 'functions'
	return calls
end 'callsOutside'

// moduleIrText is the text of the IR of a module's functions, as --emit-ir writes it.
export function moduleIrText(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, functions IrFunctionList) returns String
	var out = ByteArray.create(0)
	for i in 0 upto functions.count() 'each'
		printIr(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, f: functions[i], out: out)
	end 'each'
	return String.from(out)
end 'moduleIrText'
