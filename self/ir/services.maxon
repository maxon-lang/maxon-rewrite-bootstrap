// Services. A service is a cown whose value is its state (rt.service.new), and each message is a behaviour on it, so a send
// is a `when` on the one cown whose body calls the handler with the state: the cown's queue is the mailbox, and a
// behaviour holds its cown until it ends, so two messages of one service never run at once. Before it queues the
// behaviour, a send takes a place in the mailbox (rt.service.reserve), which fails with SendError where a call fails only
// once the service is shut down, dropping the arguments that were to move in, and slows the sender when the service is
// behind; the behaviour gives the place back as it starts (rt.service.start). A reply
// is a cell the behaviour finishes with what the handler returned and failed with (rt.reply.give), awaited as a coroutine
// is. A spawn whose factory cannot throw runs it as the service's first behaviour, which stores the state; one whose
// factory throws calls it where the spawn is, and the service starts with what it made.

// visitSpawnExpr starts a service and gives its handle.
function visitSpawnExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let call = ast.spawnExprCall(p.modules[l.mi].tree, id: e)
	let site = siteOf(l, p: p, node: e)
	let c = callSite(l, p: p, node: call)
	let mark = l.pending.count()
	let handleTy = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e))
	if c.info.body == ast.noFunc 'here'
		let made = lowerExpr(l, p: p, ms: ms, e: call)
		let state = boxed(l, p: p, ms: ms, v: made, t: exprType(p, module: l.module, node: call))
		let handle = newService(l, p: p, ms: ms, site: site, state: state, stateTy: exprType(p, module: l.module, node: call))
		popPending(l, n: mark)
		return handle
	end 'here'
	let base = l.args.count()
	pushOrderedArgs(l, p: p, ms: ms, c: c)
	let captures = messageArgs(l, p: p, ms: ms, c: c, base: base)
	popArgs(l, n: base)
	let empty = konst(l, value: 0 as Word)
	let handle = newService(l, p: p, ms: ms, site: site, state: empty, stateTy: exprType(p, module: l.module, node: call))
	let body = lowerServiceBody(l, p: p, ms: ms, c: c, handleTy: handleTy, factory: true, cell: false, pendingSlot: ast.noPendingSlot)
	emitWhen(l, behaviour: body, cowns: argsOf1(handle), captures: captures)
	popPending(l, n: mark)
	return handle
end 'visitSpawnExpr'

// newService is a new service of the state, with a pending word for each message kind of its type whose policy is a
// CoalescingPolicy, and none for a type that has no such kind.
function newService(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, state Reg, stateTy ast.TypeID) returns Reg
	let applied = applyType(l, p: p, ms: ms, t: stateTy)
	let decl = ast.typeEntry(ms.types, reads: p.types, t: applied).effectiveOrigin()
	let words = ast.serviceWords(ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, nt: decl)
	if words == 0 'none'
		return entry(l, p: p, site: site, symbol: Rt.rtServiceNew, kind: IrKind.kindManaged, args: argsOf1(state))
	end 'none'
	let count = konst(l, value: try words as Word otherwise panic("ir: more pending words than a word"))
	return entry(l, p: p, site: site, symbol: Rt.rtServiceNewPending, kind: IrKind.kindManaged, args: argsOf2(state, b: count))
end 'newService'

// lowerSend sends a message: the handle is read, the arguments move into the behaviour, and the send fails, dropping them,
// when the service is shut down. It gives the reply's promise where the sender keeps it.
function lowerSend(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let mark = l.pending.count()
	let handle = lowerRead(l, p: p, ms: ms, e: c.receiver)
	let handleTy = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.receiver))
	let base = l.args.count()
	pushOrderedArgs(l, p: p, ms: ms, c: c)
	var captures = messageArgs(l, p: p, ms: ms, c: c, base: base)
	popArgs(l, n: base)
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.fn).policy != ast.noType 'policy'
		return lowerPolicySend(l, p: p, ms: ms, c: c, handle: handle, handleTy: handleTy, captures: captures, mark: mark)
	end 'policy'
	addMark(l, p: p, ms: ms, handler: c.info.fn, captures: captures)
	let status = entry(l, p: p, site: site, symbol: Rt.rtServiceReserve, kind: IrKind.kindScalar, args: argsOf1(handle))
	let ok = l.b.newBlock()
	let zero = konst(l, value: 0 as Word)
	let failed = compare(l, op: CmpOp.cmpNe, a: status, b: zero, unsigned: false)
	// The arguments are still in flight, so the failure drops them.
	let stub = failure(l, p: p, ms: ms, errorCase: 0 as Count, err: status, errDrop: ast.noType)
	l.b.terminate(l.cur, t: newBranch(failed, ifTrue: stub, ifFalse: ok))
	l.cur = ok
	var reply = noReg
	if c.info.replyKept 'kept'
		reply = entry(l, p: p, site: site, symbol: Rt.rtReplyNew, kind: IrKind.kindManaged, args: RegList.create(0))
		captures.push(reply)
	end 'kept'
	let body = lowerServiceBody(l, p: p, ms: ms, c: c, handleTy: handleTy, factory: false, cell: c.info.replyKept, pendingSlot: ast.noPendingSlot)
	emitWhen(l, behaviour: body, cowns: argsOf1(handle), captures: captures)
	popPending(l, n: mark)
	if reply == noReg 'none'
		return konst(l, value: 0 as Word)
	end 'none'
	return reply
end 'lowerSend'

// The words rt.service.tryReserve gives besides a SendError's (runtime/service.maxon): the service is behind, so the policy
// is asked; and the cases of the library's Admission that the send tells apart.
let sendBehind = 3 as Word

let admitQueue = 0 as Word

let admitReplacePending = 3 as Word

// sendBusyWord is the word of SendBusyError.busy, its case plus 1, that a refused send of a message with a reply fails with.
let sendBusyWord = 2 as Word

// lowerPolicySend sends a message of a kind with a policy (README, "Overload policies"): while the service is not behind,
// rt.service.tryReserve takes the place as any send's does; while it is, the policy's admit is called with what it may see,
// and its answer decides. A refused message with a reply fails with busy, one without is dropped; a message of a coalescing
// kind replaces the one of its kind that waits in its pending word, or queues a behaviour for the word when it was empty.
function lowerPolicySend(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, handle Reg, handleTy ast.TypeID, captures RegList, mark Count) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let handler = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.fn).clone()
	let slot = handler.pendingSlot
	let busy = ast.answersBusy(handler, voidTy: p.builtins.voidTy)
	var pending = noBlock
	if slot != ast.noPendingSlot 'coalescing'
		// A message of the kind waits in the word: this one replaces it, behind or not, so that it is never handled before it.
		pending = l.b.newBlock()
		let open = l.b.newBlock()
		let word = konst(l, value: try (slot - 1) as Word otherwise panic("ir: a pending word past a word"))
		let held = entry(l, p: p, site: site, symbol: Rt.rtServicePendingHeld, kind: IrKind.kindScalar, args: argsOf2(handle, b: word))
		l.b.terminate(l.cur, t: newBranch(held, ifTrue: pending, ifFalse: open))
		l.cur = open
	end 'coalescing'
	let status = entry(l, p: p, site: site, symbol: Rt.rtServiceTryReserve, kind: IrKind.kindScalar, args: argsOf1(handle))
	let queued = l.b.newBlock()
	let notTaken = l.b.newBlock()
	let behind = l.b.newBlock()
	let queue = l.b.newBlock()
	let refused = l.b.newBlock()
	let done = l.b.newBlock()
	let zero = konst(l, value: 0 as Word)
	let taken = compare(l, op: CmpOp.cmpEq, a: status, b: zero, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(taken, ifTrue: queued, ifFalse: notTaken))
	l.cur = notTaken
	let stopped = failure(l, p: p, ms: ms, errorCase: 0 as Count, err: status, errDrop: ast.noType)
	let behindWord = konst(l, value: sendBehind)
	let isBehind = compare(l, op: CmpOp.cmpEq, a: status, b: behindWord, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(isBehind, ifTrue: behind, ifFalse: stopped))
	l.cur = behind
	let message = arrivingMessage(l, p: p, ms: ms, handler: c.info.fn, captures: captures)
	let answer = admitted(l, p: p, ms: ms, site: site, handle: handle, policy: handler.policy, message: message)
	let notQueue = l.b.newBlock()
	let queueWord = konst(l, value: admitQueue)
	let queues = compare(l, op: CmpOp.cmpEq, a: answer, b: queueWord, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(queues, ifTrue: queue, ifFalse: notQueue))
	l.cur = notQueue
	let replaceWord = konst(l, value: admitReplacePending)
	let replaces = compare(l, op: CmpOp.cmpEq, a: answer, b: replaceWord, unsigned: false)
	if pending != noBlock 'coalescing'
		l.b.terminate(l.cur, t: newBranch(replaces, ifTrue: pending, ifFalse: refused))
	end 'coalescing' else 'other'
		l.b.terminate(l.cur, t: newBranch(replaces, ifTrue: queue, ifFalse: refused))
	end 'other'
	l.cur = queue
	let again = entry(l, p: p, site: site, symbol: Rt.rtServiceReserve, kind: IrKind.kindScalar, args: argsOf1(handle))
	let stoppedAgain = failure(l, p: p, ms: ms, errorCase: 0 as Count, err: again, errDrop: ast.noType)
	let failedAgain = compare(l, op: CmpOp.cmpNe, a: again, b: zero, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(failedAgain, ifTrue: stoppedAgain, ifFalse: queued))
	l.cur = refused
	if busy 'busy'
		let busyWord = konst(l, value: sendBusyWord)
		let refusal = failure(l, p: p, ms: ms, errorCase: 0 as Count, err: busyWord, errDrop: ast.noType)
		l.b.terminate(l.cur, t: newJump(refusal))
	end 'busy' else 'dropped'
		let past = l.pending.count()
		dropPending(l, first: mark, past: past)
		l.b.terminate(l.cur, t: newJump(done))
	end 'dropped'
	l.cur = queued
	var reply = noReg
	var behaviourCaptures = captures.clone()
	addMark(l, p: p, ms: ms, handler: c.info.fn, captures: behaviourCaptures)
	if c.info.replyKept 'kept'
		reply = entry(l, p: p, site: site, symbol: Rt.rtReplyNew, kind: IrKind.kindManaged, args: RegList.create(0))
		behaviourCaptures.push(reply)
	end 'kept'
	let body = lowerServiceBody(l, p: p, ms: ms, c: c, handleTy: handleTy, factory: false, cell: c.info.replyKept, pendingSlot: ast.noPendingSlot)
	emitWhen(l, behaviour: body, cowns: argsOf1(handle), captures: behaviourCaptures)
	l.b.terminate(l.cur, t: newJump(done))
	if pending != noBlock 'replace'
		l.cur = pending
		replacePending(l, p: p, ms: ms, c: c, handle: handle, handleTy: handleTy, captures: captures, mark: mark, done: done)
	end 'replace'
	popPending(l, n: mark)
	l.cur = done
	if reply == noReg 'none'
		return konst(l, value: 0 as Word)
	end 'none'
	return reply
end 'lowerPolicySend'

// admitted is the answer of the policy's admit to a message sent while its service is behind, a case of Admission: the
// policy is a type of the service's, so the call is direct. What admit sees is held in place or boxed as its type is, and the
// message is lent to it where the sender holds it.
function admitted(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, handle Reg, policy ast.TypeID, message Reg) returns Reg
	let admit = policyMethod(l, p: p, ms: ms, policy: policy, name: ast.admitName)
	let arrivalTy = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: admit).paramTypes[0]
	var fields = RegList.create(0)
	fields.push(entry(l, p: p, site: site, symbol: Rt.rtServiceQueued, kind: IrKind.kindScalar, args: argsOf1(handle)))
	fields.push(entry(l, p: p, site: site, symbol: Rt.rtServiceTurn, kind: IrKind.kindScalar, args: RegList.create(0)))
	let answer = newReg(l, kind: IrKind.kindScalar)
	match heldAs(p, ms: ms, t: arrivalTy) 'holding'
		heldAddress(words) then placedCall(l, p: p, ms: ms, admit: admit, arrivalTy: arrivalTy, words: words, fields: fields, message: message, answer: answer)
		heldWord or
		heldString or
		heldBox then arrivalCall(l, p: p, ms: ms, admit: admit, arrivalTy: arrivalTy, fields: fields, message: message, answer: answer)
		heldInline(_) panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
	return answer
end 'admitted'

// arrivalCall calls admit with a box of the fields of what it sees, which it only borrows.
function arrivalCall(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, admit ast.FuncID, arrivalTy ast.TypeID, fields RegList, message Reg, answer Reg)
	let arrival = builtinRecord(l, p: p, ms: ms, t: arrivalTy, values: fields)
	emitCall(l, p: p, ms: ms, dst: answer, target: admit, args: argsOf2(arrival, b: message))
	let drop = dropType(l, p: p, ms: ms, t: arrivalTy)
	emitDropReg(l, src: arrival, ty: drop)
end 'arrivalCall'

// placedCall calls admit with what it sees held in place, in a frame area, which nothing drops.
function placedCall(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, admit ast.FuncID, arrivalTy ast.TypeID, words Count, fields RegList, message Reg, answer Reg)
	let arrival = placedFields(l, p: p, ms: ms, t: arrivalTy, words: words, values: fields)
	emitCall(l, p: p, ms: ms, dst: answer, target: admit, args: argsOf2(arrival, b: message))
end 'placedCall'

// placedFields is a value of the record t held in place in words words of a frame area of its own, whose fields are the
// words of values.
function placedFields(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, words Count, values RegList) returns Reg
	let area = newArea(l, words: words)
	for i in 0 upto values.count() 'each'
		let offset = recordFieldOffset(ms.types, reads: p.types, owner: t, index: i)
		emit(l, i: newStoreField(area, offset: offset, src: values[i], borrow: false))
	end 'each'
	return area
end 'placedFields'

// policyMethod is the method of the policy type named so, the instance of it at the policy's type arguments for a generic
// policy, as the library's are, which findInstances found at the send (notePolicies).
function policyMethod(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, policy ast.TypeID, name String) returns ast.FuncID
	var refused = diag.ErrorList.create(0)
	return match consumes policyMethodOf(p, ms: ms, module: l.module, site: 0 as ast.NodeID, policy: policy, name: name, errs: refused) 'method'
		some(f) gives checkedCallee(l, p: p, ms: ms, target: f)
		none gives panic("ir: the {name} of an overload policy was refused after its module's instances were found")
	end 'method'
end 'policyMethod'

// policyMethodOf is the method of the policy type named so, or its instance at the policy's type arguments.
function policyMethodOf(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, policy ast.TypeID, name String, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let origin = ast.typeEntry(ms.types, reads: p.types, t: policy).effectiveOrigin()
	let method = match ast.typeEntry(ms.types, reads: p.types, t: origin).findMethod(name) 'found'
		some(f) gives f
		none gives panic("ir: an overload policy without {name}")
	end 'found'
	return instantiateMethod(p, ms: ms, module: module, site: site, method: method, recv: policy, errs: errs)
end 'policyMethodOf'

// notePolicies notes the instances of the methods of generic policies that a send of the message handler runs: its own
// policy's admit, and the shed of each shedding policy of its type, which the start of each of its messages may call.
function notePolicies(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, handler ast.FuncID, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	let decl = serviceDecl(p, ms: ms, handler: handler)
	let methods = ast.typeEntry(ms.types, reads: p.types, t: decl).methods.clone()
	for m in methods 'methods'
		let policy = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m.func).policy
		if policy == ast.noType or ast.typeEntry(ms.types, reads: p.types, t: policy).typeArgs.count() == 0 'plain'
			continue 'methods'
		end 'plain'
		if m.func == handler 'admit'
			let method = policyMethodOf(p, ms: ms, module: module, site: site, policy: policy, name: ast.admitName, errs: errs)
			if not noteInstance(p, ms: ms, module: module, site: site, target: method, found: found, errs: errs) 'deepAdmit'
				return false
			end 'deepAdmit'
		end 'admit'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m.func).shedPolicy != ast.noShedPolicy 'shed'
			let method = policyMethodOf(p, ms: ms, module: module, site: site, policy: policy, name: ast.shedName, errs: errs)
			if not noteInstance(p, ms: ms, module: module, site: site, target: method, found: found, errs: errs) 'deepShed'
				return false
			end 'deepShed'
		end 'shed'
	end 'methods'
	return true
end 'notePolicies'

// arrivingMessage is the message a send of the kind handler lends its policy's admit, a value of its type's message union: a
// frame area of the words its behaviour holds from its case on, the case and the arguments, which the sender still owns and
// the area borrows. It is made only while the service is behind.
function arrivingMessage(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, handler ast.FuncID, captures RegList) returns Reg
	let decl = serviceDecl(p, ms: ms, handler: handler)
	let messages = ast.messageUnionOf(p, ms: ms, nt: decl)
	let kind = ast.messageCase(ms.types, reads: p.types, u: messages, kind: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: handler).name)
	let words = caseBoxBytes(ms.types, reads: p.types, owner: messages, caseIndex: kind) / wordBytes
	let area = newReg(l, kind: IrKind.kindManaged)
	let made = l.b.frameArea(area, words: words)
	emit(l, i: made)
	let tag = konst(l, value: try kind as Word otherwise panic("ir: a message case past a word"))
	emit(l, i: newStoreField(area, offset: 0, src: tag, borrow: false))
	for i in 0 upto captures.count() 'args'
		let offset = payloadOffset(ms.types, reads: p.types, owner: messages, caseIndex: kind, index: i)
		emit(l, i: newStoreField(area, offset: offset, src: captures[i], borrow: owning(regKind(l, v: captures[i]))))
	end 'args'
	return area
end 'arrivingMessage'

// pendingType is the box a message of a coalescing kind waits in, in its kind's pending word: a tuple of a word and its
// arguments, as the behaviour's captures hold them, so that one drop routine drops what a replaced message held.
function pendingType(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, handler ast.FuncID) returns ast.TypeID
	var elems = ast.TypeIDList.create(0)
	elems.push(p.builtins.countTy)
	let fn = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: handler).clone()
	for i in 0 upto fn.paramTypes.count() 'params'
		elems.push(applyType(l, p: p, ms: ms, t: fn.paramTypes[i]))
	end 'params'
	return ast.tupleType(ms.types, reads: p.types, elems: elems)
end 'pendingType'

// replacePending puts the message in its kind's pending word, with a place in the mailbox that never slows its sender: a
// message that waited there is dropped and its place given back, and an empty word gets a behaviour that takes what the
// word holds when it runs.
function replacePending(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, handle Reg, handleTy ast.TypeID, captures RegList, mark Count, done BlockID)
	let site = siteOf(l, p: p, node: c.node)
	let slot = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.fn).pendingSlot
	let placed = entry(l, p: p, site: site, symbol: Rt.rtServicePlace, kind: IrKind.kindScalar, args: argsOf1(handle))
	let put = l.b.newBlock()
	let zero = konst(l, value: 0 as Word)
	let stopped = failure(l, p: p, ms: ms, errorCase: 0 as Count, err: placed, errDrop: ast.noType)
	let refusedPlace = compare(l, op: CmpOp.cmpNe, a: placed, b: zero, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(refusedPlace, ifTrue: stopped, ifFalse: put))
	l.cur = put
	let boxTy = pendingType(l, p: p, ms: ms, handler: c.info.fn)
	var values = RegList.create(0)
	values.push(zero)
	for i in 0 upto captures.count() 'args'
		values.push(captures[i])
	end 'args'
	let box = builtinRecord(l, p: p, ms: ms, t: boxTy, values: values)
	popPending(l, n: mark)
	let word = konst(l, value: try (slot - 1) as Word otherwise panic("ir: a pending word past a word"))
	let old = entry(l, p: p, site: site, symbol: Rt.rtServicePutPending, kind: IrKind.kindManaged, args: argsOf3(handle, b: word, c: box))
	let replaced = l.b.newBlock()
	let first = l.b.newBlock()
	let empty = compare(l, op: CmpOp.cmpEq, a: old, b: zero, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(empty, ifTrue: first, ifFalse: replaced))
	l.cur = replaced
	let drop = dropType(l, p: p, ms: ms, t: boxTy)
	emitDropReg(l, src: old, ty: drop)
	entryVoid(l, p: p, site: site, symbol: Rt.rtServiceUnplace, args: argsOf1(handle))
	l.b.terminate(l.cur, t: newJump(done))
	l.cur = first
	let body = lowerServiceBody(l, p: p, ms: ms, c: c, handleTy: handleTy, factory: false, cell: false, pendingSlot: slot)
	var marked = RegList.create(0)
	addMark(l, p: p, ms: ms, handler: c.info.fn, captures: marked)
	emitWhen(l, behaviour: body, cowns: argsOf1(handle), captures: marked)
	l.b.terminate(l.cur, t: newJump(done))
end 'replacePending'

// messageArgs are the arguments of a message pushed since base, each of which the message owns: a value held in place that a
// let parameter borrows goes in a box of its own as a consumed one does (argValue), since the body runs past this frame.
function messageArgs(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, base Count) returns RegList
	var args = argsSince(l, base: base)
	for i in 0 upto args.count() 'args'
		if c.info.paramSpecs[i].conv == ast.Convention.convLet 'lent'
			let t = exprRefType(l, p: p, ms: ms, e: ExprRef.make(l.module, node: c.ordered[i]))
			args[i] = boxed(l, p: p, ms: ms, v: args[i], t: t)
		end 'lent'
	end 'args'
	return args
end 'messageArgs'

// lowerServiceBody lowers the behaviour that runs a factory or a handler on the service, as a body of the function around
// it: it is given the address of the state, then each argument, which it owns, then the reply's cell where the sender keeps
// one. It calls the function with the arguments, by value, and drops each that a let parameter only borrowed. A factory's
// value becomes the state; a handler's goes into the cell, or is dropped with what it failed with. The behaviour of a
// pending word (pendingSlot) is given the state alone, and moves the arguments out of the box it takes from the word, which
// it drops once the handler has run.
function lowerServiceBody(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, handleTy ast.TypeID, factory bool, cell bool, pendingSlot Count) returns Count
	let target = callee(l, p: p, ms: ms, node: c.node, info: c.info, receiver: c.receiver)
	let name = behaviourBodyName(irSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: l.b.f), index: l.b.f.bodies.count())
	let fn = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).clone()
	let params = fn.params.count()
	let pending = pendingSlot != ast.noPendingSlot
	var boxTy = ast.noType
	if pending 'boxed'
		boxTy = pendingType(l, p: p, ms: ms, handler: target)
	end 'boxed'
	let sheds = not factory and handlerSheds(p, ms: ms, handler: c.info.fn)
	// A message of a type with shedding kinds is given its mark word and its case before its arguments.
	let first = 3 if sheds else 1
	let cellIndex = first if pending else params + first
	var inner = Lowerer.new(exchange(l.instances, value: InstanceSet.new()))
	begin(inner, p: p, ms: ms, fn: c.info.body, bindParams: ast.cloneTypeArgs(l.bindParams), bindArgs: ast.cloneTypeArgs(l.bindArgs), bindWitnesses: l.bindWitnesses.clone(), name: name)
	inner.b.f.paramCount = cellIndex + (1 if cell else 0)
	let state = paramReg(inner, index: 0 as Count, kind: IrKind.kindScalar)
	var args = RegList.create(0)
	if sheds 'shedding'
		startShedding(inner, l: l, p: p, ms: ms, c: c, state: state, first: first, pendingSlot: pendingSlot)
	end 'shedding' else if not factory 'message'
		entryVoid(inner, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtServiceStart, args: argsOf1(state))
	end 'message'
	var box = noReg
	if pending 'take'
		let word = konst(inner, value: try (pendingSlot - 1) as Word otherwise panic("ir: a pending word past a word"))
		box = entry(inner, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtServiceTakePending, kind: IrKind.kindManaged, args: argsOf2(state, b: word))
	end 'take'
	var owned = RegList.create(0)
	var strings = 0 as FloatMask
	for i in 0 upto params 'params'
		let ty = applyType(l, p: p, ms: ms, t: fn.paramTypes[i])
		let kind = holderKind(l, p: p, ms: ms, t: ty)
		let param = try i + first otherwise panic("ir: more parameters than a word")
		var v = noReg
		if pending 'field'
			v = newReg(inner, kind: kind)
			let offset = recordFieldOffset(ms.types, reads: p.types, owner: boxTy, index: i + 1)
			if owning(kind) 'moved'
				let addr = newReg(inner, kind: IrKind.kindScalar)
				emit(inner, i: newFieldAddr(addr, obj: box, offset: offset))
				emit(inner, i: newMoveAt(v, addr: addr))
			end 'moved' else 'word'
				emit(inner, i: newLoadField(v, obj: box, offset: offset))
			end 'word'
		end 'field' else 'param'
			if kind == IrKind.kindString 'string'
				strings = strings or floatBit(param)
			end 'string'
			v = paramReg(inner, index: param, kind: kind)
		end 'param'
		args.push(v)
		owned.push(v)
	end 'params'
	if not factory 'receiver'
		// The state is lent once the arguments are out of a pending box: one may be a handle to this service, which holds it.
		let recv = newReg(inner, kind: IrKind.kindManaged)
		emit(inner, i: newLoadAt(recv, addr: state, filled: false))
		args.insert(0, value: recv)
	end 'receiver'
	let resultTy = applyType(l, p: p, ms: ms, t: fn.retTy)
	var dst = noReg
	if resultTy != p.builtins.voidTy 'value'
		dst = newReg(inner, kind: kindOf(l, p: p, ms: ms, t: resultTy))
	end 'value'
	var err = noReg
	if fn.errTy != ast.noType 'throws'
		var errKind = IrKind.kindScalar
		let errApplied = applyType(l, p: p, ms: ms, t: fn.errTy)
		if errorInBox(ms.types, reads: p.types, t: errApplied) 'union'
			errKind = IrKind.kindManaged
		end 'union'
		err = newReg(inner, kind: errKind)
		emitThrowingCall(inner, p: p, ms: ms, dst: dst, target: target, args: args, err: err)
	end 'throws' else 'plain'
		emitCall(inner, p: p, ms: ms, dst: dst, target: target, args: args)
	end 'plain'
	for i in 0 upto params 'borrowed'
		let ty = applyType(l, p: p, ms: ms, t: fn.paramTypes[i])
		if fn.params[i].conv == ast.Convention.convLet and holderOwns(l, p: p, ms: ms, t: ty) 'lent'
			emitDropReg(inner, src: owned[i], ty: dropType(l, p: p, ms: ms, t: ty))
		end 'lent'
	end 'borrowed'
	if factory 'store'
		let held = boxed(inner, p: p, ms: ms, v: dst, t: resultTy)
		emit(inner, i: newStoreAt(state, src: held))
	end 'store' else if cell 'reply'
		let cellReg = paramReg(inner, index: cellIndex, kind: IrKind.kindScalar)
		let value = boxed(inner, p: p, ms: ms, v: dst, t: resultTy) if dst != noReg else konst(inner, value: 0 as Word)
		let error = err if err != noReg else konst(inner, value: 0 as Word)
		entryVoid(inner, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtReplyGive, args: argsOf3(cellReg, b: value, c: error))
	end 'reply' else 'dropped'
		dropReply(inner, p: p, ms: ms, l: l, dst: dst, resultTy: resultTy, err: err, errTy: fn.errTy)
	end 'dropped'
	if pending 'emptied'
		emitDropReg(inner, src: box, ty: dropType(l, p: p, ms: ms, t: boxTy))
	end 'emptied'
	let zero = konst(inner, value: 0 as Word)
	inner.b.terminate(inner.cur, t: newRet(zero))
	var body = inner.b.finish()
	body.stringParams = strings
	l.instances = exchange(inner.instances, value: InstanceSet.new())
	var cowns = ast.TypeIDList.create(0)
	cowns.push(handleTy)
	body.cownTypes = cowns
	l.b.f.usesArrays = l.b.f.usesArrays or body.usesArrays
	l.b.f.usesBytes = l.b.f.usesBytes or body.usesBytes
	l.b.f.usesOs = l.b.f.usesOs or body.usesOs
	return l.b.body(body)
end 'lowerServiceBody'

// dropReply drops the reply of a handler that no one keeps: its error where it failed, and else its value. The types are
// the outer lowerer's, whose type arguments the body's are.
function dropReply(mutates inner Lowerer, p ast.Project, mutates ms ast.ModuleState, mutates l Lowerer, dst Reg, resultTy ast.TypeID, err Reg, errTy ast.TypeID)
	var valueDrop = ast.noType
	if dst != noReg and owning(kindOf(l, p: p, ms: ms, t: resultTy)) 'managed'
		valueDrop = dropType(l, p: p, ms: ms, t: resultTy)
	end 'managed'
	var errDrop = ast.noType
	if err != noReg 'throws'
		errDrop = errorDropType(l, p: p, ms: ms, t: errTy)
	end 'throws'
	dropOutcome(inner, dst: dst, valueDrop: valueDrop, err: err, errDrop: errDrop)
end 'dropReply'

// dropOutcome drops what a function gave that no one keeps: where err says it failed, the error, of the type errDrop where
// that is a managed one, and else the value in dst, of the type valueDrop where that is one. err is noReg for a function
// that cannot fail.
export function dropOutcome(mutates l Lowerer, dst Reg, valueDrop ast.TypeID, err Reg, errDrop ast.TypeID)
	if err == noReg 'plain'
		if valueDrop != ast.noType 'value'
			emitDropReg(l, src: dst, ty: valueDrop)
		end 'value'
		return
	end 'plain'
	if valueDrop == ast.noType and errDrop == ast.noType 'scalars'
		return
	end 'scalars'
	let failedBlock = l.b.newBlock()
	let returned = l.b.newBlock()
	let join = l.b.newBlock()
	let zero = konst(l, value: 0 as Word)
	let failed = compare(l, op: CmpOp.cmpNe, a: err, b: zero, unsigned: false)
	l.b.terminate(l.cur, t: newBranch(failed, ifTrue: failedBlock, ifFalse: returned))
	l.cur = failedBlock
	if errDrop != ast.noType 'unionError'
		emitDropReg(l, src: err, ty: errDrop)
	end 'unionError'
	l.b.terminate(l.cur, t: newJump(join))
	l.cur = returned
	if valueDrop != ast.noType 'value'
		emitDropReg(l, src: dst, ty: valueDrop)
	end 'value'
	l.b.terminate(l.cur, t: newJump(join))
	l.cur = join
end 'dropOutcome'

function lowerServiceShutdown(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtServiceShutdown, args: argsOf1(recv))
	return konst(l, value: 0 as Word)
end 'lowerServiceShutdown'

function lowerServiceUnderLoad(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtServiceUnderLoad, kind: IrKind.kindScalar, args: RegList.create(0))
end 'lowerServiceUnderLoad'

function lowerServiceMostQueued(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtServiceMostQueued, kind: IrKind.kindScalar, args: argsOf1(recv))
end 'lowerServiceMostQueued'

// Shedding (README, "Overload policies"; runtime/service.maxon, "Shedding"). Every behaviour of a service whose type has kinds
// of a SheddingPolicy holds the mark word of its kind as its first capture, and every message of it starts by
// rt.service.shedStart: where the policies' shed is due, each of the type's shedding policies is given a view of the queued
// messages of its kinds and its shed is called directly, as admit is; and a message its view marked drops what it holds
// instead of running its handler. A type with no such kind has no mark and starts its messages by rt.service.start.

// The marks of runtime/service.maxon: a kind's shedding policy, from 1, times markPolicyUnit, and the bit of a shed message.
let markPolicyUnit = 0x100000000 as Word

// The answers of rt.service.shedStart: the message runs, it was shed, or the policies' shed is due first.
let shedDroppedWord = 1 as Word

let shedDueWord = 2 as Word

// handlerSheds is whether the type of the message handler has kinds of a SheddingPolicy.
function handlerSheds(p ast.Project, ms ast.ModuleState, handler ast.FuncID) returns bool
	return ast.sheds(ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, nt: serviceDecl(p, ms: ms, handler: handler))
end 'handlerSheds'

// serviceDecl is the declaration of the type of the message handler.
function serviceDecl(p ast.Project, ms ast.ModuleState, handler ast.FuncID) returns ast.TypeID
	let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: handler).ownerTy
	return ast.typeEntry(ms.types, reads: p.types, t: owner).effectiveOrigin()
end 'serviceDecl'

// addMark puts the mark word of a message of the kind handler first among the captures of its behaviour, where its type has
// shedding kinds, and its case of the type's message union second: the case and the arguments after it are the words of a
// value of the union, which a view lends a policy's shed where the message waits.
function addMark(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, handler ast.FuncID, mutates captures RegList)
	if not handlerSheds(p, ms: ms, handler: handler) 'plain'
		return
	end 'plain'
	let f = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: handler).clone()
	let policy = try f.shedPolicy as Word otherwise panic("ir: a shedding policy past a word")
	let mark = try policy * markPolicyUnit otherwise panic("ir: a mark past a word")
	let decl = serviceDecl(p, ms: ms, handler: handler)
	let messages = ast.messageUnionOf(p, ms: ms, nt: decl)
	let kind = try ast.messageCase(ms.types, reads: p.types, u: messages, kind: f.name) as Word otherwise panic("ir: a message case past a word")
	captures.insert(0, value: konst(l, value: kind))
	captures.insert(0, value: konst(l, value: mark))
end 'addMark'

// startShedding starts a message of a type with shedding kinds in its behaviour's body: the policies' shed runs where it is
// due, and a message of a kind of a shedding policy that is marked drops its arguments, which start at the parameter first,
// or its pending box, and ends the body. The body goes on in the block that runs the handler.
function startShedding(mutates inner Lowerer, mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, state Reg, first Count, pendingSlot Count)
	let site = siteOf(l, p: p, node: c.node)
	let handler = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.fn).clone()
	let decl = serviceDecl(p, ms: ms, handler: c.info.fn)
	let words = ast.pendingWords(ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, nt: decl)
	let horizon = konst(inner, value: try words as Word otherwise panic("ir: a pending word past a word"))
	let status = entry(inner, p: p, site: site, symbol: Rt.rtServiceShedStart, kind: IrKind.kindScalar, args: argsOf2(state, b: horizon))
	let mayShed = handler.shedPolicy != ast.noShedPolicy
	let due = inner.b.newBlock()
	let notDue = inner.b.newBlock()
	let run = inner.b.newBlock()
	var dropped = noBlock
	if mayShed 'drops'
		dropped = inner.b.newBlock()
	end 'drops'
	let dueWord = konst(inner, value: shedDueWord)
	let isDue = compare(inner, op: CmpOp.cmpEq, a: status, b: dueWord, unsigned: false)
	inner.b.terminate(inner.cur, t: newBranch(isDue, ifTrue: due, ifFalse: notDue))
	inner.cur = notDue
	if mayShed 'marked'
		let droppedWord = konst(inner, value: shedDroppedWord)
		let isDropped = compare(inner, op: CmpOp.cmpEq, a: status, b: droppedWord, unsigned: false)
		inner.b.terminate(inner.cur, t: newBranch(isDropped, ifTrue: dropped, ifFalse: run))
	end 'marked' else 'kept'
		inner.b.terminate(inner.cur, t: newJump(run))
	end 'kept'
	inner.cur = due
	runSheds(inner, l: l, p: p, ms: ms, site: site, decl: decl, state: state, horizon: horizon)
	if mayShed 'shedNow'
		let marked = entry(inner, p: p, site: site, symbol: Rt.rtServiceShedMarked, kind: IrKind.kindScalar, args: argsOf1(state))
		inner.b.terminate(inner.cur, t: newBranch(marked, ifTrue: dropped, ifFalse: run))
		inner.cur = dropped
		dropShed(inner, l: l, p: p, ms: ms, site: site, handler: c.info.fn, state: state, first: first, pendingSlot: pendingSlot)
	end 'shedNow' else 'noShed'
		inner.b.terminate(inner.cur, t: newJump(run))
	end 'noShed'
	inner.cur = run
end 'startShedding'

// runSheds calls the shed of each shedding policy of the service type decl, in their order, with a view of the messages of
// its kinds: on the field that holds it, or on a value of a policy type that holds nothing.
function runSheds(mutates inner Lowerer, mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, decl ast.TypeID, state Reg, horizon Reg)
	var number = 1 as Count
	while true 'policies'
		var found = false
		var rep = ast.noFunc
		for m in ast.typeEntry(ms.types, reads: p.types, t: decl).methods 'methods'
			if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: m.func).shedPolicy == number 'this'
				found = true
				rep = m.func
				break 'methods'
			end 'this'
		end 'methods'
		if not found 'done'
			return
		end 'done'
		runShed(inner, l: l, p: p, ms: ms, site: site, decl: decl, state: state, horizon: horizon, number: number, kind: rep)
		number = try number + 1 otherwise panic("ir: more shedding policies than a word")
	end 'policies'
end 'runSheds'

// runShed calls the shed of the shedding policy number of the service type decl, which the message kind names.
function runShed(mutates inner Lowerer, mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, decl ast.TypeID, state Reg, horizon Reg, number Count, kind ast.FuncID)
	let f = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: kind).clone()
	let shed = policyMethod(inner, p: p, ms: ms, policy: f.policy, name: ast.shedName)
	let viewTy = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: shed).paramTypes[0]
	let policyWord = konst(inner, value: try number as Word otherwise panic("ir: a shedding policy past a word"))
	let view = entry(inner, p: p, site: site, symbol: Rt.rtServiceViewOpen, kind: IrKind.kindScalar, args: argsOf3(state, b: horizon, c: policyWord))
	var fields = RegList.create(0)
	fields.push(view)
	fields.push(entry(inner, p: p, site: site, symbol: Rt.rtServiceViewMessages, kind: IrKind.kindManaged, args: argsOf1(view)))
	fields.push(entry(inner, p: p, site: site, symbol: Rt.rtServiceViewCount, kind: IrKind.kindScalar, args: argsOf1(view)))
	fields.push(entry(inner, p: p, site: site, symbol: Rt.rtServiceTurn, kind: IrKind.kindScalar, args: RegList.create(0)))
	// The view is lent to shed, and dropped here: a box, since it holds the array of its messages.
	let pending = builtinRecord(inner, p: p, ms: ms, t: viewTy, values: fields)
	var args = RegList.create(0)
	var made = noReg
	var policyDrop = ast.noType
	if f.policyField != ast.noPolicyField 'field'
		let index = f.policyField - 1
		let recv = newReg(inner, kind: IrKind.kindManaged)
		emit(inner, i: newLoadAt(recv, addr: state, filled: false))
		let addr = newReg(inner, kind: IrKind.kindScalar)
		let offset = fieldAt(inner, p: p, ms: ms, owner: decl, index: index)
		emit(inner, i: newFieldAddr(addr, obj: recv, offset: offset))
		let fieldTy = ast.typeEntry(ms.types, reads: p.types, t: decl).fields[index].ty
		args.push(fieldReceiver(inner, p: p, ms: ms, owner: decl, index: index, t: fieldTy, addr: addr))
	end 'field' else 'type'
		// A receiver is given as a value: the policy's words, or its box, which nothing but the call holds.
		made = builtinRecord(inner, p: p, ms: ms, t: f.policy, values: RegList.create(0))
		args.push(made)
		if owning(regKind(inner, v: made)) 'boxed'
			policyDrop = dropType(l, p: p, ms: ms, t: f.policy)
		end 'boxed'
	end 'type'
	args.push(pending)
	emitCall(inner, p: p, ms: ms, dst: noReg, target: shed, args: args)
	// The view's messages are lent, so it gives them up before it is dropped with the array that held them.
	entryVoid(inner, p: p, site: site, symbol: Rt.rtServiceViewClose, args: argsOf1(view))
	emitDropReg(inner, src: pending, ty: dropType(l, p: p, ms: ms, t: viewTy))
	if policyDrop != ast.noType 'policy'
		emitDropReg(inner, src: made, ty: policyDrop)
	end 'policy'
end 'runShed'

// fieldReceiver is the field at index of the record owner, of the type t, whose address is addr, as a method's receiver is
// given it: its words where they are the record's own, and else the word the field holds.
function fieldReceiver(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, owner ast.TypeID, index Count, t ast.TypeID, addr Reg) returns Reg
	return match fieldHeld(l, p: p, ms: ms, owner: owner, index: index, t: t) 'holding'
		heldInline(_) gives addr
		heldWord gives lentWordAt(l, addr: addr, kind: IrKind.kindScalar)
		heldString gives panic("ir: a policy held as a String")
		heldBox gives lentWordAt(l, addr: addr, kind: IrKind.kindManaged)
		heldAddress(_) gives panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
		heldPacked gives panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
	end 'holding'
end 'fieldReceiver'

// lentWordAt is the word at addr, which stays where it is: a receiver lent from its holder.
function lentWordAt(mutates l Lowerer, addr Reg, kind IrKind) returns Reg
	let d = newReg(l, kind: kind)
	emit(l, i: newLoadAt(d, addr: addr, filled: false))
	return d
end 'lentWordAt'

// dropShed ends the body of a message that a view marked: it drops the arguments, from the parameter first, or the box its
// pending word holds, as a message that is not handled is dropped.
function dropShed(mutates inner Lowerer, mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, handler ast.FuncID, state Reg, first Count, pendingSlot Count)
	if pendingSlot != ast.noPendingSlot 'pending'
		let word = konst(inner, value: try (pendingSlot - 1) as Word otherwise panic("ir: a pending word past a word"))
		let box = entry(inner, p: p, site: site, symbol: Rt.rtServiceTakePending, kind: IrKind.kindManaged, args: argsOf2(state, b: word))
		let boxTy = pendingType(l, p: p, ms: ms, handler: handler)
		let drop = dropType(l, p: p, ms: ms, t: boxTy)
		emitDropReg(inner, src: box, ty: drop)
	end 'pending' else 'args'
		let fn = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: handler).clone()
		for i in 0 upto fn.paramTypes.count() 'params'
			let ty = applyType(l, p: p, ms: ms, t: fn.paramTypes[i])
			let kind = holderKind(l, p: p, ms: ms, t: ty)
			if owning(kind) 'owned'
				let v = paramReg(inner, index: try i + first otherwise panic("ir: more parameters than a word"), kind: kind)
				emitDropReg(inner, src: v, ty: dropType(l, p: p, ms: ms, t: ty))
			end 'owned'
		end 'params'
	end 'args'
	let zero = konst(inner, value: 0 as Word)
	inner.b.terminate(inner.cur, t: newRet(zero))
end 'dropShed'

function lowerServiceViewMark(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtServiceViewMark, args: argsOf3(args[0], b: args[1], c: args[2]))
	return konst(l, value: 0 as Word)
end 'lowerServiceViewMark'

function lowerServiceViewMarked(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtServiceViewMarked, kind: IrKind.kindScalar, args: argsOf2(args[0], b: args[1]))
end 'lowerServiceViewMarked'
