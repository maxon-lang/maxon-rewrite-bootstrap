// InstanceSet is the instances one module needs, in the order they were found.
export type InstanceSet
	export var list as ast.FuncIDList
	export var found as table.IntMap with bool

	export static function new() returns InstanceSet
		return InstanceSet{list: ast.FuncIDList.create(0), found: table.IntMap.new()}
	end 'new'

	// add notes an instance as found.
	export function add(mutates self, instance ast.FuncID)
		found.insert(instance as Count, value: true)
		list.push(instance)
	end 'add'

	// has is whether the module found the instance. A module that lowers a call of an instance it did not find would
	// depend on another module having made it, so lowering refuses it.
	export function has(instance ast.FuncID) returns bool
		return found.has(instance as Count)
	end 'has'
end 'InstanceSet'

// typeDepth is how deeply instances nest in t: a parameter or a plain type is 0, and Box with (Box with Count) is 2. A body
// that calls itself with a growing type argument has no end, which a limit on the depth finds.
export function typeDepth(tt ast.TypeSlot, reads ast.TypeTable, t ast.TypeID) returns Count
	let n = ast.typeEntry(tt, reads: reads, t: t).typeArgs.count()
	if n == 0 'plain'
		return 0
	end 'plain'
	var deepest = 0 as Count
	for i in 0 upto n 'args'
		let d = typeDepth(tt, reads: reads, t: ast.typeEntry(tt, reads: reads, t: t).typeArgs[i])
		if d > deepest 'deeper'
			deepest = d
		end 'deeper'
	end 'args'
	return succ(deepest)
end 'typeDepth'

// applyAll is the list with every type replaced by its argument, where the parameters are bound.
function applyAll(mutates tt ast.TypeSlot, reads ast.TypeTable, ts ast.TypeIDList, params ast.TypeIDList, args ast.TypeIDList) returns ast.TypeIDList
	var out = ast.TypeIDList.create(0)
	for i in 0 upto ts.count() 'each'
		out.push(ast.substituteType(tt, reads: reads, t: ts[i], params: params, args: args))
	end 'each'
	return out
end 'applyAll'

// resolveCall is the function a call runs once the type parameters of the code it is in are bound: the target itself, or
// the instance of a generic one, or for a call through a bound the method of the type that stands in for the parameter.
// bindWitnesses are the conformances that the code around the call was given. It is none after it refused an instance
// whose conformance the module of the call does not see.
export function resolveCall(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, node ast.NodeID, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	return resolveTarget(p, ms: ms, module: module, site: node, receiver: ast.callReceiver(p.modules[ast.modIndex(module)].tree, e: node, kind: info.kind), info: info, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs)
end 'resolveCall'

// resolveTarget is resolveCall for a call at site whose object is already known.
export function resolveTarget(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, receiver ast.NodeID, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	if info.kind == ast.CallKind.callFunction or info.kind == ast.CallKind.callStatic or info.kind == ast.CallKind.callMethod or info.kind == ast.CallKind.callSend 'direct'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).generics.count() == 0 'plain'
			return table.Option.some(info.fn)
		end 'plain'
		let args = applyAll(ms.types, reads: p.types, ts: info.typeArgs, params: bindParams, args: bindArgs)
		return instantiateWith(p, ms: ms, module: module, site: site, origin: info.fn, written: info.typeArgs, args: args, enclosing: bindWitnesses, errs: errs)
	end 'direct'
	if info.kind == ast.CallKind.callBound 'bound'
		// A frozen receiver lends its contents, so the method is the one of the type it holds. The receiver's type is the
		// call's, since a for's calls of the protocol have no receiver written.
		let received = ast.substituteType(ms.types, reads: p.types, t: info.receiverTy, params: bindParams, args: bindArgs)
		let recv = ast.contentType(ms.types, reads: p.types, t: received)
		let origin = ast.typeEntry(ms.types, reads: p.types, t: recv).effectiveOrigin()
		let name = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.method).name.clone()
		if ast.typeEntry(ms.types, reads: p.types, t: origin).findMethod(name).isSome() 'own'
			return witnessFor(p, ms: ms, module: module, site: site, recv: recv, name: name, conformance: module, errs: errs)
		end 'own'
		let param = ast.contentType(ms.types, reads: p.types, t: info.receiverTy)
		let conformance = passedWitness(p, ms: ms, enclosing: bindWitnesses, param: param, iface: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.method).ownerTy)
		return witnessFor(p, ms: ms, module: module, site: site, recv: recv, name: name, conformance: conformance, errs: errs)
	end 'bound'
	panic("call kind {info.kind.name} has no function to resolve")
end 'resolveTarget'

// witnessFor is the method of that name that meets a requirement for the type recv: the type's own, or else the one that
// an extension of the type adds where the module of the conformance sees it, as an instance for a generic type's
// arguments, or else the instance for recv of the one that an extension of an interface it implements adds there.
function witnessFor(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, recv ast.TypeID, name String, conformance diag.ModuleID, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let origin = ast.typeEntry(ms.types, reads: p.types, t: recv).effectiveOrigin()
	match consumes ast.typeEntry(ms.types, reads: p.types, t: origin).findMethod(name) 'found'
		some(method) then return ownWitness(p, ms: ms, module: module, site: site, method: method, recv: recv, conformance: conformance, errs: errs)
		none then _ = 0
	end 'found'
	// A built-in method of String meets a requirement as it is: a call through the bound lowers it in place
	// (lowerBuiltinWitness).
	if recv == p.builtins.stringTy or recv == p.builtins.characterTy 'primitive'
		match ast.primitiveMethod(p.builtins, t: recv, name: name) 'builtin'
			some(fid) then return table.Option.some(fid)
			none then _ = 0
		end 'builtin'
	end 'primitive'
	let key = ast.extensionKey(p, ms: ms, t: recv)
	if key.isSome() 'extensions'
		match consumes ast.extensionMethod(p, ms: ms, from: conformance, owner: key.unwrap(), name: name) 'ofType'
			found(fid) then return instantiateMethod(p, ms: ms, module: module, site: site, method: fid, recv: recv, errs: errs)
			absent then _ = 0
			ambiguous(_, _) then panic("the conformance of {ast.typeName(ms.types, reads: p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has two methods '{name}'")
		end 'ofType'
	end 'extensions'
	let have = ast.seenInterfaces(p, ms: ms, from: conformance, t: recv)
	match consumes ast.interfaceExtensionMethod(p, ms: ms, from: conformance, have: have, name: name) 'ofInterface'
		found(fid) then return instantiateExtension(p, ms: ms, module: module, site: site, method: fid, recv: recv, have: have, errs: errs)
		absent then panic("the conformance of {ast.typeName(ms.types, reads: p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has no method '{name}'")
		ambiguous(_, _) then panic("the conformance of {ast.typeName(ms.types, reads: p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has two methods '{name}'")
	end 'ofInterface'
end 'witnessFor'

// ownWitness is the method of the type recv's own that meets a requirement: a built-in one of a built-in generic type (an
// Array's equals) as it is, since a call through the bound lowers it in place (lowerBuiltinWitness), but for an array's
// equals that the library's elementwiseEquals is instead (ast.runsBuiltin), and any other at its instance for recv.
function ownWitness(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, method ast.FuncID, recv ast.TypeID, conformance diag.ModuleID, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	if not ast.runsBuiltin(p, ms: ms, t: recv, fid: method) 'library'
		match consumes ast.extensionMethod(p, ms: ms, from: conformance, owner: ast.extensionKey(p, ms: ms, t: recv).unwrap(), name: ast.elementwiseEquals) 'elementwise'
			found(fid) then return instantiateMethod(p, ms: ms, module: module, site: site, method: fid, recv: recv, errs: errs)
			absent then panic("the conformance of {ast.typeName(ms.types, reads: p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has no method '{ast.elementwiseEquals}'")
			ambiguous(_, _) then panic("the conformance of {ast.typeName(ms.types, reads: p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has two methods '{ast.elementwiseEquals}'")
		end 'elementwise'
	end 'library'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).intrinsic != ast.Intrinsic.intrNone 'builtIn'
		return table.Option.some(method)
	end 'builtIn'
	return instantiateMethod(p, ms: ms, module: module, site: site, method: method, recv: recv, errs: errs)
end 'ownWitness'

// instantiateExtension is the instance for the type recv, which implements the interfaces have, of a method that an
// extension of an interface adds.
function instantiateExtension(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, method ast.FuncID, recv ast.TypeID, have ast.TypeIDList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let args = ast.interfaceExtensionArgs(p, ms: ms, recv: recv, have: have, fid: method)
	return instantiateWith(p, ms: ms, module: module, site: site, origin: method, written: args, args: args, enclosing: ast.WitnessList.create(0), errs: errs)
end 'instantiateExtension'

// passedWitness is the module of the conformance that the code around a call was given for its type parameter param to an
// interface that is iface or extends it.
function passedWitness(p ast.Project, ms ast.ModuleState, enclosing ast.WitnessList, param ast.TypeID, iface ast.TypeID) returns diag.ModuleID
	let want = ast.originOf(ms.types, reads: p.types, t: iface)
	for i in 0 upto enclosing.count() 'each'
		if enclosing[i].paramTy == param and ast.reachesInterface(ms.types, reads: p.types, have: enclosing[i].ifaceTy, want: want) 'hit'
			return enclosing[i].module
		end 'hit'
	end 'each'
	panic("no conformance was given for {ast.typeName(ms.types, reads: p.types, t: param)} implements {ast.typeName(ms.types, reads: p.types, t: iface)}")
end 'passedWitness'

// instantiateWith is the instance of the generic origin at args, given a conformance for each of its bounds: where the call
// wrote a type parameter of the code around it (written), the conformance that code was given travels on, and for any other
// type argument it is the one that the module of the call sees. It is none after it refused a conformance the module does
// not see, or sees twice.
function instantiateWith(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, origin ast.FuncID, written ast.TypeIDList, args ast.TypeIDList, enclosing ast.WitnessList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let slots = ast.boundSlots(p, ms: ms, fn: origin)
	let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).generics)
	var witnesses = ast.WitnessList.create(0)
	for i in 0 upto slots.count() 'slots'
		let gi = indexOfParam(generics, param: slots[i].paramTy)
		let declared = slots[i].ifaceTy
		if ast.typeKind(ms.types, reads: p.types, t: written[gi]) == ast.TypeKind.typeParam 'passed'
			let passedIface = ast.substituteType(ms.types, reads: p.types, t: declared, params: generics, args: written)
			witnesses.push(ast.Witness.make(slots[i].paramTy, ifaceTy: declared, module: passedWitness(p, ms: ms, enclosing: enclosing, param: written[gi], iface: passedIface)))
			continue 'slots'
		end 'passed'
		let iface = ast.substituteType(ms.types, reads: p.types, t: declared, params: generics, args: args)
		if standsForInterface(p, ms: ms, t: args[gi]) 'interfaceValue'
			// A value of the interface meets the bound by its own table, which every call through the bound uses.
			witnesses.push(ast.Witness.make(slots[i].paramTy, ifaceTy: declared, module: ast.declaringModuleIn(ms.types, reads: p.types, t: args[gi])))
			continue 'slots'
		end 'interfaceValue'
		let argName = ast.typeName(ms.types, reads: p.types, t: args[gi])
		let ifaceName = ast.typeName(ms.types, reads: p.types, t: iface)
		let mark = errs.count()
		match consumes ast.conformanceSource(p, ms: ms, from: module, t: args[gi], iface: iface) 'source'
			found(c) then witnesses.push(ast.Witness.make(slots[i].paramTy, ifaceTy: declared, module: c.module))
			ambiguous(first, second) then pushInstanceError(p, module: module, site: site, code: diag.errAmbiguousConformance, message: ast.ambiguousConformanceText(p, from: module, typeName: argName, ifaceName: ifaceName, first: first, second: second), errs: errs)
			absent then pushInstanceError(p, module: module, site: site, code: diag.errBoundNotMet, message: "'{argName}' must implement {ifaceName} for '{funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: origin)}', but {ast.describeModule(p, modID: module)}, which makes this call, sees no declaration that says so: declare 'extension {argName} implements {ifaceName}' in it or in a module it names", errs: errs)
		end 'source'
		if errs.count() > mark 'unmet'
			return table.Option.none
		end 'unmet'
	end 'slots'
	if not requireOneConformance(p, ms: ms, module: module, site: site, origin: origin, args: args, witnesses: witnesses, errs: errs) 'diamond'
		return table.Option.none
	end 'diamond'
	return table.Option.some(ast.instantiateFunc(ms.funcs, funcReads: p.funcs, tt: ms.types, reads: p.types, origin: origin, args: args, witnesses: witnesses))
end 'instantiateWith'

// requireOneConformance refuses two bounds of one type parameter that both extend an interface where the type argument
// meets them by conformances of two modules: a call of a method of that interface through the bounds would find the
// methods each of those modules sees, and no order chooses between them.
function requireOneConformance(p ast.Project, ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, origin ast.FuncID, args ast.TypeIDList, witnesses ast.WitnessList, mutates errs diag.ErrorList) returns bool
	let generics = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).generics)
	for i in 0 upto witnesses.count() 'later'
		for j in 0 upto i 'earlier'
			let a = witnesses[j].clone()
			let b = witnesses[i].clone()
			if a.paramTy == b.paramTy and a.module != b.module and sharesInterface(ms.types, reads: p.types, a: a.ifaceTy, b: b.ifaceTy) 'diamond'
				let argName = ast.typeName(ms.types, reads: p.types, t: args[indexOfParam(generics, param: a.paramTy)])
				let message = "'{argName}' meets the bounds {ast.typeName(ms.types, reads: p.types, t: a.ifaceTy)} and {ast.typeName(ms.types, reads: p.types, t: b.ifaceTy)} of '{ast.typeName(ms.types, reads: p.types, t: a.paramTy)}' in '{funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: origin)}' by conformances of two modules, {ast.describeModule(p, modID: a.module)} and {ast.describeModule(p, modID: b.module)}, and both bounds extend one interface, whose methods each of them gives: declare both conformances in one module"
				pushInstanceError(p, module: module, site: site, code: diag.errAmbiguousConformance, message: message, errs: errs)
				return false
			end 'diamond'
		end 'earlier'
	end 'later'
	return true
end 'requireOneConformance'

// sharesInterface is whether the interfaces a and b are, or extend, one interface.
function sharesInterface(tt ast.TypeSlot, reads ast.TypeTable, a ast.TypeID, b ast.TypeID) returns bool
	let origin = ast.typeEntry(tt, reads: reads, t: a).effectiveOrigin()
	if ast.reachesInterface(tt, reads: reads, have: b, want: origin) 'reached'
		return true
	end 'reached'
	for i in 0 upto ast.typeEntry(tt, reads: reads, t: origin).conforms.count() 'parents'
		if sharesInterface(tt, reads: reads, a: ast.typeEntry(tt, reads: reads, t: origin).conforms[i], b: b) 'shared'
			return true
		end 'shared'
	end 'parents'
	return false
end 'sharesInterface'

function pushInstanceError(p ast.Project, module diag.ModuleID, site ast.NodeID, consumes code String, consumes message String, mutates errs diag.ErrorList)
	diag.pushSiteError(errs, code: code, message: message, module: module, offset: p.modules[ast.modIndex(module)].tree.reportStartOf(site))
end 'pushInstanceError'

// indexOfParam is where the type parameter param is among the generics of a function.
function indexOfParam(generics ast.TypeIDList, param ast.TypeID) returns Count
	for i in 0 upto generics.count() 'each'
		if generics[i] == param 'hit'
			return i
		end 'hit'
	end 'each'
	panic("a bound names a type parameter its function does not have")
end 'indexOfParam'

// instantiateMethod is a method of the type recv: itself, or for one of a generic type the instance for the type's
// arguments, with the conformances that the module of the call sees.
function instantiateMethod(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, method ast.FuncID, recv ast.TypeID, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: method).generics.count() == 0 'plain'
		return table.Option.some(method)
	end 'plain'
	let args = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: recv).typeArgs)
	return instantiateWith(p, ms: ms, module: module, site: site, origin: method, written: args, args: args, enclosing: ast.WitnessList.create(0), errs: errs)
end 'instantiateMethod'

// visitUses finds the instances that the calls a function records need, a for's calls of the iteration protocol among them,
// with the type parameters of the code bound and the conformances it was given.
function visitUses(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, fn ast.FuncID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	let node = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).nodeID
	var recorded = ast.NodeIDList.create(0)
	match consumes p.typings[ast.modIndex(module)].funcUses.get(node as Count) 'recorded'
		some(list) then recorded = list
		none then _ = 0
	end 'recorded'
	return visitSites(p, ms: ms, module: module, recorded: recorded, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, found: found, errs: errs)
end 'visitUses'

// visitSites finds the instances that the uses recorded at the sites of a module need. A site that reads a constant of
// another module stands for the calls of the constant's value, which is built where it is read: they are nodes of that
// module, and their instances are found there, as lowering makes them there (exprIn), with no type parameter bound, since
// a constant's value names none.
function visitSites(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, recorded ast.NodeIDList, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	for i in 0 upto recorded.count() 'each'
		let site = recorded[i]
		if not visitConstant(p, ms: ms, module: module, site: site, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, found: found, errs: errs) 'deepConstant'
			return false
		end 'deepConstant'
		if p.modules[ast.modIndex(module)].tree.kindOf(site) == ast.NodeKind.forStmt 'loop'
			let calls = iterationInfoAt(p, module: module, node: site).calls()
			for j in 0 upto calls.count() 'calls'
				if dispatchedInterface(p, ms: ms, info: calls[j], bindParams: bindParams, bindArgs: bindArgs) != ast.noType 'dispatched'
					continue 'calls'
				end 'dispatched'
				let target = resolveTarget(p, ms: ms, module: module, site: site, receiver: 0 as ast.NodeID, info: calls[j], bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs)
				if not noteInstance(p, ms: ms, module: module, site: site, target: target, found: found, errs: errs) 'deepLoop'
					return false
				end 'deepLoop'
			end 'calls'
			continue 'each'
		end 'loop'
		if p.typings[ast.modIndex(module)].hooks.has(site as Count) 'hook'
			// The part is recorded for its own call, if it is one, and again for the call its interpolation makes.
			let hook = hookInfoAt(p, module: module, node: site)
			if dispatchedInterface(p, ms: ms, info: hook, bindParams: bindParams, bindArgs: bindArgs) == ast.noType 'static'
				let target = resolveTarget(p, ms: ms, module: module, site: site, receiver: 0 as ast.NodeID, info: hook, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs)
				if not noteInstance(p, ms: ms, module: module, site: site, target: target, found: found, errs: errs) 'deepHook'
					return false
				end 'deepHook'
			end 'static'
		end 'hook'
		if p.modules[ast.modIndex(module)].tree.kindOf(site) == ast.NodeKind.whenStmt 'behaviour'
			requireCrossings(p, ms: ms, module: module, stmt: site, bindParams: bindParams, bindArgs: bindArgs, errs: errs)
			continue 'each'
		end 'behaviour'
		let boxed = ast.boxedTo(p.typings[ast.modIndex(module)], node: site)
		let boxedTy = ast.substituteType(ms.types, reads: p.types, t: exprType(p, module: module, node: site), params: bindParams, args: bindArgs)
		if boxed != ast.noType and not standsForInterface(p, ms: ms, t: boxedTy) 'box'
			if not noteTable(p, ms: ms, module: module, site: site, iface: boxed, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, found: found, errs: errs) 'deepTable'
				return false
			end 'deepTable'
		end 'box'
		if not p.typings[ast.modIndex(module)].calls.has(site as Count) 'notCall'
			continue 'each'
		end 'notCall'
		let info = callInfoAt(p, module: module, node: site)
		if not visitDefaults(p, ms: ms, module: module, info: info, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, found: found, errs: errs) 'deepDefault'
			return false
		end 'deepDefault'
		if info.intrinsic == ast.Intrinsic.intrFreeze or info.intrinsic == ast.Intrinsic.intrCown 'shared'
			requireShareable(p, ms: ms, module: module, site: site, info: info, bindParams: bindParams, bindArgs: bindArgs, errs: errs)
			continue 'each'
		end 'shared'
		if not runsFunction(info.kind) 'noFunction'
			continue 'each'
		end 'noFunction'
		if witnessInterface(p, ms: ms, module: module, receiver: ast.callReceiver(p.modules[ast.modIndex(module)].tree, e: site, kind: info.kind), info: info, bindParams: bindParams, bindArgs: bindArgs) != ast.noType 'dispatched'
			continue 'each'
		end 'dispatched'
		let target = resolveCall(p, ms: ms, module: module, node: site, info: info, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs)
		if not noteInstance(p, ms: ms, module: module, site: site, target: target, found: found, errs: errs) 'deep'
			return false
		end 'deep'
	end 'each'
	return true
end 'visitSites'

// visitConstant follows a site that reads a constant of another module, or one that is one for each instance of its generic
// type read through an instance, to the uses of the constant's value, and says whether the instances they need are
// finite: an instance's read binds the type's parameters to its arguments, as the reader's bindings give them. Any other
// site has none of its own here.
function visitConstant(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	if not p.typings[ast.modIndex(module)].names.has(site as Count) 'unnamed'
		return true
	end 'unnamed'
	let info = p.typings[ast.modIndex(module)].names.get(site as Count).unwrap()
	if info.kind != ast.NameKind.nameConst or info.decl.module == diag.stdlibID 'notConstant'
		return true
	end 'notConstant'
	let instance = p.typings[ast.modIndex(module)].staticInstances.get(site as Count)
	if info.decl.module == module and not instance.isSome() 'here'
		return true
	end 'here'
	let ref = info.decl.clone()
	let owner = ref.module
	var calls = ast.NodeIDList.create(0)
	match consumes p.typings[ast.modIndex(owner)].fieldUses.get(ast.constValueNode(p, ref: ref) as Count) 'uses'
		some(list) then calls = list
		none then return true
	end 'uses'
	if instance.isSome() 'perInstance'
		let origin = ast.declConst(p, ms: ms, ref: ref).unwrap().instanceOf
		let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: origin).typeParams)
		let written = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: instance.unwrap()).typeArgs)
		let args = applyAll(ms.types, reads: p.types, ts: written, params: bindParams, args: bindArgs)
		return visitSites(p, ms: ms, module: owner, recorded: calls, bindParams: params, bindArgs: args, bindWitnesses: bindWitnesses, found: found, errs: errs)
	end 'perInstance'
	let unbound = ast.TypeIDList.create(0)
	return visitSites(p, ms: ms, module: owner, recorded: calls, bindParams: unbound.clone(), bindArgs: unbound.clone(), bindWitnesses: ast.WitnessList.create(0), found: found, errs: errs)
end 'visitConstant'

// visitDefaults follows the defaults of the parameters that a call leaves out to the uses of each, in the module that
// declares the function, with its type parameters bound to the call's type arguments, as lowerDefault lowers them there.
function visitDefaults(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	for i in 0 upto info.ordered.count() 'each'
		if info.ordered[i] != 0 or info.paramSpecs[i].defaultExpr == 0 'given'
			continue 'each'
		end 'given'
		let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).module
		if owner == diag.stdlibID 'builtIn'
			continue 'each'
		end 'builtIn'
		var calls = ast.NodeIDList.create(0)
		match consumes p.typings[ast.modIndex(owner)].fieldUses.get(info.paramSpecs[i].defaultExpr as Count) 'defaultUses'
			some(list) then calls = list
			none then continue 'each'
		end 'defaultUses'
		let params = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).generics)
		let args = applyAll(ms.types, reads: p.types, ts: info.typeArgs, params: bindParams, args: bindArgs)
		if not visitSites(p, ms: ms, module: owner, recorded: calls, bindParams: params, bindArgs: args, bindWitnesses: bindWitnesses, found: found, errs: errs) 'deep'
			return false
		end 'deep'
	end 'each'
	return true
end 'visitDefaults'

// requireCrossings refuses, in an instance of generic code, a value that the behaviour stmt takes and that cannot cross to
// the thread that runs it at the instance's type arguments: the check judged every other capture where it was written.
function requireCrossings(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, stmt ast.NodeID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, mutates errs diag.ErrorList)
	let info = match consumes p.typings[ast.modIndex(module)].whens.get(stmt as Count) 'info'
		some(found) gives found
		none panic("a behaviour was recorded for its instances without a record of what it captures")
	end 'info'
	for i in 0 upto info.captures.count() 'captures'
		let written = p.typings[ast.modIndex(module)].locals[info.captures[i].outerLocal as Count].ty
		if not ast.mentionsTypeParam(ms.types, reads: p.types, t: written) 'judged'
			continue 'captures'
		end 'judged'
		let t = ast.substituteType(ms.types, reads: p.types, t: written, params: bindParams, args: bindArgs)
		let why = ast.unsendable(ms.types, reads: p.types, t: t)
		if why != "" 'refused'
			pushInstanceError(p, module: module, site: info.captures[i].refNode, code: diag.errBehaviourBorrow, message: ast.behaviourCrossingText(info.captures[i].name.clone(), why: why), errs: errs)
		end 'refused'
	end 'captures'
end 'requireCrossings'

// requireShareable refuses, in an instance of generic code, the value that a freeze or a cown at site is given when it
// cannot cross between threads at the instance's type arguments: the check judged every other such value where it was
// written (check.requireShareable).
function requireShareable(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, mutates errs diag.ErrorList)
	let arg = info.ordered[0]
	let t = ast.substituteType(ms.types, reads: p.types, t: exprType(p, module: module, node: arg), params: bindParams, args: bindArgs)
	let why = ast.unsendable(ms.types, reads: p.types, t: t)
	if why != "" 'refused'
		let name = ast.typeName(ms.types, reads: p.types, t: t)
		pushInstanceError(p, module: module, site: arg, code: diag.errValueNotShareable, message: ast.sharedCrossingText(name, why: why, frozen: info.intrinsic == ast.Intrinsic.intrFreeze), errs: errs)
	end 'refused'
end 'requireShareable'

// runsFunction is whether a call of the kind runs a function that can be an instance. A site is recorded for a use that
// is not the call itself, such as the value that is put in an interface value, which can be a union case or a copy.
function runsFunction(kind ast.CallKind) returns bool
	return match kind 'k'
		callFunction gives true
		callMethod gives true
		callStatic gives true
		callBound gives true
		callUnionCtor gives false
		callPrint gives false
		callPrintError gives false
		callCopy gives false
		callValue gives false
		callSend gives true
		callUnresolved panic("a call was recorded as a use before the check resolved it")
	end 'k'
end 'runsFunction'

// noteTable notes the instances that the methods of the table of a value boxed at site run.
function noteTable(p ast.Project, mutates ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, iface ast.TypeID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	let src = exprType(p, module: module, node: site)
	var methods = ast.FuncIDList.create(0)
	match consumes witnessTable(p, ms: ms, module: module, site: site, src: src, iface: iface, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs) 'table'
		some(t) then methods = t.methods
		none then return false
	end 'table'
	for i in 0 upto methods.count() 'methods'
		if not noteFound(p, ms: ms, module: module, site: site, target: methods[i], found: found, errs: errs) 'deep'
			return false
		end 'deep'
	end 'methods'
	return true
end 'noteTable'

// noteInstance adds the instance a call at site runs to those found, when it is a new one, and says whether its type
// arguments are finite. A target that is none was refused already.
function noteInstance(p ast.Project, ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, consumes target table.Option with ast.FuncID, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	if not target.isSome() 'refused'
		return false
	end 'refused'
	return noteFound(p, ms: ms, module: module, site: site, target: target.unwrap(), found: found, errs: errs)
end 'noteInstance'

function noteFound(p ast.Project, ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, target ast.FuncID, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).genericOrigin == ast.noFunc or found.has(target) 'known'
		return true
	end 'known'
	found.add(target)
	if not requireFinite(p, ms: ms, module: module, site: site, instance: target, errs: errs) 'deep'
		return false
	end 'deep'
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).module == diag.stdlibID 'std'
		panic("{funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: target)} is a generic of the standard library, which has no body to lower")
	end 'std'
	return true
end 'noteFound'

// findInstances finds the instances of generic functions that one module needs, which is the code that lowering has to
// make once for each, in that module's unit. It starts from the calls in the module's functions that are not generic, and
// follows the calls in each instance's body, whichever module declares the generic, with the instance's type arguments
// bound, until no new instance turns up. The result depends only on the module and on the generics it reaches, never on
// which other modules exist or what they use, so a module's output is the same in any project that gives its imports
// the same declarations. The instances are in the order they are found, so the result does not depend on how many
// modules lower at once.
//
// callers are the module's functions that call a generic or go through a bound, as the check pass recorded them.
export function findInstances(p ast.Project, mutates ms ast.ModuleState, callers ast.FuncIDList, mutates errs diag.ErrorList) returns InstanceSet
	var found = InstanceSet.new()
	let unbound = ast.TypeIDList.create(0)
	for i in 0 upto callers.count() 'callers'
		let fn = callers[i]
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).generics.count() == 0 'plain'
			let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).module
			if not visitUses(p, ms: ms, module: owner, fn: fn, bindParams: unbound.clone(), bindArgs: unbound.clone(), bindWitnesses: ast.WitnessList.create(0), found: found, errs: errs) 'deep'
				return found
			end 'deep'
		end 'plain'
	end 'callers'
	_ = followInstances(p, ms: ms, found: found, from: 0, errs: errs)
	return found
end 'findInstances'

// followInstances finds the instances that the instances of found from the one at from on need, and those that those need in
// turn, until no new one turns up. It is false where the type arguments of one grow without end, which errs then holds.
function followInstances(p ast.Project, mutates ms ast.ModuleState, mutates found InstanceSet, from Count, mutates errs diag.ErrorList) returns bool
	var next = from
	while next < found.list.count() 'follow'
		let instance = found.list[next]
		let origin = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: instance).genericOrigin
		let params = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).generics)
		let args = ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: instance).typeArgs)
		let owner = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).module
		let witnesses = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: instance).witnesses.clone()
		if not visitUses(p, ms: ms, module: owner, fn: origin, bindParams: params, bindArgs: args, bindWitnesses: witnesses, found: found, errs: errs) 'deep'
			return false
		end 'deep'
		next = succ(next)
	end 'follow'
	return true
end 'followInstances'

// instancesOf are the instances among fns, the functions that lowerModule lowered for a module: every one it found, which
// are the instances a function of the module calls when it is lowered again.
export function instancesOf(p ast.Project, ms ast.ModuleState, fns IrFunctionList) returns InstanceSet
	var found = InstanceSet.new()
	for i in 0 upto fns.count() 'functions'
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fns[i].decl).genericOrigin != ast.noFunc 'instance'
			found.add(fns[i].decl)
		end 'instance'
	end 'functions'
	return found
end 'instancesOf'

// requireFinite refuses an instance whose type arguments nest without end: a generic function that calls itself with a
// larger type each time would otherwise never run out of instances. Every module that reaches such an instance refuses it
// at the call that asks for the too deep one, so which module found it first does not matter.
function requireFinite(p ast.Project, ms ast.ModuleState, module diag.ModuleID, site ast.NodeID, instance ast.FuncID, mutates errs diag.ErrorList) returns bool
	let args = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: instance).typeArgs.clone()
	for i in 0 upto args.count() 'each'
		if typeDepth(ms.types, reads: p.types, t: args[i]) > ast.maxTypeDepth 'deep'
			let origin = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: instance).genericOrigin
			let message = "'{funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: origin)}' needs a type that nests more than {ast.maxTypeDepth} levels deep, so the generic grows its own type argument without end; pass the same type argument on, or end the recursion"
			diag.pushSiteError(errs, code: diag.errInstantiationTooDeep, message: message, module: module, offset: p.modules[ast.modIndex(module)].tree.startOf(site))
			return false
		end 'deep'
	end 'each'
	return true
end 'requireFinite'
