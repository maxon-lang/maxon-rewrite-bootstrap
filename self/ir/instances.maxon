// InstanceSet is the instances one module needs, in the order they were found.
export type InstanceSet
	export var list as ast.FuncIDList
	export var found as table.IntMap with bool

	export static function new() returns InstanceSet
		return InstanceSet{list: ast.FuncIDList.create(0), found: table.IntMap.new()}
	end 'new'

	// add notes an instance as found.
	export function add(mutates self, instance ast.FuncID)
		found.insert(instance as Count, value: true)
		list.push(instance)
	end 'add'

	// has is whether the module found the instance. A module that lowers a call of an instance it did not find would
	// depend on another module having made it, so lowering refuses it.
	export function has(instance ast.FuncID) returns bool
		return found.has(instance as Count)
	end 'has'
end 'InstanceSet'

// typeDepth is how deeply instances nest in t: a parameter or a plain type is 0, and Box with (Box with Count) is 2. A body
// that calls itself with a growing type argument has no end, which a limit on the depth finds.
export function typeDepth(tt ast.TypeTable, t ast.TypeID) returns Count
	let n = tt.entries[t as Count].typeArgs.count()
	if n == 0 'plain'
		return 0
	end 'plain'
	var deepest = 0 as Count
	for i in 0 upto n 'args'
		let d = typeDepth(tt, t: tt.entries[t as Count].typeArgs[i])
		if d > deepest 'deeper'
			deepest = d
		end 'deeper'
	end 'args'
	return succ(deepest)
end 'typeDepth'

// applyAll is the list with every type replaced by its argument, where the parameters are bound.
function applyAll(mutates tt ast.TypeTable, ts ast.TypeIDList, params ast.TypeIDList, args ast.TypeIDList) returns ast.TypeIDList
	var out = ast.TypeIDList.create(0)
	for i in 0 upto ts.count() 'each'
		out.push(ast.substituteType(tt, t: ts[i], params: params, args: args))
	end 'each'
	return out
end 'applyAll'

// resolveCall is the function a call runs once the type parameters of the code it is in are bound: the target itself, or
// the instance of a generic one, or for a call through a bound the method of the type that stands in for the parameter.
// bindWitnesses are the conformances that the code around the call was given. It is none after it refused an instance
// whose conformance the module of the call does not see.
export function resolveCall(mutates p ast.Project, module diag.ModuleID, node ast.NodeID, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	return resolveTarget(p, module: module, site: node, receiver: ast.callReceiver(p.modules[ast.modIndex(module)].tree, e: node, kind: info.kind), info: info, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs)
end 'resolveCall'

// resolveTarget is resolveCall for a call at site whose object is already known.
export function resolveTarget(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, receiver ast.NodeID, info ast.CallInfo, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	if info.kind == ast.CallKind.callFunction or info.kind == ast.CallKind.callStatic or info.kind == ast.CallKind.callMethod 'direct'
		if p.funcs.entries[info.fn as Count].generics.count() == 0 'plain'
			return table.Option.some(info.fn)
		end 'plain'
		let args = applyAll(p.types, ts: info.typeArgs, params: bindParams, args: bindArgs)
		return instantiateWith(p, module: module, site: site, origin: info.fn, written: info.typeArgs, args: args, enclosing: bindWitnesses, errs: errs)
	end 'direct'
	if info.kind == ast.CallKind.callBound 'bound'
		// A frozen receiver lends its contents, so the method is the one of the type it holds.
		let received = ast.substituteType(p.types, t: exprType(p, module: module, node: receiver), params: bindParams, args: bindArgs)
		let recv = ast.contentType(p.types, t: received)
		let origin = p.types.entries[recv as Count].effectiveOrigin()
		let name = p.funcs.entries[info.method as Count].name.clone()
		if p.types.entries[origin as Count].findMethod(name).isSome() 'own'
			return witnessFor(p, module: module, site: site, recv: recv, name: name, conformance: module, errs: errs)
		end 'own'
		let param = ast.contentType(p.types, t: info.receiverTy)
		let conformance = passedWitness(p, enclosing: bindWitnesses, param: param, iface: p.funcs.entries[info.method as Count].ownerTy)
		return witnessFor(p, module: module, site: site, recv: recv, name: name, conformance: conformance, errs: errs)
	end 'bound'
	panic("call kind {info.kind.name} has no function to resolve")
end 'resolveTarget'

// witnessFor is the method of that name that meets a requirement for the type recv: the type's own, or else the one that
// an extension of the type adds where the module of the conformance sees it, as an instance for a generic type's
// arguments, or else the instance for recv of the one that an extension of an interface it implements adds there.
function witnessFor(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, recv ast.TypeID, name String, conformance diag.ModuleID, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let origin = p.types.entries[recv as Count].effectiveOrigin()
	match consumes p.types.entries[origin as Count].findMethod(name) 'found'
		some(method) then return instantiateMethod(p, module: module, site: site, method: method, recv: recv, errs: errs)
		none then _ = 0
	end 'found'
	let key = ast.extensionKey(p, t: recv)
	if key.isSome() 'extensions'
		match consumes ast.extensionMethod(p, from: conformance, owner: key.unwrap(), name: name) 'ofType'
			found(fid) then return instantiateMethod(p, module: module, site: site, method: fid, recv: recv, errs: errs)
			absent then _ = 0
			ambiguous(_, _) then panic("the conformance of {ast.typeName(p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has two methods '{name}'")
		end 'ofType'
	end 'extensions'
	let have = ast.seenInterfaces(p, from: conformance, t: recv)
	match consumes ast.interfaceExtensionMethod(p, from: conformance, have: have, name: name) 'ofInterface'
		found(fid) then return instantiateExtension(p, module: module, site: site, method: fid, recv: recv, have: have, errs: errs)
		absent then panic("the conformance of {ast.typeName(p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has no method '{name}'")
		ambiguous(_, _) then panic("the conformance of {ast.typeName(p.types, t: recv)} in {ast.describeModule(p, modID: conformance)} has two methods '{name}'")
	end 'ofInterface'
end 'witnessFor'

// instantiateExtension is the instance for the type recv, which implements the interfaces have, of a method that an
// extension of an interface adds.
function instantiateExtension(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, method ast.FuncID, recv ast.TypeID, have ast.TypeIDList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let args = ast.interfaceExtensionArgs(p, recv: recv, have: have, fid: method)
	return instantiateWith(p, module: module, site: site, origin: method, written: args, args: args, enclosing: ast.WitnessList.create(0), errs: errs)
end 'instantiateExtension'

// passedWitness is the module of the conformance that the code around a call was given for its type parameter param to an
// interface that is iface or extends it.
function passedWitness(p ast.Project, enclosing ast.WitnessList, param ast.TypeID, iface ast.TypeID) returns diag.ModuleID
	let want = ast.originOf(p.types, t: iface)
	for i in 0 upto enclosing.count() 'each'
		if enclosing[i].paramTy == param and ast.reachesInterface(p.types, have: enclosing[i].ifaceTy, want: want) 'hit'
			return enclosing[i].module
		end 'hit'
	end 'each'
	panic("no conformance was given for {ast.typeName(p.types, t: param)} implements {ast.typeName(p.types, t: iface)}")
end 'passedWitness'

// instantiateWith is the instance of the generic origin at args, given a conformance for each of its bounds: where the call
// wrote a type parameter of the code around it (written), the conformance that code was given travels on, and for any other
// type argument it is the one that the module of the call sees. It is none after it refused a conformance the module does
// not see, or sees twice.
function instantiateWith(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, origin ast.FuncID, written ast.TypeIDList, args ast.TypeIDList, enclosing ast.WitnessList, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	let slots = ast.boundSlots(p, fn: origin)
	let generics = ast.cloneTypeArgs(p.funcs.entries[origin as Count].generics)
	var witnesses = ast.WitnessList.create(0)
	for i in 0 upto slots.count() 'slots'
		let gi = indexOfParam(generics, param: slots[i].paramTy)
		let declared = slots[i].ifaceTy
		if p.types.entries[written[gi] as Count].kind == ast.TypeKind.typeParam 'passed'
			let passedIface = ast.substituteType(p.types, t: declared, params: generics, args: written)
			witnesses.push(ast.Witness.make(slots[i].paramTy, ifaceTy: declared, module: passedWitness(p, enclosing: enclosing, param: written[gi], iface: passedIface)))
			continue 'slots'
		end 'passed'
		let iface = ast.substituteType(p.types, t: declared, params: generics, args: args)
		if standsForInterface(p, t: args[gi]) 'interfaceValue'
			// A value of the interface meets the bound by its own table, which every call through the bound uses.
			witnesses.push(ast.Witness.make(slots[i].paramTy, ifaceTy: declared, module: ast.declaringModule(p, t: args[gi])))
			continue 'slots'
		end 'interfaceValue'
		let argName = ast.typeName(p.types, t: args[gi])
		let ifaceName = ast.typeName(p.types, t: iface)
		let mark = errs.count()
		match consumes ast.conformanceSource(p, from: module, t: args[gi], iface: iface) 'source'
			found(c) then witnesses.push(ast.Witness.make(slots[i].paramTy, ifaceTy: declared, module: c.module))
			ambiguous(first, second) then pushInstanceError(p, module: module, site: site, code: diag.errAmbiguousConformance, message: ast.ambiguousConformanceText(p, from: module, typeName: argName, ifaceName: ifaceName, first: first, second: second), errs: errs)
			absent then pushInstanceError(p, module: module, site: site, code: diag.errBoundNotMet, message: "'{argName}' must implement {ifaceName} for '{funcSymbol(p, fid: origin)}', but {ast.describeModule(p, modID: module)}, which makes this call, sees no declaration that says so: declare 'extension {argName} implements {ifaceName}' in it or in a module it names", errs: errs)
		end 'source'
		if errs.count() > mark 'unmet'
			return table.Option.none
		end 'unmet'
	end 'slots'
	if not requireOneConformance(p, module: module, site: site, origin: origin, args: args, witnesses: witnesses, errs: errs) 'diamond'
		return table.Option.none
	end 'diamond'
	return table.Option.some(ast.instantiateFunc(p.funcs, tt: p.types, origin: origin, args: args, witnesses: witnesses))
end 'instantiateWith'

// requireOneConformance refuses two bounds of one type parameter that both extend an interface where the type argument
// meets them by conformances of two modules: a call of a method of that interface through the bounds would find the
// methods each of those modules sees, and no order chooses between them.
function requireOneConformance(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, origin ast.FuncID, args ast.TypeIDList, witnesses ast.WitnessList, mutates errs diag.ErrorList) returns bool
	let generics = ast.cloneTypeArgs(p.funcs.entries[origin as Count].generics)
	for i in 0 upto witnesses.count() 'later'
		for j in 0 upto i 'earlier'
			let a = witnesses[j].clone()
			let b = witnesses[i].clone()
			if a.paramTy == b.paramTy and a.module != b.module and sharesInterface(p.types, a: a.ifaceTy, b: b.ifaceTy) 'diamond'
				let argName = ast.typeName(p.types, t: args[indexOfParam(generics, param: a.paramTy)])
				let message = "'{argName}' meets the bounds {ast.typeName(p.types, t: a.ifaceTy)} and {ast.typeName(p.types, t: b.ifaceTy)} of '{ast.typeName(p.types, t: a.paramTy)}' in '{funcSymbol(p, fid: origin)}' by conformances of two modules, {ast.describeModule(p, modID: a.module)} and {ast.describeModule(p, modID: b.module)}, and both bounds extend one interface, whose methods each of them gives: declare both conformances in one module"
				pushInstanceError(p, module: module, site: site, code: diag.errAmbiguousConformance, message: message, errs: errs)
				return false
			end 'diamond'
		end 'earlier'
	end 'later'
	return true
end 'requireOneConformance'

// sharesInterface is whether the interfaces a and b are, or extend, one interface.
function sharesInterface(tt ast.TypeTable, a ast.TypeID, b ast.TypeID) returns bool
	let origin = tt.entries[a as Count].effectiveOrigin()
	if ast.reachesInterface(tt, have: b, want: origin) 'reached'
		return true
	end 'reached'
	for i in 0 upto tt.entries[origin as Count].conforms.count() 'parents'
		if sharesInterface(tt, a: tt.entries[origin as Count].conforms[i], b: b) 'shared'
			return true
		end 'shared'
	end 'parents'
	return false
end 'sharesInterface'

function pushInstanceError(p ast.Project, module diag.ModuleID, site ast.NodeID, consumes code String, consumes message String, mutates errs diag.ErrorList)
	diag.pushSiteError(errs, code: code, message: message, module: module, offset: p.modules[ast.modIndex(module)].tree.reportStartOf(site))
end 'pushInstanceError'

// indexOfParam is where the type parameter param is among the generics of a function.
function indexOfParam(generics ast.TypeIDList, param ast.TypeID) returns Count
	for i in 0 upto generics.count() 'each'
		if generics[i] == param 'hit'
			return i
		end 'hit'
	end 'each'
	panic("a bound names a type parameter its function does not have")
end 'indexOfParam'

// instantiateMethod is a method of the type recv: itself, or for one of a generic type the instance for the type's
// arguments, with the conformances that the module of the call sees.
function instantiateMethod(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, method ast.FuncID, recv ast.TypeID, mutates errs diag.ErrorList) returns table.Option with ast.FuncID
	if p.funcs.entries[method as Count].generics.count() == 0 'plain'
		return table.Option.some(method)
	end 'plain'
	let args = ast.cloneTypeArgs(p.types.entries[recv as Count].typeArgs)
	return instantiateWith(p, module: module, site: site, origin: method, written: args, args: args, enclosing: ast.WitnessList.create(0), errs: errs)
end 'instantiateMethod'

// visitUses finds the instances that the calls a function records need, a for's calls of the iteration protocol among them,
// with the type parameters of the code bound and the conformances it was given.
function visitUses(mutates p ast.Project, module diag.ModuleID, fn ast.FuncID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	let node = p.funcs.entries[fn as Count].nodeID
	var recorded = ast.NodeIDList.create(0)
	match consumes p.typings[ast.modIndex(module)].funcUses.get(node as Count) 'recorded'
		some(list) then recorded = list
		none then _ = 0
	end 'recorded'
	for i in 0 upto recorded.count() 'each'
		let site = recorded[i]
		if p.modules[ast.modIndex(module)].tree.kindOf(site) == ast.NodeKind.forStmt 'loop'
			let calls = iterationInfoAt(p, module: module, node: site).calls()
			for j in 0 upto calls.count() 'calls'
				let target = resolveTarget(p, module: module, site: site, receiver: 0 as ast.NodeID, info: calls[j], bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs)
				if not noteInstance(p, module: module, site: site, target: target, found: found, errs: errs) 'deepLoop'
					return false
				end 'deepLoop'
			end 'calls'
			continue 'each'
		end 'loop'
		let boxed = ast.boxedTo(p.typings[ast.modIndex(module)], node: site)
		let boxedTy = ast.substituteType(p.types, t: exprType(p, module: module, node: site), params: bindParams, args: bindArgs)
		if boxed != ast.noType and not standsForInterface(p, t: boxedTy) 'box'
			if not noteTable(p, module: module, site: site, iface: boxed, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, found: found, errs: errs) 'deepTable'
				return false
			end 'deepTable'
		end 'box'
		if not p.typings[ast.modIndex(module)].calls.has(site as Count) 'notCall'
			continue 'each'
		end 'notCall'
		let info = callInfoAt(p, module: module, node: site)
		if not runsFunction(info.kind) 'noFunction'
			continue 'each'
		end 'noFunction'
		if witnessInterface(p, module: module, receiver: ast.callReceiver(p.modules[ast.modIndex(module)].tree, e: site, kind: info.kind), info: info, bindParams: bindParams, bindArgs: bindArgs) != ast.noType 'dispatched'
			continue 'each'
		end 'dispatched'
		let target = resolveCall(p, module: module, node: site, info: info, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs)
		if not noteInstance(p, module: module, site: site, target: target, found: found, errs: errs) 'deep'
			return false
		end 'deep'
	end 'each'
	return true
end 'visitUses'

// runsFunction is whether a call of the kind runs a function that can be an instance. A site is recorded for a use that
// is not the call itself, such as the value that is put in an interface value, which can be a union case or a copy.
function runsFunction(kind ast.CallKind) returns bool
	return match kind 'k'
		callFunction gives true
		callMethod gives true
		callStatic gives true
		callBound gives true
		callUnionCtor gives false
		callPrint gives false
		callPrintError gives false
		callCopy gives false
		callValue gives false
		callUnresolved panic("a call was recorded as a use before the check resolved it")
	end 'k'
end 'runsFunction'

// noteTable notes the instances that the methods of the table of a value boxed at site run.
function noteTable(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, iface ast.TypeID, bindParams ast.TypeIDList, bindArgs ast.TypeIDList, bindWitnesses ast.WitnessList, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	let src = exprType(p, module: module, node: site)
	var methods = ast.FuncIDList.create(0)
	match consumes witnessTable(p, module: module, site: site, src: src, iface: iface, bindParams: bindParams, bindArgs: bindArgs, bindWitnesses: bindWitnesses, errs: errs) 'table'
		some(t) then methods = t.methods
		none then return false
	end 'table'
	for i in 0 upto methods.count() 'methods'
		if not noteFound(p, module: module, site: site, target: methods[i], found: found, errs: errs) 'deep'
			return false
		end 'deep'
	end 'methods'
	return true
end 'noteTable'

// noteInstance adds the instance a call at site runs to those found, when it is a new one, and says whether its type
// arguments are finite. A target that is none was refused already.
function noteInstance(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, consumes target table.Option with ast.FuncID, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	if not target.isSome() 'refused'
		return false
	end 'refused'
	return noteFound(p, module: module, site: site, target: target.unwrap(), found: found, errs: errs)
end 'noteInstance'

function noteFound(mutates p ast.Project, module diag.ModuleID, site ast.NodeID, target ast.FuncID, mutates found InstanceSet, mutates errs diag.ErrorList) returns bool
	if p.funcs.entries[target as Count].genericOrigin == ast.noFunc or found.has(target) 'known'
		return true
	end 'known'
	found.add(target)
	if not requireFinite(p, module: module, site: site, instance: target, errs: errs) 'deep'
		return false
	end 'deep'
	if p.funcs.entries[target as Count].module == diag.stdlibID 'std'
		panic("{funcSymbol(p, fid: target)} is a generic of the standard library, which has no body to lower")
	end 'std'
	return true
end 'noteFound'

// findInstances finds the instances of generic functions that one module needs, which is the code that lowering has to
// make once for each, in that module's unit. It starts from the calls in the module's functions that are not generic, and
// follows the calls in each instance's body, whichever module declares the generic, with the instance's type arguments
// bound, until no new instance turns up. The result depends only on the module and on the generics it reaches, never on
// which other modules exist or what they use, so a module's output is the same in any project that gives its imports
// the same declarations. The instances are in the order they are found, so the result does not depend on how many
// modules lower at once.
//
// callers are the module's functions that call a generic or go through a bound, as the check pass recorded them.
export function findInstances(mutates p ast.Project, callers ast.FuncIDList, mutates errs diag.ErrorList) returns InstanceSet
	var found = InstanceSet.new()
	let unbound = ast.TypeIDList.create(0)
	for i in 0 upto callers.count() 'callers'
		let fn = callers[i]
		if p.funcs.entries[fn as Count].generics.count() == 0 'plain'
			let owner = p.funcs.entries[fn as Count].module
			if not visitUses(p, module: owner, fn: fn, bindParams: unbound.clone(), bindArgs: unbound.clone(), bindWitnesses: ast.WitnessList.create(0), found: found, errs: errs) 'deep'
				return found
			end 'deep'
		end 'plain'
	end 'callers'
	var next = 0 as Count
	while next < found.list.count() 'follow'
		let instance = found.list[next]
		let origin = p.funcs.entries[instance as Count].genericOrigin
		let params = ast.cloneTypeArgs(p.funcs.entries[origin as Count].generics)
		let args = ast.cloneTypeArgs(p.funcs.entries[instance as Count].typeArgs)
		let owner = p.funcs.entries[origin as Count].module
		let witnesses = p.funcs.entries[instance as Count].witnesses.clone()
		if not visitUses(p, module: owner, fn: origin, bindParams: params, bindArgs: args, bindWitnesses: witnesses, found: found, errs: errs) 'deep'
			return found
		end 'deep'
		next = succ(next)
	end 'follow'
	return found
end 'findInstances'

// requireFinite refuses an instance whose type arguments nest without end: a generic function that calls itself with a
// larger type each time would otherwise never run out of instances. Every module that reaches such an instance refuses it
// at the call that asks for the too deep one, so which module found it first does not matter.
function requireFinite(p ast.Project, module diag.ModuleID, site ast.NodeID, instance ast.FuncID, mutates errs diag.ErrorList) returns bool
	let args = p.funcs.entries[instance as Count].typeArgs.clone()
	for i in 0 upto args.count() 'each'
		if typeDepth(p.types, t: args[i]) > ast.maxTypeDepth 'deep'
			let origin = p.funcs.entries[instance as Count].genericOrigin
			let message = "'{funcSymbol(p, fid: origin)}' needs a type that nests more than {ast.maxTypeDepth} levels deep, so the generic grows its own type argument without end; pass the same type argument on, or end the recursion"
			diag.pushSiteError(errs, code: diag.errInstantiationTooDeep, message: message, module: module, offset: p.modules[ast.modIndex(module)].tree.startOf(site))
			return false
		end 'deep'
	end 'each'
	return true
end 'requireFinite'
