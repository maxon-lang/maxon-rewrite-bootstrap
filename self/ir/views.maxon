// The lowering of the views of a string (bytes, code points and UTF-16 code units) and of the iterators that walk them. A
// view holds a copy of the string it reads; an iterator holds a copy and the position of the unit it is at, and is made
// only where there is a unit, so that its current() always has one. The code points and the UTF-16 units are the runtime's
// (runtime/textops.maxon).
//
// A call of an iterator method is lowered in place, whether the program writes it or a for walks the iteration protocol.
// Where a for walks it, a method that has no unit to give does not throw: the loop is over, and exit is the block after it.
// Where a program calls it, exit is noBlock and the method throws IterationError as any other does.

// loadText is the string that a view or an iterator holds, which they own.
function loadText(mutates l Lowerer, obj Reg, field Count) returns Reg
	let d = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newLoadField(d, obj: obj, offset: fieldOffset(field, tagged: false)))
	return d
end 'loadText'

function loadPosition(mutates l Lowerer, obj Reg, field Count) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadField(d, obj: obj, offset: fieldOffset(field, tagged: false)))
	return d
end 'loadPosition'

// continueIf goes on where cond holds. Where it does not, an iterator method that a program calls fails with exhausted, and
// one that a for calls ends the loop.
function continueIf(mutates l Lowerer, mutates p ast.Project, cond Reg, exit BlockID)
	if exit == noBlock 'throws'
		failUnless(l, p: p, cond: cond, errorCase: ast.errorIterationExhausted)
		return
	end 'throws'
	let ok = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: ok, ifFalse: exit))
	l.cur = ok
end 'continueIf'

// makeView is the view, of type t, of a copy of the string recv.
function makeView(mutates l Lowerer, mutates p ast.Project, site diag.Site, t ast.TypeID, recv Reg) returns Reg
	let string = p.builtins.stringTy
	let text = copyValue(l, p: p, site: site, v: recv, t: string)
	return builtinRecord(l, p: p, t: t, values: argsOf1(text))
end 'makeView'

// makeIterator is the iterator, of type t, over a copy of the string that a view holds, at its first unit, which the string
// must have.
function makeIterator(mutates l Lowerer, mutates p ast.Project, site diag.Site, t ast.TypeID, view Reg, textField Count, exit BlockID) returns Reg
	let held = loadText(l, obj: view, field: textField)
	let size = runtime(l, symbol: Rt.rtStrLen, kind: IrKind.kindScalar, args: argsOf1(held))
	let present = nonZero(l, v: size)
	continueIf(l, p: p, cond: present, exit: exit)
	let string = p.builtins.stringTy
	let text = copyValue(l, p: p, site: site, v: held, t: string)
	let start = konst(l, value: 0 as Word)
	var fields = RegList.create(0)
	fields.push(text)
	fields.push(start)
	return builtinRecord(l, p: p, t: t, values: fields)
end 'makeIterator'

// readUnit is the unit that an iterator is at, which the entry reads from the string and the position.
function readUnit(mutates l Lowerer, iterator Reg, textField Count, positionField Count, symbol Rt) returns Reg
	let text = loadText(l, obj: iterator, field: textField)
	let position = loadPosition(l, obj: iterator, field: positionField)
	return runtime(l, symbol: symbol, kind: IrKind.kindScalar, args: argsOf2(text, b: position))
end 'readUnit'

function setPosition(mutates l Lowerer, iterator Reg, positionField Count, position Reg)
	emit(l, i: newStoreField(iterator, offset: fieldOffset(positionField, tagged: false), src: position))
end 'setPosition'

// stepOn sets the position of an iterator to the one that a step entry gave, which is the position plus 1, or 0 where there
// is no next unit and the iterator is exhausted.
function stepOn(mutates l Lowerer, mutates p ast.Project, iterator Reg, textField Count, positionField Count, symbol Rt, exit BlockID) returns Reg
	let text = loadText(l, obj: iterator, field: textField)
	let position = loadPosition(l, obj: iterator, field: positionField)
	let step = runtime(l, symbol: symbol, kind: IrKind.kindScalar, args: argsOf2(text, b: position))
	let present = nonZero(l, v: step)
	continueIf(l, p: p, cond: present, exit: exit)
	let one = konst(l, value: 1 as Word)
	let next = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(next, op: BinOp.binSub, left: step, right: one, unsigned: true, fail: noBlock))
	setPosition(l, iterator: iterator, positionField: positionField, position: next)
	return konst(l, value: 0 as Word)
end 'stepOn'

// byteStep moves on to the next byte, which is there where the position plus 1 is below the length.
function byteStep(mutates l Lowerer, mutates p ast.Project, iterator Reg, exit BlockID) returns Reg
	let text = loadText(l, obj: iterator, field: ast.byteIteratorTextField)
	let position = loadPosition(l, obj: iterator, field: ast.byteIteratorPositionField)
	let one = konst(l, value: 1 as Word)
	let next = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newBin(next, op: BinOp.binAdd, left: position, right: one, unsigned: true, fail: noBlock))
	let size = runtime(l, symbol: Rt.rtStrLen, kind: IrKind.kindScalar, args: argsOf1(text))
	let more = compare(l, op: CmpOp.cmpLt, a: next, b: size, unsigned: true)
	continueIf(l, p: p, cond: more, exit: exit)
	setPosition(l, iterator: iterator, positionField: ast.byteIteratorPositionField, position: next)
	return konst(l, value: 0 as Word)
end 'byteStep'

// viewCount is the number of units of the string that a view holds.
function viewCount(mutates l Lowerer, view Reg, textField Count, symbol Rt) returns Reg
	let text = loadText(l, obj: view, field: textField)
	return runtime(l, symbol: symbol, kind: IrKind.kindScalar, args: argsOf1(text))
end 'viewCount'

// lowerViewMethod lowers the method of a view or an iterator that the intrinsic op is, on recv. t is the type of the value
// that a method that makes one gives.
function lowerViewMethod(mutates l Lowerer, mutates p ast.Project, op ast.Intrinsic, site diag.Site, t ast.TypeID, recv Reg, exit BlockID) returns Reg
	if op == ast.Intrinsic.intrStringBytes or op == ast.Intrinsic.intrStringCodepoints or op == ast.Intrinsic.intrStringUtf16 'view'
		return makeView(l, p: p, site: site, t: t, recv: recv)
	end 'view'
	if op == ast.Intrinsic.intrByteViewCreateIterator 'byteIterator'
		return makeIterator(l, p: p, site: site, t: t, view: recv, textField: ast.byteViewTextField, exit: exit)
	end 'byteIterator'
	if op == ast.Intrinsic.intrCodepointViewCreateIterator 'codepointIterator'
		return makeIterator(l, p: p, site: site, t: t, view: recv, textField: ast.codepointViewTextField, exit: exit)
	end 'codepointIterator'
	if op == ast.Intrinsic.intrUtf16ViewCreateIterator 'utf16Iterator'
		return makeIterator(l, p: p, site: site, t: t, view: recv, textField: ast.utf16ViewTextField, exit: exit)
	end 'utf16Iterator'
	if op == ast.Intrinsic.intrByteViewCount 'byteCount'
		return viewCount(l, view: recv, textField: ast.byteViewTextField, symbol: Rt.rtStrLen)
	end 'byteCount'
	if op == ast.Intrinsic.intrCodepointViewCount 'codepointCount'
		return viewCount(l, view: recv, textField: ast.codepointViewTextField, symbol: Rt.rtStrCodePointCount)
	end 'codepointCount'
	if op == ast.Intrinsic.intrUtf16ViewCount 'utf16Count'
		return viewCount(l, view: recv, textField: ast.utf16ViewTextField, symbol: Rt.rtStrUtf16Count)
	end 'utf16Count'
	if op == ast.Intrinsic.intrByteIteratorCurrent 'byteCurrent'
		return readUnit(l, iterator: recv, textField: ast.byteIteratorTextField, positionField: ast.byteIteratorPositionField, symbol: Rt.rtStrByteAt)
	end 'byteCurrent'
	if op == ast.Intrinsic.intrCodepointIteratorCurrent 'codepointCurrent'
		return readUnit(l, iterator: recv, textField: ast.codepointIteratorTextField, positionField: ast.codepointIteratorPositionField, symbol: Rt.rtStrCodePointAt)
	end 'codepointCurrent'
	if op == ast.Intrinsic.intrUtf16IteratorCurrent 'utf16Current'
		return readUnit(l, iterator: recv, textField: ast.utf16IteratorTextField, positionField: ast.utf16IteratorPositionField, symbol: Rt.rtStrUtf16Unit)
	end 'utf16Current'
	if op == ast.Intrinsic.intrByteIteratorAdvance 'byteAdvance'
		return byteStep(l, p: p, iterator: recv, exit: exit)
	end 'byteAdvance'
	if op == ast.Intrinsic.intrCodepointIteratorAdvance 'codepointAdvance'
		return stepOn(l, p: p, iterator: recv, textField: ast.codepointIteratorTextField, positionField: ast.codepointIteratorPositionField, symbol: Rt.rtStrCodePointNext, exit: exit)
	end 'codepointAdvance'
	if op == ast.Intrinsic.intrUtf16IteratorAdvance 'utf16Advance'
		return stepOn(l, p: p, iterator: recv, textField: ast.utf16IteratorTextField, positionField: ast.utf16IteratorPositionField, symbol: Rt.rtStrUtf16Next, exit: exit)
	end 'utf16Advance'
	panic("lower: {op} is no method of a view or an iterator")
end 'lowerViewMethod'

// lowerViewCall lowers a call that the program writes of a method of a view or an iterator.
function lowerViewCall(mutates l Lowerer, mutates p ast.Project, c CallSite, recv Reg) returns Reg
	let op = p.funcs.entries[c.info.fn as Count].intrinsic
	return lowerViewMethod(l, p: p, op: op, site: siteOf(l, p: p, node: c.node), t: exprType(p, module: l.module, node: c.node), recv: recv, exit: noBlock)
end 'lowerViewCall'

function lowerStringBytes(mutates l Lowerer, mutates p ast.Project, c CallSite, recv Reg, args RegList) returns Reg
	return lowerViewCall(l, p: p, c: c, recv: recv)
end 'lowerStringBytes'

function lowerStringCodepoints(mutates l Lowerer, mutates p ast.Project, c CallSite, recv Reg, args RegList) returns Reg
	return lowerViewCall(l, p: p, c: c, recv: recv)
end 'lowerStringCodepoints'

function lowerStringUtf16(mutates l Lowerer, mutates p ast.Project, c CallSite, recv Reg, args RegList) returns Reg
	return lowerViewCall(l, p: p, c: c, recv: recv)
end 'lowerStringUtf16'

function lowerByteViewCreateIterator(mutates l Lowerer, mutates p ast.Project, c CallSite, recv Reg, args RegList) returns Reg
