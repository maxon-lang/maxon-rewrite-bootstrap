let dropEmptyMessage = "dropEmpty of a collection that still holds an element"

let interpreterOnlyMessage = "a list or a pool runs only under the interpreter for now, and the compiler has no code for it; use an array, or run the program with the interpreter"

// entry calls a runtime entry of a primitive that returns a value. site is the source that needs it, kept when the
// backend has no code for the entry.
function entry(mutates l Lowerer, p ast.Project, site diag.Site, symbol Rt, kind IrKind, args RegList) returns Reg
	let d = newReg(l, kind: resultKind(symbol, kind: kind))
	emitEntry(l, p: p, site: site, dst: d, symbol: symbol, args: args, routine: ast.noFunc)
	return d
end 'entry'

// entryVoid calls a runtime entry that returns nothing.
function entryVoid(mutates l Lowerer, p ast.Project, site diag.Site, symbol Rt, args RegList)
	emitEntry(l, p: p, site: site, dst: noReg, symbol: symbol, args: args, routine: ast.noFunc)
end 'entryVoid'

// elementEntry calls an entry that reads or addresses one element, proven where the index is proved inside the collection
// (not checked).
function elementEntry(mutates l Lowerer, p ast.Project, site diag.Site, symbol Rt, args RegList, checked bool) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	noteEntry(l, site: site, symbol: symbol)
	let instr = l.b.callRuntime(d, symbol: symbol, args: args, routine: ast.noFunc, proven: not checked)
	emit(l, i: instr)
	return d
end 'elementEntry'

function emitEntry(mutates l Lowerer, p ast.Project, site diag.Site, dst Reg, symbol Rt, args RegList, routine ast.FuncID)
	noteEntry(l, site: site, symbol: symbol)
	emitCallRuntime(l, dst: dst, symbol: symbol, args: args, routine: routine)
end 'emitEntry'

// noteEntry records which part of the runtime a call of the entry symbol needs, or refuses one the backend has no code
// for.
function noteEntry(mutates l Lowerer, site diag.Site, symbol Rt)
	let unit = rtUnit(symbol)
	if unit == RtUnit.rtUnitOs 'os'
		l.b.f.usesOs = true
	end 'os' else if unit == RtUnit.rtUnitBytes 'bytes'
		l.b.f.usesBytes = true
	end 'bytes' else if unit == RtUnit.rtUnitArrays 'arrays'
		l.b.f.usesArrays = true
	end 'arrays' else if unit == RtUnit.rtUnitInterpreter 'interpreter'
		refuse(l, site: site, code: diag.errInterpreterOnly, message: interpreterOnlyMessage)
	end 'interpreter' else if unit == RtUnit.rtUnitRuntime or unit == RtUnit.rtUnitLinker 'internal'
		panic("lower: {rtSymbol(symbol)} is no entry of a primitive")
	end 'internal'
end 'noteEntry'

// refuse notes a place that cannot be compiled yet, once for each site.
function refuse(mutates l Lowerer, site diag.Site, consumes code String, consumes message String)
	let n = l.b.f.refusals.count()
	if n == 0 or l.b.f.refusals[pred(n)].module != site.module or l.b.f.refusals[pred(n)].offset != site.offset 'new'
		l.b.f.refusals.push(Refusal.make(site.module, offset: site.offset, code: code, message: message))
	end 'new'
end 'refuse'

// requireOrTrap continues only when cond holds, and panics with the message otherwise.
function requireOrTrap(mutates l Lowerer, cond Reg, message String)
	let ok = l.b.newBlock()
	let bad = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: ok, ifFalse: bad))
	l.cur = bad
	let text = strReg(l, value: message)
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanic, args: argsOf1(text), routine: ast.noFunc)
	seal(l, t: newTrap())
	l.cur = ok
end 'requireOrTrap'

// failUnlessBegin continues only when cond holds; the block it gives is where the operation goes on, and the one being
// lowered is where it does not, which failUnlessEnd ends with the failure, after the code between them has dropped what
// the operation was given and does not keep on that path.
function failUnlessBegin(mutates l Lowerer, cond Reg) returns BlockID
	let ok = l.b.newBlock()
	let bad = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: ok, ifFalse: bad))
	l.cur = bad
	return ok
end 'failUnlessBegin'

// failUnlessEnd fails with the case errorCase of the error the operation throws, and goes on in the block ok.
function failUnlessEnd(mutates l Lowerer, p ast.Project, ms ast.ModuleState, errorCase Count, ok BlockID)
	let stub = failure(l, p: p, ms: ms, errorCase: errorCase, err: noReg, errDrop: ast.noType)
	seal(l, t: newJump(stub))
	l.cur = ok
end 'failUnlessEnd'

// failUnless continues only when cond holds, and otherwise fails with the case errorCase of the error the operation
// throws.
function failUnless(mutates l Lowerer, p ast.Project, ms ast.ModuleState, cond Reg, errorCase Count)
	let ok = failUnlessBegin(l, cond: cond)
	failUnlessEnd(l, p: p, ms: ms, errorCase: errorCase, ok: ok)
end 'failUnless'

// CountedLoop is a loop over the indexes from 0 to below a limit: the slots that hold them, and its top and its exit.
export type CountedLoop
	export var index as Count
	export var top as BlockID
	export var exit as BlockID

	export static function make(index Count, top BlockID, exit BlockID) returns CountedLoop
		return CountedLoop{index: index, top: top, exit: exit}
	end 'make'
end 'CountedLoop'

// countedLoopBegin starts a loop that runs its body once for each index from 0 to below limit; the body is lowered
// between it and countedLoopEnd.
function countedLoopBegin(mutates l Lowerer, limit Reg) returns CountedLoop
	let index = l.b.f.newSlot(IrKind.kindScalar)
	let bound = l.b.f.newSlot(IrKind.kindScalar)
	let top = l.b.newBlock()
	let inside = l.b.newBlock()
	let exit = l.b.newBlock()
	let zero = konst(l, value: 0 as Word)
	emit(l, i: newStoreSlot(index, src: zero, borrow: false))
	emit(l, i: newStoreSlot(bound, src: limit, borrow: false))
	goTo(l, target: top)
	let i = load(l, slot: index)
	let n = load(l, slot: bound)
	let below = compare(l, op: CmpOp.cmpLt, a: i, b: n, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(below, ifTrue: inside, ifFalse: exit))
	l.cur = inside
	return CountedLoop.make(index, top: top, exit: exit)
end 'countedLoopBegin'

// countedLoopIndex is the index the body runs for.
function countedLoopIndex(mutates l Lowerer, loop CountedLoop) returns Reg
	return load(l, slot: loop.index)
end 'countedLoopIndex'

function countedLoopEnd(mutates l Lowerer, loop CountedLoop)
	let next = newReg(l, kind: IrKind.kindScalar)
	let cur = load(l, slot: loop.index)
	let one = konst(l, value: 1 as Word)
	emit(l, i: newBin(next, op: BinOp.binAdd, left: cur, right: one, unsigned: true, fail: noBlock))
	emit(l, i: newStoreSlot(loop.index, src: next, borrow: false))
	goTo(l, target: loop.top)
	l.cur = loop.exit
end 'countedLoopEnd'

// elemPlace is the address of a[i] that a call taking it by address is given: the element of a primitive that a subscript
// names, lent for as long as the primitive is not changed, or for a byte array a slot that holds the element
// (arrayPlace).
function elemPlace(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let obj = ast.indexExprObj(p.modules[l.mi].tree, id: e)
	let coll = lowerRead(l, p: p, ms: ms, e: obj)
	let index = indexValue(l, p: p, ms: ms, e: e)
	let collTy = exprType(p, module: l.module, node: obj)
	if isArray(l, p: p, ms: ms, collection: collTy) 'array'
		let box = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), t: collTy)
		return arrayPlace(l, p: p, ms: ms, box: box, arr: coll, index: index)
	end 'array'
	return elemEntry(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), collection: collTy, coll: coll, index: index)
end 'elemPlace'

// builtinOf is the primitive type that a collection's type is, read through the binding and through a frozen value.
function builtinOf(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, collection ast.TypeID) returns ast.TypeID
	let applied = applyType(l, p: p, ms: ms, t: collection)
	return ast.contentType(ms.types, reads: p.types, t: applied)
end 'builtinOf'

// indexType is the type of what goes between the brackets: a position for an array, and for a list or a pool the handle of
// the element.
function indexType(p ast.Project, mutates ms ast.ModuleState, bt ast.TypeID) returns ast.TypeID
	let kind = ast.typeKind(ms.types, reads: p.types, t: bt)
	let args = ast.typeArgsOf(ms.types, reads: p.types, t: bt)
	if kind == ast.TypeKind.builtinArray 'array'
		return p.builtins.countTy
	end 'array'
	if kind == ast.TypeKind.builtinList or kind == ast.TypeKind.builtinPool 'handle'
		var of = ast.TypeIDList.create(0)
		of.push(args[0])
		return ast.instantiateType(ms.types, reads: p.types, origin: p.builtins.handleOrigin, args: of)
	end 'handle'
	panic("lower: {ast.typeName(ms.types, reads: p.types, t: bt)} has no elements to index")
end 'indexType'

// elementType is the type of t[i]: what the primitive holds.
function elementType(p ast.Project, ms ast.ModuleState, bt ast.TypeID) returns ast.TypeID
	let kind = ast.typeKind(ms.types, reads: p.types, t: bt)
	let args = ast.typeArgsOf(ms.types, reads: p.types, t: bt)
	if kind == ast.TypeKind.builtinArray or kind == ast.TypeKind.builtinList or kind == ast.TypeKind.builtinPool 'one'
		return args[0]
	end 'one'
	panic("lower: {ast.typeName(ms.types, reads: p.types, t: bt)} has no elements")
end 'elementType'

function indexValue(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let bt = builtinOf(l, p: p, ms: ms, collection: exprType(p, module: l.module, node: ast.indexExprObj(p.modules[l.mi].tree, id: e)))
	let target = indexType(p, ms: ms, bt: bt)
	let argsRef = ast.indexExprArgsRef(p.modules[l.mi].tree, id: e)
	return lowerConverted(l, p: p, ms: ms, e: p.modules[l.mi].tree.listAt(argsRef, index: 0 as Count) as ast.NodeID, target: target)
end 'indexValue'

function isArray(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, collection ast.TypeID) returns bool
	let bt = builtinOf(l, p: p, ms: ms, collection: collection)
	return ast.typeKind(ms.types, reads: p.types, t: bt) == ast.TypeKind.builtinArray
end 'isArray'

// elemEntry is the address of an element of a list or a pool; an array's goes through arrayOf.
function elemEntry(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, collection ast.TypeID, coll Reg, index Reg) returns Reg
	let bt = builtinOf(l, p: p, ms: ms, collection: collection)
	let kind = ast.typeKind(ms.types, reads: p.types, t: bt)
	var symbol = Rt.rtNone
	if kind == ast.TypeKind.builtinList 'list'
		symbol = Rt.rtListElem
	end 'list' else if kind == ast.TypeKind.builtinPool 'pool'
		symbol = Rt.rtPoolElem
	end 'pool' else 'other'
		panic("lower: {ast.typeName(ms.types, reads: p.types, t: bt)} has no elements to address")
	end 'other'
	return entry(l, p: p, site: site, symbol: symbol, kind: IrKind.kindScalar, args: argsOf2(coll, b: index))
end 'elemEntry'

function visitIndexExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let obj = ast.indexExprObj(p.modules[l.mi].tree, id: e)
	let coll = lowerRead(l, p: p, ms: ms, e: obj)
	let index = indexValue(l, p: p, ms: ms, e: e)
	let collTy = exprType(p, module: l.module, node: obj)
	if isArray(l, p: p, ms: ms, collection: collTy) 'array'
		let box = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), t: collTy)
		return arrayLoad(l, p: p, ms: ms, box: box, arr: coll, index: index)
	end 'array'
	let addr = elemEntry(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), collection: collTy, coll: coll, index: index)
	let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e)))
	emit(l, i: newLoadAt(d, addr: addr))
	return d
end 'visitIndexExpr'

// assignElement stores into a[i]: the collection and the index are evaluated, then the value, and only then is the
// element's address taken, so a value that changes the collection cannot leave the address stale.
function assignElement(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, target ast.NodeID, value ast.NodeID)
	let obj = ast.indexExprObj(p.modules[l.mi].tree, id: target)
	let coll = lowerExpr(l, p: p, ms: ms, e: obj)
	let index = indexValue(l, p: p, ms: ms, e: target)
	let given = lowerExpr(l, p: p, ms: ms, e: value)
	let v = boxed(l, p: p, ms: ms, v: given, t: exprType(p, module: l.module, node: target))
	let collTy = exprType(p, module: l.module, node: obj)
	if isArray(l, p: p, ms: ms, collection: collTy) 'array'
		let box = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: target), t: collTy)
		arrayStore(l, p: p, ms: ms, box: box, arr: coll, index: index, v: v)
		return
	end 'array'
	let addr = elemEntry(l, p: p, ms: ms, site: siteOf(l, p: p, node: target), collection: collTy, coll: coll, index: index)
	dropAt(l, p: p, ms: ms, addr: addr, t: exprType(p, module: l.module, node: target))
	emit(l, i: newStoreAt(addr, src: v))
end 'assignElement'

// visitCollectionLitExpr builds the collection of a literal as the explicit code does: an empty one, then a push of each
// element in order, or for a map the call of the library Map's init that the check chose. The collection is in flight while the elements are computed, and owns each one once it
// is in.
function visitCollectionLitExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	return lowerCollectionLit(l, p: p, ms: ms, e: e, ty: exprType(p, module: l.module, node: e))
end 'visitCollectionLitExpr'

// lowerMapLiteral builds the map of a literal as maxon's does: the keys and the values each in an array of its own, in the
// order they are written, which the init that the check chose reads into a new map of type ty; the arrays are dropped then.
function lowerMapLiteral(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, ty ast.TypeID) returns Reg
	let site = siteOf(l, p: p, node: e)
	let info = callInfoAt(p, module: l.module, node: e)
	let target = callee(l, p: p, ms: ms, node: e, info: info, receiver: 0 as ast.NodeID)
	let applied = applyType(l, p: p, ms: ms, t: ty)
	let columns = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: applied).typeArgs)
	let mark = l.pending.count()
	let keys = columnArray(l, p: p, ms: ms, site: site, ref: ast.collectionLitExprElemsRef(p.modules[l.mi].tree, id: e), element: columns[0])
	let values = columnArray(l, p: p, ms: ms, site: site, ref: ast.collectionLitExprValuesRef(p.modules[l.mi].tree, id: e), element: columns[1])
	let made = newReg(l, kind: IrKind.kindManaged)
	emitCall(l, p: p, ms: ms, dst: made, target: target, args: argsOf2(keys, b: values))
	popPending(l, n: mark)
	let keysTy = arrayTypeOf(ms, p: p, element: columns[0])
	let keysDrop = dropType(l, p: p, ms: ms, t: keysTy)
	emitDropReg(l, src: keys, ty: keysDrop)
	let valuesTy = arrayTypeOf(ms, p: p, element: columns[1])
	let valuesDrop = dropType(l, p: p, ms: ms, t: valuesTy)
	emitDropReg(l, src: values, ty: valuesDrop)
	return made
end 'lowerMapLiteral'

// visitRangeExpr makes the library's Range or OpenRange of a range value by the call of its create that the check chose, as
// maxon's does, with the two bounds converted to its parameters.
function visitRangeExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let info = callInfoAt(p, module: l.module, node: e)
	let target = callee(l, p: p, ms: ms, node: e, info: info, receiver: 0 as ast.NodeID)
	let low = lowerConverted(l, p: p, ms: ms, e: info.ordered[0], target: info.paramSpecs[0].ty)
	let high = lowerConverted(l, p: p, ms: ms, e: info.ordered[1], target: info.paramSpecs[1].ty)
	let made = newReg(l, kind: kindOf(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e)))
	emitCall(l, p: p, ms: ms, dst: made, target: target, args: argsOf2(low, b: high))
	return made
end 'visitRangeExpr'

// arrayTypeOf is the type of an array of element.
function arrayTypeOf(mutates ms ast.ModuleState, p ast.Project, element ast.TypeID) returns ast.TypeID
	var args = ast.TypeIDList.create(0)
	args.push(element)
	return ast.instantiateType(ms.types, reads: p.types, origin: p.builtins.arrayOrigin, args: args)
end 'arrayTypeOf'

// columnArray is a new array of the expressions of a column of a literal, each converted to element, which is in flight
// from here on.
function columnArray(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, ref diag.U32, element ast.TypeID) returns Reg
	let t = arrayTypeOf(ms, p: p, element: element)
	let box = arrayOf(l, p: p, ms: ms, site: site, t: t)
	let arr = arrayNew(l, p: p, ms: ms, box: box)
	let mark = l.pending.count()
	let flight = dropType(l, p: p, ms: ms, t: t)
	l.pending.push(PendingDrop.ofReg(arr, ty: flight))
	for i in 0 upto p.modules[l.mi].tree.listLen(ref) 'each'
		let node = p.modules[l.mi].tree.listAt(ref, index: i) as ast.NodeID
		let converted = lowerConverted(l, p: p, ms: ms, e: node, target: element)
		let v = boxed(l, p: p, ms: ms, v: converted, t: element)
		arrayPush(l, p: p, ms: ms, box: box, arr: arr, v: v)
	end 'each'
	popPending(l, n: succ(mark))
	return arr
end 'columnArray'

// lowerCollectionLit builds the collection of type ty from the literal at e. A List takes the elements of an array
// literal, appended in order.
function lowerCollectionLit(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, ty ast.TypeID) returns Reg
	let site = siteOf(l, p: p, node: e)
	let elemsRef = ast.collectionLitExprElemsRef(p.modules[l.mi].tree, id: e)
	let valuesRef = ast.collectionLitExprValuesRef(p.modules[l.mi].tree, id: e)
	if p.modules[l.mi].tree.listLen(valuesRef) > 0 'map'
		return lowerMapLiteral(l, p: p, ms: ms, e: e, ty: ty)
	end 'map'
	let isList = ast.typeKind(ms.types, reads: p.types, t: ty) == ast.TypeKind.builtinList
	var collection = noReg
	var box = ArrayBox.make(site.clone(), ty: ty)
	if isList 'list'
		collection = entry(l, p: p, site: site, symbol: Rt.rtListNew, kind: IrKind.kindManaged, args: RegList.create(0))
	end 'list' else 'array'
		box = arrayOf(l, p: p, ms: ms, site: site, t: ty)
		collection = arrayNew(l, p: p, ms: ms, box: box)
	end 'array'
	let mark = l.pending.count()
	let flight = dropType(l, p: p, ms: ms, t: ty)
	l.pending.push(PendingDrop.ofReg(collection, ty: flight))
	for i in 0 upto p.modules[l.mi].tree.listLen(elemsRef) 'each'
		let node = p.modules[l.mi].tree.listAt(elemsRef, index: i) as ast.NodeID
		let first = heldIn(l, p: p, ms: ms, e: ExprRef.make(l.module, node: node))
		if isList 'append'
			_ = entry(l, p: p, site: site, symbol: Rt.rtListPushBack, kind: IrKind.kindScalar, args: argsOf2(collection, b: first))
		end 'append' else 'push'
			arrayPush(l, p: p, ms: ms, box: box, arr: collection, v: first)
		end 'push'
		popPending(l, n: succ(mark))
	end 'each'
	popPending(l, n: mark)
	return collection
end 'lowerCollectionLit'

// visitFromExpr lowers `Type from value`: an array or a list is the literal built as that type, and any other type is
// built by its `init`, which the check recorded as a static call with the literal as its one argument.
function visitFromExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let value = ast.fromExprValue(p.modules[l.mi].tree, id: e)
	let ty = exprType(p, module: l.module, node: e)
	if ast.isLiteralCollection(ms.types, reads: p.types, t: ty) 'collection'
		return lowerCollectionLit(l, p: p, ms: ms, e: value, ty: ty)
	end 'collection'
	let info = callInfoAt(p, module: l.module, node: e)
	let ordered = info.ordered.clone()
	let c = CallSite.make(e, info: info.clone(), receiver: 0 as ast.NodeID, ordered: ordered)
	return lowerCall(l, p: p, ms: ms, c: c)
end 'visitFromExpr'

// lowerIntrinsic lowers a call of a built-in method into the runtime entries of its primitive.
function lowerIntrinsic(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite) returns Reg
	let op = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.fn).intrinsic
	if ownsOperands(op) 'owns'
		return intrinsicCall(l, p: p, ms: ms, op: op, c: c, recv: noReg, args: RegList.create(0))
	end 'owns'
	let mark = l.pending.count()
	var recv = noReg
	if c.receiver != 0 'receiver'
		recv = lowerRead(l, p: p, ms: ms, e: c.receiver)
	end 'receiver'
	let base = l.args.count()
	for i in 0 upto c.ordered.count() 'each'
		if c.ordered[i] == 0 'defaulted'
			let word = konst(l, value: try c.info.paramSpecs[i].defaultCase as Word otherwise panic("ir: a case index is out of range"))
			pushArg(l, v: word)
			continue 'each'
		end 'defaulted'
		let v = argValue(l, p: p, ms: ms, c: c, index: i)
		pushArg(l, v: v)
	end 'each'
	// The primitive has the arguments now, and drops what it was given itself when it fails, as a callee does.
	popPending(l, n: mark)
	let result = intrinsicCall(l, p: p, ms: ms, op: op, c: c, recv: recv, args: argsSince(l, base: base))
	popArgs(l, n: base)
	return result
end 'lowerIntrinsic'

// array is the runtime of the array a call makes or is made on.
function arrayOfCall(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite) returns ArrayBox
	if c.receiver == 0 'made'
		return arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), t: exprType(p, module: l.module, node: c.node))
	end 'made'
	return arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), t: exprType(p, module: l.module, node: c.receiver))
end 'arrayOfCall'

// lowerArrayCreate is an array of count zero elements. An element with no zero value is refused unless count is 0, so
// only an array of one with a zero value has slots to fill.
export function lowerArrayCreate(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return arrayZeroed(l, p: p, ms: ms, c: c, count: args[0])
end 'lowerArrayCreate'

// lowerArrayCreateZeroed is create(n, zeroed:) with the literal flag read off the call: n zero elements, or an empty array
// with room for n.
function lowerArrayCreateZeroed(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	if ast.boolLitValue(p.modules[l.mi].tree, id: c.ordered[1]) 'zeroed'
		return arrayZeroed(l, p: p, ms: ms, c: c, count: args[0])
	end 'zeroed'
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let out = arrayNew(l, p: p, ms: ms, box: a)
	arrayReserve(l, p: p, ms: ms, box: a, arr: out, count: args[0])
	return out
end 'lowerArrayCreateZeroed'

// arrayZeroed is the array of count zero elements that a call makes.
function arrayZeroed(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, count Reg) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let out = arrayNew(l, p: p, ms: ms, box: a)
	if hasZero(p, ms: ms, t: arrayElem(p, ms: ms, box: a)) 'zero'
		arrayReserve(l, p: p, ms: ms, box: a, arr: out, count: count)
		let zero = konst(l, value: 0 as Word)
		if arrayPacked(p, ms: ms, box: a) 'bytes'
			let loop = countedLoopBegin(l, limit: count)
			let i = countedLoopIndex(l, loop: loop)
			arrayInsert(l, p: p, ms: ms, box: a, arr: out, index: i, v: zero)
			countedLoopEnd(l, loop: loop)
		end 'bytes' else 'words'
			arrayFill(l, p: p, ms: ms, box: a, arr: out, count: count, v: zero)
		end 'words'
	end 'zero'
	return out
end 'arrayZeroed'

// statedCountOfCall is the count that the type of the fixed array a call makes states.
function statedCountOfCall(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let n = try ast.statedCount(ms.types, reads: p.types, t: a.ty) as Word otherwise panic("lower: a fixed array's count is a word")
	return konst(l, value: n)
end 'statedCountOfCall'

// lowerFixedArrayCreate is a fixed array of the count its type states, of zero elements.
function lowerFixedArrayCreate(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let n = statedCountOfCall(l, p: p, ms: ms, c: c)
	return arrayZeroed(l, p: p, ms: ms, c: c, count: n)
end 'lowerFixedArrayCreate'

// lowerFixedArrayFilled is a fixed array of the count its type states, of copies of the value.
function lowerFixedArrayFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let n = statedCountOfCall(l, p: p, ms: ms, c: c)
	return arrayFilled(l, p: p, ms: ms, c: c, count: n, value: args[0])
end 'lowerFixedArrayFilled'

function lowerFixedArrayCreateCounted(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return arrayZeroed(l, p: p, ms: ms, c: c, count: args[0])
end 'lowerFixedArrayCreateCounted'

// lowerFixedArrayCount is the count the type states, or the box's length for a runtime-sized fixed array.
function lowerFixedArrayCount(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	if ast.statesCount(ms.types, reads: p.types, t: a.ty) 'stated'
		let n = try ast.statedCount(ms.types, reads: p.types, t: a.ty) as Word otherwise panic("lower: a fixed array's count is a word")
		return konst(l, value: n)
	end 'stated'
	return arrayLength(l, p: p, ms: ms, box: a, arr: recv)
end 'lowerFixedArrayCount'

// lowerFixedArrayGetProven is a copy of the element at an index that the checker proved inside the count, which cannot
// fail: nothing empties a slot of a fixed array, so one that is empty is a broken invariant, which panics.
function lowerFixedArrayGetProven(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let element = arrayRead(l, p: p, ms: ms, box: a, arr: recv, index: args[0], checked: false, read: SlotRead.slotLent)
	return copyValue(l, p: p, ms: ms, site: a.site, v: element, t: arrayElem(p, ms: ms, box: a))
end 'lowerFixedArrayGetProven'

// lowerFixedArraySetProven replaces the element at an index that the checker proved inside the count.
function lowerFixedArraySetProven(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayWrite(l, p: p, ms: ms, box: a, arr: recv, index: args[0], v: args[1], checked: false)
	return konst(l, value: 0 as Word)
end 'lowerFixedArraySetProven'

// lowerFixedArrayRefill writes copies of the value over every element, which keeps the count.
function lowerFixedArrayRefill(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let n = arrayLength(l, p: p, ms: ms, box: a, arr: recv)
	arrayRefill(l, p: p, ms: ms, box: a, arr: recv, newLength: n, value: args[0])
	return konst(l, value: 0 as Word)
end 'lowerFixedArrayRefill'

// hasZero is whether the word 0 is a value of t, so that a slot nothing wrote holds one: an integer whose range takes 0,
// or a bool. A managed value, a handle, an enum (whose 0 is its first case, not its case of raw value 0) and a type
// parameter have none.
function hasZero(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	if kind == ast.TypeKind.intRange 'range'
		return ast.typeEntry(ms.types, reads: p.types, t: t).minVal.le(ast.I128.zero()) and ast.I128.zero().le(ast.typeEntry(ms.types, reads: p.types, t: t).maxVal)
	end 'range'
	if kind == ast.TypeKind.floatRange 'float'
		return ast.floatRangeHolds(ms.types, reads: p.types, t: t, bits: 0)
	end 'float'
	return kind == ast.TypeKind.primBool
end 'hasZero'

function lowerArrayFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return arrayFilled(l, p: p, ms: ms, c: c, count: args[0], value: args[1])
end 'lowerArrayFilled'

// lowerArrayFromMemory is the array whose box the buffer it consumes is: the same value under the array's type.
function lowerArrayFromMemory(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return args[0]
end 'lowerArrayFromMemory'

function lowerArrayCount(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	return arrayLength(l, p: p, ms: ms, box: a, arr: recv)
end 'lowerArrayCount'

// lowerArrayCapacity is how many elements the array's buffer holds, the one count that every kind of array keeps alike.
function lowerArrayCapacity(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	return entry(l, p: p, site: a.site, symbol: Rt.rtArrayCapacity, kind: IrKind.kindScalar, args: argsOf1(recv))
end 'lowerArrayCapacity'

function lowerArrayIsEmpty(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let n = arrayLength(l, p: p, ms: ms, box: a, arr: recv)
	return isZero(l, v: n)
end 'lowerArrayIsEmpty'

// lowerArrayGet is a copy of the element at index, which fails with indexOutOfBounds past the end, as maxon's get does.
function lowerArrayGet(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	return arrayCopyAt(l, p: p, ms: ms, box: a, arr: recv, index: args[0])
end 'lowerArrayGet'

// lowerArraySet replaces the element at index, and fails with indexOutOfBounds past the end, dropping the value it was
// given, as maxon's set does.
function lowerArraySet(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let ok = arrayBoundsBegin(l, p: p, ms: ms, box: a, arr: recv, index: args[0])
	dropValue(l, p: p, ms: ms, v: args[1], t: arrayElem(p, ms: ms, box: a))
	failUnlessEnd(l, p: p, ms: ms, errorCase: ast.errorIndexOutOfBounds, ok: ok)
	arrayWrite(l, p: p, ms: ms, box: a, arr: recv, index: args[0], v: args[1], checked: false)
	return konst(l, value: 0 as Word)
end 'lowerArraySet'

export function lowerArrayPush(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayPush(l, p: p, ms: ms, box: a, arr: recv, v: args[0])
	return konst(l, value: 0 as Word)
end 'lowerArrayPush'

// lowerArrayAppend pushes a copy of each element of other, which the call only reads.
function lowerArrayAppend(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayAppendCopy(l, p: p, ms: ms, box: a, arr: recv, other: args[0])
	return konst(l, value: 0 as Word)
end 'lowerArrayAppend'

// lowerArrayInsert inserts at an index above the count at the end, as maxon's insert clamps it.
function lowerArrayInsert(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let n = arrayLength(l, p: p, ms: ms, box: a, arr: recv)
	let at = l.b.f.newSlot(IrKind.kindScalar)
	emit(l, i: newStoreSlot(at, src: args[0], borrow: false))
	let clamp = l.b.newBlock()
	let insert = l.b.newBlock()
	let above = compare(l, op: CmpOp.cmpGt, a: args[0], b: n, unsigned: true)
	l.b.terminate(l.cur, t: newBranch(above, ifTrue: clamp, ifFalse: insert))
	l.cur = clamp
	emit(l, i: newStoreSlot(at, src: n, borrow: false))
	goTo(l, target: insert)
	let index = load(l, slot: at)
	arrayInsert(l, p: p, ms: ms, box: a, arr: recv, index: index, v: args[1])
	return konst(l, value: 0 as Word)
end 'lowerArrayInsert'

function lowerArrayRemove(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayInBounds(l, p: p, ms: ms, box: a, arr: recv, index: args[0])
	return arrayRemove(l, p: p, ms: ms, box: a, arr: recv, index: args[0])
end 'lowerArrayRemove'

function lowerArrayDropEmpty(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let n = arrayLength(l, p: p, ms: ms, box: a, arr: recv)
	return dropEmpty(l, p: p, ms: ms, c: c, length: n, collection: recv)
end 'lowerArrayDropEmpty'

function lowerArrayPop(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let n = arrayLength(l, p: p, ms: ms, box: a, arr: recv)
	let present = nonZero(l, v: n)
	failUnless(l, p: p, ms: ms, cond: present, errorCase: ast.errorIndexOutOfBounds)
	let last = newReg(l, kind: IrKind.kindScalar)
	let one = konst(l, value: 1 as Word)
	emit(l, i: newBin(last, op: BinOp.binSub, left: n, right: one, unsigned: true, fail: noBlock))
	return arrayRemove(l, p: p, ms: ms, box: a, arr: recv, index: last)
end 'lowerArrayPop'

// lowerArrayClear drops every element and keeps the buffer.
function lowerArrayClear(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayClear(l, p: p, ms: ms, box: a, arr: recv)
	return konst(l, value: 0 as Word)
end 'lowerArrayClear'

// lowerArrayTruncate drops the elements at and above the new length.
function lowerArrayTruncate(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayTruncate(l, p: p, ms: ms, box: a, arr: recv, newLength: args[0])
	return konst(l, value: 0 as Word)
end 'lowerArrayTruncate'

// lowerArrayReserve makes the buffer hold a number of elements, which changes no part of the array's value.
function lowerArrayReserve(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayReserve(l, p: p, ms: ms, box: a, arr: recv, count: args[0])
	return konst(l, value: 0 as Word)
end 'lowerArrayReserve'

// lowerArrayResize makes the array newLength elements long: it drops the ones above and pushes zeros below.
function lowerArrayResize(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayTruncate(l, p: p, ms: ms, box: a, arr: recv, newLength: args[0])
	arrayGrowZero(l, p: p, ms: ms, box: a, arr: recv, newLength: args[0])
	return konst(l, value: 0 as Word)
end 'lowerArrayResize'

// lowerArrayElementSize is the bytes an element of the instance takes, what sizeof gives for it.
function lowerArrayElementSize(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let size = try ast.byteSize(ms.types, reads: p.types, t: arrayElem(p, ms: ms, box: a)) as Word otherwise panic("lower: a size is a word")
	return konst(l, value: size)
end 'lowerArrayElementSize'

// lowerArraySwap exchanges two elements, failing with indexOutOfBounds for an index past the end.
function lowerArraySwap(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arraySwap(l, p: p, ms: ms, box: a, arr: recv, i: args[0], j: args[1])
	return konst(l, value: 0 as Word)
end 'lowerArraySwap'

function lowerArrayClearSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayClearSlot(l, p: p, ms: ms, box: a, arr: recv, index: args[0])
	return konst(l, value: 0 as Word)
end 'lowerArrayClearSlot'

function lowerArraySlice(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	return arraySlice(l, p: p, ms: ms, box: a, arr: recv, start: args[0], endIndex: args[1])
end 'lowerArraySlice'

function lowerArrayFirst(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let first = konst(l, value: 0 as Word)
	return arrayCopyAt(l, p: p, ms: ms, box: a, arr: recv, index: first)
end 'lowerArrayFirst'

// lowerArrayLast is a copy of the last element; the index of an empty array wraps above its length, so it fails with indexOutOfBounds.
function lowerArrayLast(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let n = arrayLength(l, p: p, ms: ms, box: a, arr: recv)
	let last = newReg(l, kind: IrKind.kindScalar)
	let one = konst(l, value: 1 as Word)
	emit(l, i: newBin(last, op: BinOp.binSub, left: n, right: one, unsigned: true, fail: noBlock))
	return arrayCopyAt(l, p: p, ms: ms, box: a, arr: recv, index: last)
end 'lowerArrayLast'

function lowerArrayContains(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	return arrayContains(l, p: p, ms: ms, box: a, arr: recv, value: args[0])
end 'lowerArrayContains'

function lowerArrayContainsSequence(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	return arrayContainsSequence(l, p: p, ms: ms, box: a, arr: recv, sequence: args[0])
end 'lowerArrayContainsSequence'

function lowerArrayEquals(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	return arrayEquals(l, p: p, ms: ms, box: a, arr: recv, other: args[0])
end 'lowerArrayEquals'

// lowerArrayGrowFilled pushes copies of the value up to the new length.
function lowerArrayGrowFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayGrowFilled(l, p: p, ms: ms, box: a, arr: recv, newLength: args[0], value: args[1])
	return konst(l, value: 0 as Word)
end 'lowerArrayGrowFilled'

// lowerArrayRefill makes the array copies of the value, as many as the new length.
function lowerArrayRefill(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	arrayRefill(l, p: p, ms: ms, box: a, arr: recv, newLength: args[0], value: args[1])
	return konst(l, value: 0 as Word)
end 'lowerArrayRefill'

function lowerListCreate(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListNew, kind: IrKind.kindManaged, args: RegList.create(0))
end 'lowerListCreate'

function lowerListCount(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListLen, kind: IrKind.kindScalar, args: argsOf1(recv))
end 'lowerListCount'

function lowerListIsEmpty(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let n = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListLen, kind: IrKind.kindScalar, args: argsOf1(recv))
	return isZero(l, v: n)
end 'lowerListIsEmpty'

function lowerListContains(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListContains, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
end 'lowerListContains'

function lowerListPrepend(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListPushFront, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
end 'lowerListPrepend'

function lowerListAppend(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListPushBack, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
end 'lowerListAppend'

function lowerListRemoveFirst(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return removeEnd(l, p: p, ms: ms, c: c, pop: Rt.rtListPopFront, list: recv)
end 'lowerListRemoveFirst'

function lowerListRemoveLast(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return removeEnd(l, p: p, ms: ms, c: c, pop: Rt.rtListPopBack, list: recv)
end 'lowerListRemoveLast'

function lowerListFirst(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let h = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListFirst, kind: IrKind.kindScalar, args: argsOf1(recv))
	return endHandle(l, p: p, ms: ms, handle: h)
end 'lowerListFirst'

function lowerListLast(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let h = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListLast, kind: IrKind.kindScalar, args: argsOf1(recv))
	return endHandle(l, p: p, ms: ms, handle: h)
end 'lowerListLast'

function lowerListNext(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let h = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListNext, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
	return endHandle(l, p: p, ms: ms, handle: h)
end 'lowerListNext'

function lowerListPrev(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let h = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListPrev, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
	return endHandle(l, p: p, ms: ms, handle: h)
end 'lowerListPrev'

function lowerListRemove(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return removeHandle(l, p: p, ms: ms, c: c, contains: Rt.rtListContains, remove: Rt.rtListRemove, collection: recv, handle: args[0])
end 'lowerListRemove'

function lowerListDropEmpty(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let n = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListLen, kind: IrKind.kindScalar, args: argsOf1(recv))
	return dropEmpty(l, p: p, ms: ms, c: c, length: n, collection: recv)
end 'lowerListDropEmpty'

function lowerListMoveToFront(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	entryVoid(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtListMoveToFront, args: argsOf2(recv, b: args[0]))
	return konst(l, value: 0 as Word)
end 'lowerListMoveToFront'

function lowerPoolCreate(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtPoolNew, kind: IrKind.kindManaged, args: RegList.create(0))
end 'lowerPoolCreate'

function lowerPoolCount(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtPoolLen, kind: IrKind.kindScalar, args: argsOf1(recv))
end 'lowerPoolCount'

function lowerPoolIsEmpty(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let n = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtPoolLen, kind: IrKind.kindScalar, args: argsOf1(recv))
	return isZero(l, v: n)
end 'lowerPoolIsEmpty'

function lowerPoolContains(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtPoolContains, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
end 'lowerPoolContains'

function lowerPoolInsert(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtPoolInsert, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
end 'lowerPoolInsert'

function lowerPoolDropEmpty(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let n = entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtPoolLen, kind: IrKind.kindScalar, args: argsOf1(recv))
	return dropEmpty(l, p: p, ms: ms, c: c, length: n, collection: recv)
end 'lowerPoolDropEmpty'

function lowerPoolRemove(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return removeHandle(l, p: p, ms: ms, c: c, contains: Rt.rtPoolContains, remove: Rt.rtPoolRemove, collection: recv, handle: args[0])
end 'lowerPoolRemove'

function lowerStringByteLength(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return runtime(l, symbol: Rt.rtStrLen, kind: IrKind.kindScalar, args: argsOf1(recv))
end 'lowerStringByteLength'

function lowerStringByteAt(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return runtime(l, symbol: Rt.rtStrByteAt, kind: IrKind.kindScalar, args: argsOf2(recv, b: args[0]))
end 'lowerStringByteAt'

function lowerStringSliceBytes(mutates l Lowerer, p ast.Project, ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return stringView(l, text: recv, from: args[0], until: args[1], checked: true)
end 'lowerStringSliceBytes'

// lowerStringToByteArray is a new byte array of the string's UTF-8 bytes.
function lowerStringToByteArray(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), t: exprType(p, module: l.module, node: c.node))
	let out = arrayNew(l, p: p, ms: ms, box: a)
	arrayAppendText(l, p: p, ms: ms, box: a, arr: out, text: recv)
	return out
end 'lowerStringToByteArray'

// lowerStringFrom is a string of a copy of the bytes, which the call only reads.
function lowerStringFrom(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), t: c.info.paramSpecs[0].ty)
	return arrayText(l, p: p, ms: ms, box: a, arr: args[0])
end 'lowerStringFrom'

// dropEmpty ends a collection of the given length that the call consumes, and traps if an element is left: dropping it
// would drop the element, which a type with a destructor must never be left to do.
function dropEmpty(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, length Reg, collection Reg) returns Reg
	let empty = isZero(l, v: length)
	requireOrTrap(l, cond: empty, message: dropEmptyMessage)
	dropValue(l, p: p, ms: ms, v: collection, t: exprType(p, module: l.module, node: c.receiver))
	return konst(l, value: 0 as Word)
end 'dropEmpty'

// moveOutAt reads the value at an address of the type t and leaves the place empty when t is owned, so that the place can
// be written without dropping what was there.
function moveOutAt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, addr Reg, t ast.TypeID) returns Reg
	let kind = kindOf(l, p: p, ms: ms, t: t)
	let d = newReg(l, kind: kind)
	if owning(kind) 'managed'
		emit(l, i: newMoveAt(d, addr: addr))
	end 'managed' else 'scalar'
		emit(l, i: newLoadAt(d, addr: addr))
	end 'scalar'
	return d
end 'moveOutAt'

// lowerExchange moves the new value into a place and gives the value that was there to the caller, so the place is never
// dropped and a type without Droppable can be replaced. The value is computed before the place is addressed, so that
// computing it cannot leave the address stale.
function lowerExchange(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let value = lowerConverted(l, p: p, ms: ms, e: c.ordered[1], target: c.info.paramSpecs[1].ty)
	let places = l.writeBacks.count()
	let addr = address(l, p: p, ms: ms, e: c.ordered[0])
	let t = exprType(p, module: l.module, node: c.node)
	if inPlace(l, p: p, ms: ms, t: t) 'inPlace'
		// The place holds the address of the words, a frame area's or a box's: the old words are copied out before the new
		// ones are copied in, and the place keeps its box.
		let words = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newLoadAt(words, addr: addr))
		let n = placeWords(l, p: p, ms: ms, t: t)
		let old = placedCopy(l, words: n, v: words)
		copyWords(l, dst: words, src: value, words: n)
		writeBack(l, p: p, ms: ms, mark: places)
		return old
	end 'inPlace'
	let old = moveOutAt(l, p: p, ms: ms, addr: addr, t: exprType(p, module: l.module, node: c.node))
	emit(l, i: newStoreAt(addr, src: value))
	writeBack(l, p: p, ms: ms, mark: places)
	return old
end 'lowerExchange'

function isZero(mutates l Lowerer, v Reg) returns Reg
	let zero = konst(l, value: 0 as Word)
	return compare(l, op: CmpOp.cmpEq, a: v, b: zero, unsigned: false)
end 'isZero'

function nonZero(mutates l Lowerer, v Reg) returns Reg
	let zero = konst(l, value: 0 as Word)
	return compare(l, op: CmpOp.cmpNe, a: v, b: zero, unsigned: false)
end 'nonZero'

// removeEnd moves the element at an end of a list out, and fails with indexOutOfBounds on an empty list, as maxon's List
// does.
function removeEnd(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, pop Rt, list Reg) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let n = entry(l, p: p, site: site, symbol: Rt.rtListLen, kind: IrKind.kindScalar, args: argsOf1(list))
	let present = nonZero(l, v: n)
	failUnless(l, p: p, ms: ms, cond: present, errorCase: ast.errorIndexOutOfBounds)
	let t = exprType(p, module: l.module, node: c.node)
	let kind = holderKind(l, p: p, ms: ms, t: t)
	let removed = entry(l, p: p, site: site, symbol: pop, kind: kind, args: argsOf1(list))
	return unboxed(l, p: p, ms: ms, v: removed, t: t)
end 'removeEnd'

// endHandle is the handle of a list's first or last node, or of the node after or before one, which the entry gives as 0
// when there is none, where the operation fails with indexOutOfBounds.
function endHandle(mutates l Lowerer, p ast.Project, ms ast.ModuleState, handle Reg) returns Reg
	let present = nonZero(l, v: handle)
	failUnless(l, p: p, ms: ms, cond: present, errorCase: ast.errorIndexOutOfBounds)
	return handle
end 'endHandle'

// removeHandle moves the element a handle names out of a list or a pool, and fails with emptySlot for a handle that names
// none, as maxon's emptied slot does.
function removeHandle(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, contains Rt, remove Rt, collection Reg, handle Reg) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let named = entry(l, p: p, site: site, symbol: contains, kind: IrKind.kindScalar, args: argsOf2(collection, b: handle))
	failUnless(l, p: p, ms: ms, cond: named, errorCase: ast.errorEmptySlot)
	let t = exprType(p, module: l.module, node: c.node)
	let kind = holderKind(l, p: p, ms: ms, t: t)
	let removed = entry(l, p: p, site: site, symbol: remove, kind: kind, args: argsOf2(collection, b: handle))
	return unboxed(l, p: p, ms: ms, v: removed, t: t)
end 'removeHandle'

// arrayFilled is an array of count copies of value: the value is copied into every slot and then dropped, so that every
// element has an owner of its own. A scalar in words is its own copy, which one fill writes.
function arrayFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, count Reg, value Reg) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let out = arrayNew(l, p: p, ms: ms, box: a)
	arrayReserve(l, p: p, ms: ms, box: a, arr: out, count: count)
	if not arrayPacked(p, ms: ms, box: a) and not holdsManaged(ms.types, reads: p.types, t: arrayElem(p, ms: ms, box: a)) 'scalar'
		arrayFill(l, p: p, ms: ms, box: a, arr: out, count: count, v: value)
		return out
	end 'scalar'
	let loop = countedLoopBegin(l, limit: count)
	let i = countedLoopIndex(l, loop: loop)
	let copy = holderCopy(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), v: value, t: arrayElem(p, ms: ms, box: a))
	arrayInsert(l, p: p, ms: ms, box: a, arr: out, index: i, v: copy)
	countedLoopEnd(l, loop: loop)
	dropValue(l, p: p, ms: ms, v: value, t: arrayElem(p, ms: ms, box: a))
	return out
end 'arrayFilled'

// requireNative refuses, once for each site, a value of a type that holds a primitive the backend has no code for. A copy
// or a drop of such a value is code that only the interpreter has, as the entries of the primitive itself are.
function requireNative(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, t ast.TypeID)
	var visiting = ast.TypeIDList.create(0)
	if holdsInterpreterOnly(p, ms: ms, t: t, visiting: visiting) 'only'
		refuse(l, site: site, code: diag.errInterpreterOnly, message: interpreterOnlyMessage)
	end 'only'
end 'requireNative'

// holdsInterpreterOnly is whether a value of type t is, or holds at any depth, a list or a pool. visiting are the
// records and unions being walked, so a type that contains itself through an array ends.
function holdsInterpreterOnly(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, mutates visiting ast.TypeIDList) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	if kind == ast.TypeKind.primBool or kind == ast.TypeKind.primString or kind == ast.TypeKind.primCharacter or kind == ast.TypeKind.intRange or kind == ast.TypeKind.constInt or kind == ast.TypeKind.floatRange or kind == ast.TypeKind.constFloat or kind == ast.TypeKind.enumTy 'plain'
		return false
	end 'plain'
	if kind == ast.TypeKind.builtinHandle or kind == ast.TypeKind.builtinPromise 'handle'
		return false
	end 'handle'
	// A function value is dropped by the routine of its closure, which the closure that owns such a value refuses.
	if kind == ast.TypeKind.funcTy 'function'
		return false
	end 'function'
	// An interface value is dropped by the table of the type it holds, and boxing a value of a type that holds such a part
	// is refused natively where it is boxed.
	if kind == ast.TypeKind.interfaceTy 'interface'
		return false
	end 'interface'
	if kind == ast.TypeKind.builtinArray 'array'
		return holdsInterpreterOnly(p, ms: ms, t: elementType(p, ms: ms, bt: t), visiting: visiting)
	end 'array'
	if kind == ast.TypeKind.builtinGroups 'groups'
		let halves = ast.typeArgsOf(ms.types, reads: p.types, t: t)
		return holdsInterpreterOnly(p, ms: ms, t: halves[0], visiting: visiting) or holdsInterpreterOnly(p, ms: ms, t: halves[1], visiting: visiting)
	end 'groups'
	if kind == ast.TypeKind.builtinFrozen or kind == ast.TypeKind.builtinCown or kind == ast.TypeKind.builtinService 'shared'
		return holdsInterpreterOnly(p, ms: ms, t: heldType(p, ms: ms, t: t), visiting: visiting)
	end 'shared'
	if kind == ast.TypeKind.builtinList or kind == ast.TypeKind.builtinPool 'only'
		return true
	end 'only'
	// A cursor holds a word of the buffer it borrows and its index, and never drops the buffer.
	if kind == ast.TypeKind.builtinCursor 'cursor'
		return false
	end 'cursor'
	if kind == ast.TypeKind.record or kind == ast.TypeKind.unionTy 'nominal'
		for i in 0 upto visiting.count() 'seen'
			if visiting[i] == t 'again'
				return false
			end 'again'
		end 'seen'
		visiting.push(t)
		let origin = ast.typeEntry(ms.types, reads: p.types, t: t).effectiveOrigin()
		let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: origin).typeParams)
		let args = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: t).typeArgs)
		if kind == ast.TypeKind.record 'record'
			for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).fields.count() 'fields'
				let declared = ast.typeEntry(ms.types, reads: p.types, t: origin).fields[i].ty
				let field = ast.substituteType(ms.types, reads: p.types, t: declared, params: params, args: args)
				if holdsInterpreterOnly(p, ms: ms, t: field, visiting: visiting) 'holds'
					return true
				end 'holds'
			end 'fields'
			return false
		end 'record'
		for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).cases.count() 'cases'
			for j in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].payload.count() 'payload'
				let declared = ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].payload[j].ty
				let field = ast.substituteType(ms.types, reads: p.types, t: declared, params: params, args: args)
				if holdsInterpreterOnly(p, ms: ms, t: field, visiting: visiting) 'holds'
					return true
				end 'holds'
			end 'payload'
		end 'cases'
		return false
	end 'nominal'
	panic("lower: {ast.typeName(ms.types, reads: p.types, t: t)} has no layout the backend knows")
end 'holdsInterpreterOnly'
