// lowerStringToByteArray is a new byte array of the string's UTF-8 bytes.
function lowerStringToByteArray(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), t: exprType(p, module: l.module, node: c.node))
	let out = arrayNew(l, p: p, ms: ms, box: a)
	arrayAppendText(l, p: p, ms: ms, box: a, arr: out, text: recv)
	return out
end 'lowerStringToByteArray'

// lowerStringFrom is a string of a copy of the bytes, which the call only reads.
function lowerStringFrom(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let a = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), t: c.info.paramSpecs[0].ty)
	return arrayText(l, p: p, ms: ms, box: a, arr: args[0])
end 'lowerStringFrom'

// dropEmpty ends a collection of the given length that the call consumes, and traps if an element is left: dropping it
// would drop the element, which a type with a destructor must never be left to do.
function dropEmpty(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, length Reg, collection Reg) returns Reg
	let empty = isZero(l, v: length)
	requireOrTrap(l, cond: empty, message: dropEmptyMessage)
	dropValue(l, p: p, ms: ms, v: collection, t: exprType(p, module: l.module, node: c.receiver))
	return konst(l, value: 0 as Word)
end 'dropEmpty'

// moveOutAt reads the value at an address of the type t and leaves the place empty when t is owned, so that the place can
// be written without dropping what was there.
function moveOutAt(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, addr Reg, t ast.TypeID) returns Reg
	let kind = kindOf(l, p: p, ms: ms, t: t)
	let d = newReg(l, kind: kind)
	if kind == IrKind.kindManaged 'managed'
		emit(l, i: newMoveAt(d, addr: addr))
	end 'managed' else 'scalar'
		emit(l, i: newLoadAt(d, addr: addr))
	end 'scalar'
	return d
end 'moveOutAt'

// lowerExchange moves the new value into a place and gives the value that was there to the caller, so the place is never
// dropped and a type without Droppable can be replaced. The value is computed before the place is addressed, so that
// computing it cannot leave the address stale.
function lowerExchange(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let value = lowerConverted(l, p: p, ms: ms, e: c.ordered[1], target: c.info.paramSpecs[1].ty)
	let places = l.writeBacks.count()
	let addr = address(l, p: p, ms: ms, e: c.ordered[0])
	let old = moveOutAt(l, p: p, ms: ms, addr: addr, t: exprType(p, module: l.module, node: c.node))
	emit(l, i: newStoreAt(addr, src: value))
	writeBack(l, p: p, ms: ms, mark: places)
	return old
end 'lowerExchange'

// mapReplace is Map.upsert that gives back the value the key had: it moves that value out of its entry, and the insert
// then finds the entry empty, keeps its place and drops nothing. A key the map does not have fails with keyNotFound,
// dropping the key and the value it was given.
function mapReplace(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, m Reg, key Reg, value Reg) returns Reg
	let bt = builtinOf(l, p: p, ms: ms, collection: exprType(p, module: l.module, node: c.receiver))
	let elem = elementType(p, ms: ms, bt: bt)
	let site = siteOf(l, p: p, node: c.node)
	let has = entry(l, p: p, site: site, symbol: Rt.rtMapHas, kind: IrKind.kindScalar, args: argsOf2(m, b: key))
	let ok = failUnlessBegin(l, cond: has)
	let keyTy = indexType(p, ms: ms, bt: bt)
	dropValue(l, p: p, ms: ms, v: key, t: keyTy)
	dropValue(l, p: p, ms: ms, v: value, t: elem)
	failUnlessEnd(l, p: p, ms: ms, errorCase: ast.errorKeyNotFound, ok: ok)
	let addr = entry(l, p: p, site: site, symbol: Rt.rtMapElem, kind: IrKind.kindScalar, args: argsOf2(m, b: key))
	let old = moveOutAt(l, p: p, ms: ms, addr: addr, t: elem)
	entryVoid(l, p: p, site: site, symbol: Rt.rtMapInsert, args: argsOf3(m, b: key, c: value))
	return old
end 'mapReplace'

function isZero(mutates l Lowerer, v Reg) returns Reg
	let zero = konst(l, value: 0 as Word)
	return compare(l, op: CmpOp.cmpEq, a: v, b: zero, unsigned: false)
end 'isZero'

function nonZero(mutates l Lowerer, v Reg) returns Reg
	let zero = konst(l, value: 0 as Word)
	return compare(l, op: CmpOp.cmpNe, a: v, b: zero, unsigned: false)
end 'nonZero'

// removeEnd moves the element at an end of a list out, and fails with indexOutOfBounds on an empty list, as maxon's List
// does.
function removeEnd(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, pop Rt, list Reg) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let n = entry(l, p: p, site: site, symbol: Rt.rtListLen, kind: IrKind.kindScalar, args: argsOf1(list))
	let present = nonZero(l, v: n)
	failUnless(l, p: p, ms: ms, cond: present, errorCase: ast.errorIndexOutOfBounds)
	let kind = kindOf(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node))
	return entry(l, p: p, site: site, symbol: pop, kind: kind, args: argsOf1(list))
end 'removeEnd'

// endHandle is the handle of a list's first or last node, or of the node after or before one, which the entry gives as 0
// when there is none, where the operation fails with indexOutOfBounds.
function endHandle(mutates l Lowerer, p ast.Project, ms ast.ModuleState, handle Reg) returns Reg
	let present = nonZero(l, v: handle)
	failUnless(l, p: p, ms: ms, cond: present, errorCase: ast.errorIndexOutOfBounds)
	return handle
end 'endHandle'

// removeHandle moves the element a handle names out of a list or a pool, and fails with emptySlot for a handle that names
// none, as maxon's emptied slot does.
function removeHandle(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, contains Rt, remove Rt, collection Reg, handle Reg) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	let named = entry(l, p: p, site: site, symbol: contains, kind: IrKind.kindScalar, args: argsOf2(collection, b: handle))
	failUnless(l, p: p, ms: ms, cond: named, errorCase: ast.errorEmptySlot)
	let kind = kindOf(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node))
	return entry(l, p: p, site: site, symbol: remove, kind: kind, args: argsOf2(collection, b: handle))
end 'removeHandle'

// arrayFilled is an array of count copies of value: the value is copied into every slot and then dropped, so that every
// element has an owner of its own.
function arrayFilled(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, count Reg, value Reg) returns Reg
	let a = arrayOfCall(l, p: p, ms: ms, c: c)
	let out = arrayNew(l, p: p, ms: ms, box: a)
	let loop = countedLoopBegin(l, limit: count)
	let i = countedLoopIndex(l, loop: loop)
	let copy = copyValue(l, p: p, ms: ms, site: siteOf(l, p: p, node: c.node), v: value, t: arrayElem(p, ms: ms, box: a))
	arrayInsert(l, p: p, ms: ms, box: a, arr: out, index: i, v: copy)
	countedLoopEnd(l, loop: loop)
	dropValue(l, p: p, ms: ms, v: value, t: arrayElem(p, ms: ms, box: a))
	return out
end 'arrayFilled'

// requireNative refuses, once for each site, a value of a type that holds a primitive the backend has no code for. A copy
// or a drop of such a value is code that only the interpreter has, as the entries of the primitive itself are.
function requireNative(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, t ast.TypeID)
	var visiting = ast.TypeIDList.create(0)
	if holdsInterpreterOnly(p, ms: ms, t: t, visiting: visiting) 'only'
		refuse(l, site: site, code: diag.errInterpreterOnly, message: interpreterOnlyMessage)
	end 'only'
end 'requireNative'

// holdsInterpreterOnly is whether a value of type t is, or holds at any depth, a map, a list or a pool. visiting are the
// records and unions being walked, so a type that contains itself through an array ends.
function holdsInterpreterOnly(p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, mutates visiting ast.TypeIDList) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	if kind == ast.TypeKind.primBool or kind == ast.TypeKind.primString or kind == ast.TypeKind.intRange or kind == ast.TypeKind.constInt or kind == ast.TypeKind.floatRange or kind == ast.TypeKind.constFloat or kind == ast.TypeKind.enumTy 'plain'
		return false
	end 'plain'
	if kind == ast.TypeKind.builtinHandle 'handle'
		return false
	end 'handle'
	// A function value is dropped by the routine of its closure, which the closure that owns such a value refuses.
	if kind == ast.TypeKind.funcTy 'function'
		return false
	end 'function'
	// An interface value is dropped by the table of the type it holds, and boxing a value of a type that holds such a part
	// is refused natively where it is boxed.
	if kind == ast.TypeKind.interfaceTy 'interface'
		return false
	end 'interface'
	if kind == ast.TypeKind.builtinArray 'array'
		return holdsInterpreterOnly(p, ms: ms, t: elementType(p, ms: ms, bt: t), visiting: visiting)
	end 'array'
	if kind == ast.TypeKind.builtinFrozen or kind == ast.TypeKind.builtinCown 'shared'
		return holdsInterpreterOnly(p, ms: ms, t: heldType(p, ms: ms, t: t), visiting: visiting)
	end 'shared'
	if kind == ast.TypeKind.builtinMap or kind == ast.TypeKind.builtinList or kind == ast.TypeKind.builtinPool 'only'
		return true
	end 'only'
	if kind == ast.TypeKind.record or kind == ast.TypeKind.unionTy 'nominal'
		for i in 0 upto visiting.count() 'seen'
			if visiting[i] == t 'again'
				return false
			end 'again'
		end 'seen'
		visiting.push(t)
		let origin = ast.typeEntry(ms.types, reads: p.types, t: t).effectiveOrigin()
		let params = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: origin).typeParams)
		let args = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: t).typeArgs)
		if kind == ast.TypeKind.record 'record'
			for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).fields.count() 'fields'
				let declared = ast.typeEntry(ms.types, reads: p.types, t: origin).fields[i].ty
				let field = ast.substituteType(ms.types, reads: p.types, t: declared, params: params, args: args)
				if holdsInterpreterOnly(p, ms: ms, t: field, visiting: visiting) 'holds'
					return true
				end 'holds'
			end 'fields'
			return false
		end 'record'
		for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).cases.count() 'cases'
			for j in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].payload.count() 'payload'
				let declared = ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].payload[j].ty
				let field = ast.substituteType(ms.types, reads: p.types, t: declared, params: params, args: args)
				if holdsInterpreterOnly(p, ms: ms, t: field, visiting: visiting) 'holds'
					return true
				end 'holds'
			end 'payload'
		end 'cases'
		return false
	end 'nominal'
	panic("lower: {ast.typeName(ms.types, reads: p.types, t: t)} has no layout the backend knows")
end 'holdsInterpreterOnly'
