// async and await. An async call is one instruction, `async f(args)`, which gives the promise: the coroutine, a green
// thread of the caller's strand whose thunk calls f with the argument words (backend.emitAsync). An await is the runtime's:
// rt.async.await gives what f returned and frees the coroutine; for a function that throws, rt.async.wait waits,
// rt.async.error gives what f failed with and rt.async.take what it returned, and the failure goes where a call's does.

// visitAsyncExpr starts the call of an async call as a coroutine. Its arguments are lowered as the call's would be: by
// address where the parameter takes its argument's place, and by value otherwise; what a consumes parameter takes moves
// into the coroutine, which owns it from here on.
function visitAsyncExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let node = ast.asyncExprCall(p.modules[l.mi].tree, id: e)
	let c = callSite(l, p: p, node: node)
	let target = callee(l, p: p, ms: ms, node: node, info: c.info, receiver: 0 as ast.NodeID)
	let mark = l.pending.count()
	let base = l.args.count()
	let places = l.writeBacks.count()
	pushOrderedArgs(l, p: p, ms: ms, c: c)
	if l.writeBacks.count() != places 'writeBack'
		panic("lower: an async call passes an element by address, which the ownership pass lends only from a local")
	end 'writeBack'
	var args = argsSince(l, base: base)
	if resultWords(ms.types, reads: p.types, f: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target)) > 0 'inPlace'
		// No area: the function gives the coroutine a box of the result, which the promise owns (returnPlaced).
		args.push(konst(l, value: 0 as Word))
	end 'inPlace'
	let promise = newReg(l, kind: IrKind.kindManaged)
	let instr = l.b.asyncInstr(promise, target: target, args: args)
	emit(l, i: instr)
	popArgs(l, n: base)
	popPending(l, n: mark)
	return promise
end 'visitAsyncExpr'

// visitAwaitExpr waits for the coroutine of a promise and gives what its function returned; a failure of the function
// goes to the try around the await.
function visitAwaitExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let operand = ast.awaitExprE(p.modules[l.mi].tree, id: e)
	let site = siteOf(l, p: p, node: e)
	let mark = l.pending.count()
	let promise = lowerExpr(l, p: p, ms: ms, e: operand)
	// The await consumes the promise, so no failure after it drops it.
	popPending(l, n: mark)
	let t = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: operand))
	let result = ast.promiseResult(ms.types, reads: p.types, t: t)
	let errTy = ast.promiseError(ms.types, reads: p.types, t: t)
	var dst = noReg
	if result != p.builtins.voidTy 'value'
		let kind = holderKind(l, p: p, ms: ms, t: result)
		dst = newReg(l, kind: kind)
	end 'value'
	if errTy == ast.noType 'plain'
		emitEntry(l, p: p, site: site, dst: dst, symbol: Rt.rtAsyncAwait, args: argsOf1(promise), routine: ast.noFunc)
		return awaited(l, p: p, ms: ms, dst: dst, t: result)
	end 'plain'
	entryVoid(l, p: p, site: site, symbol: Rt.rtAsyncWait, args: argsOf1(promise))
	var errKind = IrKind.kindScalar
	let errApplied = applyType(l, p: p, ms: ms, t: errTy)
	if errorInBox(ms.types, reads: p.types, t: errApplied) 'union'
		errKind = IrKind.kindManaged
	end 'union'
	let err = entry(l, p: p, site: site, symbol: Rt.rtAsyncError, kind: errKind, args: argsOf1(promise))
	emitEntry(l, p: p, site: site, dst: dst, symbol: Rt.rtAsyncTake, args: argsOf1(promise), routine: ast.noFunc)
	let ok = l.b.newBlock()
	let zero = konst(l, value: 0 as Word)
	let failed = compare(l, op: CmpOp.cmpNe, a: err, b: zero, unsigned: false)
	let errDrop = errorDropType(l, p: p, ms: ms, t: errTy)
	let stub = failureBiased(l, p: p, ms: ms, errorCase: 0 as Count, err: err, errDrop: errDrop, bias: errorBias(ms.types, reads: p.types, t: errApplied))
	l.b.terminate(l.cur, t: newBranch(failed, ifTrue: stub, ifFalse: ok))
	l.cur = ok
	return awaited(l, p: p, ms: ms, dst: dst, t: result)
end 'visitAwaitExpr'

// awaited is the value of an await of a result of the type t: what dst holds, taken out of its box for a value held in
// place, or nothing for a function that returns nothing.
function awaited(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, dst Reg, t ast.TypeID) returns Reg
	if dst == noReg 'none'
		return konst(l, value: 0 as Word)
	end 'none'
	return unboxed(l, p: p, ms: ms, v: dst, t: t)
end 'awaited'

// lowerPromiseCancel cancels the coroutine of a promise and waits for it, as maxon's cancel of a tied promise does: one that
// has not started never runs, and one that has runs on with its sleeps ending at once. What its function gave, a value or
// an error, is dropped.
function lowerPromiseCancel(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	let site = siteOf(l, p: p, node: c.node)
	entryVoid(l, p: p, site: site, symbol: Rt.rtAsyncCancel, args: argsOf1(recv))
	let t = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.receiver))
	let result = ast.promiseResult(ms.types, reads: p.types, t: t)
	let errTy = ast.promiseError(ms.types, reads: p.types, t: t)
	var dst = noReg
	var valueDrop = ast.noType
	if result != p.builtins.voidTy 'value'
		let kind = holderKind(l, p: p, ms: ms, t: result)
		dst = newReg(l, kind: kind)
		if holderOwns(l, p: p, ms: ms, t: result) 'managed'
			valueDrop = dropType(l, p: p, ms: ms, t: result)
		end 'managed'
	end 'value'
	if errTy == ast.noType 'plain'
		emitEntry(l, p: p, site: site, dst: dst, symbol: Rt.rtAsyncAwait, args: argsOf1(recv), routine: ast.noFunc)
		dropOutcome(l, dst: dst, valueDrop: valueDrop, err: noReg, errDrop: ast.noType)
		return konst(l, value: 0 as Word)
	end 'plain'
	entryVoid(l, p: p, site: site, symbol: Rt.rtAsyncWait, args: argsOf1(recv))
	let errDrop = errorDropType(l, p: p, ms: ms, t: errTy)
	let errKind = IrKind.kindManaged if errDrop != ast.noType else IrKind.kindScalar
	let err = entry(l, p: p, site: site, symbol: Rt.rtAsyncError, kind: errKind, args: argsOf1(recv))
	emitEntry(l, p: p, site: site, dst: dst, symbol: Rt.rtAsyncTake, args: argsOf1(recv), routine: ast.noFunc)
	dropOutcome(l, dst: dst, valueDrop: valueDrop, err: err, errDrop: errDrop)
	return konst(l, value: 0 as Word)
end 'lowerPromiseCancel'

// lowerPromiseIsComplete is whether the coroutine or the reply of a promise has finished, which waits for nothing.
function lowerPromiseIsComplete(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtAsyncComplete, kind: IrKind.kindScalar, args: argsOf1(recv))
end 'lowerPromiseIsComplete'

// lowerArrayAwaitAny waits until a promise of an array of them has finished and gives the index of the first that has,
// as maxon's awaitAny does: it consumes none, and a slot a take left empty holds none.
function lowerArrayAwaitAny(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, args RegList) returns Reg
	return entry(l, p: p, site: siteOf(l, p: p, node: c.node), symbol: Rt.rtAsyncAwaitAny, kind: IrKind.kindScalar, args: argsOf1(recv))
end 'lowerArrayAwaitAny'
