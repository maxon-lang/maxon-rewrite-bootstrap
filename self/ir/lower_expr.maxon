// constValue is the expression that the value of the constant a name stands for is written as, and the module it is in.
function constantExpr(p ast.Project, name ast.NameInfo) returns ExprRef
	return match ast.moduleDecl(p, ref: name.decl) 'decl'
		constDecl(c) gives ExprRef.make(name.decl.module, node: c.value)
		funcDecl(_) panic("lower: a name of a constant stands for a function")
		typeDecl(_) panic("lower: a name of a constant stands for a type")
		enumDecl(_) panic("lower: a name of a constant stands for an enum")
		unionDecl(_) panic("lower: a name of a constant stands for a union")
		aliasDecl(_) panic("lower: a name of a constant stands for a typealias")
		interfaceDecl(_) panic("lower: a name of a constant stands for an interface")
		extensionDecl(_) panic("lower: a name of a constant stands for an extension")
	end 'decl'
end 'constantExpr'

// exprIn lowers an expression that is in another module than the code around it.
function exprIn(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ExprRef) returns Reg
	let saved = l.module
	setModule(l, m: e.module)
	let v = lowerExpr(l, p: p, ms: ms, e: e.node)
	setModule(l, m: saved)
	return v
end 'exprIn'

// lowerExpr lowers an expression to the register that holds its value, and settles who owns that value. One that the
// ownership pass marked consumed passes to its new owner, and a place that is consumed is moved out of (a whole local or a
// field of an owned one; the pass refuses every other). One that is not consumed only lends its value: a fresh value there
// is a temporary, dropped when the statement or branch ends.
//
// A value that is consumed is in flight until what takes it runs, which is the expression around it or the statement: a
// failure before then drops it (see failure).
function lowerExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let ty = exprType(p, module: l.module, node: e)
	let iface = ast.boxedTo(p.typings[l.mi], node: e)
	let applied = applyType(l, p: p, ms: ms, t: ty)
	let boxes = iface != ast.noType and not standsForInterface(p, ms: ms, t: applied)
	let branches = isBranching(p.modules[l.mi].tree.kindOf(e))
	if ast.typeKind(ms.types, reads: p.types, t: ty) == ast.TypeKind.constInt and not branches 'constant'
		let c = konst(l, value: wordOf(ast.typeEntry(ms.types, reads: p.types, t: ty).minVal))
		if boxes 'boxedConstant'
			return lowerBoxed(l, p: p, ms: ms, e: e, v: c, ty: ty, iface: iface)
		end 'boxedConstant'
		return c
	end 'constant'
	if ast.typeKind(ms.types, reads: p.types, t: ty) == ast.TypeKind.constFloat and not branches 'floatConstant'
		return konst(l, value: floatWord(ast.floatLowBits(ms.types, reads: p.types, t: ty)))
	end 'floatConstant'
	if p.modules[l.mi].tree.kindOf(e) == ast.NodeKind.tryExpr and ast.isTransparent(p.modules[l.mi].tree, e: e) 'transparent'
		return lowerThrough(l, p: p, ms: ms, t: e)
	end 'transparent'
	if isViewExpr(l, p: p, e: e) 'view'
		return lowerExpr(l, p: p, ms: ms, e: ast.memberExprObj(p.modules[l.mi].tree, id: e))
	end 'view'
	if p.typings[l.mi].slotTakes.has(e as Count) 'slot'
		return takeFromSlot(l, p: p, ms: ms, e: e, ty: ty)
	end 'slot'
	let mark = l.pending.count()
	var v = visitExpr(l, p: p, ms: ms, e: e)
	popPending(l, n: mark)
	if p.typings[l.mi].rawReads.has(e as Count) 'raw'
		return rawValueOf(l, p: p, ms: ms, t: applied, index: v)
	end 'raw'
	if boxes 'boxed'
		return lowerBoxed(l, p: p, ms: ms, e: e, v: v, ty: ty, iface: iface)
	end 'boxed'
	if not owning(regKind(l, v: v)) 'scalar'
		return v
	end 'scalar'
	let consumed = isConsumed(p, module: l.module, node: e)
	v = settle(l, p: p, ms: ms, e: e, v: v, ty: ty, consumed: consumed)
	if consumed and not isImmortal(l, p: p, e: e) 'inFlight'
		let dropTy = dropType(l, p: p, ms: ms, t: ty)
		l.pending.push(PendingDrop.ofReg(v, ty: dropTy))
	end 'inFlight'
	return v
end 'lowerExpr'

// takeFromSlot moves the promise out of the element or the field e, which the ownership pass found consumed there, and
// leaves the slot empty, so that the holder's drop skips it and a second take finds it empty (rt.async's exit 118). The
// promise is in flight until what takes it runs.
function takeFromSlot(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, ty ast.TypeID) returns Reg
	let places = l.writeBacks.count()
	let addr = slotAddress(l, p: p, ms: ms, e: e)
	let v = moveOutAt(l, p: p, ms: ms, addr: addr, t: ty)
	writeBack(l, p: p, ms: ms, mark: places)
	let dropTy = dropType(l, p: p, ms: ms, t: ty)
	l.pending.push(PendingDrop.ofReg(v, ty: dropTy))
	return v
end 'takeFromSlot'

// slotAddress is the address of the slot that e names: the element a for's variable stands for, in a for over slots, or
// the element or field e is.
function slotAddress(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	if p.modules[l.mi].tree.kindOf(e) == ast.NodeKind.nameExpr and nameInfoAt(p, module: l.module, node: e).kind == ast.NameKind.nameLocal 'name'
		let name = nameInfoAt(p, module: l.module, node: e)
		for k in 0 upto l.slotLoops.count() 'loops'
			let at = try l.slotLoops.count() - 1 - k otherwise panic("lower: a for over slots past the list")
			if l.slotLoops[at].local == name.local 'loop'
				let box = l.slotLoops[at].box.clone()
				let held = l.slotLoops[at].held
				let index = l.slotLoops[at].index
				let arr = load(l, slot: held)
				let i = load(l, slot: index)
				return arrayAddress(l, p: p, ms: ms, box: box, arr: arr, index: i, checked: false)
			end 'loop'
		end 'loops'
		panic("lower: a promise is taken out of the variable of no for over slots at offset {p.modules[l.mi].tree.startOf(e)}")
	end 'name'
	return address(l, p: p, ms: ms, e: e)
end 'slotAddress'

// settle gives the managed value v of e its owner, as far as the expression decides: a fresh value that is not consumed is
// a temporary of the statement, and a consumed place that shares on copy is copied.
function settle(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, v Reg, ty ast.TypeID, consumed bool) returns Reg
	if readsDatum(l, p: p, ms: ms, e: e) 'constant'
		// The executable's data is never written or dropped, so whatever takes the value takes a copy of it.
		if consumed 'owned'
			return copyValue(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), v: v, t: ty)
		end 'owned'
		return v
	end 'constant'
	if not ast.isStorage(p.modules[l.mi].tree, typing: p.typings[l.mi], node: e) 'fresh'
		if not consumed and not isImmortal(l, p: p, e: e) 'temporary'
			ownTemp(l, p: p, ms: ms, v: v, t: ty)
		end 'temporary'
		return v
	end 'fresh'
	if consumed and ast.sharesOnCopy(ms.types, reads: p.types, t: ty) 'shared'
		return copyValue(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), v: v, t: ty)
	end 'shared'
	if consumed and not isWholeLocal(l, p: p, e: e) and not isField(l, p: p, e: e) 'moved'
		panic("lower: an element or a part of a temporary is moved out at offset {p.modules[l.mi].tree.startOf(e)} of module {l.module}; the ownership pass should have refused it")
	end 'moved'
	return v
end 'settle'

// readsDatum is whether e reads a constant that is a datum of the executable: a constant that is one, or the raw value of an
// enum or a union whose raw values are.
function readsDatum(mutates l Lowerer, p ast.Project, ms ast.ModuleState, e ast.NodeID) returns bool
	let through = ast.through(p.modules[l.mi].tree, e: e)
	let k = p.modules[l.mi].tree.kindOf(through)
	if k == ast.NodeKind.nameExpr 'name'
		let name = nameInfoAt(p, module: l.module, node: through)
		return name.kind == ast.NameKind.nameConst and constantDatum(p, ms: ms, name: name).isSome()
	end 'name'
	if k != ast.NodeKind.memberExpr 'notMember'
		return false
	end 'notMember'
	let member = memberInfoAt(p, module: l.module, node: through)
	var owner = member.ownerTy
	if member.kind == ast.MemberKind.memberEnumRaw or member.kind == ast.MemberKind.memberUnionRaw 'raw'
		owner = exprType(p, module: l.module, node: ast.memberExprObj(p.modules[l.mi].tree, id: through))
	end 'raw' else if member.kind != ast.MemberKind.memberCaseRaw 'other'
		return false
	end 'other'
	return rawDatums(p, ms: ms, origin: ast.typeEntry(ms.types, reads: p.types, t: owner).effectiveOrigin()).isSome()
end 'readsDatum'

// datumReg is the value of a constant of the executable's data, which no one owns.
function datumReg(mutates l Lowerer, consumes d Datum) returns Reg
	let r = newReg(l, kind: IrKind.kindManaged)
	let instr = l.b.datum(r, d: d)
	emit(l, i: instr)
	return r
end 'datumReg'

// isBranching is whether an expression of the kind picks a branch by a value it computes, so that its type can be one
// constant that its branches agree on while the condition, the subject or an arm that panics still has to run.
function isBranching(k ast.NodeKind) returns bool
	return k == ast.NodeKind.condExpr or k == ast.NodeKind.matchExpr
end 'isBranching'

function visitExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let k = p.modules[l.mi].tree.kindOf(e)
	if k == ast.NodeKind.intLit 'intLit'
		return konst(l, value: wordOf(ast.intLitValue(p.modules[l.mi].tree, id: e)))
	end 'intLit'
	if k == ast.NodeKind.floatLit 'floatLit'
		return konst(l, value: floatWord(ast.floatLitBits(p.modules[l.mi].tree, id: e)))
	end 'floatLit'
	if k == ast.NodeKind.boolLit 'boolLit'
		if ast.boolLitValue(p.modules[l.mi].tree, id: e) 'true'
			return konst(l, value: 1 as Word)
		end 'true'
		return konst(l, value: 0 as Word)
	end 'boolLit'
	if k == ast.NodeKind.strLit 'strLit'
		return visitStrLit(l, p: p, ms: ms, e: e)
	end 'strLit'
	if k == ast.NodeKind.byteStrLit 'byteStrLit'
		return visitByteStrLit(l, p: p, ms: ms, e: e)
	end 'byteStrLit'
	if k == ast.NodeKind.charLit 'charLit'
		if ast.isIntType(ms.types, reads: p.types, t: exprType(p, module: l.module, node: e)) 'codepoint'
			// A literal beside an integer is its code point (check.integerized).
			return konst(l, value: countWord(ast.charLitCodepoint(p.modules[l.mi].tree, id: e).unwrap()))
		end 'codepoint'
		let d = newReg(l, kind: IrKind.kindString)
		let instr = l.b.character(d, text: ast.charLitText(p.modules[l.mi].tree, id: e))
		emit(l, i: instr)
		return d
	end 'charLit'
	if k == ast.NodeKind.nameExpr 'nameExpr'
		return visitNameExpr(l, p: p, ms: ms, e: e)
	end 'nameExpr'
	if k == ast.NodeKind.selfExpr 'selfExpr'
		if l.selfOwner != noSlot 'owned'
			return ownedRead(l, p: p, ms: ms, slot: slotIndex(l.selfOwner), e: e)
		end 'owned'
		return selfReg(l, p: p, ms: ms)
	end 'selfExpr'
	if k == ast.NodeKind.binaryExpr 'binaryExpr'
		return visitBinaryExpr(l, p: p, ms: ms, e: e)
	end 'binaryExpr'
	if k == ast.NodeKind.unaryExpr 'unaryExpr'
		return visitUnaryExpr(l, p: p, ms: ms, e: e)
	end 'unaryExpr'
	if k == ast.NodeKind.condExpr 'condExpr'
		return visitCondExpr(l, p: p, ms: ms, e: e)
	end 'condExpr'
	if k == ast.NodeKind.castExpr 'castExpr'
		return visitCastExpr(l, p: p, ms: ms, e: e)
	end 'castExpr'
	if k == ast.NodeKind.fromExpr 'fromExpr'
		return visitFromExpr(l, p: p, ms: ms, e: e)
	end 'fromExpr'
	if k == ast.NodeKind.rangeExpr 'rangeExpr'
		return visitRangeExpr(l, p: p, ms: ms, e: e)
	end 'rangeExpr'
	if k == ast.NodeKind.memberExpr 'memberExpr'
		return visitMemberExpr(l, p: p, ms: ms, e: e)
	end 'memberExpr'
	if k == ast.NodeKind.tryExpr 'tryExpr'
		return visitTryExpr(l, p: p, ms: ms, e: e)
	end 'tryExpr'
	if k == ast.NodeKind.panicExpr 'panicExpr'
		return visitPanicExpr(l, p: p, ms: ms, e: e)
	end 'panicExpr'
	if k == ast.NodeKind.callExpr 'callExpr'
		return visitCallExpr(l, p: p, ms: ms, node: e)
	end 'callExpr'
	if k == ast.NodeKind.structLitExpr or k == ast.NodeKind.tupleExpr 'structLitExpr'
		return visitStructLitExpr(l, p: p, ms: ms, e: e)
	end 'structLitExpr'
	if k == ast.NodeKind.indexExpr 'indexExpr'
		return visitIndexExpr(l, p: p, ms: ms, e: e)
	end 'indexExpr'
	if k == ast.NodeKind.collectionLitExpr 'collectionLitExpr'
		return visitCollectionLitExpr(l, p: p, ms: ms, e: e)
	end 'collectionLitExpr'
	if k == ast.NodeKind.matchExpr 'matchExpr'
		return lowerMatch(l, p: p, ms: ms, core: ast.matchExprMatch(p.modules[l.mi].tree, id: e), resultType: exprType(p, module: l.module, node: e))
	end 'matchExpr'
	if k == ast.NodeKind.closureExpr 'closureExpr'
		return visitClosureExpr(l, p: p, ms: ms, e: e)
	end 'closureExpr'
	if k == ast.NodeKind.asyncExpr 'asyncExpr'
		return visitAsyncExpr(l, p: p, ms: ms, e: e)
	end 'asyncExpr'
	if k == ast.NodeKind.spawnExpr 'spawnExpr'
		return visitSpawnExpr(l, p: p, ms: ms, e: e)
	end 'spawnExpr'
	if k == ast.NodeKind.awaitExpr 'awaitExpr'
		return visitAwaitExpr(l, p: p, ms: ms, e: e)
	end 'awaitExpr'
	if k == ast.NodeKind.typeQueryExpr 'typeQueryExpr'
		return visitTypeQueryExpr(l, p: p, ms: ms, e: e)
	end 'typeQueryExpr'
	panic("lower: the node {e} of kind {k.name} is no expression")
end 'visitExpr'

// visitTypeQueryExpr is sizeof of a type that a generic's parameters build, which the instance being lowered fixes, or
// countof the receiver; of a concrete type each is a constant, which lowerExpr gives.
function visitTypeQueryExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let written = exprType(p, module: l.module, node: ast.typeQueryExprType(p.modules[l.mi].tree, id: e))
	if ast.typeQueryExprOp(p.modules[l.mi].tree, id: e) == "countof" 'receiverCount'
		// The count of the receiver of a method of an extension of FixedArray, whose Self states none.
		let box = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), t: written)
		let receiver = selfReg(l, p: p, ms: ms)
		return arrayLength(l, p: p, ms: ms, box: box, arr: receiver)
	end 'receiverCount'
	let applied = applyType(l, p: p, ms: ms, t: written)
	let size = try ast.byteSize(ms.types, reads: p.types, t: applied) as Word otherwise panic("lower: a size is a word")
	return konst(l, value: size)
end 'visitTypeQueryExpr'

function isWholeLocal(mutates l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let through = ast.through(p.modules[l.mi].tree, e: e)
	let k = p.modules[l.mi].tree.kindOf(through)
	if k == ast.NodeKind.nameExpr 'name'
		return nameInfoAt(p, module: l.module, node: through).kind == ast.NameKind.nameLocal
	end 'name'
	return k == ast.NodeKind.selfExpr
end 'isWholeLocal'

// isViewExpr is whether an expression is a view of a value (`xs.managed`), which is the value itself.
function isViewExpr(mutates l Lowerer, p ast.Project, e ast.NodeID) returns bool
	return p.modules[l.mi].tree.kindOf(e) == ast.NodeKind.memberExpr and memberInfoAt(p, module: l.module, node: e).kind == ast.MemberKind.memberView
end 'isViewExpr'

// isField is whether a place is a field of a record, which a move leaves empty.
function isField(mutates l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let through = ast.through(p.modules[l.mi].tree, e: e)
	let k = p.modules[l.mi].tree.kindOf(through)
	if k == ast.NodeKind.nameExpr 'name'
		return nameInfoAt(p, module: l.module, node: through).kind == ast.NameKind.nameSelfField
	end 'name'
	if k == ast.NodeKind.memberExpr 'member'
		return memberInfoAt(p, module: l.module, node: through).kind == ast.MemberKind.memberField
	end 'member'
	return false
end 'isField'

// isImmortal is whether a value is a string that lives in the executable, which is never dropped: a literal, or the name
// of an enum or union case. A character literal is too, or two words that own nothing.
function isImmortal(mutates l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let through = ast.through(p.modules[l.mi].tree, e: e)
	let k = p.modules[l.mi].tree.kindOf(through)
	if k == ast.NodeKind.charLit 'character'
		return true
	end 'character'
	if k == ast.NodeKind.strLit 'str'
		return p.modules[l.mi].tree.strIsPlain(ast.strLitPartsRef(p.modules[l.mi].tree, id: through))
	end 'str'
	if k == ast.NodeKind.memberExpr 'member'
		let kind = memberInfoAt(p, module: l.module, node: through).kind
		return kind == ast.MemberKind.memberEnumName or kind == ast.MemberKind.memberUnionName or kind == ast.MemberKind.memberCaseName
	end 'member'
	if k == ast.NodeKind.nameExpr 'name'
		let name = nameInfoAt(p, module: l.module, node: through)
		if name.kind == ast.NameKind.nameConst 'const'
			let value = constantExpr(p, name: name)
			let saved = l.module
			setModule(l, m: value.module)
			let immortal = isImmortal(l, p: p, e: value.node)
			setModule(l, m: saved)
			return immortal
		end 'const'
	end 'name'
	return false
end 'isImmortal'

function visitCondExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let cond = lowerExpr(l, p: p, ms: ms, e: ast.condExprCond(p.modules[l.mi].tree, id: e))
	let typ = exprType(p, module: l.module, node: e)
	let result = l.b.f.newSlot(kindOf(l, p: p, ms: ms, t: typ))
	let a = l.b.newBlock()
	let b = l.b.newBlock()
	let join = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: a, ifFalse: b))
	l.cur = a
	pushScope(l, block: false)
	storeConverted(l, p: p, ms: ms, slot: result, e: ast.condExprThen(p.modules[l.mi].tree, id: e), target: typ)
	popScope(l, p: p, ms: ms)
	goTo(l, target: join)
	l.cur = b
	pushScope(l, block: false)
	storeConverted(l, p: p, ms: ms, slot: result, e: ast.condExprElse(p.modules[l.mi].tree, id: e), target: typ)
	popScope(l, p: p, ms: ms)
	goTo(l, target: join)
	return fetch(l, slot: result)
end 'visitCondExpr'

// storeConverted puts the value of one branch of an expression, converted to the type the expression has, into the slot
// that holds it until the branches join, which takes the value: it is no longer in flight, and the other branch never had
// it.
function storeConverted(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, slot Count, e ast.NodeID, target ast.TypeID)
	let mark = l.pending.count()
	let v = lowerConverted(l, p: p, ms: ms, e: e, target: target)
	emit(l, i: newStoreSlot(slot, src: v, borrow: false))
	popPending(l, n: mark)
end 'storeConverted'

function lowerConverted(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, target ast.TypeID) returns Reg
	let lowered = lowerExpr(l, p: p, ms: ms, e: e)
	// A frozen value given to a let parameter of the type it holds lends its contents.
	let have = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e))
	let want = applyType(l, p: p, ms: ms, t: target)
	let v = contentsLent(l, p: p, ms: ms, e: e, v: lowered, have: have, want: want)
	if ast.isFloatType(ms.types, reads: p.types, t: want) and ast.isIntType(ms.types, reads: p.types, t: have) 'toFloat'
		return floatOf(l, p: p, ms: ms, v: v, e: e)
	end 'toFloat'
	return v
end 'lowerConverted'

// heldType is the type of the value a frozen value or a cown holds.
function heldType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	return ast.typeArgAt(ms.types, reads: p.types, t: t, index: 0)
end 'heldType'

// siteOf is where a node is, which a refusal at it is reported at.
function siteOf(l Lowerer, p ast.Project, node ast.NodeID) returns diag.Site
	return diag.Site.make(l.module, offset: p.modules[l.mi].tree.startOf(node))
end 'siteOf'

function visitStructLitExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let lit = structLitInfoAt(p, module: l.module, node: e)
	let ty = exprType(p, module: l.module, node: e)
	if ast.typeKind(ms.types, reads: p.types, t: lit.ty) == ast.TypeKind.builtinArray 'emptyArray'
		let box = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), t: ty)
		return arrayNew(l, p: p, ms: ms, box: box)
	end 'emptyArray'
	let origin = ast.typeEntry(ms.types, reads: p.types, t: lit.ty).effectiveOrigin()
	var values = ExprRefList.create(0)
	for i in 0 upto lit.ordered.count() 'each'
		if lit.ordered[i] != 0 'given'
			values.push(ExprRef.make(l.module, node: lit.ordered[i]))
		end 'given' else 'default'
			values.push(ExprRef.make(ast.typeEntry(ms.types, reads: p.types, t: origin).decl.module, node: ast.typeEntry(ms.types, reads: p.types, t: origin).fields[i].defaultExpr))
		end 'default'
	end 'each'
	return record(l, p: p, ms: ms, t: ty, tag: noTag, values: values)
end 'visitStructLitExpr'

function visitCastExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let inner = ast.castExprE(p.modules[l.mi].tree, id: e)
	let written = exprType(p, module: l.module, node: e)
	let castTy = applyType(l, p: p, ms: ms, t: written)
	if isRecoveryCast(l, p: p, ms: ms, e: e) 'recovered'
		return lowerRecoveryCast(l, p: p, ms: ms, e: e, inner: inner, target: castTy)
	end 'recovered'
	let v = lowerExpr(l, p: p, ms: ms, e: inner)
	if ast.castRebrands(ms.types, reads: p.types, target: castTy) 'rebrand'
		// The value is the operand's, which the ownership pass gave it; a cast to an interface is the box its operand was
		// put in.
		return v
	end 'rebrand'
	let fails = arithInfoAt(p, module: l.module, node: e).fails
	let fail = overflowTo(l, p: p, ms: ms, fails: fails)
	if ast.typeKind(ms.types, reads: p.types, t: castTy) == ast.TypeKind.floatRange 'float'
		return floatConverted(l, p: p, ms: ms, v: v, e: inner, target: castTy, fails: fails)
	end 'float'
	requireInt(p, ms: ms, t: castTy)
	var source = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: inner))
	if ast.familyOfSelf(ms.types, reads: p.types, t: written) != ast.noType and ast.typeKind(ms.types, reads: p.types, t: source) == ast.TypeKind.constInt 'constant'
		// The checker could not tell whether a constant fits the instance's range, which the check against the widest
		// integer does.
		source = p.builtins.anon64Ty
	end 'constant'
	fit(l, p: p, ms: ms, v: v, target: castTy, source: source, fails: fails, fail: fail)
	return v
end 'visitCastExpr'

function requireInt(p ast.Project, ms ast.ModuleState, t ast.TypeID)
	if ast.typeKind(ms.types, reads: p.types, t: t) != ast.TypeKind.intRange 'range'
		panic("lower: {ast.typeName(ms.types, reads: p.types, t: t)} is not an integer type")
	end 'range'
end 'requireInt'

function visitPanicExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let msg = lowerExpr(l, p: p, ms: ms, e: ast.panicExprMessage(p.modules[l.mi].tree, id: e))
	let location = strReg(l, value: ast.panicLocation(p.modules[l.mi], offset: p.modules[l.mi].tree.startOf(e)))
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanicAt, args: argsOf2(location, b: msg), routine: ast.noFunc)
	seal(l, t: newTrap())
	return konst(l, value: 0 as Word)
end 'visitPanicExpr'

function visitNameExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let name = nameInfoAt(p, module: l.module, node: e)
	if name.kind == ast.NameKind.nameLocal 'local'
		let loc = localEntry(p, module: l.fnModule, id: name.local)
		if not loc.isParam 'variable'
			return ownedRead(l, p: p, ms: ms, slot: slotOf(loc), e: e)
		end 'variable'
		if loc.isCapture and not isByRef(loc) 'captured'
			return captureRead(l, p: p, ms: ms, loc: loc)
		end 'captured'
		if not isByRef(loc) 'byValue'
			let owner = ownerOf(l, id: name.local, isSelf: loc.isSelf)
			if owner != noSlot 'owned'
				return ownedRead(l, p: p, ms: ms, slot: slotIndex(owner), e: e)
			end 'owned'
			return paramReg(l, index: loc.paramIndex, kind: kindOf(l, p: p, ms: ms, t: loc.ty))
		end 'byValue'
		let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: loc.ty))
		let addr = refAddress(l, p: p, ms: ms, loc: loc)
		emit(l, i: newLoadAt(d, addr: addr, filled: false))
		return d
	end 'local'
	if name.kind == ast.NameKind.nameSelfField 'field'
		let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e)))
		let obj = selfReg(l, p: p, ms: ms)
		let owner = selfType(l, p: p, ms: ms)
		let offset = fieldAt(l, p: p, ms: ms, owner: owner, index: name.fieldIndex)
		let h = fieldHeld(l, p: p, ms: ms, owner: owner, index: name.fieldIndex, t: exprType(p, module: l.module, node: e))
		loadField(l, p: p, ms: ms, d: d, obj: obj, e: e, offset: offset, h: h)
		return d
	end 'field'
	if name.kind == ast.NameKind.nameConst 'const'
		match consumes p.typings[l.mi].staticInstances.get(e as Count) 'instance'
			some(instance) then return lowerInstanceConstant(l, p: p, ms: ms, name: name, instance: instance)
			none then _ = 0
		end 'instance'
		match consumes constantDatum(p, ms: ms, name: name) 'datum'
			some(d) then return datumReg(l, d: d)
			none then _ = 0
		end 'datum'
		return exprIn(l, p: p, ms: ms, e: constantExpr(p, name: name))
	end 'const'
	if name.kind == ast.NameKind.nameFunc 'function'
		return functionValue(l, fn: name.func)
	end 'function'
	panic("lower: unresolved name '{ast.nameExprName(p.modules[l.mi].tree, id: e)}'")
end 'visitNameExpr'

// loadField is the value of a field of a record: a move out of it when the ownership pass found the expression consuming
// it, which leaves 0 in the field for the drop of the record to skip, and a borrow otherwise. A field whose words are the
// record's own (held as h) is their address, which the record lends: whoever keeps the value copies the words.
function loadField(mutates l Lowerer, p ast.Project, ms ast.ModuleState, d Reg, obj Reg, e ast.NodeID, offset Count, h Holding)
	match h 'holding'
		heldInline(_) then emit(l, i: newFieldAddr(d, obj: obj, offset: offset))
		heldWord or
		heldString or
		heldBox then loadOwnField(l, p: p, ms: ms, d: d, obj: obj, e: e, offset: offset)
		heldAddress(_) panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
		heldPacked panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
	end 'holding'
end 'loadField'

// loadOwnField is the value of a field the record holds in its form: moved out or borrowed, as loadField says.
function loadOwnField(mutates l Lowerer, p ast.Project, ms ast.ModuleState, d Reg, obj Reg, e ast.NodeID, offset Count)
	if movesOut(p, ms: ms, module: l.module, node: e) and owning(regKind(l, v: d)) 'move'
		let addr = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newFieldAddr(addr, obj: obj, offset: offset))
		emit(l, i: newMoveAt(d, addr: addr))
		return
	end 'move'
	emit(l, i: newLoadField(d, obj: obj, offset: offset))
end 'loadOwnField'

// address is where a call that takes e by address finds it. An element of a byte array is given as a slot, so the caller
// stores what the callee left there back with writeBack once the callee returns.
function address(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let k = p.modules[l.mi].tree.kindOf(e)
	if k == ast.NodeKind.nameExpr 'name'
		let name = nameInfoAt(p, module: l.module, node: e)
		if name.kind == ast.NameKind.nameLocal 'local'
			let loc = localEntry(p, module: l.fnModule, id: name.local)
			if isByRef(loc) 'byRef'
				return refAddress(l, p: p, ms: ms, loc: loc)
			end 'byRef'
			let element = parallelElementPlace(l, p: p, ms: ms, local: name.local, slot: slotOf(loc))
			if element != noReg 'element'
				return element
			end 'element'
			placeSlot(l, slot: slotOf(loc))
			let d = newReg(l, kind: IrKind.kindScalar)
			emit(l, i: newSlotAddr(d, slot: slotOf(loc)))
			return d
		end 'local'
		if name.kind == ast.NameKind.nameSelfField 'field'
			let d = newReg(l, kind: IrKind.kindScalar)
			let obj = selfReg(l, p: p, ms: ms)
			let owner = selfType(l, p: p, ms: ms)
			let offset = fieldAt(l, p: p, ms: ms, owner: owner, index: name.fieldIndex)
			emit(l, i: newFieldAddr(d, obj: obj, offset: offset))
			return fieldPlace(l, p: p, ms: ms, owner: owner, index: name.fieldIndex, t: exprType(p, module: l.module, node: e), addr: d)
		end 'field'
	end 'name'
	if k == ast.NodeKind.memberExpr 'member'
		let member = memberInfoAt(p, module: l.module, node: e)
		if member.kind == ast.MemberKind.memberView 'view'
			return address(l, p: p, ms: ms, e: ast.memberExprObj(p.modules[l.mi].tree, id: e))
		end 'view'
		if member.kind == ast.MemberKind.memberField 'field'
			let objExpr = ast.memberExprObj(p.modules[l.mi].tree, id: e)
			let obj = lowerRead(l, p: p, ms: ms, e: objExpr)
			let d = newReg(l, kind: IrKind.kindScalar)
			let owner = exprType(p, module: l.module, node: objExpr)
			let offset = fieldAt(l, p: p, ms: ms, owner: owner, index: member.fieldIndex)
			emit(l, i: newFieldAddr(d, obj: obj, offset: offset))
			return fieldPlace(l, p: p, ms: ms, owner: owner, index: member.fieldIndex, t: exprType(p, module: l.module, node: e), addr: d)
		end 'field'
	end 'member'
	if k == ast.NodeKind.indexExpr 'index'
		return elemPlace(l, p: p, ms: ms, e: e)
	end 'index'
	if k == ast.NodeKind.tryExpr and ast.isTransparent(p.modules[l.mi].tree, e: e) 'try'
		return lowerThroughAs(l, p: p, ms: ms, t: e, place: true)
	end 'try'
	if k == ast.NodeKind.callExpr and lendsByAddressAt(l, p: p, ms: ms, node: e) 'lent'
		let lent = lowerCall(l, p: p, ms: ms, c: callSite(l, p: p, node: e))
		let lentTy = exprType(p, module: l.module, node: e)
		if lentInByte(l, p: p, ms: ms, t: lentTy) 'byte'
			return lentBytePlace(l, site: siteOf(l, p: p, node: e), t: lentTy, at: lent)
		end 'byte'
		return match held(l, p: p, ms: ms, t: lentTy) 'holding'
			heldAddress(_) gives heldPlace(l, words: lent)
			heldWord gives lent
			heldString gives lent
			heldBox gives lent
			heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
			heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		end 'holding'
	end 'lent'
	let ty = exprType(p, module: l.module, node: e)
	if ast.isMutatingFunction(ms.types, reads: p.types, t: ty) 'temporary'
		// A new function value that the callee changes lives in a slot of its own, which drops what the callee leaves there.
		let mark = l.pending.count()
		let v = visitExpr(l, p: p, ms: ms, e: e)
		popPending(l, n: mark)
		let slot = l.b.f.newSlot(IrKind.kindManaged)
		emit(l, i: newStoreSlot(slot, src: v, borrow: false))
		ownLocal(l, p: p, ms: ms, slot: slot, t: ty)
		let d = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newSlotAddr(d, slot: slot))
		return d
	end 'temporary'
	panic("lower: no address for this expression")
end 'address'

// CallSite is a call being lowered: its node, which is where a refusal is reported, and what the checker found out about
// it. receiver is the object it is made on, found once, and ordered are the arguments in the order of the parameters.
export type CallSite
	export var node as ast.NodeID
	export var info as ast.CallInfo
	export var receiver as ast.NodeID
	export var ordered as ast.NodeIDList

	export static function make(node ast.NodeID, consumes info ast.CallInfo, receiver ast.NodeID, consumes ordered ast.NodeIDList) returns CallSite
		return CallSite{node: node, info: info, receiver: receiver, ordered: ordered}
	end 'make'
end 'CallSite'

// callSite is the call a node is, with what its module's checker found out about it.
function callSite(l Lowerer, p ast.Project, node ast.NodeID) returns CallSite
	let info = callInfoAt(p, module: l.module, node: node)
	let receiver = ast.callReceiver(p.modules[l.mi].tree, e: node, kind: info.kind)
	let ordered = info.ordered.clone()
	return CallSite.make(node, info: info.clone(), receiver: receiver, ordered: ordered)
end 'callSite'

function argsSince(l Lowerer, base Count) returns RegList
	var out = RegList.create(0)
	for i in base upto l.args.count() 'each'
		out.push(l.args[i])
	end 'each'
	return out
end 'argsSince'

// lowerCall lowers a call of a function, a static function or a method, whose failure goes to the try around it.
function lowerCall(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite) returns Reg
	let mark = l.pending.count()
	let node = c.node
	let kind = c.info.kind
	if kind != ast.CallKind.callBound and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.fn).intrinsic != ast.Intrinsic.intrNone 'intrinsic'
		return lowerIntrinsic(l, p: p, ms: ms, c: c)
	end 'intrinsic'
	let places = l.writeBacks.count()
	var recv = noReg
	if c.receiver != 0 'receiver'
		recv = lowerRead(l, p: p, ms: ms, e: c.receiver)
	end 'receiver'
	return callOn(l, p: p, ms: ms, c: c, recv: recv, mark: mark, places: places)
end 'lowerCall'

// lowerOperatorCall lowers a comparison that the check made a call of 'equals' or 'compare' on the left operand, lowered to
// left: an ordering tests the case of the Ordering that 'compare' returns.
function lowerOperatorCall(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, op String, left Reg) returns Reg
	var info = callInfoAt(p, module: l.module, node: e)
	var sig = info.fn
	if info.kind == ast.CallKind.callBound 'bound'
		sig = info.method
	end 'bound'
	let ordering = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: sig).retTy
	let ordered = info.ordered.clone()
	let c = CallSite.make(e, info: info.clone(), receiver: ast.binaryExprL(p.modules[l.mi].tree, id: e), ordered: ordered)
	let result = operatorCallResult(l, p: p, ms: ms, c: c, left: left)
	if op == "==" 'equal'
		return result
	end 'equal'
	if op == "!=" 'notEqual'
		let zero = konst(l, value: 0 as Word)
		return compare(l, op: CmpOp.cmpEq, a: result, b: zero, unsigned: true)
	end 'notEqual'
	// a < b is lessThan and a <= b is not greaterThan, and so on.
	var test = CmpOp.cmpEq
	var caseName = ast.orderingLessThan
	if op == "<=" or op == ">=" 'inclusive'
		test = CmpOp.cmpNe
	end 'inclusive'
	if op == ">" or op == "<=" 'greater'
		caseName = ast.orderingGreaterThan
	end 'greater'
	let ordinal = ast.orderingCase(ms.types, reads: p.types, t: ordering, name: caseName)
	let tested = konst(l, value: try ordinal as Word otherwise panic("lower: an Ordering has more cases than a word holds"))
	return compare(l, op: test, a: result, b: tested, unsigned: true)
end 'lowerOperatorCall'

// operatorCallResult is the result of the call c that a comparison makes on its left operand, lowered to left: a built-in
// method is lowered in place, on the right operand, as a call of it is.
function operatorCallResult(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, left Reg) returns Reg
	let op = c.info.intrinsic
	if c.info.kind != ast.CallKind.callBound and op != ast.Intrinsic.intrNone 'builtIn'
		if ownsOperands(op) 'owns'
			panic("lower: the built-in {op.name} that a comparison calls lowers its own operands")
		end 'owns'
		let mark = l.pending.count()
		var args = RegList.create(0)
		args.push(lowerExpr(l, p: p, ms: ms, e: c.ordered[0]))
		let result = intrinsicCall(l, p: p, ms: ms, op: op, c: c, recv: left, args: args)
		popPending(l, n: mark)
		return result
	end 'builtIn'
	let mark = l.pending.count()
	let places = l.writeBacks.count()
	return callOn(l, p: p, ms: ms, c: c, recv: left, mark: mark, places: places)
end 'operatorCallResult'

// lowerBuiltinWitness lowers a call through a bound that a built-in method meets (instances.witnessFor), as a call of that
// method lowers: in place, on the receiver and the arguments already lowered from base on.
function lowerBuiltinWitness(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, target ast.FuncID, recv Reg, base Count, mark Count) returns Reg
	let op = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).intrinsic
	if ownsOperands(op) 'owns'
		panic("lower: the built-in {op.name} meets a requirement but lowers its own operands")
	end 'owns'
	var info = c.info.clone()
	info.fn = target
	info.kind = ast.CallKind.callMethod
	let site = CallSite.make(c.node, info: info, receiver: c.receiver, ordered: c.ordered.clone())
	var args = RegList.create(0)
	var first = base
	if recv != noReg 'receiver'
		first = succ(base)
	end 'receiver'
	for i in first upto l.args.count() 'args'
		args.push(l.args[i])
	end 'args'
	popPending(l, n: mark)
	let result = intrinsicCall(l, p: p, ms: ms, op: op, c: site, recv: recv, args: args)
	popArgs(l, n: base)
	return result
end 'lowerBuiltinWitness'

// callOn lowers the call c on the receiver recv, already lowered (noReg for a call that has none). mark and places are
// the pending drops and the write-backs from before the receiver was lowered.
function callOn(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, recv Reg, mark Count, places Count) returns Reg
	let node = c.node
	let kind = c.info.kind
	let iface = witnessInterface(p, ms: ms, module: l.module, receiver: c.receiver, info: c.info, bindParams: l.bindParams, bindArgs: l.bindArgs)
	var target = ast.noFunc
	if iface == ast.noType 'direct'
		target = callee(l, p: p, ms: ms, node: node, info: c.info, receiver: c.receiver)
	end 'direct'
	let base = l.args.count()
	if recv != noReg and c.receiver != 0 and c.info.selfConv == ast.Convention.convConsumes and iface == ast.noType 'consumedReceiver'
		let held = boxed(l, p: p, ms: ms, v: recv, t: exprType(p, module: l.module, node: c.receiver))
		pushArg(l, v: held)
	end 'consumedReceiver' else if recv != noReg 'receiver'
		pushArg(l, v: recv)
	end 'receiver'
	pushOrderedArgs(l, p: p, ms: ms, c: c)
	if target != ast.noFunc and ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).intrinsic != ast.Intrinsic.intrNone 'builtin'
		return lowerBuiltinWitness(l, p: p, ms: ms, c: c, target: target, recv: recv, base: base, mark: mark)
	end 'builtin'
	let dst = callResult(l, p: p, ms: ms, node: node)
	var errTy = ast.noType
	if kind == ast.CallKind.callBound 'bound'
		errTy = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.method).errTy
	end 'bound' else 'target'
		errTy = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).errTy
	end 'target'
	if errTy == ast.noType 'plain'
		emitCallOf(l, p: p, ms: ms, c: c, iface: iface, dst: dst, target: target, args: argsSince(l, base: base), err: noReg)
		popArgs(l, n: base)
		writeBack(l, p: p, ms: ms, mark: places)
	end 'plain' else 'throwing'
		var errKind = IrKind.kindScalar
		let errApplied = applyType(l, p: p, ms: ms, t: errTy)
		if errorInBox(ms.types, reads: p.types, t: errApplied) 'union'
			errKind = IrKind.kindManaged
		end 'union'
		let err = newReg(l, kind: errKind)
		emitCallOf(l, p: p, ms: ms, c: c, iface: iface, dst: dst, target: target, args: argsSince(l, base: base), err: err)
		popArgs(l, n: base)
		// What the callee wrote to an element before it failed stays written, as it would through the element's own
		// address.
		writeBack(l, p: p, ms: ms, mark: places)
		// The callee has the arguments now, and drops them itself when it fails.
		popPending(l, n: mark)
		let ok = l.b.newBlock()
		let zero = konst(l, value: 0 as Word)
		let failed = compare(l, op: CmpOp.cmpNe, a: err, b: zero, unsigned: false)
		let errDrop = errorDropType(l, p: p, ms: ms, t: errTy)
		let stub = failureBiased(l, p: p, ms: ms, errorCase: 0 as Count, err: err, errDrop: errDrop, bias: errorBias(ms.types, reads: p.types, t: errApplied))
		l.b.terminate(l.cur, t: newBranch(failed, ifTrue: stub, ifFalse: ok))
		l.cur = ok
	end 'throwing'
	if dst == noReg 'none'
		return konst(l, value: 0 as Word)
	end 'none'
	return dst
end 'callOn'

// emitCallOf emits the call that a call site makes with args, the receiver first: of the function target, or through the
// table of the interface value that is the receiver, when iface is its interface; err is noReg for a call that cannot
// fail.
function emitCallOf(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, iface ast.TypeID, dst Reg, target ast.FuncID, args RegList, err Reg)
	if iface != ast.noType 'witness'
		let slot = ast.requirementSlot(ms.types, reads: p.types, iface: iface, sig: c.info.method)
		var rest = RegList.create(0)
		for i in 1 upto args.count() 'rest'
			rest.push(args[i])
		end 'rest'
		// The method that meets a requirement lending a tuple lends one at the instance the call sees.
		let result = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node))
		if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.method).result == ast.ResultConv.resultBorrowed and ast.isTupleType(ms.types, reads: p.types, t: result) 'lentTuple'
			rest.push(frameArea(l, elements: ast.typeEntry(ms.types, reads: p.types, t: result).typeArgs.count()))
		end 'lentTuple' else if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.method).result != ast.ResultConv.resultBorrowed 'owned'
			pushResultArea(l, p: p, ms: ms, args: rest, t: result)
		end 'owned'
		let sig = requirementSignature(l, p: p, ms: ms, c: c)
		let instr = l.b.callWitness(dst, conv: receiverConv(c.info.selfConv), slot: slot, recv: args[0], args: rest, err: err, sig: sig)
		emit(l, i: instr)
		return
	end 'witness'
	if err == noReg 'plain'
		emitCall(l, p: p, ms: ms, dst: dst, target: target, args: args)
		return
	end 'plain'
	emitThrowingCall(l, p: p, ms: ms, dst: dst, target: target, args: args, err: err)
end 'emitCallOf'

// requirementSignature is the float signature of a call through the table of an interface value: the value the box holds
// first, never a float, since no float meets an interface, then the requirement's parameters as the call sees them, the
// types of the interface value bound, which the declaration of every method that meets the requirement has.
function requirementSignature(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite) returns FloatSignature
	var args = 0 as FloatMask
	for i in 0 upto c.info.paramSpecs.count() 'params'
		let t = applyType(l, p: p, ms: ms, t: c.info.paramSpecs[i].ty)
		if passesFloat(p, ms: ms, conv: c.info.paramSpecs[i].conv, t: t) 'float'
			args = args or floatBit(i + 1)
		end 'float'
	end 'params'
	let lends = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: c.info.method).result == ast.ResultConv.resultBorrowed
	let result = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: c.node))
	return FloatSignature.make(args, result: not lends and ast.isFloatType(ms.types, reads: p.types, t: result))
end 'requirementSignature'

// loadLent is the value at addr, the place that the call node lends to be changed.
function loadLent(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID, addr Reg) returns Reg
	let t = exprType(p, module: l.module, node: node)
	let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: t))
	if lentInByte(l, p: p, ms: ms, t: t) 'byte'
		emit(l, i: newLoadByteAt(d, addr: addr))
		return d
	end 'byte'
	emit(l, i: newLoadAt(d, addr: addr, filled: false))
	return d
end 'loadLent'

// lentInByte is whether a place of the type t, which the body names, that a call lends by address is one byte wide: where
// an array keeps an element of the type in a byte (holding, inElement). Such a place is read and written one byte at a
// time wherever it lies: a byte of an array's buffer, or the low byte of a word that holds the value, which is the value
// on every target, since each is little-endian, the value is from 0 to 255, and the word's upper bytes are never written.
// A place of any other type is its word, as it was.
function lentInByte(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns bool
	let ty = applyType(l, p: p, ms: ms, t: t)
	return match holding(ms.types, reads: p.types, b: p.builtins, t: ty, holder: Holder.inElement) 'holding'
		heldPacked gives true
		heldWord gives false
		heldString gives false
		heldBox gives false
		heldAddress(_) gives false
		heldInline(_) gives false
	end 'holding'
end 'lentInByte'

function visitCallExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID) returns Reg
	let c = callSite(l, p: p, node: node)
	let kind = c.info.kind
	if kind == ast.CallKind.callPrint or kind == ast.CallKind.callPrintError 'print'
		let text = lowerExpr(l, p: p, ms: ms, e: c.ordered[0])
		let handle = newReg(l, kind: IrKind.kindScalar)
		var symbol = Rt.rtStderr
		if kind == ast.CallKind.callPrint 'out'
			symbol = Rt.rtStdout
		end 'out'
		emit(l, i: newLoadGlobal(handle, symbol: symbol))
		emitCallRuntime(l, dst: noReg, symbol: Rt.rtWrite, args: argsOf2(handle, b: text), routine: ast.noFunc)
		return konst(l, value: 0 as Word)
	end 'print'
	if kind == ast.CallKind.callFunction or kind == ast.CallKind.callStatic or kind == ast.CallKind.callMethod or kind == ast.CallKind.callBound 'call'
		let result = lowerCall(l, p: p, ms: ms, c: c)
		if not lendsByAddressAt(l, p: p, ms: ms, node: node) 'value'
			return result
		end 'value'
		// A place lent to be changed is the address of its word, and of a value held in place the address of its words, which
		// is its value.
		return match held(l, p: p, ms: ms, t: exprType(p, module: l.module, node: node)) 'holding'
			heldAddress(_) gives result
			heldWord gives loadLent(l, p: p, ms: ms, node: node, addr: result)
			heldString gives loadLent(l, p: p, ms: ms, node: node, addr: result)
			heldBox gives loadLent(l, p: p, ms: ms, node: node, addr: result)
			heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
			heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		end 'holding'
	end 'call'
	if kind == ast.CallKind.callSend 'send'
		return lowerSend(l, p: p, ms: ms, c: c)
	end 'send'
	if kind == ast.CallKind.callValue 'value'
		let closure = lowerRead(l, p: p, ms: ms, e: ast.callExprCallee(p.modules[l.mi].tree, id: node))
		let base = l.args.count()
		let places = l.writeBacks.count()
		pushOrderedArgs(l, p: p, ms: ms, c: c)
		let dst = callResult(l, p: p, ms: ms, node: node)
		var args = argsSince(l, base: base)
		let fnTy = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: ast.callExprCallee(p.modules[l.mi].tree, id: node)))
		let result = ast.funcResult(ms.types, reads: p.types, t: fnTy)
		pushResultArea(l, p: p, ms: ms, args: args, t: result)
		let instr = l.b.callValueInstr(dst, target: closure, args: args, sig: valueSignature(p, ms: ms, t: fnTy))
		emit(l, i: instr)
		popArgs(l, n: base)
		writeBack(l, p: p, ms: ms, mark: places)
		if dst == noReg 'none'
			return konst(l, value: 0 as Word)
		end 'none'
		return dst
	end 'value'
	if kind == ast.CallKind.callCopy 'copy'
		let v = lowerExpr(l, p: p, ms: ms, e: c.receiver)
		return copyValue(l, p: p, ms: ms, site: siteOf(l, p: p, node: node), v: v, t: exprType(p, module: l.module, node: c.receiver))
	end 'copy'
	if kind == ast.CallKind.callUnionCtor 'ctor'
		var values = ExprRefList.create(0)
		for i in 0 upto c.ordered.count() 'each'
			values.push(ExprRef.make(l.module, node: c.ordered[i]))
		end 'each'
		return record(l, p: p, ms: ms, t: exprType(p, module: l.module, node: node), tag: indexOf(c.info.unionCase), values: values)
	end 'ctor'
	panic("lower: unresolved call")
end 'visitCallExpr'

// lowerInstanceConstant lowers a read of a static let that is one for each instance of its generic type, read through the
// instance: its value, built where it is read, in the module that declares it and with the type's parameters bound to the
// instance's arguments, as the reader's bindings give them.
function lowerInstanceConstant(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, name ast.NameInfo, instance ast.TypeID) returns Reg
	let origin = ast.declConst(p, ms: ms, ref: name.decl).unwrap().instanceOf
	let written = ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: instance).typeArgs)
	let args = applyAll(ms.types, reads: p.types, ts: written, params: l.bindParams, args: l.bindArgs)
	let savedParams = exchange(l.bindParams, value: ast.cloneTypeArgs(ast.typeEntry(ms.types, reads: p.types, t: origin).typeParams))
	let savedArgs = exchange(l.bindArgs, value: args)
	let v = exprIn(l, p: p, ms: ms, e: constantExpr(p, name: name))
	l.bindParams = savedParams
	l.bindArgs = savedArgs
	return v
end 'lowerInstanceConstant'

// lowerDefault lowers the default of a parameter that a call leaves out, in the module that declares the function and with
// its type parameters bound to the call's type arguments, converted to the parameter's type.
function lowerDefault(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, info ast.CallInfo, spec ast.ParamSpec) returns Reg
	let saved = l.module
	let args = applyAll(ms.types, reads: p.types, ts: info.typeArgs, params: l.bindParams, args: l.bindArgs)
	let savedParams = exchange(l.bindParams, value: ast.cloneTypeArgs(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).generics))
	let savedArgs = exchange(l.bindArgs, value: args)
	setModule(l, m: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: info.fn).module)
	var v = lowerConverted(l, p: p, ms: ms, e: spec.defaultExpr, target: spec.ty)
	if spec.conv == ast.Convention.convConsumes 'consumed'
		v = boxed(l, p: p, ms: ms, v: v, t: spec.ty)
	end 'consumed'
	setModule(l, m: saved)
	l.bindParams = savedParams
	l.bindArgs = savedArgs
	return v
end 'lowerDefault'

// pushOrderedArgs gives the call its arguments in the order of the parameters: by address where the parameter takes its
// argument's place, and by value, converted to the parameter's type, where it does not.
function pushOrderedArgs(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite)
	for i in 0 upto c.ordered.count() 'each'
		if c.ordered[i] == 0 'defaulted'
			let dv = lowerDefault(l, p: p, ms: ms, info: c.info, spec: c.info.paramSpecs[i])
			pushArg(l, v: dv)
			continue 'each'
		end 'defaulted'
		if ast.isByAddress(c.info.paramSpecs[i].conv) 'address'
			let addr = address(l, p: p, ms: ms, e: c.ordered[i])
			pushArg(l, v: addr)
		end 'address' else 'value'
			let v = argValue(l, p: p, ms: ms, c: c, index: i)
			pushArg(l, v: v)
		end 'value'
	end 'each'
end 'pushOrderedArgs'

// argValue is the value of the argument at index of a call, which its parameter takes by value: converted to the
// parameter's type, and, where the parameter consumes it, a value held in place in a box of its own, since the callee owns
// what it consumes past the caller's frame (a coroutine's, a behaviour's).
function argValue(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, c CallSite, index Count) returns Reg
	let v = lowerConverted(l, p: p, ms: ms, e: c.ordered[index], target: c.info.paramSpecs[index].ty)
	let t = exprRefType(l, p: p, ms: ms, e: ExprRef.make(l.module, node: c.ordered[index]))
	if c.info.paramSpecs[index].conv != ast.Convention.convConsumes 'lent'
		return v
	end 'lent'
	return match held(l, p: p, ms: ms, t: t) 'holding'
		heldAddress(words) gives consumedBox(l, p: p, ms: ms, v: v, words: words, t: t)
		heldWord gives v
		heldString gives v
		heldBox gives v
		heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'argValue'

// consumedBox is a box of the words words at v, a value of the type t held in place that a callee consumes.
function consumedBox(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, v Reg, words Count, t ast.TypeID) returns Reg
	let box = boxOfWords(l, v: v, words: words)
	// The box is in flight until the call takes it, as a consumed value is (lowerExpr).
	let ty = dropType(l, p: p, ms: ms, t: t)
	l.pending.push(PendingDrop.ofReg(box, ty: ty))
	return box
end 'consumedBox'

// callResult is the register a call gives its value in, or noReg for a call that returns nothing.
function callResult(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID) returns Reg
	let callTy = exprType(p, module: l.module, node: node)
	if callTy == p.builtins.voidTy 'none'
		return noReg
	end 'none'
	if lendsByAddressAt(l, p: p, ms: ms, node: node) 'place'
		return newReg(l, kind: IrKind.kindScalar)
	end 'place'
	return newReg(l, kind: kindOf(l, p: p, ms: ms, t: callTy))
end 'callResult'

// lendsByAddressAt is whether the call at node is given the address of the place it lends (ast.lendsByAddress), the
// place's word: a read of the value loads it, and a change writes through it. A call through a bound or an interface value
// is the requirement's. A
// value held in place is the address of its words already, so the callee returns that, and a place of it is the caller's
// own word that holds it (heldPlace), as every place of a value held in place is.
function lendsByAddressAt(l Lowerer, p ast.Project, ms ast.ModuleState, node ast.NodeID) returns bool
	let info = callInfoAt(p, module: l.module, node: node)
	if info.kind == ast.CallKind.callBound 'requirement'
		return ast.lendsByAddress(p, typing: p.typings[l.mi], module: l.module, ft: ms.funcs, funcReads: p.funcs, f: info.method)
	end 'requirement'
	return ast.lendsByAddress(p, typing: p.typings[l.mi], module: l.module, ft: ms.funcs, funcReads: p.funcs, f: info.fn)
end 'lendsByAddressAt'

// callee is the function a call runs. Every instance a body reaches was found for the module before lowering, so a
// missing one, or one refused, is a compiler bug: the executable would depend on another module having made the instance.
function callee(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, node ast.NodeID, info ast.CallInfo, receiver ast.NodeID) returns ast.FuncID
	var refused = diag.ErrorList.create(0)
	match consumes resolveTarget(p, ms: ms, module: l.module, site: node, receiver: receiver, info: info, bindParams: l.bindParams, bindArgs: l.bindArgs, bindWitnesses: l.bindWitnesses, errs: refused) 'resolved'
		some(fid) then return checkedCallee(l, p: p, ms: ms, target: fid)
		none then panic("lower: a call was refused after its module's instances were found")
	end 'resolved'
end 'callee'

function checkedCallee(l Lowerer, p ast.Project, ms ast.ModuleState, target ast.FuncID) returns ast.FuncID
	if ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target).genericOrigin != ast.noFunc and not l.instances.has(target) 'missing'
		panic("lower: {funcSymbol(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: target)} was not found among the instances of the module")
	end 'missing'
	return target
end 'checkedCallee'

// record is a new box of the fields of the type t, which the tag, when it has one, makes a union: values are the
// expression of each field. The box is in flight while its fields are computed, and owns each one once it is stored.
function record(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, tag Index, values ExprRefList) returns Reg
	let tagged = tag != noTag
	let count = values.count()
	let applied = applyType(l, p: p, ms: ms, t: t)
	var caseIndex = 0 as Count
	var bytes = 0 as Count
	if tagged 'union'
		caseIndex = try tag as Count otherwise panic("ir: a case index is out of range")
		if unionForm(ms.types, reads: p.types, t: applied) != UnionForm.unionBoxed 'word'
			return unionWord(l, p: p, ms: ms, t: applied, caseIndex: caseIndex, values: values)
		end 'word'
		bytes = caseBoxBytes(ms.types, reads: p.types, owner: applied, caseIndex: caseIndex)
	end 'union' else 'fields'
		match heldAs(p, ms: ms, t: applied) 'holding'
			heldAddress(words) then return placedRecord(l, p: p, ms: ms, t: applied, words: words, values: values)
			heldWord or
			heldString or
			heldBox then bytes = recordBoxBytes(ms.types, reads: p.types, owner: applied)
			heldInline(_) panic("ir: a variable that holds words of its own or a byte of a buffer")
			heldPacked panic("ir: a variable that holds words of its own or a byte of a buffer")
		end 'holding'
	end 'fields'
	let box = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newAlloc(box, bytes: bytes))
	if tagged 'tagStore'
		let tagReg = konst(l, value: tag as Word)
		emit(l, i: newStoreField(box, offset: tagOffset, src: tagReg, borrow: false))
	end 'tagStore'
	let mark = l.pending.count()
	if count > 0 'owned'
		let ty = dropType(l, p: p, ms: ms, t: t)
		l.pending.push(PendingDrop.ofReg(box, ty: ty))
	end 'owned'
	for i in 0 upto count 'each'
		if tagged 'payload'
			let v = heldIn(l, p: p, ms: ms, e: values[i], holder: t)
			emit(l, i: newStoreField(box, offset: payloadOffset(ms.types, reads: p.types, owner: applied, caseIndex: caseIndex, index: i), src: v, borrow: false))
		end 'payload' else 'field'
			storeNewField(l, p: p, ms: ms, record: box, t: applied, index: i, value: values[i], holder: t)
		end 'field'
		popPending(l, n: succ(mark))
	end 'each'
	popPending(l, n: mark)
	return box
end 'record'

// placedRecord is a new value of the record t, held in place in words words, in a frame area of its own: values are the
// expression of each field, every one a word of nothing to drop or a record held in place.
function placedRecord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, words Count, values ExprRefList) returns Reg
	let area = newArea(l, words: words)
	for i in 0 upto values.count() 'each'
		storeNewField(l, p: p, ms: ms, record: area, t: t, index: i, value: values[i], holder: t)
	end 'each'
	return area
end 'placedRecord'

// storeNewField gives the field at index of the new record of the type t, whose box or words are at record, the value of
// the expression value: a copy of its words where they are the record's own, and otherwise the value as the record holds it.
function storeNewField(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, record Reg, t ast.TypeID, index Count, value ExprRef, holder ast.TypeID)
	let offset = recordFieldOffset(ms.types, reads: p.types, owner: t, index: index)
	let named = exprRefType(l, p: p, ms: ms, e: value)
	let given = applyType(l, p: p, ms: ms, t: named)
	match holding(ms.types, reads: p.types, b: p.builtins, t: given, holder: Holder.inField(t, index: index)) 'holding'
		heldInline(words) then storeNewWords(l, p: p, ms: ms, record: record, offset: offset, value: value, words: words)
		heldWord or
		heldString or
		heldBox then storeNewHeld(l, p: p, ms: ms, record: record, offset: offset, value: value, holder: holder)
		heldAddress(_) panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
		heldPacked panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
	end 'holding'
end 'storeNewField'

// storeNewWords copies the words words of the value of the expression value to the bytes at offset of the new record at
// record, a field whose words are the record's own.
function storeNewWords(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, record Reg, offset Count, value ExprRef, words Count)
	let v = exprIn(l, p: p, ms: ms, e: value)
	copyWordsAt(l, dst: record, at: offset, src: v, words: words)
end 'storeNewWords'

// storeNewHeld gives the field at offset of the new record at record the value of the expression value, as the record of
// the type holder holds it.
function storeNewHeld(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, record Reg, offset Count, value ExprRef, holder ast.TypeID)
	let v = heldIn(l, p: p, ms: ms, e: value, holder: holder)
	emit(l, i: newStoreField(record, offset: offset, src: v, borrow: false))
end 'storeNewHeld'

// exprRefType is the type of the value that lowering the expression e gives, in the module it is in: the interface it is
// boxed to, where it is (lowerExpr), and its own type otherwise.
function exprRefType(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ExprRef) returns ast.TypeID
	let ty = exprType(p, module: e.module, node: e.node)
	let iface = ast.boxedTo(p.typings[ast.modIndex(e.module)], node: e.node)
	if iface == ast.noType 'own'
		return ty
	end 'own'
	let applied = applyType(l, p: p, ms: ms, t: ty)
	if standsForInterface(p, ms: ms, t: applied) 'own'
		return ty
	end 'own'
	return iface
end 'exprRefType'

// heldIn is the value of the expression e as a holder of the type holder other than a local keeps it (arrayHeld).
function heldIn(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ExprRef, holder ast.TypeID) returns Reg
	let v = exprIn(l, p: p, ms: ms, e: e)
	let t = exprRefType(l, p: p, ms: ms, e: e)
	return arrayHeld(l, p: p, ms: ms, v: v, t: t, holder: holder)
end 'heldIn'

// copyValue is a new value equal to v, which every part of it owns: the deep copy that CopyInstr says. A scalar is the
// value itself. site is the source that needs the copy.
function copyValue(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, site diag.Site, v Reg, t ast.TypeID) returns Reg
	let ty = applyType(l, p: p, ms: ms, t: t)
	match heldAs(p, ms: ms, t: ty) 'holding'
		heldAddress(words) then return placedCopy(l, words: words, v: v)
		heldWord or
		heldString or
		heldBox then _ = 0
		heldInline(_) panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
	if not owning(kindOfType(p, ms: ms, t: ty)) 'scalar'
		return v
	end 'scalar'
	let d = newReg(l, kind: kindOfType(p, ms: ms, t: ty))
	emitCopy(l, dst: d, src: v, ty: ty)
	return d
end 'copyValue'

// unionWord is a value of the union t that is held as a word (UnionForm): the case's index, or the payload of the case
// that carries one, or the niche for the case that does not.
function unionWord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, caseIndex Count, values ExprRefList) returns Reg
	return match unionForm(ms.types, reads: p.types, t: t) 'form'
		unionCases gives konst(l, value: try caseIndex as Word otherwise panic("ir: a case index is out of range"))
		unionNiche gives nicheCaseWord(l, p: p, ms: ms, t: t, caseIndex: caseIndex, values: values)
		unionNull gives nullCaseWord(l, p: p, ms: ms, t: t, caseIndex: caseIndex, values: values)
		unionBoxed gives panic("ir: a boxed union is no word")
	end 'form'
end 'unionWord'

// nullCaseWord is a value of the union t in the null form: the payload, which the value takes over from whatever would have
// dropped it, or 0 for the case that carries none.
function nullCaseWord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, caseIndex Count, values ExprRefList) returns Reg
	if caseIndex == payloadCase(ms.types, reads: p.types, t: t) 'payload'
		let mark = l.pending.count()
		let v = heldIn(l, p: p, ms: ms, e: values[0], holder: t)
		popPending(l, n: mark)
		return v
	end 'payload'
	let d = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newConst(d, value: 0 as Word))
	return d
end 'nullCaseWord'

function nicheCaseWord(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, caseIndex Count, values ExprRefList) returns Reg
	if caseIndex == payloadCase(ms.types, reads: p.types, t: t) 'payload'
		return exprIn(l, p: p, ms: ms, e: values[0])
	end 'payload'
	return konst(l, value: unionNicheWord(ms.types, reads: p.types, t: t))
end 'nicheCaseWord'

// tagReg is the case index of v, a value of the union t: read from its box, the word itself, or whether the word is the
// niche.
function tagReg(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, v Reg) returns Reg
	let applied = applyType(l, p: p, ms: ms, t: t)
	let form = unionForm(ms.types, reads: p.types, t: applied)
	if form == UnionForm.unionCases 'cases'
		return v
	end 'cases'
	if form == UnionForm.unionNiche 'niche'
		let niche = konst(l, value: unionNicheWord(ms.types, reads: p.types, t: applied))
		if emptyCase(ms.types, reads: p.types, t: applied) == 1 'emptySecond'
			return compare(l, op: CmpOp.cmpEq, a: v, b: niche, unsigned: false)
		end 'emptySecond'
		return compare(l, op: CmpOp.cmpNe, a: v, b: niche, unsigned: false)
	end 'niche'
	if form == UnionForm.unionNull 'null'
		let zero = konst(l, value: 0 as Word)
		if emptyCase(ms.types, reads: p.types, t: applied) == 0 'emptyFirst'
			return compare(l, op: CmpOp.cmpNe, a: v, b: zero, unsigned: false)
		end 'emptyFirst'
		return compare(l, op: CmpOp.cmpEq, a: v, b: zero, unsigned: false)
	end 'null'
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadField(d, obj: v, offset: tagOffset))
	return d
end 'tagReg'

// unionPayload is the payload at index of the case caseIndex of v, a value of the union t, read as a register of kind:
// lent from its box, or the word itself where the union is held in the niche form.
function unionPayload(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, v Reg, caseIndex Count, index Count, kind IrKind) returns Reg
	let applied = applyType(l, p: p, ms: ms, t: t)
	let form = unionForm(ms.types, reads: p.types, t: applied)
	if form == UnionForm.unionNiche or form == UnionForm.unionNull 'word'
		return v
	end 'word'
	let d = newReg(l, kind: kind)
	emit(l, i: newLoadField(d, obj: v, offset: payloadOffset(ms.types, reads: p.types, owner: applied, caseIndex: caseIndex, index: index)))
	return d
end 'unionPayload'

// caseNames are the names of the cases of an enum or a union, in the order of their indexes.
function caseNames(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns ast.StringList
	let origin = ast.typeEntry(ms.types, reads: p.types, t: t).effectiveOrigin()
	var names = ast.StringList.create(0)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).cases.count() 'each'
		names.push(ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].name.clone())
	end 'each'
	return names
end 'caseNames'

function visitMemberExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let member = memberInfoAt(p, module: l.module, node: e)
	let obj = ast.memberExprObj(p.modules[l.mi].tree, id: e)
	let kind = member.kind
	if kind == ast.MemberKind.memberField 'field'
		let base = lowerRead(l, p: p, ms: ms, e: obj)
		let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e)))
		let owner = exprType(p, module: l.module, node: obj)
		let offset = fieldAt(l, p: p, ms: ms, owner: owner, index: member.fieldIndex)
		let h = fieldHeld(l, p: p, ms: ms, owner: owner, index: member.fieldIndex, t: exprType(p, module: l.module, node: e))
		loadField(l, p: p, ms: ms, d: d, obj: base, e: e, offset: offset, h: h)
		return d
	end 'field'
	if kind == ast.MemberKind.memberView 'view'
		return visitExpr(l, p: p, ms: ms, e: obj)
	end 'view'
	if kind == ast.MemberKind.memberSelfHandle 'selfHandle'
		return entry(l, p: p, site: siteOf(l, p: p, node: e), symbol: Rt.rtServiceSelfHandle, kind: IrKind.kindManaged, args: RegList.create(0))
	end 'selfHandle'
	if kind == ast.MemberKind.memberEnumCase 'enumCase'
		return konst(l, value: try member.enumCase as Word otherwise panic("ir: a case index is out of range"))
	end 'enumCase'
	if kind == ast.MemberKind.memberUnionCase 'unionCase'
		return record(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e), tag: indexOf(member.enumCase), values: ExprRefList.create(0))
	end 'unionCase'
	if kind == ast.MemberKind.memberAllCases or kind == ast.MemberKind.memberAllCaseNames 'caseList'
		return lowerCaseList(l, p: p, ms: ms, e: e, member: member)
	end 'caseList'
	if kind == ast.MemberKind.memberEnumOrdinal 'ordinal'
		return lowerExpr(l, p: p, ms: ms, e: obj)
	end 'ordinal'
	if kind == ast.MemberKind.memberEnumName 'enumName'
		let v = lowerExpr(l, p: p, ms: ms, e: obj)
		return names(l, index: v, names: caseNames(p, ms: ms, t: exprType(p, module: l.module, node: obj)))
	end 'enumName'
	if kind == ast.MemberKind.memberEnumRaw 'enumRaw'
		let et = exprType(p, module: l.module, node: obj)
		let v = lowerExpr(l, p: p, ms: ms, e: obj)
		return rawValueOf(l, p: p, ms: ms, t: et, index: v)
	end 'enumRaw'
	if kind == ast.MemberKind.memberUnionRaw 'unionRaw'
		let ut = exprType(p, module: l.module, node: obj)
		let u = lowerExpr(l, p: p, ms: ms, e: obj)
		let tag = tagReg(l, p: p, ms: ms, t: ut, v: u)
		return rawValueOf(l, p: p, ms: ms, t: ut, index: tag)
	end 'unionRaw'
	if kind == ast.MemberKind.memberRawField 'rawField'
		let ot = exprType(p, module: l.module, node: obj)
		let v = lowerExpr(l, p: p, ms: ms, e: obj)
		var index = v
		if ast.typeKind(ms.types, reads: p.types, t: ot) == ast.TypeKind.unionTy 'union'
			index = tagReg(l, p: p, ms: ms, t: ot, v: v)
		end 'union'
		return rawFieldOf(l, p: p, ms: ms, t: ot, index: index, field: member.fieldIndex, ft: exprType(p, module: l.module, node: e))
	end 'rawField'
	if kind == ast.MemberKind.memberCaseName or kind == ast.MemberKind.memberCaseOrdinal or kind == ast.MemberKind.memberCaseRaw or kind == ast.MemberKind.memberCaseRawField 'caseRead'
		return lowerCaseRead(l, p: p, ms: ms, e: e, member: member)
	end 'caseRead'
	if kind == ast.MemberKind.memberUnionOrdinal 'unionOrdinal'
		let u = lowerExpr(l, p: p, ms: ms, e: obj)
		return tagReg(l, p: p, ms: ms, t: exprType(p, module: l.module, node: obj), v: u)
	end 'unionOrdinal'
	if kind == ast.MemberKind.memberUnionName 'unionName'
		let u = lowerExpr(l, p: p, ms: ms, e: obj)
		let t = tagReg(l, p: p, ms: ms, t: exprType(p, module: l.module, node: obj), v: u)
		return names(l, index: t, names: caseNames(p, ms: ms, t: exprType(p, module: l.module, node: obj)))
	end 'unionName'
	panic("lower: unresolved member")
end 'visitMemberExpr'

// lowerCaseRead is a member read from the case that a union type names, which the case's tag answers: its index is a constant.
function lowerCaseRead(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, member ast.MemberInfo) returns Reg
	let index = konst(l, value: try member.enumCase as Word otherwise panic("ir: a case index is out of range"))
	if member.kind == ast.MemberKind.memberCaseName 'name'
		let origin = ast.typeEntry(ms.types, reads: p.types, t: member.ownerTy).effectiveOrigin()
		return strReg(l, value: ast.typeEntry(ms.types, reads: p.types, t: origin).cases[member.enumCase].name.clone())
	end 'name'
	if member.kind == ast.MemberKind.memberCaseOrdinal 'ordinal'
		return index
	end 'ordinal'
	if member.kind == ast.MemberKind.memberCaseRaw 'raw'
		return rawValueOf(l, p: p, ms: ms, t: member.ownerTy, index: index)
	end 'raw'
	if member.kind == ast.MemberKind.memberCaseRawField 'field'
		return rawFieldOf(l, p: p, ms: ms, t: member.ownerTy, index: index, field: member.fieldIndex, ft: exprType(p, module: l.module, node: e))
	end 'field'
	panic("lower: a member of kind {member.kind.name} is no read of a case")
end 'lowerCaseRead'

// rawFieldOf is a field of the raw value of the case that index says: the raw value is made for the read and dropped after it,
// which only a field that holds no value of its own survives.
function rawFieldOf(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, index Reg, field Count, ft ast.TypeID) returns Reg
	let record = rawValueOf(l, p: p, ms: ms, t: t, index: index)
	let origin = ast.typeEntry(ms.types, reads: p.types, t: t).effectiveOrigin()
	let recordTy = ast.rawTypeOf(p, ms: ms, t: origin)
	let d = newReg(l, kind: kindOf(l, p: p, ms: ms, t: ft))
	let offset = fieldAt(l, p: p, ms: ms, owner: recordTy, index: field)
	let h = fieldHeld(l, p: p, ms: ms, owner: recordTy, index: field, t: ft)
	match h 'read'
		heldInline(_) then emit(l, i: newFieldAddr(d, obj: record, offset: offset))
		heldWord or
		heldString or
		heldBox then emit(l, i: newLoadField(d, obj: record, offset: offset))
		heldAddress(_) panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
		heldPacked panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
	end 'read'
	if not rawDatums(p, ms: ms, origin: origin).isSome() 'built'
		// A value held in place is the address of words the record holds, which leave with it.
		let value = match h 'copied'
			heldInline(words) gives placedCopy(l, words: words, v: d)
			heldWord gives d
			heldString gives d
			heldBox gives d
			heldAddress(_) gives panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
			heldPacked gives panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
		end 'copied'
		dropValue(l, p: p, ms: ms, v: record, t: recordTy)
		return value
	end 'built'
	return d
end 'rawFieldOf'

// lowerCaseList builds the array that 'Type.allCases' or 'Type.allCaseNames' is: a new one each time, since an array has
// one owner, holding a case of the enum, or the name of a case, for each case in the order they are declared.
function lowerCaseList(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, member ast.MemberInfo) returns Reg
	let site = siteOf(l, p: p, node: e)
	let box = arrayOf(l, p: p, ms: ms, site: site, t: exprType(p, module: l.module, node: e))
	let list = arrayNew(l, p: p, ms: ms, box: box)
	let names = caseNames(p, ms: ms, t: member.ownerTy)
	for i in 0 upto names.count() 'each'
		var v = noReg
		if member.kind == ast.MemberKind.memberAllCases 'cases'
			v = konst(l, value: try i as Word otherwise panic("ir: a case index is out of range"))
		end 'cases' else 'caseNames'
			v = strReg(l, value: names[i])
		end 'caseNames'
		arrayPush(l, p: p, ms: ms, box: box, arr: list, v: v)
	end 'each'
	return list
end 'lowerCaseList'

// rawValueOf is the raw value of the case of the enum or union type t that index says: the index itself for integers that the
// cases did not write, and otherwise the raw value of each case, chosen by a switch.
function rawValueOf(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, index Reg) returns Reg
	let origin = ast.typeEntry(ms.types, reads: p.types, t: t).effectiveOrigin()
	let kind = ast.typeEntry(ms.types, reads: p.types, t: origin).rawKind
	if kind == ast.RawKind.value 'value'
		match consumes rawDatums(p, ms: ms, origin: origin) 'data'
			some(ds) then return datumSelect(l, index: index, ds: ds)
			none then _ = 0
		end 'data'
		return builtRawValue(l, p: p, ms: ms, origin: origin, index: index)
	end 'value'
	if kind == ast.RawKind.string 'string'
		var texts = ast.StringList.create(0)
		for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).cases.count() 'texts'
			texts.push(ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].rawText.clone())
		end 'texts'
		return names(l, index: index, names: texts)
	end 'string'
	if kind == ast.RawKind.integer and not ast.typeEntry(ms.types, reads: p.types, t: origin).hasExplicitRaw 'ordinal'
		return index
	end 'ordinal'
	let count = ast.typeEntry(ms.types, reads: p.types, t: origin).cases.count()
	let sel = selectStart(l, kind: IrKind.kindScalar, index: index, count: count)
	for i in 0 upto count 'each'
		selectArm(l, s: sel, i: i)
		let raw = konst(l, value: wordOf(ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].rawValue))
		selectStore(l, s: sel, v: raw)
	end 'each'
	return selectEnd(l, s: sel)
end 'rawValueOf'

// builtRawValue is the raw value of the case that index says, when the cases write expressions: the one the case writes, built
// where it is read, in the module that declares the type. Whoever reads it owns it, as for a call's result.
function builtRawValue(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, origin ast.TypeID, index Reg) returns Reg
	let count = ast.typeEntry(ms.types, reads: p.types, t: origin).cases.count()
	let module = ast.typeEntry(ms.types, reads: p.types, t: origin).decl.module
	let sel = selectStart(l, kind: kindOfType(p, ms: ms, t: ast.rawTypeOf(p, ms: ms, t: origin)), index: index, count: count)
	for i in 0 upto count 'each'
		selectArm(l, s: sel, i: i)
		pushScope(l, block: false)
		let mark = l.pending.count()
		let v = exprIn(l, p: p, ms: ms, e: ExprRef.make(module, node: ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].rawExpr))
		emit(l, i: newStoreSlot(sel.result, src: v, borrow: false))
		popPending(l, n: mark)
		popScope(l, p: p, ms: ms)
		goTo(l, target: sel.join)
	end 'each'
	return selectEnd(l, s: sel)
end 'builtRawValue'

// datumSelect is the raw value of the case that index says, when every case's is a datum of the executable's data.
function datumSelect(mutates l Lowerer, index Reg, consumes ds DatumList) returns Reg
	let sel = selectStart(l, kind: IrKind.kindManaged, index: index, count: ds.count())
	var each = ds
	for i in 0 upto each.count() 'each'
		selectArm(l, s: sel, i: i)
		let v = datumReg(l, d: exchange(each[i], value: Datum.make("")))
		selectStore(l, s: sel, v: v)
	end 'each'
	return selectEnd(l, s: sel)
end 'datumSelect'

// names is the name of the case that index says, as a string of the executable.
function names(mutates l Lowerer, index Reg, names ast.StringList) returns Reg
	let sel = selectStart(l, kind: IrKind.kindString, index: index, count: names.count())
	for i in 0 upto names.count() 'each'
		selectArm(l, s: sel, i: i)
		let v = strReg(l, value: names[i])
		selectStore(l, s: sel, v: v)
	end 'each'
	return selectEnd(l, s: sel)
end 'names'

// Select is a value that one of several arms computes, which a switch on an index chooses: each arm's value is stored into
// a slot of its own and the join reads it.
export type Select
	export var result as Count
	export var join as BlockID
	export var targets as BlockIDList

	export static function make(result Count, join BlockID, consumes targets BlockIDList) returns Select
		return Select{result: result, join: join, targets: targets}
	end 'make'
end 'Select'

// selectStart ends the block with the switch over index, which has an arm for each of count values.
function selectStart(mutates l Lowerer, kind IrKind, index Reg, count Count) returns Select
	let result = l.b.f.newSlot(kind)
	let join = l.b.newBlock()
	var targets = BlockIDList.create(0)
	for i in 0 upto count 'arms'
		targets.push(l.b.newBlock())
	end 'arms'
	var values = WordList.create(0)
	var armTargets = BlockIDList.create(0)
	let last = pred(count)
	for i in 0 upto last 'cases'
		values.push(try i as Word otherwise panic("ir: a case index is out of range"))
		armTargets.push(targets[i])
	end 'cases'
	let sw = l.b.switch(index, values: values, targets: armTargets, def: targets[last])
	l.b.terminate(l.cur, t: sw)
	return Select.make(result, join: join, targets: targets)
end 'selectStart'

// selectArm makes the block of an arm the one that is being lowered.
function selectArm(mutates l Lowerer, s Select, i Count)
	l.cur = s.targets[i]
end 'selectArm'

// selectStore ends an arm with its value.
function selectStore(mutates l Lowerer, s Select, v Reg)
	emit(l, i: newStoreSlot(s.result, src: v, borrow: false))
	goTo(l, target: s.join)
end 'selectStore'

// selectEnd is the value the arms computed, taken from the slot that held it.
function selectEnd(mutates l Lowerer, s Select) returns Reg
	return fetch(l, slot: s.result)
end 'selectEnd'

// plainText is the text of a string literal with no interpolation.
function plainText(l Lowerer, p ast.Project, e ast.NodeID) returns String
	return partsText(l, p: p, partsRef: ast.strLitPartsRef(p.modules[l.mi].tree, id: e))
end 'plainText'

// partsText is the text of the parts of a literal that has no interpolation.
function partsText(l Lowerer, p ast.Project, partsRef diag.U32) returns String
	return ast.strPartsText(p.modules[l.mi].tree, partsRef: partsRef)
end 'partsText'

// visitByteStrLit is a new byte array with the bytes of a byte string literal, copied from its text in the executable's data.
function visitByteStrLit(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let a = arrayOf(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), t: exprType(p, module: l.module, node: e))
	let out = arrayNew(l, p: p, ms: ms, box: a)
	let text = partsText(l, p: p, partsRef: ast.byteStrLitPartsRef(p.modules[l.mi].tree, id: e))
	if text.byteLength() > 0 'bytes'
		let literal = strReg(l, value: text)
		arrayAppendText(l, p: p, ms: ms, box: a, arr: out, text: literal)
	end 'bytes'
	return out
end 'visitByteStrLit'

// visitStrLit is the String an interpolated literal makes (joins.maxon). A literal of a single borrowed string is a copy of
// it, because the literal's value is its own.
function visitStrLit(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let partsRef = ast.strLitPartsRef(p.modules[l.mi].tree, id: e)
	if p.modules[l.mi].tree.strIsPlain(partsRef) 'plain'
		return strReg(l, value: plainText(l, p: p, e: e))
	end 'plain'
	let mark = l.pending.count()
	var parts = TextParts.create(0)
	textParts(l, p: p, ms: ms, partsRef: partsRef, from: 0 as Count, parts: parts)
	popPending(l, n: mark)
	if parts.count() == 1 and parts[0].owner == TextOwner.textBorrowed 'single'
		let string = p.builtins.stringTy
		return copyValue(l, p: p, ms: ms, site: siteOf(l, p: p, node: e), v: parts[0].value, t: string)
	end 'single'
	return joinParts(l, p: p, ms: ms, parts: parts)
end 'visitStrLit'

// textParts evaluates the parts of a literal from the index from on, in order, and adds them to parts: a part that is itself
// an interpolated literal, with no format of its own, adds its parts in its place, so the String of the outer literal is made
// with them and the inner one is never made. Each String a part makes is dropped by a failure of a later part until the
// join takes it (l.pending), which the caller ends.
function textParts(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, partsRef diag.U32, from Count, mutates parts TextParts)
	let count = p.modules[l.mi].tree.strPartCount(partsRef)
	for i in from upto count 'parts'
		let nested = ast.nestedTextParts(p.modules[l.mi].tree, partsRef: partsRef, index: i)
		if nested.isSome() 'nested'
			textParts(l, p: p, ms: ms, partsRef: nested.unwrap(), from: 0 as Count, parts: parts)
			continue 'parts'
		end 'nested'
		let part = strPart(l, p: p, ms: ms, partsRef: partsRef, index: i)
		if part.owner == TextOwner.textFresh 'fresh'
			l.pending.push(PendingDrop.ofReg(part.value, ty: p.builtins.stringTy))
		end 'fresh'
		parts.push(part)
	end 'parts'
end 'textParts'

function strPart(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, partsRef diag.U32, index Count) returns TextPart
	if not p.modules[l.mi].tree.strPartIsExpr(partsRef, index: index) 'text'
		return TextPart.literal(partsRef, index: index, length: p.modules[l.mi].tree.strPartText(partsRef, index: index).byteLength())
	end 'text'
	let e = p.modules[l.mi].tree.strPartExpr(partsRef, index: index)
	let v = lowerRead(l, p: p, ms: ms, e: e)
	let applied = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: e))
	let t = ast.contentType(ms.types, reads: p.types, t: applied)
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	let spec = ast.partFormatSpec(p.modules[l.mi].tree, partsRef: partsRef, index: index)
	if ast.textPartBorrows(p.builtins, tt: ms.types, reads: p.types, t: t, spec: spec) 'borrowed'
		if t == p.builtins.filePathTy 'path'
			return TextPart.make(pathText(l, path: v), owner: TextOwner.textBorrowed)
		end 'path'
		if isImmortal(l, p: p, e: e) 'immortal'
			return TextPart.make(v, owner: TextOwner.textImmortal)
		end 'immortal'
		return TextPart.make(v, owner: TextOwner.textBorrowed)
	end 'borrowed'
	if t == p.builtins.stringTy 'quoted'
		return quotedText(l, v: v, spec: spec)
	end 'quoted'
	if t == p.builtins.characterTy 'character'
		return characterText(l, p: p, ms: ms, v: v, spec: spec)
	end 'character'
	if t == p.builtins.boolTy 'bool'
		var texts = ast.StringList.create(0)
		texts.push("false")
		texts.push("true")
		return TextPart.make(names(l, index: v, names: texts), owner: TextOwner.textImmortal)
	end 'bool'
	if (kind == ast.TypeKind.constInt or kind == ast.TypeKind.intRange) and spec.present 'formattedInt'
		return formattedInt(l, p: p, v: v, signed: not rendersUnsigned(p, ms: ms, t: t), spec: spec)
	end 'formattedInt'
	if (kind == ast.TypeKind.constFloat or kind == ast.TypeKind.floatRange) and spec.present 'formattedFloat'
		return formattedFloat(l, p: p, ms: ms, v: v, spec: spec)
	end 'formattedFloat'
	if kind == ast.TypeKind.constInt 'constant'
		return TextPart.decimal(v, unsigned: false)
	end 'constant'
	if kind == ast.TypeKind.intRange 'int'
		return TextPart.decimal(v, unsigned: ast.isUnsignedInt(ms.types, reads: p.types, t: t))
	end 'int'
	if kind == ast.TypeKind.constFloat or kind == ast.TypeKind.floatRange 'float'
		return TextPart.make(runtime(l, symbol: Rt.rtFtoa, kind: IrKind.kindManaged, args: argsOf1(v)), owner: TextOwner.textFresh)
	end 'float'
	if kind == ast.TypeKind.enumTy and ast.typeEntry(ms.types, reads: p.types, t: t).hasExplicitRaw 'rawEnum'
		return rawText(l, p: p, ms: ms, t: t, index: v, spec: spec)
	end 'rawEnum'
	if kind == ast.TypeKind.enumTy 'enum'
		return TextPart.make(names(l, index: v, names: caseNames(p, ms: ms, t: t)), owner: TextOwner.textImmortal)
	end 'enum'
	if kind == ast.TypeKind.unionTy 'union'
		let tag = tagReg(l, p: p, ms: ms, t: t, v: v)
		return TextPart.make(names(l, index: tag, names: caseNames(p, ms: ms, t: t)), owner: TextOwner.textImmortal)
	end 'union'
	if p.typings[l.mi].hooks.has(e as Count) 'hook'
		let made = newReg(l, kind: IrKind.kindString)
		let text = protocolCall(l, p: p, ms: ms, s: e, info: hookInfoAt(p, module: l.module, node: e), recv: v, dst: made, resultTy: p.builtins.stringTy, exit: l.cur.clone())
		return TextPart.make(text, owner: TextOwner.textFresh)
	end 'hook'
	panic("lower: cannot interpolate {ast.typeName(ms.types, reads: p.types, t: exprType(p, module: l.module, node: e))}")
end 'strPart'

// rawText is the text of an enum value whose cases write raw values, which is its raw value as the type of the raw value
// writes it: the digits of an integer, the shortest spelling of a float, or the string itself.
function rawText(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID, index Reg, spec ast.FormatSpec) returns TextPart
	let raw = rawValueOf(l, p: p, ms: ms, t: t, index: index)
	let kind = ast.typeEntry(ms.types, reads: p.types, t: t).rawKind
	if kind == ast.RawKind.string 'string'
		return TextPart.make(raw, owner: TextOwner.textImmortal)
	end 'string'
	if kind == ast.RawKind.float 'float'
		if spec.present 'floatSpec'
			return formattedFloat(l, p: p, ms: ms, v: raw, spec: spec)
		end 'floatSpec'
		return TextPart.make(runtime(l, symbol: Rt.rtFtoa, kind: IrKind.kindManaged, args: argsOf1(raw)), owner: TextOwner.textFresh)
	end 'float'
	if spec.present 'intSpec'
		return formattedInt(l, p: p, v: raw, signed: true, spec: spec)
	end 'intSpec'
	return TextPart.decimal(raw, unsigned: false)
end 'rawText'

function binOpOfText(op String) returns BinOp
	return match op 'op'
		"+" gives BinOp.binAdd
		"-" gives BinOp.binSub
		"*" gives BinOp.binMul
		"/" gives BinOp.binDiv
		"mod" gives BinOp.binMod
		"and" gives BinOp.binAnd
		"or" gives BinOp.binOr
		"xor" gives BinOp.binXor
		"shl" gives BinOp.binShl
		"shr" gives BinOp.binShr
		default panic("lower: unknown operator '{op}'")
	end 'op'
end 'binOpOfText'

function isCmpOpText(op String) returns bool
	return op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
end 'isCmpOpText'

function cmpOpOfText(op String) returns CmpOp
	return match op 'op'
		"==" gives CmpOp.cmpEq
		"!=" gives CmpOp.cmpNe
		"<" gives CmpOp.cmpLt
		"<=" gives CmpOp.cmpLe
		">" gives CmpOp.cmpGt
		">=" gives CmpOp.cmpGe
		default panic("lower: unknown comparison '{op}'")
	end 'op'
end 'cmpOpOfText'

function hasFail(fails Byte, flag Byte) returns bool
	return (fails and flag) != 0
end 'hasFail'

// visitBinaryExpr lowers an operator and the operators nested in its left operand, innermost first, so that a long chain
// takes no stack. The blocks of the 'and' and the 'or' of the chain are made outermost first, as lowering the left
// operand from within each of them would make them. An operator that is the left operand of the next ends as lowerExpr
// ends it, with the values it left in flight taken; its value is a scalar, so nothing else is left to settle.
function visitBinaryExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let mark = l.pending.count()
	var chain = ast.leftChain(p.modules[l.mi].tree, e: e)
	ast.trimFolded(p, ms: ms, typing: p.typings[l.mi], chain: chain)
	openOperator(l, p: p, e: e)
	for i in 0 upto chain.count() 'open'
		let nested = chain[i]
		openOperator(l, p: p, e: nested)
	end 'open'
	var node = ast.nextOperator(chain, e: e)
	var v = lowerExpr(l, p: p, ms: ms, e: ast.binaryExprL(p.modules[l.mi].tree, id: node))
	while node != e 'inner'
		v = lowerOperator(l, p: p, ms: ms, e: node, left: v)
		popPending(l, n: mark)
		if owning(regKind(l, v: v)) 'managed'
			panic("lower: the operator at node {node} of module {l.module} has a managed value")
		end 'managed'
		node = ast.nextOperator(chain, e: e)
	end 'inner'
	return lowerOperator(l, p: p, ms: ms, e: e, left: v)
end 'visitBinaryExpr'

function isLogicalOperator(l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let op = ast.binaryExprOp(p.modules[l.mi].tree, id: e)
	return (op == "and" or op == "or") and exprType(p, module: l.module, node: e) == p.builtins.boolTy
end 'isLogicalOperator'

// openOperator makes the slot and the blocks of an 'and' or an 'or'.
function openOperator(mutates l Lowerer, p ast.Project, e ast.NodeID)
	if isLogicalOperator(l, p: p, e: e) 'logical'
		let result = l.b.f.newSlot(IrKind.kindScalar)
		let rhs = l.b.newBlock()
		let join = l.b.newBlock()
		l.operators.push(OperatorFrame.make(result, rhs: rhs, join: join))
	end 'logical'
end 'openOperator'

// lowerOperator lowers an operator whose left operand has been lowered to the register left.
function lowerOperator(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID, left Reg) returns Reg
	let op = ast.binaryExprOp(p.modules[l.mi].tree, id: e)
	let right = ast.binaryExprR(p.modules[l.mi].tree, id: e)
	if isLogicalOperator(l, p: p, e: e) 'logical'
		let frame = try l.operators.pop() otherwise panic("lower: an 'and' or an 'or' has no blocks")
		emit(l, i: newStoreSlot(frame.result, src: left, borrow: false))
		if op == "and" 'and'
			l.b.terminate(l.cur, t: newBranch(left, ifTrue: frame.rhs, ifFalse: frame.join))
		end 'and' else 'or'
			l.b.terminate(l.cur, t: newBranch(left, ifTrue: frame.join, ifFalse: frame.rhs))
		end 'or'
		l.cur = frame.rhs
		pushScope(l, block: false)
		let rv = lowerExpr(l, p: p, ms: ms, e: right)
		emit(l, i: newStoreSlot(frame.result, src: rv, borrow: false))
		popScope(l, p: p, ms: ms)
		goTo(l, target: frame.join)
		return load(l, slot: frame.result)
	end 'logical'
	if p.typings[l.mi].calls.has(e as Count) 'method'
		return lowerOperatorCall(l, p: p, ms: ms, e: e, op: op, left: left)
	end 'method'
	let arith = arithInfoAt(p, module: l.module, node: e)
	if arith.operand == p.builtins.stringTy 'string'
		let b = lowerExpr(l, p: p, ms: ms, e: right)
		let eq = runtime(l, symbol: Rt.rtStreq, kind: IrKind.kindScalar, args: argsOf2(left, b: b))
		if op == "!=" 'ne'
			return flip(l, boolean: eq)
		end 'ne'
		return eq
	end 'string'
	if arith.operand == p.builtins.characterTy 'character'
		let other = lowerExpr(l, p: p, ms: ms, e: right)
		if op == "==" 'eq'
			return characterEquals(l, left: left, right: other)
		end 'eq'
		if op == "!=" 'ne'
			let eq = characterEquals(l, left: left, right: other)
			return flip(l, boolean: eq)
		end 'ne'
		return characterOrder(l, op: cmpOpOfText(op), left: left, right: other)
	end 'character'
	let c = lowerExpr(l, p: p, ms: ms, e: right)
	if ast.isFloatType(ms.types, reads: p.types, t: arith.operand) 'float'
		return floatOperator(l, p: p, ms: ms, e: e, op: op, left: left, right: c)
	end 'float'
	let unsigned = ast.isUnsignedInt(ms.types, reads: p.types, t: arith.operand)
	if isCmpOpText(op) 'cmp'
		return compare(l, op: cmpOpOfText(op), a: left, b: c, unsigned: unsigned)
	end 'cmp'
	let d = newReg(l, kind: IrKind.kindScalar)
	let binOp = binOpOfText(op)
	let fails = arith.fails
	if hasFail(fails, flag: ast.failDivZero) 'zero'
		let fail = failure(l, p: p, ms: ms, errorCase: ast.errorDivisionByZero, err: noReg, errDrop: ast.noType)
		emit(l, i: newGuard(c, kind: GuardKind.guardNonZero, bound: 0 as Word, fail: fail))
	end 'zero'
	if hasFail(fails, flag: ast.failShift) 'shift'
		let fail = failure(l, p: p, ms: ms, errorCase: ast.errorNegativeShift, err: noReg, errDrop: ast.noType)
		emit(l, i: newGuard(c, kind: GuardKind.guardNonNegative, bound: 0 as Word, fail: fail))
	end 'shift'
	let overflow = overflowTo(l, p: p, ms: ms, fails: fails)
	var wordFail = noBlock
	if hasFail(fails, flag: ast.failOverflow) 'wordFail'
		wordFail = overflow
	end 'wordFail'
	emit(l, i: newBin(d, op: binOp, left: left, right: c, unsigned: unsigned or signFree(l, p: p, ms: ms, op: binOp, e: e), fail: wordFail))
	let ty = exprType(p, module: l.module, node: e)
	if ast.typeKind(ms.types, reads: p.types, t: ty) == ast.TypeKind.intRange 'range'
		rangeCheck(l, p: p, ms: ms, v: d, t: ty, unsigned: unsigned, fails: fails, fail: overflow)
	end 'range'
	return d
end 'lowerOperator'

// signFree is whether op, the operator of the binary expression e, gives the same word read as signed or as unsigned: a
// quotient, a remainder or a right shift of operands that are never negative, which as unsigned is a shift and a mask
// rather than the adjustment a negative dividend needs. The word the checker computes in is signed wherever an operand's
// type is narrower than u64, so it is the operands' own types that say.
function signFree(l Lowerer, p ast.Project, mutates ms ast.ModuleState, op BinOp, e ast.NodeID) returns bool
	if op != BinOp.binDiv and op != BinOp.binMod and op != BinOp.binShr 'signed'
		return false
	end 'signed'
	let left = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: ast.binaryExprL(p.modules[l.mi].tree, id: e)))
	let right = applyType(l, p: p, ms: ms, t: exprType(p, module: l.module, node: ast.binaryExprR(p.modules[l.mi].tree, id: e)))
	return neverNegative(p, ms: ms, t: left) and neverNegative(p, ms: ms, t: right)
end 'signFree'

// neverNegative is whether every value of the integer type t, a range or a constant, is at least 0.
function neverNegative(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: t)
	if kind != ast.TypeKind.intRange and kind != ast.TypeKind.constInt 'notInt'
		return false
	end 'notInt'
	return not ast.typeEntry(ms.types, reads: p.types, t: t).minVal.isNeg()
end 'neverNegative'

// overflowTo is where an operation that can fail as fails says goes when its result does not fit, or noBlock when it
// always fits.
function overflowTo(mutates l Lowerer, p ast.Project, ms ast.ModuleState, fails Byte) returns BlockID
	if (fails and (ast.failOverflow or ast.failBelow or ast.failAbove)) == 0 'fits'
		return noBlock
	end 'fits'
	return failure(l, p: p, ms: ms, errorCase: ast.errorOverflow, err: noReg, errDrop: ast.noType)
end 'overflowTo'

function flip(mutates l Lowerer, boolean Reg) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	let one = konst(l, value: 1 as Word)
	emit(l, i: newBin(d, op: BinOp.binXor, left: boolean, right: one, unsigned: false, fail: noBlock))
	return d
end 'flip'

function visitUnaryExpr(mutates l Lowerer, p ast.Project, mutates ms ast.ModuleState, e ast.NodeID) returns Reg
	let op = ast.unaryExprOp(p.modules[l.mi].tree, id: e)
	let operand = ast.unaryExprE(p.modules[l.mi].tree, id: e)
	let v = lowerExpr(l, p: p, ms: ms, e: operand)
	let ty = exprType(p, module: l.module, node: e)
	if op == "not" and ty == p.builtins.boolTy 'boolean'
		return flip(l, boolean: v)
	end 'boolean'
	if ast.isFloatType(ms.types, reads: p.types, t: ty) 'float'
		return floatNegation(l, v: v)
	end 'float'
	let fails = arithInfoAt(p, module: l.module, node: e).fails
	let overflow = overflowTo(l, p: p, ms: ms, fails: fails)
	let d = newReg(l, kind: IrKind.kindScalar)
	if op == "not" 'not'
		emit(l, i: newNot(d, src: v))
	end 'not' else 'neg'
		var wordFail = noBlock
		if hasFail(fails, flag: ast.failOverflow) 'wordFail'
			wordFail = overflow
		end 'wordFail'
		emit(l, i: newNeg(d, src: v, fail: wordFail))
	end 'neg'
	requireInt(p, ms: ms, t: ty)
	rangeCheck(l, p: p, ms: ms, v: d, t: ty, unsigned: op == "not" and ast.isUnsignedInt(ms.types, reads: p.types, t: exprType(p, module: l.module, node: operand)), fails: fails, fail: overflow)
	return d
end 'visitUnaryExpr'

// rangeCheck checks that a result computed in a word, unsigned or signed, is in its type's range, where fails says it may
// not be. The word is the operands', which the type of the result need not share.
function rangeCheck(mutates l Lowerer, p ast.Project, ms ast.ModuleState, v Reg, t ast.TypeID, unsigned bool, fails Byte, fail BlockID)
	if unsigned 'unsigned'
		fit(l, p: p, ms: ms, v: v, target: t, source: p.builtins.anonU64Ty, fails: fails, fail: fail)
	end 'unsigned' else 'signed'
		fit(l, p: p, ms: ms, v: v, target: t, source: p.builtins.anon64Ty, fails: fails, fail: fail)
	end 'signed'
end 'rangeCheck'

// fit checks that a value of the type source is in the range of target, which goes to fail when it is not. It checks only
// the bounds that fails says the value may be past, below or above: the range analysis proved the others.
function fit(mutates l Lowerer, p ast.Project, ms ast.ModuleState, v Reg, target ast.TypeID, source ast.TypeID, fails Byte, fail BlockID)
	if ast.typeKind(ms.types, reads: p.types, t: source) == ast.TypeKind.constInt 'constant'
		return
	end 'constant'
	requireInt(p, ms: ms, t: source)
	let tMin = ast.typeEntry(ms.types, reads: p.types, t: target).minVal.clone()
	let tMax = ast.typeEntry(ms.types, reads: p.types, t: target).maxVal.clone()
	let sMin = ast.typeEntry(ms.types, reads: p.types, t: source).minVal.clone()
	let sMax = ast.typeEntry(ms.types, reads: p.types, t: source).maxVal.clone()
	let targetUnsigned = ast.isUnsignedInt(ms.types, reads: p.types, t: target)
	let sourceUnsigned = ast.isUnsignedInt(ms.types, reads: p.types, t: source)
	if tMin.le(sMin) and tMax.ge(sMax) and targetUnsigned == sourceUnsigned 'covers'
		return
	end 'covers'
	let below = hasFail(fails, flag: ast.failBelow)
	let above = hasFail(fails, flag: ast.failAbove)
	if targetUnsigned 'toUnsigned'
		if below and not sourceUnsigned and sMin.isNeg() 'negative'
			emit(l, i: newGuard(v, kind: GuardKind.guardNonNegative, bound: 0 as Word, fail: fail))
		end 'negative'
		if below and tMin.gt(ast.maxI128(sMin, b: ast.I128.zero())) 'atLeast'
			emit(l, i: newGuard(v, kind: GuardKind.guardUnsignedAtLeast, bound: wordOf(tMin), fail: fail))
		end 'atLeast'
		if above and tMax.lt(sMax) 'atMost'
			emit(l, i: newGuard(v, kind: GuardKind.guardUnsignedAtMost, bound: wordOf(tMax), fail: fail))
		end 'atMost'
		return
	end 'toUnsigned'
	var srcMax = sMax.clone()
	if sourceUnsigned and sMax.gt(ast.I128.i64Max()) 'wide'
		// A value past i64.max reads as negative in a signed word.
		if above 'aboveWord'
			emit(l, i: newGuard(v, kind: GuardKind.guardNonNegative, bound: 0 as Word, fail: fail))
		end 'aboveWord'
		srcMax = ast.I128.i64Max()
	end 'wide'
	if below and tMin.gt(sMin) 'low'
		emit(l, i: newGuard(v, kind: GuardKind.guardSignedAtLeast, bound: wordOf(tMin), fail: fail))
	end 'low'
	if above and tMax.lt(srcMax) 'high'
		emit(l, i: newGuard(v, kind: GuardKind.guardSignedAtMost, bound: wordOf(tMax), fail: fail))
	end 'high'
end 'fit'
