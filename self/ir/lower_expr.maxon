// constValue is the expression that the value of the constant a name stands for is written as, and the module it is in.
function constantExpr(p ast.Project, name ast.NameInfo) returns ExprRef
	return match ast.moduleDecl(p, ref: name.decl) 'decl'
		constDecl(c) gives ExprRef.make(name.decl.module, node: c.value)
		funcDecl(_) panic("lower: a name of a constant stands for a function")
		typeDecl(_) panic("lower: a name of a constant stands for a type")
		enumDecl(_) panic("lower: a name of a constant stands for an enum")
		unionDecl(_) panic("lower: a name of a constant stands for a union")
		aliasDecl(_) panic("lower: a name of a constant stands for a typealias")
		interfaceDecl(_) panic("lower: a name of a constant stands for an interface")
		extensionDecl(_) panic("lower: a name of a constant stands for an extension")
	end 'decl'
end 'constantExpr'

// exprIn lowers an expression that is in another module than the code around it.
function exprIn(mutates l Lowerer, mutates p ast.Project, e ExprRef) returns Reg
	let saved = l.module
	setModule(l, m: e.module)
	let v = lowerExpr(l, p: p, e: e.node)
	setModule(l, m: saved)
	return v
end 'exprIn'

// lowerExpr lowers an expression to the register that holds its value, and settles who owns that value. One that the
// ownership pass marked consumed passes to its new owner, and a place that is consumed is moved out of (a whole local or a
// field of an owned one; the pass refuses every other). One that is not consumed only lends its value: a fresh value there
// is a temporary, dropped when the statement or branch ends.
//
// A value that is consumed is in flight until what takes it runs, which is the expression around it or the statement: a
// failure before then drops it (see failure).
function lowerExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let ty = exprType(p, module: l.module, node: e)
	let iface = ast.boxedTo(p.typings[l.mi], node: e)
	let applied = applyType(l, p: p, t: ty)
	let boxes = iface != ast.noType and not standsForInterface(p, t: applied)
	let branches = isBranching(p.modules[l.mi].tree.kindOf(e))
	if p.types.entries[ty as Count].kind == ast.TypeKind.constInt and not branches 'constant'
		let c = konst(l, value: wordOf(p.types.entries[ty as Count].minVal))
		if boxes 'boxedConstant'
			return lowerBoxed(l, p: p, e: e, v: c, ty: ty, iface: iface)
		end 'boxedConstant'
		return c
	end 'constant'
	if p.types.entries[ty as Count].kind == ast.TypeKind.constFloat and not branches 'floatConstant'
		return konst(l, value: floatWord(ast.floatLowBits(p.types, t: ty)))
	end 'floatConstant'
	if p.modules[l.mi].tree.kindOf(e) == ast.NodeKind.tryExpr and ast.isTransparent(p.modules[l.mi].tree, e: e) 'transparent'
		return lowerThrough(l, p: p, t: e)
	end 'transparent'
	let mark = l.pending.count()
	var v = visitExpr(l, p: p, e: e)
	popPending(l, n: mark)
	if boxes 'boxed'
		return lowerBoxed(l, p: p, e: e, v: v, ty: ty, iface: iface)
	end 'boxed'
	if regKind(l, v: v) != IrKind.kindManaged 'scalar'
		return v
	end 'scalar'
	let consumed = isConsumed(p, module: l.module, node: e)
	v = settle(l, p: p, e: e, v: v, ty: ty, consumed: consumed)
	if consumed and not isImmortal(l, p: p, e: e) 'inFlight'
		let dropTy = dropType(l, p: p, t: ty)
		l.pending.push(PendingDrop.ofReg(v, ty: dropTy))
	end 'inFlight'
	return v
end 'lowerExpr'

// settle gives the managed value v of e its owner, as far as the expression decides: a fresh value that is not consumed is
// a temporary of the statement, and a consumed place that shares on copy is copied.
function settle(mutates l Lowerer, mutates p ast.Project, e ast.NodeID, v Reg, ty ast.TypeID, consumed bool) returns Reg
	if not ast.isStorage(p.modules[l.mi].tree, typing: p.typings[l.mi], node: e) 'fresh'
		if not consumed and not isImmortal(l, p: p, e: e) 'temporary'
			ownTemp(l, p: p, v: v, t: ty)
		end 'temporary'
		return v
	end 'fresh'
	if consumed and ast.sharesOnCopy(p.types, t: ty) 'shared'
		return copyValue(l, p: p, site: siteOf(l, p: p, node: e), v: v, t: ty)
	end 'shared'
	if consumed and not isWholeLocal(l, p: p, e: e) and not isField(l, p: p, e: e) 'moved'
		panic("lower: an element or a part of a temporary is moved out at offset {p.modules[l.mi].tree.startOf(e)} of module {l.module}; the ownership pass should have refused it")
	end 'moved'
	return v
end 'settle'

// isBranching is whether an expression of the kind picks a branch by a value it computes, so that its type can be one
// constant that its branches agree on while the condition, the subject or an arm that panics still has to run.
function isBranching(k ast.NodeKind) returns bool
	return k == ast.NodeKind.condExpr or k == ast.NodeKind.matchExpr
end 'isBranching'

function visitExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let k = p.modules[l.mi].tree.kindOf(e)
	if k == ast.NodeKind.intLit 'intLit'
		return konst(l, value: wordOf(ast.intLitValue(p.modules[l.mi].tree, id: e)))
	end 'intLit'
	if k == ast.NodeKind.floatLit 'floatLit'
		return konst(l, value: floatWord(ast.floatLitBits(p.modules[l.mi].tree, id: e)))
	end 'floatLit'
	if k == ast.NodeKind.boolLit 'boolLit'
		if ast.boolLitValue(p.modules[l.mi].tree, id: e) 'true'
			return konst(l, value: 1 as Word)
		end 'true'
		return konst(l, value: 0 as Word)
	end 'boolLit'
	if k == ast.NodeKind.strLit 'strLit'
		return visitStrLit(l, p: p, e: e)
	end 'strLit'
	if k == ast.NodeKind.byteStrLit 'byteStrLit'
		return visitByteStrLit(l, p: p, e: e)
	end 'byteStrLit'
	if k == ast.NodeKind.nameExpr 'nameExpr'
		return visitNameExpr(l, p: p, e: e)
	end 'nameExpr'
	if k == ast.NodeKind.selfExpr 'selfExpr'
		if l.selfOwner != noSlot 'owned'
			return ownedRead(l, p: p, slot: slotIndex(l.selfOwner), e: e)
		end 'owned'
		return selfReg(l, p: p)
	end 'selfExpr'
	if k == ast.NodeKind.binaryExpr 'binaryExpr'
		return visitBinaryExpr(l, p: p, e: e)
	end 'binaryExpr'
	if k == ast.NodeKind.unaryExpr 'unaryExpr'
		return visitUnaryExpr(l, p: p, e: e)
	end 'unaryExpr'
	if k == ast.NodeKind.condExpr 'condExpr'
		return visitCondExpr(l, p: p, e: e)
	end 'condExpr'
	if k == ast.NodeKind.castExpr 'castExpr'
		return visitCastExpr(l, p: p, e: e)
	end 'castExpr'
	if k == ast.NodeKind.fromExpr 'fromExpr'
		return visitFromExpr(l, p: p, e: e)
	end 'fromExpr'
	if k == ast.NodeKind.memberExpr 'memberExpr'
		return visitMemberExpr(l, p: p, e: e)
	end 'memberExpr'
	if k == ast.NodeKind.tryExpr 'tryExpr'
		return visitTryExpr(l, p: p, e: e)
	end 'tryExpr'
	if k == ast.NodeKind.panicExpr 'panicExpr'
		return visitPanicExpr(l, p: p, e: e)
	end 'panicExpr'
	if k == ast.NodeKind.callExpr 'callExpr'
		return visitCallExpr(l, p: p, node: e)
	end 'callExpr'
	if k == ast.NodeKind.structLitExpr or k == ast.NodeKind.tupleExpr 'structLitExpr'
		return visitStructLitExpr(l, p: p, e: e)
	end 'structLitExpr'
	if k == ast.NodeKind.indexExpr 'indexExpr'
		return visitIndexExpr(l, p: p, e: e)
	end 'indexExpr'
	if k == ast.NodeKind.collectionLitExpr 'collectionLitExpr'
		return visitCollectionLitExpr(l, p: p, e: e)
	end 'collectionLitExpr'
	if k == ast.NodeKind.matchExpr 'matchExpr'
		return lowerMatch(l, p: p, core: ast.matchExprMatch(p.modules[l.mi].tree, id: e), resultType: exprType(p, module: l.module, node: e))
	end 'matchExpr'
	if k == ast.NodeKind.closureExpr 'closureExpr'
		return visitClosureExpr(l, p: p, e: e)
	end 'closureExpr'
	if k == ast.NodeKind.typeQueryExpr 'typeQueryExpr'
		return visitTypeQueryExpr(l, p: p, e: e)
	end 'typeQueryExpr'
	panic("lower: the node {e} of kind {k.name} is no expression")
end 'visitExpr'

// visitTypeQueryExpr is sizeof of a type that a generic's parameters build, which the instance being lowered fixes, or
// countof the receiver; of a concrete type each is a constant, which lowerExpr gives.
function visitTypeQueryExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let written = exprType(p, module: l.module, node: ast.typeQueryExprType(p.modules[l.mi].tree, id: e))
	if ast.typeQueryExprOp(p.modules[l.mi].tree, id: e) == "countof" 'receiverCount'
		// The count of the receiver of a method of an extension of FixedArray, whose Self states none.
		let box = arrayOf(l, p: p, site: siteOf(l, p: p, node: e), t: written)
		let receiver = selfReg(l, p: p)
		return arrayLength(l, p: p, box: box, arr: receiver)
	end 'receiverCount'
	let applied = applyType(l, p: p, t: written)
	let size = try ast.byteSize(p.types, t: applied) as Word otherwise panic("lower: a size is a word")
	return konst(l, value: size)
end 'visitTypeQueryExpr'

function isWholeLocal(mutates l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let through = ast.through(p.modules[l.mi].tree, e: e)
	let k = p.modules[l.mi].tree.kindOf(through)
	if k == ast.NodeKind.nameExpr 'name'
		return nameInfoAt(p, module: l.module, node: through).kind == ast.NameKind.nameLocal
	end 'name'
	return k == ast.NodeKind.selfExpr
end 'isWholeLocal'

// isField is whether a place is a field of a record, which a move leaves empty.
function isField(mutates l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let through = ast.through(p.modules[l.mi].tree, e: e)
	let k = p.modules[l.mi].tree.kindOf(through)
	if k == ast.NodeKind.nameExpr 'name'
		return nameInfoAt(p, module: l.module, node: through).kind == ast.NameKind.nameSelfField
	end 'name'
	if k == ast.NodeKind.memberExpr 'member'
		return memberInfoAt(p, module: l.module, node: through).kind == ast.MemberKind.memberField
	end 'member'
	return false
end 'isField'

// isImmortal is whether a value is a string that lives in the executable, which is never dropped: a literal, or the name
// of an enum or union case.
function isImmortal(mutates l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let through = ast.through(p.modules[l.mi].tree, e: e)
	let k = p.modules[l.mi].tree.kindOf(through)
	if k == ast.NodeKind.strLit 'str'
		return p.modules[l.mi].tree.strIsPlain(ast.strLitPartsRef(p.modules[l.mi].tree, id: through))
	end 'str'
	if k == ast.NodeKind.memberExpr 'member'
		let kind = memberInfoAt(p, module: l.module, node: through).kind
		return kind == ast.MemberKind.memberEnumName or kind == ast.MemberKind.memberUnionName
	end 'member'
	if k == ast.NodeKind.nameExpr 'name'
		let name = nameInfoAt(p, module: l.module, node: through)
		if name.kind == ast.NameKind.nameConst 'const'
			let value = constantExpr(p, name: name)
			let saved = l.module
			setModule(l, m: value.module)
			let immortal = isImmortal(l, p: p, e: value.node)
			setModule(l, m: saved)
			return immortal
		end 'const'
	end 'name'
	return false
end 'isImmortal'

function visitCondExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let cond = lowerExpr(l, p: p, e: ast.condExprCond(p.modules[l.mi].tree, id: e))
	let typ = exprType(p, module: l.module, node: e)
	let result = l.b.f.newSlot(kindOf(l, p: p, t: typ))
	let a = l.b.newBlock()
	let b = l.b.newBlock()
	let join = l.b.newBlock()
	l.b.terminate(l.cur, t: newBranch(cond, ifTrue: a, ifFalse: b))
	l.cur = a
	pushScope(l, block: false)
	storeConverted(l, p: p, slot: result, e: ast.condExprThen(p.modules[l.mi].tree, id: e), target: typ)
	popScope(l, p: p)
	goTo(l, target: join)
	l.cur = b
	pushScope(l, block: false)
	storeConverted(l, p: p, slot: result, e: ast.condExprElse(p.modules[l.mi].tree, id: e), target: typ)
	popScope(l, p: p)
	goTo(l, target: join)
	return fetch(l, slot: result)
end 'visitCondExpr'

// storeConverted puts the value of one branch of an expression, converted to the type the expression has, into the slot
// that holds it until the branches join, which takes the value: it is no longer in flight, and the other branch never had
// it.
function storeConverted(mutates l Lowerer, mutates p ast.Project, slot Count, e ast.NodeID, target ast.TypeID)
	let mark = l.pending.count()
	let v = lowerConverted(l, p: p, e: e, target: target)
	emit(l, i: newStoreSlot(slot, src: v, borrow: false))
	popPending(l, n: mark)
end 'storeConverted'

function lowerConverted(mutates l Lowerer, mutates p ast.Project, e ast.NodeID, target ast.TypeID) returns Reg
	var v = lowerExpr(l, p: p, e: e)
	// A frozen value given to a let parameter of the type it holds lends its contents.
	var have = applyType(l, p: p, t: exprType(p, module: l.module, node: e))
	let want = applyType(l, p: p, t: target)
	while p.types.entries[have as Count].kind == ast.TypeKind.builtinFrozen and have != want 'frozen'
		let held = heldType(p, t: have)
		v = entry(l, p: p, site: siteOf(l, p: p, node: e), symbol: Rt.rtFrozenGet, kind: kindOfType(p, t: held), args: argsOf1(v))
		have = held
	end 'frozen'
	if ast.isFloatType(p.types, t: want) and ast.isIntType(p.types, t: have) 'toFloat'
		return floatOf(l, p: p, v: v, e: e)
	end 'toFloat'
	return v
end 'lowerConverted'

// heldType is the type of the value a frozen value or a cown holds.
function heldType(p ast.Project, t ast.TypeID) returns ast.TypeID
	return ast.typeArgAt(p.types, t: t, index: 0)
end 'heldType'

// siteOf is where a node is, which a refusal at it is reported at.
function siteOf(l Lowerer, p ast.Project, node ast.NodeID) returns diag.Site
	return diag.Site.make(l.module, offset: p.modules[l.mi].tree.startOf(node))
end 'siteOf'

function visitStructLitExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let lit = structLitInfoAt(p, module: l.module, node: e)
	let ty = exprType(p, module: l.module, node: e)
	let origin = p.types.entries[lit.ty as Count].effectiveOrigin()
	var values = ExprRefList.create(0)
	for i in 0 upto lit.ordered.count() 'each'
		if lit.ordered[i] != 0 'given'
			values.push(ExprRef.make(l.module, node: lit.ordered[i]))
		end 'given' else 'default'
			values.push(ExprRef.make(p.types.entries[origin as Count].decl.module, node: p.types.entries[origin as Count].fields[i].defaultExpr))
		end 'default'
	end 'each'
	return record(l, p: p, t: ty, tag: noTag, values: values)
end 'visitStructLitExpr'

function visitCastExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let inner = ast.castExprE(p.modules[l.mi].tree, id: e)
	let castTy = exprType(p, module: l.module, node: e)
	if isRecoveryCast(l, p: p, e: e) 'recovered'
		return lowerRecoveryCast(l, p: p, e: e, inner: inner, target: castTy)
	end 'recovered'
	let v = lowerExpr(l, p: p, e: inner)
	if ast.isFunctionType(p.types, t: castTy) or p.types.entries[castTy as Count].kind == ast.TypeKind.interfaceTy 'function'
		// A function cast changes only the type, and a cast to an interface is the box that its operand was put in: the
		// value is the operand's, which the ownership pass gave it.
		return v
	end 'function'
	let fails = arithInfoAt(p, module: l.module, node: e).fails
	let fail = overflowTo(l, p: p, fails: fails)
	let target = exprType(p, module: l.module, node: e)
	if p.types.entries[target as Count].kind == ast.TypeKind.floatRange 'float'
		return floatConverted(l, p: p, v: v, e: inner, target: target, fails: fails)
	end 'float'
	requireInt(p, t: target)
	fit(l, p: p, v: v, target: target, source: exprType(p, module: l.module, node: inner), fails: fails, fail: fail)
	return v
end 'visitCastExpr'

function requireInt(p ast.Project, t ast.TypeID)
	if p.types.entries[t as Count].kind != ast.TypeKind.intRange 'range'
		panic("lower: {ast.typeName(p.types, t: t)} is not an integer type")
	end 'range'
end 'requireInt'

function visitPanicExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let msg = lowerExpr(l, p: p, e: ast.panicExprMessage(p.modules[l.mi].tree, id: e))
	let location = strReg(l, value: ast.panicLocation(p.modules[l.mi], offset: p.modules[l.mi].tree.startOf(e)))
	emitCallRuntime(l, dst: noReg, symbol: Rt.rtPanicAt, args: argsOf2(location, b: msg), routine: ast.noFunc)
	seal(l, t: newTrap())
	return konst(l, value: 0 as Word)
end 'visitPanicExpr'

function visitNameExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let name = nameInfoAt(p, module: l.module, node: e)
	if name.kind == ast.NameKind.nameLocal 'local'
		let loc = localEntry(p, module: l.fnModule, id: name.local)
		if not loc.isParam 'variable'
			return ownedRead(l, p: p, slot: slotOf(loc), e: e)
		end 'variable'
		if loc.isCapture and not isByRef(loc) 'captured'
			return captureRead(l, p: p, loc: loc)
		end 'captured'
		if not isByRef(loc) 'byValue'
			let owner = ownerOf(l, id: name.local, isSelf: loc.isSelf)
			if owner != noSlot 'owned'
				return ownedRead(l, p: p, slot: slotIndex(owner), e: e)
			end 'owned'
			return paramReg(l, index: loc.paramIndex, kind: kindOf(l, p: p, t: loc.ty))
		end 'byValue'
		let d = newReg(l, kind: kindOf(l, p: p, t: loc.ty))
		let addr = refAddress(l, p: p, loc: loc)
		emit(l, i: newLoadAt(d, addr: addr))
		return d
	end 'local'
	if name.kind == ast.NameKind.nameSelfField 'field'
		let d = newReg(l, kind: kindOf(l, p: p, t: exprType(p, module: l.module, node: e)))
		let obj = selfReg(l, p: p)
		loadField(l, p: p, d: d, obj: obj, e: e, index: name.fieldIndex)
		return d
	end 'field'
	if name.kind == ast.NameKind.nameConst 'const'
		return exprIn(l, p: p, e: constantExpr(p, name: name))
	end 'const'
	if name.kind == ast.NameKind.nameFunc 'function'
		return functionValue(l, fn: name.func)
	end 'function'
	panic("lower: unresolved name '{ast.nameExprName(p.modules[l.mi].tree, id: e)}'")
end 'visitNameExpr'

// loadField is the value of a field of a record: a move out of it when the ownership pass found the expression consuming
// it, which leaves 0 in the field for the drop of the record to skip, and a borrow otherwise.
function loadField(mutates l Lowerer, p ast.Project, d Reg, obj Reg, e ast.NodeID, index Count)
	let offset = wordOffset(index)
	if movesOut(p, module: l.module, node: e) and regKind(l, v: d) == IrKind.kindManaged 'move'
		let addr = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newFieldAddr(addr, obj: obj, offset: offset))
		emit(l, i: newMoveAt(d, addr: addr))
		return
	end 'move'
	emit(l, i: newLoadField(d, obj: obj, offset: offset))
end 'loadField'

// address is where a call that takes e by address finds it. An element of a byte array is given as a slot, so the caller
// stores what the callee left there back with writeBack once the callee returns.
function address(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let k = p.modules[l.mi].tree.kindOf(e)
	if k == ast.NodeKind.nameExpr 'name'
		let name = nameInfoAt(p, module: l.module, node: e)
		if name.kind == ast.NameKind.nameLocal 'local'
			let loc = localEntry(p, module: l.fnModule, id: name.local)
			if isByRef(loc) 'byRef'
				return refAddress(l, p: p, loc: loc)
			end 'byRef'
			let d = newReg(l, kind: IrKind.kindScalar)
			emit(l, i: newSlotAddr(d, slot: slotOf(loc)))
			return d
		end 'local'
		if name.kind == ast.NameKind.nameSelfField 'field'
			let d = newReg(l, kind: IrKind.kindScalar)
			let obj = selfReg(l, p: p)
			emit(l, i: newFieldAddr(d, obj: obj, offset: wordOffset(name.fieldIndex)))
			return d
		end 'field'
	end 'name'
	if k == ast.NodeKind.memberExpr 'member'
		let member = memberInfoAt(p, module: l.module, node: e)
		if member.kind == ast.MemberKind.memberField 'field'
			let obj = lowerRead(l, p: p, e: ast.memberExprObj(p.modules[l.mi].tree, id: e))
			let d = newReg(l, kind: IrKind.kindScalar)
			emit(l, i: newFieldAddr(d, obj: obj, offset: wordOffset(member.fieldIndex)))
			return d
		end 'field'
	end 'member'
	if k == ast.NodeKind.indexExpr 'index'
		return elemPlace(l, p: p, e: e)
	end 'index'
	let ty = exprType(p, module: l.module, node: e)
	if ast.isMutatingFunction(p.types, t: ty) 'temporary'
		// A new function value that the callee changes lives in a slot of its own, which drops what the callee leaves there.
		let mark = l.pending.count()
		let v = visitExpr(l, p: p, e: e)
		popPending(l, n: mark)
		let slot = l.b.f.newSlot(IrKind.kindManaged)
		emit(l, i: newStoreSlot(slot, src: v, borrow: false))
		ownLocal(l, p: p, slot: slot, t: ty)
		let d = newReg(l, kind: IrKind.kindScalar)
		emit(l, i: newSlotAddr(d, slot: slot))
		return d
	end 'temporary'
	panic("lower: no address for this expression")
end 'address'

// CallSite is a call being lowered: its node, which is where a refusal is reported, and what the checker found out about
// it. receiver is the object it is made on, found once, and ordered are the arguments in the order of the parameters.
export type CallSite
	export var node as ast.NodeID
	export var info as ast.CallInfo
	export var receiver as ast.NodeID
	export var ordered as ast.NodeIDList

	export static function make(node ast.NodeID, consumes info ast.CallInfo, receiver ast.NodeID, consumes ordered ast.NodeIDList) returns CallSite
		return CallSite{node: node, info: info, receiver: receiver, ordered: ordered}
	end 'make'
end 'CallSite'

// callSite is the call a node is, with what its module's checker found out about it.
function callSite(l Lowerer, p ast.Project, node ast.NodeID) returns CallSite
	let info = callInfoAt(p, module: l.module, node: node)
	let receiver = ast.callReceiver(p.modules[l.mi].tree, e: node, kind: info.kind)
	let ordered = info.ordered.clone()
	return CallSite.make(node, info: info, receiver: receiver, ordered: ordered)
end 'callSite'

function argsSince(l Lowerer, base Count) returns RegList
	var out = RegList.create(0)
	for i in base upto l.args.count() 'each'
		out.push(l.args[i])
	end 'each'
	return out
end 'argsSince'

// lowerCall lowers a call of a function, a static function or a method, whose failure goes to the try around it.
function lowerCall(mutates l Lowerer, mutates p ast.Project, c CallSite) returns Reg
	let mark = l.pending.count()
	let node = c.node
	let kind = c.info.kind
	if kind != ast.CallKind.callBound and p.funcs.entries[c.info.fn as Count].intrinsic != ast.Intrinsic.intrNone 'intrinsic'
		return lowerIntrinsic(l, p: p, c: c)
	end 'intrinsic'
	let iface = witnessInterface(p, module: l.module, receiver: c.receiver, info: c.info, bindParams: l.bindParams, bindArgs: l.bindArgs)
	var target = ast.noFunc
	if iface == ast.noType 'direct'
		target = callee(l, p: p, node: node, info: c.info, receiver: c.receiver)
	end 'direct'
	let base = l.args.count()
	let places = l.writeBacks.count()
	if c.receiver != 0 'receiver'
		let recv = lowerRead(l, p: p, e: c.receiver)
		pushArg(l, v: recv)
	end 'receiver'
	pushOrderedArgs(l, p: p, c: c)
	let dst = callResult(l, p: p, node: node)
	var errTy = ast.noType
	if kind == ast.CallKind.callBound 'bound'
		errTy = p.funcs.entries[c.info.method as Count].errTy
	end 'bound' else 'target'
		errTy = p.funcs.entries[target as Count].errTy
	end 'target'
	if errTy == ast.noType 'plain'
		emitCallOf(l, p: p, c: c, iface: iface, dst: dst, target: target, args: argsSince(l, base: base), err: noReg)
		popArgs(l, n: base)
		writeBack(l, p: p, mark: places)
	end 'plain' else 'throwing'
		var errKind = IrKind.kindScalar
		if ast.isUnionError(p.types, t: errTy) 'union'
			errKind = IrKind.kindManaged
		end 'union'
		let err = newReg(l, kind: errKind)
		emitCallOf(l, p: p, c: c, iface: iface, dst: dst, target: target, args: argsSince(l, base: base), err: err)
		popArgs(l, n: base)
		// What the callee wrote to an element before it failed stays written, as it would through the element's own
		// address.
		writeBack(l, p: p, mark: places)
		// The callee has the arguments now, and drops them itself when it fails.
		popPending(l, n: mark)
		let ok = l.b.newBlock()
		let zero = konst(l, value: 0 as Word)
		let failed = compare(l, op: CmpOp.cmpNe, a: err, b: zero, unsigned: false)
		let errDrop = errorDropType(l, p: p, t: errTy)
		let stub = failure(l, p: p, errorCase: 0 as Count, err: err, errDrop: errDrop)
		l.b.terminate(l.cur, t: newBranch(failed, ifTrue: stub, ifFalse: ok))
		l.cur = ok
	end 'throwing'
	if dst == noReg 'none'
		return konst(l, value: 0 as Word)
	end 'none'
	return dst
end 'lowerCall'

// emitCallOf emits the call that a call site makes with args, the receiver first: of the function target, or through the
// table of the interface value that is the receiver, when iface is its interface; err is noReg for a call that cannot
// fail.
function emitCallOf(mutates l Lowerer, mutates p ast.Project, c CallSite, iface ast.TypeID, dst Reg, target ast.FuncID, args RegList, err Reg)
	if iface != ast.noType 'witness'
		let slot = ast.requirementSlot(p.types, iface: iface, sig: c.info.method)
		var rest = RegList.create(0)
		for i in 1 upto args.count() 'rest'
			rest.push(args[i])
		end 'rest'
		let instr = l.b.callWitness(dst, conv: receiverConv(c.info.selfConv), slot: slot, recv: args[0], args: rest, err: err)
		emit(l, i: instr)
		return
	end 'witness'
	if err == noReg 'plain'
		emitCall(l, dst: dst, target: target, args: args)
		return
	end 'plain'
	emitThrowingCall(l, dst: dst, target: target, args: args, err: err)
end 'emitCallOf'

function visitCallExpr(mutates l Lowerer, mutates p ast.Project, node ast.NodeID) returns Reg
	let c = callSite(l, p: p, node: node)
	let kind = c.info.kind
	if kind == ast.CallKind.callPrint or kind == ast.CallKind.callPrintError 'print'
		let text = lowerExpr(l, p: p, e: c.ordered[0])
		let handle = newReg(l, kind: IrKind.kindScalar)
		var symbol = Rt.rtStderr
		if kind == ast.CallKind.callPrint 'out'
			symbol = Rt.rtStdout
		end 'out'
		emit(l, i: newLoadGlobal(handle, symbol: symbol))
		emitCallRuntime(l, dst: noReg, symbol: Rt.rtWrite, args: argsOf2(handle, b: text), routine: ast.noFunc)
		return konst(l, value: 0 as Word)
	end 'print'
	if kind == ast.CallKind.callFunction or kind == ast.CallKind.callStatic or kind == ast.CallKind.callMethod or kind == ast.CallKind.callBound 'call'
		return lowerCall(l, p: p, c: c)
	end 'call'
	if kind == ast.CallKind.callValue 'value'
		let closure = lowerRead(l, p: p, e: ast.callExprCallee(p.modules[l.mi].tree, id: node))
		let base = l.args.count()
		let places = l.writeBacks.count()
		pushOrderedArgs(l, p: p, c: c)
		let dst = callResult(l, p: p, node: node)
		let args = argsSince(l, base: base)
		let instr = l.b.callValueInstr(dst, target: closure, args: args)
		emit(l, i: instr)
		popArgs(l, n: base)
		writeBack(l, p: p, mark: places)
		if dst == noReg 'none'
			return konst(l, value: 0 as Word)
		end 'none'
		return dst
	end 'value'
	if kind == ast.CallKind.callCopy 'copy'
		let v = lowerExpr(l, p: p, e: c.receiver)
		return copyValue(l, p: p, site: siteOf(l, p: p, node: node), v: v, t: exprType(p, module: l.module, node: c.receiver))
	end 'copy'
	if kind == ast.CallKind.callUnionCtor 'ctor'
		var values = ExprRefList.create(0)
		for i in 0 upto c.ordered.count() 'each'
			values.push(ExprRef.make(l.module, node: c.ordered[i]))
		end 'each'
		return record(l, p: p, t: exprType(p, module: l.module, node: node), tag: indexOf(c.info.unionCase), values: values)
	end 'ctor'
	panic("lower: unresolved call")
end 'visitCallExpr'

// lowerDefault lowers the default of a parameter that a call leaves out, in the module that declares the function and with
// its type parameters bound to the call's type arguments, converted to the parameter's type.
function lowerDefault(mutates l Lowerer, mutates p ast.Project, info ast.CallInfo, spec ast.ParamSpec) returns Reg
	let saved = l.module
	let args = applyAll(p.types, ts: info.typeArgs, params: l.bindParams, args: l.bindArgs)
	let savedParams = exchange(l.bindParams, value: ast.cloneTypeArgs(p.funcs.entries[info.fn as Count].generics))
	let savedArgs = exchange(l.bindArgs, value: args)
	setModule(l, m: p.funcs.entries[info.fn as Count].module)
	let v = lowerConverted(l, p: p, e: spec.defaultExpr, target: spec.ty)
	setModule(l, m: saved)
	l.bindParams = savedParams
	l.bindArgs = savedArgs
	return v
end 'lowerDefault'

// pushOrderedArgs gives the call its arguments in the order of the parameters: by address where the parameter takes its
// argument's place, and by value, converted to the parameter's type, where it does not.
function pushOrderedArgs(mutates l Lowerer, mutates p ast.Project, c CallSite)
	for i in 0 upto c.ordered.count() 'each'
		if c.ordered[i] == 0 'defaulted'
			let dv = lowerDefault(l, p: p, info: c.info, spec: c.info.paramSpecs[i])
			pushArg(l, v: dv)
			continue 'each'
		end 'defaulted'
		if ast.isByAddress(c.info.paramSpecs[i].conv) 'address'
			let addr = address(l, p: p, e: c.ordered[i])
			pushArg(l, v: addr)
		end 'address' else 'value'
			let v = lowerConverted(l, p: p, e: c.ordered[i], target: c.info.paramSpecs[i].ty)
			pushArg(l, v: v)
		end 'value'
	end 'each'
end 'pushOrderedArgs'

// callResult is the register a call gives its value in, or noReg for a call that returns nothing.
function callResult(mutates l Lowerer, mutates p ast.Project, node ast.NodeID) returns Reg
	let callTy = exprType(p, module: l.module, node: node)
	if callTy == p.builtins.voidTy 'none'
		return noReg
	end 'none'
	return newReg(l, kind: kindOf(l, p: p, t: callTy))
end 'callResult'

// callee is the function a call runs. Every instance a body reaches was found for the module before lowering, so a
// missing one, or one refused, is a compiler bug: the executable would depend on another module having made the instance.
function callee(mutates l Lowerer, mutates p ast.Project, node ast.NodeID, info ast.CallInfo, receiver ast.NodeID) returns ast.FuncID
	var refused = diag.ErrorList.create(0)
	match consumes resolveTarget(p, module: l.module, site: node, receiver: receiver, info: info, bindParams: l.bindParams, bindArgs: l.bindArgs, bindWitnesses: l.bindWitnesses, errs: refused) 'resolved'
		some(fid) then return checkedCallee(l, p: p, target: fid)
		none then panic("lower: a call was refused after its module's instances were found")
	end 'resolved'
end 'callee'

function checkedCallee(l Lowerer, p ast.Project, target ast.FuncID) returns ast.FuncID
	if p.funcs.entries[target as Count].genericOrigin != ast.noFunc and not l.instances.has(target) 'missing'
		panic("lower: {funcSymbol(p, fid: target)} was not found among the instances of the module")
	end 'missing'
	return target
end 'checkedCallee'

// boxBytes is the size of a record or union box: a word per field (one for a box with none), and a first word for a
// union's case index. The backend sizes the boxes it copies with it, so a copy has the layout lowering gives a value.
export function boxBytes(fields Count, tagged bool) returns Count
	var words = fields
	if words < 1 'one'
		words = 1
	end 'one'
	if tagged 'tag'
		words = succ(words)
	end 'tag'
	return wordOffset(words)
end 'boxBytes'

// fieldOffset is where the field with this index sits in a box: after the case index when the box is a union's.
export function fieldOffset(index Count, tagged bool) returns Count
	if tagged 'tag'
		return wordOffset(succ(index))
	end 'tag'
	return wordOffset(index)
end 'fieldOffset'

// record is a new box of the fields of the type t, which the tag, when it has one, makes a union: values are the
// expression of each field. The box is in flight while its fields are computed, and owns each one once it is stored.
function record(mutates l Lowerer, mutates p ast.Project, t ast.TypeID, tag Index, values ExprRefList) returns Reg
	let tagged = tag != noTag
	let count = values.count()
	let box = newReg(l, kind: IrKind.kindManaged)
	emit(l, i: newAlloc(box, bytes: boxBytes(count, tagged: tagged)))
	if tagged 'tagStore'
		let tagReg = konst(l, value: try tag as Word otherwise panic("ir: a case index is out of range"))
		emit(l, i: newStoreField(box, offset: tagOffset, src: tagReg))
	end 'tagStore'
	let mark = l.pending.count()
	if count > 0 'owned'
		let ty = dropType(l, p: p, t: t)
		l.pending.push(PendingDrop.ofReg(box, ty: ty))
	end 'owned'
	for i in 0 upto count 'each'
		let v = exprIn(l, p: p, e: values[i])
		emit(l, i: newStoreField(box, offset: fieldOffset(i, tagged: tagged), src: v))
		popPending(l, n: succ(mark))
	end 'each'
	popPending(l, n: mark)
	return box
end 'record'

// copyValue is a new value equal to v, which every part of it owns: the deep copy that CopyInstr says. A scalar is the
// value itself. site is the source that needs the copy, kept when the type holds something that has no native code.
function copyValue(mutates l Lowerer, mutates p ast.Project, site diag.Site, v Reg, t ast.TypeID) returns Reg
	let ty = applyType(l, p: p, t: t)
	if kindOfType(p, t: ty) != IrKind.kindManaged 'scalar'
		return v
	end 'scalar'
	requireNative(l, p: p, site: site, t: ty)
	let d = newReg(l, kind: IrKind.kindManaged)
	emitCopy(l, dst: d, src: v, ty: ty)
	return d
end 'copyValue'

function tagReg(mutates l Lowerer, box Reg) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newLoadField(d, obj: box, offset: tagOffset))
	return d
end 'tagReg'

// caseNames are the names of the cases of an enum or a union, in the order of their indexes.
function caseNames(p ast.Project, t ast.TypeID) returns ast.StringList
	let origin = p.types.entries[t as Count].effectiveOrigin()
	var names = ast.StringList.create(0)
	for i in 0 upto p.types.entries[origin as Count].cases.count() 'each'
		names.push(p.types.entries[origin as Count].cases[i].name.clone())
	end 'each'
	return names
end 'caseNames'

function visitMemberExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let member = memberInfoAt(p, module: l.module, node: e)
	let obj = ast.memberExprObj(p.modules[l.mi].tree, id: e)
	let kind = member.kind
	if kind == ast.MemberKind.memberField 'field'
		let base = lowerRead(l, p: p, e: obj)
		let d = newReg(l, kind: kindOf(l, p: p, t: exprType(p, module: l.module, node: e)))
		loadField(l, p: p, d: d, obj: base, e: e, index: member.fieldIndex)
		return d
	end 'field'
	if kind == ast.MemberKind.memberEnumCase 'enumCase'
		return konst(l, value: try member.enumCase as Word otherwise panic("ir: a case index is out of range"))
	end 'enumCase'
	if kind == ast.MemberKind.memberUnionCase 'unionCase'
		return record(l, p: p, t: exprType(p, module: l.module, node: e), tag: indexOf(member.enumCase), values: ExprRefList.create(0))
	end 'unionCase'
	if kind == ast.MemberKind.memberEnumOrdinal 'ordinal'
		return lowerExpr(l, p: p, e: obj)
	end 'ordinal'
	if kind == ast.MemberKind.memberEnumName 'enumName'
		let v = lowerExpr(l, p: p, e: obj)
		return names(l, index: v, names: caseNames(p, t: exprType(p, module: l.module, node: obj)))
	end 'enumName'
	if kind == ast.MemberKind.memberEnumRaw 'enumRaw'
		let et = exprType(p, module: l.module, node: obj)
		let v = lowerExpr(l, p: p, e: obj)
		return rawValueOf(l, p: p, t: et, index: v)
	end 'enumRaw'
	if kind == ast.MemberKind.memberUnionRaw 'unionRaw'
		let ut = exprType(p, module: l.module, node: obj)
		let u = lowerExpr(l, p: p, e: obj)
		let tag = tagReg(l, box: u)
		return rawValueOf(l, p: p, t: ut, index: tag)
	end 'unionRaw'
	if kind == ast.MemberKind.memberUnionOrdinal 'unionOrdinal'
		let u = lowerExpr(l, p: p, e: obj)
		return tagReg(l, box: u)
	end 'unionOrdinal'
	if kind == ast.MemberKind.memberUnionName 'unionName'
		let u = lowerExpr(l, p: p, e: obj)
		let t = tagReg(l, box: u)
		return names(l, index: t, names: caseNames(p, t: exprType(p, module: l.module, node: obj)))
	end 'unionName'
	panic("lower: unresolved member")
end 'visitMemberExpr'

// rawValueOf is the raw value of the case of the enum or union type t that index says: the index itself for integers that the
// cases did not write, and otherwise the raw value of each case, chosen by a switch.
function rawValueOf(mutates l Lowerer, p ast.Project, t ast.TypeID, index Reg) returns Reg
	let origin = p.types.entries[t as Count].effectiveOrigin()
	let kind = p.types.entries[origin as Count].rawKind
	if kind == ast.RawKind.string 'string'
		var texts = ast.StringList.create(0)
		for i in 0 upto p.types.entries[origin as Count].cases.count() 'texts'
			texts.push(p.types.entries[origin as Count].cases[i].rawText.clone())
		end 'texts'
		return names(l, index: index, names: texts)
	end 'string'
	if kind == ast.RawKind.integer and not p.types.entries[origin as Count].hasExplicitRaw 'ordinal'
		return index
	end 'ordinal'
	let count = p.types.entries[origin as Count].cases.count()
	let sel = selectStart(l, kind: IrKind.kindScalar, index: index, count: count)
	for i in 0 upto count 'each'
		selectArm(l, s: sel, i: i)
		let raw = konst(l, value: wordOf(p.types.entries[origin as Count].cases[i].rawValue))
		selectStore(l, s: sel, v: raw)
	end 'each'
	return selectEnd(l, s: sel)
end 'rawValueOf'

// names is the name of the case that index says, as a string of the executable.
function names(mutates l Lowerer, index Reg, names ast.StringList) returns Reg
	let sel = selectStart(l, kind: IrKind.kindManaged, index: index, count: names.count())
	for i in 0 upto names.count() 'each'
		selectArm(l, s: sel, i: i)
		let v = strReg(l, value: names[i])
		selectStore(l, s: sel, v: v)
	end 'each'
	return selectEnd(l, s: sel)
end 'names'

// Select is a value that one of several arms computes, which a switch on an index chooses: each arm's value is stored into
// a slot of its own and the join reads it.
export type Select
	export var result as Count
	export var join as BlockID
	export var targets as BlockIDList

	export static function make(result Count, join BlockID, consumes targets BlockIDList) returns Select
		return Select{result: result, join: join, targets: targets}
	end 'make'
end 'Select'

// selectStart ends the block with the switch over index, which has an arm for each of count values.
function selectStart(mutates l Lowerer, kind IrKind, index Reg, count Count) returns Select
	let result = l.b.f.newSlot(kind)
	let join = l.b.newBlock()
	var targets = BlockIDList.create(0)
	for i in 0 upto count 'arms'
		targets.push(l.b.newBlock())
	end 'arms'
	var values = WordList.create(0)
	var armTargets = BlockIDList.create(0)
	let last = pred(count)
	for i in 0 upto last 'cases'
		values.push(try i as Word otherwise panic("ir: a case index is out of range"))
		armTargets.push(targets[i])
	end 'cases'
	let sw = l.b.switch(index, values: values, targets: armTargets, def: targets[last])
	l.b.terminate(l.cur, t: sw)
	return Select.make(result, join: join, targets: targets)
end 'selectStart'

// selectArm makes the block of an arm the one that is being lowered.
function selectArm(mutates l Lowerer, s Select, i Count)
	l.cur = s.targets[i]
end 'selectArm'

// selectStore ends an arm with its value.
function selectStore(mutates l Lowerer, s Select, v Reg)
	emit(l, i: newStoreSlot(s.result, src: v, borrow: false))
	goTo(l, target: s.join)
end 'selectStore'

// selectEnd is the value the arms computed, taken from the slot that held it.
function selectEnd(mutates l Lowerer, s Select) returns Reg
	return fetch(l, slot: s.result)
end 'selectEnd'

// TextOwner says who owns the string a part of an interpolated literal gives.
export enum TextOwner
	// textBorrowed is a string some other owner holds, which the literal only reads.
	textBorrowed
	// textImmortal is a string in the executable.
	textImmortal
	// textFresh is a string the literal made, which it owns until it joins it into the result.
	textFresh
end 'TextOwner'

// TextPart is the value of a part of an interpolated literal and who owns it.
export type TextPart
	export var value as Reg
	export var owner as TextOwner

	export static function make(value Reg, owner TextOwner) returns TextPart
		return TextPart{value: value, owner: owner}
	end 'make'
end 'TextPart'

// plainText is the text of a string literal with no interpolation.
function plainText(l Lowerer, p ast.Project, e ast.NodeID) returns String
	return partsText(l, p: p, partsRef: ast.strLitPartsRef(p.modules[l.mi].tree, id: e))
end 'plainText'

// partsText is the text of the parts of a literal that has no interpolation.
function partsText(l Lowerer, p ast.Project, partsRef diag.U32) returns String
	return ast.strPartsText(p.modules[l.mi].tree, partsRef: partsRef)
end 'partsText'

// visitByteStrLit is a new byte array with the bytes of a byte string literal, copied from its text in the executable's data.
function visitByteStrLit(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let a = arrayOf(l, p: p, site: siteOf(l, p: p, node: e), t: exprType(p, module: l.module, node: e))
	let out = arrayNew(l, p: p, box: a)
	let text = partsText(l, p: p, partsRef: ast.byteStrLitPartsRef(p.modules[l.mi].tree, id: e))
	if text.byteLength() > 0 'bytes'
		let literal = strReg(l, value: text)
		arrayAppendText(l, p: p, box: a, arr: out, text: literal)
	end 'bytes'
	return out
end 'visitByteStrLit'

// visitStrLit joins the parts of an interpolated literal into a new string, dropping each intermediate string once it has
// been joined. A literal of a single borrowed string is a copy of it, because the literal's value is its own.
function visitStrLit(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let partsRef = ast.strLitPartsRef(p.modules[l.mi].tree, id: e)
	let count = p.modules[l.mi].tree.strPartCount(partsRef)
	if p.modules[l.mi].tree.strIsPlain(partsRef) 'plain'
		return strReg(l, value: plainText(l, p: p, e: e))
	end 'plain'
	let first = strPart(l, p: p, partsRef: partsRef, index: 0 as Count)
	var acc = first.value
	var owner = first.owner
	if count == 1 and owner == TextOwner.textBorrowed 'single'
		let string = p.builtins.stringTy
		return copyValue(l, p: p, site: siteOf(l, p: p, node: e), v: acc, t: string)
	end 'single'
	for i in 1 upto count 'join'
		let mark = l.pending.count()
		if owner == TextOwner.textFresh 'fresh'
			l.pending.push(PendingDrop.ofReg(acc, ty: p.builtins.stringTy))
		end 'fresh'
		let next = strPart(l, p: p, partsRef: partsRef, index: i)
		popPending(l, n: mark)
		let joined = runtime(l, symbol: Rt.rtConcat, kind: IrKind.kindManaged, args: argsOf2(acc, b: next.value))
		if owner == TextOwner.textFresh 'dropAcc'
			let string = p.builtins.stringTy
			dropValue(l, p: p, v: acc, t: string)
		end 'dropAcc'
		if next.owner == TextOwner.textFresh 'dropNext'
			let string = p.builtins.stringTy
			dropValue(l, p: p, v: next.value, t: string)
		end 'dropNext'
		acc = joined
		owner = TextOwner.textFresh
	end 'join'
	return acc
end 'visitStrLit'

function strPart(mutates l Lowerer, mutates p ast.Project, partsRef diag.U32, index Count) returns TextPart
	if not p.modules[l.mi].tree.strPartIsExpr(partsRef, index: index) 'text'
		return TextPart.make(strReg(l, value: p.modules[l.mi].tree.strPartText(partsRef, index: index)), owner: TextOwner.textImmortal)
	end 'text'
	let e = p.modules[l.mi].tree.strPartExpr(partsRef, index: index)
	let v = lowerRead(l, p: p, e: e)
	let applied = applyType(l, p: p, t: exprType(p, module: l.module, node: e))
	let t = ast.contentType(p.types, t: applied)
	let kind = p.types.entries[t as Count].kind
	let spec = formatSpecOf(p.modules[l.mi].tree, partsRef: partsRef, index: index)
	if t == p.builtins.stringTy and spec.quotes 'quoted'
		return quotedText(l, v: v, spec: spec)
	end 'quoted'
	if t == p.builtins.stringTy 'string'
		if isImmortal(l, p: p, e: e) 'immortal'
			return TextPart.make(v, owner: TextOwner.textImmortal)
		end 'immortal'
		return TextPart.make(v, owner: TextOwner.textBorrowed)
	end 'string'
	if t == p.builtins.boolTy 'bool'
		var texts = ast.StringList.create(0)
		texts.push("false")
		texts.push("true")
		return TextPart.make(names(l, index: v, names: texts), owner: TextOwner.textImmortal)
	end 'bool'
	if (kind == ast.TypeKind.constInt or kind == ast.TypeKind.intRange) and spec.present 'formattedInt'
		return formattedInt(l, p: p, v: v, signed: not rendersUnsigned(p, t: t), spec: spec)
	end 'formattedInt'
	if (kind == ast.TypeKind.constFloat or kind == ast.TypeKind.floatRange) and spec.present 'formattedFloat'
		return formattedFloat(l, p: p, v: v, spec: spec)
	end 'formattedFloat'
	if kind == ast.TypeKind.constInt 'constant'
		let flag = konst(l, value: 0 as Word)
		return TextPart.make(runtime(l, symbol: Rt.rtItoa, kind: IrKind.kindManaged, args: argsOf2(v, b: flag)), owner: TextOwner.textFresh)
	end 'constant'
	if kind == ast.TypeKind.intRange 'int'
		var flag = 0 as Word
		if ast.isUnsignedInt(p.types, t: t) 'unsigned'
			flag = 1
		end 'unsigned'
		let flagReg = konst(l, value: flag)
		return TextPart.make(runtime(l, symbol: Rt.rtItoa, kind: IrKind.kindManaged, args: argsOf2(v, b: flagReg)), owner: TextOwner.textFresh)
	end 'int'
	if kind == ast.TypeKind.constFloat or kind == ast.TypeKind.floatRange 'float'
		return TextPart.make(runtime(l, symbol: Rt.rtFtoa, kind: IrKind.kindManaged, args: argsOf1(v)), owner: TextOwner.textFresh)
	end 'float'
	if kind == ast.TypeKind.enumTy and p.types.entries[t as Count].hasExplicitRaw 'rawEnum'
		return rawText(l, p: p, t: t, index: v, spec: spec)
	end 'rawEnum'
	if kind == ast.TypeKind.enumTy 'enum'
		return TextPart.make(names(l, index: v, names: caseNames(p, t: t)), owner: TextOwner.textImmortal)
	end 'enum'
	if kind == ast.TypeKind.unionTy 'union'
		let tag = tagReg(l, box: v)
		return TextPart.make(names(l, index: tag, names: caseNames(p, t: t)), owner: TextOwner.textImmortal)
	end 'union'
	panic("lower: cannot interpolate {ast.typeName(p.types, t: exprType(p, module: l.module, node: e))}")
end 'strPart'

// rawText is the text of an enum value whose cases write raw values, which is its raw value as the type of the raw value
// writes it: the digits of an integer, the shortest spelling of a float, or the string itself.
function rawText(mutates l Lowerer, mutates p ast.Project, t ast.TypeID, index Reg, spec ast.FormatSpec) returns TextPart
	let raw = rawValueOf(l, p: p, t: t, index: index)
	let kind = p.types.entries[t as Count].rawKind
	if kind == ast.RawKind.string 'string'
		return TextPart.make(raw, owner: TextOwner.textImmortal)
	end 'string'
	if kind == ast.RawKind.float 'float'
		if spec.present 'floatSpec'
			return formattedFloat(l, p: p, v: raw, spec: spec)
		end 'floatSpec'
		return TextPart.make(runtime(l, symbol: Rt.rtFtoa, kind: IrKind.kindManaged, args: argsOf1(raw)), owner: TextOwner.textFresh)
	end 'float'
	if spec.present 'intSpec'
		return formattedInt(l, p: p, v: raw, signed: true, spec: spec)
	end 'intSpec'
	let signed = konst(l, value: 0 as Word)
	return TextPart.make(runtime(l, symbol: Rt.rtItoa, kind: IrKind.kindManaged, args: argsOf2(raw, b: signed)), owner: TextOwner.textFresh)
end 'rawText'

// formatSpecOf is the format specifier of a part of a string literal, which asks for nothing for a part that has none. The
// parser refused a specifier that does not read, so every one reads here.
function formatSpecOf(t ast.Tree, partsRef diag.U32, index Count) returns ast.FormatSpec
	let text = t.strPartFormat(partsRef, index: index)
	if text.byteLength() == 0 'none'
		return ast.FormatSpec.absent()
	end 'none'
	return match consumes ast.parseFormatSpec(text) 'spec'
		some(s) gives s
		none panic("ir: the format specifier '{text}' was not read by the parser")
	end 'spec'
end 'formatSpecOf'

function binOpOfText(op String) returns BinOp
	return match op 'op'
		"+" gives BinOp.binAdd
		"-" gives BinOp.binSub
		"*" gives BinOp.binMul
		"/" gives BinOp.binDiv
		"mod" gives BinOp.binMod
		"and" gives BinOp.binAnd
		"or" gives BinOp.binOr
		"xor" gives BinOp.binXor
		"shl" gives BinOp.binShl
		"shr" gives BinOp.binShr
		default panic("lower: unknown operator '{op}'")
	end 'op'
end 'binOpOfText'

function isCmpOpText(op String) returns bool
	return op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
end 'isCmpOpText'

function cmpOpOfText(op String) returns CmpOp
	return match op 'op'
		"==" gives CmpOp.cmpEq
		"!=" gives CmpOp.cmpNe
		"<" gives CmpOp.cmpLt
		"<=" gives CmpOp.cmpLe
		">" gives CmpOp.cmpGt
		">=" gives CmpOp.cmpGe
		default panic("lower: unknown comparison '{op}'")
	end 'op'
end 'cmpOpOfText'

function hasFail(fails Byte, flag Byte) returns bool
	return (fails and flag) != 0
end 'hasFail'

// visitBinaryExpr lowers an operator and the operators nested in its left operand, innermost first, so that a long chain
// takes no stack. The blocks of the 'and' and the 'or' of the chain are made outermost first, as lowering the left
// operand from within each of them would make them. An operator that is the left operand of the next ends as lowerExpr
// ends it, with the values it left in flight taken; its value is a scalar, so nothing else is left to settle.
function visitBinaryExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let mark = l.pending.count()
	var chain = ast.leftChain(p.modules[l.mi].tree, e: e)
	ast.trimFolded(p, typing: p.typings[l.mi], chain: chain)
	openOperator(l, p: p, e: e)
	for i in 0 upto chain.count() 'open'
		let nested = chain[i]
		openOperator(l, p: p, e: nested)
	end 'open'
	var node = ast.nextOperator(chain, e: e)
	var v = lowerExpr(l, p: p, e: ast.binaryExprL(p.modules[l.mi].tree, id: node))
	while node != e 'inner'
		v = lowerOperator(l, p: p, e: node, left: v)
		popPending(l, n: mark)
		if regKind(l, v: v) == IrKind.kindManaged 'managed'
			panic("lower: the operator at node {node} of module {l.module} has a managed value")
		end 'managed'
		node = ast.nextOperator(chain, e: e)
	end 'inner'
	return lowerOperator(l, p: p, e: e, left: v)
end 'visitBinaryExpr'

function isLogicalOperator(l Lowerer, p ast.Project, e ast.NodeID) returns bool
	let op = ast.binaryExprOp(p.modules[l.mi].tree, id: e)
	return (op == "and" or op == "or") and exprType(p, module: l.module, node: e) == p.builtins.boolTy
end 'isLogicalOperator'

// openOperator makes the slot and the blocks of an 'and' or an 'or'.
function openOperator(mutates l Lowerer, p ast.Project, e ast.NodeID)
	if isLogicalOperator(l, p: p, e: e) 'logical'
		let result = l.b.f.newSlot(IrKind.kindScalar)
		let rhs = l.b.newBlock()
		let join = l.b.newBlock()
		l.operators.push(OperatorFrame.make(result, rhs: rhs, join: join))
	end 'logical'
end 'openOperator'

// lowerOperator lowers an operator whose left operand has been lowered to the register left.
function lowerOperator(mutates l Lowerer, mutates p ast.Project, e ast.NodeID, left Reg) returns Reg
	let op = ast.binaryExprOp(p.modules[l.mi].tree, id: e)
	let right = ast.binaryExprR(p.modules[l.mi].tree, id: e)
	if isLogicalOperator(l, p: p, e: e) 'logical'
		let frame = try l.operators.pop() otherwise panic("lower: an 'and' or an 'or' has no blocks")
		emit(l, i: newStoreSlot(frame.result, src: left, borrow: false))
		if op == "and" 'and'
			l.b.terminate(l.cur, t: newBranch(left, ifTrue: frame.rhs, ifFalse: frame.join))
		end 'and' else 'or'
			l.b.terminate(l.cur, t: newBranch(left, ifTrue: frame.join, ifFalse: frame.rhs))
		end 'or'
		l.cur = frame.rhs
		pushScope(l, block: false)
		let rv = lowerExpr(l, p: p, e: right)
		emit(l, i: newStoreSlot(frame.result, src: rv, borrow: false))
		popScope(l, p: p)
		goTo(l, target: frame.join)
		return load(l, slot: frame.result)
	end 'logical'
	if op == "is" 'identity'
		var test = CmpOp.cmpEq
		if ast.binaryExprNegated(p.modules[l.mi].tree, id: e) 'negated'
			test = CmpOp.cmpNe
		end 'negated'
		let other = lowerExpr(l, p: p, e: right)
		return compare(l, op: test, a: left, b: other, unsigned: true)
	end 'identity'
	let arith = arithInfoAt(p, module: l.module, node: e)
	if arith.operand == p.builtins.stringTy 'string'
		let b = lowerExpr(l, p: p, e: right)
		let eq = runtime(l, symbol: Rt.rtStreq, kind: IrKind.kindScalar, args: argsOf2(left, b: b))
		if op == "!=" 'ne'
			return flip(l, boolean: eq)
		end 'ne'
		return eq
	end 'string'
	let c = lowerExpr(l, p: p, e: right)
	if ast.isFloatType(p.types, t: arith.operand) 'float'
		return floatOperator(l, p: p, e: e, op: op, left: left, right: c)
	end 'float'
	let unsigned = ast.isUnsignedInt(p.types, t: arith.operand)
	if isCmpOpText(op) 'cmp'
		return compare(l, op: cmpOpOfText(op), a: left, b: c, unsigned: unsigned)
	end 'cmp'
	let d = newReg(l, kind: IrKind.kindScalar)
	let binOp = binOpOfText(op)
	let fails = arith.fails
	if hasFail(fails, flag: ast.failDivZero) 'zero'
		let fail = failure(l, p: p, errorCase: ast.errorDivisionByZero, err: noReg, errDrop: ast.noType)
		emit(l, i: newGuard(c, kind: GuardKind.guardNonZero, bound: 0 as Word, fail: fail))
	end 'zero'
	if hasFail(fails, flag: ast.failShift) 'shift'
		let fail = failure(l, p: p, errorCase: ast.errorNegativeShift, err: noReg, errDrop: ast.noType)
		emit(l, i: newGuard(c, kind: GuardKind.guardNonNegative, bound: 0 as Word, fail: fail))
	end 'shift'
	let overflow = overflowTo(l, p: p, fails: fails)
	var wordFail = noBlock
	if hasFail(fails, flag: ast.failOverflow) 'wordFail'
		wordFail = overflow
	end 'wordFail'
	emit(l, i: newBin(d, op: binOp, left: left, right: c, unsigned: unsigned, fail: wordFail))
	let ty = exprType(p, module: l.module, node: e)
	if p.types.entries[ty as Count].kind == ast.TypeKind.intRange 'range'
		rangeCheck(l, p: p, v: d, t: ty, unsigned: unsigned, fails: fails, fail: overflow)
	end 'range'
	return d
end 'lowerOperator'

// overflowTo is where an operation that can fail as fails says goes when its result does not fit, or noBlock when it
// always fits.
function overflowTo(mutates l Lowerer, p ast.Project, fails Byte) returns BlockID
	if (fails and (ast.failOverflow or ast.failBelow or ast.failAbove)) == 0 'fits'
		return noBlock
	end 'fits'
	return failure(l, p: p, errorCase: ast.errorOverflow, err: noReg, errDrop: ast.noType)
end 'overflowTo'

function flip(mutates l Lowerer, boolean Reg) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	let one = konst(l, value: 1 as Word)
	emit(l, i: newBin(d, op: BinOp.binXor, left: boolean, right: one, unsigned: false, fail: noBlock))
	return d
end 'flip'

function visitUnaryExpr(mutates l Lowerer, mutates p ast.Project, e ast.NodeID) returns Reg
	let op = ast.unaryExprOp(p.modules[l.mi].tree, id: e)
	let v = lowerExpr(l, p: p, e: ast.unaryExprE(p.modules[l.mi].tree, id: e))
	let ty = exprType(p, module: l.module, node: e)
	if op == "not" and ty == p.builtins.boolTy 'boolean'
		return flip(l, boolean: v)
	end 'boolean'
	if ast.isFloatType(p.types, t: ty) 'float'
		return floatNegation(l, v: v)
	end 'float'
	let fails = arithInfoAt(p, module: l.module, node: e).fails
	let overflow = overflowTo(l, p: p, fails: fails)
	let d = newReg(l, kind: IrKind.kindScalar)
	if op == "not" 'not'
		emit(l, i: newNot(d, src: v))
	end 'not' else 'neg'
		var wordFail = noBlock
		if hasFail(fails, flag: ast.failOverflow) 'wordFail'
			wordFail = overflow
		end 'wordFail'
		emit(l, i: newNeg(d, src: v, fail: wordFail))
	end 'neg'
	requireInt(p, t: ty)
	rangeCheck(l, p: p, v: d, t: ty, unsigned: op == "not" and ast.isUnsignedInt(p.types, t: ty), fails: fails, fail: overflow)
	return d
end 'visitUnaryExpr'

// rangeCheck checks that a result computed in a word, unsigned or signed, is in its type's range, where fails says it may
// not be. The word is the operands', which the type of the result need not share.
function rangeCheck(mutates l Lowerer, p ast.Project, v Reg, t ast.TypeID, unsigned bool, fails Byte, fail BlockID)
	if unsigned 'unsigned'
		fit(l, p: p, v: v, target: t, source: p.builtins.anonU64Ty, fails: fails, fail: fail)
	end 'unsigned' else 'signed'
		fit(l, p: p, v: v, target: t, source: p.builtins.anon64Ty, fails: fails, fail: fail)
	end 'signed'
end 'rangeCheck'

// fit checks that a value of the type source is in the range of target, which goes to fail when it is not. It checks only
// the bounds that fails says the value may be past, below or above: the range analysis proved the others.
function fit(mutates l Lowerer, p ast.Project, v Reg, target ast.TypeID, source ast.TypeID, fails Byte, fail BlockID)
	if p.types.entries[source as Count].kind == ast.TypeKind.constInt 'constant'
		return
	end 'constant'
	requireInt(p, t: source)
	let tMin = p.types.entries[target as Count].minVal.clone()
	let tMax = p.types.entries[target as Count].maxVal.clone()
	let sMin = p.types.entries[source as Count].minVal.clone()
	let sMax = p.types.entries[source as Count].maxVal.clone()
	let targetUnsigned = ast.isUnsignedInt(p.types, t: target)
	let sourceUnsigned = ast.isUnsignedInt(p.types, t: source)
	if tMin.le(sMin) and tMax.ge(sMax) and targetUnsigned == sourceUnsigned 'covers'
		return
	end 'covers'
	let below = hasFail(fails, flag: ast.failBelow)
	let above = hasFail(fails, flag: ast.failAbove)
	if targetUnsigned 'toUnsigned'
		if below and not sourceUnsigned and sMin.isNeg() 'negative'
			emit(l, i: newGuard(v, kind: GuardKind.guardNonNegative, bound: 0 as Word, fail: fail))
		end 'negative'
		if below and tMin.gt(ast.maxI128(sMin, b: ast.I128.zero())) 'atLeast'
			emit(l, i: newGuard(v, kind: GuardKind.guardUnsignedAtLeast, bound: wordOf(tMin), fail: fail))
		end 'atLeast'
		if above and tMax.lt(sMax) 'atMost'
			emit(l, i: newGuard(v, kind: GuardKind.guardUnsignedAtMost, bound: wordOf(tMax), fail: fail))
		end 'atMost'
		return
	end 'toUnsigned'
	var srcMax = sMax.clone()
	if sourceUnsigned and sMax.gt(ast.I128.i64Max()) 'wide'
		// A value past i64.max reads as negative in a signed word.
		if above 'aboveWord'
			emit(l, i: newGuard(v, kind: GuardKind.guardNonNegative, bound: 0 as Word, fail: fail))
		end 'aboveWord'
		srcMax = ast.I128.i64Max()
	end 'wide'
	if below and tMin.gt(sMin) 'low'
		emit(l, i: newGuard(v, kind: GuardKind.guardSignedAtLeast, bound: wordOf(tMin), fail: fail))
	end 'low'
	if above and tMax.lt(srcMax) 'high'
		emit(l, i: newGuard(v, kind: GuardKind.guardSignedAtMost, bound: wordOf(tMax), fail: fail))
	end 'high'
end 'fit'
