// noSlot is the owner slot of a value that no slot owns.
export let noSlot = -1 as Index

export let noTag = -1 as Index

// succ is the count after n.
export function succ(n Count) returns Count
	return try n + 1 otherwise panic("ir: a count overflows")
end 'succ'

// pred is the count before n, which is not 0.
export function pred(n Count) returns Count
	return try n - 1 otherwise panic("ir: a count below 0")
end 'pred'

// slotIndex is the place of an owner slot, which is one.
export function slotIndex(slot Index) returns Count
	return try slot as Count otherwise panic("ir: a value that has no slot is read from one")
end 'slotIndex'

// ExprRef is an expression and the module whose tree it is in, for the few that are in another one than the code
// around them: a constant's value and the default of a field.
export type ExprRef
	export var module as diag.ModuleID
	export var node as ast.NodeID

	export static function make(module diag.ModuleID, node ast.NodeID) returns ExprRef
		return ExprRef{module: module, node: node}
	end 'make'
end 'ExprRef'

export typealias ExprRefList = Array with ExprRef

// JumpFrame is a loop or a match that is being lowered: where a break and a continue of it go. They nest, so a break finds
// its own from the top.
export type JumpFrame
	export var node as ast.NodeID
	export var brk as BlockID
	export var cont as BlockID
	// depth is the number of scopes open where the loop or match starts: a jump to it leaves the ones above.
	export var depth as Count

	export static function make(node ast.NodeID, brk BlockID, cont BlockID, depth Count) returns JumpFrame
		return JumpFrame{node: node, brk: brk, cont: cont, depth: depth}
	end 'make'
end 'JumpFrame'

export typealias JumpFrameList = Array with JumpFrame

// OwnerSlot is the slot that owns a consumes parameter: the caller gives the value away, so the callee holds it in a slot
// of its own, which moving from it empties and the end of the function drops.
export type OwnerSlot
	export var local as ast.LocalID
	export var slot as Count

	export static function make(local ast.LocalID, slot Count) returns OwnerSlot
		return OwnerSlot{local: local, slot: slot}
	end 'make'
end 'OwnerSlot'

export typealias OwnerSlotList = Array with OwnerSlot

// PendingDrop is a value to drop when its scope ends: what a slot holds, or a register.
export type PendingDrop
	export var inSlot as bool
	export var slot as Count
	export var reg as Reg
	export var ty as ast.TypeID

	export static function ofSlot(slot Count, ty ast.TypeID) returns PendingDrop
		return PendingDrop{inSlot: true, slot: slot, reg: noReg, ty: ty}
	end 'ofSlot'

	export static function ofReg(reg Reg, ty ast.TypeID) returns PendingDrop
		return PendingDrop{inSlot: false, slot: 0 as Count, reg: reg, ty: ty}
	end 'ofReg'
end 'PendingDrop'

export typealias PendingList = Array with PendingDrop

// OperatorFrame is the slot that an 'and' or an 'or' keeps its value in, and the blocks of its right operand and of
// what follows it.
export type OperatorFrame
	export var result as Count
	export var rhs as BlockID
	export var join as BlockID

	export static function make(result Count, rhs BlockID, join BlockID) returns OperatorFrame
		return OperatorFrame{result: result, rhs: rhs, join: join}
	end 'make'
end 'OperatorFrame'

export typealias OperatorFrameList = Array with OperatorFrame

// Scope is where owned values die. The scope of a block holds the locals declared in it, and the scope of a statement, or
// of one branch of a conditional, holds the temporaries it made: values that nothing took ownership of, such as the
// result of a call whose value is only borrowed. Leaving a scope drops what it holds, newest first. A jump that leaves
// several scopes drops all of them.
//
// Which values are temporaries, and which places are moved out of, is not decided here: the ownership pass marks each
// expression whose value changes owner (ast.Typing.consumed), and lowering reads that mark.
export type Scope
	export var block as bool
	export var drops as PendingList
	// drains is whether the scope is a walk of a drain (pushDrainScope), which walk is then.
	export var drains as bool
	export var walk as DrainWalk

	export static function make(block bool) returns Scope
		return Scope{block: block, drops: PendingList.create(0), drains: false, walk: DrainWalk.make(ArrayBox.make(diag.Site.make(diag.stdlibID, offset: 0), ty: ast.noType), slot: 0 as Count, drop: ElementDrop.make(Holding.heldWord, walks: false, drops: false, ty: ast.noType))}
	end 'make'
end 'Scope'

// DrainWalk is a walk of a drain: the array, of the type box names, that slot holds, and how an element of it is dropped.
export type DrainWalk
	export var box as ArrayBox
	export var slot as Count
	export var drop as ElementDrop

	export static function make(consumes box ArrayBox, slot Count, consumes drop ElementDrop) returns DrainWalk
		return DrainWalk{box: box, slot: slot, drop: drop}
	end 'make'
end 'DrainWalk'

export typealias ScopeList = Array with Scope

// TryHandler is a try being lowered: where the failures of what it covers go. A failure leaves the scopes and the values
// in flight that the try did not start with, as a jump out of them would, and jumps to the handler, or for a try that
// passes its failures on returns the error.
export type TryHandler
	export var propagates as bool
	export var target as BlockID
	// depth is how many scopes were open where the try began, and mark how many drops the innermost of them held then.
	export var depth as Count
	export var mark as Count
	// pending is how many values were in flight where the try began.
	export var pending as Count
	// binding is the slot of the error that the handler names, or noSlot.
	export var binding as Index

	export static function make(propagates bool, target BlockID, depth Count, mark Count, pending Count, binding Index) returns TryHandler
		return TryHandler{propagates: propagates, target: target, depth: depth, mark: mark, pending: pending, binding: binding}
	end 'make'
end 'TryHandler'

export typealias HandlerList = Array with TryHandler

// ArrayBox is the runtime of one array type, which every operation on an array goes through: the array entries, whose box
// holds a word to an element, or for an array that packs bytes the bytes entries, whose box holds one byte to an element.
// site is the source of the operation.
export type ArrayBox
	export var site as diag.Site
	export var ty as ast.TypeID

	export static function make(consumes site diag.Site, ty ast.TypeID) returns ArrayBox
		return ArrayBox{site: site, ty: ty}
	end 'make'
end 'ArrayBox'

// WriteBack is an element of a byte array that a call takes by address, through a slot that holds it: the slot is written
// back to the element when the call returns. The element is at index of arr, or, where at is a register, the byte at that
// address, a place of a byte-sized type that a call lent (lentInByte).
export type WriteBack
	export var box as ArrayBox
	export var arr as Reg
	export var index as Reg
	export var at as Reg
	export var slot as Count
	// reloads is whether the slot is given the element again instead, the variable of a parallel for that is lent its element
	// (parallelElementPlace), whose element the call took by address and may have replaced.
	export var reloads as bool

	export static function make(consumes box ArrayBox, arr Reg, index Reg, slot Count) returns WriteBack
		return WriteBack{box: box, arr: arr, index: index, at: noReg, slot: slot, reloads: false}
	end 'make'

	export static function makeAt(consumes box ArrayBox, at Reg, slot Count) returns WriteBack
		return WriteBack{box: box, arr: noReg, index: noReg, at: at, slot: slot, reloads: false}
	end 'makeAt'

	export static function makeReload(consumes box ArrayBox, arr Reg, index Reg, slot Count) returns WriteBack
		return WriteBack{box: box, arr: arr, index: index, at: noReg, slot: slot, reloads: true}
	end 'makeReload'
end 'WriteBack'

export typealias WriteBackList = Array with WriteBack

// SlotLoop is a for over an array whose variable names the slot of each element in turn: the local of the variable, the
// slots that hold the array and the index, and the array's box, through which a take of a promise out of the variable
// empties the element's slot (takeFromSlot).
export type SlotLoop
	export var local as ast.LocalID
	export var held as Count
	export var index as Count
	export var box as ArrayBox

	export static function make(local ast.LocalID, held Count, index Count, consumes box ArrayBox) returns SlotLoop
		return SlotLoop{local: local, held: held, index: index, box: box}
	end 'make'
end 'SlotLoop'

export typealias SlotLoopList = Array with SlotLoop

// ChunkState is what the lowering of a parallel loop's chunk keeps (parallel.maxon): whether the function being lowered is a
// chunk; for each parameter of the function around the loop that the body reads, the chunk's slot that holds it, or noSlot;
// and the slot that holds the error a failure in the body gives, with the type that drops it (noType for a word) and its
// bias, or noSlot while nothing in the body can fail.
export type ChunkState
	export var active as bool
	export var paramSlots as Array with Index
	export var errorSlot as Index
	export var errorDrop as ast.TypeID
	export var errorBias as Word

	export static function none() returns ChunkState
		return ChunkState{active: false, paramSlots: Array.create(0), errorSlot: noSlot, errorDrop: ast.noType, errorBias: 0}
	end 'none'
end 'ChunkState'

// Lowerer lowers one function at a time into the IR a builder makes. It reads what the check pass found out about every
// module's bodies: a body that lowering reaches may be another module's (an instance of its generic, a constant, a
// field's default), so a node is looked up in the typing of the module it is in, which module names.
export type Lowerer
	// module is the module of the nodes being lowered, mi its index, and fnModule the module of the function, whose locals the
	// nodes name.
	export var module as diag.ModuleID
	export var mi as Count
	export var fnModule as diag.ModuleID
	export var fn as ast.FuncID
	// origin is the function whose declaration the body is: the function itself, or the generic that it is an instance of.
	export var origin as ast.FuncID
	export var b as Builder
	// instances are the ones the module needs, which every generic call in the body must be one of.
	export var instances as InstanceSet
	// bindParams and bindArgs give the type parameters of the function being lowered their arguments, when it is an
	// instance of a generic function. The body was checked once against the parameters, so every type it names is read
	// through them.
	export var bindParams as ast.TypeIDList
	export var bindArgs as ast.TypeIDList
	// bindWitnesses are the conformances the instance was given for the bounds of its type parameters.
	export var bindWitnesses as ast.WitnessList
	export var jumps as JumpFrameList
	export var cur as BlockID
	export var scopes as ScopeList
	// ownerSlots are the slots that hold the consumes parameters the body names.
	export var ownerSlots as OwnerSlotList
	// selfOwner is the slot that owns a consumes self, or noSlot.
	export var selfOwner as Index
	// lentElements is how many elements the tuple has that the function lends, whose frame area is its last parameter, or
	// 0 (ast.lentTupleElements).
	export var lentElements as Count
	// args holds the values of the arguments of the calls being lowered, the innermost call's last, so a call needs no
	// list of its own.
	export var args as RegList
	// handlers are the trys around the code being lowered, innermost last.
	export var handlers as HandlerList
	// pending are the values computed for something that takes them, which has not run yet: a failure before it runs
	// drops them, since nothing else would.
	export var pending as PendingList
	// operators are the frames of the 'and' and the 'or' of the chain of operators being lowered, the innermost last: a
	// chain is lowered with a loop, and each of its operators makes its blocks before the operators nested in its left
	// operand do.
	export var operators as OperatorFrameList
	// writeBacks are the elements of byte arrays that the calls being lowered take by address, each through a slot that
	// holds it until the call returns.
	export var writeBacks as WriteBackList
	// slotLoops are the fors around the code being lowered whose variable names an element's slot, innermost last.
	export var slotLoops as SlotLoopList
	// parallelSlots are the parallel fors over arrays around the code being lowered, innermost last: an assignment to the
	// variable of one stores into the element it is lent.
	export var parallelSlots as SlotLoopList
	// slotWords are, for each slot of a local that holds a value held in place, how many words it takes, and 0 for any other
	// slot; slotAreas the first frame box of each such slot's frame area, or noArea before its first store.
	export var slotWords as Array with Count
	export var slotAreas as Array with Index
	// resultWords is how many words the result of the function takes where it writes it to the area its caller passes as its
	// last parameter, and 0 otherwise (resultWords).
	export var resultWords as Count
	// chunk is the state of the lowering of a parallel loop's chunk, inactive for any other function.
	export var chunk as ChunkState

	export static function new(consumes instances InstanceSet) returns Lowerer
		return Lowerer{module: 0 as diag.ModuleID, mi: 0 as Count, fnModule: 0 as diag.ModuleID, fn: ast.noFunc, origin: ast.noFunc, b: Builder.new(), instances: instances, bindParams: ast.TypeIDList.create(0), bindArgs: ast.TypeIDList.create(0), bindWitnesses: ast.WitnessList.create(0), jumps: JumpFrameList.create(0), cur: 0 as BlockID, scopes: ScopeList.create(0), ownerSlots: OwnerSlotList.create(0), selfOwner: noSlot, lentElements: 0, args: RegList.create(0), handlers: HandlerList.create(0), pending: PendingList.create(0), operators: OperatorFrameList.create(0), writeBacks: WriteBackList.create(0), slotLoops: SlotLoopList.create(0), parallelSlots: SlotLoopList.create(0), slotWords: Array.create(0), slotAreas: Array.create(0), resultWords: 0, chunk: ChunkState.none()}
	end 'new'
end 'Lowerer'

// setModule makes the nodes being lowered those of a module.
function setModule(mutates l Lowerer, m diag.ModuleID)
	l.module = m
	l.mi = ast.modIndex(m)
end 'setModule'

// popPending forgets the values in flight past the first n.
function popPending(mutates l Lowerer, n Count)
	while l.pending.count() > n 'pop'
		_ = l.pending.pop()
	end 'pop'
end 'popPending'

// popArgs forgets the arguments of the calls being lowered past the first n.
function popArgs(mutates l Lowerer, n Count)
	while l.args.count() > n 'pop'
		_ = l.args.pop()
	end 'pop'
end 'popArgs'

// slotKind is the kind of a slot of the function being lowered.
function slotKind(l Lowerer, slot Count) returns IrKind
	return l.b.f.slots[slot]
end 'slotKind'

// regKind is the kind of a register of the function being lowered.
function regKind(l Lowerer, v Reg) returns IrKind
	return l.b.f.regs[try v as Count otherwise panic("ir: a register that does not exist is read")]
end 'regKind'

// kindOfType is the kind of a value of a type in a register: for a value held in place, its address, which drops nothing.
function kindOfType(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns IrKind
	// A vector of the runtime's source is one register of its own kind, and only a local holds one.
	if ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.builtinVector128 'vector'
		return IrKind.kindVector
	end 'vector'
	return match heldAs(p, ms: ms, t: t) 'holding'
		heldWord gives IrKind.kindScalar
		heldString gives IrKind.kindString
		heldBox gives IrKind.kindManaged
		heldAddress(_) gives IrKind.kindScalar
		heldInline(_) gives panic("ir: a variable that holds words of its own or a byte of a buffer")
		heldPacked gives panic("ir: a variable that holds words of its own or a byte of a buffer")
	end 'holding'
end 'kindOfType'

// applyType is a type of the body with the type parameters of the function replaced by their arguments.
function applyType(l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns ast.TypeID
	return ast.substituteType(ms.types, reads: p.types, t: t, params: l.bindParams, args: l.bindArgs)
end 'applyType'

// kindOf is the kind of a value of a type the body names, which may be a type parameter of the function.
function kindOf(l Lowerer, p ast.Project, mutates ms ast.ModuleState, t ast.TypeID) returns IrKind
	let applied = applyType(l, p: p, ms: ms, t: t)
	return kindOfType(p, ms: ms, t: applied)
end 'kindOf'

// emit adds an instruction to the block being lowered. A store that gives a local held in place a value copies its words to
// the local's frame area (storeLocal), which is the one way every lowering gives a local a value.
export function emit(mutates l Lowerer, consumes i Instr)
	if i.op == Opcode.opStoreSlot and not storeSlotBorrow(i) 'store'
		let slot = storeSlotSlot(i)
		if slot < l.slotWords.count() and l.slotWords[slot] > 0 'inPlace'
			let words = l.slotWords[slot]
			storeLocal(l, slot: slot, words: words, v: storeSlotSrc(i))
			return
		end 'inPlace'
	end 'store'
	let block = l.cur
	l.b.emit(block, i: i)
end 'emit'

// push adds the value of an argument to the call being lowered. The value is computed before the push, because computing
// it can push too, and the stack may move.
function pushArg(mutates l Lowerer, v Reg)
	l.args.push(v)
end 'pushArg'

export function seal(mutates l Lowerer, consumes t Term)
	let block = l.cur
	if not l.b.terminated(block) 'open'
		l.b.terminate(block, t: t)
	end 'open'
	l.cur = l.b.newBlock()
end 'seal'

export function goTo(mutates l Lowerer, target BlockID)
	let block = l.cur
	if not l.b.terminated(block) 'open'
		l.b.terminate(block, t: newJump(target))
	end 'open'
	l.cur = target
end 'goTo'

export function newReg(mutates l Lowerer, kind IrKind) returns Reg
	return l.b.f.newReg(kind)
end 'newReg'

// stringParts is the address of the bytes and the word of a String, which the runtime's entries of arrays of strings take.
function stringParts(mutates l Lowerer, text Reg) returns RegList
	let bytes = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newStrPtr(bytes, src: text))
	let word = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newStrWord(word, src: text))
	return argsOf2(bytes, b: word)
end 'stringParts'

export function konst(mutates l Lowerer, value Word) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newConst(d, value: value))
	return d
end 'konst'

export function strReg(mutates l Lowerer, value String) returns Reg
	let d = newReg(l, kind: IrKind.kindString)
	emitStr(l, d: d, text: value.clone())
	return d
end 'strReg'

export function paramReg(mutates l Lowerer, index Count, kind IrKind) returns Reg
	if l.chunk.active 'chunk'
		return chunkParam(l, index: index, kind: kind)
	end 'chunk'
	let d = newReg(l, kind: kind)
	emit(l, i: newLoadParam(d, param: index))
	return d
end 'paramReg'

export function load(mutates l Lowerer, slot Count) returns Reg
	let d = newReg(l, kind: slotKind(l, slot: slot))
	emit(l, i: newLoadSlot(d, slot: slot))
	return d
end 'load'

export function compare(mutates l Lowerer, op CmpOp, a Reg, b Reg, unsigned bool) returns Reg
	let d = newReg(l, kind: IrKind.kindScalar)
	emit(l, i: newCmp(d, op: op, left: a, right: b, unsigned: unsigned))
	return d
end 'compare'

// runtime calls a runtime entry of the runtime unit and gives its value.
// resultKind is the kind of what a call of a runtime entry gives: a String's whatever the caller asks, since a String is
// two words and the entry's own signature says it gives one.
function resultKind(symbol Rt, kind IrKind) returns IrKind
	if rtGivesString(symbol) 'string'
		return IrKind.kindString
	end 'string'
	return kind
end 'resultKind'

function runtime(mutates l Lowerer, symbol Rt, kind IrKind, args RegList) returns Reg
	let d = newReg(l, kind: resultKind(symbol, kind: kind))
	emitCallRuntime(l, dst: d, symbol: symbol, args: args, routine: ast.noFunc)
	return d
end 'runtime'

export function argsOf1(a Reg) returns RegList
	var xs = RegList.create(0)
	xs.push(a)
	return xs
end 'argsOf1'

export function argsOf2(a Reg, b Reg) returns RegList
	var xs = RegList.create(0)
	xs.push(a)
	xs.push(b)
	return xs
end 'argsOf2'

function argsOf3(a Reg, b Reg, c Reg) returns RegList
	var xs = RegList.create(0)
	xs.push(a)
	xs.push(b)
	xs.push(c)
	return xs
end 'argsOf3'

let i64MaxCount = 9223372036854775807 as Count

let i64MinWord = -9223372036854775808 as Word

// wordOf is the number a 128-bit constant is, as a word: the low 64 bits, read as a signed number.
function wordOf(v ast.I128) returns Word
	if v.lo <= i64MaxCount 'low'
		return v.lo as Word
	end 'low'
	let masked = (v.lo and i64MaxCount) as Word
	return masked + i64MinWord
end 'wordOf'

// wordOffset is the size of that many words.
export function wordOffset(words Count) returns Count
	return try wordBytes * words otherwise panic("ir: a box has more words than an offset can reach")
end 'wordOffset'

function emitStr(mutates l Lowerer, d Reg, consumes text String)
	let instr = l.b.str(d, text: text)
	emit(l, i: instr)
end 'emitStr'

// emitCall calls the function target, by the float signature of its declaration, which the function's own is.
export function emitCall(mutates l Lowerer, p ast.Project, ms ast.ModuleState, dst Reg, target ast.FuncID, args RegList)
	emitThrowingCall(l, p: p, ms: ms, dst: dst, target: target, args: args, err: noReg)
end 'emitCall'

// emitThrowingCall calls the function target, which throws into err unless that is noReg. A function that lends a tuple is
// given a frame area of the call's own after the arguments, which it fills and returns (ast.lentTupleElements).
function emitThrowingCall(mutates l Lowerer, p ast.Project, ms ast.ModuleState, dst Reg, target ast.FuncID, args RegList, err Reg)
	let elements = ast.lentTupleElements(ms.types, reads: p.types, f: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target))
	if elements > 0 'lentTuple'
		var all = args.clone()
		all.push(frameArea(l, elements: elements))
		let lending = l.b.throwingCall(dst, target: target, args: all, err: err, sig: funcSignature(p, ms: ms, fid: target))
		emit(l, i: lending)
		return
	end 'lentTuple'
	let words = resultWords(ms.types, reads: p.types, b: p.builtins, f: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: target))
	if words > 0 'inPlace'
		var given = args.clone()
		given.push(newArea(l, words: words))
		let writing = l.b.throwingCall(dst, target: target, args: given, err: err, sig: funcSignature(p, ms: ms, fid: target))
		emit(l, i: writing)
		return
	end 'inPlace'
	let instr = l.b.throwingCall(dst, target: target, args: args, err: err, sig: funcSignature(p, ms: ms, fid: target))
	emit(l, i: instr)
end 'emitThrowingCall'

// frameArea is a new frame area of a lent tuple of that many elements, room for a String's two words each, the most an
// element takes of the tuple's box.
function frameArea(mutates l Lowerer, elements Count) returns Reg
	let area = newReg(l, kind: IrKind.kindManaged)
	let instr = l.b.frameArea(area, words: try elements * (stringValueBytes / wordBytes) otherwise panic("ir: a frame area past memory"))
	emit(l, i: instr)
	return area
end 'frameArea'

export function emitCallRuntime(mutates l Lowerer, dst Reg, symbol Rt, args RegList, routine ast.FuncID)
	let instr = l.b.callRuntime(dst, symbol: symbol, args: args, routine: routine, proven: false)
	emit(l, i: instr)
end 'emitCallRuntime'

function emitWhen(mutates l Lowerer, behaviour Count, cowns RegList, captures RegList)
	let instr = l.b.whenInstr(behaviour, cowns: cowns, captures: captures)
	emit(l, i: instr)
end 'emitWhen'

function emitDropReg(mutates l Lowerer, src Reg, ty ast.TypeID)
	let instr = l.b.drop(src, ty: ty)
	emit(l, i: instr)
end 'emitDropReg'

export function emitDropSlot(mutates l Lowerer, slot Count, ty ast.TypeID)
	let instr = l.b.dropSlot(slot, ty: ty)
	emit(l, i: instr)
end 'emitDropSlot'

function emitDropAt(mutates l Lowerer, addr Reg, ty ast.TypeID)
	let instr = l.b.dropAt(addr, ty: ty)
	emit(l, i: instr)
end 'emitDropAt'

function emitCopy(mutates l Lowerer, dst Reg, src Reg, ty ast.TypeID)
	let instr = l.b.copy(dst, src: src, ty: ty)
	emit(l, i: instr)
end 'emitCopy'
