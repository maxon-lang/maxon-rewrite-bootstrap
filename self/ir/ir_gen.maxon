// Instr is one instruction, a record of fixed fields whose meaning its opcode says; what does not fit in it is in
// the pools of its function, which c and a range of a and b index.
export type Instr
	export var op as Opcode
	export var dst as Reg
	export var a as Reg
	export var b as Reg
	export var c as Index
	export var imm as Word
	export var sub as Byte
	export var flags as Byte

	export static function make(op Opcode) returns Instr
		return Instr{op: op, dst: 0 as Reg, a: 0 as Reg, b: 0 as Reg, c: 0 as Index, imm: 0 as Word, sub: 0 as Byte, flags: 0 as Byte}
	end 'make'
end 'Instr'

export typealias InstrList = Array with Instr

// Term is how a block ends, a record of fixed fields like an instruction.
export type Term
	export var kind as TermKind
	export var value as Reg
	export var target as BlockID
	export var other as BlockID
	export var first as Index
	export var count as Index
	export var args as Index
	export var targetArgs as Index
	export var otherArgs as Index

	export static function make(kind TermKind) returns Term
		return Term{kind: kind, value: 0 as Reg, target: 0 as BlockID, other: 0 as BlockID, first: 0 as Index, count: 0 as Index, args: 0 as Index, targetArgs: 0 as Index, otherArgs: 0 as Index}
	end 'make'
end 'Term'

export typealias TermList = Array with Term

// Const gives a number.
export function newConst(dst Reg, value Word) returns Instr
	var r = Instr.make(Opcode.opConst)
	r.dst = dst
	r.imm = value
	return r
end 'newConst'

// Str gives a string literal.
export function newStr(dst Reg, text Index) returns Instr
	var r = Instr.make(Opcode.opStr)
	r.dst = dst
	r.c = text
	return r
end 'newStr'

// LoadSlot reads a slot.
export function newLoadSlot(dst Reg, slot Count) returns Instr
	var r = Instr.make(Opcode.opLoadSlot)
	r.dst = dst
	r.imm = try slot as Word otherwise panic("ir: loadSlot slot is out of range")
	return r
end 'newLoadSlot'

// StoreSlot puts a value in a slot, which owns it unless Borrow is set.
export function newStoreSlot(slot Count, src Reg, borrow bool) returns Instr
	var r = Instr.make(Opcode.opStoreSlot)
	r.imm = try slot as Word otherwise panic("ir: storeSlot slot is out of range")
	r.a = src
	if borrow 'borrow'
		r.flags = r.flags or flagBorrow
	end 'borrow'
	return r
end 'newStoreSlot'

// SlotAddr gives the address of a slot.
export function newSlotAddr(dst Reg, slot Count) returns Instr
	var r = Instr.make(Opcode.opSlotAddr)
	r.dst = dst
	r.imm = try slot as Word otherwise panic("ir: slotAddr slot is out of range")
	return r
end 'newSlotAddr'

// LoadParam reads a parameter.
export function newLoadParam(dst Reg, param Count) returns Instr
	var r = Instr.make(Opcode.opLoadParam)
	r.dst = dst
	r.imm = try param as Word otherwise panic("ir: loadParam param is out of range")
	return r
end 'newLoadParam'

// LoadField reads the word at Obj + Offset.
export function newLoadField(dst Reg, obj Reg, offset Count) returns Instr
	var r = Instr.make(Opcode.opLoadField)
	r.dst = dst
	r.a = obj
	r.imm = try offset as Word otherwise panic("ir: loadField offset is out of range")
	return r
end 'newLoadField'

// StoreField writes Src to the word at Obj + Offset.
export function newStoreField(obj Reg, offset Count, src Reg) returns Instr
	var r = Instr.make(Opcode.opStoreField)
	r.a = obj
	r.imm = try offset as Word otherwise panic("ir: storeField offset is out of range")
	r.b = src
	return r
end 'newStoreField'

// FieldAddr gives Obj + Offset.
export function newFieldAddr(dst Reg, obj Reg, offset Count) returns Instr
	var r = Instr.make(Opcode.opFieldAddr)
	r.dst = dst
	r.a = obj
	r.imm = try offset as Word otherwise panic("ir: fieldAddr offset is out of range")
	return r
end 'newFieldAddr'

// LoadAt reads the word at an address.
export function newLoadAt(dst Reg, addr Reg) returns Instr
	var r = Instr.make(Opcode.opLoadAt)
	r.dst = dst
	r.a = addr
	return r
end 'newLoadAt'

// StoreAt writes Src to the word at an address.
export function newStoreAt(addr Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opStoreAt)
	r.a = addr
	r.b = src
	return r
end 'newStoreAt'

// LoadGlobal reads a global of the runtime.
export function newLoadGlobal(dst Reg, symbol Rt) returns Instr
	var r = Instr.make(Opcode.opLoadGlobal)
	r.dst = dst
	r.imm = try rtCode(symbol) as Word otherwise panic("ir: loadGlobal symbol is out of range")
	return r
end 'newLoadGlobal'

// LoadRaw reads Width bits at an address, zero-extended to the word.
export function newLoadRaw(dst Reg, addr Reg, width RawWidth) returns Instr
	var r = Instr.make(Opcode.opLoadRaw)
	r.dst = dst
	r.a = addr
	r.sub = rawWidthCode(width)
	return r
end 'newLoadRaw'

// StoreRaw writes the low Width bits of Src at an address.
export function newStoreRaw(addr Reg, src Reg, width RawWidth) returns Instr
	var r = Instr.make(Opcode.opStoreRaw)
	r.a = addr
	r.b = src
	r.sub = rawWidthCode(width)
	return r
end 'newStoreRaw'

// GlobalAddr gives the address of a global of the runtime.
export function newGlobalAddr(dst Reg, symbol Rt) returns Instr
	var r = Instr.make(Opcode.opGlobalAddr)
	r.dst = dst
	r.imm = try rtCode(symbol) as Word otherwise panic("ir: globalAddr symbol is out of range")
	return r
end 'newGlobalAddr'

// CallImport calls the DLL import Name, a string of the function, with the words Args, by the
// Win64 convention, and gives what it returns.
export function newCallImport(dst Reg, name Index, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCallImport)
	r.dst = dst
	r.c = name
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCallImport'

// AtomicAdd adds Src to the word at an address as one indivisible step, a full fence, and gives the word it found.
export function newAtomicAdd(dst Reg, addr Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opAtomicAdd)
	r.dst = dst
	r.a = addr
	r.b = src
	return r
end 'newAtomicAdd'

// AtomicExchange puts Src in the word at an address as one indivisible step, a full fence, and gives the word it
// found.
export function newAtomicExchange(dst Reg, addr Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opAtomicExchange)
	r.dst = dst
	r.a = addr
	r.b = src
	return r
end 'newAtomicExchange'

// CompareExchange is given the address, the word expected and the word desired in Args: as one indivisible step,
// a full fence, it puts the desired word at the address when the expected one is there, and gives the word it found.
export function newCompareExchange(dst Reg, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCompareExchange)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCompareExchange'

// SpinPause tells the processor that the thread is waiting in a loop for another one.
export function newSpinPause() returns Instr
	var r = Instr.make(Opcode.opSpinPause)
	return r
end 'newSpinPause'

// ThreadContext gives the word the running thread keeps in the runtime's thread-local slot: its context.
export function newThreadContext(dst Reg) returns Instr
	var r = Instr.make(Opcode.opThreadContext)
	r.dst = dst
	return r
end 'newThreadContext'

// CallCode calls the code at the address that is the first of Args with the rest of Args, by the internal
// convention, and gives what it returns.
export function newCallCode(dst Reg, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCallCode)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCallCode'

// CodeAddress gives the address of the code of the function Callee, which a CallCode calls: the run of a
// behaviour's record that a test of the runtime builds by hand.
export function newCodeAddress(dst Reg, callee Index) returns Instr
	var r = Instr.make(Opcode.opCodeAddress)
	r.dst = dst
	r.c = callee
	return r
end 'newCodeAddress'

// Bin is Left Op Right; when Checked, it goes to Fail when the result does not fit, which for a
// signed '/' is i64.min / -1.
export function newBin(dst Reg, op BinOp, left Reg, right Reg, unsigned bool, fail BlockID) returns Instr
	var r = Instr.make(Opcode.opBin)
	r.dst = dst
	r.sub = binOpCode(op)
	r.a = left
	r.b = right
	if unsigned 'unsigned'
		r.flags = r.flags or flagUnsigned
	end 'unsigned'
	r.c = fail as Index
	if fail != noBlock 'fail'
		r.flags = r.flags or flagChecked
	end 'fail'
	return r
end 'newBin'

// Cmp gives 1 when Left Op Right holds and 0 when it does not.
export function newCmp(dst Reg, op CmpOp, left Reg, right Reg, unsigned bool) returns Instr
	var r = Instr.make(Opcode.opCmp)
	r.dst = dst
	r.sub = cmpOpCode(op)
	r.a = left
	r.b = right
	if unsigned 'unsigned'
		r.flags = r.flags or flagUnsigned
	end 'unsigned'
	return r
end 'newCmp'

// FBin is Left Op Right on two doubles, rounded to the nearest double, ties to even.
export function newFBin(dst Reg, op FBinOp, left Reg, right Reg) returns Instr
	var r = Instr.make(Opcode.opFBin)
	r.dst = dst
	r.sub = fBinOpCode(op)
	r.a = left
	r.b = right
	return r
end 'newFBin'

// FCmp gives 1 when Left Op Right holds of two doubles and 0 when it does not; every comparison with a
// NaN but ne does not hold.
export function newFCmp(dst Reg, op CmpOp, left Reg, right Reg) returns Instr
	var r = Instr.make(Opcode.opFCmp)
	r.dst = dst
	r.sub = cmpOpCode(op)
	r.a = left
	r.b = right
	return r
end 'newFCmp'

// FUnary is Op of a double.
export function newFUnary(dst Reg, op FUnaryOp, src Reg) returns Instr
	var r = Instr.make(Opcode.opFUnary)
	r.dst = dst
	r.sub = fUnaryOpCode(op)
	r.a = src
	return r
end 'newFUnary'

// IntToFloat is the double nearest the integer Src, read as unsigned when Unsigned is set.
export function newIntToFloat(dst Reg, src Reg, unsigned bool) returns Instr
	var r = Instr.make(Opcode.opIntToFloat)
	r.dst = dst
	r.a = src
	if unsigned 'unsigned'
		r.flags = r.flags or flagUnsigned
	end 'unsigned'
	return r
end 'newIntToFloat'

// FloatToInt is the double Src truncated toward zero, or i64.min for a NaN or a double past the word.
export function newFloatToInt(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opFloatToInt)
	r.dst = dst
	r.a = src
	return r
end 'newFloatToInt'

// Neg negates; when Checked, it goes to Fail for i64.min.
export function newNeg(dst Reg, src Reg, fail BlockID) returns Instr
	var r = Instr.make(Opcode.opNeg)
	r.dst = dst
	r.a = src
	r.c = fail as Index
	if fail != noBlock 'fail'
		r.flags = r.flags or flagChecked
	end 'fail'
	return r
end 'newNeg'

// Not inverts every bit.
export function newNot(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opNot)
	r.dst = dst
	r.a = src
	return r
end 'newNot'

// Guard goes to Fail unless Src is in the range Kind of Bound.
export function newGuard(src Reg, kind GuardKind, bound Word, fail BlockID) returns Instr
	var r = Instr.make(Opcode.opGuard)
	r.a = src
	r.sub = guardKindCode(kind)
	r.imm = bound
	r.c = fail as Index
	return r
end 'newGuard'

// Alloc gives a new box of Bytes bytes.
export function newAlloc(dst Reg, bytes Count) returns Instr
	var r = Instr.make(Opcode.opAlloc)
	r.dst = dst
	r.imm = try bytes as Word otherwise panic("ir: alloc bytes is out of range")
	return r
end 'newAlloc'

// Call applies Callee to Args.
export function newCall(dst Reg, callee Index, argsStart Reg, argsCount Reg, errReg Reg) returns Instr
	var r = Instr.make(Opcode.opCall)
	r.dst = dst
	r.c = callee
	r.a = argsStart
	r.b = argsCount
	if errReg != noReg 'errReg'
		r.flags = r.flags or flagThrows
		r.imm = errReg as Word
	end 'errReg'
	return r
end 'newCall'

// CallRuntime applies the runtime entry Symbol to Args; Routine is what the entry stores to call
// later (the destructor of a cown).
export function newCallRuntime(dst Reg, symbol Rt, argsStart Reg, argsCount Reg, routine Index) returns Instr
	var r = Instr.make(Opcode.opCallRuntime)
	r.dst = dst
	r.imm = try rtCode(symbol) as Word otherwise panic("ir: callRuntime symbol is out of range")
	r.a = argsStart
	r.b = argsCount
	r.c = routine
	return r
end 'newCallRuntime'

// When schedules the behaviour Body on the cowns Cowns, capturing Captures.
export function newWhen(body Count, cownsStart Reg, cownsCount Reg, capturesCount Index) returns Instr
	var r = Instr.make(Opcode.opWhen)
	r.imm = try body as Word otherwise panic("ir: when body is out of range")
	r.a = cownsStart
	r.b = cownsCount
	r.c = capturesCount
	return r
end 'newWhen'

// Closure gives a new closure of the body Body, holding Captures: it owns each capture that Body says it owns, and
// borrows the others.
export function newClosure(dst Reg, body Count, capturesStart Reg, capturesCount Reg) returns Instr
	var r = Instr.make(Opcode.opClosure)
	r.dst = dst
	r.imm = try body as Word otherwise panic("ir: closure body is out of range")
	r.a = capturesStart
	r.b = capturesCount
	return r
end 'newClosure'

// FuncValue gives a new closure of the function Callee, which captures nothing.
export function newFuncValue(dst Reg, callee Index) returns Instr
	var r = Instr.make(Opcode.opFuncValue)
	r.dst = dst
	r.c = callee
	return r
end 'newFuncValue'

// CallValue calls the closure that is the first of Args with all of Args: the code it holds takes the closure
// first, to read what it captured, and a named function's code ignores it.
export function newCallValue(dst Reg, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCallValue)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCallValue'

// Box gives a new interface value: a box on the heap of the address of the table Table and the value Value, which
// the box owns.
export function newBox(dst Reg, table Index, value Reg) returns Instr
	var r = Instr.make(Opcode.opBox)
	r.dst = dst
	r.c = table
	r.a = value
	return r
end 'newBox'

// FrameBox gives an interface value whose box is the function's frame box Box, two words of its frame, with the
// address of the table Table and the value Value: a value only lent to what borrows the interface value, or a scalar,
// which the box owns nothing of. The box lives as long as the frame, and a borrow cannot outlive the call it is lent to.
export function newFrameBox(dst Reg, table Index, value Reg, box Count) returns Instr
	var r = Instr.make(Opcode.opFrameBox)
	r.dst = dst
	r.c = table
	r.a = value
	r.imm = try box as Word otherwise panic("ir: frameBox box is out of range")
	return r
end 'newFrameBox'

// CallWitness calls the method in place Slot of the table of the interface value that is the first of Args, with
// the value the box holds, given as Recv says, and the rest of Args.
export function newCallWitness(dst Reg, recv ReceiverConv, slot Count, argsStart Reg, argsCount Reg, errReg Reg) returns Instr
	var r = Instr.make(Opcode.opCallWitness)
	r.dst = dst
	r.sub = receiverConvCode(recv)
	r.c = try slot as Index otherwise panic("ir: callWitness slot is out of range")
	r.a = argsStart
	r.b = argsCount
	if errReg != noReg 'errReg'
		r.flags = r.flags or flagThrows
		r.imm = errReg as Word
	end 'errReg'
	return r
end 'newCallWitness'

// IsType gives 1 when the interface value Src holds a value of the type Ty, and 0 when it holds one of another type.
export function newIsType(dst Reg, src Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opIsType)
	r.dst = dst
	r.a = src
	r.c = ty
	return r
end 'newIsType'

// Drop drops the value in Src, of type Ty.
export function newDrop(src Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opDrop)
	r.a = src
	r.c = ty
	return r
end 'newDrop'

// DropSlot drops what a slot owns, of type Ty, and leaves it empty.
export function newDropSlot(slot Count, ty Index) returns Instr
	var r = Instr.make(Opcode.opDropSlot)
	r.imm = try slot as Word otherwise panic("ir: dropSlot slot is out of range")
	r.c = ty
	return r
end 'newDropSlot'

// DropAt drops what an address holds, of type Ty, and leaves it empty.
export function newDropAt(addr Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opDropAt)
	r.a = addr
	r.c = ty
	return r
end 'newDropAt'

// MoveSlot reads a slot and leaves it empty.
export function newMoveSlot(dst Reg, slot Count) returns Instr
	var r = Instr.make(Opcode.opMoveSlot)
	r.dst = dst
	r.imm = try slot as Word otherwise panic("ir: moveSlot slot is out of range")
	return r
end 'newMoveSlot'

// MoveAt reads the value at an address and leaves the place empty.
export function newMoveAt(dst Reg, addr Reg) returns Instr
	var r = Instr.make(Opcode.opMoveAt)
	r.dst = dst
	r.a = addr
	return r
end 'newMoveAt'

// Copy gives a deep copy of Src, of type Ty.
export function newCopy(dst Reg, src Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opCopy)
	r.dst = dst
	r.a = src
	r.c = ty
	return r
end 'newCopy'

// Jump goes to Target, passing Args to its parameters. Its edges pass no arguments; newJumpWith takes them.
export function newJump(target BlockID) returns Term
	var r = Term.make(TermKind.termJump)
	r.target = target
	return r
end 'newJump'

// Jump goes to Target, passing Args to its parameters.
export function newJumpWith(target BlockID, argsStart Index, argsCount Index) returns Term
	var r = Term.make(TermKind.termJump)
	r.target = target
	r.args = argsStart
	r.targetArgs = argsCount
	return r
end 'newJumpWith'

// Branch goes to IfTrue, passing TrueArgs, when Cond is not 0, else to IfFalse, passing FalseArgs. Its edges pass no arguments; newBranchWith takes them.
export function newBranch(cond Reg, ifTrue BlockID, ifFalse BlockID) returns Term
	var r = Term.make(TermKind.termBranch)
	r.value = cond
	r.target = ifTrue
	r.other = ifFalse
	return r
end 'newBranch'

// Branch goes to IfTrue, passing TrueArgs, when Cond is not 0, else to IfFalse, passing FalseArgs.
export function newBranchWith(cond Reg, ifTrue BlockID, trueArgsStart Index, trueArgsCount Index, ifFalse BlockID, falseArgsCount Index) returns Term
	var r = Term.make(TermKind.termBranch)
	r.value = cond
	r.target = ifTrue
	r.args = trueArgsStart
	r.targetArgs = trueArgsCount
	r.other = ifFalse
	r.otherArgs = falseArgsCount
	return r
end 'newBranchWith'

// Switch goes to the target of the case that Value equals, passing the case's arguments, else to
// Fallback, passing FallbackArgs. Its edges pass no arguments; newSwitchWith takes them.
export function newSwitch(value Reg, casesFirst Index, casesCount Index, fallback BlockID) returns Term
	var r = Term.make(TermKind.termSwitch)
	r.value = value
	r.first = casesFirst
	r.count = casesCount
	r.target = fallback
	return r
end 'newSwitch'

// Switch goes to the target of the case that Value equals, passing the case's arguments, else to
// Fallback, passing FallbackArgs.
export function newSwitchWith(value Reg, casesFirst Index, casesCount Index, fallback BlockID, fallbackArgsStart Index, fallbackArgsCount Index) returns Term
	var r = Term.make(TermKind.termSwitch)
	r.value = value
	r.first = casesFirst
	r.count = casesCount
	r.target = fallback
	r.args = fallbackArgsStart
	r.targetArgs = fallbackArgsCount
	return r
end 'newSwitchWith'

// Ret returns Value.
export function newRet(value Reg) returns Term
	var r = Term.make(TermKind.termRet)
	r.value = value
	return r
end 'newRet'

// Trap stops the program.
export function newTrap() returns Term
	var r = Term.make(TermKind.termTrap)
	return r
end 'newTrap'

// Throw returns the error Err, a case of the function's error plus 1, from a function that
// throws.
export function newThrow(err Reg) returns Term
	var r = Term.make(TermKind.termThrow)
	r.value = err
	return r
end 'newThrow'

export function constValue(x Instr) returns Word
	return x.imm
end 'constValue'

export function strText(f IrFunction, x Instr) returns String
	return f.stringAt(x.c)
end 'strText'

export function loadSlotSlot(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: loadSlot slot is out of range")
end 'loadSlotSlot'

export function storeSlotSlot(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: storeSlot slot is out of range")
end 'storeSlotSlot'

export function storeSlotSrc(x Instr) returns Reg
	return x.a
end 'storeSlotSrc'

export function storeSlotBorrow(x Instr) returns bool
	return (x.flags and flagBorrow) != 0
end 'storeSlotBorrow'

export function slotAddrSlot(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: slotAddr slot is out of range")
end 'slotAddrSlot'

export function loadParamParam(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: loadParam param is out of range")
end 'loadParamParam'

export function loadFieldObj(x Instr) returns Reg
	return x.a
end 'loadFieldObj'

export function loadFieldOffset(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: loadField offset is out of range")
end 'loadFieldOffset'

export function storeFieldObj(x Instr) returns Reg
	return x.a
end 'storeFieldObj'

export function storeFieldOffset(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: storeField offset is out of range")
end 'storeFieldOffset'

export function storeFieldSrc(x Instr) returns Reg
	return x.b
end 'storeFieldSrc'

export function fieldAddrObj(x Instr) returns Reg
	return x.a
end 'fieldAddrObj'

export function fieldAddrOffset(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: fieldAddr offset is out of range")
end 'fieldAddrOffset'

export function loadAtAddr(x Instr) returns Reg
	return x.a
end 'loadAtAddr'

export function storeAtAddr(x Instr) returns Reg
	return x.a
end 'storeAtAddr'

export function storeAtSrc(x Instr) returns Reg
	return x.b
end 'storeAtSrc'

export function loadGlobalSymbol(x Instr) returns Rt
	return rtOf(try x.imm as Count otherwise panic("ir: loadGlobal symbol is out of range"))
end 'loadGlobalSymbol'

export function loadRawAddr(x Instr) returns Reg
	return x.a
end 'loadRawAddr'

export function loadRawWidth(x Instr) returns RawWidth
	return rawWidthOf(x.sub)
end 'loadRawWidth'

export function storeRawAddr(x Instr) returns Reg
	return x.a
end 'storeRawAddr'

export function storeRawSrc(x Instr) returns Reg
	return x.b
end 'storeRawSrc'

export function storeRawWidth(x Instr) returns RawWidth
	return rawWidthOf(x.sub)
end 'storeRawWidth'

export function globalAddrSymbol(x Instr) returns Rt
	return rtOf(try x.imm as Count otherwise panic("ir: globalAddr symbol is out of range"))
end 'globalAddrSymbol'

export function callImportName(f IrFunction, x Instr) returns String
	return f.stringAt(x.c)
end 'callImportName'

// callImportArgsStart is where the args of a CallImport start in their pool.
export function callImportArgsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: callImport args is out of range")
end 'callImportArgsStart'

// callImportArgsCount is how many args a CallImport has.
export function callImportArgsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: callImport args is out of range")
end 'callImportArgsCount'

export function atomicAddAddr(x Instr) returns Reg
	return x.a
end 'atomicAddAddr'

export function atomicAddSrc(x Instr) returns Reg
	return x.b
end 'atomicAddSrc'

export function atomicExchangeAddr(x Instr) returns Reg
	return x.a
end 'atomicExchangeAddr'

export function atomicExchangeSrc(x Instr) returns Reg
	return x.b
end 'atomicExchangeSrc'

// compareExchangeArgsStart is where the args of a CompareExchange start in their pool.
export function compareExchangeArgsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: compareExchange args is out of range")
end 'compareExchangeArgsStart'

// compareExchangeArgsCount is how many args a CompareExchange has.
export function compareExchangeArgsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: compareExchange args is out of range")
end 'compareExchangeArgsCount'

// callCodeArgsStart is where the args of a CallCode start in their pool.
export function callCodeArgsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: callCode args is out of range")
end 'callCodeArgsStart'

// callCodeArgsCount is how many args a CallCode has.
export function callCodeArgsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: callCode args is out of range")
end 'callCodeArgsCount'

export function codeAddressCallee(f IrFunction, x Instr) returns ast.FuncID
	return f.calleeAt(x.c)
end 'codeAddressCallee'

export function binOp(x Instr) returns BinOp
	return binOpOf(x.sub)
end 'binOp'

export function binLeft(x Instr) returns Reg
	return x.a
end 'binLeft'

export function binRight(x Instr) returns Reg
	return x.b
end 'binRight'

export function binUnsigned(x Instr) returns bool
	return (x.flags and flagUnsigned) != 0
end 'binUnsigned'

export function binHasFail(x Instr) returns bool
	return (x.flags and flagChecked) != 0
end 'binHasFail'

export function binFail(x Instr) returns table.Option with BlockID
	if not binHasFail(x) 'absent'
		return table.Option.none
	end 'absent'
	return table.Option.some(x.c as BlockID)
end 'binFail'

export function cmpOp(x Instr) returns CmpOp
	return cmpOpOf(x.sub)
end 'cmpOp'

export function cmpLeft(x Instr) returns Reg
	return x.a
end 'cmpLeft'

export function cmpRight(x Instr) returns Reg
	return x.b
end 'cmpRight'

export function cmpUnsigned(x Instr) returns bool
	return (x.flags and flagUnsigned) != 0
end 'cmpUnsigned'

export function fBinOp(x Instr) returns FBinOp
	return fBinOpOf(x.sub)
end 'fBinOp'

export function fBinLeft(x Instr) returns Reg
	return x.a
end 'fBinLeft'

export function fBinRight(x Instr) returns Reg
	return x.b
end 'fBinRight'

export function fCmpOp(x Instr) returns CmpOp
	return cmpOpOf(x.sub)
end 'fCmpOp'

export function fCmpLeft(x Instr) returns Reg
	return x.a
end 'fCmpLeft'

export function fCmpRight(x Instr) returns Reg
	return x.b
end 'fCmpRight'

export function fUnaryOp(x Instr) returns FUnaryOp
	return fUnaryOpOf(x.sub)
end 'fUnaryOp'

export function fUnarySrc(x Instr) returns Reg
	return x.a
end 'fUnarySrc'

export function intToFloatSrc(x Instr) returns Reg
	return x.a
end 'intToFloatSrc'

export function intToFloatUnsigned(x Instr) returns bool
	return (x.flags and flagUnsigned) != 0
end 'intToFloatUnsigned'

export function floatToIntSrc(x Instr) returns Reg
	return x.a
end 'floatToIntSrc'

export function negSrc(x Instr) returns Reg
	return x.a
end 'negSrc'

export function negHasFail(x Instr) returns bool
	return (x.flags and flagChecked) != 0
end 'negHasFail'

export function negFail(x Instr) returns table.Option with BlockID
	if not negHasFail(x) 'absent'
		return table.Option.none
	end 'absent'
	return table.Option.some(x.c as BlockID)
end 'negFail'

export function notSrc(x Instr) returns Reg
	return x.a
end 'notSrc'

export function guardSrc(x Instr) returns Reg
	return x.a
end 'guardSrc'

export function guardKind(x Instr) returns GuardKind
	return guardKindOf(x.sub)
end 'guardKind'

export function guardBound(x Instr) returns Word
	return x.imm
end 'guardBound'

export function guardFail(x Instr) returns BlockID
	return x.c as BlockID
end 'guardFail'

export function allocBytes(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: alloc bytes is out of range")
end 'allocBytes'

export function callCallee(f IrFunction, x Instr) returns ast.FuncID
	return f.calleeAt(x.c)
end 'callCallee'

// callArgsStart is where the args of a Call start in their pool.
export function callArgsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: call args is out of range")
end 'callArgsStart'

// callArgsCount is how many args a Call has.
export function callArgsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: call args is out of range")
end 'callArgsCount'

export function callHasErrReg(x Instr) returns bool
	return (x.flags and flagThrows) != 0
end 'callHasErrReg'

export function callErrReg(x Instr) returns table.Option with Reg
	if not callHasErrReg(x) 'absent'
		return table.Option.none
	end 'absent'
	return table.Option.some(try x.imm as Reg otherwise panic("ir: call errReg is out of range"))
end 'callErrReg'

export function callRuntimeSymbol(x Instr) returns Rt
	return rtOf(try x.imm as Count otherwise panic("ir: callRuntime symbol is out of range"))
end 'callRuntimeSymbol'

// callRuntimeArgsStart is where the args of a CallRuntime start in their pool.
export function callRuntimeArgsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: callRuntime args is out of range")
end 'callRuntimeArgsStart'

// callRuntimeArgsCount is how many args a CallRuntime has.
export function callRuntimeArgsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: callRuntime args is out of range")
end 'callRuntimeArgsCount'

export function callRuntimeHasRoutine(x Instr) returns bool
	return x.c != noRoutine
end 'callRuntimeHasRoutine'

export function callRuntimeRoutine(f IrFunction, x Instr) returns table.Option with ast.FuncID
	if not callRuntimeHasRoutine(x) 'absent'
		return table.Option.none
	end 'absent'
	return table.Option.some(f.calleeAt(x.c))
end 'callRuntimeRoutine'

export function whenBody(f IrFunction, x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: when body is out of range")
end 'whenBody'

// whenCownsStart is where the cowns of a When start in their pool.
export function whenCownsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: when cowns is out of range")
end 'whenCownsStart'

// whenCownsCount is how many cowns a When has.
export function whenCownsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: when cowns is out of range")
end 'whenCownsCount'

// whenCapturesStart is where the captures of a When start in their pool.
export function whenCapturesStart(x Instr) returns Count
	return try whenCownsStart(x) + whenCownsCount(x) otherwise panic("ir: when captures is out of range")
end 'whenCapturesStart'

// whenCapturesCount is how many captures a When has.
export function whenCapturesCount(x Instr) returns Count
	return try x.c as Count otherwise panic("ir: when captures is out of range")
end 'whenCapturesCount'

export function closureBody(f IrFunction, x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: closure body is out of range")
end 'closureBody'

// closureCapturesStart is where the captures of a Closure start in their pool.
export function closureCapturesStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: closure captures is out of range")
end 'closureCapturesStart'

// closureCapturesCount is how many captures a Closure has.
export function closureCapturesCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: closure captures is out of range")
end 'closureCapturesCount'

export function funcValueCallee(f IrFunction, x Instr) returns ast.FuncID
	return f.calleeAt(x.c)
end 'funcValueCallee'

// callValueArgsStart is where the args of a CallValue start in their pool.
export function callValueArgsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: callValue args is out of range")
end 'callValueArgsStart'

// callValueArgsCount is how many args a CallValue has.
export function callValueArgsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: callValue args is out of range")
end 'callValueArgsCount'

export function boxTable(f IrFunction, x Instr) returns WitnessTable
	return f.tableAt(x.c)
end 'boxTable'

export function boxValue(x Instr) returns Reg
	return x.a
end 'boxValue'

export function frameBoxTable(f IrFunction, x Instr) returns WitnessTable
	return f.tableAt(x.c)
end 'frameBoxTable'

export function frameBoxValue(x Instr) returns Reg
	return x.a
end 'frameBoxValue'

export function frameBoxBox(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: frameBox box is out of range")
end 'frameBoxBox'

export function callWitnessRecv(x Instr) returns ReceiverConv
	return receiverConvOf(x.sub)
end 'callWitnessRecv'

export function callWitnessSlot(x Instr) returns Count
	return try x.c as Count otherwise panic("ir: callWitness slot is out of range")
end 'callWitnessSlot'

// callWitnessArgsStart is where the args of a CallWitness start in their pool.
export function callWitnessArgsStart(x Instr) returns Count
	return try x.a as Count otherwise panic("ir: callWitness args is out of range")
end 'callWitnessArgsStart'

// callWitnessArgsCount is how many args a CallWitness has.
export function callWitnessArgsCount(x Instr) returns Count
	return try x.b as Count otherwise panic("ir: callWitness args is out of range")
end 'callWitnessArgsCount'

export function callWitnessHasErrReg(x Instr) returns bool
	return (x.flags and flagThrows) != 0
end 'callWitnessHasErrReg'

export function callWitnessErrReg(x Instr) returns table.Option with Reg
	if not callWitnessHasErrReg(x) 'absent'
		return table.Option.none
	end 'absent'
	return table.Option.some(try x.imm as Reg otherwise panic("ir: callWitness errReg is out of range"))
end 'callWitnessErrReg'

export function isTypeSrc(x Instr) returns Reg
	return x.a
end 'isTypeSrc'

export function isTypeTy(f IrFunction, x Instr) returns ast.TypeID
	return f.typeAt(x.c)
end 'isTypeTy'

export function dropSrc(x Instr) returns Reg
	return x.a
end 'dropSrc'

export function dropTy(f IrFunction, x Instr) returns ast.TypeID
	return f.typeAt(x.c)
end 'dropTy'

export function dropSlotSlot(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: dropSlot slot is out of range")
end 'dropSlotSlot'

export function dropSlotTy(f IrFunction, x Instr) returns ast.TypeID
	return f.typeAt(x.c)
end 'dropSlotTy'

export function dropAtAddr(x Instr) returns Reg
	return x.a
end 'dropAtAddr'

export function dropAtTy(f IrFunction, x Instr) returns ast.TypeID
	return f.typeAt(x.c)
end 'dropAtTy'

export function moveSlotSlot(x Instr) returns Count
	return try x.imm as Count otherwise panic("ir: moveSlot slot is out of range")
end 'moveSlotSlot'

export function moveAtAddr(x Instr) returns Reg
	return x.a
end 'moveAtAddr'

export function copySrc(x Instr) returns Reg
	return x.a
end 'copySrc'

export function copyTy(f IrFunction, x Instr) returns ast.TypeID
	return f.typeAt(x.c)
end 'copyTy'

export function jumpTarget(t Term) returns BlockID
	return t.target
end 'jumpTarget'

// jumpArgsStart is where the args of a Jump start in their pool.
export function jumpArgsStart(t Term) returns Count
	return try t.args as Count otherwise panic("ir: jump args is out of range")
end 'jumpArgsStart'

// jumpArgsCount is how many args a Jump has.
export function jumpArgsCount(t Term) returns Count
	return try t.targetArgs as Count otherwise panic("ir: jump args is out of range")
end 'jumpArgsCount'

export function branchCond(t Term) returns Reg
	return t.value
end 'branchCond'

export function branchIfTrue(t Term) returns BlockID
	return t.target
end 'branchIfTrue'

// branchTrueArgsStart is where the trueArgs of a Branch start in their pool.
export function branchTrueArgsStart(t Term) returns Count
	return try t.args as Count otherwise panic("ir: branch trueArgs is out of range")
end 'branchTrueArgsStart'

// branchTrueArgsCount is how many trueArgs a Branch has.
export function branchTrueArgsCount(t Term) returns Count
	return try t.targetArgs as Count otherwise panic("ir: branch trueArgs is out of range")
end 'branchTrueArgsCount'

export function branchIfFalse(t Term) returns BlockID
	return t.other
end 'branchIfFalse'

// branchFalseArgsStart is where the falseArgs of a Branch start in their pool.
export function branchFalseArgsStart(t Term) returns Count
	return try branchTrueArgsStart(t) + branchTrueArgsCount(t) otherwise panic("ir: branch falseArgs is out of range")
end 'branchFalseArgsStart'

// branchFalseArgsCount is how many falseArgs a Branch has.
export function branchFalseArgsCount(t Term) returns Count
	return try t.otherArgs as Count otherwise panic("ir: branch falseArgs is out of range")
end 'branchFalseArgsCount'

