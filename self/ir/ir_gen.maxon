	return try t.first as Count otherwise panic("ir: switch cases is out of range")
end 'switchCasesStart'

// switchCasesCount is how many cases a Switch has.
export function switchCasesCount(t Term) returns Count
	return try t.count as Count otherwise panic("ir: switch cases is out of range")
end 'switchCasesCount'

export function switchFallback(t Term) returns BlockID
	return t.target
end 'switchFallback'

// switchFallbackArgsStart is where the fallbackArgs of a Switch start in their pool.
export function switchFallbackArgsStart(t Term) returns Count
	return try t.args as Count otherwise panic("ir: switch fallbackArgs is out of range")
end 'switchFallbackArgsStart'

// switchFallbackArgsCount is how many fallbackArgs a Switch has.
export function switchFallbackArgsCount(t Term) returns Count
	return try t.targetArgs as Count otherwise panic("ir: switch fallbackArgs is out of range")
end 'switchFallbackArgsCount'

export function retValue(t Term) returns Reg
	return t.value
end 'retValue'

export function throwErr(t Term) returns Reg
