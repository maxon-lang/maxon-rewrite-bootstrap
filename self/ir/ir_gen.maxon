		return 0
	end 'opStrPtr'
	if op == Opcode.opStrBytes 'opStrBytes'
		return 2
	end 'opStrBytes'
	if op == Opcode.opStrWord 'opStrWord'
		return 0
	end 'opStrWord'
	if op == Opcode.opStrMake 'opStrMake'
		return 0
	end 'opStrMake'
	if op == Opcode.opAlloc 'opAlloc'
		return 12
	end 'opAlloc'
	if op == Opcode.opCall 'opCall'
		return 31
	end 'opCall'
	if op == Opcode.opCallRuntime 'opCallRuntime'
		return 31
	end 'opCallRuntime'
	if op == Opcode.opWhen 'opWhen'
		return 15
	end 'opWhen'
	if op == Opcode.opAsync 'opAsync'
		return 15
	end 'opAsync'
	if op == Opcode.opClosure 'opClosure'
		return 13
	end 'opClosure'
	if op == Opcode.opFuncValue 'opFuncValue'
		return 12
	end 'opFuncValue'
	if op == Opcode.opCallValue 'opCallValue'
		return 31
	end 'opCallValue'
	if op == Opcode.opBox 'opBox'
		return 12
	end 'opBox'
	if op == Opcode.opFrameBox 'opFrameBox'
		return 2
	end 'opFrameBox'
	if op == Opcode.opFrameArea 'opFrameArea'
		return 0
	end 'opFrameArea'
	if op == Opcode.opCallWitness 'opCallWitness'
		return 31
	end 'opCallWitness'
	if op == Opcode.opIsType 'opIsType'
		return 5
	end 'opIsType'
	if op == Opcode.opDrop 'opDrop'
		return 20
	end 'opDrop'
	if op == Opcode.opDropSlot 'opDropSlot'
		return 23
	end 'opDropSlot'
	if op == Opcode.opDropAt 'opDropAt'
		return 23
	end 'opDropAt'
	if op == Opcode.opMoveSlot 'opMoveSlot'
		return 3
	end 'opMoveSlot'
	if op == Opcode.opMoveAt 'opMoveAt'
		return 3
	end 'opMoveAt'
	if op == Opcode.opCopy 'opCopy'
		return 13
	end 'opCopy'
	panic("ir: an operation of no kind has no effects")
end 'opEffects'

// termEffects are what an operation does besides reading its operands and writing its result: a sum of effect bits.
export function termEffects(kind TermKind) returns Count
	if kind == TermKind.termJump 'termJump'
		return 0
	end 'termJump'
	if kind == TermKind.termBranch 'termBranch'
		return 0
	end 'termBranch'
	if kind == TermKind.termSwitch 'termSwitch'
		return 0
	end 'termSwitch'
	if kind == TermKind.termRet 'termRet'
		return 32
	end 'termRet'
	if kind == TermKind.termTrap 'termTrap'
		return 32
	end 'termTrap'
	if kind == TermKind.termThrow 'termThrow'
		return 32
	end 'termThrow'
	panic("ir: an operation of no kind has no effects")
end 'termEffects'

// Instr is one instruction, a record of fixed fields whose meaning its opcode says; what does not fit in it is in
// the pools of its function, which c and a range of a and b index.
export type Instr
	export var op as Opcode
	export var dst as Reg
	export var a as Reg
	export var b as Reg
	export var c as Index
	export var imm as Word
	export var sub as Byte
	export var flags as Byte

	export static function make(op Opcode) returns Instr
		return Instr{op: op, dst: 0 as Reg, a: 0 as Reg, b: 0 as Reg, c: 0 as Index, imm: 0 as Word, sub: 0 as Byte, flags: 0 as Byte}
	end 'make'
end 'Instr'

export typealias InstrList = Array with Instr

// Term is how a block ends, a record of fixed fields like an instruction.
export type Term
	export var kind as TermKind
	export var value as Reg
	export var target as BlockID
	export var other as BlockID
	export var first as Index
	export var count as Index
	export var args as Index
	export var targetArgs as Index
	export var otherArgs as Index

	export static function make(kind TermKind) returns Term
		return Term{kind: kind, value: 0 as Reg, target: 0 as BlockID, other: 0 as BlockID, first: 0 as Index, count: 0 as Index, args: 0 as Index, targetArgs: 0 as Index, otherArgs: 0 as Index}
	end 'make'
end 'Term'

export typealias TermList = Array with Term

// Const gives a number.
export function newConst(dst Reg, value Word) returns Instr
	var r = Instr.make(Opcode.opConst)
	r.dst = dst
	r.imm = value
	return r
end 'newConst'

// Str gives a string literal.
export function newStr(dst Reg, text Index, character bool) returns Instr
	var r = Instr.make(Opcode.opStr)
	r.dst = dst
	r.c = text
	if character 'character'
		r.flags = r.flags or flagCharacter
	end 'character'
	return r
end 'newStr'

// Datum gives the constant Item of the function's Datums, laid out once in the executable's data: no one owns
// it, and it is never written or dropped.
export function newDatum(dst Reg, item Count) returns Instr
	var r = Instr.make(Opcode.opDatum)
	r.dst = dst
	r.c = try item as Index otherwise panic("ir: datum item is out of range")
	return r
end 'newDatum'

// LoadSlot reads a slot.
export function newLoadSlot(dst Reg, slot Count) returns Instr
	var r = Instr.make(Opcode.opLoadSlot)
	r.dst = dst
	r.imm = try slot as Word otherwise panic("ir: loadSlot slot is out of range")
	return r
end 'newLoadSlot'

// StoreSlot puts a value in a slot, which owns it unless Borrow is set.
export function newStoreSlot(slot Count, src Reg, borrow bool) returns Instr
	var r = Instr.make(Opcode.opStoreSlot)
	r.imm = try slot as Word otherwise panic("ir: storeSlot slot is out of range")
	r.a = src
	if borrow 'borrow'
		r.flags = r.flags or flagBorrow
	end 'borrow'
	return r
end 'newStoreSlot'

// SlotAddr gives the address of a slot.
export function newSlotAddr(dst Reg, slot Count) returns Instr
	var r = Instr.make(Opcode.opSlotAddr)
	r.dst = dst
	r.imm = try slot as Word otherwise panic("ir: slotAddr slot is out of range")
	return r
end 'newSlotAddr'

// LoadParam reads a parameter.
export function newLoadParam(dst Reg, param Count) returns Instr
	var r = Instr.make(Opcode.opLoadParam)
	r.dst = dst
	r.imm = try param as Word otherwise panic("ir: loadParam param is out of range")
	return r
end 'newLoadParam'

// LoadField reads the word at Obj + Offset.
export function newLoadField(dst Reg, obj Reg, offset Count) returns Instr
	var r = Instr.make(Opcode.opLoadField)
	r.dst = dst
	r.a = obj
	r.imm = try offset as Word otherwise panic("ir: loadField offset is out of range")
	return r
end 'newLoadField'

// StoreField writes Src to the word at Obj + Offset, which owns it unless Borrow is set: a cursor's
// field that borrows the buffer it walks.
export function newStoreField(obj Reg, offset Count, src Reg, borrow bool) returns Instr
	var r = Instr.make(Opcode.opStoreField)
	r.a = obj
	r.imm = try offset as Word otherwise panic("ir: storeField offset is out of range")
	r.b = src
	if borrow 'borrow'
		r.flags = r.flags or flagBorrow
	end 'borrow'
	return r
end 'newStoreField'

// FieldAddr gives Obj + Offset.
export function newFieldAddr(dst Reg, obj Reg, offset Count) returns Instr
	var r = Instr.make(Opcode.opFieldAddr)
	r.dst = dst
	r.a = obj
	r.imm = try offset as Word otherwise panic("ir: fieldAddr offset is out of range")
	return r
end 'newFieldAddr'

// LoadAt reads the word at an address.
export function newLoadAt(dst Reg, addr Reg) returns Instr
	var r = Instr.make(Opcode.opLoadAt)
	r.dst = dst
	r.a = addr
	return r
end 'newLoadAt'

// StoreAt writes Src to the word at an address.
export function newStoreAt(addr Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opStoreAt)
	r.a = addr
	r.b = src
	return r
end 'newStoreAt'

// LoadGlobal reads a global of the runtime.
export function newLoadGlobal(dst Reg, symbol Rt) returns Instr
	var r = Instr.make(Opcode.opLoadGlobal)
	r.dst = dst
	r.imm = try rtCode(symbol) as Word otherwise panic("ir: loadGlobal symbol is out of range")
	return r
end 'newLoadGlobal'

// LoadRaw reads Width bits at an address, zero-extended to the word.
export function newLoadRaw(dst Reg, addr Reg, width RawWidth) returns Instr
	var r = Instr.make(Opcode.opLoadRaw)
	r.dst = dst
	r.a = addr
	r.sub = rawWidthCode(width)
	return r
end 'newLoadRaw'

// StoreRaw writes the low Width bits of Src at an address.
export function newStoreRaw(addr Reg, src Reg, width RawWidth) returns Instr
	var r = Instr.make(Opcode.opStoreRaw)
	r.a = addr
	r.b = src
	r.sub = rawWidthCode(width)
	return r
end 'newStoreRaw'

// LoadAcquire reads the word at an address, and nothing after it reads or writes memory before it.
export function newLoadAcquire(dst Reg, addr Reg) returns Instr
	var r = Instr.make(Opcode.opLoadAcquire)
	r.dst = dst
	r.a = addr
	return r
end 'newLoadAcquire'

// StoreRelease writes Src to the word at an address after everything before it has read and written memory.
export function newStoreRelease(addr Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opStoreRelease)
	r.a = addr
	r.b = src
	return r
end 'newStoreRelease'

// GlobalAddr gives the address of a global of the runtime.
export function newGlobalAddr(dst Reg, symbol Rt) returns Instr
	var r = Instr.make(Opcode.opGlobalAddr)
	r.dst = dst
	r.imm = try rtCode(symbol) as Word otherwise panic("ir: globalAddr symbol is out of range")
	return r
end 'newGlobalAddr'

// CallImport calls the DLL import Name, a string of the function, with the words Args, by the
// Win64 convention, and gives what it returns.
export function newCallImport(dst Reg, name Index, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCallImport)
	r.dst = dst
	r.c = name
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCallImport'

// Syscall calls the kernel with the number that is the first of Args and the words that follow it, by the
// target's system call convention, and gives what it returns.
export function newSyscall(dst Reg, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opSyscall)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	return r
end 'newSyscall'

// AtomicAdd adds Src to the word at an address as one indivisible step, a full fence, and gives the word it found.
export function newAtomicAdd(dst Reg, addr Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opAtomicAdd)
	r.dst = dst
	r.a = addr
	r.b = src
	return r
end 'newAtomicAdd'

// AtomicExchange puts Src in the word at an address as one indivisible step, a full fence, and gives the word it
// found.
export function newAtomicExchange(dst Reg, addr Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opAtomicExchange)
	r.dst = dst
	r.a = addr
	r.b = src
	return r
end 'newAtomicExchange'

// CompareExchange is given the address, the word expected and the word desired in Args: as one indivisible step,
// a full fence, it puts the desired word at the address when the expected one is there, and gives the word it found.
export function newCompareExchange(dst Reg, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCompareExchange)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCompareExchange'

// SpinPause tells the processor that the thread is waiting in a loop for another one.
export function newSpinPause() returns Instr
	var r = Instr.make(Opcode.opSpinPause)
	return r
end 'newSpinPause'

// ThreadContext gives the word the running thread keeps in the runtime's thread-local slot: its context.
export function newThreadContext(dst Reg) returns Instr
	var r = Instr.make(Opcode.opThreadContext)
	r.dst = dst
	return r
end 'newThreadContext'

// CallCode calls the code at the address that is the first of Args with the rest of Args, by the internal
// convention, and gives what it returns.
export function newCallCode(dst Reg, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCallCode)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCallCode'

// CallHost calls the code at the address that is the first of Args with the rest of Args, by the host's
// convention (Win64), as CallImport calls an import: a function of a library the import table does not name, found by
// its address.
export function newCallHost(dst Reg, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opCallHost)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	return r
end 'newCallHost'

// CodeAddress gives the address of the code of the function Callee, which a CallCode calls: the run of a
// behaviour's record that a test of the runtime builds by hand.
export function newCodeAddress(dst Reg, callee Index) returns Instr
	var r = Instr.make(Opcode.opCodeAddress)
	r.dst = dst
	r.c = callee
	return r
end 'newCodeAddress'

// Bin is Left Op Right; when Checked, it goes to Fail when the result does not fit, which for a
// signed '/' is i64.min / -1. MulHi is the high word of the 128-bit product, which a division by a constant is
// made of, and always fits.
export function newBin(dst Reg, op BinOp, left Reg, right Reg, unsigned bool, fail BlockID) returns Instr
	var r = Instr.make(Opcode.opBin)
	r.dst = dst
	r.sub = binOpCode(op)
	r.a = left
	r.b = right
	if unsigned 'unsigned'
		r.flags = r.flags or flagUnsigned
	end 'unsigned'
	r.c = fail as Index
	if fail != noBlock 'fail'
		r.flags = r.flags or flagChecked
	end 'fail'
	return r
end 'newBin'

// Cmp gives 1 when Left Op Right holds and 0 when it does not.
export function newCmp(dst Reg, op CmpOp, left Reg, right Reg, unsigned bool) returns Instr
	var r = Instr.make(Opcode.opCmp)
	r.dst = dst
	r.sub = cmpOpCode(op)
	r.a = left
	r.b = right
	if unsigned 'unsigned'
		r.flags = r.flags or flagUnsigned
	end 'unsigned'
	return r
end 'newCmp'

// FBin is Left Op Right on two doubles, rounded to the nearest double, ties to even.
export function newFBin(dst Reg, op FBinOp, left Reg, right Reg) returns Instr
	var r = Instr.make(Opcode.opFBin)
	r.dst = dst
	r.sub = fBinOpCode(op)
	r.a = left
	r.b = right
	return r
end 'newFBin'

// FCmp gives 1 when Left Op Right holds of two doubles and 0 when it does not; every comparison with a
// NaN but ne does not hold.
export function newFCmp(dst Reg, op CmpOp, left Reg, right Reg) returns Instr
	var r = Instr.make(Opcode.opFCmp)
	r.dst = dst
	r.sub = cmpOpCode(op)
	r.a = left
	r.b = right
	return r
end 'newFCmp'

// FUnary is Op of a double.
export function newFUnary(dst Reg, op FUnaryOp, src Reg) returns Instr
	var r = Instr.make(Opcode.opFUnary)
	r.dst = dst
	r.sub = fUnaryOpCode(op)
	r.a = src
	return r
end 'newFUnary'

// IntToFloat is the double nearest the integer Src, read as unsigned when Unsigned is set.
export function newIntToFloat(dst Reg, src Reg, unsigned bool) returns Instr
	var r = Instr.make(Opcode.opIntToFloat)
	r.dst = dst
	r.a = src
	if unsigned 'unsigned'
		r.flags = r.flags or flagUnsigned
	end 'unsigned'
	return r
end 'newIntToFloat'

// FloatToInt is the double Src truncated toward zero, or i64.min for a NaN or a double past the word.
export function newFloatToInt(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opFloatToInt)
	r.dst = dst
	r.a = src
	return r
end 'newFloatToInt'

// Neg negates; when Checked, it goes to Fail for i64.min.
export function newNeg(dst Reg, src Reg, fail BlockID) returns Instr
	var r = Instr.make(Opcode.opNeg)
	r.dst = dst
	r.a = src
	r.c = fail as Index
	if fail != noBlock 'fail'
		r.flags = r.flags or flagChecked
	end 'fail'
	return r
end 'newNeg'

// Not inverts every bit.
export function newNot(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opNot)
	r.dst = dst
	r.a = src
	return r
end 'newNot'

// TrailingZeros is the number of 0 bits below the lowest 1 bit of Src, and 64 when Src is 0.
export function newTrailingZeros(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opTrailingZeros)
	r.dst = dst
	r.a = src
	return r
end 'newTrailingZeros'

// Guard goes to Fail unless Src is in the range Kind of Bound.
export function newGuard(src Reg, kind GuardKind, bound Word, fail BlockID) returns Instr
	var r = Instr.make(Opcode.opGuard)
	r.a = src
	r.sub = guardKindCode(kind)
	r.imm = bound
	r.c = fail as Index
	return r
end 'newGuard'

// Length reads the count of the collection Src: of the elements of an array or a byte array, or of the bytes of a
// string.
export function newLength(dst Reg, src Reg, of Collection) returns Instr
	var r = Instr.make(Opcode.opLength)
	r.dst = dst
	r.a = src
	r.sub = collectionCode(of)
	return r
end 'newLength'

// Bounds goes to Fail unless Index is below Length, both read as unsigned: the check of an index of a collection.
export function newBounds(index Reg, length Reg, fail BlockID) returns Instr
	var r = Instr.make(Opcode.opBounds)
	r.a = index
	r.b = length
	r.c = fail as Index
	return r
end 'newBounds'

// ElemAddr gives the address of the element at Index of Arr, where a Bounds has checked the index: the elements
// are 1 shl Shift bytes each, a word (wordElementShift) or a String (stringElementShift).
export function newElemAddr(dst Reg, arr Reg, index Reg, shift Count) returns Instr
	var r = Instr.make(Opcode.opElemAddr)
	r.dst = dst
	r.a = arr
	r.b = index
	r.imm = try shift as Word otherwise panic("ir: elemAddr shift is out of range")
	return r
end 'newElemAddr'

// ElemLoad reads the element at Index of Arr, of 1 shl Shift bytes, where a Bounds has checked the index: a
// scalar, or a managed element or a String lent as LoadAt lends it.
export function newElemLoad(dst Reg, arr Reg, index Reg, shift Count) returns Instr
	var r = Instr.make(Opcode.opElemLoad)
	r.dst = dst
	r.a = arr
	r.b = index
	r.imm = try shift as Word otherwise panic("ir: elemLoad shift is out of range")
	return r
end 'newElemLoad'

// LoadByte reads the byte at Index of Src, a byte array or a string, where a Bounds has checked the index.
export function newLoadByte(dst Reg, src Reg, index Reg, of Collection) returns Instr
	var r = Instr.make(Opcode.opLoadByte)
	r.dst = dst
	r.a = src
	r.b = index
	r.sub = collectionCode(of)
	return r
end 'newLoadByte'

// Buffer reads the address of the elements of Src, an array or a byte array, which a push that grows it moves.
export function newBuffer(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opBuffer)
	r.dst = dst
	r.a = src
	return r
end 'newBuffer'

// ElemAt reads the element at Index of Data, the elements of an array that Buffer gave, of 1 shl Shift bytes,
// where a Bounds has checked the index: a scalar, or a managed element or a String lent as LoadAt lends it.
export function newElemAt(dst Reg, data Reg, index Reg, shift Count) returns Instr
	var r = Instr.make(Opcode.opElemAt)
	r.dst = dst
	r.a = data
	r.b = index
	r.imm = try shift as Word otherwise panic("ir: elemAt shift is out of range")
	return r
end 'newElemAt'

// ElemAddrAt gives the address of the element at Index of Data, the elements of an array that Buffer gave, of
// 1 shl Shift bytes, where a Bounds has checked the index: Data plus the index shifted, which reads no memory.
export function newElemAddrAt(dst Reg, data Reg, index Reg, shift Count) returns Instr
	var r = Instr.make(Opcode.opElemAddrAt)
	r.dst = dst
	r.a = data
	r.b = index
	r.imm = try shift as Word otherwise panic("ir: elemAddrAt shift is out of range")
	return r
end 'newElemAddrAt'

// ByteAt reads the byte at Index of Data, the elements of a byte array that Buffer gave, where a Bounds has checked the index.
export function newByteAt(dst Reg, data Reg, index Reg) returns Instr
	var r = Instr.make(Opcode.opByteAt)
	r.dst = dst
	r.a = data
	r.b = index
	return r
end 'newByteAt'

// StrPtr gives the address of the first byte of the string Src, its first word.
export function newStrPtr(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opStrPtr)
	r.dst = dst
	r.a = src
	return r
end 'newStrPtr'

// StrBytes gives the address of the first byte of the string Src: its first word, or where it holds its bytes in
// its two words, the frame box Box, which it writes them to in order.
export function newStrBytes(dst Reg, src Reg, box Count) returns Instr
	var r = Instr.make(Opcode.opStrBytes)
	r.dst = dst
	r.a = src
	r.imm = try box as Word otherwise panic("ir: strBytes box is out of range")
	return r
end 'newStrBytes'

// StrWord gives the word of the string Src: its length shifted up past its flags, and the flags.
export function newStrWord(dst Reg, src Reg) returns Instr
	var r = Instr.make(Opcode.opStrWord)
	r.dst = dst
	r.a = src
	return r
end 'newStrWord'

// StrMake gives the string of the address Bytes and the word Word.
export function newStrMake(dst Reg, bytes Reg, word Reg) returns Instr
	var r = Instr.make(Opcode.opStrMake)
	r.dst = dst
	r.a = bytes
	r.b = word
	return r
end 'newStrMake'

// Alloc gives a new box of Bytes bytes.
export function newAlloc(dst Reg, bytes Count) returns Instr
	var r = Instr.make(Opcode.opAlloc)
	r.dst = dst
	r.imm = try bytes as Word otherwise panic("ir: alloc bytes is out of range")
	return r
end 'newAlloc'

// Call applies Callee to Args.
export function newCall(dst Reg, callee Index, argsStart Reg, argsCount Reg, errReg Reg, floatResult bool) returns Instr
	var r = Instr.make(Opcode.opCall)
	r.dst = dst
	r.c = callee
	r.a = argsStart
	r.b = argsCount
	if errReg != noReg 'errReg'
		r.flags = r.flags or flagThrows
		r.imm = errReg as Word
	end 'errReg'
	if floatResult 'floatResult'
		r.flags = r.flags or flagFloatResult
	end 'floatResult'
	return r
end 'newCall'

// CallRuntime applies the runtime entry Symbol to Args; Routine is what the entry stores to call
// later (the destructor of a cown).
export function newCallRuntime(dst Reg, symbol Rt, argsStart Reg, argsCount Reg, routine Index, proven bool) returns Instr
	var r = Instr.make(Opcode.opCallRuntime)
	r.dst = dst
	r.imm = try rtCode(symbol) as Word otherwise panic("ir: callRuntime symbol is out of range")
	r.a = argsStart
	r.b = argsCount
	r.c = routine
	if proven 'proven'
		r.flags = r.flags or flagProven
	end 'proven'
	return r
end 'newCallRuntime'

// When schedules the behaviour Body on the cowns Cowns, capturing Captures.
export function newWhen(body Count, cownsStart Reg, cownsCount Reg, capturesCount Index) returns Instr
	var r = Instr.make(Opcode.opWhen)
	r.imm = try body as Word otherwise panic("ir: when body is out of range")
	r.a = cownsStart
	r.b = cownsCount
	r.c = capturesCount
	return r
end 'newWhen'

// Async starts Callee with the words Args as a coroutine of the running green thread's strand, and gives its
// promise: the coroutine runs the thunk of Callee, which calls it with Args and keeps what it returns, and what it
// failed with, for the await. The coroutine owns each argument a consumes parameter takes, and borrows the others.
export function newAsync(dst Reg, callee Index, argsStart Reg, argsCount Reg) returns Instr
	var r = Instr.make(Opcode.opAsync)
	r.dst = dst
	r.c = callee
	r.a = argsStart
	r.b = argsCount
	return r
end 'newAsync'

// Closure gives a new closure of the body Body, holding Captures: it owns each capture that Body says it owns, and
// borrows the others.
export function newClosure(dst Reg, body Count, capturesStart Reg, capturesCount Reg) returns Instr
	var r = Instr.make(Opcode.opClosure)
	r.dst = dst
	r.imm = try body as Word otherwise panic("ir: closure body is out of range")
	r.a = capturesStart
	r.b = capturesCount
	return r
end 'newClosure'

// FuncValue gives a new closure of the function Callee, which captures nothing.
export function newFuncValue(dst Reg, callee Index) returns Instr
	var r = Instr.make(Opcode.opFuncValue)
	r.dst = dst
	r.c = callee
	return r
end 'newFuncValue'

// CallValue calls the closure that is the first of Args with all of Args: the code it holds takes the closure
// first, to read what it captured, and a named function's code ignores it.
export function newCallValue(dst Reg, argsStart Reg, argsCount Reg, floatResult bool) returns Instr
	var r = Instr.make(Opcode.opCallValue)
	r.dst = dst
	r.a = argsStart
	r.b = argsCount
	if floatResult 'floatResult'
		r.flags = r.flags or flagFloatResult
	end 'floatResult'
	return r
end 'newCallValue'

// Box gives a new interface value: a box on the heap of the address of the table Table and the value Value, which
// the box owns.
export function newBox(dst Reg, table Index, value Reg) returns Instr
	var r = Instr.make(Opcode.opBox)
	r.dst = dst
	r.c = table
	r.a = value
	return r
end 'newBox'

// FrameBox gives an interface value whose box is the function's frame box Box, two words of its frame, with the
// address of the table Table and the value Value: a value only lent to what borrows the interface value, or a scalar,
// which the box owns nothing of. The box lives as long as the frame, and a borrow cannot outlive the call it is lent to.
export function newFrameBox(dst Reg, table Index, value Reg, box Count) returns Instr
	var r = Instr.make(Opcode.opFrameBox)
	r.dst = dst
	r.c = table
	r.a = value
	r.imm = try box as Word otherwise panic("ir: frameBox box is out of range")
	return r
end 'newFrameBox'

// FrameArea gives the address of Words words of the function's frame, from its frame box Box on through as many
// boxes as they fill: the box of a tuple that a function lends, which the call passes it to fill with a borrow of each
// element. It owns nothing, lives as long as the frame, and a lent tuple cannot outlive the scope it is lent to.
export function newFrameArea(dst Reg, words Count, box Count) returns Instr
	var r = Instr.make(Opcode.opFrameArea)
	r.dst = dst
	r.c = try words as Index otherwise panic("ir: frameArea words is out of range")
	r.imm = try box as Word otherwise panic("ir: frameArea box is out of range")
	return r
end 'newFrameArea'

// CallWitness calls the method in place Slot of the table of the interface value that is the first of Args, with
// the value the box holds, given as Recv says, and the rest of Args.
export function newCallWitness(dst Reg, recv ReceiverConv, slot Count, argsStart Reg, argsCount Reg, errReg Reg, floatResult bool) returns Instr
	var r = Instr.make(Opcode.opCallWitness)
	r.dst = dst
	r.sub = receiverConvCode(recv)
	r.c = try slot as Index otherwise panic("ir: callWitness slot is out of range")
	r.a = argsStart
	r.b = argsCount
	if errReg != noReg 'errReg'
		r.flags = r.flags or flagThrows
		r.imm = errReg as Word
	end 'errReg'
	if floatResult 'floatResult'
		r.flags = r.flags or flagFloatResult
	end 'floatResult'
	return r
end 'newCallWitness'

// IsType gives 1 when the interface value Src holds a value of the type Ty, and 0 when it holds one of another type.
export function newIsType(dst Reg, src Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opIsType)
	r.dst = dst
	r.a = src
	r.c = ty
	return r
end 'newIsType'

// Drop drops the value in Src, of type Ty.
export function newDrop(src Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opDrop)
	r.a = src
	r.c = ty
	return r
end 'newDrop'

// DropSlot drops what a slot owns, of type Ty, and leaves it empty.
export function newDropSlot(slot Count, ty Index) returns Instr
	var r = Instr.make(Opcode.opDropSlot)
	r.imm = try slot as Word otherwise panic("ir: dropSlot slot is out of range")
	r.c = ty
	return r
end 'newDropSlot'

// DropAt drops what an address holds, of type Ty, and leaves it empty.
export function newDropAt(addr Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opDropAt)
	r.a = addr
	r.c = ty
	return r
end 'newDropAt'

// MoveSlot reads a slot and leaves it empty.
export function newMoveSlot(dst Reg, slot Count) returns Instr
	var r = Instr.make(Opcode.opMoveSlot)
	r.dst = dst
	r.imm = try slot as Word otherwise panic("ir: moveSlot slot is out of range")
	return r
end 'newMoveSlot'

// MoveAt reads the value at an address and leaves the place empty.
export function newMoveAt(dst Reg, addr Reg) returns Instr
	var r = Instr.make(Opcode.opMoveAt)
	r.dst = dst
	r.a = addr
	return r
end 'newMoveAt'

// Copy gives a deep copy of Src, of type Ty.
export function newCopy(dst Reg, src Reg, ty Index) returns Instr
	var r = Instr.make(Opcode.opCopy)
	r.dst = dst
	r.a = src
	r.c = ty
	return r
end 'newCopy'

// Jump goes to Target, passing Args to its parameters. Its edges pass no arguments; newJumpWith takes them.
export function newJump(target BlockID) returns Term
	var r = Term.make(TermKind.termJump)
	r.target = target
	return r
end 'newJump'

// Jump goes to Target, passing Args to its parameters.
export function newJumpWith(target BlockID, argsStart Index, argsCount Index) returns Term
	var r = Term.make(TermKind.termJump)
	r.target = target
	r.args = argsStart
	r.targetArgs = argsCount
	return r
end 'newJumpWith'

// Branch goes to IfTrue, passing TrueArgs, when Cond is not 0, else to IfFalse, passing FalseArgs. Its edges pass no arguments; newBranchWith takes them.
export function newBranch(cond Reg, ifTrue BlockID, ifFalse BlockID) returns Term
	var r = Term.make(TermKind.termBranch)
	r.value = cond
	r.target = ifTrue
	r.other = ifFalse
	return r
end 'newBranch'

// Branch goes to IfTrue, passing TrueArgs, when Cond is not 0, else to IfFalse, passing FalseArgs.
export function newBranchWith(cond Reg, ifTrue BlockID, trueArgsStart Index, trueArgsCount Index, ifFalse BlockID, falseArgsCount Index) returns Term
	var r = Term.make(TermKind.termBranch)
	r.value = cond
	r.target = ifTrue
	r.args = trueArgsStart
	r.targetArgs = trueArgsCount
	r.other = ifFalse
	r.otherArgs = falseArgsCount
	return r
end 'newBranchWith'

// Switch goes to the target of the case that Value equals, passing the case's arguments, else to
// Fallback, passing FallbackArgs. Its edges pass no arguments; newSwitchWith takes them.
export function newSwitch(value Reg, casesFirst Index, casesCount Index, fallback BlockID) returns Term
	var r = Term.make(TermKind.termSwitch)
	r.value = value
	r.first = casesFirst
	r.count = casesCount
	r.target = fallback
	return r
end 'newSwitch'

// Switch goes to the target of the case that Value equals, passing the case's arguments, else to
// Fallback, passing FallbackArgs.
export function newSwitchWith(value Reg, casesFirst Index, casesCount Index, fallback BlockID, fallbackArgsStart Index, fallbackArgsCount Index) returns Term
	var r = Term.make(TermKind.termSwitch)
	r.value = value
	r.first = casesFirst
	r.count = casesCount
	r.target = fallback
	r.args = fallbackArgsStart
	r.targetArgs = fallbackArgsCount
	return r
end 'newSwitchWith'

// Ret returns Value.
export function newRet(value Reg) returns Term
	var r = Term.make(TermKind.termRet)
	r.value = value
	return r
end 'newRet'

// Trap stops the program.
export function newTrap() returns Term
	var r = Term.make(TermKind.termTrap)
	return r
end 'newTrap'

// Throw returns the error Err, a case of the function's error plus 1, from a function that
// throws.
export function newThrow(err Reg) returns Term
	var r = Term.make(TermKind.termThrow)
	r.value = err
	return r
end 'newThrow'

// opcodeName is the name of the kind of an instruction.
export function opcodeName(op Opcode) returns String
	if op == Opcode.opConst 'opConst'
		return "Const"
	end 'opConst'
	if op == Opcode.opStr 'opStr'
		return "Str"
	end 'opStr'
	if op == Opcode.opDatum 'opDatum'
		return "Datum"
	end 'opDatum'
	if op == Opcode.opLoadSlot 'opLoadSlot'
		return "LoadSlot"
	end 'opLoadSlot'
	if op == Opcode.opStoreSlot 'opStoreSlot'
		return "StoreSlot"
	end 'opStoreSlot'
	if op == Opcode.opSlotAddr 'opSlotAddr'
		return "SlotAddr"
	end 'opSlotAddr'
	if op == Opcode.opLoadParam 'opLoadParam'
		return "LoadParam"
	end 'opLoadParam'
	if op == Opcode.opLoadField 'opLoadField'
		return "LoadField"
	end 'opLoadField'
	if op == Opcode.opStoreField 'opStoreField'
		return "StoreField"
	end 'opStoreField'
	if op == Opcode.opFieldAddr 'opFieldAddr'
		return "FieldAddr"
	end 'opFieldAddr'
	if op == Opcode.opLoadAt 'opLoadAt'
		return "LoadAt"
	end 'opLoadAt'
	if op == Opcode.opStoreAt 'opStoreAt'
		return "StoreAt"
	end 'opStoreAt'
	if op == Opcode.opLoadGlobal 'opLoadGlobal'
		return "LoadGlobal"
	end 'opLoadGlobal'
	if op == Opcode.opLoadRaw 'opLoadRaw'
		return "LoadRaw"
	end 'opLoadRaw'
	if op == Opcode.opStoreRaw 'opStoreRaw'
		return "StoreRaw"
	end 'opStoreRaw'
	if op == Opcode.opLoadAcquire 'opLoadAcquire'
		return "LoadAcquire"
	end 'opLoadAcquire'
	if op == Opcode.opStoreRelease 'opStoreRelease'
		return "StoreRelease"
	end 'opStoreRelease'
	if op == Opcode.opGlobalAddr 'opGlobalAddr'
		return "GlobalAddr"
	end 'opGlobalAddr'
	if op == Opcode.opCallImport 'opCallImport'
		return "CallImport"
	end 'opCallImport'
	if op == Opcode.opSyscall 'opSyscall'
		return "Syscall"
	end 'opSyscall'
	if op == Opcode.opAtomicAdd 'opAtomicAdd'
		return "AtomicAdd"
	end 'opAtomicAdd'
	if op == Opcode.opAtomicExchange 'opAtomicExchange'
		return "AtomicExchange"
	end 'opAtomicExchange'
	if op == Opcode.opCompareExchange 'opCompareExchange'
		return "CompareExchange"
	end 'opCompareExchange'
	if op == Opcode.opSpinPause 'opSpinPause'
		return "SpinPause"
	end 'opSpinPause'
	if op == Opcode.opThreadContext 'opThreadContext'
		return "ThreadContext"
	end 'opThreadContext'
	if op == Opcode.opCallCode 'opCallCode'
		return "CallCode"
	end 'opCallCode'
	if op == Opcode.opCallHost 'opCallHost'
		return "CallHost"
	end 'opCallHost'
	if op == Opcode.opCodeAddress 'opCodeAddress'
		return "CodeAddress"
	end 'opCodeAddress'
	if op == Opcode.opBin 'opBin'
		return "Bin"
	end 'opBin'
	if op == Opcode.opCmp 'opCmp'
		return "Cmp"
	end 'opCmp'
	if op == Opcode.opFBin 'opFBin'
		return "FBin"
	end 'opFBin'
	if op == Opcode.opFCmp 'opFCmp'
		return "FCmp"
	end 'opFCmp'
	if op == Opcode.opFUnary 'opFUnary'
		return "FUnary"
	end 'opFUnary'
	if op == Opcode.opIntToFloat 'opIntToFloat'
		return "IntToFloat"
	end 'opIntToFloat'
	if op == Opcode.opFloatToInt 'opFloatToInt'
		return "FloatToInt"
	end 'opFloatToInt'
	if op == Opcode.opNeg 'opNeg'
		return "Neg"
	end 'opNeg'
	if op == Opcode.opNot 'opNot'
		return "Not"
	end 'opNot'
	if op == Opcode.opTrailingZeros 'opTrailingZeros'
		return "TrailingZeros"
	end 'opTrailingZeros'
	if op == Opcode.opGuard 'opGuard'
		return "Guard"
	end 'opGuard'
	if op == Opcode.opLength 'opLength'
		return "Length"
	end 'opLength'
	if op == Opcode.opBounds 'opBounds'
		return "Bounds"
	end 'opBounds'
	if op == Opcode.opElemAddr 'opElemAddr'
		return "ElemAddr"
	end 'opElemAddr'
	if op == Opcode.opElemLoad 'opElemLoad'
		return "ElemLoad"
	end 'opElemLoad'
	if op == Opcode.opLoadByte 'opLoadByte'
		return "LoadByte"
	end 'opLoadByte'
	if op == Opcode.opBuffer 'opBuffer'
		return "Buffer"
	end 'opBuffer'
	if op == Opcode.opElemAt 'opElemAt'
		return "ElemAt"
	end 'opElemAt'
	if op == Opcode.opElemAddrAt 'opElemAddrAt'
		return "ElemAddrAt"
	end 'opElemAddrAt'
	if op == Opcode.opByteAt 'opByteAt'
		return "ByteAt"
	end 'opByteAt'
	if op == Opcode.opStrPtr 'opStrPtr'
		return "StrPtr"
	end 'opStrPtr'
	if op == Opcode.opStrBytes 'opStrBytes'
		return "StrBytes"
	end 'opStrBytes'
	if op == Opcode.opStrWord 'opStrWord'
		return "StrWord"
	end 'opStrWord'
	if op == Opcode.opStrMake 'opStrMake'
		return "StrMake"
	end 'opStrMake'
	if op == Opcode.opAlloc 'opAlloc'
		return "Alloc"
	end 'opAlloc'
	if op == Opcode.opCall 'opCall'
		return "Call"
	end 'opCall'
	if op == Opcode.opCallRuntime 'opCallRuntime'
		return "CallRuntime"
	end 'opCallRuntime'
	if op == Opcode.opWhen 'opWhen'
		return "When"
	end 'opWhen'
	if op == Opcode.opAsync 'opAsync'
		return "Async"
	end 'opAsync'
	if op == Opcode.opClosure 'opClosure'
		return "Closure"
	end 'opClosure'
	if op == Opcode.opFuncValue 'opFuncValue'
		return "FuncValue"
	end 'opFuncValue'
	if op == Opcode.opCallValue 'opCallValue'
		return "CallValue"
	end 'opCallValue'
	if op == Opcode.opBox 'opBox'
		return "Box"
	end 'opBox'
	if op == Opcode.opFrameBox 'opFrameBox'
		return "FrameBox"
	end 'opFrameBox'
	if op == Opcode.opFrameArea 'opFrameArea'
		return "FrameArea"
	end 'opFrameArea'
	if op == Opcode.opCallWitness 'opCallWitness'
		return "CallWitness"
	end 'opCallWitness'
	if op == Opcode.opIsType 'opIsType'
		return "IsType"
	end 'opIsType'
	if op == Opcode.opDrop 'opDrop'
		return "Drop"
	end 'opDrop'
	if op == Opcode.opDropSlot 'opDropSlot'
		return "DropSlot"
	end 'opDropSlot'
	if op == Opcode.opDropAt 'opDropAt'
		return "DropAt"
	end 'opDropAt'
	if op == Opcode.opMoveSlot 'opMoveSlot'
		return "MoveSlot"
	end 'opMoveSlot'
	if op == Opcode.opMoveAt 'opMoveAt'
		return "MoveAt"
	end 'opMoveAt'
	if op == Opcode.opCopy 'opCopy'
		return "Copy"
	end 'opCopy'
	return "none"
end 'opcodeName'

// wrongInstr stops the compiler: an accessor was given an instruction of a kind it does not read.
export function wrongInstr(accessor String, found Opcode)
	panic("ir: {accessor} was given a {opcodeName(found)}")
end 'wrongInstr'

// termKindName is the name of the kind of a terminator.
export function termKindName(kind TermKind) returns String
	if kind == TermKind.termJump 'termJump'
		return "Jump"
	end 'termJump'
	if kind == TermKind.termBranch 'termBranch'
		return "Branch"
	end 'termBranch'
	if kind == TermKind.termSwitch 'termSwitch'
		return "Switch"
	end 'termSwitch'
	if kind == TermKind.termRet 'termRet'
		return "Ret"
	end 'termRet'
	if kind == TermKind.termTrap 'termTrap'
		return "Trap"
	end 'termTrap'
	if kind == TermKind.termThrow 'termThrow'
		return "Throw"
	end 'termThrow'
	return "none"
end 'termKindName'

// wrongTerm stops the compiler: an accessor was given a terminator of a kind it does not read.
export function wrongTerm(accessor String, found TermKind)
	panic("ir: {accessor} was given a {termKindName(found)}")
end 'wrongTerm'

export function constValue(x Instr) returns Word
	if x.op != Opcode.opConst 'op'
		wrongInstr("constValue", found: x.op)
	end 'op'
	return x.imm
end 'constValue'

export function strText(f IrFunction, x Instr) returns String
	if x.op != Opcode.opStr 'op'
		wrongInstr("strText", found: x.op)
	end 'op'
	return f.stringAt(x.c)
end 'strText'

export function strCharacter(x Instr) returns bool
	if x.op != Opcode.opStr 'op'
		wrongInstr("strCharacter", found: x.op)
	end 'op'
	return (x.flags and flagCharacter) != 0
end 'strCharacter'

export function datumItem(x Instr) returns Count
	if x.op != Opcode.opDatum 'op'
		wrongInstr("datumItem", found: x.op)
	end 'op'
	return try x.c as Count otherwise panic("ir: datum item is out of range")
end 'datumItem'

export function loadSlotSlot(x Instr) returns Count
	if x.op != Opcode.opLoadSlot 'op'
		wrongInstr("loadSlotSlot", found: x.op)
	end 'op'
	return try x.imm as Count otherwise panic("ir: loadSlot slot is out of range")
end 'loadSlotSlot'

export function storeSlotSlot(x Instr) returns Count
	if x.op != Opcode.opStoreSlot 'op'
		wrongInstr("storeSlotSlot", found: x.op)
	end 'op'
	return try x.imm as Count otherwise panic("ir: storeSlot slot is out of range")
end 'storeSlotSlot'

export function storeSlotSrc(x Instr) returns Reg
	if x.op != Opcode.opStoreSlot 'op'
		wrongInstr("storeSlotSrc", found: x.op)
	end 'op'
	return x.a
end 'storeSlotSrc'

export function storeSlotBorrow(x Instr) returns bool
	if x.op != Opcode.opStoreSlot 'op'
		wrongInstr("storeSlotBorrow", found: x.op)
	end 'op'
	return (x.flags and flagBorrow) != 0
end 'storeSlotBorrow'

export function slotAddrSlot(x Instr) returns Count
	if x.op != Opcode.opSlotAddr 'op'
		wrongInstr("slotAddrSlot", found: x.op)
	end 'op'
	return try x.imm as Count otherwise panic("ir: slotAddr slot is out of range")
end 'slotAddrSlot'

