end 'storeReleaseSrc'

export function globalAddrSymbol(x Instr) returns Rt
	if x.op != Opcode.opGlobalAddr 'op'
		wrongInstr("globalAddrSymbol", found: x.op)
	end 'op'
	return rtOf(try x.imm as Count otherwise panic("ir: globalAddr symbol is out of range"))
end 'globalAddrSymbol'

export function callImportName(f IrFunction, x Instr) returns String
	if x.op != Opcode.opCallImport 'op'
		wrongInstr("callImportName", found: x.op)
	end 'op'
	return f.stringAt(x.c)
end 'callImportName'

// callImportArgsStart is where the args of a CallImport start in their pool.
export function callImportArgsStart(x Instr) returns Count
	if x.op != Opcode.opCallImport 'op'
		wrongInstr("callImportArgsStart", found: x.op)
	end 'op'
	return try x.a as Count otherwise panic("ir: callImport args is out of range")
end 'callImportArgsStart'

// callImportArgsCount is how many args a CallImport has.
export function callImportArgsCount(x Instr) returns Count
	if x.op != Opcode.opCallImport 'op'
		wrongInstr("callImportArgsCount", found: x.op)
	end 'op'
	return try x.b as Count otherwise panic("ir: callImport args is out of range")
end 'callImportArgsCount'

// syscallArgsStart is where the args of a Syscall start in their pool.
export function syscallArgsStart(x Instr) returns Count
	if x.op != Opcode.opSyscall 'op'
		wrongInstr("syscallArgsStart", found: x.op)
	end 'op'
	return try x.a as Count otherwise panic("ir: syscall args is out of range")
end 'syscallArgsStart'

// syscallArgsCount is how many args a Syscall has.
export function syscallArgsCount(x Instr) returns Count
	if x.op != Opcode.opSyscall 'op'
		wrongInstr("syscallArgsCount", found: x.op)
	end 'op'
