		return
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		out.push(x.dst)
		return
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		out.push(x.dst)
		return
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		if x.dst != noReg 'value'
			out.push(x.dst)
		end 'value'
		if callHasErrReg(x) 'error'
			out.push(callErrReg(x).unwrap())
		end 'error'
		return
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		if x.dst != noReg 'value'
			out.push(x.dst)
		end 'value'
		return
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		return
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		out.push(x.dst)
		return
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		out.push(x.dst)
		return
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		out.push(x.dst)
		return
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		if x.dst != noReg 'value'
			out.push(x.dst)
		end 'value'
		return
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		out.push(x.dst)
		return
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		out.push(x.dst)
		return
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		out.push(x.dst)
		return
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		if x.dst != noReg 'value'
			out.push(x.dst)
		end 'value'
		if callWitnessHasErrReg(x) 'error'
			out.push(callWitnessErrReg(x).unwrap())
		end 'error'
		return
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		out.push(x.dst)
		return
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		return
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		return
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		return
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		out.push(x.dst)
		return
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		out.push(x.dst)
		return
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		out.push(x.dst)
		return
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'instrWrites'

// renameInstrReads replaces each register r that an instruction reads, in its fields and in args, with names[r].
export function renameInstrReads(mutates x Instr, mutates args RegList, names RegList)
	if x.op == Opcode.opConst 'opConst'
		return
	end 'opConst'
	if x.op == Opcode.opStr 'opStr'
		return
	end 'opStr'
	if x.op == Opcode.opDatum 'opDatum'
		return
	end 'opDatum'
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		return
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		return
	end 'opSlotAddr'
	if x.op == Opcode.opLoadParam 'opLoadParam'
		return
	end 'opLoadParam'
	if x.op == Opcode.opLoadField 'opLoadField'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opLoadField'
	if x.op == Opcode.opStoreField 'opStoreField'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opStoreField'
	if x.op == Opcode.opFieldAddr 'opFieldAddr'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opFieldAddr'
	if x.op == Opcode.opLoadAt 'opLoadAt'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opLoadAt'
	if x.op == Opcode.opStoreAt 'opStoreAt'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opStoreAt'
	if x.op == Opcode.opLoadGlobal 'opLoadGlobal'
		return
	end 'opLoadGlobal'
	if x.op == Opcode.opLoadRaw 'opLoadRaw'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opLoadRaw'
	if x.op == Opcode.opStoreRaw 'opStoreRaw'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opStoreRaw'
	if x.op == Opcode.opLoadAcquire 'opLoadAcquire'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opLoadAcquire'
	if x.op == Opcode.opStoreRelease 'opStoreRelease'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opStoreRelease'
	if x.op == Opcode.opGlobalAddr 'opGlobalAddr'
		return
	end 'opGlobalAddr'
	if x.op == Opcode.opCallImport 'opCallImport'
		renameRegs(args, start: callImportArgsStart(x), count: callImportArgsCount(x), names: names)
		return
	end 'opCallImport'
	if x.op == Opcode.opSyscall 'opSyscall'
		renameRegs(args, start: syscallArgsStart(x), count: syscallArgsCount(x), names: names)
		return
	end 'opSyscall'
	if x.op == Opcode.opAtomicAdd 'opAtomicAdd'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opAtomicAdd'
	if x.op == Opcode.opAtomicExchange 'opAtomicExchange'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opAtomicExchange'
	if x.op == Opcode.opCompareExchange 'opCompareExchange'
		renameRegs(args, start: compareExchangeArgsStart(x), count: compareExchangeArgsCount(x), names: names)
		return
	end 'opCompareExchange'
	if x.op == Opcode.opSpinPause 'opSpinPause'
		return
	end 'opSpinPause'
	if x.op == Opcode.opThreadContext 'opThreadContext'
		return
	end 'opThreadContext'
	if x.op == Opcode.opCallCode 'opCallCode'
		renameRegs(args, start: callCodeArgsStart(x), count: callCodeArgsCount(x), names: names)
		return
	end 'opCallCode'
	if x.op == Opcode.opCallHost 'opCallHost'
		renameRegs(args, start: callHostArgsStart(x), count: callHostArgsCount(x), names: names)
		return
	end 'opCallHost'
	if x.op == Opcode.opCodeAddress 'opCodeAddress'
		return
	end 'opCodeAddress'
	if x.op == Opcode.opBin 'opBin'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opBin'
	if x.op == Opcode.opCmp 'opCmp'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opCmp'
	if x.op == Opcode.opFBin 'opFBin'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opFBin'
	if x.op == Opcode.opFCmp 'opFCmp'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opFCmp'
	if x.op == Opcode.opFUnary 'opFUnary'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opFUnary'
	if x.op == Opcode.opIntToFloat 'opIntToFloat'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opIntToFloat'
	if x.op == Opcode.opFloatToInt 'opFloatToInt'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opFloatToInt'
	if x.op == Opcode.opNeg 'opNeg'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opNeg'
	if x.op == Opcode.opNot 'opNot'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opNot'
	if x.op == Opcode.opTrailingZeros 'opTrailingZeros'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opTrailingZeros'
	if x.op == Opcode.opGuard 'opGuard'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opGuard'
	if x.op == Opcode.opLength 'opLength'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opLength'
	if x.op == Opcode.opBounds 'opBounds'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opBounds'
	if x.op == Opcode.opElemAddr 'opElemAddr'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opElemAddr'
	if x.op == Opcode.opElemLoad 'opElemLoad'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opElemLoad'
	if x.op == Opcode.opLoadByte 'opLoadByte'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opLoadByte'
	if x.op == Opcode.opBuffer 'opBuffer'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opBuffer'
	if x.op == Opcode.opElemAt 'opElemAt'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opElemAt'
	if x.op == Opcode.opElemAddrAt 'opElemAddrAt'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opElemAddrAt'
	if x.op == Opcode.opByteAt 'opByteAt'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opByteAt'
	if x.op == Opcode.opStrPtr 'opStrPtr'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opStrPtr'
	if x.op == Opcode.opStrBytes 'opStrBytes'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opStrBytes'
	if x.op == Opcode.opStrWord 'opStrWord'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		x.a = renamedReg(names, r: x.a)
		x.b = renamedReg(names, r: x.b)
		return
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		return
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		renameRegs(args, start: callArgsStart(x), count: callArgsCount(x), names: names)
		return
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		renameRegs(args, start: callRuntimeArgsStart(x), count: callRuntimeArgsCount(x), names: names)
		return
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		renameRegs(args, start: whenCownsStart(x), count: whenCownsCount(x), names: names)
		renameRegs(args, start: whenCapturesStart(x), count: whenCapturesCount(x), names: names)
		return
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		renameRegs(args, start: asyncArgsStart(x), count: asyncArgsCount(x), names: names)
		return
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		renameRegs(args, start: closureCapturesStart(x), count: closureCapturesCount(x), names: names)
		return
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		return
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		renameRegs(args, start: callValueArgsStart(x), count: callValueArgsCount(x), names: names)
		return
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		return
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		renameRegs(args, start: callWitnessArgsStart(x), count: callWitnessArgsCount(x), names: names)
		return
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		return
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		return
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		x.a = renamedReg(names, r: x.a)
		return
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'renameInstrReads'

// renameTermReads replaces each register r that a terminator reads, its value and the arguments of its edges, with
// names[r].
export function renameTermReads(mutates t Term, mutates args RegList, cases CaseList, names RegList)
	if t.kind == TermKind.termJump 'termJump'
		renameRegs(args, start: jumpArgsStart(t), count: jumpArgsCount(t), names: names)
		return
	end 'termJump'
	if t.kind == TermKind.termBranch 'termBranch'
		t.value = renamedReg(names, r: t.value)
		renameRegs(args, start: branchTrueArgsStart(t), count: branchTrueArgsCount(t), names: names)
		renameRegs(args, start: branchFalseArgsStart(t), count: branchFalseArgsCount(t), names: names)
		return
	end 'termBranch'
	if t.kind == TermKind.termSwitch 'termSwitch'
		t.value = renamedReg(names, r: t.value)
		renameCaseArgs(args, cases: cases, start: switchCasesStart(t), count: switchCasesCount(t), names: names)
		renameRegs(args, start: switchFallbackArgsStart(t), count: switchFallbackArgsCount(t), names: names)
		return
	end 'termSwitch'
	if t.kind == TermKind.termRet 'termRet'
		t.value = renamedReg(names, r: t.value)
		return
	end 'termRet'
	if t.kind == TermKind.termTrap 'termTrap'
		return
	end 'termTrap'
	if t.kind == TermKind.termThrow 'termThrow'
		t.value = renamedReg(names, r: t.value)
		return
	end 'termThrow'
	panic("ir: a block has no terminator")
end 'renameTermReads'

// setInstrSlot makes an instruction that names a slot name the slot slot instead.
export function setInstrSlot(mutates x Instr, slot Count)
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		x.imm = try slot as Word otherwise panic("ir: loadSlot slot is out of range")
		return
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		x.imm = try slot as Word otherwise panic("ir: storeSlot slot is out of range")
		return
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		x.imm = try slot as Word otherwise panic("ir: slotAddr slot is out of range")
		return
	end 'opSlotAddr'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		x.imm = try slot as Word otherwise panic("ir: dropSlot slot is out of range")
		return
	end 'opDropSlot'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		x.imm = try slot as Word otherwise panic("ir: moveSlot slot is out of range")
		return
	end 'opMoveSlot'
	panic("ir: an instruction that names no slot is given one")
end 'setInstrSlot'

// relocateInstr makes an instruction of one function one of another, as at says: the registers it reads and writes
// renamed, the block it fails to renumbered, and each index into a pool moved to where the other's pools hold the first's.
export function relocateInstr(mutates x Instr, at Relocation)
	if x.op == Opcode.opConst 'opConst'
		x.dst = renamedReg(at.names, r: x.dst)
		return
	end 'opConst'
	if x.op == Opcode.opStr 'opStr'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = shiftedIndex(x.c, by: at.strings)
		return
	end 'opStr'
	if x.op == Opcode.opDatum 'opDatum'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = remappedIndex(at.datums, i: x.c)
		return
	end 'opDatum'
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		x.dst = renamedReg(at.names, r: x.dst)
		x.imm = shiftedWord(x.imm, by: at.slots)
		return
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		x.imm = shiftedWord(x.imm, by: at.slots)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		x.dst = renamedReg(at.names, r: x.dst)
		x.imm = shiftedWord(x.imm, by: at.slots)
		return
	end 'opSlotAddr'
	if x.op == Opcode.opLoadParam 'opLoadParam'
		x.dst = renamedReg(at.names, r: x.dst)
		return
	end 'opLoadParam'
	if x.op == Opcode.opLoadField 'opLoadField'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opLoadField'
	if x.op == Opcode.opStoreField 'opStoreField'
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opStoreField'
	if x.op == Opcode.opFieldAddr 'opFieldAddr'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opFieldAddr'
	if x.op == Opcode.opLoadAt 'opLoadAt'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opLoadAt'
	if x.op == Opcode.opStoreAt 'opStoreAt'
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opStoreAt'
	if x.op == Opcode.opLoadGlobal 'opLoadGlobal'
		x.dst = renamedReg(at.names, r: x.dst)
		return
	end 'opLoadGlobal'
	if x.op == Opcode.opLoadRaw 'opLoadRaw'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opLoadRaw'
	if x.op == Opcode.opStoreRaw 'opStoreRaw'
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opStoreRaw'
	if x.op == Opcode.opLoadAcquire 'opLoadAcquire'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opLoadAcquire'
	if x.op == Opcode.opStoreRelease 'opStoreRelease'
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opStoreRelease'
	if x.op == Opcode.opGlobalAddr 'opGlobalAddr'
		x.dst = renamedReg(at.names, r: x.dst)
		return
	end 'opGlobalAddr'
	if x.op == Opcode.opCallImport 'opCallImport'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = shiftedIndex(x.c, by: at.strings)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opCallImport'
	if x.op == Opcode.opSyscall 'opSyscall'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opSyscall'
	if x.op == Opcode.opAtomicAdd 'opAtomicAdd'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opAtomicAdd'
	if x.op == Opcode.opAtomicExchange 'opAtomicExchange'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opAtomicExchange'
	if x.op == Opcode.opCompareExchange 'opCompareExchange'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opCompareExchange'
	if x.op == Opcode.opSpinPause 'opSpinPause'
		return
	end 'opSpinPause'
	if x.op == Opcode.opThreadContext 'opThreadContext'
		x.dst = renamedReg(at.names, r: x.dst)
		return
	end 'opThreadContext'
	if x.op == Opcode.opCallCode 'opCallCode'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opCallCode'
	if x.op == Opcode.opCallHost 'opCallHost'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opCallHost'
	if x.op == Opcode.opCodeAddress 'opCodeAddress'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = shiftedIndex(x.c, by: at.callees)
		return
	end 'opCodeAddress'
	if x.op == Opcode.opBin 'opBin'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		if (x.flags and flagChecked) != 0 'fail'
			x.c = relocatedBlock(at.blocks, b: x.c as BlockID) as Index
		end 'fail'
		return
	end 'opBin'
	if x.op == Opcode.opCmp 'opCmp'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opCmp'
	if x.op == Opcode.opFBin 'opFBin'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opFBin'
	if x.op == Opcode.opFCmp 'opFCmp'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opFCmp'
	if x.op == Opcode.opFUnary 'opFUnary'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opFUnary'
	if x.op == Opcode.opIntToFloat 'opIntToFloat'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opIntToFloat'
	if x.op == Opcode.opFloatToInt 'opFloatToInt'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opFloatToInt'
	if x.op == Opcode.opNeg 'opNeg'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		if (x.flags and flagChecked) != 0 'fail'
			x.c = relocatedBlock(at.blocks, b: x.c as BlockID) as Index
		end 'fail'
		return
	end 'opNeg'
	if x.op == Opcode.opNot 'opNot'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opNot'
	if x.op == Opcode.opTrailingZeros 'opTrailingZeros'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opTrailingZeros'
	if x.op == Opcode.opGuard 'opGuard'
		x.a = renamedReg(at.names, r: x.a)
		x.c = relocatedBlock(at.blocks, b: x.c as BlockID) as Index
		return
	end 'opGuard'
	if x.op == Opcode.opLength 'opLength'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opLength'
	if x.op == Opcode.opBounds 'opBounds'
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		x.c = relocatedBlock(at.blocks, b: x.c as BlockID) as Index
		return
	end 'opBounds'
	if x.op == Opcode.opElemAddr 'opElemAddr'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opElemAddr'
	if x.op == Opcode.opElemLoad 'opElemLoad'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opElemLoad'
	if x.op == Opcode.opLoadByte 'opLoadByte'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opLoadByte'
	if x.op == Opcode.opBuffer 'opBuffer'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opBuffer'
	if x.op == Opcode.opElemAt 'opElemAt'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opElemAt'
	if x.op == Opcode.opElemAddrAt 'opElemAddrAt'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opElemAddrAt'
	if x.op == Opcode.opByteAt 'opByteAt'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opByteAt'
	if x.op == Opcode.opStrPtr 'opStrPtr'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opStrPtr'
	if x.op == Opcode.opStrBytes 'opStrBytes'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.imm = shiftedWord(x.imm, by: at.frameBoxes)
		return
	end 'opStrBytes'
	if x.op == Opcode.opStrWord 'opStrWord'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.b = renamedReg(at.names, r: x.b)
		return
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		x.dst = renamedReg(at.names, r: x.dst)
		return
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		if x.dst != noReg 'value'
			x.dst = renamedReg(at.names, r: x.dst)
		end 'value'
		x.c = shiftedIndex(x.c, by: at.callees)
		x.a = shiftedReg(x.a, by: at.args)
		if (x.flags and flagThrows) != 0 'errReg'
			x.imm = renamedReg(at.names, r: try x.imm as Reg otherwise panic("ir: call errReg is out of range")) as Word
		end 'errReg'
		return
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		if x.dst != noReg 'value'
			x.dst = renamedReg(at.names, r: x.dst)
		end 'value'
		x.a = shiftedReg(x.a, by: at.args)
		if x.c != noRoutine 'routine'
			x.c = shiftedIndex(x.c, by: at.callees)
		end 'routine'
		return
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		x.imm = shiftedWord(x.imm, by: at.bodies)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = shiftedIndex(x.c, by: at.callees)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		x.dst = renamedReg(at.names, r: x.dst)
		x.imm = shiftedWord(x.imm, by: at.bodies)
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = shiftedIndex(x.c, by: at.callees)
		return
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		if x.dst != noReg 'value'
			x.dst = renamedReg(at.names, r: x.dst)
		end 'value'
		x.a = shiftedReg(x.a, by: at.args)
		return
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = remappedIndex(at.tables, i: x.c)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		x.dst = renamedReg(at.names, r: x.dst)
		x.c = remappedIndex(at.tables, i: x.c)
		x.a = renamedReg(at.names, r: x.a)
		x.imm = shiftedWord(x.imm, by: at.frameBoxes)
		return
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		x.dst = renamedReg(at.names, r: x.dst)
		x.imm = shiftedWord(x.imm, by: at.frameBoxes)
		return
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		if x.dst != noReg 'value'
			x.dst = renamedReg(at.names, r: x.dst)
		end 'value'
		x.a = shiftedReg(x.a, by: at.args)
		if (x.flags and flagThrows) != 0 'errReg'
			x.imm = renamedReg(at.names, r: try x.imm as Reg otherwise panic("ir: callWitness errReg is out of range")) as Word
		end 'errReg'
		return
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.c = shiftedIndex(x.c, by: at.types)
		return
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		x.a = renamedReg(at.names, r: x.a)
		x.c = shiftedIndex(x.c, by: at.types)
		return
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		x.imm = shiftedWord(x.imm, by: at.slots)
		x.c = shiftedIndex(x.c, by: at.types)
		return
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		x.a = renamedReg(at.names, r: x.a)
		x.c = shiftedIndex(x.c, by: at.types)
		return
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		x.dst = renamedReg(at.names, r: x.dst)
		x.imm = shiftedWord(x.imm, by: at.slots)
		return
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		return
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		x.dst = renamedReg(at.names, r: x.dst)
		x.a = renamedReg(at.names, r: x.a)
		x.c = shiftedIndex(x.c, by: at.types)
		return
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'relocateInstr'

// relocateTerm makes a terminator of one function one of another, as at says: the registers it reads renamed, the
// blocks it goes to renumbered, and its edges' arguments and its cases moved to where the other's pools hold the first's.
export function relocateTerm(mutates t Term, at Relocation)
	if t.kind == TermKind.termJump 'termJump'
		t.target = relocatedBlock(at.blocks, b: t.target)
		t.args = shiftedIndex(t.args, by: at.args)
		return
	end 'termJump'
	if t.kind == TermKind.termBranch 'termBranch'
		t.value = renamedReg(at.names, r: t.value)
		t.target = relocatedBlock(at.blocks, b: t.target)
		t.args = shiftedIndex(t.args, by: at.args)
		t.other = relocatedBlock(at.blocks, b: t.other)
		return
	end 'termBranch'
	if t.kind == TermKind.termSwitch 'termSwitch'
		t.value = renamedReg(at.names, r: t.value)
		t.first = shiftedIndex(t.first, by: at.cases)
		t.target = relocatedBlock(at.blocks, b: t.target)
		t.args = shiftedIndex(t.args, by: at.args)
		return
	end 'termSwitch'
	if t.kind == TermKind.termRet 'termRet'
		t.value = renamedReg(at.names, r: t.value)
		return
	end 'termRet'
	if t.kind == TermKind.termTrap 'termTrap'
		return
	end 'termTrap'
	if t.kind == TermKind.termThrow 'termThrow'
		t.value = renamedReg(at.names, r: t.value)
		return
	end 'termThrow'
	panic("ir: a block has no terminator")
end 'relocateTerm'

// InstrVisitor has a method for every kind of instr, so one added to the table fails the build where it is not handled yet.
export interface InstrVisitor
	function visitConst(mutates self, f IrFunction, x Instr)
	function visitStr(mutates self, f IrFunction, x Instr)
	function visitDatum(mutates self, f IrFunction, x Instr)
	function visitLoadSlot(mutates self, f IrFunction, x Instr)
	function visitStoreSlot(mutates self, f IrFunction, x Instr)
	function visitSlotAddr(mutates self, f IrFunction, x Instr)
	function visitLoadParam(mutates self, f IrFunction, x Instr)
	function visitLoadField(mutates self, f IrFunction, x Instr)
	function visitStoreField(mutates self, f IrFunction, x Instr)
	function visitFieldAddr(mutates self, f IrFunction, x Instr)
	function visitLoadAt(mutates self, f IrFunction, x Instr)
	function visitStoreAt(mutates self, f IrFunction, x Instr)
	function visitLoadGlobal(mutates self, f IrFunction, x Instr)
	function visitLoadRaw(mutates self, f IrFunction, x Instr)
	function visitStoreRaw(mutates self, f IrFunction, x Instr)
	function visitLoadAcquire(mutates self, f IrFunction, x Instr)
	function visitStoreRelease(mutates self, f IrFunction, x Instr)
	function visitGlobalAddr(mutates self, f IrFunction, x Instr)
	function visitCallImport(mutates self, f IrFunction, x Instr)
	function visitSyscall(mutates self, f IrFunction, x Instr)
	function visitAtomicAdd(mutates self, f IrFunction, x Instr)
	function visitAtomicExchange(mutates self, f IrFunction, x Instr)
	function visitCompareExchange(mutates self, f IrFunction, x Instr)
	function visitSpinPause(mutates self, f IrFunction, x Instr)
	function visitThreadContext(mutates self, f IrFunction, x Instr)
	function visitCallCode(mutates self, f IrFunction, x Instr)
	function visitCallHost(mutates self, f IrFunction, x Instr)
	function visitCodeAddress(mutates self, f IrFunction, x Instr)
	function visitBin(mutates self, f IrFunction, x Instr)
	function visitCmp(mutates self, f IrFunction, x Instr)
	function visitFBin(mutates self, f IrFunction, x Instr)
	function visitFCmp(mutates self, f IrFunction, x Instr)
	function visitFUnary(mutates self, f IrFunction, x Instr)
	function visitIntToFloat(mutates self, f IrFunction, x Instr)
	function visitFloatToInt(mutates self, f IrFunction, x Instr)
	function visitNeg(mutates self, f IrFunction, x Instr)
	function visitNot(mutates self, f IrFunction, x Instr)
	function visitTrailingZeros(mutates self, f IrFunction, x Instr)
	function visitGuard(mutates self, f IrFunction, x Instr)
	function visitLength(mutates self, f IrFunction, x Instr)
	function visitBounds(mutates self, f IrFunction, x Instr)
	function visitElemAddr(mutates self, f IrFunction, x Instr)
	function visitElemLoad(mutates self, f IrFunction, x Instr)
	function visitLoadByte(mutates self, f IrFunction, x Instr)
	function visitBuffer(mutates self, f IrFunction, x Instr)
	function visitElemAt(mutates self, f IrFunction, x Instr)
	function visitElemAddrAt(mutates self, f IrFunction, x Instr)
	function visitByteAt(mutates self, f IrFunction, x Instr)
	function visitStrPtr(mutates self, f IrFunction, x Instr)
	function visitStrBytes(mutates self, f IrFunction, x Instr)
	function visitStrWord(mutates self, f IrFunction, x Instr)
	function visitStrMake(mutates self, f IrFunction, x Instr)
	function visitAlloc(mutates self, f IrFunction, x Instr)
	function visitCall(mutates self, f IrFunction, x Instr)
	function visitCallRuntime(mutates self, f IrFunction, x Instr)
	function visitWhen(mutates self, f IrFunction, x Instr)
	function visitAsync(mutates self, f IrFunction, x Instr)
	function visitClosure(mutates self, f IrFunction, x Instr)
	function visitFuncValue(mutates self, f IrFunction, x Instr)
	function visitCallValue(mutates self, f IrFunction, x Instr)
	function visitBox(mutates self, f IrFunction, x Instr)
	function visitFrameBox(mutates self, f IrFunction, x Instr)
	function visitFrameArea(mutates self, f IrFunction, x Instr)
	function visitCallWitness(mutates self, f IrFunction, x Instr)
	function visitIsType(mutates self, f IrFunction, x Instr)
	function visitDrop(mutates self, f IrFunction, x Instr)
	function visitDropSlot(mutates self, f IrFunction, x Instr)
	function visitDropAt(mutates self, f IrFunction, x Instr)
	function visitMoveSlot(mutates self, f IrFunction, x Instr)
	function visitMoveAt(mutates self, f IrFunction, x Instr)
	function visitCopy(mutates self, f IrFunction, x Instr)
end 'InstrVisitor'

// visitInstr calls the method of the visitor for the op of x.
export function visitInstr(mutates visitor V, f IrFunction, x Instr) uses V where V implements InstrVisitor
	if x.op == Opcode.opConst 'opConst'
		visitor.visitConst(f, x: x)
		return
	end 'opConst'
	if x.op == Opcode.opStr 'opStr'
		visitor.visitStr(f, x: x)
		return
	end 'opStr'
	if x.op == Opcode.opDatum 'opDatum'
		visitor.visitDatum(f, x: x)
		return
	end 'opDatum'
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		visitor.visitLoadSlot(f, x: x)
		return
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		visitor.visitStoreSlot(f, x: x)
		return
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		visitor.visitSlotAddr(f, x: x)
		return
	end 'opSlotAddr'
	if x.op == Opcode.opLoadParam 'opLoadParam'
		visitor.visitLoadParam(f, x: x)
		return
	end 'opLoadParam'
	if x.op == Opcode.opLoadField 'opLoadField'
		visitor.visitLoadField(f, x: x)
		return
	end 'opLoadField'
	if x.op == Opcode.opStoreField 'opStoreField'
		visitor.visitStoreField(f, x: x)
		return
	end 'opStoreField'
	if x.op == Opcode.opFieldAddr 'opFieldAddr'
		visitor.visitFieldAddr(f, x: x)
		return
	end 'opFieldAddr'
	if x.op == Opcode.opLoadAt 'opLoadAt'
		visitor.visitLoadAt(f, x: x)
		return
	end 'opLoadAt'
	if x.op == Opcode.opStoreAt 'opStoreAt'
		visitor.visitStoreAt(f, x: x)
		return
	end 'opStoreAt'
	if x.op == Opcode.opLoadGlobal 'opLoadGlobal'
		visitor.visitLoadGlobal(f, x: x)
		return
	end 'opLoadGlobal'
	if x.op == Opcode.opLoadRaw 'opLoadRaw'
		visitor.visitLoadRaw(f, x: x)
		return
	end 'opLoadRaw'
	if x.op == Opcode.opStoreRaw 'opStoreRaw'
		visitor.visitStoreRaw(f, x: x)
		return
	end 'opStoreRaw'
	if x.op == Opcode.opLoadAcquire 'opLoadAcquire'
		visitor.visitLoadAcquire(f, x: x)
		return
	end 'opLoadAcquire'
	if x.op == Opcode.opStoreRelease 'opStoreRelease'
		visitor.visitStoreRelease(f, x: x)
		return
	end 'opStoreRelease'
	if x.op == Opcode.opGlobalAddr 'opGlobalAddr'
		visitor.visitGlobalAddr(f, x: x)
		return
	end 'opGlobalAddr'
	if x.op == Opcode.opCallImport 'opCallImport'
		visitor.visitCallImport(f, x: x)
		return
	end 'opCallImport'
	if x.op == Opcode.opSyscall 'opSyscall'
		visitor.visitSyscall(f, x: x)
		return
	end 'opSyscall'
	if x.op == Opcode.opAtomicAdd 'opAtomicAdd'
		visitor.visitAtomicAdd(f, x: x)
		return
	end 'opAtomicAdd'
	if x.op == Opcode.opAtomicExchange 'opAtomicExchange'
		visitor.visitAtomicExchange(f, x: x)
		return
	end 'opAtomicExchange'
	if x.op == Opcode.opCompareExchange 'opCompareExchange'
		visitor.visitCompareExchange(f, x: x)
		return
	end 'opCompareExchange'
	if x.op == Opcode.opSpinPause 'opSpinPause'
		visitor.visitSpinPause(f, x: x)
		return
	end 'opSpinPause'
	if x.op == Opcode.opThreadContext 'opThreadContext'
		visitor.visitThreadContext(f, x: x)
		return
	end 'opThreadContext'
	if x.op == Opcode.opCallCode 'opCallCode'
		visitor.visitCallCode(f, x: x)
		return
	end 'opCallCode'
	if x.op == Opcode.opCallHost 'opCallHost'
		visitor.visitCallHost(f, x: x)
		return
	end 'opCallHost'
	if x.op == Opcode.opCodeAddress 'opCodeAddress'
		visitor.visitCodeAddress(f, x: x)
		return
	end 'opCodeAddress'
	if x.op == Opcode.opBin 'opBin'
		visitor.visitBin(f, x: x)
		return
	end 'opBin'
	if x.op == Opcode.opCmp 'opCmp'
		visitor.visitCmp(f, x: x)
		return
	end 'opCmp'
	if x.op == Opcode.opFBin 'opFBin'
		visitor.visitFBin(f, x: x)
		return
	end 'opFBin'
	if x.op == Opcode.opFCmp 'opFCmp'
		visitor.visitFCmp(f, x: x)
		return
	end 'opFCmp'
	if x.op == Opcode.opFUnary 'opFUnary'
		visitor.visitFUnary(f, x: x)
		return
	end 'opFUnary'
	if x.op == Opcode.opIntToFloat 'opIntToFloat'
		visitor.visitIntToFloat(f, x: x)
		return
	end 'opIntToFloat'
	if x.op == Opcode.opFloatToInt 'opFloatToInt'
		visitor.visitFloatToInt(f, x: x)
		return
	end 'opFloatToInt'
	if x.op == Opcode.opNeg 'opNeg'
		visitor.visitNeg(f, x: x)
		return
	end 'opNeg'
	if x.op == Opcode.opNot 'opNot'
		visitor.visitNot(f, x: x)
		return
	end 'opNot'
	if x.op == Opcode.opTrailingZeros 'opTrailingZeros'
		visitor.visitTrailingZeros(f, x: x)
		return
	end 'opTrailingZeros'
	if x.op == Opcode.opGuard 'opGuard'
		visitor.visitGuard(f, x: x)
		return
	end 'opGuard'
	if x.op == Opcode.opLength 'opLength'
		visitor.visitLength(f, x: x)
		return
	end 'opLength'
	if x.op == Opcode.opBounds 'opBounds'
		visitor.visitBounds(f, x: x)
		return
	end 'opBounds'
	if x.op == Opcode.opElemAddr 'opElemAddr'
		visitor.visitElemAddr(f, x: x)
		return
	end 'opElemAddr'
	if x.op == Opcode.opElemLoad 'opElemLoad'
		visitor.visitElemLoad(f, x: x)
		return
	end 'opElemLoad'
	if x.op == Opcode.opLoadByte 'opLoadByte'
		visitor.visitLoadByte(f, x: x)
		return
	end 'opLoadByte'
	if x.op == Opcode.opBuffer 'opBuffer'
		visitor.visitBuffer(f, x: x)
		return
	end 'opBuffer'
	if x.op == Opcode.opElemAt 'opElemAt'
		visitor.visitElemAt(f, x: x)
		return
	end 'opElemAt'
	if x.op == Opcode.opElemAddrAt 'opElemAddrAt'
		visitor.visitElemAddrAt(f, x: x)
		return
	end 'opElemAddrAt'
	if x.op == Opcode.opByteAt 'opByteAt'
		visitor.visitByteAt(f, x: x)
		return
	end 'opByteAt'
	if x.op == Opcode.opStrPtr 'opStrPtr'
		visitor.visitStrPtr(f, x: x)
		return
	end 'opStrPtr'
	if x.op == Opcode.opStrBytes 'opStrBytes'
		visitor.visitStrBytes(f, x: x)
		return
	end 'opStrBytes'
	if x.op == Opcode.opStrWord 'opStrWord'
		visitor.visitStrWord(f, x: x)
		return
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		visitor.visitStrMake(f, x: x)
		return
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		visitor.visitAlloc(f, x: x)
		return
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		visitor.visitCall(f, x: x)
		return
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		visitor.visitCallRuntime(f, x: x)
		return
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		visitor.visitWhen(f, x: x)
		return
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		visitor.visitAsync(f, x: x)
		return
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		visitor.visitClosure(f, x: x)
		return
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		visitor.visitFuncValue(f, x: x)
		return
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		visitor.visitCallValue(f, x: x)
		return
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		visitor.visitBox(f, x: x)
		return
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		visitor.visitFrameBox(f, x: x)
		return
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		visitor.visitFrameArea(f, x: x)
		return
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		visitor.visitCallWitness(f, x: x)
		return
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		visitor.visitIsType(f, x: x)
		return
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		visitor.visitDrop(f, x: x)
		return
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		visitor.visitDropSlot(f, x: x)
		return
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		visitor.visitDropAt(f, x: x)
		return
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		visitor.visitMoveSlot(f, x: x)
		return
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		visitor.visitMoveAt(f, x: x)
		return
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		visitor.visitCopy(f, x: x)
		return
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'visitInstr'

// TermVisitor has a method for every kind of term, so one added to the table fails the build where it is not handled yet.
export interface TermVisitor
	function visitJump(mutates self, f IrFunction, t Term)
	function visitBranch(mutates self, f IrFunction, t Term)
	function visitSwitch(mutates self, f IrFunction, t Term)
	function visitRet(mutates self, f IrFunction, t Term)
	function visitTrap(mutates self, f IrFunction, t Term)
	function visitThrow(mutates self, f IrFunction, t Term)
end 'TermVisitor'

// visitTerm calls the method of the visitor for the kind of t.
export function visitTerm(mutates visitor V, f IrFunction, t Term) uses V where V implements TermVisitor
	if t.kind == TermKind.termJump 'termJump'
		visitor.visitJump(f, t: t)
		return
	end 'termJump'
	if t.kind == TermKind.termBranch 'termBranch'
		visitor.visitBranch(f, t: t)
		return
	end 'termBranch'
	if t.kind == TermKind.termSwitch 'termSwitch'
		visitor.visitSwitch(f, t: t)
		return
	end 'termSwitch'
	if t.kind == TermKind.termRet 'termRet'
		visitor.visitRet(f, t: t)
		return
	end 'termRet'
	if t.kind == TermKind.termTrap 'termTrap'
		visitor.visitTrap(f, t: t)
		return
	end 'termTrap'
	if t.kind == TermKind.termThrow 'termThrow'
		visitor.visitThrow(f, t: t)
		return
	end 'termThrow'
	panic("ir: a block has no terminator")
end 'visitTerm'

// instrText is the text the printer gives an instruction, as Go's InstrString does.
export function instrText(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ft ast.FuncSlot, funcReads ast.FuncTable, f IrFunction, x Instr) returns String
	if x.op == Opcode.opConst 'opConst'
		return "{resultText(x.dst)}const {constValue(x)}"
	end 'opConst'
	if x.op == Opcode.opStr 'opStr'
		var text = "{resultText(x.dst)}str {quote(strText(f, x: x))}"
		if strCharacter(x) 'character'
			text = "{text} character"
		end 'character'
		return text
	end 'opStr'
	if x.op == Opcode.opDatum 'opDatum'
		return "{resultText(x.dst)}datum {datumItem(x)}"
	end 'opDatum'
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		return "{resultText(x.dst)}load s{loadSlotSlot(x)}"
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		var text = "store s{storeSlotSlot(x)}, %{storeSlotSrc(x)}"
		if storeSlotBorrow(x) 'borrow'
			text = "{text} borrow"
		end 'borrow'
		return text
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		return "{resultText(x.dst)}addr s{slotAddrSlot(x)}"
	end 'opSlotAddr'
	if x.op == Opcode.opLoadParam 'opLoadParam'
		return "{resultText(x.dst)}param {loadParamParam(x)}"
	end 'opLoadParam'
	if x.op == Opcode.opLoadField 'opLoadField'
		return "{resultText(x.dst)}field %{loadFieldObj(x)}+{loadFieldOffset(x)}"
	end 'opLoadField'
	if x.op == Opcode.opStoreField 'opStoreField'
		var text = "setfield %{storeFieldObj(x)}+{storeFieldOffset(x)}, %{storeFieldSrc(x)}"
		if storeFieldBorrow(x) 'borrow'
			text = "{text} borrow"
		end 'borrow'
		return text
	end 'opStoreField'
	if x.op == Opcode.opFieldAddr 'opFieldAddr'
		return "{resultText(x.dst)}fieldaddr %{fieldAddrObj(x)}+{fieldAddrOffset(x)}"
	end 'opFieldAddr'
	if x.op == Opcode.opLoadAt 'opLoadAt'
		return "{resultText(x.dst)}loadat %{loadAtAddr(x)}"
	end 'opLoadAt'
	if x.op == Opcode.opStoreAt 'opStoreAt'
		return "storeat %{storeAtAddr(x)}, %{storeAtSrc(x)}"
	end 'opStoreAt'
	if x.op == Opcode.opLoadGlobal 'opLoadGlobal'
		return "{resultText(x.dst)}global {rtText(loadGlobalSymbol(x))}"
	end 'opLoadGlobal'
	if x.op == Opcode.opLoadRaw 'opLoadRaw'
		return "{resultText(x.dst)}loadraw.{rawWidthText(loadRawWidth(x))} %{loadRawAddr(x)}"
	end 'opLoadRaw'
	if x.op == Opcode.opStoreRaw 'opStoreRaw'
		return "storeraw.{rawWidthText(storeRawWidth(x))} %{storeRawAddr(x)}, %{storeRawSrc(x)}"
	end 'opStoreRaw'
	if x.op == Opcode.opLoadAcquire 'opLoadAcquire'
		return "{resultText(x.dst)}loadacquire %{loadAcquireAddr(x)}"
	end 'opLoadAcquire'
	if x.op == Opcode.opStoreRelease 'opStoreRelease'
		return "storerelease %{storeReleaseAddr(x)}, %{storeReleaseSrc(x)}"
	end 'opStoreRelease'
	if x.op == Opcode.opGlobalAddr 'opGlobalAddr'
		return "{resultText(x.dst)}globaladdr {rtText(globalAddrSymbol(x))}"
	end 'opGlobalAddr'
	if x.op == Opcode.opCallImport 'opCallImport'
		return "{resultText(x.dst)}import {quote(callImportName(f, x: x))}({f.regsText(callImportArgsStart(x), count: callImportArgsCount(x))})"
	end 'opCallImport'
	if x.op == Opcode.opSyscall 'opSyscall'
		return "{resultText(x.dst)}syscall({f.regsText(syscallArgsStart(x), count: syscallArgsCount(x))})"
	end 'opSyscall'
	if x.op == Opcode.opAtomicAdd 'opAtomicAdd'
		return "{resultText(x.dst)}atomicadd %{atomicAddAddr(x)}, %{atomicAddSrc(x)}"
	end 'opAtomicAdd'
	if x.op == Opcode.opAtomicExchange 'opAtomicExchange'
		return "{resultText(x.dst)}atomicxchg %{atomicExchangeAddr(x)}, %{atomicExchangeSrc(x)}"
	end 'opAtomicExchange'
	if x.op == Opcode.opCompareExchange 'opCompareExchange'
		return "{resultText(x.dst)}cmpxchg({f.regsText(compareExchangeArgsStart(x), count: compareExchangeArgsCount(x))})"
	end 'opCompareExchange'
	if x.op == Opcode.opSpinPause 'opSpinPause'
		return "spinpause"
	end 'opSpinPause'
	if x.op == Opcode.opThreadContext 'opThreadContext'
		return "{resultText(x.dst)}threadcontext"
	end 'opThreadContext'
	if x.op == Opcode.opCallCode 'opCallCode'
		return "{resultText(x.dst)}callcode({f.regsText(callCodeArgsStart(x), count: callCodeArgsCount(x))})"
	end 'opCallCode'
	if x.op == Opcode.opCallHost 'opCallHost'
		return "{resultText(x.dst)}callhost({f.regsText(callHostArgsStart(x), count: callHostArgsCount(x))})"
	end 'opCallHost'
	if x.op == Opcode.opCodeAddress 'opCodeAddress'
		return "{resultText(x.dst)}codeaddr {funcSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: codeAddressCallee(f, x: x))}"
	end 'opCodeAddress'
	if x.op == Opcode.opBin 'opBin'
		var text = "{resultText(x.dst)}{binOpText(binOp(x))}"
		if binUnsigned(x) 'unsigned'
			text = "{text}.u"
		end 'unsigned'
		text = "{text} %{binLeft(x)}, %{binRight(x)}"
		if binHasFail(x) 'fail'
			text = "{text} else b{binFail(x).unwrap()}"
		end 'fail'
		return text
	end 'opBin'
	if x.op == Opcode.opCmp 'opCmp'
		var text = "{resultText(x.dst)}cmp.{cmpOpText(cmpOp(x))}"
		if cmpUnsigned(x) 'unsigned'
			text = "{text}.u"
		end 'unsigned'
		text = "{text} %{cmpLeft(x)}, %{cmpRight(x)}"
		return text
	end 'opCmp'
	if x.op == Opcode.opFBin 'opFBin'
		return "{resultText(x.dst)}f{fBinOpText(fBinOp(x))} %{fBinLeft(x)}, %{fBinRight(x)}"
	end 'opFBin'
	if x.op == Opcode.opFCmp 'opFCmp'
		return "{resultText(x.dst)}fcmp.{cmpOpText(fCmpOp(x))} %{fCmpLeft(x)}, %{fCmpRight(x)}"
	end 'opFCmp'
	if x.op == Opcode.opFUnary 'opFUnary'
		return "{resultText(x.dst)}f{fUnaryOpText(fUnaryOp(x))} %{fUnarySrc(x)}"
	end 'opFUnary'
	if x.op == Opcode.opIntToFloat 'opIntToFloat'
		var text = "{resultText(x.dst)}itof"
		if intToFloatUnsigned(x) 'unsigned'
			text = "{text}.u"
		end 'unsigned'
		text = "{text} %{intToFloatSrc(x)}"
		return text
	end 'opIntToFloat'
	if x.op == Opcode.opFloatToInt 'opFloatToInt'
		return "{resultText(x.dst)}ftoi %{floatToIntSrc(x)}"
	end 'opFloatToInt'
	if x.op == Opcode.opNeg 'opNeg'
		var text = "{resultText(x.dst)}neg %{negSrc(x)}"
		if negHasFail(x) 'fail'
			text = "{text} else b{negFail(x).unwrap()}"
		end 'fail'
		return text
	end 'opNeg'
	if x.op == Opcode.opNot 'opNot'
		return "{resultText(x.dst)}not %{notSrc(x)}"
	end 'opNot'
	if x.op == Opcode.opTrailingZeros 'opTrailingZeros'
		return "{resultText(x.dst)}ctz %{trailingZerosSrc(x)}"
	end 'opTrailingZeros'
	if x.op == Opcode.opGuard 'opGuard'
		return "guard %{guardSrc(x)} {guardKindText(guardKind(x))} {guardBound(x)} else b{guardFail(x)}"
	end 'opGuard'
	if x.op == Opcode.opLength 'opLength'
		return "{resultText(x.dst)}length.{collectionText(lengthOf(x))} %{lengthSrc(x)}"
	end 'opLength'
	if x.op == Opcode.opBounds 'opBounds'
		return "bounds %{boundsIndex(x)}, %{boundsLength(x)} else b{boundsFail(x)}"
	end 'opBounds'
	if x.op == Opcode.opElemAddr 'opElemAddr'
		return "{resultText(x.dst)}elemaddr %{elemAddrArr(x)}, %{elemAddrIndex(x)} shl {elemAddrShift(x)}"
	end 'opElemAddr'
	if x.op == Opcode.opElemLoad 'opElemLoad'
		return "{resultText(x.dst)}elem %{elemLoadArr(x)}, %{elemLoadIndex(x)} shl {elemLoadShift(x)}"
	end 'opElemLoad'
	if x.op == Opcode.opLoadByte 'opLoadByte'
		return "{resultText(x.dst)}byte.{collectionText(loadByteOf(x))} %{loadByteSrc(x)}, %{loadByteIndex(x)}"
	end 'opLoadByte'
	if x.op == Opcode.opBuffer 'opBuffer'
		return "{resultText(x.dst)}buffer %{bufferSrc(x)}"
	end 'opBuffer'
	if x.op == Opcode.opElemAt 'opElemAt'
		return "{resultText(x.dst)}elemat %{elemAtData(x)}, %{elemAtIndex(x)} shl {elemAtShift(x)}"
	end 'opElemAt'
	if x.op == Opcode.opElemAddrAt 'opElemAddrAt'
		return "{resultText(x.dst)}elemaddrat %{elemAddrAtData(x)}, %{elemAddrAtIndex(x)} shl {elemAddrAtShift(x)}"
	end 'opElemAddrAt'
	if x.op == Opcode.opByteAt 'opByteAt'
		return "{resultText(x.dst)}byteat %{byteAtData(x)}, %{byteAtIndex(x)}"
	end 'opByteAt'
	if x.op == Opcode.opStrPtr 'opStrPtr'
		return "{resultText(x.dst)}strptr %{strPtrSrc(x)}"
	end 'opStrPtr'
	if x.op == Opcode.opStrBytes 'opStrBytes'
		return "{resultText(x.dst)}strbytes %{strBytesSrc(x)} in frame box {strBytesBox(x)}"
	end 'opStrBytes'
	if x.op == Opcode.opStrWord 'opStrWord'
		return "{resultText(x.dst)}strword %{strWordSrc(x)}"
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		return "{resultText(x.dst)}strmake %{strMakeBytes(x)}, %{strMakeWord(x)}"
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		return "{resultText(x.dst)}alloc {allocBytes(x)}"
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		var text = "{resultText(x.dst)}call {funcSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: callCallee(f, x: x))}({f.regsText(callArgsStart(x), count: callArgsCount(x))})"
		if callHasErrReg(x) 'errReg'
			text = "{text} error %{callErrReg(x).unwrap()}"
		end 'errReg'
		if callFloats(f, x: x) != 0 'floats'
			text = "{text} floats {floatsText(callFloats(f, x: x))}"
		end 'floats'
		if callFloatResult(x) 'floatResult'
			text = "{text} returns float"
		end 'floatResult'
		return text
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		var text = "{resultText(x.dst)}runtime {rtText(callRuntimeSymbol(x))}({f.regsText(callRuntimeArgsStart(x), count: callRuntimeArgsCount(x))})"
		if callRuntimeHasRoutine(x) 'routine'
			text = "{text} routine {funcSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: callRuntimeRoutine(f, x: x).unwrap())}"
		end 'routine'
		if callRuntimeProven(x) 'proven'
			text = "{text} proven"
		end 'proven'
		return text
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		return "when {f.bodyName(whenBody(f, x: x))} cowns [{f.regsText(whenCownsStart(x), count: whenCownsCount(x))}] captures [{f.regsText(whenCapturesStart(x), count: whenCapturesCount(x))}]"
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		return "{resultText(x.dst)}async {funcSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: asyncCallee(f, x: x))}({f.regsText(asyncArgsStart(x), count: asyncArgsCount(x))})"
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		return "{resultText(x.dst)}closure {f.bodyName(closureBody(f, x: x))} [{f.regsText(closureCapturesStart(x), count: closureCapturesCount(x))}]"
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		return "{resultText(x.dst)}funcvalue {funcSymbol(p, tt: tt, reads: reads, ft: ft, funcReads: funcReads, fid: funcValueCallee(f, x: x))}"
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		var text = "{resultText(x.dst)}callvalue({f.regsText(callValueArgsStart(x), count: callValueArgsCount(x))})"
		if callFloats(f, x: x) != 0 'floats'
			text = "{text} floats {floatsText(callFloats(f, x: x))}"
		end 'floats'
		if callValueFloatResult(x) 'floatResult'
			text = "{text} returns float"
		end 'floatResult'
		return text
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		return "{resultText(x.dst)}box {boxTable(f, x: x).symbol}, %{boxValue(x)}"
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		return "{resultText(x.dst)}framebox {frameBoxTable(f, x: x).symbol}, %{frameBoxValue(x)} in frame box {frameBoxBox(x)}"
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		return "{resultText(x.dst)}framearea {frameAreaWords(x)} in frame box {frameAreaBox(x)}"
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		var text = "{resultText(x.dst)}callwitness.{receiverConvText(callWitnessRecv(x))} {callWitnessSlot(x)}({f.regsText(callWitnessArgsStart(x), count: callWitnessArgsCount(x))})"
		if callWitnessHasErrReg(x) 'errReg'
			text = "{text} error %{callWitnessErrReg(x).unwrap()}"
		end 'errReg'
		if callFloats(f, x: x) != 0 'floats'
			text = "{text} floats {floatsText(callFloats(f, x: x))}"
		end 'floats'
		if callWitnessFloatResult(x) 'floatResult'
			text = "{text} returns float"
		end 'floatResult'
		return text
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		return "{resultText(x.dst)}istype %{isTypeSrc(x)} {ast.typeName(tt, reads: reads, t: isTypeTy(f, x: x))}"
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		return "drop %{dropSrc(x)} {ast.typeName(tt, reads: reads, t: dropTy(f, x: x))}"
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		return "dropslot s{dropSlotSlot(x)} {ast.typeName(tt, reads: reads, t: dropSlotTy(f, x: x))}"
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		return "dropat %{dropAtAddr(x)} {ast.typeName(tt, reads: reads, t: dropAtTy(f, x: x))}"
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		return "{resultText(x.dst)}move s{moveSlotSlot(x)}"
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		return "{resultText(x.dst)}moveat %{moveAtAddr(x)}"
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		return "{resultText(x.dst)}copy %{copySrc(x)} {ast.typeName(tt, reads: reads, t: copyTy(f, x: x))}"
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'instrText'

// termText is the text the printer gives a terminator, as Go's TermString does.
export function termText(f IrFunction, t Term) returns String
	if t.kind == TermKind.termJump 'termJump'
		var text = "jump b{jumpTarget(t)}"
		if jumpArgsCount(t) > 0 'args'
			text = "{text}({f.regsText(jumpArgsStart(t), count: jumpArgsCount(t))})"
		end 'args'
		return text
	end 'termJump'
	if t.kind == TermKind.termBranch 'termBranch'
		var text = "branch %{branchCond(t)}, b{branchIfTrue(t)}"
		if branchTrueArgsCount(t) > 0 'trueArgs'
			text = "{text}({f.regsText(branchTrueArgsStart(t), count: branchTrueArgsCount(t))})"
		end 'trueArgs'
		text = "{text}, b{branchIfFalse(t)}"
		if branchFalseArgsCount(t) > 0 'falseArgs'
			text = "{text}({f.regsText(branchFalseArgsStart(t), count: branchFalseArgsCount(t))})"
		end 'falseArgs'
		return text
	end 'termBranch'
	if t.kind == TermKind.termSwitch 'termSwitch'
		var text = "switch %{switchValue(t)} [{f.casesText(switchCasesStart(t), count: switchCasesCount(t))}] default b{switchFallback(t)}"
		if switchFallbackArgsCount(t) > 0 'fallbackArgs'
			text = "{text}({f.regsText(switchFallbackArgsStart(t), count: switchFallbackArgsCount(t))})"
		end 'fallbackArgs'
		return text
	end 'termSwitch'
	if t.kind == TermKind.termRet 'termRet'
		return "ret %{retValue(t)}"
	end 'termRet'
	if t.kind == TermKind.termTrap 'termTrap'
		return "trap"
	end 'termTrap'
	if t.kind == TermKind.termThrow 'termThrow'
		return "throw %{throwErr(t)}"
	end 'termThrow'
	panic("ir: a block has no terminator")
end 'termText'
