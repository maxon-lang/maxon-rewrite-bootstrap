export function storeFieldOffset(x Instr) returns Count
	if x.op != Opcode.opStoreField 'op'
		wrongInstr("storeFieldOffset", found: x.op)
	end 'op'
	return try x.imm as Count otherwise panic("ir: storeField offset is out of range")
end 'storeFieldOffset'

export function storeFieldSrc(x Instr) returns Reg
	if x.op != Opcode.opStoreField 'op'
		wrongInstr("storeFieldSrc", found: x.op)
	end 'op'
	return x.b
end 'storeFieldSrc'

export function storeFieldBorrow(x Instr) returns bool
	if x.op != Opcode.opStoreField 'op'
		wrongInstr("storeFieldBorrow", found: x.op)
	end 'op'
	return (x.flags and flagBorrow) != 0
end 'storeFieldBorrow'

export function fieldAddrObj(x Instr) returns Reg
	if x.op != Opcode.opFieldAddr 'op'
		wrongInstr("fieldAddrObj", found: x.op)
	end 'op'
	return x.a
end 'fieldAddrObj'

export function fieldAddrOffset(x Instr) returns Count
	if x.op != Opcode.opFieldAddr 'op'
		wrongInstr("fieldAddrOffset", found: x.op)
	end 'op'
	return try x.imm as Count otherwise panic("ir: fieldAddr offset is out of range")
end 'fieldAddrOffset'

export function loadAtAddr(x Instr) returns Reg
	if x.op != Opcode.opLoadAt 'op'
		wrongInstr("loadAtAddr", found: x.op)
	end 'op'
	return x.a
end 'loadAtAddr'

export function storeAtAddr(x Instr) returns Reg
	if x.op != Opcode.opStoreAt 'op'
		wrongInstr("storeAtAddr", found: x.op)
	end 'op'
	return x.a
end 'storeAtAddr'

export function storeAtSrc(x Instr) returns Reg
	if x.op != Opcode.opStoreAt 'op'
		wrongInstr("storeAtSrc", found: x.op)
	end 'op'
	return x.b
end 'storeAtSrc'

export function loadGlobalSymbol(x Instr) returns Rt
	if x.op != Opcode.opLoadGlobal 'op'
		wrongInstr("loadGlobalSymbol", found: x.op)
	end 'op'
	return rtOf(try x.imm as Count otherwise panic("ir: loadGlobal symbol is out of range"))
end 'loadGlobalSymbol'

export function loadRawAddr(x Instr) returns Reg
	if x.op != Opcode.opLoadRaw 'op'
		wrongInstr("loadRawAddr", found: x.op)
