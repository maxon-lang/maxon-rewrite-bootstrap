export function frameBoxBox(x Instr) returns Count
	if x.op != Opcode.opFrameBox 'op'
		wrongInstr("frameBoxBox", found: x.op)
	end 'op'
	return try x.imm as Count otherwise panic("ir: frameBox box is out of range")
end 'frameBoxBox'

export function frameAreaWords(x Instr) returns Count
	if x.op != Opcode.opFrameArea 'op'
		wrongInstr("frameAreaWords", found: x.op)
	end 'op'
	return try x.c as Count otherwise panic("ir: frameArea words is out of range")
end 'frameAreaWords'

export function frameAreaBox(x Instr) returns Count
	if x.op != Opcode.opFrameArea 'op'
		wrongInstr("frameAreaBox", found: x.op)
	end 'op'
	return try x.imm as Count otherwise panic("ir: frameArea box is out of range")
end 'frameAreaBox'

export function callWitnessRecv(x Instr) returns ReceiverConv
	if x.op != Opcode.opCallWitness 'op'
		wrongInstr("callWitnessRecv", found: x.op)
	end 'op'
	return receiverConvOf(x.sub)
end 'callWitnessRecv'

export function callWitnessSlot(x Instr) returns Count
	if x.op != Opcode.opCallWitness 'op'
		wrongInstr("callWitnessSlot", found: x.op)
	end 'op'
	return try x.c as Count otherwise panic("ir: callWitness slot is out of range")
end 'callWitnessSlot'

// callWitnessArgsStart is where the args of a CallWitness start in their pool.
export function callWitnessArgsStart(x Instr) returns Count
	if x.op != Opcode.opCallWitness 'op'
		wrongInstr("callWitnessArgsStart", found: x.op)
	end 'op'
	return try x.a as Count otherwise panic("ir: callWitness args is out of range")
end 'callWitnessArgsStart'

// callWitnessArgsCount is how many args a CallWitness has.
export function callWitnessArgsCount(x Instr) returns Count
	if x.op != Opcode.opCallWitness 'op'
		wrongInstr("callWitnessArgsCount", found: x.op)
	end 'op'
	return try x.b as Count otherwise panic("ir: callWitness args is out of range")
end 'callWitnessArgsCount'

export function callWitnessHasErrReg(x Instr) returns bool
	if x.op != Opcode.opCallWitness 'op'
		wrongInstr("callWitnessHasErrReg", found: x.op)
	end 'op'
	return (x.flags and flagThrows) != 0
end 'callWitnessHasErrReg'

export function callWitnessErrReg(x Instr) returns table.Option with Reg
	if not callWitnessHasErrReg(x) 'absent'
		return table.Option.none
	end 'absent'
	return table.Option.some(try x.imm as Reg otherwise panic("ir: callWitness errReg is out of range"))
end 'callWitnessErrReg'

export function callWitnessFloatResult(x Instr) returns bool
	if x.op != Opcode.opCallWitness 'op'
		wrongInstr("callWitnessFloatResult", found: x.op)
	end 'op'
	return (x.flags and flagFloatResult) != 0
end 'callWitnessFloatResult'

