	if t.kind != TermKind.termRet 'kind'
		wrongTerm("retValue", found: t.kind)
	end 'kind'
	return t.value
end 'retValue'

export function throwErr(t Term) returns Reg
	if t.kind != TermKind.termThrow 'kind'
		wrongTerm("throwErr", found: t.kind)
	end 'kind'
	return t.value
end 'throwErr'

// instrDef is the register an instruction writes, if it writes one.
export function instrDef(x Instr) returns table.Option with Reg
	if x.op == Opcode.opConst 'opConst'
		return table.Option.some(x.dst)
	end 'opConst'
	if x.op == Opcode.opStr 'opStr'
		return table.Option.some(x.dst)
	end 'opStr'
	if x.op == Opcode.opDatum 'opDatum'
		return table.Option.some(x.dst)
	end 'opDatum'
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		return table.Option.some(x.dst)
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		return table.Option.none
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		return table.Option.some(x.dst)
	end 'opSlotAddr'
	if x.op == Opcode.opLoadParam 'opLoadParam'
		return table.Option.some(x.dst)
	end 'opLoadParam'
	if x.op == Opcode.opLoadField 'opLoadField'
		return table.Option.some(x.dst)
	end 'opLoadField'
	if x.op == Opcode.opStoreField 'opStoreField'
		return table.Option.none
	end 'opStoreField'
	if x.op == Opcode.opFieldAddr 'opFieldAddr'
		return table.Option.some(x.dst)
	end 'opFieldAddr'
	if x.op == Opcode.opLoadAt 'opLoadAt'
		return table.Option.some(x.dst)
	end 'opLoadAt'
	if x.op == Opcode.opStoreAt 'opStoreAt'
		return table.Option.none
	end 'opStoreAt'
	if x.op == Opcode.opLoadGlobal 'opLoadGlobal'
		return table.Option.some(x.dst)
	end 'opLoadGlobal'
	if x.op == Opcode.opLoadRaw 'opLoadRaw'
		return table.Option.some(x.dst)
	end 'opLoadRaw'
	if x.op == Opcode.opStoreRaw 'opStoreRaw'
		return table.Option.none
	end 'opStoreRaw'
	if x.op == Opcode.opLoadAcquire 'opLoadAcquire'
		return table.Option.some(x.dst)
	end 'opLoadAcquire'
	if x.op == Opcode.opStoreRelease 'opStoreRelease'
		return table.Option.none
	end 'opStoreRelease'
	if x.op == Opcode.opGlobalAddr 'opGlobalAddr'
		return table.Option.some(x.dst)
	end 'opGlobalAddr'
	if x.op == Opcode.opCallImport 'opCallImport'
		return table.Option.some(x.dst)
	end 'opCallImport'
	if x.op == Opcode.opSyscall 'opSyscall'
		return table.Option.some(x.dst)
	end 'opSyscall'
	if x.op == Opcode.opAtomicAdd 'opAtomicAdd'
		return table.Option.some(x.dst)
	end 'opAtomicAdd'
	if x.op == Opcode.opAtomicExchange 'opAtomicExchange'
		return table.Option.some(x.dst)
	end 'opAtomicExchange'
	if x.op == Opcode.opCompareExchange 'opCompareExchange'
		return table.Option.some(x.dst)
	end 'opCompareExchange'
	if x.op == Opcode.opSpinPause 'opSpinPause'
		return table.Option.none
	end 'opSpinPause'
	if x.op == Opcode.opThreadContext 'opThreadContext'
		return table.Option.some(x.dst)
	end 'opThreadContext'
	if x.op == Opcode.opCallCode 'opCallCode'
		return table.Option.some(x.dst)
	end 'opCallCode'
	if x.op == Opcode.opCallHost 'opCallHost'
		return table.Option.some(x.dst)
	end 'opCallHost'
	if x.op == Opcode.opCodeAddress 'opCodeAddress'
		return table.Option.some(x.dst)
	end 'opCodeAddress'
	if x.op == Opcode.opBin 'opBin'
		return table.Option.some(x.dst)
	end 'opBin'
	if x.op == Opcode.opCmp 'opCmp'
		return table.Option.some(x.dst)
	end 'opCmp'
	if x.op == Opcode.opFBin 'opFBin'
		return table.Option.some(x.dst)
	end 'opFBin'
	if x.op == Opcode.opFCmp 'opFCmp'
		return table.Option.some(x.dst)
	end 'opFCmp'
	if x.op == Opcode.opFUnary 'opFUnary'
		return table.Option.some(x.dst)
	end 'opFUnary'
	if x.op == Opcode.opIntToFloat 'opIntToFloat'
		return table.Option.some(x.dst)
	end 'opIntToFloat'
	if x.op == Opcode.opFloatToInt 'opFloatToInt'
		return table.Option.some(x.dst)
	end 'opFloatToInt'
	if x.op == Opcode.opNeg 'opNeg'
		return table.Option.some(x.dst)
	end 'opNeg'
	if x.op == Opcode.opNot 'opNot'
		return table.Option.some(x.dst)
	end 'opNot'
	if x.op == Opcode.opTrailingZeros 'opTrailingZeros'
		return table.Option.some(x.dst)
	end 'opTrailingZeros'
	if x.op == Opcode.opGuard 'opGuard'
		return table.Option.none
	end 'opGuard'
	if x.op == Opcode.opLength 'opLength'
		return table.Option.some(x.dst)
	end 'opLength'
	if x.op == Opcode.opBounds 'opBounds'
		return table.Option.none
	end 'opBounds'
	if x.op == Opcode.opElemAddr 'opElemAddr'
		return table.Option.some(x.dst)
	end 'opElemAddr'
	if x.op == Opcode.opElemLoad 'opElemLoad'
		return table.Option.some(x.dst)
	end 'opElemLoad'
	if x.op == Opcode.opLoadByte 'opLoadByte'
		return table.Option.some(x.dst)
	end 'opLoadByte'
	if x.op == Opcode.opBuffer 'opBuffer'
		return table.Option.some(x.dst)
	end 'opBuffer'
	if x.op == Opcode.opElemAt 'opElemAt'
		return table.Option.some(x.dst)
	end 'opElemAt'
	if x.op == Opcode.opElemAddrAt 'opElemAddrAt'
		return table.Option.some(x.dst)
	end 'opElemAddrAt'
	if x.op == Opcode.opByteAt 'opByteAt'
		return table.Option.some(x.dst)
	end 'opByteAt'
	if x.op == Opcode.opStrPtr 'opStrPtr'
		return table.Option.some(x.dst)
	end 'opStrPtr'
	if x.op == Opcode.opStrBytes 'opStrBytes'
		return table.Option.some(x.dst)
	end 'opStrBytes'
	if x.op == Opcode.opStrWord 'opStrWord'
		return table.Option.some(x.dst)
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		return table.Option.some(x.dst)
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		return table.Option.some(x.dst)
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		if x.dst == noReg 'none'
			return table.Option.none
		end 'none'
		return table.Option.some(x.dst)
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		if x.dst == noReg 'none'
			return table.Option.none
		end 'none'
		return table.Option.some(x.dst)
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		return table.Option.none
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		return table.Option.some(x.dst)
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		return table.Option.some(x.dst)
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		return table.Option.some(x.dst)
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		if x.dst == noReg 'none'
			return table.Option.none
		end 'none'
		return table.Option.some(x.dst)
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		return table.Option.some(x.dst)
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		return table.Option.some(x.dst)
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		return table.Option.some(x.dst)
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		if x.dst == noReg 'none'
			return table.Option.none
		end 'none'
		return table.Option.some(x.dst)
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		return table.Option.some(x.dst)
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		return table.Option.none
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		return table.Option.none
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		return table.Option.none
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		return table.Option.some(x.dst)
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		return table.Option.some(x.dst)
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		return table.Option.some(x.dst)
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'instrDef'

// instrFail is the block an instruction goes to when its check fails, if it has one.
export function instrFail(x Instr) returns table.Option with BlockID
	if x.op == Opcode.opConst 'opConst'
		return table.Option.none
	end 'opConst'
	if x.op == Opcode.opStr 'opStr'
		return table.Option.none
	end 'opStr'
	if x.op == Opcode.opDatum 'opDatum'
		return table.Option.none
	end 'opDatum'
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		return table.Option.none
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		return table.Option.none
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		return table.Option.none
	end 'opSlotAddr'
	if x.op == Opcode.opLoadParam 'opLoadParam'
		return table.Option.none
	end 'opLoadParam'
	if x.op == Opcode.opLoadField 'opLoadField'
		return table.Option.none
	end 'opLoadField'
	if x.op == Opcode.opStoreField 'opStoreField'
		return table.Option.none
	end 'opStoreField'
	if x.op == Opcode.opFieldAddr 'opFieldAddr'
		return table.Option.none
	end 'opFieldAddr'
	if x.op == Opcode.opLoadAt 'opLoadAt'
		return table.Option.none
	end 'opLoadAt'
	if x.op == Opcode.opStoreAt 'opStoreAt'
		return table.Option.none
	end 'opStoreAt'
	if x.op == Opcode.opLoadGlobal 'opLoadGlobal'
		return table.Option.none
	end 'opLoadGlobal'
	if x.op == Opcode.opLoadRaw 'opLoadRaw'
		return table.Option.none
	end 'opLoadRaw'
	if x.op == Opcode.opStoreRaw 'opStoreRaw'
		return table.Option.none
	end 'opStoreRaw'
	if x.op == Opcode.opLoadAcquire 'opLoadAcquire'
		return table.Option.none
	end 'opLoadAcquire'
	if x.op == Opcode.opStoreRelease 'opStoreRelease'
		return table.Option.none
	end 'opStoreRelease'
	if x.op == Opcode.opGlobalAddr 'opGlobalAddr'
		return table.Option.none
	end 'opGlobalAddr'
	if x.op == Opcode.opCallImport 'opCallImport'
		return table.Option.none
	end 'opCallImport'
	if x.op == Opcode.opSyscall 'opSyscall'
		return table.Option.none
	end 'opSyscall'
	if x.op == Opcode.opAtomicAdd 'opAtomicAdd'
		return table.Option.none
	end 'opAtomicAdd'
	if x.op == Opcode.opAtomicExchange 'opAtomicExchange'
		return table.Option.none
	end 'opAtomicExchange'
	if x.op == Opcode.opCompareExchange 'opCompareExchange'
		return table.Option.none
	end 'opCompareExchange'
	if x.op == Opcode.opSpinPause 'opSpinPause'
		return table.Option.none
	end 'opSpinPause'
	if x.op == Opcode.opThreadContext 'opThreadContext'
		return table.Option.none
	end 'opThreadContext'
	if x.op == Opcode.opCallCode 'opCallCode'
		return table.Option.none
	end 'opCallCode'
	if x.op == Opcode.opCallHost 'opCallHost'
		return table.Option.none
	end 'opCallHost'
	if x.op == Opcode.opCodeAddress 'opCodeAddress'
		return table.Option.none
	end 'opCodeAddress'
	if x.op == Opcode.opBin 'opBin'
		return binFail(x)
	end 'opBin'
	if x.op == Opcode.opCmp 'opCmp'
		return table.Option.none
	end 'opCmp'
	if x.op == Opcode.opFBin 'opFBin'
		return table.Option.none
	end 'opFBin'
	if x.op == Opcode.opFCmp 'opFCmp'
		return table.Option.none
	end 'opFCmp'
	if x.op == Opcode.opFUnary 'opFUnary'
		return table.Option.none
	end 'opFUnary'
	if x.op == Opcode.opIntToFloat 'opIntToFloat'
		return table.Option.none
	end 'opIntToFloat'
	if x.op == Opcode.opFloatToInt 'opFloatToInt'
		return table.Option.none
	end 'opFloatToInt'
	if x.op == Opcode.opNeg 'opNeg'
		return negFail(x)
	end 'opNeg'
	if x.op == Opcode.opNot 'opNot'
		return table.Option.none
	end 'opNot'
	if x.op == Opcode.opTrailingZeros 'opTrailingZeros'
		return table.Option.none
	end 'opTrailingZeros'
	if x.op == Opcode.opGuard 'opGuard'
		return table.Option.some(guardFail(x))
	end 'opGuard'
	if x.op == Opcode.opLength 'opLength'
		return table.Option.none
	end 'opLength'
	if x.op == Opcode.opBounds 'opBounds'
		return table.Option.some(boundsFail(x))
	end 'opBounds'
	if x.op == Opcode.opElemAddr 'opElemAddr'
		return table.Option.none
	end 'opElemAddr'
	if x.op == Opcode.opElemLoad 'opElemLoad'
		return table.Option.none
	end 'opElemLoad'
	if x.op == Opcode.opLoadByte 'opLoadByte'
		return table.Option.none
	end 'opLoadByte'
	if x.op == Opcode.opBuffer 'opBuffer'
		return table.Option.none
	end 'opBuffer'
	if x.op == Opcode.opElemAt 'opElemAt'
		return table.Option.none
	end 'opElemAt'
	if x.op == Opcode.opElemAddrAt 'opElemAddrAt'
		return table.Option.none
	end 'opElemAddrAt'
	if x.op == Opcode.opByteAt 'opByteAt'
		return table.Option.none
	end 'opByteAt'
	if x.op == Opcode.opStrPtr 'opStrPtr'
		return table.Option.none
	end 'opStrPtr'
	if x.op == Opcode.opStrBytes 'opStrBytes'
		return table.Option.none
	end 'opStrBytes'
	if x.op == Opcode.opStrWord 'opStrWord'
		return table.Option.none
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		return table.Option.none
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		return table.Option.none
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		return table.Option.none
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		return table.Option.none
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		return table.Option.none
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		return table.Option.none
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		return table.Option.none
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		return table.Option.none
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		return table.Option.none
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		return table.Option.none
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		return table.Option.none
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		return table.Option.none
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		return table.Option.none
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		return table.Option.none
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		return table.Option.none
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		return table.Option.none
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		return table.Option.none
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		return table.Option.none
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		return table.Option.none
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		return table.Option.none
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'instrFail'

// instrCanFail is whether an instruction has a block it goes to when its check fails, which instrFail gives.
export function instrCanFail(x Instr) returns bool
	return match x.op 'op'
		opNone gives false
		opConst gives false
		opStr gives false
		opDatum gives false
		opLoadSlot gives false
		opStoreSlot gives false
		opSlotAddr gives false
		opLoadParam gives false
		opLoadField gives false
		opStoreField gives false
		opFieldAddr gives false
		opLoadAt gives false
		opStoreAt gives false
		opLoadGlobal gives false
		opLoadRaw gives false
		opStoreRaw gives false
		opLoadAcquire gives false
		opStoreRelease gives false
		opGlobalAddr gives false
		opCallImport gives false
		opSyscall gives false
		opAtomicAdd gives false
		opAtomicExchange gives false
		opCompareExchange gives false
		opSpinPause gives false
		opThreadContext gives false
		opCallCode gives false
		opCallHost gives false
		opCodeAddress gives false
		opBin gives binHasFail(x)
		opCmp gives false
		opFBin gives false
		opFCmp gives false
		opFUnary gives false
		opIntToFloat gives false
		opFloatToInt gives false
		opNeg gives negHasFail(x)
		opNot gives false
		opTrailingZeros gives false
		opGuard gives true
		opLength gives false
		opBounds gives true
		opElemAddr gives false
		opElemLoad gives false
		opLoadByte gives false
		opBuffer gives false
		opElemAt gives false
		opElemAddrAt gives false
		opByteAt gives false
		opStrPtr gives false
		opStrBytes gives false
		opStrWord gives false
		opStrMake gives false
		opAlloc gives false
		opCall gives false
		opCallRuntime gives false
		opWhen gives false
		opAsync gives false
		opClosure gives false
		opFuncValue gives false
		opCallValue gives false
		opBox gives false
		opFrameBox gives false
		opFrameArea gives false
		opCallWitness gives false
		opIsType gives false
		opDrop gives false
		opDropSlot gives false
		opDropAt gives false
		opMoveSlot gives false
		opMoveAt gives false
		opCopy gives false
	end 'op'
end 'instrCanFail'

// instrReads appends the registers an instruction reads to out, in the order of its operands.
export function instrReads(f IrFunction, x Instr, mutates out RegList)
	if x.op == Opcode.opConst 'opConst'
		return
	end 'opConst'
	if x.op == Opcode.opStr 'opStr'
		return
	end 'opStr'
	if x.op == Opcode.opDatum 'opDatum'
		return
	end 'opDatum'
	if x.op == Opcode.opLoadSlot 'opLoadSlot'
		return
	end 'opLoadSlot'
	if x.op == Opcode.opStoreSlot 'opStoreSlot'
		out.push(storeSlotSrc(x))
		return
	end 'opStoreSlot'
	if x.op == Opcode.opSlotAddr 'opSlotAddr'
		return
	end 'opSlotAddr'
	if x.op == Opcode.opLoadParam 'opLoadParam'
		return
	end 'opLoadParam'
	if x.op == Opcode.opLoadField 'opLoadField'
		out.push(loadFieldObj(x))
		return
	end 'opLoadField'
	if x.op == Opcode.opStoreField 'opStoreField'
		out.push(storeFieldObj(x))
		out.push(storeFieldSrc(x))
		return
	end 'opStoreField'
	if x.op == Opcode.opFieldAddr 'opFieldAddr'
		out.push(fieldAddrObj(x))
		return
	end 'opFieldAddr'
	if x.op == Opcode.opLoadAt 'opLoadAt'
		out.push(loadAtAddr(x))
		return
	end 'opLoadAt'
	if x.op == Opcode.opStoreAt 'opStoreAt'
		out.push(storeAtAddr(x))
		out.push(storeAtSrc(x))
		return
	end 'opStoreAt'
	if x.op == Opcode.opLoadGlobal 'opLoadGlobal'
		return
	end 'opLoadGlobal'
	if x.op == Opcode.opLoadRaw 'opLoadRaw'
		out.push(loadRawAddr(x))
		return
	end 'opLoadRaw'
	if x.op == Opcode.opStoreRaw 'opStoreRaw'
		out.push(storeRawAddr(x))
		out.push(storeRawSrc(x))
		return
	end 'opStoreRaw'
	if x.op == Opcode.opLoadAcquire 'opLoadAcquire'
		out.push(loadAcquireAddr(x))
		return
	end 'opLoadAcquire'
	if x.op == Opcode.opStoreRelease 'opStoreRelease'
		out.push(storeReleaseAddr(x))
		out.push(storeReleaseSrc(x))
		return
	end 'opStoreRelease'
	if x.op == Opcode.opGlobalAddr 'opGlobalAddr'
		return
	end 'opGlobalAddr'
	if x.op == Opcode.opCallImport 'opCallImport'
		f.regsInto(callImportArgsStart(x), count: callImportArgsCount(x), out: out)
		return
	end 'opCallImport'
	if x.op == Opcode.opSyscall 'opSyscall'
		f.regsInto(syscallArgsStart(x), count: syscallArgsCount(x), out: out)
		return
	end 'opSyscall'
	if x.op == Opcode.opAtomicAdd 'opAtomicAdd'
		out.push(atomicAddAddr(x))
		out.push(atomicAddSrc(x))
		return
	end 'opAtomicAdd'
	if x.op == Opcode.opAtomicExchange 'opAtomicExchange'
		out.push(atomicExchangeAddr(x))
		out.push(atomicExchangeSrc(x))
		return
	end 'opAtomicExchange'
	if x.op == Opcode.opCompareExchange 'opCompareExchange'
		f.regsInto(compareExchangeArgsStart(x), count: compareExchangeArgsCount(x), out: out)
		return
	end 'opCompareExchange'
	if x.op == Opcode.opSpinPause 'opSpinPause'
		return
	end 'opSpinPause'
	if x.op == Opcode.opThreadContext 'opThreadContext'
		return
	end 'opThreadContext'
	if x.op == Opcode.opCallCode 'opCallCode'
		f.regsInto(callCodeArgsStart(x), count: callCodeArgsCount(x), out: out)
		return
	end 'opCallCode'
	if x.op == Opcode.opCallHost 'opCallHost'
		f.regsInto(callHostArgsStart(x), count: callHostArgsCount(x), out: out)
		return
	end 'opCallHost'
	if x.op == Opcode.opCodeAddress 'opCodeAddress'
		return
	end 'opCodeAddress'
	if x.op == Opcode.opBin 'opBin'
		out.push(binLeft(x))
		out.push(binRight(x))
		return
	end 'opBin'
	if x.op == Opcode.opCmp 'opCmp'
		out.push(cmpLeft(x))
		out.push(cmpRight(x))
		return
	end 'opCmp'
	if x.op == Opcode.opFBin 'opFBin'
		out.push(fBinLeft(x))
		out.push(fBinRight(x))
		return
	end 'opFBin'
	if x.op == Opcode.opFCmp 'opFCmp'
		out.push(fCmpLeft(x))
		out.push(fCmpRight(x))
		return
	end 'opFCmp'
	if x.op == Opcode.opFUnary 'opFUnary'
		out.push(fUnarySrc(x))
		return
	end 'opFUnary'
	if x.op == Opcode.opIntToFloat 'opIntToFloat'
		out.push(intToFloatSrc(x))
		return
	end 'opIntToFloat'
	if x.op == Opcode.opFloatToInt 'opFloatToInt'
		out.push(floatToIntSrc(x))
		return
	end 'opFloatToInt'
	if x.op == Opcode.opNeg 'opNeg'
		out.push(negSrc(x))
		return
	end 'opNeg'
	if x.op == Opcode.opNot 'opNot'
		out.push(notSrc(x))
		return
	end 'opNot'
	if x.op == Opcode.opTrailingZeros 'opTrailingZeros'
		out.push(trailingZerosSrc(x))
		return
	end 'opTrailingZeros'
	if x.op == Opcode.opGuard 'opGuard'
		out.push(guardSrc(x))
		return
	end 'opGuard'
	if x.op == Opcode.opLength 'opLength'
		out.push(lengthSrc(x))
		return
	end 'opLength'
	if x.op == Opcode.opBounds 'opBounds'
		out.push(boundsIndex(x))
		out.push(boundsLength(x))
		return
	end 'opBounds'
	if x.op == Opcode.opElemAddr 'opElemAddr'
		out.push(elemAddrArr(x))
		out.push(elemAddrIndex(x))
		return
	end 'opElemAddr'
	if x.op == Opcode.opElemLoad 'opElemLoad'
		out.push(elemLoadArr(x))
		out.push(elemLoadIndex(x))
		return
	end 'opElemLoad'
	if x.op == Opcode.opLoadByte 'opLoadByte'
		out.push(loadByteSrc(x))
		out.push(loadByteIndex(x))
		return
	end 'opLoadByte'
	if x.op == Opcode.opBuffer 'opBuffer'
		out.push(bufferSrc(x))
		return
	end 'opBuffer'
	if x.op == Opcode.opElemAt 'opElemAt'
		out.push(elemAtData(x))
		out.push(elemAtIndex(x))
		return
	end 'opElemAt'
	if x.op == Opcode.opElemAddrAt 'opElemAddrAt'
		out.push(elemAddrAtData(x))
		out.push(elemAddrAtIndex(x))
		return
	end 'opElemAddrAt'
	if x.op == Opcode.opByteAt 'opByteAt'
		out.push(byteAtData(x))
		out.push(byteAtIndex(x))
		return
	end 'opByteAt'
	if x.op == Opcode.opStrPtr 'opStrPtr'
		out.push(strPtrSrc(x))
		return
	end 'opStrPtr'
	if x.op == Opcode.opStrBytes 'opStrBytes'
		out.push(strBytesSrc(x))
		return
	end 'opStrBytes'
	if x.op == Opcode.opStrWord 'opStrWord'
		out.push(strWordSrc(x))
		return
	end 'opStrWord'
	if x.op == Opcode.opStrMake 'opStrMake'
		out.push(strMakeBytes(x))
		out.push(strMakeWord(x))
		return
	end 'opStrMake'
	if x.op == Opcode.opAlloc 'opAlloc'
		return
	end 'opAlloc'
	if x.op == Opcode.opCall 'opCall'
		f.regsInto(callArgsStart(x), count: callArgsCount(x), out: out)
		return
	end 'opCall'
	if x.op == Opcode.opCallRuntime 'opCallRuntime'
		f.regsInto(callRuntimeArgsStart(x), count: callRuntimeArgsCount(x), out: out)
		return
	end 'opCallRuntime'
	if x.op == Opcode.opWhen 'opWhen'
		f.regsInto(whenCownsStart(x), count: whenCownsCount(x), out: out)
		f.regsInto(whenCapturesStart(x), count: whenCapturesCount(x), out: out)
		return
	end 'opWhen'
	if x.op == Opcode.opAsync 'opAsync'
		f.regsInto(asyncArgsStart(x), count: asyncArgsCount(x), out: out)
		return
	end 'opAsync'
	if x.op == Opcode.opClosure 'opClosure'
		f.regsInto(closureCapturesStart(x), count: closureCapturesCount(x), out: out)
		return
	end 'opClosure'
	if x.op == Opcode.opFuncValue 'opFuncValue'
		return
	end 'opFuncValue'
	if x.op == Opcode.opCallValue 'opCallValue'
		f.regsInto(callValueArgsStart(x), count: callValueArgsCount(x), out: out)
		return
	end 'opCallValue'
	if x.op == Opcode.opBox 'opBox'
		out.push(boxValue(x))
		return
	end 'opBox'
	if x.op == Opcode.opFrameBox 'opFrameBox'
		out.push(frameBoxValue(x))
		return
	end 'opFrameBox'
	if x.op == Opcode.opFrameArea 'opFrameArea'
		return
	end 'opFrameArea'
	if x.op == Opcode.opCallWitness 'opCallWitness'
		f.regsInto(callWitnessArgsStart(x), count: callWitnessArgsCount(x), out: out)
		return
	end 'opCallWitness'
	if x.op == Opcode.opIsType 'opIsType'
		out.push(isTypeSrc(x))
		return
	end 'opIsType'
	if x.op == Opcode.opDrop 'opDrop'
		out.push(dropSrc(x))
		return
	end 'opDrop'
	if x.op == Opcode.opDropSlot 'opDropSlot'
		return
	end 'opDropSlot'
	if x.op == Opcode.opDropAt 'opDropAt'
		out.push(dropAtAddr(x))
		return
	end 'opDropAt'
	if x.op == Opcode.opMoveSlot 'opMoveSlot'
		return
	end 'opMoveSlot'
	if x.op == Opcode.opMoveAt 'opMoveAt'
		out.push(moveAtAddr(x))
		return
	end 'opMoveAt'
	if x.op == Opcode.opCopy 'opCopy'
		out.push(copySrc(x))
		return
	end 'opCopy'
	panic("ir: an instruction has no opcode")
end 'instrReads'

// termReads appends the registers a terminator reads to out, in the order of its operands: its value and the
// arguments of its edges.
export function termReads(f IrFunction, t Term, mutates out RegList)
	if t.kind == TermKind.termJump 'termJump'
		f.regsInto(jumpArgsStart(t), count: jumpArgsCount(t), out: out)
		return
	end 'termJump'
	if t.kind == TermKind.termBranch 'termBranch'
		out.push(branchCond(t))
		f.regsInto(branchTrueArgsStart(t), count: branchTrueArgsCount(t), out: out)
		f.regsInto(branchFalseArgsStart(t), count: branchFalseArgsCount(t), out: out)
		return
	end 'termBranch'
	if t.kind == TermKind.termSwitch 'termSwitch'
		out.push(switchValue(t))
		f.caseArgsInto(switchCasesStart(t), count: switchCasesCount(t), out: out)
		f.regsInto(switchFallbackArgsStart(t), count: switchFallbackArgsCount(t), out: out)
		return
	end 'termSwitch'
	if t.kind == TermKind.termRet 'termRet'
		out.push(retValue(t))
		return
	end 'termRet'
	if t.kind == TermKind.termTrap 'termTrap'
		return
	end 'termTrap'
	if t.kind == TermKind.termThrow 'termThrow'
		out.push(throwErr(t))
		return
	end 'termThrow'
	panic("ir: a block has no terminator")
end 'termReads'

// instrWrites appends the registers an instruction writes to out: its result, and the error of a call that throws.
