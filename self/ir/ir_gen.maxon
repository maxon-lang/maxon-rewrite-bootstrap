	if t.kind != TermKind.termSwitch 'kind'
		wrongTerm("switchValue", found: t.kind)
	end 'kind'
	return t.value
end 'switchValue'

// switchCasesStart is where the cases of a Switch start in their pool.
export function switchCasesStart(t Term) returns Count
	if t.kind != TermKind.termSwitch 'kind'
		wrongTerm("switchCasesStart", found: t.kind)
