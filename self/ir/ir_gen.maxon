export function loadRawWidth(x Instr) returns RawWidth
	if x.op != Opcode.opLoadRaw 'op'
		wrongInstr("loadRawWidth", found: x.op)
	end 'op'
	return rawWidthOf(x.sub)
end 'loadRawWidth'

export function storeRawAddr(x Instr) returns Reg
	if x.op != Opcode.opStoreRaw 'op'
		wrongInstr("storeRawAddr", found: x.op)
	end 'op'
