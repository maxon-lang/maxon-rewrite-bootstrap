export function jumpTarget(t Term) returns BlockID
	if t.kind != TermKind.termJump 'kind'
		wrongTerm("jumpTarget", found: t.kind)
	end 'kind'
	return t.target
end 'jumpTarget'

// jumpArgsStart is where the args of a Jump start in their pool.
export function jumpArgsStart(t Term) returns Count
	if t.kind != TermKind.termJump 'kind'
		wrongTerm("jumpArgsStart", found: t.kind)
	end 'kind'
	return try t.args as Count otherwise panic("ir: jump args is out of range")
end 'jumpArgsStart'

// jumpArgsCount is how many args a Jump has.
export function jumpArgsCount(t Term) returns Count
	if t.kind != TermKind.termJump 'kind'
		wrongTerm("jumpArgsCount", found: t.kind)
	end 'kind'
	return try t.targetArgs as Count otherwise panic("ir: jump args is out of range")
end 'jumpArgsCount'

export function branchCond(t Term) returns Reg
	if t.kind != TermKind.termBranch 'kind'
		wrongTerm("branchCond", found: t.kind)
	end 'kind'
	return t.value
end 'branchCond'

export function branchIfTrue(t Term) returns BlockID
	if t.kind != TermKind.termBranch 'kind'
		wrongTerm("branchIfTrue", found: t.kind)
	end 'kind'
	return t.target
end 'branchIfTrue'

// branchTrueArgsStart is where the trueArgs of a Branch start in their pool.
export function branchTrueArgsStart(t Term) returns Count
	if t.kind != TermKind.termBranch 'kind'
		wrongTerm("branchTrueArgsStart", found: t.kind)
	end 'kind'
	return try t.args as Count otherwise panic("ir: branch trueArgs is out of range")
end 'branchTrueArgsStart'

// branchTrueArgsCount is how many trueArgs a Branch has.
export function branchTrueArgsCount(t Term) returns Count
	if t.kind != TermKind.termBranch 'kind'
		wrongTerm("branchTrueArgsCount", found: t.kind)
	end 'kind'
	return try t.targetArgs as Count otherwise panic("ir: branch trueArgs is out of range")
end 'branchTrueArgsCount'

export function branchIfFalse(t Term) returns BlockID
	if t.kind != TermKind.termBranch 'kind'
		wrongTerm("branchIfFalse", found: t.kind)
	end 'kind'
	return t.other
end 'branchIfFalse'

// branchFalseArgsStart is where the falseArgs of a Branch start in their pool.
export function branchFalseArgsStart(t Term) returns Count
	return try branchTrueArgsStart(t) + branchTrueArgsCount(t) otherwise panic("ir: branch falseArgs is out of range")
end 'branchFalseArgsStart'

// branchFalseArgsCount is how many falseArgs a Branch has.
export function branchFalseArgsCount(t Term) returns Count
	if t.kind != TermKind.termBranch 'kind'
		wrongTerm("branchFalseArgsCount", found: t.kind)
	end 'kind'
	return try t.otherArgs as Count otherwise panic("ir: branch falseArgs is out of range")
end 'branchFalseArgsCount'

