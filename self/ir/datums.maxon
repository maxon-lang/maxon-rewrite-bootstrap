// DatumPart is what a word of a box of a constant holds.
export enum DatumPart
	// scalar is the word itself: a number, a bool, a float's bits, an enum's case.
	scalar
	// text is a String of the datum's texts, which value indexes: two words, the address of its bytes and its word.
	text
	// box is the address of another box of the datum, which value indexes.
	box
end 'DatumPart'

export type DatumWord
	export var part as DatumPart
	export var value as Word

	export static function make(part DatumPart, value Word) returns DatumWord
		return DatumWord{part: part, value: value}
	end 'make'
end 'DatumWord'

export typealias DatumWordList = Array with DatumWord

// datumWordWidth is how many words of memory a value of a datum takes: a String's two, or one.
export function datumWordWidth(w DatumWord) returns Count
	return match w.part 'part'
		text gives stringValueBytes / wordBytes
		scalar gives 1
		box gives 1
	end 'part'
end 'datumWordWidth'

// datumWordsOf is how many words of memory the values words[first] on, count of them, take.
export function datumWordsOf(words DatumWordList, first Count, count Count) returns Count
	var total = 0 as Count
	for i in first upto try first + count otherwise panic("ir: a datum past memory") 'each'
		total = try total + datumWordWidth(words[i]) otherwise panic("ir: a datum past memory")
	end 'each'
	return total
end 'datumWordsOf'

// DatumShape is how a box of a constant is laid out, as lowering lays out the box it would build.
export enum DatumShape
	// words is the box of a record, a tuple or a union, a word each (a union's case index first), padded as boxBytes pads.
	words
	// array is the box of an array, its length, capacity and buffer, and the buffer of a word to an element.
	array
	// bytes is the box of a packed array, as an array's, and the buffer of a byte to an element.
	bytes
end 'DatumShape'

// DatumBox is one box of a constant: its words are words[first] on, count of them. The box of an array has room for capacity
// elements, its count and roomBytes of zeros after them, as an array that reserved that room has (`create(n, zeroed:
// false)`).
export type DatumBox
	export var shape as DatumShape
	export var first as Count
	export var count as Count
	export var capacity as Count
	export var roomBytes as Count

	export static function make(shape DatumShape, first Count, count Count) returns DatumBox
		return DatumBox{shape: shape, first: first, count: count, capacity: count, roomBytes: 0}
	end 'make'
end 'DatumBox'

export typealias DatumBoxList = Array with DatumBox

// Datum is a constant laid out before the program runs: boxes[root] is its value, and the boxes and strings it reaches are
// in it too, so the executable holds it as one piece. It is named by symbol, which says which constant it is, so every
// function and every module that reads it names one datum.
export type Datum
	export var symbol as String
	export var root as Count
	export var boxes as DatumBoxList
	export var words as DatumWordList
	export var texts as ast.StringList

	export static function make(consumes symbol String) returns Datum
		return Datum{symbol: symbol, root: 0, boxes: DatumBoxList.create(0), words: DatumWordList.create(0), texts: ast.StringList.create(0)}
	end 'make'
end 'Datum'

export typealias DatumList = Array with Datum

// DatumBuild is a datum being laid out, with the parameters of the literal factory whose body is being read bound to the
// words of the call's arguments.
type DatumBuild
	var d as Datum
	var params as ast.LocalIDList
	var args as DatumWordList

	static function make(consumes symbol String) returns DatumBuild
		return DatumBuild{d: Datum.make(symbol), params: ast.LocalIDList.create(0), args: DatumWordList.create(0)}
	end 'make'
end 'DatumBuild'

// constantSymbol is the name of the datum of a constant of a module: "const " and its module's link path and name.
function constantSymbol(p ast.Project, ref ast.DeclRef) returns String
	return "const {ast.moduleLinkPath(p, modID: ref.module)}{ast.linkSeparator}{ast.declName(p, ref: ref)}"
end 'constantSymbol'

// rawSymbol is the name of the datum of the raw value of a case of an enum or a union: "raw ", the type's link name and
// the case.
function rawSymbol(p ast.Project, ms ast.ModuleState, origin ast.TypeID, index Count) returns String
	return "raw {ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: origin)}.{ast.typeEntry(ms.types, reads: p.types, t: origin).cases[index].name}"
end 'rawSymbol'

// constantDatum is the datum of the constant a name stands for, or none when the constant is read as it is lowered: its
// value is a number, a string or a function, or is not known before the program runs.
function constantDatum(p ast.Project, ms ast.ModuleState, name ast.NameInfo) returns table.Option with Datum
	if isInstanceConstant(p, ms: ms, ref: name.decl) 'perInstance'
		return table.Option.none
	end 'perInstance'
	return datumOf(p, ms: ms, symbol: constantSymbol(p, ref: name.decl), e: constantExpr(p, name: name))
end 'constantDatum'

// isInstanceConstant is whether a constant is one for each instance of its generic type, so that its value is built where it
// is read, with the instance's arguments bound, and never laid out once.
function isInstanceConstant(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns bool
	match consumes ast.declConst(p, ms: ms, ref: ref) 'valued'
		some(value) then return value.instanceOf != ast.noType
		none then return false
	end 'valued'
end 'isInstanceConstant'

// rawDatums are the datums of the raw values of the cases of an enum or a union, in the order of the cases, or none when
// a case's raw value is not one: then every case's is built where it is read, so a read has one owner whichever case it is.
function rawDatums(p ast.Project, ms ast.ModuleState, origin ast.TypeID) returns table.Option with DatumList
	if ast.typeEntry(ms.types, reads: p.types, t: origin).rawKind != ast.RawKind.value 'notBuilt'
		return table.Option.none
	end 'notBuilt'
	let module = ast.typeEntry(ms.types, reads: p.types, t: origin).decl.module
	var out = DatumList.create(0)
	for i in 0 upto ast.typeEntry(ms.types, reads: p.types, t: origin).cases.count() 'each'
		let e = ExprRef.make(module, node: ast.typeEntry(ms.types, reads: p.types, t: origin).cases[i].rawExpr)
		if not pushFound(out, found: datumOf(p, ms: ms, symbol: rawSymbol(p, ms: ms, origin: origin, index: i), e: e)) 'unknown'
			return table.Option.none
		end 'unknown'
	end 'each'
	return table.Option.some(out)
end 'rawDatums'

// pushFound adds a datum that was found to out, and gives whether there was one.
function pushFound(mutates out DatumList, consumes found table.Option with Datum) returns bool
	match consumes found 'found'
		some(d) then out.push(d)
		none then return false
	end 'found'
	return true
end 'pushFound'

// datumOf lays out the value of the constant expression e as the datum symbol, or gives none when the value is no box or is
// not known before the program runs. This is the one place that decides which constants live in the executable's data.
function datumOf(p ast.Project, ms ast.ModuleState, consumes symbol String, e ExprRef) returns table.Option with Datum
	var b = DatumBuild.make(symbol)
	var w = DatumWord.make(DatumPart.scalar, value: 0 as Word)
	if not datumWord(b, p: p, ms: ms, module: e.module, e: e.node, w: w) 'unknown'
		return table.Option.none
	end 'unknown'
	if w.part != DatumPart.box 'notBox'
		// A number is a constant of the code, and a string a literal, which the executable holds already.
		return table.Option.none
	end 'notBox'
	b.d.root = try w.value as Count otherwise panic("ir: a constant's box that is not one")
	return table.Option.some(b.d)
end 'datumOf'

function wordAt(v Count) returns Word
	return try v as Word otherwise panic("ir: an index of a datum past a word")
end 'wordAt'

// datumWord lays out the value of e, of the module, and gives the word that holds it, or false when the value is not known
// before the program runs, which leaves the constant to be built where it is read.
function datumWord(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID, mutates w DatumWord) returns bool
	let mi = ast.modIndex(module)
	if ast.boxedTo(p.typings[mi], node: e) != ast.noType or p.typings[mi].rawReads.has(e as Count) 'boxed'
		return false
	end 'boxed'
	let ty = exprType(p, module: module, node: e)
	let tk = ast.typeKind(ms.types, reads: p.types, t: ty)
	let k = p.modules[mi].tree.kindOf(e)
	if tk == ast.TypeKind.constInt and not isBranching(k) 'constInt'
		w = DatumWord.make(DatumPart.scalar, value: wordOf(ast.typeEntry(ms.types, reads: p.types, t: ty).minVal))
		return true
	end 'constInt'
	if tk == ast.TypeKind.constFloat and not isBranching(k) 'constFloat'
		w = DatumWord.make(DatumPart.scalar, value: floatWord(ast.floatLowBits(ms.types, reads: p.types, t: ty)))
		return true
	end 'constFloat'
	if k == ast.NodeKind.intLit 'intLit'
		w = DatumWord.make(DatumPart.scalar, value: wordOf(ast.intLitValue(p.modules[mi].tree, id: e)))
		return true
	end 'intLit'
	if k == ast.NodeKind.floatLit 'floatLit'
		w = DatumWord.make(DatumPart.scalar, value: floatWord(ast.floatLitBits(p.modules[mi].tree, id: e)))
		return true
	end 'floatLit'
	if k == ast.NodeKind.boolLit 'boolLit'
		if ast.boolLitValue(p.modules[mi].tree, id: e) 'true'
			w = DatumWord.make(DatumPart.scalar, value: 1 as Word)
		end 'true'
		return true
	end 'boolLit'
	if k == ast.NodeKind.strLit 'strLit'
		let partsRef = ast.strLitPartsRef(p.modules[mi].tree, id: e)
		if not p.modules[mi].tree.strIsPlain(partsRef) 'interpolates'
			return false
		end 'interpolates'
		w = DatumWord.make(DatumPart.text, value: wordAt(b.d.texts.count()))
		b.d.texts.push(ast.strPartsText(p.modules[mi].tree, partsRef: partsRef))
		return true
	end 'strLit'
	if k == ast.NodeKind.nameExpr 'nameExpr'
		return datumName(b, p: p, ms: ms, module: module, e: e, w: w)
	end 'nameExpr'
	if k == ast.NodeKind.memberExpr 'memberExpr'
		let member = memberInfoAt(p, module: module, node: e)
		if member.kind == ast.MemberKind.memberEnumCase 'enumCase'
			w = DatumWord.make(DatumPart.scalar, value: wordAt(member.enumCase))
			return true
		end 'enumCase'
		if member.kind == ast.MemberKind.memberUnionCase 'unionCase'
			return datumRecord(b, p: p, ms: ms, t: ty, tag: indexOf(member.enumCase), module: module, values: ExprRefList.create(0), w: w)
		end 'unionCase'
		// A field, a raw value or a name read off another value is read where the constant is.
		return false
	end 'memberExpr'
	if k == ast.NodeKind.castExpr 'castExpr'
		return datumCast(b, p: p, ms: ms, module: module, e: e, w: w)
	end 'castExpr'
	if k == ast.NodeKind.callExpr 'callExpr'
		return datumCall(b, p: p, ms: ms, module: module, e: e, w: w)
	end 'callExpr'
	if k == ast.NodeKind.structLitExpr or k == ast.NodeKind.tupleExpr 'structLitExpr'
		let lit = structLitInfoAt(p, module: module, node: e)
		if ast.typeKind(ms.types, reads: p.types, t: lit.ty) == ast.TypeKind.builtinArray 'emptyArray'
			return datumArrayOf(b, p: p, ms: ms, module: module, ty: lit.ty, count: 0, value: 0 as ast.NodeID, capacity: 0, w: w)
		end 'emptyArray'
		let origin = ast.typeEntry(ms.types, reads: p.types, t: lit.ty).effectiveOrigin()
		var values = ExprRefList.create(0)
		for i in 0 upto lit.ordered.count() 'each'
			if lit.ordered[i] != 0 'given'
				values.push(ExprRef.make(module, node: lit.ordered[i]))
			end 'given' else 'default'
				values.push(ExprRef.make(ast.typeEntry(ms.types, reads: p.types, t: origin).decl.module, node: ast.typeEntry(ms.types, reads: p.types, t: origin).fields[i].defaultExpr))
			end 'default'
		end 'each'
		return datumRecord(b, p: p, ms: ms, t: lit.ty, tag: noTag, module: module, values: values, w: w)
	end 'structLitExpr'
	if k == ast.NodeKind.collectionLitExpr 'collectionLitExpr'
		return datumArray(b, p: p, ms: ms, module: module, tree: p.modules[mi].tree, e: e, ty: ty, w: w)
	end 'collectionLitExpr'
	if k == ast.NodeKind.fromExpr 'fromExpr'
		// An array written `Type from [...]` is the literal built as that type (visitFromExpr); any other type is built by
		// its init, which runs code.
		if not ast.isLiteralCollection(ms.types, reads: p.types, t: ty) 'init'
			return false
		end 'init'
		return datumArray(b, p: p, ms: ms, module: module, tree: p.modules[mi].tree, e: ast.fromExprValue(p.modules[mi].tree, id: e), ty: ty, w: w)
	end 'fromExpr'
	if k == ast.NodeKind.byteStrLit or k == ast.NodeKind.charLit or k == ast.NodeKind.selfExpr or k == ast.NodeKind.binaryExpr or k == ast.NodeKind.unaryExpr or k == ast.NodeKind.asyncExpr or k == ast.NodeKind.awaitExpr or k == ast.NodeKind.spawnExpr or k == ast.NodeKind.condExpr or k == ast.NodeKind.rangeExpr or k == ast.NodeKind.tryExpr or k == ast.NodeKind.panicExpr or k == ast.NodeKind.indexExpr or k == ast.NodeKind.matchExpr or k == ast.NodeKind.closureExpr or k == ast.NodeKind.typeQueryExpr 'perUse'
		// Computed where it is read: a byte string is a new byte array each time, and the others run code or compute a
		// number that the type of the expression does not hold.
		return false
	end 'perUse'
	panic("ir: a constant's value holds the node {e} of kind {k.name}, which no datum lays out")
end 'datumWord'

// datumName is the value a name in a constant stands for: another constant, laid out again inside this one, or a parameter
// of the literal factory being read.
function datumName(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID, mutates w DatumWord) returns bool
	let name = nameInfoAt(p, module: module, node: e)
	if name.kind == ast.NameKind.nameConst 'const'
		let value = constantExpr(p, name: name)
		return datumWord(b, p: p, ms: ms, module: value.module, e: value.node, w: w)
	end 'const'
	if name.kind == ast.NameKind.nameLocal 'param'
		for i in 0 upto b.params.count() 'each'
			if b.params[i] == name.local 'bound'
				w = b.args[i].clone()
				return true
			end 'bound'
		end 'each'
		return false
	end 'param'
	// A function named as a value is a closure, which shares a count; a field of self is no constant.
	return false
end 'datumName'

// datumCast is a cast in a constant: one that only renames the type is its operand, and one to an integer type of an
// integer the checker knows is that integer when it fits, which it does in a constant the checker accepted without a try.
function datumCast(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID, mutates w DatumWord) returns bool
	let mi = ast.modIndex(module)
	let inner = ast.castExprE(p.modules[mi].tree, id: e)
	let target = exprType(p, module: module, node: e)
	if ast.typeKind(ms.types, reads: p.types, t: target) == ast.TypeKind.interfaceTy 'boxes'
		return false
	end 'boxes'
	if ast.castRebrands(ms.types, reads: p.types, target: target) 'rebrand'
		return datumWord(b, p: p, ms: ms, module: module, e: inner, w: w)
	end 'rebrand'
	let source = exprType(p, module: module, node: inner)
	if ast.typeKind(ms.types, reads: p.types, t: source) != ast.TypeKind.constInt or ast.typeKind(ms.types, reads: p.types, t: target) != ast.TypeKind.intRange 'notInteger'
		return false
	end 'notInteger'
	let v = ast.typeEntry(ms.types, reads: p.types, t: source).minVal.clone()
	if not ast.typeEntry(ms.types, reads: p.types, t: target).minVal.le(v) or not ast.typeEntry(ms.types, reads: p.types, t: target).maxVal.ge(v) 'outside'
		return false
	end 'outside'
	w = DatumWord.make(DatumPart.scalar, value: wordOf(v))
	return true
end 'datumCast'

// datumCall is a call in a constant: a copy is the value it copies, a case of a union with a payload a box, `create` of an
// array the array it makes, and a literal factory the record literal it returns with the arguments written in.
function datumCall(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID, mutates w DatumWord) returns bool
	let mi = ast.modIndex(module)
	let info = callInfoAt(p, module: module, node: e)
	if info.kind == ast.CallKind.callCopy 'copy'
		return datumWord(b, p: p, ms: ms, module: module, e: ast.callReceiver(p.modules[mi].tree, e: e, kind: info.kind), w: w)
	end 'copy'
	if info.kind == ast.CallKind.callUnionCtor 'ctor'
		var values = ExprRefList.create(0)
		for i in 0 upto info.ordered.count() 'each'
			if info.ordered[i] == 0 'defaulted'
				return false
			end 'defaulted'
			values.push(ExprRef.make(module, node: info.ordered[i]))
		end 'each'
		return datumRecord(b, p: p, ms: ms, t: exprType(p, module: module, node: e), tag: indexOf(info.unionCase), module: module, values: values, w: w)
	end 'ctor'
	if info.kind != ast.CallKind.callStatic 'notFactory'
		return false
	end 'notFactory'
	let fn = info.fn
	if isArrayCreate(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).intrinsic) 'create'
		return datumArrayCreate(b, p: p, ms: ms, module: module, e: e, info: info, op: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).intrinsic, w: w)
	end 'create'
	let fm = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).module
	let fmi = ast.modIndex(fm)
	let body = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fn).bodyRef
	if p.modules[fmi].tree.listLen(body) != 1 'statements'
		return false
	end 'statements'
	let s = p.modules[fmi].tree.listAt(body, index: 0) as ast.NodeID
	if p.modules[fmi].tree.kindOf(s) != ast.NodeKind.returnStmt 'notReturn'
		return false
	end 'notReturn'
	let value = ast.returnStmtValue(p.modules[fmi].tree, id: s)
	if value == 0 or p.modules[fmi].tree.kindOf(value) != ast.NodeKind.structLitExpr 'notLiteral'
		return false
	end 'notLiteral'
	var params = ast.LocalIDList.create(0)
	var args = DatumWordList.create(0)
	for i in 0 upto info.ordered.count() 'each'
		let arg = info.ordered[i]
		if arg == 0 'defaulted'
			return false
		end 'defaulted'
		if ast.isFloatType(ms.types, reads: p.types, t: info.paramSpecs[i].ty) and ast.isIntType(ms.types, reads: p.types, t: exprType(p, module: module, node: arg)) 'converted'
			return false
		end 'converted'
		var a = DatumWord.make(DatumPart.scalar, value: 0 as Word)
		if not datumWord(b, p: p, ms: ms, module: module, e: arg, w: a) 'unknown'
			return false
		end 'unknown'
		params.push(ast.paramLocal(p, ms: ms, f: fn, index: i))
		args.push(a)
	end 'each'
	let savedParams = exchange(b.params, value: params)
	let savedArgs = exchange(b.args, value: args)
	let known = datumWord(b, p: p, ms: ms, module: fm, e: value, w: w)
	b.params = savedParams
	b.args = savedArgs
	return known
end 'datumCall'

// datumRecord lays out a box of words of the type t: the case index first when tag is one, then a word for each value,
// padded to the size lowering gives the box. A union held as a word is that word (UnionForm).
function datumRecord(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, t ast.TypeID, tag Index, module diag.ModuleID, values ExprRefList, mutates w DatumWord) returns bool
	let tagged = tag != noTag
	if tagged and ast.typeKind(ms.types, reads: p.types, t: t) == ast.TypeKind.unionTy 'union'
		let caseIndex = try tag as Count otherwise panic("ir: a case index past a word")
		let form = unionForm(ms.types, reads: p.types, t: t)
		if form == UnionForm.unionCases 'cases'
			w = DatumWord.make(DatumPart.scalar, value: caseIndex as Word)
			return true
		end 'cases'
		if form == UnionForm.unionNiche 'niche'
			if caseIndex == payloadCase(ms.types, reads: p.types, t: t) 'payload'
				return datumWord(b, p: p, ms: ms, module: values[0].module, e: values[0].node, w: w)
			end 'payload'
			w = DatumWord.make(DatumPart.scalar, value: unionNicheWord(ms.types, reads: p.types, t: t))
			return true
		end 'niche'
		if form == UnionForm.unionNull 'null'
			if caseIndex == payloadCase(ms.types, reads: p.types, t: t) 'payload'
				// Its payload case is the payload's box.
				let payload = try values.get(0) otherwise panic("ir: a payload case without its payload")
				return datumWord(b, p: p, ms: ms, module: payload.module, e: payload.node, w: w)
			end 'payload'
			// Its empty case is the word 0, which the data does not hold as a value; it is built where it is read.
			return false
		end 'null'
	end 'union' else if not tagged 'record'
		// A record whose field's words are its own is built where it is read: the data lays a value out as a word or a box.
		for i in 0 upto fieldsOf(ms.types, reads: p.types, owner: t) 'fields'
			let field = ast.typeEntry(ms.types, reads: p.types, t: ast.originOf(ms.types, reads: p.types, t: t)).fields[i].ty
			match holding(ms.types, reads: p.types, b: p.builtins, t: field, holder: Holder.inField(t, index: i)) 'field'
				heldInline(_) then return false
				heldWord or
				heldString or
				heldBox then continue 'fields'
				heldAddress(_) panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
				heldPacked panic("ir: a field that holds the address of words elsewhere or a byte of a buffer")
			end 'field'
		end 'fields'
	end 'record'
	let at = b.d.boxes.count()
	b.d.boxes.push(DatumBox.make(DatumShape.words, first: 0, count: 0))
	var parts = DatumWordList.create(0)
	if tagged 'tag'
		parts.push(DatumWord.make(DatumPart.scalar, value: tag as Word))
	end 'tag'
	for i in 0 upto values.count() 'each'
		var v = DatumWord.make(DatumPart.scalar, value: 0 as Word)
		if not datumWord(b, p: p, ms: ms, module: values[i].module, e: values[i].node, w: v) 'unknown'
			return false
		end 'unknown'
		parts.push(v)
	end 'each'
	let start = 1 as Count if tagged else 0 as Count
	let words = boxBytes(datumWordsOf(parts, first: start, count: try parts.count() - start otherwise panic("ir: a datum below its tag")), tagged: tagged) / wordBytes
	while datumWordsOf(parts, first: 0, count: parts.count()) < words 'pad'
		parts.push(DatumWord.make(DatumPart.scalar, value: 0 as Word))
	end 'pad'
	b.d.boxes[at] = DatumBox.make(DatumShape.words, first: b.d.words.count(), count: parts.count())
	b.d.words.append(parts)
	w = DatumWord.make(DatumPart.box, value: wordAt(at))
	return true
end 'datumRecord'

// datumArray lays out an array literal: its elements, a word each or a byte each for an array that packs them. A map and
// a list are built where they are read. The literal e is of the module, whose tree is tree.
function datumArray(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, tree ast.Tree, e ast.NodeID, ty ast.TypeID, mutates w DatumWord) returns bool
	var shape = DatumShape.array
	if not datumArrayShape(p, ms: ms, ty: ty, shape: shape) 'built'
		return false
	end 'built'
	let elemsRef = ast.collectionLitExprElemsRef(tree, id: e)
	var parts = DatumWordList.create(0)
	for i in 0 upto tree.listLen(elemsRef) 'each'
		if not pushDatumElement(b, p: p, ms: ms, module: module, e: tree.listAt(elemsRef, index: i) as ast.NodeID, shape: shape, parts: parts) 'unknown'
			return false
		end 'unknown'
	end 'each'
	finishDatumArray(b, shape: shape, parts: parts, capacity: 0, elementBytes: 0, w: w)
	return true
end 'datumArray'

// datumArrayShape is how the box of an array of the type ty is laid out, a word or a byte to an element, or false where the
// array is no datum: a map, a list, an array of a type parameter's elements, or of elements held in place, whose words are
// in the buffer and which the data lays out as boxes.
function datumArrayShape(p ast.Project, ms ast.ModuleState, ty ast.TypeID, mutates shape DatumShape) returns bool
	let bt = ast.contentType(ms.types, reads: p.types, t: ty)
	if ast.typeKind(ms.types, reads: p.types, t: bt) != ast.TypeKind.builtinArray 'notArray'
		return false
	end 'notArray'
	let elem = ast.typeArgAt(ms.types, reads: p.types, t: bt, index: 0)
	if ast.typeKind(ms.types, reads: p.types, t: elem) == ast.TypeKind.typeParam 'built'
		return false
	end 'built'
	match holding(ms.types, reads: p.types, b: p.builtins, t: elem, holder: Holder.inElement) 'way'
		heldInline(_) then return false
		heldPacked then shape = DatumShape.bytes
		heldString or
		heldWord or
		heldBox then shape = DatumShape.array
		heldAddress(_) panic("ir: an element held as the address of words elsewhere")
	end 'way'
	return true
end 'datumArrayShape'

// pushDatumElement lays out the element e of an array of the shape and adds its word to parts, or gives false when it is not
// known before the program runs.
function pushDatumElement(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID, shape DatumShape, mutates parts DatumWordList) returns bool
	var v = DatumWord.make(DatumPart.scalar, value: 0 as Word)
	if not datumWord(b, p: p, ms: ms, module: module, e: e, w: v) 'unknown'
		return false
	end 'unknown'
	if shape == DatumShape.bytes and v.part != DatumPart.scalar 'notByte'
		panic("ir: an element of a packed array constant is no number")
	end 'notByte'
	parts.push(v)
	return true
end 'pushDatumElement'

// finishDatumArray adds the box of an array with the words of its elements, laid out before it, and room for capacity of
// them, each elementBytes long, and gives it as the value.
function finishDatumArray(mutates b DatumBuild, shape DatumShape, parts DatumWordList, capacity Count, elementBytes Count, mutates w DatumWord)
	let at = b.d.boxes.count()
	var box = DatumBox.make(shape, first: b.d.words.count(), count: parts.count())
	if capacity > parts.count() 'room'
		box.capacity = capacity
		box.roomBytes = try (capacity - parts.count()) * elementBytes otherwise panic("ir: a constant's room past memory")
	end 'room'
	b.d.boxes.push(box)
	b.d.words.append(parts)
	w = DatumWord.make(DatumPart.box, value: wordAt(at))
end 'finishDatumArray'

// isArrayCreate is whether a built-in is a `create` of an Array or a FixedArray.
function isArrayCreate(op ast.Intrinsic) returns bool
	return op == ast.Intrinsic.intrArrayCreate or op == ast.Intrinsic.intrArrayCreateZeroed or op == ast.Intrinsic.intrArrayFilled or op == ast.Intrinsic.intrFixedArrayCreate or op == ast.Intrinsic.intrFixedArrayFilled or op == ast.Intrinsic.intrFixedArrayCreateCounted
end 'isArrayCreate'

// datumArrayCreate is the array that a call of `create` of an Array or a FixedArray makes, as lowering makes it (arrayZeroed,
// arrayFilled): a count of copies of the value it is given, or of zero elements, where the element has a zero, and
// otherwise none. `create(n, zeroed: false)` is the empty array; the room it reserves is the runtime's buffer, which is no
// part of the value (the interpreter does not model it). The count is the one the type states or a constant argument.
function datumArrayCreate(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID, info ast.CallInfo, op ast.Intrinsic, mutates w DatumWord) returns bool
	let ty = exprType(p, module: module, node: e)
	var count = 0 as Count
	if op == ast.Intrinsic.intrFixedArrayCreate or op == ast.Intrinsic.intrFixedArrayFilled 'stated'
		count = ast.statedCount(ms.types, reads: p.types, t: ty)
	end 'stated' else 'argument'
		var n = DatumWord.make(DatumPart.scalar, value: 0 as Word)
		if not datumWord(b, p: p, ms: ms, module: module, e: createArgument(info, index: 0), w: n) or n.part != DatumPart.scalar 'unknown'
			return false
		end 'unknown'
		count = try n.value as Count otherwise return false
	end 'argument'
	var value = 0 as ast.NodeID
	if op == ast.Intrinsic.intrFixedArrayFilled 'filledStated'
		value = createArgument(info, index: 0)
	end 'filledStated' else if op == ast.Intrinsic.intrArrayFilled 'filled'
		value = createArgument(info, index: 1)
	end 'filled' else if op == ast.Intrinsic.intrArrayCreateZeroed and not datumFlag(b, p: p, ms: ms, module: module, e: createArgument(info, index: 1)) 'reserved'
		return datumArrayOf(b, p: p, ms: ms, module: module, ty: ty, count: 0, value: value, capacity: count, w: w)
	end 'reserved'
	return datumArrayOf(b, p: p, ms: ms, module: module, ty: ty, count: count, value: value, capacity: count, w: w)
end 'datumArrayCreate'

// datumFlag is the literal `true` or `false` that the checker requires of a flag of a call (`zeroed:`), read as the word
// it lays out.
function datumFlag(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, e ast.NodeID) returns bool
	var v = DatumWord.make(DatumPart.scalar, value: 0 as Word)
	if not datumWord(b, p: p, ms: ms, module: module, e: e, w: v) or v.part != DatumPart.scalar 'unknown'
		panic("ir: a flag of a call that is no literal bool")
	end 'unknown'
	return v.value != 0 as Word
end 'datumFlag'

// createArgument is the argument of a call of `create` that the parameter index is given, which the checker requires.
function createArgument(info ast.CallInfo, index Count) returns ast.NodeID
	return try info.ordered.get(index) otherwise panic("ir: a call of create without its argument {index}")
end 'createArgument'

// datumArrayOf lays out an array of the type ty of count elements, with room for capacity of them: each a copy of the value,
// laid out again for each so that no two share a box, or, where there is no value, a zero, which an element with no zero has
// none of.
function datumArrayOf(mutates b DatumBuild, p ast.Project, ms ast.ModuleState, module diag.ModuleID, ty ast.TypeID, count Count, value ast.NodeID, capacity Count, mutates w DatumWord) returns bool
	var shape = DatumShape.array
	if not datumArrayShape(p, ms: ms, ty: ty, shape: shape) 'built'
		return false
	end 'built'
	var n = count
	if value == 0 and not hasZero(p, ms: ms, t: ast.typeArgAt(ms.types, reads: p.types, t: ast.contentType(ms.types, reads: p.types, t: ty), index: 0)) 'noZero'
		n = 0
	end 'noZero'
	var parts = DatumWordList.create(0)
	for _ in 0 upto n 'each'
		if value == 0 'zero'
			parts.push(DatumWord.make(DatumPart.scalar, value: 0 as Word))
		end 'zero' else if not pushDatumElement(b, p: p, ms: ms, module: module, e: value, shape: shape, parts: parts) 'unknown'
			return false
		end 'unknown'
	end 'each'
	finishDatumArray(b, shape: shape, parts: parts, capacity: capacity, elementBytes: datumElementBytes(p, ms: ms, ty: ty, shape: shape), w: w)
	return true
end 'datumArrayOf'

// datumElementBytes is how many bytes an element of an array of the type ty takes in its buffer: a byte where it packs, a
// String's two words, or a word.
function datumElementBytes(p ast.Project, ms ast.ModuleState, ty ast.TypeID, shape DatumShape) returns Count
	if shape == DatumShape.bytes 'packed'
		return 1
	end 'packed'
	let elem = ast.typeArgAt(ms.types, reads: p.types, t: ast.contentType(ms.types, reads: p.types, t: ty), index: 0)
	match holding(ms.types, reads: p.types, b: p.builtins, t: elem, holder: Holder.inElement) 'way'
		heldString then return stringValueBytes
		heldWord or
		heldBox or
		heldPacked then return wordBytes
		heldInline(_) then return wordBytes
		heldAddress(_) then return wordBytes
	end 'way'
end 'datumElementBytes'
