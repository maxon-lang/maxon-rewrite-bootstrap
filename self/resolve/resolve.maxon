typealias BoolStrMap = table.StringMap with bool

typealias ScopeStack = Array with BoolStrMap

typealias TypeParamMap = table.StringMap with Count

type LookupResult
	export var found as bool
	export var decl as ast.DeclRef
	export var hasErr as bool
	export var errCode as String
	export var errMsg as String

	static function hit(consumes d ast.DeclRef) returns LookupResult
		return LookupResult{found: true, decl: d, hasErr: false, errCode: "", errMsg: ""}
	end 'hit'

	static function miss() returns LookupResult
		return LookupResult{found: false, decl: ast.DeclRef.make(0 as diag.ModuleID, ordinal: 0 as ast.DeclOrdinal), hasErr: false, errCode: "", errMsg: ""}
	end 'miss'

	static function fail(consumes code String, consumes msg String) returns LookupResult
		return LookupResult{found: false, decl: ast.DeclRef.make(0 as diag.ModuleID, ordinal: 0 as ast.DeclOrdinal), hasErr: true, errCode: code, errMsg: msg}
	end 'fail'
end 'LookupResult'

type Segment
	export var name as String
	export var node as ast.NodeID

	static function make(consumes name String, node ast.NodeID) returns Segment
		return Segment{name: name, node: node}
	end 'make'
end 'Segment'

typealias SegmentList = Array with Segment

type Resolver
	export var modID as diag.ModuleID
	export var tree as ast.Tree
	export var res as ast.Resolution
	export var scopes as ScopeStack
	export var fields as BoolStrMap
	export var typeParams as TypeParamMap
	// members are the typealiases the body being resolved declares, or, in an extension, the ones its type's body and the
	// extensions of the module declare, by the name its code writes, which a bare name finds before the module's own
	// declarations.
	export var members as ast.DeclRefIndex
	// expandsMembers is whether a typealias of the body being resolved is the name of its target where a signature spells it,
	// as in the requirements of an interface: the signature exposes the target, which the typealias's own declaration checks.
	export var expandsMembers as bool
	// whenDepth is how many bodies of behaviours and closures enclose the code being resolved, each of which captures the
	// names it uses from the one around it.
	export var whenDepth as Count
	// inClosure is whether the innermost of those bodies is a closure's.
	export var inClosure as bool

	static function make(modID diag.ModuleID, consumes tree ast.Tree, consumes res ast.Resolution) returns Resolver
		return Resolver{modID: modID, tree: tree, res: res, scopes: ScopeStack.create(0), fields: BoolStrMap.new(), typeParams: TypeParamMap.new(), members: ast.DeclRefIndex.new(), expandsMembers: false, whenDepth: 0 as Count, inClosure: false}
	end 'make'
end 'Resolver'

function isPrimTypeName(name String) returns bool
	return name == "bool" or name == "String" or name == "Self" or name == "int" or name == "float"
end 'isPrimTypeName'

function pushErr(mutates errs diag.ErrorList, modID diag.ModuleID, off diag.U32, consumes code String, consumes msg String)
	diag.pushSiteError(errs, code: code, message: msg, module: modID, offset: off)
end 'pushErr'

function checkEnd(mutates r Resolver, label String, endNode ast.NodeID, mutates errs diag.ErrorList)
	if endNode == 0 'none'
		return
	end 'none'
	let got = ast.endLabelName(r.tree, id: endNode)
	if got != label 'bad'
		let off = r.tree.endKeywordStart(endNode)
		pushErr(errs, modID: r.modID, off: off, code: diag.errMismatchedEndLabel, msg: diag.mismatchedEndLabel(label, got: got))
	end 'bad'
end 'checkEnd'

function isDeclVisible(r Resolver, p ast.Project, ref ast.DeclRef) returns bool
	if ref.module == r.modID or ref.module == diag.stdlibID 'ownOrStd'
		return true
	end 'ownOrStd'
	return ast.isVisibleFrom(p, v: ast.declLevel(p, ref: ref), owner: ref.module, from: r.modID)
end 'isDeclVisible'

// hiddenMessage is the message for naming, from the resolver's module, a declaration that isDeclVisible refused.
function hiddenMessage(r Resolver, p ast.Project, ref ast.DeclRef) returns String
	return ast.notVisible(p, name: ast.declName(p, ref: ref), v: ast.declLevel(p, ref: ref), owner: ref.module, from: r.modID)
end 'hiddenMessage'

function modDisplayFor(p ast.Project, modID diag.ModuleID) returns String
	if modID == diag.stdlibID 'std'
		return p.stdlib.display()
	end 'std'
	return p.modules[ast.modIndex(modID)].display()
end 'modDisplayFor'

function takeLookup(mutates r Resolver, p ast.Project, consumes lr LookupResult, off diag.U32, mutates errs diag.ErrorList) returns table.Option with ast.DeclRef
	if lr.hasErr 'err'
		pushErr(errs, modID: r.modID, off: off, code: lr.errCode, msg: lr.errMsg)
		return table.Option.none
	end 'err'
	if not lr.found 'none'
		return table.Option.none
	end 'none'
	if lr.decl.module != r.modID and lr.decl.module != diag.stdlibID 'dep'
		r.res.addDep(lr.decl.module, offset: off)
	end 'dep'
	return table.Option.some(lr.decl)
end 'takeLookup'

// bareLookup looks up a name written without a module: a typealias of the type being resolved, else the module's own
// declaration, else a built-in. Another module's declarations are always qualified, so resolving a module reads only the
// modules it names.
function bareLookup(r Resolver, p ast.Project, name String) returns LookupResult
	match consumes r.members.get(name) 'member'
		some(ref) then return LookupResult.hit(ref)
		none then _ = 0
	end 'member'
	let ownIdx = ast.modIndex(r.modID)
	match p.modules[ownIdx].names.get(name) 'own'
		some(ord) then return LookupResult.hit(ast.DeclRef.make(r.modID, ordinal: ord))
		none then _ = 0
	end 'own'
	match p.stdlib.names.get(name) 'std'
		some(ord) then return LookupResult.hit(ast.DeclRef.make(diag.stdlibID, ordinal: ord))
		none then _ = 0
	end 'std'
	return LookupResult.miss()
end 'bareLookup'

// bareLookupAt is bareLookup that records a name it does not find, written at off, as unbound.
function bareLookupAt(mutates r Resolver, p ast.Project, name String, off diag.U32) returns LookupResult
	let found = bareLookup(r, p: p, name: name)
	if not found.found 'unbound'
		recordUnbound(r, name: name, off: off)
	end 'unbound'
	return found
end 'bareLookupAt'

// recordUnbound notes a bare name that nothing declares, unless it names a primitive type, which declares nothing.
function recordUnbound(mutates r Resolver, name String, off diag.U32)
	if not isPrimTypeName(name) 'named'
		r.res.unbound.push(ast.UnboundName.make(name.clone(), offset: off))
	end 'named'
end 'recordUnbound'

function isModuleRoot(p ast.Project, name String) returns bool
	if name == ast.rootQualifier or name == ast.stdlibQualifier 'special'
		return true
	end 'special'
	let rIdx = ast.modIndex(p.rootModule)
	return p.modules[rIdx].findChild(name).isSome()
end 'isModuleRoot'

function qualifiedLookup(mutates r Resolver, p ast.Project, head String, headOff diag.U32, rest ast.StringList, offs ast.U32List, mutates errs diag.ErrorList) returns Count
	var curMod = p.rootModule
	if head == ast.rootQualifier 'exp'
		curMod = p.rootModule
	end 'exp' else if head == ast.stdlibQualifier 'std'
		curMod = diag.stdlibID
	end 'std' else 'child'
		match p.modules[ast.modIndex(p.rootModule)].findChild(head) 'ch'
			some(cid) then curMod = cid
			none then return 0 as Count
		end 'ch'
	end 'child'
	var i = 0 as Count
	while i < rest.count() 'walk'
		let segName = rest[i].clone()
		if curMod == diag.stdlibID 'inStd'
			if p.stdlib.names.has(segName) 'hitStd'
				break 'walk'
			end 'hitStd'
			break 'walk'
		end 'inStd'
		let cIdx = ast.modIndex(curMod)
		if p.modules[cIdx].names.has(segName) 'hitDecl'
			break 'walk'
		end 'hitDecl'
		match p.modules[cIdx].findChild(segName) 'sub'
			some(nextMod) then curMod = nextMod
			none then break 'walk'
		end 'sub'
		i = try i + 1 otherwise i
	end 'walk'
	if i == rest.count() 'isMod'
		var joined = ByteArray.create(0)
		for k in 0 upto rest.count() 'j'
			if k > 0 'dot'
				joined.push(46 as Byte)
			end 'dot'
			joined.append(rest[k].toByteArray())
		end 'j'
		pushErr(errs, modID: r.modID, off: headOff, code: diag.errExpressionError, msg: "'{head}.{String.from(joined)}' is a module, not a value")
		return 0 as Count
	end 'isMod'
	let targetName = rest[i].clone()
	var optOrd as table.Option with ast.DeclOrdinal
	optOrd = table.Option.none
	if curMod == diag.stdlibID 'stdGet'
		optOrd = p.stdlib.names.get(targetName)
	end 'stdGet' else 'modGet'
		optOrd = p.modules[ast.modIndex(curMod)].names.get(targetName)
	end 'modGet'
	match optOrd 'found'
		some(ord) then return finishQualified(r, p: p, ref: ast.DeclRef.make(curMod, ordinal: ord), off: offs[i], used: try i + 1 otherwise 0 as Count, errs: errs)
		none then _ = 0
	end 'found'
	pushErr(errs, modID: r.modID, off: offs[i], code: "E2073", msg: "module {modDisplayFor(p, modID: curMod)} declares no '{targetName}'")
	return 0 as Count
end 'qualifiedLookup'

function finishQualified(mutates r Resolver, p ast.Project, consumes ref ast.DeclRef, off diag.U32, used Count, mutates errs diag.ErrorList) returns Count
	if not isDeclVisible(r, p: p, ref: ref) 'hid'
		pushErr(errs, modID: r.modID, off: off, code: diag.errNotExported, msg: hiddenMessage(r, p: p, ref: ref))
		return 0 as Count
	end 'hid'
	if ref.module != r.modID and ref.module != diag.stdlibID 'dep'
		r.res.addDep(ref.module, offset: off)
	end 'dep'
	return used
end 'finishQualified'

function qualifiedDeclRef(p ast.Project, head String, rest ast.StringList) returns table.Option with ast.DeclRef
	var curMod = p.rootModule
	if head == ast.rootQualifier 'exp'
		curMod = p.rootModule
	end 'exp' else if head == ast.stdlibQualifier 'std'
		curMod = diag.stdlibID
	end 'std' else 'child'
		match p.modules[ast.modIndex(p.rootModule)].findChild(head) 'ch'
			some(cid) then curMod = cid
			none then return table.Option.none
		end 'ch'
	end 'child'
	var i = 0 as Count
	while i < rest.count() 'walk'
		let segName = rest[i].clone()
		if curMod == diag.stdlibID 'inStd'
			break 'walk'
		end 'inStd'
		let cIdx = ast.modIndex(curMod)
		if p.modules[cIdx].names.has(segName) 'hitDecl'
			break 'walk'
		end 'hitDecl'
		match p.modules[cIdx].findChild(segName) 'sub'
			some(nextMod) then curMod = nextMod
			none then break 'walk'
		end 'sub'
		i = try i + 1 otherwise i
	end 'walk'
	if i == rest.count() 'isMod'
		return table.Option.none
	end 'isMod'
	let targetName = rest[i].clone()
	var optOrd as table.Option with ast.DeclOrdinal
	optOrd = table.Option.none
	if curMod == diag.stdlibID 'stdGet'
		optOrd = p.stdlib.names.get(targetName)
	end 'stdGet' else 'modGet'
		optOrd = p.modules[ast.modIndex(curMod)].names.get(targetName)
	end 'modGet'
	match optOrd 'hit'
		some(ord) then return table.Option.some(ast.DeclRef.make(curMod, ordinal: ord))
		none then return table.Option.none
	end 'hit'
end 'qualifiedDeclRef'

function cloneTypeParamMap(m TypeParamMap) returns TypeParamMap
	return m.clone()
end 'cloneTypeParamMap'

function enterTypeParams(mutates r Resolver, p ast.Project, owner String, s Surface, params ast.TypeParamList, constraints ast.ConstraintList, mutates errs diag.ErrorList) returns TypeParamMap
	let outer = cloneTypeParamMap(r.typeParams)
	for i in 0 upto params.count() 'add'
		var tp = ast.TypeParam.make(params[i].id)
		tp.name = params[i].name.clone()
		let tpName = tp.name.clone()
		let slot = r.res.addTypeParam(tp)
		r.typeParams.insert(tpName, value: slot)
	end 'add'
	enterConstraints(r, p: p, owner: owner, s: s, constraints: constraints, ofExtension: false, errs: errs)
	return outer
end 'enterTypeParams'

// enterConstraints binds each constraint of a 'where' to the type parameter in scope that it names, and resolves its
// bounds. An extension declares no parameters of its own, so one that names another is the refusal maxon gives.
function enterConstraints(mutates r Resolver, p ast.Project, owner String, s Surface, constraints ast.ConstraintList, ofExtension bool, mutates errs diag.ErrorList)
	for i in 0 upto constraints.count() 'cons'
		let c = constraints[i].clone()
		match r.typeParams.get(c.param) 'hit'
			some(slot) then bindConstraintSlot(r, p: p, owner: owner, constraints: constraints, curIdx: i, c: c, slot: slot, errs: errs)
			none then reportUnknownTP(r, c: c, owner: owner, ofExtension: ofExtension, errs: errs)
		end 'hit'
		let bCount = r.tree.listLen(c.bounds)
		for bi in 0 upto bCount 'bnd'
			let bNode = r.tree.listAt(c.bounds, index: bi) as ast.NodeID
			signatureType(r, p: p, s: s, position: "in its where clause", tr: bNode, errs: errs)
		end 'bnd'
	end 'cons'
end 'enterConstraints'

function bindConstraintSlot(mutates r Resolver, p ast.Project, owner String, constraints ast.ConstraintList, curIdx Count, c ast.Constraint, slot Count, mutates errs diag.ErrorList)
	var firstDup = false
	for j in 0 upto curIdx 'prev'
		if constraints[j].param == c.param 'dup'
			firstDup = true
			break 'prev'
		end 'dup'
	end 'prev'
	if firstDup 'errDup'
		let off = r.tree.startOf(c.id)
		pushErr(errs, modID: r.modID, off: off, code: diag.errDuplicateDefinition, msg: "'{c.param}' is constrained twice: join its bounds with 'and', as 'where {c.param} implements A and B'")
		return
	end 'errDup'
	r.res.bindTypeParam(c.id, slot: slot)
end 'bindConstraintSlot'

function reportUnknownTP(mutates r Resolver, c ast.Constraint, owner String, ofExtension bool, mutates errs diag.ErrorList)
	let off = r.tree.startOf(c.id)
	if ofExtension 'extension'
		pushErr(errs, modID: r.modID, off: off, code: diag.errUnsupportedFeature, msg: "Unsupported: a `where` clause constrains '{c.param}', which is not a type parameter of this type — a constraint must name one of its `uses` parameters")
		return
	end 'extension'
	pushErr(errs, modID: r.modID, off: off, code: diag.errUnknownTypeParam, msg: "'{c.param}' is not a type parameter of '{owner}': declare it with 'uses {c.param}', or constrain one that '{owner}' declares")
end 'reportUnknownTP'

function resolveTypeRef(mutates r Resolver, p ast.Project, tr ast.NodeID, mutates errs diag.ErrorList)
	if tr == 0 'nil'
		return
	end 'nil'
	if ast.typeRefIsTuple(r.tree, id: tr) 'tuple'
		let elemsRef = ast.typeRefElemsRef(r.tree, id: tr)
		for i in 0 upto r.tree.listLen(elemsRef) 'elems'
			resolveTypeRef(r, p: p, tr: r.tree.listAt(elemsRef, index: i) as ast.NodeID, errs: errs)
		end 'elems'
		return
	end 'tuple'
	let argsRef = ast.typeRefTypeArgsRef(r.tree, id: tr)
	let argCount = r.tree.listLen(argsRef)
	for i in 0 upto argCount 'args'
		let aNode = r.tree.listAt(argsRef, index: i) as ast.NodeID
		resolveTypeRef(r, p: p, tr: aNode, errs: errs)
	end 'args'
	let qualRef = ast.typeRefQualifierRef(r.tree, id: tr)
	let qualCount = r.tree.listLen(qualRef)
	let tName = ast.typeRefName(r.tree, id: tr)
	let off = r.tree.startOf(tr)
	if qualCount == 0 'unqual'
		match r.typeParams.get(tName) 'tp'
			some(slot) then r.res.bindTypeParam(tr, slot: slot)
			none then resolveUnqualDeclType(r, p: p, tr: tr, tName: tName, off: off, errs: errs)
		end 'tp'
		return
	end 'unqual'
	let firstQual = r.tree.nameAt(r.tree.listAt(qualRef, index: 0 as Count))
	if not isModuleRoot(p, name: firstQual) 'noMod'
		resolveOwnTypeMember(r, p: p, tr: tr, owner: firstQual, member: tName, qualCount: qualCount, off: off, errs: errs)
		return
	end 'noMod'
	var path = ast.StringList.create(0)
	var offs = ast.U32List.create(0)
	for i in 1 upto qualCount 'qp'
		path.push(r.tree.nameAt(r.tree.listAt(qualRef, index: i)))
		offs.push(off)
	end 'qp'
	path.push(tName.clone())
	offs.push(off)
	let used = qualifiedLookup(r, p: p, head: firstQual, headOff: off, rest: path, offs: offs, errs: errs)
	if used == 0 'failed'
		return
	end 'failed'
	match consumes qualifiedDeclRef(p, head: firstQual, rest: path) 'hit'
		some(decl) then checkAndBindTypeDecl(r, p: p, tr: tr, decl: decl, used: used, pathLen: path.count(), qualRef: qualRef, tName: tName, off: off, errs: errs)
		none then _ = 0
	end 'hit'
end 'resolveTypeRef'

// resolveOwnTypeMember notes a type written Owner.member, where Owner is a declaration of the module or of the standard
// library and not a module: the member is a typealias that Owner's declaration, or an extension of it, declares.
function resolveOwnTypeMember(mutates r Resolver, p ast.Project, tr ast.NodeID, owner String, member String, qualCount Count, off diag.U32, mutates errs diag.ErrorList)
	let lr = bareLookup(r, p: p, name: owner)
	if qualCount != 1 or not lr.found or not isRefType(p, ref: lr.decl) 'noOwner'
		pushErr(errs, modID: r.modID, off: off, code: diag.errUnknownType, msg: "no module '{owner}'")
		return
	end 'noOwner'
	r.res.memberRefs.push(ast.MemberRef.make(tr, owner: lr.decl.clone(), member: member.clone()))
end 'resolveOwnTypeMember'

function resolveUnqualDeclType(mutates r Resolver, p ast.Project, tr ast.NodeID, tName String, off diag.U32, mutates errs diag.ErrorList)
	if isPrimTypeName(tName) 'prim'
		return
	end 'prim'
	let lr = bareLookupAt(r, p: p, name: tName, off: off)
	match consumes takeLookup(r, p: p, lr: lr, off: off, errs: errs) 'hit'
		some(ref) then checkTypeKindAndBind(r, p: p, tr: tr, ref: ref, tName: tName, off: off, errs: errs)
		none then _ = 0
	end 'hit'
end 'resolveUnqualDeclType'

function checkTypeKindAndBind(mutates r Resolver, p ast.Project, tr ast.NodeID, consumes ref ast.DeclRef, tName String, off diag.U32, mutates errs diag.ErrorList)
	if not isRefType(p, ref: ref) 'notTy'
		pushErr(errs, modID: r.modID, off: off, code: diag.errUnknownType, msg: "'{tName}' is not a type")
		return
	end 'notTy'
	r.res.bindDecl(tr, d: ref)
end 'checkTypeKindAndBind'

function isRefType(p ast.Project, ref ast.DeclRef) returns bool
	if ref.module == diag.stdlibID 'std'
		return p.stdlib.decls[ref.ordinal as Count].isType()
	end 'std'
	return p.modules[ast.modIndex(ref.module)].decls[ref.ordinal as Count].isType()
end 'isRefType'

function checkAndBindTypeDecl(mutates r Resolver, p ast.Project, tr ast.NodeID, consumes decl ast.DeclRef, used Count, pathLen Count, qualRef diag.U32, tName String, off diag.U32, mutates errs diag.ErrorList)
	if (try used + 1 otherwise used) == pathLen and isRefType(p, ref: decl) 'member'
		r.res.memberRefs.push(ast.MemberRef.make(tr, owner: decl, member: tName.clone()))
		return
	end 'member'
	if used != pathLen or not isRefType(p, ref: decl) 'notTy'
		var qBuf = ByteArray.create(0)
		let qLen = r.tree.listLen(qualRef)
		for i in 0 upto qLen 'each'
			if i > 0 'd'
				qBuf.push(46 as Byte)
			end 'd'
			qBuf.append(r.tree.nameAt(r.tree.listAt(qualRef, index: i)).toByteArray())
		end 'each'
		pushErr(errs, modID: r.modID, off: off, code: diag.errUnknownType, msg: "'{String.from(qBuf)}.{tName}' is not a type")
		return
	end 'notTy'
	r.res.bindDecl(tr, d: decl)
end 'checkAndBindTypeDecl'

function pushScope(mutates r Resolver)
	r.scopes.push(BoolStrMap.new())
end 'pushScope'

function pushScopeWith(mutates r Resolver, name String)
	var m = BoolStrMap.new()
	m.insert(name.clone(), value: true)
	r.scopes.push(m)
end 'pushScopeWith'

function pushScopeList(mutates r Resolver, names ast.StringList)
	var m = BoolStrMap.new()
	for i in 0 upto names.count() 'each'
		m.insert(names[i].clone(), value: true)
	end 'each'
	r.scopes.push(m)
end 'pushScopeList'

function popScope(mutates r Resolver)
	try r.scopes.pop() otherwise ignore
end 'popScope'

function bindLocalName(mutates r Resolver, name String)
	let top = try r.scopes.count() - 1 otherwise 0 as Count
	r.scopes[top].insert(name.clone(), value: true)
end 'bindLocalName'

function isNameBound(r Resolver, name String) returns bool
	for i in 0 upto r.scopes.count() 'sc'
		if r.scopes[i].has(name) 'hit'
			return true
		end 'hit'
	end 'sc'
	return r.fields.has(name)
end 'isNameBound'

function resolvesDeclMember(p ast.Project, ms ast.ModuleState, ref ast.DeclRef, memberName String) returns bool
	let d = ast.moduleDecl(p, ref: ref)
	match d 'k'
		typeDecl(td) then return typeHasStatic(p, ms: ms, ref: ref, td: td, memberName: memberName)
		enumDecl(ed) then return enumHasCase(p, ms: ms, ref: ref, ed: ed, memberName: memberName)
		unionDecl(ud) then return unionHasCase(p, ms: ms, ref: ref, ud: ud, memberName: memberName)
		interfaceDecl(_) then return false
		funcDecl(_) then return false
		constDecl(_) then return false
		aliasDecl(_) then return false
		extensionDecl(_) then return false
	end 'k'
end 'resolvesDeclMember'

// typeHasStatic, enumHasCase and unionHasCase decide from what the module that declares the type writes, since its declare
// stage, which fills the type's entry, may not have run yet: a static function or a case of that name. Only the standard
// library's entries are complete before every resolve, and they hold built-in members that its declarations do not write.
function typeHasStatic(p ast.Project, ms ast.ModuleState, ref ast.DeclRef, td ast.TypeDecl, memberName String) returns bool
	for i in 0 upto td.methods.count() 'each'
		if td.methods[i].isStatic and td.methods[i].name == memberName 'hit'
			return true
		end 'hit'
	end 'each'
	match stdlibEntry(p, ms: ms, ref: ref) 'dt'
		some(tid) then return ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].findMethod(memberName).isSome()
		none then return false
	end 'dt'
end 'typeHasStatic'

function enumHasCase(p ast.Project, ms ast.ModuleState, ref ast.DeclRef, ed ast.EnumDecl, memberName String) returns bool
	for i in 0 upto ed.cases.count() 'each'
		if ed.cases[i].name == memberName 'hit'
			return true
		end 'hit'
	end 'each'
	return stdlibHasCase(p, ms: ms, ref: ref, memberName: memberName)
end 'enumHasCase'

function unionHasCase(p ast.Project, ms ast.ModuleState, ref ast.DeclRef, ud ast.UnionDecl, memberName String) returns bool
	for i in 0 upto ud.cases.count() 'each'
		if ud.cases[i].name == memberName 'hit'
			return true
		end 'hit'
	end 'each'
	return stdlibHasCase(p, ms: ms, ref: ref, memberName: memberName)
end 'unionHasCase'

function stdlibHasCase(p ast.Project, ms ast.ModuleState, ref ast.DeclRef, memberName String) returns bool
	match stdlibEntry(p, ms: ms, ref: ref) 'dt'
		some(tid) then return ms.types.lists[ast.typeList(ms.types, t: tid)][ast.typeIndex(ms.types, t: tid)].findCase(memberName).isSome()
		none then return false
	end 'dt'
end 'stdlibHasCase'

// stdlibEntry is the type of ref where the standard library declares it, whose entry is complete before any resolve.
function stdlibEntry(p ast.Project, ms ast.ModuleState, ref ast.DeclRef) returns table.Option with ast.TypeID
	if ref.module != diag.stdlibID 'user'
		return table.Option.none
	end 'user'
	return ast.declType(p, ms: ms, ref: ref)
end 'stdlibEntry'

function resolveBlock(mutates r Resolver, p ast.Project, ms ast.ModuleState, listRef diag.U32, mutates errs diag.ErrorList)
	pushScope(r)
	let n = r.tree.listLen(listRef)
	for i in 0 upto n 'each'
		let s = r.tree.listAt(listRef, index: i) as ast.NodeID
		resolveStmt(r, p: p, ms: ms, id: s, errs: errs)
	end 'each'
	popScope(r)
end 'resolveBlock'

function resolveStmt(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	if id == 0 'nil'
		return
	end 'nil'
	let k = r.tree.kindOf(id)
	if k == ast.NodeKind.letStmt 'sLet'
		let initNode = ast.letStmtInit(r.tree, id: id)
		if initNode != 0 'hi'
			resolveExpr(r, p: p, ms: ms, id: initNode, errs: errs)
		end 'hi' else 'tp'
			resolveTypeRef(r, p: p, tr: ast.letStmtType(r.tree, id: id), errs: errs)
		end 'tp'
		bindLocalName(r, name: ast.letStmtName(r.tree, id: id))
	end 'sLet' else if k == ast.NodeKind.destructStmt 'sDes'
		resolveExpr(r, p: p, ms: ms, id: ast.destructStmtInit(r.tree, id: id), errs: errs)
		let namesRef = ast.destructStmtNamesRef(r.tree, id: id)
		for i in 0 upto r.tree.listLen(namesRef) 'names'
			bindLocalName(r, name: ast.bindNameName(r.tree, id: r.tree.listAt(namesRef, index: i) as ast.NodeID))
		end 'names'
	end 'sDes' else if k == ast.NodeKind.tupleAssignStmt 'sTup'
		resolveExpr(r, p: p, ms: ms, id: ast.tupleAssignStmtValue(r.tree, id: id), errs: errs)
		let targetsRef = ast.tupleAssignStmtTargetsRef(r.tree, id: id)
		for i in 0 upto r.tree.listLen(targetsRef) 'targets'
			let target = r.tree.listAt(targetsRef, index: i) as ast.NodeID
			if ast.assignTargetIsLet(r.tree, id: target) or ast.assignTargetIsVar(r.tree, id: target) 'declares'
				bindLocalName(r, name: ast.assignTargetName(r.tree, id: target))
			end 'declares'
		end 'targets'
	end 'sTup' else if k == ast.NodeKind.assignStmt 'sAss'
		resolveExpr(r, p: p, ms: ms, id: ast.assignStmtTarget(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.assignStmtValue(r.tree, id: id), errs: errs)
	end 'sAss' else if k == ast.NodeKind.discardStmt 'sDisc'
		resolveExpr(r, p: p, ms: ms, id: ast.discardStmtValue(r.tree, id: id), errs: errs)
	end 'sDisc' else if k == ast.NodeKind.exprStmt 'sExpr'
		resolveExpr(r, p: p, ms: ms, id: ast.exprStmtE(r.tree, id: id), errs: errs)
	end 'sExpr' else if k == ast.NodeKind.ifStmt 'sIf'
		checkEnd(r, label: ast.ifStmtLabel(r.tree, id: id), endNode: ast.ifStmtEnd(r.tree, id: id), errs: errs)
		checkEnd(r, label: ast.ifStmtElseLabel(r.tree, id: id), endNode: ast.ifStmtElseEnd(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.ifStmtCond(r.tree, id: id), errs: errs)
		resolveBlock(r, p: p, ms: ms, listRef: ast.ifStmtThenRef(r.tree, id: id), errs: errs)
		if ast.ifStmtHasElse(r.tree, id: id) 'el'
			resolveBlock(r, p: p, ms: ms, listRef: ast.ifStmtElseRef(r.tree, id: id), errs: errs)
		end 'el'
	end 'sIf' else if k == ast.NodeKind.ifTryStmt 'sIfTry'
		resolveIfTryStmt(r, p: p, ms: ms, id: id, errs: errs)
	end 'sIfTry' else if k == ast.NodeKind.whileStmt 'sWh'
		checkEnd(r, label: ast.whileStmtLabel(r.tree, id: id), endNode: ast.whileStmtEnd(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.whileStmtCond(r.tree, id: id), errs: errs)
		resolveBlock(r, p: p, ms: ms, listRef: ast.whileStmtBodyRef(r.tree, id: id), errs: errs)
	end 'sWh' else if k == ast.NodeKind.forStmt 'sFor'
		checkEnd(r, label: ast.forStmtLabel(r.tree, id: id), endNode: ast.forStmtEnd(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.forStmtFrom(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.forStmtTo(r.tree, id: id), errs: errs)
		pushScopeList(r, names: forNames(r, id: id))
		resolveBlock(r, p: p, ms: ms, listRef: ast.forStmtBodyRef(r.tree, id: id), errs: errs)
		popScope(r)
	end 'sFor' else if k == ast.NodeKind.matchStmt 'sM'
		resolveMatchCore(r, p: p, ms: ms, mc: ast.matchStmtMatch(r.tree, id: id), errs: errs)
	end 'sM' else if k == ast.NodeKind.whenStmt 'sWhen'
		resolveWhenStmt(r, p: p, ms: ms, id: id, errs: errs)
	end 'sWhen' else if k == ast.NodeKind.tryStmt 'sTry'
		resolveTryStmt(r, p: p, ms: ms, id: id, errs: errs)
	end 'sTry' else if k == ast.NodeKind.throwStmt 'sThrow'
		resolveExpr(r, p: p, ms: ms, id: ast.throwStmtValue(r.tree, id: id), errs: errs)
	end 'sThrow' else if k == ast.NodeKind.returnStmt 'sRet'
		let rv = ast.returnStmtValue(r.tree, id: id)
		if rv != 0 'rv'
			resolveExpr(r, p: p, ms: ms, id: rv, errs: errs)
		end 'rv'
	end 'sRet' else if k == ast.NodeKind.breakStmt or k == ast.NodeKind.continueStmt 'sBrk'
		_ = 0
	end 'sBrk' else 'unk'
		panic("resolveStmt: unexpected node kind")
	end 'unk'
end 'resolveStmt'

// forNames are the names that a for declares: its variable, or the names of the tuple pattern.
function forNames(r Resolver, id ast.NodeID) returns ast.StringList
	var names = ast.StringList.create(0)
	let vars = ast.forStmtVarsRef(r.tree, id: id)
	if r.tree.listLen(vars) == 0 'single'
		names.push(ast.forStmtVar(r.tree, id: id))
		return names
	end 'single'
	for i in 0 upto r.tree.listLen(vars) 'each'
		names.push(ast.bindNameName(r.tree, id: r.tree.listAt(vars, index: i) as ast.NodeID))
	end 'each'
	return names
end 'forNames'

function resolveWhenStmt(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	checkEnd(r, label: ast.whenStmtLabel(r.tree, id: id), endNode: ast.whenStmtEnd(r.tree, id: id), errs: errs)
	let cRef = ast.whenStmtCownsRef(r.tree, id: id)
	let cLen = r.tree.listLen(cRef)
	for i in 0 upto cLen 'cw'
		let cNode = r.tree.listAt(cRef, index: i) as ast.NodeID
		resolveNameExpr(r, p: p, id: cNode, errs: errs)
	end 'cw'
	let nRef = ast.whenStmtNamesRef(r.tree, id: id)
	let nLen = r.tree.listLen(nRef)
	var bNames = ast.StringList.create(0)
	for i in 0 upto nLen 'nm'
		bNames.push(r.tree.nameAt(r.tree.listAt(nRef, index: i)))
	end 'nm'
	pushScopeList(r, names: bNames)
	let outer = r.inClosure
	r.inClosure = false
	r.whenDepth = try r.whenDepth + 1 otherwise r.whenDepth
	resolveBlock(r, p: p, ms: ms, listRef: ast.whenStmtBodyRef(r.tree, id: id), errs: errs)
	if r.whenDepth > 0 'dec'
		r.whenDepth = r.whenDepth - 1
	end 'dec'
	r.inClosure = outer
	popScope(r)
end 'resolveWhenStmt'

function resolveTryStmt(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	checkEnd(r, label: ast.tryStmtLabel(r.tree, id: id), endNode: ast.tryStmtEnd(r.tree, id: id), errs: errs)
	resolveBlock(r, p: p, ms: ms, listRef: ast.tryStmtBodyRef(r.tree, id: id), errs: errs)
	if ast.tryStmtHasOtherwise(r.tree, id: id) 'ho'
		checkEnd(r, label: ast.tryStmtHandlerLabel(r.tree, id: id), endNode: ast.tryStmtHandlerEnd(r.tree, id: id), errs: errs)
		let bnd = ast.tryStmtBinding(r.tree, id: id)
		var bs = ast.StringList.create(0)
		if bnd != "" 'hasB'
			bs.push(bnd)
		end 'hasB'
		pushScopeList(r, names: bs)
		resolveBlock(r, p: p, ms: ms, listRef: ast.tryStmtHandlerRef(r.tree, id: id), errs: errs)
		popScope(r)
	end 'ho'
end 'resolveTryStmt'

// resolveIfTryStmt resolves a conditional try: its binding is in scope in the block that runs on success, and the name of
// the error in the one that runs on failure.
function resolveIfTryStmt(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	checkEnd(r, label: ast.ifTryStmtLabel(r.tree, id: id), endNode: ast.ifTryStmtEnd(r.tree, id: id), errs: errs)
	checkEnd(r, label: ast.ifTryStmtElseLabel(r.tree, id: id), endNode: ast.ifTryStmtElseEnd(r.tree, id: id), errs: errs)
	resolveExpr(r, p: p, ms: ms, id: ast.ifTryStmtCall(r.tree, id: id), errs: errs)
	var bound = ast.StringList.create(0)
	if ast.ifTryStmtName(r.tree, id: id) != "" 'named'
		bound.push(ast.ifTryStmtName(r.tree, id: id))
	end 'named'
	pushScopeList(r, names: bound)
	resolveBlock(r, p: p, ms: ms, listRef: ast.ifTryStmtThenRef(r.tree, id: id), errs: errs)
	popScope(r)
	if ast.ifTryStmtHasElse(r.tree, id: id) 'else'
		var failed = ast.StringList.create(0)
		if ast.ifTryStmtErrName(r.tree, id: id) != "" 'named'
			failed.push(ast.ifTryStmtErrName(r.tree, id: id))
		end 'named'
		pushScopeList(r, names: failed)
		resolveBlock(r, p: p, ms: ms, listRef: ast.ifTryStmtElseRef(r.tree, id: id), errs: errs)
		popScope(r)
	end 'else'
end 'resolveIfTryStmt'

function resolveMatchCore(mutates r Resolver, p ast.Project, ms ast.ModuleState, mc ast.NodeID, mutates errs diag.ErrorList)
	checkEnd(r, label: ast.matchCoreLabel(r.tree, id: mc), endNode: ast.matchCoreEnd(r.tree, id: mc), errs: errs)
	resolveExpr(r, p: p, ms: ms, id: ast.matchCoreSubject(r.tree, id: mc), errs: errs)
	let armsRef = ast.matchCoreArmsRef(r.tree, id: mc)
	let armCount = r.tree.listLen(armsRef)
	for i in 0 upto armCount 'eachArm'
		let arm = r.tree.listAt(armsRef, index: i) as ast.NodeID
		let patsRef = ast.matchArmPatternsRef(r.tree, id: arm)
		let patCount = r.tree.listLen(patsRef)
		var bNames = ast.StringList.create(0)
		for pi in 0 upto patCount 'eachPat'
			let pat = r.tree.listAt(patsRef, index: pi) as ast.NodeID
			let bRef = ast.patternBindingsRef(r.tree, id: pat)
			let bCount = r.tree.listLen(bRef)
			for bi in 0 upto bCount 'eachB'
				bNames.push(r.tree.nameAt(r.tree.listAt(bRef, index: bi)))
			end 'eachB'
		end 'eachPat'
		pushScopeList(r, names: bNames)
		let act = ast.matchArmAction(r.tree, id: arm)
		if act != 0 'act'
			resolveStmt(r, p: p, ms: ms, id: act, errs: errs)
		end 'act'
		let val = ast.matchArmValue(r.tree, id: arm)
		if val != 0 'val'
			resolveExpr(r, p: p, ms: ms, id: val, errs: errs)
		end 'val'
		popScope(r)
	end 'eachArm'
end 'resolveMatchCore'

function resolveNameExpr(mutates r Resolver, p ast.Project, id ast.NodeID, mutates errs diag.ErrorList)
	let n = ast.nameExprName(r.tree, id: id)
	if n == "Self" 's'
		return
	end 's'
	if n == ast.rootQualifier 'root'
		pushErr(errs, modID: r.modID, off: r.tree.startOf(id), code: diag.errExpressionError, msg: "'export' is the root module, not a value: name one of its declarations, as in 'export.limit'")
		return
	end 'root'
	if not isNameBound(r, name: n) 'free'
		if r.typeParams.has(n) 'parameter'
			match r.typeParams.get(n) 'slot'
				some(slot) then r.res.bindTypeParam(id, slot: slot)
				none then panic("the type parameter '{n}' has no slot")
			end 'slot'
			return
		end 'parameter'
		let off = r.tree.startOf(id)
		let lr = bareLookupAt(r, p: p, name: n, off: off)
		match consumes takeLookup(r, p: p, lr: lr, off: off, errs: errs) 'hit'
			some(ref) then r.res.bindDecl(id, d: ref)
			none then _ = 0
		end 'hit'
	end 'free' else if r.whenDepth > 0 'cap'
		r.tree.appendCaptureRefs(id, depth: r.whenDepth)
	end 'cap'
end 'resolveNameExpr'

// staticConstRef is the constant that the static let named member of the type at ref is, in the module that declares the type.
function staticConstRef(p ast.Project, ref ast.DeclRef, member String) returns table.Option with ast.DeclRef
	match ast.moduleDecl(p, ref: ref) 'k'
		typeDecl(td) then return staticConstOf(p, ref: ref, td: td, member: member)
		enumDecl(_) then return table.Option.none
		unionDecl(_) then return table.Option.none
		interfaceDecl(_) then return table.Option.none
		funcDecl(_) then return table.Option.none
		constDecl(_) then return table.Option.none
		aliasDecl(_) then return table.Option.none
		extensionDecl(_) then return table.Option.none
	end 'k'
end 'staticConstRef'

function staticConstOf(p ast.Project, ref ast.DeclRef, td ast.TypeDecl, member String) returns table.Option with ast.DeclRef
	for i in 0 upto td.statics.count() 'each'
		if td.statics[i].name == member 'hit'
			let qualified = ast.nestedAliasName(td.name, name: member)
			var ord as table.Option with ast.DeclOrdinal
			if ref.module == diag.stdlibID 'std'
				ord = p.stdlib.names.get(qualified)
			end 'std' else 'own'
				ord = p.modules[ast.modIndex(ref.module)].names.get(qualified)
			end 'own'
			match consumes ord 'declared'
				some(o) then return table.Option.some(ast.DeclRef.make(ref.module, ordinal: o))
				none then panic("the static let '{member}' of '{td.name}' is not among the declarations of its module")
			end 'declared'
		end 'hit'
	end 'each'
	return table.Option.none
end 'staticConstOf'

function resolveMemberExpr(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	var revSegs = SegmentList.create(0)
	var cur = id
	while r.tree.kindOf(cur) == ast.NodeKind.memberExpr 'collect'
		revSegs.push(Segment.make(ast.memberExprName(r.tree, id: cur), node: cur))
		cur = ast.memberExprObj(r.tree, id: cur)
	end 'collect'
	var segs = SegmentList.create(0)
	let rc = revSegs.count()
	for i in 0 upto rc 'rev'
		let idx = try (rc - 1) - i otherwise 0 as Count
		segs.push(revSegs[idx].clone())
	end 'rev'
	if r.tree.kindOf(cur) != ast.NodeKind.nameExpr 'notName'
		resolveExpr(r, p: p, ms: ms, id: ast.memberExprObj(r.tree, id: id), errs: errs)
		return
	end 'notName'
	let headName = ast.nameExprName(r.tree, id: cur)
	if isNameBound(r, name: headName) or headName == "Self" or r.typeParams.has(headName) 'bound'
		resolveExpr(r, p: p, ms: ms, id: ast.memberExprObj(r.tree, id: id), errs: errs)
		return
	end 'bound'
	let bare = bareLookup(r, p: p, name: headName)
	if bare.found 'hasBare'
		let isConst = ast.declNodeID(p, ref: bare.decl) != 0 and ast.declIsConst(p, ref: bare.decl)
		let isTy = isRefType(p, ref: bare.decl)
		if isTy 'typeHead'
			var rewritten = false
			match consumes staticConstRef(p, ref: bare.decl, member: segs[0].name) 'static'
				some(target) then rewritten = rewriteStatic(r, targetNode: segs[0].node, headNode: cur, target: target)
				none then _ = 0
			end 'static'
			if rewritten 'done'
				return
			end 'done'
		end 'typeHead'
		let hasMem = isTy and resolvesDeclMember(p, ms: ms, ref: bare.decl, memberName: segs[0].name)
		if isConst or hasMem or (not isModuleRoot(p, name: headName)) 'keepBare'
			let headOff = r.tree.startOf(cur)
			match consumes takeLookup(r, p: p, lr: bare, off: headOff, errs: errs) 'tk'
				some(ref) then r.res.bindDecl(cur, d: ref)
				none then _ = 0
			end 'tk'
			return
		end 'keepBare'
	end 'hasBare'
	if not isModuleRoot(p, name: headName) 'notRoot'
		recordUnbound(r, name: headName, off: r.tree.startOf(cur))
		return
	end 'notRoot'
	var names = ast.StringList.create(0)
	var offs = ast.U32List.create(0)
	for i in 0 upto segs.count() 'cp'
		names.push(segs[i].name.clone())
		offs.push(r.tree.startOf(segs[i].node))
	end 'cp'
	let headOff = r.tree.startOf(cur)
	let used = qualifiedLookup(r, p: p, head: headName, headOff: headOff, rest: names, offs: offs, errs: errs)
	if used == 0 'fail'
		return
	end 'fail'
	match consumes qualifiedDeclRef(p, head: headName, rest: names) 'hit'
		some(target) then rewriteMemberToName(r, targetNode: segs[try used - 1 otherwise 0 as Count].node, headNode: cur, targetDecl: target)
		none then _ = 0
	end 'hit'
end 'resolveMemberExpr'

function rewriteStatic(mutates r Resolver, targetNode ast.NodeID, headNode ast.NodeID, consumes target ast.DeclRef) returns bool
	rewriteMemberToName(r, targetNode: targetNode, headNode: headNode, targetDecl: target)
	return true
end 'rewriteStatic'

function rewriteMemberToName(mutates r Resolver, targetNode ast.NodeID, headNode ast.NodeID, consumes targetDecl ast.DeclRef)
	r.tree.becomeName(targetNode, head: headNode)
	r.res.becomeNames.insert(targetNode as Count, value: true)
	r.res.bindDecl(targetNode, d: targetDecl)
end 'rewriteMemberToName'

// resolveChain resolves an operator and the operators nested in its left operand, innermost first, so that a long chain
// takes no stack.
function resolveChain(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	var chain = ast.leftChain(r.tree, e: id)
	var node = ast.nextOperator(chain, e: id)
	resolveExpr(r, p: p, ms: ms, id: ast.binaryExprL(r.tree, id: node), errs: errs)
	while node != id 'inner'
		resolveExpr(r, p: p, ms: ms, id: ast.binaryExprR(r.tree, id: node), errs: errs)
		node = ast.nextOperator(chain, e: id)
	end 'inner'
	resolveExpr(r, p: p, ms: ms, id: ast.binaryExprR(r.tree, id: id), errs: errs)
end 'resolveChain'

function resolveExpr(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	if id == 0 'nil'
		return
	end 'nil'
	let k = r.tree.kindOf(id)
	if k == ast.NodeKind.selfExpr and r.inClosure and isNameBound(r, name: ast.receiverName) 'capturedSelf'
		r.tree.becomeSelfName(id)
		resolveNameExpr(r, p: p, id: id, errs: errs)
	end 'capturedSelf' else if k == ast.NodeKind.intLit or k == ast.NodeKind.floatLit or k == ast.NodeKind.boolLit or k == ast.NodeKind.selfExpr or k == ast.NodeKind.byteStrLit 'leaf'
		return
	end 'leaf' else if k == ast.NodeKind.nameExpr 'nm'
		resolveNameExpr(r, p: p, id: id, errs: errs)
	end 'nm' else if k == ast.NodeKind.memberExpr 'mem'
		resolveMemberExpr(r, p: p, ms: ms, id: id, errs: errs)
	end 'mem' else if k == ast.NodeKind.indexExpr 'idx'
		resolveExpr(r, p: p, ms: ms, id: ast.indexExprObj(r.tree, id: id), errs: errs)
		let argsRef = ast.indexExprArgsRef(r.tree, id: id)
		for i in 0 upto r.tree.listLen(argsRef) 'each'
			resolveExpr(r, p: p, ms: ms, id: r.tree.listAt(argsRef, index: i) as ast.NodeID, errs: errs)
		end 'each'
	end 'idx' else if k == ast.NodeKind.strLit 'str'
		let partsRef = ast.strLitPartsRef(r.tree, id: id)
		let n = r.tree.strPartCount(partsRef)
		for i in 0 upto n 'each'
			if r.tree.strPartIsExpr(partsRef, index: i) 'expr'
				resolveExpr(r, p: p, ms: ms, id: r.tree.strPartExpr(partsRef, index: i), errs: errs)
			end 'expr'
		end 'each'
	end 'str' else if k == ast.NodeKind.binaryExpr 'bin'
		resolveChain(r, p: p, ms: ms, id: id, errs: errs)
	end 'bin' else if k == ast.NodeKind.unaryExpr 'un'
		resolveExpr(r, p: p, ms: ms, id: ast.unaryExprE(r.tree, id: id), errs: errs)
	end 'un' else if k == ast.NodeKind.condExpr 'cnd'
		resolveExpr(r, p: p, ms: ms, id: ast.condExprCond(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.condExprThen(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.condExprElse(r.tree, id: id), errs: errs)
	end 'cnd' else if k == ast.NodeKind.tryExpr 'tryE'
		resolveExpr(r, p: p, ms: ms, id: ast.tryExprE(r.tree, id: id), errs: errs)
		let val = ast.tryFallback(r.tree, e: id)
		if val != 0 'v'
			resolveExpr(r, p: p, ms: ms, id: val, errs: errs)
		end 'v'
		let handler = ast.tryExprHandler(r.tree, id: id)
		if handler != 0 'handler'
			resolveTryHandler(r, p: p, ms: ms, id: id, errs: errs)
		end 'handler'
		let ret = ast.tryExprRet(r.tree, id: id)
		if ret != 0 'rt'
			let rv = ast.returnStmtValue(r.tree, id: ret)
			if rv != 0 'rv'
				resolveExpr(r, p: p, ms: ms, id: rv, errs: errs)
			end 'rv'
		end 'rt'
		let thr = ast.tryExprThr(r.tree, id: id)
		if thr != 0 'th'
			resolveExpr(r, p: p, ms: ms, id: ast.throwStmtValue(r.tree, id: thr), errs: errs)
		end 'th'
	end 'tryE' else if k == ast.NodeKind.callExpr 'call'
		resolveCallExpr(r, p: p, ms: ms, id: id, errs: errs)
	end 'call' else if k == ast.NodeKind.structLitExpr 'slit'
		resolveStructLitExpr(r, p: p, ms: ms, id: id, errs: errs)
	end 'slit' else if k == ast.NodeKind.collectionLitExpr 'coll'
		resolveExprList(r, p: p, ms: ms, list: ast.collectionLitExprElemsRef(r.tree, id: id), errs: errs)
		resolveExprList(r, p: p, ms: ms, list: ast.collectionLitExprValuesRef(r.tree, id: id), errs: errs)
	end 'coll' else if k == ast.NodeKind.tupleExpr 'tup'
		resolveExprList(r, p: p, ms: ms, list: ast.tupleExprElemsRef(r.tree, id: id), errs: errs)
	end 'tup' else if k == ast.NodeKind.castExpr 'cast'
		resolveExpr(r, p: p, ms: ms, id: ast.castExprE(r.tree, id: id), errs: errs)
		resolveTypeRef(r, p: p, tr: ast.castExprTarget(r.tree, id: id), errs: errs)
	end 'cast' else if k == ast.NodeKind.fromExpr 'from'
		resolveExpr(r, p: p, ms: ms, id: ast.fromExprHead(r.tree, id: id), errs: errs)
		resolveExpr(r, p: p, ms: ms, id: ast.fromExprValue(r.tree, id: id), errs: errs)
	end 'from' else if k == ast.NodeKind.matchExpr 'me'
		resolveMatchCore(r, p: p, ms: ms, mc: ast.matchExprMatch(r.tree, id: id), errs: errs)
	end 'me' else if k == ast.NodeKind.panicExpr 'pe'
		resolveExpr(r, p: p, ms: ms, id: ast.panicExprMessage(r.tree, id: id), errs: errs)
	end 'pe' else if k == ast.NodeKind.closureExpr 'closure'
		resolveClosureExpr(r, p: p, ms: ms, id: id, errs: errs)
	end 'closure' else if k == ast.NodeKind.typeQueryExpr 'query'
		resolveTypeRef(r, p: p, tr: ast.typeQueryExprType(r.tree, id: id), errs: errs)
	end 'query' else 'unk'
		panic("resolveExpr: unexpected node kind")
	end 'unk'
end 'resolveExpr'

// resolveClosureExpr resolves a closure, whose body sees its parameters and captures the names around it as the body of a
// behaviour does.
function resolveClosureExpr(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	let paramsRef = ast.closureExprParamsRef(r.tree, id: id)
	var names = ast.StringList.create(0)
	for i in 0 upto r.tree.listLen(paramsRef) 'params'
		let param = r.tree.listAt(paramsRef, index: i) as ast.NodeID
		let tr = ast.closureParamType(r.tree, id: param)
		if tr != 0 'typed'
			resolveTypeRef(r, p: p, tr: tr, errs: errs)
		end 'typed'
		names.push(ast.closureParamName(r.tree, id: param))
	end 'params'
	let ret = ast.closureExprReturns(r.tree, id: id)
	if ret != 0 'returns'
		resolveTypeRef(r, p: p, tr: ret, errs: errs)
	end 'returns'
	pushScopeList(r, names: names)
	let outer = r.inClosure
	r.inClosure = true
	r.whenDepth = try r.whenDepth + 1 otherwise r.whenDepth
	resolveBlock(r, p: p, ms: ms, listRef: ast.closureExprBodyRef(r.tree, id: id), errs: errs)
	if r.whenDepth > 0 'dec'
		r.whenDepth = r.whenDepth - 1
	end 'dec'
	r.inClosure = outer
	popScope(r)
end 'resolveClosureExpr'

function resolveExprList(mutates r Resolver, p ast.Project, ms ast.ModuleState, list diag.U32, mutates errs diag.ErrorList)
	for i in 0 upto r.tree.listLen(list) 'each'
		resolveExpr(r, p: p, ms: ms, id: r.tree.listAt(list, index: i) as ast.NodeID, errs: errs)
	end 'each'
end 'resolveExprList'

// resolveTryHandler resolves a try expression's block handler, which sees the error it binds. The binding is the name in
// parentheses before the label, which the parser takes for an expression.
function resolveTryHandler(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	let handler = ast.tryExprHandler(r.tree, id: id)
	checkEnd(r, label: ast.handlerBlockLabel(r.tree, id: handler), endNode: ast.handlerBlockEnd(r.tree, id: handler), errs: errs)
	var bs = ast.StringList.create(0)
	let bound = ast.tryExprValue(r.tree, id: id)
	if bound != 0 'binds'
		bs.push(ast.nameExprName(r.tree, id: bound))
	end 'binds'
	pushScopeList(r, names: bs)
	resolveBlock(r, p: p, ms: ms, listRef: ast.handlerBlockBodyRef(r.tree, id: handler), errs: errs)
	popScope(r)
end 'resolveTryHandler'

function resolveCallExpr(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	let callee = ast.callExprCallee(r.tree, id: id)
	resolveExpr(r, p: p, ms: ms, id: callee, errs: errs)
	var constructsCown = false
	if r.tree.kindOf(callee) == ast.NodeKind.nameExpr 'nm'
		match r.res.decls.get(callee as Count) 'd'
			some(ref) then constructsCown = (ref.module == diag.stdlibID and ast.declName(p, ref: ref) == "cown")
			none then _ = 0
		end 'd'
	end 'nm'
	let argsRef = ast.callExprArgsRef(r.tree, id: id)
	let n = r.tree.listLen(argsRef)
	for i in 0 upto n 'each'
		let aNode = r.tree.listAt(argsRef, index: i) as ast.NodeID
		if constructsCown and ast.argLabel(r.tree, id: aNode) == ast.dropWithLabel 'skipDW'
			continue 'each'
		end 'skipDW'
		resolveExpr(r, p: p, ms: ms, id: ast.argValue(r.tree, id: aNode), errs: errs)
	end 'each'
end 'resolveCallExpr'

function resolveStructLitExpr(mutates r Resolver, p ast.Project, ms ast.ModuleState, id ast.NodeID, mutates errs diag.ErrorList)
	let tName = ast.structLitExprTypeName(r.tree, id: id)
	if tName != "Self" 'named'
		let off = r.tree.startOf(id)
		let lr = bareLookupAt(r, p: p, name: tName, off: off)
		match consumes takeLookup(r, p: p, lr: lr, off: off, errs: errs) 'hit'
			some(ref) then r.res.bindDecl(id, d: ref)
			none then _ = 0
		end 'hit'
	end 'named'
	let fieldsRef = ast.structLitExprFieldsRef(r.tree, id: id)
	let n = r.tree.listLen(fieldsRef)
	for i in 0 upto n 'each'
		let fi = r.tree.listAt(fieldsRef, index: i) as ast.NodeID
		resolveExpr(r, p: p, ms: ms, id: ast.structFieldValue(r.tree, id: fi), errs: errs)
	end 'each'
end 'resolveStructLitExpr'

// Surface is a declaration that other modules read the signature of, as far as its visibility reaches: whoever may
// name it must be able to name every type its signature names, so each must be at least as visible (E3167). at is
// where a violation is reported.
type Surface
	export var tier as ast.Visibility
	export var noun as String
	export var name as String
	export var at as diag.U32

	static function make(tier ast.Visibility, consumes noun String, consumes name String, at diag.U32) returns Surface
		return Surface{tier: tier, noun: noun, name: name, at: at}
	end 'make'
end 'Surface'

function declSurface(r Resolver, d ast.Decl, consumes noun String) returns Surface
	return Surface.make(d.level(), noun: noun, name: d.name(), at: r.tree.reportStartOf(d.nodeID()))
end 'declSurface'

// methodSurface is a method's: its own visibility decides, not its type's.
function methodSurface(r Resolver, owner String, m ast.FuncDecl) returns Surface
	return Surface.make(ast.visibilityOf(m.visibility), noun: "function", name: "{owner}.{m.name}", at: r.tree.reportStartOf(m.id))
end 'methodSurface'

function narrower(a ast.Visibility, b ast.Visibility) returns ast.Visibility
	if a.ordinal < b.ordinal 'a'
		return a
	end 'a'
	return b
end 'narrower'

// signatureType resolves a type that the surface's signature writes at position, and refuses a declaration that it or
// its arguments name and that is less visible than the surface.
function signatureType(mutates r Resolver, p ast.Project, s Surface, position String, tr ast.NodeID, mutates errs diag.ErrorList)
	resolveTypeRef(r, p: p, tr: tr, errs: errs)
	if tr != 0 and s.tier != ast.Visibility.unexported 'exposed'
		requireExposable(r, p: p, s: s, position: position, tr: tr, errs: errs)
	end 'exposed'
end 'signatureType'

function requireExposable(mutates r Resolver, p ast.Project, s Surface, position String, tr ast.NodeID, mutates errs diag.ErrorList)
	let elemsRef = ast.typeRefElemsRef(r.tree, id: tr)
	for i in 0 upto r.tree.listLen(elemsRef) 'elems'
		requireExposable(r, p: p, s: s, position: position, tr: r.tree.listAt(elemsRef, index: i) as ast.NodeID, errs: errs)
	end 'elems'
	match r.res.decls.get(tr as Count) 'bound'
		some(ref) then reportIfHiddenUnlessExpanded(r, p: p, s: s, position: position, ref: ref, errs: errs)
		none then _ = 0
	end 'bound'
	let argsRef = ast.typeRefTypeArgsRef(r.tree, id: tr)
	for i in 0 upto r.tree.listLen(argsRef) 'args'
		requireExposable(r, p: p, s: s, position: position, tr: r.tree.listAt(argsRef, index: i) as ast.NodeID, errs: errs)
	end 'args'
end 'requireExposable'

function reportIfHiddenUnlessExpanded(r Resolver, p ast.Project, s Surface, position String, ref ast.DeclRef, mutates errs diag.ErrorList)
	if r.expandsMembers and ref.module == r.modID and ast.isNestedAlias(ast.declName(p, ref: ref)) 'expanded'
		return
	end 'expanded'
	reportIfHidden(p, s: s, position: position, ref: ref, modID: r.modID, errs: errs)
end 'reportIfHiddenUnlessExpanded'

function reportIfHidden(p ast.Project, s Surface, position String, ref ast.DeclRef, modID diag.ModuleID, mutates errs diag.ErrorList)
	let level = ast.declLevel(p, ref: ref)
	if level.ordinal >= s.tier.ordinal 'wide'
		return
	end 'wide'
	let d = ast.moduleDecl(p, ref: ref)
	let tName = d.name()
	pushErr(errs, modID: modID, off: s.at, code: diag.errExposesHiddenType, msg: diag.exposesLessVisibleType(ast.visibilityWord(s.tier), noun: s.noun, name: ast.inModule(p, modID: modID, name: s.name), typeTier: ast.visibilityWord(level), typeNoun: typeNoun(d), typeName: tName, position: position))
end 'reportIfHidden'

// typeNoun names the kind of a type declaration in a message.
function typeNoun(d ast.Decl) returns String
	return match d 'k'
		typeDecl(_) gives "type"
		enumDecl(_) gives "enum"
		unionDecl(_) gives "union"
		aliasDecl(_) gives "typealias"
		interfaceDecl(_) gives "interface"
		extensionDecl(_) gives panic("a type reference names an extension")
		funcDecl(_) gives panic("a type reference names a function")
		constDecl(_) gives panic("a type reference names a constant")
	end 'k'
end 'typeNoun'

// signature resolves the types of a function's signature, each held to the surface.
function signature(mutates r Resolver, p ast.Project, s Surface, params ast.ParamList, returnsRef ast.NodeID, throwsRef ast.NodeID, mutates errs diag.ErrorList)
	for i in 0 upto params.count() 'pars'
		signatureType(r, p: p, s: s, position: "in the type of parameter '{params[i].name}'", tr: params[i].typeRef, errs: errs)
	end 'pars'
	signatureType(r, p: p, s: s, position: "in its return type", tr: returnsRef, errs: errs)
	signatureType(r, p: p, s: s, position: "in its throws clause", tr: throwsRef, errs: errs)
end 'signature'

function resolveConforms(mutates r Resolver, p ast.Project, s Surface, conforms diag.U32, mutates errs diag.ErrorList)
	resolveInterfaceList(r, p: p, s: s, interfaces: conforms, position: "in its implements clause", errs: errs)
end 'resolveConforms'

// resolveParamDefaults resolves the default of each parameter in the scope of the declaration alone: it sees no parameter, no field and no
// 'self'.
function resolveParamDefaults(mutates r Resolver, p ast.Project, ms ast.ModuleState, params ast.ParamList, mutates errs diag.ErrorList)
	for i in 0 upto params.count() 'each'
		let dExpr = params[i].defaultRef
		if dExpr != 0 'default'
			r.scopes = ScopeStack.create(0)
			pushScope(r)
			r.fields = BoolStrMap.new()
			resolveExpr(r, p: p, ms: ms, id: dExpr, errs: errs)
			popScope(r)
		end 'default'
	end 'each'
end 'resolveParamDefaults'

// refuseParamDefaults reports a default on a parameter of a union case or an interface requirement, where no call could
// use it: a payload is given in full, and a requirement is called through a witness that has no signature to read it from.
function refuseParamDefaults(mutates r Resolver, params ast.ParamList, noun String, mutates errs diag.ErrorList)
	for i in 0 upto params.count() 'each'
		if params[i].defaultRef != 0 'default'
			pushErr(errs, modID: r.modID, off: r.tree.startOf(params[i].defaultRef), code: diag.errUnsupportedFeature, msg: "Unsupported: a default value on {noun} parameter '{params[i].name}': give the argument at each call")
		end 'default'
	end 'each'
end 'refuseParamDefaults'

// resolveInterfaceList resolves the interfaces of an 'implements' or an 'extends' clause.
function resolveInterfaceList(mutates r Resolver, p ast.Project, s Surface, interfaces diag.U32, position String, mutates errs diag.ErrorList)
	for i in 0 upto r.tree.listLen(interfaces) 'each'
		signatureType(r, p: p, s: s, position: position, tr: r.tree.listAt(interfaces, index: i) as ast.NodeID, errs: errs)
	end 'each'
end 'resolveInterfaceList'

// resolveFuncDecl resolves a function, or a method, which has a receiver when hasReceiver is set: a closure in its body
// captures 'self' by that name.
function resolveFuncDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, f ast.FuncDecl, s Surface, fieldNames BoolStrMap, hasReceiver bool, mutates errs diag.ErrorList)
	let outer = enterTypeParams(r, p: p, owner: f.name, s: s, params: f.typeParams, constraints: f.whereList, errs: errs)
	checkEnd(r, label: ast.sourceName(f), endNode: f.endRef, errs: errs)
	signature(r, p: p, s: s, params: f.params, returnsRef: f.returnsRef, throwsRef: f.throwsRef, errs: errs)
	resolveParamDefaults(r, p: p, ms: ms, params: f.params, errs: errs)
	r.scopes = ScopeStack.create(0)
	pushScope(r)
	r.fields = cloneBoolStrMap(fieldNames)
	for i in 0 upto f.params.count() 'pNames'
		bindLocalName(r, name: f.params[i].name)
	end 'pNames'
	if hasReceiver 'receiver'
		bindLocalName(r, name: ast.receiverName)
	end 'receiver'
	resolveBlock(r, p: p, ms: ms, listRef: f.body, errs: errs)
	popScope(r)
	r.typeParams = outer
end 'resolveFuncDecl'

function cloneBoolStrMap(m BoolStrMap) returns BoolStrMap
	return m.clone()
end 'cloneBoolStrMap'

function resolveTopDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, d ast.Decl, mutates errs diag.ErrorList)
	let emptyFields = BoolStrMap.new()
	match d 'k'
		funcDecl(fd) then resolveFuncDecl(r, p: p, ms: ms, f: fd, s: declSurface(r, d: d, noun: "function"), fieldNames: emptyFields, hasReceiver: false, errs: errs)
		constDecl(cd) then resolveTopConst(r, p: p, ms: ms, cd: cd, errs: errs)
		typeDecl(td) then resolveTypeDecl(r, p: p, ms: ms, td: td, s: declSurface(r, d: d, noun: "type"), errs: errs)
		enumDecl(ed) then resolveEnumDecl(r, p: p, ms: ms, ed: ed, s: declSurface(r, d: d, noun: "enum"), errs: errs)
		unionDecl(ud) then resolveUnionDecl(r, p: p, ms: ms, ud: ud, s: declSurface(r, d: d, noun: "union"), errs: errs)
		aliasDecl(ad) then resolveTopAlias(r, p: p, ad: ad, s: declSurface(r, d: d, noun: "typealias"), errs: errs)
		interfaceDecl(ifd) then resolveInterfaceDecl(r, p: p, ms: ms, ifd: ifd, errs: errs)
		extensionDecl(xd) then resolveExtensionDecl(r, p: p, ms: ms, xd: xd, s: declSurface(r, d: d, noun: "extension"), errs: errs)
	end 'k'
end 'resolveTopDecl'

// resolveTopAlias resolves a typealias of the module, except one a type's body declares, which its type resolves with the
// type's parameters in scope.
function resolveTopAlias(mutates r Resolver, p ast.Project, ad ast.AliasDecl, s Surface, mutates errs diag.ErrorList)
	if not ast.isNestedAlias(ad.name) 'topLevel'
		resolveAliasDecl(r, p: p, ad: ad, s: s, errs: errs)
	end 'topLevel'
end 'resolveTopAlias'

// resolveTopConst resolves a constant of the module, except a static let that a type's body declares, which its type resolves
// with the type's other members in scope.
function resolveTopConst(mutates r Resolver, p ast.Project, ms ast.ModuleState, cd ast.ConstDecl, mutates errs diag.ErrorList)
	if not ast.isNestedAlias(cd.name) 'topLevel'
		resolveConstDecl(r, p: p, ms: ms, cd: cd, errs: errs)
	end 'topLevel'
end 'resolveTopConst'

function resolveConstDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, cd ast.ConstDecl, mutates errs diag.ErrorList)
	resolveStandaloneExpr(r, p: p, ms: ms, e: cd.value, errs: errs)
end 'resolveConstDecl'

// resolveStandaloneExpr resolves an expression that no function holds, a constant's value, a field's default or a raw value, which
// names no local and no field.
function resolveStandaloneExpr(mutates r Resolver, p ast.Project, ms ast.ModuleState, e ast.NodeID, mutates errs diag.ErrorList)
	r.scopes = ScopeStack.create(0)
	pushScope(r)
	r.fields = BoolStrMap.new()
	resolveExpr(r, p: p, ms: ms, id: e, errs: errs)
	popScope(r)
end 'resolveStandaloneExpr'

function resolveTypeDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, td ast.TypeDecl, s Surface, mutates errs diag.ErrorList)
	checkEnd(r, label: td.name, endNode: td.endRef, errs: errs)
	let outer = enterTypeParams(r, p: p, owner: td.name, s: s, params: td.typeParams, constraints: td.whereList, errs: errs)
	resolveNestedAliases(r, p: p, ms: ms, owner: td.name, aliases: td.aliases, statics: td.statics, s: s, errs: errs)
	resolveConforms(r, p: p, s: s, conforms: td.conforms, errs: errs)
	var fNames = BoolStrMap.new()
	for i in 0 upto td.fields.count() 'flds'
		fNames.insert(td.fields[i].name.clone(), value: true)
		let tRef = td.fields[i].typeRef
		if tRef != 0 'ht'
			let fTier = narrower(s.tier, b: ast.visibilityOf(td.fields[i].visibility))
			let fs = Surface.make(fTier, noun: "field", name: "{td.name}.{td.fields[i].name}", at: r.tree.startOf(tRef))
			signatureType(r, p: p, s: fs, position: "in its type", tr: tRef, errs: errs)
		end 'ht'
		let dExpr = td.fields[i].defaultRef
		if dExpr != 0 'hd'
			resolveStandaloneExpr(r, p: p, ms: ms, e: dExpr, errs: errs)
		end 'hd'
	end 'flds'
	let emptyFields = BoolStrMap.new()
	for i in 0 upto td.methods.count() 'meths'
		let surface = methodSurface(r, owner: td.name, m: td.methods[i])
		if td.methods[i].isStatic 'st'
			resolveFuncDecl(r, p: p, ms: ms, f: td.methods[i].clone(), s: surface, fieldNames: emptyFields, hasReceiver: false, errs: errs)
		end 'st' else 'inst'
			resolveFuncDecl(r, p: p, ms: ms, f: td.methods[i].clone(), s: surface, fieldNames: fNames, hasReceiver: true, errs: errs)
		end 'inst'
	end 'meths'
	r.members = ast.DeclRefIndex.new()
	r.typeParams = outer
end 'resolveTypeDecl'

// resolveNestedAliases brings the typealiases and the static lets that the body of the type or interface owner declares into
// scope, then resolves the targets of the typealiases, which may name the parameters and each other, and the values of the
// static lets.
function resolveNestedAliases(mutates r Resolver, p ast.Project, ms ast.ModuleState, owner String, aliases ast.AliasDeclList, statics ast.ConstDeclList, s Surface, mutates errs diag.ErrorList)
	for i in 0 upto aliases.count() 'scope'
		match consumes p.modules[ast.modIndex(r.modID)].names.get(ast.nestedAliasName(owner, name: aliases[i].name)) 'declared'
			some(ord) then r.members.insert(aliases[i].name.clone(), value: ast.DeclRef.make(r.modID, ordinal: ord))
			none then panic("the typealias '{aliases[i].name}' of '{owner}' is not among the declarations of its module")
		end 'declared'
	end 'scope'
	for i in 0 upto statics.count() 'staticScope'
		match consumes p.modules[ast.modIndex(r.modID)].names.get(ast.nestedAliasName(owner, name: statics[i].name)) 'declared'
			some(ord) then r.members.insert(statics[i].name.clone(), value: ast.DeclRef.make(r.modID, ordinal: ord))
			none then panic("the static let '{statics[i].name}' of '{owner}' is not among the declarations of its module")
		end 'declared'
	end 'staticScope'
	for i in 0 upto aliases.count() 'targets'
		let a = aliases[i].clone()
		let surface = Surface.make(narrower(s.tier, b: ast.visibilityOf(a.visibility)), noun: "typealias", name: ast.nestedAliasName(owner, name: a.name), at: r.tree.reportStartOf(a.id))
		resolveAliasDecl(r, p: p, ad: a, s: surface, errs: errs)
	end 'targets'
	for i in 0 upto statics.count() 'values'
		resolveConstDecl(r, p: p, ms: ms, cd: statics[i].clone(), errs: errs)
	end 'values'
end 'resolveNestedAliases'

// resolveRawValue resolves the value that a case writes after '=', where it is not a literal: a literal names nothing.
function resolveRawValue(mutates r Resolver, p ast.Project, ms ast.ModuleState, raw ast.NodeID, mutates errs diag.ErrorList)
	if raw != 0 'written'
		resolveStandaloneExpr(r, p: p, ms: ms, e: raw, errs: errs)
	end 'written'
end 'resolveRawValue'

function resolveEnumDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, ed ast.EnumDecl, s Surface, mutates errs diag.ErrorList)
	checkEnd(r, label: ed.name, endNode: ed.endRef, errs: errs)
	resolveConforms(r, p: p, s: s, conforms: ed.conforms, errs: errs)
	for i in 0 upto ed.cases.count() 'cs'
		resolveRawValue(r, p: p, ms: ms, raw: ed.cases[i].raw, errs: errs)
	end 'cs'
	let emptyFields = BoolStrMap.new()
	for i in 0 upto ed.methods.count() 'meths'
		let surface = methodSurface(r, owner: ed.name, m: ed.methods[i])
		resolveFuncDecl(r, p: p, ms: ms, f: ed.methods[i].clone(), s: surface, fieldNames: emptyFields, hasReceiver: not ed.methods[i].isStatic, errs: errs)
	end 'meths'
end 'resolveEnumDecl'

function resolveUnionDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, ud ast.UnionDecl, s Surface, mutates errs diag.ErrorList)
	checkEnd(r, label: ud.name, endNode: ud.endRef, errs: errs)
	let outer = enterTypeParams(r, p: p, owner: ud.name, s: s, params: ud.typeParams, constraints: ud.whereList, errs: errs)
	resolveConforms(r, p: p, s: s, conforms: ud.conforms, errs: errs)
	for i in 0 upto ud.cases.count() 'cs'
		refuseParamDefaults(r, params: ud.cases[i].fields, noun: "union case", errs: errs)
		for j in 0 upto ud.cases[i].fields.count() 'ps'
			let tRef = ud.cases[i].fields[j].typeRef
			let cs = Surface.make(s.tier, noun: "union case", name: "{ud.name}.{ud.cases[i].name}", at: r.tree.startOf(tRef))
			signatureType(r, p: p, s: cs, position: "in the type of payload '{ud.cases[i].fields[j].name}'", tr: tRef, errs: errs)
		end 'ps'
		resolveRawValue(r, p: p, ms: ms, raw: ud.cases[i].raw, errs: errs)
	end 'cs'
	let emptyFields = BoolStrMap.new()
	for i in 0 upto ud.methods.count() 'meths'
		let surface = methodSurface(r, owner: ud.name, m: ud.methods[i])
		resolveFuncDecl(r, p: p, ms: ms, f: ud.methods[i].clone(), s: surface, fieldNames: emptyFields, hasReceiver: not ud.methods[i].isStatic, errs: errs)
	end 'meths'
	r.typeParams = outer
end 'resolveUnionDecl'

// extendedDecl is the declaration an extension extends, when its target names one.
function extendedDecl(r Resolver, xd ast.ExtensionDecl) returns table.Option with ast.DeclRef
	if xd.isInt 'integer'
		return table.Option.none
	end 'integer'
	return r.res.decls.get(xd.target as Count)
end 'extendedDecl'

// extendedName is the name an extension's end label repeats: the extended type's, whether or not it is qualified.
function extendedName(r Resolver, xd ast.ExtensionDecl) returns String
	if xd.isInt 'integer'
		return "int"
	end 'integer'
	return ast.typeRefName(r.tree, id: xd.target)
end 'extendedName'

// extensionTypeParams are the type parameters of the declaration an extension extends, or the associated types of the
// interface it extends, which its code names as that declaration's own code does.
function extensionTypeParams(p ast.Project, ref ast.DeclRef) returns ast.TypeParamList
	return match ast.moduleDecl(p, ref: ref) 'k'
		typeDecl(td) gives td.typeParams.clone()
		unionDecl(ud) gives ud.typeParams.clone()
		enumDecl(_) gives ast.TypeParamList.create(0)
		interfaceDecl(ifd) gives ifd.typeParams.clone()
		aliasDecl(_) gives ast.TypeParamList.create(0)
		funcDecl(_) gives ast.TypeParamList.create(0)
		constDecl(_) gives ast.TypeParamList.create(0)
		extensionDecl(_) gives ast.TypeParamList.create(0)
	end 'k'
end 'extensionTypeParams'

// extensionFieldNames are the fields of the type an extension extends, which a method of the extension names bare.
function extensionFieldNames(p ast.Project, ref ast.DeclRef) returns BoolStrMap
	var names = BoolStrMap.new()
	match ast.moduleDecl(p, ref: ref) 'k'
		typeDecl(td) then names = declaredFieldNames(td)
		unionDecl(_) then _ = 0
		enumDecl(_) then _ = 0
		interfaceDecl(_) then _ = 0
		aliasDecl(_) then _ = 0
		funcDecl(_) then _ = 0
		constDecl(_) then _ = 0
		extensionDecl(_) then _ = 0
	end 'k'
	return names
end 'extensionFieldNames'

function declaredFieldNames(td ast.TypeDecl) returns BoolStrMap
	var names = BoolStrMap.new()
	for i in 0 upto td.fields.count() 'each'
		names.insert(td.fields[i].name.clone(), value: true)
	end 'each'
	return names
end 'declaredFieldNames'

// resolveExtensionDecl resolves the type an extension extends and the methods it adds, which see the type parameters and the
// fields of that type. Each type parameter has a node of the extension's own, since the type's nodes are in its module.
function resolveExtensionDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, xd ast.ExtensionDecl, s Surface, mutates errs diag.ErrorList)
	let name = extendedName(r, xd: xd)
	checkEnd(r, label: name, endNode: xd.endRef, errs: errs)
	if not xd.isInt 'target'
		resolveTypeRef(r, p: p, tr: xd.target, errs: errs)
	end 'target'
	let outer = cloneTypeParamMap(r.typeParams)
	var fieldNames = BoolStrMap.new()
	match consumes extendedDecl(r, xd: xd) 'extended'
		some(ref) then fieldNames = enterExtendedMembers(r, p: p, xd: xd, ref: ref)
		none then _ = 0
	end 'extended'
	enterExtensionAliases(r, p: p, xd: xd)
	for i in 0 upto xd.aliases.count() 'aliases'
		let a = xd.aliases[i].clone()
		let surface = Surface.make(ast.visibilityOf(a.visibility), noun: "typealias", name: ast.nestedAliasName(ast.extensionOwnerName(r.tree, xd: xd), name: a.name), at: r.tree.reportStartOf(a.id))
		resolveAliasDecl(r, p: p, ad: a, s: surface, errs: errs)
	end 'aliases'
	resolveConforms(r, p: p, s: s, conforms: xd.conforms, errs: errs)
	enterConstraints(r, p: p, owner: name, s: s, constraints: xd.whereList, ofExtension: true, errs: errs)
	let emptyFields = BoolStrMap.new()
	for i in 0 upto xd.methods.count() 'meths'
		let surface = methodSurface(r, owner: name, m: xd.methods[i])
		if xd.methods[i].isStatic 'st'
			resolveFuncDecl(r, p: p, ms: ms, f: xd.methods[i].clone(), s: surface, fieldNames: emptyFields, hasReceiver: false, errs: errs)
		end 'st' else 'inst'
			resolveFuncDecl(r, p: p, ms: ms, f: xd.methods[i].clone(), s: surface, fieldNames: fieldNames, hasReceiver: true, errs: errs)
		end 'inst'
	end 'meths'
	r.members = ast.DeclRefIndex.new()
	r.typeParams = outer
end 'resolveExtensionDecl'

// enterExtensionAliases brings into scope the typealiases that a bare name in the extension may mean: the ones that the body
// of the extended type declares, and the ones that the extensions of the module declare for it.
function enterExtensionAliases(mutates r Resolver, p ast.Project, xd ast.ExtensionDecl)
	match consumes extendedDecl(r, xd: xd) 'extended'
		some(ref) then ast.nestedMembers(p, declaring: ref.module, owner: ast.declName(p, ref: ref), from: r.modID, out: r.members)
		none then _ = 0
	end 'extended'
	ast.nestedMembers(p, declaring: r.modID, owner: ast.extensionOwnerName(r.tree, xd: xd), from: r.modID, out: r.members)
end 'enterExtensionAliases'

// enterExtendedMembers brings the type parameters of the extended declaration into scope, and gives its field names.
function enterExtendedMembers(mutates r Resolver, p ast.Project, xd ast.ExtensionDecl, ref ast.DeclRef) returns BoolStrMap
	let params = extensionTypeParams(p, ref: ref)
	for i in 0 upto params.count() 'params'
		var tp = ast.newTypeParam(r.tree, start: r.tree.startOf(xd.target))
		tp.name = params[i].name.clone()
		let slot = r.res.addTypeParam(tp.clone())
		if i == 0 'first'
			r.res.extParams.insert(xd.id as Count, value: slot)
		end 'first'
		r.typeParams.insert(params[i].name.clone(), value: slot)
	end 'params'
	return extensionFieldNames(p, ref: ref)
end 'enterExtendedMembers'

function resolveAliasDecl(mutates r Resolver, p ast.Project, ad ast.AliasDecl, s Surface, mutates errs diag.ErrorList)
	if ad.instance != 0 'inst'
		signatureType(r, p: p, s: s, position: "in its target", tr: ad.instance, errs: errs)
	end 'inst'
	if ad.parent != 0 'parent'
		signatureType(r, p: p, s: s, position: "in its implements clause", tr: ad.parent, errs: errs)
	end 'parent'
	if ad.fn != 0 'fn'
		let paramsRef = ast.funcTypeParamsRef(r.tree, id: ad.fn)
		for i in 0 upto r.tree.listLen(paramsRef) 'params'
			let tr = ast.funcTypeParamType(r.tree, id: r.tree.listAt(paramsRef, index: i) as ast.NodeID)
			signatureType(r, p: p, s: s, position: "in its parameter {i + 1}", tr: tr, errs: errs)
		end 'params'
		let ret = ast.funcTypeReturns(r.tree, id: ad.fn)
		if ret != 0 'returns'
			signatureType(r, p: p, s: s, position: "in its result", tr: ret, errs: errs)
		end 'returns'
	end 'fn'
end 'resolveAliasDecl'

// resolveInterfaceDecl resolves the requirements, which take the interface's visibility: a conformer's caller reaches
// them through the interface.
function resolveInterfaceDecl(mutates r Resolver, p ast.Project, ms ast.ModuleState, ifd ast.InterfaceDecl, mutates errs diag.ErrorList)
	checkEnd(r, label: ifd.name, endNode: ifd.endRef, errs: errs)
	let tier = ast.visibilityOf(ifd.visibility)
	let ifs = Surface.make(tier, noun: "interface", name: ifd.name.clone(), at: r.tree.startOf(ifd.id))
	let outer = enterTypeParams(r, p: p, owner: ifd.name, s: ifs, params: ifd.typeParams, constraints: ast.ConstraintList.create(0), errs: errs)
	resolveNestedAliases(r, p: p, ms: ms, owner: ifd.name, aliases: ifd.aliases, statics: ast.ConstDeclList.create(0), s: ifs, errs: errs)
	resolveInterfaceList(r, p: p, s: ifs, interfaces: ifd.parents, position: "in its extends clause", errs: errs)
	r.expandsMembers = true
	for i in 0 upto ifd.methods.count() 'sigs'
		let s = Surface.make(tier, noun: "function", name: "{ifd.name}.{ifd.methods[i].name}", at: r.tree.startOf(ifd.methods[i].id))
		signature(r, p: p, s: s, params: ifd.methods[i].params, returnsRef: ifd.methods[i].returnsRef, throwsRef: ifd.methods[i].throwsRef, errs: errs)
		refuseParamDefaults(r, params: ifd.methods[i].params, noun: "interface requirement", errs: errs)
	end 'sigs'
	r.expandsMembers = false
	r.members = ast.DeclRefIndex.new()
	r.typeParams = outer
end 'resolveInterfaceDecl'

export function resolveModule(mutates ms ast.ModuleState, p ast.Project, mutates errs diag.ErrorList)
	let modID = ms.module
	let modIdx = ast.modIndex(modID)
	var r = Resolver.make(modID, tree: exchange(ms.tree, value: ast.Tree.new(modID, text: "")), res: exchange(ms.resolution, value: ast.Resolution.new(modID)))
	let declCount = p.modules[modIdx].decls.count()
	for i in 0 upto declCount 'eachD'
		r.typeParams = TypeParamMap.new()
		let d = p.modules[modIdx].decls[i].clone()
		resolveTopDecl(r, p: p, ms: ms, d: d, errs: errs)
	end 'eachD'
	ms.tree = exchange(r.tree, value: ast.Tree.new(modID, text: ""))
	ms.resolution = exchange(r.res, value: ast.Resolution.new(modID))
end 'resolveModule'

export function resolveProject(mutates p ast.Project, mutates errs diag.ErrorList)
	resolveFrom(p, first: 0, errs: errs)
end 'resolveProject'

// resolveFrom resolves the modules from the one at index first on, the ones a project added to modules that are resolved
// already.
export function resolveFrom(mutates p ast.Project, first Count, mutates errs diag.ErrorList)
	for i in first upto p.modules.count() 'eachM'
		let module = p.modules[i].id
		var ms = ast.lendModule(p, module: module, lent: ast.Lent.tree)
		resolveModule(ms, p: p, errs: errs)
		ast.giveBack(p, ms: ms)
	end 'eachM'
end 'resolveFrom'
