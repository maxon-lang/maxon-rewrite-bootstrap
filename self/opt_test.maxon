// The matcher of generic.rules (opt.rewriteInstr) on instructions built by hand: each rewrites to a register, to an
// instruction after the instructions it needs, or stays.

function expectRewrittenToReg(mutates f ir.IrFunction, defs opt.DefList, at Count, want ir.Reg, label String)
	var out = opt.Rewrite.new()
	if not opt.rewriteInstr(f, at: at, defs: defs, out: out) 'none'
		panic("{label}: no rule rewrites it")
	end 'none'
	if out.kind != opt.RewriteKind.rewriteToReg or out.reg != want 'differs'
		panic("{label}: it is not rewritten to %{want}")
	end 'differs'
end 'expectRewrittenToReg'

function expectKept(mutates f ir.IrFunction, defs opt.DefList, at Count, label String)
	var out = opt.Rewrite.new()
	if opt.rewriteInstr(f, at: at, defs: defs, out: out) 'some'
		panic("{label}: a rule rewrites it")
	end 'some'
end 'expectKept'

// expectRewrittenToInstr runs the rules on the instruction at and gives what they rewrite it to.
function expectRewrittenToInstr(mutates f ir.IrFunction, defs opt.DefList, at Count, label String) returns opt.Rewrite
	var out = opt.Rewrite.new()
	if not opt.rewriteInstr(f, at: at, defs: defs, out: out) 'none'
		panic("{label}: no rule rewrites it")
	end 'none'
	if out.kind != opt.RewriteKind.rewriteToInstr 'differs'
		panic("{label}: it is not rewritten to an instruction")
	end 'differs'
	return out
end 'expectRewrittenToInstr'

function emitTo(mutates f ir.IrFunction, consumes x ir.Instr) returns Count
	let at = f.instrs.count()
	f.instrs.push(x)
	return at
end 'emitTo'

function emitBin(mutates f ir.IrFunction, op ir.BinOp, left ir.Reg, right ir.Reg, unsigned bool, fail ir.BlockID) returns Count
	let dst = f.newReg(ir.IrKind.kindScalar)
	return emitTo(f, x: ir.newBin(dst, op: op, left: left, right: right, unsigned: unsigned, fail: fail))
end 'emitBin'

function emitNeg(mutates f ir.IrFunction, src ir.Reg, fail ir.BlockID) returns Count
	let dst = f.newReg(ir.IrKind.kindScalar)
	return emitTo(f, x: ir.newNeg(dst, src: src, fail: fail))
end 'emitNeg'

function testRewrite()
	var f = ir.IrFunction.new(0 as ast.FuncID, name: "rules", paramCount: 2)
	let x = f.newReg(ir.IrKind.kindScalar)
	_ = emitTo(f, x: ir.newLoadParam(x, param: 0))
	let y = f.newReg(ir.IrKind.kindScalar)
	_ = emitTo(f, x: ir.newLoadParam(y, param: 1))
	let zero = f.newReg(ir.IrKind.kindScalar)
	_ = emitTo(f, x: ir.newConst(zero, value: 0))
	let eight = f.newReg(ir.IrKind.kindScalar)
	_ = emitTo(f, x: ir.newConst(eight, value: 8))
	let fail = 0 as ir.BlockID
	let addZero = emitBin(f, op: ir.BinOp.binAdd, left: x, right: zero, unsigned: false, fail: fail)
	let zeroAdd = emitBin(f, op: ir.BinOp.binAdd, left: zero, right: y, unsigned: true, fail: ir.noBlock)
	let andSelf = emitBin(f, op: ir.BinOp.binAnd, left: y, right: y, unsigned: false, fail: ir.noBlock)
	let mulZero = emitBin(f, op: ir.BinOp.binMul, left: zero, right: x, unsigned: false, fail: fail)
	let mulEight = emitBin(f, op: ir.BinOp.binMul, left: eight, right: x, unsigned: false, fail: ir.noBlock)
	let checkedMulEight = emitBin(f, op: ir.BinOp.binMul, left: x, right: eight, unsigned: false, fail: fail)
	let xorSelf = emitBin(f, op: ir.BinOp.binXor, left: x, right: x, unsigned: false, fail: ir.noBlock)
	let subXY = emitBin(f, op: ir.BinOp.binSub, left: x, right: y, unsigned: false, fail: fail)
	let negX = f.newReg(ir.IrKind.kindScalar)
	_ = emitTo(f, x: ir.newNeg(negX, src: x, fail: ir.noBlock))
	let negNegX = emitNeg(f, src: negX, fail: fail)
	let defs = opt.defsOf(f)
	expectRewrittenToReg(f, defs: defs, at: addZero, want: x, label: "x + 0")
	expectRewrittenToReg(f, defs: defs, at: zeroAdd, want: y, label: "0 + y")
	expectRewrittenToReg(f, defs: defs, at: andSelf, want: y, label: "y and y")
	expectRewrittenToReg(f, defs: defs, at: mulZero, want: zero, label: "0 * x")
	expectKept(f, defs: defs, at: checkedMulEight, label: "a checked x * 8")
	expectKept(f, defs: defs, at: subXY, label: "x - y")
	// An unchecked -x of i64.min is i64.min, which a checked - of it would fail on.
	expectKept(f, defs: defs, at: negNegX, label: "a checked -(-x) of an unchecked -x")
	let regs = f.regs.count()
	let shift = expectRewrittenToInstr(f, defs: defs, at: mulEight, label: "8 * x")
	if shift.pre.count() != 1 or ir.constValue(shift.pre[0]) != 3 or shift.pre[0].dst != ir.regOf(regs) 'pre'
		panic("8 * x: the shift count is not a new const 3")
	end 'pre'
	if shift.instr.op != ir.Opcode.opBin or ir.binOp(shift.instr) != ir.BinOp.binShl or ir.binLeft(shift.instr) != x or ir.binRight(shift.instr) != ir.regOf(regs) or ir.binHasFail(shift.instr) or shift.instr.dst != f.instrs[mulEight].dst 'shl'
		panic("8 * x: it is not rewritten to x shl 3")
	end 'shl'
	let cleared = expectRewrittenToInstr(f, defs: defs, at: xorSelf, label: "x xor x")
	if cleared.instr.op != ir.Opcode.opConst or ir.constValue(cleared.instr) != 0 or cleared.pre.count() != 0 'zero'
		panic("x xor x: it is not rewritten to const 0")
	end 'zero'
end 'testRewrite'
