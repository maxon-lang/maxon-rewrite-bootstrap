// Interning by structural hash: two structures under one word are a clash that names both types, never one type. No two
// structures of a program are known to share a hash, so the test gives the lookup the word of another instance.

function testShapeClash()
	var p = ast.Project.new("self")
	var counts = ast.TypeIDList.create(0)
	counts.push(p.builtins.countTy)
	let arrayOfCount = ast.instantiateType(p.types, origin: p.builtins.arrayOrigin, args: counts)
	var strings = ast.TypeIDList.create(0)
	strings.push(p.builtins.stringTy)
	let word = ast.instanceWord(p.types, origin: p.builtins.arrayOrigin, args: counts)
	match consumes ast.instanceUnder(p.types, word: word, origin: p.builtins.arrayOrigin, args: counts) 'own'
		same(id) then assertEqStr("{id}", expected: "{arrayOfCount}", label: "shapes: the instance under its own word")
		absent then panic("shapes: an interned instance is not found under its word")
		clash(message) then panic("shapes: an instance clashes with itself: {message}")
	end 'own'
	match consumes ast.instanceUnder(p.types, word: word, origin: p.builtins.arrayOrigin, args: strings) 'forced'
		clash(message) then assertEqStr(message, expected: "internal error: the types 'Array with Count' and 'Array with String' have one structural hash, {word}", label: "shapes: a clash")
		same(_) then panic("shapes: two instances under one word are taken for one type")
		absent then panic("shapes: a word that holds a type is found empty")
	end 'forced'
end 'testShapeClash'
