function parseBound(mutates p Parser) returns ast.Bound
	let start = p.curStart()
	let neg = p.accept(TokenKind.minus)
	if p.curKind() == TokenKind.integer 'num'
		let tok = p.advance()
		let val = decodeIntText(tok.text(p.src))
		let id = p.tree.alloc(ast.NodeKind.bound, start: start)
		return ast.Bound.makeInt(id, negative: neg, value: val)
	end 'num'
	let sizedTok = p.expect(TokenKind.name, what: "a range bound")
	_ = p.expect(TokenKind.dot, what: "'.'")
	let limTok = p.expect(TokenKind.name, what: "a limit name")
	let id = p.tree.alloc(ast.NodeKind.bound, start: start)
	return ast.Bound.makeSized(id, negative: neg, sizedName: sizedTok.text(p.src), limitName: limTok.text(p.src))
end 'parseBound'

function parseTypeRef(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	var quals = ast.U32List.new()
	while p.curKind() == TokenKind.name and p.peekKind(1 as Count) == TokenKind.dot 'q'
		quals.append(p.curTextRef())
		_ = p.advance()
		_ = p.advance()
	end 'q'
	let nameRef = p.curTextRef()
	if not p.accept(TokenKind.kwSelfType) 'nm'
		_ = p.expect(TokenKind.name, what: "a type name")
	end 'nm'
	var args = ast.U32List.new()
	if p.accept(TokenKind.kwWith) 'withArgs'
		if p.accept(TokenKind.lParen) 'paren'
			while not p.hasError 'a'
				args.append(parseTypeRef(p) as diag.U32)
				if not p.accept(TokenKind.comma) 'adone'
					break 'a'
				end 'adone'
			end 'a'
			_ = p.expect(TokenKind.rParen, what: "')'")
		end 'paren' else 'single'
			args.append(parseTypeRef(p) as diag.U32)
		end 'single'
	end 'withArgs'
	let id = ast.newTypeRef(p.tree, start: start)
	let qRef = p.tree.pushList(quals)
	let aRef = p.tree.pushList(args)
	ast.setTypeRefQualifierRef(p.tree, id: id, ref: qRef)
	ast.setTypeRefNameRef(p.tree, id: id, ref: nameRef)
	ast.setTypeRefTypeArgsRef(p.tree, id: id, ref: aRef)
	return id
end 'parseTypeRef'

function decodeIntText(text String) returns ast.I128
	var base = 10 as Count
	var start = 0 as Count
	let n = text.byteCount()
	if n >= 2 and text.byteAt(0 as Count) == byteZero 'pref'
		let b1 = text.byteAt(1 as Count)
		if b1 == byteLowerX 'hex'
			base = 16 as Count
			start = 2 as Count
		end 'hex' else if b1 == byteLowerB 'bin'
			base = 2 as Count
			start = 2 as Count
		end 'bin' else if b1 == byteLowerO 'oct'
			base = 8 as Count
			start = 2 as Count
		end 'oct'
	end 'pref'
	var acc = 0 as Count
	for i in start upto n 'd'
		let b = text.byteAt(i)
		if b == byteUnderscore 'skip'
			continue 'd'
		end 'skip'
		var digit = 0 as Count
		if b >= byteZero and b <= byteNine 'dec'
			digit = (b - byteZero) as Count
		end 'dec' else if b >= byteLowerA and b <= byteLowerF 'lhex'
			digit = ((b - byteLowerA) as Count) + 10
		end 'lhex' else if b >= byteUpperA and b <= byteUpperF 'uhex'
			digit = ((b - byteUpperA) as Count) + 10
		end 'uhex'
		acc = try acc * base + digit otherwise acc
	end 'd'
	return ast.I128.fromCount(acc)
end 'decodeIntText'

function parseIntLit(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	let neg = p.accept(TokenKind.minus)
	let tok = p.expect(TokenKind.integer, what: "an integer")
	let val = decodeIntText(tok.text(p.src))
	let id = ast.newIntLit(p.tree, start: start)
	if neg 'n'
		ast.setIntLitNegative(p.tree, id: id)
	end 'n'
	ast.setIntLitMagnitude(p.tree, id: id, value: val)
	return id
end 'parseIntLit'

function hexDigitVal(b Byte) returns Count
	if b >= byteZero and b <= byteNine 'd'
		return (b - byteZero) as Count
	end 'd'
	if b >= byteLowerA and b <= byteLowerF 'l'
		return ((b - byteLowerA) as Count) + 10
	end 'l'
	if b >= byteUpperA and b <= byteUpperF 'u'
		return ((b - byteUpperA) as Count) + 10
	end 'u'
	return 0 as Count
end 'hexDigitVal'

function pushUtf8Rune(mutates buf Bytes, codepoint Count)
	if codepoint < 128 'b1'
		buf.push(codepoint as Byte)
		return
	end 'b1'
	if codepoint < 2048 'b2'
		let hi = try (codepoint shr 6) as Byte otherwise 0 as Byte
		buf.push(((192 as Byte) or hi) as Byte)
		buf.push((128 or (codepoint and 63)) as Byte)
		return
	end 'b2'
	let b0 = try (224 or (codepoint shr 12)) as Byte otherwise 0 as Byte
	buf.push(b0)
	buf.push((128 or ((codepoint shr 6) and 63)) as Byte)
	buf.push((128 or (codepoint and 63)) as Byte)
end 'pushUtf8Rune'

function parseInterpExpr(mutates p Parser, exprStart Count, exprEnd Count) returns ast.NodeID
	let lexRes = lexInterpolation(p.src, begin: exprStart, until: exprEnd)
	var subToks as Tokens
	match consumes lexRes 'lr'
		ok(t) then subToks = t
		err(e) then return panicFailExpr(p, msg: "invalid string interpolation")
	end 'lr'
	let oldToks = exchange(p.tokens, value: subToks)
	let oldPos = p.pos
	p.pos = 0 as Count
	let subExpr = parseExpr(p)
	if not p.hasError and p.curKind() != TokenKind.fileEnd and p.curKind() != TokenKind.eof 'trailing'
		p.fail(diag.errUnexpectedToken, message: "unexpected token in interpolation")
	end 'trailing'
	p.tokens = oldToks
	p.pos = oldPos
	return subExpr
end 'parseInterpExpr'

function panicFailExpr(mutates p Parser, consumes msg String) returns ast.NodeID
	p.fail(diag.errUnexpectedToken, message: msg)
	return 0 as ast.NodeID
end 'panicFailExpr'

function flushStrText(mutates p Parser, mutates parts ast.U32List, mutates buf Bytes, hasBuf bool, runStart Count, pos Count)
	if hasBuf 'dec'
		let idx = p.tree.addString(buf.toString())
		parts.append(1 as diag.U32)
		parts.append(idx)
		buf = Bytes.new()
		return
	end 'dec'
	let n = try pos - runStart otherwise 0 as Count
	let tag = try (n + 2) as diag.U32 otherwise panic("string part overflow")
	let off = try runStart as diag.U32 otherwise panic("string part offset overflow")
	parts.append(tag)
	parts.append(off)
end 'flushStrText'

function findInterpEnd(src String, openBrace Count, endPos Count) returns Count
	var i = try openBrace + 1 otherwise openBrace
	var nest = 0 as Count
	while i < endPos 'scan'
		let c = src.byteAt(i)
		if c == byteRBrace and nest == 0 'done'
			return i
		end 'done'
		if c == byteLBrace 'open'
			nest = try nest + 1 otherwise nest
		end 'open' else if c == byteRBrace 'close'
			if nest > 0 'dn'
				nest = nest - 1
			end 'dn'
		end 'close' else if c == byteQuote 'str'
			i = try i + 1 otherwise i
			while i < endPos and src.byteAt(i) != byteQuote 's'
				if src.byteAt(i) == byteBackslash 'esc'
					i = try i + 1 otherwise i
				end 'esc'
				if i < endPos 'adv'
					i = try i + 1 otherwise i
				end 'adv'
			end 's'
		end 'str'
		i = try i + 1 otherwise i
	end 'scan'
	return i
end 'findInterpEnd'

function parseStrLit(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	let tok = p.expect(TokenKind.string, what: "a string")
	let id = ast.newStrLit(p.tree, start: start)
	if tok.length < 2 'emptyTok'
		return id
	end 'emptyTok'
	let endPos = try tok.start + tok.length - 1 otherwise tok.start
	var i = try tok.start + 1 otherwise tok.start
	var runStart = i
	var buf = Bytes.new()
	var hasBuf = false
	var added = false
	var parts = ast.U32List.new()
	while i < endPos and not p.hasError 'scan'
		let c = p.src.byteAt(i)
		if c == byteBackslash 'esc'
			if not hasBuf 'startBuf'
				if i > runStart 'copyPrefix'
					buf.appendString(p.src.slice(runStart, until: i))
				end 'copyPrefix'
				hasBuf = true
			end 'startBuf'
			i = try i + 1 otherwise i
			if i >= endPos 'bad'
				break 'scan'
			end 'bad'
			let e = p.src.byteAt(i)
			i = try i + 1 otherwise i
			if e == byteLowerN 'en'
				buf.push(byteNewline)
			end 'en' else if e == byteLowerT 'et'
				buf.push(byteTab)
			end 'et' else if e == byteLowerR 'er'
				buf.push(byteCR)
			end 'er' else if e == byteZero 'ez'
				buf.push(0 as Byte)
			end 'ez' else if e == byteLowerX 'ex'
				var v = 0 as Count
				if (try i + 1 otherwise i) < endPos 'okx'
					v = try hexDigitVal(p.src.byteAt(i)) * 16 + hexDigitVal(p.src.byteAt(i + 1)) otherwise 0 as Count
					i = try i + 2 otherwise i
				end 'okx'
				pushUtf8Rune(buf, codepoint: v)
			end 'ex' else if e == byteLowerU 'eu'
				var v = 0 as Count
				for _ in 0 upto 4 'u4'
					if i < endPos 'oku'
						v = try v * 16 + hexDigitVal(p.src.byteAt(i)) otherwise 0 as Count
						i = try i + 1 otherwise i
					end 'oku'
				end 'u4'
				pushUtf8Rune(buf, codepoint: v)
			end 'eu' else 'lit'
				buf.push(e)
			end 'lit'
			continue 'scan'
		end 'esc'
		if c == byteLBrace 'interp'
			if i > runStart or hasBuf 'flushBefore'
				flushStrText(p, parts: parts, buf: buf, hasBuf: hasBuf, runStart: runStart, pos: i)
				hasBuf = false
			end 'flushBefore'
			let exprEnd = findInterpEnd(p.src, openBrace: i, endPos: endPos)
			let exprStart = try i + 1 otherwise i
			let subExpr = parseInterpExpr(p, exprStart: exprStart, exprEnd: exprEnd)
			parts.append(0 as diag.U32)
			parts.append(subExpr as diag.U32)
			added = true
			i = try exprEnd + 1 otherwise exprEnd
			runStart = i
			continue 'scan'
		end 'interp'
		if hasBuf 'pushChar'
			buf.push(c)
		end 'pushChar'
		i = try i + 1 otherwise i
	end 'scan'
	if i > runStart or hasBuf or not added 'flushEnd'
		flushStrText(p, parts: parts, buf: buf, hasBuf: hasBuf, runStart: runStart, pos: i)
	end 'flushEnd'
	let partsRef = p.tree.pushList(parts)
	ast.setStrLitPartsRef(p.tree, id: id, ref: partsRef)
	return id
end 'parseStrLit'

function parseBoolLit(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	let isTrue = p.curKind() == TokenKind.kwTrue
	_ = p.advance()
	let id = ast.newBoolLit(p.tree, start: start)
	if isTrue 't'
		ast.setBoolLitValue(p.tree, id: id)
	end 't'
	return id
end 'parseBoolLit'

function parsePatternValue(mutates p Parser) returns ast.NodeID
	let k = p.curKind()
	if k == TokenKind.integer or k == TokenKind.minus 'num'
		return parseIntLit(p)
	end 'num'
	if k == TokenKind.string 'str'
		return parseStrLit(p)
	end 'str'
	return parseBoolLit(p)
end 'parsePatternValue'

function parsePattern(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	let id = ast.newPattern(p.tree, start: start)
	if p.curKind() == TokenKind.name 'cs'
		let nameRef = p.curTextRef()
		_ = p.advance()
		ast.setPatternCaseNameRef(p.tree, id: id, ref: nameRef)
		if p.accept(TokenKind.lParen) 'binds'
			ast.setPatternHasBindings(p.tree, id: id)
			var bs = ast.U32List.new()
			if p.curKind() != TokenKind.rParen 'nonEmpty'
				while not p.hasError 'b'
					let bRef = p.curTextRef()
					if not p.accept(TokenKind.kwUnderscore) 'nm'
						_ = p.expect(TokenKind.name, what: "a pattern binding")
					end 'nm'
					bs.append(bRef)
					if not p.accept(TokenKind.comma) 'bdone'
						break 'b'
					end 'bdone'
				end 'b'
			end 'nonEmpty'
			_ = p.expect(TokenKind.rParen, what: "')'")
			let bListRef = p.tree.pushList(bs)
			ast.setPatternBindingsRef(p.tree, id: id, ref: bListRef)
		end 'binds'
		return id
	end 'cs'
	let lo = parsePatternValue(p)
	ast.setPatternValue(p.tree, id: id, value: lo)
	if p.accept(TokenKind.kwTo) 'to'
		ast.setPatternInclusive(p.tree, id: id)
		let hi = parsePatternValue(p)
		ast.setPatternHigh(p.tree, id: id, value: hi)
	end 'to' else if p.accept(TokenKind.kwUpto) 'upto'
		let hi = parsePatternValue(p)
		ast.setPatternHigh(p.tree, id: id, value: hi)
	end 'upto'
	return id
end 'parsePattern'

function parseMatchArm(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	let id = ast.newMatchArm(p.tree, start: start)
	if p.accept(TokenKind.kwDefault) 'def'
		ast.setMatchArmIsDefault(p.tree, id: id)
	end 'def' else 'pats'
		var pats = ast.U32List.new()
		while not p.hasError 'more'
			pats.append(parsePattern(p) as diag.U32)
			if p.accept(TokenKind.kwOr) 'orMore'
				_ = p.expect(TokenKind.newline, what: "a newline")
			end 'orMore' else 'done'
				break 'more'
			end 'done'
		end 'more'
		let pRef = p.tree.pushList(pats)
		ast.setMatchArmPatternsRef(p.tree, id: id, ref: pRef)
	end 'pats'
	if p.accept(TokenKind.kwThen) 'th'
		let act = parseStmt(p)
		ast.setMatchArmAction(p.tree, id: id, value: act)
	end 'th' else if p.accept(TokenKind.kwGives) 'gv'
		ast.setMatchArmGives(p.tree, id: id)
		let val = parseExpr(p)
		ast.setMatchArmValue(p.tree, id: id, value: val)
	end 'gv' else 'pn'
		let val = parsePanicExpr(p)
		ast.setMatchArmValue(p.tree, id: id, value: val)
	end 'pn'
	return id
end 'parseMatchArm'

function parseMatchCore(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	_ = p.expect(TokenKind.kwMatch, what: "'match'")
	let consumesSubj = p.accept(TokenKind.kwConsumes)
	let subj = parseExpr(p)
	let lblRef = p.curTextRef()
	_ = p.expect(TokenKind.label, what: "a match label")
	_ = p.expect(TokenKind.newline, what: "a newline")
	var arms = ast.U32List.new()
	if p.accept(TokenKind.indent) 'body'
		while not p.hasError and p.curKind() != TokenKind.dedent and p.curKind() != TokenKind.eof 'a'
			arms.append(parseMatchArm(p) as diag.U32)
			_ = p.expect(TokenKind.newline, what: "a newline")
		end 'a'
		_ = p.expect(TokenKind.dedent, what: "the end of the match")
	end 'body'
	_ = p.expect(TokenKind.kwEnd, what: "'end'")
	let endLbl = p.parseEndLabel()
	let id = ast.newMatchCore(p.tree, start: start)
	if consumesSubj 'c'
		ast.setMatchCoreConsumes(p.tree, id: id)
	end 'c'
	ast.setMatchCoreSubject(p.tree, id: id, value: subj)
	ast.setMatchCoreLabelRef(p.tree, id: id, ref: lblRef)
	let aRef = p.tree.pushList(arms)
	ast.setMatchCoreArmsRef(p.tree, id: id, ref: aRef)
	ast.setMatchCoreEnd(p.tree, id: id, value: endLbl)
	return id
end 'parseMatchCore'

function parsePanicExpr(mutates p Parser) returns ast.NodeID
	let start = p.curStart()
	_ = p.expect(TokenKind.kwPanic, what: "'panic'")
	_ = p.expect(TokenKind.lParen, what: "'('")
	let msg = parseExpr(p)
	_ = p.expect(TokenKind.rParen, what: "')'")
	let id = ast.newPanicExpr(p.tree, start: start)
	ast.setPanicExprMessage(p.tree, id: id, value: msg)
	return id
end 'parsePanicExpr'

function parsePrimary(mutates p Parser) returns ast.NodeID
	let k = p.curKind()
	if k == TokenKind.integer 'num'
		return parseIntLit(p)
	end 'num'
	if k == TokenKind.string 'str'
		return parseStrLit(p)
	end 'str'
	if k == TokenKind.kwTrue or k == TokenKind.kwFalse 'bl'
		return parseBoolLit(p)
	end 'bl'
	if k == TokenKind.kwSelf 'slf'
		let start = p.curStart()
		_ = p.advance()
		return ast.newSelfExpr(p.tree, start: start)
	end 'slf'
	if k == TokenKind.kwPanic 'pn'
		return parsePanicExpr(p)
	end 'pn'
	if k == TokenKind.kwMatch 'mt'
		let start = p.curStart()
		let core = parseMatchCore(p)
		let id = ast.newMatchExpr(p.tree, start: start)
		ast.setMatchExprMatch(p.tree, id: id, value: core)
		return id
	end 'mt'
	if k == TokenKind.lParen 'grp'
		_ = p.advance()
		let e = parseExpr(p)
		_ = p.expect(TokenKind.rParen, what: "')'")
		return e
	end 'grp'
	if k == TokenKind.name or k == TokenKind.kwSelfType 'nm'
		let start = p.curStart()
		let nameRef = p.curTextRef()
		_ = p.advance()
		if p.accept(TokenKind.lBrace) 'slit'
			var flds = ast.U32List.new()
			if p.curKind() != TokenKind.rBrace 'nonEmpty'
				while not p.hasError 'f'
					let fStart = p.curStart()
					let fRef = p.curTextRef()
					_ = p.expect(TokenKind.name, what: "a field name")
					_ = p.expect(TokenKind.colon, what: "':'")
					let fVal = parseExpr(p)
					let sf = ast.newStructField(p.tree, start: fStart)
					ast.setStructFieldNameRef(p.tree, id: sf, ref: fRef)
					ast.setStructFieldValue(p.tree, id: sf, value: fVal)
					flds.append(sf as diag.U32)
					if not p.accept(TokenKind.comma) 'fdone'
						break 'f'
					end 'fdone'
				end 'f'
			end 'nonEmpty'
			_ = p.expect(TokenKind.rBrace, what: "'\}'")
			let id = ast.newStructLitExpr(p.tree, start: start)
			ast.setStructLitExprTypeNameRef(p.tree, id: id, ref: nameRef)
			let fListRef = p.tree.pushList(flds)
			ast.setStructLitExprFieldsRef(p.tree, id: id, ref: fListRef)
			return id
		end 'slit'
		let id = ast.newNameExpr(p.tree, start: start)
		ast.setNameExprNameRef(p.tree, id: id, ref: nameRef)
		return id
	end 'nm'
	p.fail(diag.errExpressionError, message: "expected an expression, found '{p.curText()}'")
	return 0 as ast.NodeID
end 'parsePrimary'

function parsePostfix(mutates p Parser) returns ast.NodeID
	var left = parsePrimary(p)
	while not p.hasError 'post'
		let k = p.curKind()
		if k == TokenKind.dot 'mem'
			let start = p.tree.startOf(left)
			_ = p.advance()
			let mRef = p.curTextRef()
			_ = p.expect(TokenKind.name, what: "a member name")
			let id = ast.newMemberExpr(p.tree, start: start)
			ast.setMemberExprObj(p.tree, id: id, value: left)
			ast.setMemberExprNameRef(p.tree, id: id, ref: mRef)
			left = id
		end 'mem' else if k == TokenKind.lBracket 'idx'
			let start = p.tree.startOf(left)
			_ = p.advance()
			var args = ast.U32List.new()
			while not p.hasError 'a'
				args.append(parseExpr(p) as diag.U32)
				if not p.accept(TokenKind.comma) 'adone'
					break 'a'
				end 'adone'
			end 'a'
			_ = p.expect(TokenKind.rBracket, what: "']'")
			let id = ast.newIndexExpr(p.tree, start: start)
			ast.setIndexExprObj(p.tree, id: id, value: left)
			let aRef = p.tree.pushList(args)
			ast.setIndexExprArgsRef(p.tree, id: id, ref: aRef)
			left = id
		end 'idx' else if k == TokenKind.lParen 'call'
			let start = p.tree.startOf(left)
			_ = p.advance()
			var args = ast.U32List.new()
			if p.curKind() != TokenKind.rParen 'nonEmpty'
				while not p.hasError 'a'
					let aStart = p.curStart()
					var lblRef = 0 as diag.U32
					if p.curKind() == TokenKind.name and p.peekKind(1 as Count) == TokenKind.colon 'lbl'
						lblRef = p.curTextRef()
						_ = p.advance()
						_ = p.advance()
					end 'lbl'
					let val = parseExpr(p)
					let ag = ast.newArg(p.tree, start: aStart)
					ast.setArgLabelRef(p.tree, id: ag, ref: lblRef)
					ast.setArgValue(p.tree, id: ag, value: val)
					args.append(ag as diag.U32)
					if not p.accept(TokenKind.comma) 'adone'
						break 'a'
					end 'adone'
				end 'a'
			end 'nonEmpty'
			_ = p.expect(TokenKind.rParen, what: "')'")
			let id = ast.newCallExpr(p.tree, start: start)
			ast.setCallExprCallee(p.tree, id: id, value: left)
			let aRef = p.tree.pushList(args)
			ast.setCallExprArgsRef(p.tree, id: id, ref: aRef)
			left = id
		end 'call' else 'done'
			break 'post'
		end 'done'
	end 'post'
	return left
end 'parsePostfix'

function parseUnary(mutates p Parser) returns ast.NodeID
	let k = p.curKind()
	if k == TokenKind.minus or k == TokenKind.kwNot 'un'
		let start = p.curStart()
		let opText = p.advance().text(p.src)
		let inner = parseUnary(p)
		let id = ast.newUnaryExpr(p.tree, start: start)
		ast.setUnaryExprOp(p.tree, id: id, text: opText)
		ast.setUnaryExprE(p.tree, id: id, value: inner)
		return id
	end 'un'
	return parsePostfix(p)
end 'parseUnary'

function parseCast(mutates p Parser) returns ast.NodeID
	var left = parseUnary(p)
	while p.accept(TokenKind.kwAs) 'cast'
		let start = p.tree.startOf(left)
		let target = parseTypeRef(p)
		let id = ast.newCastExpr(p.tree, start: start)
		ast.setCastExprE(p.tree, id: id, value: left)
		ast.setCastExprTarget(p.tree, id: id, value: target)
		left = id
	end 'cast'
	return left
end 'parseCast'

function binaryPrec(k TokenKind) returns Count
	if k == TokenKind.star or k == TokenKind.slash or k == TokenKind.kwMod 'p7'
		return 7 as Count
	end 'p7'
	if k == TokenKind.plus or k == TokenKind.minus 'p6'
		return 6 as Count
	end 'p6'
	if k == TokenKind.kwShl or k == TokenKind.kwShr 'p5'
		return 5 as Count
	end 'p5'
	if k == TokenKind.eqEq or k == TokenKind.notEq or k == TokenKind.lt or k == TokenKind.le or k == TokenKind.gt or k == TokenKind.ge 'p4'
		return 4 as Count
	end 'p4'
	if k == TokenKind.kwAnd 'p3'
		return 3 as Count
	end 'p3'
	if k == TokenKind.kwXor 'p2'
		return 2 as Count
	end 'p2'
	if k == TokenKind.kwOr 'p1'
		return 1 as Count
	end 'p1'
	return 0 as Count
end 'binaryPrec'

function parseBinary(mutates p Parser, minPrec Count) returns ast.NodeID
	var left = parseCast(p)
	while not p.hasError 'bin'
		let prec = binaryPrec(p.curKind())
		if prec < minPrec or prec == 0 'done'
			break 'bin'
		end 'done'
		let opText = p.advance().text(p.src)
		let nextPrec = try prec + 1 otherwise prec
		let right = parseBinary(p, minPrec: nextPrec)
		let start = p.tree.startOf(left)
		let id = ast.newBinaryExpr(p.tree, start: start)
		ast.setBinaryExprL(p.tree, id: id, value: left)
		ast.setBinaryExprOp(p.tree, id: id, text: opText)
		ast.setBinaryExprR(p.tree, id: id, value: right)
		left = id
	end 'bin'
	return left
end 'parseBinary'

function parseCond(mutates p Parser) returns ast.NodeID
	let first = parseBinary(p, minPrec: 1 as Count)
	if not p.accept(TokenKind.kwIf) 'plain'
		return first
	end 'plain'
	let cond = parseExpr(p)
	_ = p.expect(TokenKind.kwElse, what: "'else'")
	let alt = parseCond(p)
	let start = p.tree.startOf(first)
	let id = ast.newCondExpr(p.tree, start: start)
	ast.setCondExprThen(p.tree, id: id, value: first)
	ast.setCondExprCond(p.tree, id: id, value: cond)
	ast.setCondExprElse(p.tree, id: id, value: alt)
	return id
end 'parseCond'

function parseExpr(mutates p Parser) returns ast.NodeID
	if p.curKind() == TokenKind.kwTry 'tr'
		let start = p.curStart()
		_ = p.advance()
		let inner = parseExpr(p)
		let id = ast.newTryExpr(p.tree, start: start)
		ast.setTryExprE(p.tree, id: id, value: inner)
		if p.accept(TokenKind.kwOtherwise) 'oth'
			let k = p.curKind()
			if k == TokenKind.kwReturn or k == TokenKind.kwBreak or k == TokenKind.kwContinue 'jmp'
				let st = parseStmt(p)
				if k == TokenKind.kwReturn 'r'
					ast.setTryExprRet(p.tree, id: id, value: st)
				end 'r' else if k == TokenKind.kwBreak 'b'
					ast.setTryExprBrk(p.tree, id: id, value: st)
				end 'b' else 'c'
					ast.setTryExprCont(p.tree, id: id, value: st)
				end 'c'
			end 'jmp' else 'val'
				let fb = parseExpr(p)
				ast.setTryExprValue(p.tree, id: id, value: fb)
			end 'val'
		end 'oth'
		return id
	end 'tr'
	return parseCond(p)
end 'parseExpr'
