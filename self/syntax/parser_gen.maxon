	let v3 = try p.next()
	let v4 = p.textRef(v3)
	ast.setClosureParamNameRef(p.tree, id: n, ref: v4)
	if p.inSet(lookahead12) 'b4'
		let v5 = try parseTypeRef(p)
		ast.setClosureParamType(p.tree, id: n, value: v5)
	end 'b4'
	return n
end 'parseClosureParam'

function parseClosureBody(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newReturnStmt(p.tree, start: t)
	let v1 = try parseExpr(p)
	ast.setReturnStmtValue(p.tree, id: n, value: v1)
	return n
end 'parseClosureBody'
