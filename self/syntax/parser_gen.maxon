	let v9 = try p.expect(TokenKind.label, what: "a label")
	let v10 = p.textRef(v9)
	ast.setWhenStmtLabelRef(p.tree, id: n, ref: v10)
	let v11 = try parseBlock(p)
	ast.setWhenStmtBodyRef(p.tree, id: n, ref: v11)
	_ = try p.expect(TokenKind.kw_end, what: "'end'")
	if p.at(TokenKind.label) 'b3'
		let v12 = try parseEndLabel(p)
		ast.setWhenStmtEnd(p.tree, id: n, value: v12)
	end 'b3'
	let v13 = takeIDs(p.tree, stack: p.lists.ids_WhenStmt_Cowns, mark: mark_n_Cowns)
	ast.setWhenStmtCownsRef(p.tree, id: n, ref: v13)
	let v14 = takeIDs(p.tree, stack: p.lists.ids_WhenStmt_Names, mark: mark_n_Names)
	ast.setWhenStmtNamesRef(p.tree, id: n, ref: v14)
	return n
end 'parseWhenStmt'

function parseMatchCore(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newMatchCore(p.tree, start: t)
	let mark_n_Arms = p.lists.ids_MatchCore_Arms.mark()
	_ = try p.expect(TokenKind.kw_match, what: "'match'")
	if p.at(TokenKind.kw_consumes) 'b1'
		_ = try p.expect(TokenKind.kw_consumes, what: "'consumes'")
		ast.setMatchCoreConsumes(p.tree, id: n)
	end 'b1'
	let v1 = try parseExpr(p)
	ast.setMatchCoreSubject(p.tree, id: n, value: v1)
	let v2 = try p.expect(TokenKind.label, what: "a label")
	let v3 = p.textRef(v2)
	ast.setMatchCoreLabelRef(p.tree, id: n, ref: v3)
	_ = try p.expect(TokenKind.newline, what: "the end of the line")
	if p.at(TokenKind.indent) 'b2'
		_ = try p.expect(TokenKind.indent, what: "an indented line")
		let v4 = try parseMatchArm(p)
		let v5 = v4 as diag.U32
		p.lists.ids_MatchCore_Arms.push(v5)
		_ = try p.expect(TokenKind.newline, what: "the end of the line")
		while p.inSet(lookahead26) 'b3'
			let v6 = try parseMatchArm(p)
			let v7 = v6 as diag.U32
			p.lists.ids_MatchCore_Arms.push(v7)
			_ = try p.expect(TokenKind.newline, what: "the end of the line")
		end 'b3'
		_ = try p.expect(TokenKind.dedent, what: "the end of the indented lines")
	end 'b2'
	_ = try p.expect(TokenKind.kw_end, what: "'end'")
	if p.at(TokenKind.label) and p.peekIn(lookahead22) 'b4'
		let v8 = try parseEndLabel(p)
		ast.setMatchCoreEnd(p.tree, id: n, value: v8)
	end 'b4'
	let v9 = takeIDs(p.tree, stack: p.lists.ids_MatchCore_Arms, mark: mark_n_Arms)
	ast.setMatchCoreArmsRef(p.tree, id: n, ref: v9)
	return n
end 'parseMatchCore'

function parseMatchArm(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newMatchArm(p.tree, start: t)
	let mark_n_Patterns = p.lists.ids_MatchArm_Patterns.mark()
	if p.at(TokenKind.kw_default) 'b1'
		_ = try p.expect(TokenKind.kw_default, what: "'default'")
		ast.setMatchArmIsDefault(p.tree, id: n)
	end 'b1' else if p.inSet(lookahead27) 'b2'
		let v1 = try parsePattern(p)
		let v2 = v1 as diag.U32
		p.lists.ids_MatchArm_Patterns.push(v2)
		while p.at(TokenKind.kw_or) 'b3'
			_ = try p.expect(TokenKind.kw_or, what: "'or'")
			_ = try p.expect(TokenKind.newline, what: "the end of the line")
			let v3 = try parsePattern(p)
			let v4 = v3 as diag.U32
			p.lists.ids_MatchArm_Patterns.push(v4)
		end 'b3'
	end 'b2' else 'b4'
		throw p.expected("an integer, 'default', 'false', 'true', '-', a name or a string")
	end 'b4'
	if p.at(TokenKind.kw_then) 'b5'
		_ = try p.expect(TokenKind.kw_then, what: "'then'")
		let v5 = try parseStmt(p)
		ast.setMatchArmAction(p.tree, id: n, value: v5)
	end 'b5' else if p.at(TokenKind.kw_gives) 'b6'
		_ = try p.expect(TokenKind.kw_gives, what: "'gives'")
		ast.setMatchArmGives(p.tree, id: n)
		let v6 = try parseExpr(p)
		ast.setMatchArmValue(p.tree, id: n, value: v6)
	end 'b6' else if p.at(TokenKind.kw_panic) 'b7'
		let v7 = try parsePanicExpr(p)
		ast.setMatchArmValue(p.tree, id: n, value: v7)
	end 'b7' else 'b8'
		throw p.expected("'gives', 'panic' or 'then'")
	end 'b8'
	let v8 = takeIDs(p.tree, stack: p.lists.ids_MatchArm_Patterns, mark: mark_n_Patterns)
	ast.setMatchArmPatternsRef(p.tree, id: n, ref: v8)
	return n
end 'parseMatchArm'

function parsePattern(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newPattern(p.tree, start: t)
	let mark_n_Bindings = p.lists.ids_Pattern_Bindings.mark()
	if p.inSet(lookahead4) 'b1'
		if not p.inSet(lookahead4) 'b2'
			throw p.expected("a name")
		end 'b2'
		let v1 = try p.next()
		let v2 = p.textRef(v1)
		ast.setPatternCaseNameRef(p.tree, id: n, ref: v2)
		if p.at(TokenKind.lParen) 'b3'
			p.joinNext = true
			_ = try p.expect(TokenKind.lParen, what: "'('")
			ast.setPatternHasBindings(p.tree, id: n)
			if p.inSet(lookahead20) 'b4'
				if not p.inSet(lookahead20) 'b5'
					throw p.expected("'_' or a name")
				end 'b5'
				let v3 = try p.next()
				let v4 = p.textRef(v3)
				p.lists.ids_Pattern_Bindings.push(v4)
				while p.at(TokenKind.comma) 'b6'
					_ = try p.expect(TokenKind.comma, what: "','")
					if not p.inSet(lookahead20) 'b7'
						throw p.expected("'_' or a name")
					end 'b7'
					let v5 = try p.next()
					let v6 = p.textRef(v5)
					p.lists.ids_Pattern_Bindings.push(v6)
				end 'b6'
			end 'b4'
			_ = try p.expect(TokenKind.rParen, what: "')'")
		end 'b3'
	end 'b1' else if p.inSet(lookahead28) 'b8'
		let v7 = try parsePatternValue(p)
		ast.setPatternValue(p.tree, id: n, value: v7)
		if p.inSet(lookahead21) 'b9'
			if p.at(TokenKind.kw_to) 'b10'
				_ = try p.expect(TokenKind.kw_to, what: "'to'")
				ast.setPatternInclusive(p.tree, id: n)
			end 'b10' else if p.at(TokenKind.kw_upto) 'b11'
				_ = try p.expect(TokenKind.kw_upto, what: "'upto'")
			end 'b11' else 'b12'
				throw p.expected("'to' or 'upto'")
			end 'b12'
			let v8 = try parsePatternValue(p)
			ast.setPatternHigh(p.tree, id: n, value: v8)
		end 'b9'
	end 'b8' else 'b13'
		throw p.expected("a pattern")
	end 'b13'
	let v9 = takeIDs(p.tree, stack: p.lists.ids_Pattern_Bindings, mark: mark_n_Bindings)
	ast.setPatternBindingsRef(p.tree, id: n, ref: v9)
	return n
end 'parsePattern'

function parsePatternValue(mutates p Parser) returns ast.NodeID throws SyntaxError
	var value = 0 as ast.NodeID
	if p.inSet(lookahead29) 'b1'
		let v1 = try parseIntLit(p)
		value = v1
	end 'b1' else if p.at(TokenKind.string) 'b2'
		let v2 = try parseStrLit(p)
		value = v2
	end 'b2' else if p.inSet(lookahead30) 'b3'
		let v3 = try parseBoolLit(p)
		value = v3
	end 'b3' else 'b4'
		throw p.expected("a literal pattern")
	end 'b4'
	return value
end 'parsePatternValue'

function parseExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	return try parseExprPrec(p, minPrec: 0)
end 'parseExpr'

function parseExprPrec(mutates p Parser, minPrec Count) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	var left = 0 as ast.NodeID
	if p.at(TokenKind.integer) or (p.at(TokenKind.minus) and p.peekIs(TokenKind.integer)) 'b1'
		let v1 = try parseIntLit(p)
		left = v1
	end 'b1' else if p.at(TokenKind.string) 'b2'
		let v2 = try parseStrLit(p)
		left = v2
	end 'b2' else if p.at(TokenKind.byteString) 'b3'
		let v3 = try parseByteStrLit(p)
		left = v3
	end 'b3' else if p.inSet(lookahead30) 'b4'
		let v4 = try parseBoolLit(p)
		left = v4
	end 'b4' else if (p.at(TokenKind.kw_Self) and p.peekIs(TokenKind.lBrace)) or (p.at(TokenKind.name) and p.peekIs(TokenKind.lBrace)) 'b5'
		let v5 = try parseStructLitExpr(p)
		left = v5
	end 'b5' else if p.at(TokenKind.lBracket) 'b6'
		let v6 = try parseCollectionLitExpr(p)
		left = v6
	end 'b6' else if p.at(TokenKind.kw_self) 'b7'
		let v7 = try parseSelfExpr(p)
		left = v7
	end 'b7' else if p.inSet(lookahead31) 'b8'
		let v8 = try parseNameExpr(p)
		left = v8
	end 'b8' else if p.at(TokenKind.kw_panic) 'b9'
		let v9 = try parsePanicExpr(p)
		left = v9
	end 'b9' else if p.at(TokenKind.kw_match) 'b10'
		let v10 = try parseMatchExpr(p)
		left = v10
	end 'b10' else if p.at(TokenKind.kw_function) 'b11'
		let v11 = try parseClosureExpr(p)
		left = v11
	end 'b11' else if p.at(TokenKind.lParen) 'b12'
		_ = try p.expect(TokenKind.lParen, what: "'('")
		let v12 = try parseExpr(p)
		left = v12
		_ = try p.expect(TokenKind.rParen, what: "')'")
	end 'b12' else if p.inSet(lookahead32) 'b13'
		let n = ast.newUnaryExpr(p.tree, start: t)
		if not p.inSet(lookahead32) 'b14'
			throw p.expected("'not' or '-'")
		end 'b14'
		let joins13 = p.at(TokenKind.minus)
		let v14 = try p.next()
		let v15 = p.text(v14)
		ast.setUnaryExprOp(p.tree, id: n, text: v15)
		p.joinNext = p.joinNext or joins13
		let v16 = try parseExprPrec(p, minPrec: 10)
		ast.setUnaryExprE(p.tree, id: n, value: v16)
		left = n
	end 'b13' else if p.at(TokenKind.kw_try) 'b15'
		let n = ast.newTryExpr(p.tree, start: t)
		_ = try p.expect(TokenKind.kw_try, what: "'try'")
		let v17 = try parseExpr(p)
		ast.setTryExprE(p.tree, id: n, value: v17)
		if p.at(TokenKind.kw_otherwise) and p.peekIn(lookahead33) 'b16'
			_ = try p.expect(TokenKind.kw_otherwise, what: "'otherwise'")
			if p.at(TokenKind.kw_ignore) 'b17'
				_ = try p.expect(TokenKind.kw_ignore, what: "'ignore'")
				ast.setTryExprIgnore(p.tree, id: n)
			end 'b17' else if p.inSet(lookahead19) 'b18'
				let v18 = try parseExpr(p)
				ast.setTryExprValue(p.tree, id: n, value: v18)
				if p.at(TokenKind.label) and p.peekIs(TokenKind.newline) and p.atHandlerBinding() 'b19'
					let v19 = try parseHandlerBlock(p)
					ast.setTryExprHandler(p.tree, id: n, value: v19)
				end 'b19'
			end 'b18' else if p.at(TokenKind.label) 'b20'
				let v20 = try parseHandlerBlock(p)
				ast.setTryExprHandler(p.tree, id: n, value: v20)
			end 'b20' else if p.at(TokenKind.kw_return) 'b21'
				let v21 = try parseReturnStmt(p)
				ast.setTryExprRet(p.tree, id: n, value: v21)
			end 'b21' else if p.at(TokenKind.kw_break) 'b22'
				let v22 = try parseBreakStmt(p)
				ast.setTryExprBrk(p.tree, id: n, value: v22)
			end 'b22' else if p.at(TokenKind.kw_continue) 'b23'
				let v23 = try parseContinueStmt(p)
				ast.setTryExprCont(p.tree, id: n, value: v23)
			end 'b23' else if p.at(TokenKind.kw_throw) 'b24'
				let v24 = try parseThrowStmt(p)
				ast.setTryExprThr(p.tree, id: n, value: v24)
			end 'b24' else 'b25'
				throw p.expected("a byte string, an integer, 'Self', 'break', 'continue', 'export', 'false', 'function', 'ignore', 'match', 'not', 'panic', 'return', 'self', 'throw', 'true', 'try', '[', '(', a label, '-', a name or a string")
			end 'b25'
		end 'b16'
		left = n
	end 'b15' else 'b26'
		throw p.expected("an expression")
	end 'b26'
	while p.inSet(lookahead34) 'b27'
		if p.at(TokenKind.dot) 'b28'
			if 14 < minPrec 'b29'
				return left
			end 'b29'
			let v25 = p.curStart()
			let n = ast.newMemberExpr(p.tree, start: v25)
			ast.setMemberExprObj(p.tree, id: n, value: left)
			_ = try p.expect(TokenKind.dot, what: "'.'")
			if not p.inSet(lookahead4) 'b30'
				throw p.expected("a name")
			end 'b30'
			let v26 = try p.next()
			let v27 = p.textRef(v26)
			ast.setMemberExprNameRef(p.tree, id: n, ref: v27)
			left = n
		end 'b28' else if p.at(TokenKind.lBracket) 'b31'
			if 13 < minPrec 'b32'
				return left
			end 'b32'
			let v28 = p.curStart()
			let n = ast.newIndexExpr(p.tree, start: v28)
			let mark_n_Args = p.lists.ids_IndexExpr_Args.mark()
			ast.setIndexExprObj(p.tree, id: n, value: left)
			p.joinNext = true
			_ = try p.expect(TokenKind.lBracket, what: "'['")
			let v29 = try parseExpr(p)
			let v30 = v29 as diag.U32
			p.lists.ids_IndexExpr_Args.push(v30)
			while p.at(TokenKind.comma) 'b33'
				_ = try p.expect(TokenKind.comma, what: "','")
				let v31 = try parseExpr(p)
				let v32 = v31 as diag.U32
				p.lists.ids_IndexExpr_Args.push(v32)
			end 'b33'
			_ = try p.expect(TokenKind.rBracket, what: "']'")
			let v33 = takeIDs(p.tree, stack: p.lists.ids_IndexExpr_Args, mark: mark_n_Args)
			ast.setIndexExprArgsRef(p.tree, id: n, ref: v33)
			left = n
		end 'b31' else if p.at(TokenKind.lParen) 'b34'
			if 12 < minPrec 'b35'
				return left
			end 'b35'
			let v34 = p.curStart()
			let n = ast.newCallExpr(p.tree, start: v34)
			let mark_n_Args = p.lists.ids_CallExpr_Args.mark()
			ast.setCallExprCallee(p.tree, id: n, value: left)
			p.joinNext = true
			_ = try p.expect(TokenKind.lParen, what: "'('")
			if p.inSet(lookahead35) 'b36'
				let v35 = try parseArg(p)
				let v36 = v35 as diag.U32
				p.lists.ids_CallExpr_Args.push(v36)
				while p.at(TokenKind.comma) 'b37'
					_ = try p.expect(TokenKind.comma, what: "','")
					let v37 = try parseArg(p)
					let v38 = v37 as diag.U32
					p.lists.ids_CallExpr_Args.push(v38)
				end 'b37'
			end 'b36'
			_ = try p.expect(TokenKind.rParen, what: "')'")
			let v39 = takeIDs(p.tree, stack: p.lists.ids_CallExpr_Args, mark: mark_n_Args)
			ast.setCallExprArgsRef(p.tree, id: n, ref: v39)
			left = n
		end 'b34' else if p.at(TokenKind.kw_from) 'b38'
			if 11 < minPrec 'b39'
				return left
			end 'b39'
			let v40 = p.curStart()
			let n = ast.newFromExpr(p.tree, start: v40)
			ast.setFromExprHead(p.tree, id: n, value: left)
			_ = try p.expect(TokenKind.kw_from, what: "'from'")
			let v41 = try parseExprPrec(p, minPrec: 12)
			ast.setFromExprValue(p.tree, id: n, value: v41)
			left = n
		end 'b38' else if p.at(TokenKind.kw_as) 'b40'
			if 9 < minPrec 'b41'
				return left
			end 'b41'
			let v42 = p.curStart()
			let n = ast.newCastExpr(p.tree, start: v42)
			ast.setCastExprE(p.tree, id: n, value: left)
			_ = try p.expect(TokenKind.kw_as, what: "'as'")
			let v43 = try parseTypeRef(p)
			ast.setCastExprTarget(p.tree, id: n, value: v43)
			left = n
		end 'b40' else if p.inSet(lookahead36) 'b42'
			if 8 < minPrec 'b43'
				return left
			end 'b43'
			let v44 = p.curStart()
			let n = ast.newBinaryExpr(p.tree, start: v44)
			ast.setBinaryExprL(p.tree, id: n, value: left)
			if not p.inSet(lookahead36) 'b44'
				throw p.expected("'mod', '/' or '*'")
			end 'b44'
			let v45 = try p.next()
			let v46 = p.text(v45)
			ast.setBinaryExprOp(p.tree, id: n, text: v46)
			let v47 = try parseExprPrec(p, minPrec: 9)
			ast.setBinaryExprR(p.tree, id: n, value: v47)
			left = n
		end 'b42' else if p.inSet(lookahead37) 'b45'
			if 7 < minPrec 'b46'
				return left
			end 'b46'
			let v48 = p.curStart()
			let n = ast.newBinaryExpr(p.tree, start: v48)
			ast.setBinaryExprL(p.tree, id: n, value: left)
			if not p.inSet(lookahead37) 'b47'
				throw p.expected("'-' or '+'")
			end 'b47'
			let v49 = try p.next()
			let v50 = p.text(v49)
			ast.setBinaryExprOp(p.tree, id: n, text: v50)
			let v51 = try parseExprPrec(p, minPrec: 8)
			ast.setBinaryExprR(p.tree, id: n, value: v51)
			left = n
		end 'b45' else if p.inSet(lookahead38) 'b48'
			if 6 < minPrec 'b49'
				return left
			end 'b49'
			let v52 = p.curStart()
			let n = ast.newBinaryExpr(p.tree, start: v52)
			ast.setBinaryExprL(p.tree, id: n, value: left)
			if not p.inSet(lookahead38) 'b50'
				throw p.expected("'shl' or 'shr'")
			end 'b50'
			let v53 = try p.next()
			let v54 = p.text(v53)
			ast.setBinaryExprOp(p.tree, id: n, text: v54)
			let v55 = try parseExprPrec(p, minPrec: 7)
			ast.setBinaryExprR(p.tree, id: n, value: v55)
			left = n
		end 'b48' else if p.inSet(lookahead39) 'b51'
			if 5 < minPrec 'b52'
				return left
			end 'b52'
			let v56 = p.curStart()
			let n = ast.newBinaryExpr(p.tree, start: v56)
			ast.setBinaryExprL(p.tree, id: n, value: left)
			if not p.inSet(lookahead39) 'b53'
				throw p.expected("'==', '>=', '>', '<=', '<' or '!='")
			end 'b53'
			let v57 = try p.next()
			let v58 = p.text(v57)
			ast.setBinaryExprOp(p.tree, id: n, text: v58)
			let v59 = try parseExprPrec(p, minPrec: 6)
			ast.setBinaryExprR(p.tree, id: n, value: v59)
			left = n
		end 'b51' else if p.at(TokenKind.kw_and) 'b54'
			if 4 < minPrec 'b55'
				return left
			end 'b55'
			let v60 = p.curStart()
			let n = ast.newBinaryExpr(p.tree, start: v60)
			ast.setBinaryExprL(p.tree, id: n, value: left)
			let v61 = try p.expect(TokenKind.kw_and, what: "'and'")
			let v62 = p.text(v61)
			ast.setBinaryExprOp(p.tree, id: n, text: v62)
			let v63 = try parseExprPrec(p, minPrec: 5)
			ast.setBinaryExprR(p.tree, id: n, value: v63)
			left = n
		end 'b54' else if p.at(TokenKind.kw_xor) 'b56'
			if 3 < minPrec 'b57'
				return left
			end 'b57'
			let v64 = p.curStart()
			let n = ast.newBinaryExpr(p.tree, start: v64)
			ast.setBinaryExprL(p.tree, id: n, value: left)
			let v65 = try p.expect(TokenKind.kw_xor, what: "'xor'")
			let v66 = p.text(v65)
			ast.setBinaryExprOp(p.tree, id: n, text: v66)
			let v67 = try parseExprPrec(p, minPrec: 4)
			ast.setBinaryExprR(p.tree, id: n, value: v67)
			left = n
		end 'b56' else if p.at(TokenKind.kw_or) 'b58'
			if 2 < minPrec 'b59'
				return left
			end 'b59'
			let v68 = p.curStart()
			let n = ast.newBinaryExpr(p.tree, start: v68)
			ast.setBinaryExprL(p.tree, id: n, value: left)
			let v69 = try p.expect(TokenKind.kw_or, what: "'or'")
			let v70 = p.text(v69)
			ast.setBinaryExprOp(p.tree, id: n, text: v70)
			let v71 = try parseExprPrec(p, minPrec: 3)
			ast.setBinaryExprR(p.tree, id: n, value: v71)
			left = n
		end 'b58' else if p.at(TokenKind.kw_if) 'b60'
			if 1 < minPrec 'b61'
				return left
			end 'b61'
			let v72 = p.curStart()
			let n = ast.newCondExpr(p.tree, start: v72)
			ast.setCondExprThen(p.tree, id: n, value: left)
			_ = try p.expect(TokenKind.kw_if, what: "'if'")
			let v73 = try parseExpr(p)
			ast.setCondExprCond(p.tree, id: n, value: v73)
