	_ = try p.expect(TokenKind.colon, what: "':'")
	let v3 = try parseExpr(p)
	ast.setStructFieldValue(p.tree, id: n, value: v3)
	return n
end 'parseStructField'

function parseCollectionLitExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newCollectionLitExpr(p.tree, start: t)
	let mark_n_Elems = p.lists.ids_CollectionLitExpr_Elems.mark()
	let mark_n_Values = p.lists.ids_CollectionLitExpr_Values.mark()
	_ = try p.expect(TokenKind.lBracket, what: "'['")
	if p.inSet(lookahead19) 'b1'
		let v1 = try parseExpr(p)
		let v2 = v1 as diag.U32
		p.lists.ids_CollectionLitExpr_Elems.push(v2)
		if p.at(TokenKind.colon) 'b2'
			_ = try p.expect(TokenKind.colon, what: "':'")
			let v3 = try parseExpr(p)
			let v4 = v3 as diag.U32
			p.lists.ids_CollectionLitExpr_Values.push(v4)
			while p.at(TokenKind.comma) 'b3'
				_ = try p.expect(TokenKind.comma, what: "','")
				let v5 = try parseExpr(p)
				let v6 = v5 as diag.U32
				p.lists.ids_CollectionLitExpr_Elems.push(v6)
				_ = try p.expect(TokenKind.colon, what: "':'")
				let v7 = try parseExpr(p)
				let v8 = v7 as diag.U32
				p.lists.ids_CollectionLitExpr_Values.push(v8)
			end 'b3'
		end 'b2' else if p.inSet(lookahead40) 'b4'
			while p.at(TokenKind.comma) 'b5'
				_ = try p.expect(TokenKind.comma, what: "','")
				let v9 = try parseExpr(p)
				let v10 = v9 as diag.U32
				p.lists.ids_CollectionLitExpr_Elems.push(v10)
			end 'b5'
		end 'b4' else 'b6'
			throw p.expected("':', ',' or ']'")
		end 'b6'
	end 'b1'
	_ = try p.expect(TokenKind.rBracket, what: "']'")
	let v11 = takeIDs(p.tree, stack: p.lists.ids_CollectionLitExpr_Elems, mark: mark_n_Elems)
	ast.setCollectionLitExprElemsRef(p.tree, id: n, ref: v11)
	let v12 = takeIDs(p.tree, stack: p.lists.ids_CollectionLitExpr_Values, mark: mark_n_Values)
	ast.setCollectionLitExprValuesRef(p.tree, id: n, ref: v12)
