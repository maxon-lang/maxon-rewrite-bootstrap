function parseStructLitExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newStructLitExpr(p.tree, start: t)
	let mark_n_Fields = p.lists.ids_StructLitExpr_Fields.mark()
	if not p.inSet(lookahead15) 'b1'
		throw p.expected("'Self' or a name")
	end 'b1'
	let v1 = try p.next()
	let v2 = p.textRef(v1)
	ast.setStructLitExprTypeNameRef(p.tree, id: n, ref: v2)
	_ = try p.expect(TokenKind.lBrace, what: "'\{'")
	if p.inSet(lookahead4) 'b2'
		let v3 = try parseStructField(p)
		let v4 = v3 as diag.U32
		p.lists.ids_StructLitExpr_Fields.push(v4)
		while p.at(TokenKind.comma) 'b3'
			_ = try p.expect(TokenKind.comma, what: "','")
			let v5 = try parseStructField(p)
			let v6 = v5 as diag.U32
			p.lists.ids_StructLitExpr_Fields.push(v6)
		end 'b3'
	end 'b2'
	_ = try p.expect(TokenKind.rBrace, what: "'\}'")
	let v7 = takeIDs(p.tree, stack: p.lists.ids_StructLitExpr_Fields, mark: mark_n_Fields)
	ast.setStructLitExprFieldsRef(p.tree, id: n, ref: v7)
	return n
end 'parseStructLitExpr'

function parseStructField(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
