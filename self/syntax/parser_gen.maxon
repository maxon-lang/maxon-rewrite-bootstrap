function parseSpawnExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newSpawnExpr(p.tree, start: t)
	let v1 = try p.expect(TokenKind.name, what: "a name")
	let v2 = p.textRef(v1)
	ast.setSpawnExprSpawnRef(p.tree, id: n, ref: v2)
	let v3 = try parseExpr(p)
	ast.setSpawnExprCall(p.tree, id: n, value: v3)
	return n
end 'parseSpawnExpr'

function parsePanicExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newPanicExpr(p.tree, start: t)
	try p.pass(TokenKind.kw_panic, what: "'panic'")
	p.joinNext = true
	try p.pass(TokenKind.lParen, what: "'('")
	let v1 = try parseStrLit(p)
	ast.setPanicExprMessage(p.tree, id: n, value: v1)
	try p.pass(TokenKind.rParen, what: "')'")
	return n
end 'parsePanicExpr'

function parseMatchExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newMatchExpr(p.tree, start: t)
	let v1 = try parseMatchCore(p)
	ast.setMatchExprMatch(p.tree, id: n, value: v1)
	return n
end 'parseMatchExpr'

function parseTypeQueryExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newTypeQueryExpr(p.tree, start: t)
	if not p.inSet(lookahead49) 'b1'
		throw p.expected("'countof' or 'sizeof'")
	end 'b1'
	let v1 = try p.next()
	let v2 = p.text(v1)
	ast.setTypeQueryExprOp(p.tree, id: n, text: v2)
	p.joinNext = true
	try p.pass(TokenKind.lParen, what: "'('")
	let v3 = try parseTypeRef(p)
	ast.setTypeQueryExprType(p.tree, id: n, value: v3)
	try p.pass(TokenKind.rParen, what: "')'")
	return n
end 'parseTypeQueryExpr'

function parseClosureExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newClosureExpr(p.tree, start: t)
	let mark_n_Params = p.lists.ids_ClosureExpr_Params.mark()
	let mark_n_Body = p.lists.ids_ClosureExpr_Body.mark()
	try p.pass(TokenKind.kw_function, what: "'function'")
	p.joinNext = true
	try p.pass(TokenKind.lParen, what: "'('")
	if p.inSet(lookahead62) 'b1'
		let v1 = try parseClosureParam(p)
		let v2 = v1 as diag.U32
		p.lists.ids_ClosureExpr_Params.push(v2)
		while p.at(TokenKind.comma) 'b2'
			try p.pass(TokenKind.comma, what: "','")
			let v3 = try parseClosureParam(p)
			let v4 = v3 as diag.U32
			p.lists.ids_ClosureExpr_Params.push(v4)
		end 'b2'
	end 'b1'
	try p.pass(TokenKind.rParen, what: "')'")
	if p.at(TokenKind.kw_returns) 'b3'
		try p.pass(TokenKind.kw_returns, what: "'returns'")
		let v5 = try parseTypeRef(p)
		ast.setClosureExprReturns(p.tree, id: n, value: v5)
	end 'b3'
	try p.pass(TokenKind.kw_gives, what: "'gives'")
	let v6 = try parseClosureBody(p)
	let v7 = v6 as diag.U32
	p.lists.ids_ClosureExpr_Body.push(v7)
	let v8 = takeIDs(p.tree, stack: p.lists.ids_ClosureExpr_Params, mark: mark_n_Params)
	ast.setClosureExprParamsRef(p.tree, id: n, ref: v8)
	let v9 = takeIDs(p.tree, stack: p.lists.ids_ClosureExpr_Body, mark: mark_n_Body)
	ast.setClosureExprBodyRef(p.tree, id: n, ref: v9)
	return n
end 'parseClosureExpr'

function parseClosureParam(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newClosureParam(p.tree, start: t)
	if p.inSet(lookahead10) 'b1'
		if not p.inSet(lookahead10) 'b2'
			throw p.expected("'consumes', 'mutates' or 'sets'")
		end 'b2'
		let v1 = try p.next()
		let v2 = p.text(v1)
		ast.setClosureParamConvention(p.tree, id: n, text: v2)
	end 'b1'
	if not p.inSet(lookahead37) 'b3'
		throw p.expected("'_' or a name")
	end 'b3'
	let v3 = try p.next()
	try p.declares(v3)
	let v4 = p.textRef(v3)
	ast.setClosureParamNameRef(p.tree, id: n, ref: v4)
	if p.inSet(lookahead9) 'b4'
		let v5 = try parseTypeRef(p)
		ast.setClosureParamType(p.tree, id: n, value: v5)
	end 'b4'
	return n
end 'parseClosureParam'

function parseClosureBody(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newReturnStmt(p.tree, start: t)
	let v1 = try parseExpr(p)
	ast.setReturnStmtValue(p.tree, id: n, value: v1)
	return n
end 'parseClosureBody'
