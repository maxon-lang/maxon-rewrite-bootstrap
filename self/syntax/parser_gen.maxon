	let v1 = try p.expect(TokenKind.integer, what: "an integer")
	let v2 = try intLitMagnitude(p, t: v1)
	ast.setIntLitMagnitude(p.tree, id: n, value: v2)
	return n
end 'parseIntLit'

function parseFloatLit(mutates p Parser) returns ast.NodeID throws SyntaxError
