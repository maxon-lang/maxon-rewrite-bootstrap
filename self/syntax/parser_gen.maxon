function parseArg(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newArg(p.tree, start: t)
	if p.inSet(lookahead41) or (p.at(TokenKind.kw_Self) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_export) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_false) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_from) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_function) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_match) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_not) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_panic) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_self) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_true) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.kw_try) and p.peekIs(TokenKind.colon)) or (p.at(TokenKind.name) and p.peekIs(TokenKind.colon)) 'b1'
		if not p.inSet(lookahead5) 'b2'
			throw p.expected("a name")
		end 'b2'
		let v1 = try p.next()
		let v2 = p.textRef(v1)
		ast.setArgLabelRef(p.tree, id: n, ref: v2)
		_ = try p.expect(TokenKind.colon, what: "':'")
	end 'b1'
	let v3 = try parseExpr(p)
	ast.setArgValue(p.tree, id: n, value: v3)
	return n
end 'parseArg'

function parsePanicExpr(mutates p Parser) returns ast.NodeID throws SyntaxError
	let t = p.curStart()
	let n = ast.newPanicExpr(p.tree, start: t)
	_ = try p.expect(TokenKind.kw_panic, what: "'panic'")
	p.joinNext = true
	_ = try p.expect(TokenKind.lParen, what: "'('")
	let v1 = try parseStrLit(p)
	ast.setPanicExprMessage(p.tree, id: n, value: v1)
	_ = try p.expect(TokenKind.rParen, what: "')'")
	return n
