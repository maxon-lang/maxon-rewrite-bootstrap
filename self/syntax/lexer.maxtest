function assertKind(tokens Tokens, index Count, expected TokenKind, label String)
	if index >= tokens.count() 'oob'
		panic("{label}: expected token at {index}, only {tokens.count()} tokens")
	end 'oob'
	let got = tokens[index].kind
	if got != expected 'mismatch'
		panic("{label}: token {index} expected {expected.name}, got {got.name}")
	end 'mismatch'
end 'assertKind'

function assertText(tokens Tokens, src String, index Count, expected String, label String)
	let got = tokens[index].text(src)
	if got != expected 'mismatch'
		panic("{label}: token {index} expected '{expected}', got '{got}'")
	end 'mismatch'
end 'assertText'

function expectOk(src String, label String) returns Tokens
	return match consumes lex(src) 'res'
		ok(tokens) gives tokens
		err(e) panic("{label}: unexpected lex error {e.format()}")
	end 'res'
end 'expectOk'

function expectError(src String, expectedMessage String, label String)
	match lex(src) 'res'
		ok(_) then panic("{label}: expected error '{expectedMessage}', but lexing succeeded")
		err(e) then checkErrorMessage(e.message, expected: expectedMessage, label: label)
	end 'res'
end 'expectError'

function checkErrorMessage(got String, expected String, label String)
	if got != expected 'mismatch'
		panic("{label}: expected error '{expected}', got '{got}'")
	end 'mismatch'
end 'checkErrorMessage'

test 'program'
	let src = "// greeting\nfunction main() returns ExitCode\n\tlet x = 42 // answer\n\treturn x\nend 'main'\n"
	let toks = expectOk(src, label: "program")
	assertKind(toks, index: 0, expected: TokenKind.kw_function, label: "program")
	assertKind(toks, index: 1, expected: TokenKind.name, label: "program")
	assertText(toks, src: src, index: 1, expected: "main", label: "program")
	assertKind(toks, index: 2, expected: TokenKind.lParen, label: "program")
	assertKind(toks, index: 3, expected: TokenKind.rParen, label: "program")
	assertKind(toks, index: 4, expected: TokenKind.kw_returns, label: "program")
	assertKind(toks, index: 5, expected: TokenKind.name, label: "program")
	assertKind(toks, index: 6, expected: TokenKind.newline, label: "program")
	assertKind(toks, index: 7, expected: TokenKind.indent, label: "program")
	assertKind(toks, index: 8, expected: TokenKind.kw_let, label: "program")
	assertKind(toks, index: 9, expected: TokenKind.name, label: "program")
	assertKind(toks, index: 10, expected: TokenKind.assign, label: "program")
	assertKind(toks, index: 11, expected: TokenKind.integer, label: "program")
	assertText(toks, src: src, index: 11, expected: "42", label: "program")
	assertKind(toks, index: 12, expected: TokenKind.newline, label: "program")
	assertKind(toks, index: 13, expected: TokenKind.kw_return, label: "program")
	assertKind(toks, index: 14, expected: TokenKind.name, label: "program")
	assertKind(toks, index: 15, expected: TokenKind.newline, label: "program")
	assertKind(toks, index: 16, expected: TokenKind.dedent, label: "program")
	assertKind(toks, index: 17, expected: TokenKind.kw_end, label: "program")
	assertKind(toks, index: 18, expected: TokenKind.label, label: "program")
	assertText(toks, src: src, index: 18, expected: "main", label: "program")
	assertKind(toks, index: 19, expected: TokenKind.newline, label: "program")
	assertKind(toks, index: 20, expected: TokenKind.fileEnd, label: "program")
	assertKind(toks, index: 21, expected: TokenKind.eof, label: "program")
end 'program'

test 'numbers and operators'
	let src = "let a = 1_000 + 0xFF - 0b1010 * 0o77 / 2\nlet b = a == 1 and a != 2 and a <= 3 and a >= 0\n"
	let toks = expectOk(src, label: "numbers")
	assertText(toks, src: src, index: 3, expected: "1_000", label: "numbers")
	assertText(toks, src: src, index: 5, expected: "0xFF", label: "numbers")
	assertText(toks, src: src, index: 7, expected: "0b1010", label: "numbers")
	assertText(toks, src: src, index: 9, expected: "0o77", label: "numbers")
	assertKind(toks, index: 17, expected: TokenKind.eqEq, label: "numbers")
	assertKind(toks, index: 21, expected: TokenKind.notEq, label: "numbers")
	assertKind(toks, index: 25, expected: TokenKind.le, label: "numbers")
	assertKind(toks, index: 29, expected: TokenKind.ge, label: "numbers")
end 'numbers and operators'

test 'strings and interpolation'
	let src = "let s = \"hi \{a + 1\}\\n\\x41\\u0042\"\n"
	let toks = expectOk(src, label: "strings")
	assertKind(toks, index: 3, expected: TokenKind.string, label: "strings")
	let interpText = "a + 1"
	let interpSrc = sourceOf(interpText.clone(), path: "")
	var errs = diag.ErrorList.create(0)
	let interpToks = try lexInterpolation(interpSrc, errs: errs, file: 0, begin: 0, until: interpText.byteLength(), lenient: false) otherwise panic("interp: unexpected lex error")
	assertKind(interpToks, index: 0, expected: TokenKind.name, label: "interp")
	assertKind(interpToks, index: 1, expected: TokenKind.plus, label: "interp")
	assertKind(interpToks, index: 2, expected: TokenKind.integer, label: "interp")
	assertKind(interpToks, index: 3, expected: TokenKind.fileEnd, label: "interp")
end 'strings and interpolation'

test 'errors'
	expectError("let x = 1", expectedMessage: "the file does not end with a newline", label: "noNewline")
	expectError("  let x = 1\n", expectedMessage: "a line is indented with a space; indent with tabs only", label: "spaceIndent")
	expectError("\t\nlet x = 1\n", expectedMessage: "a blank line holds tabs; remove the trailing whitespace", label: "blankTabs")
	expectError("\t// bad\nlet x = 1\n", expectedMessage: "a comment line is indented 1 tabs, but the code line after it 0; indent them alike", label: "commentIndent")
	expectError("let x = /* no */ 1\n", expectedMessage: "a block comment is not allowed; write // comments on their own lines or after code", label: "blockComment")
	expectError("let  x = 1\n", expectedMessage: "tokens are separated by one space, not several", label: "doubleSpace")
	expectError("let x = (\n1)\n", expectedMessage: "a line breaks inside parentheses; keep what they hold on one line", label: "breakInParens")
	expectError("let x = 0x\n", expectedMessage: "incomplete integer", label: "incompleteHex")
	expectError("let s = \"oops\n", expectedMessage: "unterminated string literal", label: "unterminatedStr")
	expectError("let s = \"\{x:04x\"\n", expectedMessage: "unterminated interpolation in string literal", label: "unterminatedFormatSpec")
	expectError("let s = \"\}\"\n", expectedMessage: "a '\}' in a string is written '\\\}'", label: "bareBrace")
end 'errors'

function endsWithMaxon(name String) returns bool
	let suffix = ".maxon"
	let sn = suffix.byteLength()
	let n = name.byteLength()
	if n <= sn 'short'
		return false
	end 'short'
	let start = n - sn
	return name.sliceBytes(start, endPos: n) == suffix
end 'endsWithMaxon'

function parseDirTests(dir String) returns Count
	var count = 0 as Count
	let entries = try Directory.list(try FilePath.from(dir) otherwise panic("invalid path")) otherwise panic("cannot list the directory")
	for i in 0 upto entries.count() 'each'
		let full = entries[i].toString()
		if Directory.isDirectory(entries[i]) 'sub'
			let sub = parseDirTests(full)
			count = try count + sub otherwise count
		end 'sub' else if endsWithMaxon(full) 'src'
			let text = try File.readText(entries[i]) otherwise panic("cannot read the file")
			match parseSource(0 as diag.ModuleID, path: full.clone(), src: text) 'pr'
				ok(m) then count = try count + m.decls.count() otherwise count
				err(e) then panic("parse failed on {full}: {e[0].format()}")
			end 'pr'
		end 'src'
	end 'each'
	return count
end 'parseDirTests'

test 'parser'
	let declCount = parseDirTests("self")
	if declCount < 30 'few'
		panic("expected >= 30 decls across self, got {declCount}")
	end 'few'
	let interpSrc = "function f(x Count) returns String\n\treturn \"a=\{x + 1\}b\\n\"\nend 'f'\n"
	match parseSource(0 as diag.ModuleID, path: "interp.maxon", src: interpSrc) 'ir'
		ok(m) then checkInterpAst(m)
		err(e) then panic("interp parse failed: {e[0].format()}")
	end 'ir'
end 'parser'

function checkInterpAst(m ast.ParsedModule)
	if m.decls.count() != 1 'cnt'
		panic("expected 1 decl in interp test")
	end 'cnt'
end 'checkInterpAst'

function assertEqStr(got String, expected String, label String)
	if got != expected 'neq'
		panic("{label}: expected '{expected}', got '{got}'")
	end 'neq'
end 'assertEqStr'

// functionNameColumn is where the name of a function begins after its keyword, which is where a declaration is located.
let functionNameColumn = 10

test 'positions and diag'
	var paths = ast.StringList.create(0)
	paths.push("a.maxon")
	paths.push("b.maxon")
	var texts = ast.StringList.create(0)
	texts.push("function one()\n\treturn\nend 'one'\n")
	texts.push("function two()\n\tlet x = 1\n\treturn\nend 'two'\n")
	let pr = parseModuleFiles(0 as diag.ModuleID, path: "m", filePaths: paths, fileTexts: texts, target: ast.Target.windowsX64())
	var m as ast.ParsedModule
	match consumes pr 'r'
		ok(modVal) then m = modVal
		err(e) then panic("unexpected parseModuleFiles error: {e[0].format()}")
	end 'r'
	if m.decls.count() != 2 'd2'
		panic("expected 2 decls, got {m.decls.count()}")
	end 'd2'
	let d0Off = m.decls[0].offset(m.tree)
	let d1Off = m.decls[1].offset(m.tree)
	var made = ast.Module.new(0 as diag.ModuleID, path: "m", text: "", files: ast.FileSpanList.create(0))
	made.takeParsed(m)
	let loc0 = ast.locateModuleOffset(made, offset: d0Off)
	let loc1 = ast.locateModuleOffset(made, offset: d1Off)
	assertEqStr(loc0.file, expected: "a.maxon", label: "loc0.file")
	assertEqStr(loc1.file, expected: "b.maxon", label: "loc1.file")
	if loc0.line != 1 or loc0.col != functionNameColumn or loc1.line != 1 or loc1.col != functionNameColumn 'lc'
		panic("unexpected decl locs")
	end 'lc'
	var mods = ast.ModuleList.create(0)
	mods.push(made)
	var errs = diag.ErrorList.create(0)
	diag.pushSiteError(errs, code: "E3001", message: "second", module: 0 as diag.ModuleID, offset: d1Off)
	diag.pushSiteError(errs, code: "E2001", message: "first", module: 0 as diag.ModuleID, offset: d0Off)
	ast.locateAllErrors(mods, errs: errs)
	assertEqStr(errs[0].file, expected: "a.maxon", label: "sort0")
	assertEqStr(errs[1].file, expected: "b.maxon", label: "sort1")
end 'positions and diag'
