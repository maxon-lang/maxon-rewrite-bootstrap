export union ParseResult
	ok(module ast.Module)
	err(errors diag.ErrorList)
end 'ParseResult'

// BlankRule says which blank lines may come before a line: parseProgram sets the rule between declarations, and a
// function inside a declaration has its own.
enum BlankRule
	// noBlanks allows none: the line is inside a declaration.
	noBlanks
	// firstInFile allows blank lines between comment paragraphs, but not before the first line of the file.
	firstInFile
	// afterDecl requires one blank line right after the declaration before, and allows one between comment
	// paragraphs.
	afterDecl
	// beforeFunction is afterDecl for a method or an interface's function that is not the first line of its body: a
	// blank line sets each function apart, as between top-level declarations.
	beforeFunction
end 'BlankRule'

// Gap is what the layout puts before a token.
enum Gap
	// lineStart is the start of a line: only the blank lines and comment lines before it are left to decide.
	lineStart
	// endOfLine is before a newline: nothing, or a comment after the code.
	endOfLine
	// joined joins the token to the one before it.
	joined
	// oneSpace is one space.
	oneSpace
end 'Gap'

// BlankFault is how the blank lines before a line break the rule: a blank line that is not allowed, or one that is
// missing.
enum BlankFault
	noFault
	extraBlank
	missingBlank
end 'BlankFault'

type Fault
	var kind as BlankFault
	var message as String

	static function make(kind BlankFault, consumes message String) returns Fault
		return Fault{kind: kind, message: message}
	end 'make'
end 'Fault'

let blankInBody = "a blank line is only allowed between declarations, and before a function of a type, an enum or a union"

let blankBeforeFunction = "expected a blank line before this function, which is not the first line of its type, enum or union"

let blankAfterDeclaration = "expected a blank line after the declaration above"

// Parser holds what the generated parse functions (parser_gen.maxon) share: the module's source, its token stream, the
// position in it, and the file the parser is in.
type Parser
	var src as Source
	var toks as Tokens
	var tree as ast.Tree
	var lists as ListStacks
	var pos as Count
	var fileIndex as Count
	var errors as diag.ErrorList
	// The layout: where the last token consumed ends and what it was, whether the next token joins it with no space
	// between them, and which blank lines may come before the next line.
	var prevEnd as Count
	var prevKind as TokenKind
	var joinNext as bool
	var blanks as BlankRule
	// format is what a formatting parser writes: where it would refuse a layout, it writes the layout the rules require.
	var format as Formatter
	var formatting as bool

	static function new(consumes src Source, consumes toks Tokens, module diag.ModuleID) returns Parser
		let text = src.text.clone()
		var prevEnd = 0 as Count
		if src.files.count() > 0 'first'
			prevEnd = src.files[0].start as Count
		end 'first'
		return Parser{src: src, toks: toks, tree: ast.Tree.new(module, text: text), lists: ListStacks.new(), pos: 0 as Count, fileIndex: 0 as Count, errors: diag.ErrorList.create(0), prevEnd: prevEnd, prevKind: TokenKind.fileEnd, joinNext: false, blanks: BlankRule.firstInFile, format: Formatter.new(), formatting: false}
	end 'new'

	function fileNumber() returns Count
		let last = try src.files.count() - 1 otherwise 0 as Count
		if fileIndex < last 'within'
			return fileIndex
		end 'within'
		return last
	end 'fileNumber'

	// text is a token's text: a substring of the module's source.
	function text(t Token) returns String
		return src.text.sliceBytes(t.start as Count, endPos: t.endOffset())
	end 'text'

	function cur() returns Token
		return toks[pos].clone()
	end 'cur'

	function curStart() returns diag.U32
		return toks[pos].start
	end 'curStart'

	function peekTok() returns Token
		let last = try toks.count() - 1 otherwise 0 as Count
		var at = try pos + 1 otherwise last
		if at > last 'clamp'
			at = last
		end 'clamp'
		return toks[at].clone()
	end 'peekTok'

	// next consumes the current token, after checking the layout before it.
	function next(mutates self) returns Token throws SyntaxError
		let t = self.cur()
		try self.layout(t)
		return self.skip()
	end 'next'

	// layout checks the gap before t, or in a formatting parser writes the gap the rules require there and then t.
	function layout(mutates self, t Token) throws SyntaxError
		if formatting 'formats'
			try self.formatToken(t)
			return
		end 'formats'
		try self.checkLayout(t)
	end 'layout'

	// formatToken writes the gap the layout puts before t, and then t. It is called where a checking parser calls
	// checkLayout, so the gap comes from the same decisions.
	function formatToken(mutates self, t Token) throws SyntaxError
		let start = lexemeStart(t)
		let gap = self.gapBefore(t.kind)
		if gap == Gap.lineStart 'lines'
			try self.blankLines(start)
			let depth = format.depth
			if t.kind == TokenKind.indent 'indent'
				format.depth = after(depth)
			end 'indent' else if t.kind == TokenKind.dedent 'dedent'
				format.depth = try depth - 1 otherwise panic("the formatter dedents past the margin")
			end 'dedent' else if t.kind != TokenKind.fileEnd and t.kind != TokenKind.eof 'code'
				format.indent(depth)
			end 'code'
		end 'lines' else if gap == Gap.endOfLine 'endOfLine'
			format.trailingComment(src.text, begin: prevEnd, until: start)
		end 'endOfLine' else if gap == Gap.oneSpace 'space'
			format.out.push(byteSpace)
		end 'space'
		format.tokenStart = format.out.count()
		if t.kind == TokenKind.newline 'newline'
			format.out.push(byteNewline)
			return
		end 'newline'
		appendRange(format.out, text: src.text, begin: start, until: lexemeEnd(t))
	end 'formatToken'

	// depthAfterIndentTokens is the indentation of the code line that starts at the current token, which is the first of
	// the indent or dedent tokens that open it, or the line's first token.
	function depthAfterIndentTokens() returns Count
		var depth = format.depth
		var i = pos
		while i < toks.count() 'scan'
			let kind = toks[i].kind
			if kind == TokenKind.indent 'indent'
				depth = after(depth)
			end 'indent' else if kind == TokenKind.dedent 'dedent'
				depth = try depth - 1 otherwise panic("the formatter dedents past the margin")
			end 'dedent' else 'code'
				return depth
			end 'code'
			i = after(i)
		end 'scan'
		return depth
	end 'depthAfterIndentTokens'

	// skip consumes the current token without checking its layout, as error recovery does.
	function skip(mutates self) returns Token
		let t = self.cur()
		if after(pos) < toks.count() 'more'
			pos = after(pos)
		end 'more'
		prevEnd = lexemeEnd(t)
		prevKind = t.kind
		joinNext = inTokenSet(tokenNoSpaceAfter, kind: t.kind)
		return t
	end 'skip'

	function at(k TokenKind) returns bool
		return toks[pos].kind == k
	end 'at'

	function inSet(set String) returns bool
		return inTokenSet(set, kind: toks[pos].kind)
	end 'inSet'

	function peekIs(k TokenKind) returns bool
		return self.peekTok().kind == k
	end 'peekIs'

	function peekIn(set String) returns bool
		return inTokenSet(set, kind: self.peekTok().kind)
	end 'peekIn'

	function atEndOfInput() returns bool
		return self.at(TokenKind.fileEnd) or self.at(TokenKind.eof)
	end 'atEndOfInput'

	// gapBefore is the one place that says what separates a token of kind from the one before it: within a line, none
	// where it, or the token before it, joins its neighbour, and one space otherwise. The checker refuses another gap.
	function gapBefore(kind TokenKind) returns Gap
		if startsLine(prevKind) 'line'
			return Gap.lineStart
		end 'line'
		if kind == TokenKind.newline 'newline'
			return Gap.endOfLine
		end 'newline'
		if joinNext or inTokenSet(tokenNoSpaceBefore, kind: kind) 'joined'
			return Gap.joined
		end 'joined'
		return Gap.oneSpace
	end 'gapBefore'

	// checkLayout checks the space before t. Within a line the lexer has made every gap one space or none; here the
	// grammar decides which. At the start of a line the lexer has checked the indentation, and only the blank lines
	// before it are left to check.
	function checkLayout(mutates self, t Token) throws SyntaxError
		let start = lexemeStart(t)
		let gap = self.gapBefore(t.kind)
		let last = prevEnd
		if gap == Gap.lineStart 'line'
			try self.blankLines(start)
		end 'line' else if gap == Gap.joined 'joined'
			if start > last 'spaced'
				let msg = "expected no space before '{self.describe(t)}'"
				throw self.refuse(msg, at: last)
			end 'spaced'
		end 'joined' else if gap == Gap.oneSpace 'space'
			if start == last 'touching'
				let msg = "expected a space before '{self.describe(t)}'"
				throw self.refuse(msg, at: t.start as Count)
			end 'touching'
		end 'space'
	end 'checkLayout'

	// blankLines checks the blank lines and comment lines between the last line and the one that starts at lineStart,
	// against the rule parseProgram set for it. A formatting parser writes the lines the rule allows instead of refusing
	// the others.
	function blankLines(mutates self, lineStart Count) throws SyntaxError
		var rule = blanks
		blanks = BlankRule.noBlanks
		if rule == BlankRule.noBlanks and prevKind == TokenKind.newline and self.startsFunction() 'function'
			rule = BlankRule.beforeFunction
		end 'function'
		var depth = 0 as Count
		if formatting 'depth'
			depth = self.depthAfterIndentTokens()
		end 'depth'
		var at = prevEnd
		var kept = 0 as Count
		var lastBlank = false
		while at < lineStart 'lines'
			var stop = at
			while stop < lineStart and src.text.byteAt(stop) != byteNewline 'scan'
				stop = after(stop)
			end 'scan'
			if stop == lineStart 'unended'
				break 'lines'
			end 'unended'
			let blank = isBlankLine(src.text, from: at, until: stop)
			let fault = lineFault(rule, kept: kept, blank: blank, lastBlank: lastBlank)
			if fault.kind != BlankFault.noFault 'refused'
				if not formatting 'refuse'
					throw self.refuse(fault.message.clone(), at: at)
				end 'refuse'
				if fault.kind == BlankFault.extraBlank 'extra'
					at = after(stop)
					continue 'lines'
				end 'extra'
				format.blankLine()
				kept = after(kept)
			end 'refused'
			if formatting 'write'
				format.gapLine(src.text, begin: at, until: stop, blank: blank, tabs: depth)
			end 'write'
			kept = after(kept)
			lastBlank = blank
			at = after(stop)
		end 'lines'
		let fault = endFault(rule, kept: kept, lastBlank: lastBlank, atFileEnd: self.at(TokenKind.fileEnd))
		if fault.kind == BlankFault.extraBlank 'extra'
			if not formatting 'refuseExtra'
				throw self.refuse(fault.message.clone(), at: before(at))
			end 'refuseExtra'
			format.dropBlankLine()
		end 'extra' else if fault.kind == BlankFault.missingBlank 'missing'
			if not formatting 'refuseMissing'
				throw self.refuse(fault.message.clone(), at: at)
			end 'refuseMissing'
			format.blankLine()
		end 'missing'
	end 'blankLines'

	// refuse is the syntax error for a gap that breaks the layout.
	function refuse(mutates self, consumes message String, at Count) returns SyntaxError
		let file = self.fileNumber()
		errors.push(src.errorAt(diag.errExpectedToken, message: message, file: file, offset: at))
		return SyntaxError.refused
	end 'refuse'

	// startsFunction is whether the line starting at the current token defines a function inside a declaration: a
	// method or a static function. No statement starts with these words, so inside a function body it is never true.
	// An interface's functions are signatures, one line each with no body, and are listed without blank lines between
	// them.
	function startsFunction() returns bool
		let k = toks[pos].kind
		if k == TokenKind.kw_export or k == TokenKind.kw_public 'visibility'
			let following = self.peekTok().kind
			if following != TokenKind.kw_function and following != TokenKind.kw_static 'notFunction'
				return false
			end 'notFunction'
		end 'visibility' else if k != TokenKind.kw_function and k != TokenKind.kw_static 'other'
			return false
		end 'other'
		return self.lineOpensBody()
	end 'startsFunction'

	// lineOpensBody is whether the line starting at the current token is followed by an indented body.
	function lineOpensBody() returns bool
		var i = pos
		while after(i) < toks.count() 'scan'
			if toks[i].kind == TokenKind.newline 'newline'
				return toks[after(i)].kind == TokenKind.indent
			end 'newline'
			i = after(i)
		end 'scan'
		return false
	end 'lineOpensBody'

	// describe is how a syntax error shows a token: its text, or a name for a token whose text is not shown.
	function describe(t Token) returns String
		if t.kind == TokenKind.newline 'newline'
			return newlineText
		end 'newline'
		if t.kind == TokenKind.fileEnd 'fileEnd'
			return fileEndText
		end 'fileEnd'
		if t.kind == TokenKind.eof 'eof'
			return eofText
		end 'eof'
		if t.kind == TokenKind.string 'string'
			return stringText
		end 'string'
		if t.length == 0 'empty'
			return tokenDescription(t.kind)
		end 'empty'
		return self.text(t)
	end 'describe'

	// expected is the syntax error at the current token, naming what the grammar allows there.
	function expected(mutates self, what String) returns SyntaxError
		let t = self.cur()
		let file = self.fileNumber()
		if self.atEndOfInput() 'end'
			errors.push(src.errorAt(diag.errUnexpectedEnd, message: diag.unexpectedEof(), file: file, offset: t.start as Count))
			return SyntaxError.refused
		end 'end'
		let msg = diag.expectedToken(what, got: self.describe(t))
		errors.push(src.errorAt(diag.errExpectedToken, message: msg, file: file, offset: t.start as Count))
		return SyntaxError.refused
	end 'expected'

	function expect(mutates self, k TokenKind, what String) returns Token throws SyntaxError
		if not self.at(k) 'missing'
			throw self.expected(what)
		end 'missing'
		return try self.next()
	end 'expect'

	// textRef is what a record holds for the name or label that a token is.
	function textRef(t Token) returns diag.U32
		return ast.textRef(t.start)
	end 'textRef'
end 'Parser'

// The conversions below turn a token into a field that is not its text, as Maxon.g4 declares.

function intLitMagnitude(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	return try integer(p, t: t)
end 'intLitMagnitude'

function boundValue(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	return try integer(p, t: t)
end 'boundValue'

function integer(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	let file = p.fileNumber()
	return try readInteger(p.src, errs: p.errors, file: file, at: t.start as Count, stop: t.endOffset())
end 'integer'

// strLitParts reads the string literal that t is and gives the parts it holds in the tree: a run of the module's text
// is its offset and length, text that an escape changed is a string of its own, and an interpolation is the
// expression that its text parses to.
function strLitParts(mutates p Parser, t Token) returns diag.U32 throws SyntaxError
	let file = p.fileNumber()
	var r = stringReaderAt(p.src, file: file, open: t.start as Count, collect: true)
	_ = try r.read(p.src, errs: p.errors)
	let parts = exchange(r.parts, value: StrParts.create(0))
	var b = ast.StrPartsBuilder.new()
	var formatted = ast.StringList.create(0)
	for i in 0 upto parts.count() 'each'
		match parts[i] 'part'
			text(run, begin, raw) then addTextPart(p, parts: b, text: run, begin: begin, raw: raw)
			expr(begin, until) then b.interpolation(try parseInterpolationAt(p, begin: begin, until: until, formatted: formatted))
		end 'part'
	end 'each'
	if p.formatting 'format'
		p.format.replaceString(p.src.text, t: t, parts: parts, formatted: formatted)
	end 'format'
	return b.finish(p.tree)
end 'strLitParts'

// lexemeStart and lexemeEnd are where a token's source text begins and ends: a label's token leaves out its quotes.
function lexemeStart(t Token) returns Count
	if t.kind == TokenKind.label 'label'
		return before(t.start as Count)
	end 'label'
	return t.start as Count
end 'lexemeStart'

function lexemeEnd(t Token) returns Count
	if t.kind == TokenKind.label 'label'
		return after(t.endOffset())
	end 'label'
	return t.endOffset()
end 'lexemeEnd'

// startsLine reports whether a token of kind is the last thing before a new line's first token.
function startsLine(kind TokenKind) returns bool
	return kind == TokenKind.newline or kind == TokenKind.indent or kind == TokenKind.dedent or kind == TokenKind.fileEnd
end 'startsLine'

// lineFault is the fault of the line that would come after kept lines under rule, blank or not, the one before it
// being lastBlank.
function lineFault(rule BlankRule, kept Count, blank bool, lastBlank bool) returns Fault
	if blank and rule == BlankRule.noBlanks 'inBody'
		return Fault.make(BlankFault.extraBlank, message: blankInBody)
	end 'inBody'
	if blank and kept == 0 and rule == BlankRule.firstInFile 'fileStart'
		return Fault.make(BlankFault.extraBlank, message: "the file starts with a blank line")
	end 'fileStart'
	if blank and lastBlank 'twice'
		return Fault.make(BlankFault.extraBlank, message: "two blank lines in a row; keep one")
	end 'twice'
	if not blank and kept == 0 and rule == BlankRule.afterDecl 'afterDecl'
		return Fault.make(BlankFault.missingBlank, message: blankAfterDeclaration)
	end 'afterDecl'
	if not blank and kept == 0 and rule == BlankRule.beforeFunction 'beforeFunction'
		return Fault.make(BlankFault.missingBlank, message: blankBeforeFunction)
	end 'beforeFunction'
	return Fault.make(BlankFault.noFault, message: "")
end 'lineFault'

// endFault is the fault of the gap's end, when kept lines have come before the line that starts it, the last one
// blank or not, and that line is the end of the file or not.
function endFault(rule BlankRule, kept Count, lastBlank bool, atFileEnd bool) returns Fault
	if rule == BlankRule.afterDecl and kept == 0 and not atFileEnd 'afterDecl'
		return Fault.make(BlankFault.missingBlank, message: blankAfterDeclaration)
	end 'afterDecl'
	if rule == BlankRule.beforeFunction and kept == 0 'beforeFunction'
		return Fault.make(BlankFault.missingBlank, message: blankBeforeFunction)
	end 'beforeFunction'
	if lastBlank and atFileEnd 'fileEnd'
		return Fault.make(BlankFault.extraBlank, message: "the file ends with a blank line")
	end 'fileEnd'
	return Fault.make(BlankFault.noFault, message: "")
end 'endFault'

// isBlankLine is whether a line holds nothing but whitespace.
function isBlankLine(text String, from Count, until Count) returns bool
	for i in from upto until 'each'
		let c = text.byteAt(i)
		if c != byteSpace and c != byteTab and c != byteNewline 'code'
			return false
		end 'code'
	end 'each'
	return true
end 'isBlankLine'

function addTextPart(mutates p Parser, mutates parts ast.StrPartsBuilder, text String, begin Count, raw bool)
	if raw 'raw'
		let offset = try begin as diag.U32 otherwise panic("a string part starts past U32")
		let length = try text.byteLength() as diag.U32 otherwise panic("a string part is longer than U32")
		parts.run(offset, length: length)
		return
	end 'raw'
	parts.decoded(p.tree, text: text.clone())
end 'addTextPart'

// parseInterpolationAt parses the interpolation from begin to until with the parser's tokens and layout set aside: its
// first token follows its '{' with no space between them. A formatting parser formats it in a pass of its own and adds
// its text to formatted.
function parseInterpolationAt(mutates p Parser, begin Count, until Count, mutates formatted ast.StringList) returns ast.NodeID throws SyntaxError
	let file = p.fileNumber()
	let toks = try lexInterpolation(p.src, errs: p.errors, file: file, begin: begin, until: until, lenient: p.formatting)
	let savedToks = exchange(p.toks, value: toks)
	let savedFormat = exchange(p.format, value: Formatter.new())
	let savedPos = p.pos
	let savedEnd = p.prevEnd
	let savedKind = p.prevKind
	let savedJoin = p.joinNext
	let savedBlanks = p.blanks
	p.pos = 0 as Count
	p.prevEnd = begin
	p.prevKind = TokenKind.lBrace
	p.joinNext = true
	p.blanks = BlankRule.noBlanks
	var e = 0 as ast.NodeID
	var failed = false
	try 'interpolation'
		e = parseInterpolation(p)
	end 'interpolation' otherwise 'refused'
		failed = true
	end 'refused'
	p.toks = savedToks
	p.pos = savedPos
	p.prevEnd = savedEnd
	p.prevKind = savedKind
	p.joinNext = savedJoin
	p.blanks = savedBlanks
	let sub = exchange(p.format, value: savedFormat)
	if failed 'failed'
		throw SyntaxError.refused
	end 'failed'
	if p.formatting 'format'
		formatted.push(String.from(sub.out))
	end 'format'
	return e
end 'parseInterpolationAt'

function parseInterpolation(mutates p Parser) returns ast.NodeID throws SyntaxError
	let e = try parseExpr(p)
	if not p.atEndOfInput() 'trailing'
		throw p.expected("the end of the interpolation")
	end 'trailing'
	return e
end 'parseInterpolation'

// parseProgram parses every declaration of a module's files. A syntax error abandons the rest of its file, so each
// file reports its own first error.
function parseProgram(mutates p Parser) returns ast.DeclList
	var decls = ast.DeclList.create(0)
	var count = 0 as Count
	var failed = false
	while not p.at(TokenKind.eof) 'decls'
		if p.at(TokenKind.fileEnd) 'fileEnd'
			if not failed 'check'
				p.blanks = blanksBefore(count)
				let t = p.cur()
				try 'layout'
					p.checkLayout(t)
				end 'layout' otherwise 'refused'
					failed = true
				end 'refused'
			end 'check'
			_ = p.skip()
			p.fileIndex = after(p.fileIndex)
			count = 0 as Count
			failed = false
			continue 'decls'
		end 'fileEnd'
		var abandoned = false
		try 'decl'
			p.blanks = blanksBefore(count)
			let d = parseDecl(p)
			decls.push(d)
			_ = p.expect(TokenKind.newline, what: "the end of the line")
		end 'decl' otherwise 'refused'
			abandoned = true
		end 'refused'
		count = after(count)
		if abandoned 'skip'
			failed = true
			p.lists.reset()
			while not p.atEndOfInput() 'rest'
				_ = p.skip()
			end 'rest'
		end 'skip'
	end 'decls'
	return decls
end 'parseProgram'

// blanksBefore is the rule for the blank lines before a file's next declaration, after count of them.
function blanksBefore(count Count) returns BlankRule
	if count > 0 'after'
		return BlankRule.afterDecl
	end 'after'
	return BlankRule.firstInFile
end 'blanksBefore'

// parseSourceInto parses the module of the handle from its source.
function parseSourceInto(module diag.ModuleID, consumes path String, consumes src Source) returns ParseResult
	var errs = diag.ErrorList.create(0)
	var toks = Tokens.create(0)
	var failed = false
	try 'lex'
		toks = lexSource(src, errs: errs, lenient: false)
	end 'lex' otherwise 'refused'
		failed = true
	end 'refused'
	if failed 'lexError'
		return ParseResult.err(errs)
	end 'lexError'
	let files = src.files.clone()
	var p = Parser.new(src, toks: toks, module: module)
	let decls = parseProgram(p)
	if p.errors.count() > 0 'syntaxErrors'
		return ParseResult.err(exchange(p.errors, value: diag.ErrorList.create(0)))
	end 'syntaxErrors'
	var m = ast.Module.new(module, path: path, text: "", files: files)
	m.tree = exchange(p.tree, value: ast.Tree.new(module, text: ""))
	m.decls = decls
	return ParseResult.ok(m)
end 'parseSourceInto'

export function parseSource(module diag.ModuleID, path String, consumes src String) returns ParseResult
	return parseSourceInto(module, path: path.clone(), src: sourceOf(src, path: path))
end 'parseSource'

export function parseModuleFiles(module diag.ModuleID, consumes path String, consumes filePaths ast.StringList, consumes fileTexts ast.StringList) returns ParseResult
	var buf = ByteArray.create(0)
	var files = ast.FileSpanList.create(0)
	for i in 0 upto filePaths.count() 'concat'
		let startOff = try buf.count() as diag.U32 otherwise panic("the module's text is larger than 4 GB; split the module")
		buf.append(fileTexts[i].toByteArray())
		let endOff = try buf.count() as diag.U32 otherwise panic("the module's text is larger than 4 GB; split the module")
		files.push(ast.FileSpan.make(filePaths[i].clone(), start: startOff, endOff: endOff))
	end 'concat'
	return parseSourceInto(module, path: path, src: Source.make(String.from(buf), files: files))
end 'parseModuleFiles'
