export union ParseResult
	ok(module ast.ParsedModule)
	err(errors diag.ErrorList)
end 'ParseResult'

// BlankRule says which blank lines may come before a line: parseProgram sets the rule between declarations, and a
// function inside a declaration has its own.
enum BlankRule
	// noBlanks allows none: the line is inside a declaration.
	noBlanks
	// firstInFile allows blank lines between comment paragraphs, but not before the first line of the file.
	firstInFile
	// afterDecl requires one blank line right after the declaration before, and allows one between comment
	// paragraphs.
	afterDecl
	// beforeFunction is afterDecl for a method or an interface's function that is not the first line of its body: a
	// blank line sets each function apart, as between top-level declarations.
	beforeFunction
end 'BlankRule'

// Gap is what the layout puts before a token.
enum Gap
	// lineStart is the start of a line: only the blank lines and comment lines before it are left to decide.
	lineStart
	// endOfLine is before a newline: nothing, or a comment after the code.
	endOfLine
	// joined joins the token to the one before it.
	joined
	// oneSpace is one space.
	oneSpace
end 'Gap'

// GapLine is what a line between two tokens is: a blank line, a comment line, or a directive line, which opens an `#if`, goes
// on to its `#else` or closes it.
enum GapLine
	blank
	comment
	opens
	alternates
	closes
end 'GapLine'

typealias GapLines = Array with GapLine

// isDirectiveLine is whether the line of a gap is a directive.
function isDirectiveLine(kind GapLine) returns bool
	return kind != GapLine.blank and kind != GapLine.comment
end 'isDirectiveLine'

// firstDirective is the index of the first directive line of the lines of a gap that holds one.
function firstDirective(kinds GapLines) returns Count
	for i in 0 upto kinds.count() 'each'
		if isDirectiveLine(kinds[i]) 'directive'
			return i
		end 'directive'
	end 'each'
	panic("a gap that holds a directive line holds none")
end 'firstDirective'

// nextDirectiveOpens is whether the first directive line after the line at line opens an `#if`; hasDirectiveAfter is whether
// there is one.
function nextDirectiveOpens(kinds GapLines, line Count) returns bool
	for i in (try line + 1 otherwise panic("a gap has too many lines")) upto kinds.count() 'each'
		if isDirectiveLine(kinds[i]) 'directive'
			return kinds[i] == GapLine.opens
		end 'directive'
	end 'each'
	return false
end 'nextDirectiveOpens'

function hasDirectiveAfter(kinds GapLines, line Count) returns bool
	for i in (try line + 1 otherwise panic("a gap has too many lines")) upto kinds.count() 'each'
		if isDirectiveLine(kinds[i]) 'directive'
			return true
		end 'directive'
	end 'each'
	return false
end 'hasDirectiveAfter'

// BlankFault is how the blank lines before a line break the rule: a blank line that is not allowed, or one that is
// missing.
enum BlankFault
	noFault
	extraBlank
	missingBlank
end 'BlankFault'

type Fault
	var kind as BlankFault
	var message as String

	static function make(kind BlankFault, consumes message String) returns Fault
		return Fault{kind: kind, message: message}
	end 'make'
end 'Fault'

// testWord is the word that starts a test, where a quoted name follows it; it is a name everywhere else.
let testWord = "test"

// spawnWord starts a spawn; it is a name everywhere else.
export let spawnWord = "spawn"

// testFileExtension ends the name of a file of tests, the only file that may hold a test.
let testFileExtension = ".maxtest"

// capturesWord is the word after `mutates` that ends a function type which mutates its captures.
let capturesWord = "captures"

// expressionWanted is what Maxon.g4 says its expression rule is, which a syntax error names where one is missing.
let expressionWanted = "an expression"

let blankInBody = "a blank line is only allowed between declarations, and before a function of a type, an enum or a union"

let blankBeforeFunction = "expected a blank line before this function, which is not the first line of its type, enum or union"

let blankAfterDeclaration = "expected a blank line after the declaration above"

// ParenScan is what the tokens from an opening parenthesis to its closing one say about the parenthesis.
type ParenScan
	var hasComma as bool
	var closing as Count

	static function make(hasComma bool, closing Count) returns ParenScan
		return ParenScan{hasComma: hasComma, closing: closing}
	end 'make'
end 'ParenScan'

// Parser holds what the generated parse functions (parser_gen.maxon) share: the module's source, its token stream, the
// position in it, and the file the parser is in.
typealias NameWords = Array with diag.U32

type Parser
	var src as Source
	var toks as Tokens
	var tree as ast.Tree
	var lists as ListStacks
	var pos as Count
	var fileIndex as Count
	var errors as diag.ErrorList
	// The layout: where the last token consumed ends and what it was, whether the next token joins it with no space
	// between them, and which blank lines may come before the next line.
	var prevEnd as Count
	var prevKind as TokenKind
	var joinNext as bool
	var blanks as BlankRule
	// format is what a formatting parser writes: where it would refuse a layout, it writes the layout the rules require.
	var format as Formatter
	var formatting as bool
	// layoutOnly is set where only the layout of a program is wanted, which the formatter and its check read: what the name of
	// the file says about the declarations in it is then not asked.
	var layoutOnly as bool
	// directives is the text of each directive line of the source, in order, which a formatting parser writes where the line
	// stands; directiveNext is the next one it writes.
	var directives as ast.StringList
	var directiveNext as Count
	// libraryTier is whether the module is in the library tier, whose declarations may take the names reserved for it.
	var libraryTier as bool
	// initializer is the name of the module-level or static let whose initializer is being parsed, or empty outside one.
	var initializer as String
	// nameWords is where each keyword that the parser took as a name starts, in text order: a rename of the keyword leaves
	// these alone.
	var nameWords as NameWords
	// nameUses are the names that the code of the source writes, its interpolations' included (addNameUses).
	var nameUses as ast.NameUses
	// unionNames are the names the source writes before `.Message`, whose types' message unions it may name (unionNamesOf).
	var unionNames as ast.StringList

	static function new(consumes src Source, consumes toks Tokens, module diag.ModuleID) returns Parser
		let text = src.text.clone()
		var prevEnd = 0 as Count
		if src.files.count() > 0 'first'
			prevEnd = src.files[0].start as Count
		end 'first'
		return Parser{src: src, toks: toks, tree: ast.Tree.new(module, text: text), lists: ListStacks.new(), pos: 0 as Count, fileIndex: 0 as Count, errors: diag.ErrorList.create(0), prevEnd: prevEnd, prevKind: TokenKind.fileEnd, joinNext: false, blanks: BlankRule.firstInFile, format: Formatter.new(), formatting: false, layoutOnly: false, directives: ast.StringList.create(0), directiveNext: 0 as Count, libraryTier: false, initializer: "", nameWords: NameWords.create(0), nameUses: ast.NameUses.create(0), unionNames: ast.StringList.create(0)}
	end 'new'

	function fileNumber() returns Count
		let last = try src.files.count() - 1 otherwise 0 as Count
		if fileIndex < last 'within'
			return fileIndex
		end 'within'
		return last
	end 'fileNumber'

	// text is a token's text: a substring of the module's source.
	function text(t Token) returns String
		return src.text.sliceBytes(t.start as Count, endPos: t.endOffset()).clone()
	end 'text'

	function cur() returns borrowed Token
		return toks[pos]
	end 'cur'

	function curStart() returns diag.U32
		return toks[pos].start
	end 'curStart'

	// at2 is the token two after the current one: the one after a test's name.
	function at2() returns Token throws SyntaxError
		let at = try pos + 2 otherwise panic("the tokens are too many")
		if at >= toks.count() 'past'
			return toks[before(toks.count())].clone()
		end 'past'
		return toks[at].clone()
	end 'at2'

	function peekTok() returns borrowed Token
		let last = try toks.count() - 1 otherwise 0 as Count
		var at = try pos + 1 otherwise last
		if at > last 'clamp'
			at = last
		end 'clamp'
		return toks[at]
	end 'peekTok'

	// next consumes the current token, after checking the layout before it.
	function next(mutates self) returns Token throws SyntaxError
		try self.layout()
		return self.skip()
	end 'next'

	// layout checks the gap before the current token, or in a formatting parser writes the gap the rules require there and
	// then the token.
	function layout(mutates self) throws SyntaxError
		if formatting 'formats'
			try self.formatToken()
			return
		end 'formats'
		try self.checkLayout()
	end 'layout'

	// formatToken writes the gap the layout puts before the current token, and then the token. It is called where a checking
	// parser calls checkLayout, so the gap comes from the same decisions.
	function formatToken(mutates self) throws SyntaxError
		let kind = toks[pos].kind
		let start = lexemeStart(toks[pos])
		let gap = self.gapBefore(kind)
		if gap == Gap.lineStart 'lines'
			try self.blankLines(start)
			let depth = format.depth
			if kind == TokenKind.indent 'indent'
				format.depth = after(depth)
			end 'indent' else if kind == TokenKind.dedent 'dedent'
				format.depth = try depth - 1 otherwise panic("the formatter dedents past the margin")
			end 'dedent' else if kind != TokenKind.fileEnd and kind != TokenKind.eof 'code'
				format.indent(format.tabsAt(depth))
			end 'code'
		end 'lines' else if gap == Gap.endOfLine 'endOfLine'
			format.trailingComment(src.text, begin: prevEnd, until: start)
		end 'endOfLine' else if gap == Gap.oneSpace 'space'
			format.out.push(byteSpace)
		end 'space'
		format.tokenStart = format.out.count()
		if kind == TokenKind.newline 'newline'
			format.out.push(byteNewline)
			return
		end 'newline'
		appendRange(format.out, text: src.text, begin: start, until: lexemeEnd(toks[pos]))
	end 'formatToken'

	// depthAfterIndentTokens is the indentation of the code line that starts at the current token, which is the first of
	// the indent or dedent tokens that open it, or the line's first token.
	function depthAfterIndentTokens() returns Count
		return format.tabsAt(self.logicalDepthAfterIndentTokens())
	end 'depthAfterIndentTokens'

	// logicalDepthAfterIndentTokens is that indentation before the tabs of the `#if` regions that hold the line.
	function logicalDepthAfterIndentTokens() returns Count
		var depth = format.depth
		var i = pos
		while i < toks.count() 'scan'
			let kind = toks[i].kind
			if kind == TokenKind.indent 'indent'
				depth = after(depth)
			end 'indent' else if kind == TokenKind.dedent 'dedent'
				depth = try depth - 1 otherwise panic("the formatter dedents past the margin")
			end 'dedent' else 'code'
				return depth
			end 'code'
			i = after(i)
		end 'scan'
		return depth
	end 'logicalDepthAfterIndentTokens'

	// skip consumes the current token without checking its layout, as error recovery does.
	function skip(mutates self) returns Token
		let at = pos
		self.advance()
		return toks[at].clone()
	end 'skip'

	// advance is skip where nothing keeps the token.
	function advance(mutates self)
		let at = pos
		if after(pos) < toks.count() 'more'
			pos = after(pos)
		end 'more'
		prevEnd = lexemeEnd(toks[at])
		prevKind = toks[at].kind
		joinNext = inTokenSet(tokenNoSpaceAfter, kind: toks[at].kind)
	end 'advance'

	function at(k TokenKind) returns bool
		return toks[pos].kind == k
	end 'at'

	function inSet(set String) returns bool
		return inTokenSet(set, kind: toks[pos].kind)
	end 'inSet'

	function peekIs(k TokenKind) returns bool
		return self.peekTok().kind == k
	end 'peekIs'

	function peekIn(set String) returns bool
		return inTokenSet(set, kind: self.peekTok().kind)
	end 'peekIn'

	// atHandlerBinding is whether the label here names the block that follows `otherwise (e)`: only that binding makes a
	// label after the value of an `otherwise` the label of a handler, and not the label of the `if` or the loop that the try
	// ends the condition of.
	function atHandlerBinding() returns bool
		if pos < 4 'short'
			return false
		end 'short'
		let closing = before(pos)
		let name = before(closing)
		let opening = before(name)
		return toks[before(opening)].kind == TokenKind.kw_otherwise and toks[opening].kind == TokenKind.lParen and toks[name].kind == TokenKind.name and toks[closing].kind == TokenKind.rParen
	end 'atHandlerBinding'

	// scanParen reads the tokens from the parenthesis the parser is at to the one that closes it: whether a comma stands
	// between them, outside any bracket inside, and the place of the closing one, which is the end of the tokens where
	// none does.
	function scanParen() returns ParenScan
		var depth = 0 as Count
		var hasComma = false
		var i = after(pos)
		while i < toks.count() and toks[i].kind != TokenKind.fileEnd and toks[i].kind != TokenKind.eof 'scan'
			let kind = toks[i].kind
			if kind == TokenKind.lParen or kind == TokenKind.lBracket or kind == TokenKind.lBrace 'open'
				depth = after(depth)
			end 'open' else if kind == TokenKind.rParen or kind == TokenKind.rBracket or kind == TokenKind.rBrace 'close'
				if depth == 0 'closes'
					return ParenScan.make(hasComma, closing: i)
				end 'closes'
				depth = depth - 1
			end 'close' else if kind == TokenKind.comma and depth == 0 'comma'
				hasComma = true
			end 'comma'
			i = after(i)
		end 'scan'
		return ParenScan.make(hasComma, closing: toks.count())
	end 'scanParen'

	// atTuple is whether the parenthesis here opens a tuple, which holds a comma between its parentheses; `(a)` is the
	// expression a.
	// notFallthrough is whether the 'and' at the current token is an operator: 'and fallthrough' ends the statement of a match arm.
	function notFallthrough() returns bool
		return not self.peekIs(TokenKind.kw_fallthrough)
	end 'notFallthrough'

	// rangeIsValue is whether the 'to' or 'upto' here makes a range value. At the top of a for header, outside any bracket
	// after its 'in', the operator is the counted loop's own, which the header reads, so that loop makes no range; everywhere
	// else, inside a bracket of the header too, it makes the library's Range or OpenRange, as maxon's does.
	function rangeIsValue() returns bool
		var depth = 0 as Count
		var i = pos
		while i > 0 'scan'
			i = before(i)
			let kind = toks[i].kind
			if kind == TokenKind.rParen or kind == TokenKind.rBracket or kind == TokenKind.rBrace 'close'
				depth = after(depth)
			end 'close' else if kind == TokenKind.lParen or kind == TokenKind.lBracket or kind == TokenKind.lBrace 'open'
				if depth == 0 'inside'
					return true
				end 'inside'
				depth = before(depth)
			end 'open' else if kind == TokenKind.kw_in and depth == 0 'header'
				return false
			end 'header' else if kind == TokenKind.newline or kind == TokenKind.indent or kind == TokenKind.dedent 'lineStart'
				return true
			end 'lineStart'
		end 'scan'
		return true
	end 'rangeIsValue'

	// atSpawn is whether a spawn starts here: `spawn` before the type its factory is named through. A name never follows
	// another name in an expression.
	function atSpawn() returns bool
		return self.at(TokenKind.name) and self.text(toks[pos]) == spawnWord and self.peekIs(TokenKind.name)
	end 'atSpawn'

	// atTestDecl is whether the declaration that starts here is a test: `test` and a quoted name.
	function atTestDecl() returns bool
		return self.at(TokenKind.name) and self.text(toks[pos]) == testWord and (self.peekIs(TokenKind.label) or self.peekIs(TokenKind.testName))
	end 'atTestDecl'

	// atTryBlock is whether the `try` here opens a block: a label follows it, and no `.`, which a character literal that the
	// try calls a method of has after it, as maxon tells the two by the token after the quote.
	function atTryBlock() returns bool
		let quote = after(pos)
		return self.peekIs(TokenKind.label) and not (after(quote) < toks.count() and toks[after(quote)].kind == TokenKind.dot)
	end 'atTryBlock'

	// atStaticLet is whether the member that starts at the current token is a `static let`, which `static function` starts as
	// well, after the same modifier.
	function atStaticLet() returns bool
		var i = pos
		if toks[i].kind == TokenKind.kw_export or toks[i].kind == TokenKind.kw_public 'visibility'
			i = after(i)
		end 'visibility'
		if i >= toks.count() or toks[i].kind != TokenKind.kw_static 'notStatic'
			return false
		end 'notStatic'
		let next = after(i)
		return next < toks.count() and toks[next].kind == TokenKind.kw_let
	end 'atStaticLet'

	function atTuple() returns bool
		return self.scanParen().hasComma
	end 'atTuple'

	// atTupleAssignment is whether the parenthesis here opens the targets of a tuple assignment, which the `=` after the
	// closing one tells from an expression that starts with a parenthesis.
	function atTupleAssignment() returns bool
		let scan = self.scanParen()
		return scan.hasComma and after(scan.closing) < toks.count() and toks[after(scan.closing)].kind == TokenKind.assign
	end 'atTupleAssignment'

	// atMutatesCaptures is whether `mutates` here begins the clause `mutates captures` that ends a function type, whose
	// second word is a name everywhere else.
	function atMutatesCaptures() returns bool
		return self.at(TokenKind.kw_mutates) and self.peekIs(TokenKind.name) and self.text(self.peekTok()) == capturesWord
	end 'atMutatesCaptures'

	// atBorrowedResult is whether the name here is the word `borrowed` before the type of a function's result, which a type
	// starts after: anywhere else, and as the whole result type, it is a name.
	function atBorrowedResult() returns bool
		if not self.at(TokenKind.name) or self.text(self.cur()) != ast.borrowedWord 'notWord'
			return false
		end 'notWord'
		return self.peekIs(TokenKind.name) or self.peekIs(TokenKind.kw_export) or self.peekIs(TokenKind.kw_Self) or self.peekIs(TokenKind.kw_int) or self.peekIs(TokenKind.lParen)
	end 'atBorrowedResult'

	function atEndOfInput() returns bool
		return self.at(TokenKind.fileEnd) or self.at(TokenKind.eof)
	end 'atEndOfInput'

	// gapBefore is the one place that says what separates a token of kind from the one before it: within a line, none
	// where it, or the token before it, joins its neighbour, and one space otherwise. The checker refuses another gap.
	function gapBefore(kind TokenKind) returns Gap
		if startsLine(prevKind) 'line'
			return Gap.lineStart
		end 'line'
		if kind == TokenKind.newline 'newline'
			return Gap.endOfLine
		end 'newline'
		if joinNext or inTokenSet(tokenNoSpaceBefore, kind: kind) 'joined'
			return Gap.joined
		end 'joined'
		return Gap.oneSpace
	end 'gapBefore'

	// checkLayout checks the space before the current token. Within a line the lexer has made every gap one space or none;
	// here the grammar decides which. At the start of a line the lexer has checked the indentation, and only the blank lines
	// before it are left to check.
	function checkLayout(mutates self) throws SyntaxError
		let start = lexemeStart(toks[pos])
		let gap = self.gapBefore(toks[pos].kind)
		let last = prevEnd
		if gap == Gap.lineStart 'line'
			try self.blankLines(start)
		end 'line' else if gap == Gap.joined 'joined'
			if start > last 'spaced'
				let msg = "expected no space before '{self.describe(toks[pos])}'"
				throw self.refuse(msg, at: last)
			end 'spaced'
		end 'joined' else if gap == Gap.oneSpace 'space'
			if start == last 'touching'
				let msg = "expected a space before '{self.describe(toks[pos])}'"
				throw self.refuse(msg, at: toks[pos].start as Count)
			end 'touching'
		end 'space'
	end 'checkLayout'

	// blankLines checks the blank lines and comment lines between the last line and the one that starts at lineStart,
	// against the rule parseProgram set for it. A formatting parser writes the lines the rule allows instead of refusing
	// the others.
	function blankLines(mutates self, lineStart Count) throws SyntaxError
		var rule = blanks
		blanks = BlankRule.noBlanks
		if rule == BlankRule.noBlanks and prevKind == TokenKind.newline and self.startsFunction() 'function'
			rule = BlankRule.beforeFunction
		end 'function'
		if self.gapHoldsDirective(lineStart) 'directives'
			if formatting 'format'
				try self.formatDirectiveGap(rule, lineStart: lineStart)
			end 'format'
			return
		end 'directives'
		var depth = 0 as Count
		if formatting 'depth'
			depth = self.depthAfterIndentTokens()
		end 'depth'
		var at = prevEnd
		var kept = 0 as Count
		var lastBlank = false
		while at < lineStart 'lines'
			var stop = at
			while stop < lineStart and src.text.byteAt(stop) != byteNewline 'scan'
				stop = after(stop)
			end 'scan'
			if stop == lineStart 'unended'
				break 'lines'
			end 'unended'
			let blank = isBlankLine(src.text, from: at, until: stop)
			let fault = lineFault(rule, kept: kept, blank: blank, lastBlank: lastBlank)
			if fault.kind != BlankFault.noFault 'refused'
				if not formatting 'refuse'
					throw self.refuse(fault.message.clone(), at: at)
				end 'refuse'
				if fault.kind == BlankFault.extraBlank 'extra'
					at = after(stop)
					continue 'lines'
				end 'extra'
				format.blankLine()
				kept = after(kept)
			end 'refused'
			if formatting 'write'
				format.gapLine(src.text, begin: at, until: stop, blank: blank, tabs: depth)
			end 'write'
			kept = after(kept)
			lastBlank = blank
			at = after(stop)
		end 'lines'
		let fault = endFault(rule, kept: kept, lastBlank: lastBlank, atFileEnd: self.at(TokenKind.fileEnd))
		if fault.kind == BlankFault.extraBlank 'extra'
			if not formatting 'refuseExtra'
				throw self.refuse(fault.message.clone(), at: before(at))
			end 'refuseExtra'
			format.dropBlankLine()
		end 'extra' else if fault.kind == BlankFault.missingBlank 'missing'
			if not formatting 'refuseMissing'
				throw self.refuse(fault.message.clone(), at: at)
			end 'refuseMissing'
			format.blankLine()
		end 'missing'
	end 'blankLines'

	// lineEndWithin is where the line that starts at begin ends, or lineStart when the gap ends before the line does.
	function lineEndWithin(begin Count, lineStart Count) returns Count
		var stop = begin
		while stop < lineStart and src.text.byteAt(stop) != byteNewline 'scan'
			stop = after(stop)
		end 'scan'
		return stop
	end 'lineEndWithin'

	// gapHoldsDirective is whether a line of the gap before the line that starts at lineStart is a directive line. Such a
	// gap holds the directive lines, and the code of the branches that are left out, between two tokens of the program.
	function gapHoldsDirective(lineStart Count) returns bool
		var at = prevEnd
		while at < lineStart 'lines'
			let stop = self.lineEndWithin(at, lineStart: lineStart)
			if stop == lineStart 'unended'
				return false
			end 'unended'
			let first = skipSourceWhitespace(src.text, begin: at, until: stop)
			if first < stop and src.text.byteAt(first) == byteHash 'directive'
				return true
			end 'directive'
			at = after(stop)
		end 'lines'
		return false
	end 'gapHoldsDirective'

	// directiveKindAt is what the line of the gap from begin until stop is: a blank line, a comment line, or the directive
	// line it holds.
	function directiveKindAt(begin Count, stop Count) returns GapLine
		if isBlankLine(src.text, from: begin, until: stop) 'blank'
			return GapLine.blank
		end 'blank'
		let first = skipSourceWhitespace(src.text, begin: begin, until: stop)
		if src.text.byteAt(first) != byteHash 'comment'
			return GapLine.comment
		end 'comment'
		if self.startsWithWord(first, until: stop, word: hashEndifText) 'closes'
			return GapLine.closes
		end 'closes'
		if self.startsWithWord(first, until: stop, word: hashElseText) 'alternates'
			return GapLine.alternates
		end 'alternates'
		return GapLine.opens
	end 'directiveKindAt'

	function startsWithWord(at Count, until Count, word String) returns bool
		let stop = try at + word.byteLength() otherwise panic("a directive ends past the text")
		return stop <= until and src.text.sliceBytes(at, endPos: stop) == word
	end 'startsWithWord'

	// formatDirectiveGap writes a gap that holds directive lines. A directive line stands at the indentation of the code
	// around the `#if`, its branch one tab deeper; no blank line comes before an `#else` or an `#endif` or after an `#if` or an
	// `#else`, and the blank lines before an `#if` and after an `#endif` are those the line the `#if` stands for would have,
	// which is the line the gap ends with: its rule.
	function formatDirectiveGap(mutates self, rule BlankRule, lineStart Count) throws SyntaxError
		var begins = Offsets.create(0)
		var stops = Offsets.create(0)
		var kinds = GapLines.create(0)
		var at = prevEnd
		while at < lineStart 'gather'
			let stop = self.lineEndWithin(at, lineStart: lineStart)
			if stop == lineStart 'unended'
				break 'gather'
			end 'unended'
			begins.push(at)
			stops.push(stop)
			kinds.push(self.directiveKindAt(at, stop: stop))
			at = after(stop)
		end 'gather'
		let base = format.depth
		var regions = format.regions
		var tabs = Offsets.create(0)
		for j in 0 upto kinds.count() 'tabs'
			var lineTabs = 0 as Count
			if kinds[j] == GapLine.opens 'opens'
				lineTabs = try base + regions otherwise panic("the indentation overflows")
				regions = after(regions)
			end 'opens' else if kinds[j] == GapLine.alternates 'alternates'
				regions = try regions - 1 otherwise panic("an #else closes no #if")
				lineTabs = try base + regions otherwise panic("the indentation overflows")
				regions = after(regions)
			end 'alternates' else if kinds[j] == GapLine.closes 'closes'
				regions = try regions - 1 otherwise panic("an #endif closes no #if")
				lineTabs = try base + regions otherwise panic("the indentation overflows")
			end 'closes'
			tabs.push(lineTabs)
		end 'tabs'
		var following = 0 as Count
		following = try self.logicalDepthAfterIndentTokens() + regions otherwise panic("the indentation overflows")
		var back = kinds.count()
		while back > 0 'comments'
			back = before(back)
			if kinds[back] == GapLine.comment 'comment'
				tabs[back] = following
			end 'comment' else if kinds[back] != GapLine.blank 'directive'
				following = tabs[back]
			end 'directive'
		end 'comments'
		var segment = rule
		if kinds.count() > 0 and kinds[firstDirective(kinds)] != GapLine.opens 'closing'
			segment = BlankRule.noBlanks
		end 'closing'
		var kept = 0 as Count
		var lastBlank = false
		for j in 0 upto kinds.count() 'lines'
			let kind = kinds[j]
			if kind == GapLine.blank or kind == GapLine.comment 'plain'
				let blank = kind == GapLine.blank
				let fault = lineFault(segment, kept: kept, blank: blank, lastBlank: lastBlank)
				if fault.kind == BlankFault.extraBlank 'extra'
					continue 'lines'
				end 'extra'
				if fault.kind == BlankFault.missingBlank 'missing'
					format.blankLine()
					kept = after(kept)
				end 'missing'
				format.gapLine(src.text, begin: begins[j], until: stops[j], blank: blank, tabs: tabs[j])
				kept = after(kept)
				lastBlank = blank
				continue 'lines'
			end 'plain'
			self.endSegment(segment, kept: kept, lastBlank: lastBlank, atFileEnd: false)
			format.indent(tabs[j])
			let text = directives[directiveNext].clone()
			format.out.append(text.toByteArray())
			format.out.push(byteNewline)
			directiveNext = after(directiveNext)
			if kind == GapLine.closes and nextDirectiveOpens(kinds, line: j) 'afterClose'
				segment = rule
			end 'afterClose' else if kind == GapLine.closes and not hasDirectiveAfter(kinds, line: j) 'last'
				segment = rule
			end 'last' else 'branch'
				segment = BlankRule.noBlanks
			end 'branch'
			kept = 0 as Count
			lastBlank = false
		end 'lines'
		format.regions = regions
		self.endSegment(segment, kept: kept, lastBlank: lastBlank, atFileEnd: self.at(TokenKind.fileEnd))
	end 'formatDirectiveGap'

	// endSegment writes the blank line that the end of a run of gap lines under rule lacks, or takes back the one it has too
	// many.
	function endSegment(mutates self, rule BlankRule, kept Count, lastBlank bool, atFileEnd bool)
		let fault = endFault(rule, kept: kept, lastBlank: lastBlank, atFileEnd: atFileEnd)
		if fault.kind == BlankFault.extraBlank 'extra'
			format.dropBlankLine()
		end 'extra' else if fault.kind == BlankFault.missingBlank 'missing'
			format.blankLine()
		end 'missing'
	end 'endSegment'

	// refuse is the syntax error for a gap that breaks the layout.
	// declares refuses the name t that a declaration takes where it is reserved: one that starts with the prefix of the
	// names of the compiler and the library tier, outside that tier. The formatter reads layout only, and refuses none.
	function declares(mutates self, t Token) throws SyntaxError
		if layoutOnly or libraryTier 'open'
			return
		end 'open'
		let name = self.text(t)
		if name.startsWith(reservedPrefix) 'prefixed'
			errors.push(src.errorAt(diag.errReservedIdentifier, message: diag.reservedIdentifier(name), file: self.fileNumber(), offset: t.start as Count))
			throw SyntaxError.refused
		end 'prefixed'
	end 'declares'

	// nameWord notes t where it is one of keywords, those that its place takes as a name.
	function nameWord(mutates self, t Token, keywords String)
		if t.kind != TokenKind.name and inTokenSet(keywords, kind: t.kind) 'keyword'
			nameWords.push(t.start)
		end 'keyword'
	end 'nameWord'

	// initializes is declares for a module-level or static let, whose initializer is parsed next.
	function initializes(mutates self, t Token) throws SyntaxError
		try self.declares(t)
		initializer = self.text(t)
	end 'initializes'

	function initialized(mutates self) throws SyntaxError
		initializer = ""
	end 'initialized'

	// leavesFunction refuses a return in the initializer of a module-level or static let, which is in no function to leave.
	function leavesFunction(mutates self, t Token) throws SyntaxError
		if initializer != "" 'initializing'
			errors.push(src.errorAt(diag.errReturnInInitializer, message: diag.returnInInitializer(initializer), file: self.fileNumber(), offset: t.start as Count))
			throw SyntaxError.refused
		end 'initializing'
	end 'leavesFunction'

	function refuse(mutates self, consumes message String, at Count) returns SyntaxError
		let file = self.fileNumber()
		errors.push(src.errorAt(diag.errExpectedToken, message: message, file: file, offset: at))
		return SyntaxError.refused
	end 'refuse'

	// startsFunction is whether the line starting at the current token defines a function inside a declaration: a
	// method or a static function. No statement starts with these words, so inside a function body it is never true.
	// An interface's functions are signatures, one line each with no body, and are listed without blank lines between
	// them.
	function startsFunction() returns bool
		let k = toks[pos].kind
		if k == TokenKind.at 'annotated'
			// A message's '@policy(T)' takes parentheses, which a binding's '@heap' does not.
			let third = try pos + 2 otherwise panic("the tokens are too many")
			return self.peekTok().kind == TokenKind.name and third < toks.count() and toks[third].kind == TokenKind.lParen and self.lineOpensBody()
		end 'annotated'
		if k == TokenKind.kw_export or k == TokenKind.kw_public 'visibility'
			let following = self.peekTok().kind
			if following != TokenKind.kw_function and following != TokenKind.kw_static 'notFunction'
				return false
			end 'notFunction'
		end 'visibility' else if k != TokenKind.kw_function and k != TokenKind.kw_static 'other'
			return false
		end 'other'
		return self.lineOpensBody()
	end 'startsFunction'

	// lineOpensBody is whether the line starting at the current token is followed by an indented body.
	function lineOpensBody() returns bool
		var i = pos
		while after(i) < toks.count() 'scan'
			if toks[i].kind == TokenKind.newline 'newline'
				return toks[after(i)].kind == TokenKind.indent
			end 'newline'
			i = after(i)
		end 'scan'
		return false
	end 'lineOpensBody'

	// describe is how a syntax error shows a token: its text, or a name for a token whose text is not shown.
	function describe(t Token) returns String
		if t.kind == TokenKind.newline 'newline'
			return newlineText
		end 'newline'
		if t.kind == TokenKind.fileEnd 'fileEnd'
			return fileEndText
		end 'fileEnd'
		if t.kind == TokenKind.eof 'eof'
			return eofText
		end 'eof'
		if t.kind == TokenKind.string 'string'
			return stringText
		end 'string'
		if t.length == 0 'empty'
			return tokenDescription(t.kind)
		end 'empty'
		return self.text(t)
	end 'describe'

	// expected is the syntax error at the current token, naming what the grammar allows there.
	function expected(mutates self, what String) returns SyntaxError
		if pos >= 2 and toks[before(before(pos))].kind == TokenKind.at and toks[before(pos)].kind == TokenKind.name 'annotation'
			// An annotation stands before a binding, which is what the word after the '@' leaves out.
			errors.push(src.errorAt(diag.errUnexpectedToken, message: diag.heapAnnotationWithoutBinding(), file: self.fileNumber(), offset: toks[before(before(pos))].start as Count))
			return SyntaxError.refused
		end 'annotation'
		let t = self.cur().clone()
		let file = self.fileNumber()
		if what == expressionWanted 'expression'
			// Where an operand is missing maxon reports E2004, as it does a name that names nothing, '_' among them: a
			// discard is no variable to read.
			let msg = diag.undefinedVariable("_") if t.kind == TokenKind.kw__ else diag.expectedExpression(self.describe(t))
			errors.push(src.errorAt(diag.errExpressionError, message: msg, file: file, offset: t.start as Count))
			return SyntaxError.refused
		end 'expression'
		if self.atEndOfInput() 'end'
			errors.push(src.errorAt(diag.errUnexpectedEnd, message: diag.unexpectedEof(), file: file, offset: t.start as Count))
			return SyntaxError.refused
		end 'end'
		let msg = diag.expectedToken(what, got: self.describe(t))
		errors.push(src.errorAt(diag.errExpectedToken, message: msg, file: file, offset: t.start as Count))
		return SyntaxError.refused
	end 'expected'

	// emptyBlock is E3082: only a function body may have no statement, so a block whose line is followed by its `end` is
	// reported at that `end`, naming the label of its header.
	function emptyBlock(mutates self) returns SyntaxError
		let header = toks[before(before(pos))].clone()
		if header.kind != TokenKind.label 'unlabelled'
			panic("a block without statements has no label before its line")
		end 'unlabelled'
		errors.push(src.errorAt(diag.errEmptyBlock, message: diag.emptyBlock(self.text(header)), file: self.fileNumber(), offset: toks[pos].start as Count))
		return SyntaxError.refused
	end 'emptyBlock'

	function expect(mutates self, k TokenKind, what String) returns Token throws SyntaxError
		try self.require(k, what: what)
		return try self.next()
	end 'expect'

	// pass is expect where nothing keeps the token.
	function pass(mutates self, k TokenKind, what String) throws SyntaxError
		try self.require(k, what: what)
		try self.layout()
		self.advance()
	end 'pass'

	// require refuses a current token that is not of kind k, which what describes.
	function require(mutates self, k TokenKind, what String) throws SyntaxError
		if not self.at(k) 'missing'
			if k == TokenKind.indent and self.at(TokenKind.kw_end) 'emptyBlock'
				throw self.emptyBlock()
			end 'emptyBlock'
			throw self.expected(what)
		end 'missing'
	end 'require'

	// textRef is what a record holds for the name or label that a token is.
	function textRef(t Token) returns diag.U32
		return ast.textRef(t.start)
	end 'textRef'
end 'Parser'

// The conversions below turn a token into a field that is not its text, as Maxon.g4 declares.

function intLitMagnitude(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	return try integer(p, t: t)
end 'intLitMagnitude'

function boundValue(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	return try integer(p, t: t)
end 'boundValue'

function boundReal(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	return try real(p, t: t)
end 'boundReal'

function typeCountValue(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	return try integer(p, t: t)
end 'typeCountValue'

function floatLitMagnitude(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	return try real(p, t: t)
end 'floatLitMagnitude'

// real reads the float literal that t is as the bits of the double nearest it.
function real(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	let text = p.src.text.sliceBytes(t.start as Count, endPos: t.endOffset())
	match ast.floatFromText(text) 'read'
		bits(value) then return ast.I128.fromCount(value)
		overflow then break
	end 'read'
	let file = p.fileNumber()
	p.errors.push(p.src.errorAt(diag.errIntegerLiteralRange, message: diag.floatLiteralOverflow(text), file: file, offset: t.start as Count))
	throw SyntaxError.refused
end 'real'

function integer(mutates p Parser, t Token) returns ast.I128 throws SyntaxError
	let file = p.fileNumber()
	return try readInteger(p.src, errs: p.errors, file: file, at: t.start as Count, stop: t.endOffset())
end 'integer'

// strLitParts reads the string literal that t is and gives the parts it holds in the tree: a run of the module's text
// is its offset and length, text that an escape changed is a string of its own, and an interpolation is the
// expression that its text parses to.
function strLitParts(mutates p Parser, t Token) returns diag.U32 throws SyntaxError
	let file = p.fileNumber()
	var r = stringReaderAt(p.src, file: file, open: t.start as Count, collect: true)
	_ = try r.read(p.src, errs: p.errors)
	let parts = exchange(r.parts, value: StrParts.create(0))
	var b = ast.StrPartsBuilder.new()
	var formatted = ast.StringList.create(0)
	for i in 0 upto parts.count() 'each'
		match parts[i] 'part'
			text(run, begin, raw) then addTextPart(p, parts: b, text: run, begin: begin, raw: raw)
			expr(begin, until, specBegin, specUntil) then try addInterpolation(p, parts: b, begin: begin, until: until, specBegin: specBegin, specUntil: specUntil, formatted: formatted)
		end 'part'
	end 'each'
	if p.formatting 'format'
		p.format.replaceString(p.src.text, t: t, parts: parts, formatted: formatted)
	end 'format'
	return b.finish(p.tree)
end 'strLitParts'

// addInterpolation adds the interpolation from begin to until, with the format specifier from specBegin to specUntil
// when it has one, to the parts of a string literal. A width or a precision past the bound of a specifier is refused.
function addInterpolation(mutates p Parser, mutates parts ast.StrPartsBuilder, begin Count, until Count, specBegin Count, specUntil Count, mutates formatted ast.StringList) throws SyntaxError
	let node = try parseInterpolationAt(p, begin: begin, until: until, formatted: formatted)
	if specUntil == specBegin 'plain'
		parts.interpolation(node)
		return
	end 'plain'
	let spec = p.src.text.sliceBytes(specBegin, endPos: specUntil)
	if not ast.parseFormatSpec(spec).isSome() 'overflow'
		let file = p.fileNumber()
		p.errors.push(p.src.errorAt(diag.errIntegerLiteralRange, message: diag.formatFieldOverflow(spec, bound: "{ast.formatFieldBound}"), file: file, offset: until))
		throw SyntaxError.refused
	end 'overflow'
	parts.formatted(p.tree, e: node, spec: spec.clone())
end 'addInterpolation'

// byteStrLitParts reads the byte string literal that t is: its bytes are one part, which is a string of them.
function byteStrLitParts(mutates p Parser, t Token) returns diag.U32 throws SyntaxError
	let file = p.fileNumber()
	var r = byteStringReaderAt(p.src, file: file, open: t.start as Count, collect: true)
	_ = try r.read(p.src, errs: p.errors)
	let parts = exchange(r.parts, value: StrParts.create(0))
	var b = ast.StrPartsBuilder.new()
	for i in 0 upto parts.count() 'each'
		match parts[i] 'part'
			text(run, begin, raw) then addTextPart(p, parts: b, text: run, begin: begin, raw: raw)
			expr(begin, until, _, _) then panic("a byte string holds an interpolation at {begin} to {until}")
		end 'part'
	end 'each'
	return b.finish(p.tree)
end 'byteStrLitParts'

// charLitParts reads the character literal that t is, a label's or a test name's token, and gives its text in the tree, decoded:
// one grapheme cluster, or E2016.
function charLitParts(mutates p Parser, t Token) returns diag.U32 throws SyntaxError
	let file = p.fileNumber()
	let open = lexemeStart(t)
	var r = stringReaderAt(p.src, file: file, open: open, collect: true)
	try r.readCharacter(p.src, errs: p.errors, until: t.endOffset())
	let text = String.from(exchange(r.buf, value: ByteArray.create(0)))
	if text.byteLength() == 0 or strGraphemeEnd(text, start: 0) != text.byteLength() 'notOne'
		p.errors.push(p.src.errorAt(diag.errInvalidCharacterLiteral, message: diag.invalidCharacterLiteral("a character literal must contain exactly one character"), file: file, offset: open))
		throw SyntaxError.refused
	end 'notOne'
	var b = ast.StrPartsBuilder.new()
	b.decoded(p.tree, text: text)
	return b.finish(p.tree)
end 'charLitParts'

// strKnownSimple is what the text operations (textops_gen.maxon) ask of a String's ASCII bit, which the parser keeps none of.
function strKnownSimple(text String) returns bool
	return false
end 'strKnownSimple'

// lexemeStart and lexemeEnd are where a token's source text begins and ends: a label's token leaves out its quotes.
function lexemeStart(t Token) returns Count
	if t.kind == TokenKind.label or t.kind == TokenKind.testName 'label'
		return before(t.start as Count)
	end 'label'
	return t.start as Count
end 'lexemeStart'

function lexemeEnd(t Token) returns Count
	if t.kind == TokenKind.label or t.kind == TokenKind.testName 'label'
		return after(t.endOffset())
	end 'label'
	return t.endOffset()
end 'lexemeEnd'

// startsLine reports whether a token of kind is the last thing before a new line's first token.
function startsLine(kind TokenKind) returns bool
	return kind == TokenKind.newline or kind == TokenKind.indent or kind == TokenKind.dedent or kind == TokenKind.fileEnd
end 'startsLine'

// lineFault is the fault of the line that would come after kept lines under rule, blank or not, the one before it
// being lastBlank.
function lineFault(rule BlankRule, kept Count, blank bool, lastBlank bool) returns Fault
	if blank and rule == BlankRule.noBlanks 'inBody'
		return Fault.make(BlankFault.extraBlank, message: blankInBody)
	end 'inBody'
	if blank and kept == 0 and rule == BlankRule.firstInFile 'fileStart'
		return Fault.make(BlankFault.extraBlank, message: "the file starts with a blank line")
	end 'fileStart'
	if blank and lastBlank 'twice'
		return Fault.make(BlankFault.extraBlank, message: "two blank lines in a row; keep one")
	end 'twice'
	if not blank and kept == 0 and rule == BlankRule.afterDecl 'afterDecl'
		return Fault.make(BlankFault.missingBlank, message: blankAfterDeclaration)
	end 'afterDecl'
	if not blank and kept == 0 and rule == BlankRule.beforeFunction 'beforeFunction'
		return Fault.make(BlankFault.missingBlank, message: blankBeforeFunction)
	end 'beforeFunction'
	return Fault.make(BlankFault.noFault, message: "")
end 'lineFault'

// endFault is the fault of the gap's end, when kept lines have come before the line that starts it, the last one
// blank or not, and that line is the end of the file or not.
function endFault(rule BlankRule, kept Count, lastBlank bool, atFileEnd bool) returns Fault
	if rule == BlankRule.afterDecl and kept == 0 and not atFileEnd 'afterDecl'
		return Fault.make(BlankFault.missingBlank, message: blankAfterDeclaration)
	end 'afterDecl'
	if rule == BlankRule.beforeFunction and kept == 0 'beforeFunction'
		return Fault.make(BlankFault.missingBlank, message: blankBeforeFunction)
	end 'beforeFunction'
	if lastBlank and atFileEnd 'fileEnd'
		return Fault.make(BlankFault.extraBlank, message: "the file ends with a blank line")
	end 'fileEnd'
	return Fault.make(BlankFault.noFault, message: "")
end 'endFault'

// isBlankLine is whether a line holds nothing but whitespace.
function isBlankLine(text String, from Count, until Count) returns bool
	for i in from upto until 'each'
		let c = text.byteAt(i)
		if c != byteSpace and c != byteTab and c != byteNewline 'code'
			return false
		end 'code'
	end 'each'
	return true
end 'isBlankLine'

function addTextPart(mutates p Parser, mutates parts ast.StrPartsBuilder, text String, begin Count, raw bool)
	if raw 'raw'
		let offset = try begin as diag.U32 otherwise panic("a string part starts past U32")
		let length = try text.byteLength() as diag.U32 otherwise panic("a string part is longer than U32")
		parts.run(offset, length: length)
		return
	end 'raw'
	parts.decoded(p.tree, text: text.clone())
end 'addTextPart'

// parseInterpolationAt parses the interpolation from begin to until with the parser's tokens and layout set aside: its
// first token follows its '{' with no space between them. A formatting parser formats it in a pass of its own and adds
// its text to formatted.
function parseInterpolationAt(mutates p Parser, begin Count, until Count, mutates formatted ast.StringList) returns ast.NodeID throws SyntaxError
	let file = p.fileNumber()
	let toks = try lexInterpolation(p.src, errs: p.errors, file: file, begin: begin, until: until, lenient: p.formatting)
	let savedToks = exchange(p.toks, value: toks)
	let savedFormat = exchange(p.format, value: Formatter.new())
	let savedPos = p.pos
	let savedEnd = p.prevEnd
	let savedKind = p.prevKind
	let savedJoin = p.joinNext
	let savedBlanks = p.blanks
	let keywordsBefore = p.nameWords.count()
	p.pos = 0 as Count
	p.prevEnd = begin
	p.prevKind = TokenKind.lBrace
	p.joinNext = true
	p.blanks = BlankRule.noBlanks
	var e = 0 as ast.NodeID
	var failed = false
	try 'interpolation'
		e = parseInterpolation(p)
	end 'interpolation' otherwise 'refused'
		failed = true
	end 'refused'
	addNameUses(p.nameUses, toks: p.toks, keywords: p.nameWords, from: keywordsBefore)
	p.toks = savedToks
	p.pos = savedPos
	p.prevEnd = savedEnd
	p.prevKind = savedKind
	p.joinNext = savedJoin
	p.blanks = savedBlanks
	let sub = exchange(p.format, value: savedFormat)
	if failed 'failed'
		throw SyntaxError.refused
	end 'failed'
	if p.formatting 'format'
		formatted.push(String.from(sub.out))
	end 'format'
	return e
end 'parseInterpolationAt'

// addNameUses adds to found each name among toks, the parsed tokens of a source or of an interpolation: a token of a name, or of
// a keyword that the parse took as a name, which keywords holds from the one at from on, in the order of the text.
function addNameUses(mutates found ast.NameUses, toks Tokens, keywords NameWords, from Count)
	var next = from
	for t in toks 'tokens'
		while next < keywords.count() and keywords.get(next) < t.start 'passed'
			next = after(next)
		end 'passed'
		var named = t.kind == TokenKind.name
		if not named and next < keywords.count() and keywords.get(next) == t.start 'keyword'
			named = true
		end 'keyword'
		if named 'name'
			found.push(ast.NameUse.make(t.start, length: t.length))
		end 'name'
	end 'tokens'
end 'addNameUses'

function parseInterpolation(mutates p Parser) returns ast.NodeID throws SyntaxError
	let e = try parseExpr(p)
	if not p.atEndOfInput() 'trailing'
		throw p.expected("the end of the interpolation")
	end 'trailing'
	return e
end 'parseInterpolation'

// pushDecl adds a declaration to a module's list, and after a type, an enum or a union the typealiases and the static lets its
// body declares, and after an extension the typealiases and the static lets it declares, each named by its owner and its own
// name: such a member is a declaration of the module like the others, with the type as its scope.
function pushDecl(mutates decls ast.DeclList, t ast.Tree, consumes d ast.Decl, unionNames ast.StringList)
	var nested = ast.DeclList.create(0)
	match d 'k'
		typeDecl(td) then nestedMemberDecls(td, out: nested, unionNames: unionNames)
		extensionDecl(xd) then extensionMemberDecls(xd, owner: ast.extensionOwnerName(t, xd: xd), out: nested)
		interfaceDecl(ifd) then interfaceMemberDecls(ifd, out: nested)
		funcDecl(_) then break
		constDecl(_) then break
		enumDecl(ed) then staticMemberDecls(ed.statics, owner: ed.name, visibility: ed.visibility, out: nested)
		unionDecl(ud) then staticMemberDecls(ud.statics, owner: ud.name, visibility: ud.visibility, out: nested)
		aliasDecl(_) then break
	end 'k'
	decls.push(d)
	for i in 0 upto nested.count() 'each'
		decls.push(nested[i].clone())
	end 'each'
end 'pushDecl'

function nestedMemberDecls(td ast.TypeDecl, mutates out ast.DeclList, unionNames ast.StringList)
	for i in 0 upto td.aliases.count() 'each'
		var a = td.aliases[i].clone()
		a.visibility = ast.nestedVisibility(td.visibility, member: a.visibility)
		a.name = ast.nestedAliasName(td.name, name: a.name)
		out.push(ast.Decl.aliasDecl(a))
	end 'each'
	staticMemberDecls(td.statics, owner: td.name, visibility: td.visibility, out: out)
	messageUnionDecl(td, out: out, unionNames: unionNames)
end 'nestedMemberDecls'

// messageUnionDecl files the message union of a type a message of which names a policy (README, "Overload policies"), or
// whose name the module writes before `.Message` (unionNames), as a posted message names it: a case for each export instance
// method, its message kinds in source order, whose payload is the message's parameters, so that a policy reads a message as
// one value of a closed set and the runtime posts one. Its cases are the methods' nodes and their types are the parameters'
// type references, as written. A type whose module names no union of it has none, so it costs nothing to compile.
function messageUnionDecl(td ast.TypeDecl, mutates out ast.DeclList, unionNames ast.StringList)
	var annotated = false
	for i in 0 upto td.methods.count() 'annotated'
		annotated = annotated or td.methods[i].isAnnotated
	end 'annotated'
	if not annotated and not unionNames.contains(td.name) 'none'
		return
	end 'none'
	var ud = ast.UnionDecl.make(td.id)
	ud.name = ast.nestedAliasName(td.name, name: ast.messageUnionMember)
	ud.visibility = td.visibility.clone()
	for i in 0 upto td.methods.count() 'methods'
		if not ast.isMessageKind(td.methods[i]) 'other'
			continue 'methods'
		end 'other'
		var kind = ast.UnionCaseDecl.make(td.methods[i].id)
		kind.name = td.methods[i].name.clone()
		for j in 0 upto td.methods[i].params.count() 'params'
			var field = td.methods[i].params[j].clone()
			field.convention = ""
			field.defaultRef = 0 as ast.NodeID
			kind.fields.push(field)
		end 'params'
		ud.cases.push(kind)
	end 'methods'
	out.push(ast.Decl.unionDecl(ud))
end 'messageUnionDecl'

// staticMemberDecls files the static lets of the body of the declaration owner, whose visibility bounds theirs.
function staticMemberDecls(statics ast.ConstDeclList, owner String, visibility String, mutates out ast.DeclList)
	for i in 0 upto statics.count() 'statics'
		var s = statics[i].clone()
		s.visibility = ast.nestedVisibility(visibility, member: s.visibility)
		s.name = ast.nestedAliasName(owner, name: s.name)
		out.push(ast.Decl.constDecl(s))
	end 'statics'
end 'staticMemberDecls'

// extensionMemberDecls files the typealiases and the static lets of an extension under the type it extends, as it writes it.
// Each keeps its own visibility, as the extension's methods do.
function extensionMemberDecls(xd ast.ExtensionDecl, owner String, mutates out ast.DeclList)
	for i in 0 upto xd.aliases.count() 'aliases'
		var a = xd.aliases[i].clone()
		a.name = ast.nestedAliasName(owner, name: a.name)
		out.push(ast.Decl.aliasDecl(a))
	end 'aliases'
	for i in 0 upto xd.statics.count() 'statics'
		var s = xd.statics[i].clone()
		s.name = ast.nestedAliasName(owner, name: s.name)
		out.push(ast.Decl.constDecl(s))
	end 'statics'
end 'extensionMemberDecls'

function interfaceMemberDecls(ifd ast.InterfaceDecl, mutates out ast.DeclList)
	for i in 0 upto ifd.aliases.count() 'each'
		var a = ifd.aliases[i].clone()
		a.visibility = ast.nestedVisibility(ifd.visibility, member: a.visibility)
		a.name = ast.nestedAliasName(ifd.name, name: a.name)
		out.push(ast.Decl.aliasDecl(a))
	end 'each'
end 'interfaceMemberDecls'

// parseDeclaration parses the declaration at the parser: a test, or one that Maxon.g4 names.
function parseDeclaration(mutates p Parser) returns ast.Decl throws SyntaxError
	if p.atTestDecl() 'test'
		let test = try parseTest(p)
		return ast.Decl.funcDecl(test)
	end 'test'
	return try parseDecl(p)
end 'parseDeclaration'

// baseName is the last part of a path.
function baseName(path String) returns String
	var start = 0 as Count
	for i in 0 upto path.byteLength() 'each'
		let c = path.byteAt(i)
		if c == byteSlash or c == byteBackslash 'separator'
			start = after(i)
		end 'separator'
	end 'each'
	return path.sliceBytes(start, endPos: path.byteLength()).clone()
end 'baseName'

// testFileName is the name of the file of tests that a file is renamed to, which has the name of the file with its extension
// made `.maxtest`.
function testFileName(file String) returns String
	let suffix = ".maxon"
	if file.endsWith(suffix) 'maxon'
		return "{file.sliceBytes(0 as Count, endPos: (try file.byteLength() - suffix.byteLength() otherwise 0 as Count))}{testFileExtension}"
	end 'maxon'
	return "{file}{testFileExtension}"
end 'testFileName'

// refuseAt records an error at the offset of the file that the parser is in, and abandons the declaration.
function refuseAt(mutates p Parser, consumes code String, consumes message String, at Count) returns SyntaxError
	let file = p.fileNumber()
	p.errors.push(p.src.errorAt(code, message: message, file: file, offset: at))
	return SyntaxError.refused
end 'refuseAt'

// parseTest parses a test, which is a function that no program calls: it has a name that is prose, no parameters and no
// result, and only a file of tests may hold one. Its function is named by the name it compiles to; the prose name is kept.
function parseTest(mutates p Parser) returns ast.FuncDecl throws SyntaxError
	let keyword = p.cur().clone()
	let named = p.peekTok().clone()
	let file = baseName(p.src.files[p.fileNumber()].path)
	if not p.layoutOnly and not file.endsWith(testFileExtension) 'outside'
		throw refuseAt(p, code: diag.errTestOutsideTestFile, message: diag.testOutsideTestFile(file, renamed: testFileName(file)), at: keyword.start as Count)
	end 'outside'
	if named.length == 0 'empty'
		throw refuseAt(p, code: diag.errTestEmptyName, message: diag.testEmptyName(), at: lexemeStart(named))
	end 'empty'
	let following = try p.at2()
	if following.kind != TokenKind.newline 'header'
		throw refuseAt(p, code: diag.errExpectedToken, message: "Expected newline after block label, got '{p.describe(following)}'", at: following.start as Count)
	end 'header'
	var test = try parseTestDecl(p)
	test.name = ast.testSymbol(test.testName)
	return test
end 'parseTest'

// parseProgram parses every declaration of a module's files. A syntax error abandons the rest of its file, so each
// file reports its own first error.
function parseProgram(mutates p Parser) returns ast.DeclList
	var decls = ast.DeclList.create(0)
	var count = 0 as Count
	var failed = false
	while not p.at(TokenKind.eof) 'decls'
		if p.at(TokenKind.fileEnd) 'fileEnd'
			if not failed 'check'
				p.blanks = blanksBefore(count)
				try 'layout'
					p.checkLayout()
				end 'layout' otherwise 'refused'
					failed = true
				end 'refused'
			end 'check'
			p.advance()
			p.fileIndex = after(p.fileIndex)
			count = 0 as Count
			failed = false
			continue 'decls'
		end 'fileEnd'
		var abandoned = false
		try 'decl'
			p.blanks = blanksBefore(count)
			let d = parseDeclaration(p)
			pushDecl(decls, t: p.tree, d: d, unionNames: p.unionNames)
			p.pass(TokenKind.newline, what: "the end of the line")
		end 'decl' otherwise 'refused'
			abandoned = true
		end 'refused'
		count = after(count)
		if abandoned 'skip'
			failed = true
			p.lists.reset()
			while not p.atEndOfInput() 'rest'
				p.advance()
			end 'rest'
		end 'skip'
	end 'decls'
	return decls
end 'parseProgram'

// unionNamesOf is each name the source writes just before `.Message`, once: the types whose message unions it may name, as
// `Conn.Message.readable()` does, which are declared for them (messageUnionDecl). A name of another module's type is its
// own module's to declare, which names it so too or names a policy.
function unionNamesOf(p Parser) returns ast.StringList
	var names = ast.StringList.create(0)
	var twoBack = TokenKind.eof
	var oneBack = TokenKind.eof
	var name = ""
	for t in p.toks 'tokens'
		if t.kind == TokenKind.name 'name'
			let text = p.text(t)
			if oneBack == TokenKind.dot and twoBack == TokenKind.name and text == ast.messageUnionMember and not names.contains(name) 'union'
				names.push(name.clone())
			end 'union'
			name = text
		end 'name'
		twoBack = oneBack
		oneBack = t.kind
	end 'tokens'
	return names
end 'unionNamesOf'

// blanksBefore is the rule for the blank lines before a file's next declaration, after count of them.
function blanksBefore(count Count) returns BlankRule
	if count > 0 'after'
		return BlankRule.afterDecl
	end 'after'
	return BlankRule.firstInFile
end 'blanksBefore'

// reservedPrefix starts the names that only the library tier declares, as maxon reserves them.
let reservedPrefix = "__"

// parseSourceInto parses the module of the handle from its source; a module of the library tier may declare its reserved
// names.
function parseSourceInto(module diag.ModuleID, consumes path String, consumes src Source, target ast.Target, libraryTier bool) returns ParseResult
	var errs = diag.ErrorList.create(0)
	var toks = Tokens.create(0)
	var failed = false
	try 'lex'
		toks = lexSource(src, errs: errs, lenient: false)
	end 'lex' otherwise 'refused'
		failed = true
	end 'refused'
	if failed 'lexError'
		return ParseResult.err(errs)
	end 'lexError'
	var resolved = Resolved.make(Tokens.create(0), lines: ast.StringList.create(0))
	try 'directives'
		resolved = resolveDirectives(src, toks: toks, target: target, formatting: false, errs: errs)
	end 'directives' otherwise 'unresolved'
		failed = true
	end 'unresolved'
	if failed 'directiveError'
		return ParseResult.err(errs)
	end 'directiveError'
	let files = src.files.clone()
	var p = Parser.new(src, toks: exchange(resolved.toks, value: Tokens.create(0)), module: module)
	p.libraryTier = libraryTier
	p.unionNames = unionNamesOf(p)
	let decls = parseProgram(p)
	addNameUses(p.nameUses, toks: p.toks, keywords: p.nameWords, from: 0)
	if p.errors.count() > 0 'syntaxErrors'
		return ParseResult.err(exchange(p.errors, value: diag.ErrorList.create(0)))
	end 'syntaxErrors'
	var m = ast.ParsedModule.new(module, text: "", files: files)
	m.tree = exchange(p.tree, value: ast.Tree.new(module, text: ""))
	m.decls = decls
	m.nameUses = exchange(p.nameUses, value: ast.NameUses.create(0))
	return ParseResult.ok(m)
end 'parseSourceInto'

export function parseSource(module diag.ModuleID, path String, consumes src String) returns ParseResult
	return parseSourceInto(module, path: path.clone(), src: sourceOf(src, path: path), target: ast.Target.windowsX64(), libraryTier: false)
end 'parseSource'

export function parseModuleFiles(module diag.ModuleID, consumes path String, consumes filePaths ast.StringList, consumes fileTexts ast.StringList, target ast.Target, libraryTier bool) returns ParseResult
	var buf = ByteArray.create(0)
	var files = ast.FileSpanList.create(0)
	var spans as Array with Count
	spans = Array.create(0)
	for i in 0 upto filePaths.count() 'concat'
		buf.append(fileTexts[i].toByteArray())
		spans.push(buf.count())
	end 'concat'
	let text = String.from(buf)
	var startOff = 0 as diag.U32
	for i in 0 upto filePaths.count() 'spans'
		let endOff = try spans[i] as diag.U32 otherwise panic("the module's text is larger than 4 GB; split the module")
		files.push(ast.FileSpan.make(filePaths[i].clone(), text: text, start: startOff, endOff: endOff))
		startOff = endOff
	end 'spans'
	return parseSourceInto(module, path: path, src: Source.make(text, files: files), target: target, libraryTier: libraryTier)
end 'parseModuleFiles'
