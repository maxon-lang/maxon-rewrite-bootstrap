// The first three bytes of a UTF-8 byte order mark, which the formatter drops.
let bomFirst = 239 as Byte

let bomSecond = 187 as Byte

let bomThird = 191 as Byte

// FormatResult is a source formatted, or the errors that stopped it: the text is then left as it was.
export union FormatResult
	formatted(text String)
	refused(errors diag.ErrorList)
end 'FormatResult'

// appendRange appends the bytes of text from begin until until.
function appendRange(mutates out ByteArray, text String, begin Count, until Count)
	for i in begin upto until 'each'
		out.push(text.byteAt(i))
	end 'each'
end 'appendRange'

// isSourceWhitespace is what a line's ends may hold that the formatter removes.
function isSourceWhitespace(c Byte) returns bool
	return c == byteSpace or c == byteTab or c == byteCR
end 'isSourceWhitespace'

// skipSourceWhitespace is where the text from begin until until starts once its leading whitespace is left out.
function skipSourceWhitespace(text String, begin Count, until Count) returns Count
	var at = begin
	while at < until and isSourceWhitespace(text.byteAt(at)) 'skip'
		at = after(at)
	end 'skip'
	return at
end 'skipSourceWhitespace'

// trimmedEnd is where the text from begin until until ends once its trailing whitespace is left out.
function trimmedEnd(text String, begin Count, until Count) returns Count
	var stop = until
	while stop > begin and isSourceWhitespace(text.byteAt(before(stop))) 'trim'
		stop = before(stop)
	end 'trim'
	return stop
end 'trimmedEnd'

// startsWithComment is whether the text from at until until starts a comment.
function startsWithComment(text String, at Count, until Count) returns bool
	return after(at) < until and text.byteAt(at) == byteSlash and text.byteAt(after(at)) == byteSlash
end 'startsWithComment'

// Formatter is the output of a parser that formats: the tokens of the program, each after the gap the layout puts before
// it.
type Formatter
	var out as ByteArray
	// depth is the indentation of the line being written, in tabs.
	var depth as Count
	// tokenStart is where the last token's text begins in out.
	var tokenStart as Count
	// regions is the number of `#if` regions around the line being written; a line is indented a tab for each.
	var regions as Count

	static function new() returns Formatter
		return Formatter{out: ByteArray.create(0), depth: 0 as Count, tokenStart: 0 as Count, regions: 0 as Count}
	end 'new'

	// tabsAt is the indentation of a line at the level, which the `#if` regions around it add to.
	function tabsAt(level Count) returns Count
		return try level + regions otherwise panic("the indentation overflows")
	end 'tabsAt'

	function indent(mutates self, tabs Count)
		for _ in 0 upto tabs 'each'
			out.push(byteTab)
		end 'each'
	end 'indent'

	function blankLine(mutates self)
		out.push(byteNewline)
	end 'blankLine'

	// dropBlankLine takes back the blank line just written.
	function dropBlankLine(mutates self)
		let n = out.count()
		let alone = n == 1 and out[0] == byteNewline
		let doubled = n >= 2 and out[before(n)] == byteNewline and out[before(before(n))] == byteNewline
		if not alone and not doubled 'unexpected'
			panic("the formatter is asked to drop a blank line where there is none")
		end 'unexpected'
		_ = try out.pop() otherwise panic("the formatter's output ran out while it dropped a blank line")
	end 'dropBlankLine'

	// gapLine writes a line of the gap before a line of code: a blank line, or a comment line indented like the code.
	function gapLine(mutates self, text String, begin Count, until Count, blank bool, tabs Count)
		if blank 'blank'
			self.blankLine()
			return
		end 'blank'
		self.indent(tabs)
		let first = skipSourceWhitespace(text, begin: begin, until: until)
		appendRange(out, text: text, begin: first, until: trimmedEnd(text, begin: first, until: until))
		out.push(byteNewline)
	end 'gapLine'

	// trailingComment writes the comment after code, if the text from begin until until, which ends where the line does,
	// holds one: one space after the code, with its own text unchanged.
	function trailingComment(mutates self, text String, begin Count, until Count)
		let first = skipSourceWhitespace(text, begin: begin, until: until)
		if startsWithComment(text, at: first, until: until) 'comment'
			out.push(byteSpace)
			appendRange(out, text: text, begin: first, until: trimmedEnd(text, begin: first, until: until))
		end 'comment'
	end 'trailingComment'

	// replaceString rewrites the string literal t, the last token written, with each interpolation formatted: formatted
	// holds the text of each of the string's interpolations, in order, and parts are its parts.
	function replaceString(mutates self, source String, t Token, parts StrParts, formatted ast.StringList)
		if formatted.count() == 0 'plain'
			return
		end 'plain'
		var interpolations = Spans.create(0)
		for i in 0 upto parts.count() 'each'
			match parts[i] 'part'
				text(run, begin, raw) then break
				expr(begin, until, _, _) then interpolations.push(Span.make(begin, until: until))
			end 'part'
		end 'each'
		var literal = ByteArray.create(0)
		var at = t.start as Count
		for i in 0 upto interpolations.count() 'splice'
			appendRange(literal, text: source, begin: at, until: interpolations[i].begin)
			literal.append(formatted[i].toByteArray())
			at = interpolations[i].until
		end 'splice'
		appendRange(literal, text: source, begin: at, until: t.endOffset())
		while out.count() > tokenStart 'cut'
			_ = out.pop()
		end 'cut'
		out.append(literal)
	end 'replaceString'
end 'Formatter'

// formatSource returns text, a Maxon source file, in the one layout the parser accepts: one space or none between
// tokens, one tab per indentation level, and blank lines exactly where the rules put them. It changes only the
// whitespace between tokens, the blank lines and the position of comments; every token, and every comment's text, stays.
// Line endings become LF, a byte order mark goes, and the file ends with a newline.
//
// Source whose layout is wrong still formats when the right layout is unambiguous. Whatever the lexer or the parser
// refuses beyond layout, such as indentation with spaces or a syntax error, is returned as errors.
export function formatSource(file String, text String) returns FormatResult
	let normal = normalizeLines(text)
	var errs = diag.ErrorList.create(0)
	var toks = Tokens.create(0)
	var failed = false
	try 'lex'
		toks = lexSource(sourceOf(normal.clone(), path: file), errs: errs, lenient: true)
	end 'lex' otherwise 'refused'
		failed = true
	end 'refused'
	if failed 'lexError'
		return FormatResult.refused(errs)
	end 'lexError'
	let src = sourceOf(normal.clone(), path: file)
	var resolved = Resolved.make(Tokens.create(0), lines: ast.StringList.create(0))
	try 'directives'
		resolved = resolveDirectives(src, toks: toks.clone(), target: ast.Target.windowsX64(), formatting: true, errs: errs)
	end 'directives' otherwise 'refused'
		return FormatResult.refused(errs)
	end 'refused'
	let laidOut = resolved.toks.clone()
	var p = Parser.new(src, toks: exchange(resolved.toks, value: Tokens.create(0)), module: 0 as diag.ModuleID)
	p.directives = exchange(resolved.lines, value: ast.StringList.create(0))
	p.formatting = true
	p.layoutOnly = true
	_ = parseProgram(p)
	if p.errors.count() > 0 'syntaxErrors'
		return FormatResult.refused(exchange(p.errors, value: diag.ErrorList.create(0)))
	end 'syntaxErrors'
	let out = String.from(p.format.out)
	verifyFormat(file, input: normal, toks: laidOut, out: out)
	return FormatResult.formatted(out)
end 'formatSource'

// normalizeLines drops a byte order mark, ends every line with a newline alone and ends the text with one.
function normalizeLines(text String) returns String
	let length = text.byteLength()
	var bytes = ByteArray.create(0)
	var at = 0 as Count
	if length >= 3 and text.byteAt(0 as Count) == bomFirst and text.byteAt(1 as Count) == bomSecond and text.byteAt(2 as Count) == bomThird 'bom'
		at = 3 as Count
	end 'bom'
	while at < length 'bytes'
		let c = text.byteAt(at)
		if not (c == byteCR and after(at) < length and text.byteAt(after(at)) == byteNewline) 'kept'
			bytes.push(c)
		end 'kept'
		at = after(at)
	end 'bytes'
	if bytes.count() > 0 and bytes[before(bytes.count())] != byteNewline 'unended'
		bytes.push(byteNewline)
	end 'unended'
	return String.from(bytes)
end 'normalizeLines'

// tokenHolds is whether the text of t, a token of the source, holds the byte c.
function tokenHolds(source String, t Token, c Byte) returns bool
	for i in t.start as Count upto t.endOffset() 'each'
		if source.byteAt(i) == c 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'tokenHolds'

// sameTokenText is whether t, a token of source, and u, a token of other, read alike.
function sameTokenText(source String, t Token, other String, u Token) returns bool
	if t.length != u.length 'length'
		return false
	end 'length'
	for i in 0 upto t.length as Count 'each'
		if source.byteAt((t.start as Count) + i) != other.byteAt((u.start as Count) + i) 'differs'
			return false
		end 'differs'
	end 'each'
	return true
end 'sameTokenText'

// verifyFormat checks the formatter's work, which a bug must never put in a file: the output has to pass the strict
// parser, and hold the tokens of the input, apart from the layout inside the interpolations of a string. The tokens
// compared are those of the program once its directives are resolved, as the branch of a directive is indented in the
// output whatever it was in the input.
function verifyFormat(file String, input String, toks Tokens, out String)
	var errs = diag.ErrorList.create(0)
	var again = Tokens.create(0)
	var failed = false
	try 'lex'
		again = lexSource(sourceOf(out.clone(), path: file), errs: errs, lenient: false)
	end 'lex' otherwise 'refused'
		failed = true
	end 'refused'
	if not failed 'parse'
		let src = sourceOf(out.clone(), path: file)
		var resolved = Resolved.make(Tokens.create(0), lines: ast.StringList.create(0))
		try 'directives'
			resolved = resolveDirectives(src, toks: again.clone(), target: ast.Target.windowsX64(), formatting: true, errs: errs)
		end 'directives' otherwise 'unresolved'
			failed = true
		end 'unresolved'
		if not failed 'check'
			again = resolved.toks.clone()
			var p = Parser.new(src, toks: exchange(resolved.toks, value: Tokens.create(0)), module: 0 as diag.ModuleID)
			p.layoutOnly = true
			_ = parseProgram(p)
			if p.errors.count() > 0 'refused'
				errs.push(p.errors.pop())
			end 'refused'
		end 'check'
	end 'parse'
	if errs.count() > 0 'unparsed'
		panic("the formatted {file} does not parse: {errs[0].format()}")
	end 'unparsed'
	if again.count() != toks.count() 'count'
		panic("formatting {file} changed its {toks.count()} tokens into {again.count()}")
	end 'count'
	for i in 0 upto toks.count() 'each'
		let same = toks[i].kind == again[i].kind and (sameTokenText(input, t: toks[i], other: out, u: again[i]) or (toks[i].kind == TokenKind.string and tokenHolds(input, t: toks[i], c: byteLBrace)))
		if not same 'changed'
			panic("formatting {file} changed token {i}")
		end 'changed'
	end 'each'
end 'verifyFormat'

let byteBacktick = 96 as Byte

// maxonFenceTag marks a fenced block as Maxon; a block with no tag is taken to be Maxon too, and one with any other tag
// (powershell, an IR listing) is left alone.
let maxonFenceTag = "maxon"

let codeFenceLength = 3 as Count

// Span is a range of a text, as offsets into it.
type Span
	var begin as Count
	var until as Count

	static function make(begin Count, until Count) returns Span
		return Span{begin: begin, until: until}
	end 'make'
end 'Span'

typealias Spans = Array with Span

// isAsciiSpace is whether c is white space as a Markdown fence tag leaves it out.
function isAsciiSpace(c Byte) returns bool
	return c == byteSpace or (c >= byteTab and c <= byteCR)
end 'isAsciiSpace'

// trimSpaceFrom is where the text from begin until until starts once its leading white space is left out.
function trimSpaceFrom(text String, begin Count, until Count) returns Count
	var at = begin
	while at < until and isAsciiSpace(text.byteAt(at)) 'skip'
		at = after(at)
	end 'skip'
	return at
end 'trimSpaceFrom'

// trimSpaceUntil is where the text from begin until until ends once its trailing white space is left out.
function trimSpaceUntil(text String, begin Count, until Count) returns Count
	var stop = until
	while stop > begin and isAsciiSpace(text.byteAt(before(stop))) 'trim'
		stop = before(stop)
	end 'trim'
	return stop
end 'trimSpaceUntil'

// lineEndAt is where the line that holds offset at ends: the offset of its newline, or the text's length.
function lineEndAt(text String, at Count) returns Count
	let length = text.byteLength()
	var stop = at
	while stop < length and text.byteAt(stop) != byteNewline 'scan'
		stop = after(stop)
	end 'scan'
	return stop
end 'lineEndAt'

// indentEnd is where the line from begin until until starts once the spaces and tabs that indent it are left out.
function indentEnd(text String, begin Count, until Count) returns Count
	var at = begin
	while at < until and (text.byteAt(at) == byteSpace or text.byteAt(at) == byteTab) 'indent'
		at = after(at)
	end 'indent'
	return at
end 'indentEnd'

// opensFence is whether the text from at until until starts with a code fence.
function opensFence(text String, at Count, until Count) returns bool
	let stop = try at + codeFenceLength otherwise panic("a code fence ends past the text")
	return stop <= until and text.byteAt(at) == byteBacktick and text.byteAt(after(at)) == byteBacktick and text.byteAt(after(after(at))) == byteBacktick
end 'opensFence'

// isMaxonFence is whether the tag after the fence from begin until until marks Maxon: it is empty or maxon.
function isMaxonFence(text String, begin Count, until Count) returns bool
	let first = trimSpaceFrom(text, begin: begin, until: until)
	let last = trimSpaceUntil(text, begin: first, until: until)
	return first == last or text.sliceBytes(first, endPos: last) == maxonFenceTag
end 'isMaxonFence'

// CodeRange is a range of a Markdown document that holds Maxon: a fenced block, whose text is a file of its own, or with
// block unset an inline code span, which is part of one line.
type CodeRange
	var span as Span
	var block as bool

	static function make(begin Count, until Count, block bool) returns CodeRange
		return CodeRange{span: Span.make(begin, until: until), block: block}
	end 'make'
end 'CodeRange'

typealias CodeRanges = Array with CodeRange

// indexOfByte is the offset of the first c from at until until, or until when there is none.
function indexOfByte(text String, c Byte, at Count, until Count) returns Count
	var stop = at
	while stop < until and text.byteAt(stop) != c 'scan'
		stop = after(stop)
	end 'scan'
	return stop
end 'indexOfByte'

// scanSpans adds to ranges each non-empty inline code span of the line from begin until until.
function scanSpans(text String, begin Count, until Count, mutates ranges CodeRanges)
	var at = begin
	while at < until 'spans'
		let open = indexOfByte(text, c: byteBacktick, at: at, until: until)
		if open == until 'noOpen'
			return
		end 'noOpen'
		let spanBegin = after(open)
		let close = indexOfByte(text, c: byteBacktick, at: spanBegin, until: until)
		if close == until 'noClose'
			return
		end 'noClose'
		if close > spanBegin 'filled'
			ranges.push(CodeRange.make(spanBegin, until: close, block: false))
		end 'filled'
		at = after(close)
	end 'spans'
end 'scanSpans'

// scanMarkdown finds the Maxon in a Markdown document, in text order: the text of each fenced block that is tagged maxon
// or not tagged, and with spans the inline code spans too, as offsets into the text.
function scanMarkdown(text String, spans bool) returns CodeRanges
	var found = CodeRanges.create(0)
	let length = text.byteLength()
	var at = 0 as Count
	while at < length 'lines'
		let lineEnd = lineEndAt(text, at: at)
		let first = indentEnd(text, begin: at, until: lineEnd)
		if opensFence(text, at: first, until: lineEnd) 'fence'
			var blockBegin = length
			if after(lineEnd) < length 'block'
				blockBegin = after(lineEnd)
			end 'block'
			let closing = closingFence(text, begin: blockBegin)
			if isMaxonFence(text, begin: after(after(after(first))), until: lineEnd) 'maxon'
				found.push(CodeRange.make(blockBegin, until: closing.begin, block: true))
			end 'maxon'
			at = closing.until
			continue 'lines'
		end 'fence'
		if spans 'inline'
			scanSpans(text, begin: at, until: lineEnd, ranges: found)
		end 'inline'
		at = after(lineEnd)
	end 'lines'
	return found
end 'scanMarkdown'

// closingFence finds the fence that closes a block whose text starts at begin: it gives where the block's text ends (the
// start of the closing fence's line) and where the text after the fence's line starts. An unclosed block runs to the end
// of the document.
function closingFence(text String, begin Count) returns Span
	let length = text.byteLength()
	var at = begin
	while at < length 'lines'
		let lineEnd = lineEndAt(text, at: at)
		var next = length
		if lineEnd < length 'newline'
			next = after(lineEnd)
		end 'newline'
		if opensFence(text, at: indentEnd(text, begin: at, until: next), until: next) 'fence'
			return Span.make(at, until: next)
		end 'fence'
		at = next
	end 'lines'
	return Span.make(length, until: length)
end 'closingFence'

// formatMarkdown returns the Markdown document text with the Maxon in its fenced blocks formatted: a block tagged maxon
// or not tagged that is a whole program. Prose, other blocks and blocks that do not parse stay as they are.
export function formatMarkdown(file String, text String) returns String
	let blocks = scanMarkdown(text, spans: false)
	var out = ByteArray.create(0)
	var at = 0 as Count
	for i in 0 upto blocks.count() 'blocks'
		let begin = blocks[i].span.begin
		let until = blocks[i].span.until
		appendRange(out, text: text, begin: at, until: begin)
		out.append(formattedBlock(file, block: text.sliceBytes(begin, endPos: until)).toByteArray())
		at = until
	end 'blocks'
	appendRange(out, text: text, begin: at, until: text.byteLength())
	return String.from(out)
end 'formatMarkdown'

// formattedBlock is the block with its Maxon formatted, or the block itself when it is not a whole program.
function formattedBlock(file String, block String) returns String
	if trimSpaceFrom(block, begin: 0 as Count, until: block.byteLength()) == block.byteLength() 'empty'
		return block.clone()
	end 'empty'
	match formatSource(file, text: block) 'result'
		formatted(text) then return withLineEndsOf(block, formatted: text)
		refused(errors) then return block.clone()
	end 'result'
end 'formattedBlock'

// withLineEndsOf is formatted, which ends its lines with LF, with the line endings of block: its last line ends as the
// block's does, and its lines with CRLF where the block's do.
function withLineEndsOf(block String, formatted String) returns String
	let length = block.byteLength()
	let endsLine = length > 0 and block.byteAt(before(length)) == byteNewline
	var crlf = false
	for i in 1 upto length 'scan'
		if block.byteAt(i) == byteNewline and block.byteAt(before(i)) == byteCR 'crlf'
			crlf = true
		end 'crlf'
	end 'scan'
	var stop = formatted.byteLength()
	if not endsLine and stop > 0 and formatted.byteAt(before(stop)) == byteNewline 'trim'
		stop = before(stop)
	end 'trim'
	var out = ByteArray.create(0)
	for i in 0 upto stop 'each'
		let c = formatted.byteAt(i)
		if c == byteNewline and crlf 'break'
			out.push(byteCR)
		end 'break'
		out.push(c)
	end 'each'
	return String.from(out)
end 'withLineEndsOf'
