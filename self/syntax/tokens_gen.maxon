// tokenSetMember is the character of a kind a set of token kinds holds: a set has a character per token kind the
// parser sees, in the order of their numbers.
let tokenSetMember = 49 as Byte

export function inTokenSet(set String, kind TokenKind) returns bool
	return kind.ordinal < set.byteLength() and set.byteAt(kind.ordinal) == tokenSetMember
end 'inTokenSet'

let tableBase = 32 as Count

let tableDigits = 2 as Count

let tableDigitZero = 48 as Count

// tableEntry is the entry at index of a table of the lexer: its high digit, then its low one.
function tableEntry(table String, index Count) returns Count
	let at = try index * tableDigits otherwise panic("a DFA table index overflows")
	let high = try (table.byteAt(at) as Count) - tableDigitZero otherwise panic("a DFA table holds a byte that is no digit")
	let low = try (table.byteAt(try at + 1 otherwise panic("a DFA table index overflows")) as Count) - tableDigitZero otherwise panic("a DFA table holds a byte that is no digit")
	return high * tableBase + low
end 'tableEntry'

// The lexer's DFA, compiled from every token rule and keyword of Maxon.g4. A state is a row of dfaNextTable, a
// column per byte class; state 0 is dead, as no token goes on from it, and dfaStart is the start.

let dfaClasses = 59 as Count

let dfaStart = 1 as Count

