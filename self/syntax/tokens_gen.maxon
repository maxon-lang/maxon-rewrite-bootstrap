// tokenKindAt is the token kind of a number, as a table holds it.
function tokenKindAt(ordinal Count) returns TokenKind
	return match ordinal 'kind'
		0 gives TokenKind.fileEnd
		1 gives TokenKind.indent
		2 gives TokenKind.dedent
		3 gives TokenKind.name
		4 gives TokenKind.integer
		5 gives TokenKind.floatNumber
		6 gives TokenKind.string
		7 gives TokenKind.byteString
		8 gives TokenKind.label
		9 gives TokenKind.newline
		10 gives TokenKind.lParen
		11 gives TokenKind.rParen
		12 gives TokenKind.lBrace
		13 gives TokenKind.rBrace
		14 gives TokenKind.comma
		15 gives TokenKind.colon
		16 gives TokenKind.dot
		17 gives TokenKind.lBracket
		18 gives TokenKind.rBracket
		19 gives TokenKind.plus
		20 gives TokenKind.minus
		21 gives TokenKind.star
		22 gives TokenKind.slash
		23 gives TokenKind.assign
		24 gives TokenKind.eqEq
		25 gives TokenKind.notEq
		26 gives TokenKind.lt
		27 gives TokenKind.le
		28 gives TokenKind.gt
		29 gives TokenKind.ge
		30 gives TokenKind.eof
		31 gives TokenKind.kw_export
		32 gives TokenKind.kw_public
		33 gives TokenKind.kw_static
		34 gives TokenKind.kw_function
		35 gives TokenKind.kw_from
		36 gives TokenKind.kw_mutates
		37 gives TokenKind.kw_consumes
		38 gives TokenKind.kw_destructs
		39 gives TokenKind.kw_self
		40 gives TokenKind.kw_returns
		41 gives TokenKind.kw_throws
		42 gives TokenKind.kw_end
		43 gives TokenKind.kw_sets
		44 gives TokenKind.kw__
		45 gives TokenKind.kw_let
		46 gives TokenKind.kw_type
		47 gives TokenKind.kw_is
		48 gives TokenKind.kw_noncopyable
		49 gives TokenKind.kw_var
		50 gives TokenKind.kw_as
		51 gives TokenKind.kw_extension
		52 gives TokenKind.kw_int
		53 gives TokenKind.kw_enum
		54 gives TokenKind.kw_union
		55 gives TokenKind.kw_typealias
		56 gives TokenKind.kw_to
		57 gives TokenKind.kw_upto
		58 gives TokenKind.kw_Self
		59 gives TokenKind.kw_with
		60 gives TokenKind.kw_uses
		61 gives TokenKind.kw_where
		62 gives TokenKind.kw_implements
		63 gives TokenKind.kw_and
		64 gives TokenKind.kw_interface
		65 gives TokenKind.kw_if
		66 gives TokenKind.kw_else
		67 gives TokenKind.kw_try
		68 gives TokenKind.kw_while
		69 gives TokenKind.kw_for
		70 gives TokenKind.kw_in
		71 gives TokenKind.kw_otherwise
		72 gives TokenKind.kw_throw
		73 gives TokenKind.kw_return
		74 gives TokenKind.kw_break
		75 gives TokenKind.kw_continue
		76 gives TokenKind.kw_when
		77 gives TokenKind.kw_match
		78 gives TokenKind.kw_default
		79 gives TokenKind.kw_or
		80 gives TokenKind.kw_then
		81 gives TokenKind.kw_fallthrough
		82 gives TokenKind.kw_gives
		83 gives TokenKind.kw_not
		84 gives TokenKind.kw_mod
		85 gives TokenKind.kw_shl
		86 gives TokenKind.kw_shr
		87 gives TokenKind.kw_xor
		88 gives TokenKind.kw_ignore
		89 gives TokenKind.kw_true
		90 gives TokenKind.kw_false
		91 gives TokenKind.kw_panic
		92 gives TokenKind.whitespace
		93 gives TokenKind.lineComment
		94 gives TokenKind.blockComment
		95 gives TokenKind.noToken
		default panic("no token kind has this number")
	end 'kind'
end 'tokenKindAt'

// tokenSetMember is the character of a kind a set of token kinds holds: a set has a character per token kind the
// parser sees, in the order of their numbers.
let tokenSetMember = 49 as Byte

export function inTokenSet(set String, kind TokenKind) returns bool
	return kind.ordinal < set.byteLength() and set.byteAt(kind.ordinal) == tokenSetMember
end 'inTokenSet'

let tableBase = 32 as Count

let tableDigits = 2 as Count

let tableDigitZero = 48 as Count

// tableEntry is the entry at index of a table of the lexer: its high digit, then its low one.
function tableEntry(table String, index Count) returns Count
	let at = try index * tableDigits otherwise panic("a DFA table index overflows")
	let high = try (table.byteAt(at) as Count) - tableDigitZero otherwise panic("a DFA table holds a byte that is no digit")
	let low = try (table.byteAt(try at + 1 otherwise panic("a DFA table index overflows")) as Count) - tableDigitZero otherwise panic("a DFA table holds a byte that is no digit")
	return try high * tableBase + low otherwise panic("a DFA table entry overflows")
end 'tableEntry'

// The lexer's DFA, compiled from every token rule and keyword of Maxon.g4. A state is a row of dfaNextTable, a
// column per byte class; state 0 is dead, as no token goes on from it, and dfaStart is the start.

let dfaClasses = 54 as Count

let dfaStart = 1 as Count

