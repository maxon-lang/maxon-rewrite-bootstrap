let byteTab = 9 as Byte

let byteNewline = 10 as Byte

let byteCR = 13 as Byte

let byteSpace = 32 as Byte

let byteQuote = 34 as Byte

let byteApostrophe = 39 as Byte

let byteHash = 35 as Byte

let byteLParen = 40 as Byte

let byteRParen = 41 as Byte

let byteStar = 42 as Byte

let byteDot = 46 as Byte

let byteSlash = 47 as Byte

let byteZero = 48 as Byte

let byteNine = 57 as Byte

let byteColon = 58 as Byte

let byteUpperA = 65 as Byte

let byteUpperF = 70 as Byte

let byteUpperZ = 90 as Byte

let byteLBracket = 91 as Byte

let byteBackslash = 92 as Byte

let byteRBracket = 93 as Byte

let byteUnderscore = 95 as Byte

let byteLowerA = 97 as Byte

let byteLowerB = 98 as Byte

let byteLowerF = 102 as Byte

let byteLowerN = 110 as Byte

let byteLowerO = 111 as Byte

let byteLowerR = 114 as Byte

let byteLowerT = 116 as Byte

let byteLowerU = 117 as Byte

let byteLowerX = 120 as Byte

let byteLowerZ = 122 as Byte

let byteLBrace = 123 as Byte

let byteRBrace = 125 as Byte

// maxTokenLength is the longest token: a token keeps its length in 24 bits.
let maxTokenLength = 16777215 as Count

// The bytes that start a UTF-8 sequence of two, three and four bytes are at least these, and a byte after the first
// holds utf8ContinuationBits under utf8ContinuationTag.
let utf8Lead2 = 192 as Count

let utf8Lead3 = 224 as Count

let utf8Lead4 = 240 as Count

let utf8ContinuationTag = 128 as Count

let utf8ContinuationBits = 63 as Count

// utf8Max1 and utf8Max2 are the first code points that take two and three bytes.
let utf8Max1 = 128 as Count

let utf8Max2 = 2048 as Count

// The surrogates are no Unicode scalar values, so an escape may not write one (E1004).
let surrogateFirst = 55296 as Count

let surrogateLast = 57343 as Count

let replacementCharacter = 65533 as Count

// A byte string holds the bytes 0 to 255, and each character of its text is one of them: the code points up to U+00FF.
let byteStringMax = 255 as Count

// The bits of a UTF-8 lead byte that belong to the code point, for a sequence of two, three and four bytes.
let utf8Lead2Bits = 31 as Count

let utf8Lead3Bits = 15 as Count

let utf8Lead4Bits = 7 as Count

let utf8ContinuationShift = 6 as Count

// byteEscapeForm is how the message for a character that is no byte spells the escape that writes any byte.
let byteEscapeForm = "\\xNN"

let hexDigitValue = 10 as Count

// A code point is shown with at least this many hex digits.
let codepointDigits = 4 as Count

let hexDigits = "0123456789abcdef"

let hexRadix = 16 as Count

let newlineText = "\\n"

let fileEndText = "<end of file>"

let eofText = "<eof>"

let stringText = "\"...\""

// Token is a token's kind and where it is in the module text. Its text, value and position are read from the text
// when they are needed. A label's token covers the text between its quotes.
export type Token
	export var kind as TokenKind
	export var start as diag.U32
	export var length as diag.U32

	export static function make(kind TokenKind, start diag.U32, length diag.U32) returns Token
		return Token{kind: kind, start: start, length: length}
	end 'make'

	export function endOffset() returns Count
		return try (start as Count) + (length as Count) otherwise panic("a token ends past U32")
	end 'endOffset'

	export function text(src String) returns String
		return src.sliceBytes(start as Count, endPos: self.endOffset()).clone()
	end 'text'
end 'Token'

export typealias Tokens = Array with Token

// StrPart is a part of a string literal: a run of its text, which is the module's text from begin when raw and text an
// escape changed otherwise, or an interpolation, the offsets of its expression in the module text and those of the format
// specifier after its colon, which are the same where it has none.
export union StrPart
	text(text String, begin Count, raw bool)
	expr(begin Count, until Count, specBegin Count, specUntil Count)
end 'StrPart'

export typealias StrParts = Array with StrPart

typealias Offsets = Array with Count

export union LexResult
	ok(tokens Tokens)
	err(error diag.CompileError)
end 'LexResult'

// after is the offset after at: a module's text is at most 4 GB, so it never overflows.
function after(at Count) returns Count
	return try at + 1 otherwise panic("a source offset overflows")
end 'after'

// before is the offset before at, where the text has a byte there.
function before(at Count) returns Count
	return try at - 1 otherwise panic("a source offset is before the text")
end 'before'

function isAsciiDigit(c Byte) returns bool
	return c >= byteZero and c <= byteNine
end 'isAsciiDigit'

function isAsciiHexDigit(c Byte) returns bool
	return isAsciiDigit(c) or (c >= byteLowerA and c <= byteLowerF) or (c >= byteUpperA and c <= byteUpperF)
end 'isAsciiHexDigit'

function hexDigit(ch Byte) returns Count
	if isAsciiDigit(ch) 'digit'
		return try (ch as Count) - (byteZero as Count) otherwise panic("a digit is below '0'")
	end 'digit'
	if ch >= byteLowerA 'lower'
		return try (ch as Count) - (byteLowerA as Count) + hexDigitValue otherwise panic("a hex digit is below 'a'")
	end 'lower'
	return try (ch as Count) - (byteUpperA as Count) + hexDigitValue otherwise panic("a hex digit is below 'A'")
end 'hexDigit'

// runeAt is the character at the offset, as a syntax error shows it.
function runeAt(text String, at Count, limit Count) returns String
	if at >= limit 'none'
		return ""
	end 'none'
	let n = runeLength(text, at: at, limit: limit)
	if n == 0 'invalid'
		var shown = ByteArray.create(0)
		appendRune(shown, ch: replacementCharacter)
		return String.from(shown)
	end 'invalid'
	return text.sliceBytes(at, endPos: try at + n otherwise limit).clone()
end 'runeAt'

// The lowest lead byte of a sequence that can be valid, the first that cannot (its code points would pass U+10FFFF), and
// the lead bytes whose second byte has a narrower range: E0 and F0 (utf8Lead3 and utf8Lead4), where a lower one would be an overlong form, and ED
// and F4, where a higher one would be a surrogate or past U+10FFFF.
let utf8LeadMin = 194 as Count

let utf8LeadPast = 245 as Count

let utf8LeadED = 237 as Count

let utf8LeadF4 = 244 as Count

let utf8ContinuationLast = 191 as Count

let utf8SecondAfterE0 = 160 as Count

let utf8SecondBeforeED = 159 as Count

let utf8SecondAfterF0 = 144 as Count

let utf8SecondBeforeF4 = 143 as Count

// runeLength is the number of bytes of the UTF-8 sequence at the offset, or 0 when the bytes there are no valid
// sequence: the rule Go's utf8.DecodeRune applies, so an error names a byte that starts no character as U+FFFD.
function runeLength(text String, at Count, limit Count) returns Count
	let lead = text.byteAt(at) as Count
	if lead < utf8Max1 'ascii'
		return 1 as Count
	end 'ascii'
	if lead < utf8LeadMin or lead >= utf8LeadPast 'badLead'
		return 0 as Count
	end 'badLead'
	var n = 2 as Count
	if lead >= utf8Lead4 'four'
		n = 4 as Count
	end 'four' else if lead >= utf8Lead3 'three'
		n = 3 as Count
	end 'three'
	let stop = try at + n otherwise return 0 as Count
	if stop > limit 'short'
		return 0 as Count
	end 'short'
	var low = utf8ContinuationTag
	var high = utf8ContinuationLast
	if lead == utf8Lead3 'e0'
		low = utf8SecondAfterE0
	end 'e0' else if lead == utf8LeadED 'ed'
		high = utf8SecondBeforeED
	end 'ed' else if lead == utf8Lead4 'f0'
		low = utf8SecondAfterF0
	end 'f0' else if lead == utf8LeadF4 'f4'
		high = utf8SecondBeforeF4
	end 'f4'
	for i in 1 upto n 'continuation'
		let b = text.byteAt(try at + i otherwise return 0 as Count) as Count
		if b < low or b > high 'outside'
			return 0 as Count
		end 'outside'
		low = utf8ContinuationTag
		high = utf8ContinuationLast
	end 'continuation'
	return n
end 'runeLength'

// codepointAt is the code point of the UTF-8 sequence of n bytes at the offset, which runeLength found valid.
function codepointAt(text String, at Count, n Count) returns Count
	var cp = text.byteAt(at) as Count
	if n == 2 'two'
		cp = cp and utf8Lead2Bits
	end 'two' else if n == 3 'three'
		cp = cp and utf8Lead3Bits
	end 'three' else 'four'
		cp = cp and utf8Lead4Bits
	end 'four'
	for i in 1 upto n 'continuations'
		let next = text.byteAt(try at + i otherwise panic("a source offset overflows")) as Count
		cp = try (cp shl utf8ContinuationShift) or (next and utf8ContinuationBits) otherwise panic("a code point exceeds a word")
	end 'continuations'
	return cp
end 'codepointAt'

// codepointText is a code point as U+ and its hex digits, at least four.
function codepointText(cp Count) returns String
	return "U+{hexText(cp, width: codepointDigits)}"
end 'codepointText'

// appendRune appends the UTF-8 bytes of a code point an escape writes, which is at most four hex digits and no surrogate.
function appendRune(mutates buf ByteArray, ch Count)
	if ch < utf8Max1 'one'
		buf.push(try ch as Byte otherwise panic("a one-byte rune exceeds a byte"))
		return
	end 'one'
	if ch < utf8Max2 'two'
		buf.push(try (utf8Lead2 or (ch shr 6)) as Byte otherwise panic("a two-byte rune exceeds a byte"))
		buf.push(try (utf8ContinuationTag or (ch and utf8ContinuationBits)) as Byte otherwise panic("a continuation exceeds a byte"))
		return
	end 'two'
	buf.push(try (utf8Lead3 or (ch shr 12)) as Byte otherwise panic("a three-byte rune exceeds a byte"))
	buf.push(try (utf8ContinuationTag or ((ch shr 6) and utf8ContinuationBits)) as Byte otherwise panic("a continuation exceeds a byte"))
	buf.push(try (utf8ContinuationTag or (ch and utf8ContinuationBits)) as Byte otherwise panic("a continuation exceeds a byte"))
end 'appendRune'

type Lexer
	var file as Count
	var pos as Count
	var limit as Count
	// inline is set for an interpolation, which starts at begin.
	var inline as bool
	// lenient accepts what has one correct layout and so one meaning, for the formatter to correct: extra whitespace
	// between tokens and at the end of a line, whitespace on a blank line, a comment indented or spaced as it likes.
	// Indentation of code stays strict, since another one would change what the program says.
	var lenient as bool
	var begin as Count
	var depth as Count
	// indent is the indentation, in tabs, of the last code line.
	var indent as Count
	var tokens as Tokens
	var errors as diag.ErrorList

	static function make(file Count, pos Count, limit Count, inline bool, lenient bool) returns Lexer
		return Lexer{file: file, pos: pos, limit: limit, inline: inline, lenient: lenient, begin: pos, depth: 0 as Count, indent: 0 as Count, tokens: Tokens.create(0), errors: diag.ErrorList.create(0)}
	end 'make'

	// fail records the error at the offset, which is what the lexer then throws.
	function fail(mutates self, src Source, consumes message String, at Count) returns SyntaxError
		return self.failWith(src, code: diag.errUnexpectedToken, message: message, at: at)
	end 'fail'

	function failWith(mutates self, src Source, consumes code String, consumes message String, at Count) returns SyntaxError
		errors.push(src.errorAt(code, message: message, file: file, offset: at))
		return SyntaxError.refused
	end 'failWith'

	function finish(mutates self, src Source, at Count) throws SyntaxError
		try self.emit(src, kind: TokenKind.eof, start: at, stop: at)
	end 'finish'

	function lexFile(mutates self, src Source, index Count, from Count, until Count) throws SyntaxError
		file = index
		pos = from
		limit = until
		depth = 0 as Count
		indent = 0 as Count
		if from < until and src.text.byteAt(before(until)) != byteNewline 'unended'
			throw self.fail(src, message: "the file does not end with a newline", at: until)
		end 'unended'
		while pos < limit 'lines'
			try self.lineStart(src)
			if pos < limit 'code'
				try self.lexLine(src)
			end 'code'
		end 'lines'
		let stop = limit
		while indent > 0 'dedents'
			try self.emit(src, kind: TokenKind.dedent, start: stop, stop: stop)
			indent = before(indent)
		end 'dedents'
		try self.emit(src, kind: TokenKind.fileEnd, start: stop, stop: stop)
	end 'lexFile'

	function emit(mutates self, src Source, kind TokenKind, start Count, stop Count) throws SyntaxError
		let length = try stop - start otherwise panic("a token ends before it starts")
		if length > maxTokenLength 'long'
			throw self.fail(src, message: "a token is longer than 16 MB; split it", at: start)
		end 'long'
		let at = try start as diag.U32 otherwise panic("a token starts past U32")
		let n = try length as diag.U32 otherwise panic("a token is longer than U32")
		tokens.push(Token.make(kind, start: at, length: n))
	end 'emit'

	// lineStart reads the blank lines and comment lines before the next code line, and that line's indentation. A line
	// is indented with tabs only, at most one more than the code line before it; a comment line is indented like the
	// code line after it, or not at all at the end of the file.
	function lineStart(mutates self, src Source) throws SyntaxError
		var comments = Offsets.create(0)
		while pos < limit 'lines'
			let lineBegin = pos
			while src.text.byteAt(pos) == byteTab 'tabs'
				pos = after(pos)
			end 'tabs'
			let tabs = try pos - lineBegin otherwise panic("a line starts after its tabs")
			let c = src.text.byteAt(pos)
			if c == byteNewline 'blank'
				if tabs > 0 and not lenient 'tabbed'
					throw self.fail(src, message: "a blank line holds tabs; remove the trailing whitespace", at: lineBegin)
				end 'tabbed'
				pos = after(pos)
				continue 'lines'
			end 'blank'
			if (c == byteSpace or c == byteCR) and lenient 'spaceLine'
				let skipped = try self.skipSpaceLine(src)
				if skipped 'whole'
					continue 'lines'
				end 'whole'
			end 'spaceLine'
			let at = pos
			if c == byteSpace 'space'
				throw self.fail(src, message: "a line is indented with a space; indent with tabs only", at: at)
			end 'space'
			if c == byteSlash and src.text.byteAt(after(at)) == byteSlash 'comment'
				if not lenient 'checked'
					comments.push(lineBegin)
				end 'checked'
				let stop = try self.comment(src, start: at)
				pos = after(stop)
				continue 'lines'
			end 'comment'
			for i in 0 upto comments.count() 'aligned'
				try self.checkCommentIndent(src, lineBegin: comments[i], tabs: tabs)
			end 'aligned'
			let deeper = try indent + 1 otherwise panic("the indentation overflows")
			if tabs > deeper 'tooDeep'
				throw self.fail(src, message: "a line is indented more than one tab deeper than the line above", at: lineBegin)
			end 'tooDeep' else if tabs == deeper 'indented'
				try self.emit(src, kind: TokenKind.indent, start: at, stop: at)
			end 'indented' else 'dedented'
				for _ in tabs upto indent 'dedents'
					try self.emit(src, kind: TokenKind.dedent, start: at, stop: at)
				end 'dedents'
			end 'dedented'
			indent = tabs
			return
		end 'lines'
		for i in 0 upto comments.count() 'trailing'
			try self.checkCommentIndent(src, lineBegin: comments[i], tabs: 0 as Count)
		end 'trailing'
	end 'lineStart'

	// skipSpaceLine skips the line at pos if it holds only whitespace, or whitespace and a comment, whatever its
	// indentation: neither says anything the formatter cannot put right. It reports whether it did.
	function skipSpaceLine(mutates self, src Source) returns bool throws SyntaxError
		var at = pos
		var c = src.text.byteAt(at)
		while c == byteSpace or c == byteTab or c == byteCR 'blanks'
			if c == byteCR 'cr'
				_ = try textCharacter(src, errs: errors, file: file, at: at, limit: limit)
			end 'cr'
			at = after(at)
			c = src.text.byteAt(at)
		end 'blanks'
		if c == byteNewline 'blank'
			pos = after(at)
			return true
		end 'blank'
		if c == byteSlash and src.text.byteAt(after(at)) == byteSlash 'comment'
			let stop = try self.comment(src, start: at)
			pos = after(stop)
			return true
		end 'comment'
		return false
	end 'skipSpaceLine'

	function checkCommentIndent(mutates self, src Source, lineBegin Count, tabs Count) throws SyntaxError
		var got = 0 as Count
		while src.text.byteAt(try lineBegin + got otherwise panic("a comment line overflows")) == byteTab 'tabs'
			got = after(got)
		end 'tabs'
		if got != tabs 'misaligned'
			throw self.fail(src, message: "a comment line is indented {got} tabs, but the code line after it {tabs}; indent them alike", at: lineBegin)
		end 'misaligned'
	end 'checkCommentIndent'

	// comment checks the comment at start, which runs to the end of its line, and returns where the line ends.
	function comment(mutates self, src Source, start Count) returns Count throws SyntaxError
		var stop = start
		while stop < limit 'scan'
			let c = src.text.byteAt(stop)
			if c < byteSpace or c >= byteDelete 'checked'
				if c == byteNewline 'end'
					break 'scan'
				end 'end'
				stop = try textCharacter(src, errs: errors, file: file, at: stop, limit: limit)
				continue 'scan'
			end 'checked'
			stop = after(stop)
		end 'scan'
		let last = src.text.byteAt(before(stop))
		if (last == byteSpace or last == byteTab or last == byteCR) and not lenient 'trailing'
			throw self.fail(src, message: "a comment ends with whitespace; remove it", at: before(stop))
		end 'trailing'
		return stop
	end 'comment'

	// lexLine runs the generated DFA (tokens_gen.maxon) from each position to the longest token there, up to the end
	// of the line. It never backs off: a match that stops in a state accepting no token is an error naming the
	// unfinished token.
	function lexLine(mutates self, src Source) throws SyntaxError
		let lineFirst = tokens.count()
		while pos < limit 'tokens'
			var start = pos
			// Most tokens follow one space; step over it here rather than in a round of the DFA. Any other
			// whitespace goes through the DFA, whose whitespace case checks it.
			if src.text.byteAt(start) == byteSpace and after(start) < limit and not (inline and start == begin) 'oneSpace'
				let c = src.text.byteAt(after(start))
				if c != byteSpace and c != byteTab and c != byteCR and c != byteNewline 'step'
					start = after(start)
				end 'step'
			end 'oneSpace'
			var state = dfaStart
			var i = start
			while i < limit 'run'
				let next = dfaNext(state, class: dfaClass(src.text.byteAt(i)))
				if next == 0 'dead'
					break 'run'
				end 'dead'
				state = next
				i = after(i)
			end 'run'
			var kind = dfaAccept(state)
			if self.isIntegerBeforePoint(src, kind: kind, start: start, stop: i) 'integer'
				kind = TokenKind.integer
				i = start
				while src.text.byteAt(i) != byteDot 'digits'
					i = after(i)
				end 'digits'
			end 'integer'
			if kind == TokenKind.noToken 'unfinished'
				throw self.unfinished(src, state: state, start: start)
			end 'unfinished'
			if kind == TokenKind.whitespace or kind == TokenKind.lineComment 'skipped'
				let resume = try self.skipped(src, kind: kind, start: start, stop: i)
				pos = resume
				continue 'tokens'
			end 'skipped'
			if kind == TokenKind.blockComment 'block'
				throw self.fail(src, message: "a block comment is not allowed; write // comments on their own lines or after code", at: start)
			end 'block'
			if inTokenSet(tokenScanned, kind: kind) 'scanned'
				i = try scanRest(src, errs: errors, file: file, kind: kind, start: start)
			end 'scanned'
			pos = i
			if kind == TokenKind.newline 'newline'
				if depth > 0 and self.opensDirective(lineFirst) 'directive'
					// A condition with a parenthesis left open is the directive's to refuse, at the token that closes none.
					depth = 0 as Count
				end 'directive'
				if depth > 0 'inParens'
					throw self.fail(src, message: "a line breaks inside parentheses; keep what they hold on one line", at: start)
				end 'inParens'
				try self.emit(src, kind: kind, start: start, stop: i)
				return
			end 'newline' else if kind == TokenKind.lParen or kind == TokenKind.lBrace 'open'
				depth = after(depth)
			end 'open' else if kind == TokenKind.rParen or kind == TokenKind.rBrace 'close'
				if depth > 0 'nested'
					depth = before(depth)
				end 'nested'
			end 'close' else if kind == TokenKind.label or kind == TokenKind.testName 'label'
				// A label's or a test name's token is the text between its quotes.
				start = after(start)
				i = before(i)
				if kind == TokenKind.testName 'name'
					try self.checkText(src, start: start, stop: i)
				end 'name'
			end 'label'
			try self.emit(src, kind: kind, start: start, stop: i)
		end 'tokens'
	end 'lexLine'

	// checkText checks the text from start to stop that the DFA read as a test name, which holds any character.
	function checkText(mutates self, src Source, start Count, stop Count) throws SyntaxError
		var at = start
		while at < stop 'chars'
			let c = src.text.byteAt(at)
			if c < byteSpace or c >= byteDelete 'checked'
				at = try textCharacter(src, errs: errors, file: file, at: at, limit: stop)
				continue 'chars'
			end 'checked'
			at = after(at)
		end 'chars'
	end 'checkText'

	// opensDirective is whether the line whose first token is the one at first is a `#if`.
	function opensDirective(first Count) returns bool
		return tokens.count() > first and tokens[first].kind == TokenKind.hashIf
	end 'opensDirective'

	// isIntegerBeforePoint is whether the DFA, which reads the longest token and never backs off, took a `.` after the
	// digits from start for the point of a float when the number is an integer. That is so where a number follows a `.`,
	// as an element index does, so `t.0.1` reaches into a tuple and takes no fraction, and where the point is no
	// fraction's: `21.doubled()` calls a method, and the DFA stops after `21.`, in a state that no float finishes.
	function isIntegerBeforePoint(src Source, kind TokenKind, start Count, stop Count) returns bool
		if kind == TokenKind.floatNumber 'float'
			let n = tokens.count()
			return n > 0 and tokens[before(n)].kind == TokenKind.dot
		end 'float'
		if kind != TokenKind.noToken 'token'
			return false
		end 'token'
		let first = src.text.byteAt(start)
		return first >= byteZero and first <= byteNine and src.text.byteAt(before(stop)) == byteDot
	end 'isIntegerBeforePoint'

	// skipped is where lexLine goes on after the whitespace or the comment from start to stop, which are not tokens.
	// They are checked here, off lexLine's path: whitespace is an error unless it is the one space lexLine steps over,
	// which never reaches here, and so is a comment inside an interpolation or one that touches the code before it; the
	// lenient lexer accepts the whitespace and the comment's position, but not a carriage return that ends no line, which
	// is no layout to correct.
	function skipped(mutates self, src Source, kind TokenKind, start Count, stop Count) returns Count throws SyntaxError
		if kind == TokenKind.whitespace 'space'
			if not lenient 'strict'
				throw self.badSpace(src, start: start, stop: stop)
			end 'strict'
			for at in start upto stop 'each'
				if src.text.byteAt(at) == byteCR 'cr'
					_ = try textCharacter(src, errs: errors, file: file, at: at, limit: limit)
				end 'cr'
			end 'each'
			return stop
		end 'space'
		if inline 'interpolation'
			throw self.fail(src, message: "a comment inside an interpolation; move it after the line", at: start)
		end 'interpolation'
		if src.text.byteAt(before(start)) != byteSpace and not lenient 'touching'
			throw self.fail(src, message: "a comment after code is separated from it by one space", at: start)
		end 'touching'
		return try self.comment(src, start: start)
	end 'skipped'

	// badSpace is the error for whitespace inside a line that is not the one space lexLine steps over between two
	// tokens.
	function badSpace(mutates self, src Source, start Count, stop Count) returns SyntaxError
		for at in start upto stop 'each'
			let c = src.text.byteAt(at)
			if c == byteTab 'tab'
				return self.fail(src, message: "a tab inside a line; tabs only indent, and tokens are separated by one space", at: at)
			end 'tab'
			if c == byteCR 'cr'
				// A carriage return that ends no line is a control character; one before a newline breaks only the layout.
				try 'encoding'
					_ = textCharacter(src, errs: errors, file: file, at: at, limit: limit)
				end 'encoding' otherwise 'control'
					return SyntaxError.refused
				end 'control'
				return self.fail(src, message: "a carriage return; end lines with a newline alone", at: at)
			end 'cr'
		end 'each'
		if stop == limit or src.text.byteAt(stop) == byteNewline 'trailing'
			return self.fail(src, message: "trailing whitespace; remove it", at: start)
		end 'trailing'
		if inline and start == begin 'interpolation'
			return self.fail(src, message: "a space at the start of an interpolation; remove it", at: start)
		end 'interpolation'
		if stop > after(start) 'several'
			return self.fail(src, message: "tokens are separated by one space, not several", at: start)
		end 'several'
		panic("the space is one space between two tokens, which lexLine steps over")
	end 'badSpace'

	// unfinished is the error for input that stops in a state accepting no token.
	function unfinished(mutates self, src Source, state Count, start Count) returns SyntaxError
		// A directive and a block comment are known by their first bytes, and maxon names what is wrong with each.
		let first = src.text.byteAt(start)
		if first == byteHash 'directive'
			var nameEnd = after(start)
			while nameEnd < limit and src.text.byteAt(nameEnd) >= byteLowerA and src.text.byteAt(nameEnd) <= byteLowerZ 'name'
				nameEnd = after(nameEnd)
			end 'name'
			return self.failWith(src, code: diag.errUnknownDirective, message: diag.unknownDirective(src.text.sliceBytes(after(start), endPos: nameEnd).clone()), at: start)
		end 'directive'
		if first == byteSlash and after(start) < limit and src.text.byteAt(after(start)) == byteStar 'blockComment'
			return self.failWith(src, code: diag.errUnterminatedBlockComment, message: diag.unterminatedBlockComment(), at: start)
		end 'blockComment'
		let msg = dfaIncomplete(state)
		if msg != "" 'named'
			return self.fail(src, message: msg, at: start)
		end 'named'
		if state == dfaStart 'stray'
			return strayCharacter(src, errs: errors, file: file, start: start, limit: limit)
		end 'stray'
		// The start of a token that is not finished, as a '!' with no '=' after it, which maxon reads as a token its
		// parser refuses.
		let ch = runeAt(src.text, at: start, limit: limit)
		return self.fail(src, message: "unexpected character '{ch}'", at: start)
	end 'unfinished'
end 'Lexer'

// holdsQuote says whether a quote is among the bytes of text from begin up to until.
function holdsQuote(text String, begin Count, until Count) returns bool
	for at in begin upto until 'bytes'
		if text.byteAt(at) == byteQuote 'quote'
			return true
		end 'quote'
	end 'bytes'
	return false
end 'holdsQuote'

// scanString reads the string literal at start in the file of the index, which the DFA only starts, returning its end.
function scanString(src Source, mutates errs diag.ErrorList, file Count, start Count) returns Count throws SyntaxError
	var r = stringReaderAt(src, file: file, open: start, collect: false)
	return try r.read(src, errs: errs)
end 'scanString'

// scanByteString reads the byte string literal at start, which the DFA only starts with its b and its quote, returning its end.
function scanByteString(src Source, mutates errs diag.ErrorList, file Count, start Count) returns Count throws SyntaxError
	var r = byteStringReaderAt(src, file: file, open: start, collect: false)
	return try r.read(src, errs: errs)
end 'scanByteString'

// lexSource lexes every file of src, recording the error it stops at in errs. Each code line ends with a newline; a line
// indented one tab more than the code line before it starts with an indent, and one indented less starts with a dedent
// for each tab. Each file ends with a fileEnd and the module with an eof.
export function lexSource(src Source, mutates errs diag.ErrorList, lenient bool) returns Tokens throws SyntaxError
	var lx = Lexer.make(0 as Count, pos: 0 as Count, limit: 0 as Count, inline: false, lenient: lenient)
	var failed = false
	try 'files'
		for i in 0 upto src.files.count() 'each'
			lx.lexFile(src, index: i, from: src.files[i].start as Count, until: src.files[i].endOff as Count)
		end 'each'
		lx.finish(src, at: src.text.byteLength())
	end 'files' otherwise 'refused'
		failed = true
	end 'refused'
	return try lexed(lx, failed: failed, errs: errs)
end 'lexSource'

// lexInterpolation lexes the expression of an interpolation from begin to until in the file of the index: part of one
// line, with no layout of its own.
export function lexInterpolation(src Source, mutates errs diag.ErrorList, file Count, begin Count, until Count, lenient bool) returns Tokens throws SyntaxError
	var lx = Lexer.make(file, pos: begin, limit: until, inline: true, lenient: lenient)
	var failed = false
	try 'line'
		lx.lexLine(src)
		lx.emit(src, kind: TokenKind.fileEnd, start: until, stop: until)
		lx.finish(src, at: until)
	end 'line' otherwise 'refused'
		failed = true
	end 'refused'
	return try lexed(lx, failed: failed, errs: errs)
end 'lexInterpolation'

// lexed is the tokens of a lexer that is done, or the error it failed with, moved to errs.
function lexed(mutates lx Lexer, failed bool, mutates errs diag.ErrorList) returns Tokens throws SyntaxError
	if failed 'refused'
		errs.push(try lx.errors.pop() otherwise panic("the lexer failed with no error"))
		throw SyntaxError.refused
	end 'refused'
	return exchange(lx.tokens, value: Tokens.create(0))
end 'lexed'

// sourceOf is the source of a module with one file.
export function sourceOf(consumes text String, path String) returns Source
	var files = ast.FileSpanList.create(0)
	let size = try text.byteLength() as diag.U32 otherwise panic("the module's text is larger than 4 GB; split the module")
	files.push(ast.FileSpan.make(path.clone(), text: text, start: 0 as diag.U32, endOff: size))
	return Source.make(text, files: files)
end 'sourceOf'

// lex lexes a module of one file.
export function lex(text String) returns LexResult
	let src = sourceOf(text.clone(), path: "")
	var errs = diag.ErrorList.create(0)
	var toks = Tokens.create(0)
	var failed = false
	try 'lexing'
		toks = lexSource(src, errs: errs, lenient: false)
	end 'lexing' otherwise 'refused'
		failed = true
	end 'refused'
	if failed 'error'
		return LexResult.err(try errs.pop() otherwise panic("the lexer failed with no error"))
	end 'error'
	return LexResult.ok(toks)
end 'lex'

// readInteger reads the integer literal from at to stop, which the lexer's DFA matched.
export function readInteger(src Source, mutates errs diag.ErrorList, file Count, at Count, stop Count) returns ast.I128 throws SyntaxError
	var pos = at
	var radix = 10 as Count
	if src.text.byteAt(pos) == byteZero and after(pos) < stop 'prefixed'
		let prefix = src.text.byteAt(after(pos))
		if prefix == byteLowerX 'hex'
			radix = hexRadix
		end 'hex' else if prefix == byteLowerB 'binary'
			radix = 2 as Count
		end 'binary' else if prefix == byteLowerO 'octal'
			radix = 8 as Count
		end 'octal'
		if radix != 10 'skip'
			pos = after(after(pos))
		end 'skip'
	end 'prefixed'
	var value = 0 as Count
	var digits = 0 as Count
	while pos < stop and (isAsciiHexDigit(src.text.byteAt(pos)) or src.text.byteAt(pos) == byteUnderscore) 'digits'
		let ch = src.text.byteAt(pos)
		if ch == byteUnderscore 'separator'
			pos = after(pos)
			continue 'digits'
		end 'separator'
		let d = hexDigit(ch)
		if d >= radix 'past'
			break 'digits'
		end 'past'
		try 'grow'
			value = value * radix + d
		end 'grow' otherwise 'tooLarge'
			errs.push(src.errorAt(diag.errExpressionError, message: "integer literal is larger than u64.max", file: file, offset: at))
			throw SyntaxError.refused
		end 'tooLarge'
		digits = after(digits)
		pos = after(pos)
	end 'digits'
	if digits == 0 'none'
		panic("the integer literal has no digits, but the lexer matched it")
	end 'none'
	return ast.I128.fromCount(value)
end 'readInteger'

// stringReaderAt is the reader of the string literal at open in the file of the index; one that collects keeps the
// literal's parts.
function stringReaderAt(src Source, file Count, open Count, collect bool) returns StringReader
	return StringReader.make(file, open: open, limit: src.files[file].endOff as Count, collect: collect)
end 'stringReaderAt'

// byteStringReaderAt is the reader of the byte string literal whose b is at open in the file of the index.
function byteStringReaderAt(src Source, file Count, open Count, collect bool) returns StringReader
	var r = stringReaderAt(src, file: file, open: open, collect: collect)
	r.bytes = true
	r.pos = after(after(open))
	return r
end 'byteStringReaderAt'

// StringReader reads one string literal; the lexer uses it to find the literal's end and report its errors, and the
// parser to take its parts.
type StringReader
	var file as Count
	var open as Count
	var pos as Count
	var limit as Count
	var collect as bool
	var parts as StrParts
	// The current text part is the text from run to pos until an escape forces it into buf.
	var run as Count
	var buf as ByteArray
	var escaped as bool
	// bytes is set for a byte string, whose text is one byte to a character and has no interpolation.
	var bytes as bool

	static function make(file Count, open Count, limit Count, collect bool) returns StringReader
		return StringReader{file: file, open: open, pos: after(open), limit: limit, collect: collect, parts: StrParts.create(0), run: 0 as Count, buf: ByteArray.create(0), escaped: false, bytes: false}
	end 'make'

	function fail(src Source, mutates errs diag.ErrorList, consumes message String, at Count) returns SyntaxError
		errs.push(src.errorAt(diag.errUnexpectedToken, message: message, file: file, offset: at))
		return SyntaxError.refused
	end 'fail'

	// unterminated is the error of a literal that its line or the source ends, at its quote.
	function unterminated(src Source, mutates errs diag.ErrorList) returns SyntaxError
		errs.push(src.errorAt(diag.errUnterminatedString, message: diag.unterminatedString(), file: file, offset: open))
		return SyntaxError.refused
	end 'unterminated'

	// read reads the literal, returning its end.
	function read(mutates self, src Source, mutates errs diag.ErrorList) returns Count throws SyntaxError
		if bytes 'bytes'
			return try self.readBytes(src, errs: errs)
		end 'bytes'
		run = pos
		var added = false
		while pos < limit and src.text.byteAt(pos) != byteNewline 'chars'
			let c = src.text.byteAt(pos)
			if c == byteQuote 'close'
				if pos > run or escaped or not added 'last'
					self.flushText(src)
				end 'last'
				pos = after(pos)
				return pos
			end 'close' else if c == byteBackslash 'escape'
				try self.escape(src, errs: errs)
			end 'escape' else if c == byteRBrace 'brace'
				throw self.fail(src, errs: errs, message: "a '\}' in a string is written '\\\}'", at: pos)
			end 'brace' else if c == byteLBrace 'interpolation'
				if pos > run or escaped 'text'
					self.flushText(src)
				end 'text'
				try self.interpolation(src, errs: errs)
				added = true
			end 'interpolation' else if c < byteSpace or c >= byteDelete 'checked'
				let next = try textCharacter(src, errs: errs, file: file, at: pos, limit: limit)
				if escaped 'kept'
					for at in pos upto next 'bytes'
						buf.push(src.text.byteAt(at))
					end 'bytes'
				end 'kept'
				pos = next
			end 'checked' else 'plain'
				if escaped 'kept'
					buf.push(c)
				end 'kept'
				pos = after(pos)
			end 'plain'
		end 'chars'
		throw self.unterminated(src, errs: errs)
	end 'read'

	// readBytes reads a byte string, returning its end. Its bytes are kept in buf as they are read, since a character that
	// is more than one byte of the source is one byte of the string.
	function readBytes(mutates self, src Source, mutates errs diag.ErrorList) returns Count throws SyntaxError
		while pos < limit and src.text.byteAt(pos) != byteNewline 'chars'
			let c = src.text.byteAt(pos)
			if c == byteQuote 'close'
				if collect 'collect'
					parts.push(StrPart.text(String.from(buf), begin: run, raw: false))
				end 'collect'
				pos = after(pos)
				return pos
			end 'close' else if c == byteBackslash 'escape'
				try self.escape(src, errs: errs)
			end 'escape' else if c >= byteSpace and c < byteDelete 'ascii'
				if collect 'keep'
					buf.push(c)
				end 'keep'
				pos = after(pos)
			end 'ascii' else 'checked'
				let next = try textCharacter(src, errs: errs, file: file, at: pos, limit: limit)
				let n = try next - pos otherwise panic("a character ends before it starts")
				var cp = c as Count
				if n > 1 'multibyte'
					cp = codepointAt(src.text, at: pos, n: n)
				end 'multibyte'
				try self.requireByte(src, errs: errs, codepoint: cp)
				if collect 'keep'
					buf.push(try cp as Byte otherwise panic("a byte string character exceeds a byte"))
				end 'keep'
				pos = next
			end 'checked'
		end 'chars'
		throw self.unterminated(src, errs: errs)
	end 'readBytes'

	// requireByte refuses a code point that has no byte of its own.
	function requireByte(mutates self, src Source, mutates errs diag.ErrorList, codepoint Count) throws SyntaxError
		if codepoint > byteStringMax 'tooBig'
			errs.push(src.errorAt(diag.errInvalidEscape, message: diag.byteStringCodepointRange(codepointText(codepoint), escape: byteEscapeForm), file: file, offset: open))
			throw SyntaxError.refused
		end 'tooBig'
	end 'requireByte'

	// requireScalar refuses a surrogate, which is no Unicode scalar value, so no UTF-8 text holds it. Maxon reports it at
	// the fragment of text it is in: the literal's quote for the first, and the byte after an interpolation for another.
	function requireScalar(mutates self, src Source, mutates errs diag.ErrorList, codepoint Count) throws SyntaxError
		if codepoint >= surrogateFirst and codepoint <= surrogateLast 'surrogate'
			let fragment = open if run == after(open) else run
			errs.push(src.errorAt(diag.errInvalidEscape, message: diag.surrogateEscape(), file: file, offset: fragment))
			throw SyntaxError.refused
		end 'surrogate'
	end 'requireScalar'

	function flushText(mutates self, src Source)
		if collect 'collect'
			if escaped 'decoded'
				parts.push(StrPart.text(String.from(buf), begin: run, raw: false))
			end 'decoded' else 'raw'
				parts.push(StrPart.text(src.text.sliceBytes(run, endPos: pos).clone(), begin: run, raw: true))
			end 'raw'
		end 'collect'
		escaped = false
		buf = ByteArray.create(0)
	end 'flushText'

	function escape(mutates self, src Source, mutates errs diag.ErrorList) throws SyntaxError
		if not escaped and collect and not bytes 'start'
			buf = src.text.sliceBytes(run, endPos: pos).toByteArray()
		end 'start'
		escaped = true
		pos = after(pos)
		let at = pos
		if pos >= limit or src.text.byteAt(pos) == byteNewline 'ended'
			throw self.unterminated(src, errs: errs)
		end 'ended'
		let e = src.text.byteAt(pos)
		pos = after(pos)
		var ch = 0 as Count
		if e == byteLowerN 'newline'
			ch = byteNewline as Count
		end 'newline' else if e == byteLowerT 'tab'
			ch = byteTab as Count
		end 'tab' else if e == byteLowerR 'cr'
			ch = byteCR as Count
		end 'cr' else if e == byteZero 'nul'
			ch = 0 as Count
		end 'nul' else if e == byteBackslash or e == byteQuote or e == byteApostrophe or ((e == byteLBrace or e == byteRBrace) and not bytes) 'itself'
			ch = e as Count
		end 'itself' else if e == byteLowerX 'byte'
			ch = try self.readHex(src, errs: errs, digits: 2 as Count)
		end 'byte' else if e == byteLowerU 'unicode'
			ch = try self.readHex(src, errs: errs, digits: 4 as Count)
			if bytes 'narrow'
				try self.requireByte(src, errs: errs, codepoint: ch)
			end 'narrow' else 'text'
				try self.requireScalar(src, errs: errs, codepoint: ch)
			end 'text'
		end 'unicode' else 'unknown'
			let shown = runeAt(src.text, at: at, limit: limit)
			throw self.fail(src, errs: errs, message: "unknown escape sequence '\\{shown}'", at: open)
		end 'unknown'
		if collect and bytes 'byte'
			buf.push(try ch as Byte otherwise panic("a byte string escape exceeds a byte"))
		end 'byte' else if collect 'collect'
			appendRune(buf, ch: ch)
		end 'collect'
	end 'escape'

	function readHex(mutates self, src Source, mutates errs diag.ErrorList, digits Count) returns Count throws SyntaxError
		var v = 0 as Count
		for _ in 0 upto digits 'digits'
			if pos >= limit or not isAsciiHexDigit(src.text.byteAt(pos)) 'malformed'
				throw self.fail(src, errs: errs, message: "malformed hex escape", at: open)
			end 'malformed'
			v = try v * hexRadix + hexDigit(src.text.byteAt(pos)) otherwise panic("a hex escape overflows")
			pos = after(pos)
		end 'digits'
		return v
	end 'readHex'

	function interpolation(mutates self, src Source, mutates errs diag.ErrorList) throws SyntaxError
		pos = after(pos)
		let start = pos
		var nest = 0 as Count
		var parens = 0 as FullRangeInt
		var exprEnd = start
		var specBegin = start
		var specified = false
		while pos < limit and src.text.byteAt(pos) != byteNewline and not (src.text.byteAt(pos) == byteRBrace and nest == 0) and not specified 'scan'
			let ch = src.text.byteAt(pos)
			if ch == byteLBrace 'open'
				nest = after(nest)
			end 'open' else if ch == byteRBrace 'close'
				nest = before(nest)
			end 'close' else if ch == byteLParen or ch == byteLBracket 'group'
				parens = try parens + 1 otherwise panic("the parentheses nest too deep")
			end 'group' else if ch == byteRParen or ch == byteRBracket 'ungroup'
				parens = try parens - 1 otherwise panic("the parentheses nest too deep")
			end 'ungroup' else if ch == byteColon and parens == 0 and nest == 0 'format'
				// The specifier is the bytes up to the brace that ends the interpolation, which no construct of its own owns.
				exprEnd = pos
				specBegin = after(pos)
				pos = specBegin
				while pos < limit and src.text.byteAt(pos) != byteNewline and src.text.byteAt(pos) != byteRBrace 'specifier'
					let s = src.text.byteAt(pos)
					if s < byteSpace or s >= byteDelete 'checked'
						pos = try textCharacter(src, errs: errs, file: file, at: pos, limit: limit)
						continue 'specifier'
					end 'checked'
					pos = after(pos)
				end 'specifier'
				specified = true
			end 'format' else if ch == byteQuote 'string'
				pos = after(pos)
				while pos < limit and src.text.byteAt(pos) != byteQuote and src.text.byteAt(pos) != byteNewline 'inner'
					if src.text.byteAt(pos) == byteBackslash 'escaped'
						pos = after(pos)
					end 'escaped'
					pos = after(pos)
				end 'inner'
			end 'string'
			if not specified 'next'
				pos = after(pos)
			end 'next'
		end 'scan'
		if pos >= limit or src.text.byteAt(pos) != byteRBrace 'unterminated'
			// A quote in what the brace opened was the string's own end, so the brace was meant as text, as maxon judges.
			let brace = before(start)
			if holdsQuote(src.text, begin: start, until: pos) 'text'
				errs.push(src.errorAt(diag.errUnescapedBrace, message: "Unescaped '\{' in string literal — use '\\\{' for a literal brace", file: file, offset: brace))
				throw SyntaxError.refused
			end 'text'
			errs.push(src.errorAt(diag.errUnterminatedString, message: diag.unterminatedString(), file: file, offset: brace))
			throw SyntaxError.refused
		end 'unterminated'
		if not specified 'whole'
			exprEnd = pos
			specBegin = pos
		end 'whole'
		if collect 'collect'
			parts.push(StrPart.expr(start, until: exprEnd, specBegin: specBegin, specUntil: pos))
		end 'collect'
		pos = after(pos)
		run = pos
	end 'interpolation'
end 'StringReader'
