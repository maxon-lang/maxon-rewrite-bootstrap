export enum TokenKind
	fileEnd
	indent
	dedent
	name
	integer
	string
	label
	newline
	lParen
	rParen
	lBrace
	rBrace
	comma
	colon
	dot
	lBracket
	rBracket
	plus
	minus
	star
	slash
	assign
	eqEq
	notEq
	lt
	le
	gt
	ge
	eof
	kwExport
	kwPublic
	kwStatic
	kwFunction
	kwMutates
	kwConsumes
	kwDestructs
	kwSelf
	kwReturns
	kwThrows
	kwEnd
	kwSets
	kwUnderscore
	kwLet
	kwType
	kwIs
	kwNoncopyable
	kwVar
	kwAs
	kwEnum
	kwUnion
	kwTypealias
	kwInt
	kwTo
	kwUpto
	kwSelfType
	kwWith
	kwUses
	kwWhere
	kwImplements
	kwAnd
	kwInterface
	kwIf
	kwElse
	kwWhile
	kwFor
	kwIn
	kwTry
	kwOtherwise
	kwReturn
	kwBreak
	kwContinue
	kwWhen
	kwMatch
	kwDefault
	kwOr
	kwThen
	kwGives
	kwNot
	kwMod
	kwShl
	kwShr
	kwXor
	kwTrue
	kwFalse
	kwPanic
end 'TokenKind'

export type Token
	export let kind as TokenKind
	export let start as Count
	export let length as Count

	export static function make(kind TokenKind, start Count, length Count) returns Token
		return Token{kind: kind, start: start, length: length}
	end 'make'

	export function endOffset() returns Count
		return try self.start + self.length otherwise panic("token end overflow")
	end 'endOffset'

	export function text(src String) returns String
		return src.sliceBytes(self.start, endPos: self.endOffset())
	end 'text'
end 'Token'

export typealias Tokens = Array with Token

export type LexError
	export let offset as Count
	export let message as String

	export static function make(offset Count, consumes message String) returns LexError
		return LexError{offset: offset, message: message}
	end 'make'
end 'LexError'

export union LexResult
	ok(tokens Tokens)
	err(error LexError)
end 'LexResult'

export function keywordKind(word String) returns TokenKind
	return match word 'kw'
		"export" gives TokenKind.kwExport
		"public" gives TokenKind.kwPublic
		"static" gives TokenKind.kwStatic
		"function" gives TokenKind.kwFunction
		"mutates" gives TokenKind.kwMutates
		"consumes" gives TokenKind.kwConsumes
		"destructs" gives TokenKind.kwDestructs
		"self" gives TokenKind.kwSelf
		"returns" gives TokenKind.kwReturns
		"throws" gives TokenKind.kwThrows
		"end" gives TokenKind.kwEnd
		"sets" gives TokenKind.kwSets
		"_" gives TokenKind.kwUnderscore
		"let" gives TokenKind.kwLet
		"type" gives TokenKind.kwType
		"is" gives TokenKind.kwIs
		"noncopyable" gives TokenKind.kwNoncopyable
		"var" gives TokenKind.kwVar
		"as" gives TokenKind.kwAs
		"enum" gives TokenKind.kwEnum
		"union" gives TokenKind.kwUnion
		"typealias" gives TokenKind.kwTypealias
		"int" gives TokenKind.kwInt
		"to" gives TokenKind.kwTo
		"upto" gives TokenKind.kwUpto
		"Self" gives TokenKind.kwSelfType
		"with" gives TokenKind.kwWith
		"uses" gives TokenKind.kwUses
		"where" gives TokenKind.kwWhere
		"implements" gives TokenKind.kwImplements
		"and" gives TokenKind.kwAnd
		"interface" gives TokenKind.kwInterface
		"if" gives TokenKind.kwIf
		"else" gives TokenKind.kwElse
		"while" gives TokenKind.kwWhile
		"for" gives TokenKind.kwFor
		"in" gives TokenKind.kwIn
		"try" gives TokenKind.kwTry
		"otherwise" gives TokenKind.kwOtherwise
		"return" gives TokenKind.kwReturn
		"break" gives TokenKind.kwBreak
		"continue" gives TokenKind.kwContinue
		"when" gives TokenKind.kwWhen
		"match" gives TokenKind.kwMatch
		"default" gives TokenKind.kwDefault
		"or" gives TokenKind.kwOr
		"then" gives TokenKind.kwThen
		"gives" gives TokenKind.kwGives
		"not" gives TokenKind.kwNot
		"mod" gives TokenKind.kwMod
		"shl" gives TokenKind.kwShl
		"shr" gives TokenKind.kwShr
		"xor" gives TokenKind.kwXor
		"true" gives TokenKind.kwTrue
		"false" gives TokenKind.kwFalse
		"panic" gives TokenKind.kwPanic
		default gives TokenKind.name
	end 'kw'
end 'keywordKind'
