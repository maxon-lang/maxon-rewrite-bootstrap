// Option is a value that may be missing, which nothing built in returns: it lives here, in the lowest module, so every
// module that wants one can name it.
export union Option uses T
	some(value T)
	none

	export function isSome() returns bool
		return match self 'o'
			some(v) gives true
			none gives false
		end 'o'
	end 'isSome'

	export function unwrap(consumes self) returns T
		match consumes self 'o'
			some(value) then return value
			none then panic("unwrap of an Option that holds no value")
		end 'o'
	end 'unwrap'
end 'Option'
