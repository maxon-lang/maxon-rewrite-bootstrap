enum SlotState
	empty = 0
	occupied = 1
	deleted = 2
end 'SlotState'

typealias States = Array with SlotState

typealias Strings = Array with String

typealias Counts = Array with Count

// The hashes work on 32 bits, as maxon's stdlib does (PrimitiveExtensions.maxon, String.maxon): a 32-bit value times a
// 32-bit multiplier fits a Count, so no product overflows. A product that overflowed would fail its `try` and give every
// key one hash, and each probe would then walk the whole table.
let hashLow32Mask = 4294967295 as Count

let hashHalfShift = 32 as Count

let fnvOffset32 = 2166136261 as Count

let fnvPrime32 = 16777619 as Count

// fibonacciMultiplier is 2^32 divided by the golden ratio, which spreads consecutive keys, such as node handles, over
// the low bits that a table's mask keeps.
let fibonacciMultiplier = 2654435761 as Count

let foldShift = 15 as Count

// firstCapacity is the slots of a map's first table.
let firstCapacity = 16 as Count

// hashString is 32-bit FNV-1a.
function hashString(s String) returns Count
	var h = fnvOffset32
	for i in 0 upto s.byteLength() 'each'
		let b = s.byteAt(i) as Count
		h = (try (h xor b) * fnvPrime32 otherwise 0 as Count) and hashLow32Mask
	end 'each'
	return h
end 'hashString'

function hashCount(k Count) returns Count
	let folded = (k xor (k shr hashHalfShift)) and hashLow32Mask
	let x = folded * fibonacciMultiplier
	return (x xor (x shr foldShift)) and hashLow32Mask
end 'hashCount'

// mapSlotOccupied is whether a slot of a map whose state is state (stateAt) holds an entry, which is all the build cache keeps
// of a slot besides its state.
export function mapSlotOccupied(state Count) returns bool
	return state == SlotState.occupied.ordinal
end 'mapSlotOccupied'

// A map holds its values in a slot array of slot states' length whose slots that hold no entry are empty, so that neither a
// slot nor a lookup boxes an Option, and a reader is lent the value where it lies (find and valueAt) rather than given a
// copy.

// restoredSlots is the values of a map's slots from those of its occupied slots in slot order, as the build cache stores them.
function restoredSlots(states ByteArray, consumes filled Array with V) uses V returns __SlotArray with V where V implements Droppable
	var rest = filled
	var slots as __SlotArray with V
	slots = __SlotArray.create(states.count())
	var i = states.count()
	while i > 0 'slots'
		i = i - 1
		if mapSlotOccupied(states[i] as Count) 'filled'
			slots.fillSlot(i, value: try rest.pop() otherwise panic("table: a stored map has fewer values than occupied slots"))
		end 'filled'
	end 'slots'
	return slots
end 'restoredSlots'

// StringMap is an open-addressing hash map from String to V built on array.
export type StringMap uses V
	var states as States
	var keys as Strings
	var vals as __SlotArray with V
	var len as Count
	var used as Count

	export static function new() returns Self
		return Self{states: States.create(0), keys: Strings.create(0), vals: __SlotArray.create(0), len: 0 as Count, used: 0 as Count}
	end 'new'

	export function count() returns Count
		return len
	end 'count'

	export function isEmpty() returns bool
		return len == 0
	end 'isEmpty'

	// capacity, stateAt, keyAt, valueAt, usedSlots and restored lay the map out as its arrays hold it, which the build cache
	// stores and loads back as it is, so that a map it loads probes and iterates as the one it stored did.
	export function capacity() returns Count
		return states.count()
	end 'capacity'

	export function stateAt(index Count) returns Count
		return states[index].ordinal
	end 'stateAt'

	export function keyAt(index Count) returns borrowed String
		return keys[index]
	end 'keyAt'

	// valueAt is the value of an occupied slot: one that find gave, or whose stateAt is occupied.
	export function valueAt(index Count) returns borrowed V
		return vals.lendSlot(index)
	end 'valueAt'

	export function usedSlots() returns Count
		return used
	end 'usedSlots'

	export static function restored(consumes states ByteArray, consumes keys Array with String, consumes values Array with V, length Count, used Count) returns Self where V implements Droppable
		let slots = restoredSlots(states, filled: values)
		var held = States.create(0)
		for i in 0 upto states.count() 'states'
			held.push(SlotState.allCases[states[i] as Count])
		end 'states'
		return Self{states: held, keys: keys, vals: slots, len: length, used: used}
	end 'restored'

	// find is whether the map holds key, and gives the slot that holds it, which valueAt reads, when it does.
	export function find(key String, sets slot Count) returns bool
		let cap = states.count()
		slot = cap
		if cap == 0 'empty'
			return false
		end 'empty'
		let mask = cap - 1
		var idx = hashString(key) and mask
		for _ in 0 upto cap 'probe'
			let st = states[idx]
			if st == SlotState.empty 'miss'
				return false
			end 'miss'
			if st == SlotState.occupied and keys[idx] == key 'hit'
				slot = idx
				return true
			end 'hit'
			idx = (try idx + 1 otherwise 0 as Count) and mask
		end 'probe'
		return false
	end 'find'

	export function has(key String) returns bool
		var slot as Count
		return self.find(key, slot: slot)
	end 'has'

	// get is a copy of the value of key, for a caller that keeps it; a caller that only reads it reads it in place with find
	// and valueAt.
	export function get(key String) returns Option with V where V implements Copyable
		var slot as Count
		if self.find(key, slot: slot) 'hit'
			return Option.some(vals.lendSlot(slot).clone())
		end 'hit'
		return Option.none
	end 'get'

	// getOr is a copy of the value of key, or of fallback where the map holds none.
	export function getOr(key String, fallback V) returns V where V implements Copyable
		var slot as Count
		if self.find(key, slot: slot) 'hit'
			return vals.lendSlot(slot).clone()
		end 'hit'
		return fallback.clone()
	end 'getOr'

	function grow(mutates self, newCap Count) where V implements Droppable
		if newCap == 0 'zero'
			return
		end 'zero'
		var nextStates = States.filled(newCap, value: SlotState.empty)
		var nextKeys = Strings.filled(newCap, value: "")
		var nextVals as __SlotArray with V
		nextVals = __SlotArray.create(newCap)
		let oldCap = states.count()
		let mask = newCap - 1
		for i in 0 upto oldCap 'rehash'
			if states[i] == SlotState.occupied 'move'
				let k = exchange(keys[i], value: "")
				var idx = hashString(k) and mask
				while nextStates[idx] == SlotState.occupied 'probe'
					idx = (try idx + 1 otherwise 0 as Count) and mask
				end 'probe'
				nextStates[idx] = SlotState.occupied
				nextKeys[idx] = k
				nextVals.fillSlot(idx, value: try vals.takeSlot(i) otherwise panic("table: an occupied slot of a map holds no value"))
			end 'move'
		end 'rehash'
		states = nextStates
		keys = nextKeys
		vals = nextVals
		used = len
	end 'grow'

	export function insert(mutates self, key String, consumes value V) where V implements Droppable
		let cap = states.count()
		if cap == 0 'first'
			self.grow(firstCapacity)
		end 'first' else if (try (used + 1) * 10 otherwise cap) >= (try cap * 7 otherwise cap) 'needGrow'
			self.grow(cap + cap)
		end 'needGrow'
		let curCap = states.count()
		if curCap == 0 'noCap'
			return
		end 'noCap'
		let mask = curCap - 1
		var idx = hashString(key) and mask
		var firstDeleted = curCap
		for _ in 0 upto curCap 'probe'
			let st = states[idx]
			if st == SlotState.empty 'stop'
				break 'probe'
			end 'stop'
			if st == SlotState.occupied and keys[idx] == key 'replace'
				try vals.clearSlot(idx) otherwise panic("table: an occupied slot of a map holds no value")
				vals.fillSlot(idx, value: value)
				return
			end 'replace'
			if st == SlotState.deleted and firstDeleted == curCap 'mark'
				firstDeleted = idx
			end 'mark'
			idx = (try idx + 1 otherwise 0 as Count) and mask
		end 'probe'
		let target = firstDeleted if firstDeleted < curCap else idx
		if states[target] == SlotState.empty 'bumpUsed'
			used = try used + 1 otherwise used
		end 'bumpUsed'
		states[target] = SlotState.occupied
		keys[target] = key.clone()
		vals.fillSlot(target, value: value)
		len = try len + 1 otherwise len
	end 'insert'

	export function remove(mutates self, key String) returns Option with V where V implements Droppable
		var slot as Count
		if self.find(key, slot: slot) 'hit'
			states[slot] = SlotState.deleted
			keys[slot] = ""
			len = try len - 1 otherwise 0 as Count
			return Option.some(try vals.takeSlot(slot) otherwise panic("table: an occupied slot of a map holds no value"))
		end 'hit'
		return Option.none
	end 'remove'
end 'StringMap'

// IntMap is an open-addressing hash map from Count to V built on array.
export type IntMap uses V
	var states as States
	var keys as Counts
	var vals as __SlotArray with V
	var len as Count
	var used as Count

	export static function new() returns Self
		return Self{states: States.create(0), keys: Counts.create(0), vals: __SlotArray.create(0), len: 0 as Count, used: 0 as Count}
	end 'new'

	export function count() returns Count
		return len
	end 'count'

	export function isEmpty() returns bool
		return len == 0
	end 'isEmpty'

	// capacity, stateAt, keyAt, valueAt, usedSlots and restored lay the map out as its arrays hold it, which the build cache
	// stores and loads back as it is, so that a map it loads probes and iterates as the one it stored did.
	export function capacity() returns Count
		return states.count()
	end 'capacity'

	export function stateAt(index Count) returns Count
		return states[index].ordinal
	end 'stateAt'

	export function keyAt(index Count) returns borrowed Count
		return keys[index]
	end 'keyAt'

	// valueAt is the value of an occupied slot: one that find gave, or whose stateAt is occupied.
	export function valueAt(index Count) returns borrowed V
		return vals.lendSlot(index)
	end 'valueAt'

	export function usedSlots() returns Count
		return used
	end 'usedSlots'

	export static function restored(consumes states ByteArray, consumes keys Array with Count, consumes values Array with V, length Count, used Count) returns Self where V implements Droppable
		let slots = restoredSlots(states, filled: values)
		var held = States.create(0)
		for i in 0 upto states.count() 'states'
			held.push(SlotState.allCases[states[i] as Count])
		end 'states'
		return Self{states: held, keys: keys, vals: slots, len: length, used: used}
	end 'restored'

	// find is whether the map holds key, and gives the slot that holds it, which valueAt reads, when it does.
	export function find(key Count, sets slot Count) returns bool
		let cap = states.count()
		slot = cap
		if cap == 0 'empty'
			return false
		end 'empty'
		let mask = cap - 1
		var idx = hashCount(key) and mask
		for _ in 0 upto cap 'probe'
			let st = states[idx]
			if st == SlotState.empty 'miss'
				return false
			end 'miss'
			if st == SlotState.occupied and keys[idx] == key 'hit'
				slot = idx
				return true
			end 'hit'
			idx = (try idx + 1 otherwise 0 as Count) and mask
		end 'probe'
		return false
	end 'find'

	export function has(key Count) returns bool
		var slot as Count
		return self.find(key, slot: slot)
	end 'has'

	// expect is the value of key, lent where it lies, for a caller to whom a missing key is a broken invariant: what names
	// what the map should have held, for the panic.
	export function expect(key Count, what String) returns borrowed V
		var slot as Count
		if not self.find(key, slot: slot) 'missing'
			panic("table: no {what} was recorded for key {key}")
		end 'missing'
		return vals.lendSlot(slot)
	end 'expect'

	// get is a copy of the value of key, for a caller that keeps it; a caller that only reads it reads it in place with find
	// and valueAt.
	export function get(key Count) returns Option with V where V implements Copyable
		var slot as Count
		if self.find(key, slot: slot) 'hit'
			return Option.some(vals.lendSlot(slot).clone())
		end 'hit'
		return Option.none
	end 'get'

	// getOr is a copy of the value of key, or of fallback where the map holds none.
	export function getOr(key Count, fallback V) returns V where V implements Copyable
		var slot as Count
		if self.find(key, slot: slot) 'hit'
			return vals.lendSlot(slot).clone()
		end 'hit'
		return fallback.clone()
	end 'getOr'

	function grow(mutates self, newCap Count) where V implements Droppable
		if newCap == 0 'zero'
			return
		end 'zero'
		var nextStates = States.filled(newCap, value: SlotState.empty)
		var nextKeys = Counts.filled(newCap, value: 0 as Count)
		var nextVals as __SlotArray with V
		nextVals = __SlotArray.create(newCap)
		let oldCap = states.count()
		let mask = newCap - 1
		for i in 0 upto oldCap 'rehash'
			if states[i] == SlotState.occupied 'move'
				let k = keys[i]
				var idx = hashCount(k) and mask
				while nextStates[idx] == SlotState.occupied 'probe'
					idx = (try idx + 1 otherwise 0 as Count) and mask
				end 'probe'
				nextStates[idx] = SlotState.occupied
				nextKeys[idx] = k
				nextVals.fillSlot(idx, value: try vals.takeSlot(i) otherwise panic("table: an occupied slot of a map holds no value"))
			end 'move'
		end 'rehash'
		states = nextStates
		keys = nextKeys
		vals = nextVals
		used = len
	end 'grow'

	export function insert(mutates self, key Count, consumes value V) where V implements Droppable
		let cap = states.count()
		if cap == 0 'first'
			self.grow(firstCapacity)
		end 'first' else if (try (used + 1) * 10 otherwise cap) >= (try cap * 7 otherwise cap) 'needGrow'
			self.grow(cap + cap)
		end 'needGrow'
		let curCap = states.count()
		if curCap == 0 'noCap'
			return
		end 'noCap'
		let mask = curCap - 1
		var idx = hashCount(key) and mask
		var firstDeleted = curCap
		for _ in 0 upto curCap 'probe'
			let st = states[idx]
			if st == SlotState.empty 'stop'
				break 'probe'
			end 'stop'
			if st == SlotState.occupied and keys[idx] == key 'replace'
				try vals.clearSlot(idx) otherwise panic("table: an occupied slot of a map holds no value")
				vals.fillSlot(idx, value: value)
				return
			end 'replace'
			if st == SlotState.deleted and firstDeleted == curCap 'mark'
				firstDeleted = idx
			end 'mark'
			idx = (try idx + 1 otherwise 0 as Count) and mask
		end 'probe'
		let target = firstDeleted if firstDeleted < curCap else idx
		if states[target] == SlotState.empty 'bumpUsed'
			used = try used + 1 otherwise used
		end 'bumpUsed'
		states[target] = SlotState.occupied
		keys[target] = key
		vals.fillSlot(target, value: value)
		len = try len + 1 otherwise len
	end 'insert'

	export function remove(mutates self, key Count) returns Option with V where V implements Droppable
		var slot as Count
		if self.find(key, slot: slot) 'hit'
			states[slot] = SlotState.deleted
			len = try len - 1 otherwise 0 as Count
			return Option.some(try vals.takeSlot(slot) otherwise panic("table: an occupied slot of a map holds no value"))
		end 'hit'
		return Option.none
	end 'remove'
end 'IntMap'
