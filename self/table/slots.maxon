// Every record is a box of its own, so a copy of an element allocates. A list that is rewritten in another order (a pass
// that compacts or lays out instructions, a map that rehashes) moves its elements out with takeAt instead, which leaves
// empty slots behind (as Array.resize of an array of a type parameter and clearSlot do): a drop or a clear of the old list
// skips them, and nothing reads them.

// emptySlots is an array of n empty slots.
export function emptySlots(n Count) uses T returns Array with T where T implements Droppable
	var slots as Array with T
	slots = Array.create(0)
	slots.resize(n)
	return slots
end 'emptySlots'

// takeAt moves the element at an index out of xs and leaves its slot empty, the others where they are: the element is
// swapped to the end, where pop takes it without a copy, and the end's own element swapped back over the empty slot that
// resize puts there.
export function takeAt(mutates xs Array with T, at Count) uses T returns T where T implements Droppable
	let last = try xs.count() - 1 otherwise panic("table: an element taken from an empty list")
	try xs.managed.swap(at, j: last) otherwise panic("table: an element taken past the end of its list")
	let v = try xs.pop() otherwise panic("table: an element taken past the end of its list")
	xs.resize(last + 1)
	try xs.managed.swap(at, j: last) otherwise panic("table: an element taken past the end of its list")
	return v
end 'takeAt'
