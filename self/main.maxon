function assertKind(tokens syntax.Tokens, index Count, expected syntax.TokenKind, label String)
	if index >= tokens.count() 'oob'
		panic("{label}: expected token at {index}, only {tokens.count()} tokens")
	end 'oob'
	let got = tokens[index].kind
	if got != expected 'mismatch'
		panic("{label}: token {index} expected {expected.name}, got {got.name}")
	end 'mismatch'
end 'assertKind'

function assertText(tokens syntax.Tokens, src String, index Count, expected String, label String)
	let got = tokens[index].text(src)
	if got != expected 'mismatch'
		panic("{label}: token {index} expected '{expected}', got '{got}'")
	end 'mismatch'
end 'assertText'

function expectOk(src String, label String) returns syntax.Tokens
	return match consumes syntax.lex(src) 'res'
		ok(tokens) gives tokens
		err(e) panic("{label}: unexpected lex error {e.format()}")
	end 'res'
end 'expectOk'

function expectError(src String, expectedMessage String, label String)
	match syntax.lex(src) 'res'
		ok(_) then panic("{label}: expected error '{expectedMessage}', but lexing succeeded")
		err(e) then checkErrorMessage(e.message, expected: expectedMessage, label: label)
	end 'res'
end 'expectError'

function checkErrorMessage(got String, expected String, label String)
	if got != expected 'mismatch'
		panic("{label}: expected error '{expected}', got '{got}'")
	end 'mismatch'
end 'checkErrorMessage'

function testProgram()
	let src = "// greeting\nfunction main() returns ExitCode\n\tlet x = 42 // answer\n\treturn x\nend 'main'\n"
	let toks = expectOk(src, label: "program")
	assertKind(toks, index: 0, expected: syntax.TokenKind.kw_function, label: "program")
	assertKind(toks, index: 1, expected: syntax.TokenKind.name, label: "program")
	assertText(toks, src: src, index: 1, expected: "main", label: "program")
	assertKind(toks, index: 2, expected: syntax.TokenKind.lParen, label: "program")
	assertKind(toks, index: 3, expected: syntax.TokenKind.rParen, label: "program")
	assertKind(toks, index: 4, expected: syntax.TokenKind.kw_returns, label: "program")
	assertKind(toks, index: 5, expected: syntax.TokenKind.name, label: "program")
	assertKind(toks, index: 6, expected: syntax.TokenKind.newline, label: "program")
	assertKind(toks, index: 7, expected: syntax.TokenKind.indent, label: "program")
	assertKind(toks, index: 8, expected: syntax.TokenKind.kw_let, label: "program")
	assertKind(toks, index: 9, expected: syntax.TokenKind.name, label: "program")
	assertKind(toks, index: 10, expected: syntax.TokenKind.assign, label: "program")
	assertKind(toks, index: 11, expected: syntax.TokenKind.integer, label: "program")
	assertText(toks, src: src, index: 11, expected: "42", label: "program")
	assertKind(toks, index: 12, expected: syntax.TokenKind.newline, label: "program")
	assertKind(toks, index: 13, expected: syntax.TokenKind.kw_return, label: "program")
	assertKind(toks, index: 14, expected: syntax.TokenKind.name, label: "program")
	assertKind(toks, index: 15, expected: syntax.TokenKind.newline, label: "program")
	assertKind(toks, index: 16, expected: syntax.TokenKind.dedent, label: "program")
	assertKind(toks, index: 17, expected: syntax.TokenKind.kw_end, label: "program")
	assertKind(toks, index: 18, expected: syntax.TokenKind.label, label: "program")
	assertText(toks, src: src, index: 18, expected: "main", label: "program")
	assertKind(toks, index: 19, expected: syntax.TokenKind.newline, label: "program")
	assertKind(toks, index: 20, expected: syntax.TokenKind.fileEnd, label: "program")
	assertKind(toks, index: 21, expected: syntax.TokenKind.eof, label: "program")
end 'testProgram'

function testNumbersAndOperators()
	let src = "let a = 1_000 + 0xFF - 0b1010 * 0o77 / 2\nlet b = a == 1 and a != 2 and a <= 3 and a >= 0\n"
	let toks = expectOk(src, label: "numbers")
	assertText(toks, src: src, index: 3, expected: "1_000", label: "numbers")
	assertText(toks, src: src, index: 5, expected: "0xFF", label: "numbers")
	assertText(toks, src: src, index: 7, expected: "0b1010", label: "numbers")
	assertText(toks, src: src, index: 9, expected: "0o77", label: "numbers")
	assertKind(toks, index: 17, expected: syntax.TokenKind.eqEq, label: "numbers")
	assertKind(toks, index: 21, expected: syntax.TokenKind.notEq, label: "numbers")
	assertKind(toks, index: 25, expected: syntax.TokenKind.le, label: "numbers")
	assertKind(toks, index: 29, expected: syntax.TokenKind.ge, label: "numbers")
end 'testNumbersAndOperators'

function testStringsAndInterpolation()
	let src = "let s = \"hi \{a + 1\}\\n\\x41\\u0042\"\n"
	let toks = expectOk(src, label: "strings")
	assertKind(toks, index: 3, expected: syntax.TokenKind.string, label: "strings")
	let interpText = "a + 1"
	let interpSrc = syntax.sourceOf(interpText.clone(), path: "")
	var errs = diag.ErrorList.create(0)
	let interpToks = try syntax.lexInterpolation(interpSrc, errs: errs, file: 0, begin: 0, until: interpText.byteLength(), lenient: false) otherwise panic("interp: unexpected lex error")
	assertKind(interpToks, index: 0, expected: syntax.TokenKind.name, label: "interp")
	assertKind(interpToks, index: 1, expected: syntax.TokenKind.plus, label: "interp")
	assertKind(interpToks, index: 2, expected: syntax.TokenKind.integer, label: "interp")
	assertKind(interpToks, index: 3, expected: syntax.TokenKind.fileEnd, label: "interp")
end 'testStringsAndInterpolation'

function testErrors()
	expectError("let x = 1", expectedMessage: "the file does not end with a newline", label: "noNewline")
	expectError("  let x = 1\n", expectedMessage: "a line is indented with a space; indent with tabs only", label: "spaceIndent")
	expectError("\t\nlet x = 1\n", expectedMessage: "a blank line holds tabs; remove the trailing whitespace", label: "blankTabs")
	expectError("\t// bad\nlet x = 1\n", expectedMessage: "a comment line is indented 1 tabs, but the code line after it 0; indent them alike", label: "commentIndent")
	expectError("let x = /* no */ 1\n", expectedMessage: "a block comment is not allowed; write // comments on their own lines or after code", label: "blockComment")
	expectError("let  x = 1\n", expectedMessage: "tokens are separated by one space, not several", label: "doubleSpace")
	expectError("let x = (\n1)\n", expectedMessage: "a line breaks inside parentheses; keep what they hold on one line", label: "breakInParens")
	expectError("let x = 0x\n", expectedMessage: "incomplete integer", label: "incompleteHex")
	expectError("let s = \"oops\n", expectedMessage: "unterminated string literal", label: "unterminatedStr")
	expectError("let s = \"\{x:04x\"\n", expectedMessage: "unterminated interpolation in string literal", label: "unterminatedFormatSpec")
	expectError("let s = \"\}\"\n", expectedMessage: "a '\}' in a string is written '\\\}'", label: "bareBrace")
end 'testErrors'

typealias StrToCount = table.StringMap with Count

typealias CountToStr = table.IntMap with String

function testTables()
	var sm = StrToCount.new()
	for i in 0 upto 100 'fillStr'
		let k = "key_{i}"
		sm.insert(k, value: i as Count)
	end 'fillStr'
	if sm.count() != 100 'cnt1'
		panic("StringMap count expected 100, got {sm.count()}")
	end 'cnt1'
	sm.insert("key_42", value: 999 as Count)
	if sm.get("key_42").unwrap() != 999 'ovr'
		panic("StringMap overwrite failed")
	end 'ovr'
	let removed = sm.remove("key_10")
	if removed.unwrap() != 10 or sm.has("key_10") or sm.count() != 99 'rem'
		panic("StringMap remove failed")
	end 'rem'
	var im = CountToStr.new()
	for i in 0 upto 100 'fillInt'
		im.insert(i as Count, value: "val_{i}")
	end 'fillInt'
	if im.count() != 100 or im.get(77 as Count).unwrap() != "val_77" 'intGet'
		panic("IntMap get failed")
	end 'intGet'
	let r2 = im.remove(77 as Count)
	if r2.unwrap() != "val_77" or im.has(77 as Count) or im.count() != 99 'intRem'
		panic("IntMap remove failed")
	end 'intRem'
end 'testTables'

function endsWithMaxon(name String) returns bool
	let suffix = ".maxon"
	let sn = suffix.byteLength()
	let n = name.byteLength()
	if n <= sn 'short'
		return false
	end 'short'
	let start = n - sn
	return name.sliceBytes(start, endPos: n) == suffix
end 'endsWithMaxon'

function parseDirTests(dir String) returns Count
	var count = 0 as Count
	let entries = try Directory.list(try FilePath.from(dir) otherwise panic("invalid path")) otherwise panic("cannot list the directory")
	for i in 0 upto entries.count() 'each'
		let full = entries[i].toString()
		if Directory.isDirectory(entries[i]) 'sub'
			let sub = parseDirTests(full)
			count = try count + sub otherwise count
		end 'sub' else if endsWithMaxon(full) 'src'
			let text = try File.readText(entries[i]) otherwise panic("cannot read the file")
			match syntax.parseSource(0 as diag.ModuleID, path: full.clone(), src: text) 'pr'
				ok(m) then count = try count + m.decls.count() otherwise count
				err(e) then panic("parse failed on {full}: {e[0].format()}")
			end 'pr'
		end 'src'
	end 'each'
	return count
end 'parseDirTests'

function testParser()
	let declCount = parseDirTests("self")
	if declCount < 30 'few'
		panic("expected >= 30 decls across self, got {declCount}")
	end 'few'
	let interpSrc = "function f(x Count) returns String\n\treturn \"a=\{x + 1\}b\\n\"\nend 'f'\n"
	match syntax.parseSource(0 as diag.ModuleID, path: "interp.maxon", src: interpSrc) 'ir'
		ok(m) then checkInterpAst(m)
		err(e) then panic("interp parse failed: {e[0].format()}")
	end 'ir'
end 'testParser'

function checkInterpAst(m ast.Module)
	if m.decls.count() != 1 'cnt'
		panic("expected 1 decl in interp test")
	end 'cnt'
end 'checkInterpAst'

function assertEqStr(got String, expected String, label String)
	if got != expected 'neq'
		panic("{label}: expected '{expected}', got '{got}'")
	end 'neq'
end 'assertEqStr'

function testI128()
	let a = ast.I128.fromInt(-42 as FullRangeInt)
	let b = ast.I128.fromInt(100 as FullRangeInt)
	let sum = a.add(b)
	assertEqStr(sum.toString(), expected: "58", label: "i128.add")
	let diff = a.sub(b)
	assertEqStr(diff.toString(), expected: "-142", label: "i128.sub")
	assertEqStr(a.neg().toString(), expected: "42", label: "i128.neg")
	if not a.lt(b) or b.le(a) or not sum.eq(ast.I128.fromInt(58 as FullRangeInt)) 'cmp'
		panic("i128 compare failed")
	end 'cmp'
	let big = ast.mulWide(ast.I128.fromCount(10000000000 as Count), b: ast.I128.fromCount(10000000000 as Count))
	assertEqStr(big.toString(), expected: "100000000000000000000", label: "i128.mulWide")
	let q = ast.quoTrunc(big.neg(), b: ast.I128.fromInt(10000000000 as FullRangeInt))
	assertEqStr(q.toString(), expected: "-10000000000", label: "i128.quoTrunc")
	assertEqStr(ast.I128.i64Min().toString(), expected: "-9223372036854775808", label: "i128.i64Min")
	assertEqStr(ast.I128.u64Max().toString(), expected: "18446744073709551615", label: "i128.u64Max")
end 'testI128'

// functionNameColumn is where the name of a function begins after its keyword, which is where a declaration is located.
let functionNameColumn = 10

function testPositionsAndDiag()
	var paths = ast.StringList.create(0)
	paths.push("a.maxon")
	paths.push("b.maxon")
	var texts = ast.StringList.create(0)
	texts.push("function one()\n\treturn\nend 'one'\n")
	texts.push("function two()\n\tlet x = 1\n\treturn\nend 'two'\n")
	let pr = syntax.parseModuleFiles(0 as diag.ModuleID, path: "m", filePaths: paths, fileTexts: texts, target: ast.Target.windowsX64())
	var m as ast.Module
	match consumes pr 'r'
		ok(modVal) then m = modVal
		err(e) then panic("unexpected parseModuleFiles error: {e[0].format()}")
	end 'r'
	if m.decls.count() != 2 'd2'
		panic("expected 2 decls, got {m.decls.count()}")
	end 'd2'
	let d0Off = m.decls[0].offset(m.tree)
	let d1Off = m.decls[1].offset(m.tree)
	let loc0 = ast.locateModuleOffset(m, offset: d0Off)
	let loc1 = ast.locateModuleOffset(m, offset: d1Off)
	assertEqStr(loc0.file, expected: "a.maxon", label: "loc0.file")
	assertEqStr(loc1.file, expected: "b.maxon", label: "loc1.file")
	if loc0.line != 1 or loc0.col != functionNameColumn or loc1.line != 1 or loc1.col != functionNameColumn 'lc'
		panic("unexpected decl locs")
	end 'lc'
	var mods = ast.ModuleList.create(0)
	mods.push(m)
	var errs = diag.ErrorList.create(0)
	diag.pushSiteError(errs, code: "E3001", message: "second", module: 0 as diag.ModuleID, offset: d1Off)
	diag.pushSiteError(errs, code: "E2001", message: "first", module: 0 as diag.ModuleID, offset: d0Off)
	ast.locateAllErrors(mods, errs: errs)
	assertEqStr(errs[0].file, expected: "a.maxon", label: "sort0")
	assertEqStr(errs[1].file, expected: "b.maxon", label: "sort1")
end 'testPositionsAndDiag'

function testAstModel()
	var proj = ast.Project.new("self")
	if proj.stdlib.decls.count() < 20 'std'
		panic("expected >= 20 stdlib decls")
	end 'std'
	var args = ast.TypeIDList.create(0)
	args.push(proj.builtins.countTy)
	let arrCount = ast.instantiateType(proj.types, origin: proj.builtins.arrayOrigin, args: args)
	assertEqStr(ast.typeName(proj.types, t: arrCount), expected: "Array with Count", label: "arrCount")
	var nested = ast.TypeIDList.create(0)
	nested.push(arrCount)
	let listArrCount = ast.instantiateType(proj.types, origin: proj.builtins.listOrigin, args: nested)
	assertEqStr(ast.typeName(proj.types, t: listArrCount), expected: "List with (Array with Count)", label: "listArrCount")
	let listArrCount2 = ast.instantiateType(proj.types, origin: proj.builtins.listOrigin, args: nested)
	if listArrCount != listArrCount2 'intern'
		panic("type interning failed")
	end 'intern'
	let fid = proj.types.slots[ast.typeSlot(proj.builtins.arrayOrigin)][ast.typeIndex(proj.builtins.arrayOrigin)].findMethod("push").unwrap()
	let instFid = ast.instantiateFunc(proj.funcs, tt: proj.types, origin: fid, args: args, witnesses: ast.WitnessList.create(0))
	let ln = ast.funcLinkName(proj, fid: instFid)
	assertEqStr(ln, expected: "(stdlib::Array with Count=int(0 to 18446744073709551615)).push", label: "funcLinkName")
end 'testAstModel'

function hexDigit(c Byte) returns Count
	let value = c as Count
	if value >= 65 'upper'
		return try value - 55 otherwise panic("not a hex digit")
	end 'upper'
	return try value - 48 otherwise panic("not a hex digit")
end 'hexDigit'

// emitHex appends the bytes that a string of hex digit pairs spells, so that machine code reads as its encoding.
function emitHex(mutates code ByteArray, hex String)
	var i = 0 as Count
	while i < hex.byteLength() 'pairs'
		let c = hex.byteAt(i)
		if c != 32 'digit'
			let hi = hexDigit(c)
			let lo = hexDigit(hex.byteAt(try i + 1 otherwise panic("odd hex digits")))
			code.push(try hi * 16 + lo as Byte otherwise panic("not a byte"))
			i = try i + 2 otherwise panic("hex too long")
		end 'digit' else 'space'
			i = try i + 1 otherwise panic("hex too long")
		end 'space'
	end 'pairs'
end 'emitHex'

// emitU32 appends a 32-bit little-endian value, the immediate of an instruction.
function emitU32(mutates code ByteArray, v Count)
	var rest = v
	for _ in 0 upto 4 'bytes'
		code.push(try (rest and 255) as Byte otherwise panic("not a byte"))
		rest = rest shr 8
	end 'bytes'
end 'emitU32'

// emitRel32 appends the displacement from the end of the instruction being written to an address.
function emitRel32(mutates code ByteArray, target Count, textRva Count)
	let next = try textRva + code.count() + 4 otherwise panic("code past the address space")
	emitU32(code, v: try target - next otherwise panic("a target before the instruction"))
end 'emitRel32'

// peExitProgram is ExitProcess(42):
//   sub rsp, 40; mov ecx, 42; call [ExitProcess]
function peExitProgram(image backend.PeImage) returns ByteArray
	var code = ByteArray.create(0)
	emitHex(code, hex: "48 83 EC 28 B9 2A 00 00 00 FF 15")
	emitRel32(code, target: backend.importSlotRva(image, index: 0), textRva: image.textRva)
	return code
end 'peExitProgram'

// peHelloProgram writes the string at the start of the data section to standard output, then ExitProcess(7):
//   sub rsp, 56; mov ecx, -11; call [GetStdHandle]; mov rcx, rax; lea rdx, [rip+msg]; mov r8d, len
//   lea r9, [rsp+48]; mov qword [rsp+32], 0; call [WriteFile]; mov ecx, 7; call [ExitProcess]
function peHelloProgram(image backend.PeImage, messageLength Count) returns ByteArray
	var code = ByteArray.create(0)
	emitHex(code, hex: "48 83 EC 38 B9 F5 FF FF FF FF 15")
	emitRel32(code, target: backend.importSlotRva(image, index: 1), textRva: image.textRva)
	emitHex(code, hex: "48 89 C1 48 8D 15")
	emitRel32(code, target: image.dataRva, textRva: image.textRva)
	emitHex(code, hex: "41 B8")
	emitU32(code, v: messageLength)
	emitHex(code, hex: "4C 8D 4C 24 30 48 C7 44 24 20 00 00 00 00 FF 15")
	emitRel32(code, target: backend.importSlotRva(image, index: 2), textRva: image.textRva)
	emitHex(code, hex: "B9 07 00 00 00 FF 15")
	emitRel32(code, target: backend.importSlotRva(image, index: 0), textRva: image.textRva)
	return code
end 'peHelloProgram'

function peTempPath(name String) returns FilePath
	let dir = try Process.environmentVariable("TEMP") otherwise panic("TEMP is not set")
	return try FilePath.from("{dir}\\{name}") otherwise panic("not a path")
end 'peTempPath'

// runPeImage writes the image to a file, runs it and gives what it printed and its exit code.
function runPeImage(image backend.PeImage, name String, expectedCode ExitCode, expectedOutput String)
	let out = runPeImageOutput(image, name: name, expectedCode: expectedCode)
	assertEqStr(out.stdout, expected: expectedOutput, label: name)
end 'runPeImage'

// runPeImageOutput writes the image, runs it and checks its exit code, and gives what it wrote.
function runPeImageOutput(image backend.PeImage, name String, expectedCode ExitCode) returns CollectedOutput
	let path = peTempPath(name)
	try backend.writePeImage(image, path: path) otherwise panic("cannot write {name}")
	let out = try Subprocess.run(Executable.path(peTempPath(name)), arguments: Array.create(0)) otherwise panic("cannot run {name}")
	try File.delete(path) otherwise panic("cannot delete {name}")
	if out.exitCode() != expectedCode 'code'
		panic("{name}: expected exit code {expectedCode}, got {out.exitCode()}")
	end 'code'
	return out
end 'runPeImageOutput'

function testPe()
	let message = "hello from a PE written by self\n"
	var kernel = backend.NameList.create(0)
	kernel.push("ExitProcess")
	kernel.push("GetStdHandle")
	kernel.push("WriteFile")
	// The sections' addresses depend on their sizes only by whole pages, and the programs are far smaller than one, so
	// a layout made for one byte of code is the layout the programs are made for.
	let probe = backend.buildPeImage(1, dataSize: message.byteLength(), dll: "kernel32.dll", imports: kernel, entryOffset: 0)
	let exitCode = peExitProgram(probe)
	var exitImage = backend.buildPeImage(exitCode.count(), dataSize: 0, dll: "kernel32.dll", imports: kernel, entryOffset: 0)
	backend.placeCode(exitImage, at: 0, bytes: exitCode)
	runPeImage(exitImage, name: "minimaxon_pe_exit.exe", expectedCode: 42, expectedOutput: "")
	let helloCode = peHelloProgram(probe, messageLength: message.byteLength())
	var helloImage = backend.buildPeImage(helloCode.count(), dataSize: message.byteLength(), dll: "kernel32.dll", imports: kernel, entryOffset: 0)
	backend.placeCode(helloImage, at: 0, bytes: helloCode)
	backend.placeData(helloImage, at: 0, bytes: message.toByteArray())
	runPeImage(helloImage, name: "minimaxon_pe_hello.exe", expectedCode: 7, expectedOutput: message)
end 'testPe'

function testProject()
	var errs = diag.ErrorList.create(0)
	let optProj = project.loadProject("self", errs: errs)
	var p as ast.Project
	match consumes optProj 'pr'
		some(pv) then p = pv
		none then panic("loadProject(\"self\") returned none")
	end 'pr'
	if errs.count() > 0 'hasErr'
		panic("loadProject(\"self\") reported {errs[0].format()}")
	end 'hasErr'
	if p.modules.count() < 6 'mods'
		panic("expected >= 6 modules in self, got {p.modules.count()}")
	end 'mods'
	if not p.byPath.has("") or not p.byPath.has("ast") or not p.byPath.has("project") or not p.byPath.has("syntax") 'paths'
		panic("expected root, ast, project, syntax modules in p.byPath")
	end 'paths'
	let g = project.newGraph(p)
	match project.checkAcyclic(g, p: p) 'cyc'
		some(ce) then panic("unexpected cycle: {ce.format()}")
		none then _ = 0
	end 'cyc'
end 'testProject'

function testResolve()
	var errs = diag.ErrorList.create(0)
	var p = match consumes project.loadProject("self", errs: errs) 'pr'
		some(pv) gives pv
		none panic("loadProject(\"self\") returned none")
	end 'pr'
	if errs.count() > 0 'pe'
		panic("load error: {errs[0].format()}")
	end 'pe'
	resolve.resolveProject(p, errs: errs)
	if errs.count() > 0 're'
		ast.locateAllErrors(p.modules, errs: errs)
		panic("resolve error on self: {errs[0].format()}")
	end 're'
	let g = project.newGraph(p)
	match project.checkAcyclic(g, p: p) 'cyc'
		some(ce) then panic("unexpected module cycle: {ce.format()}")
		none then _ = 0
	end 'cyc'
	let order = project.topoOrder(g)
	if order.count() != p.modules.count() 'ord'
		panic("expected topoOrder count {p.modules.count()}, got {order.count()}")
	end 'ord'
end 'testResolve'

function hexOf(code ByteArray) returns String
	let digits = "0123456789abcdef"
	var out = ByteArray.create(0)
	for i in 0 upto code.count() 'each'
		let b = code[i]
		out.push(digits.byteAt(b / 16))
		out.push(digits.byteAt(b mod 16))
	end 'each'
	return String.from(out)
end 'hexOf'

function expectEncoded(code ByteArray, expected String, label String)
	let got = hexOf(code)
	if got != expected 'mismatch'
		panic("{label}: expected {expected}, got {got}")
	end 'mismatch'
end 'expectEncoded'

// The bytes are those the Go compiler's assembler wrote for the same instructions, which internal/x64gen keeps and checks.
function testX64Encoder()
	let rax = backend.X64Register.rax
	let rcx = backend.X64Register.rcx
	let rbx = backend.X64Register.rbx
	let rsp = backend.X64Register.rsp
	let rbp = backend.X64Register.rbp
	let rsi = backend.X64Register.rsi
	let r8 = backend.X64Register.r8
	let r9 = backend.X64Register.r9
	let r10 = backend.X64Register.r10
	let r11 = backend.X64Register.r11
	let r12 = backend.X64Register.r12
	let r13 = backend.X64Register.r13
	let r14 = backend.X64Register.r14
	let r15 = backend.X64Register.r15
	var c = ByteArray.create(0)
	backend.encodeMovRegReg(c, dest: rax, src: rcx)
	expectEncoded(c, expected: "4889c8", label: "movRegReg")
	c = ByteArray.create(0)
	backend.encodeMovRegReg(c, dest: r9, src: r12)
	expectEncoded(c, expected: "4d89e1", label: "movRegReg")
	c = ByteArray.create(0)
	backend.encodeAddRegReg(c, dest: rbx, src: r15)
	expectEncoded(c, expected: "4c01fb", label: "addRegReg")
	c = ByteArray.create(0)
	backend.encodeLoadRegBaseDisp(c, dest: rax, base: rsp, disp: 8)
	expectEncoded(c, expected: "488b442408", label: "loadRegBaseDisp")
	c = ByteArray.create(0)
	backend.encodeLoadRegBaseDisp(c, dest: rax, base: rbp, disp: 0)
	expectEncoded(c, expected: "488b4500", label: "loadRegBaseDisp")
	c = ByteArray.create(0)
	backend.encodeLoadRegBaseDisp(c, dest: r13, base: r13, disp: -129)
	expectEncoded(c, expected: "4d8bad7fffffff", label: "loadRegBaseDisp")
	c = ByteArray.create(0)
	backend.encodeStoreBaseDispReg(c, base: r12, disp: 256, src: rax)
	expectEncoded(c, expected: "4989842400010000", label: "storeBaseDispReg")
	c = ByteArray.create(0)
	backend.encodeStoreBaseDispReg8(c, base: rax, disp: 0, src: rcx)
	expectEncoded(c, expected: "8808", label: "storeBaseDispReg8")
	c = ByteArray.create(0)
	backend.encodeStoreBaseDispReg8(c, base: rax, disp: 0, src: rsi)
	expectEncoded(c, expected: "408830", label: "storeBaseDispReg8")
	c = ByteArray.create(0)
	backend.encodeStoreBaseDispReg8(c, base: r8, disp: 0, src: r12)
	expectEncoded(c, expected: "458820", label: "storeBaseDispReg8")
	c = ByteArray.create(0)
	backend.encodeMovRegImm(c, dest: rax, imm: 5)
	expectEncoded(c, expected: "b805000000", label: "movRegImm")
	c = ByteArray.create(0)
	backend.encodeMovRegImm(c, dest: rax, imm: -1)
	expectEncoded(c, expected: "48c7c0ffffffff", label: "movRegImm")
	c = ByteArray.create(0)
	backend.encodeMovRegImm(c, dest: r10, imm: 1099511627776)
	expectEncoded(c, expected: "49ba0000000000010000", label: "movRegImm")
	c = ByteArray.create(0)
	backend.encodeMovRegImm(c, dest: rax, imm: -9223372036854775808)
	expectEncoded(c, expected: "48b80000000000000080", label: "movRegImm")
	c = ByteArray.create(0)
	backend.encodeAddRegImm(c, dest: rsp, imm: -16)
	expectEncoded(c, expected: "4883c4f0", label: "addRegImm")
	c = ByteArray.create(0)
	backend.encodeSubRegImm(c, dest: rsp, imm: 4096)
	expectEncoded(c, expected: "4881ec00100000", label: "subRegImm")
	c = ByteArray.create(0)
	backend.encodeCmpRegImm(c, dest: r8, imm: 127)
	expectEncoded(c, expected: "4983f87f", label: "cmpRegImm")
	c = ByteArray.create(0)
	backend.encodePushReg(c, reg: r14)
	expectEncoded(c, expected: "4156", label: "pushReg")
	c = ByteArray.create(0)
	backend.encodePopReg(c, reg: rbx)
	expectEncoded(c, expected: "5b", label: "popReg")
	c = ByteArray.create(0)
	backend.encodeSetccRax(c, cond: backend.X64CondCode.less)
	expectEncoded(c, expected: "0f9cc0480fb6c0", label: "setccRax")
	c = ByteArray.create(0)
	backend.encodeCqo(c)
	expectEncoded(c, expected: "4899", label: "cqo")
	c = ByteArray.create(0)
	backend.encodeRepStosq(c)
	expectEncoded(c, expected: "f348ab", label: "repStosq")
	c = ByteArray.create(0)
	backend.encodeLeaRegRip(c, dest: r11, disp: 0)
	expectEncoded(c, expected: "4c8d1d00000000", label: "leaRegRip")
	c = ByteArray.create(0)
	backend.encodeCallRip(c, disp: 0)
	expectEncoded(c, expected: "ff1500000000", label: "callRip")
	c = ByteArray.create(0)
	backend.encodeJmpRel32(c, rel: 0)
	backend.patchRel32(c, at: backend.lastField32(c), target: 0)
	expectEncoded(c, expected: "e9fbffffff", label: "jmpRel32 backward")
	c = ByteArray.create(0)
	backend.encodeJmpRel32(c, rel: 0)
	let forward = backend.lastField32(c)
	for i in 0 upto 10 'pad'
		c.push(0)
	end 'pad'
	backend.patchRel32(c, at: forward, target: c.count())
	expectEncoded(c, expected: "e90a00000000000000000000000000", label: "jmpRel32 forward")
	// The atomic forms and the read of the thread's context came after the assembler, so their bytes are the Intel
	// manual's, which internal/x64gen's literal rows also hold.
	c = ByteArray.create(0)
	backend.encodeLockXaddBaseDispReg(c, base: r12, disp: 8, src: r9)
	expectEncoded(c, expected: "f04d0fc14c2408", label: "lockXaddBaseDispReg")
	c = ByteArray.create(0)
	backend.encodeXchgBaseDispReg(c, base: r13, disp: 0, src: backend.X64Register.rdx)
	expectEncoded(c, expected: "49875500", label: "xchgBaseDispReg")
	c = ByteArray.create(0)
	backend.encodeLockCmpxchgBaseDispReg(c, base: rcx, disp: 0, src: backend.X64Register.rdx)
	expectEncoded(c, expected: "f0480fb111", label: "lockCmpxchgBaseDispReg")
	c = ByteArray.create(0)
	backend.encodePause(c)
	expectEncoded(c, expected: "f390", label: "pause")
	c = ByteArray.create(0)
	backend.encodeLoadRegGsBaseDisp(c, dest: rax, base: rcx, disp: backend.tebTlsSlotsOffset)
	expectEncoded(c, expected: "65488b8180140000", label: "loadRegGsBaseDisp")
end 'testX64Encoder'

function selfTest()
	testProgram()
	testNumbersAndOperators()
	testStringsAndInterpolation()
	testErrors()
	testTables()
	testParser()
	testI128()
	testPositionsAndDiag()
	testAstModel()
	testProject()
	testResolve()
	testPe()
	testX64Encoder()
	testDeclare()
	testCodegen()
	testMachineIr()
	testSpilling()
	testIr()
	testVerify()
	testBodies()
	testFilesOfTests()
	testInterp()
	testFormat()
	testRewrite()
	testAnalyses()
	testTimings()
	testSsa()
	testShapeClash()
	testFold()
	print("self: all checks passed\n")
end 'selfTest'

// selftest is the one command the driver does not have: the tests are this module's, and a module imports only the ones
// below it.
function main() returns ExitCode
	let args = CommandLine.args()
	if args.count() >= 2 and args[1] == "selftest" 'selftest'
		selfTest()
		return 0
	end 'selftest'
	return driver.run(args)
end 'main'
