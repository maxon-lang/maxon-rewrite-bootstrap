// The x64 encoder of machine IR: an allocated function, every operand physical, into a code unit, with the same label
// uses and fixups for the linker as the rest of the backend writes. The blocks are laid out as a BlockLayout plans
// (branches.maxon), which also says where the flags are dead: there a constant 0 is the short exclusive or, and a copy
// before the addition of a constant to it is one lea. The head of a loop is placed by fitLine (align.maxon).

// machinePageSize is how far the stack may grow past the last page it touched: a frame bigger than that touches each
// page on the way down, so the guard page is met in order.
let machinePageSize = 4096

// encodeX64Function writes a function whose registers are allocated into the unit, as a section of its own, and
// defines its symbol. A function with a loop is written twice: first without padding, which gives each loop's length, and
// then for good, with each loop's head placed so that the loop spans no more lines of code than its length needs.
export function encodeX64Function(mutates u CodeUnit, fn MirFunction, instance bool, mutates lay BlockLayout)
	lay.plan(fn)
	lay.framed = needsFrame(fn)
	u.beginSection()
	if lay.heads 'loops'
		lay.starts.clear()
		encodeBlocks(u, fn: fn, lay: lay, measure: true)
		u.rewindSection()
		u.alignSection(codeLineBytes)
	end 'loops'
	u.defineFunction(fn.symbol, instance: instance)
	u.startRows()
	encodeBlocks(u, fn: fn, lay: lay, measure: false)
end 'encodeX64Function'

// encodeBlocks writes the blocks of fn in the order of the layout. Measuring, it notes where each starts in lay.starts and
// pads nothing; otherwise it pads before the head of each loop as fitLine says.
function encodeBlocks(mutates u CodeUnit, fn MirFunction, mutates lay BlockLayout, measure bool)
	let notes = fn.keepsSpans and not measure
	if notes 'code'
		lay.startCode(fn, at: u.asm.pos())
	end 'code'
	for _ in 0 upto fn.blocks.count() 'labels'
		_ = u.asm.newLabel()
	end 'labels'
	for pos in 0 upto lay.order.count() 'blocks'
		let b = lay.order[pos]
		if measure 'note'
			lay.starts.push(u.sectionOffset())
		end 'note' else 'pad'
			if lay.isLoopHead(pos) 'loop'
				encodeNops(u.asm.code, bytes: fitLine(u.sectionOffset(), bytes: lay.loopBytes(pos)))
			end 'loop'
		end 'pad'
		u.asm.bind(b as LabelID)
		var next = noNextBlock
		if pos + 1 < lay.order.count() 'follows'
			next = lay.order[pos + 1] as ir.Index
		end 'follows'
		var k = fn.blocks[b as Count].first
		while k < fn.blocks[b as Count].endAt 'instrs'
			let at = u.asm.pos()
			let encoded = k
			k = encodeAt(u, fn: fn, lay: lay, k: k, stop: fn.blocks[b as Count].endAt, next: next)
			if notes 'rows'
				noteSpans(u, fn: fn, lay: lay, from: encoded, upTo: k, at: at)
			end 'rows'
		end 'instrs'
		if notes 'end'
			lay.codeEnd[b as Count] = u.asm.pos()
		end 'end'
	end 'blocks'
	if measure 'end'
		lay.starts.push(u.sectionOffset())
	end 'end'
end 'encodeBlocks'

// noNextBlock is the block after the last one laid out, which no branch goes to.
let noNextBlock = -1 as ir.Index

// encodeAt encodes instruction k of fn, or it and the one after it in its block, which ends at stop, as one, and is the
// instruction after them: a jump to the block laid out next is left out, a conditional branch to it over a jump becomes
// one branch the other way, and a copy and the addition of a constant to it, whose flags nothing reads, become one lea.
function encodeAt(mutates u CodeUnit, fn MirFunction, lay BlockLayout, k Count, stop Count, next ir.Index) returns Count
	let after = nextCount(k)
	if isEdgeJump(fn.instrs[k]) and lay.goesTo(fn, edge: refIndex(fn.instrs[k]), b: next) 'fallsThrough'
		return after
	end 'fallsThrough'
	if after < stop 'pair'
		if isEdgeBranch(fn.instrs[k]) and isEdgeJump(fn.instrs[after]) and lay.goesTo(fn, edge: refIndex(fn.instrs[k]), b: next) 'overJump'
			encodeJccRel32(u.asm.code, cond: negated(fn.instrs[k].cond), rel: 0)
			u.asm.useLabel(lay.label(fn, edge: refIndex(fn.instrs[after])))
			return nextCount(after)
		end 'overJump'
		if isCopyAdded(fn.instrs[k], add: fn.instrs[after]) and not lay.flagsLiveAfter[after] 'lea'
			encodeLeaRegBaseDisp(u.asm.code, dest: generalRegister(fn.instrs[after].a), base: generalRegister(fn.instrs[k].b), disp: addedDisp(fn.instrs[after]))
			return nextCount(after)
		end 'lea'
	end 'pair'
	if isZeroConstant(fn.instrs[k]) and not lay.flagsLiveAfter[k] 'zero'
		let r = generalRegister(fn.instrs[k].a)
		encodeXorReg32Reg32(u.asm.code, dest: r, src: r)
		return after
	end 'zero'
	encodeMachineInstr(u, fn: fn, lay: lay, x: fn.instrs[k])
	return after
end 'encodeAt'

// isEdgeBranch is whether an instruction is a conditional branch along an edge.
function isEdgeBranch(x MInstr) returns bool
	return isX64Form(x, form: X64Form.jccRel32) and x.ref == MRef.edge
end 'isEdgeBranch'

// isCopyAdded is whether add adds a constant to the register a copy before it wrote, the copy that allocation makes of
// a two-address form's operand where the operand lives on.
function isCopyAdded(copy MInstr, add MInstr) returns bool
	if copy.kind != MKind.copy or copy.a == copy.b or add.kind != MKind.target or add.a != copy.a or add.b != copy.a 'apart'
		return false
	end 'apart'
	return isX64Form(add, form: X64Form.addRegImm8) or isX64Form(add, form: X64Form.addRegImm32) or isX64Form(add, form: X64Form.subRegImm8) or isX64Form(add, form: X64Form.subRegImm32)
end 'isCopyAdded'

// addedDisp is the displacement that a lea adds for an addition or a subtraction of a constant.
function addedDisp(add MInstr) returns Imm32
	if isX64Form(add, form: X64Form.subRegImm8) or isX64Form(add, form: X64Form.subRegImm32) 'sub'
		return try (0 - add.imm) as Imm32 otherwise panic("backend: a subtraction of a constant whose negation is past 32 bits")
	end 'sub'
	return try add.imm as Imm32 otherwise panic("backend: an addition of a constant past 32 bits")
end 'addedDisp'

// isZeroConstant is whether an instruction sets a register to 0.
function isZeroConstant(x MInstr) returns bool
	return (isX64Form(x, form: X64Form.movRegImm32) or isX64Form(x, form: X64Form.movRegImm32Signed) or isX64Form(x, form: X64Form.movRegImm64)) and x.imm == 0
end 'isZeroConstant'

function encodeMachineInstr(mutates u CodeUnit, fn MirFunction, lay BlockLayout, x MInstr)
	match x.kind 'kind'
		target then encodeTargetInstr(u, fn: fn, lay: lay, x: x)
		copy then encodeCopy(u, x: x)
		spill then encodeSpill(u, x: x)
		reload or
		restore then encodeReload(u, x: x)
		parallelCopy then panic("backend: a parallel copy that allocation left")
		frameSetup then encodeFrameSetup(u, fn: fn, framed: lay.framed)
		frameTeardown then encodeFrameTeardown(u, fn: fn, framed: lay.framed)
	end 'kind'
end 'encodeMachineInstr'

// encodeCopy moves a register to another of its class: an xmm register whole, so the copy depends on nothing its target
// held.
function encodeCopy(mutates u CodeUnit, x MInstr)
	if x.a == x.b 'same'
		return
	end 'same'
	match classOfNumber(x64Arch, number: physicalNumber(x.a)) 'class'
		gpr then encodeMovRegReg(u.asm.code, dest: generalRegister(x.a), src: generalRegister(x.b))
		xmm then encodeMovapsRegReg(u.asm.code, dest: vectorRegister(x.a), src: vectorRegister(x.b))
	end 'class'
end 'encodeCopy'

// encodeSpill stores a register in its spill slot, a word, the low 64 bits of an xmm register.
function encodeSpill(mutates u CodeUnit, x MInstr)
	let disp = spillSlotOffset(spillSlotOf(x))
	match classOfNumber(x64Arch, number: physicalNumber(x.a)) 'class'
		gpr then encodeStoreBaseDispReg(u.asm.code, base: X64Register.rbp, disp: disp, src: generalRegister(x.a))
		xmm then encodeMovsdBaseDispReg(u.asm.code, base: X64Register.rbp, disp: disp, src: vectorRegister(x.a))
	end 'class'
end 'encodeSpill'

function encodeReload(mutates u CodeUnit, x MInstr)
	let disp = spillSlotOffset(spillSlotOf(x))
	match classOfNumber(x64Arch, number: physicalNumber(x.a)) 'class'
		gpr then encodeLoadRegBaseDisp(u.asm.code, dest: generalRegister(x.a), base: X64Register.rbp, disp: disp)
		xmm then encodeMovsdRegBaseDisp(u.asm.code, dest: vectorRegister(x.a), base: X64Register.rbp, disp: disp)
	end 'class'
end 'encodeReload'

// operandRegister is register operand i of a form as its encoder takes it, of the class the form names it, or rax for
// one the form does not have, which its encoder does not read.
function operandRegister(x MInstr, index Count, count Count) returns X64Register
	if index >= count 'absent'
		return X64Register.rax
	end 'absent'
	let r = operandAt(x, index: index)
	return match operandClass(x.form, index: index) 'class'
		gpr gives generalRegister(r)
		xmm gives vectorRegister(r)
	end 'class'
end 'operandRegister'

function encodeTargetInstr(mutates u CodeUnit, fn MirFunction, lay BlockLayout, x MInstr)
	if reuses(x) and x.a != x.b 'reuse'
		panic("backend: a two-address definition in another register than the operand it reuses")
	end 'reuse'
	if hasPatchField(x.form) != (x.ref != MRef.none) 'reference'
		panic("backend: a reference on a form without a field for it, or a field with no reference")
	end 'reference'
	let n = machineOperandCount(x.form)
	encodeMachineForm(u.asm.code, form: x.form, a: operandRegister(x, index: 0, count: n), b: operandRegister(x, index: 1, count: n), c: operandRegister(x, index: 2, count: n), aux: x.aux, imm: x.imm, cond: x.cond)
	match x.ref 'ref'
		none then return
		edge then u.asm.useLabel(lay.label(fn, edge: refIndex(x)))
		symbol then u.asm.noteSymbolFixup(fn.symbols[refIndex(x)])
		data then u.asm.noteDataFixup(refIndex(x))
		importSlot then u.asm.noteImportFixup(fn.symbols[refIndex(x)])
	end 'ref'
end 'encodeTargetInstr'

// vectorSaveBytes is the room the prologue saves an xmm register in: the convention keeps all 128 bits of one, which a
// scalar operation or a movq may change above the double it holds.
let vectorSaveBytes = 16

// vectorSaveDisp is where, below the frame pointer, the prologue saves the nth of the xmm registers it saves: below the
// slots.
function vectorSaveDisp(fn MirFunction, nth Count) returns Imm32
	let below = try fn.frameBytes() + (nth + 1) * vectorSaveBytes otherwise panic("backend: a frame past memory")
	return try (0 - (below as FullRangeInt)) as Imm32 otherwise panic("backend: a frame past 2 GiB")
end 'vectorSaveDisp'

// savedVectorBytes is the room the xmm registers the prologue saves take below the slots.
function savedVectorBytes(fn MirFunction) returns Count
	return try maskCount(fn.savedRegs and classMask(x64Arch, class: RegClass.xmm)) * vectorSaveBytes otherwise panic("backend: a frame past memory")
end 'savedVectorBytes'

// encodeFrameSetup is the prologue. A function with a frame saves rbp, points it at the frame, and makes room for its
// slots below it and the xmm registers it saves below them, touching each page of a frame past one; then it pushes the
// general callee-saved registers it was given, so that rsp is 16-byte aligned at a call, and saves the xmm ones. A leaf
// with no frame only pushes the general ones, and gave its values no xmm register the convention keeps.
function encodeFrameSetup(mutates u CodeUnit, fn MirFunction, framed bool)
	if framed 'frame'
		encodePushReg(u.asm.code, reg: X64Register.rbp)
		encodeMovRegReg(u.asm.code, dest: X64Register.rbp, src: X64Register.rsp)
		let saved = try maskCount(fn.savedRegs and classMask(x64Arch, class: RegClass.gpr)) * wordBytes otherwise panic("backend: a frame past memory")
		let slots = try alignUp(fn.frameBytes() + savedVectorBytes(fn) + saved, alignment: x64StackAlignment) - saved otherwise panic("backend: a frame below zero")
		var frame = slots as Count
		let probes = addCounts(slots, b: saved) > machinePageSize
		while frame > machinePageSize 'pages'
			encodeSubRegImm(u.asm.code, dest: X64Register.rsp, imm: machinePageSize)
			encodeStoreBaseDispReg(u.asm.code, base: X64Register.rsp, disp: 0, src: X64Register.rax)
			frame = frame - machinePageSize
		end 'pages'
		if frame > 0 'rest'
			encodeSubRegImm(u.asm.code, dest: X64Register.rsp, imm: imm32Of(frame))
		end 'rest'
		if probes 'last'
			encodeStoreBaseDispReg(u.asm.code, base: X64Register.rsp, disp: 0, src: X64Register.rax)
		end 'last'
	end 'frame'
	for r in 0 upto x64FirstVector 'saved'
		if maskHas(fn.savedRegs, number: regNumOfCount(r)) 'save'
			encodePushReg(u.asm.code, reg: x64RegisterOf(regNumOfCount(r)))
		end 'save'
	end 'saved'
	var nth = 0 as Count
	for r in x64FirstVector upto x64RegisterFileSize 'vectors'
		if maskHas(fn.savedRegs, number: regNumOfCount(r)) 'save'
			encodeMovupsBaseDispReg(u.asm.code, base: X64Register.rbp, disp: vectorSaveDisp(fn, nth: nth), src: vectorRegister(physOfCount(r)))
			nth = nextCount(nth)
		end 'save'
	end 'vectors'
end 'encodeFrameSetup'

// x64FrameSize is the bytes the frame encodeFrameSetup makes takes below the return address: rbp, the slots and the xmm
// registers it saves, and the general registers it pushes.
function x64FrameSize(fn MirFunction, framed bool) returns Count
	let saved = try maskCount(fn.savedRegs and classMask(x64Arch, class: RegClass.gpr)) * wordBytes otherwise panic("backend: a frame past memory")
	if not framed 'leaf'
		return saved
	end 'leaf'
	return try wordBytes + alignUp(fn.frameBytes() + savedVectorBytes(fn) + saved, alignment: x64StackAlignment) otherwise panic("backend: a frame past memory")
end 'x64FrameSize'

// encodeFrameTeardown restores the xmm registers the prologue saved and pops the general ones it pushed, in the other
// order, then drops the frame.
function encodeFrameTeardown(mutates u CodeUnit, fn MirFunction, framed bool)
	var nth = 0 as Count
	for v in x64FirstVector upto x64RegisterFileSize 'vectors'
		if maskHas(fn.savedRegs, number: regNumOfCount(v)) 'restore'
			encodeMovupsRegBaseDisp(u.asm.code, dest: vectorRegister(physOfCount(v)), base: X64Register.rbp, disp: vectorSaveDisp(fn, nth: nth))
			nth = nextCount(nth)
		end 'restore'
	end 'vectors'
	var r = x64FirstVector as Count
	while r > 0 'saved'
		r = prevCount(r)
		if maskHas(fn.savedRegs, number: regNumOfCount(r)) 'restore'
			encodePopReg(u.asm.code, reg: x64RegisterOf(regNumOfCount(r)))
		end 'restore'
	end 'saved'
	if framed 'frame'
		encodeLeave(u.asm.code)
	end 'frame'
end 'encodeFrameTeardown'

// needsFrame is whether a function needs a frame of its own: it has slots or spills, which are addressed from rbp, or it
// calls, which needs rsp aligned, or it names rbp or rsp itself. Otherwise it is a leaf that keeps only the callee-saved
// registers it was given.
function needsFrame(fn MirFunction) returns bool
	if fn.slotsGiven() > 0 or (fn.savedRegs and classMask(x64Arch, class: RegClass.xmm)) != 0 'slots'
		return true
	end 'slots'
	let fp = x64PhysReg(rbp)
	let sp = x64PhysReg(rsp)
	for k in 0 upto fn.instrs.count() 'instrs'
		if usesFrame(fn.instrs[k], fp: fp, sp: sp) 'uses'
			return true
		end 'uses'
	end 'instrs'
	return false
end 'needsFrame'

function usesFrame(x MInstr, fp MReg, sp MReg) returns bool
	return match x.kind 'kind'
		target gives isCall(x.form) or isX64Form(x, form: X64Form.pushReg) or isX64Form(x, form: X64Form.popReg) or isX64Form(x, form: X64Form.pushImm32) or namesFrame(x, fp: fp, other: sp)
		copy gives namesFrame(x, fp: fp, other: sp)
		spill or
		reload or
		restore gives true
		parallelCopy gives panic("backend: a parallel copy that allocation left")
		frameSetup or
		frameTeardown gives false
	end 'kind'
end 'usesFrame'

// namesFrame is whether an instruction names as an operand the frame pointer or the other register a frame of its own
// is kept by: x64's stack pointer, or arm64's link register, which the frame record saves.
function namesFrame(x MInstr, fp MReg, other MReg) returns bool
	for i in 0 upto operandCount(x) 'operands'
		let r = operandAt(x, index: i)
		if r == fp or r == other 'frame'
			return true
		end 'frame'
	end 'operands'
	return false
end 'namesFrame'
