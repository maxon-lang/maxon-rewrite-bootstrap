// Instruction selection: a module's functions, from their IR, into machine IR (mir.maxon), which the allocator gives
// registers and the encoder of the architecture writes into the module's code unit. The rules of each instruction set
// (internal/rulegen/x64.rules, arm64.rules) select most operations (lower_x64_gen.maxon, lower_arm64_gen.maxon, generated);
// the helpers here select the
// rest that every architecture selects alike: the calls of functions, function values, interface methods and runtime
// entries, the boxes, closures, behaviours and coroutines, the drops and copies, a switch and a return. They write the
// machine through the primitives of the architecture compiled for (isel_x64.maxon, isel_arm64.maxon), which also holds its half of the
// calls (where the convention puts each argument), its prologue and the helpers its rules name for what only it does.
//
// Every register of the IR is the virtual register of the same number from firstVirtual, so a block's parameters and an
// edge's arguments are those registers, and the code of a block may name a register that a block written later defines.
// IR block b is machine block b, and the blocks that the prologue and a helper's branches need are made after them.
//
// Calls use the internal convention of the target table (regs_x64_gen.maxon, regs_arm64_gen.maxon): the first words in its registers and the
// first floats in its float registers, each class counted apart, and the rest on the stack; the result in its result
// register, a float's in its float result register, and the error of a function that throws beside it in its error
// register. Which arguments and results are floats is the call's float signature and the function's
// (ir/convention.maxon). A function copies its parameters out of the argument registers first. A call of a function value
// passes the closure last, so that the code of a named function, which takes the same arguments but the closure, never
// reaches it.
// ifaceBoxWords is how many words of the frame a frame box takes.
let ifaceBoxWords = ifaceBoxBytes / wordBytes

let shiftBitCount = 64

let signBitShift = 63

typealias CalleeSymbols = table.IntMap with String

typealias TableSet = table.StringMap with bool

// DefAt is the instruction that defines a register, or noDefAt for a block's parameter.
typealias DefAt = int(-1 to 2147483647)

typealias DefAtList = Array with DefAt

let noDefAt = -1 as DefAt

// Referent is what the field a form ends with refers to: an edge, a symbol, data or an import.
export type Referent
	export var ref as MRef
	export var aux as Imm32

	static function make(ref MRef, aux Imm32) returns Referent
		return Referent{ref: ref, aux: aux}
	end 'make'
end 'Referent'

function regIndex(r ir.Reg) returns Count
	return try r as Count otherwise panic("backend: a register that is not one")
end 'regIndex'

// vregOf is the virtual register of a register of the IR.
function vregOf(r ir.Reg) returns MReg
	return vregAt(regIndex(r))
end 'vregOf'

function blockOf(b ir.BlockID) returns MBlockID
	return try b as MBlockID otherwise panic("backend: a branch to no block")
end 'blockOf'

// Selector writes one module's functions into its unit. The rules get no project, so what the instructions of the
// function name by a handle that only the project can spell is looked up once, before the function is selected.
export type Selector
	var u as CodeUnit
	var mir as MirFunction
	// defs is the instruction that defines each register of the function being selected.
	var defs as DefAtList
	// second is the virtual register of the second word of each String register of the function being selected, its word,
	// and noMReg for every other register: a String is two words, and the IR register's own is its first.
	var second as MRegList
	// stringTy is the type String, whose values are two words, and characterTy the type Character, laid out as a String.
	var stringTy as ast.TypeID
	var characterTy as ast.TypeID
	var args as MRegList
	// callArgs are the arguments of the call being selected, in the order the convention passes them, and callFloats
	// which of them are floats; places is where the convention puts them (placeArgs).
	var callArgs as MRegList
	var callFloats as Array with bool
	var places as CountList
	// params are the registers the function's parameters were copied to out of the argument registers, noMReg for one
	// passed on the stack, and paramPlaces where the convention passes each; paramFloats are which of them are floats, in
	// the order the convention passes them.
	var params as MRegList
	var paramPlaces as CountList
	var paramFloats as Array with bool
	// params and paramPlaces are by word, a String parameter's two in a row: paramWordAt is the first word of each
	// parameter, and wordPositions where the convention passes each word, as paramFloats has them.
	var paramWordAt as CountList
	var wordPositions as CountList
	// closureBody is whether the function being selected is the body of a closure, whose first parameter, the closure,
	// the convention passes last.
	var closureBody as bool
	// calleeSymbols are the symbols of the callees of the function being selected, by function.
	var calleeSymbols as CalleeSymbols
	// canThrow is whether the function being selected returns an error beside its value, and floatResult whether its
	// value is a float.
	var canThrow as bool
	var floatResult as bool
	// fnSymbol is the link name of the function being selected, which the bodies of its closures are named after.
	var fnSymbol as String
	// tables are the tables of interface values that the unit has, and due the ones the function being selected names
	// that the unit does not have yet, which are written after it.
	var tables as TableSet
	var due as ir.WitnessTableList
	// thunks are the thunks of the functions that async calls start which the unit has, and dueThunks the functions whose
	// thunks the function being selected needs and the unit does not have yet, which are written after it.
	var thunks as TableSet
	var dueThunks as ast.FuncIDList
	// typeNames are the symbols of the data that names each type that the unit's tables hold and its casts test, which
	// the unit defines once each.
	var typeNames as TableSet
	var typeSymbols as CalleeSymbols
	// datums are the constants of the executable's data that the unit defines, by symbol.
	var datums as TableSet
	// readCount is how many times the instructions and terminators of the function being selected read each register,
	// so that a rule fuses an operation only into its one reader; reads is a list the counting reuses.
	var readCount as CountList
	var reads as ir.RegList
	// irBlock is the IR block being selected, and irAt the instruction being selected.
	var irBlock as Count
	var irAt as Count
	// dead removes the code that fusing left without a reader, and layout lays out the blocks for the encoder.
	var dead as DeadCode
	var layout as BlockLayout
	// allocator allocates the registers of every function of the module.
	var allocator as Allocator
	// classes decides the register class of each register of the function being selected.
	var classes as ClassChoice
	// arch and system are the target the module is compiled for: the architecture of the machine IR, and the system,
	// which reads a thread's context and reaches the kernel its own way.
	var arch as ast.TargetArch
	var system as ast.TargetSystem
	// harvest describes the locals of a function that keeps spans (locals.maxon).
	var harvest as LocalHarvest
	// sharedWords are the words that no one move sets which the function being selected makes once, on arm64.
	var sharedWords as WordSharing
	// spareInstrs is the buffer of the machine instructions of the function selected last, which the next one writes into
	// rather than growing a new one.
	var spareInstrs as MInstrList

	static function new(verifies bool, target ast.Target) returns Selector
		return Selector{u: CodeUnit.new(), mir: MirFunction.new("", canThrow: false, arch: target.arch), defs: DefAtList.create(0), second: MRegList.create(0), stringTy: ast.noType, characterTy: ast.noType, args: MRegList.create(0), callArgs: MRegList.create(0), callFloats: Array.create(0), places: CountList.create(0), params: MRegList.create(0), paramPlaces: CountList.create(0), paramFloats: Array.create(0), paramWordAt: CountList.create(0), wordPositions: CountList.create(0), closureBody: false, calleeSymbols: CalleeSymbols.new(), canThrow: false, floatResult: false, fnSymbol: "", tables: TableSet.new(), due: ir.WitnessTableList.create(0), thunks: TableSet.new(), dueThunks: ast.FuncIDList.create(0), typeNames: TableSet.new(), typeSymbols: CalleeSymbols.new(), datums: TableSet.new(), readCount: CountList.create(0), reads: ir.RegList.create(0), irBlock: 0, irAt: 0, dead: DeadCode.new(), layout: BlockLayout.new(), allocator: Allocator.new(verifies, target: target), classes: ClassChoice.new(), arch: target.arch, system: target.system, harvest: LocalHarvest.new(), sharedWords: WordSharing.new(), spareInstrs: MInstrList.create(0)}
	end 'new'

	// prepare names what the function's instructions ask for by handle: the symbols of its callees, and the drop and copy
	// routines of its types, which are asked for in the order the code does.
	function prepare(mutates self, p ast.Project, mutates ms ast.ModuleState, f ir.IrFunction)
		canThrow = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f.decl).errTy != ast.noType
		stringTy = p.builtins.stringTy
		characterTy = p.builtins.characterTy
		floatResult = f.floatResult
		calleeSymbols = CalleeSymbols.new()
		for i in 0 upto f.callees.count() 'callees'
			calleeSymbols.insert(f.callees[i] as Count, value: ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: f.callees[i]))
		end 'callees'
		for i in 0 upto f.tables.count() 'tables'
			if not tables.has(f.tables[i].symbol) 'new'
				tables.insert(f.tables[i].symbol.clone(), value: true)
				due.push(f.tables[i].clone())
				_ = self.typeName(p, ms: ms, t: f.tables[i].concrete)
			end 'new'
		end 'tables'
		for i in 0 upto f.datums.count() 'datums'
			if not datums.has(f.datums[i].symbol) 'new'
				datums.insert(f.datums[i].symbol.clone(), value: true)
				u.defineDatum(f.datums[i])
			end 'new'
		end 'datums'
		defs.clear()
		for _ in 0 upto f.regs.count() 'regs'
			defs.push(noDefAt)
		end 'regs'
		for k in 0 upto f.instrs.count() 'instrs'
			let op = f.instrs[k].op
			let dst = f.instrs[k].dst
			if dst != ir.noReg 'defines'
				defs[regIndex(dst)] = try k as DefAt otherwise panic("backend: more instructions than a register names")
			end 'defines'
			if op == ir.Opcode.opDrop 'drop'
				_ = u.needed.symbol(p, ms: ms, kind: RoutineKind.dropRoutine, ty: ir.dropTy(f, x: f.instrs[k]))
			end 'drop' else if op == ir.Opcode.opAsync 'async'
				let started = ir.asyncCallee(f, x: f.instrs[k])
				let thunk = asyncThunkSymbol(self.calleeSymbol(started))
				if not thunks.has(thunk) 'new'
					thunks.insert(thunk, value: true)
					dueThunks.push(started)
				end 'new'
			end 'async' else if op == ir.Opcode.opIsType 'isType'
				let ty = ir.isTypeTy(f, x: f.instrs[k])
				let named = self.typeName(p, ms: ms, t: ty)
				typeSymbols.insert(ty as Count, value: named)
			end 'isType' else if op == ir.Opcode.opDropSlot 'dropSlot'
				_ = u.needed.symbol(p, ms: ms, kind: RoutineKind.dropRoutine, ty: ir.dropSlotTy(f, x: f.instrs[k]))
			end 'dropSlot' else if op == ir.Opcode.opDropAt 'dropAt'
				_ = u.needed.symbol(p, ms: ms, kind: RoutineKind.dropRoutine, ty: ir.dropAtTy(f, x: f.instrs[k]))
			end 'dropAt' else if op == ir.Opcode.opCopy 'copy'
				_ = u.needed.symbol(p, ms: ms, kind: RoutineKind.copyRoutine, ty: ir.copyTy(f, x: f.instrs[k]))
			end 'copy'
		end 'instrs'
		self.countReads(f)
	end 'prepare'

	function countReads(mutates self, f ir.IrFunction)
		ir.resetCounts(readCount, n: f.regs.count())
		for b in 0 upto f.blocks.count() 'blocks'
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				reads.clear()
				ir.instrReads(f, x: f.instrs[k], out: reads)
				self.countRead()
			end 'instrs'
			reads.clear()
			ir.termReads(f, t: f.blocks[b].term, out: reads)
			self.countRead()
		end 'blocks'
	end 'countReads'

	function countRead(mutates self)
		for i in 0 upto reads.count() 'each'
			let r = regIndex(reads[i])
			readCount[r] = nextCount(readCount[r])
		end 'each'
	end 'countRead'

	// fuses is whether the instruction or terminator being selected may make the value of the register r itself, in place
	// of reading it: it is the only reader, and the instruction that defines r comes right before it in its block, so
	// nothing between writes the flags or memory and no operand of the definition lives longer. The definition is still
	// selected at its place; the dead code removal leaves it out.
	function fuses(f ir.IrFunction, r ir.Reg) returns bool
		let d = defs[regIndex(r)]
		if d == noDefAt or readCount[regIndex(r)] != 1 or irAt == f.blocks[irBlock].first 'apart'
			return false
		end 'apart'
		return (d as Count) == prevCount(irAt)
	end 'fuses'

	// knownLength is whether the IR register index holds the length of the array in the IR register box at the instruction
	// being selected: a length of it earlier in the same block defines index, and nothing between writes memory or calls
	// (the IR table's effects), so nothing between can have changed the length.
	function knownLength(f ir.IrFunction, box ir.Reg, index ir.Reg) returns bool
		if not self.definedBy(f, r: index, op: ir.Opcode.opLength) 'other'
			return false
		end 'other'
		let d = self.defOf(index)
		if ir.lengthSrc(f.instrs[d]) != box or ir.lengthOf(f.instrs[d]) != ir.Collection.collectionArray or d < f.blocks[irBlock].first or d >= irAt 'elsewhere'
			return false
		end 'elsewhere'
		for k in nextCount(d) upto irAt 'between'
			if (ir.opEffects(f.instrs[k].op) and (ir.effectWrites or ir.effectCalls)) != 0 'changes'
				return false
			end 'changes'
		end 'between'
		return true
	end 'knownLength'

	// typeName is the symbol of the word of data whose address names the type t, for the table of a value of it and the cast
	// that tests for it, defined in the unit once.
	function typeName(mutates self, p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
		let symbol = typeNameSymbol(p, ms: ms, t: t)
		if not typeNames.has(symbol) 'new'
			typeNames.insert(symbol.clone(), value: true)
			u.defineSharedData(symbol, size: wordBytes)
		end 'new'
		return symbol
	end 'typeName'

	// The selection rules' interface: what the generated selections (lower_x64_gen.maxon) call.

	function emit(mutates self, consumes x MInstr)
		mir.emit(x)
	end 'emit'

	function newTemp(mutates self) returns MReg
		return mir.newVReg(RegClass.gpr)
	end 'newTemp'

	// newTempOf is a new register of a class.
	function newTempOf(mutates self, class RegClass) returns MReg
		return mir.newVReg(class)
	end 'newTempOf'

	// inXmm is whether the class analysis gave the IR register r an xmm register.
	function inXmm(r ir.Reg) returns bool
		return mir.classes[regIndex(r)] == RegClass.xmm
	end 'inXmm'

	// floatRef is the word of the unit's data that holds the bits of a constant, which a form reads into an xmm register.
	function floatRef(mutates self, bits ir.Word) returns Referent
		return Referent.make(MRef.data, aux: imm32Of(u.data.wordOffset(ir.bitsOfWord(bits))))
	end 'floatRef'

	// resultOf is the register an instruction's result is defined in: its register's, or a new one for a result that the
	// IR does not keep.
	function resultOf(mutates self, r ir.Reg) returns MReg
		if r == ir.noReg 'none'
			return self.newTemp()
		end 'none'
		return vregOf(r)
	end 'resultOf'

	// definedBy is whether an instruction of the opcode op defines the register r.
	function definedBy(f ir.IrFunction, r ir.Reg, op ir.Opcode) returns bool
		let at = defs[regIndex(r)]
		if at == noDefAt 'parameter'
			return false
		end 'parameter'
		return f.instrs[at as Count].op == op
	end 'definedBy'

	// defOf is the instruction that defines the register r, which one does.
	function defOf(r ir.Reg) returns Count
		return try defs[regIndex(r)] as Count otherwise panic("backend: a register that no instruction defines is matched")
	end 'defOf'

	// edgeTo is the edge to an IR block that passes it the arguments args[start] on, count of them.
	function edgeTo(mutates self, f ir.IrFunction, target ir.BlockID, start Count, count Count) returns Referent
		let block = try target as Count otherwise panic("backend: an edge to no block")
		if count != f.blocks[block].paramCount 'arity'
			panic("backend: an edge passes {count} arguments to b{block}, which has {f.blocks[block].paramCount} parameters")
		end 'arity'
		args.clear()
		for i in 0 upto count 'args'
			let r = f.args[try start + i otherwise panic("backend: an argument past the pool")]
			args.push(vregOf(r))
			let word = second[regIndex(r)]
			if word != noMReg 'string'
				args.push(word)
			end 'string'
		end 'args'
		return Referent.make(MRef.edge, aux: mir.addEdge(blockOf(target), args: args))
	end 'edgeTo'

	function symbolRef(mutates self, name String) returns Referent
		return Referent.make(MRef.symbol, aux: mir.addSymbol(name))
	end 'symbolRef'

	// textRef is the data of the string an instruction gives.
	function textRef(mutates self, f ir.IrFunction, ins ir.Instr) returns Referent
		return Referent.make(MRef.data, aux: imm32Of(u.data.textOffset(ir.strText(f, x: ins))))
	end 'textRef'

	// datumRef is the constant an instruction gives, which prepare defined in the unit.
	function datumRef(mutates self, f ir.IrFunction, ins ir.Instr) returns Referent
		return self.symbolRef(f.datums[ir.datumItem(ins)].symbol)
	end 'datumRef'

	function calleeRef(mutates self, fid ast.FuncID) returns Referent
		return self.symbolRef(self.calleeSymbol(fid))
	end 'calleeRef'

	// calleeSymbol is the link name of a function the function being selected calls or takes the code of.
	function calleeSymbol(fid ast.FuncID) returns String
		return match calleeSymbols.get(fid as Count) 'callee'
			some(name) gives name.clone()
			none gives panic("backend: a callee that prepare did not name")
		end 'callee'
	end 'calleeSymbol'

	// The helpers' own building blocks.

	function copy(mutates self, dst MReg, src MReg)
		mir.emit(newCopy(dst, src: src))
	end 'copy'

	function constant(mutates self, value FullRangeInt) returns MReg
		let d = self.newTemp()
		self.constantInto(d, value: value)
		return d
	end 'constant'

	function load(mutates self, base MReg, disp Imm32) returns MReg
		let d = self.newTemp()
		self.loadInto(d, base: base, disp: disp)
		return d
	end 'load'

	// addArg adds an argument to the call being selected, a float or a word.
	function addArg(mutates self, v MReg, float bool)
		callArgs.push(v)
		callFloats.push(float)
	end 'addArg'

	// addArgs adds the arguments args[start] on, count of them, to the call being selected, the floats among them as the
	// mask floats says from its place first on.
	function addArgs(mutates self, f ir.IrFunction, start Count, count Count, floats ir.FloatMask, first Count)
		for i in 0 upto count 'args'
			self.addValue(f.args[try start + i otherwise panic("backend: an argument past the pool")], float: ir.isFloatAt(floats, place: try first + i otherwise panic("backend: an argument past the pool")))
		end 'args'
	end 'addArgs'

	// addValue adds an IR register to the call being selected: a float, a word, or the two words of a String, in order.
	function addValue(mutates self, r ir.Reg, float bool)
		self.addArg(vregOf(r), float: float)
		let word = second[regIndex(r)]
		if word != noMReg 'string'
			self.addArg(word, float: false)
		end 'string'
	end 'addValue'

	// secondOf is the second word of the String in the IR register r.
	function secondOf(r ir.Reg) returns MReg
		let word = second[regIndex(r)]
		if word == noMReg 'none'
			panic("backend: in {fnSymbol}, the second word of register {r}, which holds no String")
		end 'none'
		return word
	end 'secondOf'

	// paramWords lays out the words of f's parameters, a String's two in a row: paramFloats is whether each is a float in the
	// order the convention passes them, paramWordAt the first word of each parameter, and wordPositions where in that order
	// each word is, by parameter.
	function paramWords(mutates self, f ir.IrFunction)
		paramFloats.clear()
		paramWordAt.clear()
		wordPositions.clear()
		var starts = CountList.create(0)
		for at in 0 upto f.paramCount 'order'
			let k = paramAtPosition(at, count: f.paramCount, closure: closureBody)
			starts.push(paramFloats.count())
			paramFloats.push(ir.isFloatAt(f.floatParams, place: k))
			if ir.isFloatAt(f.stringParams, place: k) 'string'
				paramFloats.push(false)
			end 'string'
		end 'order'
		for k in 0 upto f.paramCount 'params'
			let start = starts[paramPosition(k, count: f.paramCount, closure: closureBody)]
			paramWordAt.push(wordPositions.count())
			wordPositions.push(start)
			if ir.isFloatAt(f.stringParams, place: k) 'string'
				wordPositions.push(nextCount(start))
			end 'string'
		end 'params'
	end 'paramWords'

	// pairStrings gives each String register of f the virtual register of its second word, after those of every register.
	function pairStrings(mutates self, f ir.IrFunction)
		second.clear()
		for r in 0 upto f.regs.count() 'regs'
			if f.regs[r] == ir.IrKind.kindString 'string'
				second.push(mir.newVReg(RegClass.gpr))
			end 'string' else 'other'
				second.push(noMReg)
			end 'other'
		end 'regs'
	end 'pairStrings'

	// addWords adds the arguments args[start] on, count of them, to the call being selected, as words.
	function addWords(mutates self, f ir.IrFunction, start Count, count Count)
		self.addArgs(f, start: start, count: count, floats: 0 as ir.FloatMask, first: 0)
	end 'addWords'

	// takeResult puts what a call returned in dst, if the IR keeps it: a float from the convention's float result register.
	function takeResult(mutates self, dst ir.Reg, float bool)
		if dst != ir.noReg 'kept'
			self.copy(vregOf(dst), src: physOfNumber(internalResult(arch, float: float)))
			let word = second[regIndex(dst)]
			if word != noMReg 'string'
				self.copy(word, src: physOfNumber(internalSecondResultOf(arch)))
			end 'string'
		end 'kept'
	end 'takeResult'

	function takeError(mutates self, err table.Option with ir.Reg)
		match err 'throws'
			some(r) then self.copy(vregOf(r), src: physOfNumber(internalErrorOf(arch)))
			none then return
		end 'throws'
	end 'takeError'

	// callWords calls a symbol with the words args[start] on, count of them, and takes the word it returns into dst: a
	// runtime entry, which takes and returns only words (README, "The runtime").
	function callWords(mutates self, f ir.IrFunction, symbol String, start Count, count Count, dst ir.Reg)
		self.addWords(f, start: start, count: count)
		self.callSymbol(symbol)
		self.takeResult(dst, float: false)
	end 'callWords'

	// callRoutine calls the drop or copy routine of a type with one value. The routine is generated once for the program,
	// after every module, from the list each unit keeps of the ones it asked for.
	function callRoutine(mutates self, kind RoutineKind, ty ast.TypeID, value MReg)
		self.addArg(value, float: false)
		self.callSymbol(u.needed.lookup(kind, ty: ty))
	end 'callRoutine'

	// callRoutineOf calls the drop or copy routine of a type with the value in an IR register: a String's two words.
	function callRoutineOf(mutates self, kind RoutineKind, ty ast.TypeID, value ir.Reg)
		self.addValue(value, float: false)
		self.callSymbol(u.needed.lookup(kind, ty: ty))
	end 'callRoutineOf'

	// allocInto allocates a box of a number of bytes into dst.
	function allocInto(mutates self, dst MReg, bytes Count)
		let size = self.constant(try bytes as FullRangeInt otherwise panic("backend: a box past memory"))
		self.addArg(size, float: false)
		self.callSymbol(ir.rtSymbol(ir.Rt.rtAlloc))
		self.copy(dst, src: physOfNumber(internalResultOf(arch)))
	end 'allocInto'

	// jumpWith jumps to a block that takes one parameter, passing it value.
	function jumpWith(mutates self, block MBlockID, value MReg)
		args.clear()
		args.push(value)
		self.jumpTo(block)
	end 'jumpWith'

	// reach jumps to a block where paths meet, passing value when the block takes it.
	function reach(mutates self, block MBlockID, value MReg, keeps bool)
		if keeps 'passes'
			self.jumpWith(block, value: value)
			return
		end 'passes'
		args.clear()
		self.jumpTo(block)
	end 'reach'

	// join starts writing a block where the paths of a helper's branches meet, with the IR register r, which each path
	// passes, as its parameter.
	function join(mutates self, block MBlockID, r ir.Reg)
		mir.writeBlock(block)
		mir.addBlockParam(vregOf(r))
	end 'join'

	// addParamOf adds an IR register to the parameters of the block being written: its word, or a String's two.
	function addParamOf(mutates self, r ir.Reg)
		mir.addBlockParam(vregOf(r))
		let word = second[regIndex(r)]
		if word != noMReg 'string'
			mir.addBlockParam(word)
		end 'string'
	end 'addParamOf'

	// inBounds goes to slow unless the index is below the length the box holds at lengthOffset. The comparison is
	// unsigned, so no index the entry would refuse passes it.
	function inBounds(mutates self, box MReg, index MReg, lengthOffset Count, slow MBlockID)
		let length = self.load(box, disp: imm32Of(lengthOffset))
		self.compare(index, b: length)
		self.branchTo(MCond.aboveEqual, block: slow)
	end 'inBounds'

	// elementBuffer is the address of the elements of an array, after a branch to slow when the index is out of range; the
	// element is in it at the index.
	function elementBuffer(mutates self, box MReg, index MReg, slow MBlockID) returns MReg
		self.inBounds(box, index: index, lengthOffset: arrayLengthOffset, slow: slow)
		return self.load(box, disp: imm32Of(arrayDataOffset))
	end 'elementBuffer'

	// pushInPlace goes to slow unless the entry inserts at the end of an array whose buffer has room; otherwise it counts
	// the new element and is the address of the elements, which the new one goes into at the index. atEnd says that the
	// index is the array's length (knownLength), which a push's is, so only the room is tested.
	function pushInPlace(mutates self, box MReg, index MReg, atEnd bool, slow MBlockID) returns MReg
		if not atEnd 'end'
			let length = self.load(box, disp: imm32Of(arrayLengthOffset))
			self.compare(index, b: length)
			self.branchTo(MCond.notEqual, block: slow)
		end 'end'
		let capacity = self.load(box, disp: imm32Of(arrayCapacityOffset))
		self.compare(index, b: capacity)
		self.branchTo(MCond.aboveEqual, block: slow)
		let longer = self.offset(index, disp: 1)
		self.store(box, disp: imm32Of(arrayLengthOffset), src: longer)
		return self.load(box, disp: imm32Of(arrayDataOffset))
	end 'pushInPlace'

	// closureBox allocates the box of a closure into box and fills in its header. drop is the routine that drops what it
	// owns, or empty for none.
	function closureBox(mutates self, box MReg, code String, drop String, captures Count)
		self.allocInto(box, bytes: try closureCapturesOffset + captures * closureCaptureBytes otherwise panic("backend: a closure past memory"))
		self.storeImm(box, disp: imm32Of(closureCountOffset), value: 1)
		let codeAt = self.address(code)
		self.store(box, disp: imm32Of(closureCodeOffset), src: codeAt)
		if drop == "" 'nothing'
			self.storeImm(box, disp: imm32Of(closureDropOffset), value: 0)
		end 'nothing' else 'routine'
			let routine = self.address(drop)
			self.store(box, disp: imm32Of(closureDropOffset), src: routine)
		end 'routine'
	end 'closureBox'

	// fillBox writes the address of the table and the value into an interface value's box.
	function fillBox(mutates self, f ir.IrFunction, box MReg, table ir.WitnessTable, value ir.Reg)
		let tableAt = self.address(table.symbol)
		self.store(box, disp: imm32Of(ifaceTableOffset), src: tableAt)
		self.storeValue(box, disp: imm32Of(ifaceValueOffset), r: value, f: f)
	end 'fillBox'

	// The primitives of the architecture: what the shared helpers and the driver ask of the machine, each written by the
	// architecture's selector (isel_x64.maxon, isel_arm64.maxon), which is chosen here by the architecture compiled for.

	// constantInto sets dst to a word.
	function constantInto(mutates self, dst MReg, value FullRangeInt)
		match arch 'arch'
			x64 then self.x64ConstantInto(dst, value: value)
			arm64 then self.arm64ConstantInto(dst, value: value)
		end 'arch'
	end 'constantInto'

	// loadInto loads the word at base plus disp into dst.
	function loadInto(mutates self, dst MReg, base MReg, disp Imm32)
		match arch 'arch'
			x64 then self.x64LoadInto(dst, base: base, disp: disp)
			arm64 then self.arm64LoadInto(dst, base: base, disp: disp)
		end 'arch'
	end 'loadInto'

	// store stores the word src at base plus disp.
	function store(mutates self, base MReg, disp Imm32, src MReg)
		match arch 'arch'
			x64 then self.x64Store(base, disp: disp, src: src)
			arm64 then self.arm64StoreWord(base, disp: disp, src: src)
		end 'arch'
	end 'store'

	// storeImm stores a word that a doubleword sign-extends to at base plus disp.
	function storeImm(mutates self, base MReg, disp Imm32, value Imm32)
		match arch 'arch'
			x64 then self.x64StoreImm(base, disp: disp, value: value)
			arm64 then self.arm64StoreImm(base, disp: disp, value: value)
		end 'arch'
	end 'storeImm'

	// addImm is a register that src plus imm defines, which may write the flags.
	function addImm(mutates self, src MReg, imm Imm32) returns MReg
		return match arch 'arch'
			x64 gives self.x64AddImm(src, imm: imm)
			arm64 gives self.arm64AddConst(src, value: imm as FullRangeInt)
		end 'arch'
	end 'addImm'

	// offset is a register that src plus disp defines, which leaves the flags as they are.
	function offset(mutates self, src MReg, disp Imm32) returns MReg
		return match arch 'arch'
			x64 gives self.x64Offset(src, disp: disp)
			arm64 gives self.arm64AddConst(src, value: disp as FullRangeInt)
		end 'arch'
	end 'offset'

	// address is the address of a symbol.
	function address(mutates self, symbol String) returns MReg
		return match arch 'arch'
			x64 gives self.x64Address(symbol)
			arm64 gives self.arm64Address(symbol)
		end 'arch'
	end 'address'

	// constantArg is the word that the constant argument index of a call, its arguments from start, is.
	function constantArg(f ir.IrFunction, start Count, index Count) returns Count
		let r = f.args[try start + index otherwise panic("backend: an argument past the pool")]
		if not self.definedBy(f, r: r, op: ir.Opcode.opConst) 'other'
			panic("backend: an argument that is no constant is read as one")
		end 'other'
		return try f.instrs[self.defOf(r)].imm as Count otherwise panic("backend: a negative constant is read as a size")
	end 'constantArg'

	// strideAddress is the address of the element at an index of the buffer at base, whose elements are bytes bytes each, a
	// whole number of words: a shift where that number is a power of two, and a multiply of the index otherwise.
	function strideAddress(mutates self, base MReg, index MReg, bytes Count) returns MReg
		let words = bytes / wordBytes
		var power = 1 as Count
		var shift = wordElementShift as Count
		while power < words 'power'
			power = power + power
			shift = nextCount(shift)
		end 'power'
		if power == words 'shifted'
			return self.elementAddress(base, index: index, shift: shift)
		end 'shifted'
		let scaled = match arch 'arch'
			x64 gives self.x64MulImm(index, value: words)
			arm64 gives self.arm64MulImm(index, value: words)
		end 'arch'
		return self.elementAddress(base, index: scaled, shift: wordElementShift)
	end 'strideAddress'

	// elementAddress is the address of the element at an index of the buffer at base, whose elements are 1 shl shift bytes
	// each.
	function elementAddress(mutates self, base MReg, index MReg, shift Count) returns MReg
		return match arch 'arch'
			x64 gives self.x64ElementAddress(base, index: index, shift: shift)
			arm64 gives self.arm64ElementAddress(base, index: index, shift: shift)
		end 'arch'
	end 'elementAddress'

	// loadIndexedByte is a register that the byte at base plus index plus disp, zero-extended, defines.
	function loadIndexedByte(mutates self, base MReg, index MReg, disp Imm32) returns MReg
		return match arch 'arch'
			x64 gives self.x64LoadIndexedByte(base, index: index, disp: disp)
			arm64 gives self.arm64LoadIndexedByte(base, index: index, disp: disp)
		end 'arch'
	end 'loadIndexedByte'

	// storeIndexedByte stores the low byte of src at base plus index.
	function storeIndexedByte(mutates self, base MReg, index MReg, src MReg)
		match arch 'arch'
			x64 then self.x64StoreIndexedByte(base, index: index, src: src)
			arm64 then self.arm64StoreIndexedByte(base, index: index, src: src)
		end 'arch'
	end 'storeIndexedByte'

	// storeIndexedWord stores the word src at an index of the buffer at base.
	function storeIndexedWord(mutates self, base MReg, index MReg, src MReg)
		match arch 'arch'
			x64 then self.x64StoreIndexedWord(base, index: index, src: src)
			arm64 then self.arm64StoreIndexedWord(base, index: index, src: src)
		end 'arch'
	end 'storeIndexedWord'

	// compare sets the flags by a comparison of a with b.
	function compare(mutates self, a MReg, b MReg)
		match arch 'arch'
			x64 then self.x64Compare(a, b: b)
			arm64 then self.arm64Compare(a, b: b)
		end 'arch'
	end 'compare'

	// compareWith sets the flags by a comparison of a with a constant.
	function compareWith(mutates self, a MReg, value ir.Word)
		match arch 'arch'
			x64 then self.x64CompareWith(a, value: value)
			arm64 then self.arm64CompareWith(a, value: value)
		end 'arch'
	end 'compareWith'

	// flagInto puts in the register of dst 1 where the flags meet cond and 0 where they do not.
	function flagInto(mutates self, dst ir.Reg, cond MCond)
		match arch 'arch'
			x64 then self.x64FlagInto(dst, cond: cond)
			arm64 then self.arm64FlagInto(dst, cond: cond)
		end 'arch'
	end 'flagInto'

	// zeroInto sets the physical register r, a float's or a word's, to 0.
	function zeroInto(mutates self, r MReg, float bool)
		match arch 'arch'
			x64 then self.x64ZeroInto(r, float: float)
			arm64 then self.arm64ZeroInto(r, float: float)
		end 'arch'
	end 'zeroInto'

	// callSymbol calls a symbol by the internal convention with the arguments of the call being selected.
	function callSymbol(mutates self, symbol String)
		match arch 'arch'
			x64 then self.x64CallSymbol(symbol)
			arm64 then self.arm64CallSymbol(symbol)
		end 'arch'
	end 'callSymbol'

	// callRegister calls the code at the address in a register by the internal convention with the arguments of the
	// call being selected.
	function callRegister(mutates self, code MReg)
		match arch 'arch'
			x64 then self.x64CallRegister(code)
			arm64 then self.arm64CallRegister(code)
		end 'arch'
	end 'callRegister'

	// jumpTo ends the block being written with a jump to a block, with the arguments of args.
	function jumpTo(mutates self, block MBlockID)
		match arch 'arch'
			x64 then self.x64JumpTo(block)
			arm64 then self.arm64JumpTo(block)
		end 'arch'
	end 'jumpTo'

	// jumpAlong ends the block being written with a jump along an edge.
	function jumpAlong(mutates self, refers Referent)
		match arch 'arch'
			x64 then self.x64JumpAlong(refers)
			arm64 then self.arm64JumpAlong(refers)
		end 'arch'
	end 'jumpAlong'

	// branchAlong goes along an edge when the flags meet cond.
	function branchAlong(mutates self, cond MCond, refers Referent)
		match arch 'arch'
			x64 then self.x64BranchAlong(cond, refers: refers)
			arm64 then self.arm64BranchAlong(cond, refers: refers)
		end 'arch'
	end 'branchAlong'

	// branchTo goes to a block, which takes no arguments, when the flags meet cond, and otherwise to the block written
	// next, which it makes and starts.
	function branchTo(mutates self, cond MCond, block MBlockID)
		match arch 'arch'
			x64 then self.x64BranchTo(cond, block: block)
			arm64 then self.arm64BranchTo(cond, block: block)
		end 'arch'
	end 'branchTo'

	// failTo goes to an IR failure block when the flags meet cond, in the middle of the block, as the IR's own failure
	// edges leave.
	function failTo(mutates self, cond MCond, block ir.BlockID)
		match arch 'arch'
			x64 then self.x64FailTo(cond, block: block)
			arm64 then self.arm64FailTo(cond, block: block)
		end 'arch'
	end 'failTo'

	// leave ends the function: its epilogue and the return.
	function leave(mutates self)
		match arch 'arch'
			x64 then self.x64Leave()
			arm64 then self.arm64Leave()
		end 'arch'
	end 'leave'

	// takeParams copies the parameters of f that the internal convention passes in registers out of them, before
	// anything else can write one: each a float or a word as f's float signature says, which every call of it says too.
	function takeParams(mutates self, f ir.IrFunction)
		match arch 'arch'
			x64 then self.x64TakeParams(f)
			arm64 then self.arm64TakeParams(f)
		end 'arch'
	end 'takeParams'

	// zeroManagedSlots empties every slot that can own a value, so a drop of a slot that was moved from, or never assigned,
	// finds 0 and does nothing. A scalar slot is never dropped and is left as it is.
	function zeroManagedSlots(mutates self, f ir.IrFunction)
		match arch 'arch'
			x64 then self.x64ZeroManagedSlots(f)
			arm64 then self.arm64ZeroManagedSlots(f)
		end 'arch'
	end 'zeroManagedSlots'
end 'Selector'

function argAt(f ir.IrFunction, start Count, index Count) returns MReg
	return vregOf(f.args[try start + index otherwise panic("backend: an argument past the pool")])
end 'argAt'

// The helpers that the rules of every instruction set name, one per operation that a sequence of forms does not select.

// emitCallCode calls the code at the address that is the first of the arguments with the rest, words: the run of a
// behaviour's record, which takes a word.
function emitCallCode(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let start = ir.callCodeArgsStart(ins)
	let count = ir.callCodeArgsCount(ins)
	let words = try count - 1 otherwise panic("backend: a call of code with no address")
	sel.addWords(fn, start: try start + 1 otherwise panic("backend: an argument past the pool"), count: words)
	sel.callRegister(argAt(fn, start: start, index: 0))
	sel.takeResult(ins.dst, float: false)
end 'emitCallCode'

function emitCall(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let symbol = sel.calleeSymbol(ir.callCallee(fn, x: ins))
	sel.addArgs(fn, start: ir.callArgsStart(ins), count: ir.callArgsCount(ins), floats: ir.callFloats(fn, x: ins), first: 0)
	sel.callSymbol(symbol)
	sel.takeResult(ins.dst, float: ir.callReturnsFloat(ins))
	sel.takeError(ir.callErrReg(ins))
end 'emitCall'

// emitCallValue calls the code a closure holds with the arguments and then the closure, which the body of a closure
// reads its captures from.
function emitCallValue(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let start = ir.callValueArgsStart(ins)
	let count = ir.callValueArgsCount(ins)
	let closure = argAt(fn, start: start, index: 0)
	let code = sel.load(closure, disp: imm32Of(closureCodeOffset))
	sel.addArgs(fn, start: try start + 1 otherwise panic("backend: an argument past the pool"), count: try count - 1 otherwise panic("backend: a call of a function value with no closure"), floats: ir.callFloats(fn, x: ins), first: 1)
	sel.addArg(closure, float: false)
	sel.callRegister(code)
	sel.takeResult(ins.dst, float: ir.callReturnsFloat(ins))
end 'emitCallValue'

// emitCallWitness calls the entry of a method in the table of an interface value, which jumps to the method, with the
// value the box holds first and the other arguments, and then the word of a String the box holds, which only a String's
// method reads, through the routine its table goes through (emitStringReceiver). A method that consumes the value takes
// it out of the box, which is freed once the method has returned.
function emitCallWitness(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let start = ir.callWitnessArgsStart(ins)
	let count = ir.callWitnessArgsCount(ins)
	let iface = argAt(fn, start: start, index: 0)
	let value = sel.load(iface, disp: imm32Of(ifaceValueOffset))
	let table = sel.load(iface, disp: imm32Of(ifaceTableOffset))
	let entry = sel.addImm(table, imm: imm32Of(try (tableFirstMethod + ir.callWitnessSlot(ins)) * tableEntrySize(sel.arch) otherwise panic("backend: a table past memory")))
	sel.addArg(value, float: ir.isFloatAt(ir.callFloats(fn, x: ins), place: 0))
	sel.addArgs(fn, start: try start + 1 otherwise panic("backend: an argument past the pool"), count: try count - 1 otherwise panic("backend: a witness call with no interface value"), floats: ir.callFloats(fn, x: ins), first: 1)
	let word = sel.load(iface, disp: imm32Of(ifaceWordOffset))
	sel.addArg(word, float: false)
	sel.callRegister(entry)
	sel.takeResult(ins.dst, float: ir.callReturnsFloat(ins))
	sel.takeError(ir.callWitnessErrReg(ins))
	if ir.callWitnessRecv(ins) == ir.ReceiverConv.receiverMoved 'consumed'
		sel.addArg(iface, float: false)
		sel.callSymbol(ir.rtSymbol(ir.Rt.rtFree))
	end 'consumed'
end 'emitCallWitness'

// emitIsType calls the entry of the table that names the type of the value the box holds, and compares what it gives
// with the name of the type the cast wants.
function emitIsType(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let table = sel.load(vregOf(ir.isTypeSrc(ins)), disp: imm32Of(ifaceTableOffset))
	let entry = sel.addImm(table, imm: imm32Of(try tableTypeEntry * tableEntrySize(sel.arch) otherwise panic("backend: a table past memory")))
	sel.callRegister(entry)
	let named = sel.newTemp()
	sel.copy(named, src: physOfNumber(internalResultOf(sel.arch)))
	let symbol = match sel.typeSymbols.get(ir.isTypeTy(fn, x: ins) as Count) 'named'
		some(name) gives name.clone()
		none panic("backend: a cast to a type that prepare did not name")
	end 'named'
	let wanted = sel.address(symbol)
	sel.compare(named, b: wanted)
	sel.flagInto(ins.dst, cond: MCond.equal)
end 'emitIsType'

function emitAlloc(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.allocInto(vregOf(ins.dst), bytes: ir.allocBytes(ins))
end 'emitAlloc'

// emitCallRuntime calls a runtime entry. The entries that read the length of an array, a byte array or a string, read
// or write one of their elements, or push one, are most of what a program does with them, so their common case is
// written in place, and the entry itself is only called for the rest: an index out of range, which it panics on, or a
// push that has to grow the buffer or an insert below the end, which move elements. What the program sees is the
// entry's behaviour either way. A read of what a frozen value holds is a load and nothing else, since a borrow leaves
// the count alone. A read of an element whose value nothing reads is the call alone: it is the one a bounds check's trap
// block makes (self/opt/expand.maxon), there to trap. A length or an element read is a call only in a source form, the IR
// of a function before its primitives were expanded, which the emit selects only to test its loops (SourceForms).
function emitCallRuntime(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let symbol = ir.callRuntimeSymbol(ins)
	let start = ir.callRuntimeArgsStart(ins)
	if symbol == ir.Rt.rtStrLen 'stringLength'
		let result = sel.resultOf(ins.dst)
		sel.stringLengthInto(result, word: sel.secondOf(fn.args[start]))
		return
	end 'stringLength'
	if symbol == ir.Rt.rtStrView 'stringView'
		emitStringView(sel, fn: fn, ins: ins)
		return
	end 'stringView'
	if symbol == ir.Rt.rtStrOwned 'stringOwned'
		let result = sel.resultOf(ins.dst)
		let word = sel.secondOf(fn.args[start])
		sel.maskInto(result, src: word, mask: stringOwnedBit)
		return
	end 'stringOwned'
	if symbol == ir.Rt.rtStrAscii 'stringAscii'
		let result = sel.resultOf(ins.dst)
		let word = sel.secondOf(fn.args[start])
		sel.maskInto(result, src: word, mask: stringAsciiBit)
		return
	end 'stringAscii'
	if symbol == ir.Rt.rtArrayLen or symbol == ir.Rt.rtBytesLen or symbol == ir.Rt.rtFrozenGet 'load'
		var offset = imm32Of(arrayLengthOffset)
		if symbol == ir.Rt.rtFrozenGet 'frozen'
			offset = imm32Of(frozenValueOffset)
		end 'frozen'
		if isStringReg(fn, r: ins.dst) 'string'
			sel.loadString(ins.dst, base: argAt(fn, start: start, index: 0), disp: offset)
			return
		end 'string'
		let result = sel.resultOf(ins.dst)
		sel.loadInto(result, base: argAt(fn, start: start, index: 0), disp: offset)
		return
	end 'load'
	if symbol == ir.Rt.rtCownNew 'cown'
		emitCownNew(sel, fn: fn, ins: ins)
		return
	end 'cown'
	if symbol == ir.Rt.rtFrozenFreeze 'freeze'
		let value = fn.args[start]
		sel.addArg(vregOf(value), float: false)
		sel.callSymbol(ir.rtSymbol(symbol))
		sel.takeResult(ins.dst, float: false)
		sel.storeSecondWord(fn, value: value, holder: ins.dst, offset: frozenValueOffset)
		return
	end 'freeze'
	if symbol == ir.Rt.rtReplyGive and isStringReg(fn, r: fn.args[nextCount(start)]) 'boxReply'
		let box = sel.newTemp()
		sel.allocInto(box, bytes: stringValueBytes)
		sel.storeString(box, disp: imm32Of(stringBytesOffset), r: fn.args[nextCount(start)])
		sel.addArg(argAt(fn, start: start, index: 0), float: false)
		sel.addArg(box, float: false)
		sel.addValue(fn.args[try start + 2 otherwise panic("backend: an argument past the pool")], float: false)
		sel.callSymbol(ir.rtSymbol(symbol))
		return
	end 'boxReply'
	if (symbol == ir.Rt.rtAsyncAwait or symbol == ir.Rt.rtAsyncTake) and isStringReg(fn, r: ins.dst) 'boxedString'
		sel.addWords(fn, start: start, count: ir.callRuntimeArgsCount(ins))
		sel.callSymbol(ir.rtSymbol(symbol))
		let box = sel.newTemp()
		sel.copy(box, src: physOfNumber(internalResultOf(sel.arch)))
		sel.loadString(ins.dst, base: box, disp: imm32Of(stringBytesOffset))
		sel.addArg(box, float: false)
		sel.callSymbol(ir.rtSymbol(ir.Rt.rtFree))
		return
	end 'boxedString'
	let reads = symbol == ir.Rt.rtArrayElem or symbol == ir.Rt.rtStrsElem or symbol == ir.Rt.rtRecsElem or symbol == ir.Rt.rtBytesGet or symbol == ir.Rt.rtStrByteAt
	let opens = symbol == ir.Rt.rtStrsOpen or symbol == ir.Rt.rtRecsOpen
	// An element of an array of records held in place is written in place where its size is a constant, as lowering gives it.
	let records = symbol == ir.Rt.rtRecsElem or symbol == ir.Rt.rtRecsOpen
	let sized = records and sel.definedBy(fn, r: fn.args[nextCount(nextCount(start))], op: ir.Opcode.opConst)
	if not ir.writtenInPlace(symbol) or (reads and ins.dst == ir.noReg) or (records and not sized) 'call'
		sel.callWords(fn, symbol: ir.rtSymbol(symbol), start: start, count: ir.callRuntimeArgsCount(ins), dst: ins.dst)
		return
	end 'call'
	if not reads and not opens and ins.dst != ir.noReg 'result'
		panic("backend: {ir.rtSymbol(symbol)} is written in place and gives no result, and this call keeps one")
	end 'result'
	let keeps = (reads or opens) and ins.dst != ir.noReg
	let slow = sel.mir.addBlock()
	let done = sel.mir.addBlock()
	let box = argAt(fn, start: start, index: 0)
	let index = argAt(fn, start: start, index: 1)
	if symbol == ir.Rt.rtArrayElem 'arrayElem'
		let data = sel.elementBuffer(box, index: index, slow: slow)
		let at = sel.elementAddress(data, index: index, shift: wordElementShift)
		sel.reach(done, value: at, keeps: keeps)
	end 'arrayElem' else if symbol == ir.Rt.rtStrsElem 'stringsElem'
		let data = sel.elementBuffer(box, index: index, slow: slow)
		let at = sel.elementAddress(data, index: index, shift: stringElementShift)
		sel.reach(done, value: at, keeps: keeps)
	end 'stringsElem' else if symbol == ir.Rt.rtStrsOpen 'stringsOpen'
		// The room is past the length, so it holds no String yet: it is left empty, as the entry leaves it.
		let atEnd = sel.knownLength(fn, box: fn.args[start], index: fn.args[nextCount(start)])
		let data = sel.pushInPlace(box, index: index, atEnd: atEnd, slow: slow)
		let at = sel.elementAddress(data, index: index, shift: stringElementShift)
		sel.emptyString(at, disp: 0)
		sel.reach(done, value: at, keeps: keeps)
	end 'stringsOpen' else if symbol == ir.Rt.rtRecsElem 'recordsElem'
		let data = sel.elementBuffer(box, index: index, slow: slow)
		let at = sel.strideAddress(data, index: index, bytes: sel.constantArg(fn, start: start, index: 2))
		sel.reach(done, value: at, keeps: keeps)
	end 'recordsElem' else if symbol == ir.Rt.rtRecsOpen 'recordsOpen'
		// The room is past the length, whose words may be an element's that a shrink left: they are zeroed, as the entry does.
		let bytes = sel.constantArg(fn, start: start, index: 2)
		let atEnd = sel.knownLength(fn, box: fn.args[start], index: fn.args[nextCount(start)])
		let data = sel.pushInPlace(box, index: index, atEnd: atEnd, slow: slow)
		let at = sel.strideAddress(data, index: index, bytes: bytes)
		var offset = 0 as Count
		while offset < bytes 'words'
			sel.storeImm(at, disp: imm32Of(offset), value: 0)
			offset = try offset + wordBytes otherwise panic("backend: an element past memory")
		end 'words'
		sel.reach(done, value: at, keeps: keeps)
	end 'recordsOpen' else if symbol == ir.Rt.rtBytesGet 'bytesGet'
		let data = sel.elementBuffer(box, index: index, slow: slow)
		let byte = sel.loadIndexedByte(data, index: index, disp: 0)
		sel.reach(done, value: byte, keeps: keeps)
	end 'bytesGet' else if symbol == ir.Rt.rtBytesSet 'bytesSet'
		let data = sel.elementBuffer(box, index: index, slow: slow)
		sel.storeIndexedByte(data, index: index, src: argAt(fn, start: start, index: 2))
		sel.args.clear()
		sel.jumpTo(done)
	end 'bytesSet' else if symbol == ir.Rt.rtArrayInsert 'arrayInsert'
		let atEnd = sel.knownLength(fn, box: fn.args[start], index: fn.args[nextCount(start)])
		let data = sel.pushInPlace(box, index: index, atEnd: atEnd, slow: slow)
		sel.storeIndexedWord(data, index: index, src: argAt(fn, start: start, index: 2))
		sel.args.clear()
		sel.jumpTo(done)
	end 'arrayInsert' else if symbol == ir.Rt.rtBytesInsert 'bytesInsert'
		let atEnd = sel.knownLength(fn, box: fn.args[start], index: fn.args[nextCount(start)])
		let data = sel.pushInPlace(box, index: index, atEnd: atEnd, slow: slow)
		sel.storeIndexedByte(data, index: index, src: argAt(fn, start: start, index: 2))
		sel.args.clear()
		sel.jumpTo(done)
	end 'bytesInsert' else if symbol == ir.Rt.rtStrByteAt 'stringByteAt'
		// A String that holds its bytes in its words has its byte read from them.
		let held = sel.mir.addBlock()
		sel.branchIfInline(sel.secondOf(fn.args[start]), block: held)
		let heldElsewhere = sel.mir.addBlock()
		sel.jumpTo(heldElsewhere)
		sel.mir.writeBlock(held)
		let count = sel.newTemp()
		sel.bitFieldInto(count, src: sel.secondOf(fn.args[start]), lsb: stringCountShift, width: stringInlineShift - stringCountShift)
		sel.compare(index, b: count)
		sel.branchTo(MCond.aboveEqual, block: slow)
		let inlineByte = sel.newTemp()
		sel.inlineByteInto(inlineByte, text: fn.args[start], index: index)
		sel.reach(done, value: inlineByte, keeps: keeps)
		sel.mir.writeBlock(heldElsewhere)
		let length = sel.newTemp()
		sel.shiftRightInto(length, src: sel.secondOf(fn.args[start]), count: stringLengthShift)
		sel.compare(index, b: length)
		sel.branchTo(MCond.aboveEqual, block: slow)
		let byte = sel.loadIndexedByte(box, index: index, disp: 0)
		sel.reach(done, value: byte, keeps: keeps)
	end 'stringByteAt' else 'unknown'
		panic("backend: {ir.rtSymbol(symbol)} is not written in place")
	end 'unknown'
	sel.mir.writeBlock(slow)
	sel.addWords(fn, start: start, count: ir.callRuntimeArgsCount(ins))
	sel.callSymbol(ir.rtSymbol(symbol))
	if keeps 'gives'
		let result = sel.newTemp()
		sel.copy(result, src: physOfNumber(internalResultOf(sel.arch)))
		sel.jumpWith(done, value: result)
		sel.join(done, r: ins.dst)
	end 'gives' else 'none'
		sel.args.clear()
		sel.jumpTo(done)
		sel.mir.writeBlock(done)
	end 'none'
end 'emitCallRuntime'

// emitElemAddr is the address of an element of an array, after the bounds check, whose size the instruction says.
function emitElemAddr(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let data = sel.load(vregOf(ir.elemAddrArr(ins)), disp: imm32Of(arrayDataOffset))
	let at = sel.elementAddress(data, index: vregOf(ir.elemAddrIndex(ins)), shift: ir.elemAddrShift(ins))
	let result = sel.resultOf(ins.dst)
	sel.copy(result, src: at)
end 'emitElemAddr'

// emitElemAddrAt gives the address of an element of a buffer that a Buffer read gave, of a size an index does not scale by.
function emitElemAddrAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = sel.elementAddress(vregOf(ir.elemAddrAtData(ins)), index: vregOf(ir.elemAddrAtIndex(ins)), shift: ir.elemAddrAtShift(ins))
	let result = sel.resultOf(ins.dst)
	sel.copy(result, src: at)
end 'emitElemAddrAt'

// cownNew passes the entry the value and the address of the code of the destructor that ends it, or 0 when it is dropped.
function emitCownNew(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let routine = match ir.callRuntimeRoutine(fn, x: ins) 'routine'
		some(r) gives sel.address(sel.calleeSymbol(r))
		none gives sel.constant(0)
	end 'routine'
	let value = fn.args[ir.callRuntimeArgsStart(ins)]
	sel.addArg(vregOf(value), float: false)
	sel.addArg(routine, float: false)
	sel.callSymbol(ir.rtSymbol(ir.Rt.rtCownNew))
	sel.takeResult(ins.dst, float: false)
	sel.storeSecondWord(fn, value: value, holder: ins.dst, offset: cownValueOffset)
end 'emitCownNew'

// emitClosure makes the box of a closure: a count of 1, the code of its body, the routine that drops what it owns, and
// what it captured.
function emitClosure(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let index = ir.closureBody(fn, x: ins)
	let body = bodySymbol(sel.fnSymbol, index: index)
	let count = ir.closureCapturesCount(ins)
	var drop = ""
	if ownsCaptures(fn.bodies[index]) 'owns'
		drop = captureDropSymbol(body)
	end 'owns'
	let box = vregOf(ins.dst)
	sel.closureBox(box, code: body, drop: drop, captures: count)
	let start = ir.closureCapturesStart(ins)
	for i in 0 upto count 'captures'
		let capture = fn.args[try start + i otherwise panic("backend: a capture past the pool")]
		let disp = imm32Of(try closureCapturesOffset + i * closureCaptureBytes otherwise panic("backend: a capture past memory"))
		if isStringReg(fn, r: capture) 'string'
			sel.storeString(box, disp: disp, r: capture)
		end 'string' else 'word'
			sel.store(box, disp: disp, src: vregOf(capture))
		end 'word'
	end 'captures'
end 'emitClosure'

// emitFuncValue makes the box of a closure of a named function, which captures nothing and so has nothing to drop.
function emitFuncValue(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let code = sel.calleeSymbol(ir.funcValueCallee(fn, x: ins))
	sel.closureBox(vregOf(ins.dst), code: code, drop: "", captures: 0)
end 'emitFuncValue'

// emitBox makes an interface value: a box on the heap of the address of the table and the value.
function emitBox(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let box = vregOf(ins.dst)
	sel.allocInto(box, bytes: ifaceBoxBytes)
	sel.fillBox(fn, box: box, table: ir.boxTable(fn, x: ins), value: ir.boxValue(ins))
end 'emitBox'

// emitWhen makes a behaviour's record and hands it to the runtime's acquire: the thunk of its body, how many cowns it
// names, and then, after the request slots that the acquire fills in, the cowns in source order and the captures, a
// word each. The record holds the behaviour's captures from here on, and the runtime adds the behaviour's own hold on
// each cown.
function emitWhen(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let cowns = ir.whenCownsCount(ins)
	let index = ir.whenBody(fn, x: ins)
	let words = try cowns + ir.whenCapturesCount(ins) otherwise panic("backend: a behaviour past memory")
	if fn.bodies[index].paramCount != words or fn.bodies[index].cownTypes.count() != cowns 'shape'
		panic("backend: a behaviour's body does not take its cowns' values and its captures, which its thunk passes it")
	end 'shape'
	let start = behaviourWordsOffset(cowns)
	let first = ir.whenCownsStart(ins)
	var slots = 0 as Count
	for i in 0 upto words 'width'
		slots = try slots + valueWordsOf(fn, r: fn.args[try first + i otherwise panic("backend: an argument past the pool")]) otherwise panic("backend: a behaviour past memory")
	end 'width'
	let record = sel.newTemp()
	sel.allocInto(record, bytes: try start + slots * wordBytes otherwise panic("backend: a behaviour past memory"))
	let thunk = sel.address(thunkSymbol(bodySymbol(sel.fnSymbol, index: index)))
	sel.store(record, disp: imm32Of(behaviourRunOffset), src: thunk)
	sel.storeImm(record, disp: imm32Of(behaviourCownCountOffset), value: try cowns as Imm32 otherwise panic("backend: a behaviour past memory"))
	var at = start
	for i in 0 upto words 'words'
		let r = fn.args[try first + i otherwise panic("backend: an argument past the pool")]
		sel.storeValue(record, disp: imm32Of(at), r: r, f: fn)
		at = try at + valueWordsOf(fn, r: r) * wordBytes otherwise panic("backend: a behaviour past memory")
	end 'words'
	sel.addArg(record, float: false)
	sel.callSymbol(ir.rtSymbol(ir.Rt.rtCownAcquire))
end 'emitWhen'

// emitAsync starts a coroutine: the runtime makes its green thread with the address of the thunk of the function, the
// arguments are written into its argument words, and the runtime then queues it in the caller's strand, publishing it
// last as maxon's __gt_ready does. The promise is the green thread.
function emitAsync(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let count = ir.asyncArgsCount(ins)
	var argWords = 0 as Count
	for i in 0 upto count 'width'
		argWords = try argWords + valueWordsOf(fn, r: fn.args[try ir.asyncArgsStart(ins) + i otherwise panic("backend: an argument past the pool")]) otherwise panic("backend: a coroutine past memory")
	end 'width'
	if argWords > greenArgWords 'words'
		panic("backend: an async call passes more words than a coroutine holds, which the checker refuses")
	end 'words'
	let thunk = sel.address(asyncThunkSymbol(sel.calleeSymbol(ir.asyncCallee(fn, x: ins))))
	sel.addArg(thunk, float: false)
	sel.callSymbol(ir.rtSymbol(ir.Rt.rtAsyncNew))
	sel.takeResult(ins.dst, float: false)
	let g = vregOf(ins.dst)
	let start = ir.asyncArgsStart(ins)
	var at = greenArgsOffset as Count
	for i in 0 upto count 'args'
		let r = fn.args[try start + i otherwise panic("backend: an argument past the pool")]
		sel.storeValue(g, disp: imm32Of(at), r: r, f: fn)
		at = try at + valueWordsOf(fn, r: r) * wordBytes otherwise panic("backend: a coroutine past memory")
	end 'args'
	sel.addArg(g, float: false)
	sel.callSymbol(ir.rtSymbol(ir.Rt.rtAsyncStart))
end 'emitAsync'

// asyncThunkSymbol is the link name of the thunk a coroutine of the function with the link name callee runs. It starts
// with a word and a space, as a routine's does, so no function is named like it.
function asyncThunkSymbol(callee String) returns String
	return "async {callee}"
end 'asyncThunkSymbol'

// A String that owns no bytes, a literal, a view or one that holds its bytes in its words, has nothing to drop, which its
// word says in place, so its drop routine is called only for one that owns them.
function emitDropValue(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	if ir.dropTy(fn, x: ins) == sel.stringTy 'string'
		let done = sel.mir.addBlock()
		let owned = sel.newTemp()
		sel.maskInto(owned, src: sel.secondOf(ir.dropSrc(ins)), mask: stringOwnedBit)
		sel.branchIfZero(owned, block: done)
		sel.callRoutineOf(RoutineKind.dropRoutine, ty: ir.dropTy(fn, x: ins), value: ir.dropSrc(ins))
		sel.args.clear()
		sel.jumpTo(done)
		sel.mir.writeBlock(done)
		return
	end 'string'
	sel.callRoutineOf(RoutineKind.dropRoutine, ty: ir.dropTy(fn, x: ins), value: ir.dropSrc(ins))
end 'emitDropValue'

function emitDropAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.dropPlace(vregOf(ir.dropAtAddr(ins)), disp: 0, ty: ir.dropAtTy(fn, x: ins))
end 'emitDropAt'

function emitCopyValue(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.callRoutineOf(RoutineKind.copyRoutine, ty: ir.copyTy(fn, x: ins), value: ir.copySrc(ins))
	sel.takeResult(ins.dst, float: false)
end 'emitCopyValue'

// emitSwitch compares the value with each case in turn, a block each.
function emitSwitch(mutates sel Selector, fn ir.IrFunction, ins ir.Term)
	let value = vregOf(ir.switchValue(ins))
	let start = ir.switchCasesStart(ins)
	for i in 0 upto ir.switchCasesCount(ins) 'cases'
		let at = try start + i otherwise panic("backend: a case past the pool")
		sel.compareWith(value, value: fn.cases[at].value)
		let edge = sel.edgeTo(fn, target: fn.cases[at].target, start: fn.cases[at].argsStart(), count: fn.cases[at].argsCount())
		sel.branchAlong(MCond.equal, refers: edge)
		let next = sel.mir.addBlock()
		sel.args.clear()
		sel.jumpTo(next)
		sel.mir.writeBlock(next)
	end 'cases'
	let fallback = sel.edgeTo(fn, target: ir.switchFallback(ins), start: ir.switchFallbackArgsStart(ins), count: ir.switchFallbackArgsCount(ins))
	sel.jumpAlong(fallback)
end 'emitSwitch'

// emitRet returns a value in the convention's register for it, a float's or a word's.
function emitRet(mutates sel Selector, fn ir.IrFunction, ins ir.Term)
	let value = ir.retValue(ins)
	sel.copy(physOfNumber(internalResult(sel.arch, float: sel.floatResult)), src: vregOf(value))
	if isStringReg(fn, r: value) 'string'
		sel.copy(physOfNumber(internalSecondResultOf(sel.arch)), src: sel.secondOf(value))
	end 'string'
	if sel.canThrow 'clear'
		sel.zeroInto(physOfNumber(internalErrorOf(sel.arch)), float: false)
	end 'clear'
	sel.leave()
end 'emitRet'

// emitThrow returns an error, with the result registers cleared, which the return reads all the same.
function emitThrow(mutates sel Selector, fn ir.IrFunction, ins ir.Term)
	sel.copy(physOfNumber(internalErrorOf(sel.arch)), src: vregOf(ir.throwErr(ins)))
	let float = sel.floatResult
	sel.zeroInto(physOfNumber(internalResult(sel.arch, float: float)), float: float)
	if fn.stringResult 'string'
		sel.zeroInto(physOfNumber(internalSecondResultOf(sel.arch)), float: false)
	end 'string'
	sel.leave()
end 'emitThrow'

// paramPosition is where the internal convention passes parameter k of a function of count of them: in order, but for
// the body of a closure, which takes the closure, its first parameter, last.
function paramPosition(k Count, count Count, closure bool) returns Count
	if not closure 'named'
		return k
	end 'named'
	if k == 0 'closure'
		return try count - 1 otherwise panic("backend: a closure's body with no parameters")
	end 'closure'
	return k - 1
end 'paramPosition'

// paramAtPosition is the parameter that the internal convention passes at a position, which paramPosition gives.
function paramAtPosition(position Count, count Count, closure bool) returns Count
	if not closure 'named'
		return position
	end 'named'
	let last = try count - 1 otherwise panic("backend: a closure's body with no parameters")
	if position == last 'closure'
		return 0
	end 'closure'
	return try position + 1 otherwise panic("backend: a parameter past the count")
end 'paramAtPosition'

// selectFunction writes the code of one function into the unit: its machine IR, by the rules and the helpers, then
// allocated and encoded. A prologue block of its own comes first, so that a branch to the IR's first block does not
// run it again; it copies the parameters out of the argument registers before it clears the slots, which writes some
// of them. By rule, it gives the hot loops that need more registers than the target has (E5001), and writes nothing then,
// or spills them as any other code.
function selectFunction(mutates sel Selector, p ast.Project, mutates ms ast.ModuleState, f ir.IrFunction, symbol String, instance bool, closure bool, rule HotLoops) returns PressureRefusalList
	sel.prepare(p, ms: ms, f: f)
	sel.fnSymbol = symbol.clone()
	sel.closureBody = closure
	sel.mir = MirFunction.new(symbol, canThrow: sel.canThrow, arch: sel.arch)
	sel.mir.instrs = exchange(sel.spareInstrs, value: MInstrList.create(0))
	sel.mir.instrs.clear()
	sel.mir.floatResult = sel.floatResult
	sel.mir.stringResult = f.stringResult
	sel.mir.keepsSpans = f.keepsSpans
	sel.classes.choose(f, fn: sel.mir)
	sel.mir.lengthened = f.lengthened.clone()
	sel.pairStrings(f)
	match sel.arch 'arch'
		x64 then sel.sharedWords.clear()
		arm64 then sel.planWords(f)
	end 'arch'
	sel.mir.fixedSlots = try slotsWords(f) + f.frameBoxes * ifaceBoxWords otherwise panic("backend: a frame past memory")
	for _ in 0 upto f.blocks.count() 'blocks'
		_ = sel.mir.addBlock()
	end 'blocks'
	let prologue = sel.mir.addBlock()
	sel.mir.writeBlock(prologue)
	sel.emit(newFrameSetup())
	sel.takeParams(f)
	sel.zeroManagedSlots(f)
	sel.args.clear()
	sel.jumpTo(0)
	for i in 0 upto f.blocks.count() 'blocks'
		sel.mir.writeBlock(try i as MBlockID otherwise panic("backend: more blocks than a branch names"))
		for k in 0 upto f.blocks[i].paramCount 'params'
			sel.addParamOf(f.blockParam(i, i: k))
		end 'params'
		sel.irBlock = i
		for k in f.blocks[i].first upto f.blocks[i].endAt 'instrs'
			sel.irAt = k
			sel.mir.pos = ir.spanAt(f, k: k)
			sel.makeDueWords(i, at: k)
			selectInstruction(sel, fn: f, ins: f.instrs[k])
		end 'instrs'
		sel.irAt = f.blocks[i].endAt
		sel.mir.pos = ir.noSpan
		sel.makeDueWords(i, at: f.blocks[i].endAt)
		selectTerminator(sel, fn: f, ins: f.blocks[i].term)
		if f.blocks[i].term.kind == ir.TermKind.termTrap 'fails'
			sel.mir.blocks[i].likelihood = Likelihood.cold
		end 'fails'
	end 'blocks'
	sel.mir.endBlock()
	var mir = exchange(sel.mir, value: MirFunction.new("", canThrow: false, arch: sel.arch))
	if f.keepsSpans 'named'
		let named = namedValues(sel, f: f)
		sel.harvest.named = named
	end 'named'
	legalizeClasses(mir)
	sel.dead.remove(mir)
	if f.keepsSpans 'copies'
		followCopies(sel.harvest.named, dead: sel.dead)
	end 'copies'
	sel.allocator.spiller.clock.lap(EmitPhase.selection)
	let refusals = sel.allocator.allocate(mir, rule: rule)
	if refusals.count() > 0 or rule == HotLoops.test 'refused'
		return refusals
	end 'refused'
	if f.keepsSpans 'sites'
		if mir.spans.count() != mir.instrs.count() 'apart'
			panic("backend: {symbol} keeps {mir.spans.count()} spans for {mir.instrs.count()} machine instructions")
		end 'apart'
		let sites = ir.sitesOf(f)
		sel.u.addSites(siteCallees(p, ms: ms, sites: sites), sites: sites)
		sel.harvest.harvest(f, fn: mir, s: sel.allocator.spiller, c: sel.allocator.colourer)
	end 'sites'
	encodeFunction(sel, fn: mir, instance: instance)
	if f.keepsSpans 'locals'
		sel.harvest.finish(sel.u, f: f, fn: mir, lay: sel.layout)
	end 'locals'
	sel.spareInstrs = exchange(mir.instrs, value: MInstrList.create(0))
	sel.allocator.spiller.clock.lap(EmitPhase.encoding)
	return refusals
end 'selectFunction'

// siteCallees are the link names of the callees of f's inline sites.
function siteCallees(p ast.Project, ms ast.ModuleState, sites ir.InlineSiteList) returns ast.StringList
	var names = ast.StringList.create(0)
	for s in 0 upto sites.count() 'sites'
		names.push(ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: sites[s].callee))
	end 'sites'
	return names
end 'siteCallees'

// selectInstruction writes the machine instructions of an instruction by the selection of the architecture compiled
// for, which its rules generate (lower_x64_gen.maxon, lower_arm64_gen.maxon).
function selectInstruction(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	match sel.arch 'arch'
		x64 then x64SelectInstr(sel, fn: fn, ins: ins)
		arm64 then arm64SelectInstr(sel, fn: fn, ins: ins)
	end 'arch'
end 'selectInstruction'

// selectTerminator writes the machine instructions of a terminator by the selection of the architecture compiled for.
function selectTerminator(mutates sel Selector, fn ir.IrFunction, ins ir.Term)
	match sel.arch 'arch'
		x64 then x64SelectTerm(sel, fn: fn, ins: ins)
		arm64 then arm64SelectTerm(sel, fn: fn, ins: ins)
	end 'arch'
end 'selectTerminator'

// encodeFunction writes an allocated function into the unit by the encoder of the architecture compiled for.
function encodeFunction(mutates sel Selector, fn MirFunction, instance bool)
	match sel.arch 'arch'
		x64 then encodeX64Function(sel.u, fn: fn, instance: instance, lay: sel.layout)
		arm64 then encodeArm64Function(sel.u, fn: fn, instance: instance, lay: sel.layout)
	end 'arch'
end 'encodeFunction'

// SourceForms gives the emit of a module the source form of one of its functions: the IR it had before the expansion of
// the primitives, leaf inlining and the passes after it, whose instructions hold no more values at once than the program
// as written. The emit asks for it only where a hot loop of the optimized IR does not fit, since E5001 is whether the
// program's own loop fits (README, "E5001 and the optimizations"), so a module whose loops fit holds no second form of
// its functions.
export interface SourceForms
	// sourceOf is the source form of the function at place at of the module's functions fns.
	function sourceOf(mutates self, p ast.Project, mutates ms ast.ModuleState, fns ir.IrFunctionList, at Count) returns SourceForm
end 'SourceForms'

// SourceForm is what a function's source form is to the emit.
export union SourceForm
	// compiled: the function is compiled as the program wrote it, so what its emit refuses stands.
	compiled
	// lowered: the function lowered again and taken through the passes before the expansion of the primitives.
	lowered(form ir.IrFunction)
	// straight: the function as written may hold no loop, so it has none to refuse.
	straight
end 'SourceForm'

// AsWritten is the source of a program whose functions are compiled as they were lowered, each its own source form.
type AsWritten implements SourceForms
	static function new() returns AsWritten
		return AsWritten{}
	end 'new'

	function sourceOf(mutates self, p ast.Project, mutates ms ast.ModuleState, fns ir.IrFunctionList, at Count) returns SourceForm
		return SourceForm.compiled
	end 'sourceOf'
end 'AsWritten'

// Source is what the emit of a function of the module knows of its source form, which is the same for the function and
// the bodies of its closures and behaviours: whether it asked for it yet, and what it was given.
type Source
	var asked as bool
	var found as SourceForm

	static function new() returns Source
		return Source{asked: false, found: SourceForm.compiled}
	end 'new'

	// forget makes it the source form of the next function, not asked for yet.
	function forget(mutates self)
		asked = false
		found = SourceForm.compiled
	end 'forget'
end 'Source'

// selectOrRefuse writes the code of f, the body that path names of the function at place at of fns. Where a hot loop of f
// needs more registers than the target has, with the values the optimizer lengthened reloaded in it, the loop as the
// program wrote it decides: forms gives the function's source form the first time one of its bodies asks, and where the
// same body of it refuses a hot loop too, that is E5001, reported at the function; otherwise f is written with its loops
// spilled as any other code, which --timings counts. So a program that compiles without the optimizations compiles with
// them, and a function compiles only as optimized (README, "E5001 and the optimizations").
function selectOrRefuse(mutates sel Selector, p ast.Project, mutates ms ast.ModuleState, fns ir.IrFunctionList, at Count, f ir.IrFunction, path CountList, mutates source Source, mutates forms F, symbol String, instance bool, closure bool, mutates errs diag.ErrorList) uses F where F implements SourceForms
	let refusals = selectFunction(sel, p: p, ms: ms, f: f, symbol: symbol, instance: instance, closure: closure, rule: HotLoops.refuse)
	if refusals.count() == 0 'compiled'
		return
	end 'compiled'
	if not source.asked 'ask'
		source.found = forms.sourceOf(p, ms: ms, fns: fns, at: at)
		source.asked = true
	end 'ask'
	var written = PressureRefusalList.create(0)
	match source.found 'found'
		compiled then written = refusals.clone()
		lowered(form) then written = selectBodyAt(sel, p: p, ms: ms, f: form, path: path, depth: 0, symbol: symbol, instance: instance, closure: closure)
		straight then _ = 0
	end 'found'
	if written.count() > 0 'refused'
		reportRefusals(p, ms: ms, f: f, refusals: written, errs: errs)
		return
	end 'refused'
	sel.allocator.spiller.clock.spilledLoops = try sel.allocator.spiller.clock.spilledLoops + 1 otherwise panic("backend: more functions spilled than memory")
	_ = selectFunction(sel, p: p, ms: ms, f: f, symbol: symbol, instance: instance, closure: closure, rule: HotLoops.spill)
end 'selectOrRefuse'

// selectBodyAt gives the hot loops refused in the body of f that path names from depth on, f itself past its end, writing
// nothing.
function selectBodyAt(mutates sel Selector, p ast.Project, mutates ms ast.ModuleState, f ir.IrFunction, path CountList, depth Count, symbol String, instance bool, closure bool) returns PressureRefusalList
	if depth == path.count() 'here'
		return selectFunction(sel, p: p, ms: ms, f: f, symbol: symbol, instance: instance, closure: closure, rule: HotLoops.test)
	end 'here'
	return selectBodyAt(sel, p: p, ms: ms, f: f.bodies[path[depth]], path: path, depth: ir.succ(depth), symbol: symbol, instance: instance, closure: closure)
end 'selectBodyAt'

// reportRefusals reports each hot loop of f that E5001 refuses, at the function's declaration, since the IR keeps no
// place of a loop: an instance's at its generic's.
function reportRefusals(p ast.Project, ms ast.ModuleState, f ir.IrFunction, refusals PressureRefusalList, mutates errs diag.ErrorList)
	var origin = f.decl
	let generic = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: f.decl).genericOrigin
	if generic != ast.noFunc 'instance'
		origin = generic
	end 'instance'
	let module = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).module
	let offset = p.modules[ast.modIndex(module)].tree.startOf(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).nodeID)
	let place = "'{ast.funcEntry(ms.funcs, funcReads: p.funcs, f: origin).name}'"
	for i in 0 upto refusals.count() 'refusals'
		let message = pressureRefusalMessage(refusals[i], place: place, target: ast.archName(p.target.arch))
		if not reported(errs, message: message, module: module, offset: offset) 'new'
			diag.pushSiteError(errs, code: diag.errRegisterPressure, message: message, module: module, offset: offset)
		end 'new'
	end 'refusals'
end 'reportRefusals'

// reported is whether errs holds E5001 with the message at the place already: every instance of a generic refuses the
// same loop.
function reported(errs diag.ErrorList, message String, module diag.ModuleID, offset diag.U32) returns bool
	for i in 0 upto errs.count() 'errors'
		if errs[i].code == diag.errRegisterPressure and errs[i].site.module == module and errs[i].site.offset == offset and errs[i].message == message 'same'
			return true
		end 'same'
	end 'errors'
	return false
end 'reported'

// bodySymbol is the link name of the body of a closure of the function with the link name enclosing.
function bodySymbol(enclosing String, index Count) returns String
	return "{enclosing}{ast.closureSuffix}{index}"
end 'bodySymbol'

// captureDropSymbol is the link name of the routine that drops what a closure of the body with the link name body owns.
// It starts with a word and a space, as a routine's does, so no function is named like it.
function captureDropSymbol(body String) returns String
	return "captures {body}"
end 'captureDropSymbol'

// thunkSymbol is the link name of the thunk of the behaviour body with the link name body, which the scheduler runs the
// behaviour's record with. It starts with a word and a space, as a routine's does, so no function is named like it.
function thunkSymbol(body String) returns String
	return "run {body}"
end 'thunkSymbol'

// behaviourWordsOffset is where the record of a behaviour of a count of cowns holds them, after its request slots, the
// captures following them.
export function behaviourWordsOffset(cowns Count) returns Count
	return try behaviourSlotsOffset + cowns * requestSlotBytes otherwise panic("backend: a behaviour past memory")
end 'behaviourWordsOffset'

// isBehaviourBody is whether a body is a behaviour's, which a `when` names at least one cown of, rather than a closure's.
function isBehaviourBody(body ir.IrFunction) returns bool
	return body.cownTypes.count() > 0
end 'isBehaviourBody'

// ownsCaptures is whether a closure of the body owns a value it captured, which its drop routine then drops.
function ownsCaptures(body ir.IrFunction) returns bool
	for i in 0 upto body.captureOwned.count() 'captures'
		if body.captureOwned[i] 'owned'
			return true
		end 'owned'
	end 'captures'
	return false
end 'ownsCaptures'

// selectFunctionTree writes the code of f, the body that path names of the function at place at of fns, with the link name
// symbol, and of the bodies of its closures and its behaviours, each closure's with the routine that drops what the closure
// owns and each behaviour's with its thunk, and the tables that they name and the unit does not have yet. closure says that
// f is the body of a closure. source is the function's source form as far as one of its bodies asked forms for it.
function selectFunctionTree(mutates sel Selector, p ast.Project, mutates ms ast.ModuleState, fns ir.IrFunctionList, at Count, f ir.IrFunction, mutates path CountList, mutates source Source, mutates forms F, symbol String, instance bool, closure bool, mutates errs diag.ErrorList) uses F where F implements SourceForms
	selectOrRefuse(sel, p: p, ms: ms, fns: fns, at: at, f: f, path: path, source: source, forms: forms, symbol: symbol, instance: instance, closure: closure, errs: errs)
	let due = exchange(sel.due, value: ir.WitnessTableList.create(0))
	for i in 0 upto due.count() 'tables'
		emitTable(sel.u, p: p, ms: ms, t: due[i], typeSymbol: typeNameSymbol(p, ms: ms, t: due[i].concrete))
	end 'tables'
	let thunks = exchange(sel.dueThunks, value: ast.FuncIDList.create(0))
	for i in 0 upto thunks.count() 'thunks'
		let started = ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: thunks[i])
		emitAsyncThunk(sel.u, p: p, ms: ms, symbol: asyncThunkSymbol(started), callee: thunks[i], calleeSymbol: started)
	end 'thunks'
	for i in 0 upto f.bodies.count() 'bodies'
		let body = bodySymbol(symbol, index: i)
		path.push(i)
		selectFunctionTree(sel, p: p, ms: ms, fns: fns, at: at, f: f.bodies[i], path: path, source: source, forms: forms, symbol: body, instance: instance, closure: not isBehaviourBody(f.bodies[i]), errs: errs)
		try path.pop() otherwise panic("backend: the path of a body ran out")
		if isBehaviourBody(f.bodies[i]) 'behaviour'
			emitBehaviourThunk(sel.u, p: p, ms: ms, symbol: thunkSymbol(body), body: f.bodies[i], bodySymbol: body, instance: instance)
		end 'behaviour' else if ownsCaptures(f.bodies[i]) 'owns'
			emitCaptureDrop(sel.u, p: p, ms: ms, symbol: captureDropSymbol(body), body: f.bodies[i], instance: instance)
		end 'owns'
	end 'bodies'
end 'selectFunctionTree'

// emitModule is the unit with the code of a module's functions, and the hot loops E5001 refuses in errs. forms gives the
// source form of a function where a hot loop of it does not fit. With verifies, register allocation holds each function to
// its invariants. clock is charged the time of each phase.
export function emitModule(p ast.Project, mutates ms ast.ModuleState, fns ir.IrFunctionList, mutates forms F, verifies bool, mutates clock EmitClock, mutates errs diag.ErrorList) uses F returns CodeUnit where F implements SourceForms
	var sel = Selector.new(verifies, target: p.target)
	sel.allocator.spiller.clock = exchange(clock, value: EmitClock.off())
	sel.allocator.spiller.clock.restart()
	var path = CountList.create(0)
	var source = Source.new()
	for i in 0 upto fns.count() 'each'
		let symbol = ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: fns[i].decl)
		let instance = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fns[i].decl).genericOrigin != ast.noFunc
		sel.u.preemptible = ast.preemptibleFunction(p, ms: ms, fid: fns[i].decl)
		source.forget()
		selectFunctionTree(sel, p: p, ms: ms, fns: fns, at: i, f: fns[i], path: path, source: source, forms: forms, symbol: symbol, instance: instance, closure: false, errs: errs)
	end 'each'
	sel.u.asm.endLabels()
	sel.allocator.spiller.clock.lap(EmitPhase.selection)
	clock = exchange(sel.allocator.spiller.clock, value: EmitClock.off())
	return exchange(sel.u, value: CodeUnit.new())
end 'emitModule'
