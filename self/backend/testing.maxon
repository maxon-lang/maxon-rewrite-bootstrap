// Helpers that the tests of this module and of the modules above it share: the lowest module that may name all they
// need is their one home, as a module's tests may name only what the module may name. Nothing else calls them, so the
// linker leaves them out of every executable but a compile of tests.

// allocRootType adds a type that the root module declares, as a link name needs every declared type to be in a module.
export function allocRootType(mutates p ast.Project, consumes entry ast.TypeEntry) returns ast.TypeID
	var declared = entry
	declared.hasDecl = true
	declared.decl = ast.DeclRef.make(p.rootModule, ordinal: 0 as ast.DeclOrdinal)
	let module = p.rootModule
	return ast.makeType(p, module: module, e: declared)
end 'allocRootType'

// countLive adds to the number of live boxes, keeping every register but rcx.
export function asmCountLive(mutates u CodeUnit, delta Imm32)
	u.asm.loadSymbol(rcx, symbol: testLiveSymbol)
	u.asm.addImm(rcx, imm: delta)
	u.asm.storeSymbol(testLiveSymbol, src: rcx)
end 'asmCountLive'

export function asmEpilogue(mutates u CodeUnit)
	u.asm.mov(rsp, src: rbp)
	u.asm.pop(rbp)
	u.asm.ret()
end 'asmEpilogue'

// asmPrologue and asmEpilogue frame a function of the test runtime that calls Windows, which wants the stack aligned.
export function asmPrologue(mutates u CodeUnit)
	u.asm.push(rbp)
	u.asm.mov(rbp, src: rsp)
	u.asm.andImm(rsp, imm: -16)
	u.asm.subImm(rsp, imm: 48)
end 'asmPrologue'

// imageTempPath is where a test writes the executable called name, in the system's directory of temporary files.
export function imageTempPath(name String) returns FilePath
	return try FilePath.from(ast.temporaryPath(name)) otherwise panic("not a path")
end 'imageTempPath'

// runIr links the functions with the entry stub and the test runtime, and runs the executable.
export function runIr(mutates p ast.Project, fns ir.IrFunctionList, entry ast.FuncID, count bool, name String, expectedCode ExitCode, expectedOutput String)
	var modules = FunctionLists.create(0)
	modules.push(fns.clone())
	var ready = UnitList.create(0)
	ready.push(runtimeUnit(p.target, count: count))
	let linked = buildProgram(p, modules: modules, ready: freeze(ready), entry: entry, options: RuntimeOptions.make(count), mapsSymbols: false)
	runImage(linked.image, name: name, expectedCode: expectedCode, expectedOutput: expectedOutput)
end 'runIr'

// runImage writes the image, an executable of the system the compiler runs on, to a file, runs it and checks its exit code
// and what it printed.
export function runImage(image Image, name String, expectedCode ExitCode, expectedOutput String)
	let out = runImageOutput(image, name: name, expectedCode: expectedCode)
	table.assertEqStr(out.stdout, expected: expectedOutput, label: name)
end 'runImage'

// runImageOutput writes the image, runs it and checks its exit code, and gives what it wrote.
export function runImageOutput(image Image, name String, expectedCode ExitCode) returns CollectedOutput
	let path = imageTempPath(name)
	try writeImage(image, path: path) otherwise panic("cannot write {name}")
	let out = try Subprocess.run(Executable.path(imageTempPath(name)), arguments: Array.create(0)) otherwise panic("cannot run {name}")
	try File.delete(path) otherwise panic("cannot delete {name}")
	if out.exitCode() != expectedCode 'code'
		panic("{name}: expected exit code {expectedCode}, got {out.exitCode()}")
	end 'code'
	return out
end 'runImageOutput'

// runtimeUnit is the entries of the runtime that the test programs and the entry stub call, for the target the programs
// run on, written in assembly by the internal convention: alloc, free, write, a stand-in for itoa, checkLeaks, which exits
// with the runtime's leak code and writes no report, and panic, which exits with the panic code and writes nothing. A test
// program uses no scheduler, so its entry calls main itself (start.maxon) and needs nothing of the scheduler's.
export function runtimeUnit(target ast.Target, count bool) returns CodeUnit
	return match target.arch 'arch'
		x64 gives x64RuntimeUnit(target.system, count: count)
		arm64 gives arm64RuntimeUnit(target.system, count: count)
	end 'arch'
end 'runtimeUnit'

// x64RuntimeUnit is the test runtime of an x64 system, whose internal convention passes the first two arguments in rcx and
// rdx and gives the result in r8.
function x64RuntimeUnit(system ast.TargetSystem, count bool) returns CodeUnit
	return match system 'system'
		windows gives windowsRuntimeUnit(count)
		linux gives linuxRuntimeUnit(count)
		macos gives panic("backend: x64 runs no macOS")
	end 'system'
end 'x64RuntimeUnit'

// windowsRuntimeUnit is the test runtime of x64 Windows, whose entries call Windows by Win64.
function windowsRuntimeUnit(count bool) returns CodeUnit
	let result = x64InternalResult
	var u = CodeUnit.new()
	u.defineData(testLiveSymbol, size: wordBytes)
	u.defineCode(ir.rtSymbol(ir.Rt.rtAlloc))
	asmPrologue(u)
	u.asm.mov(r8, src: x64InternalArg(0))
	u.asm.loadSymbol(rcx, symbol: ir.rtSymbol(ir.Rt.rtHeap))
	u.asm.movImm(rdx, imm: 8)
	u.asm.callImport("HeapAlloc")
	if count 'allocCount'
		asmCountLive(u, delta: 1)
	end 'allocCount'
	u.asm.mov(result, src: rax)
	asmEpilogue(u)
	u.defineCode(ir.rtSymbol(ir.Rt.rtFree))
	asmPrologue(u)
	let freed = u.asm.newLabel()
	u.asm.mov(r8, src: x64InternalArg(0))
	u.asm.test(r8, right: r8)
	u.asm.jcc(MCond.equal, label: freed)
	if count 'freeCount'
		asmCountLive(u, delta: -1)
	end 'freeCount'
	u.asm.loadSymbol(rcx, symbol: ir.rtSymbol(ir.Rt.rtHeap))
	u.asm.bitXor(rdx, src: rdx)
	u.asm.callImport("HeapFree")
	u.asm.bind(freed)
	asmEpilogue(u)
	u.defineCode(ir.rtSymbol(ir.Rt.rtWrite))
	asmPrologue(u)
	u.asm.mov(r8, src: x64InternalArg(2))
	u.asm.shrImm(r8, imm: stringLengthShift as Imm8)
	u.asm.mov(rdx, src: x64InternalArg(1))
	u.asm.mov(rcx, src: x64InternalArg(0))
	u.asm.lea(r9, base: rsp, disp: 40)
	u.asm.bitXor(rax, src: rax)
	u.asm.store(rsp, disp: 32, src: rax)
	u.asm.callImport("WriteFile")
	asmEpilogue(u)
	emitTestItoa(u)
	u.defineCode(ir.rtSymbol(ir.Rt.rtCheckLeaks))
	asmPrologue(u)
	let clean = u.asm.newLabel()
	u.asm.mov(result, src: x64InternalArg(0))
	u.asm.loadSymbol(rcx, symbol: testLiveSymbol)
	u.asm.test(rcx, right: rcx)
	u.asm.jcc(MCond.equal, label: clean)
	u.asm.movImm(rcx, imm: testLeakExitCode)
	u.asm.callImport("ExitProcess")
	u.asm.bind(clean)
	asmEpilogue(u)
	u.defineCode(ir.rtSymbol(ir.Rt.rtPanic))
	asmPrologue(u)
	u.asm.movImm(rcx, imm: testPanicExitCode)
	u.asm.callImport("ExitProcess")
	return u
end 'windowsRuntimeUnit'

// linuxRuntimeUnit is the test runtime of x64 Linux, whose entries call the kernel: alloc maps each box on pages of its
// own, which free leaves mapped, since a test program is short and only the count of live boxes is checked.
function linuxRuntimeUnit(count bool) returns CodeUnit
	let result = x64InternalResult
	var u = CodeUnit.new()
	u.defineData(testLiveSymbol, size: wordBytes)
	u.defineCode(ir.rtSymbol(ir.Rt.rtAlloc))
	u.asm.mov(rsi, src: x64InternalArg(0))
	u.asm.movImm(rdi, imm: noAddress)
	u.asm.movImm(rdx, imm: linuxProtReadWrite)
	u.asm.movImm(r10, imm: linuxMapAnonPrivate)
	u.asm.movImm(r8, imm: noFile)
	u.asm.movImm(r9, imm: noOffset)
	stubSyscall(u, number: linuxSysMmap)
	if count 'allocCount'
		asmCountLive(u, delta: 1)
	end 'allocCount'
	u.asm.mov(result, src: rax)
	u.asm.ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtFree))
	let freed = u.asm.newLabel()
	u.asm.test(x64InternalArg(0), right: x64InternalArg(0))
	u.asm.jcc(MCond.equal, label: freed)
	if count 'freeCount'
		asmCountLive(u, delta: -1)
	end 'freeCount'
	u.asm.bind(freed)
	u.asm.ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtWrite))
	u.asm.mov(rdi, src: x64InternalArg(0))
	u.asm.mov(rsi, src: x64InternalArg(1))
	u.asm.mov(rdx, src: x64InternalArg(2))
	u.asm.shrImm(rdx, imm: stringLengthShift as Imm8)
	stubSyscall(u, number: linuxSysWrite)
	u.asm.ret()
	emitTestItoa(u)
	u.defineCode(ir.rtSymbol(ir.Rt.rtCheckLeaks))
	let clean = u.asm.newLabel()
	u.asm.mov(result, src: x64InternalArg(0))
	u.asm.loadSymbol(rcx, symbol: testLiveSymbol)
	u.asm.test(rcx, right: rcx)
	u.asm.jcc(MCond.equal, label: clean)
	u.asm.movImm(rdi, imm: testLeakExitCode)
	stubSyscall(u, number: linuxSysExitGroup)
	u.asm.bind(clean)
	u.asm.ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtPanic))
	u.asm.movImm(rdi, imm: testPanicExitCode)
	stubSyscall(u, number: linuxSysExitGroup)
	return u
end 'linuxRuntimeUnit'

// arm64RuntimeUnit is the test runtime of an arm64 system, whose internal convention passes the arguments in x0 up and gives
// the result in x0: its entries call the system by the entry stub's calls (emitArm64StubCall), libSystem's functions on
// macOS and system calls on Linux. As on x64 Linux, alloc maps each box on pages of its own, which free leaves mapped.
function arm64RuntimeUnit(system ast.TargetSystem, count bool) returns CodeUnit
	let result = arm64InternalResult
	var u = CodeUnit.new()
	u.defineData(testLiveSymbol, size: wordBytes)
	u.defineCode(ir.rtSymbol(ir.Rt.rtAlloc))
	u.asm.arm64Enter()
	u.asm.arm64Mov(arm64StubArg(1), src: arm64InternalArg(0))
	u.asm.arm64MovImm(arm64StubArg(0), value: noAddress)
	u.asm.arm64MovImm(arm64StubArg(2), value: arm64ProtReadWrite(system))
	u.asm.arm64MovImm(arm64StubArg(3), value: arm64MapFlags(system, reserve: false))
	u.asm.arm64MovImm(arm64StubArg(4), value: noFile)
	u.asm.arm64MovImm(arm64StubArg(5), value: noOffset)
	emitArm64StubCall(u, system: system, call: Arm64StubCall.stubMap)
	if count 'allocCount'
		arm64CountLive(u, delta: 1)
	end 'allocCount'
	u.asm.arm64Mov(result, src: arm64LinuxSyscallResult)
	u.asm.arm64Leave()
	u.asm.arm64Ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtFree))
	let freed = u.asm.newLabel()
	u.asm.arm64BranchIfZero(arm64InternalArg(0), label: freed)
	if count 'freeCount'
		arm64CountLive(u, delta: -1)
	end 'freeCount'
	u.asm.bind(freed)
	u.asm.arm64Ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtWrite))
	u.asm.arm64Enter()
	u.asm.arm64ShrImm(arm64StubArg(2), src: arm64InternalArg(2), shift: stringLengthShift as Arm64Imm6)
	u.asm.arm64Mov(arm64StubArg(1), src: arm64InternalArg(1))
	u.asm.arm64Mov(arm64StubArg(0), src: arm64InternalArg(0))
	emitArm64StubCall(u, system: system, call: Arm64StubCall.stubWrite)
	u.asm.arm64Leave()
	u.asm.arm64Ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtItoa))
	u.asm.arm64AddressData(result, dataOffset: u.data.textOffset("?"))
	u.asm.arm64MovImm(arm64InternalSecondResult, value: literalWord("?"))
	u.asm.arm64Ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtCheckLeaks))
	let clean = u.asm.newLabel()
	u.asm.arm64Mov(result, src: arm64InternalArg(0))
	u.asm.arm64LoadSymbol(stubTemp, symbol: testLiveSymbol)
	u.asm.arm64BranchIfZero(stubTemp, label: clean)
	u.asm.arm64MovImm(arm64StubArg(0), value: testLeakExitCode)
	emitArm64StubCall(u, system: system, call: Arm64StubCall.stubExit)
	u.asm.bind(clean)
	u.asm.arm64Ret()
	u.defineCode(ir.rtSymbol(ir.Rt.rtPanic))
	u.asm.arm64MovImm(arm64StubArg(0), value: testPanicExitCode)
	emitArm64StubCall(u, system: system, call: Arm64StubCall.stubExit)
	return u
end 'arm64RuntimeUnit'

// arm64CountLive adds to the number of live boxes, keeping every register but the stub's temporary and the address scratch
// register.
function arm64CountLive(mutates u CodeUnit, delta FullRangeInt)
	u.asm.arm64LoadSymbol(stubTemp, symbol: testLiveSymbol)
	u.asm.arm64AddImm(stubTemp, src: stubTemp, value: delta)
	u.asm.arm64StoreSymbol(testLiveSymbol, src: stubTemp)
end 'arm64CountLive'

// emitTestItoa writes the stand-in for itoa, which gives "?" for every number.
function emitTestItoa(mutates u CodeUnit)
	u.defineCode(ir.rtSymbol(ir.Rt.rtItoa))
	u.asm.leaData(x64InternalResult, dataOffset: u.data.textOffset("?"))
	u.asm.movImm(x64InternalSecondResult, imm: literalWord("?"))
	u.asm.ret()
end 'emitTestItoa'

// testLeakExitCode is the runtime's exit code for a leak (runtime/output.maxon).
let testLeakExitCode = 99

// testLiveSymbol is the word in which the test's runtime counts its live boxes, as the real one counts them in each
// thread's context.
let testLiveSymbol = "test.live"

// testPanicExitCode is the runtime's exit code for a panic, which a fault ends as.
let testPanicExitCode = 1
