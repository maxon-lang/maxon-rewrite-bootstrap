// Codegen turns the IR of a module's functions into x64 in a code unit. It is deliberately naive: every register and slot
// has its own frame slot, so each instruction loads its operands and stores its result. Calls use an internal convention:
// the arguments are pushed left to right and the caller pops them. A function that throws returns its error beside its
// value in errorReg.

// errorReg is where a function that throws returns its error: 0 when it returned, and the error's case plus 1 when it
// failed.
let errorReg = rdx

let pageSize = 4096

let frameAlignment = 16

// ifaceBoxWords is how many words of the frame a frame box takes.
let ifaceBoxWords = ifaceBoxBytes / wordBytes

let shiftBitCount = 64

let signBitShift = 63

// The rounding modes of roundsd's immediate: to the nearest (ties to even), down and up.
let roundNearest = 0 as Imm8

let roundDown = 1 as Imm8

let roundUp = 2 as Imm8

// zeroInlineSlots is how many managed slots a frame clears with one store each; a frame with more clears all its slots
// with one string instruction, which is shorter from there on.
let zeroInlineSlots = 6

// The arguments of a call are the words above the return address and the saved frame pointer.
let paramBase = 16

// A DLL import takes its first win64RegisterArgs words in registers, and has win64ShadowBytes of stack below the rest that
// it may write.
let win64RegisterArgs = 4 as Count

let win64ShadowBytes = 32 as Count

// win64ArgRegister is the register of a DLL import's argument, of the first win64RegisterArgs.
function win64ArgRegister(index Count) returns X64Register
	if index == 0 'first'
		return rcx
	end 'first'
	if index == 1 'second'
		return rdx
	end 'second'
	if index == 2 'third'
		return r8
	end 'third'
	if index == 3 'fourth'
		return r9
	end 'fourth'
	panic("backend: a DLL import's argument past its registers")
end 'win64ArgRegister'

typealias CalleeSymbols = table.IntMap with String

typealias TableSet = table.StringMap with bool

// Codegen writes one module's functions into its unit. The visitors get no project, so what the instructions of the
// function name by a handle that only the project can spell is looked up once, before the function is visited.
type Codegen implements ir.InstrVisitor, ir.TermVisitor
	var u as CodeUnit
	// next is the block whose code follows the block being written, which a jump to it falls through to, or noBlock.
	var next as ir.BlockID
	// calleeSymbols are the symbols of the callees of the function being written, by function.
	var calleeSymbols as CalleeSymbols
	// canThrow is whether the function being written returns an error beside its value.
	var canThrow as bool
	// symbol is the link name of the function being written, which the bodies of its closures are named after.
	var fnSymbol as String
	// tables are the tables of interface values that the unit has, and due the ones the function being written names
	// that the unit does not have yet, which are written after it.
	var tables as TableSet
	var due as ir.WitnessTableList
	// typeNames are the symbols of the data that names each type that the unit's tables hold and its casts test, which
	// the unit defines once each.
	var typeNames as TableSet
	var typeSymbols as CalleeSymbols

	static function new() returns Codegen
		return Codegen{u: CodeUnit.new(), next: ir.noBlock, calleeSymbols: CalleeSymbols.new(), canThrow: false, fnSymbol: "", tables: TableSet.new(), due: ir.WitnessTableList.create(0), typeNames: TableSet.new(), typeSymbols: CalleeSymbols.new()}
	end 'new'

	function get(mutates self, f ir.IrFunction, r X64Register, v ir.Reg)
		u.asm.load(r, base: rbp, disp: regOffset(f, v: v))
	end 'get'

	function put(mutates self, f ir.IrFunction, v ir.Reg, r X64Register)
		u.asm.store(rbp, disp: regOffset(f, v: v), src: r)
	end 'put'

	// prepare names what the function's instructions ask for by handle: the symbols of its callees, and the drop and copy
	// routines of its types, which are asked for in the order the code does.
	function prepare(mutates self, mutates p ast.Project, f ir.IrFunction)
		canThrow = p.funcs.entries[f.decl as Count].errTy != ast.noType
		calleeSymbols = CalleeSymbols.new()
		for i in 0 upto f.callees.count() 'callees'
			calleeSymbols.insert(f.callees[i] as Count, value: ast.funcLinkName(p, fid: f.callees[i]))
		end 'callees'
		for i in 0 upto f.tables.count() 'tables'
			if not tables.has(f.tables[i].symbol) 'new'
				tables.insert(f.tables[i].symbol.clone(), value: true)
				due.push(f.tables[i].clone())
				_ = self.typeName(p, t: f.tables[i].concrete)
			end 'new'
		end 'tables'
		for k in 0 upto f.instrs.count() 'instrs'
			let op = f.instrs[k].op
			if op == ir.Opcode.opDrop 'drop'
				_ = u.needed.symbol(p, kind: RoutineKind.dropRoutine, ty: ir.dropTy(f, x: f.instrs[k]))
			end 'drop' else if op == ir.Opcode.opIsType 'isType'
				let ty = ir.isTypeTy(f, x: f.instrs[k])
				let named = self.typeName(p, t: ty)
				typeSymbols.insert(ty as Count, value: named)
			end 'isType' else if op == ir.Opcode.opDropSlot 'dropSlot'
				_ = u.needed.symbol(p, kind: RoutineKind.dropRoutine, ty: ir.dropSlotTy(f, x: f.instrs[k]))
			end 'dropSlot' else if op == ir.Opcode.opDropAt 'dropAt'
				_ = u.needed.symbol(p, kind: RoutineKind.dropRoutine, ty: ir.dropAtTy(f, x: f.instrs[k]))
			end 'dropAt' else if op == ir.Opcode.opCopy 'copy'
				_ = u.needed.symbol(p, kind: RoutineKind.copyRoutine, ty: ir.copyTy(f, x: f.instrs[k]))
			end 'copy'
		end 'instrs'
	end 'prepare'

	// typeName is the symbol of the word of data whose address names the type t, for the table of a value of it and the cast
	// that tests for it, defined in the unit once.
	function typeName(mutates self, p ast.Project, t ast.TypeID) returns String
		let symbol = typeNameSymbol(p, t: t)
		if not typeNames.has(symbol) 'new'
			typeNames.insert(symbol.clone(), value: true)
			u.defineSharedData(symbol, size: wordBytes)
		end 'new'
		return symbol
	end 'typeName'

	// zeroManagedSlots empties every slot that can own a value, so a drop of a slot that was moved from, or never assigned, finds
	// 0 and does nothing. A scalar slot is never dropped and is left as it is, and so is a register, which is always written
	// before it is read.
	function zeroManagedSlots(mutates self, f ir.IrFunction)
		var managed = 0 as Count
		for i in 0 upto f.slots.count() 'count'
			if f.slots[i] == ir.IrKind.kindManaged 'managed'
				managed = try managed + 1 otherwise panic("backend: more slots than memory")
			end 'managed'
		end 'count'
		if managed == 0 'none'
			return
		end 'none'
		u.asm.bitXor(rax, src: rax)
		if managed > zeroInlineSlots 'string'
			let slots = f.slots.count()
			u.asm.lea(rdi, base: rbp, disp: slotOffset(try slots - 1 otherwise panic("backend: no slots")))
			u.asm.movImm(rcx, imm: try slots as FullRangeInt otherwise panic("backend: more slots than memory"))
			u.asm.repStosq()
			return
		end 'string'
		for i in 0 upto f.slots.count() 'inline'
			if f.slots[i] == ir.IrKind.kindManaged 'managed'
				u.asm.store(rbp, disp: slotOffset(i), src: rax)
			end 'managed'
		end 'inline'
	end 'zeroManagedSlots'

	function allocateFrame(mutates self, bytes Count)
		var frame = alignUp(bytes, alignment: frameAlignment)
		while frame > pageSize 'pages'
			u.asm.subImm(rsp, imm: pageSize)
			u.asm.store(rsp, disp: 0, src: rax)
			frame = try frame - pageSize otherwise panic("backend: a frame below zero")
		end 'pages'
		if frame > 0 'rest'
			u.asm.subImm(rsp, imm: imm32Of(frame))
		end 'rest'
	end 'allocateFrame'

	function call(mutates self, f ir.IrFunction, symbol String, start Count, count Count, dst ir.Reg)
		for i in 0 upto count 'args'
			self.get(f, r: rax, v: f.args[try start + i otherwise panic("backend: an argument past the pool")])
			u.asm.push(rax)
		end 'args'
		u.asm.callSymbol(symbol)
		if count > 0 'pop'
			u.asm.addImm(rsp, imm: imm32Of(try count * wordBytes otherwise panic("backend: more arguments than memory")))
		end 'pop'
		if dst != ir.noReg 'gives'
			self.put(f, v: dst, r: rax)
		end 'gives'
	end 'call'

	// callRoutine calls the drop or copy routine of a type with the value in rax. The routine is generated once for the
	// program, after every module, from the list each unit keeps of the ones it asked for.
	function callRoutine(mutates self, kind RoutineKind, ty ast.TypeID)
		u.asm.push(rax)
		u.asm.callSymbol(u.needed.lookup(kind, ty: ty))
		u.asm.addImm(rsp, imm: wordBytes)
	end 'callRoutine'

	function condition(x ir.Instr) returns X64CondCode
		let unsigned = ir.cmpUnsigned(x)
		let op = ir.cmpOp(x)
		if op == ir.CmpOp.cmpEq 'eq'
			return X64CondCode.equal
		end 'eq'
		if op == ir.CmpOp.cmpNe 'ne'
			return X64CondCode.notEqual
		end 'ne'
		if op == ir.CmpOp.cmpLt 'lt'
			return X64CondCode.below if unsigned else X64CondCode.less
		end 'lt'
		if op == ir.CmpOp.cmpLe 'le'
			return X64CondCode.belowEqual if unsigned else X64CondCode.lessEqual
		end 'le'
		if op == ir.CmpOp.cmpGt 'gt'
			return X64CondCode.above if unsigned else X64CondCode.greater
		end 'gt'
		if op == ir.CmpOp.cmpGe 'ge'
			return X64CondCode.aboveEqual if unsigned else X64CondCode.greaterEqual
		end 'ge'
		panic("codegen: comparison {op.name}")
	end 'condition'

	// binary computes an operation on rax and rcx into rax. A checked one jumps to its failure block when the result does not
	// fit: the carry flag says so for an unsigned word and the overflow flag for a signed one.
	function binary(mutates self, x ir.Instr)
		let unsigned = ir.binUnsigned(x)
		var overflow = X64CondCode.overflow
		if unsigned 'carry'
			overflow = X64CondCode.below
		end 'carry'
		let checked = ir.binHasFail(x)
		let op = ir.binOp(x)
		if op == ir.BinOp.binDiv or op == ir.BinOp.binMod 'divide'
			self.divide(x, remainder: op == ir.BinOp.binMod, unsigned: unsigned)
			return
		end 'divide'
		if op == ir.BinOp.binShl or op == ir.BinOp.binShr 'shift'
			self.shift(x, left: op == ir.BinOp.binShl, unsigned: unsigned)
			return
		end 'shift'
		if op == ir.BinOp.binAdd 'add'
			u.asm.add(rax, src: rcx)
		end 'add' else if op == ir.BinOp.binSub 'sub'
			u.asm.sub(rax, src: rcx)
		end 'sub' else if op == ir.BinOp.binMul 'mul'
			if unsigned 'unsignedMul'
				u.asm.mulRax(rcx)
			end 'unsignedMul' else 'signedMul'
				u.asm.imul(rax, src: rcx)
			end 'signedMul'
		end 'mul' else if op == ir.BinOp.binAnd 'and'
			u.asm.bitAnd(rax, src: rcx)
		end 'and' else if op == ir.BinOp.binOr 'or'
			u.asm.bitOr(rax, src: rcx)
		end 'or' else if op == ir.BinOp.binXor 'xor'
			u.asm.bitXor(rax, src: rcx)
		end 'xor' else 'unknown'
			panic("codegen: operator {op.name}")
		end 'unknown'
		if checked 'check'
			u.asm.jcc(overflow, label: blockLabel(ir.binFail(x).unwrap()))
		end 'check'
	end 'binary'

	// divide divides rax by rcx, which a guard or the range analysis has found is not 0, into rax: the quotient, or the
	// remainder when remainder is set. A signed division by -1 is the one that the processor faults on, for i64.min: the quotient is
	// then the failure of a checked division, and the remainder is 0.
	function divide(mutates self, x ir.Instr, remainder bool, unsigned bool)
		if unsigned 'unsigned'
			u.asm.bitXor(rdx, src: rdx)
			u.asm.div(rcx)
			if remainder 'keepRemainder'
				u.asm.mov(rax, src: rdx)
			end 'keepRemainder'
			return
		end 'unsigned'
		let divideLabel = u.asm.newLabel()
		let done = u.asm.newLabel()
		u.asm.cmpImm(rcx, imm: -1)
		u.asm.jcc(X64CondCode.notEqual, label: divideLabel)
		if remainder 'zero'
			u.asm.bitXor(rax, src: rax)
		end 'zero' else 'negate'
			u.asm.neg(rax)
			if ir.binHasFail(x) 'checked'
				u.asm.jcc(X64CondCode.overflow, label: blockLabel(ir.binFail(x).unwrap()))
			end 'checked'
		end 'negate'
		u.asm.jmp(done)
		u.asm.bind(divideLabel)
		u.asm.cqo()
		u.asm.idiv(rcx)
		if remainder 'keepRemainder'
			u.asm.mov(rax, src: rdx)
		end 'keepRemainder'
		u.asm.bind(done)
	end 'divide'

	// shift shifts rax by rcx, which a guard or the range analysis has found is not negative. A checked left shift goes to its
	// failure block when a bit that is not 0, or the sign, leaves the word: shifting the result back must give the value.
	function shift(mutates self, x ir.Instr, left bool, unsigned bool)
		let big = u.asm.newLabel()
		let done = u.asm.newLabel()
		let checkLeft = left and ir.binHasFail(x)
		if checkLeft 'save'
			u.asm.mov(rdx, src: rax)
		end 'save'
		u.asm.cmpImm(rcx, imm: shiftBitCount)
		u.asm.jcc(X64CondCode.greaterEqual, label: big)
		if left 'left'
			u.asm.shlCl(rax)
			if checkLeft 'verify'
				u.asm.mov(r8, src: rax)
				if unsigned 'unsignedBack'
					u.asm.shrCl(r8)
				end 'unsignedBack' else 'signedBack'
					u.asm.sarCl(r8)
				end 'signedBack'
				u.asm.cmp(r8, right: rdx)
				u.asm.jcc(X64CondCode.notEqual, label: blockLabel(ir.binFail(x).unwrap()))
			end 'verify'
		end 'left' else if unsigned 'unsignedRight'
			u.asm.shrCl(rax)
		end 'unsignedRight' else 'signedRight'
			u.asm.sarCl(rax)
		end 'signedRight'
		u.asm.jmp(done)
		u.asm.bind(big)
		if checkLeft 'lost'
			u.asm.test(rdx, right: rdx)
			u.asm.jcc(X64CondCode.notEqual, label: blockLabel(ir.binFail(x).unwrap()))
		end 'lost'
		if not left and not unsigned 'sign'
			u.asm.sarImm(rax, imm: signBitShift)
		end 'sign' else 'zero'
			u.asm.bitXor(rax, src: rax)
		end 'zero'
		u.asm.bind(done)
	end 'shift'

	function jumpUnlessNext(mutates self, target ir.BlockID)
		if target != next 'jump'
			u.asm.jmp(blockLabel(target))
		end 'jump'
	end 'jumpUnlessNext'

	// The visit methods are codegen's ir.InstrVisitor and ir.TermVisitor: each writes the code of one operation.

	function visitConst(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.movImm(rax, imm: try ir.constValue(x) as FullRangeInt otherwise panic("backend: a constant past the word"))
		self.put(f, v: x.dst, r: rax)
	end 'visitConst'

	function visitStr(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.leaData(rax, dataOffset: u.data.textOffset(ir.strText(f, x: x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitStr'

	function visitLoadSlot(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.load(rax, base: rbp, disp: slotOffset(ir.loadSlotSlot(x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitLoadSlot'

	function visitMoveSlot(mutates self, f ir.IrFunction, x ir.Instr)
		let slot = ir.moveSlotSlot(x)
		u.asm.load(rax, base: rbp, disp: slotOffset(slot))
		self.put(f, v: x.dst, r: rax)
		u.asm.bitXor(rcx, src: rcx)
		u.asm.store(rbp, disp: slotOffset(slot), src: rcx)
	end 'visitMoveSlot'

	function visitStoreSlot(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.storeSlotSrc(x))
		u.asm.store(rbp, disp: slotOffset(ir.storeSlotSlot(x)), src: rax)
	end 'visitStoreSlot'

	function visitSlotAddr(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.lea(rax, base: rbp, disp: slotOffset(ir.slotAddrSlot(x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitSlotAddr'

	function visitLoadParam(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.load(rax, base: rbp, disp: paramOffset(f, index: ir.loadParamParam(x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitLoadParam'

	function visitLoadField(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.loadFieldObj(x))
		u.asm.load(rax, base: rax, disp: imm32Of(ir.loadFieldOffset(x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitLoadField'

	function visitStoreField(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rcx, v: ir.storeFieldObj(x))
		self.get(f, r: rax, v: ir.storeFieldSrc(x))
		u.asm.store(rcx, disp: imm32Of(ir.storeFieldOffset(x)), src: rax)
	end 'visitStoreField'

	function visitFieldAddr(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.fieldAddrObj(x))
		u.asm.lea(rax, base: rax, disp: imm32Of(ir.fieldAddrOffset(x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitFieldAddr'

	function visitLoadAt(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.loadAtAddr(x))
		u.asm.load(rax, base: rax, disp: 0)
		self.put(f, v: x.dst, r: rax)
	end 'visitLoadAt'

	function visitMoveAt(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rcx, v: ir.moveAtAddr(x))
		u.asm.load(rax, base: rcx, disp: 0)
		self.put(f, v: x.dst, r: rax)
		u.asm.bitXor(rdx, src: rdx)
		u.asm.store(rcx, disp: 0, src: rdx)
	end 'visitMoveAt'

	function visitDrop(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.dropSrc(x))
		self.callRoutine(RoutineKind.dropRoutine, ty: ir.dropTy(f, x: x))
	end 'visitDrop'

	function visitDropSlot(mutates self, f ir.IrFunction, x ir.Instr)
		let slot = ir.dropSlotSlot(x)
		u.asm.load(rax, base: rbp, disp: slotOffset(slot))
		u.asm.bitXor(rcx, src: rcx)
		u.asm.store(rbp, disp: slotOffset(slot), src: rcx)
		self.callRoutine(RoutineKind.dropRoutine, ty: ir.dropSlotTy(f, x: x))
	end 'visitDropSlot'

	function visitDropAt(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rcx, v: ir.dropAtAddr(x))
		u.asm.load(rax, base: rcx, disp: 0)
		u.asm.bitXor(rdx, src: rdx)
		u.asm.store(rcx, disp: 0, src: rdx)
		self.callRoutine(RoutineKind.dropRoutine, ty: ir.dropAtTy(f, x: x))
	end 'visitDropAt'

	function visitCopy(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.copySrc(x))
		self.callRoutine(RoutineKind.copyRoutine, ty: ir.copyTy(f, x: x))
		self.put(f, v: x.dst, r: rax)
	end 'visitCopy'

	function visitStoreAt(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rcx, v: ir.storeAtAddr(x))
		self.get(f, r: rax, v: ir.storeAtSrc(x))
		u.asm.store(rcx, disp: 0, src: rax)
	end 'visitStoreAt'

	function visitLoadGlobal(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.loadSymbol(rax, symbol: ir.rtSymbol(ir.loadGlobalSymbol(x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitLoadGlobal'

	// The raw operations are the runtime's source's (README, "The runtime"): a load or a store of a width, the address of
	// a global, and a call of a DLL import.
	function visitLoadRaw(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rcx, v: ir.loadRawAddr(x))
		match ir.loadRawWidth(x) 'width'
			width8 then u.asm.loadByte(rax, base: rcx, disp: 0)
			width16 then u.asm.loadWord16(rax, base: rcx, disp: 0)
			width32 then u.asm.loadWord32(rax, base: rcx, disp: 0)
			width64 then u.asm.load(rax, base: rcx, disp: 0)
		end 'width'
		self.put(f, v: x.dst, r: rax)
	end 'visitLoadRaw'

	function visitStoreRaw(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rcx, v: ir.storeRawAddr(x))
		self.get(f, r: rax, v: ir.storeRawSrc(x))
		match ir.storeRawWidth(x) 'width'
			width8 then u.asm.storeByte(rcx, disp: 0, src: rax)
			width16 then u.asm.storeWord16(rcx, disp: 0, src: rax)
			width32 then u.asm.storeWord32(rcx, disp: 0, src: rax)
			width64 then u.asm.store(rcx, disp: 0, src: rax)
		end 'width'
	end 'visitStoreRaw'

	function visitGlobalAddr(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.leaSymbol(rax, symbol: ir.rtSymbol(ir.globalAddrSymbol(x)))
		self.put(f, v: x.dst, r: rax)
	end 'visitGlobalAddr'

	// visitCallImport calls a DLL import by the Win64 convention: the first four words in rcx, rdx, r8 and r9, the rest on
	// the stack above the 32 bytes of shadow space the callee may write, rsp aligned to 16 at the call. Code keeps nothing
	// in a register across an instruction, so rbx, which the callee preserves, holds rsp across the call and is restored.
	function visitCallImport(mutates self, f ir.IrFunction, x ir.Instr)
		let start = ir.callImportArgsStart(x)
		let count = ir.callImportArgsCount(x)
		let stackWords = count - win64RegisterArgs if count > win64RegisterArgs else 0
		let frame = try (win64ShadowBytes + stackWords * wordBytes + frameAlignment - 1) / frameAlignment * frameAlignment otherwise panic("backend: more arguments than memory")
		u.asm.push(rbx)
		u.asm.mov(rbx, src: rsp)
		u.asm.andImm(rsp, imm: -frameAlignment)
		u.asm.subImm(rsp, imm: imm32Of(frame))
		for i in win64RegisterArgs upto count 'stack'
			self.get(f, r: rax, v: f.args[try start + i otherwise panic("backend: an argument past the pool")])
			let at = try win64ShadowBytes + (i - win64RegisterArgs) * wordBytes otherwise panic("backend: more arguments than memory")
			u.asm.store(rsp, disp: imm32Of(at), src: rax)
		end 'stack'
		let inRegisters = count if count < win64RegisterArgs else win64RegisterArgs
		for i in 0 upto inRegisters 'registers'
			self.get(f, r: win64ArgRegister(i), v: f.args[try start + i otherwise panic("backend: an argument past the pool")])
		end 'registers'
		u.asm.callImport(importIndex(ir.callImportName(f, x: x)))
		u.asm.mov(rsp, src: rbx)
		u.asm.pop(rbx)
		self.put(f, v: x.dst, r: rax)
	end 'visitCallImport'

	function visitBin(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.binLeft(x))
		self.get(f, r: rcx, v: ir.binRight(x))
		self.binary(x)
		self.put(f, v: x.dst, r: rax)
	end 'visitBin'

	function visitCmp(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.cmpLeft(x))
		self.get(f, r: rcx, v: ir.cmpRight(x))
		u.asm.cmp(rax, right: rcx)
		u.asm.setccRax(self.condition(x))
		self.put(f, v: x.dst, r: rax)
	end 'visitCmp'

	// A float operation moves its operands from the frame into xmm0 and xmm1 and its result back into rax: a float is a
	// word like any other between operations.
	function visitFBin(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.fBinLeft(x))
		self.get(f, r: rcx, v: ir.fBinRight(x))
		u.asm.toXmm0(rax)
		u.asm.toXmm1(rcx)
		match ir.fBinOp(x) 'op'
			fBinAdd then u.asm.addsd()
			fBinSub then u.asm.subsd()
			fBinMul then u.asm.mulsd()
			fBinDiv then u.asm.divsd()
		end 'op'
		u.asm.fromXmm0(rax)
		self.put(f, v: x.dst, r: rax)
	end 'visitFBin'

	// visitFCmp compares with ucomisd, which sets the carry, zero and parity flags all for an unordered pair: a test of
	// below swaps the operands so that a NaN fails it as it fails every test but ne.
	function visitFCmp(mutates self, f ir.IrFunction, x ir.Instr)
		let op = ir.fCmpOp(x)
		let swapped = op == ir.CmpOp.cmpLt or op == ir.CmpOp.cmpLe
		self.get(f, r: rax, v: ir.fCmpRight(x) if swapped else ir.fCmpLeft(x))
		self.get(f, r: rcx, v: ir.fCmpLeft(x) if swapped else ir.fCmpRight(x))
		u.asm.toXmm0(rax)
		u.asm.toXmm1(rcx)
		u.asm.ucomisd()
		match op 'op'
			cmpEq then self.orderedTest(X64CondCode.equal, ordered: X64CondCode.noParity, both: true)
			cmpNe then self.orderedTest(X64CondCode.notEqual, ordered: X64CondCode.parity, both: false)
			cmpLt then u.asm.setccRax(X64CondCode.above)
			cmpLe then u.asm.setccRax(X64CondCode.aboveEqual)
			cmpGt then u.asm.setccRax(X64CondCode.above)
			cmpGe then u.asm.setccRax(X64CondCode.aboveEqual)
		end 'op'
		self.put(f, v: x.dst, r: rax)
	end 'visitFCmp'

	// orderedTest sets rax to cond and, with both, also to the parity test that says the pair is ordered, or else to either.
	function orderedTest(mutates self, cond X64CondCode, ordered X64CondCode, both bool)
		u.asm.setccRax(cond)
		u.asm.setccByte(ordered, reg: rcx)
		if both 'and'
			u.asm.bitAnd(rax, src: rcx)
		end 'and' else 'or'
			u.asm.bitOr(rax, src: rcx)
		end 'or'
	end 'orderedTest'

	function visitFUnary(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.fUnarySrc(x))
		u.asm.toXmm0(rax)
		match ir.fUnaryOp(x) 'op'
			fUnarySqrt then u.asm.sqrtsd()
			fUnaryRound then u.asm.roundsd(roundNearest)
			fUnaryFloor then u.asm.roundsd(roundDown)
			fUnaryCeil then u.asm.roundsd(roundUp)
		end 'op'
		u.asm.fromXmm0(rax)
		self.put(f, v: x.dst, r: rax)
	end 'visitFUnary'

	// visitIntToFloat converts with cvtsi2sd, which reads a signed word: an unsigned one past i64.max is halved first,
	// keeping its low bit so that it rounds as the whole would, and the double doubled.
	function visitIntToFloat(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.intToFloatSrc(x))
		if not ir.intToFloatUnsigned(x) 'signed'
			u.asm.cvtsi2sd(rax)
		end 'signed' else 'unsigned'
			let large = u.asm.newLabel()
			let done = u.asm.newLabel()
			u.asm.test(rax, right: rax)
			u.asm.jcc(X64CondCode.sign, label: large)
			u.asm.cvtsi2sd(rax)
			u.asm.jmp(done)
			u.asm.bind(large)
			u.asm.mov(rdx, src: rax)
			u.asm.andImm(rdx, imm: 1)
			u.asm.movImm(rcx, imm: 1)
			u.asm.shrCl(rax)
			u.asm.bitOr(rax, src: rdx)
			u.asm.cvtsi2sd(rax)
			u.asm.fromXmm0(rax)
			u.asm.toXmm1(rax)
			u.asm.addsd()
			u.asm.bind(done)
		end 'unsigned'
		u.asm.fromXmm0(rax)
		self.put(f, v: x.dst, r: rax)
	end 'visitIntToFloat'

	function visitFloatToInt(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.floatToIntSrc(x))
		u.asm.toXmm0(rax)
		u.asm.cvttsd2siRax()
		self.put(f, v: x.dst, r: rax)
	end 'visitFloatToInt'

	function visitNeg(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.negSrc(x))
		u.asm.neg(rax)
		if ir.negHasFail(x) 'checked'
			u.asm.jcc(X64CondCode.overflow, label: blockLabel(ir.negFail(x).unwrap()))
		end 'checked'
		self.put(f, v: x.dst, r: rax)
	end 'visitNeg'

	function visitNot(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.notSrc(x))
		u.asm.bitNot(rax)
		self.put(f, v: x.dst, r: rax)
	end 'visitNot'

	function visitAlloc(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.movImm(rax, imm: try ir.allocBytes(x) as FullRangeInt otherwise panic("backend: a box past memory"))
		u.asm.push(rax)
		u.asm.callSymbol(ir.rtSymbol(ir.Rt.rtAlloc))
		u.asm.addImm(rsp, imm: wordBytes)
		self.put(f, v: x.dst, r: rax)
	end 'visitAlloc'

	function visitCall(mutates self, f ir.IrFunction, x ir.Instr)
		let symbol = match calleeSymbols.get(ir.callCallee(f, x: x) as Count) 'callee'
			some(name) gives name.clone()
			none panic("backend: a callee that prepare did not name")
		end 'callee'
		self.call(f, symbol: symbol, start: ir.callArgsStart(x), count: ir.callArgsCount(x), dst: x.dst)
		match ir.callErrReg(x) 'throws'
			some(err) then self.put(f, v: err, r: errorReg)
			none then _ = 0
		end 'throws'
	end 'visitCall'

	// visitCallRuntime calls a runtime entry. The entries that read the length of an array, a byte array or a string, read
	// or write one of their elements, or push one, are most of what a program does with them, so their common case is
	// written in place, and the entry itself is only called for the rest: an index out of range, which it panics on, or a
	// push that has to grow the buffer or an insert below the end, which move elements. What the program sees is the
	// entry's behaviour either way.
	function visitCallRuntime(mutates self, f ir.IrFunction, x ir.Instr)
		let symbol = ir.callRuntimeSymbol(x)
		if symbol == ir.Rt.rtArrayLen or symbol == ir.Rt.rtBytesLen or symbol == ir.Rt.rtStrLen 'length'
			let offset = stringLengthOffset if symbol == ir.Rt.rtStrLen else arrayLengthOffset
			self.get(f, r: rcx, v: self.runtimeArg(f, x: x, index: 0))
			u.asm.load(rax, base: rcx, disp: offset)
			self.put(f, v: x.dst, r: rax)
			return
		end 'length'
		let slow = u.asm.newLabel()
		let done = u.asm.newLabel()
		if symbol == ir.Rt.rtArrayElem 'arrayElem'
			self.elementAddress(f, x: x, elementBytes: wordBytes, slow: slow)
			self.put(f, v: x.dst, r: rax)
		end 'arrayElem' else if symbol == ir.Rt.rtBytesGet 'bytesGet'
			self.elementAddress(f, x: x, elementBytes: byteBytes, slow: slow)
			u.asm.loadByte(rax, base: rax, disp: 0)
			self.put(f, v: x.dst, r: rax)
		end 'bytesGet' else if symbol == ir.Rt.rtBytesSet 'bytesSet'
			self.elementAddress(f, x: x, elementBytes: byteBytes, slow: slow)
			self.get(f, r: rdx, v: self.runtimeArg(f, x: x, index: 2))
			u.asm.storeByte(rax, disp: 0, src: rdx)
		end 'bytesSet' else if symbol == ir.Rt.rtArrayInsert 'arrayInsert'
			self.pushInPlace(f, x: x, elementBytes: wordBytes, slow: slow)
			u.asm.store(rax, disp: 0, src: rdx)
		end 'arrayInsert' else if symbol == ir.Rt.rtBytesInsert 'bytesInsert'
			self.pushInPlace(f, x: x, elementBytes: byteBytes, slow: slow)
			u.asm.storeByte(rax, disp: 0, src: rdx)
		end 'bytesInsert' else if symbol == ir.Rt.rtStrByteAt 'stringByteAt'
			self.inBounds(f, x: x, lengthOffset: stringLengthOffset, slow: slow)
			u.asm.add(rax, src: rcx)
			u.asm.loadByte(rax, base: rax, disp: stringBytesOffset)
			self.put(f, v: x.dst, r: rax)
		end 'stringByteAt' else 'call'
			self.call(f, symbol: ir.rtSymbol(symbol), start: ir.callRuntimeArgsStart(x), count: ir.callRuntimeArgsCount(x), dst: x.dst)
			return
		end 'call'
		u.asm.jmp(done)
		u.asm.bind(slow)
		self.call(f, symbol: ir.rtSymbol(symbol), start: ir.callRuntimeArgsStart(x), count: ir.callRuntimeArgsCount(x), dst: x.dst)
		u.asm.bind(done)
	end 'visitCallRuntime'

	function runtimeArg(f ir.IrFunction, x ir.Instr, index Count) returns ir.Reg
		return f.args[try ir.callRuntimeArgsStart(x) + index otherwise panic("backend: an argument past the pool")]
	end 'runtimeArg'

	// inBounds puts the entry's box, its first argument, in rcx and the index, its second, in rax, and jumps to slow when the
	// index is not below the length the box holds at lengthOffset. The comparison is unsigned, so no index the entry would
	// refuse passes it.
	function inBounds(mutates self, f ir.IrFunction, x ir.Instr, lengthOffset Imm32, slow LabelID)
		self.get(f, r: rcx, v: self.runtimeArg(f, x: x, index: 0))
		self.get(f, r: rax, v: self.runtimeArg(f, x: x, index: 1))
		u.asm.load(rdx, base: rcx, disp: lengthOffset)
		u.asm.cmp(rax, right: rdx)
		u.asm.jcc(X64CondCode.aboveEqual, label: slow)
	end 'inBounds'

	// elementAddress puts in rax the address of the element at the index of the entry's array, or jumps to slow when the
	// index is out of range.
	function elementAddress(mutates self, f ir.IrFunction, x ir.Instr, elementBytes Count, slow LabelID)
		self.inBounds(f, x: x, lengthOffset: arrayLengthOffset, slow: slow)
		self.scaleIndex(elementBytes)
		u.asm.load(rcx, base: rcx, disp: arrayDataOffset)
		u.asm.add(rax, src: rcx)
	end 'elementAddress'

	// pushInPlace jumps to slow unless the entry inserts at the end of an array whose buffer has room; otherwise it counts
	// the new element and leaves its address in rax and the element, the third argument, in rdx.
	function pushInPlace(mutates self, f ir.IrFunction, x ir.Instr, elementBytes Count, slow LabelID)
		self.get(f, r: rcx, v: self.runtimeArg(f, x: x, index: 0))
		self.get(f, r: rax, v: self.runtimeArg(f, x: x, index: 1))
		u.asm.load(rdx, base: rcx, disp: arrayLengthOffset)
		u.asm.cmp(rax, right: rdx)
		u.asm.jcc(X64CondCode.notEqual, label: slow)
		u.asm.load(rdx, base: rcx, disp: arrayCapacityOffset)
		u.asm.cmp(rax, right: rdx)
		u.asm.jcc(X64CondCode.aboveEqual, label: slow)
		u.asm.lea(rdx, base: rax, disp: 1)
		u.asm.store(rcx, disp: arrayLengthOffset, src: rdx)
		self.scaleIndex(elementBytes)
		u.asm.load(rcx, base: rcx, disp: arrayDataOffset)
		u.asm.add(rax, src: rcx)
		self.get(f, r: rdx, v: self.runtimeArg(f, x: x, index: 2))
	end 'pushInPlace'

	// scaleIndex turns the index in rax into a byte offset; it uses rdx.
	function scaleIndex(mutates self, elementBytes Count)
		if elementBytes == byteBytes 'bytes'
			return
		end 'bytes'
		u.asm.movImm(rdx, imm: try elementBytes as FullRangeInt otherwise panic("backend: an element past memory"))
		u.asm.imul(rax, src: rdx)
	end 'scaleIndex'

	// visitClosure makes the box of a closure: a count of 1, the code of its body, the routine that drops what it owns, and
	// what it captured.
	function visitClosure(mutates self, f ir.IrFunction, x ir.Instr)
		let index = ir.closureBody(f, x: x)
		let body = bodySymbol(fnSymbol, index: index)
		let count = ir.closureCapturesCount(x)
		var drop = ""
		if ownsCaptures(f.bodies[index]) 'owns'
			drop = captureDropSymbol(body)
		end 'owns'
		self.closureBox(f, dst: x.dst, code: body, drop: drop, captures: count)
		let start = ir.closureCapturesStart(x)
		for i in 0 upto count 'captures'
			self.get(f, r: rcx, v: f.args[try start + i otherwise panic("backend: a capture past the pool")])
			u.asm.store(rax, disp: imm32Of(try closureCapturesOffset + i * wordBytes otherwise panic("backend: a capture past memory")), src: rcx)
		end 'captures'
	end 'visitClosure'

	// visitFuncValue makes the box of a closure of a named function, which captures nothing and so has nothing to drop.
	function visitFuncValue(mutates self, f ir.IrFunction, x ir.Instr)
		let code = match calleeSymbols.get(ir.funcValueCallee(f, x: x) as Count) 'callee'
			some(name) gives name.clone()
			none panic("backend: a function value that prepare did not name")
		end 'callee'
		self.closureBox(f, dst: x.dst, code: code, drop: "", captures: 0)
	end 'visitFuncValue'

	// closureBox allocates the box of a closure and fills in its header, leaving the box in rax and in dst. drop is the
	// routine that drops what it owns, or empty for none.
	function closureBox(mutates self, f ir.IrFunction, dst ir.Reg, code String, drop String, captures Count)
		let words = try closureCapturesOffset / wordBytes + captures otherwise panic("backend: a closure past memory")
		let bytes = try words * wordBytes otherwise panic("backend: a closure past memory")
		u.asm.movImm(rax, imm: try bytes as FullRangeInt otherwise panic("backend: a closure past memory"))
		u.asm.push(rax)
		u.asm.callSymbol(ir.rtSymbol(ir.Rt.rtAlloc))
		u.asm.addImm(rsp, imm: wordBytes)
		self.put(f, v: dst, r: rax)
		u.asm.movImm(rcx, imm: 1)
		u.asm.store(rax, disp: imm32Of(closureCountOffset), src: rcx)
		u.asm.leaSymbol(rcx, symbol: code)
		u.asm.store(rax, disp: imm32Of(closureCodeOffset), src: rcx)
		if drop == "" 'nothing'
			u.asm.bitXor(rcx, src: rcx)
		end 'nothing' else 'routine'
			u.asm.leaSymbol(rcx, symbol: drop)
		end 'routine'
		u.asm.store(rax, disp: imm32Of(closureDropOffset), src: rcx)
	end 'closureBox'

	// visitBox makes an interface value: a box on the heap of the address of the table and the value.
	function visitBox(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.movImm(rax, imm: try ifaceBoxBytes as FullRangeInt otherwise panic("backend: a box past memory"))
		u.asm.push(rax)
		u.asm.callSymbol(ir.rtSymbol(ir.Rt.rtAlloc))
		u.asm.addImm(rsp, imm: wordBytes)
		self.fillBox(f, table: ir.boxTable(f, x: x), value: ir.boxValue(x), dst: x.dst)
	end 'visitBox'

	// visitFrameBox makes an interface value whose box is one of the function's frame boxes.
	function visitFrameBox(mutates self, f ir.IrFunction, x ir.Instr)
		u.asm.lea(rax, base: rbp, disp: frameBoxOffset(f, box: ir.frameBoxBox(x)))
		self.fillBox(f, table: ir.frameBoxTable(f, x: x), value: ir.frameBoxValue(x), dst: x.dst)
	end 'visitFrameBox'

	// fillBox writes the address of the table and the value into the box at rax, which is the interface value dst.
	function fillBox(mutates self, f ir.IrFunction, table ir.WitnessTable, value ir.Reg, dst ir.Reg)
		self.put(f, v: dst, r: rax)
		u.asm.leaSymbol(rcx, symbol: table.symbol)
		u.asm.store(rax, disp: imm32Of(ifaceTableOffset), src: rcx)
		self.get(f, r: rcx, v: value)
		u.asm.store(rax, disp: imm32Of(ifaceValueOffset), src: rcx)
	end 'fillBox'

	// visitIsType calls the entry of the table that names the type of the value the box holds, and compares what it gives
	// with the name of the type the cast wants.
	function visitIsType(mutates self, f ir.IrFunction, x ir.Instr)
		self.get(f, r: rax, v: ir.isTypeSrc(x))
		u.asm.load(rax, base: rax, disp: imm32Of(ifaceTableOffset))
		u.asm.addImm(rax, imm: imm32Of(try tableTypeEntry * tableEntryBytes otherwise panic("backend: a table past memory")))
		u.asm.callRegister(rax)
		let symbol = match typeSymbols.get(ir.isTypeTy(f, x: x) as Count) 'named'
			some(name) gives name.clone()
			none panic("backend: a cast to a type that prepare did not name")
		end 'named'
		u.asm.leaSymbol(rcx, symbol: symbol)
		u.asm.cmp(rax, right: rcx)
		u.asm.setccByte(X64CondCode.equal, reg: rax)
		self.put(f, v: x.dst, r: rax)
	end 'visitIsType'

	// visitCallWitness calls the entry of a method in the table of an interface value, which jumps to the method, with the
	// value the box holds first and the other arguments. A method that consumes the value takes it out of
	// the box, which is freed once the method has returned.
	function visitCallWitness(mutates self, f ir.IrFunction, x ir.Instr)
		let start = ir.callWitnessArgsStart(x)
		let count = ir.callWitnessArgsCount(x)
		let conv = ir.callWitnessRecv(x)
		self.get(f, r: rax, v: f.args[start])
		u.asm.load(rcx, base: rax, disp: imm32Of(ifaceValueOffset))
		u.asm.push(rcx)
		for i in 1 upto count 'args'
			self.get(f, r: rax, v: f.args[try start + i otherwise panic("backend: an argument past the pool")])
			u.asm.push(rax)
		end 'args'
		self.get(f, r: rax, v: f.args[start])
		u.asm.load(rax, base: rax, disp: imm32Of(ifaceTableOffset))
		u.asm.addImm(rax, imm: imm32Of(try (tableFirstMethod + ir.callWitnessSlot(x)) * tableEntryBytes otherwise panic("backend: a table past memory")))
		u.asm.callRegister(rax)
		u.asm.addImm(rsp, imm: imm32Of(try count * wordBytes otherwise panic("backend: more arguments than memory")))
		if x.dst != ir.noReg 'gives'
			self.put(f, v: x.dst, r: rax)
		end 'gives'
		match ir.callWitnessErrReg(x) 'throws'
			some(err) then self.put(f, v: err, r: errorReg)
			none then _ = 0
		end 'throws'
		if conv == ir.ReceiverConv.receiverMoved 'consumed'
			self.get(f, r: rax, v: f.args[start])
			u.asm.push(rax)
			u.asm.callSymbol(ir.rtSymbol(ir.Rt.rtFree))
			u.asm.addImm(rsp, imm: wordBytes)
		end 'consumed'
	end 'visitCallWitness'

	// visitCallValue calls the code a closure holds with every argument, the closure first: the body of a closure reads
	// its captures from it, and the code of a named function never reaches it, since it is the farthest from the return
	// address.
	function visitCallValue(mutates self, f ir.IrFunction, x ir.Instr)
		let start = ir.callValueArgsStart(x)
		let count = ir.callValueArgsCount(x)
		for i in 0 upto count 'args'
			self.get(f, r: rax, v: f.args[try start + i otherwise panic("backend: an argument past the pool")])
			u.asm.push(rax)
		end 'args'
		self.get(f, r: rax, v: f.args[start])
		u.asm.load(rax, base: rax, disp: imm32Of(closureCodeOffset))
		u.asm.callRegister(rax)
		u.asm.addImm(rsp, imm: imm32Of(try count * wordBytes otherwise panic("backend: more arguments than memory")))
		if x.dst != ir.noReg 'gives'
			self.put(f, v: x.dst, r: rax)
		end 'gives'
	end 'visitCallValue'

	function visitWhen(mutates self, f ir.IrFunction, x ir.Instr)
		panic("codegen: a behaviour has no native code, and the driver refuses it before code is generated")
	end 'visitWhen'

	// visitGuard jumps to the guard's failure block unless the value is in its range.
	function visitGuard(mutates self, f ir.IrFunction, x ir.Instr)
		let fail = blockLabel(ir.guardFail(x))
		let kind = ir.guardKind(x)
		self.get(f, r: rax, v: ir.guardSrc(x))
		if kind == ir.GuardKind.guardNonNegative 'nonNegative'
			u.asm.test(rax, right: rax)
			u.asm.jcc(X64CondCode.sign, label: fail)
			return
		end 'nonNegative'
		if kind == ir.GuardKind.guardNonZero 'nonZero'
			u.asm.test(rax, right: rax)
			u.asm.jcc(X64CondCode.equal, label: fail)
			return
		end 'nonZero'
		u.asm.movImm(rcx, imm: try ir.guardBound(x) as FullRangeInt otherwise panic("backend: a bound past the word"))
		u.asm.cmp(rax, right: rcx)
		if kind == ir.GuardKind.guardSignedAtLeast 'signedAtLeast'
			u.asm.jcc(X64CondCode.less, label: fail)
		end 'signedAtLeast' else if kind == ir.GuardKind.guardSignedAtMost 'signedAtMost'
			u.asm.jcc(X64CondCode.greater, label: fail)
		end 'signedAtMost' else if kind == ir.GuardKind.guardUnsignedAtLeast 'unsignedAtLeast'
			u.asm.jcc(X64CondCode.below, label: fail)
		end 'unsignedAtLeast' else if kind == ir.GuardKind.guardUnsignedAtMost 'unsignedAtMost'
			u.asm.jcc(X64CondCode.above, label: fail)
		end 'unsignedAtMost' else 'unknown'
			panic("codegen: guard {kind.name}")
		end 'unknown'
	end 'visitGuard'

	function visitJump(mutates self, f ir.IrFunction, t ir.Term)
		self.jumpUnlessNext(ir.jumpTarget(t))
	end 'visitJump'

	function visitBranch(mutates self, f ir.IrFunction, t ir.Term)
		self.get(f, r: rax, v: ir.branchCond(t))
		u.asm.test(rax, right: rax)
		u.asm.jcc(X64CondCode.equal, label: blockLabel(ir.branchIfFalse(t)))
		self.jumpUnlessNext(ir.branchIfTrue(t))
	end 'visitBranch'

	function visitSwitch(mutates self, f ir.IrFunction, t ir.Term)
		self.get(f, r: rax, v: ir.switchValue(t))
		let start = ir.switchCasesStart(t)
		for i in 0 upto ir.switchCasesCount(t) 'cases'
			let at = try start + i otherwise panic("backend: a case past the pool")
			u.asm.movImm(rcx, imm: try f.cases[at].value as FullRangeInt otherwise panic("backend: a case value past the word"))
			u.asm.cmp(rax, right: rcx)
			u.asm.jcc(X64CondCode.equal, label: blockLabel(f.cases[at].target))
		end 'cases'
		self.jumpUnlessNext(ir.switchFallback(t))
	end 'visitSwitch'

	function visitRet(mutates self, f ir.IrFunction, t ir.Term)
		self.get(f, r: rax, v: ir.retValue(t))
		if canThrow 'clear'
			u.asm.bitXor(errorReg, src: errorReg)
		end 'clear'
		u.asm.mov(rsp, src: rbp)
		u.asm.pop(rbp)
		u.asm.ret()
	end 'visitRet'

	function visitThrow(mutates self, f ir.IrFunction, t ir.Term)
		self.get(f, r: errorReg, v: ir.throwErr(t))
		u.asm.bitXor(rax, src: rax)
		u.asm.mov(rsp, src: rbp)
		u.asm.pop(rbp)
		u.asm.ret()
	end 'visitThrow'

	function visitTrap(mutates self, f ir.IrFunction, t ir.Term)
		u.asm.ud2()
	end 'visitTrap'
end 'Codegen'

// bodySymbol is the link name of the body of a closure of the function with the link name enclosing.
function bodySymbol(enclosing String, index Count) returns String
	return "{enclosing}{ast.closureSuffix}{index}"
end 'bodySymbol'

// captureDropSymbol is the link name of the routine that drops what a closure of the body with the link name body owns.
// It starts with a word and a space, as a routine's does, so no function is named like it.
function captureDropSymbol(body String) returns String
	return "captures {body}"
end 'captureDropSymbol'

// ownsCaptures is whether a closure of the body owns a value it captured, which its drop routine then drops.
function ownsCaptures(body ir.IrFunction) returns bool
	for i in 0 upto body.captureOwned.count() 'captures'
		if body.captureOwned[i] 'owned'
			return true
		end 'owned'
	end 'captures'
	return false
end 'ownsCaptures'

// emitFunctionTree writes the code of a function with the link name symbol, and of the bodies of its closures, each with
// the routine that drops what its closure owns, and the tables that they name and the unit does not have yet.
function emitFunctionTree(mutates g Codegen, mutates p ast.Project, f ir.IrFunction, symbol String, instance bool)
	emitFunction(g, p: p, f: f, symbol: symbol, instance: instance)
	let due = exchange(g.due, value: ir.WitnessTableList.create(0))
	for i in 0 upto due.count() 'tables'
		emitTable(g.u, p: p, t: due[i], typeSymbol: typeNameSymbol(p, t: due[i].concrete))
	end 'tables'
	for i in 0 upto f.bodies.count() 'bodies'
		let body = bodySymbol(symbol, index: i)
		emitFunctionTree(g, p: p, f: f.bodies[i], symbol: body, instance: instance)
		if ownsCaptures(f.bodies[i]) 'owns'
			emitCaptureDrop(g.u, p: p, symbol: captureDropSymbol(body), body: f.bodies[i], instance: instance)
		end 'owns'
	end 'bodies'
end 'emitFunctionTree'

// emitFunction writes the code of one function into the unit. The loop is outside the type because the dispatch takes the
// visitor to mutate, which a method cannot give of its own self.
function emitFunction(mutates g Codegen, mutates p ast.Project, f ir.IrFunction, symbol String, instance bool)
	g.prepare(p, f: f)
	g.fnSymbol = symbol.clone()
	g.u.beginSection()
	for _ in 0 upto f.blocks.count() 'labels'
		_ = g.u.asm.newLabel()
	end 'labels'
	g.u.defineFunction(symbol, instance: instance)
	g.u.asm.push(rbp)
	g.u.asm.mov(rbp, src: rsp)
	g.allocateFrame(frameBytes(f))
	g.zeroManagedSlots(f)
	for i in 0 upto f.blocks.count() 'blocks'
		g.u.asm.bind(blockLabel(try i as ir.BlockID otherwise panic("backend: a function has more blocks than any code can name")))
		for k in f.blocks[i].first upto f.blocks[i].endAt 'instrs'
			ir.visitInstr(g, f: f, x: f.instrs[k])
		end 'instrs'
		g.next = ir.noBlock
		if i + 1 < f.blocks.count() 'follows'
			g.next = try (i + 1) as ir.BlockID otherwise panic("backend: a function has more blocks than any code can name")
		end 'follows'
		ir.visitTerm(g, f: f, t: f.blocks[i].term)
	end 'blocks'
end 'emitFunction'

// blockLabel is the label of a block: the labels of a function are made for its blocks first, in order.
function blockLabel(block ir.BlockID) returns LabelID
	return try block as LabelID otherwise panic("backend: a branch to no block")
end 'blockLabel'

// frameOffset is where the word with a 1-based number sits below the frame pointer.
function frameOffset(words Count) returns Imm32
	let bytes = try words * wordBytes otherwise panic("backend: a frame past memory")
	let signed = try bytes as FullRangeInt otherwise panic("backend: a frame past memory")
	return try 0 - signed otherwise panic("backend: a frame past 2 GiB")
end 'frameOffset'

function slotOffset(slot Count) returns Imm32
	return frameOffset(try slot + 1 otherwise panic("backend: a slot past memory"))
end 'slotOffset'

function regOffset(f ir.IrFunction, v ir.Reg) returns Imm32
	let index = try v as Count otherwise panic("backend: a register that is not one")
	let before = try f.slots.count() + index otherwise panic("backend: a register past memory")
	return frameOffset(try before + 1 otherwise panic("backend: a register past memory"))
end 'regOffset'

function paramOffset(f ir.IrFunction, index Count) returns Imm32
	let after = try f.paramCount - 1 - index otherwise panic("backend: a parameter that the function lacks")
	return imm32Of(try paramBase + wordBytes * after otherwise panic("backend: a parameter past memory"))
end 'paramOffset'

// frameBoxOffset is where a frame box starts, below the registers: its words lie upward from there, as a box's do.
function frameBoxOffset(f ir.IrFunction, box Count) returns Imm32
	let below = try f.slots.count() + f.regs.count() + (box + 1) * ifaceBoxWords otherwise panic("backend: a frame box past memory")
	return frameOffset(below)
end 'frameBoxOffset'

function frameBytes(f ir.IrFunction) returns Count
	let words = try f.slots.count() + f.regs.count() + f.frameBoxes * ifaceBoxWords otherwise panic("backend: a frame past memory")
	return try words * wordBytes otherwise panic("backend: a frame past memory")
end 'frameBytes'

// emitModule is the unit with the code of a module's functions.
export function emitModule(mutates p ast.Project, fns ir.IrFunctionList) returns CodeUnit
	var g = Codegen.new()
	for i in 0 upto fns.count() 'each'
		emitFunctionTree(g, p: p, f: fns[i], symbol: ast.funcLinkName(p, fid: fns[i].decl), instance: p.funcs.entries[fns[i].decl as Count].genericOrigin != ast.noFunc)
	end 'each'
	g.u.asm.endLabels()
	return exchange(g.u, value: CodeUnit.new())
end 'emitModule'
