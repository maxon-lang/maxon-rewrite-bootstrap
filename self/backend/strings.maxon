// The selection of Strings (README, "The IR"): a String register of the IR is two virtual registers, the IR register's own
// for the address of its bytes and secondOf for its word, and a String in memory is those two words, the first at the
// place's address. Every helper that moves a value moves both; the rules send each access of a String here.

// secondWordDisp is where the word of a String lies when its first word is at disp.
function secondWordDisp(disp Imm32) returns Imm32
	return try (disp + stringWordOffset) as Imm32 otherwise panic("backend: a String's word past 2 GiB")
end 'secondWordDisp'

// ifaceWordOffset is where the box of an interface value holds the word of a String it holds, and nothing that another
// type's routines read.
let ifaceWordOffset = ifaceValueOffset + stringWordOffset

// literalWord is the word of a literal: its length and its ASCII bit, and no bytes of its own, since they are the
// executable's.
function literalWord(text String) returns FullRangeInt
	var word = try (text.byteLength() shl stringLengthShift) as FullRangeInt otherwise panic("backend: a literal past memory")
	if holdsSimpleBytes(text) 'simple'
		word = word or stringAsciiBit
	end 'simple'
	return word
end 'literalWord'

// holdsSimpleBytes is whether every byte of a text is below 0x80 and none is a carriage return, which a line feed after it
// would make one grapheme cluster with: what a String's ASCII bit says (runtime::bytesAreSimple).
function holdsSimpleBytes(text String) returns bool
	for i in 0 upto text.byteLength() 'bytes'
		if text.byteAt(i) >= asciiLimit or text.byteAt(i) == carriageReturnByte 'other'
			return false
		end 'other'
	end 'bytes'
	return true
end 'holdsSimpleBytes'

// asciiLimit is the first byte that is not ASCII.
let asciiLimit = 0x80 as Byte

let carriageReturnByte = 13 as Byte

extension Selector
	// frameBase is the register the frame's slots are addressed from.
	function frameBase() returns MReg
		return match arch 'arch'
			x64 gives x64PhysReg(rbp)
			arm64 gives arm64PhysReg(arm64FramePointer)
		end 'arch'
	end 'frameBase'

	// slotOffset is where a slot of the IR lies from frameBase.
	function slotOffset(slot Count) returns Imm32
		return match arch 'arch'
			x64 gives slotDisp(slot)
			arm64 gives arm64SlotDisp(slot)
		end 'arch'
	end 'slotOffset'

	// shiftRightInto sets dst to src shifted right by count, zeros coming in.
	function shiftRightInto(mutates self, dst MReg, src MReg, count Count)
		match arch 'arch'
			x64 then self.x64ShiftRightInto(dst, src: src, count: count)
			arm64 then self.arm64ShiftRightInto(dst, src: src, count: count)
		end 'arch'
	end 'shiftRightInto'

	// shiftLeftInto sets dst to src shifted left by count, zeros coming in.
	function shiftLeftInto(mutates self, dst MReg, src MReg, count Count)
		match arch 'arch'
			x64 then self.x64ShiftLeftInto(dst, src: src, count: count)
			arm64 then self.arm64ShiftLeftInto(dst, src: src, count: count)
		end 'arch'
	end 'shiftLeftInto'

	// addInto sets dst to the sum of a and b, which wraps.
	function addInto(mutates self, dst MReg, a MReg, b MReg)
		match arch 'arch'
			x64 then self.target(X64Form.addRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
			arm64 then self.arm64Instr(Arm64Form.addRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
		end 'arch'
	end 'addInto'

	// orInto sets dst to the bits that a or b has set.
	function orInto(mutates self, dst MReg, a MReg, b MReg)
		match arch 'arch'
			x64 then self.target(X64Form.orRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
			arm64 then self.arm64Instr(Arm64Form.orrRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
		end 'arch'
	end 'orInto'

	// orMaskInto sets dst to the bits of src and those mask has set.
	function orMaskInto(mutates self, dst MReg, src MReg, mask FullRangeInt)
		match arch 'arch'
			x64 then self.x64OrMaskInto(dst, src: src, mask: mask)
			arm64 then self.arm64Instr(Arm64Form.orrRegMask, a: dst, b: src, c: noMReg, aux: 0, imm: mask)
		end 'arch'
	end 'orMaskInto'

	// maskInto sets dst to the bits of src that mask has set.
	function maskInto(mutates self, dst MReg, src MReg, mask FullRangeInt)
		match arch 'arch'
			x64 then self.target(chooseAndRegImm(try mask as Imm32 otherwise panic("backend: a mask past 32 bits")), a: dst, b: src, c: noMReg, aux: 0, imm: mask)
			arm64 then self.arm64Instr(Arm64Form.andRegMask, a: dst, b: src, c: noMReg, aux: 0, imm: mask)
		end 'arch'
	end 'maskInto'

	// referAddressInto sets dst to the address that refers names.
	function referAddressInto(mutates self, dst MReg, refers Referent)
		match arch 'arch'
			x64 then self.x64ReferAddressInto(dst, refers: refers)
			arm64 then self.arm64ReferAddressInto(dst, refers: refers)
		end 'arch'
	end 'referAddressInto'

	// loadString loads the String at base plus disp into the IR register r.
	function loadString(mutates self, r ir.Reg, base MReg, disp Imm32)
		self.loadInto(vregOf(r), base: base, disp: disp)
		self.loadInto(self.secondOf(r), base: base, disp: secondWordDisp(disp))
	end 'loadString'

	// storeString stores the String in the IR register r at base plus disp.
	function storeString(mutates self, base MReg, disp Imm32, r ir.Reg)
		self.store(base, disp: disp, src: vregOf(r))
		self.store(base, disp: secondWordDisp(disp), src: self.secondOf(r))
	end 'storeString'

	// storeSecondWord stores the word of a String value in the box that holder holds, whose entry stored its first word at
	// offset: the entries that make a frozen value and a cown take a word, and their boxes have room for two.
	function storeSecondWord(mutates self, f ir.IrFunction, value ir.Reg, holder ir.Reg, offset Count)
		if isStringReg(f, r: value) 'string'
			self.store(vregOf(holder), disp: secondWordDisp(imm32Of(offset)), src: self.secondOf(value))
		end 'string'
	end 'storeSecondWord'

	// storeValue stores the value in the IR register r of f at base plus disp: a word, or a String's two.
	function storeValue(mutates self, base MReg, disp Imm32, r ir.Reg, f ir.IrFunction)
		if isStringReg(f, r: r) 'string'
			self.storeString(base, disp: disp, r: r)
			return
		end 'string'
		self.store(base, disp: disp, src: vregOf(r))
	end 'storeValue'

	// emptyString leaves the String at base plus disp empty: 0 and 0, which owns nothing.
	function emptyString(mutates self, base MReg, disp Imm32)
		self.storeImm(base, disp: disp, value: 0)
		self.storeImm(base, disp: secondWordDisp(disp), value: 0)
	end 'emptyString'

	// dropPlace drops the value of type ty at base plus disp, a String's two words or a word, and leaves the place empty.
	function dropPlace(mutates self, base MReg, disp Imm32, ty ast.TypeID)
		let value = self.load(base, disp: disp)
		self.storeImm(base, disp: disp, value: 0)
		self.addArg(value, float: false)
		if ty == stringTy 'string'
			let word = self.load(base, disp: secondWordDisp(disp))
			self.storeImm(base, disp: secondWordDisp(disp), value: 0)
			self.addArg(word, float: false)
		end 'string'
		self.callSymbol(u.needed.lookup(RoutineKind.dropRoutine, ty: ty))
	end 'dropPlace'
end 'Selector'

// valueWordsOf is how many words the value in the IR register r of f takes in memory.
function valueWordsOf(f ir.IrFunction, r ir.Reg) returns Count
	if isStringReg(f, r: r) 'string'
		return stringValueBytes / wordBytes
	end 'string'
	return 1
end 'valueWordsOf'

// emitStringConst is the empty String, the only constant a String register is given: a slot read before its first store.
function emitStringConst(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	if ir.constValue(ins) != 0 'value'
		panic("backend: a String register given a constant other than the empty place")
	end 'value'
	sel.constantInto(vregOf(ins.dst), value: 0)
	sel.constantInto(sel.secondOf(ins.dst), value: 0)
end 'emitStringConst'

// emitStr is a literal: the address of its bytes in the executable and its word, both known before the program runs.
function emitStr(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let refers = sel.textRef(fn, ins: ins)
	sel.referAddressInto(vregOf(ins.dst), refers: refers)
	sel.constantInto(sel.secondOf(ins.dst), value: literalWord(ir.strText(fn, x: ins)))
end 'emitStr'

// emitStringView is a view of a String's bytes, rt.str.view's (text, from, length) with its bounds checked before: the
// address of the byte at from, and a word of the length, the text's ASCII bit and the view bit, which owns no bytes. It
// reads no memory and makes no call, so a slice costs a few instructions.
function emitStringView(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let start = ir.callRuntimeArgsStart(ins)
	let text = fn.args[start]
	let from = vregOf(fn.args[nextCount(start)])
	let length = vregOf(fn.args[try start + 2 otherwise panic("backend: an argument past the pool")])
	let bytes = sel.resultOf(ins.dst)
	sel.addInto(bytes, a: vregOf(text), b: from)
	let ascii = sel.newTemp()
	sel.maskInto(ascii, src: sel.secondOf(text), mask: stringAsciiBit)
	let shifted = sel.newTemp()
	sel.shiftLeftInto(shifted, src: length, count: stringLengthShift)
	let flags = sel.newTemp()
	sel.orInto(flags, a: shifted, b: ascii)
	sel.orMaskInto(sel.secondOf(ins.dst), src: flags, mask: stringViewBit)
end 'emitStringView'

// emitStringLength is the length a String's word holds, which reads no memory.
function emitStringLength(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	let word = sel.secondOf(ir.lengthSrc(ins))
	sel.shiftRightInto(result, src: word, count: stringLengthShift)
end 'emitStringLength'

// emitStringElemLoad reads a String element of an array whose bounds check has passed.
function emitStringElemLoad(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let data = sel.load(vregOf(ir.elemLoadArr(ins)), disp: imm32Of(arrayDataOffset))
	let at = sel.elementAddress(data, index: vregOf(ir.elemLoadIndex(ins)), shift: ir.elemLoadShift(ins))
	sel.loadString(ins.dst, base: at, disp: 0)
end 'emitStringElemLoad'

// emitStringElemAt reads a String element of a buffer that a Buffer read gave, whose bounds check has passed.
function emitStringElemAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = sel.elementAddress(vregOf(ir.elemAtData(ins)), index: vregOf(ir.elemAtIndex(ins)), shift: ir.elemAtShift(ins))
	sel.loadString(ins.dst, base: at, disp: 0)
end 'emitStringElemAt'

function emitStrPtr(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	sel.copy(result, src: vregOf(ir.strPtrSrc(ins)))
end 'emitStrPtr'

function emitStrWord(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	let word = sel.secondOf(ir.strWordSrc(ins))
	sel.copy(result, src: word)
end 'emitStrWord'

function emitStrMake(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.copy(vregOf(ins.dst), src: vregOf(ir.strMakeBytes(ins)))
	sel.copy(sel.secondOf(ins.dst), src: vregOf(ir.strMakeWord(ins)))
end 'emitStrMake'

function emitStringLoadSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.loadString(ins.dst, base: sel.frameBase(), disp: sel.slotOffset(ir.loadSlotSlot(ins)))
end 'emitStringLoadSlot'

function emitStringStoreSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.storeString(sel.frameBase(), disp: sel.slotOffset(ir.storeSlotSlot(ins)), r: ir.storeSlotSrc(ins))
end 'emitStringStoreSlot'

function emitStringMoveSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let disp = sel.slotOffset(ir.moveSlotSlot(ins))
	sel.loadString(ins.dst, base: sel.frameBase(), disp: disp)
	sel.emptyString(sel.frameBase(), disp: disp)
end 'emitStringMoveSlot'

function emitStringLoadField(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.loadString(ins.dst, base: vregOf(ir.loadFieldObj(ins)), disp: imm32Of(ir.loadFieldOffset(ins)))
end 'emitStringLoadField'

function emitStringStoreField(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.storeString(vregOf(ir.storeFieldObj(ins)), disp: imm32Of(ir.storeFieldOffset(ins)), r: ir.storeFieldSrc(ins))
end 'emitStringStoreField'

function emitStringLoadAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.loadString(ins.dst, base: vregOf(ir.loadAtAddr(ins)), disp: 0)
end 'emitStringLoadAt'

function emitStringStoreAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.storeString(vregOf(ir.storeAtAddr(ins)), disp: 0, r: ir.storeAtSrc(ins))
end 'emitStringStoreAt'

function emitStringMoveAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = vregOf(ir.moveAtAddr(ins))
	sel.loadString(ins.dst, base: at, disp: 0)
	sel.emptyString(at, disp: 0)
end 'emitStringMoveAt'
