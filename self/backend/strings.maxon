// The selection of Strings (README, "The IR"): a String register of the IR is two virtual registers, the IR register's own
// for the address of its bytes and secondOf for its word, and a String in memory is those two words, the first at the
// place's address. Every helper that moves a value moves both; the rules send each access of a String here.

// secondWordDisp is where the word of a String lies when its first word is at disp.
function secondWordDisp(disp Imm32) returns Imm32
	return try (disp + stringWordOffset) as Imm32 otherwise panic("backend: a String's word past 2 GiB")
end 'secondWordDisp'

// ifaceWordOffset is where the box of an interface value holds the word of a String it holds, and nothing that another
// type's routines read.
let ifaceWordOffset = ifaceValueOffset + stringWordOffset

// literalWord is the word of a literal: its length and its ASCII bit, and no bytes of its own, since they are the
// executable's.
function literalWord(text String) returns FullRangeInt
	var word = try (text.byteLength() shl stringLengthShift) as FullRangeInt otherwise panic("backend: a literal past memory")
	if holdsSimpleBytes(text) 'simple'
		word = word or stringAsciiBit
	end 'simple'
	return word
end 'literalWord'

// inlineTextWord is the count bytes of a literal's text from from, as the words of a String that holds them hold them, the
// first lowest: in its first word, or in its second above the flags.
function inlineTextWord(text String, from Count, count Count) returns FullRangeInt
	var bits = 0 as Count
	var shift = 0 as Count
	if from > 0 'second'
		shift = stringLengthShift
	end 'second'
	let until = try from + count otherwise panic("backend: a character past memory")
	for i in from upto until 'bytes'
		if i < text.byteLength() 'byte'
			bits = bits or (try (text.byteAt(i) as Count) shl shift otherwise panic("backend: a byte past its word"))
		end 'byte'
		shift = try shift + bitsPerByte otherwise panic("backend: a byte past its word")
	end 'bytes'
	return ir.wordOfBits(bits)
end 'inlineTextWord'

// holdsSimpleBytes is whether every byte of a text is below 0x80 and none is a carriage return, which a line feed after it
// would make one grapheme cluster with: what a String's ASCII bit says (runtime::bytesAreSimple).
function holdsSimpleBytes(text String) returns bool
	for i in 0 upto text.byteLength() 'bytes'
		if text.byteAt(i) >= asciiLimit or text.byteAt(i) == carriageReturnByte 'other'
			return false
		end 'other'
	end 'bytes'
	return true
end 'holdsSimpleBytes'

// asciiLimit is the first byte that is not ASCII.
let asciiLimit = 0x80 as Byte

let carriageReturnByte = 13 as Byte

extension Selector
	// frameBase is the register the frame's slots are addressed from.
	function frameBase() returns MReg
		return match arch 'arch'
			x64 gives x64PhysReg(rbp)
			arm64 gives arm64PhysReg(arm64FramePointer)
		end 'arch'
	end 'frameBase'

	// slotOffset is where a slot of the IR lies from frameBase.
	function slotOffset(slot Count) returns Imm32
		return match arch 'arch'
			x64 gives slotDisp(slot)
			arm64 gives arm64SlotDisp(slot)
		end 'arch'
	end 'slotOffset'

	// shiftRightInto sets dst to src shifted right by count, zeros coming in.
	function shiftRightInto(mutates self, dst MReg, src MReg, count Count)
		match arch 'arch'
			x64 then self.x64ShiftRightInto(dst, src: src, count: count)
			arm64 then self.arm64ShiftRightInto(dst, src: src, count: count)
		end 'arch'
	end 'shiftRightInto'

	// shiftLeftInto sets dst to src shifted left by count, zeros coming in.
	function shiftLeftInto(mutates self, dst MReg, src MReg, count Count)
		match arch 'arch'
			x64 then self.x64ShiftLeftInto(dst, src: src, count: count)
			arm64 then self.arm64ShiftLeftInto(dst, src: src, count: count)
		end 'arch'
	end 'shiftLeftInto'

	// addInto sets dst to the sum of a and b, which wraps.
	function addInto(mutates self, dst MReg, a MReg, b MReg)
		match arch 'arch'
			x64 then self.target(X64Form.addRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
			arm64 then self.arm64Instr(Arm64Form.addRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
		end 'arch'
	end 'addInto'

	// orInto sets dst to the bits that a or b has set.
	function orInto(mutates self, dst MReg, a MReg, b MReg)
		match arch 'arch'
			x64 then self.target(X64Form.orRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
			arm64 then self.arm64Instr(Arm64Form.orrRegReg, a: dst, b: a, c: b, aux: 0, imm: 0)
		end 'arch'
	end 'orInto'

	// orMaskInto sets dst to the bits of src and those mask has set.
	function orMaskInto(mutates self, dst MReg, src MReg, mask FullRangeInt)
		match arch 'arch'
			x64 then self.x64OrMaskInto(dst, src: src, mask: mask)
			arm64 then self.arm64Instr(Arm64Form.orrRegMask, a: dst, b: src, c: noMReg, aux: 0, imm: mask)
		end 'arch'
	end 'orMaskInto'

	// maskInto sets dst to the bits of src that mask has set.
	function maskInto(mutates self, dst MReg, src MReg, mask FullRangeInt)
		match arch 'arch'
			x64 then self.target(chooseAndRegImm(try mask as Imm32 otherwise panic("backend: a mask past 32 bits")), a: dst, b: src, c: noMReg, aux: 0, imm: mask)
			arm64 then self.arm64Instr(Arm64Form.andRegMask, a: dst, b: src, c: noMReg, aux: 0, imm: mask)
		end 'arch'
	end 'maskInto'

	// referAddressInto sets dst to the address that refers names.
	function referAddressInto(mutates self, dst MReg, refers Referent)
		match arch 'arch'
			x64 then self.x64ReferAddressInto(dst, refers: refers)
			arm64 then self.arm64ReferAddressInto(dst, refers: refers)
		end 'arch'
	end 'referAddressInto'

	// loadString loads the String at base plus disp into the IR register r.
	function loadString(mutates self, r ir.Reg, base MReg, disp Imm32)
		self.loadInto(vregOf(r), base: base, disp: disp)
		self.loadInto(self.secondOf(r), base: base, disp: secondWordDisp(disp))
	end 'loadString'

	// storeString stores the String in the IR register r at base plus disp.
	function storeString(mutates self, base MReg, disp Imm32, r ir.Reg)
		self.store(base, disp: disp, src: vregOf(r))
		self.store(base, disp: secondWordDisp(disp), src: self.secondOf(r))
	end 'storeString'

	// storeSecondWord stores the word of a String value in the box that holder holds, whose entry stored its first word at
	// offset: the entries that make a frozen value and a cown take a word, and their boxes have room for two.
	function storeSecondWord(mutates self, f ir.IrFunction, value ir.Reg, holder ir.Reg, offset Count)
		if isStringReg(f, r: value) 'string'
			self.store(vregOf(holder), disp: secondWordDisp(imm32Of(offset)), src: self.secondOf(value))
		end 'string'
	end 'storeSecondWord'

	// storeValue stores the value in the IR register r of f at base plus disp: a word, or a String's two.
	function storeValue(mutates self, base MReg, disp Imm32, r ir.Reg, f ir.IrFunction)
		if isStringReg(f, r: r) 'string'
			self.storeString(base, disp: disp, r: r)
			return
		end 'string'
		self.store(base, disp: disp, src: vregOf(r))
	end 'storeValue'

	// emptyString leaves the String at base plus disp empty: 0 and 0, which owns nothing.
	function emptyString(mutates self, base MReg, disp Imm32)
		self.storeImm(base, disp: disp, value: 0)
		self.storeImm(base, disp: secondWordDisp(disp), value: 0)
	end 'emptyString'

	// dropPlace drops the value of type ty at base plus disp, a String's two words or a word, and leaves the place empty.
	function dropPlace(mutates self, base MReg, disp Imm32, ty ast.TypeID)
		let value = self.load(base, disp: disp)
		self.storeImm(base, disp: disp, value: 0)
		self.addArg(value, float: false)
		if ty == stringTy or ty == characterTy 'string'
			let word = self.load(base, disp: secondWordDisp(disp))
			self.storeImm(base, disp: secondWordDisp(disp), value: 0)
			self.addArg(word, float: false)
		end 'string'
		self.callSymbol(u.needed.lookup(RoutineKind.dropRoutine, ty: ty))
	end 'dropPlace'
end 'Selector'

// valueWordsOf is how many words the value in the IR register r of f takes in memory.
function valueWordsOf(f ir.IrFunction, r ir.Reg) returns Count
	if isStringReg(f, r: r) 'string'
		return stringValueBytes / wordBytes
	end 'string'
	return 1
end 'valueWordsOf'

// emitStringConst is the empty String, the only constant a String register is given: a slot read before its first store.
function emitStringConst(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	if ir.constValue(ins) != 0 'value'
		panic("backend: a String register given a constant other than the empty place")
	end 'value'
	sel.constantInto(vregOf(ins.dst), value: 0)
	sel.constantInto(sel.secondOf(ins.dst), value: 0)
end 'emitStringConst'

// emitStr is a literal: the address of its bytes in the executable and its word, both known before the program runs. A
// literal of few enough bytes, a String's or a Character's, is the two words that hold them (runtime/inline.maxon), loaded
// from a constant of their own: an address and two loads where the moves of the words would take up to eight instructions.
function emitStr(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	if holdsInline(ir.strText(fn, x: ins)) 'inline'
		let text = ir.strText(fn, x: ins)
		let first = ir.bitsOfWord(inlineTextWord(text, from: 0 as Count, count: wordBytes) as ir.Word)
		let second = ir.bitsOfWord(inlineStringWord(text) as ir.Word)
		let offset = sel.u.data.inlineOffset(text, first: first, second: second)
		sel.loadDataWords(vregOf(ins.dst), high: sel.secondOf(ins.dst), offset: offset)
		return
	end 'inline'
	let refers = sel.textRef(fn, ins: ins)
	sel.referAddressInto(vregOf(ins.dst), refers: refers)
	sel.constantInto(sel.secondOf(ins.dst), value: literalWord(ir.strText(fn, x: ins)))
end 'emitStr'

// emitStringView is a view of a String's bytes, rt.str.view's (text, from, length) with its bounds checked before: the
// address of the byte at from, and a word of the length, the text's ASCII bit and the view bit, which owns no bytes. It
// reads no memory and makes no call, so a slice costs a few instructions.
// A view of at most stringInlineBytes bytes, or of a String that holds its bytes in its words, is a String that holds them
// in its own, which runtime::stringView makes.
function emitStringView(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let start = ir.callRuntimeArgsStart(ins)
	let text = fn.args[start]
	let from = vregOf(fn.args[nextCount(start)])
	let length = vregOf(fn.args[try start + 2 otherwise panic("backend: an argument past the pool")])
	let small = sel.mir.addBlock()
	let done = sel.mir.addBlock()
	sel.compareWith(length, value: stringInlineBytes as ir.Word)
	sel.branchTo(MCond.belowEqual, block: small)
	sel.branchIfInline(sel.secondOf(text), block: small)
	let bytes = sel.newTemp()
	sel.addInto(bytes, a: vregOf(text), b: from)
	let ascii = sel.newTemp()
	sel.maskInto(ascii, src: sel.secondOf(text), mask: stringAsciiBit)
	let shifted = sel.newTemp()
	sel.shiftLeftInto(shifted, src: length, count: stringLengthShift)
	let flags = sel.newTemp()
	sel.orInto(flags, a: shifted, b: ascii)
	let word = sel.newTemp()
	sel.orMaskInto(word, src: flags, mask: stringViewBit)
	sel.args.clear()
	sel.args.push(bytes)
	sel.args.push(word)
	sel.jumpTo(done)
	sel.mir.writeBlock(small)
	sel.addWords(fn, start: start, count: ir.callRuntimeArgsCount(ins))
	sel.callSymbol(ir.rtSymbol(ir.Rt.rtStrView))
	let first = sel.newTemp()
	sel.copy(first, src: physOfNumber(internalResultOf(sel.arch)))
	let second = sel.newTemp()
	sel.copy(second, src: physOfNumber(internalSecondResultOf(sel.arch)))
	sel.args.clear()
	sel.args.push(first)
	sel.args.push(second)
	sel.jumpTo(done)
	sel.mir.writeBlock(done)
	sel.addParamOf(ins.dst)
end 'emitStringView'

// emitStringLength is the length a String's word holds, which reads no memory.
function emitStringLength(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	sel.stringLengthInto(result, word: sel.secondOf(ir.lengthSrc(ins)))
end 'emitStringLength'

// emitStringElemLoad reads a String element of an array whose bounds check has passed.
function emitStringElemLoad(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let data = sel.load(vregOf(ir.elemLoadArr(ins)), disp: imm32Of(arrayDataOffset))
	let at = sel.elementAddress(data, index: vregOf(ir.elemLoadIndex(ins)), shift: ir.elemLoadShift(ins))
	sel.loadString(ins.dst, base: at, disp: 0)
end 'emitStringElemLoad'

// emitStringElemAt reads a String element of a buffer that a Buffer read gave, whose bounds check has passed.
function emitStringElemAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = sel.elementAddress(vregOf(ir.elemAtData(ins)), index: vregOf(ir.elemAtIndex(ins)), shift: ir.elemAtShift(ins))
	sel.loadString(ins.dst, base: at, disp: 0)
end 'emitStringElemAt'

// emitStrBytes is the address of the first byte of a String: its first word, or, where it holds its bytes in its words,
// the frame box the instruction names, which they are written to in order: the first word, then the bytes of the second.
function emitStrBytes(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let text = ir.strBytesSrc(ins)
	let word = sel.secondOf(text)
	let held = sel.mir.addBlock()
	let done = sel.mir.addBlock()
	sel.branchIfInline(word, block: held)
	sel.jumpWith(done, value: vregOf(text))
	sel.mir.writeBlock(held)
	let disp = sel.frameBoxAt(fn, box: ir.strBytesBox(ins))
	sel.store(sel.frameBase(), disp: disp, src: vregOf(text))
	let rest = sel.newTemp()
	sel.bitFieldInto(rest, src: word, lsb: stringLengthShift, width: stringCountShift - stringLengthShift)
	sel.store(sel.frameBase(), disp: secondWordDisp(disp), src: rest)
	let at = sel.newTemp()
	sel.frameAddressInto(at, disp: disp)
	sel.jumpWith(done, value: at)
	sel.join(done, r: ins.dst)
end 'emitStrBytes'

// emitStringLoadByte is the byte at an index of a String, its bounds checked before: a load where its bytes are elsewhere,
// and the byte shifted out of its words where it holds them there.
function emitStringLoadByte(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let text = ir.loadByteSrc(ins)
	let index = vregOf(ir.loadByteIndex(ins))
	let held = sel.mir.addBlock()
	let done = sel.mir.addBlock()
	sel.branchIfInline(sel.secondOf(text), block: held)
	let byte = sel.loadIndexedByte(vregOf(text), index: index, disp: 0)
	sel.jumpWith(done, value: byte)
	sel.mir.writeBlock(held)
	let result = sel.newTemp()
	sel.inlineByteInto(result, text: text, index: index)
	sel.jumpWith(done, value: result)
	sel.join(done, r: ins.dst)
end 'emitStringLoadByte'

function emitStrPtr(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	sel.copy(result, src: vregOf(ir.strPtrSrc(ins)))
end 'emitStrPtr'

function emitStrWord(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	let word = sel.secondOf(ir.strWordSrc(ins))
	sel.copy(result, src: word)
end 'emitStrWord'

function emitStrMake(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.copy(vregOf(ins.dst), src: vregOf(ir.strMakeBytes(ins)))
	sel.copy(sel.secondOf(ins.dst), src: vregOf(ir.strMakeWord(ins)))
end 'emitStrMake'

function emitStringLoadSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.loadString(ins.dst, base: sel.frameBase(), disp: sel.slotOffset(ir.loadSlotSlot(ins)))
end 'emitStringLoadSlot'

function emitStringStoreSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.storeString(sel.frameBase(), disp: sel.slotOffset(ir.storeSlotSlot(ins)), r: ir.storeSlotSrc(ins))
end 'emitStringStoreSlot'

function emitStringMoveSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let disp = sel.slotOffset(ir.moveSlotSlot(ins))
	sel.loadString(ins.dst, base: sel.frameBase(), disp: disp)
	sel.emptyString(sel.frameBase(), disp: disp)
end 'emitStringMoveSlot'

function emitStringLoadField(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.loadString(ins.dst, base: vregOf(ir.loadFieldObj(ins)), disp: imm32Of(ir.loadFieldOffset(ins)))
end 'emitStringLoadField'

function emitStringStoreField(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.storeString(vregOf(ir.storeFieldObj(ins)), disp: imm32Of(ir.storeFieldOffset(ins)), r: ir.storeFieldSrc(ins))
end 'emitStringStoreField'

function emitStringLoadAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.loadString(ins.dst, base: vregOf(ir.loadAtAddr(ins)), disp: 0)
end 'emitStringLoadAt'

function emitStringStoreAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.storeString(vregOf(ir.storeAtAddr(ins)), disp: 0, r: ir.storeAtSrc(ins))
end 'emitStringStoreAt'

function emitStringMoveAt(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = vregOf(ir.moveAtAddr(ins))
	sel.loadString(ins.dst, base: at, disp: 0)
	sel.emptyString(at, disp: 0)
end 'emitStringMoveAt'

// wordBits is how many bits a word has.
let wordBits = 64 as Count

// byteShiftBits is how far an index of a byte is shifted to the count of bits before it, and byteValueMask keeps a byte.
let byteShiftBits = 3 as Count

let byteValueMask = 255 as FullRangeInt

// inlineStringWord is the second word of a String literal of few enough bytes to hold them in its words: the bytes after
// the eighth above the flags, the ASCII bit where it applies, their count and the bit that says so.
function inlineStringWord(text String) returns FullRangeInt
	var word = inlineTextWord(text, from: wordBytes, count: stringInlineBytes - wordBytes)
	word = word or (ir.wordOfBits((1 shl stringInlineShift) or (try text.byteLength() shl stringCountShift otherwise panic("backend: a literal longer than its words hold"))) as FullRangeInt)
	if holdsSimpleBytes(text) 'simple'
		word = word or stringAsciiBit
	end 'simple'
	return word
end 'inlineStringWord'

// holdsInline is whether a String of these bytes holds them in its two words.
function holdsInline(text String) returns bool
	return text.byteLength() > 0 and text.byteLength() <= stringInlineBytes
end 'holdsInline'

// A String of at most stringInlineBytes bytes holds them in its two words (runtime/inline.maxon): its word has the bit at
// stringInlineShift, their count under it, and the bytes after the eighth under that, above the flags, which are clear.
extension Selector
	// bitFieldInto sets dst to the width bits of src from lsb up, moved down to the bottom.
	function bitFieldInto(mutates self, dst MReg, src MReg, lsb Count, width Count)
		let top = try lsb + width - 1 otherwise panic("backend: a bit field past the word")
		if arch == ast.TargetArch.arm64 'arm64'
			self.arm64Instr(Arm64Form.ubfmRegReg, a: dst, b: src, c: noMReg, aux: try top as Imm32 otherwise panic("backend: a bit field past the word"), imm: try lsb as FullRangeInt otherwise panic("backend: a bit field past the word"))
			return
		end 'arm64'
		let up = self.newTemp()
		self.shiftLeftInto(up, src: src, count: try wordBits - 1 - top otherwise panic("backend: a bit field past the word"))
		self.shiftRightInto(dst, src: up, count: try wordBits - width otherwise panic("backend: a bit field past the word"))
	end 'bitFieldInto'

	// branchIfZero goes to block where r is 0: cbz on arm64.
	function branchIfZero(mutates self, r MReg, block MBlockID)
		if arch == ast.TargetArch.arm64 'arm64'
			args.clear()
			let edge = mir.addEdge(block, args: args)
			var x = newArm64Target(Arm64Form.cbz, a: r, b: noMReg, c: noMReg, aux: 0, imm: 0)
			x.ref = MRef.edge
			x.aux = edge
			mir.emit(x)
			let next = mir.addBlock()
			self.jumpTo(next)
			mir.writeBlock(next)
			return
		end 'arm64'
		self.compareWith(r, value: 0)
		self.branchTo(MCond.equal, block: block)
	end 'branchIfZero'

	// branchIfInline goes to block where the String of the word holds its bytes in its words: its word is negative.
	function branchIfInline(mutates self, word MReg, block MBlockID)
		self.compareWith(word, value: 0)
		self.branchTo(MCond.less, block: block)
	end 'branchIfInline'

	// stringLengthInto sets dst to the length a String's word holds: the word shifted down past the flags, or the count of
	// the bytes it holds in its words, chosen with no branch.
	function stringLengthInto(mutates self, dst MReg, word MReg)
		let held = self.newTemp()
		self.bitFieldInto(held, src: word, lsb: stringCountShift, width: stringInlineShift - stringCountShift)
		let length = self.newTemp()
		self.shiftRightInto(length, src: word, count: stringLengthShift)
		self.compareWith(word, value: 0)
		self.selectInto(dst, cond: MCond.less, chosen: held, other: length)
	end 'stringLengthInto'

	// selectInto sets dst to chosen where the flags say cond, and to other else: csel on arm64, cmov on x64.
	function selectInto(mutates self, dst MReg, cond MCond, chosen MReg, other MReg)
		if arch == ast.TargetArch.arm64 'arm64'
			var x = newArm64Conditional(Arm64Form.cselRegReg, cond: cond, a: dst, ref: MRef.none, aux: 0)
			x.b = chosen
			x.c = other
			self.emit(x)
			return
		end 'arm64'
		var x = newConditional(X64Form.cmovccRegReg, cond: cond, a: dst, ref: MRef.none, aux: 0)
		x.b = other
		x.c = chosen
		self.emit(x)
	end 'selectInto'

	// shiftRightByInto sets dst to src shifted right by the register by, zeros coming in, the count taken modulo the word.
	function shiftRightByInto(mutates self, dst MReg, src MReg, by MReg)
		if arch == ast.TargetArch.arm64 'arm64'
			self.arm64Instr(Arm64Form.lsrvRegReg, a: dst, b: src, c: by, aux: 0, imm: 0)
			return
		end 'arm64'
		self.copy(x64PhysReg(rcx), src: by)
		self.target(X64Form.shrRegCl, a: dst, b: src, c: noMReg, aux: 0, imm: 0)
	end 'shiftRightByInto'

	// inlineByteInto sets dst to the byte at an index of a String that holds its bytes in its words, below their count:
	// each word shifted down by the index's bytes, the shift taken modulo the word, and the one the index is in.
	function inlineByteInto(mutates self, dst MReg, text ir.Reg, index MReg)
		let shift = self.newTemp()
		self.shiftLeftInto(shift, src: index, count: byteShiftBits)
		let rest = self.newTemp()
		self.bitFieldInto(rest, src: self.secondOf(text), lsb: stringLengthShift, width: stringCountShift - stringLengthShift)
		let low = self.newTemp()
		self.shiftRightByInto(low, src: vregOf(text), by: shift)
		let high = self.newTemp()
		self.shiftRightByInto(high, src: rest, by: shift)
		self.compareWith(index, value: wordBytes as ir.Word)
		let picked = self.newTemp()
		self.selectInto(picked, cond: MCond.below, chosen: low, other: high)
		self.maskInto(dst, src: picked, mask: byteValueMask)
	end 'inlineByteInto'

	// loadDataWords loads the two words at an offset of the unit's data into low and high: two loads relative to the
	// instruction pointer on x64, and the address and two loads on arm64.
	function loadDataWords(mutates self, low MReg, high MReg, offset Count)
		if arch == ast.TargetArch.arm64 'arm64'
			let at = self.newTemp()
			self.referAddressInto(at, refers: Referent.make(MRef.data, aux: imm32Of(offset)))
			self.loadInto(low, base: at, disp: 0)
			self.loadInto(high, base: at, disp: imm32Of(wordBytes))
			return
		end 'arm64'
		self.referring(X64Form.loadRegRip, a: low, refers: Referent.make(MRef.data, aux: imm32Of(offset)))
		self.referring(X64Form.loadRegRip, a: high, refers: Referent.make(MRef.data, aux: imm32Of(try offset + wordBytes otherwise panic("backend: a constant past memory"))))
	end 'loadDataWords'

	// frameBoxAt is where a frame box of f lies from frameBase.
	function frameBoxAt(f ir.IrFunction, box Count) returns Imm32
		return match arch 'arch'
			x64 gives frameBoxDisp(f, box: box)
			arm64 gives arm64FrameBoxDisp(f, box: box)
		end 'arch'
	end 'frameBoxAt'

	// frameAddressInto sets dst to frameBase plus disp.
	function frameAddressInto(mutates self, dst MReg, disp Imm32)
		if arch == ast.TargetArch.arm64 'arm64'
			let at = self.arm64AddConst(arm64PhysReg(arm64FramePointer), value: disp as FullRangeInt)
			self.copy(dst, src: at)
			return
		end 'arm64'
		self.target(X64Form.leaRegBaseDisp, a: dst, b: x64PhysReg(rbp), c: noMReg, aux: disp, imm: 0)
	end 'frameAddressInto'
end 'Selector'
