// x64's register file and calling conventions, and the constraints of its machine instructions: what the target-
// independent machine IR, the allocator and the encoder ask of a form. The constraints of each form are generated from
// the instruction table (x64_gen.maxon); this file adds the pseudo-instructions' and the conventions' part.

// pseudoForm is the form field of a pseudo-instruction, which nothing reads.
let pseudoForm = X64Form.ud2

// unusedCond is the condition of an instruction that has none, which nothing reads.
let unusedCond = X64CondCode.overflow

export function physReg(r X64Register) returns MReg
	return try r.rawValue as MReg otherwise panic("backend: a register past an operand")
end 'physReg'

function regNumOf(r X64Register) returns RegNum
	return try r.rawValue as RegNum otherwise panic("backend: a register past the register file")
end 'regNumOf'

function regMaskOf(r X64Register) returns RegMask
	return regBit(regNumOf(r))
end 'regMaskOf'

// classMask is every register of a class.
function classMask(class RegClass) returns RegMask
	let gprs = regBit(try x64FirstVector as RegNum otherwise panic("backend: a register file past a mask")) - 1
	let file = regBit(try x64RegisterFileSize as RegNum otherwise panic("backend: a register file past a mask")) - 1
	return match class 'class'
		gpr gives gprs
		xmm gives file and not gprs
	end 'class'
end 'classMask'

// reservedMask are the registers that hold the stack and the frame, which no value is given.
function reservedMask() returns RegMask
	return regMaskOf(X64Register.rsp) or regMaskOf(X64Register.rbp)
end 'reservedMask'

// allocatable is the registers of a class that a value may be given.
export function allocatable(class RegClass) returns RegMask
	return classMask(class) and not reservedMask()
end 'allocatable'

export function classOfNumber(number RegNum) returns RegClass
	if number < x64FirstVector 'general'
		return RegClass.gpr
	end 'general'
	return RegClass.xmm
end 'classOfNumber'

// generalRegister is the general register a physical operand names.
function generalRegister(r MReg) returns X64Register
	let number = physicalNumber(r)
	if number >= x64FirstVector 'vector'
		panic("backend: a general operand in an xmm register")
	end 'vector'
	return x64RegisterOf(number)
end 'generalRegister'

// ConventionKind is the calling convention of a call: the compiler's own for Maxon functions, Win64 for a DLL import.
enum ConventionKind
	internal
	win64
end 'ConventionKind'

// CallConvention is where a convention passes values and what a call keeps. Arguments that are not in args go on the
// stack, pushed in order.
type CallConvention
	export var args as MRegList
	export var result as RegNum
	export var error as RegNum
	// clobbered are the registers a call leaves holding nothing, and calleeSaved the ones it keeps.
	export var clobbered as RegMask
	export var calleeSaved as RegMask

	static function make(consumes args MRegList, result RegNum, error RegNum, calleeSaved RegMask) returns CallConvention
		let all = allocatable(RegClass.gpr) or allocatable(RegClass.xmm)
		return CallConvention{args: args, result: result, error: error, clobbered: all and not calleeSaved, calleeSaved: calleeSaved}
	end 'make'
end 'CallConvention'

// conventionOf is a convention's table. The internal one is today's: every argument on the stack, the result in rax
// and the error in rdx, and nothing kept, so a value lives across a call only in the frame.
function conventionOf(kind ConventionKind) returns CallConvention
	return match kind 'kind'
		internal gives CallConvention.make(MRegList.create(0), result: regNumOf(X64Register.rax), error: regNumOf(X64Register.rdx), calleeSaved: 0)
		win64 gives CallConvention.make(win64Args(), result: regNumOf(X64Register.rax), error: regNumOf(X64Register.rdx), calleeSaved: win64CalleeSaved())
	end 'kind'
end 'conventionOf'

function win64Args() returns MRegList
	var args = MRegList.create(0)
	args.push(physReg(X64Register.rcx))
	args.push(physReg(X64Register.rdx))
	args.push(physReg(X64Register.r8))
	args.push(physReg(X64Register.r9))
	return args
end 'win64Args'

// win64FirstKeptXmm is the first xmm register a Win64 callee keeps: xmm6 to xmm15 survive a call.
let win64FirstKeptXmm = 6

function win64CalleeSaved() returns RegMask
	var kept = regMaskOf(X64Register.rbx) or regMaskOf(X64Register.rsi) or regMaskOf(X64Register.rdi)
	kept = kept or regMaskOf(X64Register.r12) or regMaskOf(X64Register.r13) or regMaskOf(X64Register.r14) or regMaskOf(X64Register.r15)
	let firstKept = try (x64FirstVector + win64FirstKeptXmm) as RegNum otherwise panic("backend: a register file past a mask")
	return kept or (classMask(RegClass.xmm) and not (regBit(firstKept) - 1))
end 'win64CalleeSaved'

// Conventions are the tables of both conventions, which the allocator makes once.
type Conventions
	export var internal as CallConvention
	export var win64 as CallConvention

	static function make() returns Conventions
		return Conventions{internal: conventionOf(ConventionKind.internal), win64: conventionOf(ConventionKind.win64)}
	end 'make'
end 'Conventions'

// callConvention is the convention of a call instruction: a call through an import's slot is a DLL's.
function callConvention(x MInstr) returns ConventionKind
	if x.ref == MRef.importSlot 'import'
		return ConventionKind.win64
	end 'import'
	return ConventionKind.internal
end 'callConvention'

// isUnconditionalJump is whether a branch along an edge always takes it, so the edge's copies can go before it.
function isUnconditionalJump(x MInstr) returns bool
	return x.kind == MKind.target and x.form == X64Form.jmpRel32
end 'isUnconditionalJump'

// trivialScratch are the registers the trivial allocator moves values through: no form and no convention fixes them,
// and nothing lives in them across an instruction.
function trivialScratch(index Count) returns MReg
	if index == 0 'first'
		return physReg(X64Register.r10)
	end 'first'
	if index == 1 'second'
		return physReg(X64Register.r11)
	end 'second'
	panic("backend: an instruction reads more registers than the trivial allocator has scratch registers")
end 'trivialScratch'

// The constraints of an instruction. The registers of a target instruction are, in order: the one it defines, if
// any; the one a two-address form reads and writes, which the definition reuses; and the others it reads. A physical
// operand is a fixed register.

// operandCount is how many register operands an instruction has.
function operandCount(x MInstr) returns Count
	return match x.kind 'kind'
		target gives machineOperandCount(x.form)
		copy gives 2
		spill or
		reload gives 1
		parallelCopy or
		frameSetup or
		frameTeardown gives 0
	end 'kind'
end 'operandCount'

// defines is whether operand a is a definition, and the others uses.
function defines(x MInstr) returns bool
	return match x.kind 'kind'
		target gives definesOperand(x.form)
		copy or
		reload gives true
		spill or
		parallelCopy or
		frameSetup or
		frameTeardown gives false
	end 'kind'
end 'defines'

// reuses is whether the definition a must be given the register of the use b.
function reuses(x MInstr) returns bool
	return match x.kind 'kind'
		target gives reusesOperand(x.form)
		copy or
		reload or
		spill or
		parallelCopy or
		frameSetup or
		frameTeardown gives false
	end 'kind'
end 'reuses'

// implicitUses are the registers an instruction reads that no operand names: a form's fixed uses, and the result
// registers a return reads.
function implicitUses(x MInstr, convs Conventions, canThrow bool) returns RegMask
	return match x.kind 'kind'
		target gives fixedUses(x.form) or returnUses(x, conv: convs.internal, canThrow: canThrow)
		copy or
		reload or
		spill or
		parallelCopy or
		frameSetup or
		frameTeardown gives 0
	end 'kind'
end 'implicitUses'

function returnUses(x MInstr, conv CallConvention, canThrow bool) returns RegMask
	if not isReturn(x.form) 'other'
		return 0
	end 'other'
	if canThrow 'error'
		return regBit(conv.result) or regBit(conv.error)
	end 'error'
	return regBit(conv.result)
end 'returnUses'

// implicitDefs are the registers an instruction writes that no operand names: a form's fixed results and clobbers,
// and what a call's convention does not keep. A value live across the instruction may not be in one of them.
function implicitDefs(x MInstr, convs Conventions) returns RegMask
	return match x.kind 'kind'
		target gives fixedDefs(x.form) or clobbers(x.form) or callClobbers(x, convs: convs)
		copy or
		reload or
		spill or
		parallelCopy or
		frameSetup or
		frameTeardown gives 0
	end 'kind'
end 'implicitDefs'

function callClobbers(x MInstr, convs Conventions) returns RegMask
	if not isCall(x.form) 'other'
		return 0
	end 'other'
	return match callConvention(x) 'kind'
		internal gives convs.internal.clobbered
		win64 gives convs.win64.clobbered
	end 'kind'
end 'callClobbers'
