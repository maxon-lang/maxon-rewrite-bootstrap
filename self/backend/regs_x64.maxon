// x64's register file and calling conventions, as the selector, the encoder and the entry stub ask of them, and the
// constructors of machine instructions of x64's forms. What the target-neutral machine IR and the allocator ask of every
// form is in machine.maxon, over the tables of machine_gen.maxon.
// x64Arch is the architecture of the machine IR that x64's selector, encoder and entry stub write.
let x64Arch = ast.TargetArch.x64

export function x64PhysReg(r X64Register) returns MReg
	return try r.rawValue as MReg otherwise panic("backend: a register past an operand")
end 'x64PhysReg'

function regNumOf(r X64Register) returns RegNum
	return try r.rawValue as RegNum otherwise panic("backend: a register past the register file")
end 'regNumOf'

export function regMaskOf(r X64Register) returns RegMask
	return regBit(regNumOf(r))
end 'regMaskOf'

// newX64Target is an x64 form with its register operands, the displacement of a memory operand and an immediate.
export function newX64Target(form X64Form, a MReg, b MReg, c MReg, aux Imm32, imm FullRangeInt) returns MInstr
	return newMachine(x64FormID(form), a: a, b: b, c: c, aux: aux, imm: imm)
end 'newX64Target'

// newReferring is an x64 form whose last field refers to an edge, a symbol, data or an import.
export function newReferring(form X64Form, a MReg, ref MRef, aux Imm32) returns MInstr
	return newMachineReferring(x64FormID(form), a: a, ref: ref, aux: aux)
end 'newReferring'

// newConditional is an x64 form with a condition: a branch along an edge, or a setcc of a.
export function newConditional(form X64Form, cond MCond, a MReg, ref MRef, aux Imm32) returns MInstr
	var x = newReferring(form, a: a, ref: ref, aux: aux)
	x.cond = cond
	return x
end 'newConditional'

// newCall is a call of an x64 form whose last field refers to ref and aux (none for a call through a register, a),
// passing arguments in the registers argRegs.
export function newCall(form X64Form, a MReg, ref MRef, aux Imm32, argRegs RegMask) returns MInstr
	return newMachineCall(x64FormID(form), a: a, ref: ref, aux: aux, argRegs: argRegs)
end 'newCall'

// isX64Form is whether a machine instruction is the x64 form form.
function isX64Form(x MInstr, form X64Form) returns bool
	return x.kind == MKind.target and x.form == x64FormID(form)
end 'isX64Form'

// generalRegister is the general register a physical operand names.
function generalRegister(r MReg) returns X64Register
	let number = physicalNumber(r)
	if number >= x64FirstVector 'vector'
		panic("backend: a general operand in an xmm register")
	end 'vector'
	return x64RegisterOf(number)
end 'generalRegister'

// vectorRegister is the xmm register a physical operand names, as the general register of the same encoding number,
// which is how an encoder takes an xmm register.
function vectorRegister(r MReg) returns X64Register
	let number = physicalNumber(r)
	if number < x64FirstVector 'general'
		panic("backend: an xmm operand in a general register")
	end 'general'
	return x64RegisterOf(try (number - x64FirstVector) as RegNum otherwise panic("backend: an xmm register past the register file"))
end 'vectorRegister'

// argRegisterCount is how many arguments a convention passes in registers on a system.
function argRegisterCount(kind ConventionKind, system ast.TargetSystem) returns Count
	return match kind 'kind'
		internal gives x64InternalArgCount
		host gives x64HostArgCount(system)
		syscall gives x64SyscallArgCount(system)
	end 'kind'
end 'argRegisterCount'

// argRegister is the register of an argument that a convention passes in one on a system.
function argRegister(kind ConventionKind, system ast.TargetSystem, index Count) returns X64Register
	return match kind 'kind'
		internal gives x64InternalArg(index)
		host gives x64HostArg(system, index: index)
		syscall gives x64SyscallArg(system, index: index)
	end 'kind'
end 'argRegister'

// argsInRegisters is how many of a call's words, count of them, a convention passes in registers on a system.
function argsInRegisters(kind ConventionKind, system ast.TargetSystem, count Count) returns Count
	let registers = argRegisterCount(kind, system: system)
	return count if count < registers else registers
end 'argsInRegisters'

// wordArgRegs are the registers of the first count words that a convention passes in registers on a system.
function wordArgRegs(kind ConventionKind, system ast.TargetSystem, count Count) returns RegMask
	var mask = 0 as RegMask
	for i in 0 upto count 'args'
		mask = mask or regMaskOf(argRegister(kind, system: system, index: i))
	end 'args'
	return mask
end 'wordArgRegs'

// resultRegister is the register of a call's result on a system.
function resultRegister(kind ConventionKind, system ast.TargetSystem) returns X64Register
	return match kind 'kind'
		internal gives x64InternalResult
		host gives x64HostResult(system)
		syscall gives x64SyscallResult(system)
	end 'kind'
end 'resultRegister'

// internalArgsInRegisters is how many of a call's words, count of them, the internal convention passes in registers,
// the same on every system.
function internalArgsInRegisters(count Count) returns Count
	return count if count < x64InternalArgCount else x64InternalArgCount
end 'internalArgsInRegisters'

// internalArgRegs are the registers of the first count words that the internal convention passes in registers.
function internalArgRegs(count Count) returns RegMask
	var mask = 0 as RegMask
	for i in 0 upto count 'args'
		mask = mask or regMaskOf(x64InternalArg(i))
	end 'args'
	return mask
end 'internalArgRegs'

// An argument's place is where the internal convention passes it: a register, by its number in the register file, or
// the stack, by its place among the arguments there from stackPlaceBase on.
let stackPlaceBase = x64RegisterFileSize

function stackPlace(slot Count) returns Count
	return try stackPlaceBase + slot otherwise panic("backend: an argument past memory")
end 'stackPlace'

function isStackPlace(place Count) returns bool
	return place >= stackPlaceBase
end 'isStackPlace'

// stackSlotOf is the place among the arguments on the stack of a place there, the first nearest the return address.
function stackSlotOf(place Count) returns Count
	return try place - stackPlaceBase otherwise panic("backend: a register taken for a place on the stack")
end 'stackSlotOf'

// placeRegister is the physical register of a place in a register.
function placeRegister(place Count) returns MReg
	return try place as MReg otherwise panic("backend: a place past the register file")
end 'placeRegister'

// placeArgs gives each argument of a call of the internal convention, in the order the convention passes them, its place
// in places, by whether it is a float (floats), as maxon's convention does: each class counts its own arguments into its
// own registers, so the first float is in the first float register however many words come before it, and the arguments
// past a class's registers go on the stack in one run, in the order of the arguments. It is how many go on the stack.
function placeArgs(floats Array with bool, mutates places CountList) returns Count
	places.clear()
	var words = 0 as Count
	var vectors = 0 as Count
	var stacked = 0 as Count
	for i in 0 upto floats.count() 'args'
		if floats[i] and vectors < x64InternalFloatArgCount 'vector'
			places.push(x64InternalFloatArg(vectors) as Count)
			vectors = try vectors + 1 otherwise panic("backend: more arguments than memory")
		end 'vector' else if not floats[i] and words < x64InternalArgCount 'word'
			places.push(regNumOf(x64InternalArg(words)) as Count)
			words = try words + 1 otherwise panic("backend: more arguments than memory")
		end 'word' else 'stack'
			places.push(stackPlace(stacked))
			stacked = try stacked + 1 otherwise panic("backend: more arguments than memory")
		end 'stack'
	end 'args'
	return stacked
end 'placeArgs'

// argWord is the register of the first argument of the internal convention: the one argument of the routines and the
// runtime entries that the routines and the entry stub call.
function argWord() returns X64Register
	return x64InternalArg(0)
end 'argWord'

// resultWord is the register of the result of the internal convention.
function resultWord() returns X64Register
	return x64InternalResult
end 'resultWord'

// x64KeptBy is the registers a call of a convention keeps on a system: its host convention or its system call's, which
// a system that does not have it keeps none of, since no call of it is ever made there.
function x64KeptBy(kind ConventionKind, system ast.TargetSystem) returns RegMask
	return match kind 'kind'
		internal gives x64InternalCalleeSaved()
		host gives x64HostCalleeSaved(system) if ast.systemReach(system) == ast.SystemReach.imports else 0
		syscall gives x64SyscallCalleeSaved(system) if ast.systemReach(system) == ast.SystemReach.syscalls else 0
	end 'kind'
end 'x64KeptBy'
