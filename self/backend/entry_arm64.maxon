// The entry stub of an arm64 executable, as entry_linux.maxon is x64's on Linux: the code the process starts at keeps
// the stack pointer the kernel started it with, where the arguments and the environment are, sets the standard handles,
// points tpidr_el0 at the main thread's context, moves to a stack of the main thread's reserve, runs main by rt.runMain
// (start.maxon) and exits with what main returns. A thread the runtime makes starts in the routine the runtime calls to
// make it, which clones the process's thread onto the stack the runtime mapped, with its context as the clone's thread
// pointer. The fault handler and the restorer its signals return through are here too, with the green threads' code
// (green_arm64.maxon). Every system call is svc with its number in x8 and its words in x0 to x5, which keeps every
// register but x0, the result.

// The registers the stub works in: x9 to x14, which no system call's word is passed in, and x19, which keeps the main
// stack's reserve across the calls that guard it.
let stubTemp = Arm64Register.x9

let stubSecond = Arm64Register.x10

let stubThird = Arm64Register.x11

let stubFourth = Arm64Register.x12

let stubReserve = Arm64Register.x19

// emitArm64Runtime is the unit of the entry for an arm64 target, by its system.
function emitArm64Runtime(calls EntryCalls, options RuntimeOptions, system ast.TargetSystem) returns CodeUnit
	return match system 'system'
		linux gives emitArm64LinuxRuntime(calls, options: options)
		windows gives panic("backend: arm64 has no entry stub for Windows, which the target table runs no arm64 on")
		macos gives panic("backend: arm64 has no entry stub for macOS yet, whose target the target table holds pending")
	end 'system'
end 'emitArm64Runtime'

// emitArm64LinuxRuntime is the arm64 Linux unit of the entry: the standard handles, the main thread's context and the stack
// pointer the process started with, which the runtime's source reads; the entry, the routine that starts a thread, and the
// fault handler with the restorer its signals return through.
function emitArm64LinuxRuntime(calls EntryCalls, options RuntimeOptions) returns CodeUnit
	var u = CodeUnit.new()
	u.defineData(ir.rtSymbol(ir.Rt.rtStdout), size: wordBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtStderr), size: wordBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtMainContext), size: contextBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtProcessStart), size: wordBytes)
	emitStartData(u)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtEntry))
	emitArm64LinuxEntry(u, count: options.countAllocations)
	emitStartRoutines(u, a: arm64Arch, calls: calls)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtThreadStart))
	emitArm64ThreadStart(u)
	u.beginSection()
	u.defineCode(faultSymbol)
	emitArm64FaultHandler(u)
	u.defineCode(ir.rtSymbol(ir.Rt.rtSigreturn))
	arm64StubSyscall(u, number: arm64LinuxSysRtSigreturn)
	emitArm64GreenRoutines(u, system: ast.TargetSystem.linux)
	emitArm64PreemptHandler(u)
	return u
end 'emitArm64LinuxRuntime'

// arm64StubSyscall makes the system call of a number with the words in x0 to x5.
function arm64StubSyscall(mutates u CodeUnit, number FullRangeInt)
	u.asm.arm64MovImm(arm64LinuxSyscallNumber, value: number)
	u.asm.arm64Svc()
end 'arm64StubSyscall'

// arm64StubArg is the register of a system call's word at an index.
function arm64StubArg(index Count) returns Arm64Register
	return arm64LinuxSyscallArg(index)
end 'arm64StubArg'

// arm64BranchIfFailed goes to a label where the result of a system call is -errno: a word above -linuxErrnoLimit.
function arm64BranchIfFailed(mutates u CodeUnit, to LabelID)
	u.asm.arm64MovImm(stubTemp, value: 0 - (linuxErrnoLimit as FullRangeInt))
	u.asm.arm64Cmp(arm64LinuxSyscallResult, right: stubTemp)
	u.asm.arm64BranchIf(MCond.above, label: to)
end 'arm64BranchIfFailed'

// emitArm64LinuxEntry writes the executable's entry point, where the kernel starts the process with sp at the argument
// count and every other register 0.
function emitArm64LinuxEntry(mutates u CodeUnit, count bool)
	u.asm.arm64Mov(stubTemp, src: Arm64Register.sp)
	u.asm.arm64StoreSymbol(ir.rtSymbol(ir.Rt.rtProcessStart), src: stubTemp)
	u.asm.arm64MovImm(stubTemp, value: linuxStdoutFd)
	u.asm.arm64StoreSymbol(ir.rtSymbol(ir.Rt.rtStdout), src: stubTemp)
	u.asm.arm64MovImm(stubTemp, value: linuxStderrFd)
	u.asm.arm64StoreSymbol(ir.rtSymbol(ir.Rt.rtStderr), src: stubTemp)
	let unmapped = u.asm.newLabel()
	// tpidr_el0 is the main thread's context, as a worker's start makes it its own.
	u.asm.arm64Address(stubTemp, symbol: ir.rtSymbol(ir.Rt.rtMainContext))
	encodeArm64MsrTpidr(u.asm.code, src: stubTemp)
	emitArm64MainStack(u, unmapped: unmapped)
	emitArm64SignalStack(u)
	emitArm64FaultActions(u)
	u.asm.arm64CallSymbol(runMainSymbol)
	if count 'leaks'
		u.asm.arm64CallSymbol(ir.rtSymbol(ir.Rt.rtCheckLeaks))
	end 'leaks'
	arm64StubSyscall(u, number: arm64LinuxSysExitGroup)
	u.asm.bind(unmapped)
	u.asm.arm64AddressData(arm64ArgWord(), dataOffset: u.data.textOffset(stackUnmapped))
	u.asm.arm64CallSymbol(ir.rtSymbol(ir.Rt.rtPanic))
end 'emitArm64LinuxEntry'

// emitArm64MainStack moves the main thread to a stack of stackReserveBytes of its own, as a worker's, its lowest page the
// guard, and goes to unmapped when the kernel refuses.
function emitArm64MainStack(mutates u CodeUnit, unmapped LabelID)
	emitArm64Map(u, bytes: stackReserveBytes, flags: linuxMapAnonPrivate or linuxMapNoReserve)
	arm64BranchIfFailed(u, to: unmapped)
	u.asm.arm64Mov(stubReserve, src: arm64LinuxSyscallResult)
	u.asm.arm64MovImm(arm64StubArg(1), value: linuxPageBytes)
	u.asm.arm64MovImm(arm64StubArg(2), value: linuxProtNone)
	arm64StubSyscall(u, number: arm64LinuxSysMprotect)
	u.asm.arm64BranchIfNotZero(arm64LinuxSyscallResult, label: unmapped)
	u.asm.arm64MovImm(stubTemp, value: stackReserveBytes)
	u.asm.arm64Add(stubTemp, left: stubReserve, right: stubTemp)
	u.asm.arm64Mov(Arm64Register.sp, src: stubTemp)
end 'emitArm64MainStack'

// emitArm64Map maps bytes of zeroed pages of no file with the flags, readable and writable; the address is in x0.
function emitArm64Map(mutates u CodeUnit, bytes FullRangeInt, flags FullRangeInt)
	u.asm.arm64MovImm(arm64StubArg(0), value: noAddress)
	u.asm.arm64MovImm(arm64StubArg(1), value: bytes)
	u.asm.arm64MovImm(arm64StubArg(2), value: linuxProtReadWrite)
	u.asm.arm64MovImm(arm64StubArg(3), value: flags)
	u.asm.arm64MovImm(arm64StubArg(4), value: noFile)
	u.asm.arm64MovImm(arm64StubArg(5), value: noOffset)
	arm64StubSyscall(u, number: arm64LinuxSysMmap)
end 'emitArm64Map'

// emitArm64ThreadStart writes the routine that starts a worker's thread, which the runtime calls by the internal
// convention with the top of the stack it mapped for the thread, where it has stored the thread's context. The routine
// gives the kernel's answer, the thread's id or -errno. The new thread starts after the clone with that stack and its
// context as tpidr_el0, and calls the runtime's workerMain with it. arm64's clone takes the thread pointer before the
// child's tid.
function emitArm64ThreadStart(mutates u CodeUnit)
	let child = u.asm.newLabel()
	u.asm.arm64Load(arm64StubArg(3), base: arm64ArgWord(), disp: 0)
	u.asm.arm64Mov(arm64StubArg(1), src: arm64ArgWord())
	u.asm.arm64MovImm(arm64StubArg(0), value: arm64LinuxCloneThreadFlags)
	u.asm.arm64MovImm(arm64StubArg(2), value: noTid)
	u.asm.arm64MovImm(arm64StubArg(4), value: noTid)
	arm64StubSyscall(u, number: arm64LinuxSysClone)
	u.asm.arm64BranchIfZero(arm64LinuxSyscallResult, label: child)
	u.asm.arm64Ret()
	u.asm.bind(child)
	emitArm64SignalStack(u)
	u.asm.arm64Load(arm64ArgWord(), base: Arm64Register.sp, disp: 0)
	u.asm.arm64CallSymbol(ir.rtSymbol(ir.Rt.rtWorkerMain))
	u.asm.arm64MovImm(arm64StubArg(0), value: workerExitCode)
	arm64StubSyscall(u, number: arm64LinuxSysExit)
end 'emitArm64ThreadStart'

// emitArm64SignalStack gives the running thread a stack of faultStackGuarantee bytes that its signals run on, as x64's
// does, through a stack_t below the stack pointer, a room the stack's alignment rounds up.
function emitArm64SignalStack(mutates u CodeUnit)
	let skip = u.asm.newLabel()
	let room = alignUp(stackRecordBytes, alignment: arm64StackAlignment)
	emitArm64Map(u, bytes: faultStackGuarantee, flags: linuxMapAnonPrivate)
	arm64BranchIfFailed(u, to: skip)
	u.asm.arm64AddImm(Arm64Register.sp, src: Arm64Register.sp, value: arm64Negated(arm64Disp(room)))
	u.asm.arm64Store(Arm64Register.sp, disp: stackSpOffset, src: arm64LinuxSyscallResult)
	u.asm.arm64Store(Arm64Register.sp, disp: stackFlagsOffset, src: arm64ZeroRegister)
	u.asm.arm64MovImm(stubTemp, value: faultStackGuarantee)
	u.asm.arm64Store(Arm64Register.sp, disp: stackSizeOffset, src: stubTemp)
	u.asm.arm64Mov(arm64StubArg(0), src: Arm64Register.sp)
	u.asm.arm64MovImm(arm64StubArg(1), value: noOldStack)
	arm64StubSyscall(u, number: arm64LinuxSysSigaltstack)
	u.asm.arm64AddImm(Arm64Register.sp, src: Arm64Register.sp, value: arm64Disp(room))
	u.asm.bind(skip)
end 'emitArm64SignalStack'

// emitArm64FaultActions makes the fault handler the action of each signal of a hardware fault, for every thread, through
// a struct sigaction below the stack pointer.
function emitArm64FaultActions(mutates u CodeUnit)
	let room = alignUp(linuxSigactionBytes, alignment: arm64StackAlignment)
	u.asm.arm64AddImm(Arm64Register.sp, src: Arm64Register.sp, value: arm64Negated(arm64Disp(room)))
	u.asm.arm64Address(stubTemp, symbol: faultSymbol)
	u.asm.arm64Store(Arm64Register.sp, disp: linuxSigactionHandlerOffset, src: stubTemp)
	u.asm.arm64MovImm(stubTemp, value: linuxFaultActionFlags)
	u.asm.arm64Store(Arm64Register.sp, disp: linuxSigactionFlagsOffset, src: stubTemp)
	u.asm.arm64Address(stubTemp, symbol: ir.rtSymbol(ir.Rt.rtSigreturn))
	u.asm.arm64Store(Arm64Register.sp, disp: linuxSigactionRestorerOffset, src: stubTemp)
	u.asm.arm64Store(Arm64Register.sp, disp: linuxSigactionMaskOffset, src: arm64ZeroRegister)
	emitArm64FaultAction(u, signal: linuxSigsegv)
	emitArm64FaultAction(u, signal: linuxSigbus)
	emitArm64FaultAction(u, signal: linuxSigfpe)
	u.asm.arm64AddImm(Arm64Register.sp, src: Arm64Register.sp, value: arm64Disp(room))
end 'emitArm64FaultActions'

function emitArm64FaultAction(mutates u CodeUnit, signal FullRangeInt)
	u.asm.arm64MovImm(arm64StubArg(0), value: signal)
	u.asm.arm64Mov(arm64StubArg(1), src: Arm64Register.sp)
	u.asm.arm64MovImm(arm64StubArg(2), value: noOldAction)
	u.asm.arm64MovImm(arm64StubArg(3), value: linuxSignalMaskBytes)
	arm64StubSyscall(u, number: arm64LinuxSysRtSigaction)
end 'emitArm64FaultAction'

// emitArm64FaultHandler writes the handler of the signals of a hardware fault (AAPCS64: the signal in x0, the siginfo in
// x1, the context in x2), on the thread's signal stack: it writes `panic: <what> at rip=0x<address>` to standard error,
// as maxon's arm64 runtime does, and exits with the panic code, making nothing but system calls. arm64's division
// raises no signal, so a SIGFPE reads as the x64 handler reads one.
function emitArm64FaultHandler(mutates u CodeUnit)
	let report = u.asm.newLabel()
	let memory = u.asm.newLabel()
	let wild = u.asm.newLabel()
	let overflowed = u.asm.newLabel()
	let frame = alignUp(faultFrameSize, alignment: arm64StackAlignment)
	let line = stubSecond
	u.asm.arm64AddImm(Arm64Register.sp, src: Arm64Register.sp, value: arm64Negated(arm64Disp(frame)))
	u.asm.arm64Load(stubTemp, base: arm64ArgRegister(ConventionKind.host, system: ast.TargetSystem.linux, index: 2), disp: arm64LinuxUcontextPcOffset)
	u.asm.arm64Store(Arm64Register.sp, disp: faultAddressSlot, src: stubTemp)
	u.asm.arm64CmpImm(arm64ArgWord(), value: linuxSigfpe)
	u.asm.arm64BranchIf(MCond.notEqual, label: memory)
	u.asm.arm64LoadWord32(stubTemp, base: arm64ArgRegister(ConventionKind.host, system: ast.TargetSystem.linux, index: 1), disp: siginfoCodeOffset)
	u.asm.arm64CmpImm(stubTemp, value: fpeIntegerOverflow)
	u.asm.arm64BranchIf(MCond.equal, label: overflowed)
	u.asm.arm64AddressData(line, dataOffset: u.data.textOffset(faultLineOpening(divideByZeroWords)))
	u.asm.arm64Jump(report)
	u.asm.bind(overflowed)
	u.asm.arm64AddressData(line, dataOffset: u.data.textOffset(faultLineOpening(integerOverflowWords)))
	u.asm.arm64Jump(report)
	u.asm.bind(memory)
	u.asm.arm64Load(stubTemp, base: arm64ArgRegister(ConventionKind.host, system: ast.TargetSystem.linux, index: 1), disp: siginfoAddressOffset)
	u.asm.arm64Load(stubThird, base: arm64ArgRegister(ConventionKind.host, system: ast.TargetSystem.linux, index: 2), disp: arm64LinuxUcontextSpOffset)
	u.asm.arm64Sub(stubTemp, left: stubTemp, right: stubThird)
	u.asm.arm64MovImm(stubThird, value: stackFaultReach)
	u.asm.arm64Add(stubTemp, left: stubTemp, right: stubThird)
	u.asm.arm64MovImm(stubThird, value: 2 * stackFaultReach)
	u.asm.arm64Cmp(stubTemp, right: stubThird)
	u.asm.arm64BranchIf(MCond.aboveEqual, label: wild)
	u.asm.arm64AddressData(line, dataOffset: u.data.textOffset(faultLineOpening(stackOverflowWords)))
	u.asm.arm64Jump(report)
	u.asm.bind(wild)
	u.asm.arm64AddressData(line, dataOffset: u.data.textOffset(faultLineOpening(accessViolationWords)))
	u.asm.bind(report)
	u.asm.arm64Load(arm64StubArg(2), base: line, disp: 0)
	u.asm.arm64AddImm(arm64StubArg(1), src: line, value: wordBytes)
	emitArm64StderrWrite(u)
	emitArm64AddressDigits(u)
	u.asm.arm64AddImm(arm64StubArg(1), src: Arm64Register.sp, value: faultDigitsSlot)
	u.asm.arm64MovImm(arm64StubArg(2), value: addressDigits + 1)
	emitArm64StderrWrite(u)
	u.asm.arm64MovImm(arm64StubArg(0), value: faultExitCode)
	arm64StubSyscall(u, number: arm64LinuxSysExitGroup)
end 'emitArm64FaultHandler'

// emitArm64StderrWrite writes the x2 bytes at x1 to standard error.
function emitArm64StderrWrite(mutates u CodeUnit)
	u.asm.arm64LoadSymbol(arm64StubArg(0), symbol: ir.rtSymbol(ir.Rt.rtStderr))
	arm64StubSyscall(u, number: arm64LinuxSysWrite)
end 'emitArm64StderrWrite'

// emitArm64AddressDigits writes the faulting address, in the handler's frame, as addressDigits hexadecimal digits and a
// newline at faultDigitsSlot, as x64's does.
function emitArm64AddressDigits(mutates u CodeUnit)
	let value = stubTemp
	let digits = stubSecond
	let nibble = stubThird
	let byte = stubFourth
	u.asm.arm64Load(value, base: Arm64Register.sp, disp: faultAddressSlot)
	u.asm.arm64AddressData(digits, dataOffset: u.data.textOffset(hexDigits))
	u.asm.arm64AddImm(digits, src: digits, value: wordBytes)
	for i in 0 upto addressDigits 'digits'
		let lastDigit = try faultDigitsSlot + addressDigits - 1 otherwise panic("backend: the fault frame is past 2 GiB")
		encodeArm64AndRegMask(u.asm.code, dest: nibble, src: value, imm: nibbleMask)
		u.asm.arm64LoadByte(byte, base: digits, index: nibble)
		encodeArm64StrbOff(u.asm.code, src: byte, base: Arm64Register.sp, disp: imm32Of(try lastDigit - i otherwise panic("backend: a digit before the fault frame")))
		encodeArm64UbfmRegReg(u.asm.code, dest: value, src: value, immr: nibbleBits, imms: arm64SignShift)
	end 'digits'
	u.asm.arm64MovImm(byte, value: newlineByte)
	encodeArm64StrbOff(u.asm.code, src: byte, base: Arm64Register.sp, disp: faultNewlineSlot)
end 'emitArm64AddressDigits'
