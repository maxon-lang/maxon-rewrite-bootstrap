// The backend from the IR of a program to its executable: the entry stub, the code of every module's functions, the drop
// and copy routine of each type that code asks for, and the link. The runtime's heap, arrays, strings and OS are Maxon
// source that comes in as functions of the modules, so a call to one is a call to a symbol that the link resolves.

export typealias FunctionLists = Array with ir.IrFunctionList

// buildProgram is the executable image of the functions of every module, in module order, with entry as the function
// that main is: linkProgram of the modules' units. With mapsSymbols the result also holds the map of the code's symbols.
export function buildProgram(mutates p ast.Project, modules FunctionLists, ready frozen with UnitList, entry ast.FuncID, options RuntimeOptions, mapsSymbols bool) returns Linked
	var units = UnitList.create(0)
	var errs = diag.ErrorList.create(0)
	var clock = EmitClock.off()
	var ms = ast.lendProject(p)
	var none = NoFallbacks.new()
	for i in 0 upto modules.count() 'modules'
		units.push(emitModule(p, ms: ms, fns: modules[i], fallbacks: none, verifies: true, clock: clock, errs: errs))
	end 'modules'
	ast.giveBack(p, ms: ms)
	if errs.count() > 0 'refused'
		panic("backend: a program built without the driver is refused: {errs[0].message}")
	end 'refused'
	return linkProgram(p, modules: units, ready: ready, entry: entry, options: options, mapsSymbols: mapsSymbols)
end 'buildProgram'

// linkProgram is the executable image of the units of every module, in module order, with entry as the function that main
// is. The units are in the order the link lays them out in: the entry stub, the ready-made units (the ones that the build
// cache has, and any that are not made from IR), the modules, and the routines. The ready units are frozen and only read, so
// that many programs, at once, can be linked with the same ones.
export function linkProgram(mutates p ast.Project, consumes modules UnitList, ready frozen with UnitList, entry ast.FuncID, options RuntimeOptions, mapsSymbols bool) returns Linked
	var entries = ast.FuncIDList.create(0)
	entries.push(entry)
	return linkCalling(p, modules: modules, ready: ready, entries: entries, exitsWithResult: true, options: options, mapsSymbols: mapsSymbols)
end 'linkProgram'

// linkCalling is linkProgram for an entry that calls entries in order: main, whose result is the exit code, or the tests of
// an executable of tests, after which it exits with 0.
function linkCalling(mutates p ast.Project, consumes modules UnitList, ready frozen with UnitList, entries ast.FuncIDList, exitsWithResult bool, options RuntimeOptions, mapsSymbols bool) returns Linked
	var ms = ast.lendProject(p)
	var symbols = ast.StringList.create(0)
	for i in 0 upto entries.count() 'entries'
		symbols.push(ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: entries[i]))
	end 'entries'
	var stub = UnitList.create(0)
	stub.push(emitRuntime(EntryCalls.make(symbols, exitsWithResult: exitsWithResult), options: options, target: p.target))
	var units = LinkUnits.make(share(ready), own: stub)
	units.add(modules)
	let routines = emitTypeRoutines(p, ms: ms, units: units)
	ast.giveBack(p, ms: ms)
	units.add(routines)
	return link(units, entry: ir.rtSymbol(ir.Rt.rtEntry), choice: schedulerChoice(), target: p.target, mapsSymbols: mapsSymbols, describesLines: p.keepsSpans)
end 'linkCalling'

// compileProgram writes the executable that linkProgram makes of the modules' units to out, the map of its code's symbols to
// symbolMap when that is not empty, and its debug info beside it when p keeps spans (writeSidecar), and gives whether it runs
// the scheduler. An executable of tests has no main: its entry calls tests, in order, and exits with 0 when none panicked.
export function compileProgram(mutates p ast.Project, consumes modules UnitList, ready frozen with UnitList, entry ast.FuncID, tests ast.FuncIDList, options RuntimeOptions, out FilePath, symbolMap String) returns bool throws FileWriteError
	var entries = tests.clone()
	let runsTests = tests.count() > 0
	if not runsTests 'main'
		entries.push(entry)
	end 'main'
	let linked = linkCalling(p, modules: modules, ready: ready, entries: entries, exitsWithResult: not runsTests, options: options, mapsSymbols: symbolMap != "")
	try writeImage(linked.image, path: out)
	if symbolMap != "" 'map'
		let mapPath = try FilePath.from(symbolMap) otherwise panic("backend: the symbol map {symbolMap} is not a path")
		try File.writeText(mapPath, content: linked.symbolMap)
	end 'map'
	if p.keepsSpans 'debugInfo'
		try writeSidecar(p, lines: linked.lines, out: out)
	end 'debugInfo'
	return linked.scheduled
end 'compileProgram'
