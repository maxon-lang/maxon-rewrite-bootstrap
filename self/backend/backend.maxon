// The backend from the IR of a program to its executable: the entry stub, the code of every module's functions, the drop
// and copy routine of each type that code asks for, and the link. The runtime's heap, arrays, strings and OS are Maxon
// source that comes in as functions of the modules, so a call to one is a call to a symbol that the link resolves.

export typealias FunctionLists = Array with ir.IrFunctionList

// buildProgram is the executable image of the functions of every module, in module order, with entry as the function
// that main is. The units are in the order the link lays them out in: the entry stub, the ready-made units (the ones that
// the build cache has, and any that are not made from IR), the modules, and the routines.
export function buildProgram(mutates p ast.Project, modules FunctionLists, consumes ready UnitList, entry ast.FuncID, options RuntimeOptions) returns PeImage
	var units = UnitList.create(0)
	units.push(emitRuntime(ast.funcLinkName(p, fid: entry), options: options))
	var held = ready
	for i in 0 upto held.count() 'ready'
		units.push(exchange(held[i], value: CodeUnit.new()))
	end 'ready'
	for i in 0 upto modules.count() 'modules'
		units.push(emitModule(p, fns: modules[i]))
	end 'modules'
	var routines = emitTypeRoutines(p, units: units)
	for i in 0 upto routines.count() 'routines'
		units.push(exchange(routines[i], value: CodeUnit.new()))
	end 'routines'
	return link(units, entry: ir.rtSymbol(ir.Rt.rtEntry))
end 'buildProgram'

// compileProgram writes the executable of the functions of every module to out.
export function compileProgram(mutates p ast.Project, modules FunctionLists, consumes ready UnitList, entry ast.FuncID, options RuntimeOptions, out FilePath) throws FileWriteError
	let image = buildProgram(p, modules: modules, ready: ready, entry: entry, options: options)
	try writePeImage(image, path: out)
end 'compileProgram'
