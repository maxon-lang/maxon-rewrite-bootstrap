// How main starts, which the link decides by what the program's live code reaches (SchedulerChoice): a program that uses
// the scheduler runs main as a green thread, by the runtime's mainRun, and one that does not calls main on the main thread's
// own stack, with no scheduler, monitor or thread of its own, and links none of the scheduler's code. The entry stub calls
// rt.runMain either way. The scheduler's routines that code outside it names have a form for a program of one thread, which
// the link puts in their place: the blocking call's bracket and the exit claim do nothing, since no other thread can take a
// processor or stop one, and Process.setExitCode keeps its code in the stub's data rather than in the scheduler's record.

// runMainSymbol is what the entry calls to run main: with the scheduler, mainRun with rt.mainGreen.
let runMainSymbol = "rt.runMain"

// mainAloneSymbol is rt.runMain without the scheduler: it calls main, or each test, by rt.mainGreen, and gives the code that
// Process.setExitCode set last in place of main's.
let mainAloneSymbol = "rt.mainAlone"

// unbracketedSymbol does nothing: the single-thread form of the blocking bracket's two ends and of the exit claim.
let unbracketedSymbol = "rt.unbracketed"

// setExitCodeAloneSymbol is Process.setExitCode without the scheduler, which keeps the code in exitCodeSymbol.
let setExitCodeAloneSymbol = "rt.setExitCodeAlone"

// exitCodeSymbol and exitSetSymbol are the code that Process.setExitCode set last in a program without the scheduler, and
// whether it set one.
let exitCodeSymbol = "g.exitCode"

let exitSetSymbol = "g.exitSet"

// schedulerChoice is how the link decides whether a program runs the scheduler. The witness is rt.stackSwitch: running a
// green thread and leaving one are the only switches of a stack, so a behaviour, a coroutine, a sleep, a yield and an await
// each reach it, through the runtime's code that starts or parks a green thread, and nothing else does once the scheduler's
// routines that other code names are in their single-thread form.
export function schedulerChoice() returns SchedulerChoice
	var substitutes = SubstituteList.create(0)
	substitutes.push(Substitute.make(runMainSymbol, alone: mainAloneSymbol))
	substitutes.push(Substitute.make(ir.rtSymbol(ir.Rt.rtEnterBlocking), alone: unbracketedSymbol))
	substitutes.push(Substitute.make(ir.rtSymbol(ir.Rt.rtExitBlocking), alone: unbracketedSymbol))
	substitutes.push(Substitute.make(ir.rtSymbol(ir.Rt.rtExitClaim), alone: unbracketedSymbol))
	substitutes.push(Substitute.make(ir.rtSymbol(ir.Rt.rtOsSetExitCode), alone: setExitCodeAloneSymbol))
	return SchedulerChoice.make(ir.rtSymbol(ir.Rt.rtStackSwitch), substitutes: substitutes)
end 'schedulerChoice'

// emitStartData reserves the words of Process.setExitCode in a program without the scheduler.
function emitStartData(mutates u CodeUnit)
	u.defineData(exitCodeSymbol, size: wordBytes)
	u.defineData(exitSetSymbol, size: wordBytes)
end 'emitStartData'

// emitStartRoutines writes rt.mainGreen, which calls main, and the two ways of running it, each a section that the link keeps
// only when the program's way names it, with the single-thread forms of the scheduler's routines. Besides the convention's
// argument and result they work in the routines' work register.
function emitStartRoutines(mutates u CodeUnit, a ast.TargetArch, calls EntryCalls)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtMainGreen))
	emitMainGreen(u, a: a, calls: calls)
	u.beginSection()
	u.defineCode(runMainSymbol)
	rEnterStub(u, a: a)
	rAddress(u, a: a, dst: rArg, symbol: ir.rtSymbol(ir.Rt.rtMainGreen))
	rCallSymbol(u, a: a, symbol: ir.rtSymbol(ir.Rt.rtMainRun))
	rLeaveStub(u, a: a)
	rRet(u, a: a)
	u.beginSection()
	u.defineCode(mainAloneSymbol)
	let mains = u.asm.newLabel()
	rEnterStub(u, a: a)
	rCallSymbol(u, a: a, symbol: ir.rtSymbol(ir.Rt.rtMainGreen))
	rLoadSymbol(u, a: a, dst: rWork, symbol: exitSetSymbol)
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: mains)
	rLoadSymbol(u, a: a, dst: rResult, symbol: exitCodeSymbol)
	u.asm.bind(mains)
	rLeaveStub(u, a: a)
	rRet(u, a: a)
	u.beginSection()
	u.defineCode(setExitCodeAloneSymbol)
	rStoreSymbol(u, a: a, symbol: exitCodeSymbol, src: rArg)
	rMovImm(u, a: a, dst: rWork, imm: 1)
	rStoreSymbol(u, a: a, symbol: exitSetSymbol, src: rWork)
	rRet(u, a: a)
	u.beginSection()
	u.defineCode(unbracketedSymbol)
	rRet(u, a: a)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtCopyBytes))
	emitCopyBytes(u, a: a)
end 'emitStartRoutines'

// emitCopyBytes writes rt.copyBytes, which __Raw.copyBytes calls by the internal convention with the source, the target
// and the count: the copy routines' copy (rCopyBytes), whose registers every call may leave holding anything. The count is
// above 0 and the two places do not overlap, which the caller sees to.
function emitCopyBytes(mutates u CodeUnit, a ast.TargetArch)
	rMov(u, a: a, dst: rCopyFrom, src: rArg)
	rMov(u, a: a, dst: rCopyTo, src: rArgWord)
	rMov(u, a: a, dst: rSecond, src: rArgThird)
	rCopyBytes(u, a: a)
	rRet(u, a: a)
end 'emitCopyBytes'

// emitMainGreen writes rt.mainGreen, the code main's green thread runs, which greenMain calls by the internal convention
// with the green thread, and which rt.mainAlone calls: it calls main, whose result is the exit code, or each test of an
// executable of tests, after which the code is 0.
function emitMainGreen(mutates u CodeUnit, a ast.TargetArch, calls EntryCalls)
	rEnterStub(u, a: a)
	for i in 0 upto calls.symbols.count() 'calls'
		rCallSymbol(u, a: a, symbol: calls.symbols[i])
	end 'calls'
	if not calls.exitsWithResult 'passed'
		rMovImm(u, a: a, dst: rResult, imm: 0)
	end 'passed'
	rLeaveStub(u, a: a)
	rRet(u, a: a)
end 'emitMainGreen'
