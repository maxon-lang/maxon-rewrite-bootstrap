// The linker lays the units out, resolves symbols and patches the references in the code. It keeps only the sections of
// code and the pieces of data that the entry reaches, as Go's linker does: every function is compiled, and what nothing
// calls is dropped here. The layout follows the order of the units, and of the sections and pieces in each.

let linkDataAlignment = 8 as Count

let importSlotBytes = 8 as Count

// The 32-bit field of a call or a reference counts from the end of the field.
let linkFieldBytes = 4 as Count

enum LinkTargetKind
	linkUndefined
	linkCode
	linkData
	linkPreemptibleCode
end 'LinkTargetKind'

// LinkTarget is where a symbol is defined: a section of code or a piece of data of a unit, and its offset in the unit, or
// the table of preemptible code.
type LinkTarget
	var kind as LinkTargetKind
	var unit as Count
	var part as Count
	var offset as Count

	static function make(kind LinkTargetKind, unit Count, part Count, offset Count) returns LinkTarget
		return LinkTarget{kind: kind, unit: unit, part: part, offset: offset}
	end 'make'
end 'LinkTarget'

typealias LinkTargetList = Array with LinkTarget

typealias BoolList = Array with bool

// LinkUnit is a unit as the link sees it: its sections and pieces, which of them the entry reaches, and where those go.
type LinkUnit
	// sections and pieces end with one past the last, so part i runs to the start of part i+1.
	var sections as CodeSectionList
	var sectionStarts as CountList
	var pieces as CountList
	var liveCode as BoolList
	var liveData as BoolList
	// readOnly says which pieces go in the image's read-only data (DataSection.readOnly) rather than its data.
	var readOnly as BoolList
	// codeAt and dataAt are where each live section and piece go, counted from codeBase, and from dataBase or constBase by
	// the piece's part of the image, where the layout puts the unit; codeSize, dataSize and constSize are how much the
	// unit's live parts take.
	var codeAt as CountList
	var dataAt as CountList
	var codeBase as Count
	var dataBase as Count
	var constBase as Count
	var codeSize as Count
	var dataSize as Count
	var constSize as Count
	var hasCode as bool
	var hasData as bool
	var hasConst as bool
	// firstID is the id of the unit's first definition: its code symbols, then its data symbols.
	var firstID as Count
	// targets is the id of what each symbol fixup names, and dataPieces the piece each data fixup points into. A section
	// has them once a mark has found it live, and they are used only while it is.
	var targets as CountList
	var dataPieces as CountList

	static function make(consumes sections CodeSectionList, consumes sectionStarts CountList, consumes pieces CountList, consumes liveCode BoolList, consumes liveData BoolList, consumes readOnly BoolList, consumes codeAt CountList, consumes dataAt CountList, consumes targets CountList, consumes dataPieces CountList) returns LinkUnit
		return LinkUnit{sections: sections, sectionStarts: sectionStarts, pieces: pieces, liveCode: liveCode, liveData: liveData, readOnly: readOnly, codeAt: codeAt, dataAt: dataAt, codeBase: 0 as Count, dataBase: 0 as Count, constBase: 0 as Count, codeSize: 0 as Count, dataSize: 0 as Count, constSize: 0 as Count, hasCode: false, hasData: false, hasConst: false, firstID: 0 as Count, targets: targets, dataPieces: dataPieces}
	end 'make'
end 'LinkUnit'

typealias LinkUnitList = Array with LinkUnit

// LiveSection is a section of a unit that the mark has found and not yet read.
type LiveSection
	var unit as Count
	var index as Count

	static function make(unit Count, index Count) returns LiveSection
		return LiveSection{unit: unit, index: index}
	end 'make'
end 'LiveSection'

typealias LiveSectionList = Array with LiveSection

// containing is the index of the part whose start is the last at or before an offset.
function containing(starts CountList, offset Count) returns Count
	var low = 0 as Count
	var high = starts.count()
	while low < high 'search'
		let span = high - low
		let middle = try low + span / 2 otherwise panic("link: a part past memory")
		if starts[middle] <= offset 'after'
			low = try middle + 1 otherwise panic("link: a part past memory")
		end 'after' else 'before'
			high = middle
		end 'before'
	end 'search'
	return try low - 1 otherwise panic("link: an offset before the first part")
end 'containing'

function falses(count Count) returns BoolList
	return BoolList.filled(count, value: false)
end 'falses'

function zeros(count Count) returns CountList
	return CountList.filled(count, value: 0 as Count)
end 'zeros'

function newLinkUnit(u CodeUnit) returns LinkUnit
	var sections = CodeSectionList.create(0)
	if u.sections.count() == 0 'single'
		sections.push(CodeSection.make(0, symbolFixups: 0, dataFixups: 0, importFixups: 0, alignment: functionAlignment, preemptible: false))
	end 'single' else 'several'
		if u.sections[0].code != 0 'before'
			panic("link: a unit has code before its first section")
		end 'before'
		for i in 0 upto u.sections.count() 'copy'
			sections.push(u.sections[i].clone())
		end 'copy'
	end 'several'
	sections.push(CodeSection.make(u.asm.code.count(), symbolFixups: u.asm.symbolFixups.count(), dataFixups: u.asm.dataFixups.count(), importFixups: u.asm.importFixups.count(), alignment: functionAlignment, preemptible: false))
	var sectionStarts = CountList.create(0)
	for i in 0 upto sections.count() 'starts'
		sectionStarts.push(sections[i].code)
	end 'starts'
	var pieces = CountList.create(0)
	var readOnly = BoolList.create(0)
	if u.data.pieces.count() == 0 'none'
		pieces.push(0)
		readOnly.push(false)
	end 'none' else 'some'
		for i in 0 upto u.data.pieces.count() 'copy'
			pieces.push(u.data.pieces[i])
			readOnly.push(u.data.readOnly[i])
		end 'copy'
	end 'some'
	pieces.push(u.data.bytes.count())
	let sectionCount = try sections.count() - 1 otherwise panic("link: no sections")
	let pieceCount = try pieces.count() - 1 otherwise panic("link: no pieces")
	return LinkUnit.make(sections, sectionStarts: sectionStarts, pieces: pieces, liveCode: falses(sectionCount), liveData: falses(pieceCount), readOnly: readOnly, codeAt: zeros(sectionCount), dataAt: zeros(pieceCount), targets: zeros(u.asm.symbolFixups.count()), dataPieces: zeros(u.asm.dataFixups.count()))
end 'newLinkUnit'

// Linked is the executable of a link, the map of its code's symbols and the lines of its code when the link was asked for
// them, and whether the program runs the scheduler (SchedulerChoice).
export type Linked
	export var image as Image
	export var symbolMap as String
	export var lines as CodeLines
	export var scheduled as bool

	static function make(consumes image Image, consumes symbolMap String, consumes lines CodeLines, scheduled bool) returns Linked
		return Linked{image: image, symbolMap: symbolMap, lines: lines, scheduled: scheduled}
	end 'make'
end 'Linked'

// Substitute is a symbol that a program without the scheduler links to another definition: a routine of the scheduler that
// code outside it names, and its form for a program of one thread.
export type Substitute
	var symbol as String
	var alone as String

	export static function make(consumes symbol String, consumes alone String) returns Substitute
		return Substitute{symbol: symbol, alone: alone}
	end 'make'
end 'Substitute'

export typealias SubstituteList = Array with Substitute

// SchedulerChoice is how a link decides whether a program runs the scheduler, by reachability: the program is linked as one
// of a single thread, every substitute in place of its symbol, and when the live code then reaches witness it uses the
// scheduler, and is linked again with every symbol its own. witness is code that whatever needs the scheduler reaches, and
// nothing else does.
export type SchedulerChoice
	var witness as String
	var substitutes as SubstituteList

	export static function make(consumes witness String, consumes substitutes SubstituteList) returns SchedulerChoice
		return SchedulerChoice{witness: witness, substitutes: substitutes}
	end 'make'
end 'SchedulerChoice'

// SavedTarget is the definition of a symbol that a substitute's stands in for while the link marks a program of one thread.
type SavedTarget
	var id as Count
	var target as LinkTarget

	static function make(id Count, consumes target LinkTarget) returns SavedTarget
		return SavedTarget{id: id, target: target}
	end 'make'
end 'SavedTarget'

typealias SavedTargetList = Array with SavedTarget

// substitute puts the definition of each substitute in place of its symbol's, and gives what it replaced. A symbol that no
// unit defines is named by none, as in a program linked with a runtime of its own.
function substitute(mutates defined LinkTargetList, symbols SymbolIds, choice SchedulerChoice) returns SavedTargetList
	var saved = SavedTargetList.create(0)
	for i in 0 upto choice.substitutes.count() 'substitutes'
		let id = lookupSymbol(symbols, symbol: choice.substitutes[i].symbol)
		if id == 0 'unnamed'
			continue 'substitutes'
		end 'unnamed'
		let alone = lookupSymbol(symbols, symbol: choice.substitutes[i].alone)
		if defined[alone].kind != LinkTargetKind.linkCode 'missing'
			panic("link: {choice.substitutes[i].alone}, the form of {choice.substitutes[i].symbol} without the scheduler, is not code")
		end 'missing'
		saved.push(SavedTarget.make(id, target: defined[id].clone()))
		defined[id] = defined[alone].clone()
	end 'substitutes'
	return saved
end 'substitute'

// restore gives each symbol that substitute replaced its own definition back.
function restore(mutates defined LinkTargetList, saved SavedTargetList)
	for i in 0 upto saved.count() 'saved'
		defined[saved[i].id] = saved[i].target.clone()
	end 'saved'
end 'restore'

// reaches is whether the mark found the code that a symbol names live.
function reaches(links LinkUnitList, symbols SymbolIds, defined LinkTargetList, symbol String) returns bool
	let id = lookupSymbol(symbols, symbol: symbol)
	if id == 0 or defined[id].kind != LinkTargetKind.linkCode 'none'
		return false
	end 'none'
	return links[defined[id].unit].liveCode[defined[id].part]
end 'reaches'

// forgetLive makes every section and piece dead again, for another mark from the entry.
function forgetLive(mutates links LinkUnitList)
	for i in 0 upto links.count() 'units'
		links[i].liveCode = falses(links[i].liveCode.count())
		links[i].liveData = falses(links[i].liveData.count())
	end 'units'
end 'forgetLive'

// LinkUnits are the units of a link in the order it lays them out: the first of the program's own (the entry stub), the
// ready units, which every program linked with them shares and a link only reads, and then the rest of the program's own.
export type LinkUnits
	var ready as frozen with UnitList
	var own as UnitList

	static function make(consumes ready frozen with UnitList, consumes own UnitList) returns LinkUnits
		if own.count() == 0 'stub'
			panic("link: a program has no entry stub to lay out first")
		end 'stub'
		return LinkUnits{ready: ready, own: own}
	end 'make'

	function count() returns Count
		return try ready.count() + own.count() otherwise panic("link: more units than memory")
	end 'count'

	// at is the unit at place i of the layout.
	function at(i Count) returns borrowed CodeUnit
		if i == 0 'stub'
			return own[0]
		end 'stub'
		if i <= ready.count() 'ready'
			return ready[ir.pred(i)]
		end 'ready'
		return own[i - ready.count()]
	end 'at'

	// add puts the units at the end of the layout.
	function add(mutates self, consumes units UnitList)
		var held = units
		for i in 0 upto held.count() 'units'
			own.push(exchange(held[i], value: CodeUnit.new()))
		end 'units'
	end 'add'
end 'LinkUnits'

// link is the executable of the units for the system, with the code reachable from the entry symbol, and the scheduler
// only when the program needs it (choice). With mapsSymbols it also gives the map of the code's symbols (see
// symbolMapText), and with describesLines the lines of its code (describeLines).
export function link(units LinkUnits, entry String, choice SchedulerChoice, target ast.Target, mapsSymbols bool, describesLines bool) returns Linked
	var links = LinkUnitList.create(0)
	for i in 0 upto units.count() 'units'
		links.push(newLinkUnit(units.at(i)))
	end 'units'
	// Ids count from 1, so that 0 is no definition, and end with the table of preemptible code.
	var next = 1 as Count
	for i in 0 upto links.count() 'ids'
		links[i].firstID = next
		next = try next + units.at(i).codeSymbols.count() + units.at(i).dataSymbols.count() otherwise panic("link: more symbols than memory")
	end 'ids'
	let preemptibleCode = next
	var symbols = SymbolIds.new()
	var defined = LinkTargetList.filled(try preemptibleCode + 1 otherwise panic("link: more symbols than memory"), value: LinkTarget.make(LinkTargetKind.linkUndefined, unit: 0, part: 0, offset: 0))
	for i in 0 upto links.count() 'define'
		defineSymbols(links[i], u: units.at(i), index: i, symbols: symbols, defined: defined)
	end 'define'
	defined[preemptibleCode] = LinkTarget.make(LinkTargetKind.linkPreemptibleCode, unit: 0, part: 0, offset: 0)
	defineSymbol(symbols, id: preemptibleCode, symbol: ir.rtSymbol(ir.Rt.rtPreemptibleCode), repeatable: false)
	let startId = lookupSymbol(symbols, symbol: entry)
	let start = defined[startId].clone()
	if start.kind != LinkTargetKind.linkCode 'entry'
		panic("no entry symbol {entry}")
	end 'entry'
	let saved = substitute(defined, symbols: symbols, choice: choice)
	markLive(links, units: units, symbols: symbols, defined: defined, start: start)
	let scheduled = reaches(links, symbols: symbols, defined: defined, symbol: choice.witness)
	if scheduled 'scheduler'
		restore(defined, saved: saved)
		forgetLive(links)
		markLive(links, units: units, symbols: symbols, defined: defined, start: start)
	end 'scheduler'
	let sizes = layOut(links)
	let table = PreemptibleTable.of(links, wanted: namedByLiveCode(links, id: preemptibleCode))
	let tableAt = alignUp(sizes.data, alignment: linkDataAlignment)
	let dataSize = try tableAt + table.bytes() otherwise panic("link: data past memory")
	let pointers = livePointers(links, units: units)
	let imports = LinkImports.of(target.system, links: links, units: units)
	var image = buildImage(target, layout: ImageLayout.make(sizes.code, constSize: sizes.constant, dataSize: dataSize, entryOffset: codeOffset(links, t: start), pointers: pointers.clone()), imports: imports.names)
	var code = ByteArray.create(0)
	var parts = ImageParts.make(ByteArray.create(sizes.constant), data: ByteArray.create(dataSize))
	for i in 0 upto links.count() 'copy'
		copyAndPatch(code, parts: parts, links: links, unit: i, u: units.at(i), defined: defined, image: image, imports: imports, tableAt: tableAt, arch: target.arch)
	end 'copy'
	table.write(parts.data, at: tableAt, image: image)
	writePointers(target.system, image: image, data: parts.data, pointers: pointers)
	var lines = CodeLines.none()
	if describesLines 'lines'
		lines = describeLines(links, units: units, code: code, image: image)
	end 'lines'
	placeCode(image, at: 0, bytes: code)
	placeConstants(image, bytes: parts.constants)
	placeData(image, at: 0, bytes: parts.data)
	var symbolMap = ""
	if mapsSymbols 'map'
		// The map names each symbol at its own definition, so a substitute's code is listed by its own name.
		restore(defined, saved: saved)
		symbolMap = symbolMapText(links, units: units, symbols: symbols, defined: defined, textRva: image.textRva, codeSize: sizes.code)
	end 'map'
	return Linked.make(image, symbolMap: symbolMap, lines: lines, scheduled: scheduled)
end 'link'

// livePointers are the words of the live data that hold the address of other data, with both where they end up in the data
// section, in the order of their places, which is the order the base relocations list them in.
function livePointers(links LinkUnitList, units LinkUnits) returns DataPointerList
	var out = DataPointerList.create(0)
	for u in 0 upto links.count() 'units'
		for j in 0 upto units.at(u).data.pointers.count() 'pointers'
			let pointer = units.at(u).data.pointers[j].clone()
			let piece = containing(links[u].pieces, offset: pointer.pos)
			if not links[u].liveData[piece] 'dropped'
				continue 'pointers'
			end 'dropped'
			if links[u].readOnly[piece] 'constant'
				panic("link: a word that holds an address in a piece of read-only data")
			end 'constant'
			if containing(links[u].pieces, offset: pointer.target) != piece 'apart'
				panic("link: a pointer of the data reaches past its piece")
			end 'apart'
			let base = try links[u].dataBase + links[u].dataAt[piece] otherwise panic("link: data past memory")
			let pos = try base + (try pointer.pos - links[u].pieces[piece] otherwise panic("link: a pointer before its piece")) otherwise panic("link: data past memory")
			if out.count() > 0 and out[ir.pred(out.count())].pos >= pos 'order'
				panic("link: the pointers of the data are out of order")
			end 'order'
			let target = try base + (try pointer.target - links[u].pieces[piece] otherwise panic("link: a pointer before its piece")) otherwise panic("link: data past memory")
			out.push(DataPointer.make(pos, target: target))
		end 'pointers'
	end 'units'
	return out
end 'livePointers'

// patch64 writes the 64-bit little-endian value at an offset of the bytes.
function patch64(mutates bytes ByteArray, at Count, value Count)
	var rest = value
	for i in 0 upto wordBytes 'bytes'
		bytes[try at + i otherwise panic("link: a word past memory")] = (rest mod byteValues) as Byte
		rest = rest / byteValues
	end 'bytes'
end 'patch64'

// MapEntry is one function or routine in the executable's code, as the symbol map lists it.
type MapEntry
	var rva as Count
	var symbol as String

	static function make(rva Count, consumes symbol String) returns MapEntry
		return MapEntry{rva: rva, symbol: symbol}
	end 'make'
end 'MapEntry'

typealias MapEntryList = Array with MapEntry

let mapHexDigits = 8 as Count

let bitsPerHexDigit = 4 as Count

let hexLetterOffset = 87 as Count

let digitOffset = 48 as Count

let decimalBase = 10 as Count

let hexDigitMask = 15 as Count

// appendHex appends value as mapHexDigits lowercase hexadecimal digits.
function appendHex(mutates text ByteArray, value Count)
	for i in 0 upto mapHexDigits 'digits'
		let shift = (mapHexDigits - 1 - i) * bitsPerHexDigit
		let digit = (value shr shift) and hexDigitMask
		if digit < decimalBase 'number'
			text.push((digitOffset + digit) as Byte)
		end 'number' else 'letter'
			text.push((hexLetterOffset + digit) as Byte)
		end 'letter'
	end 'digits'
end 'appendHex'

// symbolMapText is, for every function and routine the executable keeps, its RVA, its size and its symbol, one per line in
// address order, so that a profiler (cmd/sample) can name the code an address is in. A symbol's size runs to the next
// symbol, so it takes in the padding after it.
function symbolMapText(links LinkUnitList, units LinkUnits, symbols SymbolIds, defined LinkTargetList, textRva Count, codeSize Count) returns String
	var entries = MapEntryList.create(0)
	for u in 0 upto links.count() 'units'
		for i in 0 upto units.at(u).codeSymbols.count() 'symbols'
			let id = try links[u].firstID + i otherwise panic("link: more symbols than memory")
			let t = defined[id].clone()
			if lookupSymbol(symbols, symbol: units.at(u).codeSymbols[i].symbol) == id and links[u].liveCode[t.part] 'kept'
				entries.push(MapEntry.make(try textRva + codeOffset(links, t: t) otherwise panic("link: code past memory"), symbol: units.at(u).codeSymbols[i].symbol.clone()))
			end 'kept'
		end 'symbols'
	end 'units'
	sortMapEntries(entries)
	var text = ByteArray.create(0)
	for i in 0 upto entries.count() 'entries'
		var finish = (try textRva + codeSize otherwise panic("link: code past memory")) as Count
		let next = i + 1
		if next < entries.count() 'following'
			finish = entries[next].rva
		end 'following'
		appendHex(text, value: entries[i].rva)
		text.push(32 as Byte)
		appendHex(text, value: try finish - entries[i].rva otherwise panic("link: symbols out of order"))
		text.push(32 as Byte)
		text.append(entries[i].symbol.toByteArray())
		text.push(10 as Byte)
	end 'entries'
	return String.from(text)
end 'symbolMapText'

// sortMapEntries orders the entries by address, keeping the order of those at the same one. The code is laid out in the
// order the entries are found in, so they are sorted already unless a unit defines its symbols out of order.
function sortMapEntries(mutates entries MapEntryList)
	for i in 1 upto entries.count() 'insert'
		var j = i
		while j > 0 'shift'
			let prev = j - 1
			if entries[j].rva < entries[prev].rva 'swap'
				let current = entries[j].clone()
				entries[j] = entries[prev].clone()
				entries[prev] = current
				j = prev
			end 'swap' else 'done'
				break 'shift'
			end 'done'
		end 'shift'
	end 'insert'
end 'sortMapEntries'

typealias SymbolIds = table.StringMap with Count

// defineSymbol records the symbol of an id. A symbol that another id defines too is an internal error unless it is
// repeatable: an instance of a generic function, which every unit that needs it defines. The table finds the first
// unit's, so the others' code is never reached and the mark drops it.
function defineSymbol(mutates symbols SymbolIds, id Count, symbol String, repeatable bool)
	if symbols.has(symbol) 'held'
		if not repeatable 'twice'
			panic("symbol {symbol} is defined twice")
		end 'twice'
		return
	end 'held'
	symbols.insert(symbol.clone(), value: id)
end 'defineSymbol'

// lookupSymbol is the id of the definition of a symbol, or 0 for none.
function lookupSymbol(symbols SymbolIds, symbol String) returns Count
	return match symbols.get(symbol) 'id'
		some(id) gives id
		none gives 0
	end 'id'
end 'lookupSymbol'

// defineSymbols enters what the unit defines into the table, and where each definition is.
function defineSymbols(mutates l LinkUnit, u CodeUnit, index Count, mutates symbols SymbolIds, mutates defined LinkTargetList)
	var id = l.firstID
	for i in 0 upto u.codeSymbols.count() 'code'
		let offset = u.codeSymbols[i].offset
		defined[id] = LinkTarget.make(LinkTargetKind.linkCode, unit: index, part: containing(l.sectionStarts, offset: offset), offset: offset)
		defineSymbol(symbols, id: id, symbol: u.codeSymbols[i].symbol, repeatable: u.codeSymbols[i].instance)
		id = try id + 1 otherwise panic("link: more symbols than memory")
	end 'code'
	for i in 0 upto u.dataSymbols.count() 'data'
		let offset = u.dataSymbols[i].offset
		defined[id] = LinkTarget.make(LinkTargetKind.linkData, unit: index, part: containing(l.pieces, offset: offset), offset: offset)
		defineSymbol(symbols, id: id, symbol: u.dataSymbols[i].symbol, repeatable: u.dataSymbols[i].instance)
		id = try id + 1 otherwise panic("link: more symbols than memory")
	end 'data'
end 'defineSymbols'

// markLive finds the sections and pieces that the entry reaches through the symbols and data their code refers to. The
// layout does not depend on the order they are found in.
function markLive(mutates links LinkUnitList, units LinkUnits, symbols SymbolIds, defined LinkTargetList, start LinkTarget)
	links[start.unit].liveCode[start.part] = true
	var work = LiveSectionList.create(0)
	work.push(LiveSection.make(start.unit, index: start.part))
	var at = 0 as Count
	while at < work.count() 'reach'
		let section = work[at].clone()
		at = at + 1
		markSection(links, u: units.at(section.unit), symbols: symbols, defined: defined, section: section, work: work)
	end 'reach'
end 'markLive'

// markSection reads one live section, of the unit u: the pieces of data and the sections of code it refers to. It queues the
// sections that no one had reached before.
function markSection(mutates links LinkUnitList, u CodeUnit, symbols SymbolIds, defined LinkTargetList, section LiveSection, mutates work LiveSectionList)
	let unit = section.unit
	let begin = links[unit].sections[section.index].clone()
	let nextSection = try section.index + 1 otherwise panic("link: more sections than memory")
	let finish = links[unit].sections[nextSection].clone()
	for j in begin.dataFixups upto finish.dataFixups 'data'
		let piece = containing(links[unit].pieces, offset: u.asm.dataFixups[j].dataOffset)
		links[unit].dataPieces[j] = piece
		links[unit].liveData[piece] = true
	end 'data'
	for j in begin.symbolFixups upto finish.symbolFixups 'symbols'
		// A fixup's id is the same in every mark of a link, which a mark's lookup fills in once: no symbol's id is 0.
		var id = links[unit].targets[j]
		if id == 0 'unlooked'
			id = lookupSymbol(symbols, symbol: u.asm.symbolFixups[j].symbol)
			links[unit].targets[j] = id
		end 'unlooked'
		let target = defined[id].clone()
		if target.kind == LinkTargetKind.linkUndefined 'undefined'
			panic("undefined symbol {u.asm.symbolFixups[j].symbol}")
		end 'undefined' else if target.kind == LinkTargetKind.linkData 'dataTarget'
			links[target.unit].liveData[target.part] = true
		end 'dataTarget' else if target.kind == LinkTargetKind.linkCode 'codeTarget'
			if not links[target.unit].liveCode[target.part] 'fresh'
				links[target.unit].liveCode[target.part] = true
				work.push(LiveSection.make(target.unit, index: target.part))
			end 'fresh'
		end 'codeTarget' else if target.kind != LinkTargetKind.linkPreemptibleCode 'unknown'
			panic("link: unknown target kind {target.kind.name}")
		end 'unknown'
	end 'symbols'
end 'markSection'

// LinkSizes are how much code, read-only data and data the live parts of every unit take.
type LinkSizes
	var code as Count
	var constant as Count
	var data as Count

	static function make(code Count, constant Count, data Count) returns LinkSizes
		return LinkSizes{code: code, constant: constant, data: data}
	end 'make'
end 'LinkSizes'

// ImageParts are the bytes of the image's read-only data and of its data, which the link writes the live pieces into.
type ImageParts
	var constants as ByteArray
	var data as ByteArray

	static function make(consumes constants ByteArray, consumes data ByteArray) returns ImageParts
		return ImageParts{constants: constants, data: data}
	end 'make'
end 'ImageParts'

// layOut places the live sections and pieces, unit after unit, and gives the sizes of the code, the read-only data and the
// data. Each unit places its own parts from its own start, which is aligned; the running sum over the units then gives
// each its base.
function layOut(mutates links LinkUnitList) returns LinkSizes
	var codeSize = 0 as Count
	var constSize = 0 as Count
	var dataSize = 0 as Count
	for i in 0 upto links.count() 'units'
		place(links[i])
		if links[i].hasCode 'code'
			codeSize = alignUp(codeSize, alignment: codeLineBytes)
		end 'code'
		links[i].codeBase = codeSize
		codeSize = try codeSize + links[i].codeSize otherwise panic("link: code past memory")
		if links[i].hasData 'data'
			dataSize = alignUp(dataSize, alignment: linkDataAlignment)
		end 'data'
		links[i].dataBase = dataSize
		dataSize = try dataSize + links[i].dataSize otherwise panic("link: data past memory")
		if links[i].hasConst 'constant'
			constSize = alignUp(constSize, alignment: linkDataAlignment)
		end 'constant'
		links[i].constBase = constSize
		constSize = try constSize + links[i].constSize otherwise panic("link: data past memory")
	end 'units'
	return LinkSizes.make(codeSize, constant: constSize, data: dataSize)
end 'layOut'

// place gives each live section and piece its offset from the start of the unit's code and its data.
function place(mutates l LinkUnit)
	for s in 0 upto l.liveCode.count() 'sections'
		if l.liveCode[s] 'live'
			let alignment = l.sections[s].alignment
			if alignment > codeLineBytes or alignment == 0 'boundary'
				panic("link: a section that asks for a boundary of {alignment} bytes, which the image does not start its code on")
			end 'boundary'
			let length = try l.sections[s + 1].code - l.sections[s].code otherwise panic("link: a section that ends before it starts")
			l.hasCode = true
			l.codeSize = alignUp(l.codeSize, alignment: alignment)
			l.codeSize = try l.codeSize + fitLine(l.codeSize, bytes: length) otherwise panic("link: code past memory")
			l.codeAt[s] = l.codeSize
			l.codeSize = try l.codeSize + length otherwise panic("link: code past memory")
		end 'live'
	end 'sections'
	for p in 0 upto l.liveData.count() 'pieces'
		if not l.liveData[p] 'dropped'
			continue 'pieces'
		end 'dropped'
		let length = try l.pieces[p + 1] - l.pieces[p] otherwise panic("link: a piece that ends before it starts")
		if l.readOnly[p] 'constant'
			l.hasConst = true
			l.constSize = alignUp(l.constSize, alignment: linkDataAlignment)
			l.dataAt[p] = l.constSize
			l.constSize = try l.constSize + length otherwise panic("link: data past memory")
		end 'constant' else 'data'
			l.hasData = true
			l.dataSize = alignUp(l.dataSize, alignment: linkDataAlignment)
			l.dataAt[p] = l.dataSize
			l.dataSize = try l.dataSize + length otherwise panic("link: data past memory")
		end 'data'
	end 'pieces'
end 'place'

// codeOffset is where the definition of a symbol of code ends up in the code.
function codeOffset(links LinkUnitList, t LinkTarget) returns Count
	if t.kind != LinkTargetKind.linkCode 'code'
		panic("link: a target of kind {t.kind.name} has no place in the code")
	end 'code'
	let inSection = try t.offset - links[t.unit].sections[t.part].code otherwise panic("link: a definition before its section")
	return try links[t.unit].codeBase + links[t.unit].codeAt[t.part] + inSection otherwise panic("link: code past memory")
end 'codeOffset'

// pieceRva is the address in the image of the byte at an offset of a unit's data, in a live piece: in the image's read-only
// data or its data, by the piece.
function pieceRva(l LinkUnit, piece Count, offset Count, image Image) returns Count
	let inPiece = try offset - l.pieces[piece] otherwise panic("link: a reference before its piece")
	if l.readOnly[piece] 'constant'
		return try image.constRva + l.constBase + l.dataAt[piece] + inPiece otherwise panic("link: an address past the image")
	end 'constant'
	return try image.dataRva + l.dataBase + l.dataAt[piece] + inPiece otherwise panic("link: an address past the image")
end 'pieceRva'

// copyRange puts the bytes of src from one offset up to another at an offset of dest.
function copyRange(mutates dest ByteArray, at Count, src ByteArray, begin Count, finish Count)
	for i in begin upto finish 'each'
		dest[try at + (i - begin) otherwise panic("link: a copy past memory")] = src[i]
	end 'each'
end 'copyRange'

// appendRange puts the bytes of src from one offset up to another at the end of dest.
function appendRange(mutates dest ByteArray, src ByteArray, begin Count, finish Count)
	for i in begin upto finish 'each'
		dest.push(src[i])
	end 'each'
end 'appendRange'

// linkPatch makes the field of a kind at pos of the code, which sits at textRva, reach target, an address of the image.
function linkPatch(mutates code ByteArray, kind FixupKind, pos Count, textRva Count, target Count)
	match kind 'kind'
		rel32 then patchLinkRel32(code, pos: pos, textRva: textRva, target: target)
		branch26 or
		branch19 then arm64PatchBranch(code, kind: kind, at: pos, distance: linkDistance(pos, textRva: textRva, target: target))
		page21 then arm64PatchPages(code, at: pos, place: try textRva + pos otherwise panic("link: an address past the image"), target: target)
		pageOffset12 or
		pageOffset12Word then arm64PatchPageOffset(code, kind: kind, at: pos, target: target)
	end 'kind'
end 'linkPatch'

// linkDistance is how far target is from the instruction at pos of the code, which sits at textRva, in bytes.
function linkDistance(pos Count, textRva Count, target Count) returns FullRangeInt
	let place = try textRva + pos otherwise panic("link: an address past the image")
	return try (target as FullRangeInt) - (place as FullRangeInt) otherwise panic("link: a reference past the range of the image")
end 'linkDistance'

// patchLinkRel32 makes the 32-bit field at pos, which counts from its own end, reach target.
function patchLinkRel32(mutates code ByteArray, pos Count, textRva Count, target Count)
	let after = try textRva + pos + linkFieldBytes otherwise panic("link: an address past the image")
	let relative = try (target as FullRangeInt) - (after as FullRangeInt) otherwise panic("link: a reference past the range of the image")
	patch32(code, at: pos, value: try relative as Imm32 otherwise panic("link: a reference past 2 GiB"))
end 'patchLinkRel32'

// copyAndPatch puts the live sections and pieces of a unit, u at place unit of the layout, into the code and the data of the
// image and fills in the addresses they refer to. A section moves as a whole, so a fixup keeps its place in it. The units
// come in the order of their places, so the code is written in that order, with traps in the gaps that align a section.
function copyAndPatch(mutates code ByteArray, mutates parts ImageParts, links LinkUnitList, unit Count, u CodeUnit, defined LinkTargetList, image Image, imports LinkImports, tableAt Count, arch ast.TargetArch)
	let l = links[unit].clone()
	for p in 0 upto l.liveData.count() 'pieces'
		if not l.liveData[p] 'dropped'
			continue 'pieces'
		end 'dropped'
		if l.readOnly[p] 'constant'
			copyRange(parts.constants, at: try l.constBase + l.dataAt[p] otherwise panic("link: data past memory"), src: u.data.bytes, begin: l.pieces[p], finish: l.pieces[p + 1])
		end 'constant' else 'data'
			copyRange(parts.data, at: try l.dataBase + l.dataAt[p] otherwise panic("link: data past memory"), src: u.data.bytes, begin: l.pieces[p], finish: l.pieces[p + 1])
		end 'data'
	end 'pieces'
	for s in 0 upto l.liveCode.count() 'sections'
		if not l.liveCode[s] 'dropped'
			continue 'sections'
		end 'dropped'
		let begin = l.sections[s].clone()
		let finish = l.sections[s + 1].clone()
		let at = try l.codeBase + l.codeAt[s] otherwise panic("link: code past memory")
		encodeTraps(code, arch: arch, bytes: try at - code.count() otherwise panic("link: sections out of the order of their places"))
		appendRange(code, src: u.asm.code, begin: begin.code, finish: finish.code)
		for j in begin.dataFixups upto finish.dataFixups 'dataFixups'
			let fixup = u.asm.dataFixups[j].clone()
			let target = pieceRva(l, piece: l.dataPieces[j], offset: fixup.dataOffset, image: image)
			linkPatch(code, kind: fixup.kind, pos: movedPos(at, fixupPos: fixup.pos, sectionStart: begin.code), textRva: image.textRva, target: target)
		end 'dataFixups'
		for j in begin.importFixups upto finish.importFixups 'importFixups'
			let fixup = u.asm.importFixups[j].clone()
			let index = imports.slotOf(fixup.name)
			if index >= image.importSlots 'slot'
				panic("link: a call of an import that the executable has no slot for")
			end 'slot'
			let slot = try index * importSlotBytes otherwise panic("link: an import past memory")
			linkPatch(code, kind: fixup.kind, pos: movedPos(at, fixupPos: fixup.pos, sectionStart: begin.code), textRva: image.textRva, target: try image.iatRva + slot otherwise panic("link: an address past the image"))
		end 'importFixups'
		for j in begin.symbolFixups upto finish.symbolFixups 'symbolFixups'
			let target = defined[l.targets[j]].clone()
			var address = 0 as Count
			if target.kind == LinkTargetKind.linkPreemptibleCode 'table'
				address = try image.dataRva + tableAt otherwise panic("link: an address past the image")
			end 'table' else if target.kind == LinkTargetKind.linkData 'dataTarget'
				address = pieceRva(links[target.unit], piece: target.part, offset: target.offset, image: image)
			end 'dataTarget' else if target.kind == LinkTargetKind.linkCode 'codeTarget'
				address = try image.textRva + codeOffset(links, t: target) otherwise panic("link: an address past the image")
			end 'codeTarget' else 'unknown'
				panic("link: a live fixup has a target of kind {target.kind.name}")
			end 'unknown'
			let fixup = u.asm.symbolFixups[j].clone()
			linkPatch(code, kind: fixup.kind, pos: movedPos(at, fixupPos: fixup.pos, sectionStart: begin.code), textRva: image.textRva, target: address)
		end 'symbolFixups'
	end 'sections'
end 'copyAndPatch'

// LinkImports are the library functions an executable imports, which are the ones its live sections call and no other:
// the names its table binds, in the order of their slots, and the function's name of each slot that a fixup names. A PE
// binds its DLL functions in the order of their names, by byte; a Mach-O binds its libSystem functions in the order of
// macosImports, under their symbols, since dyld binds each slot at launch. A static ELF imports nothing.
type LinkImports
	var names as NameList
	var called as NameList

	static function of(system ast.TargetSystem, links LinkUnitList, units LinkUnits) returns LinkImports
		return match ast.imageFormatOf(system) 'format'
			pe gives LinkImports.dll(calledNames(links, units: units))
			elf gives LinkImports{names: NameList.create(0), called: NameList.create(0)}
			machO gives LinkImports.libSystem(calledNames(links, units: units))
		end 'format'
	end 'of'

	// dll is a PE's table: each DLL function called, under its own name.
	static function dll(consumes called NameList) returns LinkImports
		var sorted = called
		sortNames(sorted)
		return LinkImports{names: sorted.clone(), called: sorted}
	end 'dll'

	// libSystem is a Mach-O's table: each libSystem function called, in the order of macosImports, under its symbol.
	static function libSystem(called NameList) returns LinkImports
		let all = macosImports()
		var indices = CountList.create(0)
		var ordered = NameList.create(0)
		for i in 0 upto all.count() 'listed'
			if containsName(called, name: all[i]) 'calledHere'
				indices.push(i)
				ordered.push(all[i].clone())
			end 'calledHere'
		end 'listed'
		for i in 0 upto called.count() 'known'
			_ = macosImportIndex(called[i])
		end 'known'
		return LinkImports{names: machoSymbolsOf(indices), called: ordered}
	end 'libSystem'

	// slotOf is the slot of the library function that a live fixup names.
	function slotOf(name String) returns Count
		for i in 0 upto called.count() 'slots'
			if called[i] == name 'found'
				return i
			end 'found'
		end 'slots'
		panic("link: a live call of the library function {name}, which the import table does not hold")
	end 'slotOf'
end 'LinkImports'

// calledNames are the library functions that the live sections of the units call, each once, in the order of the first
// call in the units' order.
function calledNames(links LinkUnitList, units LinkUnits) returns NameList
	var names = NameList.create(0)
	for u in 0 upto links.count() 'units'
		for s in 0 upto links[u].liveCode.count() 'sections'
			if links[u].liveCode[s] 'live'
				let next = s + 1
				for j in links[u].sections[s].importFixups upto links[u].sections[next].importFixups 'fixups'
					if not containsName(names, name: units.at(u).asm.importFixups[j].name) 'new'
						names.push(units.at(u).asm.importFixups[j].name.clone())
					end 'new'
				end 'fixups'
			end 'live'
		end 'sections'
	end 'units'
	return names
end 'calledNames'

function containsName(names NameList, name String) returns bool
	for i in 0 upto names.count() 'names'
		if names[i] == name 'found'
			return true
		end 'found'
	end 'names'
	return false
end 'containsName'

// sortNames puts names in the order of their bytes, an insertion sort: a table holds a few dozen.
function sortNames(mutates names NameList)
	for i in 1 upto names.count() 'insert'
		var j = i
		while j > 0 and nameBefore(names[j], b: names[j - 1]) 'down'
			let earlier = j - 1
			let moved = exchange(names[j], value: "")
			let before = exchange(names[earlier], value: moved)
			names[j] = before
			j = earlier
		end 'down'
	end 'insert'
end 'sortNames'

// nameBefore is whether a comes before b in the order of their bytes.
function nameBefore(a String, b String) returns bool
	let n = a.byteLength() if a.byteLength() < b.byteLength() else b.byteLength()
	for i in 0 upto n 'bytes'
		if a.byteAt(i) != b.byteAt(i) 'differ'
			return a.byteAt(i) < b.byteAt(i)
		end 'differ'
	end 'bytes'
	return a.byteLength() < b.byteLength()
end 'nameBefore'

// movedPos is where a fixup of a section is once the section is at an offset of the image's code.
function movedPos(at Count, fixupPos Count, sectionStart Count) returns Count
	let inSection = try fixupPos - sectionStart otherwise panic("link: a fixup before its section")
	return try at + inSection otherwise panic("link: code past memory")
end 'movedPos'

// namedByLiveCode is whether a live section refers to the symbol of an id: the mark gave the target of each fixup of a
// live section.
function namedByLiveCode(links LinkUnitList, id Count) returns bool
	for u in 0 upto links.count() 'units'
		for s in 0 upto links[u].liveCode.count() 'sections'
			if not links[u].liveCode[s] 'dropped'
				continue 'sections'
			end 'dropped'
			let next = s + 1
			for j in links[u].sections[s].symbolFixups upto links[u].sections[next].symbolFixups 'fixups'
				if links[u].targets[j] == id 'named'
					return true
				end 'named'
			end 'fixups'
		end 'sections'
	end 'units'
	return false
end 'namedByLiveCode'

// PreemptibleTable is the table of the code that the monitor may stop a green thread in (g.preemptibleCode), which the
// runtime searches with the address a thread was stopped at: the live preemptible sections (CodeSection), those that
// follow each other in the layout as one range, in the order of the code. The link puts it after the data of every
// unit, and only when live code names it, so a program with no green thread has none. Its words are the count of the
// ranges, then each range's start and end as how far below the table they are, since the code comes before the data in
// both images and the distance is the same wherever the image is loaded.
type PreemptibleTable
	var wanted as bool
	// starts and ends are where each range begins and ends in the image's code.
	var starts as CountList
	var ends as CountList

	static function of(links LinkUnitList, wanted bool) returns PreemptibleTable
		var starts = CountList.create(0)
		var ends = CountList.create(0)
		if wanted 'wanted'
			var open = false
			for u in 0 upto links.count() 'units'
				for s in 0 upto links[u].liveCode.count() 'sections'
					if not links[u].liveCode[s] 'dropped'
						continue 'sections'
					end 'dropped'
					if not links[u].sections[s].preemptible 'closed'
						open = false
						continue 'sections'
					end 'closed'
					let at = try links[u].codeBase + links[u].codeAt[s] otherwise panic("link: code past memory")
					let length = try links[u].sections[s + 1].code - links[u].sections[s].code otherwise panic("link: a section that ends before it starts")
					let finish = try at + length otherwise panic("link: code past memory")
					if open 'extend'
						ends[ir.pred(ends.count())] = finish
					end 'extend' else 'begin'
						starts.push(at)
						ends.push(finish)
						open = true
					end 'begin'
				end 'sections'
			end 'units'
		end 'wanted'
		return PreemptibleTable{wanted: wanted, starts: starts, ends: ends}
	end 'of'

	// bytes is the room the table takes in the data: none when no code names it.
	function bytes() returns Count
		if not wanted 'none'
			return 0
		end 'none'
		return try (1 + starts.count() * 2) * wordBytes otherwise panic("link: data past memory")
	end 'bytes'

	// write puts the table at an offset of the image's data.
	function write(mutates data ByteArray, at Count, image Image)
		if not wanted 'none'
			return
		end 'none'
		let table = try image.dataRva + at otherwise panic("link: an address past the image")
		patch64(data, at: at, value: starts.count())
		for i in 0 upto starts.count() 'ranges'
			let slot = try at + (1 + i * 2) * wordBytes otherwise panic("link: data past memory")
			patch64(data, at: slot, value: belowTable(try image.textRva + starts[i] otherwise panic("link: an address past the image"), table: table))
			patch64(data, at: try slot + wordBytes otherwise panic("link: data past memory"), value: belowTable(try image.textRva + ends[i] otherwise panic("link: an address past the image"), table: table))
		end 'ranges'
	end 'write'
end 'PreemptibleTable'

// belowTable is how far an address of the code is below the table of preemptible code.
function belowTable(address Count, table Count) returns Count
	return try table - address otherwise panic("link: the image's code is not below its data")
end 'belowTable'
