	sel.emit(mi8)
	let r9 = sel.edgeTo(fn, target: vYes, start: ir.branchTrueArgsStart(ins), count: ir.branchTrueArgsCount(ins))
	var mi10 = newTarget(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi10.ref = r9.ref
	mi10.aux = r9.aux
	sel.emit(mi10)
	return true
end 'rule195'

// x64.rules:197: (branch c:(cmp x y) [yes] [no]) && sel.fuses(fn, r: c) => (CmpRegReg x y) (JccRel32 [negated(condOf(sel, fn: fn, r: c))] [no]) (JmpRel32 [yes])
function rule197(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	let reg1 = ir.branchCond(ins)
	let vC = reg1
	if not sel.definedBy(fn, r: reg1, op: ir.Opcode.opCmp) 'm1'
		return false
	end 'm1'
	let def2 = sel.defOf(reg1)
	let vX = ir.cmpLeft(fn.instrs[def2])
	let vY = ir.cmpRight(fn.instrs[def2])
	let vYes = ir.branchIfTrue(ins)
	let vNo = ir.branchIfFalse(ins)
	if not (sel.fuses(fn, r: vC)) 'm2'
		return false
	end 'm2'
	var mi3 = newTarget(X64Form.cmpRegReg, a: vregOf(vX), b: vregOf(vY), c: noMReg, aux: 0, imm: 0)
	sel.emit(mi3)
	let r4 = sel.edgeTo(fn, target: vNo, start: ir.branchFalseArgsStart(ins), count: ir.branchFalseArgsCount(ins))
	var mi5 = newTarget(X64Form.jccRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi5.cond = negated(condOf(sel, fn: fn, r: vC))
	mi5.ref = r4.ref
	mi5.aux = r4.aux
	sel.emit(mi5)
	let r6 = sel.edgeTo(fn, target: vYes, start: ir.branchTrueArgsStart(ins), count: ir.branchTrueArgsCount(ins))
	var mi7 = newTarget(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi7.ref = r6.ref
	mi7.aux = r6.aux
	sel.emit(mi7)
	return true
end 'rule197'

// x64.rules:198: (branch c [yes] [no]) => (TestRegReg c c) (JccRel32 [X64CondCode.equal] [no]) (JmpRel32 [yes])
function rule198(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	let vC = ir.branchCond(ins)
	let vYes = ir.branchIfTrue(ins)
	let vNo = ir.branchIfFalse(ins)
	var mi1 = newTarget(X64Form.testRegReg, a: vregOf(vC), b: vregOf(vC), c: noMReg, aux: 0, imm: 0)
	sel.emit(mi1)
	let r2 = sel.edgeTo(fn, target: vNo, start: ir.branchFalseArgsStart(ins), count: ir.branchFalseArgsCount(ins))
	var mi3 = newTarget(X64Form.jccRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi3.cond = X64CondCode.equal
	mi3.ref = r2.ref
	mi3.aux = r2.aux
	sel.emit(mi3)
	let r4 = sel.edgeTo(fn, target: vYes, start: ir.branchTrueArgsStart(ins), count: ir.branchTrueArgsCount(ins))
	var mi5 = newTarget(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi5.ref = r4.ref
	mi5.aux = r4.aux
	sel.emit(mi5)
	return true
end 'rule198'

// x64.rules:199: (switch) => (emitSwitch)
function rule199(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	emitSwitch(sel, fn: fn, ins: ins)
	return true
end 'rule199'

// x64.rules:200: (ret) => (emitRet)
function rule200(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	emitRet(sel, fn: fn, ins: ins)
	return true
end 'rule200'

// x64.rules:201: (throw) => (emitThrow)
function rule201(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	emitThrow(sel, fn: fn, ins: ins)
	return true
end 'rule201'

// x64.rules:202: (trap) => (Ud2)
function rule202(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	var mi1 = newTarget(X64Form.ud2, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	sel.emit(mi1)
	return true
end 'rule202'
