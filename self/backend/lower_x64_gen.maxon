end 'rule227'

// x64.rules:228: (throw) => (emitThrow)
function rule228(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	emitThrow(sel, fn: fn, ins: ins)
	return true
end 'rule228'

// x64.rules:229: (trap) => (Ud2)
function rule229(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	var mi1 = newTarget(X64Form.ud2, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	sel.emit(mi1)
	return true
end 'rule229'
