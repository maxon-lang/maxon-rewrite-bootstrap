// x64.rules:137: (jump [b]) => (JmpRel32 [b])
function rule137(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	let vB = ir.jumpTarget(ins)
	let r1 = sel.edgeTo(fn, target: vB, start: ir.jumpArgsStart(ins), count: ir.jumpArgsCount(ins))
	var mi2 = newTarget(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi2.ref = r1.ref
	mi2.aux = r1.aux
	sel.emit(mi2)
	return true
end 'rule137'

// x64.rules:138: (branch c [yes] [no]) => (TestRegReg c c) (JccRel32 [X64CondCode.equal] [no]) (JmpRel32 [yes])
function rule138(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	let vC = ir.branchCond(ins)
	let vYes = ir.branchIfTrue(ins)
	let vNo = ir.branchIfFalse(ins)
	var mi1 = newTarget(X64Form.testRegReg, a: vregOf(vC), b: vregOf(vC), c: noMReg, aux: 0, imm: 0)
	sel.emit(mi1)
	let r2 = sel.edgeTo(fn, target: vNo, start: ir.branchFalseArgsStart(ins), count: ir.branchFalseArgsCount(ins))
	var mi3 = newTarget(X64Form.jccRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi3.cond = X64CondCode.equal
	mi3.ref = r2.ref
	mi3.aux = r2.aux
	sel.emit(mi3)
	let r4 = sel.edgeTo(fn, target: vYes, start: ir.branchTrueArgsStart(ins), count: ir.branchTrueArgsCount(ins))
	var mi5 = newTarget(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi5.ref = r4.ref
	mi5.aux = r4.aux
	sel.emit(mi5)
	return true
end 'rule138'

