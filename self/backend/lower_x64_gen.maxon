// x64.rules:225: (branch c:(cmp x (const [k])) [yes] [no]) && fitsImm32(k) and sel.fuses(fn, r: c) => (CmpRegImm x [k]) (JccRel32 [negated(condOf(sel, fn: fn, r: c))] [no]) (JmpRel32 [yes])
function x64Rule225(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	let reg1 = ir.branchCond(ins)
	let vC = reg1
	if not sel.definedBy(fn, r: reg1, op: ir.Opcode.opCmp) 'm1'
		return false
	end 'm1'
	let def2 = sel.defOf(reg1)
	let vX = ir.cmpLeft(fn.instrs[def2])
	let reg3 = ir.cmpRight(fn.instrs[def2])
	if not sel.definedBy(fn, r: reg3, op: ir.Opcode.opConst) 'm2'
		return false
	end 'm2'
	let def4 = sel.defOf(reg3)
	let vK = ir.constValue(fn.instrs[def4])
	let vYes = ir.branchIfTrue(ins)
	let vNo = ir.branchIfFalse(ins)
	if not (fitsImm32(vK) and sel.fuses(fn, r: vC)) 'm3'
		return false
	end 'm3'
	let i5 = try (vK) as Imm32 otherwise panic("backend: a value of x64.rules:225 does not fit Imm32")
	var mi6 = newX64Target(chooseCmpRegImm(i5), a: vregOf(vX), b: noMReg, c: noMReg, aux: 0, imm: i5 as FullRangeInt)
	sel.emit(mi6)
	let r7 = sel.edgeTo(fn, target: vNo, start: ir.branchFalseArgsStart(ins), count: ir.branchFalseArgsCount(ins))
	var mi8 = newX64Target(X64Form.jccRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi8.cond = negated(condOf(sel, fn: fn, r: vC))
	mi8.ref = r7.ref
	mi8.aux = r7.aux
	sel.emit(mi8)
	let r9 = sel.edgeTo(fn, target: vYes, start: ir.branchTrueArgsStart(ins), count: ir.branchTrueArgsCount(ins))
	var mi10 = newX64Target(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi10.ref = r9.ref
	mi10.aux = r9.aux
	sel.emit(mi10)
	return true
end 'x64Rule225'

