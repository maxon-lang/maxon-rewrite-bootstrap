	var mi3 = newTarget(X64Form.roundsdXmm0Xmm0Imm8, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: i2 as FullRangeInt)
	sel.emit(mi3)
	let t4 = sel.resultOf(ins.dst)
	var mi5 = newTarget(X64Form.movqRegXmm0, a: t4, b: noMReg, c: noMReg, aux: 0, imm: 0)
	sel.emit(mi5)
	return true
end 'rule111'

// x64.rules:113: (intToFloat.!unsigned x) => (Cvtsi2sdXmm0Reg x) (MovqRegXmm0 r)
function rule113(mutates sel Selector, fn ir.IrFunction, ins ir.Instr) returns bool
	if ir.intToFloatUnsigned(ins) 'm1'
		return false
	end 'm1'
	let vX = ir.intToFloatSrc(ins)
	var mi1 = newTarget(X64Form.cvtsi2sdXmm0Reg, a: vregOf(vX), b: noMReg, c: noMReg, aux: 0, imm: 0)
	sel.emit(mi1)
	let t2 = sel.resultOf(ins.dst)
	var mi3 = newTarget(X64Form.movqRegXmm0, a: t2, b: noMReg, c: noMReg, aux: 0, imm: 0)
	sel.emit(mi3)
	return true
end 'rule113'

