// x64.rules:210: (jump [b]) => (JmpRel32 [b])
function rule210(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	let vB = ir.jumpTarget(ins)
	let r1 = sel.edgeTo(fn, target: vB, start: ir.jumpArgsStart(ins), count: ir.jumpArgsCount(ins))
	var mi2 = newTarget(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi2.ref = r1.ref
	mi2.aux = r1.aux
	sel.emit(mi2)
	return true
end 'rule210'

// x64.rules:211: (branch c:(cmp x (const [0])) [yes] [no]) && sel.fuses(fn, r: c) => (TestRegReg x x) (JccRel32 [negated(condOf(sel, fn: fn, r: c))] [no]) (JmpRel32 [yes])
function rule211(mutates sel Selector, fn ir.IrFunction, ins ir.Term) returns bool
	let reg1 = ir.branchCond(ins)
	let vC = reg1
	if not sel.definedBy(fn, r: reg1, op: ir.Opcode.opCmp) 'm1'
		return false
	end 'm1'
	let def2 = sel.defOf(reg1)
	let vX = ir.cmpLeft(fn.instrs[def2])
	let reg3 = ir.cmpRight(fn.instrs[def2])
	if not sel.definedBy(fn, r: reg3, op: ir.Opcode.opConst) 'm2'
		return false
	end 'm2'
	let def4 = sel.defOf(reg3)
	if ir.constValue(fn.instrs[def4]) != 0 'm3'
		return false
	end 'm3'
	let vYes = ir.branchIfTrue(ins)
	let vNo = ir.branchIfFalse(ins)
	if not (sel.fuses(fn, r: vC)) 'm4'
		return false
	end 'm4'
	var mi5 = newTarget(X64Form.testRegReg, a: vregOf(vX), b: vregOf(vX), c: noMReg, aux: 0, imm: 0)
	sel.emit(mi5)
	let r6 = sel.edgeTo(fn, target: vNo, start: ir.branchFalseArgsStart(ins), count: ir.branchFalseArgsCount(ins))
	var mi7 = newTarget(X64Form.jccRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi7.cond = negated(condOf(sel, fn: fn, r: vC))
	mi7.ref = r6.ref
	mi7.aux = r6.aux
	sel.emit(mi7)
	let r8 = sel.edgeTo(fn, target: vYes, start: ir.branchTrueArgsStart(ins), count: ir.branchTrueArgsCount(ins))
	var mi9 = newTarget(X64Form.jmpRel32, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi9.ref = r8.ref
	mi9.aux = r8.aux
	sel.emit(mi9)
	return true
end 'rule211'

