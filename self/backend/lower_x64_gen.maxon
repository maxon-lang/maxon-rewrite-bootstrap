	emitUnsignedToFloat(sel, fn: fn, ins: ins)
	return true
end 'rule114'

// x64.rules:115: (floatToInt x) => (MovqXmm0Reg x) (Cvttsd2siRaxXmm0) (Copy r rax)
function rule115(mutates sel Selector, fn ir.IrFunction, ins ir.Instr) returns bool
	let vX = ir.floatToIntSrc(ins)
	var mi1 = newTarget(X64Form.movqXmm0Reg, a: vregOf(vX), b: noMReg, c: noMReg, aux: 0, imm: 0)
	sel.emit(mi1)
	var mi2 = newTarget(X64Form.cvttsd2siRaxXmm0, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	sel.emit(mi2)
	let t3 = sel.resultOf(ins.dst)
	sel.emit(newCopy(t3, src: physReg(X64Register.rax)))
	return true
end 'rule115'

