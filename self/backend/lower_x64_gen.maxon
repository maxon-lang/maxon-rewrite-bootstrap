		return false
	end 'm1'
	emitStringConst(sel, fn: fn, ins: ins)
	return true
end 'x64Rule20'

// x64.rules:21: (const [c]) && sel.inXmm(ins.dst) => (MovsdRegRip r [sel.floatRef(c)])
function x64Rule21(mutates sel Selector, fn ir.IrFunction, ins ir.Instr) returns bool
	let vC = ir.constValue(ins)
	if not (sel.inXmm(ins.dst)) 'm1'
		return false
	end 'm1'
	let r1 = sel.floatRef(vC)
	let t2 = sel.resultOf(ins.dst)
	var mi3 = newX64Target(X64Form.movsdRegRip, a: t2, b: noMReg, c: noMReg, aux: 0, imm: 0)
	mi3.ref = r1.ref
	mi3.aux = r1.aux
	sel.emit(mi3)
	return true
end 'x64Rule21'

// x64.rules:22: (const [c]) => (MovRegImm r [c])
function x64Rule22(mutates sel Selector, fn ir.IrFunction, ins ir.Instr) returns bool
	let vC = ir.constValue(ins)
	let i1 = (vC) as FullRangeInt
	let t2 = sel.resultOf(ins.dst)
	var mi3 = newX64Target(chooseMovRegImm(i1), a: t2, b: noMReg, c: noMReg, aux: 0, imm: i1)
	sel.emit(mi3)
	return true
end 'x64Rule22'

