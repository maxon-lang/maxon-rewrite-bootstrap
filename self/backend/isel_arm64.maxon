// arm64's instruction selection, as isel_x64.maxon is x64's: the primitives that the shared helpers and the driver ask of
// the architecture (isel.maxon), arm64's half of the calls (AAPCS64's places of the internal convention, the arguments
// past its registers stored at the stack pointer in the room the frame keeps for them, a system call), the prologue that
// takes the parameters and clears the managed slots, the frame's slots above the frame record, and the helpers that
// arm64.rules names for what only arm64 does: an immediate that no field holds, an offset that no access holds, a
// checked division, a shift by a count, compare-exchange and a bounds check.

extension Selector
	// arm64ContextRead is how a thread of the system compiled for reads its context.
	function arm64ContextRead() returns Arm64ThreadContext
		return arm64ThreadContext(system)
	end 'arm64ContextRead'

	function arm64Instr(mutates self, form Arm64Form, a MReg, b MReg, c MReg, aux Imm32, imm FullRangeInt)
		mir.emit(newArm64Target(form, a: a, b: b, c: c, aux: aux, imm: imm))
	end 'arm64Instr'

	// arm64Define is a new register that a form defines from the uses b and c.
	function arm64Define(mutates self, form Arm64Form, b MReg, c MReg, aux Imm32, imm FullRangeInt) returns MReg
		let d = self.newTemp()
		self.arm64Instr(form, a: d, b: b, c: c, aux: aux, imm: imm)
		return d
	end 'arm64Define'

	// arm64Refer writes a form whose last field refers to what refers names, after the register operands a and b.
	function arm64Refer(mutates self, form Arm64Form, a MReg, b MReg, refers Referent)
		mir.emit(newArm64Referring(form, a: a, b: b, ref: refers.ref, aux: refers.aux))
	end 'arm64Refer'

	// arm64ConstantInto sets dst to a word: in one move where the ladder of the word is one, or where it is a logical
	// immediate, and otherwise by the ladder, which is one machine instruction (MovRegWord) so that the allocator can write
	// it again before a use instead of keeping or spilling its register.
	function arm64ConstantInto(mutates self, dst MReg, value FullRangeInt)
		let word = value as ir.Word
		if arm64OneMove(word) 'one'
			let form = Arm64Form.movnRegImm if arm64LadderInverted(value) else Arm64Form.movzRegImm
			self.arm64Instr(form, a: dst, b: noMReg, c: noMReg, aux: arm64OneMoveShift(word) as Imm32, imm: arm64OneMoveHalfword(word) as FullRangeInt)
			return
		end 'one'
		if arm64IsLogicalImmediate(value) 'mask'
			self.arm64Instr(Arm64Form.movRegMask, a: dst, b: noMReg, c: noMReg, aux: 0, imm: value)
			return
		end 'mask'
		self.arm64Instr(Arm64Form.movRegWord, a: dst, b: noMReg, c: noMReg, aux: 0, imm: value)
	end 'arm64ConstantInto'

	// arm64AddConst is a register that src plus a constant defines: an add or a sub of an immediate where 12 bits hold
	// it, the same shifted by 12 and the rest added where 24 bits hold it, and otherwise the add of a register that holds
	// it. It leaves the flags as they are.
	function arm64AddConst(mutates self, src MReg, value FullRangeInt) returns MReg
		let word = value as ir.Word
		if arm64HoldsImm12(value) 'add'
			return self.arm64Define(Arm64Form.addRegImm, b: src, c: noMReg, aux: 0, imm: value)
		end 'add'
		if arm64HoldsNegatedImm12(value) 'sub'
			return self.arm64Define(Arm64Form.subRegImm, b: src, c: noMReg, aux: 0, imm: arm64Negated(value))
		end 'sub'
		if value > 0 and value < arm64WideImmediate 'split'
			let high = self.arm64Define(Arm64Form.addRegImmHigh, b: src, c: noMReg, aux: 0, imm: value shr arm64Imm12Bits)
			if (value and arm64Imm12Max) == 0 'whole'
				return high
			end 'whole'
			return self.arm64Define(Arm64Form.addRegImm, b: high, c: noMReg, aux: 0, imm: value and arm64Imm12Max)
		end 'split'
		let held = self.constant(value)
		return self.arm64Define(Arm64Form.addRegReg, b: src, c: held, aux: 0, imm: 0)
	end 'arm64AddConst'

	// arm64Load loads the word at base plus disp into dst, into a d register for a float: by the scaled offset of the
	// load where it holds disp, by the unscaled one where that does, and otherwise at the address added up first.
	function arm64Load(mutates self, dst MReg, base MReg, disp FullRangeInt, float bool)
		if float 'float'
			if arm64LdrDOffHolds(disp) 'scaled'
				self.arm64Instr(Arm64Form.ldrDOff, a: dst, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
			end 'scaled' else if arm64LdrDUnscaledHolds(disp) 'unscaled'
				self.arm64Instr(Arm64Form.ldrDUnscaled, a: dst, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
			end 'unscaled' else 'added'
				let at = self.arm64AddConst(base, value: disp)
				self.arm64Instr(Arm64Form.ldrDOff, a: dst, b: at, c: noMReg, aux: 0, imm: 0)
			end 'added'
			return
		end 'float'
		if arm64Ldr64OffHolds(disp) 'scaled'
			self.arm64Instr(Arm64Form.ldr64Off, a: dst, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
		end 'scaled' else if arm64Ldr64UnscaledHolds(disp) 'unscaled'
			self.arm64Instr(Arm64Form.ldr64Unscaled, a: dst, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
		end 'unscaled' else 'added'
			let at = self.arm64AddConst(base, value: disp)
			self.arm64Instr(Arm64Form.ldr64Off, a: dst, b: at, c: noMReg, aux: 0, imm: 0)
		end 'added'
	end 'arm64Load'

	// arm64Store stores src, a float's d register or a word's, at base plus disp, as arm64Load loads it.
	function arm64Store(mutates self, base MReg, disp FullRangeInt, src MReg, float bool)
		if float 'float'
			if arm64StrDOffHolds(disp) 'scaled'
				self.arm64Instr(Arm64Form.strDOff, a: src, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
			end 'scaled' else if arm64StrDUnscaledHolds(disp) 'unscaled'
				self.arm64Instr(Arm64Form.strDUnscaled, a: src, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
			end 'unscaled' else 'added'
				let at = self.arm64AddConst(base, value: disp)
				self.arm64Instr(Arm64Form.strDOff, a: src, b: at, c: noMReg, aux: 0, imm: 0)
			end 'added'
			return
		end 'float'
		if arm64Str64OffHolds(disp) 'scaled'
			self.arm64Instr(Arm64Form.str64Off, a: src, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
		end 'scaled' else if arm64Str64UnscaledHolds(disp) 'unscaled'
			self.arm64Instr(Arm64Form.str64Unscaled, a: src, b: base, c: noMReg, aux: try disp as Imm32 otherwise panic("backend: an offset past 32 bits"), imm: 0)
		end 'unscaled' else 'added'
			let at = self.arm64AddConst(base, value: disp)
			self.arm64Instr(Arm64Form.str64Off, a: src, b: at, c: noMReg, aux: 0, imm: 0)
		end 'added'
	end 'arm64Store'

	// arm64ShiftRightInto is lsr: ubfm of the bits from count up.
	function arm64ShiftRightInto(mutates self, dst MReg, src MReg, count Count)
		self.arm64Instr(Arm64Form.ubfmRegReg, a: dst, b: src, c: noMReg, aux: arm64SignShift as Imm32, imm: try count as FullRangeInt otherwise panic("backend: a shift past the word"))
	end 'arm64ShiftRightInto'

	// arm64ShiftLeftInto is lsl: ubfm that moves the low bits up by count.
	function arm64ShiftLeftInto(mutates self, dst MReg, src MReg, count Count)
		let shift = try count as ir.Word otherwise panic("backend: a shift past the word")
		let imms = try arm64LslImms(shift) as Imm32 otherwise panic("backend: a shift past the word")
		self.arm64Instr(Arm64Form.ubfmRegReg, a: dst, b: src, c: noMReg, aux: imms, imm: try arm64LslImmr(shift) as FullRangeInt otherwise panic("backend: a shift past the word"))
	end 'arm64ShiftLeftInto'

	function arm64ReferAddressInto(mutates self, dst MReg, refers Referent)
		let page = self.newTemp()
		self.arm64Refer(Arm64Form.adrp, a: page, b: noMReg, refers: refers)
		self.arm64Refer(Arm64Form.addPageOff, a: dst, b: page, refers: refers)
	end 'arm64ReferAddressInto'

	function arm64LoadInto(mutates self, dst MReg, base MReg, disp Imm32)
		self.arm64Load(dst, base: base, disp: disp as FullRangeInt, float: false)
	end 'arm64LoadInto'

	function arm64StoreWord(mutates self, base MReg, disp Imm32, src MReg)
		self.arm64Store(base, disp: disp as FullRangeInt, src: src, float: false)
	end 'arm64StoreWord'

	// arm64StoreImm stores a word at base plus disp: 0 from the zero register, and any other word from a register that
	// holds it.
	function arm64StoreImm(mutates self, base MReg, disp Imm32, value Imm32)
		if value == 0 'zero'
			self.arm64StoreWord(base, disp: disp, src: arm64PhysReg(arm64ZeroRegister))
			return
		end 'zero'
		let held = self.constant(value as FullRangeInt)
		self.arm64StoreWord(base, disp: disp, src: held)
	end 'arm64StoreImm'

	function arm64Address(mutates self, symbol String) returns MReg
		let refers = self.symbolRef(symbol)
		let page = self.newTemp()
		self.arm64Refer(Arm64Form.adrp, a: page, b: noMReg, refers: refers)
		let d = self.newTemp()
		self.arm64Refer(Arm64Form.addPageOff, a: d, b: page, refers: refers)
		return d
	end 'arm64Address'

	// arm64WordAddress is the address of the word at an index of the buffer at base: the index shifted by 3, added.
	function arm64ElementAddress(mutates self, base MReg, index MReg, shift Count) returns MReg
		return self.arm64Define(Arm64Form.addRegRegLsl, b: base, c: index, aux: 0, imm: try shift as FullRangeInt otherwise panic("backend: a shift past the word"))
	end 'arm64ElementAddress'

	function arm64MulImm(mutates self, src MReg, value Count) returns MReg
		let factor = self.newTemp()
		self.arm64ConstantInto(factor, value: try value as FullRangeInt otherwise panic("backend: a factor past the word"))
		return self.arm64Define(Arm64Form.mulRegReg, b: src, c: factor, aux: 0, imm: 0)
	end 'arm64MulImm'

	function arm64LoadIndexedByte(mutates self, base MReg, index MReg, disp Imm32) returns MReg
		var at = base
		if disp != 0 'offset'
			at = self.arm64AddConst(base, value: disp as FullRangeInt)
		end 'offset'
		return self.arm64Define(Arm64Form.ldrbIdx, b: at, c: index, aux: 0, imm: 0)
	end 'arm64LoadIndexedByte'

	function arm64StoreIndexedByte(mutates self, base MReg, index MReg, src MReg)
		self.arm64Instr(Arm64Form.strbIdx, a: src, b: base, c: index, aux: 0, imm: 0)
	end 'arm64StoreIndexedByte'

	function arm64StoreIndexedWord(mutates self, base MReg, index MReg, src MReg)
		self.arm64Instr(Arm64Form.str64Idx, a: src, b: base, c: index, aux: 0, imm: 0)
	end 'arm64StoreIndexedWord'

	function arm64Compare(mutates self, a MReg, b MReg)
		self.arm64Instr(Arm64Form.cmpRegReg, a: a, b: b, c: noMReg, aux: 0, imm: 0)
	end 'arm64Compare'

	// arm64CompareWith compares with an immediate where 12 bits hold the constant or its negation, and with a register
	// that holds it otherwise.
	function arm64CompareWith(mutates self, a MReg, value ir.Word)
		let wanted = value as FullRangeInt
		if arm64HoldsImm12(wanted) 'immediate'
			self.arm64Instr(Arm64Form.cmpRegImm, a: a, b: noMReg, c: noMReg, aux: 0, imm: wanted)
		end 'immediate' else if arm64HoldsNegatedImm12(wanted) 'negated'
			self.arm64Instr(Arm64Form.cmnRegImm, a: a, b: noMReg, c: noMReg, aux: 0, imm: arm64Negated(wanted))
		end 'negated' else 'register'
			let bound = self.constant(wanted)
			self.arm64Compare(a, b: bound)
		end 'register'
	end 'arm64CompareWith'

	// arm64FlagInto sets dst's register by the condition.
	function arm64FlagInto(mutates self, dst ir.Reg, cond MCond)
		let result = self.resultOf(dst)
		self.emit(newArm64Conditional(Arm64Form.csetReg, cond: cond, a: result, ref: MRef.none, aux: 0))
	end 'arm64FlagInto'

	// arm64ZeroInto is the exclusive or of the register with itself, of its class.
	function arm64ZeroInto(mutates self, r MReg, float bool)
		let clear = Arm64Form.eorVec if float else Arm64Form.eorRegReg
		self.arm64Instr(clear, a: r, b: r, c: r, aux: 0, imm: 0)
	end 'arm64ZeroInto'

	// arm64PassArgs puts the arguments of the call being selected where the internal convention has the callee read them:
	// those on the stack stored at the stack pointer, in the room the frame keeps for the most any call of the function
	// passes there, then the others copied into their registers. It is the registers they are in.
	function arm64PassArgs(mutates self) returns RegMask
		let stacked = arm64PlaceArgs(callFloats, places: places)
		let sp = arm64PhysReg(Arm64Register.sp)
		for i in 0 upto callArgs.count() 'stack'
			if arm64IsStackPlace(places[i]) 'stored'
				let at = try arm64StackSlotOf(places[i]) * wordBytes otherwise panic("backend: more arguments than memory")
				let v = callArgs[i]
				let float = callFloats[i]
				self.arm64Store(sp, disp: arm64Disp(at), src: v, float: float)
			end 'stored'
		end 'stack'
		let room = try stacked * wordBytes otherwise panic("backend: more arguments than memory")
		mir.outgoingBytes = maxOf(mir.outgoingBytes, b: room)
		var argRegs = 0 as RegMask
		for k in 0 upto callArgs.count() 'registers'
			let place = places[k]
			if not arm64IsStackPlace(place) 'register'
				let v = callArgs[k]
				self.copy(placeRegister(place), src: v)
				argRegs = argRegs or regBit(physicalNumber(placeRegister(place)))
			end 'register'
		end 'registers'
		return argRegs
	end 'arm64PassArgs'

	// arm64CallForm emits a call of the internal convention with the arguments of the call being selected.
	function arm64CallForm(mutates self, form Arm64Form, code MReg, refers Referent)
		let argRegs = self.arm64PassArgs()
		mir.emit(newArm64Call(form, a: code, ref: refers.ref, aux: refers.aux, argRegs: argRegs))
		callArgs.clear()
		callFloats.clear()
	end 'arm64CallForm'

	function arm64CallSymbol(mutates self, symbol String)
		let callee = self.symbolRef(symbol)
		self.arm64CallForm(Arm64Form.bl, code: noMReg, refers: callee)
	end 'arm64CallSymbol'

	function arm64CallRegister(mutates self, code MReg)
		self.arm64CallForm(Arm64Form.blr, code: code, refers: Referent.make(MRef.none, aux: 0))
	end 'arm64CallRegister'

	// arm64TakeFrom puts what a register holds in dst, if the IR keeps it.
	function arm64TakeFrom(mutates self, dst ir.Reg, r Arm64Register)
		if dst != ir.noReg 'kept'
			self.copy(vregOf(dst), src: arm64PhysReg(r))
		end 'kept'
	end 'arm64TakeFrom'

	// arm64TakeParams loads the parameters the convention passes on the stack from where the prologue left their address,
	// before anything can write the register it is in, then copies those it passes in registers out of them.
	function arm64TakeParams(mutates self, f ir.IrFunction)
		self.paramWords(f)
		_ = arm64PlaceArgs(paramFloats, places: places)
		params.clear()
		paramPlaces.clear()
		for w in 0 upto wordPositions.count() 'params'
			paramPlaces.push(places[wordPositions[w]])
			params.push(noMReg)
		end 'params'
		let base = arm64PhysReg(arm64IncomingBase)
		for k in 0 upto wordPositions.count() 'stack'
			let place = paramPlaces[k]
			if arm64IsStackPlace(place) 'loaded'
				let float = paramFloats[wordPositions[k]]
				let v = self.newTempOf(RegClass.xmm if float else RegClass.gpr)
				self.arm64Load(v, base: base, disp: try (arm64StackSlotOf(place) * wordBytes) as FullRangeInt otherwise panic("backend: a parameter past memory"), float: float)
				params[k] = v
				mir.incomingStack = true
			end 'loaded'
		end 'stack'
		for k in 0 upto wordPositions.count() 'registers'
			let place = paramPlaces[k]
			if not arm64IsStackPlace(place) 'register'
				let v = self.newTempOf(classOfNumber(arch, number: physicalNumber(placeRegister(place))))
				self.copy(v, src: placeRegister(place))
				params[k] = v
			end 'register'
		end 'registers'
	end 'arm64TakeParams'

	function arm64JumpTo(mutates self, block MBlockID)
		let edge = mir.addEdge(block, args: args)
		mir.emit(newArm64Referring(Arm64Form.b, a: noMReg, b: noMReg, ref: MRef.edge, aux: edge))
	end 'arm64JumpTo'

	function arm64BranchTo(mutates self, cond MCond, block MBlockID)
		args.clear()
		let edge = mir.addEdge(block, args: args)
		mir.emit(newArm64Conditional(Arm64Form.bCond, cond: cond, a: noMReg, ref: MRef.edge, aux: edge))
		let next = mir.addBlock()
		self.jumpTo(next)
		mir.writeBlock(next)
	end 'arm64BranchTo'

	function arm64FailTo(mutates self, cond MCond, block ir.BlockID)
		args.clear()
		let edge = mir.addEdge(blockOf(block), args: args)
		mir.emit(newArm64Conditional(Arm64Form.bCond, cond: cond, a: noMReg, ref: MRef.edge, aux: edge))
	end 'arm64FailTo'

	// arm64ZeroManagedSlots stores the zero register into every slot that can own a value.
	function arm64ZeroManagedSlots(mutates self, f ir.IrFunction)
		let fp = arm64PhysReg(arm64FramePointer)
		let zero = arm64PhysReg(arm64ZeroRegister)
		for i in 0 upto f.slots.count() 'slots'
			if ir.owning(f.slots[i]) 'managed'
				self.arm64StoreWord(fp, disp: arm64SlotDisp(i), src: zero)
			end 'managed'
			if f.slots[i] == ir.IrKind.kindString 'string'
				self.arm64StoreWord(fp, disp: secondWordDisp(arm64SlotDisp(i)), src: zero)
			end 'string'
		end 'slots'
	end 'arm64ZeroManagedSlots'

	function arm64Leave(mutates self)
		self.emit(newFrameTeardown())
		self.arm64Instr(Arm64Form.ret, a: noMReg, b: noMReg, c: noMReg, aux: 0, imm: 0)
	end 'arm64Leave'

	function arm64JumpAlong(mutates self, refers Referent)
		self.arm64Refer(Arm64Form.b, a: noMReg, b: noMReg, refers: refers)
	end 'arm64JumpAlong'

	function arm64BranchAlong(mutates self, cond MCond, refers Referent)
		self.emit(newArm64Conditional(Arm64Form.bCond, cond: cond, a: noMReg, ref: refers.ref, aux: refers.aux))
	end 'arm64BranchAlong'
end 'Selector'

// arm64WideImmediate is one past the largest constant that an add of the high 12 bits and then of the low 12 adds.
let arm64WideImmediate = 0x1000000

// emitArm64Constant sets a general register to a word that no one move does: a copy of the register that holds it where
// the function makes the word once (WordSharing), and the word's ladder otherwise.
function emitArm64Constant(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	let held = sel.sharedWords.sharedOf(ins.dst)
	if held != noMReg 'shared'
		sel.copy(result, src: held)
		return
	end 'shared'
	sel.arm64ConstantInto(result, value: ir.constValue(ins) as FullRangeInt)
end 'emitArm64Constant'

// WordSharing makes once in a function each word that no one move sets, on arm64. The IR writes a constant again at each
// of its readers (opt/motion.maxon, Motion.constant), which costs nothing where the reader takes it as an immediate or one
// move sets it, but costs a ladder of up to four moves each time where neither does. Such a word written at more than
// one place, or inside a loop, is made once instead: at the start of the segment nearest the entry's side that dominates
// every place it is written and that no loop holds, and each place copies it. The ladder is one machine instruction that
// makes its result from its immediate alone (MovRegWord), so where the registers do not allow the word to be kept from
// there to its readers, the allocator writes it again before them instead of spilling it: the code that writing it at
// each place gives.
export type WordSharing
	var flow as ir.Flow
	// shared is the register that holds the word of each constant register the function makes once, and noMReg for every
	// other register.
	var shared as MRegList
	// The words due: make dueReg[i] the word dueValue[i] before the instruction dueAt[i] of the block dueBlock[i], or
	// before its terminator where dueAt[i] is the block's end.
	var dueBlock as CountList
	var dueAt as CountList
	var dueReg as MRegList
	var dueValue as Array with FullRangeInt
	// The constants that write such a word, by instruction and word, and whether each is placed yet.
	var siteAt as CountList
	var siteValue as Array with FullRangeInt
	var placed as Array with bool
	var siteGroup as CountList
	// header is the header of the outermost loop that holds each segment, or noLoop; walk is the stack of the walk that
	// finds a loop's segments.
	var header as CountList
	var seen as CountList
	var walk as CountList

	static function new() returns WordSharing
		return WordSharing{flow: ir.Flow.new(), shared: MRegList.create(0), dueBlock: CountList.create(0), dueAt: CountList.create(0), dueReg: MRegList.create(0), dueValue: Array.create(0), siteAt: CountList.create(0), siteValue: Array.create(0), placed: Array.create(0), siteGroup: CountList.create(0), header: CountList.create(0), seen: CountList.create(0), walk: CountList.create(0)}
	end 'new'

	// sharedOf is the register that holds the word of the constant register r, or noMReg where r writes it in place.
	function sharedOf(r ir.Reg) returns MReg
		let i = regIndex(r)
		if i >= shared.count() 'none'
			return noMReg
		end 'none'
		return shared[i]
	end 'sharedOf'

	// clear makes no word shared, as for a function selected for x64.
	function clear(mutates self)
		shared.clear()
		siteAt.clear()
		siteValue.clear()
		dueBlock.clear()
		dueAt.clear()
		dueReg.clear()
		dueValue.clear()
	end 'clear'

	// isDue is whether a word is to be made before the instruction at of block b.
	function isDue(b Count, at Count) returns bool
		for i in 0 upto dueAt.count() 'due'
			if dueAt[i] == at and dueBlock[i] == b 'here'
				return true
			end 'here'
		end 'due'
		return false
	end 'isDue'

	// findLoops sets header: the segments of the loop of each back edge are its header and those that reach its latch
	// without passing through the header, and a segment takes the header of the outermost loop that holds it, the one
	// whose header dominates the others'. seen stamps the segments each loop's walk has reached with the loop's number.
	function findLoops(mutates self)
		let segs = flow.segCount()
		ir.resetCounts(header, n: segs)
		ir.resetCounts(seen, n: segs)
		for s in 0 upto segs 'none'
			header[s] = noLoop
		end 'none'
		for e in 0 upto flow.retreatTo.count() 'loops'
			let h = flow.retreatTo[e]
			let latch = flow.retreatFrom[e]
			if not flow.dominates(h, b: latch) 'irreducible'
				continue 'loops'
			end 'irreducible'
			let stamp = nextCount(e)
			seen[h] = stamp
			self.mark(h, h: h)
			walk.clear()
			walk.push(latch)
			while walk.count() > 0 'body'
				let s = walk.pop()
				if seen[s] == stamp 'reached'
					continue 'body'
				end 'reached'
				seen[s] = stamp
				self.mark(s, h: h)
				for p in flow.predStart[s] upto flow.predStart[nextCount(s)] 'preds'
					let from = flow.pred[p]
					if flow.reached[from] and seen[from] != stamp 'enter'
						walk.push(from)
					end 'enter'
				end 'preds'
			end 'body'
		end 'loops'
	end 'findLoops'

	// mark puts the segment s in the loop whose header is h, unless a loop around that one holds it already.
	function mark(mutates self, s Count, h Count)
		if header[s] == noLoop or header[s] == h or flow.dominates(h, b: header[s]) 'outer'
			header[s] = h
		end 'outer'
	end 'mark'

	// addSite records that the constant instrs[k] writes a word that no one move sets.
	function addSite(mutates self, k Count, value FullRangeInt)
		siteAt.push(k)
		siteValue.push(value)
	end 'addSite'

	// place finds where each word of the sites is made once, for the words that are, and leaves their registers to
	// give: siteGroup is the word due of each site, or noLoop for one written in place.
	function place(mutates self, f ir.IrFunction)
		for _ in 0 upto f.regs.count() 'regs'
			shared.push(noMReg)
		end 'regs'
		flow.build(f)
		self.findLoops()
		ir.resetFlags(placed, n: siteAt.count())
		ir.resetCounts(siteGroup, n: siteAt.count())
		for i in 0 upto siteAt.count() 'words'
			if placed[i] 'done'
				continue 'words'
			end 'done'
			var at = noLoop
			var sites = 0 as Count
			for j in i upto siteAt.count() 'same'
				if not placed[j] and siteValue[j] == siteValue[i] 'word'
					placed[j] = true
					siteGroup[j] = noLoop
					let s = flow.defs.seg[regIndex(f.instrs[siteAt[j]].dst)]
					if flow.reached[s] 'live'
						at = s if at == noLoop else flow.commonDominatorOf(at, other: s)
						sites = sites + 1
						siteGroup[j] = dueAt.count()
					end 'live'
				end 'word'
			end 'same'
			// A loop's header is dominated by the segment before the loop, its immediate dominator, unless the header is the
			// entry, which nothing comes before.
			var hoisted = false
			while at != noLoop and header[at] != noLoop and flow.idom[header[at]] != header[at] 'out'
				at = flow.idom[header[at]]
				hoisted = true
			end 'out'
			if at == noLoop or (sites < 2 and not hoisted) 'inPlace'
				for j in i upto siteAt.count() 'unname'
					if siteGroup[j] == dueAt.count() and siteValue[j] == siteValue[i] 'word'
						siteGroup[j] = noLoop
					end 'word'
				end 'unname'
				continue 'words'
			end 'inPlace'
			dueBlock.push(flow.segBlock[at])
			dueAt.push(flow.segFirst[at])
			dueReg.push(noMReg)
			dueValue.push(siteValue[i])
		end 'words'
	end 'place'

	// give makes held the register of the word due g, which each of its sites copies.
	function give(mutates self, f ir.IrFunction, g Count, held MReg)
		dueReg[g] = held
		for j in 0 upto siteAt.count() 'sites'
			if siteGroup[j] == g 'site'
				shared[regIndex(f.instrs[siteAt[j]].dst)] = held
			end 'site'
		end 'sites'
	end 'give'
end 'WordSharing'

// noLoop is the header of a segment that no loop holds, no segment, and the word due of a site written in place: no
// function has so many segments.
let noLoop = 2147483647 as Count

extension Selector
	// planWords finds the words that no one move sets which f makes once (WordSharing), and gives each a register.
	function planWords(mutates self, f ir.IrFunction)
		sharedWords.clear()
		for k in 0 upto f.instrs.count() 'instrs'
			let dst = f.instrs[k].dst
			if f.instrs[k].op == ir.Opcode.opConst and not isStringReg(f, r: dst) and not self.inXmm(dst) 'constant'
				let value = ir.constValue(f.instrs[k])
				if not arm64OneMove(value) and not arm64IsLogicalImmediate(value as FullRangeInt) 'ladder'
					sharedWords.addSite(k, value: value as FullRangeInt)
				end 'ladder'
			end 'constant'
		end 'instrs'
		if sharedWords.siteAt.count() == 0 'none'
			return
		end 'none'
		sharedWords.place(f)
		for g in 0 upto sharedWords.dueAt.count() 'due'
			let held = self.newTemp()
			sharedWords.give(f, g: g, held: held)
		end 'due'
	end 'planWords'

	// makeDueWords writes the ladders of the words that WordSharing makes before the instruction at of block b.
	function makeDueWords(mutates self, b Count, at Count)
		if sharedWords.dueAt.count() == 0 or not sharedWords.isDue(b, at: at) 'none'
			return
		end 'none'
		for i in 0 upto sharedWords.dueAt.count() 'due'
			if sharedWords.dueAt[i] == at and sharedWords.dueBlock[i] == b 'here'
				let held = sharedWords.dueReg[i]
				let value = sharedWords.dueValue[i]
				self.arm64Instr(Arm64Form.movRegWord, a: held, b: noMReg, c: noMReg, aux: 0, imm: value)
			end 'here'
		end 'due'
	end 'makeDueWords'
end 'Selector'

// The accesses of an offset that the field of the access does not hold, a slot of a large frame among them.

function emitArm64LoadSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	let float = sel.inXmm(ins.dst)
	sel.arm64Load(result, base: arm64PhysReg(arm64FramePointer), disp: arm64SlotDisp(ir.loadSlotSlot(ins)) as FullRangeInt, float: float)
end 'emitArm64LoadSlot'

function emitArm64StoreSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let v = ir.storeSlotSrc(ins)
	sel.arm64Store(arm64PhysReg(arm64FramePointer), disp: arm64SlotDisp(ir.storeSlotSlot(ins)) as FullRangeInt, src: vregOf(v), float: sel.inXmm(v))
end 'emitArm64StoreSlot'

function emitArm64SlotAddr(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = sel.arm64AddConst(arm64PhysReg(arm64FramePointer), value: arm64SlotDisp(ir.slotAddrSlot(ins)) as FullRangeInt)
	let result = sel.resultOf(ins.dst)
	sel.copy(result, src: at)
end 'emitArm64SlotAddr'

function emitArm64MoveSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let fp = arm64PhysReg(arm64FramePointer)
	let disp = arm64SlotDisp(ir.moveSlotSlot(ins))
	let result = sel.resultOf(ins.dst)
	sel.arm64LoadInto(result, base: fp, disp: disp)
	sel.arm64StoreWord(fp, disp: disp, src: arm64PhysReg(arm64ZeroRegister))
end 'emitArm64MoveSlot'

function emitArm64LoadField(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let result = sel.resultOf(ins.dst)
	let float = sel.inXmm(ins.dst)
	sel.arm64Load(result, base: vregOf(ir.loadFieldObj(ins)), disp: arm64Disp(ir.loadFieldOffset(ins)), float: float)
end 'emitArm64LoadField'

function emitArm64StoreField(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let v = ir.storeFieldSrc(ins)
	sel.arm64Store(vregOf(ir.storeFieldObj(ins)), disp: arm64Disp(ir.storeFieldOffset(ins)), src: vregOf(v), float: sel.inXmm(v))
end 'emitArm64StoreField'

function emitArm64FieldAddr(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = sel.arm64AddConst(vregOf(ir.fieldAddrObj(ins)), value: arm64Disp(ir.fieldAddrOffset(ins)))
	let result = sel.resultOf(ins.dst)
	sel.copy(result, src: at)
end 'emitArm64FieldAddr'

// emitArm64Guard goes to the guard's failure block unless the value is in the range of a bound that no immediate holds.
function emitArm64Guard(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.arm64CompareWith(vregOf(ir.guardSrc(ins)), value: ir.guardBound(ins))
	sel.arm64FailTo(guardFailure(ins), block: ir.guardFail(ins))
end 'emitArm64Guard'

// emitArm64CheckedDivide divides by a divisor that is not 0 and fails where the quotient does not fit: for i64.min by -1,
// whose quotient is the negation, which a subtraction from 0 says overflows.
function emitArm64CheckedDivide(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let x = vregOf(ir.binLeft(ins))
	let y = vregOf(ir.binRight(ins))
	if not ir.binHasFail(ins) 'unchecked'
		let result = sel.resultOf(ins.dst)
		sel.arm64Instr(Arm64Form.sdivRegReg, a: result, b: x, c: y, aux: 0, imm: 0)
		return
	end 'unchecked'
	let divide = sel.mir.addBlock()
	let done = sel.mir.addBlock()
	sel.arm64CompareWith(y, value: -1)
	sel.branchTo(MCond.notEqual, block: divide)
	let negated = sel.arm64Define(Arm64Form.subsRegReg, b: arm64PhysReg(arm64ZeroRegister), c: x, aux: 0, imm: 0)
	sel.arm64FailTo(MCond.overflow, block: ir.binFail(ins).unwrap())
	sel.jumpWith(done, value: negated)
	sel.mir.writeBlock(divide)
	let quotient = sel.arm64Define(Arm64Form.sdivRegReg, b: x, c: y, aux: 0, imm: 0)
	sel.jumpWith(done, value: quotient)
	sel.join(done, r: ins.dst)
end 'emitArm64CheckedDivide'

// emitArm64Shift shifts by a count that is not negative. lslv, lsrv and asrv shift by the count modulo the word, so a
// count past the word branches to what every bit leaving gives: 0, or the sign for a signed right shift. A checked left
// shift goes to its failure block when a bit that is not 0, or the sign, leaves the word: shifting the result back must
// give the value.
function emitArm64Shift(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let left = ir.binOp(ins) == ir.BinOp.binShl
	let unsigned = ir.binUnsigned(ins)
	let checkLeft = left and ir.binHasFail(ins)
	let x = vregOf(ir.binLeft(ins))
	let count = vregOf(ir.binRight(ins))
	let big = sel.mir.addBlock()
	let done = sel.mir.addBlock()
	sel.arm64CompareWith(count, value: shiftBitCount)
	sel.branchTo(MCond.greaterEqual, block: big)
	var form = Arm64Form.asrvRegReg
	if left 'left'
		form = Arm64Form.lslvRegReg
	end 'left' else if unsigned 'unsignedRight'
		form = Arm64Form.lsrvRegReg
	end 'unsignedRight'
	let shifted = sel.arm64Define(form, b: x, c: count, aux: 0, imm: 0)
	if checkLeft 'verify'
		let back = sel.arm64Define(Arm64Form.lsrvRegReg if unsigned else Arm64Form.asrvRegReg, b: shifted, c: count, aux: 0, imm: 0)
		sel.arm64Compare(back, b: x)
		sel.arm64FailTo(MCond.notEqual, block: ir.binFail(ins).unwrap())
	end 'verify'
	sel.jumpWith(done, value: shifted)
	sel.mir.writeBlock(big)
	if checkLeft 'lost'
		sel.arm64CompareWith(x, value: 0)
		sel.arm64FailTo(MCond.notEqual, block: ir.binFail(ins).unwrap())
	end 'lost'
	if not left and not unsigned 'sign'
		let sign = sel.arm64Define(Arm64Form.sbfmRegReg, b: x, c: noMReg, aux: arm64SignShift, imm: arm64SignShift)
		sel.jumpWith(done, value: sign)
	end 'sign' else 'zero'
		let zero = sel.constant(0)
		sel.jumpWith(done, value: zero)
	end 'zero'
	sel.join(done, r: ins.dst)
end 'emitArm64Shift'

// emitArm64CompareExchange is casal of x0, which holds the word expected before it and the word found after it.
function emitArm64CompareExchange(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let start = ir.compareExchangeArgsStart(ins)
	sel.copy(arm64PhysReg(Arm64Register.x0), src: argAt(fn, start: start, index: 1))
	sel.arm64Instr(Arm64Form.casalX0, a: argAt(fn, start: start, index: 2), b: argAt(fn, start: start, index: 0), c: noMReg, aux: 0, imm: 0)
	sel.arm64TakeFrom(ins.dst, r: Arm64Register.x0)
end 'emitArm64CompareExchange'

// emitArm64CallImport calls a function of the system's libraries, which an arm64 executable reaches through its slot of
// the global offset table: the slot's page, the word at its low bits, and a call of that by the host convention.
function emitArm64CallImport(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	if ast.systemReach(sel.system) != ast.SystemReach.imports 'imports'
		panic("backend: the runtime calls the library function {ir.callImportName(fn, x: ins)} on a target whose programs reach the system by system calls: its source for the target lacks that function")
	end 'imports'
	let name = ir.callImportName(fn, x: ins)
	let count = ir.callImportArgsCount(ins)
	requireArm64Import(sel.system, name: name)
	let refers = Referent.make(MRef.importSlot, aux: sel.mir.addSymbol(name))
	let page = sel.newTemp()
	sel.arm64Refer(Arm64Form.adrp, a: page, b: noMReg, refers: refers)
	let code = sel.newTemp()
	sel.arm64Refer(Arm64Form.ldr64PageOff, a: code, b: page, refers: refers)
	emitArm64HostCall(sel, fn: fn, ins: ins, start: ir.callImportArgsStart(ins), count: count, fixed: arm64FixedWords(sel.system, name: name, count: count), code: code)
end 'emitArm64CallImport'

// emitArm64CallHost calls the code at an address, the first of its arguments, by the host convention, which only a
// system whose programs reach it through its libraries has.
function emitArm64CallHost(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	if ast.systemReach(sel.system) != ast.SystemReach.imports 'host'
		panic("backend: the runtime calls a library function by its address on a target whose programs reach the system by system calls: its source for the target lacks that function")
	end 'host'
	let start = ir.callHostArgsStart(ins)
	let words = try ir.callHostArgsCount(ins) - 1 otherwise panic("backend: a host call with no address")
	let first = try start + 1 otherwise panic("backend: an argument past the pool")
	emitArm64HostCall(sel, fn: fn, ins: ins, start: first, count: words, fixed: words, code: argAt(fn, start: start, index: 0))
end 'emitArm64CallHost'

// arm64ImportIndex is the index of a library function among the imports of the system, which the link numbers the
// slots of those it calls from.
function requireArm64Import(system ast.TargetSystem, name String)
	match system 'system'
		macos then _ = macosImportIndex(name)
		windows then panic("backend: arm64 has no import table for Windows, which the target table runs no arm64 on")
		linux then panic("backend: arm64 Linux programs make system calls and import nothing")
	end 'system'
end 'requireArm64Import'

// arm64FixedWords is how many of the count words of a call of a library function its convention passes as the named
// ones: all of them but where the function is variadic and the system passes what is variadic on the stack.
function arm64FixedWords(system ast.TargetSystem, name String, count Count) returns Count
	if not arm64HostVariadicOnStack(system) 'registers'
		return count
	end 'registers'
	let fixed = macosFixedWords(name, count: count)
	if fixed > count 'short'
		panic("backend: the runtime calls the variadic {name} with {count} words, fewer than its {fixed} fixed ones")
	end 'short'
	return fixed
end 'arm64FixedWords'

// emitArm64HostCall calls the code a register holds by the host convention with the count words from start of the call's
// arguments: the first fixed in their registers, and the rest, the variadic words of a convention that passes them on the
// stack, stored a word each from the stack pointer, in the room the frame keeps for the most any call of the function
// passes there. arm64's host conventions keep the registers the internal one keeps, so the call is one of the internal
// convention as the allocator sees it.
function emitArm64HostCall(mutates sel Selector, fn ir.IrFunction, ins ir.Instr, start Count, count Count, fixed Count, code MReg)
	if arm64KeptBy(ConventionKind.host, system: sel.system) != arm64KeptBy(ConventionKind.internal, system: sel.system) 'kept'
		panic("backend: an arm64 host convention keeps other registers than the internal one, so a host call is not one of the internal convention")
	end 'kept'
	if fixed > arm64ArgRegisterCount(ConventionKind.host, system: sel.system) 'many'
		panic("backend: a host call of more fixed words than the host convention has registers for")
	end 'many'
	let sp = arm64PhysReg(Arm64Register.sp)
	for i in fixed upto count 'stacked'
		let at = try (i - fixed) * wordBytes otherwise panic("backend: more arguments than memory")
		sel.arm64Store(sp, disp: arm64Disp(at), src: argAt(fn, start: start, index: i), float: false)
	end 'stacked'
	let room = try (count - fixed) * wordBytes otherwise panic("backend: more arguments than memory")
	sel.mir.outgoingBytes = maxOf(sel.mir.outgoingBytes, b: room)
	for i in 0 upto fixed 'registers'
		sel.copy(arm64PhysReg(arm64ArgRegister(ConventionKind.host, system: sel.system, index: i)), src: argAt(fn, start: start, index: i))
	end 'registers'
	sel.emit(newArm64Call(Arm64Form.blr, a: code, ref: MRef.none, aux: 0, argRegs: arm64WordArgRegs(ConventionKind.host, system: sel.system, count: fixed)))
	sel.arm64TakeFrom(ins.dst, r: arm64ResultRegister(ConventionKind.host, system: sel.system))
end 'emitArm64HostCall'

// emitArm64Syscall calls the kernel by Linux's system call convention: the number and the words in its registers, svc,
// and the result in its result register.
function emitArm64Syscall(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	if ast.systemReach(sel.system) != ast.SystemReach.syscalls 'kernel'
		panic("backend: the runtime makes a system call on a target whose programs reach the system through its libraries")
	end 'kernel'
	let start = ir.syscallArgsStart(ins)
	let count = ir.syscallArgsCount(ins)
	let words = try count - 1 otherwise panic("backend: a system call with no number")
	if words > arm64ArgRegisterCount(ConventionKind.syscall, system: sel.system) 'many'
		panic("backend: a system call of more words than the system call convention has registers for")
	end 'many'
	let first = try start + 1 otherwise panic("backend: an argument past the pool")
	for i in 0 upto words 'registers'
		sel.copy(arm64PhysReg(arm64ArgRegister(ConventionKind.syscall, system: sel.system, index: i)), src: argAt(fn, start: first, index: i))
	end 'registers'
	sel.copy(arm64PhysReg(arm64SyscallNumber(sel.system)), src: argAt(fn, start: start, index: 0))
	let reads = arm64WordArgRegs(ConventionKind.syscall, system: sel.system, count: words) or arm64RegMaskOf(arm64SyscallNumber(sel.system))
	sel.emit(newArm64Call(Arm64Form.svc, a: noMReg, ref: MRef.none, aux: 0, argRegs: reads))
	sel.arm64TakeFrom(ins.dst, r: arm64ResultRegister(ConventionKind.syscall, system: sel.system))
end 'emitArm64Syscall'

// emitArm64Bounds goes to the failure block of a bounds check where the index is not below the length, unsigned. The
// branch ends the block, as x64's does.
function emitArm64Bounds(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.arm64Compare(vregOf(ir.boundsIndex(ins)), b: vregOf(ir.boundsLength(ins)))
	sel.branchTo(MCond.aboveEqual, block: blockOf(ir.boundsFail(ins)))
end 'emitArm64Bounds'

// arm64FrameBoxDisp is where a frame box starts, after the IR's slots: its words lie upward from there, as a box's do, and
// as the slots do above the frame record.
function arm64FrameBoxDisp(f ir.IrFunction, box Count) returns Imm32
	return arm64WordDisp(try slotsWords(f) + box * ifaceBoxWords otherwise panic("backend: a frame box past memory"))
end 'arm64FrameBoxDisp'

// emitArm64FrameBox makes an interface value whose box is one of the function's frame boxes.
function emitArm64FrameBox(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = sel.arm64AddConst(arm64PhysReg(arm64FramePointer), value: arm64FrameBoxDisp(fn, box: ir.frameBoxBox(ins)) as FullRangeInt)
	let box = vregOf(ins.dst)
	sel.copy(box, src: at)
	sel.fillBox(fn, box: box, table: ir.frameBoxTable(fn, x: ins), value: ir.frameBoxValue(ins))
end 'emitArm64FrameBox'

// emitArm64FrameArea gives the address of a frame area, which starts at its first frame box, the lowest, and lies upward
// from there through the boxes after it.
function emitArm64FrameArea(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let at = sel.arm64AddConst(arm64PhysReg(arm64FramePointer), value: arm64FrameBoxDisp(fn, box: ir.frameAreaBox(ins)) as FullRangeInt)
	sel.copy(vregOf(ins.dst), src: at)
end 'emitArm64FrameArea'

function emitArm64DropSlot(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	sel.dropPlace(arm64PhysReg(arm64FramePointer), disp: arm64SlotDisp(ir.dropSlotSlot(ins)), ty: ir.dropSlotTy(fn, x: ins))
end 'emitArm64DropSlot'

// emitArm64LoadParam reads a parameter from where the prologue took it.
function emitArm64LoadParam(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let w = sel.paramWordAt[ir.loadParamParam(ins)]
	let result = sel.resultOf(ins.dst)
	let first = sel.params[w]
	sel.copy(result, src: first)
	if isStringReg(fn, r: ins.dst) 'string'
		let word = sel.params[nextCount(w)]
		let second = sel.secondOf(ins.dst)
		sel.copy(second, src: word)
	end 'string'
end 'emitArm64LoadParam'

// The shuffles that arm64 has no one instruction of. A lane of 32 bits is two bits of an order and four bytes of a tbl's
// picks; a lane of 16 bits is one bit of a mask and two bytes; the order that swaps the two halves is ext's of 8 bytes.
let dwordOrderBits = 2 as Count

let dwordOrderLanes = 4 as Count

let dwordLaneMask = 3 as Count

// dwordLanesInHalf are the 32-bit lanes of a 64-bit half, of which the lane's place in its half is the low bit.
let dwordLanesInHalf = 2 as Count

let dwordInHalfMask = 1 as Count

let dwordBytes = 4 as Count

let byteBits = 8 as Count

let halvesSwapped = 0x4E as Count

let vectorHalfBytes = 8 as Count

let broadcastOrder = 0x55 as Count

let wordLaneBits = 16 as Count

let wordLanesInWord = 4 as Count

let wordLaneOnes = 0xFFFF as Count

// emitArm64ShuffleDwords is pshufd: dup where every lane is the same one, ext where the halves swap, and else tbl with the
// picks of the order's bytes.
function emitArm64ShuffleDwords(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let order = ir.vecShuffleDwordsOrder(ins)
	let x = vregOf(ir.vecShuffleDwordsSrc(ins))
	let r = sel.resultOf(ins.dst)
	let lane = order and dwordLaneMask
	if order == lane * broadcastOrder 'broadcast'
		sel.arm64Instr(Arm64Form.dupVec4SLane, a: r, b: x, c: noMReg, aux: 0, imm: lane as FullRangeInt)
		return
	end 'broadcast'
	if order == halvesSwapped 'swapped'
		sel.arm64Instr(Arm64Form.extVec16, a: r, b: x, c: x, aux: 0, imm: vectorHalfBytes as FullRangeInt)
		return
	end 'swapped'
	var low = 0 as Count
	var high = 0 as Count
	for i in 0 upto dwordOrderLanes 'lanes'
		let picked = (order shr (i * dwordOrderBits)) and dwordLaneMask
		for j in 0 upto dwordBytes 'bytes'
			let pick = picked * dwordBytes + j
			let at = ((i and dwordInHalfMask) * dwordBytes + j) * byteBits
			if i < dwordLanesInHalf 'low'
				low = low or (pick shl at)
			end 'low' else 'high'
				high = high or (pick shl at)
			end 'high'
		end 'bytes'
	end 'lanes'
	let picks = arm64VectorOfWords(sel, low: low, high: high)
	sel.arm64Instr(Arm64Form.tblVec16, a: r, b: x, c: picks, aux: 0, imm: 0)
end 'emitArm64ShuffleDwords'

// emitArm64BlendWords is pblendw: left with the bits where left and right differ that the mask's lanes cover flipped.
function emitArm64BlendWords(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let mask = ir.vecBlendWordsMask(ins)
	let left = vregOf(ir.vecBlendWordsLeft(ins))
	let right = vregOf(ir.vecBlendWordsRight(ins))
	var low = 0 as Count
	var high = 0 as Count
	for i in 0 upto wordLanesInWord 'lanes'
		if ((mask shr i) and 1) != 0 'lowLane'
			low = low or (wordLaneOnes shl (i * wordLaneBits))
		end 'lowLane'
		if ((mask shr (i + wordLanesInWord)) and 1) != 0 'highLane'
			high = high or (wordLaneOnes shl (i * wordLaneBits))
		end 'highLane'
	end 'lanes'
	let lanes = arm64VectorOfWords(sel, low: low, high: high)
	let differ = sel.newTempOf(RegClass.xmm)
	sel.arm64Instr(Arm64Form.eorVec16, a: differ, b: left, c: right, aux: 0, imm: 0)
	let taken = sel.newTempOf(RegClass.xmm)
	sel.arm64Instr(Arm64Form.andVec16, a: taken, b: differ, c: lanes, aux: 0, imm: 0)
	let d = sel.resultOf(ins.dst)
	sel.arm64Instr(Arm64Form.eorVec16, a: d, b: left, c: taken, aux: 0, imm: 0)
end 'emitArm64BlendWords'

// arm64VectorOfWords is a new vector register of two words that the selection knows, its low lane and its high one.
function arm64VectorOfWords(mutates sel Selector, low Count, high Count) returns MReg
	let lowWord = sel.constant(ir.wordOfBits(low) as FullRangeInt)
	let highWord = sel.constant(ir.wordOfBits(high) as FullRangeInt)
	let half = sel.newTempOf(RegClass.xmm)
	sel.arm64Instr(Arm64Form.fmovDX, a: half, b: lowWord, c: noMReg, aux: 0, imm: 0)
	let whole = sel.newTempOf(RegClass.xmm)
	sel.arm64Instr(Arm64Form.insVecD1, a: whole, b: half, c: highWord, aux: 0, imm: 0)
	return whole
end 'arm64VectorOfWords'

// emitVecShaArm64 selects the SHA-256 instructions, which read and write their first vector: sha256h, sha256h2 and
// sha256su1 read their third in v0, the first vector register. x64's instructions have no arm64 form.
function emitVecShaArm64(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	let start = ir.vecShaArgsStart(ins)
	let first = argAt(fn, start: start, index: 0)
	let second = argAt(fn, start: start, index: 1)
	match ir.vecShaOp(ins) 'op'
		vecShaH then emitArm64ShaThree(sel, ins: ins, form: Arm64Form.sha256hVec, first: first, second: second, third: argAt(fn, start: start, index: 2))
		vecShaH2 then emitArm64ShaThree(sel, ins: ins, form: Arm64Form.sha256h2Vec, first: first, second: second, third: argAt(fn, start: start, index: 2))
		vecShaSu1 then emitArm64ShaThree(sel, ins: ins, form: Arm64Form.sha256su1Vec, first: first, second: second, third: argAt(fn, start: start, index: 2))
		vecShaSu0 then emitArm64ShaTwo(sel, ins: ins, form: Arm64Form.sha256su0Vec, first: first, second: second)
		vecShaRnds2 or
		vecShaMsg1 or
		vecShaMsg2 then emitX64Operation(sel, fn: fn, ins: ins)
	end 'op'
end 'emitVecShaArm64'

function emitArm64ShaThree(mutates sel Selector, ins ir.Instr, form Arm64Form, first MReg, second MReg, third MReg)
	sel.copy(physOfCount(arm64FirstVector), src: third)
	emitArm64ShaTwo(sel, ins: ins, form: form, first: first, second: second)
end 'emitArm64ShaThree'

// emitArm64ShaTwo is a SHA-256 form that reads and writes first, which the instruction's result is defined in.
function emitArm64ShaTwo(mutates sel Selector, ins ir.Instr, form Arm64Form, first MReg, second MReg)
	let d = sel.resultOf(ins.dst)
	sel.arm64Instr(form, a: d, b: first, c: second, aux: 0, imm: 0)
end 'emitArm64ShaTwo'

// emitX64Operation refuses an operation of x64's instructions, which the runtime's source has only under #if arch(x64).
function emitX64Operation(mutates sel Selector, fn ir.IrFunction, ins ir.Instr)
	panic("backend: {ir.opcodeName(ins.op)} is an x64 instruction, which arm64 has no form of: the runtime's source has it only under #if arch(x64)")
end 'emitX64Operation'
