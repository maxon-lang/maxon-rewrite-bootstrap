// The assembler and the code unit: what codegen, the routines and the entry stub write instructions into, and what the
// linker reads. The architecture's assembler (asm_x64.maxon, over the encoder of x64_gen.maxon) writes the instructions;
// this is what every one leaves to the backend: labels, the fixups that the linker patches, each of a kind, and the
// symbols a unit defines.

// imm32Of is a size or an offset that an instruction holds in 32 bits.
export function imm32Of(value Count) returns Imm32
	return try value as Imm32 otherwise panic("backend: an offset past 2 GiB")
end 'imm32Of'

typealias StringOffsets = table.StringMap with Count

typealias WordOffsets = table.IntMap with Count

// LabelID is a label of the function or routine being written, an index into its Asm.
export typealias LabelID = int(0 to 2147483647)

// Label is a place in the code that a branch goes to. The uses of a label that is not bound yet are a chain through the
// assembler's table of uses, which binding walks.
type Label
	var bound as bool
	var pos as Count
	// last is one past the index in the table of uses of the last use of the label before it was bound, and 0 for none.
	var last as Count

	static function make() returns Label
		return Label{bound: false, pos: 0 as Count, last: 0 as Count}
	end 'make'
end 'Label'

typealias LabelList = Array with Label

// FixupKind is what a field that the link or a label fills in holds: on x64 a 32-bit offset from the field's end to
// the target (rel32), in a branch, a call or a rip-relative operand; on arm64 a field of the instruction word at the
// fixup, which holds the distance from the instruction in words, of b and bl (branch26) or of b.cond, cbz and cbnz
// (branch19), the distance in pages of adrp (page21), or the low 12 bits of the target's address, as they are for an
// add (pageOffset12) and in words for the load or the store of a word (pageOffset12Word).
export enum FixupKind
	rel32
	branch26
	branch19
	page21
	pageOffset12
	pageOffset12Word
end 'FixupKind'

// fixupKindOf is the kind with a number, its rawValue, which a unit kept by the build cache holds.
function fixupKindOf(number Count) returns FixupKind
	return match number 'number'
		0 gives FixupKind.rel32
		1 gives FixupKind.branch26
		2 gives FixupKind.branch19
		3 gives FixupKind.page21
		4 gives FixupKind.pageOffset12
		5 gives FixupKind.pageOffset12Word
		default panic("backend: a kept unit holds a fixup of no kind")
	end 'number'
end 'fixupKindOf'

// DataFixup is a reference of a kind to an offset of the data section, written at pos.
export type DataFixup
	export var kind as FixupKind
	export var pos as Count
	export var dataOffset as Count

	export static function make(kind FixupKind, pos Count, dataOffset Count) returns DataFixup
		return DataFixup{kind: kind, pos: pos, dataOffset: dataOffset}
	end 'make'
end 'DataFixup'

export typealias DataFixupList = Array with DataFixup

// ImportFixup is a reference of a kind to the import slot of the index-th imported name, written at pos.
export type ImportFixup
	export var kind as FixupKind
	export var pos as Count
	export var index as Count

	export static function make(kind FixupKind, pos Count, index Count) returns ImportFixup
		return ImportFixup{kind: kind, pos: pos, index: index}
	end 'make'
end 'ImportFixup'

export typealias ImportFixupList = Array with ImportFixup

// SymbolFixup is a reference of a kind, written at pos, to a symbol that this unit or another one defines.
export type SymbolFixup
	export var kind as FixupKind
	export var pos as Count
	export var symbol as String

	export static function make(kind FixupKind, pos Count, consumes symbol String) returns SymbolFixup
		return SymbolFixup{kind: kind, pos: pos, symbol: symbol}
	end 'make'
end 'SymbolFixup'

export typealias SymbolFixupList = Array with SymbolFixup

// SymbolDef is a symbol that a unit defines and where: an offset in its code or in its data. A symbol is the text that
// the unit's code and the link name it by, so a unit does not depend on the compile that made it.
export type SymbolDef
	export var symbol as String
	export var offset as Count
	// instance says the symbol is an instance of a generic function, which every unit that needs it defines, and the link
	// keeps one of; any other symbol is defined once.
	export var instance as bool

	export static function make(consumes symbol String, offset Count, instance bool) returns SymbolDef
		return SymbolDef{symbol: symbol, offset: offset, instance: instance}
	end 'make'
end 'SymbolDef'

export typealias SymbolDefList = Array with SymbolDef

// Asm is the code of a unit and the references in it that are not known until the link: what every architecture's
// assembler writes into (asm_x64.maxon). A branch to a label not bound yet is a use in a table of its own, which the
// label's binding patches by the use's kind, so that no field has to hold the chain of a label's uses.
export type Asm
	export var code as ByteArray
	export var dataFixups as DataFixupList
	export var importFixups as ImportFixupList
	export var symbolFixups as SymbolFixupList
	var labels as LabelList
	// The uses of labels not bound yet: where each field is, its kind, and the use before it of the same label, one past
	// its index, or 0 for none.
	var useAt as CountList
	var useKind as Array with FixupKind
	var usePrevious as CountList
	// relaxes says that the code being written is a function that the arm64 encoder writes again when one of its
	// conditional branches goes past the reach of its field (encode_arm64.maxon), so such a branch is left unpatched and
	// noted in farBranches, where it is no defect.
	var relaxes as bool
	var farBranches as CountList

	export static function new() returns Asm
		return Asm{code: ByteArray.create(0), dataFixups: DataFixupList.create(0), importFixups: ImportFixupList.create(0), symbolFixups: SymbolFixupList.create(0), labels: LabelList.create(0), useAt: CountList.create(0), useKind: Array.create(0), usePrevious: CountList.create(0), relaxes: false, farBranches: CountList.create(0)}
	end 'new'

	export function pos() returns Count
		return code.count()
	end 'pos'

	// addDataFixup notes a field of a kind at at that refers to an offset of the data section.
	function addDataFixup(mutates self, kind FixupKind, at Count, dataOffset Count)
		dataFixups.push(DataFixup.make(kind, pos: at, dataOffset: dataOffset))
	end 'addDataFixup'

	// addSymbolFixup notes a field of a kind at at that refers to a symbol.
	function addSymbolFixup(mutates self, kind FixupKind, at Count, symbol String)
		symbolFixups.push(SymbolFixup.make(kind, pos: at, symbol: symbol.clone()))
	end 'addSymbolFixup'

	// addImportFixup notes a field of a kind at at that refers to the import slot of the index-th imported name.
	function addImportFixup(mutates self, kind FixupKind, at Count, index Count)
		importFixups.push(ImportFixup.make(kind, pos: at, index: index))
	end 'addImportFixup'

	// newLabel makes a label that stays valid until the next section starts.
	export function newLabel(mutates self) returns LabelID
		let id = try labels.count() as LabelID otherwise panic("a function has more labels than any code can name")
		labels.push(Label.make())
		return id
	end 'newLabel'

	// addLabelUse makes the field of a kind at at go to the label: now, if it is bound, and when it is otherwise.
	function addLabelUse(mutates self, label LabelID, kind FixupKind, at Count)
		let index = label as Count
		if labels[index].bound 'bound'
			let target = labels[index].pos
			self.patchUse(kind, at: at, target: target)
			return
		end 'bound'
		useAt.push(at)
		useKind.push(kind)
		usePrevious.push(labels[index].last)
		labels[index].last = useAt.count()
	end 'addLabelUse'

	// bind puts the label here and makes every branch that went to it before go here.
	export function bind(mutates self, label LabelID)
		let index = label as Count
		let target = code.count()
		var use = labels[index].last
		while use != 0 'uses'
			let at = try use - 1 otherwise panic("a label use is before the table")
			let kind = useKind[at]
			let field = useAt[at]
			self.patchUse(kind, at: field, target: target)
			use = usePrevious[at]
		end 'uses'
		labels[index].bound = true
		labels[index].pos = target
		labels[index].last = 0
	end 'bind'

	// patchUse makes the field of a kind at at go to target, or notes it in farBranches when it is a conditional branch
	// of code that relaxes them and target is past its reach.
	function patchUse(mutates self, kind FixupKind, at Count, target Count)
		if kind == FixupKind.branch19 and relaxes and not arm64BranchReaches(kind, distance: distanceOf(at, target: target)) 'far'
			farBranches.push(at)
			return
		end 'far'
		patchLabelField(code, kind: kind, at: at, target: target)
	end 'patchUse'

	// endLabels checks that every label of the section that ends was bound and every branch to one patched, and forgets
	// them.
	export function endLabels(mutates self)
		for i in 0 upto labels.count() 'each'
			if labels[i].last != 0 'unbound'
				panic("backend: a branch goes to a label that was never bound")
			end 'unbound'
		end 'each'
		if farBranches.count() != 0 'far'
			panic("backend: a conditional branch past the reach of its field that was not written again")
		end 'far'
		labels = LabelList.create(0)
		useAt.clear()
		useKind.clear()
		usePrevious.clear()
	end 'endLabels'
end 'Asm'

// patchLabelField makes the field of a kind at at of the code go to target, an offset of the same code.
function patchLabelField(mutates code ByteArray, kind FixupKind, at Count, target Count)
	match kind 'kind'
		rel32 then patchRel32(code, at: at, target: target)
		branch26 or
		branch19 then arm64PatchBranch(code, kind: kind, at: at, distance: distanceOf(at, target: target))
		page21 or
		pageOffset12 or
		pageOffset12Word then panic("backend: a label of the code is the target of an address's page or its low bits, which only the link fills in")
	end 'kind'
end 'patchLabelField'

// distanceOf is how far target is from at, both offsets of one code, in bytes.
function distanceOf(at Count, target Count) returns FullRangeInt
	return try (target as FullRangeInt) - (at as FullRangeInt) otherwise panic("backend: a distance past the word")
end 'distanceOf'

// CodeSection is where a part of a unit's code begins, and where its fixups of each kind begin, which are in the order of
// their positions, and the boundary the link starts it on: the code in it is aligned from its start, so it is aligned in
// the image only on that boundary. preemptible says that the monitor may stop a green thread anywhere in it: it is the
// program's code, which holds nothing of the thread it runs on, and not the runtime's or the compiler's own (README,
// "Green threads").
export type CodeSection
	export var code as Count
	export var symbolFixups as Count
	export var dataFixups as Count
	export var importFixups as Count
	export var alignment as Count
	export var preemptible as bool

	export static function make(code Count, symbolFixups Count, dataFixups Count, importFixups Count, alignment Count, preemptible bool) returns CodeSection
		return CodeSection{code: code, symbolFixups: symbolFixups, dataFixups: dataFixups, importFixups: importFixups, alignment: alignment, preemptible: preemptible}
	end 'make'
end 'CodeSection'

export typealias CodeSectionList = Array with CodeSection

// DataPointer is a word of the data that holds the address of other data of the same piece: the link writes the address,
// and the loader moves it with the image.
export type DataPointer
	export var pos as Count
	export var target as Count

	export static function make(pos Count, target Count) returns DataPointer
		return DataPointer{pos: pos, target: target}
	end 'make'
end 'DataPointer'

export typealias DataPointerList = Array with DataPointer

// DataSection is the bytes of the executable's data: the strings that code names, the constants it reads and the globals
// it reads.
export type DataSection
	export var bytes as ByteArray
	var strings as StringOffsets
	// words are the offsets of the words that constants read into xmm registers are, by their bits.
	var words as WordOffsets
	// pieces are the offsets where each string, each constant and each reserved value begins, which the link keeps or
	// drops whole.
	export var pieces as CountList
	// pointers are the words of the constants that hold addresses, in the order of their offsets.
	export var pointers as DataPointerList

	export static function new() returns DataSection
		return DataSection{bytes: ByteArray.create(0), strings: StringOffsets.new(), words: WordOffsets.new(), pieces: CountList.create(0), pointers: DataPointerList.create(0)}
	end 'new'

	export function align8(mutates self)
		while bytes.count() mod wordBytes != 0 'pad'
			bytes.push(0)
		end 'pad'
	end 'align8'

	export function reserve(mutates self, size Count) returns Count
		self.align8()
		let at = bytes.count()
		pieces.push(at)
		for _ in 0 upto size 'zeros'
			bytes.push(0)
		end 'zeros'
		return at
	end 'reserve'

	// wordOffset is where a word of the bits given is, put there once however often it is asked for.
	export function wordOffset(mutates self, bits Count) returns Count
		match words.get(bits) 'known'
			some(at) then return at
			none then _ = 0
		end 'known'
		let at = self.reserve(wordBytes)
		var rest = bits
		for i in 0 upto wordBytes 'bytes'
			bytes[addCounts(at, b: i)] = (rest mod byteValues) as Byte
			rest = rest / byteValues
		end 'bytes'
		words.insert(bits, value: at)
		return at
	end 'wordOffset'

	// textOffset is where a string is, as the length and then the bytes, put there once however often it is asked for.
	export function textOffset(mutates self, text String) returns Count
		match strings.get(text) 'known'
			some(at) then return at
			none then _ = 0
		end 'known'
		self.align8()
		let at = bytes.count()
		pieces.push(at)
		var length = text.byteLength()
		for _ in 0 upto wordBytes 'length'
			bytes.push((length mod byteValues) as Byte)
			length = length / byteValues
		end 'length'
		bytes.append(text.toByteArray())
		strings.insert(text.clone(), value: at)
		return at
	end 'textOffset'
end 'DataSection'

// CodeUnit is the code and data of one module, of the routines of some types, or of the entry, with the symbols it defines.
export type CodeUnit
	export var asm as Asm
	export var data as DataSection
	// codeSymbols and dataSymbols are in the order the unit defined them. A symbol that is defined twice, and is not an
	// instance of a generic, is found by the link, which meets every definition of every unit.
	export var codeSymbols as SymbolDefList
	export var dataSymbols as SymbolDefList
	// sections are the parts of the code that the link keeps or drops whole, in order: a function or a routine each. A
	// unit that starts none is one section, so its code may jump between its own symbols.
	export var sections as CodeSectionList
	// needed are the drop and copy routines this unit's code calls, in the order its code first does.
	export var needed as RoutineSet
	// preemptible is whether the sections it begins from now on are (CodeSection): none is until the unit's maker says
	// that what it writes next is the program's own code.
	export var preemptible as bool

	export static function new() returns CodeUnit
		return CodeUnit{asm: Asm.new(), data: DataSection.new(), codeSymbols: SymbolDefList.create(0), dataSymbols: SymbolDefList.create(0), sections: CodeSectionList.create(0), needed: RoutineSet.new(), preemptible: false}
	end 'new'

	export function defineCode(mutates self, symbol String)
		codeSymbols.push(SymbolDef.make(symbol.clone(), offset: asm.pos(), instance: false))
	end 'defineCode'

	// defineFunction defines the code of a function by its link name.
	export function defineFunction(mutates self, symbol String, instance bool)
		codeSymbols.push(SymbolDef.make(symbol.clone(), offset: asm.pos(), instance: instance))
	end 'defineFunction'

	// beginSection starts a part of the code that the link keeps only if the entry reaches it. Code in it reaches other
	// sections only through symbols.
	export function beginSection(mutates self)
		asm.endLabels()
		sections.push(CodeSection.make(asm.pos(), symbolFixups: asm.symbolFixups.count(), dataFixups: asm.dataFixups.count(), importFixups: asm.importFixups.count(), alignment: functionAlignment, preemptible: preemptible))
	end 'beginSection'

	// sectionOffset is how far the code written next is from the start of the section begun last.
	function sectionOffset() returns Count
		return try asm.pos() - sections[self.lastSection()].code otherwise panic("backend: code before its section")
	end 'sectionOffset'

	// rewindSection forgets the code, the references and the labels of the section begun last, so that it can be written
	// again.
	function rewindSection(mutates self)
		let s = sections[self.lastSection()].clone()
		asm.code.truncate(s.code)
		asm.symbolFixups.truncate(s.symbolFixups)
		asm.dataFixups.truncate(s.dataFixups)
		asm.importFixups.truncate(s.importFixups)
		asm.endLabels()
	end 'rewindSection'

	// alignSection has the link start the section begun last on a boundary, which its code was placed from.
	function alignSection(mutates self, alignment Count)
		let last = self.lastSection()
		sections[last].alignment = maxOf(sections[last].alignment, b: alignment)
	end 'alignSection'

	function lastSection() returns Count
		return try sections.count() - 1 otherwise panic("backend: code outside a section")
	end 'lastSection'

	export function defineData(mutates self, symbol String, size Count)
		dataSymbols.push(SymbolDef.make(symbol.clone(), offset: data.reserve(size), instance: false))
	end 'defineData'

	// defineSharedData reserves data that every unit that names it defines, of which the link keeps one, as it does of an
	// instance: the address is what names the thing, whichever unit's is kept.
	export function defineSharedData(mutates self, symbol String, size Count)
		dataSymbols.push(SymbolDef.make(symbol.clone(), offset: data.reserve(size), instance: true))
	end 'defineSharedData'

	// defineDatum lays out a constant as a piece of the data, which every unit that reads it defines and the link keeps one
	// of, as it does of an instance.
	export function defineDatum(mutates self, d ir.Datum)
		dataSymbols.push(SymbolDef.make(d.symbol.clone(), offset: layOutDatum(data, d: d), instance: true))
	end 'defineDatum'
end 'CodeUnit'

export typealias UnitList = Array with CodeUnit
