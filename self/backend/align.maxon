// Where code starts, so that the time code takes depends on the code alone and not on where the link happened to place
// it. An x64 processor fetches code and caches its decoded operations by lines of codeLineBytes, and a loop or a call that
// runs through one more line than its length needs costs that line each time round: measured on a Zen 3, the same loop
// took 150 or 195 ms and the same recursive function 140 or 152 ms by where the line breaks fell. So a function starts on
// functionAlignment, and a function, or the code of a loop from its head to the last branch back to it, that would run
// into one more line than its length needs is moved to the start of the next line (fitLine); a function with a loop starts
// on a line, which its loops are placed from. A function's padding is never run; a loop's runs once each time the loop is
// entered from above, as the fewest nops. On arm64 every function of the runtime also starts on a line of 128 bytes
// (runtimeAlignment), so that the runtime's hot code does not move within its lines when other runtime code changes.
//
// The references start a function on 16 bytes and align no loop on arm64: Go's linker (Funcalign, cmd/link/internal/arm64
// and amd64) on 16 for arm64 and 32 for amd64, and clang 21 on 4 for arm64 and Apple's cores and 16 for x64, with loops on 16
// for x64 only. Neither aligns anything to 128.

// functionAlignment is the boundary every function starts on.
let functionAlignment = 16 as Count

// codeLineBytes is the line of code that a fetch reads and the cache of decoded operations holds, by which fitLine places
// code on every architecture, and x64's codeBoundary.
let codeLineBytes = 64 as Count

// arm64CodeLineBytes is the line that arm64 code is placed by, as codeLineBytes is x64's: on an Apple M3 the same
// instructions took 1-2% more cycles when most of the runtime's code moved 448 bytes, 64 mod 128 (f8ab0e40), so its fetch is
// sensitive to where 128-byte lines break.
let arm64CodeLineBytes = 128 as Count

// codeBoundary is the line of the architecture: the boundary the image starts its code on and the link each unit's, so that
// a place in a line of a unit is the same place in memory, and the largest alignment a section may ask for.
function codeBoundary(arch ast.TargetArch) returns Count
	return match arch 'arch'
		x64 gives codeLineBytes
		arm64 gives arm64CodeLineBytes
	end 'arch'
end 'codeBoundary'

// runtimeAlignment is the boundary every function of the runtime starts on. The runtime holds the hot code of every
// program (the heap, strings, arrays, the scheduler), and a change to any of its functions moves all that the link places
// after it. On arm64 each of its functions therefore starts on a line, so that a change to one moves no other within its
// line, at about 51 bytes of padding a function (25 KB of the compiler's 5.6 MB of code). On x64 fitLine already keeps every
// function to the fewest lines its length needs and every function with a loop on a line, so the runtime starts on
// functionAlignment as the rest of the code does.
function runtimeAlignment(arch ast.TargetArch) returns Count
	return match arch 'arch'
		x64 gives functionAlignment
		arm64 gives arm64CodeLineBytes
	end 'arch'
end 'runtimeAlignment'

// longestNop is the length of the longest nop of the x64 table.
let longestNop = 9 as Count

// fitLine is the padding that moves code of a length from offset to the start of the next line, when that has it span one
// line fewer, and 0 otherwise.
function fitLine(offset Count, bytes Count) returns Count
	let padding = paddingTo(offset, alignment: codeLineBytes)
	if linesSpanned(offset, bytes: bytes) > linesSpanned(0, bytes: bytes) 'saves'
		return padding
	end 'saves'
	return 0
end 'fitLine'

// linesSpanned is how many lines code of a length at offset runs into.
function linesSpanned(offset Count, bytes Count) returns Count
	let into = offset mod codeLineBytes
	return try (into + bytes + codeLineBytes - 1) / codeLineBytes otherwise panic("backend: code past memory")
end 'linesSpanned'

// paddingTo is how many bytes take offset up to the next multiple of alignment.
function paddingTo(offset Count, alignment Count) returns Count
	let over = try offset mod alignment otherwise panic("backend: an alignment of 0")
	if over == 0 'aligned'
		return 0
	end 'aligned'
	return try alignment - over otherwise panic("backend: a remainder past its divisor")
end 'paddingTo'

// encodeNops writes the fewest nops that are bytes long: the longest ones, then one of the rest.
function encodeNops(mutates code ByteArray, bytes Count)
	var left = bytes
	while left > longestNop 'longest'
		encodeNop9(code)
		left = left - longestNop
	end 'longest'
	match left 'length'
		0 then return
		1 then encodeNop1(code)
		2 then encodeNop2(code)
		3 then encodeNop3(code)
		4 then encodeNop4(code)
		5 then encodeNop5(code)
		6 then encodeNop6(code)
		7 then encodeNop7(code)
		8 then encodeNop8(code)
		9 then encodeNop9(code)
		default then panic("backend: a nop of {left} bytes, past the longest")
	end 'length'
end 'encodeNops'

// encodeTraps fills bytes of code that nothing runs with the architecture's trap, so that a stray jump into them stops there:
// x64's one-byte int3, and arm64's brk, a word, which every gap between its sections is a whole number of.
function encodeTraps(mutates code ByteArray, arch ast.TargetArch, bytes Count)
	match arch 'arch'
		x64 then encodeInt3s(code, bytes: bytes)
		arm64 then encodeBrks(code, bytes: bytes)
	end 'arch'
end 'encodeTraps'

function encodeBrks(mutates code ByteArray, bytes Count)
	if bytes mod arm64WordBytes != 0 'part'
		panic("link: a gap between arm64 sections of a part of a word")
	end 'part'
	for _ in 0 upto bytes / arm64WordBytes 'words'
		encodeArm64Brk(code, imm: 0)
	end 'words'
end 'encodeBrks'

// encodeInt3s fills bytes of code that nothing runs with the one-byte trap.
function encodeInt3s(mutates code ByteArray, bytes Count)
	for _ in 0 upto bytes 'each'
		encodeInt3(code)
	end 'each'
end 'encodeInt3s'
