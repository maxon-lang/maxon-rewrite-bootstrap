// The entry stub: the code the executable starts at, which sets up the heap, the standard handles and the main thread's
// context, runs main, as a green thread with the behaviours it schedules when the program uses the scheduler (start.maxon),
// and exits with what main returns. It also has the code a thread the runtime makes starts at. The rest of the runtime is Maxon source that is compiled with every program; the
// symbols it defines are the linker's to resolve.

let stdOutputHandle = -11

let stdErrorHandle = -12

// windowsShadowSize is the stack the entry and a thread's start keep below their saved registers for the DLL functions
// they call: the shadow space, and the word above it that a function's output or input goes to.
let windowsShadowSize = 40

// tebTlsSlotsOffset is where a thread's TEB, which gs addresses, holds its inline thread-local slots (TlsSlots), a word
// each; a slot that TlsAlloc gives from tebTlsSlots on lives elsewhere, which a read of the context could not reach.
export let tebTlsSlotsOffset = 0x1480

let tebTlsSlots = 64

// dwordSlot is the word above the entry's shadow space where a DWORD that a DLL function returned is zero-extended, since
// Win64 leaves the upper half of rax undefined.
let dwordSlot = 32

// tlsSlotPastTheTeb is the entry's panic when TlsAlloc gives a slot that is not inline in the TEB, or none.
let tlsSlotPastTheTeb = "the runtime's thread-local slot is not one of the TEB's 64 inline slots"

// threadExitCode is what a thread the runtime makes returns to Windows when its worker is done.
let threadExitCode = 0

// RuntimeOptions say how the entry stub is built.
export type RuntimeOptions
	// countAllocations has the entry fail when main returns with a heap box still live.
	export var countAllocations as bool

	export static function make(countAllocations bool) returns RuntimeOptions
		return RuntimeOptions{countAllocations: countAllocations}
	end 'make'
end 'RuntimeOptions'

// EntryCalls are the functions the entry calls, in order, by symbol: a program's main, whose result is the exit code, or the
// tests of an executable of tests, after which the entry exits with 0.
type EntryCalls
	var symbols as ast.StringList
	var exitsWithResult as bool

	static function make(consumes symbols ast.StringList, exitsWithResult bool) returns EntryCalls
		return EntryCalls{symbols: symbols, exitsWithResult: exitsWithResult}
	end 'make'
end 'EntryCalls'

// emitRuntime is the unit with the entry point, the start of a thread the runtime makes, and the globals the runtime's
// source reads, for the target the executable runs on. calls are the functions the entry calls. The stub is code of the
// processor's and the system's interfaces, written for each by hand.
function emitRuntime(calls EntryCalls, options RuntimeOptions, target ast.Target) returns CodeUnit
	return match target.arch 'arch'
		x64 gives emitX64Runtime(calls, options: options, system: target.system)
		arm64 gives emitArm64Runtime(calls, options: options, system: target.system)
	end 'arch'
end 'emitRuntime'

function emitX64Runtime(calls EntryCalls, options RuntimeOptions, system ast.TargetSystem) returns CodeUnit
	return match system 'system'
		windows gives emitWindowsRuntime(calls, options: options)
		linux gives emitLinuxRuntime(calls, options: options)
		macos gives panic("backend: x64 has no entry stub for macOS")
	end 'system'
end 'emitX64Runtime'

// emitWindowsRuntime is the Windows unit of the entry: the globals the runtime's source reads, the process heap and the
// standard handles, which the entry sets, and the thread-local slot; the entry, the start of a thread, and the vectored
// exception handler.
function emitWindowsRuntime(calls EntryCalls, options RuntimeOptions) returns CodeUnit
	var u = CodeUnit.new()
	u.defineData(ir.rtSymbol(ir.Rt.rtHeap), size: wordBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtStdout), size: wordBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtStderr), size: wordBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtTlsSlot), size: wordBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtTlsOffset), size: wordBytes)
	u.defineData(ir.rtSymbol(ir.Rt.rtMainContext), size: contextBytes)
	emitStartData(u)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtEntry))
	emitEntry(u, count: options.countAllocations)
	emitStartRoutines(u, a: ast.TargetArch.x64, calls: calls)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtThreadStart))
	emitThreadStart(u)
	u.beginSection()
	u.defineCode(faultSymbol)
	emitFaultHandler(u)
	emitGreenRoutines(u, system: ast.TargetSystem.windows)
	return u
end 'emitWindowsRuntime'

// emitGreenRoutines writes the stub's code of green threads, each a section that the link keeps only when the runtime's
// code that names it is kept (green.maxon).
function emitGreenRoutines(mutates u CodeUnit, system ast.TargetSystem)
	emitStackSwitch(u, system: system)
	emitGreenStart(u)
	emitAsyncPreempt(u, system: system)
end 'emitGreenRoutines'

// callRuntime calls an entry of the runtime by the internal convention with the word a register holds as its one
// argument. The entries the stub calls take one word each: main's exit code, the thread's context or the message.
function callRuntime(mutates u CodeUnit, entry ir.Rt, arg X64Register)
	if arg != argWord() 'move'
		u.asm.mov(argWord(), src: arg)
	end 'move'
	u.asm.callSymbol(ir.rtSymbol(entry))
end 'callRuntime'

// emitEntry writes the executable's entry point: it sets up the heap, the standard handles, the fault handler and the main
// thread's context, runs main (or each test) by rt.runMain, which with the scheduler runs it as a green thread until it and
// the behaviours and green threads it made have finished (start.maxon), and exits with what main returns (0 after the
// tests). In an executable that counts its allocations, the runtime's checkLeaks sees the exit code first, and exits with a
// leak report in its place when a box is still live.
function emitEntry(mutates u CodeUnit, count bool)
	u.asm.subImm(rsp, imm: windowsShadowSize)
	u.asm.callImport(impGetProcessHeap)
	u.asm.storeSymbol(ir.rtSymbol(ir.Rt.rtHeap), src: rax)
	u.asm.movImm(rcx, imm: stdOutputHandle)
	u.asm.callImport(impGetStdHandle)
	u.asm.storeSymbol(ir.rtSymbol(ir.Rt.rtStdout), src: rax)
	u.asm.movImm(rcx, imm: stdErrorHandle)
	u.asm.callImport(impGetStdHandle)
	u.asm.storeSymbol(ir.rtSymbol(ir.Rt.rtStderr), src: rax)
	emitFaultHandlerSetup(u)
	let pastTheTeb = u.asm.newLabel()
	emitTlsSetup(u, pastTheTeb: pastTheTeb)
	u.asm.callSymbol(runMainSymbol)
	if count 'leaks'
		callRuntime(u, entry: ir.Rt.rtCheckLeaks, arg: resultWord())
	end 'leaks'
	u.asm.mov(x64WindowsHostArg(0), src: resultWord())
	u.asm.callImport(impExitProcess)
	u.asm.bind(pastTheTeb)
	u.asm.leaData(argWord(), dataOffset: u.data.textOffset(tlsSlotPastTheTeb))
	u.asm.movImm(x64InternalArg(1), imm: literalWord(tlsSlotPastTheTeb))
	callRuntime(u, entry: ir.Rt.rtPanic, arg: argWord())
end 'emitEntry'

// emitTlsSetup takes the thread-local slot every thread keeps its context in, goes to pastTheTeb when the slot is not
// inline in the TEB (TLS_OUT_OF_INDEXES among them), and stores the main thread's context in it.
function emitTlsSetup(mutates u CodeUnit, pastTheTeb LabelID)
	u.asm.callImport(impTlsAlloc)
	u.asm.storeWord32(rsp, disp: dwordSlot, src: rax)
	u.asm.loadWord32(rax, base: rsp, disp: dwordSlot)
	u.asm.cmpImm(rax, imm: tebTlsSlots)
	u.asm.jcc(MCond.aboveEqual, label: pastTheTeb)
	u.asm.storeSymbol(ir.rtSymbol(ir.Rt.rtTlsSlot), src: rax)
	u.asm.movImm(rcx, imm: wordBytes)
	u.asm.imul(rcx, src: rax)
	u.asm.storeSymbol(ir.rtSymbol(ir.Rt.rtTlsOffset), src: rcx)
	u.asm.leaSymbol(rdx, symbol: ir.rtSymbol(ir.Rt.rtMainContext))
	emitTlsStore(u)
end 'emitTlsSetup'

// emitTlsStore stores rdx in the running thread's thread-local slot.
function emitTlsStore(mutates u CodeUnit)
	u.asm.loadSymbol(rcx, symbol: ir.rtSymbol(ir.Rt.rtTlsSlot))
	u.asm.callImport(impTlsSetValue)
end 'emitTlsStore'

// threadContextRegister is where a thread's start holds the thread's context across its calls: a register the internal
// convention keeps, so that workerMain and the DLL functions leave it.
function threadContextRegister() returns X64Register
	let kept = x64InternalCalleeSaved() and x64WindowsHostCalleeSaved() and classMask(x64Arch, class: RegClass.gpr)
	for r in 0 upto x64FirstVector 'registers'
		if maskHas(kept, number: regNumOfCount(r)) 'kept'
			return x64RegisterOf(regNumOfCount(r))
		end 'kept'
	end 'registers'
	panic("backend: no general register that both conventions keep")
end 'threadContextRegister'

// threadSaves are the registers a thread's start saves, since Win64 has a callee keep them: those that the code it runs
// by the internal convention may change, and the one it holds the context in. The frame pointer is no value's, and the
// code it runs keeps it.
function threadSaves() returns RegMask
	let changed = x64WindowsHostCalleeSaved() and not x64InternalCalleeSaved()
	return (changed or regMaskOf(threadContextRegister())) and classMask(x64Arch, class: RegClass.gpr) and not reservedMask(x64Arch)
end 'threadSaves'

// emitThreadSaves pushes threadSaves, and is how many it pushed. The xmm registers Win64 keeps, the internal convention
// keeps too.
function emitThreadSaves(mutates u CodeUnit) returns Count
	var pushed = 0 as Count
	for r in 0 upto x64FirstVector 'saved'
		if maskHas(threadSaves(), number: regNumOfCount(r)) 'save'
			u.asm.push(x64RegisterOf(regNumOfCount(r)))
			pushed = nextCount(pushed)
		end 'save'
	end 'saved'
	return pushed
end 'emitThreadSaves'

function emitThreadRestores(mutates u CodeUnit)
	var r = x64FirstVector as Count
	while r > 0 'saved'
		r = prevCount(r)
		if maskHas(threadSaves(), number: regNumOfCount(r)) 'restore'
			u.asm.pop(x64RegisterOf(regNumOfCount(r)))
		end 'restore'
	end 'saved'
end 'emitThreadRestores'

// threadFrameBytes is the frame below a thread's saved registers: windowsShadowSize, and a word more when the return
// address and the pushes leave rsp off the alignment a DLL function's call needs.
function threadFrameBytes(pushed Count) returns Count
	let above = try (pushed + 1) * wordBytes otherwise panic("backend: a thread's start past memory")
	let below = try alignUp(above + windowsShadowSize, alignment: x64StackAlignment) - above otherwise panic("backend: a thread's start past memory")
	return below
end 'threadFrameBytes'

// emitThreadStart writes the code a thread the runtime makes starts at, which CreateThread calls by Win64 with the
// thread's context in rcx: it keeps stack for the fault handler, stores the context in the thread-local slot, and calls
// the runtime's workerMain with it by the internal convention.
function emitThreadStart(mutates u CodeUnit)
	let context = threadContextRegister()
	let frame = imm32Of(threadFrameBytes(emitThreadSaves(u)))
	u.asm.subImm(rsp, imm: frame)
	u.asm.mov(context, src: x64WindowsHostArg(0))
	emitStackGuarantee(u)
	u.asm.mov(rdx, src: context)
	emitTlsStore(u)
	callRuntime(u, entry: ir.Rt.rtWorkerMain, arg: context)
	u.asm.addImm(rsp, imm: frame)
	emitThreadRestores(u)
	u.asm.movImm(x64WindowsHostResult, imm: threadExitCode)
	u.asm.ret()
end 'emitThreadStart'

// importIndex is the slot of a DLL import in the executable's import table, which a call of it goes through.
export function importIndex(name String) returns Count
	let names = rtImports()
	for i in 0 upto names.count() 'names'
		if names[i] == name 'found'
			return i
		end 'found'
	end 'names'
	panic("backend: the runtime calls a DLL function the executable does not import")
end 'importIndex'

// faultSymbol is the vectored exception handler that turns a hardware fault into a panic line, as maxon's runtime does:
// without it a stack overflow or an access violation ends the process with no word of what happened.
let faultSymbol = "rt.fault"

// faultExitCode is what a fault exits with: the runtime's panic code, since a fault ends the program as a panic does.
let faultExitCode = 1

// faultStackGuarantee is the stack Windows keeps past the guard page for the handler (SetThreadStackGuarantee), since a
// stack overflow runs the handler on the stack it has spent. Maxon keeps the same.
let faultStackGuarantee = 32768

// vectoredHandlerFirst has AddVectoredExceptionHandler call the handler before any other.
let vectoredHandlerFirst = 1

// continueSearch is the handler's answer for an exception it does not convert, which leaves it to the system.
let continueSearch = 0

// The handler's argument is an EXCEPTION_POINTERS, whose first word points at the EXCEPTION_RECORD; the record holds the
// 32-bit exception code first and the address of the faulting instruction at exceptionAddressOffset.
let exceptionRecordOffset = 0

let exceptionCodeOffset = 0

let exceptionAddressOffset = 16

// What a fault's panic line says it was, as maxon's runtime words it, after "panic: " and before the faulting address.
let stackOverflowWords = "stack overflow"

let accessViolationWords = "nil pointer or invalid memory access"

let divideByZeroWords = "integer divide by zero"

let integerOverflowWords = "integer overflow"

// faultLineOpening is a fault's panic line up to the faulting address.
function faultLineOpening(words String) returns String
	return "panic: {words} at rip=0x"
end 'faultLineOpening'

// The Windows exception codes the handler converts, those maxon's does.
let excStackOverflow = 3221225725

let excAccessViolation = 3221225477

let excIntDivideByZero = 3221225620

let excIntOverflow = 3221225621

// The handler's frame below the shadow space: WriteFile's fifth argument, the count it writes back, the address as hex
// digits and the newline after them, and the faulting address. faultFrameSize keeps rsp 16-byte aligned at each call,
// since the handler is entered 8 bytes off.
let faultFifthArgSlot = 32

let faultWrittenSlot = 40

let faultDigitsSlot = 48

let addressDigits = 16

let faultNewlineSlot = 64

let faultAddressSlot = 72

let faultFrameSize = 88

let nibbleBits = 4

let nibbleMask = 15

let newlineByte = 10

let hexDigits = "0123456789abcdef"

// guaranteeSlot is the word above the entry's shadow space, where SetThreadStackGuarantee reads the size from.
let guaranteeSlot = 32

// emitFaultHandlerSetup keeps stack for the fault handler and registers it, before main runs.
function emitFaultHandlerSetup(mutates u CodeUnit)
	emitStackGuarantee(u)
	u.asm.movImm(rcx, imm: vectoredHandlerFirst)
	u.asm.leaSymbol(rdx, symbol: faultSymbol)
	u.asm.callImport(impAddVectoredExceptionHandler)
end 'emitFaultHandlerSetup'

// emitStackGuarantee keeps stack past the guard page of the running thread for the fault handler, in a frame of the
// entry's shape.
function emitStackGuarantee(mutates u CodeUnit)
	u.asm.movImm(rax, imm: faultStackGuarantee)
	u.asm.store(rsp, disp: guaranteeSlot, src: rax)
	u.asm.lea(rcx, base: rsp, disp: guaranteeSlot)
	u.asm.callImport(impSetThreadStackGuarantee)
end 'emitStackGuarantee'

// emitFaultHandler writes the vectored exception handler (Win64 ABI: the EXCEPTION_POINTERS in rcx, the answer in rax).
// For a fault it converts it writes `panic: <what> at rip=0x<address>` to standard error and exits, as maxon's does; it
// calls nothing but kernel32 and allocates nothing, so it works when the heap or the stack is what failed. Every other
// exception goes on to the system.
function emitFaultHandler(mutates u CodeUnit)
	let report = u.asm.newLabel()
	u.asm.subImm(rsp, imm: faultFrameSize)
	u.asm.load(rax, base: rcx, disp: exceptionRecordOffset)
	u.asm.loadWord32(rdx, base: rax, disp: exceptionCodeOffset)
	u.asm.load(r11, base: rax, disp: exceptionAddressOffset)
	u.asm.store(rsp, disp: faultAddressSlot, src: r11)
	emitFaultArm(u, code: excStackOverflow, words: stackOverflowWords, report: report)
	emitFaultArm(u, code: excAccessViolation, words: accessViolationWords, report: report)
	emitFaultArm(u, code: excIntDivideByZero, words: divideByZeroWords, report: report)
	emitFaultArm(u, code: excIntOverflow, words: integerOverflowWords, report: report)
	u.asm.addImm(rsp, imm: faultFrameSize)
	u.asm.movImm(rax, imm: continueSearch)
	u.asm.ret()
	u.asm.bind(report)
	u.asm.load(r8, base: rax, disp: 0)
	u.asm.lea(rdx, base: rax, disp: wordBytes)
	emitStderrWrite(u)
	emitAddressDigits(u)
	u.asm.lea(rdx, base: rsp, disp: faultDigitsSlot)
	u.asm.movImm(r8, imm: addressDigits + 1)
	emitStderrWrite(u)
	emitExitClaim(u)
	u.asm.movImm(rcx, imm: faultExitCode)
	u.asm.callImport(impExitProcess)
end 'emitFaultHandler'

// emitExitClaim takes the exit claim of the scheduler for the faulting thread before it ends the process, as the runtime's
// exitProcess does (runtime/monitor.maxon), waiting out a suspension the monitor has under way, so that ExitProcess never
// meets a thread the monitor suspended, which may hold a lock of the system's that ExitProcess takes (Go's suspendLock). A
// thread with no context yet, or a process with no scheduler, has no monitor to wait out. It works in rax, rdx and r10.
function emitExitClaim(mutates u CodeUnit)
	let claimed = u.asm.newLabel()
	let retry = u.asm.newLabel()
	emitLoadContext(u, system: ast.TargetSystem.windows, dst: rdx)
	u.asm.test(rdx, right: rdx)
	u.asm.jcc(MCond.equal, label: claimed)
	u.asm.load(r10, base: rdx, disp: imm32Of(contextSchedulerOffset))
	u.asm.test(r10, right: r10)
	u.asm.jcc(MCond.equal, label: claimed)
	u.asm.bind(retry)
	u.asm.movImm(rax, imm: 0)
	u.asm.lockCmpxchg(r10, disp: imm32Of(schedExitClaimOffset), src: rdx)
	u.asm.jcc(MCond.equal, label: claimed)
	u.asm.cmp(rax, right: rdx)
	u.asm.jcc(MCond.equal, label: claimed)
	u.asm.pause()
	u.asm.jmp(retry)
	u.asm.bind(claimed)
end 'emitExitClaim'

// emitAddressDigits writes the faulting address, in the handler's frame, as addressDigits hexadecimal digits and a newline
// at faultDigitsSlot, with rax, rcx, rdx, r10 and r11.
function emitAddressDigits(mutates u CodeUnit)
	u.asm.load(rax, base: rsp, disp: faultAddressSlot)
	u.asm.leaData(r10, dataOffset: u.data.countedTextOffset(hexDigits))
	u.asm.movImm(rcx, imm: nibbleBits)
	for i in 0 upto addressDigits 'digits'
		let lastDigit = try faultDigitsSlot + addressDigits - 1 otherwise panic("backend: the fault frame is past 2 GiB")
		u.asm.mov(rdx, src: rax)
		u.asm.andImm(rdx, imm: nibbleMask)
		u.asm.add(rdx, src: r10)
		u.asm.loadByte(r11, base: rdx, disp: wordBytes)
		u.asm.storeByte(rsp, disp: imm32Of(try lastDigit - i otherwise panic("backend: a digit before the fault frame")), src: r11)
		u.asm.shrCl(rax)
	end 'digits'
	u.asm.movImm(r11, imm: newlineByte)
	u.asm.storeByte(rsp, disp: faultNewlineSlot, src: r11)
end 'emitAddressDigits'

// emitFaultArm goes to report with the panic line's opening in rax when the exception code in rdx is code.
function emitFaultArm(mutates u CodeUnit, code FullRangeInt, words String, report LabelID)
	let next = u.asm.newLabel()
	u.asm.movImm(r10, imm: code)
	u.asm.cmp(rdx, right: r10)
	u.asm.jcc(MCond.notEqual, label: next)
	u.asm.leaData(rax, dataOffset: u.data.countedTextOffset(faultLineOpening(words)))
	u.asm.jmp(report)
	u.asm.bind(next)
end 'emitFaultArm'

// emitStderrWrite writes the r8 bytes at rdx to standard error with WriteFile.
function emitStderrWrite(mutates u CodeUnit)
	u.asm.loadSymbol(rcx, symbol: ir.rtSymbol(ir.Rt.rtStderr))
	u.asm.lea(r9, base: rsp, disp: faultWrittenSlot)
	u.asm.movImm(r10, imm: 0)
	u.asm.store(rsp, disp: faultFifthArgSlot, src: r10)
	u.asm.callImport(impWriteFile)
end 'emitStderrWrite'
