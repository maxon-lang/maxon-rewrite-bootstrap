	arm64Emit(code, word: 0x92800000 or arm64RegisterField(dest, at: 0) or ((imm as Arm64Bits) shl 5) or ((shift as Arm64Bits) shl 21))
end 'encodeArm64MovnRegImm'

// movk dest, imm, shift: 0xF2800000.
export function encodeArm64MovkRegImm(mutates code ByteArray, dest Arm64Register, imm Arm64Imm16, shift Arm64Imm2)
	arm64Emit(code, word: 0xF2800000 or arm64RegisterField(dest, at: 0) or ((imm as Arm64Bits) shl 5) or ((shift as Arm64Bits) shl 21))
end 'encodeArm64MovkRegImm'

// mov dest, imm: the ladder of the word, one to four moves.
export function encodeArm64MovRegWord(mutates code ByteArray, dest Arm64Register, imm FullRangeInt)
	encodeArm64MovImm(code, dest: dest, value: imm)
end 'encodeArm64MovRegWord'

// ubfm dest, src, immr, imms: 0xD3400000.
export function encodeArm64UbfmRegReg(mutates code ByteArray, dest Arm64Register, src Arm64Register, immr Arm64Imm6, imms Arm64Imm6)
	arm64Emit(code, word: 0xD3400000 or arm64RegisterField(dest, at: 0) or arm64RegisterField(src, at: 5) or ((immr as Arm64Bits) shl 16) or ((imms as Arm64Bits) shl 10))
end 'encodeArm64UbfmRegReg'

// sbfm dest, src, immr, imms: 0x93400000.
export function encodeArm64SbfmRegReg(mutates code ByteArray, dest Arm64Register, src Arm64Register, immr Arm64Imm6, imms Arm64Imm6)
	arm64Emit(code, word: 0x93400000 or arm64RegisterField(dest, at: 0) or arm64RegisterField(src, at: 5) or ((immr as Arm64Bits) shl 16) or ((imms as Arm64Bits) shl 10))
end 'encodeArm64SbfmRegReg'

// csel dest, left, right, cond: 0x9A800000.
export function encodeArm64CselRegReg(mutates code ByteArray, dest Arm64Register, left Arm64Register, right Arm64Register, cond MCond)
	arm64Emit(code, word: 0x9A800000 or arm64RegisterField(dest, at: 0) or arm64RegisterField(left, at: 5) or arm64RegisterField(right, at: 16) or (arm64ConditionCode(cond) shl 12))
end 'encodeArm64CselRegReg'

// csinc dest, left, right, cond: 0x9A800400.
export function encodeArm64CsincRegReg(mutates code ByteArray, dest Arm64Register, left Arm64Register, right Arm64Register, cond MCond)
	arm64Emit(code, word: 0x9A800400 or arm64RegisterField(dest, at: 0) or arm64RegisterField(left, at: 5) or arm64RegisterField(right, at: 16) or (arm64ConditionCode(cond) shl 12))
end 'encodeArm64CsincRegReg'

// cset dest, cond: 0x9A9F07E0.
export function encodeArm64CsetReg(mutates code ByteArray, dest Arm64Register, cond MCond)
	arm64Emit(code, word: 0x9A9F07E0 or arm64RegisterField(dest, at: 0) or ((arm64ConditionCode(cond) xor arm64OppositeCondition) shl 12))
end 'encodeArm64CsetReg'

// ldr dest, [base + disp]: 0xF9400000.
export function encodeArm64Ldr64Off(mutates code ByteArray, dest Arm64Register, base Arm64Register, disp Imm32)
	arm64Emit(code, word: 0xF9400000 or arm64RegisterField(dest, at: 0) or arm64RegisterField(base, at: 5) or arm64UnitsField(disp as FullRangeInt, scale: 8, low: 0, high: 4095, bits: 12, at: 10))
end 'encodeArm64Ldr64Off'

