end 'arm64Ldp64PreHolds'

// arm64Ldp64PostHolds is whether the offset of Ldp64Post holds disp.
export function arm64Ldp64PostHolds(disp FullRangeInt) returns bool
	return arm64HoldsUnits(disp, scale: 8, low: -64, high: 63)
end 'arm64Ldp64PostHolds'

// arm64StpDHolds is whether the offset of StpD holds disp.
export function arm64StpDHolds(disp FullRangeInt) returns bool
	return arm64HoldsUnits(disp, scale: 8, low: -64, high: 63)
end 'arm64StpDHolds'

// arm64StpDPreHolds is whether the offset of StpDPre holds disp.
export function arm64StpDPreHolds(disp FullRangeInt) returns bool
	return arm64HoldsUnits(disp, scale: 8, low: -64, high: 63)
end 'arm64StpDPreHolds'

// arm64StpDPostHolds is whether the offset of StpDPost holds disp.
export function arm64StpDPostHolds(disp FullRangeInt) returns bool
	return arm64HoldsUnits(disp, scale: 8, low: -64, high: 63)
end 'arm64StpDPostHolds'

// arm64LdpDHolds is whether the offset of LdpD holds disp.
export function arm64LdpDHolds(disp FullRangeInt) returns bool
	return arm64HoldsUnits(disp, scale: 8, low: -64, high: 63)
end 'arm64LdpDHolds'

// arm64LdpDPreHolds is whether the offset of LdpDPre holds disp.
export function arm64LdpDPreHolds(disp FullRangeInt) returns bool
	return arm64HoldsUnits(disp, scale: 8, low: -64, high: 63)
end 'arm64LdpDPreHolds'

// arm64LdpDPostHolds is whether the offset of LdpDPost holds disp.
export function arm64LdpDPostHolds(disp FullRangeInt) returns bool
	return arm64HoldsUnits(disp, scale: 8, low: -64, high: 63)
end 'arm64LdpDPostHolds'

// Arm64Form is every form of the table that a machine instruction holds, for the instruction selection to ask
// about.
export enum Arm64Form
	addRegReg
	addRegRegLsl
	addRegRegLsr
	subRegRegLsl
	subRegReg
	addsRegReg
	subsRegReg
	cmpRegReg
	negReg
	andRegReg
	orrRegReg
	eorRegReg
	andsRegReg
	tstRegReg
	movRegReg
	mvnRegReg
	mulRegReg
	smulhRegReg
	umulhRegReg
	sdivRegReg
	udivRegReg
	lslvRegReg
	lsrvRegReg
	asrvRegReg
	rorvRegReg
	rbitRegReg
	clzRegReg
	addRegImm
	addRegImmHigh
	subRegImm
	subRegImmHigh
	addsRegImm
	subsRegImm
	cmpRegImm
	cmnRegImm
	andRegMask
	orrRegMask
	eorRegMask
	andsRegMask
	tstRegMask
	movRegMask
	movzRegImm
	movnRegImm
	movkRegImm
	movRegWord
	ubfmRegReg
	sbfmRegReg
	cselRegReg
	csincRegReg
	csetReg
	ldr64Off
	str64Off
	ldr64Unscaled
	str64Unscaled
	ldr64Idx
	str64Idx
	ldr32Off
	str32Off
	ldr32Unscaled
	str32Unscaled
	ldr32Idx
	str32Idx
	ldrhOff
	strhOff
	ldrhUnscaled
	strhUnscaled
	ldrhIdx
	strhIdx
	ldrbOff
	strbOff
	ldrbUnscaled
	strbUnscaled
	ldrbIdx
	strbIdx
	ldrDOff
	strDOff
	ldrDUnscaled
	strDUnscaled
	ldrDIdx
	strDIdx
	ldrswOff
	ldrshOff
	ldrsbOff
	ldr64Idx1
	str64Idx1
	adrp
	adr
	addPageOff
	ldr64PageOff
	str64PageOff
	ldrDPageOff
	b
	bl
	bCond
	cbz
	cbnz
	br
	blr
	ret
	fadd
	fsub
	fmul
	fdiv
	fsqrt
	fneg
	fabs
	fmovDD
	fmovDImm
	frintn
	frintm
	frintp
	frintz
	fcmp
	fcmpZero
	fcsel
	fcvtzs
	scvtf
	ucvtf
	fmovDX
	fmovXD
	eorVec
	ldar
	stlr
	ldaxr
	stlxr
	casalX0
	ldaddal
	swpal
	dmbIsh
	isb
	yield
	nop
	brk
	svc
	mrsTpidr
	mrsTpidrro
	msrTpidr
	mrsNzcv
	msrNzcv
end 'Arm64Form'

// arm64FormBase is the FormID of arm64's first form: its forms are a range of FormIDs of their own.
let arm64FormBase = 256

// arm64FormID is the FormID of a form.
export function arm64FormID(form Arm64Form) returns FormID
	return try (arm64FormBase + form.rawValue) as FormID otherwise panic("backend: an arm64 form past the FormIDs")
end 'arm64FormID'

// arm64RegisterOf is the general register with a number of the register file.
export function arm64RegisterOf(number RegNum) returns Arm64Register
	return match number 'number'
		0 gives Arm64Register.x0
		1 gives Arm64Register.x1
		2 gives Arm64Register.x2
		3 gives Arm64Register.x3
		4 gives Arm64Register.x4
		5 gives Arm64Register.x5
		6 gives Arm64Register.x6
		7 gives Arm64Register.x7
		8 gives Arm64Register.x8
		9 gives Arm64Register.x9
		10 gives Arm64Register.x10
		11 gives Arm64Register.x11
		12 gives Arm64Register.x12
		13 gives Arm64Register.x13
		14 gives Arm64Register.x14
		15 gives Arm64Register.x15
		16 gives Arm64Register.x16
		17 gives Arm64Register.x17
		18 gives Arm64Register.x18
		19 gives Arm64Register.x19
		20 gives Arm64Register.x20
		21 gives Arm64Register.x21
		22 gives Arm64Register.x22
		23 gives Arm64Register.x23
		24 gives Arm64Register.x24
		25 gives Arm64Register.x25
		26 gives Arm64Register.x26
		27 gives Arm64Register.x27
		28 gives Arm64Register.x28
		29 gives Arm64Register.x29
		30 gives Arm64Register.x30
		31 gives Arm64Register.sp
		default panic("backend: a register number that is no general register")
	end 'number'
end 'arm64RegisterOf'

// encodeArm64MachineForm encodes a form from the fields of a machine instruction: a defines, a reused register is
// the same as a, and the registers a form does not have are not read.
export function encodeArm64MachineForm(mutates code ByteArray, form FormID, a Arm64Register, b Arm64Register, c Arm64Register, aux Imm32, imm FullRangeInt, cond MCond)
	match form 'form'
		256 then encodeArm64AddRegReg(code, dest: a, left: b, right: c)
		257 then encodeArm64AddRegRegLsl(code, dest: a, left: b, right: c, shift: try imm as Arm64Imm6 otherwise panic("backend: the immediate of AddRegRegLsl does not fit it"))
		258 then encodeArm64AddRegRegLsr(code, dest: a, left: b, right: c, shift: try imm as Arm64Imm6 otherwise panic("backend: the immediate of AddRegRegLsr does not fit it"))
		259 then encodeArm64SubRegRegLsl(code, dest: a, left: b, right: c, shift: try imm as Arm64Imm6 otherwise panic("backend: the immediate of SubRegRegLsl does not fit it"))
		260 then encodeArm64SubRegReg(code, dest: a, left: b, right: c)
		261 then encodeArm64AddsRegReg(code, dest: a, left: b, right: c)
		262 then encodeArm64SubsRegReg(code, dest: a, left: b, right: c)
		263 then encodeArm64CmpRegReg(code, left: a, right: b)
		264 then encodeArm64NegReg(code, dest: a, src: b)
		265 then encodeArm64AndRegReg(code, dest: a, left: b, right: c)
		266 then encodeArm64OrrRegReg(code, dest: a, left: b, right: c)
		267 then encodeArm64EorRegReg(code, dest: a, left: b, right: c)
		268 then encodeArm64AndsRegReg(code, dest: a, left: b, right: c)
		269 then encodeArm64TstRegReg(code, left: a, right: b)
		270 then encodeArm64MovRegReg(code, dest: a, src: b)
		271 then encodeArm64MvnRegReg(code, dest: a, src: b)
		272 then encodeArm64MulRegReg(code, dest: a, left: b, right: c)
		273 then encodeArm64SmulhRegReg(code, dest: a, left: b, right: c)
		274 then encodeArm64UmulhRegReg(code, dest: a, left: b, right: c)
		275 then encodeArm64SdivRegReg(code, dest: a, left: b, right: c)
		276 then encodeArm64UdivRegReg(code, dest: a, left: b, right: c)
		277 then encodeArm64LslvRegReg(code, dest: a, left: b, right: c)
		278 then encodeArm64LsrvRegReg(code, dest: a, left: b, right: c)
		279 then encodeArm64AsrvRegReg(code, dest: a, left: b, right: c)
		280 then encodeArm64RorvRegReg(code, dest: a, left: b, right: c)
		281 then encodeArm64RbitRegReg(code, dest: a, src: b)
		282 then encodeArm64ClzRegReg(code, dest: a, src: b)
		283 then encodeArm64AddRegImm(code, dest: a, src: b, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of AddRegImm does not fit it"))
		284 then encodeArm64AddRegImmHigh(code, dest: a, src: b, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of AddRegImmHigh does not fit it"))
		285 then encodeArm64SubRegImm(code, dest: a, src: b, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of SubRegImm does not fit it"))
		286 then encodeArm64SubRegImmHigh(code, dest: a, src: b, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of SubRegImmHigh does not fit it"))
		287 then encodeArm64AddsRegImm(code, dest: a, src: b, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of AddsRegImm does not fit it"))
		288 then encodeArm64SubsRegImm(code, dest: a, src: b, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of SubsRegImm does not fit it"))
		289 then encodeArm64CmpRegImm(code, left: a, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of CmpRegImm does not fit it"))
		290 then encodeArm64CmnRegImm(code, left: a, imm: try imm as Arm64Imm12 otherwise panic("backend: the immediate of CmnRegImm does not fit it"))
		291 then encodeArm64AndRegMask(code, dest: a, src: b, imm: imm)
		292 then encodeArm64OrrRegMask(code, dest: a, src: b, imm: imm)
		293 then encodeArm64EorRegMask(code, dest: a, src: b, imm: imm)
		294 then encodeArm64AndsRegMask(code, dest: a, src: b, imm: imm)
		295 then encodeArm64TstRegMask(code, left: a, imm: imm)
		296 then encodeArm64MovRegMask(code, dest: a, imm: imm)
		297 then encodeArm64MovzRegImm(code, dest: a, imm: try imm as Arm64Imm16 otherwise panic("backend: the immediate of MovzRegImm does not fit it"), shift: try aux as Arm64Imm2 otherwise panic("backend: the immediate of MovzRegImm does not fit it"))
		298 then encodeArm64MovnRegImm(code, dest: a, imm: try imm as Arm64Imm16 otherwise panic("backend: the immediate of MovnRegImm does not fit it"), shift: try aux as Arm64Imm2 otherwise panic("backend: the immediate of MovnRegImm does not fit it"))
		299 then encodeArm64MovkRegImm(code, dest: a, imm: try imm as Arm64Imm16 otherwise panic("backend: the immediate of MovkRegImm does not fit it"), shift: try aux as Arm64Imm2 otherwise panic("backend: the immediate of MovkRegImm does not fit it"))
		300 then encodeArm64MovRegWord(code, dest: a, imm: imm)
		301 then encodeArm64UbfmRegReg(code, dest: a, src: b, immr: try imm as Arm64Imm6 otherwise panic("backend: the immediate of UbfmRegReg does not fit it"), imms: try aux as Arm64Imm6 otherwise panic("backend: the immediate of UbfmRegReg does not fit it"))
		302 then encodeArm64SbfmRegReg(code, dest: a, src: b, immr: try imm as Arm64Imm6 otherwise panic("backend: the immediate of SbfmRegReg does not fit it"), imms: try aux as Arm64Imm6 otherwise panic("backend: the immediate of SbfmRegReg does not fit it"))
		303 then encodeArm64CselRegReg(code, dest: a, left: b, right: c, cond: cond)
		304 then encodeArm64CsincRegReg(code, dest: a, left: b, right: c, cond: cond)
		305 then encodeArm64CsetReg(code, dest: a, cond: cond)
		306 then encodeArm64Ldr64Off(code, dest: a, base: b, disp: aux)
		307 then encodeArm64Str64Off(code, src: a, base: b, disp: aux)
		308 then encodeArm64Ldr64Unscaled(code, dest: a, base: b, disp: aux)
		309 then encodeArm64Str64Unscaled(code, src: a, base: b, disp: aux)
		310 then encodeArm64Ldr64Idx(code, dest: a, base: b, index: c)
		311 then encodeArm64Str64Idx(code, src: a, base: b, index: c)
		312 then encodeArm64Ldr32Off(code, dest: a, base: b, disp: aux)
		313 then encodeArm64Str32Off(code, src: a, base: b, disp: aux)
		314 then encodeArm64Ldr32Unscaled(code, dest: a, base: b, disp: aux)
		315 then encodeArm64Str32Unscaled(code, src: a, base: b, disp: aux)
		316 then encodeArm64Ldr32Idx(code, dest: a, base: b, index: c)
		317 then encodeArm64Str32Idx(code, src: a, base: b, index: c)
		318 then encodeArm64LdrhOff(code, dest: a, base: b, disp: aux)
		319 then encodeArm64StrhOff(code, src: a, base: b, disp: aux)
		320 then encodeArm64LdrhUnscaled(code, dest: a, base: b, disp: aux)
		321 then encodeArm64StrhUnscaled(code, src: a, base: b, disp: aux)
		322 then encodeArm64LdrhIdx(code, dest: a, base: b, index: c)
		323 then encodeArm64StrhIdx(code, src: a, base: b, index: c)
		324 then encodeArm64LdrbOff(code, dest: a, base: b, disp: aux)
		325 then encodeArm64StrbOff(code, src: a, base: b, disp: aux)
		326 then encodeArm64LdrbUnscaled(code, dest: a, base: b, disp: aux)
		327 then encodeArm64StrbUnscaled(code, src: a, base: b, disp: aux)
		328 then encodeArm64LdrbIdx(code, dest: a, base: b, index: c)
		329 then encodeArm64StrbIdx(code, src: a, base: b, index: c)
		330 then encodeArm64LdrDOff(code, dest: a, base: b, disp: aux)
		331 then encodeArm64StrDOff(code, src: a, base: b, disp: aux)
		332 then encodeArm64LdrDUnscaled(code, dest: a, base: b, disp: aux)
		333 then encodeArm64StrDUnscaled(code, src: a, base: b, disp: aux)
		334 then encodeArm64LdrDIdx(code, dest: a, base: b, index: c)
		335 then encodeArm64StrDIdx(code, src: a, base: b, index: c)
		336 then encodeArm64LdrswOff(code, dest: a, base: b, disp: aux)
		337 then encodeArm64LdrshOff(code, dest: a, base: b, disp: aux)
		338 then encodeArm64LdrsbOff(code, dest: a, base: b, disp: aux)
		339 then encodeArm64Ldr64Idx1(code, dest: a, base: b, index: c)
		340 then encodeArm64Str64Idx1(code, src: a, base: b, index: c)
		341 then encodeArm64Adrp(code, dest: a, pages: 0)
		342 then encodeArm64Adr(code, dest: a, rel: 0)
		343 then encodeArm64AddPageOff(code, dest: a, src: b, offset: 0)
		344 then encodeArm64Ldr64PageOff(code, dest: a, base: b, offset: 0)
		345 then encodeArm64Str64PageOff(code, src: a, base: b, offset: 0)
		346 then encodeArm64LdrDPageOff(code, dest: a, base: b, offset: 0)
		347 then encodeArm64B(code, rel: 0)
		348 then encodeArm64Bl(code, rel: 0)
		349 then encodeArm64BCond(code, cond: cond, rel: 0)
		350 then encodeArm64Cbz(code, src: a, rel: 0)
		351 then encodeArm64Cbnz(code, src: a, rel: 0)
		352 then encodeArm64Br(code, target: a)
		353 then encodeArm64Blr(code, target: a)
		354 then encodeArm64Ret(code)
		355 then encodeArm64Fadd(code, dest: a, left: b, right: c)
		356 then encodeArm64Fsub(code, dest: a, left: b, right: c)
		357 then encodeArm64Fmul(code, dest: a, left: b, right: c)
		358 then encodeArm64Fdiv(code, dest: a, left: b, right: c)
		359 then encodeArm64Fsqrt(code, dest: a, src: b)
		360 then encodeArm64Fneg(code, dest: a, src: b)
		361 then encodeArm64Fabs(code, dest: a, src: b)
		362 then encodeArm64FmovDD(code, dest: a, src: b)
		363 then encodeArm64FmovDImm(code, dest: a, imm: try imm as Arm64Imm8 otherwise panic("backend: the immediate of FmovDImm does not fit it"))
		364 then encodeArm64Frintn(code, dest: a, src: b)
		365 then encodeArm64Frintm(code, dest: a, src: b)
		366 then encodeArm64Frintp(code, dest: a, src: b)
		367 then encodeArm64Frintz(code, dest: a, src: b)
		368 then encodeArm64Fcmp(code, left: a, right: b)
		369 then encodeArm64FcmpZero(code, left: a)
		370 then encodeArm64Fcsel(code, dest: a, left: b, right: c, cond: cond)
		371 then encodeArm64Fcvtzs(code, dest: a, src: b)
		372 then encodeArm64Scvtf(code, dest: a, src: b)
		373 then encodeArm64Ucvtf(code, dest: a, src: b)
		374 then encodeArm64FmovDX(code, dest: a, src: b)
		375 then encodeArm64FmovXD(code, dest: a, src: b)
		376 then encodeArm64EorVec(code, dest: a, left: b, right: c)
		377 then encodeArm64Ldar(code, dest: a, base: b)
		378 then encodeArm64Stlr(code, src: a, base: b)
		379 then encodeArm64Ldaxr(code, dest: a, base: b)
		380 then encodeArm64Stlxr(code, status: a, src: b, base: c)
		381 then encodeArm64CasalX0(code, src: a, base: b)
		382 then encodeArm64Ldaddal(code, dest: a, src: b, base: c)
		383 then encodeArm64Swpal(code, dest: a, src: b, base: c)
		384 then encodeArm64DmbIsh(code)
		385 then encodeArm64Isb(code)
		386 then encodeArm64Yield(code)
		387 then encodeArm64Nop(code)
		388 then encodeArm64Brk(code, imm: try imm as Arm64Imm16 otherwise panic("backend: the immediate of Brk does not fit it"))
		389 then encodeArm64Svc(code)
		390 then encodeArm64MrsTpidr(code, dest: a)
		391 then encodeArm64MrsTpidrro(code, dest: a)
		392 then encodeArm64MsrTpidr(code, src: a)
		393 then encodeArm64MrsNzcv(code, dest: a)
		394 then encodeArm64MsrNzcv(code, src: a)
		default then panic("backend: a machine instruction of a form of no arm64 form")
	end 'form'
end 'encodeArm64MachineForm'
