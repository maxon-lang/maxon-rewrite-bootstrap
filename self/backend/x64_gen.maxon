// mov [rip + disp], src: REX.W 89 /r.
export function encodeStoreRipReg(mutates code ByteArray, disp Imm32, src X64Register)
	emitRex(code, wide: true, regField: src, rmField: X64Register.rax, force: false)
	code.push(0x89)
	writeModRmRip(code, regBits: regLow3(src))
	writeImm32(code, value: disp)
end 'encodeStoreRipReg'

// call [rip + disp]: FF /2.
export function encodeCallRip(mutates code ByteArray, disp Imm32)
	code.push(0xFF)
	writeModRmRip(code, regBits: 2)
	writeImm32(code, value: disp)
end 'encodeCallRip'

// call reg: FF /2.
export function encodeCallReg(mutates code ByteArray, reg X64Register)
	emitRex(code, wide: false, regField: X64Register.rax, rmField: reg, force: false)
	code.push(0xFF)
	writeModRmReg(code, regBits: 2, rm: reg)
end 'encodeCallReg'

// jmp rel: E9.
export function encodeJmpRel32(mutates code ByteArray, rel Imm32)
	code.push(0xE9)
	writeImm32(code, value: rel)
end 'encodeJmpRel32'

// call rel: E8.
export function encodeCallRel32(mutates code ByteArray, rel Imm32)
	code.push(0xE8)
	writeImm32(code, value: rel)
end 'encodeCallRel32'

// jcc cond, rel: 0F 80+cc.
export function encodeJccRel32(mutates code ByteArray, cond X64CondCode, rel Imm32)
	code.push(0x0F)
	code.push(0x80 + conditionBits(cond))
	writeImm32(code, value: rel)
end 'encodeJccRel32'

// movq src: 66 REX.W 0F 6E /0.
export function encodeMovqXmm0Reg(mutates code ByteArray, src X64Register)
	code.push(0x66)
	emitRex(code, wide: true, regField: X64Register.rax, rmField: src, force: false)
	code.push(0x0F)
	code.push(0x6E)
	writeModRmReg(code, regBits: 0, rm: src)
end 'encodeMovqXmm0Reg'

// movq src: 66 REX.W 0F 6E /1.
export function encodeMovqXmm1Reg(mutates code ByteArray, src X64Register)
	code.push(0x66)
	emitRex(code, wide: true, regField: X64Register.rax, rmField: src, force: false)
	code.push(0x0F)
	code.push(0x6E)
	writeModRmReg(code, regBits: 1, rm: src)
end 'encodeMovqXmm1Reg'

// movq dest: 66 REX.W 0F 7E /0.
export function encodeMovqRegXmm0(mutates code ByteArray, dest X64Register)
	code.push(0x66)
	emitRex(code, wide: true, regField: X64Register.rax, rmField: dest, force: false)
	code.push(0x0F)
	code.push(0x7E)
	writeModRmReg(code, regBits: 0, rm: dest)
end 'encodeMovqRegXmm0'

// addsd : F2 0F 58 C1.
export function encodeAddsdXmm0Xmm1(mutates code ByteArray)
	code.push(0xF2)
	code.push(0x0F)
	code.push(0x58)
	code.push(0xC1)
end 'encodeAddsdXmm0Xmm1'

// subsd : F2 0F 5C C1.
export function encodeSubsdXmm0Xmm1(mutates code ByteArray)
	code.push(0xF2)
	code.push(0x0F)
	code.push(0x5C)
	code.push(0xC1)
end 'encodeSubsdXmm0Xmm1'

// mulsd : F2 0F 59 C1.
export function encodeMulsdXmm0Xmm1(mutates code ByteArray)
	code.push(0xF2)
	code.push(0x0F)
	code.push(0x59)
	code.push(0xC1)
end 'encodeMulsdXmm0Xmm1'

// divsd : F2 0F 5E C1.
export function encodeDivsdXmm0Xmm1(mutates code ByteArray)
	code.push(0xF2)
	code.push(0x0F)
	code.push(0x5E)
	code.push(0xC1)
end 'encodeDivsdXmm0Xmm1'

// sqrtsd : F2 0F 51 C0.
export function encodeSqrtsdXmm0Xmm0(mutates code ByteArray)
	code.push(0xF2)
	code.push(0x0F)
	code.push(0x51)
	code.push(0xC0)
end 'encodeSqrtsdXmm0Xmm0'

// ucomisd : 66 0F 2E C1.
export function encodeUcomisdXmm0Xmm1(mutates code ByteArray)
	code.push(0x66)
	code.push(0x0F)
	code.push(0x2E)
	code.push(0xC1)
end 'encodeUcomisdXmm0Xmm1'

// roundsd imm: 66 0F 3A 0B C0.
export function encodeRoundsdXmm0Xmm0Imm8(mutates code ByteArray, imm Imm8)
	code.push(0x66)
	code.push(0x0F)
	code.push(0x3A)
	code.push(0x0B)
	code.push(0xC0)
	writeImm8(code, value: imm)
end 'encodeRoundsdXmm0Xmm0Imm8'

// cvtsi2sd src: F2 REX.W 0F 2A /0.
export function encodeCvtsi2sdXmm0Reg(mutates code ByteArray, src X64Register)
	code.push(0xF2)
	emitRex(code, wide: true, regField: X64Register.rax, rmField: src, force: false)
	code.push(0x0F)
	code.push(0x2A)
	writeModRmReg(code, regBits: 0, rm: src)
end 'encodeCvtsi2sdXmm0Reg'

// cvttsd2si : F2 REX.W 0F 2C C0.
export function encodeCvttsd2siRaxXmm0(mutates code ByteArray)
	code.push(0xF2)
	emitRex(code, wide: true, regField: X64Register.rax, rmField: X64Register.rax, force: false)
	code.push(0x0F)
	code.push(0x2C)
	code.push(0xC0)
end 'encodeCvttsd2siRaxXmm0'

// encodeAddRegImm is the first of AddRegImm8, AddRegImm32 whose immediate holds the value.
export function encodeAddRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'addRegImm8'
		encodeAddRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'addRegImm8' else 'addRegImm32'
		encodeAddRegImm32(code, dest: dest, imm: imm)
	end 'addRegImm32'
end 'encodeAddRegImm'

// encodeAndRegImm is the first of AndRegImm8, AndRegImm32 whose immediate holds the value.
export function encodeAndRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'andRegImm8'
		encodeAndRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'andRegImm8' else 'andRegImm32'
		encodeAndRegImm32(code, dest: dest, imm: imm)
	end 'andRegImm32'
end 'encodeAndRegImm'

// encodeSubRegImm is the first of SubRegImm8, SubRegImm32 whose immediate holds the value.
export function encodeSubRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'subRegImm8'
		encodeSubRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'subRegImm8' else 'subRegImm32'
		encodeSubRegImm32(code, dest: dest, imm: imm)
	end 'subRegImm32'
end 'encodeSubRegImm'

// encodeCmpRegImm is the first of CmpRegImm8, CmpRegImm32 whose immediate holds the value.
export function encodeCmpRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'cmpRegImm8'
		encodeCmpRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'cmpRegImm8' else 'cmpRegImm32'
		encodeCmpRegImm32(code, dest: dest, imm: imm)
	end 'cmpRegImm32'
end 'encodeCmpRegImm'

// encodeMovRegImm is the first of MovRegImm32, MovRegImm32Signed, MovRegImm64 whose immediate holds the value.
export function encodeMovRegImm(mutates code ByteArray, dest X64Register, imm FullRangeInt)
	if imm >= 0 and imm <= imm32UMax 'movRegImm32'
		encodeMovRegImm32(code, dest: dest, imm: imm as Imm32U)
	end 'movRegImm32' else if imm >= imm32Min and imm <= imm32Max 'movRegImm32Signed'
		encodeMovRegImm32Signed(code, dest: dest, imm: imm as Imm32)
	end 'movRegImm32Signed' else 'movRegImm64'
		encodeMovRegImm64(code, dest: dest, imm: imm)
	end 'movRegImm64'
end 'encodeMovRegImm'

// encodeSetccRax is SetccReg, MovzxRegReg8 in a row.
export function encodeSetccRax(mutates code ByteArray, cond X64CondCode)
	encodeSetccReg(code, cond: cond, dest: X64Register.rax)
	encodeMovzxRegReg8(code, dest: X64Register.rax, src: X64Register.rax)
end 'encodeSetccRax'

// X64Form is every instruction form of the table, for the instruction selection to ask about.
export enum X64Form
	movRegReg
	addRegReg
	subRegReg
	andRegReg
	orRegReg
	xorRegReg
	cmpRegReg
	testRegReg
	imulRegReg
	loadRegBaseDisp
	storeBaseDispReg
	leaRegBaseDisp
	movzxRegByteBaseDisp
	storeBaseDispReg8
	movzxRegWordBaseDisp
	loadReg32BaseDisp
	storeBaseDispReg16
	storeBaseDispReg32
	storeBaseDispImm8
	movzxRegReg8
	setccReg
	movRegImm32
	movRegImm32Signed
	movRegImm64
	addRegImm8
	addRegImm32
	andRegImm8
	andRegImm32
	subRegImm8
	subRegImm32
	cmpRegImm8
	cmpRegImm32
	notReg
	negReg
	mulReg
	divReg
	idivReg
	cqo
	shlRegCl
	shrRegCl
	sarRegCl
	sarRegImm8
	pushReg
	popReg
	ret
	ud2
	repMovsb
	repStosq
	repeCmpsb
	leaRegRip
	loadRegRip
	storeRipReg
	callRip
	callReg
	jmpRel32
	callRel32
	jccRel32
	movqXmm0Reg
	movqXmm1Reg
	movqRegXmm0
	addsdXmm0Xmm1
	subsdXmm0Xmm1
	mulsdXmm0Xmm1
	divsdXmm0Xmm1
	sqrtsdXmm0Xmm0
	ucomisdXmm0Xmm1
	roundsdXmm0Xmm0Imm8
	cvtsi2sdXmm0Reg
	cvttsd2siRaxXmm0
end 'X64Form'

export function setsFlags(form X64Form) returns bool
	return match form 'form'
		addRegReg or
		subRegReg or
		andRegReg or
		orRegReg or
		xorRegReg or
		cmpRegReg or
		testRegReg or
		imulRegReg or
		addRegImm8 or
		addRegImm32 or
		andRegImm8 or
		andRegImm32 or
		subRegImm8 or
		subRegImm32 or
		cmpRegImm8 or
		cmpRegImm32 or
		negReg or
		mulReg or
		divReg or
		idivReg or
		shlRegCl or
		shrRegCl or
		sarRegCl or
		sarRegImm8 or
		repeCmpsb or
		ucomisdXmm0Xmm1 gives true
		movRegReg or
		loadRegBaseDisp or
		storeBaseDispReg or
		leaRegBaseDisp or
		movzxRegByteBaseDisp or
		storeBaseDispReg8 or
		movzxRegWordBaseDisp or
		loadReg32BaseDisp or
		storeBaseDispReg16 or
		storeBaseDispReg32 or
		storeBaseDispImm8 or
		movzxRegReg8 or
		setccReg or
		movRegImm32 or
		movRegImm32Signed or
		movRegImm64 or
		notReg or
		cqo or
		pushReg or
		popReg or
		ret or
		ud2 or
		repMovsb or
		repStosq or
		leaRegRip or
		loadRegRip or
		storeRipReg or
		callRip or
		callReg or
		jmpRel32 or
		callRel32 or
		jccRel32 or
		movqXmm0Reg or
		movqXmm1Reg or
		movqRegXmm0 or
		addsdXmm0Xmm1 or
		subsdXmm0Xmm1 or
		mulsdXmm0Xmm1 or
		divsdXmm0Xmm1 or
		sqrtsdXmm0Xmm0 or
		roundsdXmm0Xmm0Imm8 or
		cvtsi2sdXmm0Reg or
		cvttsd2siRaxXmm0 gives false
	end 'form'
end 'setsFlags'

export function readsFlags(form X64Form) returns bool
	return match form 'form'
		setccReg or
		jccRel32 gives true
		movRegReg or
		addRegReg or
		subRegReg or
		andRegReg or
		orRegReg or
		xorRegReg or
		cmpRegReg or
		testRegReg or
		imulRegReg or
		loadRegBaseDisp or
		storeBaseDispReg or
		leaRegBaseDisp or
		movzxRegByteBaseDisp or
		storeBaseDispReg8 or
		movzxRegWordBaseDisp or
		loadReg32BaseDisp or
		storeBaseDispReg16 or
		storeBaseDispReg32 or
		storeBaseDispImm8 or
		movzxRegReg8 or
		movRegImm32 or
		movRegImm32Signed or
		movRegImm64 or
		addRegImm8 or
		addRegImm32 or
		andRegImm8 or
		andRegImm32 or
		subRegImm8 or
		subRegImm32 or
		cmpRegImm8 or
		cmpRegImm32 or
		notReg or
		negReg or
		mulReg or
		divReg or
		idivReg or
		cqo or
		shlRegCl or
		shrRegCl or
		sarRegCl or
		sarRegImm8 or
		pushReg or
		popReg or
		ret or
		ud2 or
		repMovsb or
		repStosq or
		repeCmpsb or
		leaRegRip or
		loadRegRip or
		storeRipReg or
		callRip or
		callReg or
		jmpRel32 or
		callRel32 or
		movqXmm0Reg or
		movqXmm1Reg or
		movqRegXmm0 or
		addsdXmm0Xmm1 or
		subsdXmm0Xmm1 or
		mulsdXmm0Xmm1 or
		divsdXmm0Xmm1 or
		sqrtsdXmm0Xmm0 or
		ucomisdXmm0Xmm1 or
		roundsdXmm0Xmm0Imm8 or
		cvtsi2sdXmm0Reg or
		cvttsd2siRaxXmm0 gives false
	end 'form'
end 'readsFlags'

export function readsMemory(form X64Form) returns bool
	return match form 'form'
		loadRegBaseDisp or
		movzxRegByteBaseDisp or
		movzxRegWordBaseDisp or
		loadReg32BaseDisp or
		popReg or
		ret or
		repMovsb or
		repeCmpsb or
		loadRegRip or
		callRip or
		callReg gives true
		movRegReg or
		addRegReg or
		subRegReg or
		andRegReg or
		orRegReg or
		xorRegReg or
		cmpRegReg or
		testRegReg or
		imulRegReg or
		storeBaseDispReg or
		leaRegBaseDisp or
		storeBaseDispReg8 or
		storeBaseDispReg16 or
		storeBaseDispReg32 or
		storeBaseDispImm8 or
		movzxRegReg8 or
		setccReg or
		movRegImm32 or
		movRegImm32Signed or
		movRegImm64 or
		addRegImm8 or
		addRegImm32 or
		andRegImm8 or
		andRegImm32 or
		subRegImm8 or
		subRegImm32 or
		cmpRegImm8 or
		cmpRegImm32 or
		notReg or
		negReg or
		mulReg or
		divReg or
		idivReg or
		cqo or
		shlRegCl or
		shrRegCl or
		sarRegCl or
		sarRegImm8 or
		pushReg or
		ud2 or
		repStosq or
		leaRegRip or
		storeRipReg or
		jmpRel32 or
		callRel32 or
		jccRel32 or
		movqXmm0Reg or
		movqXmm1Reg or
		movqRegXmm0 or
		addsdXmm0Xmm1 or
		subsdXmm0Xmm1 or
		mulsdXmm0Xmm1 or
		divsdXmm0Xmm1 or
		sqrtsdXmm0Xmm0 or
		ucomisdXmm0Xmm1 or
		roundsdXmm0Xmm0Imm8 or
		cvtsi2sdXmm0Reg or
		cvttsd2siRaxXmm0 gives false
	end 'form'
end 'readsMemory'

export function writesMemory(form X64Form) returns bool
	return match form 'form'
		storeBaseDispReg or
		storeBaseDispReg8 or
		storeBaseDispReg16 or
		storeBaseDispReg32 or
		storeBaseDispImm8 or
		pushReg or
		repMovsb or
		repStosq or
		storeRipReg or
		callRip or
		callReg or
		callRel32 gives true
		movRegReg or
		addRegReg or
		subRegReg or
		andRegReg or
		orRegReg or
		xorRegReg or
		cmpRegReg or
		testRegReg or
		imulRegReg or
		loadRegBaseDisp or
		leaRegBaseDisp or
		movzxRegByteBaseDisp or
		movzxRegWordBaseDisp or
		loadReg32BaseDisp or
		movzxRegReg8 or
		setccReg or
		movRegImm32 or
		movRegImm32Signed or
		movRegImm64 or
		addRegImm8 or
		addRegImm32 or
		andRegImm8 or
		andRegImm32 or
		subRegImm8 or
		subRegImm32 or
		cmpRegImm8 or
		cmpRegImm32 or
		notReg or
		negReg or
		mulReg or
		divReg or
		idivReg or
		cqo or
		shlRegCl or
		shrRegCl or
		sarRegCl or
		sarRegImm8 or
		popReg or
		ret or
		ud2 or
		repeCmpsb or
		leaRegRip or
		loadRegRip or
		jmpRel32 or
		jccRel32 or
		movqXmm0Reg or
		movqXmm1Reg or
		movqRegXmm0 or
		addsdXmm0Xmm1 or
		subsdXmm0Xmm1 or
		mulsdXmm0Xmm1 or
		divsdXmm0Xmm1 or
		sqrtsdXmm0Xmm0 or
		ucomisdXmm0Xmm1 or
		roundsdXmm0Xmm0Imm8 or
		cvtsi2sdXmm0Reg or
		cvttsd2siRaxXmm0 gives false
	end 'form'
end 'writesMemory'
