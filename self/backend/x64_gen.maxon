// encodeAddRegImm is the first of AddRegImm8, AddRegImm32 whose immediate holds the value.
export function encodeAddRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'addRegImm8'
		encodeAddRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'addRegImm8' else 'addRegImm32'
		encodeAddRegImm32(code, dest: dest, imm: imm)
	end 'addRegImm32'
end 'encodeAddRegImm'

// encodeAndRegImm is the first of AndRegImm8, AndRegImm32 whose immediate holds the value.
export function encodeAndRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'andRegImm8'
		encodeAndRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'andRegImm8' else 'andRegImm32'
		encodeAndRegImm32(code, dest: dest, imm: imm)
	end 'andRegImm32'
end 'encodeAndRegImm'

// encodeSubRegImm is the first of SubRegImm8, SubRegImm32 whose immediate holds the value.
export function encodeSubRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'subRegImm8'
		encodeSubRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'subRegImm8' else 'subRegImm32'
		encodeSubRegImm32(code, dest: dest, imm: imm)
	end 'subRegImm32'
end 'encodeSubRegImm'

// encodeCmpRegImm is the first of CmpRegImm8, CmpRegImm32 whose immediate holds the value.
export function encodeCmpRegImm(mutates code ByteArray, dest X64Register, imm Imm32)
	if imm >= imm8Min and imm <= imm8Max 'cmpRegImm8'
		encodeCmpRegImm8(code, dest: dest, imm: imm as Imm8)
	end 'cmpRegImm8' else 'cmpRegImm32'
		encodeCmpRegImm32(code, dest: dest, imm: imm)
	end 'cmpRegImm32'
end 'encodeCmpRegImm'

// encodeMovRegImm is the first of MovRegImm32, MovRegImm32Signed, MovRegImm64 whose immediate holds the value.
export function encodeMovRegImm(mutates code ByteArray, dest X64Register, imm FullRangeInt)
	if imm >= 0 and imm <= imm32UMax 'movRegImm32'
		encodeMovRegImm32(code, dest: dest, imm: imm as Imm32U)
	end 'movRegImm32' else if imm >= imm32Min and imm <= imm32Max 'movRegImm32Signed'
		encodeMovRegImm32Signed(code, dest: dest, imm: imm as Imm32)
	end 'movRegImm32Signed' else 'movRegImm64'
		encodeMovRegImm64(code, dest: dest, imm: imm)
	end 'movRegImm64'
end 'encodeMovRegImm'

// encodeSetccRax is SetccReg, MovzxRegReg8 in a row.
export function encodeSetccRax(mutates code ByteArray, cond MCond)
	encodeSetccReg(code, cond: cond, dest: X64Register.rax)
	encodeMovzxRegReg8(code, dest: X64Register.rax, src: X64Register.rax)
end 'encodeSetccRax'

// X64Form is every instruction form of the table, for the instruction selection to ask about.
export enum X64Form
	movRegReg
	addRegReg
	subRegReg
	andRegReg
	orRegReg
	xorRegReg
	cmpRegReg
	testRegReg
	imulRegReg
	tzcntRegReg
	cmovccRegReg
	loadRegBaseDisp
	storeBaseDispReg
	leaRegBaseDisp
	movzxRegByteBaseDisp
	storeBaseDispReg8
	loadRegBaseIndex8Disp
	storeBaseIndex8DispReg
	leaRegBaseIndex8Disp
	leaRegBaseIndex1Disp
	loadRegBaseIndex1Disp
	storeBaseIndex1DispReg
	movzxRegByteBaseIndex1Disp
	storeBaseIndex1DispReg8
	movzxRegWordBaseDisp
	movReg32Reg
	loadReg32BaseDisp
	storeBaseDispReg16
	storeBaseDispReg32
	storeBaseDispImm8
	storeBaseDispImm32
	movzxRegReg8
	setccReg
	movRegImm32
	movRegImm32Signed
	movRegImm64
	addRegImm8
	addRegImm32
	andRegImm8
	andRegImm32
	subRegImm8
	subRegImm32
	cmpRegImm8
	cmpRegImm32
	orRegImm8
	orRegImm32
	xorRegImm8
	xorRegImm32
	imulRegRegImm8
	imulRegRegImm32
	shlRegImm8
	shrRegImm8
	cmpRegBaseDisp
	xorReg32Reg32
	leave
	notReg
	negReg
	mulReg
	imulReg
	divReg
	idivReg
	cqo
	shlRegCl
	shrRegCl
	sarRegCl
	sarRegImm8
	pushReg
	pushImm32
	popReg
	ret
	ud2
	repMovsb
	repStosq
	repeCmpsb
	leaRegRip
	loadRegRip
	storeRipReg
	callRip
	callReg
	lockXaddBaseDispReg
	xchgBaseDispReg
	lockCmpxchgBaseDispReg
	pause
	loadRegGsBaseDisp
	loadRegFsBaseDisp
	storeGsBaseDispReg
	pushfq
	popfq
	syscall
	jmpRel32
	callRel32
	jccRel32
	movapsRegReg
	xorpsRegReg
	addsdRegReg
	subsdRegReg
	mulsdRegReg
	divsdRegReg
	sqrtsdRegReg
	ucomisdRegReg
	roundsdRegRegImm8
	cvtsi2sdRegReg
	cvttsd2siRegReg
	movqXmmReg
	movqRegXmm
	movsdRegBaseDisp
	movsdBaseDispReg
	movsdRegBaseIndex8Disp
	movsdBaseIndex8DispReg
	movsdRegRip
	movupsRegBaseDisp
	movupsBaseDispReg
	pxorRegReg
	pandRegReg
	porRegReg
	padddRegReg
	pshufbRegReg
	psrlqRegImm8
	psrldqRegImm8
	psllqRegImm8
	pslldqRegImm8
	pinsrqXmmRegImm8
	pextrqRegXmmImm8
	pshufdRegRegImm8
	palignrRegRegImm8
	pblendwRegRegImm8
	aesencRegReg
	aesenclastRegReg
	aesdecRegReg
	aesdeclastRegReg
	aesimcRegReg
	pclmulqdqRegRegImm8
	sha256rnds2RegReg
	sha256msg1RegReg
	sha256msg2RegReg
	cpuid
	int3
	nop1
	nop2
	nop3
	nop4
	nop5
	nop6
	nop7
	nop8
	nop9
end 'X64Form'

// x64FormID is the FormID of a form: x64's forms are the first FormIDs.
export function x64FormID(form X64Form) returns FormID
	return try form.rawValue as FormID otherwise panic("backend: an x64 form past the FormIDs")
end 'x64FormID'

// x64RegisterOf is the general register with a number of the register file.
export function x64RegisterOf(number RegNum) returns X64Register
	return match number 'number'
		0 gives X64Register.rax
		1 gives X64Register.rcx
		2 gives X64Register.rdx
		3 gives X64Register.rbx
		4 gives X64Register.rsp
		5 gives X64Register.rbp
		6 gives X64Register.rsi
		7 gives X64Register.rdi
		8 gives X64Register.r8
		9 gives X64Register.r9
		10 gives X64Register.r10
		11 gives X64Register.r11
		12 gives X64Register.r12
		13 gives X64Register.r13
		14 gives X64Register.r14
		15 gives X64Register.r15
		default panic("backend: a register number that is no general register")
	end 'number'
end 'x64RegisterOf'

// chooseAddRegImm is the first of AddRegImm8, AddRegImm32 whose immediate holds the value.
export function chooseAddRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'addRegImm8'
		return X64Form.addRegImm8
	end 'addRegImm8'
	return X64Form.addRegImm32
end 'chooseAddRegImm'

// chooseAndRegImm is the first of AndRegImm8, AndRegImm32 whose immediate holds the value.
export function chooseAndRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'andRegImm8'
		return X64Form.andRegImm8
	end 'andRegImm8'
	return X64Form.andRegImm32
end 'chooseAndRegImm'

// chooseSubRegImm is the first of SubRegImm8, SubRegImm32 whose immediate holds the value.
export function chooseSubRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'subRegImm8'
		return X64Form.subRegImm8
	end 'subRegImm8'
	return X64Form.subRegImm32
end 'chooseSubRegImm'

// chooseCmpRegImm is the first of CmpRegImm8, CmpRegImm32 whose immediate holds the value.
export function chooseCmpRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'cmpRegImm8'
		return X64Form.cmpRegImm8
	end 'cmpRegImm8'
	return X64Form.cmpRegImm32
end 'chooseCmpRegImm'

// chooseMovRegImm is the first of MovRegImm32, MovRegImm32Signed, MovRegImm64 whose immediate holds the value.
export function chooseMovRegImm(imm FullRangeInt) returns X64Form
	if imm >= 0 and imm <= imm32UMax 'movRegImm32'
		return X64Form.movRegImm32
	end 'movRegImm32'
	if imm >= imm32Min and imm <= imm32Max 'movRegImm32Signed'
		return X64Form.movRegImm32Signed
	end 'movRegImm32Signed'
	return X64Form.movRegImm64
end 'chooseMovRegImm'

// encodeMachineForm encodes a form from the fields of a machine instruction: a defines, a reused register is
// the same as a, and the registers a form does not have are not read.
export function encodeMachineForm(mutates code ByteArray, form FormID, a X64Register, b X64Register, c X64Register, aux Imm32, imm FullRangeInt, cond MCond)
	match form 'form'
		0 then encodeMovRegReg(code, dest: a, src: b)
		1 then encodeAddRegReg(code, dest: a, src: c)
		2 then encodeSubRegReg(code, dest: a, src: c)
		3 then encodeAndRegReg(code, dest: a, src: c)
		4 then encodeOrRegReg(code, dest: a, src: c)
		5 then encodeXorRegReg(code, dest: a, src: c)
		6 then encodeCmpRegReg(code, left: a, right: b)
		7 then encodeTestRegReg(code, left: a, right: b)
		8 then encodeImulRegReg(code, dest: a, src: c)
		9 then encodeTzcntRegReg(code, dest: a, src: b)
		10 then encodeCmovccRegReg(code, cond: cond, dest: a, src: c)
		11 then encodeLoadRegBaseDisp(code, dest: a, base: b, disp: aux)
		12 then encodeStoreBaseDispReg(code, base: a, disp: aux, src: b)
		13 then encodeLeaRegBaseDisp(code, dest: a, base: b, disp: aux)
		14 then encodeMovzxRegByteBaseDisp(code, dest: a, base: b, disp: aux)
		15 then encodeStoreBaseDispReg8(code, base: a, disp: aux, src: b)
		16 then encodeLoadRegBaseIndex8Disp(code, dest: a, base: b, index: c, disp: aux)
		17 then encodeStoreBaseIndex8DispReg(code, base: a, index: b, disp: aux, src: c)
		18 then encodeLeaRegBaseIndex8Disp(code, dest: a, base: b, index: c, disp: aux)
		19 then encodeLeaRegBaseIndex1Disp(code, dest: a, base: b, index: c, disp: aux)
		20 then encodeLoadRegBaseIndex1Disp(code, dest: a, base: b, index: c, disp: aux)
		21 then encodeStoreBaseIndex1DispReg(code, base: a, index: b, disp: aux, src: c)
		22 then encodeMovzxRegByteBaseIndex1Disp(code, dest: a, base: b, index: c, disp: aux)
		23 then encodeStoreBaseIndex1DispReg8(code, base: a, index: b, disp: aux, src: c)
		24 then encodeMovzxRegWordBaseDisp(code, dest: a, base: b, disp: aux)
		25 then encodeMovReg32Reg(code, dest: a, src: b)
		26 then encodeLoadReg32BaseDisp(code, dest: a, base: b, disp: aux)
		27 then encodeStoreBaseDispReg16(code, base: a, disp: aux, src: b)
		28 then encodeStoreBaseDispReg32(code, base: a, disp: aux, src: b)
		29 then encodeStoreBaseDispImm8(code, base: a, disp: aux, imm: try imm as Imm8 otherwise panic("backend: the immediate of StoreBaseDispImm8 does not fit it"))
		30 then encodeStoreBaseDispImm32(code, base: a, disp: aux, imm: try imm as Imm32 otherwise panic("backend: the immediate of StoreBaseDispImm32 does not fit it"))
		31 then encodeMovzxRegReg8(code, dest: a, src: b)
		32 then encodeSetccReg(code, cond: cond, dest: a)
		33 then encodeMovRegImm32(code, dest: a, imm: try imm as Imm32U otherwise panic("backend: the immediate of MovRegImm32 does not fit it"))
		34 then encodeMovRegImm32Signed(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of MovRegImm32Signed does not fit it"))
		35 then encodeMovRegImm64(code, dest: a, imm: imm)
		36 then encodeAddRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of AddRegImm8 does not fit it"))
		37 then encodeAddRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of AddRegImm32 does not fit it"))
		38 then encodeAndRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of AndRegImm8 does not fit it"))
		39 then encodeAndRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of AndRegImm32 does not fit it"))
		40 then encodeSubRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of SubRegImm8 does not fit it"))
		41 then encodeSubRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of SubRegImm32 does not fit it"))
		42 then encodeCmpRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of CmpRegImm8 does not fit it"))
		43 then encodeCmpRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of CmpRegImm32 does not fit it"))
		44 then encodeOrRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of OrRegImm8 does not fit it"))
		45 then encodeOrRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of OrRegImm32 does not fit it"))
		46 then encodeXorRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of XorRegImm8 does not fit it"))
		47 then encodeXorRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of XorRegImm32 does not fit it"))
		48 then encodeImulRegRegImm8(code, dest: a, src: b, imm: try imm as Imm8 otherwise panic("backend: the immediate of ImulRegRegImm8 does not fit it"))
		49 then encodeImulRegRegImm32(code, dest: a, src: b, imm: try imm as Imm32 otherwise panic("backend: the immediate of ImulRegRegImm32 does not fit it"))
		50 then encodeShlRegImm8(code, reg: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of ShlRegImm8 does not fit it"))
		51 then encodeShrRegImm8(code, reg: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of ShrRegImm8 does not fit it"))
		52 then encodeCmpRegBaseDisp(code, left: a, base: b, disp: aux)
		53 then encodeXorReg32Reg32(code, dest: a, src: c)
		54 then encodeLeave(code)
		55 then encodeNotReg(code, reg: a)
		56 then encodeNegReg(code, reg: a)
		57 then encodeMulReg(code, reg: a)
		58 then encodeImulReg(code, reg: a)
		59 then encodeDivReg(code, reg: a)
		60 then encodeIdivReg(code, reg: a)
		61 then encodeCqo(code)
		62 then encodeShlRegCl(code, reg: a)
		63 then encodeShrRegCl(code, reg: a)
		64 then encodeSarRegCl(code, reg: a)
		65 then encodeSarRegImm8(code, reg: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of SarRegImm8 does not fit it"))
		66 then encodePushReg(code, reg: a)
		67 then encodePushImm32(code, imm: try imm as Imm32 otherwise panic("backend: the immediate of PushImm32 does not fit it"))
		68 then encodePopReg(code, reg: a)
		69 then encodeRet(code)
		70 then encodeUd2(code)
		71 then encodeRepMovsb(code)
		72 then encodeRepStosq(code)
		73 then encodeRepeCmpsb(code)
		74 then encodeLeaRegRip(code, dest: a, disp: 0)
		75 then encodeLoadRegRip(code, dest: a, disp: 0)
		76 then encodeStoreRipReg(code, disp: 0, src: a)
		77 then encodeCallRip(code, disp: 0)
		78 then encodeCallReg(code, reg: a)
		79 then encodeLockXaddBaseDispReg(code, base: c, disp: aux, src: a)
		80 then encodeXchgBaseDispReg(code, base: c, disp: aux, src: a)
		81 then encodeLockCmpxchgBaseDispReg(code, base: a, disp: aux, src: b)
		82 then encodePause(code)
		83 then encodeLoadRegGsBaseDisp(code, dest: a, base: b, disp: aux)
		84 then encodeLoadRegFsBaseDisp(code, dest: a, base: b, disp: aux)
		85 then encodeStoreGsBaseDispReg(code, base: a, disp: aux, src: b)
		86 then encodePushfq(code)
		87 then encodePopfq(code)
		88 then encodeSyscall(code)
		89 then encodeJmpRel32(code, rel: 0)
		90 then encodeCallRel32(code, rel: 0)
		91 then encodeJccRel32(code, cond: cond, rel: 0)
		92 then encodeMovapsRegReg(code, dest: a, src: b)
		93 then encodeXorpsRegReg(code, dest: a, src: c)
		94 then encodeAddsdRegReg(code, dest: a, src: c)
		95 then encodeSubsdRegReg(code, dest: a, src: c)
		96 then encodeMulsdRegReg(code, dest: a, src: c)
		97 then encodeDivsdRegReg(code, dest: a, src: c)
		98 then encodeSqrtsdRegReg(code, dest: a, src: b)
		99 then encodeUcomisdRegReg(code, left: a, right: b)
		100 then encodeRoundsdRegRegImm8(code, dest: a, src: b, imm: try imm as Imm8 otherwise panic("backend: the immediate of RoundsdRegRegImm8 does not fit it"))
		101 then encodeCvtsi2sdRegReg(code, dest: a, src: b)
		102 then encodeCvttsd2siRegReg(code, dest: a, src: b)
		103 then encodeMovqXmmReg(code, dest: a, src: b)
		104 then encodeMovqRegXmm(code, dest: a, src: b)
		105 then encodeMovsdRegBaseDisp(code, dest: a, base: b, disp: aux)
		106 then encodeMovsdBaseDispReg(code, base: a, disp: aux, src: b)
		107 then encodeMovsdRegBaseIndex8Disp(code, dest: a, base: b, index: c, disp: aux)
		108 then encodeMovsdBaseIndex8DispReg(code, base: a, index: b, disp: aux, src: c)
		109 then encodeMovsdRegRip(code, dest: a, disp: 0)
		110 then encodeMovupsRegBaseDisp(code, dest: a, base: b, disp: aux)
		111 then encodeMovupsBaseDispReg(code, base: a, disp: aux, src: b)
		112 then encodePxorRegReg(code, dest: a, src: c)
		113 then encodePandRegReg(code, dest: a, src: c)
		114 then encodePorRegReg(code, dest: a, src: c)
		115 then encodePadddRegReg(code, dest: a, src: c)
		116 then encodePshufbRegReg(code, dest: a, src: c)
		117 then encodePsrlqRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of PsrlqRegImm8 does not fit it"))
		118 then encodePsrldqRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of PsrldqRegImm8 does not fit it"))
		119 then encodePsllqRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of PsllqRegImm8 does not fit it"))
		120 then encodePslldqRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of PslldqRegImm8 does not fit it"))
		121 then encodePinsrqXmmRegImm8(code, dest: a, src: c, imm: try imm as Imm8 otherwise panic("backend: the immediate of PinsrqXmmRegImm8 does not fit it"))
		122 then encodePextrqRegXmmImm8(code, dest: a, src: b, imm: try imm as Imm8 otherwise panic("backend: the immediate of PextrqRegXmmImm8 does not fit it"))
		123 then encodePshufdRegRegImm8(code, dest: a, src: b, imm: try imm as Imm8 otherwise panic("backend: the immediate of PshufdRegRegImm8 does not fit it"))
		124 then encodePalignrRegRegImm8(code, dest: a, src: c, imm: try imm as Imm8 otherwise panic("backend: the immediate of PalignrRegRegImm8 does not fit it"))
		125 then encodePblendwRegRegImm8(code, dest: a, src: c, imm: try imm as Imm8 otherwise panic("backend: the immediate of PblendwRegRegImm8 does not fit it"))
		126 then encodeAesencRegReg(code, dest: a, src: c)
		127 then encodeAesenclastRegReg(code, dest: a, src: c)
		128 then encodeAesdecRegReg(code, dest: a, src: c)
		129 then encodeAesdeclastRegReg(code, dest: a, src: c)
		130 then encodeAesimcRegReg(code, dest: a, src: b)
		131 then encodePclmulqdqRegRegImm8(code, dest: a, src: c, imm: try imm as Imm8 otherwise panic("backend: the immediate of PclmulqdqRegRegImm8 does not fit it"))
		132 then encodeSha256rnds2RegReg(code, dest: a, src: c)
		133 then encodeSha256msg1RegReg(code, dest: a, src: c)
		134 then encodeSha256msg2RegReg(code, dest: a, src: c)
		135 then encodeCpuid(code)
		136 then encodeInt3(code)
		137 then encodeNop1(code)
		138 then encodeNop2(code)
		139 then encodeNop3(code)
		140 then encodeNop4(code)
		141 then encodeNop5(code)
		142 then encodeNop6(code)
		143 then encodeNop7(code)
		144 then encodeNop8(code)
		145 then encodeNop9(code)
		default then panic("backend: a machine instruction of a form of no x64 form")
	end 'form'
end 'encodeMachineForm'
