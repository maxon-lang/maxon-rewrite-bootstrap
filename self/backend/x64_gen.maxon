export function encodeMovsdRegBaseIndex8Disp(mutates code ByteArray, dest X64Register, base X64Register, index X64Register, disp Imm32)
	code.push(0xF2)
	emitRex(code, wide: false, regField: dest, indexField: index, rmField: base, force: false)
	code.push(0x0F)
	code.push(0x10)
	writeMemIndex(code, regBits: regLow3(dest), base: base, index: index, scaleBits: 3, disp: disp)
end 'encodeMovsdRegBaseIndex8Disp'

