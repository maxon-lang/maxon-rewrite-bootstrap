		cvtsi2sdXmm0Reg or
		cvttsd2siRaxXmm0 gives 0x0
		repMovsb or
		repeCmpsb gives 0xC2
		repStosq gives 0x82
	end 'form'
end 'clobbers'

// chooseAddRegImm is the first of AddRegImm8, AddRegImm32 whose immediate holds the value.
export function chooseAddRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'addRegImm8'
		return X64Form.addRegImm8
	end 'addRegImm8'
	return X64Form.addRegImm32
end 'chooseAddRegImm'

// chooseAndRegImm is the first of AndRegImm8, AndRegImm32 whose immediate holds the value.
export function chooseAndRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'andRegImm8'
		return X64Form.andRegImm8
	end 'andRegImm8'
	return X64Form.andRegImm32
end 'chooseAndRegImm'

// chooseSubRegImm is the first of SubRegImm8, SubRegImm32 whose immediate holds the value.
export function chooseSubRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'subRegImm8'
		return X64Form.subRegImm8
	end 'subRegImm8'
	return X64Form.subRegImm32
end 'chooseSubRegImm'

// chooseCmpRegImm is the first of CmpRegImm8, CmpRegImm32 whose immediate holds the value.
export function chooseCmpRegImm(imm Imm32) returns X64Form
	if imm >= imm8Min and imm <= imm8Max 'cmpRegImm8'
		return X64Form.cmpRegImm8
	end 'cmpRegImm8'
	return X64Form.cmpRegImm32
end 'chooseCmpRegImm'

// chooseMovRegImm is the first of MovRegImm32, MovRegImm32Signed, MovRegImm64 whose immediate holds the value.
export function chooseMovRegImm(imm FullRangeInt) returns X64Form
	if imm >= 0 and imm <= imm32UMax 'movRegImm32'
		return X64Form.movRegImm32
	end 'movRegImm32'
	if imm >= imm32Min and imm <= imm32Max 'movRegImm32Signed'
		return X64Form.movRegImm32Signed
	end 'movRegImm32Signed'
	return X64Form.movRegImm64
end 'chooseMovRegImm'

// encodeMachineForm encodes a form from the fields of a machine instruction: a defines, a reused register is
// the same as a, and the registers a form does not have are not read.
export function encodeMachineForm(mutates code ByteArray, form X64Form, a X64Register, b X64Register, c X64Register, aux Imm32, imm FullRangeInt, cond X64CondCode)
	match form 'form'
		movRegReg then encodeMovRegReg(code, dest: a, src: b)
		addRegReg then encodeAddRegReg(code, dest: a, src: c)
		subRegReg then encodeSubRegReg(code, dest: a, src: c)
		andRegReg then encodeAndRegReg(code, dest: a, src: c)
		orRegReg then encodeOrRegReg(code, dest: a, src: c)
		xorRegReg then encodeXorRegReg(code, dest: a, src: c)
		cmpRegReg then encodeCmpRegReg(code, left: a, right: b)
		testRegReg then encodeTestRegReg(code, left: a, right: b)
		imulRegReg then encodeImulRegReg(code, dest: a, src: c)
		loadRegBaseDisp then encodeLoadRegBaseDisp(code, dest: a, base: b, disp: aux)
		storeBaseDispReg then encodeStoreBaseDispReg(code, base: a, disp: aux, src: b)
		leaRegBaseDisp then encodeLeaRegBaseDisp(code, dest: a, base: b, disp: aux)
		movzxRegByteBaseDisp then encodeMovzxRegByteBaseDisp(code, dest: a, base: b, disp: aux)
		storeBaseDispReg8 then encodeStoreBaseDispReg8(code, base: a, disp: aux, src: b)
		loadRegBaseIndex8Disp then encodeLoadRegBaseIndex8Disp(code, dest: a, base: b, index: c, disp: aux)
		storeBaseIndex8DispReg then encodeStoreBaseIndex8DispReg(code, base: a, index: b, disp: aux, src: c)
		leaRegBaseIndex8Disp then encodeLeaRegBaseIndex8Disp(code, dest: a, base: b, index: c, disp: aux)
		loadRegBaseIndex1Disp then encodeLoadRegBaseIndex1Disp(code, dest: a, base: b, index: c, disp: aux)
		storeBaseIndex1DispReg then encodeStoreBaseIndex1DispReg(code, base: a, index: b, disp: aux, src: c)
		movzxRegByteBaseIndex1Disp then encodeMovzxRegByteBaseIndex1Disp(code, dest: a, base: b, index: c, disp: aux)
		storeBaseIndex1DispReg8 then encodeStoreBaseIndex1DispReg8(code, base: a, index: b, disp: aux, src: c)
		movzxRegWordBaseDisp then encodeMovzxRegWordBaseDisp(code, dest: a, base: b, disp: aux)
		loadReg32BaseDisp then encodeLoadReg32BaseDisp(code, dest: a, base: b, disp: aux)
		storeBaseDispReg16 then encodeStoreBaseDispReg16(code, base: a, disp: aux, src: b)
		storeBaseDispReg32 then encodeStoreBaseDispReg32(code, base: a, disp: aux, src: b)
		storeBaseDispImm8 then encodeStoreBaseDispImm8(code, base: a, disp: aux, imm: try imm as Imm8 otherwise panic("backend: the immediate of StoreBaseDispImm8 does not fit it"))
		storeBaseDispImm32 then encodeStoreBaseDispImm32(code, base: a, disp: aux, imm: try imm as Imm32 otherwise panic("backend: the immediate of StoreBaseDispImm32 does not fit it"))
		movzxRegReg8 then encodeMovzxRegReg8(code, dest: a, src: b)
		setccReg then encodeSetccReg(code, cond: cond, dest: a)
		movRegImm32 then encodeMovRegImm32(code, dest: a, imm: try imm as Imm32U otherwise panic("backend: the immediate of MovRegImm32 does not fit it"))
		movRegImm32Signed then encodeMovRegImm32Signed(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of MovRegImm32Signed does not fit it"))
		movRegImm64 then encodeMovRegImm64(code, dest: a, imm: imm)
		addRegImm8 then encodeAddRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of AddRegImm8 does not fit it"))
		addRegImm32 then encodeAddRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of AddRegImm32 does not fit it"))
		andRegImm8 then encodeAndRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of AndRegImm8 does not fit it"))
		andRegImm32 then encodeAndRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of AndRegImm32 does not fit it"))
		subRegImm8 then encodeSubRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of SubRegImm8 does not fit it"))
		subRegImm32 then encodeSubRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of SubRegImm32 does not fit it"))
		cmpRegImm8 then encodeCmpRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of CmpRegImm8 does not fit it"))
		cmpRegImm32 then encodeCmpRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of CmpRegImm32 does not fit it"))
		orRegImm8 then encodeOrRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of OrRegImm8 does not fit it"))
		orRegImm32 then encodeOrRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of OrRegImm32 does not fit it"))
		xorRegImm8 then encodeXorRegImm8(code, dest: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of XorRegImm8 does not fit it"))
		xorRegImm32 then encodeXorRegImm32(code, dest: a, imm: try imm as Imm32 otherwise panic("backend: the immediate of XorRegImm32 does not fit it"))
		imulRegRegImm8 then encodeImulRegRegImm8(code, dest: a, src: b, imm: try imm as Imm8 otherwise panic("backend: the immediate of ImulRegRegImm8 does not fit it"))
		imulRegRegImm32 then encodeImulRegRegImm32(code, dest: a, src: b, imm: try imm as Imm32 otherwise panic("backend: the immediate of ImulRegRegImm32 does not fit it"))
		shlRegImm8 then encodeShlRegImm8(code, reg: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of ShlRegImm8 does not fit it"))
		shrRegImm8 then encodeShrRegImm8(code, reg: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of ShrRegImm8 does not fit it"))
		cmpRegBaseDisp then encodeCmpRegBaseDisp(code, left: a, base: b, disp: aux)
		xorReg32Reg32 then encodeXorReg32Reg32(code, dest: a, src: c)
		leave then encodeLeave(code)
		notReg then encodeNotReg(code, reg: a)
		negReg then encodeNegReg(code, reg: a)
		mulReg then encodeMulReg(code, reg: a)
		divReg then encodeDivReg(code, reg: a)
		idivReg then encodeIdivReg(code, reg: a)
		cqo then encodeCqo(code)
		shlRegCl then encodeShlRegCl(code, reg: a)
		shrRegCl then encodeShrRegCl(code, reg: a)
		sarRegCl then encodeSarRegCl(code, reg: a)
		sarRegImm8 then encodeSarRegImm8(code, reg: a, imm: try imm as Imm8 otherwise panic("backend: the immediate of SarRegImm8 does not fit it"))
		pushReg then encodePushReg(code, reg: a)
		pushImm32 then encodePushImm32(code, imm: try imm as Imm32 otherwise panic("backend: the immediate of PushImm32 does not fit it"))
		popReg then encodePopReg(code, reg: a)
		ret then encodeRet(code)
		ud2 then encodeUd2(code)
		repMovsb then encodeRepMovsb(code)
		repStosq then encodeRepStosq(code)
		repeCmpsb then encodeRepeCmpsb(code)
		leaRegRip then encodeLeaRegRip(code, dest: a, disp: 0)
		loadRegRip then encodeLoadRegRip(code, dest: a, disp: 0)
		storeRipReg then encodeStoreRipReg(code, disp: 0, src: a)
		callRip then encodeCallRip(code, disp: 0)
		callReg then encodeCallReg(code, reg: a)
		lockXaddBaseDispReg then encodeLockXaddBaseDispReg(code, base: c, disp: aux, src: a)
		xchgBaseDispReg then encodeXchgBaseDispReg(code, base: c, disp: aux, src: a)
		lockCmpxchgBaseDispReg then encodeLockCmpxchgBaseDispReg(code, base: a, disp: aux, src: b)
		pause then encodePause(code)
		loadRegGsBaseDisp then encodeLoadRegGsBaseDisp(code, dest: a, base: b, disp: aux)
		jmpRel32 then encodeJmpRel32(code, rel: 0)
		callRel32 then encodeCallRel32(code, rel: 0)
		jccRel32 then encodeJccRel32(code, cond: cond, rel: 0)
		movqXmm0Reg then encodeMovqXmm0Reg(code, src: a)
		movqXmm1Reg then encodeMovqXmm1Reg(code, src: a)
		movqRegXmm0 then encodeMovqRegXmm0(code, dest: a)
		addsdXmm0Xmm1 then encodeAddsdXmm0Xmm1(code)
		subsdXmm0Xmm1 then encodeSubsdXmm0Xmm1(code)
		mulsdXmm0Xmm1 then encodeMulsdXmm0Xmm1(code)
		divsdXmm0Xmm1 then encodeDivsdXmm0Xmm1(code)
		sqrtsdXmm0Xmm0 then encodeSqrtsdXmm0Xmm0(code)
		ucomisdXmm0Xmm1 then encodeUcomisdXmm0Xmm1(code)
		roundsdXmm0Xmm0Imm8 then encodeRoundsdXmm0Xmm0Imm8(code, imm: try imm as Imm8 otherwise panic("backend: the immediate of RoundsdXmm0Xmm0Imm8 does not fit it"))
		cvtsi2sdXmm0Reg then encodeCvtsi2sdXmm0Reg(code, src: a)
		cvttsd2siRaxXmm0 then encodeCvttsd2siRaxXmm0(code)
	end 'form'
end 'encodeMachineForm'
