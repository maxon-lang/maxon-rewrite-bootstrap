		loadRegBaseIndex8Disp or
		storeBaseIndex8DispReg or
		leaRegBaseIndex8Disp or
		loadRegBaseIndex1Disp or
		storeBaseIndex1DispReg or
		movzxRegByteBaseIndex1Disp or
		storeBaseIndex1DispReg8 or
		movzxRegWordBaseDisp or
		loadReg32BaseDisp or
		storeBaseDispReg16 or
		storeBaseDispReg32 or
		storeBaseDispImm8 or
		storeBaseDispImm32 or
		movzxRegReg8 or
		setccReg or
		movRegImm32 or
		movRegImm32Signed or
		movRegImm64 or
		addRegImm8 or
		addRegImm32 or
		andRegImm8 or
		andRegImm32 or
		subRegImm8 or
		subRegImm32 or
		cmpRegImm8 or
		cmpRegImm32 or
		orRegImm8 or
		orRegImm32 or
		xorRegImm8 or
		xorRegImm32 or
		imulRegRegImm8 or
		imulRegRegImm32 or
		shlRegImm8 or
		shrRegImm8 or
		cmpRegBaseDisp or
		xorReg32Reg32 or
		leave or
		notReg or
		negReg or
		shlRegCl or
		shrRegCl or
		sarRegCl or
		sarRegImm8 or
		pushReg or
		pushImm32 or
		popReg or
		ret or
		ud2 or
		repMovsb or
		repStosq or
		repeCmpsb or
		leaRegRip or
		loadRegRip or
		storeRipReg or
		callRip or
		callReg or
		lockXaddBaseDispReg or
		xchgBaseDispReg or
		pause or
		loadRegGsBaseDisp or
		jmpRel32 or
		callRel32 or
		jccRel32 or
		movqRegXmm0 or
		ucomisdXmm0Xmm1 gives 0x0
		mulReg or
		divReg or
		idivReg gives 0x5
		cqo gives 0x4
		lockCmpxchgBaseDispReg or
		cvttsd2siRaxXmm0 gives 0x1
		movqXmm0Reg or
		addsdXmm0Xmm1 or
		subsdXmm0Xmm1 or
		mulsdXmm0Xmm1 or
		divsdXmm0Xmm1 or
		sqrtsdXmm0Xmm0 or
		roundsdXmm0Xmm0Imm8 or
		cvtsi2sdXmm0Reg gives 0x10000
		movqXmm1Reg gives 0x20000
	end 'form'
end 'fixedDefs'

// clobbers is the registers a form leaves holding nothing, besides a call's.
export function clobbers(form X64Form) returns RegMask
	return match form 'form'
		movRegReg or
