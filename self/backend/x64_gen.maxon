	emitRex(code, wide: false, regField: src, indexField: index, rmField: base, force: false)
	code.push(0x0F)
	code.push(0x11)
	writeMemIndex(code, regBits: regLow3(src), base: base, index: index, scaleBits: 3, disp: disp)
end 'encodeMovsdBaseIndex8DispReg'

