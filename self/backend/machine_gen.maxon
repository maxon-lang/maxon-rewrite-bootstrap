// MCond is a condition that a machine instruction tests: what the flags a comparison set say, which each instruction
// set encodes its own way.
export enum MCond
	overflow
	noOverflow
	below
	aboveEqual
	equal
	notEqual
	belowEqual
	above
	sign
	noSign
	parity
	noParity
	less
	greaterEqual
	lessEqual
	greater
end 'MCond'

// formCount is one past the last FormID of the forms of every instruction set.
export let formCount = 394

// formTableZero is the byte of the digit 0, which a form table's digits count from.
let formTableZero = 48

// formDigit is the digit a form table holds for a form: one digit per FormID, so that what the allocator or an
// encoder asks of a form for every instruction is one read of data rather than a match over every form.
function formDigit(table String, form FormID) returns Count
