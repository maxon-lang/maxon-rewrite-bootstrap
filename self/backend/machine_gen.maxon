// fixedUses is the registers a form reads that no operand names.
export function fixedUses(form FormID) returns RegMask
	return match formDigit("", form: form) 'mask'
		0 gives 0x0
		1 gives 0x1
		2 gives 0x5
		3 gives 0x2
		4 gives 0xC2
		5 gives 0x83
		default panic("backend: a form table of fixedUses holds no mask")
	end 'mask'
