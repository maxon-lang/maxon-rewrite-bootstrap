end 'formDigit'

// machineOperandCount is how many register operands a machine instruction of a form has.
export function machineOperandCount(form FormID) returns Count
	return formDigit("", form: form)
end 'machineOperandCount'

// definesOperand is whether operand a of a form is a definition, and the others uses.
export function definesOperand(form FormID) returns bool
	return formDigit("", form: form) == 1
end 'definesOperand'

