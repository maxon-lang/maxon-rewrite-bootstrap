// The entry stub's code for green threads on arm64, as green.maxon is x64's: the switch from one stack to another, the
// start of a stack that has not run, the code a green thread that the monitor stops is made to resume in, which keeps
// every register, and the handler of the preemption signal. Each is a section of its own, so an executable has it only
// when the runtime's code that names it is linked.
//
// A switch record holds the registers the internal convention keeps, x19 to x28 and d8 to d15, and the frame pointer, in
// the slots of x64's record (switchRbxOffset on): x19, which a stack that has not run starts with the word to pass in,
// in rbx's; x29 in rbp's; x20, the code it calls, in r12's; x21 to x23 in r13's to r15's; and x24 to x28 and the d
// registers from switchXmmOffset. A switch pushes its return address on the stack it leaves, as x64's call does, so a
// stack that has not run, whose top word the runtime made rt.greenStart's address, returns there.

// arm64SwitchGeneralCount is how many general registers a switch record holds: the ten the internal convention keeps and
// the frame pointer.
let arm64SwitchGeneralCount = 11

// arm64SwitchGeneralRegister is the general register a switch record holds in slot.
function arm64SwitchGeneralRegister(slot Count) returns Arm64Register
	if slot == 0 'x19'
		return Arm64Register.x19
	end 'x19'
	if slot == 1 'x29'
		return arm64FramePointer
	end 'x29'
	if slot == 2 'x20'
		return Arm64Register.x20
	end 'x20'
	if slot < arm64SwitchGeneralCount 'rest'
		return arm64RegisterOf((slot + 18) as RegNum)
	end 'rest'
	panic("backend: a switch record has no slot {slot} for an arm64 general register")
end 'arm64SwitchGeneralRegister'

// arm64SwitchFirstExtra is the first slot of the general registers kept from switchXmmOffset, after the six of x64's.
let arm64SwitchFirstExtra = 6

// arm64SwitchGeneralDisp is where a switch record holds the general register of a slot.
function arm64SwitchGeneralDisp(slot Count) returns FullRangeInt
	if slot < arm64SwitchFirstExtra 'x64Slots'
		return arm64Disp(switchRbxOffset + slot * wordBytes)
	end 'x64Slots'
	return arm64Disp(try switchXmmOffset + (slot - arm64SwitchFirstExtra) * wordBytes otherwise panic("backend: a switch record past memory"))
end 'arm64SwitchGeneralDisp'

// arm64SwitchVectorDisp is where a switch record holds the nth d register the internal convention keeps, after the
// general registers past x64's six.
function arm64SwitchVectorDisp(nth Count) returns FullRangeInt
	return arm64Disp(try switchXmmOffset + (arm64SwitchGeneralCount - arm64SwitchFirstExtra + nth) * wordBytes otherwise panic("backend: a switch record past memory"))
end 'arm64SwitchVectorDisp'

// requireArm64SwitchLayout holds the record to the convention: its general slots are the general registers the internal
// convention keeps and the frame pointer, its d slots as many as the d registers it keeps, and all of them in the record.
function requireArm64SwitchLayout()
	let kept = arm64InternalCalleeSaved()
	var gprs = 0 as Count
	var vectors = 0 as Count
	for r in 0 upto arm64RegisterFileSize 'registers'
		if maskHas(kept, number: regNumOfCount(r)) 'kept'
			if r < arm64FirstVector 'general'
				gprs = nextCount(gprs)
			end 'general' else 'vector'
				vectors = nextCount(vectors)
			end 'vector'
		end 'kept'
	end 'registers'
	if nextCount(gprs) != arm64SwitchGeneralCount 'counts'
		panic("backend: the arm64 switch record does not hold the general registers the internal convention keeps")
	end 'counts'
	for slot in 0 upto arm64SwitchGeneralCount 'slots'
		let r = arm64SwitchGeneralRegister(slot)
		if r != arm64FramePointer and not maskHas(kept, number: arm64RegNumOf(r)) 'unkept'
			panic("backend: the arm64 switch record holds a register the internal convention does not keep")
		end 'unkept'
	end 'slots'
	if arm64SwitchVectorDisp(vectors) > arm64Disp(switchBytes) 'room'
		panic("backend: the arm64 switch record is past the room of a switch record")
	end 'room'
end 'requireArm64SwitchLayout'

// The scratch registers of the switch, which the internal convention lets a call change: the record it leaves and the
// one it goes to, apart from its argument.
let arm64SwitchFrom = Arm64Register.x9

let arm64SwitchTo = Arm64Register.x10

let arm64SwitchSp = Arm64Register.x11

// emitArm64GreenRoutines writes the stub's code of green threads.
function emitArm64GreenRoutines(mutates u CodeUnit, system ast.TargetSystem)
	emitArm64StackSwitch(u)
	emitArm64GreenStart(u)
	emitArm64AsyncPreempt(u, system: system)
	emitArm64StackWipe(u)
end 'emitArm64GreenRoutines'

// The registers of rt.stackWipe, which the internal convention lets a call change: the lowest address it zeroes, the one
// it zeroes next, and 8, its step.
let arm64WipeLow = Arm64Register.x9

let arm64WipeCursor = Arm64Register.x10

let arm64WipeStep = Arm64Register.x11

// emitArm64StackWipe writes rt.stackWipe: given a count of bytes and a floor, it zeroes the vector registers the internal
// convention lets a call change, then the words below the stack pointer from the top down to the higher of the floor and
// the stack pointer less the bytes. It takes no stack of its own, so what it zeroes is all below its caller's.
function emitArm64StackWipe(mutates u CodeUnit)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtStackWipe))
	let changed = arm64InternalCallerSaved()
	for r in arm64FirstVector upto arm64RegisterFileSize 'vectors'
		if maskHas(changed, number: regNumOfCount(r)) 'changed'
			let v = arm64RegisterOf((r - arm64FirstVector) as RegNum)
			encodeArm64EorVec16(u.asm.code, dest: v, left: v, right: v)
		end 'changed'
	end 'vectors'
	let floorReady = u.asm.newLabel()
	let loop = u.asm.newLabel()
	let done = u.asm.newLabel()
	u.asm.arm64Mov(arm64WipeCursor, src: Arm64Register.sp)
	u.asm.arm64Sub(arm64WipeLow, left: arm64WipeCursor, right: arm64ArgWord())
	u.asm.arm64Cmp(arm64WipeLow, right: arm64InternalArg(1))
	u.asm.arm64BranchIf(MCond.aboveEqual, label: floorReady)
	u.asm.arm64Mov(arm64WipeLow, src: arm64InternalArg(1))
	u.asm.bind(floorReady)
	u.asm.arm64MovImm(arm64WipeStep, value: wordBytes as FullRangeInt)
	u.asm.bind(loop)
	u.asm.arm64Cmp(arm64WipeCursor, right: arm64WipeLow)
	u.asm.arm64BranchIf(MCond.belowEqual, label: done)
	u.asm.arm64Sub(arm64WipeCursor, left: arm64WipeCursor, right: arm64WipeStep)
	u.asm.arm64Store(arm64WipeCursor, disp: 0, src: arm64ZeroRegister)
	u.asm.arm64Jump(loop)
	u.asm.bind(done)
	u.asm.arm64Ret()
	u.setSectionStack(0)
end 'emitArm64StackWipe'

// emitArm64StackSwitch writes rt.stackSwitch: given the address of a pair of switch records, it pushes its return address
// on the running stack, saves the registers of the running stack into the first record, goes on the stack of the second
// with its registers, pops the return address there and returns to it, with the first record.
function emitArm64StackSwitch(mutates u CodeUnit)
	requireArm64SwitchLayout()
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtStackSwitch))
	u.asm.arm64Load(arm64SwitchFrom, base: arm64ArgWord(), disp: 0)
	u.asm.arm64Load(arm64SwitchTo, base: arm64ArgWord(), disp: wordBytes)
	u.asm.arm64Push(arm64LinkRegister, second: arm64ZeroRegister)
	for slot in 0 upto arm64SwitchGeneralCount 'saveGprs'
		u.asm.arm64Store(arm64SwitchFrom, disp: arm64SwitchGeneralDisp(slot), src: arm64SwitchGeneralRegister(slot))
	end 'saveGprs'
	emitArm64SwitchVectors(u, record: arm64SwitchFrom, saves: true)
	u.asm.arm64Mov(arm64SwitchSp, src: Arm64Register.sp)
	u.asm.arm64Store(arm64SwitchFrom, disp: arm64Disp(switchSpOffset), src: arm64SwitchSp)
	u.asm.arm64Load(arm64SwitchSp, base: arm64SwitchTo, disp: arm64Disp(switchSpOffset))
	u.asm.arm64Mov(Arm64Register.sp, src: arm64SwitchSp)
	emitArm64SwitchVectors(u, record: arm64SwitchTo, saves: false)
	for slot in 0 upto arm64SwitchGeneralCount 'loadGprs'
		u.asm.arm64Load(arm64SwitchGeneralRegister(slot), base: arm64SwitchTo, disp: arm64SwitchGeneralDisp(slot))
	end 'loadGprs'
	u.asm.arm64Pop(arm64LinkRegister, second: arm64ZeroRegister)
	u.asm.arm64Mov(arm64ResultWord(), src: arm64SwitchFrom)
	u.asm.arm64Ret()
end 'emitArm64StackSwitch'

// emitArm64SwitchVectors saves the d registers the internal convention keeps into a switch record, or loads them.
function emitArm64SwitchVectors(mutates u CodeUnit, record Arm64Register, saves bool)
	let kept = arm64InternalCalleeSaved()
	var nth = 0 as Count
	for r in arm64FirstVector upto arm64RegisterFileSize 'vectors'
		if maskHas(kept, number: regNumOfCount(r)) 'kept'
			let n = r - arm64FirstVector
			if saves 'save'
				u.asm.arm64StoreVector(record, disp: arm64SwitchVectorDisp(nth), n: n)
			end 'save' else 'load'
				u.asm.arm64LoadVector(n, base: record, disp: arm64SwitchVectorDisp(nth))
			end 'load'
			nth = nextCount(nth)
		end 'kept'
	end 'vectors'
end 'emitArm64SwitchVectors'

// emitArm64GreenStart writes rt.greenStart, where a switch onto a stack that has not run returns to: the runtime seeded
// the record's x19 with the word to pass and its x20 with the code to call, which never returns.
function emitArm64GreenStart(mutates u CodeUnit)
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtGreenStart))
	u.asm.arm64Mov(arm64ArgWord(), src: Arm64Register.x19)
	u.asm.arm64CallRegister(Arm64Register.x20)
	u.asm.arm64Brk()
end 'emitArm64GreenStart'

// The frame of rt.asyncPreempt: a word for each general register by its number, the flags, two words for each vector
// register, which the stopped code may hold a 128-bit vector in, and at its top the word below the stack pointer the green thread was stopped at, which asyncPreempted writes the
// address it was stopped at into (runtime's resumeAt) and rt.asyncPreempt branches through.
let preemptGeneralSlots = 31

let preemptFlagsDisp = 248

let preemptVectorsDisp = 256

let preemptVectorCount = 32

let preemptVectorBytes = 16

let preemptFrameBytes = 784

// emitArm64AsyncPreempt writes rt.asyncPreempt, which a green thread the monitor stops resumes in, with the stack pointer
// it was stopped at: the stopped code is in the middle of whatever it was doing and may be using any register, so this
// saves the flags and every register but the stack pointer, x15, which no code but this keeps a value in, and x18, which
// no code writes, calls the code that contextPreemptCodeOffset of the thread's context names with the context, which parks
// the green thread and comes back when it runs again, perhaps on another thread, and branches to where it was stopped with
// every register as it was. Nothing keeps a value below the stack pointer, so the frame overwrites nothing.
function emitArm64AsyncPreempt(mutates u CodeUnit, system ast.TargetSystem)
	let resume = arm64ResumeRegister
	let resumeDisp = arm64Disp(try preemptFrameBytes - wordBytes otherwise panic("backend: a frame below zero"))
	let vectorsEnd = arm64Disp(try preemptVectorsDisp + preemptVectorCount * preemptVectorBytes otherwise panic("backend: a frame past memory"))
	let generalsEnd = arm64Disp(try preemptGeneralSlots * wordBytes otherwise panic("backend: a frame past memory"))
	if vectorsEnd > resumeDisp or generalsEnd > preemptFlagsDisp 'layout'
		panic("backend: rt.asyncPreempt's frame does not hold every register")
	end 'layout'
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtAsyncPreempt))
	u.asm.arm64AddImm(Arm64Register.sp, src: Arm64Register.sp, value: arm64Negated(arm64Disp(preemptFrameBytes)))
	for r in 0 upto preemptGeneralSlots 'saveGprs'
		if arm64Preserved(r) 'saved'
			u.asm.arm64Store(Arm64Register.sp, disp: arm64Disp(r * wordBytes), src: arm64RegisterOf(regNumOfCount(r)))
		end 'saved'
	end 'saveGprs'
	encodeArm64MrsNzcv(u.asm.code, dest: resume)
	u.asm.arm64Store(Arm64Register.sp, disp: preemptFlagsDisp, src: resume)
	for n in 0 upto preemptVectorCount 'saveVectors'
		u.asm.arm64StoreVectorWhole(Arm64Register.sp, disp: arm64Disp(preemptVectorsDisp + n * preemptVectorBytes), n: n)
	end 'saveVectors'
	emitArm64LoadContext(u, system: system, dst: resume)
	u.asm.arm64Mov(arm64ArgWord(), src: resume)
	u.asm.arm64Load(resume, base: resume, disp: arm64Disp(contextPreemptCodeOffset))
	u.asm.arm64CallRegister(resume)
	for n in 0 upto preemptVectorCount 'loadVectors'
		u.asm.arm64LoadVectorWhole(n, base: Arm64Register.sp, disp: arm64Disp(preemptVectorsDisp + n * preemptVectorBytes))
	end 'loadVectors'
	u.asm.arm64Load(resume, base: Arm64Register.sp, disp: preemptFlagsDisp)
	encodeArm64MsrNzcv(u.asm.code, src: resume)
	for r in 0 upto preemptGeneralSlots 'loadGprs'
		if arm64Preserved(r) 'saved'
			u.asm.arm64Load(arm64RegisterOf(regNumOfCount(r)), base: Arm64Register.sp, disp: arm64Disp(r * wordBytes))
		end 'saved'
	end 'loadGprs'
	u.asm.arm64Load(resume, base: Arm64Register.sp, disp: resumeDisp)
	u.asm.arm64AddImm(Arm64Register.sp, src: Arm64Register.sp, value: arm64Disp(preemptFrameBytes))
	u.asm.arm64JumpRegister(resume)
end 'emitArm64AsyncPreempt'

// arm64Preserved is whether rt.asyncPreempt keeps the general register of a number: every one but x15, its own, and x18,
// which no code writes.
function arm64Preserved(r Count) returns bool
	let n = regNumOfCount(r)
	return n != arm64RegNumOf(arm64ResumeRegister) and n != arm64RegNumOf(Arm64Register.x18)
end 'arm64Preserved'

// emitArm64LoadContext reads the running thread's context into a register, as a read of __Raw.threadContext does
// (arm64.rules); a read of the TSD slot changes the scratch register too, which every caller here has saved or holds
// nothing in.
function emitArm64LoadContext(mutates u CodeUnit, system ast.TargetSystem, dst Arm64Register)
	match arm64ThreadContext(system) 'context'
		threadRegister then encodeArm64MrsTpidr(u.asm.code, dest: dst)
		tlsSlot then emitArm64LoadTsdContext(u, dst: dst)
	end 'context'
end 'emitArm64LoadContext'

// emitArm64LoadTsdContext reads the slot of the thread's TSD array, which tpidrro_el0 points at, that the key in
// rt.tlsOffset names.
function emitArm64LoadTsdContext(mutates u CodeUnit, dst Arm64Register)
	encodeArm64MrsTpidrro(u.asm.code, dest: dst)
	encodeArm64AndRegMask(u.asm.code, dest: dst, src: dst, imm: arm64TsdMask as FullRangeInt)
	u.asm.arm64LoadSymbol(arm64Scratch, symbol: ir.rtSymbol(ir.Rt.rtTlsOffset))
	encodeArm64Ldr64Idx(u.asm.code, dest: dst, base: dst, index: arm64Scratch)
end 'emitArm64LoadTsdContext'

// emitArm64PreemptHandler writes rt.preemptHandler, the handler of the preemption signal, which the system calls by
// AAPCS64 with the signal's context in x2, on the thread's signal stack, and returns through the restorer on Linux and
// libSystem's trampoline on macOS: it calls the code that contextSignalCodeOffset of the thread's context names with that
// context, which may make the stopped code resume in rt.asyncPreempt, and returns.
function emitArm64PreemptHandler(mutates u CodeUnit, system ast.TargetSystem)
	let code = Arm64Register.x9
	u.beginSection()
	u.defineCode(ir.rtSymbol(ir.Rt.rtPreemptHandler))
	u.asm.arm64Enter()
	u.asm.arm64Mov(arm64ArgWord(), src: arm64ArgRegister(ConventionKind.host, system: system, index: 2))
	emitArm64LoadContext(u, system: system, dst: code)
	u.asm.arm64Load(code, base: code, disp: arm64Disp(contextSignalCodeOffset))
	u.asm.arm64CallRegister(code)
	u.asm.arm64Leave()
	u.asm.arm64Ret()
end 'emitArm64PreemptHandler'
