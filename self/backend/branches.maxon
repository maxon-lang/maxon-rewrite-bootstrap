// The layout of an allocated function's blocks for the encoder, and what it reads of the code around each instruction.
// A block that only jumps on is left out, and every branch to it goes where its jump goes; the cold blocks (a failing
// check's) are laid out after the others, so the hot path runs straight on; and the encoder leaves out a jump to the block
// laid out next, and turns a conditional branch to it over a jump the other way into one branch.

// BlockLayout plans the encoding of one function; its lists are reused from one function to the next.
export type BlockLayout
	// order is the blocks the encoder writes, in that order.
	var order as MBlockIDList
	// resolved is the block a branch to each block goes to: the block itself, or where its chain of jumps ends.
	var resolved as MBlockIDList
	var forwards as BoolList
	// flagsLiveIn is whether a block may read the flags it is entered with, and flagsLiveAfter whether the flags are read
	// after each instruction before they are written again.
	var flagsLiveIn as BoolList
	var flagsLiveAfter as BoolList
	// framed is whether the function needs a frame of its own, which the architecture's encoder decides.
	var framed as bool
	// position is where each block is in order. loopEnd is, for the head of a loop as the code runs it, the position past
	// the last block that branches back to it, and 0 for any other block; heads says whether there is a loop. starts are
	// where the encoding of the function without padding put the block at each position, and past the last, its end.
	var position as CountList
	var loopEnd as CountList
	var heads as bool
	var starts as CountList

	export static function new() returns BlockLayout
		return BlockLayout{order: MBlockIDList.create(0), resolved: MBlockIDList.create(0), forwards: BoolList.create(0), flagsLiveIn: BoolList.create(0), flagsLiveAfter: BoolList.create(0), framed: true, position: CountList.create(0), loopEnd: CountList.create(0), heads: false, starts: CountList.create(0)}
	end 'new'

	function plan(mutates self, fn MirFunction)
		self.findFlags(fn)
		order.clear()
		resolved.clear()
		for b in 0 upto fn.blocks.count() 'identity'
			resolved.push(blockIdOf(b))
		end 'identity'
		if not endsInTransfers(fn) 'fallsThrough'
			for o in 0 upto fn.order.count() 'asWritten'
				order.push(fn.order[o])
			end 'asWritten'
		end 'fallsThrough' else 'reordered'
			self.resolveJumps(fn)
			order.push(fn.order[0])
			self.place(fn, cold: false)
			self.place(fn, cold: true)
		end 'reordered'
		self.findLoopHeads(fn)
	end 'plan'

	// findLoopHeads finds the head of each loop as the code runs it: a block of a loop that a branch of a hot block laid
	// out at or after it goes back to, so the branch that closes the loop reaches it each time round, and the last such
	// block, which ends the loop's code. A block that is not laid out is after every block.
	function findLoopHeads(mutates self, fn MirFunction)
		let blocks = fn.blocks.count()
		ir.resetCounts(loopEnd, n: blocks)
		heads = false
		position.clear()
		for _ in 0 upto blocks 'unplaced'
			position.push(blocks)
		end 'unplaced'
		for pos in 0 upto order.count() 'positions'
			position[order[pos] as Count] = pos
		end 'positions'
		for pos in 0 upto order.count() 'blocks'
			let b = order[pos] as Count
			if fn.blocks[b].likelihood == Likelihood.cold 'cold'
				continue 'blocks'
			end 'cold'
			for k in fn.blocks[b].first upto fn.blocks[b].endAt 'instrs'
				if fn.instrs[k].kind == MKind.target and fn.instrs[k].ref == MRef.edge 'branch'
					let target = resolved[fn.edges[refIndex(fn.instrs[k])].target as Count] as Count
					if position[target] <= pos and fn.blocks[target].loopDepth > 0 'back'
						loopEnd[target] = nextCount(pos)
						heads = true
					end 'back'
				end 'branch'
			end 'instrs'
		end 'blocks'
	end 'findLoopHeads'

	// isLoopHead is whether the block at a position of order heads a loop.
	function isLoopHead(pos Count) returns bool
		return loopEnd[order[pos] as Count] != 0
	end 'isLoopHead'

	// loopBytes is how long the code of the loop headed by the block at a position of order was without padding.
	function loopBytes(pos Count) returns Count
		return try starts[loopEnd[order[pos] as Count]] - starts[pos] otherwise panic("backend: a loop that ends before its head")
	end 'loopBytes'

	// label is the label a branch along an edge goes to.
	function label(fn MirFunction, edge Count) returns LabelID
		if fn.edges[edge].argCount != 0 'arguments'
			panic("backend: an edge keeps its arguments past allocation")
		end 'arguments'
		return resolved[fn.edges[edge].target as Count] as LabelID
	end 'label'

	// goesTo is whether a branch along an edge goes to the block b.
	function goesTo(fn MirFunction, edge Count, b ir.Index) returns bool
		return resolved[fn.edges[edge].target as Count] as ir.Index == b
	end 'goesTo'

	// resolveJumps finds the blocks that only jump on, and where each chain of them ends. A chain that comes back to
	// itself is a loop that does nothing, whose blocks are kept.
	function resolveJumps(mutates self, fn MirFunction)
		let blocks = fn.blocks.count()
		ir.resetFlags(forwards, n: blocks)
		for o in 1 upto fn.order.count() 'blocks'
			let b = fn.order[o] as Count
			forwards[b] = fn.blocks[b].endAt == nextCount(fn.blocks[b].first) and isEdgeJump(fn.instrs[fn.blocks[b].first])
		end 'blocks'
		for b in 0 upto blocks 'chains'
			var at = b
			var steps = 0 as Count
			while forwards[at] and steps <= blocks 'follow'
				at = fn.edges[refIndex(fn.instrs[fn.blocks[at].first])].target as Count
				steps = nextCount(steps)
			end 'follow'
			if steps > blocks 'cycle'
				forwards[b] = false
				at = b
			end 'cycle'
			resolved[b] = blockIdOf(at)
		end 'chains'
	end 'resolveJumps'

	// place lays out the blocks of fn after its entry that no chain of jumps skips, of the likelihood cold says, in the
	// order of fn.
	function place(mutates self, fn MirFunction, cold bool)
		for o in 1 upto fn.order.count() 'blocks'
			let b = fn.order[o]
			if not forwards[b as Count] and (fn.blocks[b as Count].likelihood == Likelihood.cold) == cold 'here'
				order.push(b)
			end 'here'
		end 'blocks'
	end 'place'

	function findFlags(mutates self, fn MirFunction)
		findFlagsLiveIn(fn, liveIn: flagsLiveIn)
		ir.resetFlags(flagsLiveAfter, n: fn.instrs.count())
		for b in 0 upto fn.blocks.count() 'blocks'
			var live = flagsLiveOut(fn, b: b, liveIn: flagsLiveIn)
			var k = fn.blocks[b].endAt
			while k > fn.blocks[b].first 'instrs'
				k = prevCount(k)
				flagsLiveAfter[k] = live
				if killsFlags(fn.instrs[k]) 'writes'
					live = false
				end 'writes'
				if readsFlagsOf(fn.instrs[k]) 'reads'
					live = true
				end 'reads'
			end 'instrs'
		end 'blocks'
	end 'findFlags'
end 'BlockLayout'

// isEdgeJump is whether an instruction always goes along an edge.
function isEdgeJump(x MInstr) returns bool
	return isUnconditionalJump(x) and x.ref == MRef.edge
end 'isEdgeJump'

// endsInTransfers is whether every block of fn that is written ends in an instruction that goes elsewhere, a jump, a
// return or a trap, so none falls into the block written after it and the blocks may be laid out in any order.
function endsInTransfers(fn MirFunction) returns bool
	for o in 0 upto fn.order.count() 'blocks'
		let b = fn.order[o] as Count
		if fn.blocks[b].endAt == fn.blocks[b].first 'empty'
			return false
		end 'empty'
		let last = prevCount(fn.blocks[b].endAt)
		if not transfers(fn.instrs[last]) 'falls'
			return false
		end 'falls'
	end 'blocks'
	return true
end 'endsInTransfers'

function transfers(x MInstr) returns bool
	return x.kind == MKind.target and (isJump(x.form) or isReturn(x.form) or isTrap(x.form))
end 'transfers'
