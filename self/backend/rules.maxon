// The helpers that the conditions and expressions of x64.rules and arm64.rules call, and the constants they name.

// The rounding modes of roundsd's immediate: to the nearest (ties to even), down and up.
let roundNearest = 0 as Imm8

let roundDown = 1 as Imm8

let roundUp = 2 as Imm8

// fitsImm32 is whether a word is the sign extension of a 32-bit immediate, which the forms with one hold.
function fitsImm32(c ir.Word) returns bool
	return c >= imm32Min and c <= imm32Max
end 'fitsImm32'

// fitsImm8 is whether a word is the sign extension of an 8-bit immediate.
function fitsImm8(c ir.Word) returns bool
	return c >= imm8Min and c <= imm8Max
end 'fitsImm8'

// shiftsInWord is whether a shift count leaves some bit of the word in it, which a shift by an immediate counts by.
function shiftsInWord(c ir.Word) returns bool
	return c >= 0 and c < shiftBitCount
end 'shiftsInWord'

// slotDisp is where a slot of the IR's frame sits below the frame pointer: the slots are the first of the fixed slots.
function slotDisp(slot Count) returns Imm32
	return spillSlotOffset(try slot as SpillSlot otherwise panic("backend: a slot past 2 GiB"))
end 'slotDisp'

// cmpCondition is the condition code that holds when a comparison does.
function cmpCondition(x ir.Instr) returns MCond
	let unsigned = ir.cmpUnsigned(x)
	return match ir.cmpOp(x) 'op'
		cmpEq gives MCond.equal
		cmpNe gives MCond.notEqual
		cmpLt gives MCond.below if unsigned else MCond.less
		cmpLe gives MCond.belowEqual if unsigned else MCond.lessEqual
		cmpGt gives MCond.above if unsigned else MCond.greater
		cmpGe gives MCond.aboveEqual if unsigned else MCond.greaterEqual
	end 'op'
end 'cmpCondition'

// condOf is the condition code that holds when the comparison that defines r does.
function condOf(sel Selector, fn ir.IrFunction, r ir.Reg) returns MCond
	return cmpCondition(fn.instrs[sel.defOf(r)])
end 'condOf'

// negated is the condition code that holds where cond does not.
function negated(cond MCond) returns MCond
	return match cond 'cond'
		overflow gives MCond.noOverflow
		noOverflow gives MCond.overflow
		below gives MCond.aboveEqual
		aboveEqual gives MCond.below
		equal gives MCond.notEqual
		notEqual gives MCond.equal
		belowEqual gives MCond.above
		above gives MCond.belowEqual
		sign gives MCond.noSign
		noSign gives MCond.sign
		parity gives MCond.noParity
		noParity gives MCond.parity
		less gives MCond.greaterEqual
		greaterEqual gives MCond.less
		lessEqual gives MCond.greater
		greater gives MCond.lessEqual
	end 'cond'
end 'negated'

// swapped is the condition code of a comparison whose operands are swapped: x < y where y > x.
function swapped(cond MCond) returns MCond
	return match cond 'cond'
		equal or
		notEqual gives cond
		below gives MCond.above
		above gives MCond.below
		aboveEqual gives MCond.belowEqual
		belowEqual gives MCond.aboveEqual
		less gives MCond.greater
		greater gives MCond.less
		lessEqual gives MCond.greaterEqual
		greaterEqual gives MCond.lessEqual
		overflow or
		noOverflow or
		sign or
		noSign or
		parity or
		noParity gives panic("backend: a condition of no comparison of two operands swapped")
	end 'cond'
end 'swapped'

// guardFailure is the condition code, after a comparison of a guard's value with its bound, that says the value is out
// of the guard's range.
function guardFailure(x ir.Instr) returns MCond
	return match ir.guardKind(x) 'kind'
		guardSignedAtLeast gives MCond.less
		guardSignedAtMost gives MCond.greater
		guardUnsignedAtLeast gives MCond.below
		guardUnsignedAtMost gives MCond.above
		guardNonNegative or
		guardNonZero gives panic("backend: a guard against 0 is compared with no bound")
	end 'kind'
end 'guardFailure'

// arm64's helpers.

// arm64Imm12Max is the largest immediate that the 12 bits of an add, a sub and a cmp hold.
let arm64Imm12Max = 4095

// arm64WordShift is the shift of an index that the offset of its word in a buffer is.
let arm64WordShift = 3 as ir.Word

// arm64SignShift is the shift that leaves a word's sign alone, and the top bit of a bitfield move of the whole word.
let arm64SignShift = 63

// arm64FrameRecordBytes is the frame record at the frame pointer, the caller's frame pointer and the return address,
// which the slots are above.
let arm64FrameRecordBytes = 16

// arm64TsdMask clears the low bits of tpidrro_el0, which macOS keeps the processor's number in.
let arm64TsdMask = -8 as ir.Word

// arm64HoldsImm12 is whether a word is an immediate of add, sub and cmp.
function arm64HoldsImm12(c FullRangeInt) returns bool
	return c >= 0 and c <= arm64Imm12Max
end 'arm64HoldsImm12'

// arm64HoldsNegatedImm12 is whether a word is the negation of an immediate of add, sub and cmp other than 0, which the
// other operation of the two takes.
function arm64HoldsNegatedImm12(c FullRangeInt) returns bool
	return c < 0 and c >= 0 - arm64Imm12Max
end 'arm64HoldsNegatedImm12'

// arm64Disp is an offset in bytes as the helpers of the forms take it.
function arm64Disp(n Count) returns FullRangeInt
	return try n as FullRangeInt otherwise panic("backend: an offset past the word")
end 'arm64Disp'

// arm64Negated is the negation of a word that is not i64.min, which the immediate of the other operation of two takes.
function arm64Negated(value FullRangeInt) returns FullRangeInt
	return try 0 - value otherwise panic("backend: the negation of i64.min")
end 'arm64Negated'

// arm64Field32 is an offset or an immediate that the 32 bits of a machine instruction's aux hold.
function arm64Field32(value FullRangeInt) returns Imm32
	return try value as Imm32 otherwise panic("backend: an offset past 32 bits")
end 'arm64Field32'

// arm64SlotDisp is where a slot of the IR's frame sits above the frame pointer, after the frame record: the slots are the
// first of the fixed slots, and the spill slots follow them.
function arm64SlotDisp(slot Count) returns Imm32
	return imm32Of(try arm64FrameRecordBytes + slot * spillSlotBytes otherwise panic("backend: a slot past 2 GiB"))
end 'arm64SlotDisp'

// arm64LslImmr and arm64LslImms are the fields of the bitfield move that shifts left by a count within the word.
function arm64LslImmr(c ir.Word) returns Count
	return try ((shiftBitCount - c) mod shiftBitCount) as Count otherwise panic("backend: a shift past the word")
end 'arm64LslImmr'

function arm64LslImms(c ir.Word) returns Count
	return try (arm64SignShift - c) as Count otherwise panic("backend: a shift past the word")
end 'arm64LslImms'

// arm64LiveHalfword is the one halfword of a word that its ladder writes, which arm64OneMove says it has, or the first
// for a word whose ladder writes none.
function arm64LiveHalfword(c ir.Word) returns Count
	for hw in 0 upto arm64LadderSteps 'halfwords'
		if not arm64LadderSkips(c as FullRangeInt, hw: hw) 'live'
			return hw
		end 'live'
	end 'halfwords'
	return 0
end 'arm64LiveHalfword'

// arm64OneMove is whether the ladder of a word is one movz or movn.
function arm64OneMove(c ir.Word) returns bool
	var live = 0 as Count
	for hw in 0 upto arm64LadderSteps 'halfwords'
		if not arm64LadderSkips(c as FullRangeInt, hw: hw) 'live'
			live = nextCount(live)
		end 'live'
	end 'halfwords'
	return live <= 1
end 'arm64OneMove'

// arm64OneMoveHalfword and arm64OneMoveShift are the fields of the one move of a word that arm64OneMove says has one.
function arm64OneMoveHalfword(c ir.Word) returns Arm64Imm16
	return arm64LadderFirst(c as FullRangeInt, hw: arm64LiveHalfword(c))
end 'arm64OneMoveHalfword'

function arm64OneMoveShift(c ir.Word) returns Arm64Imm2
	return arm64LadderShift(arm64LiveHalfword(c))
end 'arm64OneMoveShift'
