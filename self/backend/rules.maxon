// The helpers that the conditions and expressions of x64.rules call, and the constants they name.

// The rounding modes of roundsd's immediate: to the nearest (ties to even), down and up.
let roundNearest = 0 as Imm8

let roundDown = 1 as Imm8

let roundUp = 2 as Imm8

// The arguments of a call are the words above the return address and the saved frame pointer.
let paramBase = 16

// fitsImm32 is whether a word is the sign extension of a 32-bit immediate, which the forms with one hold.
function fitsImm32(c ir.Word) returns bool
	return c >= imm32Min and c <= imm32Max
end 'fitsImm32'

// slotDisp is where a slot of the IR's frame sits below the frame pointer: the slots are the first of the fixed slots.
function slotDisp(slot Count) returns Imm32
	return spillSlotOffset(try slot as SpillSlot otherwise panic("backend: a slot past 2 GiB"))
end 'slotDisp'

// paramDisp is where a parameter of f sits above the frame pointer: the arguments are pushed left to right, so the last
// is nearest.
function paramDisp(f ir.IrFunction, index Count) returns Imm32
	let after = try f.paramCount - 1 - index otherwise panic("backend: a parameter that the function lacks")
	return imm32Of(try paramBase + wordBytes * after otherwise panic("backend: a parameter past memory"))
end 'paramDisp'

// cmpCondition is the condition code that holds when a comparison does.
function cmpCondition(x ir.Instr) returns X64CondCode
	let unsigned = ir.cmpUnsigned(x)
	return match ir.cmpOp(x) 'op'
		cmpEq gives X64CondCode.equal
		cmpNe gives X64CondCode.notEqual
		cmpLt gives X64CondCode.below if unsigned else X64CondCode.less
		cmpLe gives X64CondCode.belowEqual if unsigned else X64CondCode.lessEqual
		cmpGt gives X64CondCode.above if unsigned else X64CondCode.greater
		cmpGe gives X64CondCode.aboveEqual if unsigned else X64CondCode.greaterEqual
	end 'op'
end 'cmpCondition'

// guardFailure is the condition code, after a comparison of a guard's value with its bound, that says the value is out
// of the guard's range.
function guardFailure(x ir.Instr) returns X64CondCode
	return match ir.guardKind(x) 'kind'
		guardSignedAtLeast gives X64CondCode.less
		guardSignedAtMost gives X64CondCode.greater
		guardUnsignedAtLeast gives X64CondCode.below
		guardUnsignedAtMost gives X64CondCode.above
		guardNonNegative or
		guardNonZero gives panic("backend: a guard against 0 is compared with no bound")
	end 'kind'
end 'guardFailure'
