// A drop or a copy of a value is code that depends on the type of the value: which of the words of a box are boxes
// themselves, and in what layout. It is generated once for each concrete type that a program drops or copies, after
// monomorphization, as a routine of its own that the code of every module calls, so a type that contains itself (a record
// with an array of itself) is a routine that calls itself and not code written out where it is wanted.
//
// A routine is called by the internal convention with one argument, the value, which its prologue stores in its frame,
// and a copy returns the new value in the convention's result register; between calls the routines work in rax and
// the other registers every call may leave holding anything, so they keep no callee-saved register. A drop of a value
// that is 0 does nothing, which is how a place that was moved from, or never assigned, is dropped.
//
// The routines are in units of their own, built after the units of the modules, because which of them a program needs is
// known only once every module has been generated. Which they are, and in what order, comes from the modules in source
// order and from each routine's own parts in field order.

// routinesPerUnit is how many routines go into one unit.
let routinesPerUnit = 256

// Frame offsets of the routines below the frame pointer: the argument, and then the locals.
let routineArg = -8

let routineLocal0 = -16

let routineLocal1 = -24

let routineLocal2 = -32

let routineLocal3 = -40

// thunkBase is the register a behaviour's thunk holds the record in while it loads the body's arguments: one that the
// internal convention passes no value in.
let thunkBase = r11

// thunkWord is the register a thunk loads an argument the body takes on the stack into before pushing it.
let thunkWord = r10

// A count of owners (of a closure, a frozen value or a cown) is stepped by one locked add, since the owners may be on
// other threads: a new owner adds ownerJoins, one let go of adds ownerLeaves, and the one that found lastOwner there
// ends the box.
let ownerJoins = 1 as FullRangeInt

let ownerLeaves = -1 as FullRangeInt

let lastOwner = 1 as Imm32

export enum RoutineKind
	dropRoutine = 0
	copyRoutine = 1

	export function symbolPrefix() returns String
		return match self 'kind'
			dropRoutine gives "drop"
			copyRoutine gives "copy"
		end 'kind'
	end 'symbolPrefix'
end 'RoutineKind'

// TypeRoutine is the routine that drops or copies a value of one type. Its symbol is the kind and the type's link name, so
// two units that ask for the routine of one type name one routine, whichever compile made them.
export type TypeRoutine
	export var kind as RoutineKind
	export var ty as ast.TypeID
	// symbol is the text the routine is defined and called by.
	export var symbol as String

	export static function make(kind RoutineKind, ty ast.TypeID, consumes symbol String) returns TypeRoutine
		return TypeRoutine{kind: kind, ty: ty, symbol: symbol}
	end 'make'
end 'TypeRoutine'

export typealias TypeRoutineList = Array with TypeRoutine

typealias RoutineSymbols = table.IntMap with String

// routineSymbol is the symbol of the routine of a kind for the type with a link name. It starts with the kind and a space,
// which no function's link name does, so no routine is named like a function.
function routineSymbol(kind RoutineKind, typeLinkName String) returns String
	return "{kind.symbolPrefix()} {typeLinkName}"
end 'routineSymbol'

// RoutineSet is the routines a body of code asks for, each once, in the order they were first asked for. The name of a
// routine is made once for each type.
export type RoutineSet
	export var list as TypeRoutineList
	var dropSymbols as RoutineSymbols
	var copySymbols as RoutineSymbols

	export static function new() returns RoutineSet
		return RoutineSet{list: TypeRoutineList.create(0), dropSymbols: RoutineSymbols.new(), copySymbols: RoutineSymbols.new()}
	end 'new'

	function known(kind RoutineKind, ty ast.TypeID) returns table.Option with String
		if kind == RoutineKind.dropRoutine 'drop'
			return dropSymbols.get(ty as Count)
		end 'drop'
		return copySymbols.get(ty as Count)
	end 'known'

	function remember(mutates self, kind RoutineKind, ty ast.TypeID, symbol String)
		if kind == RoutineKind.dropRoutine 'drop'
			dropSymbols.insert(ty as Count, value: symbol.clone())
		end 'drop' else 'copy'
			copySymbols.insert(ty as Count, value: symbol.clone())
		end 'copy'
	end 'remember'

	// lookup is the symbol of a routine that symbol has been asked for already.
	export function lookup(kind RoutineKind, ty ast.TypeID) returns String
		match self.known(kind, ty: ty) 'hit'
			some(name) then return name.clone()
			none then panic("backend: the routine of a type was not asked for before its code")
		end 'hit'
	end 'lookup'

	// symbol is the name of the code that drops or copies a value of a type, and notes that the code asks for it. A drop of a
	// box that holds nothing to drop is the free itself, with no routine of its own.
	export function symbol(mutates self, p ast.Project, mutates ms ast.ModuleState, kind RoutineKind, ty ast.TypeID) returns String
		match self.known(kind, ty: ty) 'hit'
			some(name) then return name.clone()
			none then _ = 0
		end 'hit'
		if kind == RoutineKind.dropRoutine and onlyFrees(p, ms: ms, ty: ty) 'frees'
			let free = ir.rtSymbol(ir.Rt.rtFree)
			self.remember(kind, ty: ty, symbol: free)
			return free
		end 'frees'
		let name = routineSymbol(kind, typeLinkName: ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: ty))
		self.remember(kind, ty: ty, symbol: name)
		list.push(TypeRoutine.make(kind, ty: ty, symbol: name.clone()))
		return name
	end 'symbol'
end 'RoutineSet'

function fieldCount(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).fields.count()
end 'fieldCount'

function caseCount(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).cases.count()
end 'caseCount'

function payloadCount(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).cases[caseIndex].payload.count()
end 'payloadCount'

// elementType is the type of what an array holds.
function elementType(tt ast.TypeSlot, reads ast.TypeTable, array ast.TypeID) returns ast.TypeID
	return ast.typeEntry(tt, reads: reads, t: array).typeArgs[0]
end 'elementType'

function anyManagedPayload(mutates tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count) returns bool
	for j in 0 upto payloadCount(tt, reads: reads, owner: owner, caseIndex: caseIndex) 'each'
		let payloadTy = ast.payloadType(tt, reads: reads, owner: owner, caseIndex: caseIndex, index: j)
		if ast.isManagedType(tt, reads: reads, t: payloadTy) 'managed'
			return true
		end 'managed'
	end 'each'
	return false
end 'anyManagedPayload'

// onlyFrees is whether dropping a value of the type is freeing its box and nothing else: a record with no managed field,
// or a union that has no managed payload in any case.
function onlyFrees(p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: ty)
	if kind == ast.TypeKind.record 'record'
		for i in 0 upto fieldCount(ms.types, reads: p.types, owner: ty) 'fields'
			let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: ty, index: i)
			if ast.isManagedType(ms.types, reads: p.types, t: fieldTy) 'managed'
				return false
			end 'managed'
		end 'fields'
		return true
	end 'record'
	if kind == ast.TypeKind.unionTy 'union'
		for i in 0 upto caseCount(ms.types, reads: p.types, owner: ty) 'cases'
			if anyManagedPayload(ms.types, reads: p.types, owner: ty, caseIndex: i) 'managed'
				return false
			end 'managed'
		end 'cases'
		return true
	end 'union'
	return false
end 'onlyFrees'

// addNew appends to list the routines that are not known yet, and notes them.
function addNew(mutates known StringOffsets, consumes list TypeRoutineList, routines TypeRoutineList) returns TypeRoutineList
	var out = list
	for i in 0 upto routines.count() 'each'
		if not known.has(routines[i].symbol) 'new'
			known.insert(routines[i].symbol.clone(), value: 0 as Count)
			out.push(routines[i].clone())
		end 'new'
	end 'each'
	return out
end 'addNew'

// emitTypeRoutines is the units with the drop and copy routine of every type that the units ask for, and of every type
// those routines reach. A routine asks for the routines of the parts of its type, so they are made in waves: the ones the
// modules ask for, then the ones those ask for that are not made yet, and so on, each wave in the order the routines were
// first asked for.
export function emitTypeRoutines(p ast.Project, mutates ms ast.ModuleState, units LinkUnits) returns UnitList
	var known = StringOffsets.new()
	var pending = TypeRoutineList.create(0)
	for i in 0 upto units.count() 'units'
		pending = addNew(known, list: pending, routines: units.at(i).needed.list)
	end 'units'
	var made = UnitList.create(0)
	while pending.count() > 0 'waves'
		var wave = UnitList.create(0)
		var start = 0 as Count
		while start < pending.count() 'chunks'
			var stop = try start + routinesPerUnit otherwise pending.count()
			if stop > pending.count() 'clamp'
				stop = pending.count()
			end 'clamp'
			var chunk = TypeRoutineList.create(0)
			for i in start upto stop 'slice'
				chunk.push(pending[i].clone())
			end 'slice'
			wave.push(emitRoutines(p, ms: ms, routines: chunk))
			start = stop
		end 'chunks'
		var next = TypeRoutineList.create(0)
		for i in 0 upto wave.count() 'asked'
			next = addNew(known, list: next, routines: wave[i].needed.list)
		end 'asked'
		for i in 0 upto wave.count() 'collect'
			made.push(exchange(wave[i], value: CodeUnit.new()))
		end 'collect'
		pending = next
	end 'waves'
	return made
end 'emitTypeRoutines'

// carryRoutines makes, in the unit u of a module, the drop and copy routine of every type its code asks for, and of every type
// those reach, and leaves it asking for none: a unit is then all the link needs of its module, so a unit that a build cache
// kept links as the one its emit made, whatever the compile it links in knows of the module's types. Every unit that asks for
// a routine defines it, and the link keeps one, as it does of an instance.
export function carryRoutines(p ast.Project, mutates ms ast.ModuleState, mutates u CodeUnit)
	var i = 0 as Count
	while i < u.needed.list.count() 'routines'
		let routine = u.needed.list[i].clone()
		emitRoutine(u, p: p, ms: ms, routine: routine)
		i = try i + 1 otherwise panic("backend: more routines than memory")
	end 'routines'
	u.needed = RoutineSet.new()
end 'carryRoutines'

function emitRoutines(p ast.Project, mutates ms ast.ModuleState, routines TypeRoutineList) returns CodeUnit
	var u = CodeUnit.new()
	for i in 0 upto routines.count() 'each'
		emitRoutine(u, p: p, ms: ms, routine: routines[i])
	end 'each'
	return u
end 'emitRoutines'

// routineCall calls the routine of a type with the value in rax, and leaves a copy's result in rax. A routine that has
// not been asked for yet is queued.
function routineCall(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, kind RoutineKind, ty ast.TypeID)
	let symbol = u.needed.symbol(p, ms: ms, kind: kind, ty: ty)
	u.asm.mov(argWord(), src: rax)
	u.asm.callSymbol(symbol)
	takeResult(u)
end 'routineCall'

// callRuntimeWithRax calls an entry of the runtime with the value in rax as its one argument, and leaves its result in rax.
function callRuntimeWithRax(mutates u CodeUnit, entry ir.Rt)
	u.asm.mov(argWord(), src: rax)
	u.asm.callSymbol(ir.rtSymbol(entry))
	takeResult(u)
end 'callRuntimeWithRax'

// takeResult moves what a call returned into rax.
function takeResult(mutates u CodeUnit)
	u.asm.mov(rax, src: resultWord())
end 'takeResult'

// routinePrologue starts a routine that keeps its argument and a number of words of its own below the frame pointer. A
// routine is called once for each level of a nested value, so a tree that is deep enough would use up the stack: a
// routine reserves only what it uses.
function routinePrologue(mutates u CodeUnit, locals Count)
	u.asm.push(rbp)
	u.asm.mov(rbp, src: rsp)
	u.asm.subImm(rsp, imm: imm32Of(try (locals + 1) * wordBytes otherwise panic("a routine with locals past memory")))
	u.asm.store(rbp, disp: routineArg, src: argWord())
end 'routinePrologue'

function routineEpilogue(mutates u CodeUnit)
	u.asm.mov(rsp, src: rbp)
	u.asm.pop(rbp)
	u.asm.ret()
end 'routineEpilogue'

// routineReturn ends a copy routine, which returns the new value that rax holds.
function routineReturn(mutates u CodeUnit)
	u.asm.mov(resultWord(), src: rax)
	routineEpilogue(u)
end 'routineReturn'

// freeArgument gives back the box that the routine's argument is.
function freeArgument(mutates u CodeUnit)
	u.asm.load(rax, base: rbp, disp: routineArg)
	callRuntimeWithRax(u, entry: ir.Rt.rtFree)
end 'freeArgument'

// allocate calls the allocator for a box of a size, leaving it in rax.
function allocate(mutates u CodeUnit, bytes Count)
	u.asm.movImm(rax, imm: try bytes as FullRangeInt otherwise panic("a box past memory"))
	callRuntimeWithRax(u, entry: ir.Rt.rtAlloc)
end 'allocate'

// emitRoutine emits the code of one routine.
function emitRoutine(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, routine TypeRoutine)
	u.beginSection()
	u.defineFunction(routine.symbol, instance: true)
	if routine.kind == RoutineKind.dropRoutine 'drop'
		emitDrop(u, p: p, ms: ms, ty: routine.ty)
	end 'drop' else 'copy'
		emitCopy(u, p: p, ms: ms, ty: routine.ty)
	end 'copy'
end 'emitRoutine'

function emitDrop(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let kind = ast.typeKind(ms.types, reads: p.types, t: ty)
	if kind == ast.TypeKind.primString 'string'
		dropString(u)
		return
	end 'string'
	if kind == ast.TypeKind.record 'record'
		dropRecord(u, p: p, ms: ms, ty: ty)
		return
	end 'record'
	if kind == ast.TypeKind.unionTy 'union'
		dropUnion(u, p: p, ms: ms, ty: ty)
		return
	end 'union'
	if kind == ast.TypeKind.builtinArray 'array'
		if ast.packsBytes(ms.types, reads: p.types, b: p.builtins, t: ty) 'bytes'
			dropBytes(u)
			return
		end 'bytes'
		dropArray(u, p: p, ms: ms, ty: ty)
		return
	end 'array'
	if kind == ast.TypeKind.funcTy 'function'
		dropClosure(u)
		return
	end 'function'
	if kind == ast.TypeKind.interfaceTy 'interface'
		dropInterfaceValue(u)
		return
	end 'interface'
	if kind == ast.TypeKind.builtinFrozen 'frozen'
		dropFrozen(u, p: p, ms: ms, ty: ty)
		return
	end 'frozen'
	if kind == ast.TypeKind.builtinCown or kind == ast.TypeKind.builtinService 'cown'
		dropCown(u, p: p, ms: ms, ty: ty)
		return
	end 'cown'
	if kind == ast.TypeKind.builtinCursor 'cursor'
		dropCursor(u)
		return
	end 'cursor'
	if kind == ast.TypeKind.builtinPromise 'promise'
		dropPromise(u, p: p, ms: ms, ty: ty)
		return
	end 'promise'
	panic("routines: no drop routine for {ast.typeName(ms.types, reads: p.types, t: ty)}, which the driver should have refused")
end 'emitDrop'

function emitCopy(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let kind = ast.typeKind(ms.types, reads: p.types, t: ty)
	if kind == ast.TypeKind.primString 'string'
		copyString(u)
		return
	end 'string'
	if kind == ast.TypeKind.record 'record'
		copyRecord(u, p: p, ms: ms, ty: ty)
		return
	end 'record'
	if kind == ast.TypeKind.unionTy 'union'
		copyUnion(u, p: p, ms: ms, ty: ty)
		return
	end 'union'
	if kind == ast.TypeKind.builtinArray 'array'
		if ast.packsBytes(ms.types, reads: p.types, b: p.builtins, t: ty) 'bytes'
			copyBytes(u)
			return
		end 'bytes'
		copyArray(u, p: p, ms: ms, ty: ty)
		return
	end 'array'
	if kind == ast.TypeKind.funcTy 'function'
		copyShared(u, countOffset: closureCountOffset)
		return
	end 'function'
	if kind == ast.TypeKind.interfaceTy 'interface'
		copyInterfaceValue(u)
		return
	end 'interface'
	if kind == ast.TypeKind.builtinFrozen 'frozen'
		copyShared(u, countOffset: frozenCountOffset)
		return
	end 'frozen'
	if kind == ast.TypeKind.builtinCown or kind == ast.TypeKind.builtinService 'cown'
		copyShared(u, countOffset: cownCountOffset)
		return
	end 'cown'
	if kind == ast.TypeKind.builtinCursor 'cursor'
		copyCursor(u, p: p, ms: ms)
		return
	end 'cursor'
	panic("routines: no copy routine for {ast.typeName(ms.types, reads: p.types, t: ty)}, which the driver should have refused")
end 'emitCopy'

// dropPromise is the drop of a promise, which cancels it as `p.cancel()` does: the coroutine is marked, so it does not
// start or its sleeps end at once, it is waited for, and what its function gave, a value or an error, is dropped. The
// ownership pass drops no promise a program holds (E3213), so this meets the empty place an await leaves, and a promise
// that a coroutine cancelled before it started was given to own.
function dropPromise(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 1)
	returnIfEmpty(u, done: done)
	callRuntimeWithRax(u, entry: ir.Rt.rtAsyncCancel)
	let result = ast.promiseResult(ms.types, reads: p.types, t: ty)
	let errTy = ast.promiseError(ms.types, reads: p.types, t: ty)
	let managed = ast.isManagedType(ms.types, reads: p.types, t: result)
	u.asm.load(rax, base: rbp, disp: routineArg)
	if errTy == ast.noType 'plain'
		callRuntimeWithRax(u, entry: ir.Rt.rtAsyncAwait)
		if managed 'value'
			routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: result)
		end 'value'
	end 'plain' else 'throws'
		callRuntimeWithRax(u, entry: ir.Rt.rtAsyncWait)
		u.asm.load(rax, base: rbp, disp: routineArg)
		callRuntimeWithRax(u, entry: ir.Rt.rtAsyncError)
		u.asm.store(rbp, disp: routineLocal0, src: rax)
		u.asm.load(rax, base: rbp, disp: routineArg)
		callRuntimeWithRax(u, entry: ir.Rt.rtAsyncTake)
		let returned = u.asm.newLabel()
		u.asm.load(rcx, base: rbp, disp: routineLocal0)
		u.asm.test(rcx, right: rcx)
		u.asm.jcc(MCond.equal, label: returned)
		if ast.isUnionError(ms.types, reads: p.types, t: errTy) 'unionError'
			u.asm.load(rax, base: rbp, disp: routineLocal0)
			routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: errTy)
		end 'unionError'
		u.asm.jmp(done)
		u.asm.bind(returned)
		if managed 'value'
			routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: result)
		end 'value'
	end 'throws'
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropPromise'

// returnIfEmpty is the start of a drop: a value that is 0 holds nothing.
function returnIfEmpty(mutates u CodeUnit, done LabelID)
	u.asm.load(rax, base: rbp, disp: routineArg)
	u.asm.test(rax, right: rax)
	u.asm.jcc(MCond.equal, label: done)
end 'returnIfEmpty'

// dropWord drops the managed word at an offset of the box that the argument is.
function dropWord(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, offset Count, ty ast.TypeID)
	u.asm.load(rax, base: rbp, disp: routineArg)
	u.asm.load(rax, base: rax, disp: imm32Of(offset))
	routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: ty)
end 'dropWord'

function dropRecord(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 0)
	returnIfEmpty(u, done: done)
	for i in 0 upto fieldCount(ms.types, reads: p.types, owner: ty) 'fields'
		let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: ty, index: i)
		if ast.isManagedType(ms.types, reads: p.types, t: fieldTy) 'managed'
			dropWord(u, p: p, ms: ms, offset: ir.fieldOffset(i, tagged: false), ty: fieldTy)
		end 'managed'
	end 'fields'
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropRecord'

// dropCursor frees the box of a cursor (ir.cursorFields), which borrows the buffer it walks and owns nothing else.
function dropCursor(mutates u CodeUnit)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 0)
	returnIfEmpty(u, done: done)
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropCursor'

// copyCursor is a new cursor at the same element of the same buffer, which the copy borrows as well.
function copyCursor(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState)
	routinePrologue(u, locals: 1)
	allocate(u, bytes: ir.boxBytes(ir.cursorFields, tagged: false))
	u.asm.store(rbp, disp: routineLocal0, src: rax)
	for i in 0 upto ir.cursorFields 'words'
		copyWord(u, p: p, ms: ms, offset: ir.fieldOffset(i, tagged: false), ty: p.builtins.countTy)
	end 'words'
	u.asm.load(rax, base: rbp, disp: routineLocal0)
	routineReturn(u)
end 'copyCursor'

// dropUnion drops the payload of the case the box holds, and then the box.
function dropUnion(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	let release = u.asm.newLabel()
	routinePrologue(u, locals: 0)
	returnIfEmpty(u, done: done)
	for i in 0 upto caseCount(ms.types, reads: p.types, owner: ty) 'cases'
		if not anyManagedPayload(ms.types, reads: p.types, owner: ty, caseIndex: i) 'plain'
			continue 'cases'
		end 'plain'
		let next = u.asm.newLabel()
		u.asm.load(rax, base: rbp, disp: routineArg)
		u.asm.load(rax, base: rax, disp: imm32Of(ir.tagOffset))
		u.asm.cmpImm(rax, imm: imm32Of(i))
		u.asm.jcc(MCond.notEqual, label: next)
		for j in 0 upto payloadCount(ms.types, reads: p.types, owner: ty, caseIndex: i) 'payload'
			let payloadTy = ast.payloadType(ms.types, reads: p.types, owner: ty, caseIndex: i, index: j)
			if ast.isManagedType(ms.types, reads: p.types, t: payloadTy) 'managed'
				dropWord(u, p: p, ms: ms, offset: ir.fieldOffset(j, tagged: true), ty: payloadTy)
			end 'managed'
		end 'payload'
		u.asm.jmp(release)
		u.asm.bind(next)
	end 'cases'
	u.asm.bind(release)
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropUnion'

// dropArray drops each element, and then the buffer and the header.
function dropArray(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 1)
	returnIfEmpty(u, done: done)
	let elem = elementType(ms.types, reads: p.types, array: ty)
	if ast.isManagedType(ms.types, reads: p.types, t: elem) 'managed'
		let top = u.asm.newLabel()
		let out = u.asm.newLabel()
		u.asm.bitXor(rax, src: rax)
		u.asm.store(rbp, disp: routineLocal0, src: rax)
		u.asm.bind(top)
		u.asm.load(rcx, base: rbp, disp: routineArg)
		u.asm.load(rdx, base: rcx, disp: arrayLengthOffset)
		u.asm.load(rax, base: rbp, disp: routineLocal0)
		u.asm.cmp(rax, right: rdx)
		u.asm.jcc(MCond.aboveEqual, label: out)
		u.asm.load(rcx, base: rcx, disp: arrayDataOffset)
		u.asm.movImm(rdx, imm: wordBytes)
		u.asm.imul(rax, src: rdx)
		u.asm.add(rcx, src: rax)
		u.asm.load(rax, base: rcx, disp: 0)
		routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: elem)
		u.asm.load(rax, base: rbp, disp: routineLocal0)
		u.asm.addImm(rax, imm: 1)
		u.asm.store(rbp, disp: routineLocal0, src: rax)
		u.asm.jmp(top)
		u.asm.bind(out)
	end 'managed'
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rax, base: rcx, disp: arrayDataOffset)
	callRuntimeWithRax(u, entry: ir.Rt.rtFree)
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropArray'

// dropClosure lets go of one of the function values that share a closure: the last one drops what the closure owns, by the
// routine the closure holds, and frees the box.
function dropClosure(mutates u CodeUnit)
	let done = u.asm.newLabel()
	let release = u.asm.newLabel()
	routinePrologue(u, locals: 0)
	returnIfEmpty(u, done: done)
	leaveUnlessLast(u, countOffset: closureCountOffset, done: done)
	u.asm.load(argWord(), base: rbp, disp: routineArg)
	u.asm.load(rax, base: argWord(), disp: imm32Of(closureDropOffset))
	u.asm.test(rax, right: rax)
	u.asm.jcc(MCond.equal, label: release)
	u.asm.callRegister(rax)
	u.asm.bind(release)
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropClosure'

// leaveUnlessLast lets go of one owner of the box that the argument is, and jumps to done unless it was the last.
function leaveUnlessLast(mutates u CodeUnit, countOffset Count, done LabelID)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.movImm(rax, imm: ownerLeaves)
	u.asm.lockXadd(rcx, disp: imm32Of(countOffset), src: rax)
	u.asm.cmpImm(rax, imm: lastOwner)
	u.asm.jcc(MCond.notEqual, label: done)
end 'leaveUnlessLast'

// heldType is the type of what a frozen value or a cown holds.
function heldType(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns ast.TypeID
	return ast.typeEntry(tt, reads: reads, t: owner).typeArgs[0]
end 'heldType'

// dropFrozen lets go of one owner of a frozen value: the last frees the box and then drops what it held, in the order
// the interpreter frees them.
function dropFrozen(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 1)
	returnIfEmpty(u, done: done)
	leaveUnlessLast(u, countOffset: frozenCountOffset, done: done)
	u.asm.load(rax, base: rcx, disp: imm32Of(frozenValueOffset))
	u.asm.store(rbp, disp: routineLocal0, src: rax)
	freeArgument(u)
	let held = heldType(ms.types, reads: p.types, owner: ty)
	if ast.isManagedType(ms.types, reads: p.types, t: held) 'managed'
		u.asm.load(rax, base: rbp, disp: routineLocal0)
		routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: held)
	end 'managed'
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropFrozen'

// dropCown lets go of one owner of a cown: the last frees the cown and then ends its value, with the destructor it was
// made with or else by the drop of the value's type, in the order the interpreter frees them. A destructor is given only
// a value that is there.
function dropCown(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	let dropped = u.asm.newLabel()
	routinePrologue(u, locals: 2)
	returnIfEmpty(u, done: done)
	leaveUnlessLast(u, countOffset: cownCountOffset, done: done)
	u.asm.load(rax, base: rcx, disp: imm32Of(cownValueOffset))
	u.asm.store(rbp, disp: routineLocal0, src: rax)
	u.asm.load(rax, base: rcx, disp: imm32Of(cownEndingOffset))
	u.asm.store(rbp, disp: routineLocal1, src: rax)
	freeArgument(u)
	u.asm.load(rax, base: rbp, disp: routineLocal1)
	u.asm.test(rax, right: rax)
	u.asm.jcc(MCond.equal, label: dropped)
	u.asm.load(argWord(), base: rbp, disp: routineLocal0)
	u.asm.test(argWord(), right: argWord())
	u.asm.jcc(MCond.equal, label: done)
	u.asm.callRegister(rax)
	u.asm.jmp(done)
	u.asm.bind(dropped)
	let held = heldType(ms.types, reads: p.types, owner: ty)
	if ast.isManagedType(ms.types, reads: p.types, t: held) 'managed'
		u.asm.load(rax, base: rbp, disp: routineLocal0)
		routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: held)
	end 'managed'
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropCown'

// tableEntryAddress puts in rax the address of an entry of the table of the interface value that rcx is.
function tableEntryAddress(mutates u CodeUnit, entry Count)
	u.asm.load(rax, base: rcx, disp: imm32Of(ifaceTableOffset))
	u.asm.addImm(rax, imm: imm32Of(try entry * tableEntryBytes otherwise panic("routines: a table past memory")))
end 'tableEntryAddress'

// dropInterfaceValue drops the value the box holds by the entry of its table that drops it, and frees the box. Every
// interface type has this one routine, since the table knows the type of the value.
function dropInterfaceValue(mutates u CodeUnit)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 0)
	returnIfEmpty(u, done: done)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rdx, base: rcx, disp: imm32Of(ifaceValueOffset))
	tableEntryAddress(u, entry: tableDropEntry)
	u.asm.mov(argWord(), src: rdx)
	u.asm.callRegister(rax)
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropInterfaceValue'

// copyInterfaceValue is a new box of the same table and a copy of the value, which the entry of the table that copies it
// makes.
function copyInterfaceValue(mutates u CodeUnit)
	routinePrologue(u, locals: 1)
	allocate(u, bytes: ifaceBoxBytes)
	u.asm.store(rbp, disp: routineLocal0, src: rax)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rdx, base: rcx, disp: imm32Of(ifaceTableOffset))
	u.asm.store(rax, disp: imm32Of(ifaceTableOffset), src: rdx)
	u.asm.load(rdx, base: rcx, disp: imm32Of(ifaceValueOffset))
	tableEntryAddress(u, entry: tableCopyEntry)
	u.asm.mov(argWord(), src: rdx)
	u.asm.callRegister(rax)
	takeResult(u)
	u.asm.load(rcx, base: rbp, disp: routineLocal0)
	u.asm.store(rcx, disp: imm32Of(ifaceValueOffset), src: rax)
	u.asm.mov(rax, src: rcx)
	routineReturn(u)
end 'copyInterfaceValue'

// emitTable writes the table of an interface value, a section of code of an entry for each of its routines and methods:
// a jump to it, padded to tableEntryBytes. An entry is called as what it jumps to is, so it passes the arguments on as
// they are. Every unit that boxes such a value writes the table, and the link keeps one, as it does an instance. A scalar
// is dropped by nothing and copied as it is, and the copy of a value that no copy of the interface value can reach traps.
// typeNameSymbol is the symbol of the word of data whose address names the type t at run time. It starts with a word and a
// space, as a routine's does, so it names no function.
export function typeNameSymbol(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return "type {ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: t)}"
end 'typeNameSymbol'

export function emitTable(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, t ir.WitnessTable, typeSymbol String)
	u.beginSection()
	u.defineFunction(t.symbol, instance: true)
	let managed = ast.isManagedType(ms.types, reads: p.types, t: t.concrete)
	var start = u.asm.pos()
	if managed 'drop'
		u.asm.jmpSymbol(u.needed.symbol(p, ms: ms, kind: RoutineKind.dropRoutine, ty: t.concrete))
	end 'drop' else 'nothing'
		u.asm.ret()
	end 'nothing'
	padEntry(u, start: start)
	start = u.asm.pos()
	if not ast.reachesInterface(ms.types, reads: p.types, have: t.iface, want: p.builtins.copyableTy) 'uncopied'
		u.asm.ud2()
	end 'uncopied' else if managed 'copy'
		u.asm.jmpSymbol(u.needed.symbol(p, ms: ms, kind: RoutineKind.copyRoutine, ty: t.concrete))
	end 'copy' else 'same'
		u.asm.mov(resultWord(), src: argWord())
		u.asm.ret()
	end 'same'
	padEntry(u, start: start)
	start = u.asm.pos()
	u.asm.leaSymbol(resultWord(), symbol: typeSymbol)
	u.asm.ret()
	padEntry(u, start: start)
	for i in 0 upto t.methods.count() 'methods'
		start = u.asm.pos()
		u.asm.jmpSymbol(ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: t.methods[i]))
		padEntry(u, start: start)
	end 'methods'
end 'emitTable'

// padEntry fills an entry of a table that started at start up to tableEntryBytes with returns, which no code
// reaches.
function padEntry(mutates u CodeUnit, start Count)
	let finish = try start + tableEntryBytes otherwise panic("routines: a table past memory")
	if u.asm.pos() > finish 'long'
		panic("routines: an entry of a table is longer than tableEntryBytes")
	end 'long'
	while u.asm.pos() < finish 'pad'
		u.asm.ret()
	end 'pad'
end 'padEntry'

// copyShared is another owner of a box that its owners share, a closure, a frozen value or a cown: the same box, with its
// count raised by 1.
function copyShared(mutates u CodeUnit, countOffset Count)
	routinePrologue(u, locals: 0)
	u.asm.load(rax, base: rbp, disp: routineArg)
	u.asm.movImm(rcx, imm: ownerJoins)
	u.asm.lockXadd(rax, disp: imm32Of(countOffset), src: rcx)
	routineReturn(u)
end 'copyShared'

// emitCaptureDrop writes the routine that drops what a closure of the body owns, which the last function value that shares
// the closure calls before it frees the box.
export function emitCaptureDrop(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, symbol String, body ir.IrFunction, instance bool)
	u.beginSection()
	u.defineFunction(symbol, instance: instance)
	routinePrologue(u, locals: 0)
	for i in 0 upto body.captureOwned.count() 'captures'
		if body.captureOwned[i] 'owned'
			dropWord(u, p: p, ms: ms, offset: try closureCapturesOffset + i * wordBytes otherwise panic("routines: a capture past memory"), ty: body.captureTypes[i])
		end 'owned'
	end 'captures'
	routineEpilogue(u)
end 'emitCaptureDrop'

// emitBehaviourThunk writes the thunk that the scheduler runs a behaviour's record with, once the behaviour holds every
// cown it names: it calls the body with the address of each cown's value and then each capture, words in the general
// registers, as a behaviour's body takes them whatever their types, and which the body drops as it drops a consumes
// parameter; has the runtime hand each cown to the behaviour queued after it; drops the behaviour's
// hold on each cown, in source order as the interpreter does, which may end a cown and run its destructor on this
// thread; and frees the record. The scheduler counts the behaviour finished when the thunk returns.
export function emitBehaviourThunk(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, symbol String, body ir.IrFunction, bodySymbol String, instance bool)
	let cowns = body.cownTypes.count()
	let start = behaviourWordsOffset(cowns)
	u.beginSection()
	u.defineFunction(symbol, instance: instance)
	routinePrologue(u, locals: 0)
	let inRegisters = internalArgsInRegisters(body.paramCount)
	let scratch = regMaskOf(thunkBase) or regMaskOf(thunkWord)
	if (scratch and (internalArgRegs(inRegisters) or not x64InternalCallerSaved())) != 0 'scratch'
		panic("routines: a thunk's scratch register passes an argument or is one a call keeps")
	end 'scratch'
	u.asm.load(thunkBase, base: rbp, disp: routineArg)
	var w = body.paramCount
	while w > inRegisters 'stack'
		w = prevCount(w)
		loadBehaviourWord(u, into: thunkWord, start: start, index: w, cowns: cowns)
		u.asm.push(thunkWord)
	end 'stack'
	for i in 0 upto inRegisters 'registers'
		loadBehaviourWord(u, into: x64InternalArg(i), start: start, index: i, cowns: cowns)
	end 'registers'
	u.asm.callSymbol(bodySymbol)
	let pushed = try body.paramCount - inRegisters otherwise panic("routines: more arguments in registers than a body takes")
	if pushed > 0 'pop'
		u.asm.addImm(rsp, imm: imm32Of(try pushed * wordBytes otherwise panic("routines: a behaviour past memory")))
	end 'pop'
	u.asm.load(rax, base: rbp, disp: routineArg)
	callRuntimeWithRax(u, entry: ir.Rt.rtCownRelease)
	for i in 0 upto cowns 'holds'
		u.asm.load(rcx, base: rbp, disp: routineArg)
		u.asm.load(rax, base: rcx, disp: imm32Of(try start + i * wordBytes otherwise panic("routines: a behaviour past memory")))
		routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: body.cownTypes[i])
	end 'holds'
	freeArgument(u)
	routineEpilogue(u)
end 'emitBehaviourThunk'

// emitAsyncThunk writes the thunk a coroutine runs, which greenMain calls with the coroutine by the internal convention: it
// calls the function an async call starts with the coroutine's argument words, each in the place the convention passes
// its parameter in (a float's bits in an xmm register), keeps what the function failed with in the coroutine for the
// await, and gives back what it returned as a word, a float's bits among them. Every unit that starts the function writes
// it, and the link keeps one, as it does an instance.
export function emitAsyncThunk(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, symbol String, callee ast.FuncID, calleeSymbol String)
	let params = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).params.count()
	let fails = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).errTy != ast.noType
	let sig = ir.funcSignature(p, ms: ms, fid: callee)
	var floats as Array with bool
	floats = Array.create(0)
	for i in 0 upto params 'floats'
		floats.push(ir.isFloatAt(sig.args, place: i))
	end 'floats'
	var places = CountList.create(0)
	let stacked = placeArgs(floats, places: places)
	u.beginSection()
	u.defineFunction(symbol, instance: true)
	routinePrologue(u, locals: 0)
	let scratch = regMaskOf(thunkBase) or regMaskOf(thunkWord)
	if (scratch and (internalArgRegs(internalArgsInRegisters(params)) or not x64InternalCallerSaved())) != 0 'scratch'
		panic("routines: a thunk's scratch register passes an argument or is one a call keeps")
	end 'scratch'
	let skip = u.asm.newLabel()
	let join = u.asm.newLabel()
	u.asm.load(thunkBase, base: rbp, disp: routineArg)
	u.asm.load(thunkWord, base: thunkBase, disp: imm32Of(greenCancelOffset))
	u.asm.test(thunkWord, right: thunkWord)
	u.asm.jcc(MCond.notEqual, label: skip)
	var w = params
	while w > 0 'stack'
		w = prevCount(w)
		if isStackPlace(places[w]) 'pushed'
			u.asm.load(thunkWord, base: thunkBase, disp: coroutineWordDisp(w))
			u.asm.push(thunkWord)
		end 'pushed'
	end 'stack'
	for i in 0 upto params 'registers'
		if isStackPlace(places[i]) 'onStack'
			continue 'registers'
		end 'onStack'
		let number = try places[i] as RegNum otherwise panic("routines: a place past the register file")
		if floats[i] 'vector'
			u.asm.loadFloatWord(x64RegisterOf(try (number - x64FirstVector) as RegNum otherwise panic("routines: a float in a general register")), base: thunkBase, disp: coroutineWordDisp(i))
		end 'vector' else 'word'
			u.asm.load(x64RegisterOf(number), base: thunkBase, disp: coroutineWordDisp(i))
		end 'word'
	end 'registers'
	u.asm.callSymbol(calleeSymbol)
	if stacked > 0 'pop'
		u.asm.addImm(rsp, imm: imm32Of(try stacked * wordBytes otherwise panic("routines: a coroutine past memory")))
	end 'pop'
	if sig.result 'floatResult'
		u.asm.moveFromVector(resultWord(), src: x64RegisterOf(try (x64InternalFloatResult - x64FirstVector) as RegNum otherwise panic("routines: a float result in a general register")))
	end 'floatResult'
	u.asm.jmp(join)
	u.asm.bind(skip)
	dropOwnedArguments(u, p: p, ms: ms, callee: callee)
	u.asm.movImm(resultWord(), imm: 0)
	u.asm.movImm(x64InternalError, imm: 0)
	u.asm.bind(join)
	if fails 'fails'
		u.asm.load(thunkBase, base: rbp, disp: routineArg)
		u.asm.store(thunkBase, disp: imm32Of(greenErrorOffset), src: x64InternalError)
	end 'fails'
	routineEpilogue(u)
end 'emitAsyncThunk'

// dropOwnedArguments drops, for a coroutine whose promise was cancelled before it started, the arguments its function would
// have owned: what a consumes parameter took. The rest the caller lent, and keeps.
function dropOwnedArguments(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, callee ast.FuncID)
	let params = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).params.count()
	for i in 0 upto params 'params'
		let conv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).params[i].conv
		let ty = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).paramTypes[i]
		if (conv == ast.Convention.convConsumes or conv == ast.Convention.convDestructs) and ast.isManagedType(ms.types, reads: p.types, t: ty) 'owned'
			u.asm.load(thunkBase, base: rbp, disp: routineArg)
			u.asm.load(rax, base: thunkBase, disp: coroutineWordDisp(i))
			routineCall(u, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: ty)
		end 'owned'
	end 'params'
end 'dropOwnedArguments'

// coroutineWordDisp is where a coroutine holds its argument word at index.
function coroutineWordDisp(index Count) returns Imm32
	if index >= greenArgWords 'past'
		panic("routines: a coroutine has no argument word of that index")
	end 'past'
	return imm32Of(try greenArgsOffset + index * wordBytes otherwise panic("routines: a coroutine past memory"))
end 'coroutineWordDisp'

// loadBehaviourWord loads into a register the word of a behaviour's record, which thunkBase holds, that is the body's
// argument at index: the address of the value of each cown, and then each capture.
function loadBehaviourWord(mutates u CodeUnit, into X64Register, start Count, index Count, cowns Count)
	u.asm.load(into, base: thunkBase, disp: imm32Of(try start + index * wordBytes otherwise panic("routines: a behaviour past memory")))
	if index < cowns 'cown'
		u.asm.addImm(into, imm: imm32Of(cownValueOffset))
	end 'cown'
end 'loadBehaviourWord'

// jumpIfImmortal jumps when the string that the argument is lives in the executable's data section, which no one frees:
// its address is between the bounds the linker defines. A string on the heap is never there.
function jumpIfImmortal(mutates u CodeUnit, target LabelID)
	u.asm.load(rax, base: rbp, disp: routineArg)
	u.asm.leaSymbol(rcx, symbol: ir.rtSymbol(ir.Rt.rtImageDataStart))
	u.asm.sub(rax, src: rcx)
	u.asm.leaSymbol(rdx, symbol: ir.rtSymbol(ir.Rt.rtImageDataEnd))
	u.asm.sub(rdx, src: rcx)
	u.asm.cmp(rax, right: rdx)
	u.asm.jcc(MCond.below, label: target)
end 'jumpIfImmortal'

function dropString(mutates u CodeUnit)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 0)
	returnIfEmpty(u, done: done)
	jumpIfImmortal(u, target: done)
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropString'

function dropBytes(mutates u CodeUnit)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 0)
	returnIfEmpty(u, done: done)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rax, base: rcx, disp: arrayDataOffset)
	callRuntimeWithRax(u, entry: ir.Rt.rtFree)
	freeArgument(u)
	u.asm.bind(done)
	routineEpilogue(u)
end 'dropBytes'

// copyWord copies the word at an offset of the box that the argument is into the same offset of the new box, which is
// the first local: a managed word is copied by the routine of its type.
function copyWord(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, offset Count, ty ast.TypeID)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rax, base: rcx, disp: imm32Of(offset))
	if ast.isManagedType(ms.types, reads: p.types, t: ty) 'managed'
		routineCall(u, p: p, ms: ms, kind: RoutineKind.copyRoutine, ty: ty)
	end 'managed'
	u.asm.load(rcx, base: rbp, disp: routineLocal0)
	u.asm.store(rcx, disp: imm32Of(offset), src: rax)
end 'copyWord'

function copyRecord(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let fields = fieldCount(ms.types, reads: p.types, owner: ty)
	routinePrologue(u, locals: 1)
	allocate(u, bytes: ir.boxBytes(fields, tagged: false))
	u.asm.store(rbp, disp: routineLocal0, src: rax)
	for i in 0 upto fields 'fields'
		let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: ty, index: i)
		copyWord(u, p: p, ms: ms, offset: ir.fieldOffset(i, tagged: false), ty: fieldTy)
	end 'fields'
	u.asm.load(rax, base: rbp, disp: routineLocal0)
	routineReturn(u)
end 'copyRecord'

// copyUnion makes a box for the case the value holds, sized for its payload as lowering sizes it.
function copyUnion(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 1)
	let cases = caseCount(ms.types, reads: p.types, owner: ty)
	for i in 0 upto cases 'cases'
		let payload = payloadCount(ms.types, reads: p.types, owner: ty, caseIndex: i)
		let last = i + 1 == cases
		let next = u.asm.newLabel()
		if not last 'check'
			u.asm.load(rax, base: rbp, disp: routineArg)
			u.asm.load(rax, base: rax, disp: imm32Of(ir.tagOffset))
			u.asm.cmpImm(rax, imm: imm32Of(i))
			u.asm.jcc(MCond.notEqual, label: next)
		end 'check'
		allocate(u, bytes: ir.boxBytes(payload, tagged: true))
		u.asm.store(rbp, disp: routineLocal0, src: rax)
		u.asm.movImm(rcx, imm: try i as FullRangeInt otherwise panic("a case index past memory"))
		u.asm.store(rax, disp: imm32Of(ir.tagOffset), src: rcx)
		for j in 0 upto payload 'payload'
			let payloadTy = ast.payloadType(ms.types, reads: p.types, owner: ty, caseIndex: i, index: j)
			copyWord(u, p: p, ms: ms, offset: ir.fieldOffset(j, tagged: true), ty: payloadTy)
		end 'payload'
		if not last 'skip'
			u.asm.jmp(done)
			u.asm.bind(next)
		end 'skip'
	end 'cases'
	u.asm.bind(done)
	u.asm.load(rax, base: rbp, disp: routineLocal0)
	routineReturn(u)
end 'copyUnion'

// copyArray makes a header and a buffer of exactly the length, with a copy of each element.
function copyArray(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let header = routineLocal0
	let length = routineLocal1
	let index = routineLocal2
	let buffer = routineLocal3
	let done = u.asm.newLabel()
	let top = u.asm.newLabel()
	routinePrologue(u, locals: 4)
	allocate(u, bytes: arrayHeaderBytes)
	u.asm.store(rbp, disp: header, src: rax)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rax, base: rcx, disp: arrayLengthOffset)
	u.asm.store(rbp, disp: length, src: rax)
	u.asm.test(rax, right: rax)
	u.asm.jcc(MCond.equal, label: done)
	u.asm.movImm(rdx, imm: wordBytes)
	u.asm.imul(rax, src: rdx)
	callRuntimeWithRax(u, entry: ir.Rt.rtAlloc)
	u.asm.store(rbp, disp: buffer, src: rax)
	u.asm.load(rcx, base: rbp, disp: header)
	u.asm.load(rax, base: rbp, disp: length)
	u.asm.store(rcx, disp: arrayLengthOffset, src: rax)
	u.asm.store(rcx, disp: arrayCapacityOffset, src: rax)
	u.asm.load(rax, base: rbp, disp: buffer)
	u.asm.store(rcx, disp: arrayDataOffset, src: rax)
	u.asm.bitXor(rax, src: rax)
	u.asm.store(rbp, disp: index, src: rax)
	u.asm.bind(top)
	u.asm.load(rax, base: rbp, disp: index)
	u.asm.load(rdx, base: rbp, disp: length)
	u.asm.cmp(rax, right: rdx)
	u.asm.jcc(MCond.aboveEqual, label: done)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rcx, base: rcx, disp: arrayDataOffset)
	u.asm.movImm(rdx, imm: wordBytes)
	u.asm.imul(rax, src: rdx)
	u.asm.add(rcx, src: rax)
	u.asm.load(rax, base: rcx, disp: 0)
	let elem = elementType(ms.types, reads: p.types, array: ty)
	// An empty slot of a managed element, 0, stays empty in the copy (ir.SlotRead).
	let empty = u.asm.newLabel()
	if ast.isManagedType(ms.types, reads: p.types, t: elem) 'managed'
		u.asm.test(rax, right: rax)
		u.asm.jcc(MCond.equal, label: empty)
		routineCall(u, p: p, ms: ms, kind: RoutineKind.copyRoutine, ty: elem)
	end 'managed'
	u.asm.bind(empty)
	u.asm.load(rcx, base: rbp, disp: index)
	u.asm.movImm(rdx, imm: wordBytes)
	u.asm.imul(rcx, src: rdx)
	u.asm.load(rdx, base: rbp, disp: buffer)
	u.asm.add(rcx, src: rdx)
	u.asm.store(rcx, disp: 0, src: rax)
	u.asm.load(rax, base: rbp, disp: index)
	u.asm.addImm(rax, imm: 1)
	u.asm.store(rbp, disp: index, src: rax)
	u.asm.jmp(top)
	u.asm.bind(done)
	u.asm.load(rax, base: rbp, disp: header)
	routineReturn(u)
end 'copyArray'

// copyString is a new string with the same length and bytes, unless the string is in the executable: that one is never
// freed and never changes, so its copy is itself.
function copyString(mutates u CodeUnit)
	let immortal = u.asm.newLabel()
	routinePrologue(u, locals: 1)
	jumpIfImmortal(u, target: immortal)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rax, base: rcx, disp: stringLengthOffset)
	u.asm.addImm(rax, imm: wordBytes)
	callRuntimeWithRax(u, entry: ir.Rt.rtAlloc)
	u.asm.store(rbp, disp: routineLocal0, src: rax)
	u.asm.mov(rdi, src: rax)
	u.asm.load(rsi, base: rbp, disp: routineArg)
	u.asm.load(rcx, base: rsi, disp: stringLengthOffset)
	u.asm.addImm(rcx, imm: wordBytes)
	u.asm.repMovsb()
	u.asm.load(rax, base: rbp, disp: routineLocal0)
	routineReturn(u)
	u.asm.bind(immortal)
	u.asm.load(rax, base: rbp, disp: routineArg)
	routineReturn(u)
end 'copyString'

function copyBytes(mutates u CodeUnit)
	let header = routineLocal0
	let length = routineLocal1
	let buffer = routineLocal2
	let done = u.asm.newLabel()
	routinePrologue(u, locals: 3)
	allocate(u, bytes: arrayHeaderBytes)
	u.asm.store(rbp, disp: header, src: rax)
	u.asm.load(rcx, base: rbp, disp: routineArg)
	u.asm.load(rax, base: rcx, disp: arrayLengthOffset)
	u.asm.store(rbp, disp: length, src: rax)
	u.asm.test(rax, right: rax)
	u.asm.jcc(MCond.equal, label: done)
	callRuntimeWithRax(u, entry: ir.Rt.rtAlloc)
	u.asm.store(rbp, disp: buffer, src: rax)
	u.asm.load(rcx, base: rbp, disp: header)
	u.asm.load(rax, base: rbp, disp: length)
	u.asm.store(rcx, disp: arrayLengthOffset, src: rax)
	u.asm.store(rcx, disp: arrayCapacityOffset, src: rax)
	u.asm.load(rdx, base: rbp, disp: buffer)
	u.asm.store(rcx, disp: arrayDataOffset, src: rdx)
	u.asm.mov(rdi, src: rdx)
	u.asm.load(rsi, base: rbp, disp: routineArg)
	u.asm.load(rsi, base: rsi, disp: arrayDataOffset)
	u.asm.mov(rcx, src: rax)
	u.asm.repMovsb()
	u.asm.bind(done)
	u.asm.load(rax, base: rbp, disp: header)
	routineReturn(u)
end 'copyBytes'
