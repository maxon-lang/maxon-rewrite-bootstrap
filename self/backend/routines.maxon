// A drop or a copy of a value is code that depends on the type of the value: which of the words of a box are boxes
// themselves, and in what layout. It is generated once for each concrete type that a program drops or copies, after
// monomorphization, as a routine of its own that the code of every module calls, so a type that contains itself (a record
// with an array of itself) is a routine that calls itself and not code written out where it is wanted.
//
// A routine is called by the internal convention with one argument, the value, which its prologue stores in its frame,
// and a copy returns the new value in the convention's result register; a String's are two words, its word in the
// second argument and the second result; between calls the routines work in the registers of routine_asm.maxon and
// the other registers every call may leave holding anything, so they keep no callee-saved register. A drop of a value
// that is 0 does nothing, which is how a place that was moved from, or never assigned, is dropped.
//
// The routines are in units of their own, built after the units of the modules, because which of them a program needs is
// known only once every module has been generated. Which they are, and in what order, comes from the modules in source
// order and from each routine's own parts in field order.

// routinesPerUnit is how many routines go into one unit.
let routinesPerUnit = 256

// Frame offsets of the routines below the frame pointer: the argument, and then the locals, a word each, which every
// architecture's access of a word holds.
let routineArg = -8

let routineLocal0 = -16

let routineLocal1 = -24

let routineLocal2 = -32

let routineLocal3 = -40

let routineLocal4 = -48

let routineLocal5 = -56

// A count of owners (of a closure, a frozen value or a cown) is stepped by one locked add, since the owners may be on
// other threads: a new owner adds ownerJoins, one let go of adds ownerLeaves, and the one that found lastOwner there
// ends the box.
let ownerJoins = 1 as FullRangeInt

let ownerLeaves = -1 as FullRangeInt

let lastOwner = 1 as Imm32

export enum RoutineKind
	dropRoutine = 0
	copyRoutine = 1

	export function symbolPrefix() returns String
		return match self 'kind'
			dropRoutine gives "drop"
			copyRoutine gives "copy"
		end 'kind'
	end 'symbolPrefix'
end 'RoutineKind'

// TypeRoutine is the routine that drops or copies a value of one type. Its symbol is the kind and the type's link name, so
// two units that ask for the routine of one type name one routine, whichever compile made them.
export type TypeRoutine
	export var kind as RoutineKind
	export var ty as ast.TypeID
	// symbol is the text the routine is defined and called by.
	export var symbol as String

	export static function make(kind RoutineKind, ty ast.TypeID, consumes symbol String) returns TypeRoutine
		return TypeRoutine{kind: kind, ty: ty, symbol: symbol}
	end 'make'
end 'TypeRoutine'

export typealias TypeRoutineList = Array with TypeRoutine

typealias RoutineSymbols = table.IntMap with String

// routineSymbol is the symbol of the routine of a kind for the type with a link name. It starts with the kind and a space,
// which no function's link name does, so no routine is named like a function.
function routineSymbol(kind RoutineKind, typeLinkName String) returns String
	return "{kind.symbolPrefix()} {typeLinkName}"
end 'routineSymbol'

// RoutineSet is the routines a body of code asks for, each once, in the order they were first asked for. The name of a
// routine is made once for each type.
export type RoutineSet
	export var list as TypeRoutineList
	var dropSymbols as RoutineSymbols
	var copySymbols as RoutineSymbols

	export static function new() returns RoutineSet
		return RoutineSet{list: TypeRoutineList.create(0), dropSymbols: RoutineSymbols.new(), copySymbols: RoutineSymbols.new()}
	end 'new'

	function known(kind RoutineKind, ty ast.TypeID) returns table.Option with String
		if kind == RoutineKind.dropRoutine 'drop'
			return dropSymbols.get(ty as Count)
		end 'drop'
		return copySymbols.get(ty as Count)
	end 'known'

	function remember(mutates self, kind RoutineKind, ty ast.TypeID, symbol String)
		if kind == RoutineKind.dropRoutine 'drop'
			dropSymbols.insert(ty as Count, value: symbol.clone())
		end 'drop' else 'copy'
			copySymbols.insert(ty as Count, value: symbol.clone())
		end 'copy'
	end 'remember'

	// lookup is the symbol of a routine that symbol has been asked for already.
	export function lookup(kind RoutineKind, ty ast.TypeID) returns String
		match self.known(kind, ty: ty) 'hit'
			some(name) then return name.clone()
			none then panic("backend: the routine of a type was not asked for before its code")
		end 'hit'
	end 'lookup'

	// symbol is the name of the code that drops or copies a value of a type, and notes that the code asks for it. A drop of a
	// box that holds nothing to drop is the free itself, with no routine of its own.
	export function symbol(mutates self, p ast.Project, mutates ms ast.ModuleState, kind RoutineKind, ty ast.TypeID) returns String
		match self.known(kind, ty: ty) 'hit'
			some(name) then return name.clone()
			none then _ = 0
		end 'hit'
		if kind == RoutineKind.dropRoutine and onlyFrees(p, ms: ms, ty: ty) 'frees'
			let free = ir.rtSymbol(ir.Rt.rtFree)
			self.remember(kind, ty: ty, symbol: free)
			return free
		end 'frees'
		let name = routineSymbol(kind, typeLinkName: ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: ty))
		self.remember(kind, ty: ty, symbol: name)
		list.push(TypeRoutine.make(kind, ty: ty, symbol: name.clone()))
		return name
	end 'symbol'
end 'RoutineSet'

function fieldCount(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).fields.count()
end 'fieldCount'

function caseCount(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).cases.count()
end 'caseCount'

function payloadCount(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count) returns Count
	return ast.typeEntry(tt, reads: reads, t: ast.originOf(tt, reads: reads, t: owner)).cases[caseIndex].payload.count()
end 'payloadCount'

// elementType is the type of what an array holds.
function elementType(tt ast.TypeSlot, reads ast.TypeTable, array ast.TypeID) returns ast.TypeID
	return ast.typeEntry(tt, reads: reads, t: array).typeArgs[0]
end 'elementType'

function anyManagedPayload(mutates tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID, caseIndex Count) returns bool
	for j in 0 upto payloadCount(tt, reads: reads, owner: owner, caseIndex: caseIndex) 'each'
		let payloadTy = ast.payloadType(tt, reads: reads, owner: owner, caseIndex: caseIndex, index: j)
		if ast.isManagedType(tt, reads: reads, t: payloadTy) 'managed'
			return true
		end 'managed'
	end 'each'
	return false
end 'anyManagedPayload'

// onlyFrees is whether dropping a value of the type is freeing its box and nothing else: a record with no managed field,
// or a union that has no managed payload in any case.
function onlyFrees(p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID) returns bool
	let kind = ast.typeKind(ms.types, reads: p.types, t: ty)
	if kind == ast.TypeKind.record 'record'
		for i in 0 upto fieldCount(ms.types, reads: p.types, owner: ty) 'fields'
			let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: ty, index: i)
			if ast.isManagedType(ms.types, reads: p.types, t: fieldTy) 'managed'
				return false
			end 'managed'
		end 'fields'
		return true
	end 'record'
	if kind == ast.TypeKind.unionTy 'union'
		for i in 0 upto caseCount(ms.types, reads: p.types, owner: ty) 'cases'
			if anyManagedPayload(ms.types, reads: p.types, owner: ty, caseIndex: i) 'managed'
				return false
			end 'managed'
		end 'cases'
		return true
	end 'union'
	return false
end 'onlyFrees'

// addNew appends to list the routines that are not known yet, and notes them.
function addNew(mutates known StringOffsets, consumes list TypeRoutineList, routines TypeRoutineList) returns TypeRoutineList
	var out = list
	for i in 0 upto routines.count() 'each'
		if not known.has(routines[i].symbol) 'new'
			known.insert(routines[i].symbol.clone(), value: 0 as Count)
			out.push(routines[i].clone())
		end 'new'
	end 'each'
	return out
end 'addNew'

// emitTypeRoutines is the units with the drop and copy routine of every type that the units ask for, and of every type
// those routines reach. A routine asks for the routines of the parts of its type, so they are made in waves: the ones the
// modules ask for, then the ones those ask for that are not made yet, and so on, each wave in the order the routines were
// first asked for.
export function emitTypeRoutines(p ast.Project, mutates ms ast.ModuleState, units LinkUnits) returns UnitList
	var known = StringOffsets.new()
	var pending = TypeRoutineList.create(0)
	for i in 0 upto units.count() 'units'
		pending = addNew(known, list: pending, routines: units.at(i).needed.list)
	end 'units'
	var made = UnitList.create(0)
	while pending.count() > 0 'waves'
		var wave = UnitList.create(0)
		var start = 0 as Count
		while start < pending.count() 'chunks'
			var stop = try start + routinesPerUnit otherwise pending.count()
			if stop > pending.count() 'clamp'
				stop = pending.count()
			end 'clamp'
			var chunk = TypeRoutineList.create(0)
			for i in start upto stop 'slice'
				chunk.push(pending[i].clone())
			end 'slice'
			wave.push(emitRoutines(p, ms: ms, routines: chunk))
			start = stop
		end 'chunks'
		var next = TypeRoutineList.create(0)
		for i in 0 upto wave.count() 'asked'
			next = addNew(known, list: next, routines: wave[i].needed.list)
		end 'asked'
		for i in 0 upto wave.count() 'collect'
			made.push(exchange(wave[i], value: CodeUnit.new()))
		end 'collect'
		pending = next
	end 'waves'
	return made
end 'emitTypeRoutines'

// carryRoutines makes, in the unit u of a module, the drop and copy routine of every type its code asks for, and of every type
// those reach, and leaves it asking for none: a unit is then all the link needs of its module, so a unit that a build cache
// kept links as the one its emit made, whatever the compile it links in knows of the module's types. Every unit that asks for
// a routine defines it, and the link keeps one, as it does of an instance.
export function carryRoutines(p ast.Project, mutates ms ast.ModuleState, mutates u CodeUnit)
	let a = p.target.arch
	var i = 0 as Count
	while i < u.needed.list.count() 'routines'
		let routine = u.needed.list[i].clone()
		emitRoutine(u, a: a, p: p, ms: ms, routine: routine)
		i = try i + 1 otherwise panic("backend: more routines than memory")
	end 'routines'
	u.needed = RoutineSet.new()
end 'carryRoutines'

function emitRoutines(p ast.Project, mutates ms ast.ModuleState, routines TypeRoutineList) returns CodeUnit
	let a = p.target.arch
	var u = CodeUnit.new()
	for i in 0 upto routines.count() 'each'
		emitRoutine(u, a: a, p: p, ms: ms, routine: routines[i])
	end 'each'
	return u
end 'emitRoutines'

// routineCall calls the routine of a type with the value in the work register, and leaves a copy's result there. A routine that has
// not been asked for yet is queued.
function routineCall(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, kind RoutineKind, ty ast.TypeID)
	let symbol = u.needed.symbol(p, ms: ms, kind: kind, ty: ty)
	rMov(u, a: a, dst: rArg, src: rWork)
	rCallSymbol(u, a: a, symbol: symbol)
	takeResult(u, a: a)
end 'routineCall'

// callRuntimeWithWork calls an entry of the runtime with the value in the work register as its one argument, and leaves its
// result there.
function callRuntimeWithWork(mutates u CodeUnit, a ast.TargetArch, entry ir.Rt)
	rMov(u, a: a, dst: rArg, src: rWork)
	rCallSymbol(u, a: a, symbol: ir.rtSymbol(entry))
	takeResult(u, a: a)
end 'callRuntimeWithWork'

// takeResult moves what a call returned into the work register.
function takeResult(mutates u CodeUnit, a ast.TargetArch)
	rMov(u, a: a, dst: rWork, src: rResult)
end 'takeResult'

// routinePrologue starts a routine that keeps its argument and a number of words of its own below the frame pointer. A
// routine is called once for each level of a nested value, so a tree that is deep enough would use up the stack: a
// routine reserves only what it uses.
function routinePrologue(mutates u CodeUnit, a ast.TargetArch, locals Count)
	rPrologue(u, a: a, words: try locals + 1 otherwise panic("a routine with locals past memory"))
end 'routinePrologue'

function routineEpilogue(mutates u CodeUnit, a ast.TargetArch)
	rEpilogue(u, a: a)
end 'routineEpilogue'

// routineReturn ends a copy routine, which returns the new value that the work register holds.
function routineReturn(mutates u CodeUnit, a ast.TargetArch)
	rMov(u, a: a, dst: rResult, src: rWork)
	routineEpilogue(u, a: a)
end 'routineReturn'

// freeArgument gives back the box that the routine's argument is.
function freeArgument(mutates u CodeUnit, a ast.TargetArch)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtFree)
end 'freeArgument'

// allocate calls the allocator for a box of a size, leaving it in the work register.
function allocate(mutates u CodeUnit, a ast.TargetArch, bytes Count)
	rMovImm(u, a: a, dst: rWork, imm: try bytes as FullRangeInt otherwise panic("a box past memory"))
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAlloc)
end 'allocate'

// emitRoutine emits the code of one routine.
function emitRoutine(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, routine TypeRoutine)
	u.beginSection()
	u.defineFunction(routine.symbol, instance: true)
	if routine.kind == RoutineKind.dropRoutine 'drop'
		emitDrop(u, a: a, p: p, ms: ms, ty: routine.ty)
	end 'drop' else 'copy'
		emitCopy(u, a: a, p: p, ms: ms, ty: routine.ty)
	end 'copy'
end 'emitRoutine'

function emitDrop(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let kind = ast.typeKind(ms.types, reads: p.types, t: ty)
	if kind == ast.TypeKind.primString 'string'
		dropString(u, a: a, checks: p.checksStrings)
		return
	end 'string'
	if kind == ast.TypeKind.record 'record'
		dropRecord(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'record'
	if kind == ast.TypeKind.unionTy 'union'
		dropUnion(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'union'
	if kind == ast.TypeKind.builtinArray 'array'
		if ast.packsBytes(ms.types, reads: p.types, b: p.builtins, t: ty) 'bytes'
			dropBytes(u, a: a)
			return
		end 'bytes'
		dropArray(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'array'
	if kind == ast.TypeKind.builtinGroups 'groups'
		dropArray(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'groups'
	if kind == ast.TypeKind.funcTy 'function'
		dropClosure(u, a: a)
		return
	end 'function'
	if kind == ast.TypeKind.interfaceTy 'interface'
		dropInterfaceValue(u, a: a)
		return
	end 'interface'
	if kind == ast.TypeKind.builtinFrozen 'frozen'
		dropFrozen(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'frozen'
	if kind == ast.TypeKind.builtinCown or kind == ast.TypeKind.builtinService 'cown'
		dropCown(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'cown'
	if kind == ast.TypeKind.builtinCursor 'cursor'
		dropCursor(u, a: a)
		return
	end 'cursor'
	if kind == ast.TypeKind.builtinPromise 'promise'
		dropPromise(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'promise'
	panic("routines: no drop routine for {ast.typeName(ms.types, reads: p.types, t: ty)}, which the driver should have refused")
end 'emitDrop'

function emitCopy(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let kind = ast.typeKind(ms.types, reads: p.types, t: ty)
	if kind == ast.TypeKind.primString 'string'
		copyString(u, a: a, checks: p.checksStrings)
		return
	end 'string'
	if kind == ast.TypeKind.record 'record'
		copyRecord(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'record'
	if kind == ast.TypeKind.unionTy 'union'
		copyUnion(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'union'
	if kind == ast.TypeKind.builtinArray 'array'
		if ast.packsBytes(ms.types, reads: p.types, b: p.builtins, t: ty) 'bytes'
			copyBytes(u, a: a)
			return
		end 'bytes'
		copyArray(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'array'
	if kind == ast.TypeKind.builtinGroups 'groups'
		copyArray(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'groups'
	if kind == ast.TypeKind.funcTy 'function'
		copyShared(u, a: a, countOffset: closureCountOffset)
		return
	end 'function'
	if kind == ast.TypeKind.interfaceTy 'interface'
		copyInterfaceValue(u, a: a)
		return
	end 'interface'
	if kind == ast.TypeKind.builtinFrozen 'frozen'
		copyShared(u, a: a, countOffset: frozenCountOffset)
		return
	end 'frozen'
	if kind == ast.TypeKind.builtinCown or kind == ast.TypeKind.builtinService 'cown'
		copyShared(u, a: a, countOffset: cownCountOffset)
		return
	end 'cown'
	if kind == ast.TypeKind.builtinCursor 'cursor'
		copyCursor(u, a: a, p: p, ms: ms, ty: ty)
		return
	end 'cursor'
	panic("routines: no copy routine for {ast.typeName(ms.types, reads: p.types, t: ty)}, which the driver should have refused")
end 'emitCopy'

// dropPromise is the drop of a promise, which cancels it as `p.cancel()` does: the coroutine is marked, so it does not
// start or its sleeps end at once, it is waited for, and what its function gave, a value or an error, is dropped. The
// ownership pass drops no promise a program holds (E3213), so this meets the empty place an await leaves, and a promise
// that a coroutine cancelled before it started was given to own.
function dropPromise(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 2)
	returnIfEmpty(u, a: a, done: done)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAsyncCancel)
	let result = ast.promiseResult(ms.types, reads: p.types, t: ty)
	let errTy = ast.promiseError(ms.types, reads: p.types, t: ty)
	let managed = ast.isManagedType(ms.types, reads: p.types, t: result)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
	if errTy == ast.noType 'plain'
		callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAsyncAwait)
		if managed 'value'
			dropResult(u, a: a, p: p, ms: ms, ty: result)
		end 'value'
	end 'plain' else 'throws'
		callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAsyncWait)
		rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
		callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAsyncError)
		rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
		rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
		callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAsyncTake)
		let returned = u.asm.newLabel()
		rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
		rTest(u, a: a, left: rSecond, right: rSecond)
		rBranch(u, a: a, cond: MCond.equal, label: returned)
		if ast.isUnionError(ms.types, reads: p.types, t: errTy) 'unionError'
			rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
			routineCall(u, a: a, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: errTy)
		end 'unionError'
		rJump(u, a: a, label: done)
		u.asm.bind(returned)
		if managed 'value'
			dropResult(u, a: a, p: p, ms: ms, ty: result)
		end 'value'
	end 'throws'
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropPromise'

// returnIfEmpty is the start of a drop: a value that is 0 holds nothing.
function returnIfEmpty(mutates u CodeUnit, a ast.TargetArch, done LabelID)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: done)
end 'returnIfEmpty'

// dropWord drops the managed value at an offset of the box that the argument is: a word, or a String's two.
function dropWord(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, offset Count, ty ast.TypeID)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
	dropValueAt(u, a: a, p: p, ms: ms, base: rWork, offset: offset, ty: ty)
end 'dropWord'

// wordOf is where the word of a String lies when the String is at offset.
function wordOf(offset Count) returns Count
	return try offset + stringWordOffset otherwise panic("routines: a String past memory")
end 'wordOf'

// dropValueAt drops the managed value at an offset of the address in base, which may be rWork or rSecond.
function dropValueAt(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, base RoutineReg, offset Count, ty ast.TypeID)
	if ast.isStringType(ms.types, reads: p.types, t: ty) 'string'
		let symbol = u.needed.symbol(p, ms: ms, kind: RoutineKind.dropRoutine, ty: ty)
		rMov(u, a: a, dst: rCopyFrom, src: base)
		rLoad(u, a: a, dst: rArgWord, base: rCopyFrom, disp: imm32Of(wordOf(offset)))
		rLoad(u, a: a, dst: rArg, base: rCopyFrom, disp: imm32Of(offset))
		rCallSymbol(u, a: a, symbol: symbol)
		return
	end 'string'
	rLoad(u, a: a, dst: rWork, base: base, disp: imm32Of(offset))
	routineCall(u, a: a, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: ty)
end 'dropValueAt'

// copyValueInto copies the value at an offset of the address in rSecond, by the routine of its type where it is managed,
// and leaves the copy in rWork, and a String's word in rResultWord.
function copyValueInto(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, offset Count, ty ast.TypeID)
	if ast.isStringType(ms.types, reads: p.types, t: ty) 'string'
		let symbol = u.needed.symbol(p, ms: ms, kind: RoutineKind.copyRoutine, ty: ty)
		rMov(u, a: a, dst: rCopyFrom, src: rSecond)
		rLoad(u, a: a, dst: rArgWord, base: rCopyFrom, disp: imm32Of(wordOf(offset)))
		rLoad(u, a: a, dst: rArg, base: rCopyFrom, disp: imm32Of(offset))
		rCallSymbol(u, a: a, symbol: symbol)
		takeResult(u, a: a)
		return
	end 'string'
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: imm32Of(offset))
	if ast.isManagedType(ms.types, reads: p.types, t: ty) 'managed'
		routineCall(u, a: a, p: p, ms: ms, kind: RoutineKind.copyRoutine, ty: ty)
	end 'managed'
end 'copyValueInto'

// storeCopy stores the copy copyValueInto left at an offset of the address in rSecond.
function storeCopy(mutates u CodeUnit, a ast.TargetArch, p ast.Project, ms ast.ModuleState, offset Count, ty ast.TypeID)
	rStore(u, a: a, base: rSecond, disp: imm32Of(offset), src: rWork)
	if ast.isStringType(ms.types, reads: p.types, t: ty) 'string'
		rStore(u, a: a, base: rSecond, disp: imm32Of(wordOf(offset)), src: rResultWord)
	end 'string'
end 'storeCopy'

function dropRecord(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 0)
	returnIfEmpty(u, a: a, done: done)
	// Each promise a field holds is cancelled before the drop of any of them waits, as an array's are (cancelElements).
	for i in 0 upto fieldCount(ms.types, reads: p.types, owner: ty) 'promises'
		let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: ty, index: i)
		if ast.isPromiseType(ms.types, reads: p.types, t: fieldTy) 'promise'
			let skip = u.asm.newLabel()
			rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
			rLoad(u, a: a, dst: rWork, base: rSecond, disp: imm32Of(ir.recordFieldOffset(ms.types, reads: p.types, owner: ty, index: i)))
			rTest(u, a: a, left: rWork, right: rWork)
			rBranch(u, a: a, cond: MCond.equal, label: skip)
			callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAsyncCancel)
			u.asm.bind(skip)
		end 'promise'
	end 'promises'
	for i in 0 upto fieldCount(ms.types, reads: p.types, owner: ty) 'fields'
		let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: ty, index: i)
		if ast.isManagedType(ms.types, reads: p.types, t: fieldTy) 'managed'
			let offset = ir.recordFieldOffset(ms.types, reads: p.types, owner: ty, index: i)
			dropWord(u, a: a, p: p, ms: ms, offset: offset, ty: fieldTy)
		end 'managed'
	end 'fields'
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropRecord'

// dropCursor frees the box of a cursor (ir.cursorWords), which borrows what it walks and owns nothing else.
function dropCursor(mutates u CodeUnit, a ast.TargetArch)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 0)
	returnIfEmpty(u, a: a, done: done)
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropCursor'

// copyCursor is a new cursor of the type ty at the same element of what the cursor walks, which the copy borrows as well:
// every word is copied as it is, the borrowed ones too.
function copyCursor(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let words = ir.cursorWords(p, ms: ms, t: ty)
	routinePrologue(u, a: a, locals: 1)
	allocate(u, a: a, bytes: ir.boxBytes(words, tagged: false))
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
	for i in 0 upto words 'words'
		copyWord(u, a: a, p: p, ms: ms, offset: ir.fieldOffset(i, tagged: false), ty: p.builtins.countTy)
	end 'words'
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
	routineReturn(u, a: a)
end 'copyCursor'

// dropUnion drops the payload of the case the box holds, and then the box.
function dropUnion(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	let release = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 0)
	returnIfEmpty(u, a: a, done: done)
	for i in 0 upto caseCount(ms.types, reads: p.types, owner: ty) 'cases'
		if not anyManagedPayload(ms.types, reads: p.types, owner: ty, caseIndex: i) 'plain'
			continue 'cases'
		end 'plain'
		let next = u.asm.newLabel()
		rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
		rLoad(u, a: a, dst: rWork, base: rWork, disp: imm32Of(ir.tagOffset))
		rCmpImm(u, a: a, left: rWork, imm: imm32Of(i))
		rBranch(u, a: a, cond: MCond.notEqual, label: next)
		for j in 0 upto payloadCount(ms.types, reads: p.types, owner: ty, caseIndex: i) 'payload'
			let payloadTy = ast.payloadType(ms.types, reads: p.types, owner: ty, caseIndex: i, index: j)
			if ast.isManagedType(ms.types, reads: p.types, t: payloadTy) 'managed'
				let offset = ir.payloadOffset(ms.types, reads: p.types, owner: ty, caseIndex: i, index: j)
				dropWord(u, a: a, p: p, ms: ms, offset: offset, ty: payloadTy)
			end 'managed'
		end 'payload'
		rJump(u, a: a, label: release)
		u.asm.bind(next)
	end 'cases'
	u.asm.bind(release)
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropUnion'

// wordColumns are the types of the words of an array box's buffer, which repeat in that order: an array's element, or a
// group of a buffer of groups, its control word and the two halves of each of its pairs (ir/groups.maxon).
function wordColumns(p ast.Project, tt ast.TypeSlot, reads ast.TypeTable, ty ast.TypeID) returns ast.TypeIDList
	var columns = ast.TypeIDList.create(0)
	if ast.typeKind(tt, reads: reads, t: ty) == ast.TypeKind.builtinGroups 'groups'
		columns.push(p.builtins.countTy)
		for i in 0 upto ir.groupPairs as Count 'pairs'
			columns.push(ast.typeEntry(tt, reads: reads, t: ty).typeArgs[0])
			columns.push(ast.typeEntry(tt, reads: reads, t: ty).typeArgs[1])
		end 'pairs'
		return columns
	end 'groups'
	columns.push(elementType(tt, reads: reads, array: ty))
	return columns
end 'wordColumns'

function anyManagedColumn(tt ast.TypeSlot, reads ast.TypeTable, columns ast.TypeIDList) returns bool
	for j in 0 upto columns.count() 'each'
		if ast.isManagedType(tt, reads: reads, t: columns[j]) 'managed'
			return true
		end 'managed'
	end 'each'
	return false
end 'anyManagedColumn'

// wordAddress leaves in second the address of the word at an offset in words from the index the local at indexDisp holds,
// in the buffer of the array box at boxDisp.
function wordAddress(mutates u CodeUnit, a ast.TargetArch, boxDisp Imm32, indexDisp Imm32, offset Count)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: boxDisp)
	rLoad(u, a: a, dst: rSecond, base: rSecond, disp: arrayDataOffset)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: indexDisp)
	rMovImm(u, a: a, dst: rThird, imm: wordBytes)
	rMul(u, a: a, dst: rWork, src: rThird)
	rAdd(u, a: a, dst: rSecond, src: rWork)
	if offset != 0 'offset'
		rAddImm(u, a: a, dst: rSecond, imm: imm32Of(try offset * wordBytes otherwise panic("a column past memory")))
	end 'offset'
end 'wordAddress'

// columnStarts is the word each column of an array box's buffer starts at in its element or group, a String's two words
// apart, and then the number of words of an element or a group.
function columnStarts(tt ast.TypeSlot, reads ast.TypeTable, columns ast.TypeIDList) returns CountList
	var starts = CountList.create(0)
	var word = 0 as Count
	for j in 0 upto columns.count() 'columns'
		starts.push(word)
		word = try word + ir.valueWords(tt, reads: reads, t: columns[j]) otherwise panic("routines: an element past memory")
	end 'columns'
	starts.push(word)
	return starts
end 'columnStarts'

// lengthWords is how many words of the buffer one of an array box's length counts: an element's, or one for a buffer of
// groups, whose length counts words.
function lengthWords(tt ast.TypeSlot, reads ast.TypeTable, ty ast.TypeID, stride Count) returns Count
	if ast.typeKind(tt, reads: reads, t: ty) == ast.TypeKind.builtinGroups 'groups'
		return 1
	end 'groups'
	return stride
end 'lengthWords'

// loadWordsLimit leaves in rThird the number of words of the buffer of the array box that the argument is.
function loadWordsLimit(mutates u CodeUnit, a ast.TargetArch, perLength Count)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rThird, base: rSecond, disp: arrayLengthOffset)
	if perLength != 1 'scaled'
		rMovImm(u, a: a, dst: rWork, imm: try perLength as FullRangeInt otherwise panic("routines: an element past memory"))
		rMul(u, a: a, dst: rThird, src: rWork)
	end 'scaled'
end 'loadWordsLimit'

// dropArray drops each element of an array, or each word of a buffer of groups, by its type, and then the
// buffer and the header.
function dropArray(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 1)
	returnIfEmpty(u, a: a, done: done)
	let columns = wordColumns(p, tt: ms.types, reads: p.types, ty: ty)
	let starts = columnStarts(ms.types, reads: p.types, columns: columns)
	let stride = starts[columns.count()]
	if columns.count() == 1 and ast.isPromiseType(ms.types, reads: p.types, t: columns[0]) 'promises'
		cancelElements(u, a: a)
	end 'promises'
	if anyManagedColumn(ms.types, reads: p.types, columns: columns) 'managed'
		let top = u.asm.newLabel()
		let out = u.asm.newLabel()
		rZero(u, a: a, dst: rWork)
		rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
		u.asm.bind(top)
		loadWordsLimit(u, a: a, perLength: lengthWords(ms.types, reads: p.types, ty: ty, stride: stride))
		rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
		rCmp(u, a: a, left: rWork, right: rThird)
		rBranch(u, a: a, cond: MCond.aboveEqual, label: out)
		for j in 0 upto columns.count() 'columns'
			if ast.isManagedType(ms.types, reads: p.types, t: columns[j]) 'owning'
				wordAddress(u, a: a, boxDisp: routineArg, indexDisp: routineLocal0, offset: starts[j])
				dropValueAt(u, a: a, p: p, ms: ms, base: rSecond, offset: 0, ty: columns[j])
			end 'owning'
		end 'columns'
		rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
		rAddImm(u, a: a, dst: rWork, imm: imm32Of(stride))
		rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
		rJump(u, a: a, label: top)
		u.asm.bind(out)
	end 'managed'
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: arrayDataOffset)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtFree)
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropArray'

// cancelElements cancels each promise an array holds, its address in the routine's argument, before the drop of any of
// them waits for its coroutine: a coroutine that has not started then never starts, where the wait for one before it
// would otherwise let it run. An element that a take left empty is skipped.
function cancelElements(mutates u CodeUnit, a ast.TargetArch)
	let top = u.asm.newLabel()
	let next = u.asm.newLabel()
	let out = u.asm.newLabel()
	rZero(u, a: a, dst: rWork)
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
	u.asm.bind(top)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rThird, base: rSecond, disp: arrayLengthOffset)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
	rCmp(u, a: a, left: rWork, right: rThird)
	rBranch(u, a: a, cond: MCond.aboveEqual, label: out)
	rLoad(u, a: a, dst: rSecond, base: rSecond, disp: arrayDataOffset)
	rMovImm(u, a: a, dst: rThird, imm: wordBytes)
	rMul(u, a: a, dst: rWork, src: rThird)
	rAdd(u, a: a, dst: rSecond, src: rWork)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: 0)
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: next)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAsyncCancel)
	u.asm.bind(next)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
	rAddImm(u, a: a, dst: rWork, imm: 1)
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
	rJump(u, a: a, label: top)
	u.asm.bind(out)
end 'cancelElements'

// dropClosure lets go of one of the function values that share a closure: the last one drops what the closure owns, by the
// routine the closure holds, and frees the box.
function dropClosure(mutates u CodeUnit, a ast.TargetArch)
	let done = u.asm.newLabel()
	let release = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 0)
	returnIfEmpty(u, a: a, done: done)
	leaveUnlessLast(u, a: a, countOffset: closureCountOffset, done: done)
	rLoad(u, a: a, dst: rArg, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rWork, base: rArg, disp: imm32Of(closureDropOffset))
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: release)
	rCallRegister(u, a: a, reg: rWork)
	u.asm.bind(release)
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropClosure'

// leaveUnlessLast lets go of one owner of the box that the argument is, and jumps to done unless it was the last.
function leaveUnlessLast(mutates u CodeUnit, a ast.TargetArch, countOffset Count, done LabelID)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rMovImm(u, a: a, dst: rWork, imm: ownerLeaves)
	rLockAdd(u, a: a, base: rSecond, disp: imm32Of(countOffset), src: rWork)
	rCmpImm(u, a: a, left: rWork, imm: lastOwner)
	rBranch(u, a: a, cond: MCond.notEqual, label: done)
end 'leaveUnlessLast'

// heldType is the type of what a frozen value or a cown holds.
function heldType(tt ast.TypeSlot, reads ast.TypeTable, owner ast.TypeID) returns ast.TypeID
	return ast.typeEntry(tt, reads: reads, t: owner).typeArgs[0]
end 'heldType'

// keepHeld keeps the two words of the value of the box in rSecond at offset in the first two locals: a String's, or a word
// and the 0 after it.
function keepHeld(mutates u CodeUnit, a ast.TargetArch, offset Count)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: imm32Of(offset))
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: imm32Of(wordOf(offset)))
	rStore(u, a: a, base: rFrame, disp: routineLocal1, src: rWork)
end 'keepHeld'

// dropKept drops the value of type ty that keepHeld kept.
function dropKept(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let symbol = u.needed.symbol(p, ms: ms, kind: RoutineKind.dropRoutine, ty: ty)
	rLoad(u, a: a, dst: rArgWord, base: rFrame, disp: routineLocal1)
	rLoad(u, a: a, dst: rArg, base: rFrame, disp: routineLocal0)
	rCallSymbol(u, a: a, symbol: symbol)
end 'dropKept'

// dropFrozen lets go of one owner of a frozen value: the last frees the box and then drops what it held, in the order
// the interpreter frees them.
function dropFrozen(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 2)
	returnIfEmpty(u, a: a, done: done)
	leaveUnlessLast(u, a: a, countOffset: frozenCountOffset, done: done)
	keepHeld(u, a: a, offset: frozenValueOffset)
	freeArgument(u, a: a)
	let held = heldType(ms.types, reads: p.types, owner: ty)
	if ast.isManagedType(ms.types, reads: p.types, t: held) 'managed'
		dropKept(u, a: a, p: p, ms: ms, ty: held)
	end 'managed'
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropFrozen'

// dropCown lets go of one owner of a cown: the last frees the cown and then ends its value, with the destructor it was
// made with or else by the drop of the value's type, in the order the interpreter frees them. A destructor is given only
// a value that is there.
function dropCown(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	let dropped = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 3)
	returnIfEmpty(u, a: a, done: done)
	leaveUnlessLast(u, a: a, countOffset: cownCountOffset, done: done)
	keepHeld(u, a: a, offset: cownValueOffset)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: imm32Of(cownEndingOffset))
	rStore(u, a: a, base: rFrame, disp: routineLocal2, src: rWork)
	freeArgument(u, a: a)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal2)
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: dropped)
	rLoad(u, a: a, dst: rArgWord, base: rFrame, disp: routineLocal1)
	rLoad(u, a: a, dst: rArg, base: rFrame, disp: routineLocal0)
	rTest(u, a: a, left: rArg, right: rArg)
	rBranch(u, a: a, cond: MCond.equal, label: done)
	rCallRegister(u, a: a, reg: rWork)
	rJump(u, a: a, label: done)
	u.asm.bind(dropped)
	let held = heldType(ms.types, reads: p.types, owner: ty)
	if ast.isManagedType(ms.types, reads: p.types, t: held) 'managed'
		dropKept(u, a: a, p: p, ms: ms, ty: held)
	end 'managed'
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropCown'

// tableEntryAddress puts in the work register the address of an entry of the table of the interface value that the second
// register is.
function tableEntryAddress(mutates u CodeUnit, a ast.TargetArch, entry Count)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: imm32Of(ifaceTableOffset))
	rAddImm(u, a: a, dst: rWork, imm: imm32Of(try entry * tableEntrySize(a) otherwise panic("routines: a table past memory")))
end 'tableEntryAddress'

// passBoxedValue puts in the work register the address of an entry of the table of the interface value that the second
// register is, and in the argument registers the value its box holds: a String's word in the second, which the routines
// of every other type ignore.
function passBoxedValue(mutates u CodeUnit, a ast.TargetArch, entry Count)
	tableEntryAddress(u, a: a, entry: entry)
	rLoad(u, a: a, dst: rCopyTo, base: rSecond, disp: imm32Of(ifaceWordOffset))
	rLoad(u, a: a, dst: rThird, base: rSecond, disp: imm32Of(ifaceValueOffset))
	rMov(u, a: a, dst: rArg, src: rThird)
	rMov(u, a: a, dst: rArgWord, src: rCopyTo)
end 'passBoxedValue'

// dropInterfaceValue drops the value the box holds by the entry of its table that drops it, and frees the box. Every
// interface type has this one routine, since the table knows the type of the value.
function dropInterfaceValue(mutates u CodeUnit, a ast.TargetArch)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 0)
	returnIfEmpty(u, a: a, done: done)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	passBoxedValue(u, a: a, entry: tableDropEntry)
	rCallRegister(u, a: a, reg: rWork)
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropInterfaceValue'

// copyInterfaceValue is a new box of the same table and a copy of the value, which the entry of the table that copies it
// makes.
function copyInterfaceValue(mutates u CodeUnit, a ast.TargetArch)
	routinePrologue(u, a: a, locals: 1)
	allocate(u, a: a, bytes: ifaceBoxBytes)
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rThird, base: rSecond, disp: imm32Of(ifaceTableOffset))
	rStore(u, a: a, base: rWork, disp: imm32Of(ifaceTableOffset), src: rThird)
	passBoxedValue(u, a: a, entry: tableCopyEntry)
	rCallRegister(u, a: a, reg: rWork)
	takeResult(u, a: a)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
	rStore(u, a: a, base: rSecond, disp: imm32Of(ifaceValueOffset), src: rWork)
	rStore(u, a: a, base: rSecond, disp: imm32Of(ifaceWordOffset), src: rResultWord)
	rMov(u, a: a, dst: rWork, src: rSecond)
	routineReturn(u, a: a)
end 'copyInterfaceValue'

// emitTable writes the table of an interface value, a section of code of an entry for each of its routines and methods:
// a jump to it, padded to tableEntryBytes. An entry is called as what it jumps to is, so it passes the arguments on as
// they are. Every unit that boxes such a value writes the table, and the link keeps one, as it does an instance. A scalar
// is dropped by nothing and copied as it is, and the copy of a value that no copy of the interface value can reach traps.
// typeNameSymbol is the symbol of the word of data whose address names the type t at run time. It starts with a word and a
// space, as a routine's does, so it names no function.
export function typeNameSymbol(p ast.Project, ms ast.ModuleState, t ast.TypeID) returns String
	return "type {ast.typeLinkNameIn(p, tt: ms.types, reads: p.types, t: t)}"
end 'typeNameSymbol'

export function emitTable(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, t ir.WitnessTable, typeSymbol String)
	let a = p.target.arch
	u.beginSection()
	u.defineFunction(t.symbol, instance: true)
	let managed = ast.isManagedType(ms.types, reads: p.types, t: t.concrete)
	var start = u.asm.pos()
	if managed 'drop'
		let drop = u.needed.symbol(p, ms: ms, kind: RoutineKind.dropRoutine, ty: t.concrete)
		rJumpSymbol(u, a: a, symbol: drop)
	end 'drop' else 'nothing'
		rRet(u, a: a)
	end 'nothing'
	padEntry(u, a: a, start: start)
	start = u.asm.pos()
	if not ast.reachesInterface(ms.types, reads: p.types, have: t.iface, want: p.builtins.copyableTy) 'uncopied'
		rTrap(u, a: a)
	end 'uncopied' else if managed 'copy'
		let copy = u.needed.symbol(p, ms: ms, kind: RoutineKind.copyRoutine, ty: t.concrete)
		rJumpSymbol(u, a: a, symbol: copy)
	end 'copy' else 'same'
		rMov(u, a: a, dst: rResult, src: rArg)
		rRet(u, a: a)
	end 'same'
	padEntry(u, a: a, start: start)
	start = u.asm.pos()
	rAddress(u, a: a, dst: rResult, symbol: typeSymbol)
	rRet(u, a: a)
	padEntry(u, a: a, start: start)
	var receivers = CountList.create(0)
	for i in 0 upto t.methods.count() 'methods'
		start = u.asm.pos()
		if takesStringReceiver(p, ms: ms, fid: t.methods[i]) 'string'
			receivers.push(i)
			rJumpSymbol(u, a: a, symbol: stringReceiverSymbol(t.symbol, index: i))
		end 'string' else 'direct'
			rJumpSymbol(u, a: a, symbol: ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: t.methods[i]))
		end 'direct'
		padEntry(u, a: a, start: start)
	end 'methods'
	for j in 0 upto receivers.count() 'receivers'
		emitStringReceiver(u, p: p, ms: ms, t: t, index: receivers[j])
	end 'receivers'
end 'emitTable'

// takesStringReceiver is whether the method fid takes its receiver as a String's two words, which a call through an
// interface value does not pass as they are.
function takesStringReceiver(p ast.Project, ms ast.ModuleState, fid ast.FuncID) returns bool
	return ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).hasReceiver and ir.isFloatAt(ir.funcSignature(p, ms: ms, fid: fid).strings, place: 0)
end 'takesStringReceiver'

// stringReceiverSymbol is the symbol of the routine through which the entry index of the table of an interface value
// calls a method that takes a String receiver.
function stringReceiverSymbol(table String, index Count) returns String
	return "receiver {index} {table}"
end 'stringReceiverSymbol'

// emitStringReceiver writes the routine through which the entry index of the table t calls its method, which takes its
// receiver as a String's two words. A call through an interface value passes the first word of the value its box holds
// as the receiver, and the second after every other word it passes (emitCallWitness), where a method of any other type
// reads nothing: the routine moves the method's other words up one register, puts the String's word in the second, and
// goes on to the method.
function emitStringReceiver(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, t ir.WitnessTable, index Count)
	let a = p.target.arch
	let fid = t.methods[index]
	let method = ast.funcLinkNameIn(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, fid: fid)
	let last = nextCount(wordsAfterReceiver(p, ms: ms, fid: fid))
	u.beginSection()
	u.defineFunction(stringReceiverSymbol(t.symbol, index: index), instance: true)
	if last >= rWordArgRegisters(a) 'stacked'
		moveReceiverWordThroughFrame(u, p: p, ms: ms, fid: fid)
		rJumpSymbol(u, a: a, symbol: method)
		return
	end 'stacked'
	rRoleOfArg(u, a: a, dst: rThunkBase, index: last)
	var i = last
	while i > 1 'shift'
		i = prevCount(i)
		rArgFrom(u, a: a, index: nextCount(i), from: i)
	end 'shift'
	rArgOfRole(u, a: a, index: 1, src: rThunkBase)
	rJumpSymbol(u, a: a, symbol: method)
end 'emitStringReceiver'

// incomingArgsDisp is where a routine's frame finds the first of the arguments its caller passed on the stack: past the
// frame pointer it saved and the return address.
let incomingArgsDisp = 16

// moveReceiverWordThroughFrame is the move of emitStringReceiver where the words of the method fid pass the registers, so
// that some of those it moves are on the stack: the call passed the receiver's word after every other argument, and the
// method takes it right after the receiver's first word. Both orders place the same arguments, so the caller's stack has
// the room of the method's. Each argument whose place differs is kept in the routine's frame before any is written, and
// then written where the method takes it; a float in a register keeps its place, since the floats keep their order. The
// frame is given back before the jump to the method, which finds its stack arguments where the caller put them.
function moveReceiverWordThroughFrame(mutates u CodeUnit, p ast.Project, ms ast.ModuleState, fid ast.FuncID)
	let a = p.target.arch
	let sig = ir.funcSignature(p, ms: ms, fid: fid)
	let places = addCounts(ast.leadingParams(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid)), b: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).params.count())
	var methodFloats as Array with bool
	methodFloats = Array.create(0)
	for place in 0 upto places 'places'
		methodFloats.push(ir.isFloatAt(sig.args, place: place) and not ir.isFloatAt(sig.strings, place: place))
		if ir.isFloatAt(sig.strings, place: place) 'string'
			methodFloats.push(false)
		end 'string'
	end 'places'
	let count = methodFloats.count()
	var callerFloats as Array with bool
	callerFloats = Array.create(0)
	for k in 0 upto count 'caller'
		callerFloats.push(methodFloats[callerArgOf(k, count: count)])
	end 'caller'
	var methodPlaces = CountList.create(0)
	var callerPlaces = CountList.create(0)
	_ = rPlaceArgs(a, floats: methodFloats, places: methodPlaces)
	_ = rPlaceArgs(a, floats: callerFloats, places: callerPlaces)
	let methodWords = wordIndices(methodFloats, places: methodPlaces, a: a)
	let callerWords = wordIndices(callerFloats, places: callerPlaces, a: a)
	var moved = CountList.create(0)
	for k in 0 upto count 'moves'
		let from = callerArgOf(k, count: count)
		if methodPlaces[k] != callerPlaces[from] 'differs'
			if methodFloats[k] and not rIsStackPlace(a, place: methodPlaces[k]) 'vector'
				panic("routines: a float argument of a String method changes register through an interface value")
			end 'vector'
			moved.push(k)
		end 'differs'
	end 'moves'
	requireThunkScratch(a, count: count)
	routinePrologue(u, a: a, locals: moved.count())
	for i in 0 upto moved.count() 'keep'
		let from = callerArgOf(moved[i], count: count)
		if rIsStackPlace(a, place: callerPlaces[from]) 'stack'
			rLoad(u, a: a, dst: rThunkWord, base: rFrame, disp: incomingArgDisp(a, place: callerPlaces[from]))
		end 'stack' else 'register'
			rRoleOfArg(u, a: a, dst: rThunkWord, index: callerWords[from])
		end 'register'
		rStore(u, a: a, base: rFrame, disp: frameLocal(i), src: rThunkWord)
	end 'keep'
	for i in 0 upto moved.count() 'write'
		let k = moved[i]
		if rIsStackPlace(a, place: methodPlaces[k]) 'stack'
			rLoad(u, a: a, dst: rThunkWord, base: rFrame, disp: frameLocal(i))
			rStore(u, a: a, base: rFrame, disp: incomingArgDisp(a, place: methodPlaces[k]), src: rThunkWord)
		end 'stack' else 'register'
			rLoadArgWord(u, a: a, index: methodWords[k], base: rFrame, disp: frameLocal(i))
		end 'register'
	end 'write'
	rLeaveFrame(u, a: a)
end 'moveReceiverWordThroughFrame'

// callerArgOf is which argument of a call through an interface value, count of them, the method's argument k is: the
// receiver's word, the method's second, is the call's last, and the method's others follow the receiver's first word.
function callerArgOf(k Count, count Count) returns Count
	if k == 0 'first'
		return 0
	end 'first'
	if k == 1 'word'
		return prevCount(count)
	end 'word'
	return prevCount(k)
end 'callerArgOf'

// wordIndices is, for each argument a word register passes, which of the convention's word registers it is, and 0 for
// any other.
function wordIndices(floats Array with bool, places CountList, a ast.TargetArch) returns CountList
	var indices = CountList.create(0)
	var words = 0 as Count
	for i in 0 upto floats.count() 'args'
		if floats[i] or rIsStackPlace(a, place: places[i]) 'other'
			indices.push(0)
		end 'other' else 'word'
			indices.push(words)
			words = nextCount(words)
		end 'word'
	end 'args'
	return indices
end 'wordIndices'

// incomingArgDisp is where a routine's frame finds the argument its caller passed at a place on the stack.
function incomingArgDisp(a ast.TargetArch, place Count) returns Imm32
	return imm32Of(try incomingArgsDisp + rStackSlotOf(a, place: place) * wordBytes otherwise panic("routines: an argument past memory"))
end 'incomingArgDisp'

// frameLocal is where a routine's frame holds its local i.
function frameLocal(i Count) returns Imm32
	let depth = try (i * wordBytes) as Imm32 otherwise panic("routines: a local past memory")
	return try routineLocal0 - depth otherwise panic("routines: a local past memory")
end 'frameLocal'

// wordsAfterReceiver is how many words the method fid takes in general registers past its receiver: a word for each
// parameter, two for a String, none for a float.
function wordsAfterReceiver(p ast.Project, ms ast.ModuleState, fid ast.FuncID) returns Count
	let sig = ir.funcSignature(p, ms: ms, fid: fid)
	let places = addCounts(ast.leadingParams(ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid)), b: ast.funcEntry(ms.funcs, funcReads: p.funcs, f: fid).params.count())
	var words = 0 as Count
	for place in 1 upto places 'places'
		if ir.isFloatAt(sig.strings, place: place) 'string'
			words = addCounts(words, b: stringValueBytes / wordBytes)
		end 'string' else if not ir.isFloatAt(sig.args, place: place) 'word'
			words = nextCount(words)
		end 'word'
	end 'places'
	return words
end 'wordsAfterReceiver'

// padEntry fills an entry of a table that started at start up to tableEntryBytes with returns, which no code
// reaches.
function padEntry(mutates u CodeUnit, a ast.TargetArch, start Count)
	let finish = try start + tableEntrySize(a) otherwise panic("routines: a table past memory")
	if u.asm.pos() > finish 'long'
		panic("routines: an entry of a table is longer than tableEntrySize")
	end 'long'
	while u.asm.pos() < finish 'pad'
		rRet(u, a: a)
	end 'pad'
end 'padEntry'

// copyShared is another owner of a box that its owners share, a closure, a frozen value or a cown: the same box, with its
// count raised by 1.
function copyShared(mutates u CodeUnit, a ast.TargetArch, countOffset Count)
	routinePrologue(u, a: a, locals: 0)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
	rMovImm(u, a: a, dst: rSecond, imm: ownerJoins)
	rLockAdd(u, a: a, base: rWork, disp: imm32Of(countOffset), src: rSecond)
	routineReturn(u, a: a)
end 'copyShared'

// emitCaptureDrop writes the routine that drops what a closure of the body owns, which the last function value that shares
// the closure calls before it frees the box.
export function emitCaptureDrop(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, symbol String, body ir.IrFunction, instance bool)
	let a = p.target.arch
	u.beginSection()
	u.defineFunction(symbol, instance: instance)
	routinePrologue(u, a: a, locals: 0)
	for i in 0 upto body.captureOwned.count() 'captures'
		if body.captureOwned[i] 'owned'
			dropWord(u, a: a, p: p, ms: ms, offset: try closureCapturesOffset + i * closureCaptureBytes otherwise panic("routines: a capture past memory"), ty: body.captureTypes[i])
		end 'owned'
	end 'captures'
	routineEpilogue(u, a: a)
end 'emitCaptureDrop'

// parameterWords is how many words count parameters take, a String's two.
function parameterWords(count Count, strings ir.FloatMask) returns Count
	var words = count
	for i in 0 upto count 'strings'
		if ir.isFloatAt(strings, place: i) 'string'
			words = try words + 1 otherwise panic("routines: parameters past memory")
		end 'string'
	end 'strings'
	return words
end 'parameterWords'

// emitBehaviourThunk writes the thunk that the scheduler runs a behaviour's record with, once the behaviour holds every
// cown it names: it calls the body with the address of each cown's value and then each capture, words in the general
// registers, as a behaviour's body takes them whatever their types, and which the body drops as it drops a consumes
// parameter; has the runtime hand each cown to the behaviour queued after it; drops the behaviour's
// hold on each cown, in source order as the interpreter does, which may end a cown and run its destructor on this
// thread; and frees the record. The scheduler counts the behaviour finished when the thunk returns.
export function emitBehaviourThunk(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, symbol String, body ir.IrFunction, bodySymbol String, instance bool)
	let a = p.target.arch
	let cowns = body.cownTypes.count()
	let start = behaviourWordsOffset(cowns)
	u.beginSection()
	u.defineFunction(symbol, instance: instance)
	routinePrologue(u, a: a, locals: 0)
	let words = parameterWords(body.paramCount, strings: body.stringParams)
	let inRegisters = rInternalArgsInRegisters(a, count: words)
	requireThunkScratch(a, count: words)
	rLoad(u, a: a, dst: rThunkBase, base: rFrame, disp: routineArg)
	let pushed = try words - inRegisters otherwise panic("routines: more arguments in registers than a body takes")
	rOpenArgs(u, a: a, count: pushed)
	var w = words
	while w > inRegisters 'stack'
		w = prevCount(w)
		loadBehaviourWord(u, a: a, start: start, index: w, cowns: cowns)
		rPassArg(u, a: a, slot: try w - inRegisters otherwise panic("routines: a word on the stack below the registers"), src: rThunkWord)
	end 'stack'
	for i in 0 upto inRegisters 'registers'
		loadBehaviourArg(u, a: a, start: start, index: i, cowns: cowns)
	end 'registers'
	rCallSymbol(u, a: a, symbol: bodySymbol)
	rCloseArgs(u, a: a, count: pushed)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtCownRelease)
	for i in 0 upto cowns 'holds'
		rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
		rLoad(u, a: a, dst: rWork, base: rSecond, disp: imm32Of(try start + i * wordBytes otherwise panic("routines: a behaviour past memory")))
		routineCall(u, a: a, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: body.cownTypes[i])
	end 'holds'
	freeArgument(u, a: a)
	routineEpilogue(u, a: a)
end 'emitBehaviourThunk'

// emitAsyncThunk writes the thunk a coroutine runs, which greenMain calls with the coroutine by the internal convention: it
// calls the function an async call starts with the coroutine's argument words, each in the place the convention passes
// its parameter in (a float's bits in a vector register), keeps what the function failed with in the coroutine for the
// await, and gives back what it returned as a word, a float's bits among them. Every unit that starts the function writes
// it, and the link keeps one, as it does an instance.
export function emitAsyncThunk(mutates u CodeUnit, p ast.Project, mutates ms ast.ModuleState, symbol String, callee ast.FuncID, calleeSymbol String)
	let a = p.target.arch
	let params = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).params.count()
	let fails = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).errTy != ast.noType
	let sig = ir.funcSignature(p, ms: ms, fid: callee)
	var floats as Array with bool
	floats = Array.create(0)
	for i in 0 upto params 'floats'
		floats.push(ir.isFloatAt(sig.args, place: i))
		if ir.isFloatAt(sig.strings, place: i) 'string'
			floats.push(false)
		end 'string'
	end 'floats'
	let words = floats.count()
	var places = CountList.create(0)
	let stacked = rPlaceArgs(a, floats: floats, places: places)
	u.beginSection()
	u.defineFunction(symbol, instance: true)
	routinePrologue(u, a: a, locals: 3)
	requireThunkScratch(a, count: words)
	let skip = u.asm.newLabel()
	let join = u.asm.newLabel()
	rLoad(u, a: a, dst: rThunkBase, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rThunkWord, base: rThunkBase, disp: imm32Of(greenCancelOffset))
	rTest(u, a: a, left: rThunkWord, right: rThunkWord)
	rBranch(u, a: a, cond: MCond.notEqual, label: skip)
	rOpenArgs(u, a: a, count: stacked)
	var w = words
	while w > 0 'stack'
		w = prevCount(w)
		if rIsStackPlace(a, place: places[w]) 'pushed'
			rLoad(u, a: a, dst: rThunkWord, base: rThunkBase, disp: coroutineWordDisp(w))
			rPassArg(u, a: a, slot: rStackSlotOf(a, place: places[w]), src: rThunkWord)
		end 'pushed'
	end 'stack'
	for i in 0 upto words 'registers'
		if not rIsStackPlace(a, place: places[i]) 'inRegister'
			rLoadPlace(u, a: a, place: places[i], float: floats[i], base: rThunkBase, disp: coroutineWordDisp(i))
		end 'inRegister'
	end 'registers'
	rCallSymbol(u, a: a, symbol: calleeSymbol)
	rCloseArgs(u, a: a, count: stacked)
	if sig.result 'floatResult'
		rResultFromFloat(u, a: a)
	end 'floatResult'
	if sig.stringResult 'stringResult'
		boxResultString(u, a: a)
	end 'stringResult'
	rJump(u, a: a, label: join)
	u.asm.bind(skip)
	dropOwnedArguments(u, a: a, p: p, ms: ms, callee: callee)
	rMovImm(u, a: a, dst: rResult, imm: 0)
	rMovImm(u, a: a, dst: rError, imm: 0)
	if sig.stringResult 'emptyString'
		rMovImm(u, a: a, dst: rResultWord, imm: 0)
		boxResultString(u, a: a)
	end 'emptyString'
	u.asm.bind(join)
	if fails 'fails'
		rLoad(u, a: a, dst: rThunkBase, base: rFrame, disp: routineArg)
		rStore(u, a: a, base: rThunkBase, disp: imm32Of(greenErrorOffset), src: rError)
	end 'fails'
	routineEpilogue(u, a: a)
end 'emitAsyncThunk'

// boxResultString puts the String a coroutine's function returned in a box of its own, whose address the coroutine keeps as
// the word it gives: a promise holds a word, and the code that takes the value takes the String out of the box.
function boxResultString(mutates u CodeUnit, a ast.TargetArch)
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rResult)
	rStore(u, a: a, base: rFrame, disp: routineLocal1, src: rResultWord)
	rStore(u, a: a, base: rFrame, disp: routineLocal2, src: rError)
	allocate(u, a: a, bytes: stringValueBytes)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
	rStore(u, a: a, base: rWork, disp: imm32Of(stringBytesOffset), src: rSecond)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal1)
	rStore(u, a: a, base: rWork, disp: imm32Of(stringWordOffset), src: rSecond)
	rMov(u, a: a, dst: rResult, src: rWork)
	rLoad(u, a: a, dst: rError, base: rFrame, disp: routineLocal2)
end 'boxResultString'

// dropResult drops what a coroutine gave, which is in the work register: a String in the box it was kept in, or a value.
function dropResult(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	if not ast.isStringType(ms.types, reads: p.types, t: ty) 'value'
		routineCall(u, a: a, p: p, ms: ms, kind: RoutineKind.dropRoutine, ty: ty)
		return
	end 'value'
	let none = u.asm.newLabel()
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: none)
	rStore(u, a: a, base: rFrame, disp: routineLocal1, src: rWork)
	dropValueAt(u, a: a, p: p, ms: ms, base: rWork, offset: 0, ty: ty)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal1)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtFree)
	u.asm.bind(none)
end 'dropResult'

// dropOwnedArguments drops, for a coroutine whose promise was cancelled before it started, the arguments its function would
// have owned: what a consumes parameter took. The rest the caller lent, and keeps.
function dropOwnedArguments(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, callee ast.FuncID)
	let params = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).params.count()
	var word = 0 as Count
	for i in 0 upto params 'params'
		let conv = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).params[i].conv
		let ty = ast.funcEntry(ms.funcs, funcReads: p.funcs, f: callee).paramTypes[i]
		if (conv == ast.Convention.convConsumes or conv == ast.Convention.convDestructs) and ast.isManagedType(ms.types, reads: p.types, t: ty) 'owned'
			rLoad(u, a: a, dst: rThunkBase, base: rFrame, disp: routineArg)
			let at = try (greenArgsOffset as Count) + word * wordBytes otherwise panic("routines: a coroutine past memory")
			dropValueAt(u, a: a, p: p, ms: ms, base: rThunkBase, offset: at, ty: ty)
		end 'owned'
		let width = 2 as Count if ast.isStringType(ms.types, reads: p.types, t: ty) and not ast.isByAddress(conv) else 1 as Count
		word = try word + width otherwise panic("routines: a coroutine past memory")
	end 'params'
end 'dropOwnedArguments'

// coroutineWordDisp is where a coroutine holds its argument word at index.
function coroutineWordDisp(index Count) returns Imm32
	if index >= greenArgWords 'past'
		panic("routines: a coroutine has no argument word of that index")
	end 'past'
	return imm32Of(try greenArgsOffset + index * wordBytes otherwise panic("routines: a coroutine past memory"))
end 'coroutineWordDisp'

// loadBehaviourWord loads into thunkWord the word of a behaviour's record, which thunkBase holds, that is the body's
// argument at index, which the body takes on the stack: the address of the value of each cown, and then each capture.
function loadBehaviourWord(mutates u CodeUnit, a ast.TargetArch, start Count, index Count, cowns Count)
	rLoad(u, a: a, dst: rThunkWord, base: rThunkBase, disp: behaviourWordDisp(start, index: index))
	if index < cowns 'cown'
		rAddImm(u, a: a, dst: rThunkWord, imm: imm32Of(cownValueOffset))
	end 'cown'
end 'loadBehaviourWord'

// loadBehaviourArg loads the word of a behaviour's record at index into the register the body takes it in, its word
// argument of the same index.
function loadBehaviourArg(mutates u CodeUnit, a ast.TargetArch, start Count, index Count, cowns Count)
	rLoadArgWord(u, a: a, index: index, base: rThunkBase, disp: behaviourWordDisp(start, index: index))
	if index < cowns 'cown'
		rAddImmArg(u, a: a, index: index, imm: imm32Of(cownValueOffset))
	end 'cown'
end 'loadBehaviourArg'

// behaviourWordDisp is where a behaviour's record holds the word of its body's argument at index.
function behaviourWordDisp(start Count, index Count) returns Imm32
	return imm32Of(try start + index * wordBytes otherwise panic("routines: a behaviour past memory"))
end 'behaviourWordDisp'

// skipUnlessOwned goes to done unless the String whose word is in the first local owns its bytes: a literal's are the
// executable's and a view's another String's, so neither is freed.
function skipUnlessOwned(mutates u CodeUnit, a ast.TargetArch, done LabelID)
	skipUnlessBits(u, a: a, bits: stringOwnedBit, done: done)
end 'skipUnlessOwned'

// skipUnlessBits goes to done unless the word of the String in the first local has one of bits set.
function skipUnlessBits(mutates u CodeUnit, a ast.TargetArch, bits FullRangeInt, done LabelID)
	rMovImm(u, a: a, dst: rWork, imm: bits)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
	rTest(u, a: a, left: rSecond, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: done)
end 'skipUnlessBits'

// checkAsciiBit has the runtime check the bytes of the owned String that the routine's argument and its first local hold,
// where its ASCII bit is set (Project.checksStrings).
function checkAsciiBit(mutates u CodeUnit, a ast.TargetArch)
	let clear = u.asm.newLabel()
	rMovImm(u, a: a, dst: rWork, imm: stringAsciiBit)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
	rTest(u, a: a, left: rSecond, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: clear)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
	rShrImm(u, a: a, dst: rWork, shift: stringLengthShift)
	rArgOfRole(u, a: a, index: 1, src: rWork)
	rLoadArgWord(u, a: a, index: 0, base: rFrame, disp: routineArg)
	rCallSymbol(u, a: a, symbol: ir.rtSymbol(ir.Rt.rtCheckSimpleBytes))
	u.asm.bind(clear)
end 'checkAsciiBit'

// dropString frees the bytes of a String that owns them: its word says so, with no access to memory.
function dropString(mutates u CodeUnit, a ast.TargetArch, checks bool)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 1)
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rArgWord)
	skipUnlessOwned(u, a: a, done: done)
	if checks 'checks'
		checkAsciiBit(u, a: a)
	end 'checks'
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropString'

function dropBytes(mutates u CodeUnit, a ast.TargetArch)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 0)
	returnIfEmpty(u, a: a, done: done)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: arrayDataOffset)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtFree)
	freeArgument(u, a: a)
	u.asm.bind(done)
	routineEpilogue(u, a: a)
end 'dropBytes'

// copyWord copies the word at an offset of the box that the argument is into the same offset of the new box, which is
// the first local: a managed word is copied by the routine of its type.
function copyWord(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, offset Count, ty ast.TypeID)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	copyValueInto(u, a: a, p: p, ms: ms, offset: offset, ty: ty)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
	storeCopy(u, a: a, p: p, ms: ms, offset: offset, ty: ty)
end 'copyWord'

function copyRecord(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let fields = fieldCount(ms.types, reads: p.types, owner: ty)
	routinePrologue(u, a: a, locals: 1)
	let types = ir.fieldTypes(ms.types, reads: p.types, owner: ty)
	allocate(u, a: a, bytes: ir.valuesBytes(ms.types, reads: p.types, types: types, tagged: false))
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
	for i in 0 upto fields 'fields'
		let fieldTy = ast.fieldType(ms.types, reads: p.types, owner: ty, index: i)
		let offset = ir.recordFieldOffset(ms.types, reads: p.types, owner: ty, index: i)
		copyWord(u, a: a, p: p, ms: ms, offset: offset, ty: fieldTy)
	end 'fields'
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
	routineReturn(u, a: a)
end 'copyRecord'

// copyUnion makes a box for the case the value holds, sized for its payload as lowering sizes it.
function copyUnion(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 1)
	let cases = caseCount(ms.types, reads: p.types, owner: ty)
	for i in 0 upto cases 'cases'
		let payload = payloadCount(ms.types, reads: p.types, owner: ty, caseIndex: i)
		let last = i + 1 == cases
		let next = u.asm.newLabel()
		if not last 'check'
			rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
			rLoad(u, a: a, dst: rWork, base: rWork, disp: imm32Of(ir.tagOffset))
			rCmpImm(u, a: a, left: rWork, imm: imm32Of(i))
			rBranch(u, a: a, cond: MCond.notEqual, label: next)
		end 'check'
		let types = ir.payloadTypes(ms.types, reads: p.types, owner: ty, caseIndex: i)
		allocate(u, a: a, bytes: ir.valuesBytes(ms.types, reads: p.types, types: types, tagged: true))
		rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rWork)
		rMovImm(u, a: a, dst: rSecond, imm: try i as FullRangeInt otherwise panic("a case index past memory"))
		rStore(u, a: a, base: rWork, disp: imm32Of(ir.tagOffset), src: rSecond)
		for j in 0 upto payload 'payload'
			let payloadTy = ast.payloadType(ms.types, reads: p.types, owner: ty, caseIndex: i, index: j)
			let offset = ir.payloadOffset(ms.types, reads: p.types, owner: ty, caseIndex: i, index: j)
			copyWord(u, a: a, p: p, ms: ms, offset: offset, ty: payloadTy)
		end 'payload'
		if not last 'skip'
			rJump(u, a: a, label: done)
			u.asm.bind(next)
		end 'skip'
	end 'cases'
	u.asm.bind(done)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
	routineReturn(u, a: a)
end 'copyUnion'

// copyArray makes a header and a buffer of exactly the length, with a copy of each element of an array, or of each word of
// a buffer of groups, by its type.
function copyArray(mutates u CodeUnit, a ast.TargetArch, p ast.Project, mutates ms ast.ModuleState, ty ast.TypeID)
	let header = routineLocal0
	let length = routineLocal1
	let index = routineLocal2
	let buffer = routineLocal3
	let done = u.asm.newLabel()
	let top = u.asm.newLabel()
	let columns = wordColumns(p, tt: ms.types, reads: p.types, ty: ty)
	let starts = columnStarts(ms.types, reads: p.types, columns: columns)
	let stride = starts[columns.count()]
	let perLength = lengthWords(ms.types, reads: p.types, ty: ty, stride: stride)
	routinePrologue(u, a: a, locals: 6)
	allocate(u, a: a, bytes: arrayHeaderBytes)
	rStore(u, a: a, base: rFrame, disp: header, src: rWork)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: arrayLengthOffset)
	rStore(u, a: a, base: rFrame, disp: length, src: rWork)
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: done)
	rMovImm(u, a: a, dst: rThird, imm: try (perLength * wordBytes) as FullRangeInt otherwise panic("routines: an element past memory"))
	rMul(u, a: a, dst: rWork, src: rThird)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAlloc)
	rStore(u, a: a, base: rFrame, disp: buffer, src: rWork)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: header)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: length)
	rStore(u, a: a, base: rSecond, disp: arrayLengthOffset, src: rWork)
	rStore(u, a: a, base: rSecond, disp: arrayCapacityOffset, src: rWork)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: buffer)
	rStore(u, a: a, base: rSecond, disp: arrayDataOffset, src: rWork)
	rZero(u, a: a, dst: rWork)
	rStore(u, a: a, base: rFrame, disp: index, src: rWork)
	u.asm.bind(top)
	loadWordsLimit(u, a: a, perLength: perLength)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: index)
	rCmp(u, a: a, left: rWork, right: rThird)
	rBranch(u, a: a, cond: MCond.aboveEqual, label: done)
	for j in 0 upto columns.count() 'columns'
		wordAddress(u, a: a, boxDisp: routineArg, indexDisp: index, offset: starts[j])
		// An empty slot of a managed element, 0, stays empty in the copy (ir.SlotRead), as a String's 0 and 0 does.
		let empty = u.asm.newLabel()
		if ast.isStringType(ms.types, reads: p.types, t: columns[j]) 'string'
			copyValueInto(u, a: a, p: p, ms: ms, offset: 0, ty: columns[j])
		end 'string' else 'word'
			rLoad(u, a: a, dst: rWork, base: rSecond, disp: 0)
			if ast.isManagedType(ms.types, reads: p.types, t: columns[j]) 'managed'
				rTest(u, a: a, left: rWork, right: rWork)
				rBranch(u, a: a, cond: MCond.equal, label: empty)
				routineCall(u, a: a, p: p, ms: ms, kind: RoutineKind.copyRoutine, ty: columns[j])
			end 'managed'
		end 'word'
		u.asm.bind(empty)
		rStore(u, a: a, base: rFrame, disp: routineLocal4, src: rWork)
		rStore(u, a: a, base: rFrame, disp: routineLocal5, src: rResultWord)
		wordAddress(u, a: a, boxDisp: header, indexDisp: index, offset: starts[j])
		rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal4)
		rStore(u, a: a, base: rSecond, disp: 0, src: rWork)
		if ast.isStringType(ms.types, reads: p.types, t: columns[j]) 'second'
			rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal5)
			rStore(u, a: a, base: rSecond, disp: imm32Of(stringWordOffset), src: rWork)
		end 'second'
	end 'columns'
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: index)
	rAddImm(u, a: a, dst: rWork, imm: imm32Of(stride))
	rStore(u, a: a, base: rFrame, disp: index, src: rWork)
	rJump(u, a: a, label: top)
	u.asm.bind(done)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: header)
	routineReturn(u, a: a)
end 'copyArray'

// copyString is a new String of a copy of the bytes, which it owns, where the String owns them or is a view of another's:
// a literal's copy is the same two words, since its bytes are the executable's and outlive every copy. A view's copy has
// its word with the owned bit in place of the view bit.
function copyString(mutates u CodeUnit, a ast.TargetArch, checks bool)
	let shared = u.asm.newLabel()
	let owned = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 2)
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rArgWord)
	skipUnlessBits(u, a: a, bits: stringOwnedBit or stringViewBit, done: shared)
	if checks 'checks'
		checkAsciiBit(u, a: a)
	end 'checks'
	rMovImm(u, a: a, dst: rWork, imm: stringViewBit)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
	rTest(u, a: a, left: rSecond, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: owned)
	rMovImm(u, a: a, dst: rWork, imm: stringViewBit - stringOwnedBit)
	rSub(u, a: a, dst: rSecond, src: rWork)
	rStore(u, a: a, base: rFrame, disp: routineLocal0, src: rSecond)
	u.asm.bind(owned)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal0)
	rShrImm(u, a: a, dst: rWork, shift: stringLengthShift)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAlloc)
	rStore(u, a: a, base: rFrame, disp: routineLocal1, src: rWork)
	rMov(u, a: a, dst: rCopyTo, src: rWork)
	rLoad(u, a: a, dst: rCopyFrom, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineLocal0)
	rShrImm(u, a: a, dst: rSecond, shift: stringLengthShift)
	rCopyBytes(u, a: a)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineLocal1)
	rLoad(u, a: a, dst: rResultWord, base: rFrame, disp: routineLocal0)
	routineReturn(u, a: a)
	u.asm.bind(shared)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rResultWord, base: rFrame, disp: routineLocal0)
	routineReturn(u, a: a)
end 'copyString'

function copyBytes(mutates u CodeUnit, a ast.TargetArch)
	let header = routineLocal0
	let length = routineLocal1
	let buffer = routineLocal2
	let done = u.asm.newLabel()
	routinePrologue(u, a: a, locals: 3)
	allocate(u, a: a, bytes: arrayHeaderBytes)
	rStore(u, a: a, base: rFrame, disp: header, src: rWork)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rWork, base: rSecond, disp: arrayLengthOffset)
	rStore(u, a: a, base: rFrame, disp: length, src: rWork)
	rTest(u, a: a, left: rWork, right: rWork)
	rBranch(u, a: a, cond: MCond.equal, label: done)
	callRuntimeWithWork(u, a: a, entry: ir.Rt.rtAlloc)
	rStore(u, a: a, base: rFrame, disp: buffer, src: rWork)
	rLoad(u, a: a, dst: rSecond, base: rFrame, disp: header)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: length)
	rStore(u, a: a, base: rSecond, disp: arrayLengthOffset, src: rWork)
	rStore(u, a: a, base: rSecond, disp: arrayCapacityOffset, src: rWork)
	rLoad(u, a: a, dst: rThird, base: rFrame, disp: buffer)
	rStore(u, a: a, base: rSecond, disp: arrayDataOffset, src: rThird)
	rMov(u, a: a, dst: rCopyTo, src: rThird)
	rLoad(u, a: a, dst: rCopyFrom, base: rFrame, disp: routineArg)
	rLoad(u, a: a, dst: rCopyFrom, base: rCopyFrom, disp: arrayDataOffset)
	rMov(u, a: a, dst: rSecond, src: rWork)
	rCopyBytes(u, a: a)
	u.asm.bind(done)
	rLoad(u, a: a, dst: rWork, base: rFrame, disp: header)
	routineReturn(u, a: a)
end 'copyBytes'
