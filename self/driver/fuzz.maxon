// The fuzz command: it writes random programs the checker should accept, checks them, runs each under the tracking interpreter,
// and reports a program the checker accepted that the interpreter convicts of a memory-model violation or a leak (a hole in the
// checker or in the lowering), a program that the checker refuses (a hole in the generator, when it does not parse) and, with
// --native, one whose executable gives other output than the interpreter. A program is a pure function of its seed, so a failure
// is reproduced by its seed alone. With --proofs the programs are the proof generator's (self/fuzz/proofs.maxon), which aims at the
// range analysis's proofs of access and arithmetic: each is fixed by the compiler's own fix pass, which removes the handler of an
// access the analysis proves, and then every refusal is a hole in the generator, and an access the interpreter finds outside its
// array, or an output that differs from the executable's, is a hole in a proof.

let fuzzSeedFlag = "--seed="

let fuzzCountFlag = "--count="

let fuzzSchedulesFlag = "--schedules="

let fuzzKeepFlag = "--keep="

let fuzzDumpFlag = "--dump"

let fuzzNativeFlag = "--native"

let fuzzProofsFlag = "--proofs"

let fuzzWorkerFlag = "--worker"

// programsPerWorker is how many seeds one worker process runs: what an internal compiler error costs is the other programs of its
// chunk, run again.
let programsPerWorker = 100 as Count

// workerMarker starts the line that a worker writes before each program, which says where it was if it dies.
let workerMarker = "@"

// workerTally starts the line that a worker ends with, which is its counts: tallyWords words, the marker and the numbers,
// then the rejected codes.
let workerTally = "tally "

let tallyWords = 12 as Count

let defaultGeneratedPrograms = 300 as Count

// generatedStepLimit is how many instructions a generated program may outcome under the interpreter before it counts as a timeout.
let generatedStepLimit = 20000000 as Count

// defaultScheduleSeeds is how many schedules a program that has behaviours runs under.
let defaultScheduleSeeds = 3 as Count

// nativeBehaviourRuns is how many times --native runs the executable of a program that schedules behaviours, each run
// under another schedule, with the worker count of the fuzzer's environment (MAXON_MAX_PROCS).
let nativeBehaviourRuns = 3 as Count

// maxReportedFailures is how many failing programs are printed whole; the others only say their seed.
let maxReportedFailures = 3 as Count

// A outcome of at least minProgramsForAcceptedShare programs must have 1 in minAcceptedDivisor accepted: only an accepted program
// reaches the interpreter, so a change to the language that the generator did not follow would otherwise pass with every program
// refused.
let minProgramsForAcceptedShare = 100 as Count

let minAcceptedDivisor = 10 as Count

// leakMessage is what an executable that counts its allocations says when main returns with a heap box still live.
let leakMessage = "leaked allocations"

// generatedPath names the program of a seed in diagnostics; it is never written.
let generatedPath = "p.maxon"

let libraryFileName = "library.txt"

// proofsLibraryFileName is the library of the proof generator's programs.
let proofsLibraryFileName = "proofs.txt"

// proofsKeepDirName is where --proofs keeps the programs that fail when --keep names no directory, under the system's temporary
// directory.
let proofsKeepDirName = "minimaxon-fuzz-proofs"

// maxRefusedDivisor is the share of the programs of a --proofs run that the checker may refuse for a fact it knows of the code
// (isStaticRefusal), as 1 in this many.
let maxRefusedDivisor = 4 as Count

// minProvenDivisor is the share of the accesses of a --proofs run that the analysis must prove, as 1 in this many: a generator
// whose programs the analysis proves nothing of tests no proof.
let minProvenDivisor = 8 as Count

let selfDirName = "self"

let fuzzDirName = "fuzz"

typealias FuzzCounts = Array with Count

// fuzzFlagValue is what a flag with a value gives, when the argument is that flag.
function fuzzFlagValue(arg String, prefix String) returns table.Option with String
	if hasPrefix(arg, prefix: prefix) 'flag'
		return table.Option.some(arg.sliceBytes(prefix.byteLength(), endPos: arg.byteLength()).clone())
	end 'flag'
	return table.Option.none
end 'fuzzFlagValue'

// fuzzNumber is the number a flag's value writes, or a usage error.
function fuzzNumber(text String, flag String) returns table.Option with Count
	let number = parseSeed(text)
	if not number.isSome() 'invalid'
		printError("{flag} takes a number\n")
	end 'invalid'
	return number
end 'fuzzNumber'

// libraryText is the generic code that every generated program starts with, which lives beside the generator's source: the file
// of the generator the options choose.
function libraryText(options FuzzOptions) returns table.Option with String
	let selfDir = project.nearestDirectory(selfDirName)
	if not selfDir.isSome() 'missing'
		return table.Option.none
	end 'missing'
	let fuzzDir = project.joinPath(selfDir.unwrap(), name: fuzzDirName)
	return project.readTextFile(project.joinPath(fuzzDir, name: libraryFileOf(options)))
end 'libraryText'

function libraryFileOf(options FuzzOptions) returns String
	if options.proofs 'proofs'
		return proofsLibraryFileName.clone()
	end 'proofs'
	return libraryFileName.clone()
end 'libraryFileOf'

// generatedProgram is the program of a seed, from the generator the options choose.
function generatedProgram(options FuzzOptions, seed Count, library String) returns fuzz.GeneratedProgram
	if options.proofs 'proofs'
		return fuzz.generateProof(seed, library: library)
	end 'proofs'
	return fuzz.generate(seed, library: library)
end 'generatedProgram'

// FuzzOptions are what the flags of the fuzz command say.
type FuzzOptions
	var first as Count
	var count as Count
	var schedules as Count
	var keep as String
	var dump as bool
	var native as bool
	// proofs says that the programs are the proof generator's.
	var proofs as bool
	// worker says that this process is one that a run of the command started for some of its seeds, so that an internal compiler error
	// on one program ends only that process.
	var worker as bool

	static function new() returns FuzzOptions
		return FuzzOptions{first: 1, count: defaultGeneratedPrograms, schedules: defaultScheduleSeeds, keep: "", dump: false, native: false, proofs: false, worker: false}
	end 'new'
end 'FuzzOptions'

// readFuzzOptions reads the flags after the command, or says why it cannot.
function readFuzzOptions(args CommandNames) returns table.Option with FuzzOptions
	var options = FuzzOptions.new()
	for i in 1 upto args.count() 'args'
		let seed = fuzzFlagValue(args[i], prefix: fuzzSeedFlag)
		let count = fuzzFlagValue(args[i], prefix: fuzzCountFlag)
		let schedules = fuzzFlagValue(args[i], prefix: fuzzSchedulesFlag)
		let keep = fuzzFlagValue(args[i], prefix: fuzzKeepFlag)
		if seed.isSome() 'seed'
			let number = fuzzNumber(seed.unwrap(), flag: "--seed")
			if not number.isSome() 'invalid'
				return table.Option.none
			end 'invalid'
			options.first = number.unwrap()
		end 'seed' else if count.isSome() 'count'
			let number = fuzzNumber(count.unwrap(), flag: "--count")
			if not number.isSome() 'invalid'
				return table.Option.none
			end 'invalid'
			options.count = number.unwrap()
		end 'count' else if schedules.isSome() 'schedules'
			let number = fuzzNumber(schedules.unwrap(), flag: "--schedules")
			if not number.isSome() 'invalid'
				return table.Option.none
			end 'invalid'
			options.schedules = number.unwrap()
		end 'schedules' else if keep.isSome() 'keep'
			options.keep = keep.unwrap()
		end 'keep' else if args[i] == fuzzDumpFlag 'dump'
			options.dump = true
		end 'dump' else if args[i] == fuzzNativeFlag 'native'
			options.native = true
		end 'native' else if args[i] == fuzzProofsFlag 'proofs'
			options.proofs = true
		end 'proofs' else if args[i] == fuzzWorkerFlag 'worker'
			options.worker = true
		end 'worker' else 'unknown'
			printError("fuzz: unknown argument {args[i]}\n")
			return table.Option.none
		end 'unknown'
	end 'args'
	if options.proofs and options.keep == "" 'kept'
		options.keep = ast.temporaryPath(proofsKeepDirName)
	end 'kept'
	return table.Option.some(options)
end 'readFuzzOptions'

// fuzzCommand is `fuzz [--seed=N] [--count=N] [--schedules=N] [--keep=DIR] [--native] [--proofs] [--dump]`: it runs the programs
// of the seeds from --seed up, --count of them, and with --dump only prints the program of --seed.
function fuzzCommand(args CommandNames) returns ExitCode
	let read = readFuzzOptions(args)
	if not read.isSome() 'invalid'
		printError(usage())
		return usageExitCode
	end 'invalid'
	let options = read.unwrap()
	let found = libraryText(options)
	if not found.isSome() 'noLibrary'
		printError("fuzz: no {selfDirName}/{fuzzDirName}/{libraryFileOf(options)} in the compiler's directory or above it\n")
		return usageExitCode
	end 'noLibrary'
	let library = found.unwrap()
	if options.dump 'dump'
		print(generatedProgram(options, seed: options.first, library: library).source)
		return 0
	end 'dump'
	if options.worker 'worker'
		return fuzzWorker(options, library: library)
	end 'worker'
	return fuzzSupervisor(options)
end 'fuzzCommand'

// isStaticRefusal is whether the code says that the checker knows an access or a division of the program to be wrong whatever
// is run: an index that a condition made a known number outside a fixed array, or a divisor of 0. The generator cannot tell
// which values a condition made known, so such a program is left out, as a refusal.
function isStaticRefusal(code String) returns bool
	return code == diag.errTypeMismatch or code == diag.errDivisionByZero
end 'isStaticRefusal'

// GeneratedRun is what happened to one generated program.
type GeneratedRun
	// rejected says that the front end refused the program, which is no failure unless it did not parse.
	var rejected as bool
	var syntaxFail as bool
	var rejectedCode as String
	var rejectedText as String
	var violations as ast.StringList
	var timedOut as bool
	var exitCode as ExitCode
	var stdout as String
	var behaviours as Count
	// scheduleSeed is the schedule that gave the result, which for a program that breaks a rule is the first that did.
	var scheduleSeed as Count

	static function new() returns GeneratedRun
		return GeneratedRun{rejected: false, syntaxFail: false, rejectedCode: "", rejectedText: "", violations: ast.StringList.create(0), timedOut: false, exitCode: 0, stdout: "", behaviours: 0, scheduleSeed: 0}
	end 'new'
end 'GeneratedRun'

// isSyntaxCode is whether the diagnostic means the program is not well formed, which the generator must never write.
function isSyntaxCode(code String) returns bool
	return code == diag.errUnexpectedToken or code == diag.errUnexpectedCharacter or code == diag.errControlCharacter or code == diag.errLineSeparator or code == diag.errBidiControl or code == diag.errByteOrderMark or code == diag.errUnexpectedEnd or code == diag.errMismatchedEndLabel or code == diag.errExpectedToken or code == diag.errIntegerLiteralRange
end 'isSyntaxCode'

// runGenerated checks a program and runs it under the interpreter, under as many schedules as the program's behaviours want.
// A generated program is staged in the library tier, as every check of one is: it tests the rules of cowns and behaviours,
// which only the library tiers write (E3185 elsewhere).
function runGenerated(source String, schedules Count) returns GeneratedRun
	var outcome = GeneratedRun.new()
	var errs = diag.ErrorList.create(0)
	var p = ast.Project.new("")
	project.loadSourceInto(p, path: generatedPath, text: source, errs: errs)
	stageInLibrary(p, first: 0)
	runLoaded(p, schedules: schedules, outcome: outcome, errs: errs)
	return outcome
end 'runGenerated'

function runLoaded(mutates p ast.Project, schedules Count, mutates outcome GeneratedRun, mutates errs diag.ErrorList)
	let generated = lowerForInterpreter(p, errs: errs)
	if errs.count() > 0 'rejected'
		diag.sortErrors(errs)
		outcome.rejected = true
		outcome.rejectedCode = errs[0].code.clone()
		outcome.rejectedText = joinErrors(errs)
		for i in 0 upto errs.count() 'each'
			if isSyntaxCode(errs[i].code) 'syntax'
				outcome.syntaxFail = true
			end 'syntax'
		end 'each'
		return
	end 'rejected'
	var out = interp.run(p, modules: generated.modules, entry: generated.entry, stepLimit: generatedStepLimit, seed: interp.seedOf(0), wantFrees: false, stdin: "")
	if out.behaviours > 0 'scheduled'
		// The schedule of behaviours is random, so a program that has some runs under several, and a rule that only some of them
		// break is still broken.
		var schedule = 1 as Count
		while schedule < schedules and out.violations.count() == 0 'schedules'
			let again = interp.run(p, modules: generated.modules, entry: generated.entry, stepLimit: generatedStepLimit, seed: interp.seedOf(schedule), wantFrees: false, stdin: "")
			if again.violations.count() > 0 'broken'
				out = again
				outcome.scheduleSeed = schedule
			end 'broken'
			schedule = schedule + 1
		end 'schedules'
	end 'scheduled'
	outcome.violations = out.violations.clone()
	outcome.timedOut = out.timedOut
	outcome.exitCode = interp.exitStatus(out.exitCode)
	outcome.stdout = out.stdout.clone()
	outcome.behaviours = out.behaviours
end 'runLoaded'

// NativeCheck is how an executable of a program compares with the interpreter's outcome of it: the difference, and whether it ran.
type NativeCheck
	var mismatch as String
	var ran as bool

	static function agreed(ran bool) returns NativeCheck
		return NativeCheck{mismatch: "", ran: ran}
	end 'agreed'

	static function differs(consumes mismatch String, ran bool) returns NativeCheck
		return NativeCheck{mismatch: mismatch, ran: ran}
	end 'differs'
end 'NativeCheck'

// compareNative compiles the program the interpreter just ran and runs the executable. A program that schedules behaviours
// and was not written so that its output is the same under every schedule is skipped. One that was runs several times, and a run that ends in a trap may have printed more or
// less of main's output first than the interpreter did, since a behaviour runs beside main: one output must be the start
// of the other.
function compareNative(shared SharedRuntime, source String, outcome GeneratedRun, scheduleIndependent bool) returns NativeCheck
	if outcome.behaviours > 0 and not scheduleIndependent 'scheduleDependent'
		return NativeCheck.agreed(false)
	end 'scheduleDependent'
	let exe = temporaryExecutable("fuzz.maxon", suffix: executableExtension(hostTarget()))
	var options = Options.new()
	options.countAllocations = true
	options.stagesInLibrary = true
	var errs = diag.ErrorList.create(0)
	_ = compileSourceWith(shared, path: generatedPath, text: source, output: exe, options: options, errs: errs)
	diag.sortErrors(errs)
	if errs.count() > 0 'failed'
		return NativeCheck.differs("the program did not compile: {joinErrors(errs)}", ran: false)
	end 'failed'
	let exePath = try FilePath.from(exe) otherwise return NativeCheck.differs("{exe} is not a path", ran: false)
	var runs = 1 as Count
	if outcome.behaviours > 0 'scheduled'
		runs = nativeBehaviourRuns
	end 'scheduled'
	for run in 0 upto runs 'runs'
		let out = try Subprocess.run(Executable.path(exePath.clone()), arguments: CommandNames.create(0)) otherwise return NativeCheck.differs("cannot run {exe}", ran: false)
		let check = compareRun(out, outcome: outcome)
		if check.mismatch != "" 'mismatch'
			try File.delete(exePath) otherwise panic("fuzz: cannot delete {exe}")
			if runs == 1 'once'
				return check
			end 'once'
			return NativeCheck.differs("run {run + 1} of {runs}, {workerCountText()}: {check.mismatch}", ran: true)
		end 'mismatch'
	end 'runs'
	try File.delete(exePath) otherwise panic("fuzz: cannot delete {exe}")
	return NativeCheck.agreed(true)
end 'compareNative'

// compareRun is how one run of the executable compares with the interpreter's outcome.
function compareRun(out CollectedOutput, outcome GeneratedRun) returns NativeCheck
	if findText(out.stderr, needle: leakMessage).isSome() 'leaked'
		// The interpreter found no leak, so a box the executable still holds is one that it did not free.
		return NativeCheck.differs("the executable ended with live heap boxes: {out.stderr}", ran: true)
	end 'leaked'
	if out.exitCode() != outcome.exitCode 'exit'
		return NativeCheck.differs("exit code {out.exitCode()} against {outcome.exitCode}", ran: true)
	end 'exit'
	if out.stdout == outcome.stdout 'same'
		return NativeCheck.agreed(true)
	end 'same'
	let trappedBeside = outcome.behaviours > 0 and outcome.exitCode != 0
	if trappedBeside and (hasPrefix(out.stdout, prefix: outcome.stdout) or hasPrefix(outcome.stdout, prefix: out.stdout)) 'cutShort'
		return NativeCheck.agreed(true)
	end 'cutShort'
	return NativeCheck.differs("standard output differs", ran: true)
end 'compareRun'

// keepSource saves a program in the directory, when there is one, to look at it later.
function keepSource(dir String, name String, source String)
	if dir == "" 'nowhere'
		return
	end 'nowhere'
	let dirPath = try FilePath.from(dir) otherwise return
	_ = Directory.create(dirPath)
	let file = try FilePath.from(project.joinPath(dir, name: name)) otherwise return
	try File.writeText(file, content: source) otherwise return
end 'keepSource'

// numbered is the source with the number of each line before it.
function numbered(source String) returns String
	var out = ByteArray.create(0)
	var start = 0 as Count
	var number = 1 as Count
	let n = source.byteLength()
	for i in 0 upto n 'bytes'
		if source.byteAt(i) == 10 'line'
			out.append(numberedLine(number, text: source.sliceBytes(start, endPos: i)).toByteArray())
			start = i + 1
			number = try number + 1 otherwise panic("fuzz: more lines than memory")
		end 'line'
	end 'bytes'
	out.append(numberedLine(number, text: source.sliceBytes(start, endPos: n)).toByteArray())
	return String.from(out)
end 'numbered'

function numberedLine(number Count, text String) returns String
	var digits = "{number}"
	while digits.byteLength() < 4 'pad'
		digits = " {digits}"
	end 'pad'
	return "{digits}  {text}\n"
end 'numberedLine'

// FuzzTally is what the programs of a run came to.
type FuzzTally
	var accepted as Count
	var trapped as Count
	var timedOut as Count
	var failures as Count
	var compared as Count
	// comparedConcurrent is how many of the compared programs scheduled behaviours.
	var comparedConcurrent as Count
	var concurrent as Count
	var behaviours as Count
	// accesses is how many accesses the proof programs had, and proven how many of them the analysis proved.
	var accesses as Count
	var proven as Count
	// planted is how many accepted programs had a shape planted that the checker refused as it must.
	var planted as Count
	var rejectedCodes as ast.StringList
	var rejectedCounts as table.StringMap with Count

	static function new() returns FuzzTally
		return FuzzTally{accepted: 0, trapped: 0, timedOut: 0, failures: 0, compared: 0, comparedConcurrent: 0, concurrent: 0, behaviours: 0, accesses: 0, proven: 0, planted: 0, rejectedCodes: ast.StringList.create(0), rejectedCounts: table.StringMap.new()}
	end 'new'

	// reject counts programs that the checker refused, by the code of the first diagnostic of each.
	function reject(mutates self, code String, programs Count)
		let seen = rejectedCounts.get(code)
		if seen.isSome() 'again'
			rejectedCounts.insert(code.clone(), value: try seen.unwrap() + programs otherwise panic("fuzz: more programs than memory"))
		end 'again' else 'first'
			rejectedCodes.push(code.clone())
			rejectedCounts.insert(code.clone(), value: programs)
		end 'first'
	end 'reject'

	// countAccesses adds the accesses of a proof program and the share the analysis proved: proofAccessTally's two numbers.
	function countAccesses(mutates self, counts FuzzCounts)
		accesses = try accesses + counts[0] otherwise panic("fuzz: more accesses than memory")
		proven = try proven + counts[1] otherwise panic("fuzz: more accesses than memory")
	end 'countAccesses'

	// the counts of the worker's line, which ends a worker's output: its numbers in order, then the rejected codes with their counts.
	function line() returns String
		var text = "{workerTally}{accepted} {trapped} {timedOut} {failures} {compared} {comparedConcurrent} {concurrent} {behaviours} {accesses} {proven} {planted}"
		for i in 0 upto rejectedCodes.count() 'codes'
			let count = rejectedCounts.get(rejectedCodes[i]).unwrap()
			text = "{text} {rejectedCodes[i]}:{count}"
		end 'codes'
		return text
	end 'line'

	// add takes in the counts of a worker's line, which says whether it was one.
	function add(mutates self, tallyLine String) returns bool
		let words = splitWords(tallyLine)
		if words.count() < tallyWords or words[0] != "tally" 'other'
			return false
		end 'other'
		var numbers = FuzzCounts.create(0)
		for i in 1 upto tallyWords 'numbers'
			let n = parseSeed(words[i])
			if not n.isSome() 'invalid'
				return false
			end 'invalid'
			numbers.push(n.unwrap())
		end 'numbers'
		// The count of planted shapes is the last number.
		let plantedNumber = try numbers.pop() otherwise panic("fuzz: a tally line of no numbers")
		planted = try planted + plantedNumber otherwise panic("fuzz: more programs than memory")
		accepted = try accepted + numbers[0] otherwise panic("fuzz: more programs than memory")
		trapped = try trapped + numbers[1] otherwise panic("fuzz: more programs than memory")
		timedOut = try timedOut + numbers[2] otherwise panic("fuzz: more programs than memory")
		failures = try failures + numbers[3] otherwise panic("fuzz: more programs than memory")
		compared = try compared + numbers[4] otherwise panic("fuzz: more programs than memory")
		comparedConcurrent = try comparedConcurrent + numbers[5] otherwise panic("fuzz: more programs than memory")
		concurrent = try concurrent + numbers[6] otherwise panic("fuzz: more programs than memory")
		behaviours = try behaviours + numbers[7] otherwise panic("fuzz: more programs than memory")
		accesses = try accesses + numbers[8] otherwise panic("fuzz: more accesses than memory")
		proven = try proven + numbers[9] otherwise panic("fuzz: more accesses than memory")
		for i in tallyWords upto words.count() 'codes'
			let split = findText(words[i], needle: ":")
			if split.isSome() 'pair'
				let at = split.unwrap()
				let code = words[i].sliceBytes(0, endPos: at)
				let count = parseSeed(words[i].sliceBytes(try at + 1 otherwise panic("fuzz: a colon past memory"), endPos: words[i].byteLength()))
				if count.isSome() 'counted'
					self.reject(code, programs: count.unwrap())
				end 'counted'
			end 'pair'
		end 'codes'
		return true
	end 'add'
end 'FuzzTally'

// splitWords is the words of a line, which are cut at spaces.
function splitWords(text String) returns ast.StringList
	var words = ast.StringList.create(0)
	var start = 0 as Count
	let n = text.byteLength()
	for i in 0 upto n 'bytes'
		if text.byteAt(i) == spaceByte 'cut'
			if i > start 'word'
				words.push(text.sliceBytes(start, endPos: i).clone())
			end 'word'
			start = i + 1
		end 'cut'
	end 'bytes'
	if n > start 'last'
		words.push(text.sliceBytes(start, endPos: n).clone())
	end 'last'
	return words
end 'splitWords'

// fail reports a program that is a failure: it is kept, and the first few are printed whole.
function fail(mutates tally FuzzTally, options FuzzOptions, seed Count, source String, message String)
	tally.failures = try tally.failures + 1 otherwise panic("fuzz: more failures than memory")
	keepSource(options.keep, name: "seed{seed}.maxon", source: source)
	if tally.failures <= maxReportedFailures 'whole'
		print("seed {seed}: {message}\n{numbered(source)}\n")
	end 'whole' else 'brief'
		print("seed {seed}: {message}\n")
	end 'brief'
end 'fail'

// fixedProgram is the program after the compiler's own fix pass: it removes the handler of each access, and the try of each
// piece of arithmetic, that the analysis proves cannot fail (E3944), and adds a try that panics to what the generator wrote
// bare, so the program that is left is what the analysis accepts. With only, the fixes of that kind are the only ones made.
function fixedProgram(source String, libraries FixLibraries, only table.Option with String) returns String
	var files = project.SourceFiles.create(0)
	files.push(project.SourceFile.make(generatedPath.clone(), text: source.clone()))
	var prog = FixProgram.make(generatedPath.clone(), name: generatedPath.clone(), single: true, files: files, candidates: ast.knownTargets())
	// A generated program is checked in the library tier (runGenerated), so its fixes are made there too.
	prog.inLibrary = true
	let outcome = fixProgram(prog, libraries: libraries, expected: table.Option.none, watches: ast.StringList.create(0), only: only)
	return outcome.files[0].text.clone()
end 'fixedProgram'

// proofLibraries is the library that the fixes of a --proofs run share, prepared once: the first target's, which is the one a
// program of one file is checked for. Another run has none to prepare.
function proofLibraries(options FuzzOptions) returns FixLibraries
	if not options.proofs 'none'
		return noFixLibraries()
	end 'none'
	var needed = Flags.create(0)
	let known = ast.knownTargets()
	for i in 0 upto known.count() 'targets'
		needed.push(i == 0)
	end 'targets'
	return prepareFixLibraries(needed)
end 'proofLibraries'

// nativeRuntime is the runtime that executables of generated programs link with, which only a run with --native makes, since
// checking and compiling it is what no other run needs.
function nativeRuntime(options FuzzOptions) returns SharedRuntime
	if options.native 'native'
		return prepareSharedRuntime(hostTarget())
	end 'native'
	return SharedRuntime.none()
end 'nativeRuntime'

// isOwnershipCode is whether an error refuses a program for what it does with a value's owner: a use after a move, a change
// or a move of a place that something still borrows, or a move out of what the program only borrows.
function isOwnershipCode(code String) returns bool
	return code == diag.errUseAfterMove or code == diag.errExclusivity or code == diag.errMoveOutOfBorrow or code == diag.errMoveOutOfField
end 'isOwnershipCode'

// plantedRefusal is what the checker did with the program's planted shape when it did not refuse it as it must, with an
// ownership error on one of the shape's lines, or nothing when it did. The planted program is the generator's text, which no
// fix has touched, so a try that fixedProgram removes from the program that runs can neither accept nor hide a planted shape:
// E3944 is reported only for a module with no other error, and a refusal for it alone is no ownership error.
function plantedRefusal(generated fuzz.GeneratedProgram) returns String
	var errs = diag.ErrorList.create(0)
	var p = ast.Project.new("")
	project.loadSourceInto(p, path: generatedPath, text: generated.planted, errs: errs)
	stageInLibrary(p, first: 0)
	_ = checkLoaded(p, goal: Goal.checked, makesProgram: true, errs: errs)
	ast.locateAllErrors(p.modules, errs: errs)
	for e in errs 'errors'
		if isOwnershipCode(e.code) and e.line >= generated.plantFirst and e.line <= generated.plantLast 'refused'
			return ""
		end 'refused'
	end 'errors'
	if errs.count() == 0 'accepted'
		return "it accepted it"
	end 'accepted'
	diag.sortErrors(errs)
	return "it refused it otherwise: {joinErrors(errs)}"
end 'plantedRefusal'

// fuzzWorker runs the programs of the seeds in this process, and says how they went as a line of counts. A program that is
// refused is no failure, since most of what the generator writes is written to reach the edges of the rules; a program that is
// accepted and then breaks a rule is a hole in the checker, and one that is not well formed is a bug in the generator.
function fuzzWorker(options FuzzOptions, library String) returns ExitCode
	var tally = FuzzTally.new()
	var shared = nativeRuntime(options)
	let libraries = proofLibraries(options)
	let last = try options.first + options.count otherwise panic("fuzz: the seeds pass the largest number")
	var seed = options.first
	while seed < last 'seeds'
		print("{workerMarker}{seed}\n")
		let generated = generatedProgram(options, seed: seed, library: library)
		var source = generated.source.clone()
		if options.proofs 'proofs'
			source = fixedProgram(source, libraries: libraries, only: table.Option.none)
		end 'proofs'
		var outcome = runGenerated(source, schedules: options.schedules)
		if outcome.rejected and outcome.rejectedCode == diag.errNeedlessTry 'needless'
			// The generator writes a try on every piece of arithmetic, which the analysis may prove cannot fail; what it is
			// refused for is nothing the program is about, so the program runs without those tries.
			source = fixedProgram(source, libraries: libraries, only: table.Option.some(check.fixKindUntry.clone()))
			outcome = runGenerated(source, schedules: options.schedules)
		end 'needless'
		if outcome.syntaxFail 'syntax'
			fail(tally, options: options, seed: seed, source: source, message: "the generator wrote a program that does not parse: {outcome.rejectedText}")
		end 'syntax' else if outcome.rejected and options.proofs and not isStaticRefusal(outcome.rejectedCode) 'refused'
			fail(tally, options: options, seed: seed, source: source, message: "the checker refuses the program after the fix, which a proof program never needs: {outcome.rejectedText}")
		end 'refused' else if outcome.rejected 'rejected'
			tally.reject(outcome.rejectedCode, programs: 1)
		end 'rejected' else if outcome.violations.count() > 0 'violated'
			var report = ""
			for i in 0 upto outcome.violations.count() 'each'
				report = "{report}{outcome.violations[i]}\n"
			end 'each'
			fail(tally, options: options, seed: seed, source: source, message: "a program the checker accepted breaks the memory model (schedule of seed {outcome.scheduleSeed}):\n{report}")
		end 'violated' else if outcome.timedOut 'timedOut'
			tally.timedOut = try tally.timedOut + 1 otherwise panic("fuzz: more programs than memory")
			keepSource(options.keep, name: "timeout{seed}.maxon", source: source)
		end 'timedOut' else 'accepted'
			tally.accepted = try tally.accepted + 1 otherwise panic("fuzz: more programs than memory")
			if options.proofs 'counted'
				tally.countAccesses(fuzz.proofAccessTally(source))
			end 'counted'
			if outcome.exitCode != 0 'trapped'
				tally.trapped = try tally.trapped + 1 otherwise panic("fuzz: more programs than memory")
			end 'trapped'
			if outcome.behaviours > 0 'concurrent'
				tally.concurrent = try tally.concurrent + 1 otherwise panic("fuzz: more programs than memory")
				tally.behaviours = try tally.behaviours + outcome.behaviours otherwise panic("fuzz: more behaviours than memory")
			end 'concurrent'
			if generated.isPlanted() 'planted'
				let refusal = plantedRefusal(generated)
				if refusal != "" 'plantAccepted'
					fail(tally, options: options, seed: seed, source: generated.planted, message: "the checker must refuse the planted {generated.plantName} at lines {generated.plantFirst} to {generated.plantLast} with an ownership error, and {refusal}")
				end 'plantAccepted' else 'plantRefused'
					tally.planted = try tally.planted + 1 otherwise panic("fuzz: more programs than memory")
				end 'plantRefused'
			end 'planted'
			if options.native 'native'
				let check = compareNative(shared, source: source, outcome: outcome, scheduleIndependent: generated.scheduleIndependent)
				if check.mismatch != "" 'mismatch'
					fail(tally, options: options, seed: seed, source: source, message: "the executable and the interpreter differ: {check.mismatch}")
				end 'mismatch' else if check.ran 'ran'
					tally.compared = try tally.compared + 1 otherwise panic("fuzz: more programs than memory")
					if outcome.behaviours > 0 'concurrent'
						tally.comparedConcurrent = try tally.comparedConcurrent + 1 otherwise panic("fuzz: more programs than memory")
					end 'concurrent'
				end 'ran'
			end 'native'
		end 'accepted'
		seed = seed + 1
	end 'seeds'
	print("{tally.line()}\n")
	return 0
end 'fuzzWorker'

// fuzzSupervisor runs the programs of the seeds in worker processes, programsPerWorker at a time, so that an internal compiler
// error, which ends the process it happens in, is only one failed program: the worker's last marker says which, and the rest of
// its chunk is run again by new workers.
function fuzzSupervisor(options FuzzOptions) returns ExitCode
	var tally = FuzzTally.new()
	let last = try options.first + options.count otherwise panic("fuzz: the seeds pass the largest number")
	var first = options.first
	while first < last 'chunks'
		let room = last - first
		var size = programsPerWorker
		if room < size 'short'
			size = room
		end 'short'
		if not runChunk(options, first: first, count: size, tally: tally) 'aborted'
			return usageExitCode
		end 'aborted'
		first = try first + size otherwise panic("fuzz: the seeds pass the largest number")
	end 'chunks'
	return fuzzSummary(tally, options: options)
end 'fuzzSupervisor'

// workerArguments are the arguments of a worker for the seeds from first, count of them.
function workerArguments(options FuzzOptions, first Count, count Count) returns CommandNames
	var args = CommandNames.create(0)
	args.push("fuzz")
	args.push(fuzzWorkerFlag)
	args.push("{fuzzSeedFlag}{first}")
	args.push("{fuzzCountFlag}{count}")
	args.push("{fuzzSchedulesFlag}{options.schedules}")
	if options.keep != "" 'keep'
		args.push("{fuzzKeepFlag}{options.keep}")
	end 'keep'
	if options.native 'native'
		args.push(fuzzNativeFlag)
	end 'native'
	if options.proofs 'proofs'
		args.push(fuzzProofsFlag)
	end 'proofs'
	return args
end 'workerArguments'

// runChunk has a worker run the seeds from first, count of them, and adds what it found to the tally. A worker that dies has met an
// internal compiler error in the program of its last marker: that program is a failure, and the seeds before it and after it are run
// by other workers. It says whether it could go on.
function runChunk(options FuzzOptions, first Count, count Count, mutates tally FuzzTally) returns bool
	if count == 0 'none'
		return true
	end 'none'
	let exe = try Process.executablePath() otherwise panic("fuzz: the compiler's own path is unavailable")
	let result = try Subprocess.run(Executable.path(exe.clone()), arguments: workerArguments(options, first: first, count: count)) otherwise panic("fuzz: cannot start a worker")
	var counted = false
	var started = false
	var current = 0 as Count
	let text = withoutCarriageReturns(result.stdout, loneToo: false)
	var start = 0 as Count
	let n = text.byteLength()
	for i in 0 upto n 'bytes'
		if text.byteAt(i) == newlineByte 'line'
			let line = text.sliceBytes(start, endPos: i)
			start = i + 1
			if hasPrefix(line, prefix: workerMarker) 'marker'
				let number = parseSeed(line.sliceBytes(workerMarker.byteLength(), endPos: line.byteLength()))
				if number.isSome() 'seed'
					current = number.unwrap()
					started = true
				end 'seed'
			end 'marker' else if hasPrefix(line, prefix: workerTally) 'counts'
				counted = tally.add(line)
			end 'counts' else 'echo'
				print("{line}\n")
			end 'echo'
		end 'line'
	end 'bytes'
	if counted 'done'
		return true
	end 'done'
	if not started 'unstarted'
		printError("fuzz: a worker ended before its first program: {result.stderr}")
		return false
	end 'unstarted'
	// The seeds before the one that failed ran with no trouble, and run the same again.
	let before = try current - first otherwise panic("fuzz: a worker's marker is before its chunk")
	if not runChunk(options, first: first, count: before, tally: tally) 'beforeAborted'
		return false
	end 'beforeAborted'
	let found = libraryText(options)
	if not found.isSome() 'noLibrary'
		return false
	end 'noLibrary'
	let source = generatedProgram(options, seed: current, library: found.unwrap()).source.clone()
	fail(tally, options: options, seed: current, source: source, message: "internal compiler error: {trimSpace(result.stderr)}")
	let after = try (first + count) - (current + 1) otherwise panic("fuzz: a worker's marker is after its chunk")
	return runChunk(options, first: try current + 1 otherwise panic("fuzz: the seeds pass the largest number"), count: after, tally: tally)
end 'runChunk'

// fuzzSummary prints the counts of a run and gives its exit code: 0 for a run with no failure.
function fuzzSummary(mutates tally FuzzTally, options FuzzOptions) returns ExitCode
	project.sortStrings(tally.rejectedCodes)
	var total = 0 as Count
	var parts = ast.StringList.create(0)
	for i in 0 upto tally.rejectedCodes.count() 'codes'
		let count = tally.rejectedCounts.get(tally.rejectedCodes[i]).unwrap()
		total = try total + count otherwise panic("fuzz: more programs than memory")
		parts.push("{tally.rejectedCodes[i]}:{count}")
	end 'codes'
	if tally.compared > 0 'compared'
		print("{tally.compared} accepted programs also ran as executables with the same output and exit code, {tally.comparedConcurrent} of them scheduling behaviours, each run {nativeBehaviourRuns} times with {workerCountText()}\n")
	end 'compared'
	print("{options.count} programs: {tally.accepted} accepted and clean ({tally.trapped} of them ended in a trap, {tally.timedOut} ran out of steps), {total} rejected by the checker [{fuzz.joinStrings(parts, separator: " ")}], {tally.failures} failed\n")
	if options.proofs 'proofs'
		print("{tally.accesses} accesses in the accepted programs, {tally.proven} of them proven by the analysis\n")
	end 'proofs' else 'schedules'
		print("{tally.planted} of the accepted programs refused, as they must, the shape planted in them\n")
		print("{tally.concurrent} of the accepted programs scheduled behaviours ({tally.behaviours} in all), each under {options.schedules} schedules\n")
	end 'schedules'
	var failed = tally.failures > 0
	let reached = try tally.accepted + tally.failures otherwise panic("fuzz: more programs than memory")
	let wanted = try reached * minAcceptedDivisor otherwise panic("fuzz: more programs than memory")
	if options.count >= minProgramsForAcceptedShare and wanted < options.count 'few'
		print("the checker accepted {reached} of {options.count} programs, fewer than 1 in {minAcceptedDivisor}: a run that accepts almost nothing tests nothing, so the generator or its library no longer follows the language\n")
		failed = true
	end 'few'
	let refusedLimit = try total * maxRefusedDivisor otherwise panic("fuzz: more programs than memory")
	if options.proofs and refusedLimit > options.count 'refused'
		print("the checker refused {total} of {options.count} programs for what it knows of their code, more than 1 in {maxRefusedDivisor}: the generator writes too many accesses that the code makes wrong\n")
		failed = true
	end 'refused'
	let provenWanted = try tally.proven * minProvenDivisor otherwise panic("fuzz: more accesses than memory")
	if options.proofs and tally.accesses > 0 and provenWanted < tally.accesses 'unproven'
		print("the analysis proved {tally.proven} of {tally.accesses} accesses, fewer than 1 in {minProvenDivisor}: a run whose programs prove almost nothing tests no proof, so the generator is biased toward what the analysis refuses\n")
		failed = true
	end 'unproven'
	if failed 'failed'
		if options.keep != "" and tally.failures > 0 'kept'
			print("the programs that failed are in {options.keep}, each as seed<N>.maxon\n")
		end 'kept'
		return diagnosticsExitCode
	end 'failed'
	return 0
end 'fuzzSummary'
