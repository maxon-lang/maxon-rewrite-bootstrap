function loadProjectAt(path String, mutates errs diag.ErrorList) returns ast.Project
	return match consumes project.loadProject(path, errs: errs) 'pr'
		some(pv) gives pv
		none panic("{path}: cannot be loaded")
	end 'pr'
end 'loadProjectAt'

function expectChecked(path String)
	var errs = diag.ErrorList.create(0)
	var p = loadProjectAt(path, errs: errs)
	_ = frontEnd(p, makesProgram: false, errs: errs)
	if errs.count() > 0 'failed'
		ast.locateAllErrors(p.modules, errs: errs)
		panic("{path}: unexpected error {errs[0].format()}")
	end 'failed'
end 'expectChecked'

function expectCheckError(path String, code String, line Count, col Count)
	var errs = diag.ErrorList.create(0)
	var p = loadProjectAt(path, errs: errs)
	_ = frontEnd(p, makesProgram: false, errs: errs)
	ast.locateAllErrors(p.modules, errs: errs)
	if errs.count() == 0 'none'
		panic("{path}: expected {code}, got none")
	end 'none'
	if errs[0].code != code or errs[0].line != line or errs[0].col != col 'where'
		panic("{path}: expected {code} at {line}:{col}, got {errs[0].format()}")
	end 'where'
end 'expectCheckError'

test 'bodies'
	expectChecked("tests/run/generics.maxon")
	expectChecked("tests/run/list-slot-keys.maxon")
	expectChecked("tests/run/slot-key-stack.maxon")
	expectChecked("tests/modules/generics")
	expectChecked("tests/modules/throws")
	expectCheckError("tests/errors/array-create-of-an-element-without-zero.maxon", code: "E3106", line: 5, col: 31)
	expectCheckError("tests/errors/generic-case-without-a-context.maxon", code: "E3179", line: 21, col: 16)
	expectCheckError("tests/errors/generic-conformance-missing-method.maxon", code: "E3016", line: 51, col: 6)
	expectCheckError("tests/errors/expression-statement-not-a-call.maxon", code: "E2001", line: 3, col: 2)
	expectCheckError("tests/errors/block-statement-as-arm-action.maxon", code: "E2049", line: 4, col: 10)
	expectCheckError("tests/errors/clone-of-a-noncopyable-type.maxon", code: "E3918", line: 11, col: 12)
	expectCheckError("tests/errors/generic-bound-not-met-in-a-body.maxon", code: "E3017", line: 52, col: 9)
	expectCheckError("tests/errors/generic-bound-is-not-an-interface.maxon", code: "E3907", line: 51, col: 59)
end 'bodies'

// loadTestFiles is the project of the files, which are given as a path and its text, held in memory in one directory.
function loadTestFiles(files project.SourceFiles, mutates errs diag.ErrorList) returns ast.Project
	var p = ast.Project.new("<project>")
	project.loadFilesInto(p, rootPath: "<project>", files: files, errs: errs)
	return p
end 'loadTestFiles'

test 'files of tests'
	var files = project.SourceFiles.create(0)
	files.push(project.SourceFile.make(project.joinPath("<project>", name: "main.maxon"), text: "function main() returns ExitCode\n\treturn 0\nend 'main'\n"))
	files.push(project.SourceFile.make(project.joinPath("<project>", name: "suite.maxtest"), text: "enum ApiError implements Error\n\tnotFound\nend 'ApiError'\n\nfunction lookup() throws ApiError\n\tthrow ApiError.notFound\nend 'lookup'\n\ntest 'a call that throws needs no try'\n\tlookup()\nend 'a call that throws needs no try'\n\ntest 'a bare try takes any error'\n\ttry lookup()\nend 'a bare try takes any error'\n"))
	var errs = diag.ErrorList.create(0)
	var p = loadTestFiles(files, errs: errs)
	let checked = frontEnd(p, makesProgram: false, errs: errs)
	if errs.count() > 0 'failed'
		ast.locateAllErrors(p.modules, errs: errs)
		panic("test files: unexpected error {errs[0].format()}")
	end 'failed'
	for m in 0 upto checked.functions.count() 'modules'
		for i in 0 upto checked.functions[m].count() 'functions'
			if ast.funcEntry(ast.FuncSlot.none(), funcReads: p.funcs, f: checked.functions[m][i]).isTest 'test'
				panic("a test is among the functions of the program")
			end 'test'
		end 'functions'
	end 'modules'
	var clash = project.SourceFiles.create(0)
	clash.push(project.SourceFile.make(project.joinPath("<project>", name: "main.maxon"), text: "function main() returns ExitCode\n\treturn 0\nend 'main'\n"))
	clash.push(project.SourceFile.make(project.joinPath("<project>", name: "suite.maxtest"), text: "test 'adds two'\n\tlet x = 1\nend 'adds two'\n\ntest 'adds-two'\n\tlet y = 1\nend 'adds-two'\n"))
	var clashErrs = diag.ErrorList.create(0)
	var q = loadTestFiles(clash, errs: clashErrs)
	_ = frontEnd(q, makesProgram: false, errs: clashErrs)
	ast.locateAllErrors(q.modules, errs: clashErrs)
	if clashErrs.count() == 0 or clashErrs[0].code != "E3107" 'clash'
		panic("two tests that compile to one symbol are not refused")
	end 'clash'
	var outside = project.SourceFiles.create(0)
	outside.push(project.SourceFile.make(project.joinPath("<project>", name: "main.maxon"), text: "test 'a test'\n\tlet x = 1\nend 'a test'\n\nfunction main() returns ExitCode\n\treturn 0\nend 'main'\n"))
	var outsideErrs = diag.ErrorList.create(0)
	var r = loadTestFiles(outside, errs: outsideErrs)
	ast.locateAllErrors(r.modules, errs: outsideErrs)
	if outsideErrs.count() == 0 or outsideErrs[0].code != "E2058" 'outside'
		panic("a test outside a file of tests is not refused")
	end 'outside'
end 'files of tests'
