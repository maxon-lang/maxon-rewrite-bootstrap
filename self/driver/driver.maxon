export let usageExitCode = 2 as ExitCode

let diagnosticsExitCode = 1 as ExitCode

let emitIrFlag = "--emit-ir"

let emitMapFlag = "--emit-map"

let verifyIrFlag = "--verify-ir"

let timingsFlag = "--timings"

let traceFlag = "--trace="

let countAllocationsFlag = "--count-allocations"

// debugInfoFlag writes the debug info sidecar beside the executable; noDebugInfoFlag, maxon's, writes none, as a build does
// by default.
let debugInfoFlag = "--debug-info"

let noDebugInfoFlag = "--no-debug-info"

let reverseModulesFlag = "--reverse-modules"

let verifyReadsFlag = "--verify-reads"

let verifyCacheFlag = "--verify-cache"

let testsFlag = "--tests"

let outputFlag = "-o"

let targetFlag = "--target="

let irExtension = ".ir"

let mapExtension = ".map"

typealias CommandNames = Array with String

export function usage() returns String
	return "usage:\n  build <file.maxon|dir> [-o out.exe]   compile to an executable of the target\n  run <file.maxon|dir>                  compile and run\n  check [--tests] <file.maxon|dir>      report diagnostics only; --tests also checks the files of tests (.maxtest) of\n                                        every module\n  test [--update-positions] [--compile-only] [dir]\n                                        run the corpus of tests (default: the nearest tests directory); --compile-only compiles\n                                        every program and runs none\n  test <specs> [--require-passed|--skip-passed] [--record-passed]\n                                        run maxon's spec tests: failing if a test of specs/passed.txt does not pass, or leaving\n                                        them out; and writing the list again with the tests that pass\n  test <specs> --compile-only [--target=<arch>-<os>]\n                                        compile every spec test and run none, failing where one does not compile as its blocks\n                                        say and the host's compile of it does\n  interp <file.maxon|dir> [--seed=N]    run under the tracking interpreter (development only)\n  fuzz [--seed=N] [--count=N] [--schedules=N] [--keep=DIR] [--native] [--proofs] [--services] [--dump]\n                                        write random programs, check them and run them under the interpreter; --services runs\n                                        the send graphs of up to four services under the oracles of backpressure (development only)\n  rewrite --keyword=old=new <path>...   rename a keyword in the .maxon files and the code in the .md files under the paths\n  fmt [--check] <path>...               put the .maxon files and the Maxon code in the .md files in the one layout\n  fix [--check] <path>...               apply the fix that each diagnostic names, to a fixpoint, in a .maxon file, a project or\n                                        the maxon blocks of the tests of spec files\n  qualify <dir>...                      write the module before each name of another module's declaration in the projects\n  ircount <file.ir> (op=NAME|call=SYMBOL)...\n                                        count the lines of an --emit-ir file that are the operation, or call the symbol\n  rename [--prelude=f,...] [--rules=file] <rule>... <program>...\n                                        rename built-in types and method calls by what the checker resolved\n  test <module dir> [--compile-only]    run the tests of the modules under the directory (the files of tests, .maxtest);\n                                        --compile-only builds their executable for the target and runs nothing\n  selftest [--compile-only]             run the compiler's own tests: test self\n  cache [trim|clear]                    say where the build cache is and what it holds; delete what was unused for five days,\n                                        or everything\n  debug --symbolize <exe> <offset|rip=0xADDR>...\n                                        name the function, file:line:column and inlined calls of code offsets of an executable\n                                        built with --debug-info, or of the address of a fault line\n  debug --dump-info <exe> [header|files|functions|types|lines|inline|layout]...\n                                        print the debug info that a build with --debug-info wrote beside an executable\n  debug --batch --commands=<cmd;cmd;...|@file> [--stop-timeout=<seconds>] <exe> [-- <program args>...]\n                                        debug an executable built with --debug-info, on x64 Windows: run the commands (break,\n                                        clear, run, continue, step, next, finish, backtrace, print, locals, help, quit) and\n                                        write one JSON event per line\n  debug [--stop-timeout=<seconds>] <exe> [-- <program args>...]\n                                        debug it in a conversation: read the commands from standard input after the\n                                        prompt '(maxon debug) ' and answer each in text\n\n--target=<arch>-<os> compiles for x64-windows, x64-linux or arm64-linux (a static ELF executable that needs no library), and test runs the\ncorpus for it, with --verify-ir verifying each program's compile; the default is the system the compiler runs on. --emit-ir writes the IR beside the executable, as <out>.ir; --verify-ir checks the IR of every function against the verifier's rules\nbefore code is made and its register allocation against its invariants, and stops at the first function that breaks one; --emit-map writes the map of its code symbols, as <out>.map, which\ncmd/sample profiles with. --debug-info writes the executable's debug info beside it, as <out>.mxdbg, and leaves the executable as it is (it compiles\nwithout the build cache); --no-debug-info writes none, as a build does by default. --timings prints the time of each stage and of the slowest modules on standard error. --trace=<file> writes the timeline\nof a build or check's tasks to the file in Chrome's trace format. --count-allocations builds executables that count their live heap boxes and fail at exit with\ncode 99 if any is left (development only). --reverse-modules runs the modules of each stage in another order that keeps each after the\nmodules it names, which must make the same executable (development only). --verify-reads stops a compile at a task's read of a type or function\nentry that a stage it did not wait on made (development only). --update-positions makes test rewrite the position of an expect-error whose code\nwas reported at another place. build and test of modules keep each module's code in the build cache (MINIMAXON_CACHE names its directory, or is off for none;\n%LOCALAPPDATA%\\minimaxon\\cache otherwise) and link a module whose key is unchanged from it; --verify-cache compiles every\nmodule and stops at the first whose code or summary differs from the entry under its key (development only).\n"
end 'usage'

// absentFlagPrefixes start the flags that other compilers of the language have and this one does not.
function absentFlagPrefixes() returns CommandNames
	var prefixes = CommandNames.create(0)
	prefixes.push("--jobs=")
	prefixes.push("--with=")
	return prefixes
end 'absentFlagPrefixes'

// absentCommands are the commands that other compilers of the language have and this one does not.
function absentCommands() returns CommandNames
	return CommandNames.create(0)
end 'absentCommands'

// hasAbsentFlag is whether some argument is a flag that this compiler does not have, and says so.
function hasAbsentFlag(args Array with String) returns bool
	let prefixes = absentFlagPrefixes()
	for i in 1 upto args.count() 'args'
		for j in 0 upto prefixes.count() 'prefixes'
			if hasPrefix(args[i], prefix: prefixes[j]) 'absent'
				printError("the flag '{args[i]}' does not exist in this compiler\n{usage()}")
				return true
			end 'absent'
		end 'prefixes'
	end 'args'
	return false
end 'hasAbsentFlag'

// Options say how a program is compiled to an executable.
type Options
	// emitIr writes the IR of every function beside the executable, as <output>.ir.
	var emitIr as bool
	// keepsIrText keeps the text of that IR (ir.moduleIrText) in what the compile generated, for a test of the IR to read without a file; it is for a compile without the build cache, as a test is.
	var keepsIrText as bool
	// verifyIr checks the IR of every function with the verifier before any code is made.
	var verifyIr as bool
	// emitMap writes the map of the executable's code symbols beside it, as <output>.map.
	var emitMap as bool
	// countAllocations makes the executable count its live heap boxes and fail at exit if any is left.
	var countAllocations as bool
	// debugInfo writes the executable's debug info beside it, as <output>.mxdbg (README, "Debug info").
	var debugInfo as bool
	// timings prints the time of each stage and of the slowest modules on standard error when the compile ends.
	var timings as bool
	// trace is the file that the timeline of a build or check's tasks is written to, or nothing.
	var trace as String
	// keepsLowered keeps the IR as lowered, before the optimizer changes it for codegen, for the interpreter to run after
	// the executable is made, as a test does.
	var keepsLowered as bool
	// reversesModules runs the modules of each stage in another order that keeps each after the modules it names, which
	// shows that what a compile makes does not depend on that order.
	var reversesModules as bool
	// verifiesReads names the task that reads a type or function entry that is the product of a stage it did not wait on,
	// which is a fault of the task graph.
	var verifiesReads as bool
	// runsTests makes the compile one of tests: the modules under testsUnder are read with their files of tests, which are
	// lowered with them, only they and the modules they name are compiled past the resolve, and the executable, whose entry
	// calls each test, is run when the compile ends, unless compilesTestsOnly, which makes the executable for the target,
	// through code generation, and runs nothing.
	var runsTests as bool
	var testsUnder as String
	var compilesTestsOnly as bool
	// checksTests makes a check read every module's files of tests with its source, so that they are held to the same rules.
	var checksTests as bool
	// cacheDir is the build cache's directory, or nothing for a compile that uses none; compiler is the digest of the compiler
	// that every key holds; verifiesCache compiles every module and holds what it makes to the entries the cache has.
	var cacheDir as String
	var compiler as table.Digest
	var verifiesCache as bool
	// speculates lets the compile take a module's summary from before it is lowered (CacheSetup.speculates).
	var speculates as bool
	// target is the platform the executable is made for, and whose branches of a #if the compile reads.
	var target as ast.Target
	// stagesInLibrary compiles the program's modules in the library tier, as maxon's spec runner compiles a case marked
	// `tier: stdlib`: they may name maxon's raw surface.
	var stagesInLibrary as bool
	// skimsBodies parses the modules with the bodies of their functions skimmed (syntax.parseModuleFilesSkimming), for a compile
	// whose modules' units the cache holds, which needs none of them (prepareRuntime); a module whose bodies its compile then
	// needs fails it (skimmedBodyNeeded).
	var skimsBodies as bool

	static function new() returns Options
		return Options{emitIr: false, keepsIrText: false, verifyIr: false, emitMap: false, countAllocations: false, debugInfo: false, keepsLowered: false, timings: false, trace: "", reversesModules: false, verifiesReads: false, runsTests: false, testsUnder: "", compilesTestsOnly: false, checksTests: false, cacheDir: "", compiler: table.Digest.none(), verifiesCache: false, speculates: false, target: hostTarget(), stagesInLibrary: false, skimsBodies: false}
	end 'new'

	// timesTasks is whether a compile reads the clock around each task, for --timings or --trace.
	function timesTasks() returns bool
		return timings or trace != ""
	end 'timesTasks'
end 'Options'

// run is the compiler's command line; args holds the program's own name first, as CommandLine.args() gives it. The flags
// may stand anywhere after it.
export function run(args Array with String) returns ExitCode
	if hasAbsentFlag(args) 'absentFlag'
		return usageExitCode
	end 'absentFlag'
	var options = Options.new()
	var rest = CommandNames.create(0)
	for i in 1 upto args.count() 'flags'
		if args[i] == emitIrFlag 'emitIr'
			options.emitIr = true
		end 'emitIr' else if args[i] == verifyIrFlag 'verifyIr'
			options.verifyIr = true
		end 'verifyIr' else if args[i] == emitMapFlag 'emitMap'
			options.emitMap = true
		end 'emitMap' else if args[i] == countAllocationsFlag 'count'
			options.countAllocations = true
		end 'count' else if args[i] == debugInfoFlag 'debugInfo'
			options.debugInfo = true
		end 'debugInfo' else if args[i] == noDebugInfoFlag 'noDebugInfo'
			options.debugInfo = false
		end 'noDebugInfo' else if args[i] == reverseModulesFlag 'reverse'
			options.reversesModules = true
		end 'reverse' else if args[i] == verifyReadsFlag 'verifyReads'
			options.verifiesReads = true
		end 'verifyReads' else if args[i] == verifyCacheFlag 'verifyCache'
			options.verifiesCache = true
		end 'verifyCache' else if args[i] == testsFlag 'tests'
			options.checksTests = true
		end 'tests' else if args[i] == timingsFlag 'timings'
			options.timings = true
		end 'timings' else if hasPrefix(args[i], prefix: traceFlag) 'trace'
			options.trace = args[i].sliceBytes(traceFlag.byteLength(), endPos: args[i].byteLength()).clone()
		end 'trace' else if hasPrefix(args[i], prefix: targetFlag) 'target'
			let name = args[i].sliceBytes(targetFlag.byteLength(), endPos: args[i].byteLength())
			let named = targetNamed(name)
			if not named.isSome() 'unknown'
				printError("error: unknown --target '{name}' (expected one of: {targetRoster()})\n")
				return diagnosticsExitCode
			end 'unknown'
			options.target = named.unwrap()
		end 'target' else 'argument'
			rest.push(args[i].clone())
		end 'argument'
	end 'flags'
	if rest.count() == 0 'bare'
		printError(usage())
		return usageExitCode
	end 'bare'
	let command = rest[0].clone()
	if isAbsentCommand(command) 'absentCommand'
		printError("the command '{command}' does not exist in this compiler\n{usage()}")
		return usageExitCode
	end 'absentCommand'
	let unknown = firstUnknownFlag(rest)
	if unknown.isSome() 'unknownFlag'
		printError("the argument '{unknown.unwrap()}' is not a flag of the command '{command}'\n{usage()}")
		return usageExitCode
	end 'unknownFlag'
	if runsAtBackgroundPriority(command) 'background'
		_ = Process.enterBackgroundPriority()
	end 'background'
	if command == "test" 'test'
		return testCommand(rest, given: options)
	end 'test'
	if command == selftestCommandName 'selftest'
		return selftestCommand(rest, given: options)
	end 'selftest'
	if command == "fuzz" 'fuzz'
		return fuzzCommand(rest)
	end 'fuzz'
	if command == "rewrite" 'rewrite'
		return rewriteCommand(rest)
	end 'rewrite'
	if command == "fix" 'fix'
		return fixCommand(rest)
	end 'fix'
	if command == "qualify" 'qualify'
		return qualifyCommand(rest)
	end 'qualify'
	if command == "rename" 'rename'
		return renameCommand(rest)
	end 'rename'
	if command == "ircount" 'ircount'
		return irCountCommand(rest)
	end 'ircount'
	if command == "cache" 'cache'
		return cacheCommand(rest)
	end 'cache'
	if command == "debug" 'debug'
		return debugCommand(rest)
	end 'debug'
	if rest.count() < 2 'unnamed'
		printError(usage())
		return usageExitCode
	end 'unnamed'
	let path = rest[1].clone()
	if command == "check" 'check'
		return buildPath(path, output: "", options: options)
	end 'check'
	if command == "build" 'build'
		var output = defaultOutput(path, suffix: executableExtension(options.target))
		if rest.count() >= 4 and rest[2] == outputFlag 'named'
			output = rest[3].clone()
		end 'named'
		return buildPath(path, output: output, options: withCache(options))
	end 'build'
	if command == "run" 'runCommand'
		return runProgram(path, options: options)
	end 'runCommand'
	if command == "fmt" 'fmt'
		return formatCommand(rest)
	end 'fmt'
	if command == "interp" 'interp'
		return interpCommand(rest)
	end 'interp'
	printError(usage())
	return usageExitCode
end 'run'

let dashByte = 45 as Byte

// commandFlags are the flags that a command reads from the arguments after its name, beside the options of Options, which the
// loop of run takes from every command's arguments. A flag that ends in = is the start of an argument that holds the value.
function commandFlags(command String) returns CommandNames
	var flags = CommandNames.create(0)
	if command == "build" 'build'
		flags.push(outputFlag)
	end 'build' else if command == "test" 'test'
		flags.push(executablesFlag)
		flags.push(runnerFlag)
		flags.push(workerCountsFlag)
		flags.push(envRunnerFlag)
		flags.push(verboseFlag)
		flags.push(updatePositionsFlag)
		flags.push(behavioursFlag)
		flags.push(compileOnlyFlag)
		flags.push(interpretFlag)
		flags.push(repeatFlag)
		flags.push(recordPassedFlag)
		flags.push(skipPassedFlag)
		flags.push(requirePassedFlag)
		flags.push(saveResultsFlag)
		flags.push(replayResultsFlag)
	end 'test' else if command == selftestCommandName 'selftest'
		flags.push(compileOnlyFlag)
	end 'selftest' else if command == "fuzz" 'fuzz'
		flags.push(fuzzSeedFlag)
		flags.push(fuzzCountFlag)
		flags.push(fuzzSchedulesFlag)
		flags.push(fuzzKeepFlag)
		flags.push(fuzzDumpFlag)
		flags.push(fuzzNativeFlag)
		flags.push(fuzzProofsFlag)
		flags.push(fuzzWorkerFlag)
		flags.push(fuzzServicesFlag)
	end 'fuzz' else if command == "interp" 'interp'
		flags.push(seedFlagPrefix)
		flags.push(freesFlag)
	end 'interp' else if command == "rewrite" 'rewrite'
		flags.push(keywordFlagPrefix)
	end 'rewrite' else if command == "fmt" or command == "fix" 'check'
		flags.push(checkFlag)
	end 'check' else if command == "rename" 'rename'
		flags.push(rulesFlagPrefix)
		flags.push(preludeFlagPrefix)
	end 'rename' else if command == "debug" 'debug'
		flags.push(symbolizeFlag)
		flags.push(dumpInfoFlag)
		flags.push(batchFlag)
		flags.push(commandsPrefix)
		flags.push(stopTimeoutPrefix)
	end 'debug'
	return flags
end 'commandFlags'

// takesFlag is whether the argument is one of the flags, or starts with one that ends in =.
function takesFlag(flags CommandNames, arg String) returns bool
	for i in 0 upto flags.count() 'flags'
		let last = flags[i].byteAt(try flags[i].byteLength() - 1 otherwise 0)
		if last == equalsByte and hasPrefix(arg, prefix: flags[i]) 'valued'
			return true
		end 'valued'
		if arg == flags[i] 'named'
			return true
		end 'named'
	end 'flags'
	return false
end 'takesFlag'

// firstUnknownFlag is the first argument after the command's name that starts with - and is not a flag of the command, so that
// a misspelled flag or one the compiler no longer has is an error, never a path or an argument that is ignored. A lone - is no
// flag, and the arguments after programArgumentsMark are the program's.
function firstUnknownFlag(rest CommandNames) returns table.Option with String
	let flags = commandFlags(rest[0])
	for i in 1 upto rest.count() 'arguments'
		if rest[i] == programArgumentsMark 'program'
			break 'arguments'
		end 'program'
		if rest[i].byteLength() > 1 and rest[i].byteAt(0) == dashByte and not takesFlag(flags, arg: rest[i]) 'unknown'
			return table.Option.some(rest[i].clone())
		end 'unknown'
	end 'arguments'
	return table.Option.none
end 'firstUnknownFlag'

function isAbsentCommand(name String) returns bool
	let names = absentCommands()
	for i in 0 upto names.count() 'each'
		if names[i] == name 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'isAbsentCommand'

// runsAtBackgroundPriority is whether a command is one that keeps every core busy: it puts the compiler's own process at
// background priority before it starts anything, so a foreground job preempts it, and the compilers and executables it
// starts inherit that. `run` is not one, since the program it starts is the user's.
function runsAtBackgroundPriority(command String) returns bool
	return command == "test" or command == "selftest" or command == "fuzz" or command == "build" or command == "check"
end 'runsAtBackgroundPriority'

// defaultOutput is the executable a build of path makes when no -o names one: the path without its extension and with the
// executable's.
function defaultOutput(path String, suffix String) returns String
	var finish = path.byteLength()
	while finish > 0 and isSeparator(path.byteAt(finish - 1)) 'trim'
		finish = finish - 1
	end 'trim'
	let trimmed = path.sliceBytes(0, endPos: finish)
	var at = finish
	while at > 0 'back'
		let before = at - 1
		let c = trimmed.byteAt(before)
		if isSeparator(c) 'separator'
			break 'back'
		end 'separator'
		if c == dotByte 'extension'
			return "{trimmed.sliceBytes(0, endPos: before)}{suffix}"
		end 'extension'
		at = before
	end 'back'
	return "{trimmed}{suffix}"
end 'defaultOutput'

let slashByte = 47 as Byte

let backslashByte = 92 as Byte

let dotByte = 46 as Byte

function isSeparator(c Byte) returns bool
	return c == slashByte or c == backslashByte
end 'isSeparator'

// runProgram builds the program to a temporary executable, runs it and passes on what it wrote and its exit code.
function runProgram(path String, options Options) returns ExitCode
	let exe = temporaryExecutable(path, suffix: executableExtension(options.target))
	let built = compilePath(path, output: exe, options: options)
	if built != 0 'failed'
		return built
	end 'failed'
	let exePath = try FilePath.from(exe) otherwise panic("driver: the temporary executable has no path")
	let out = try Subprocess.run(Executable.path(exePath.clone()), arguments: CommandNames.create(0)) otherwise panic("driver: cannot run {exe}")
	print(out.stdout)
	printError(out.stderr)
	try File.delete(exePath) otherwise panic("driver: cannot delete {exe}")
	return out.exitCode()
end 'runProgram'

// temporaryExecutable is where run builds the program at path: in the temporary directory, named after the process and the
// program, so that two compilers running at once never write the same file.
function temporaryExecutable(path String, suffix String) returns String
	let name = defaultOutput(path, suffix: suffix)
	var at = name.byteLength()
	while at > 0 and not isSeparator(name.byteAt(at - 1)) 'back'
		at = at - 1
	end 'back'
	return ast.temporaryPath("minimaxon-run-{Process.id()}-{name.sliceBytes(at, endPos: name.byteLength())}")
end 'temporaryExecutable'

// checkPath runs the front end over the project at path and prints its diagnostics.
export function checkPath(path String) returns ExitCode
	return compilePath(path, output: "", options: Options.new())
end 'checkPath'

function report(mutates errs diag.ErrorList) returns ExitCode
	diag.sortErrors(errs)
	for i in 0 upto errs.count() 'each'
		printError("{errs[i].format()}\n")
	end 'each'
	if errs.count() == 0 'clean'
		return 0
	end 'clean'
	return diagnosticsExitCode
end 'report'
