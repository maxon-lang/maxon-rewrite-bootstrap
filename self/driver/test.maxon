// The test runner: minimaxon's `test` command, which compiles and runs the corpus in this process.

let testsDirName = "tests"

let modulesDir = "modules"

// The programs of this directory are benchmarks: bench.ps1 builds and times them, and the runner leaves them out, since
// they run for long enough to measure and the interpreter would run them far slower.
let benchDir = "bench"

// The programs of this directory of the corpus are only compiled: one that expects no error must compile clean, and none is run.
let checkOnlyDir = "check"

// The programs of this directory are tests of the runtime: each is compiled as a file of the runtime's module, so that it
// may call what no program can, and is run natively only, since the interpreter does not run the runtime's source.
let runtimeTierDir = "runtime"

// The programs of this directory are staged in the library tier, as maxon's spec runner stages a case marked `tier: stdlib`, so
// that they may go through the doors of maxon's raw surface (README, "Modules"), the buffer cursor among them.
let libraryTierDir = "library"

// The programs of this directory are held to claims about the optimized IR of their functions (self/driver/irexpect.maxon): each
// must compile clean and carry expect-ir directives, and none is run. The IR is the host's, so a run for another target leaves them out.
let irTierDir = "ir"

let sourceExtension = ".maxon"

let expectErrorPrefix = "// expect-error:"

let expectFreePrefix = "// expect-free:"

let expectExitPrefix = "// expect-exit:"

let expectStdoutPrefix = "//>"

let expectMemoryPrefix = "// memory-limit:"

let nativeOnlyDirective = "// native-only"

// A program that holds every processor while it runs, as a test of preemption does, runs with the machine to itself: once every
// other test has ended, with no executable and no compile of another test beside it, and each such program after the one before it,
// so that the run drains once for all of them. As a spec test of maxon's that says `runs: alone` does: beside it, a program
// whose run is a chain of short waits on the system, such as one that starts a hundred children one after another, waits a slice
// for each and outlives its deadline, or one that measures a wake within a few milliseconds.
let runsAloneDirective = "// runs: alone"

// A program that runs for long, which a run of the corpus leaves out unless it is given the --manual flag, or the program's own
// path: the runner names it in the summary, as one it left out. The gate runs none of them (README, "Tests").
let runsManualDirective = "// runs: manual"

// Each line of this directive is a line of the program's standard input, as maxon's spec tests feed one; a program without one
// reads the end of its input at once.
let stdinPrefix = "// stdin:"

// A program that says the targets it does not run on, as a spec test of maxon's does, is not run for them: it reads what is
// another system's only, as a path of Windows or a program that Windows has.
let unsupportedTargetsPrefix = "// unsupported-targets:"

let schedulesPrefix = "// schedules:"

// A program may say whether its link gives it the scheduler (self/backend/start.maxon), which nothing it does can show: a
// program without it runs on the main thread alone.
let expectSchedulerPrefix = "// expect-scheduler:"

let schedulerUsed = "used"

let schedulerUnused = "none"

// The words of which every program that runs the scheduler has one in one of its files: a behaviour's when, a coroutine's
// async, a sleep, the Scheduler's yield, and a parallel loop. A run of the behaviours alone compiles only the programs that have one, and
// the link then says which of them run the scheduler.
let whenWord = "when"

let asyncWord = "async"

let sleepWord = "sleep"

let schedulerWord = "Scheduler"

let parallelWord = "parallel"

// A file of this extension is a case of the fix command: a program that, fixed, must check clean and be the text of the
// file beside it with the other extension.
let fixCaseExtension = ".fix"

let fixedExtension = ".fixed"

// fixCaseRounds is the most rounds of fixes a fix case may take: a round makes every fix that the diagnostics name and that
// can be made together, and the check names every missing try of a function at once, so only a fix that another one's
// makes needed takes a second round. A case that takes more fixes one thing a round, as a check that stops at the first
// failure of a function made fix do once.
let fixCaseRounds = 2 as Count

let errorLocationSplit = " at "

// The UTF-8 byte order mark: EF BB BF.
let byteOrderMarkBytes = 3 as Count

let carriageReturnByte = 13 as Byte

let newlineByte = 10 as Byte

let spaceByte = 32 as Byte

let zeroByte = 48 as Byte

let nineByte = 57 as Byte

let tabByte = 9 as Byte

// The width of the text after "//>" that is the program's stdout: one space after the marker belongs to the marker.
let stdoutMarkerBytes = 3 as Count

// An exit code at or above this is a negative number to the system, and is printed as one.
let signBit = 2147483648

let exitCodeRange = 4294967296

let decimalBase = 10 as Count

// Expectation is what the directives of a test program say.
type Expectation
	var errors as ast.StringList
	var exit as ExitCode
	var stdout as String
	// stdin is what the program reads as its standard input.
	var stdin as String
	var memoryLimitMB as Count
	var nativeOnly as bool
	// runsAlone is whether the program's executable runs with no other test's running (runsAloneDirective).
	var runsAlone as bool
	// manual is whether the program says it is run by hand (runsManualDirective).
	var manual as bool
	// frees is the order in which the interpreter must free the values of the program, when the program says it.
	var frees as ast.StringList
	var checkOnly as bool
	var runtimeTier as bool
	var libraryTier as bool
	// irClaims are the texts of the program's expect-ir directives, and irTier is whether the program is one that those hold.
	var irClaims as ast.StringList
	var irTier as bool
	// schedules is how many schedules of its behaviours the interpreter runs the program under, which a program that
	// schedules so many that every seed would cost seconds lowers.
	var schedules as Count
	// mentionsConcurrency is whether a file of the program has a word that every program that runs the scheduler has,
	// without which it does not run the scheduler.
	var mentionsConcurrency as bool
	// unsupportedTargets are the names of the targets the program does not run on, separated by commas.
	var unsupportedTargets as String
	// saysScheduler is whether the program says whether its link gives it the scheduler, and scheduled what it says.
	var saysScheduler as bool
	var scheduled as bool

	static function new() returns Expectation
		return Expectation{errors: ast.StringList.create(0), exit: 0, stdout: "", stdin: "", memoryLimitMB: 0, nativeOnly: false, runsAlone: false, manual: false, frees: ast.StringList.create(0), checkOnly: false, runtimeTier: false, libraryTier: false, irClaims: ast.StringList.create(0), irTier: false, schedules: scheduleSeeds, mentionsConcurrency: false, unsupportedTargets: "", saysScheduler: false, scheduled: false}
	end 'new'
end 'Expectation'

// TestOutcome is how a test of the corpus ended. A test that the compiler cannot attempt yet is unsupported, which is
// neither a pass nor a failure, one that a run of the behaviours alone finds schedules none is left out of it, and one that is
// run by hand (runsManualDirective) is left out of a run that does not ask for it, and is named in its summary.
enum TestOutcome
	testPassed
	testFailed
	testUnsupported
	testLeftOut
	testManual
end 'TestOutcome'

// TestResult is the outcome of a test with what to say of it: what failed, or why an unsupported test is.
type TestResult
	var outcome as TestOutcome
	var detail as String
	// runNanos is how long all the runs of the executable of a test that passed took, and runs how many they were, and
	// interpretedNanos how long the interpreter took: the report of the slowest tests (Slowest) divides the first by the second.
	var runNanos as Count
	var runs as Count
	var interpretedNanos as Count

	static function passed() returns TestResult
		return TestResult{outcome: TestOutcome.testPassed, detail: "", runNanos: 0, runs: 0, interpretedNanos: 0}
	end 'passed'

	static function failed(consumes detail String) returns TestResult
		return TestResult{outcome: TestOutcome.testFailed, detail: detail, runNanos: 0, runs: 0, interpretedNanos: 0}
	end 'failed'

	static function unsupported(consumes reason String) returns TestResult
		return TestResult{outcome: TestOutcome.testUnsupported, detail: reason, runNanos: 0, runs: 0, interpretedNanos: 0}
	end 'unsupported'

	static function leftOut() returns TestResult
		return TestResult{outcome: TestOutcome.testLeftOut, detail: "", runNanos: 0, runs: 0, interpretedNanos: 0}
	end 'leftOut'

	static function manual() returns TestResult
		return TestResult{outcome: TestOutcome.testManual, detail: "", runNanos: 0, runs: 0, interpretedNanos: 0}
	end 'manual'
end 'TestResult'

function hasPrefix(text String, prefix String) returns bool
	let n = prefix.byteLength()
	if text.byteLength() < n 'short'
		return false
	end 'short'
	return text.sliceBytes(0, endPos: n) == prefix
end 'hasPrefix'

function isSpaceByte(c Byte) returns bool
	return c == spaceByte or (c >= tabByte and c <= carriageReturnByte)
end 'isSpaceByte'

function trimLeft(text String) returns borrowed String
	var start = 0 as Count
	let n = text.byteLength()
	while start < n and isSpaceByte(text.byteAt(start)) 'skip'
		start = start + 1
	end 'skip'
	return text.sliceBytes(start, endPos: n)
end 'trimLeft'

function trimSpace(text String) returns borrowed String
	var start = 0 as Count
	var finish = text.byteLength()
	while start < finish and isSpaceByte(text.byteAt(start)) 'skipLeft'
		start = start + 1
	end 'skipLeft'
	while finish > start and isSpaceByte(text.byteAt(finish - 1)) 'skipRight'
		finish = finish - 1
	end 'skipRight'
	return text.sliceBytes(start, endPos: finish)
end 'trimSpace'

// matchesAt is whether needle stands in text at the byte at.
function matchesAt(text String, at Count, needle String) returns bool
	let room = try text.byteLength() - at otherwise return false
	if needle.byteLength() > room 'short'
		return false
	end 'short'
	for i in 0 upto needle.byteLength() 'bytes'
		let position = try at + i otherwise return false
		if text.byteAt(position) != needle.byteAt(i) 'differs'
			return false
		end 'differs'
	end 'bytes'
	return true
end 'matchesAt'

// findText is where needle first stands in text.
function findText(text String, needle String) returns table.Option with Count
	for at in 0 upto text.byteLength() 'scan'
		if matchesAt(text, at: at, needle: needle) 'found'
			return table.Option.some(at)
		end 'found'
	end 'scan'
	return table.Option.none
end 'findText'

// parseCount is the number that text writes in decimal digits.
function parseCount(text String) returns table.Option with Count
	if text.byteLength() == 0 'empty'
		return table.Option.none
	end 'empty'
	var value = 0 as Count
	for i in 0 upto text.byteLength() 'digits'
		let c = text.byteAt(i)
		if c < zeroByte or c > nineByte 'notDigit'
			return table.Option.none
		end 'notDigit'
		let digit = (c - zeroByte) as Count
		value = try value * decimalBase + digit otherwise return table.Option.none
	end 'digits'
	return table.Option.some(value)
end 'parseCount'

// withoutCarriageReturns is text with each CRLF made LF, and each lone CR too when loneToo is set.
function withoutCarriageReturns(text String, loneToo bool) returns String
	var out = ByteArray.create(0)
	let n = text.byteLength()
	for i in 0 upto n 'bytes'
		let c = text.byteAt(i)
		if c != carriageReturnByte 'plain'
			out.push(c)
		end 'plain' else if not (i + 1 < n and text.byteAt(i + 1) == newlineByte) 'lone'
			// The CR of a CRLF goes; a lone one is an LF where loneToo is set.
			out.push(newlineByte if loneToo else c)
		end 'lone'
	end 'bytes'
	return String.from(out)
end 'withoutCarriageReturns'

function hasByteOrderMark(text String) returns bool
	return text.byteLength() >= byteOrderMarkBytes and text.byteAt(0) == 0xEF and text.byteAt(1) == 0xBB and text.byteAt(2) == 0xBF
end 'hasByteOrderMark'

// readLines is the lines of a file, whatever its line endings, without a byte order mark.
function readLines(path String) returns ast.StringList
	let filePath = try FilePath.from(path) otherwise panic("test: {path} is not a path")
	let content = try File.readText(filePath) otherwise panic("test: cannot read {path}")
	var text = content.clone()
	if hasByteOrderMark(text) 'bom'
		text = text.sliceBytes(byteOrderMarkBytes, endPos: text.byteLength()).clone()
	end 'bom'
	return splitLines(withoutCarriageReturns(text, loneToo: true))
end 'readLines'

// splitLines is the lines of a text, which end at each newline; a text that ends in one has an empty last line.
function splitLines(text String) returns ast.StringList
	return splitAtByte(text, separator: newlineByte)
end 'splitLines'

// splitAtByte is the pieces of text between its bytes equal to separator, which are one more than those bytes.
function splitAtByte(text String, separator Byte) returns ast.StringList
	var lines = ast.StringList.create(0)
	var start = 0 as Count
	let n = text.byteLength()
	for i in 0 upto n 'scan'
		if text.byteAt(i) == separator 'cut'
			lines.push(text.sliceBytes(start, endPos: i).clone())
			start = i + 1
		end 'cut'
	end 'scan'
	lines.push(text.sliceBytes(start, endPos: n).clone())
	return lines
end 'splitAtByte'

// directiveNumber is the number a directive's text holds, for the directive that file has on one of its lines.
function directiveNumber(text String, file String, directive String) returns Count
	return match consumes parseCount(trimSpace(text)) 'number'
		some(n) gives n
		none panic("test: {file}: malformed {directive}")
	end 'number'
end 'directiveNumber'

function afterPrefix(line String, prefix String) returns borrowed String
	return line.sliceBytes(prefix.byteLength(), endPos: line.byteLength())
end 'afterPrefix'

// afterMarkerSpace is the text of a directive after the one space that follows its marker, so that what the directive holds may
// start or end with spaces of its own.
function afterMarkerSpace(text String) returns String
	if text.byteLength() > 0 and text.byteAt(0) == spaceByte 'space'
		return text.sliceBytes(1, endPos: text.byteLength()).clone()
	end 'space'
	return text.clone()
end 'afterMarkerSpace'

// applyDirective adds what one line of a test program says, when it is a directive, to the expectation.
function applyDirective(mutates expect Expectation, mutates stdout ByteArray, mutates stdin ByteArray, line String, file String)
	if hasPrefix(line, prefix: expectErrorPrefix) 'error'
		expect.errors.push(trimSpace(afterPrefix(line, prefix: expectErrorPrefix)).clone())
	end 'error' else if hasPrefix(line, prefix: expectIrPrefix) 'ir'
		expect.irClaims.push(trimSpace(afterPrefix(line, prefix: expectIrPrefix)).clone())
	end 'ir' else if hasPrefix(line, prefix: expectFreePrefix) 'free'
		expect.frees.push(afterMarkerSpace(afterPrefix(line, prefix: expectFreePrefix)))
	end 'free' else if hasPrefix(line, prefix: expectExitPrefix) 'exit'
		let n = directiveNumber(afterPrefix(line, prefix: expectExitPrefix), file: file, directive: "expect-exit")
		expect.exit = try n as ExitCode otherwise panic("test: {file}: malformed expect-exit")
	end 'exit' else if hasPrefix(line, prefix: expectMemoryPrefix) 'memory'
		let n = directiveNumber(afterPrefix(line, prefix: expectMemoryPrefix), file: file, directive: "memory-limit")
		if n < 1 'zero'
			panic("test: {file}: malformed memory-limit: write a number of megabytes")
		end 'zero'
		expect.memoryLimitMB = n
	end 'memory' else if hasPrefix(line, prefix: schedulesPrefix) 'schedules'
		let n = directiveNumber(afterPrefix(line, prefix: schedulesPrefix), file: file, directive: "schedules")
		if n < 1 'none'
			panic("test: {file}: malformed schedules: write a number of schedules from 1")
		end 'none'
		expect.schedules = n
	end 'schedules' else if line == nativeOnlyDirective 'native'
		expect.nativeOnly = true
	end 'native' else if line == runsAloneDirective 'alone'
		expect.runsAlone = true
	end 'alone' else if line == runsManualDirective 'manual'
		expect.manual = true
	end 'manual' else if hasPrefix(line, prefix: unsupportedTargetsPrefix) 'targets'
		expect.unsupportedTargets = trimSpace(afterPrefix(line, prefix: unsupportedTargetsPrefix)).clone()
	end 'targets' else if hasPrefix(line, prefix: expectSchedulerPrefix) 'scheduler'
		let answer = trimSpace(afterPrefix(line, prefix: expectSchedulerPrefix))
		if answer != schedulerUsed and answer != schedulerUnused 'malformed'
			panic("test: {file}: malformed expect-scheduler: write {schedulerUsed} or {schedulerUnused}")
		end 'malformed'
		expect.saysScheduler = true
		expect.scheduled = answer == schedulerUsed
	end 'scheduler' else if hasPrefix(line, prefix: stdinPrefix) 'stdin'
		stdin.append(afterMarkerSpace(afterPrefix(line, prefix: stdinPrefix)).toByteArray())
		stdin.push(newlineByte)
	end 'stdin' else if hasPrefix(line, prefix: expectStdoutPrefix) 'stdout'
		var skip = stdoutMarkerBytes
		if line.byteLength() > stdoutMarkerBytes and line.byteAt(stdoutMarkerBytes) == spaceByte 'space'
			skip = stdoutMarkerBytes + 1
		end 'space'
		stdout.append(line.sliceBytes(skip, endPos: line.byteLength()).toByteArray())
		stdout.push(newlineByte)
	end 'stdout'
end 'applyDirective'

// mentionsConcurrency is whether a line has a word that every program that runs the scheduler has.
function mentionsConcurrency(line String) returns bool
	return findText(line, needle: whenWord).isSome() or findText(line, needle: asyncWord).isSome() or findText(line, needle: sleepWord).isSome() or findText(line, needle: schedulerWord).isSome() or findText(line, needle: parallelWord).isSome()
end 'mentionsConcurrency'

// readExpectation reads the directives of a program, a file or a project's directory, whose files are read in order.
function readExpectation(program String) returns Expectation
	var expect = Expectation.new()
	var stdout = ByteArray.create(0)
	var stdin = ByteArray.create(0)
	var files = ast.StringList.create(0)
	if project.isDirectoryPath(program) 'project'
		files = project.sourceFiles(program)
	end 'project' else 'single'
		files.push(program.clone())
	end 'single'
	for f in 0 upto files.count() 'files'
		let lines = readLines(files[f])
		for l in 0 upto lines.count() 'lines'
			applyDirective(expect, stdout: stdout, stdin: stdin, line: trimLeft(lines[l]), file: files[f])
			if not expect.mentionsConcurrency and mentionsConcurrency(lines[l]) 'concurrency'
				expect.mentionsConcurrency = true
			end 'concurrency'
		end 'lines'
	end 'files'
	expect.stdout = String.from(stdout)
	expect.stdin = String.from(stdin)
	return expect
end 'readExpectation'

// collectPrograms adds the source files and the cases of fix under dir, except those under modulesRoot, which holds projects,
// and under benchRoot, which holds benchmarks.
function collectPrograms(dir String, modulesRoot String, benchRoot String, mutates files ast.StringList)
	let dirPath = try FilePath.from(dir) otherwise panic("test: {dir} is not a path")
	let listed = try Directory.list(dirPath) otherwise panic("test: cannot read {dir}")
	for i in 0 upto listed.count() 'entries'
		let full = project.joinPath(dir, name: project.lastComponent(listed[i].toString()))
		if project.isDirectoryPath(full) 'directory'
			if full != modulesRoot and full != benchRoot 'program'
				collectPrograms(full, modulesRoot: modulesRoot, benchRoot: benchRoot, files: files)
			end 'program'
		end 'directory' else if project.endsWithMaxon(full) or endsWithText(full, suffix: fixCaseExtension) 'source'
			files.push(full)
		end 'source'
	end 'entries'
end 'collectPrograms'

// collectProjects adds the directories of modulesRoot, each a project.
function collectProjects(modulesRoot String, mutates files ast.StringList)
	if not project.isDirectoryPath(modulesRoot) 'none'
		return
	end 'none'
	let dirPath = try FilePath.from(modulesRoot) otherwise panic("test: {modulesRoot} is not a path")
	let listed = try Directory.list(dirPath) otherwise panic("test: cannot read {modulesRoot}")
	for i in 0 upto listed.count() 'entries'
		let full = project.joinPath(modulesRoot, name: project.lastComponent(listed[i].toString()))
		if project.isDirectoryPath(full) 'project'
			files.push(full)
		end 'project'
	end 'entries'
end 'collectProjects'

let updatePositionsFlag = "--update-positions"

let behavioursFlag = "--behaviours"

// manualFlag has a run include the programs that say `// runs: manual` (runsManualDirective), which it leaves out otherwise,
// naming them in the summary; a run of one such program by its own path includes it as well.
let manualFlag = "--manual"

// slowestFlag has a run end with the N tests that passed and took longest, with the time of a run of each one's executable (the
// time of all its runs divided by their number, as the gate runs a program that schedules behaviours more than once) and, for
// a program of the corpus, the interpreter's: how a machine finds the tests that are over the second or two that the gate may
// spend on one, which are run by hand (runsManualDirective).
let slowestFlag = "--slowest="

let repeatFlag = "--repeat="

// compileOnlyFlag compiles every program of the corpus, or every spec test, and runs none, as the programs of tests/check
// are: it is how the gate holds the benchmarks, which the runner leaves out of the corpus, and the corpus and the spec tests
// for the targets the host cannot run, to the compiler. A spec test so compiled must compile as the host's compile of it
// does (stageSpecTest).
let compileOnlyFlag = "--compile-only"

// runnerFlag names the command that starts each executable of the corpus, in place of the target's runner.
let runnerFlag = "--runner="

// workerCountsFlag lists the worker counts that each executable of a run is run under, one after another, in place of the one
// its environment gives; envRunnerFlag names cmd/envrun, which sets the count for the executable alone. So the programs that
// schedule behaviours are compiled once for all the counts, and the runner keeps its own width.
let workerCountsFlag = "--worker-counts="

let envRunnerFlag = "--env-runner="

// behaviourRuns is how many times the corpus runs the executable of a program that schedules behaviours, unless
// --repeat says: each run is another schedule, and the gate runs the corpus under three worker counts, so a few runs each
// are enough there, while a soak asks for hundreds.
let behaviourRuns = 2 as Count

// The environment variable the runtime reads its worker count from, which a failure of a program that schedules
// behaviours names.
let workerCountVariable = "MAXON_MAX_PROCS"

// CorpusOptions are how a run of the corpus goes. A run with behavioursOnly runs only the programs that schedule
// behaviours, and only natively: it is the run under another worker count, which the environment of the runner sets for
// every executable it starts, after a full run has held the programs to the interpreter, which the count does not reach.
type CorpusOptions
	var verbose as bool
	var updatePositions as bool
	var behavioursOnly as bool
	// includesManual has the run include the programs that are run by hand (manualFlag).
	var includesManual as bool
	// slowest is how many of the slowest tests the run reports at its end, or 0 for none (slowestFlag).
	var slowest as Count
	var repeats as Count
	// target is the target the programs are compiled for, whose executables runner starts.
	var target as ast.Target
	var runner as TargetRunner
	// verifiesIr compiles every program with --verify-ir.
	var verifiesIr as bool
	// compilesOnly makes every program one that is only compiled.
	var compilesOnly as bool
	// interprets has each spec test that passes run under the interpreter too, as the corpus's programs always are.
	var interprets as bool
	// workerCounts are the worker counts each executable runs under, and envRunner the program that sets one for it alone: none
	// of them leaves the executables the environment of the runner.
	var workerCounts as CountList
	var envRunner as String
	// workingDirectory is where the spec tests' programs run (specRunDirectory); the corpus's run in the runner's own
	// (inheritedDirectory).
	var workingDirectory as String

	static function new() returns CorpusOptions
		return CorpusOptions{verbose: false, updatePositions: false, behavioursOnly: false, includesManual: false, slowest: 0, repeats: behaviourRuns, target: hostTarget(), runner: TargetRunner.native, verifiesIr: false, compilesOnly: false, interprets: false, workerCounts: CountList.create(0), envRunner: "", workingDirectory: inheritedDirectory}
	end 'new'
end 'CorpusOptions'

// testCommand is `test [dir|file.md] [--verbose] [--update-positions] [--behaviours] [--repeat=N] [--executables=N]
// [--compile-only] [--manual] [--slowest=N] [--interpret] [--skip-passed] [--require-passed] [--record-passed] [--save-results=file] [--replay-results=file]`: the corpus is the given directory of programs, or the spec files at the given path, or
// else the nearest tests directory from the executable's upward. With --update-positions a test whose expect-error got its
// code at another place has the directive rewritten to that place, as after a change that only moves code, such as renaming
// a keyword. --behaviours runs only the programs that schedule behaviours, natively, and --repeat runs the executable of each
// such program N times. --executables lets at most N test executables run at once. The last three flags are for the spec
// files: one leaves out the tests that the list of the tests that pass has, one fails the run when one of them does not
// pass, and one writes the list. The last two keep the result of every test in a file and take them from it instead of running the
// tests (self/driver/specresults.maxon). --interpret, also for the spec files, runs each test that passes under the interpreter
// as well, and fails it for an access left unchecked whose check fails: a proven access out of range, which the checker
// proved in range and is not, or a read of an empty slot of an array, which has none.
function testCommand(rest CommandNames, given Options) returns ExitCode
	var options = SpecOptions.new()
	var corpus = CorpusOptions.new()
	var corpusFlags = false
	var executables = 0 as Count
	var commandRunner as table.Option with TargetRunner
	commandRunner = table.Option.none
	var path = ""
	var hasPath = false
	for i in 1 upto rest.count() 'arguments'
		if hasPrefix(rest[i], prefix: executablesFlag) 'executables'
			executables = match consumes parseCount(afterPrefix(rest[i], prefix: executablesFlag)) 'cap'
				some(n) gives n
				none gives 0
			end 'cap'
			if executables < 1 'malformed'
				printError("test: {executablesFlag} takes a number of executables from 1\n")
				return usageExitCode
			end 'malformed'
		end 'executables' else if hasPrefix(rest[i], prefix: runnerFlag) 'runner'
			let words = runnerWords(afterPrefix(rest[i], prefix: runnerFlag))
			if words[0].byteLength() == 0 'empty'
				printError("test: {runnerFlag} names the command that starts each executable\n")
				return usageExitCode
			end 'empty'
			commandRunner = table.Option.some(TargetRunner.command(words))
		end 'runner' else if hasPrefix(rest[i], prefix: workerCountsFlag) 'workerCounts'
			let words = runnerWords(afterPrefix(rest[i], prefix: workerCountsFlag))
			for w in 0 upto words.count() 'counts'
				let count = match consumes parseCount(words[w]) 'count'
					some(n) gives n
					none gives 0
				end 'count'
				if count < 1 'malformed'
					printError("test: {workerCountsFlag} takes worker counts from 1, apart by commas\n")
					return usageExitCode
				end 'malformed'
				corpus.workerCounts.push(count)
			end 'counts'
			corpusFlags = true
		end 'workerCounts' else if hasPrefix(rest[i], prefix: envRunnerFlag) 'envRunner'
			corpus.envRunner = afterPrefix(rest[i], prefix: envRunnerFlag).clone()
		end 'envRunner' else if rest[i] == verboseFlag 'verbose'
			options.verbose = true
		end 'verbose' else if rest[i] == updatePositionsFlag 'positions'
			corpus.updatePositions = true
		end 'positions' else if rest[i] == behavioursFlag 'behaviours'
			corpus.behavioursOnly = true
			corpusFlags = true
		end 'behaviours' else if rest[i] == manualFlag 'manual'
			corpus.includesManual = true
		end 'manual' else if hasPrefix(rest[i], prefix: slowestFlag) 'slowest'
			corpus.slowest = match consumes parseCount(afterPrefix(rest[i], prefix: slowestFlag)) 'count'
				some(n) gives n
				none gives 0
			end 'count'
			if corpus.slowest < 1 'malformed'
				printError("test: {slowestFlag} takes a number of tests from 1\n")
				return usageExitCode
			end 'malformed'
		end 'slowest' else if rest[i] == compileOnlyFlag 'compileOnly'
			corpus.compilesOnly = true
		end 'compileOnly' else if rest[i] == interpretFlag 'interpret'
			corpus.interprets = true
		end 'interpret' else if hasPrefix(rest[i], prefix: repeatFlag) 'repeat'
			let runs = match consumes parseCount(afterPrefix(rest[i], prefix: repeatFlag)) 'runs'
				some(n) gives n
				none gives 0
			end 'runs'
			if runs < 1 'malformed'
				printError("test: {repeatFlag} takes a number of runs from 1\n")
				return usageExitCode
			end 'malformed'
			corpus.repeats = runs
			corpusFlags = true
		end 'repeat' else if rest[i] == recordPassedFlag 'record'
			options.record = true
		end 'record' else if hasPrefix(rest[i], prefix: recordOnlyFlag) 'recordOnly'
			options.recordOnly.push(afterPrefix(rest[i], prefix: recordOnlyFlag).clone())
		end 'recordOnly' else if rest[i] == skipPassedFlag 'skip'
			options.skipPassed = true
		end 'skip' else if rest[i] == requirePassedFlag 'require'
			options.requirePassed = true
		end 'require' else if hasPrefix(rest[i], prefix: saveResultsFlag) 'save'
			options.results = ResultsMode.resultsSave
			options.resultsPath = afterPrefix(rest[i], prefix: saveResultsFlag).clone()
		end 'save' else if hasPrefix(rest[i], prefix: replayResultsFlag) 'replay'
			options.results = ResultsMode.resultsReplay
			options.resultsPath = afterPrefix(rest[i], prefix: replayResultsFlag).clone()
		end 'replay' else if not hasPath 'path'
			path = rest[i].clone()
			hasPath = true
		end 'path'
	end 'arguments'
	if (options.needsList() or options.results != ResultsMode.resultsOff) and not (hasPath and isSpecPath(path)) 'listFlags'
		printError("test: {recordPassedFlag}, {skipPassedFlag}, {requirePassedFlag}, {saveResultsFlag} and {replayResultsFlag} are for the spec files: name the specs directory\n")
		return usageExitCode
	end 'listFlags'
	if options.recordOnly.count() > 0 and not options.record 'recordOnly'
		printError("test: {recordOnlyFlag} narrows what {recordPassedFlag} adds: give {recordPassedFlag} too\n")
		return usageExitCode
	end 'recordOnly'
	if options.results != ResultsMode.resultsOff and (options.skipPassed or options.resultsPath == "") 'results'
		printError("test: {saveResultsFlag} and {replayResultsFlag} take the file of the results of every test: give it a path, and not {skipPassedFlag}\n")
		return usageExitCode
	end 'results'
	if hasPath and project.holdsModuleTests(path) 'modules'
		return moduleTests(path, options: given, compilesOnly: corpus.compilesOnly, includesManual: corpus.includesManual)
	end 'modules'
	let width = RunWidth.of(runWorkers(), executables: executables)
	if hasPath and isSpecPath(path) 'specs'
		if corpusFlags 'corpusFlags'
			printError("test: {behavioursFlag}, {repeatFlag}N and {workerCountsFlag} are for the corpus, not the spec files\n")
			return usageExitCode
		end 'corpusFlags'
		if corpus.compilesOnly and (options.needsList() or options.results != ResultsMode.resultsOff) 'compileOnlyList'
			printError("test: {compileOnlyFlag} holds each spec test to the host's compile of it, not to {passedListName} or kept results\n")
			return usageExitCode
		end 'compileOnlyList'
		// The spec tests' executables run only on the host, so a run for another target only compiles them.
		if corpus.interprets and corpus.compilesOnly 'compileOnlyInterpret'
			printError("test: {interpretFlag} runs what {compileOnlyFlag} does not run: give one\n")
			return usageExitCode
		end 'compileOnlyInterpret'
		if not corpus.compilesOnly and given.target.name() != hostTarget().name() 'foreign'
			printError("test: the spec tests run on {hostTarget().name()} only: {compileOnlyFlag} compiles them for {given.target.name()}\n")
			return usageExitCode
		end 'foreign'
		corpus.target = given.target.clone()
		corpus.verifiesIr = given.verifyIr
		return runSpecs(path, options: options, compiling: corpus, width: width)
	end 'specs'
	if corpus.interprets 'interpretCorpus'
		printError("test: {interpretFlag} is for the spec files, and the corpus always runs under the interpreter: name the specs directory\n")
		return usageExitCode
	end 'interpretCorpus'
	if corpus.workerCounts.count() > 0 and corpus.envRunner == "" 'envRunnerMissing'
		printError("test: {workerCountsFlag} needs {envRunnerFlag}, the program that sets the worker count of one executable\n")
		return usageExitCode
	end 'envRunnerMissing'
	corpus.verbose = options.verbose
	corpus.target = given.target.clone()
	corpus.verifiesIr = given.verifyIr
	let runner = commandRunner.clone() if commandRunner.isSome() else runnerFor(given.target)
	if not runner.isSome() and not corpus.compilesOnly 'noRunner'
		printError("test: no runner on {hostTarget().name()} starts the executables of {given.target.name()}\n")
		return usageExitCode
	end 'noRunner'
	// A compile-only run starts no executable, so a target that nothing here runs may be compiled for.
	if runner.isSome() 'runs'
		corpus.runner = runner.unwrap()
	end 'runs'
	if hasPath 'given'
		return runTests(path, options: corpus, width: width)
	end 'given'
	return match consumes project.nearestDirectory(testsDirName) 'nearest'
		some(dir) gives runTests(dir, options: corpus, width: width)
		none gives usageError()
	end 'nearest'
end 'testCommand'

function usageError() returns ExitCode
	printError("test: no directory of tests: name one, or run the compiler from a checkout that has tests\n")
	return usageExitCode
end 'usageError'

// corpusRootOf is the directory of tests that holds the program at file, the nearest one up from it.
function corpusRootOf(file String) returns table.Option with String
	var dir = project.parentDir(file)
	while true 'up'
		if project.lastComponent(dir) == testsDirName 'found'
			return table.Option.some(dir)
		end 'found'
		let parent = project.parentDir(dir)
		if parent == dir or parent == "." 'top'
			return table.Option.none
		end 'top'
		dir = parent
	end 'up'
	return table.Option.none
end 'corpusRootOf'

// runTests runs every program and project of the corpus in dir, as behaviours (startTests), which print a line for each in
// the order of the files and the failures and the counts at the end, and set the code the process exits with. A path of one
// program runs it alone, in the corpus that holds it, a program that is run by hand (runsManualDirective) included; a
// directory leaves such programs out, unless it is given manualFlag, and the summary names them.
function runTests(dir String, options CorpusOptions, width RunWidth) returns ExitCode
	let given = project.absolutePath(dir)
	var root = given.clone()
	var files = ast.StringList.create(0)
	let single = not project.isDirectoryPath(given) and project.endsWithMaxon(given)
	if single 'single'
		let holder = corpusRootOf(given)
		if not holder.isSome() 'none'
			printError("test: {given} is under no directory called {testsDirName}\n")
			return usageExitCode
		end 'none'
		root = holder.unwrap()
		files.push(given.clone())
	end 'single'
	if not project.isDirectoryPath(root) 'missing'
		panic("test: cannot read {root}")
	end 'missing'
	let modulesRoot = project.joinPath(root, name: modulesDir)
	if not single 'directory'
		collectPrograms(root, modulesRoot: modulesRoot, benchRoot: project.joinPath(root, name: benchDir), files: files)
		collectProjects(modulesRoot, files: files)
		project.sortStrings(files)
	end 'directory'
	let checkOnlyPrefix = project.joinPath(project.joinPath(root, name: checkOnlyDir), name: "")
	let runtimeTierPrefix = project.joinPath(project.joinPath(root, name: runtimeTierDir), name: "")
	let libraryTierPrefix = project.joinPath(project.joinPath(root, name: libraryTierDir), name: "")
	let irTierPrefix = project.joinPath(project.joinPath(root, name: irTierDir), name: "")
	var jobs = Jobs.create(0)
	for i in 0 upto files.count() 'tests'
		let file = files[i].clone()
		let nameStart = try root.byteLength() + 1 otherwise panic("test: {root} is too long")
		let name = file.sliceBytes(nameStart, endPos: file.byteLength()).clone()
		var expect = readExpectation(file)
		expect.checkOnly = options.compilesOnly or hasPrefix(file, prefix: checkOnlyPrefix)
		if hasPrefix(file, prefix: runtimeTierPrefix) 'runtimeTier'
			expect.runtimeTier = true
			expect.nativeOnly = true
		end 'runtimeTier'
		expect.libraryTier = hasPrefix(file, prefix: libraryTierPrefix)
		expect.irTier = hasPrefix(file, prefix: irTierPrefix)
		let leftOut = options.behavioursOnly and not mayScheduleBehaviours(expect, file: file)
		// A program that is run by hand is still compiled by a run that runs none (compileOnly), since that holds no time.
		let byHand = expect.manual and not (single or options.includesManual or options.compilesOnly)
		jobs.push(Job.corpus(CorpusJob.make(file, name: name, expect: expect, leftOut: leftOut, byHand: byHand)))
	end 'tests'
	let tests = jobs.count()
	startTests(prepareSharedRuntime(options.target), host: SharedRuntime.none(), jobs: jobs, files: SpecFiles.create(0), corpus: options.clone(), verbose: options.verbose, scratch: Scratch.make("test", suffix: executableExtension(options.target)), width: width, tally: Tally.corpus(CorpusTally.make(tests, slowest: options.slowest)))
	return compiledByBehaviours
end 'runTests'

// prepareSharedRuntime is the runtime of the target that every compile of a run of tests links with, checked and compiled
// once. It panics when the runtime does not compile, since no test could then say anything about the program it compiles.
function prepareSharedRuntime(target ast.Target) returns SharedRuntime
	return prepareCachedRuntime(target, cacheDir: "")
end 'prepareSharedRuntime'

// prepareCachedRuntime is prepareSharedRuntime for programs compiled with the build cache at cacheDir, or with none when it is
// empty: the compiler's digest, which every key holds, is read once for the run.
function prepareCachedRuntime(target ast.Target, cacheDir String) returns SharedRuntime
	var errs = diag.ErrorList.create(0)
	var options = testOptions()
	options.target = target.clone()
	if cacheDir != "" 'cached'
		options.cacheDir = cacheDir.clone()
		options.compiler = compilerIdentity()
		options.speculates = true
	end 'cached'
	let shared = SharedRuntime.prepare(options, errs: errs)
	if errs.count() > 0 'broken'
		panic("test: the runtime does not compile: {joinErrors(errs)}")
	end 'broken'
	return shared
end 'prepareCachedRuntime'

// testOptions are the options every test is compiled with: the executables count their live heap boxes, so that a test
// that leaks fails.
function testOptions() returns Options
	var options = Options.new()
	options.countAllocations = true
	return options
end 'testOptions'

// interpretedTestOptions are testOptions for a test that the interpreter runs too, on the IR as lowered.
function interpretedTestOptions() returns Options
	var options = testOptions()
	options.keepsLowered = true
	return options
end 'interpretedTestOptions'

// compileForTest makes the executable of file at output, as the driver does for every test, so that a test that expects
// an error the generate stage raises gets it. What it lowered is kept for the interpreter, which runs it as the executable
// is made from it.
function compileForTest(shared SharedRuntime, file String, output String, inLibrary bool, verifies bool, keepsIr bool, mutates errs diag.ErrorList) returns CompiledProgram
	var options = interpretedTestOptions()
	options.verifyIr = verifies
	options.keepsIrText = keepsIr
	options.stagesInLibrary = inLibrary
	let compiled = compileProjectWith(shared, path: file, output: output, options: options, errs: errs)
	diag.sortErrors(errs)
	return compiled
end 'compileForTest'

function joinErrors(errs diag.ErrorList) returns String
	var out = ByteArray.create(0)
	for i in 0 upto errs.count() 'each'
		if i > 0 'separator'
			out.append("; ".toByteArray())
		end 'separator'
		out.append(errs[i].format().toByteArray())
	end 'each'
	return String.from(out)
end 'joinErrors'

function positionText(e diag.CompileError) returns String
	return "{e.line}:{e.col}"
end 'positionText'

// mayScheduleBehaviours is whether a program is one a run of the behaviours alone compiles to see whether it runs the
// scheduler: one that is run, and has a word that every program that runs the scheduler has, or is a test of the
// runtime, which may run it without one.
function mayScheduleBehaviours(expect Expectation, file String) returns bool
	if expect.errors.count() > 0 or expect.checkOnly or endsWithText(file, suffix: fixCaseExtension) 'notRun'
		return false
	end 'notRun'
	return expect.runtimeTier or expect.mentionsConcurrency
end 'mayScheduleBehaviours'

// stageProgram compiles the test program of job, which is test index of the run, to the executable at exe, and checks what
// it can against what its directives say before the executable runs. The executable lives only as long as the test.
function stageProgram(shared SharedRuntime, job CorpusJob, index Count, exe String, options CorpusOptions) returns Staged
	if listsTarget(job.expect.unsupportedTargets, target: options.target.name()) 'unsupported'
		return Staged.done(Finished.make(TestResult.unsupported("unsupported on {options.target.name()}")))
	end 'unsupported'
	if job.expect.irTier and options.target.name() != hostTarget().name() 'foreign'
		return Staged.done(Finished.make(TestResult.unsupported("the IR expectations are held to the host's IR: {hostTarget().name()}, not {options.target.name()}")))
	end 'foreign'
	if endsWithText(job.file, suffix: fixCaseExtension) 'fix'
		let stem = job.file.sliceBytes(0, endPos: try job.file.byteLength() - fixCaseExtension.byteLength() otherwise 0 as Count)
		return Staged.done(Finished.make(runFixTest(job.file, expected: "{stem}{fixedExtension}")))
	end 'fix'
	var errs = diag.ErrorList.create(0)
	var compiled as CompiledProgram
	if job.expect.runtimeTier 'runtimeTier'
		var runtimeOptions = interpretedTestOptions()
		runtimeOptions.target = options.target.clone()
		runtimeOptions.verifyIr = options.verifiesIr
		compiled = compileRuntimeTest(job.file, output: exe, options: runtimeOptions, errs: errs)
		diag.sortErrors(errs)
	end 'runtimeTier' else 'program'
		compiled = compileForTest(shared, file: job.file, output: exe, inLibrary: job.expect.libraryTier, verifies: options.verifiesIr, keepsIr: job.expect.irTier, errs: errs)
	end 'program'
	return checkTest(job.expect, file: job.file, compiled: compiled, errs: errs, index: index, exe: exe, options: options)
end 'stageProgram'

// checkTest is whether a compile that gave errs is what expect says, or, when it made the executable at exe, the run of the
// executable that is to say it. A program is run natively and then under the interpreter too, unless it says it is too
// heavy for that. A program that schedules behaviours runs natively several
// times, each under another schedule.
function checkTest(expect Expectation, file String, consumes compiled CompiledProgram, errs diag.ErrorList, index Count, exe String, options CorpusOptions) returns Staged
	let built = errs.count() == 0
	if expect.irTier 'ir'
		if errs.count() > 0 'broken'
			return doneBuilt(TestResult.failed(joinErrors(errs)), exe: exe, built: built)
		end 'broken'
		return doneBuilt(checkIrClaims(expect, irText: compiled.generated.irText), exe: exe, built: built)
	end 'ir'
	if expect.irClaims.count() > 0 'misplaced'
		return doneBuilt(TestResult.failed("{expectIrPrefix} is for the programs of tests/{irTierDir}"), exe: exe, built: built)
	end 'misplaced'
	if expect.errors.count() > 0 'expected'
		return doneBuilt(checkExpectedErrors(expect, file: file, errs: errs, updatePositions: options.updatePositions), exe: exe, built: built)
	end 'expected'
	if errs.count() > 0 'failed'
		return doneBuilt(TestResult.failed(joinErrors(errs)), exe: exe, built: built)
	end 'failed'
	if expect.checkOnly 'checked'
		return doneBuilt(TestResult.passed(), exe: exe, built: built)
	end 'checked'
	// The link says whether the program runs the scheduler, whatever it reached it by: a when, an async call, a sleep, or a
	// test of the runtime's own.
	let scheduling = compiled.generated.scheduled
	if expect.saysScheduler and scheduling != expect.scheduled 'scheduler'
		return doneBuilt(TestResult.failed("the link gave the program the scheduler: {scheduling}, and the program expects {expect.scheduled}"), exe: exe, built: built)
	end 'scheduler'
	if options.behavioursOnly and not scheduling 'unscheduled'
		return doneBuilt(TestResult.leftOut(), exe: exe, built: built)
	end 'unscheduled'
	var runs = 1 as Count
	if scheduling 'repeated'
		runs = options.repeats
	end 'repeated'
	let interprets = not (expect.nativeOnly or options.behavioursOnly)
	return Staged.needsRun(PendingRun.corpus(CorpusPending.make(index, exe: exe.clone(), expect: expect.clone(), compiled: compiled, runs: runs, interprets: interprets)))
end 'checkTest'

// runNativeRuns runs the executable runs times, and each run must give what the program expects; a failure says which run
// it was and under what worker count, since a program that schedules behaviours runs under another schedule each time. A
// pass says how long the runs took and how many they were.
function runNativeRuns(exe String, expect Expectation, runs Count, options CorpusOptions) returns TestResult
	var counts = options.workerCounts.clone()
	if counts.count() == 0 'inherited'
		counts.push(0)
	end 'inherited'
	let started = Clock.nowNanos() as Count
	for at in 0 upto counts.count() 'counts'
		let workers = counts[at]
		for run in 0 upto runs 'runs'
			let result = runNative(exe, expect: expect, runner: options.runner, workers: workers, envRunner: options.envRunner)
			if result.outcome == TestOutcome.testFailed 'failed'
				if runs == 1 and workers == 0 'once'
					return result
				end 'once'
				let count = "{workerCountVariable}={workers}" if workers > 0 else workerCountText()
				return TestResult.failed("run {run + 1} of {runs}, {count}: {result.detail}")
			end 'failed'
		end 'runs'
	end 'counts'
	var passed = TestResult.passed()
	passed.runNanos = elapsedSince(started)
	passed.runs = try counts.count() * runs otherwise panic("test: more runs than memory")
	return passed
end 'runNativeRuns'

// elapsedSince is the time since started, a reading of the clock.
function elapsedSince(started Count) returns Count
	return try (Clock.nowNanos() as Count) - started otherwise panic("test: the clock went backwards")
end 'elapsedSince'

// workerCountText says what worker count the executables the runner starts run with.
function workerCountText() returns String
	let count = try Process.environmentVariable(workerCountVariable) otherwise return "{workerCountVariable} unset"
	return "{workerCountVariable}={count}"
end 'workerCountText'

// runInterpreted runs a program under the tracking interpreter, which must give what the program expects and break no rule of
// the memory model. A program that schedules behaviours runs under several schedules, and each must give the same output.
function runInterpreted(compiled CompiledProgram, expect Expectation) returns TestResult
	for schedule in 0 upto expect.schedules 'schedules'
		let out = interp.run(compiled.p, modules: compiled.generated.modules, entry: compiled.generated.entry, stepLimit: interp.defaultStepLimit, seed: interp.seedOf(schedule), wantFrees: expect.frees.count() > 0, races: true, stdin: expect.stdin)
		var atSeed = ""
		if out.behaviours > 0 'scheduled'
			atSeed = " under the schedule of seed {schedule}"
		end 'scheduled'
		let code = interp.exitStatus(out.exitCode)
		if out.violations.count() > 0 'violated'
			return TestResult.failed("the interpreter found a violation of the memory model{atSeed}:\n{joinLines(out.violations)}")
		end 'violated'
		if out.timedOut 'timedOut'
			return TestResult.failed("the interpreter timed out{atSeed}")
		end 'timedOut'
		if out.unmodelled 'unmodelled'
			return TestResult.failed("the interpreter does not model what the program uses{atSeed}: {trimSpace(out.stderr)}")
		end 'unmodelled'
		if code != expect.exit 'exit'
			return TestResult.failed("the interpreter exited {exitCodeText(code)}, expected {exitCodeText(expect.exit)}{atSeed}; stderr: {trimSpace(out.stderr)}")
		end 'exit'
		if out.stdout != expect.stdout 'stdout'
			return TestResult.failed("the interpreter's stdout differs{atSeed}\n--- expected\n{expect.stdout}--- actual\n{out.stdout}")
		end 'stdout'
		if expect.frees.count() > 0 and not sameLines(out.frees, expected: expect.frees) 'frees'
			return TestResult.failed("the interpreter freed in another order{atSeed}\n--- expected\n{joinLines(expect.frees)}\n--- actual\n{joinLines(out.frees)}")
		end 'frees'
		if out.behaviours == 0 'oneSchedule'
			break 'schedules'
		end 'oneSchedule'
	end 'schedules'
	return TestResult.passed()
end 'runInterpreted'

// interpretedViolations runs a program under the interpreter once, for the accesses left unchecked alone: a read the checker
// proved in range that is not, or a read of an array's element with no test for an empty slot that finds one, fails the test. The output and the exit code are the executable's to give, which the run of it has checked
// already; a run that outlasts the step limit, ends in a trap of the program or at what the interpreter does not model found
// no wrong proof, and the rules of the memory model are the corpus's to hold the programs to, which the spec tests, written
// for maxon, are not.
function interpretedViolations(compiled CompiledProgram) returns TestResult
	let out = interp.run(compiled.p, modules: compiled.generated.modules, entry: compiled.generated.entry, stepLimit: interp.defaultStepLimit, seed: interp.seedOf(0), wantFrees: false, races: true, stdin: "")
	if out.uncheckedAccess 'wrong'
		return TestResult.failed("the interpreter found an access left unchecked whose check fails:\n{joinLines(out.violations)}")
	end 'wrong'
	return TestResult.passed()
end 'interpretedViolations'

// sameLines is whether two lists hold the same lines in the same order.
function sameLines(actual ast.StringList, expected ast.StringList) returns bool
	if actual.count() != expected.count() 'counts'
		return false
	end 'counts'
	for i in 0 upto actual.count() 'each'
		if actual[i] != expected[i] 'differs'
			return false
		end 'differs'
	end 'each'
	return true
end 'sameLines'

// checkExpectedErrors is whether errs holds the error of every expect-error directive of the program.
function checkExpectedErrors(expect Expectation, file String, errs diag.ErrorList, updatePositions bool) returns TestResult
	for i in 0 upto expect.errors.count() 'directives'
		let result = checkExpectedError(expect.errors[i], file: file, errs: errs, updatePositions: updatePositions)
		if result.outcome != TestOutcome.testPassed 'notFound'
			return result
		end 'notFound'
	end 'directives'
	return TestResult.passed()
end 'checkExpectedErrors'

// checkExpectedError is whether errs holds the error of one expect-error directive, which says expected: its code, and its
// position when the directive gives one.
function checkExpectedError(expected String, file String, errs diag.ErrorList, updatePositions bool) returns TestResult
	var code = expected.clone()
	var at = ""
	let split = findText(expected, needle: errorLocationSplit)
	let hasAt = split.isSome()
	if hasAt 'positioned'
		let found = split.unwrap()
		code = expected.sliceBytes(0, endPos: found).clone()
		let atStart = try found + errorLocationSplit.byteLength() otherwise panic("test: {expected} is too long")
		at = expected.sliceBytes(atStart, endPos: expected.byteLength()).clone()
	end 'positioned'
	for i in 0 upto errs.count() 'each'
		if errs[i].code == code and (not hasAt or at == positionText(errs[i])) 'found'
			return TestResult.passed()
		end 'found'
	end 'each'
	if updatePositions and hasAt 'moving'
		for i in 0 upto errs.count() 'moved'
			if errs[i].code == code 'sameCode'
				moveExpectedError(file, old: expected, replacement: "{code}{errorLocationSplit}{positionText(errs[i])}")
				return TestResult.passed()
			end 'sameCode'
		end 'moved'
	end 'moving'
	if errs.count() == 0 'compiled'
		return TestResult.failed("expected {expected}, but it compiled")
	end 'compiled'
	return TestResult.failed("expected {expected}, got: {joinErrors(errs)}")
end 'checkExpectedError'

// exitCodeText is an exit code as a signed number, as the system reports a crash.
function exitCodeText(code ExitCode) returns String
	if code >= signBit 'negative'
		return "-{exitCodeRange - code}"
	end 'negative'
	return "{code}"
end 'exitCodeText'

// How long a test executable may run before it is ended, in milliseconds.
let testRunDeadlineMs = 10000 as Count

// How many schedules of its behaviours a program that schedules any is run under: the seeds from 0 up to this.
let scheduleSeeds = 20 as Count

// ExecutableRun is how running an executable ended: with its output and exit code, by not starting, with the case of the error
// that the start failed with, or by outliving the deadline, which ended it.
union ExecutableRun
	ran(out CollectedOutput)
	cannotStart(reason String)
	timedOut
end 'ExecutableRun'

// inheritedDirectory is the directory of runExecutable that starts the executable in the runner's working directory.
let inheritedDirectory = ""

// runExecutable runs the executable at exe with no arguments and the input as its standard input, which then ends, through the
// runner of its target, in directory, or in the runner's working directory for inheritedDirectory, for no longer than
// testRunDeadlineMs. An environment of assignments (NAME=VALUE) is set for the executable alone by envRunner, cmd/envrun; with
// none it inherits the runner's.
function runExecutable(exe String, runner TargetRunner, directory String, environment CommandNames, envRunner String, input String) returns ExecutableRun
	let exePath = try FilePath.from(exe) otherwise return ExecutableRun.cannotStart("{exe} is not a path")
	let deadline = WaitDeadline.within(testRunDeadlineMs)
	var started = runnerExecutable(runner, exe: exePath)
	var arguments = runnerArguments(runner, exe: exe)
	if environment.count() > 0 'environment'
		arguments = envRunnerArguments(environment, started: started, arguments: arguments)
		started = Executable.name(envRunner.clone())
	end 'environment'
	try 'run'
		let out = startExecutable(started, arguments: arguments, directory: directory, input: input, deadline: deadline)
		return ExecutableRun.ran(out)
	end 'run' otherwise (e) 'failed'
		match e 'kind'
			timeout then return ExecutableRun.timedOut
			executableNotFound then return ExecutableRun.cannotStart("SubprocessError.executableNotFound: the system found no such program")
			spawnFailed then return ExecutableRun.cannotStart("SubprocessError.spawnFailed: the system refused to start the program")
			busy then return ExecutableRun.cannotStart("SubprocessError.busy: the system found the file busy (ETXTBSY or EBUSY, a sharing violation on Windows)")
			ioFailed then return ExecutableRun.cannotStart("SubprocessError.ioFailed: the pipes to the program could not be made or read")
			treeNotEnded then return ExecutableRun.cannotStart("SubprocessError.treeNotEnded")
			detachRefused then return ExecutableRun.cannotStart("SubprocessError.detachRefused")
			inputTooLarge then return ExecutableRun.cannotStart("SubprocessError.inputTooLarge")
			statusLost then return ExecutableRun.cannotStart("SubprocessError.statusLost: the program's exit status was lost")
		end 'kind'
	end 'failed'
	panic("test: the run of {exe} ended in no case of its error")
end 'runExecutable'

// startExecutable runs the executable with the arguments and the input as its standard input in directory, or in the runner's
// working directory for inheritedDirectory, until the deadline. A child that starts in a directory is given no input.
function startExecutable(executable Executable, arguments CommandNames, directory String, input String, deadline WaitDeadline) returns CollectedOutput throws SubprocessError
	if directory == inheritedDirectory 'inherited'
		return try __Builtins.runWithInput(executable, arguments: arguments, input: input, deadline: deadline)
	end 'inherited'
	if input != "" 'unsupported'
		panic("test: a program that starts in the directory {directory} cannot be given standard input")
	end 'unsupported'
	let at = try FilePath.from(directory) otherwise panic("test: the working directory {directory} is not a path")
	return try Subprocess.runInDirectory(executable, arguments: arguments, directory: at, deadline: deadline)
end 'startExecutable'

// runNative runs the executable and checks its output and exit code against what the program expects. The memory limit
// of the directive is not enforced.
function runNative(exe String, expect Expectation, runner TargetRunner, workers Count, envRunner String) returns TestResult
	var environment = CommandNames.create(0)
	if workers > 0 'counted'
		environment.push("{workerCountVariable}={workers}")
	end 'counted'
	match consumes runExecutable(exe, runner: runner, directory: inheritedDirectory, environment: environment, envRunner: envRunner, input: expect.stdin) 'run'
		ran(out) then return checkNativeOutput(out, exe: exe, expect: expect)
		cannotStart(reason) then return TestResult.failed("cannot run {exe}: {reason}")
		timedOut then return TestResult.failed("timed out")
	end 'run'
end 'runNative'

function checkNativeOutput(out CollectedOutput, exe String, expect Expectation) returns TestResult
	let actual = withoutCarriageReturns(out.stdout, loneToo: false)
	let code = out.exitCode()
	if code != expect.exit 'exit'
		var limit = ""
		if expect.memoryLimitMB > 0 'limited'
			limit = " (the program may have used more than its {expect.memoryLimitMB} MB, which fails an allocation and crashes it)"
		end 'limited'
		return TestResult.failed("exit {exitCodeText(code)}, expected {exitCodeText(expect.exit)}{limit}; stderr: {trimSpace(out.stderr)}")
	end 'exit'
	if actual != expect.stdout 'stdout'
		return TestResult.failed("stdout differs\n--- expected\n{expect.stdout}--- actual\n{actual}")
	end 'stdout'
	return TestResult.passed()
end 'checkNativeOutput'

// runFixTest is whether the fix command makes of the program at file a program that checks clean and is the text of the file
// at expected. A file of `// --- file:` sections is a project, which both files hold as a spec test's block does.
function runFixTest(file String, expected String) returns TestResult
	let text = withoutCarriageReturns(readText(file), loneToo: false)
	let wanted = withoutCarriageReturns(readText(expected), loneToo: false)
	let sections = splitSections(text)
	if sections.count() > 0 'project'
		let built = fixProgram(FixProgram.make(projectRoot, name: file.clone(), single: false, files: sectionFiles(sections), candidates: ast.knownTargets()), libraries: noFixLibraries(), expected: table.Option.none, watches: ast.StringList.create(0), only: table.Option.none)
		print(built.said)
		return fixedResult(built, expected: expected, wanted: withoutFinalNewline(wanted), actual: withoutFinalNewline(fixedBlock(text, sections: sections, outcome: built)))
	end 'project'
	let outcome = fixSource(file, text: text)
	print(outcome.said)
	return fixedResult(outcome, expected: expected, wanted: wanted, actual: outcome.files[0].text)
end 'runFixTest'

// fixedResult is whether the fixed program checks clean, in at most fixCaseRounds rounds, and its text is the wanted text of
// the file named expected.
function fixedResult(outcome FixOutcome, expected String, wanted String, actual String) returns TestResult
	if outcome.left != "" 'left'
		return TestResult.failed("fixed, it still has an error {outcome.left}")
	end 'left'
	if outcome.rounds > fixCaseRounds 'slow'
		return TestResult.failed("fixed in {outcome.rounds} rounds, more than {fixCaseRounds}")
	end 'slow'
	if actual != wanted 'differs'
		return TestResult.failed("fixed, it is not {expected}: {firstDifference(wanted, actual: actual)}")
	end 'differs'
	return TestResult.passed()
end 'fixedResult'
