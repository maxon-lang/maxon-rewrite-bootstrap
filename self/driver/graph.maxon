// The task graph of a compile: each stage of each module is a task that waits for the module's stage before it and, where
// it reads what that stage made of them, for the same stage of the modules it names, and a stage of the project as a whole
// is a task that waits for every module's stage before it. Two executors run it: execute, here, one task at a time in the order they were added, which is the order of the
// stages and, within a stage, the order of the modules the stage visits, so every task's inputs have run when it starts; and
// the behaviours of executor.maxon, each task once its inputs have ended, on every core. Both run the work of tasks.maxon on
// what the task's inputs gave it, so they make the same executable and the same diagnostics.

// Stage is a step of the compile. A stage of the project as a whole is marked so; every other one is of one module.
enum Stage
	// scan (of a library module in a program's compile) reads from the text of the module's files the words that reach it and
	// the library modules it may name, which the parse of every library module waits on (reachedByProgram); it makes no segment.
	scan
	parse
	// parsed (project) joins the parses: resolve may read the declaration table of any module that a qualified name passes
	// through, which it knows only as it resolves.
	parsed
	resolve
	// order (project) makes the module graph from what resolve recorded, refuses a cycle, and adds the tasks of the check.
	order
	aliases
	declare
	// entry (project) is the part of the declare that is of no one module: a program in which no module declares main.
	entry
	constantOrder
	constants
	bodies
	verify
	// endCheck (project) ends the check of the project: every module's verify and the entry ended without an error, which the
	// program waits on. A module's lower waits only on its own verify, which waited on the verify of each module it reaches.
	endCheck
	// lower lowers the module's functions and runs the passes that read only them; inline replaces their calls of leaves, of
	// its own and of the modules it names, whose inline it waits on, and runs the passes after it.
	lower
	inline
	// program (project) holds the runtime to the functions the compiler calls, writes --emit-ir and reports what the backend
	// cannot run yet.
	program
	emit
	// link (project) links the units into the executable, or, for the runtime's own compile, keeps them for the programs.
	link
end 'Stage'

// Goal is how far a compile goes, and what it ends with.
enum Goal
	// declared stops after the constants.
	declared
	// checked stops after verify.
	checked
	// instances finds the instances every module needs and holds the runtime, as a check does.
	instances
	// lowered lowers every module's functions, for the interpreter.
	lowered
	// units lowers and emits the runtime's own project into the units every program is linked with.
	units
	// executable links an executable.
	executable
end 'Goal'

enum TaskState
	waiting
	done
	failed
	skipped
end 'TaskState'

// Task is a stage of one module, or of the project, with its inputs: the tasks whose results it reads, a range of the
// graph's inputs. The errors it found are a list of its own, part of its product.
type Task
	var stage as Stage
	// module is the module of a stage of one module, and nothing for a stage of the project.
	var module as Count
	var firstInput as Count
	var inputCount as Count

	static function make(stage Stage, module Count, firstInput Count, inputCount Count) returns Task
		return Task{stage: stage, module: module, firstInput: firstInput, inputCount: inputCount}
	end 'make'
end 'Task'

typealias Tasks = Array with Task

typealias TaskIDs = Array with Count

// ModuleDeps are the modules each module names, by module.
typealias ModuleDeps = Array with TaskIDs

// TaskGraph is the tasks in the order they run and, while it is being built, the tasks of the stage added last: by module
// for a stage of modules, or the one task of a stage of the project.
type TaskGraph
	var tasks as Tasks
	var inputs as TaskIDs
	// group is the tasks of the stage added last.
	var group as TaskIDs
	// groupOfModules is whether that stage is of modules, whose task for a module is moduleTask at the module.
	var groupOfModules as bool
	var moduleTask as TaskIDs

	static function new(modules Count) returns TaskGraph
		var moduleTask = TaskIDs.create(0)
		for _ in 0 upto modules 'each'
			moduleTask.push(0)
		end 'each'
		return TaskGraph{tasks: Tasks.create(0), inputs: TaskIDs.create(0), group: TaskIDs.create(0), groupOfModules: false, moduleTask: moduleTask}
	end 'new'

	// addProjectTask adds a stage of the project that waits for every task of the stage added before it, and for the tasks
	// also.
	function addProjectTask(mutates self, stage Stage, also TaskIDs)
		let id = tasks.count()
		let firstInput = inputs.count()
		inputs.append(group)
		inputs.append(also)
		tasks.push(Task.make(stage, module: 0, firstInput: firstInput, inputCount: try inputs.count() - firstInput otherwise panic("driver: a task's inputs end before they start")))
		group = TaskIDs.create(0)
		group.push(id)
		groupOfModules = false
	end 'addProjectTask'

	// addSideTask adds a stage of the project that waits for every task of the stage added before it, and for the tasks also,
	// as addProjectTask does, but that no later stage of modules waits for, and gives the task.
	function addSideTask(mutates self, stage Stage, also TaskIDs) returns Count
		let id = tasks.count()
		let firstInput = inputs.count()
		inputs.append(group)
		inputs.append(also)
		tasks.push(Task.make(stage, module: 0, firstInput: firstInput, inputCount: try inputs.count() - firstInput otherwise panic("driver: a task's inputs end before they start")))
		return id
	end 'addSideTask'

	// addModuleTasks adds a stage of each module of order, in that order: each waits for its module's task of the stage added
	// before, or for the task of the project that stage is, and, where the stage reads what the modules it names (deps) made
	// of it, for their tasks of this stage, which come first in order.
	function addModuleTasks(mutates self, stage Stage, order check.ModuleOrder, deps ModuleDeps, first Count)
		var added = TaskIDs.create(0)
		for i in 0 upto order.count() 'modules'
			let m = ast.modIndex(order[i])
			let id = tasks.count()
			let firstInput = inputs.count()
			if groupOfModules 'previous'
				inputs.push(moduleTask[m])
			end 'previous' else 'project'
				inputs.append(group)
			end 'project'
			if readsNamedModules(stage) 'named'
				for j in 0 upto deps[m].count() 'deps'
					let d = deps[m][j]
					if d >= first 'compiled'
						inputs.push(namedTask(stage, module: d, by: m))
					end 'compiled'
				end 'deps'
			end 'named'
			let inputCount = try inputs.count() - firstInput otherwise panic("driver: a task's inputs end before they start")
			tasks.push(Task.make(stage, module: m, firstInput: firstInput, inputCount: inputCount))
			moduleTask[m] = id
			added.push(id)
		end 'modules'
		group = added
		groupOfModules = true
	end 'addModuleTasks'

	// addLowerTasks adds the lower of each module of order. Without modules on demand (onDemand, by module) it is
	// addModuleTasks. A module on demand lowers only what the lowers before it call (lowersOnDemand), so it comes after them
	// instead of in order: first the lower of every other module, in order, each waiting for its verify; then the modules on
	// demand, in the reverse of order, each waiting for its verify, for the lower of every module of the first pass, since a
	// module of the program can lower an instance of another's generic whose body calls the library without naming it, and for
	// the lower of every module on demand that names it, which the reverse order adds first.
	function addLowerTasks(mutates self, order check.ModuleOrder, deps ModuleDeps, onDemand Placed, first Count)
		var any = false
		for i in 0 upto order.count() 'any'
			if demandedAt(onDemand, m: ast.modIndex(order[i])) 'demanded'
				any = true
			end 'demanded'
		end 'any'
		if not any 'whole'
			self.addModuleTasks(Stage.lower, order: order, deps: deps, first: first)
			return
		end 'whole'
		var added = TaskIDs.create(0)
		var firstPass = TaskIDs.create(0)
		for i in 0 upto order.count() 'whole'
			let m = ast.modIndex(order[i])
			if not demandedAt(onDemand, m: m) 'own'
				let id = addTaskAfter(Stage.lower, module: m, before: singleTask(moduleTask[m]), also: TaskIDs.create(0))
				firstPass.push(id)
				added.push(id)
			end 'own'
		end 'whole'
		var i = order.count()
		while i > 0 'demanded'
			i = i - 1
			let m = ast.modIndex(order[i])
			if not demandedAt(onDemand, m: m) 'own'
				continue 'demanded'
			end 'own'
			var also = firstPass.clone()
			for j in 0 upto order.count() 'namers'
				let k = ast.modIndex(order[j])
				if k != m and demandedAt(onDemand, m: k) and namesModule(deps[k], module: m) 'names'
					also.push(namedTask(Stage.lower, module: k, by: m))
				end 'names'
			end 'namers'
			added.push(addTaskAfter(Stage.lower, module: m, before: singleTask(moduleTask[m]), also: also))
		end 'demanded'
		group = added
		groupOfModules = true
	end 'addLowerTasks'

	// addParseTasks adds the scan of each module of library, which waits for nothing, and the parse of each module of program and
	// then of library, each waiting for the tasks of the stage added before (none, at the start of a compile). The parse of a
	// module of program waits for the scans of the library, whose words it reads its text for (libraryWords), and the parse of
	// a module of library for those and for the parses of program: a module of the library is parsed only when the program's
	// words reach it (reachedByProgram). The core is reached whatever the program writes, so its parse waits for its own scan
	// only, and runs beside the program's.
	function addParseTasks(mutates self, program check.ModuleOrder, library check.ModuleOrder, core table.Option with Count)
		let before = group.clone()
		var scans = TaskIDs.create(0)
		for i in 0 upto library.count() 'scans'
			scans.push(addTaskAfter(Stage.scan, module: ast.modIndex(library[i]), before: before, also: TaskIDs.create(0)))
		end 'scans'
		var added = TaskIDs.create(0)
		for i in 0 upto program.count() 'program'
			added.push(addTaskAfter(Stage.parse, module: ast.modIndex(program[i]), before: before, also: scans))
		end 'program'
		var waited = added.clone()
		waited.append(scans)
		var place = 0 as Count
		for i in 0 upto library.count() 'library'
			var also = waited.clone()
			if core.isSome() and ast.modIndex(library[i]) == core.clone().unwrap() 'core'
				also = singleTask(try scans.get(place) otherwise panic("driver: a library module without its scan"))
			end 'core'
			added.push(addTaskAfter(Stage.parse, module: ast.modIndex(library[i]), before: before, also: also))
			place = place + 1
		end 'library'
		group = added
		groupOfModules = true
	end 'addParseTasks'

	// addResolveTasks adds the resolve of each module of program and then of library, each waiting for the task of the project
	// added before it (the join of the parses), and each of library for the resolves of program as well: it resolves only for a
	// program that names the library (resolvesModule).
	function addResolveTasks(mutates self, program check.ModuleOrder, library check.ModuleOrder)
		let before = group.clone()
		var added = TaskIDs.create(0)
		for i in 0 upto program.count() 'program'
			added.push(addTaskAfter(Stage.resolve, module: ast.modIndex(program[i]), before: before, also: TaskIDs.create(0)))
		end 'program'
		let programTasks = added.clone()
		for i in 0 upto library.count() 'library'
			added.push(addTaskAfter(Stage.resolve, module: ast.modIndex(library[i]), before: before, also: programTasks))
		end 'library'
		group = added
		groupOfModules = true
	end 'addResolveTasks'

	// addTaskAfter adds the task of stage of module m, which waits for the tasks before and also, and gives it.
	function addTaskAfter(mutates self, stage Stage, module Count, before TaskIDs, also TaskIDs) returns Count
		let id = tasks.count()
		let firstInput = inputs.count()
		inputs.append(before)
		inputs.append(also)
		tasks.push(Task.make(stage, module: module, firstInput: firstInput, inputCount: try inputs.count() - firstInput otherwise panic("driver: a task's inputs end before they start")))
		moduleTask[module] = id
		return id
	end 'addTaskAfter'

	// namedTask is the task of stage of module, which module by names and which order put before it.
	function namedTask(stage Stage, module Count, by Count) returns Count
		let id = moduleTask[module]
		if id >= tasks.count() or tasks[id].stage != stage or tasks[id].module != module 'missing'
			panic("driver: module {by} comes before module {module}, which it names")
		end 'missing'
		return id
	end 'namedTask'

	// inputAt is the k-th input of task.
	function inputAt(task Count, k Count) returns Count
		return inputs[try tasks[task].firstInput + k otherwise panic("driver: a task's inputs end past memory")]
	end 'inputAt'

	// dependents are, by task, the tasks that wait on it, in the order they were added.
	function dependents() returns Array with TaskIDs
		var waiting as Array with TaskIDs
		waiting = Array.create(0)
		for _ in 0 upto tasks.count() 'tasks'
			waiting.push(TaskIDs.create(0))
		end 'tasks'
		for t in 0 upto tasks.count() 'waiters'
			for k in 0 upto tasks[t].inputCount 'inputs'
				let input = inputAt(t, k: k)
				waiting[input].push(t)
			end 'inputs'
		end 'waiters'
		return waiting
	end 'dependents'
end 'TaskGraph'

// demandedAt is whether onDemand marks module m, which a module past its end is not.
function demandedAt(onDemand Placed, m Count) returns bool
	if m >= onDemand.count() 'past'
		return false
	end 'past'
	return onDemand[m]
end 'demandedAt'

// singleTask is a list of the one task id.
function singleTask(id Count) returns TaskIDs
	var one = TaskIDs.create(0)
	one.push(id)
	return one
end 'singleTask'

// namesModule is whether the modules a module names (named) hold module.
function namesModule(named TaskIDs, module Count) returns bool
	for j in 0 upto named.count() 'named'
		if named[j] == module 'found'
			return true
		end 'found'
	end 'named'
	return false
end 'namesModule'

// readsNamedModules is whether a module's stage reads what the same stage made of the modules the module names.
function readsNamedModules(stage Stage) returns bool
	return match stage 's'
		scan gives false
		parse gives false
		parsed gives false
		resolve gives false
		order gives false
		aliases gives true
		declare gives true
		entry gives false
		constantOrder gives true
		constants gives true
		bodies gives true
		verify gives true
		endCheck gives false
		lower gives false
		inline gives true
		program gives false
		emit gives false
		link gives false
	end 's'
end 'readsNamedModules'

// phaseOf is where a stage's errors stand in the order of the stages: the errors reported are those of the earliest phase
// that has any. The entry check is the declare's.
function phaseOf(stage Stage) returns Count
	if stage == Stage.entry 'entry'
		return Stage.declare.ordinal
	end 'entry'
	return stage.ordinal
end 'phaseOf'

// reportsFirstModule is whether only the first module, in module order, that failed a stage has its errors reported: an
// instance whose type arguments nest without end fails every module that reaches it.
function reportsFirstModule(stage Stage) returns bool
	return stage == Stage.lower
end 'reportsFirstModule'

// lowersBodies is whether a compile lowers the functions of its modules, rather than only finding the instances they need.
function lowersBodies(goal Goal) returns bool
	return match goal 'g'
		declared gives false
		checked gives false
		instances gives false
		lowered gives true
		units gives true
		executable gives true
	end 'g'
end 'lowersBodies'

// makesCode is whether a compile compiles its modules' functions to code.
function makesCode(goal Goal) returns bool
	return match goal 'g'
		declared gives false
		checked gives false
		instances gives false
		lowered gives false
		units gives true
		executable gives true
	end 'g'
end 'makesCode'

// isModuleStage is whether a stage is of one module, as against a stage of the project as a whole.
function isModuleStage(stage Stage) returns bool
	return match stage 's'
		scan gives true
		parse gives true
		parsed gives false
		resolve gives true
		order gives false
		aliases gives true
		declare gives true
		entry gives false
		constantOrder gives true
		constants gives true
		bodies gives true
		verify gives true
		endCheck gives false
		lower gives true
		inline gives true
		program gives false
		emit gives true
		link gives false
	end 's'
end 'isModuleStage'

// phaseOfStage is the phase of a stage of one module: the segment of its module's slots that its task writes, which is its
// product.
function phaseOfStage(stage Stage) returns ast.Phase
	match stage 's'
		scan then panic("driver: the scan makes no segment of its module")
		parse then return ast.Phase.parse
		parsed then panic("driver: parsed is a stage of the project")
		resolve then return ast.Phase.resolve
		order then panic("driver: order is a stage of the project")
		aliases then return ast.Phase.aliases
		declare then return ast.Phase.declare
		entry then panic("driver: entry is a stage of the project")
		constantOrder then return ast.Phase.constantOrder
		constants then return ast.Phase.constants
		bodies then return ast.Phase.bodies
		verify then return ast.Phase.verify
		endCheck then panic("driver: endCheck is a stage of the project")
		lower then return ast.Phase.lower
		inline then return ast.Phase.inline
		program then panic("driver: program is a stage of the project")
		emit then return ast.Phase.emit
		link then panic("driver: link is a stage of the project")
	end 's'
end 'phaseOfStage'

// Run is the state of one compile that execute runs on one thread: the compile, its graph, the work of each module, and what
// the tasks made that later tasks and the caller read.
type Run
	var compile as Compile
	var graph as TaskGraph
	// work is what the tasks of each module hold between them, by module from first on, out of the project while the tasks run
	// (homesOut).
	var work as Array with ModuleWork
	var homesOut as bool
	// outcomes are what each task gave the tasks that wait on it, by task; started is what a task that waits on nothing is
	// given.
	var outcomes as Array with Outcome
	var started as Outcome
	// states and errors are what became of each task, and the errors it found, which the compile's list takes in task order
	// when it ends.
	var states as TaskStates
	var errors as ErrorLists
	// earlierErrors is how many errors the error list held when the compile started, which the phase of parse holds.
	var earlierErrors as Count
	// entryPlan is what the order decided about the program's entry function, which the entry task reports on.
	var entryPlan as check.EntryPlan
	// checksStarted is whether the order started the check of each module.
	var checksStarted as bool
	var checked as check.Checked
	// generates is whether the check ended as a task, which it does when every module's verify ran and the goal goes on.
	var generates as bool
	// timings holds the time of each stage and module when --timings asks for it.
	var timings as Timings
	// made are the modules' units of a compile whose goal is the units, which programs are then linked with.
	var made as backend.UnitList
	// scheduled is whether the executable the link made runs the scheduler.
	var scheduled as bool
	// irText is the text of the IR that the program stage kept, when the options keep it (Options.keepsIrText).
	var irText as String

	static function make(consumes compile Compile, modules Count) returns Run
		let plan = check.EntryPlan.none(compile.makesProgram)
		return Run{compile: compile, graph: TaskGraph.new(modules), work: Array.create(0), homesOut: false, outcomes: Array.create(0), started: Outcome.none(), states: TaskStates.create(0), errors: ErrorLists.create(0), earlierErrors: 0, entryPlan: plan, checksStarted: false, checked: check.Checked.none(), generates: false, timings: Timings.off(), made: backend.UnitList.create(0), scheduled: false, irText: ""}
	end 'make'

	// generated is what the generate stage lowered, which is nothing when the check did not end without errors: the IR as
	// lowered of a compile that keeps it or that makes no code.
	function generated(mutates self) returns Generated
		if not generates 'nothing'
			return Generated.nothing()
		end 'nothing'
		var modules = backend.FunctionLists.create(0)
		for slot in 0 upto work.count() 'modules'
			if compile.options.keepsLowered 'kept'
				modules.push(exchange(work[slot].kept, value: ir.IrFunctionList.create(0)))
			end 'kept' else if not makesCode(compile.goal) 'lowered'
				modules.push(exchange(work[slot].lowered, value: ir.IrFunctionList.create(0)))
			end 'lowered' else 'compiled'
				return Generated.nothing()
			end 'compiled'
		end 'modules'
		return Generated.make(checked.entry, modules: modules, scheduled: scheduled, irText: exchange(irText, value: ""))
	end 'generated'
end 'Run'

// lowersOrFinds is whether a compile goes on past the check to the instances.
function lowersOrFinds(goal Goal) returns bool
	return match goal 'g'
		declared gives false
		checked gives false
		instances gives true
		lowered gives true
		units gives true
		executable gives true
	end 'g'
end 'lowersOrFinds'

// compileOf is the compile of the modules of p from the one at index first on, from the stage from (parse, or resolve for
// modules parsed already) as far as goal, which it seals what ran before (ast.sealProject).
function compileOf(mutates p ast.Project, from Stage, first Count, goal Goal, makesProgram bool, output String, options Options) returns Compile
	ast.sealProject(p, first: first)
	var begun = 0 as Count
	if from == Stage.resolve 'parsed'
		begun = ast.Phase.resolve.ordinal
	end 'parsed' else if from != Stage.parse 'from'
		panic("driver: a compile starts at parse or resolve, not at {from}")
	end 'from'
	let modules = try p.modules.count() - first otherwise panic("driver: a compile from past the modules")
	let libraryLater = libraryLaterOf(p, first: first)
	var heads = project.LibraryHeads.none()
	var indexSetup = IndexSetup.off()
	var index = LibraryIndex.absent()
	if from == Stage.parse 'parsing'
		if libraryLater.contains(true) 'library'
			heads = project.LibraryHeads.of(p, first: first)
		end 'library'
		indexSetup = indexSetupOf(p, libraryLater: libraryLater, first: first, options: options)
		index = readIndex(indexSetup)
	end 'parsing'
	return Compile.make(goal, first: first, modules: modules, begun: begun, makesProgram: makesProgram, options: options.clone(), output: output.clone(), base: freeze(ast.baseOf(p, first: first)), cache: cacheSetupOf(p, first: first, options: options), libraryLater: libraryLater, heads: heads, indexSetup: indexSetup, index: index)
end 'compileOf'

// startGraph adds the tasks of the compile c up to the order, from the stage from: those that every compile has, before it
// knows what the modules name.
function startGraph(mutates graph TaskGraph, c Compile, from Stage)
	let modules = independentOrder(c)
	let none = ModuleDeps.create(0)
	if from == Stage.parse 'parse'
		graph.addParseTasks(modulesOf(c, order: modules, library: false), library: modulesOf(c, order: modules, library: true), core: c.heads.coreModule())
		graph.addProjectTask(Stage.parsed, also: TaskIDs.create(0))
	end 'parse'
	graph.addResolveTasks(modulesOf(c, order: modules, library: false), library: modulesOf(c, order: modules, library: true))
	graph.addProjectTask(Stage.order, also: TaskIDs.create(0))
end 'startGraph'

// modulesOf are the modules of order whose resolve waits for the program's (Compile.libraryLater), or the others.
function modulesOf(c Compile, order check.ModuleOrder, library bool) returns check.ModuleOrder
	var kept = check.ModuleOrder.create(0)
	for i in 0 upto order.count() 'modules'
		if c.libraryLater[c.slotOf(ast.modIndex(order[i]))] == library 'kept'
			kept.push(order[i])
		end 'kept'
	end 'modules'
	return kept
end 'modulesOf'

// runStages compiles the modules of p from the one at index first on, from the stage from (parse, or resolve for modules
// parsed already) as far as goal, one task after another (execute). memory holds the files that parse reads from memory
// rather than disk. The errors are those of the earliest phase that has any, which the error list also holds when it is
// not empty at the start.
function runStages(mutates p ast.Project, from Stage, memory project.SourceFiles, first Count, goal Goal, makesProgram bool, output String, options Options, ready frozen with backend.UnitList, mutates errs diag.ErrorList) returns Run
	var run = Run.make(compileOf(p, from: from, first: first, goal: goal, makesProgram: makesProgram, output: output, options: options), modules: p.modules.count())
	takeHomes(run, p: p)
	run.started = Outcome.start(startedKnown(run.compile, works: run.work), failed: errs.count() > 0)
	run.earlierErrors = errs.count()
	if options.timings 'timed'
		run.timings = Timings.start(Stage.allCaseNames, modules: p.modules.count())
	end 'timed'
	startGraph(run.graph, c: run.compile, from: from)
	execute(run, p: p, memory: memory, ready: ready, errs: errs)
	putHomes(run, p: p)
	if run.timings.enabled 'report'
		reportTimings(run.timings, p: p, goal: goal, first: first)
	end 'report'
	keepEarliestErrors(run.graph, states: run.states, errors: run.errors, earlier: run.earlierErrors, errs: errs)
	endUnchecked(run, p: p)
	endCheck(run)
	return run
end 'runStages'

// takeHomes takes what the tasks of each module the compile compiles write out of the project, into the run's work, so that
// a task reads another module only in the products of its stages.
function takeHomes(mutates run Run, mutates p ast.Project)
	if run.homesOut 'out'
		panic("driver: the modules' homes are taken twice")
	end 'out'
	for slot in 0 upto run.compile.modules 'modules'
		let home = ast.takeHome(p, module: run.compile.idOf(slot))
		if slot < run.work.count() 'again'
			run.work[slot].home = home
		end 'again' else 'first'
			run.work.push(ModuleWork.make(home))
		end 'first'
	end 'modules'
	run.homesOut = true
end 'takeHomes'

// putHomes gives the project back what takeHomes took, for a task of the project that reads it whole, or when the compile ends.
function putHomes(mutates run Run, mutates p ast.Project)
	if not run.homesOut 'in'
		return
	end 'in'
	for slot in 0 upto run.work.count() 'modules'
		let module = run.work[slot].home.module
		let home = exchange(run.work[slot].home, value: ast.ModuleHome.empty(module))
		ast.putHome(p, home: home)
	end 'modules'
	run.homesOut = false
end 'putHomes'

// reportTimings prints the compile's timings on standard error.
function reportTimings(timings Timings, p ast.Project, goal Goal, first Count)
	printError(timings.report("compile timings, goal {goal}", names: timingNames(p), first: first))
end 'reportTimings'

// chargeTask adds what a task of stage of module took, nanos and what it timed besides (timing), to timings.
function chargeTask(mutates timings Timings, stage Stage, module Count, nanos Count, timing TaskTiming)
	if isModuleStage(stage) 'ofModule'
		timings.addModule(stage.ordinal, module: module, nanos: nanos)
	end 'ofModule' else 'ofProject'
		timings.addProject(stage.ordinal, nanos: nanos)
	end 'ofProject'
	timings.addTask(timing.lower, emitted: timing.emit, inlined: timing.inlined)
end 'chargeTask'

// execute runs the tasks in order, the ones that a task adds as well, each when every task it waits on has run: a task is
// skipped when its inputs say it must be (Outcome.mustSkip).
function execute(mutates run Run, mutates p ast.Project, memory project.SourceFiles, ready frozen with backend.UnitList, mutates errs diag.ErrorList)
	var t = 0 as Count
	while t < run.graph.tasks.count() 'tasks'
		var outcome = outcomeBefore(run, task: t)
		let stage = run.graph.tasks[t].stage
		var taskErrors = diag.ErrorList.create(0)
		var state = TaskState.skipped
		if outcome.mustSkip(stage) 'skip'
			outcome.skipped = true
		end 'skip' else 'run'
			var timing = TaskTiming.of(run.timings.enabled)
			let started = clockIf(run.timings.enabled)
			runTask(run, p: p, task: t, outcome: outcome, memory: memory, timing: timing, ready: ready, errs: taskErrors)
			if run.timings.enabled 'timed'
				chargeTask(run.timings, stage: stage, module: run.graph.tasks[t].module, nanos: elapsedIf(true, started: started), timing: timing)
			end 'timed'
			state = TaskState.done
			if taskErrors.count() > 0 'failed'
				state = TaskState.failed
				outcome.noteFailure(true, phase: phaseOf(stage))
			end 'failed'
		end 'run'
		run.states.push(state)
		run.errors.push(taskErrors)
		run.outcomes.push(outcome)
		t = try t + 1 otherwise panic("driver: more tasks than memory")
	end 'tasks'
end 'execute'

// outcomeBefore is what a task's inputs, which ran before it, gave it, merged; for a task that waits on nothing, what the
// start of the compile gives.
function outcomeBefore(run Run, task Count) returns Outcome
	if run.graph.tasks[task].inputCount == 0 'started'
		return run.started.copy()
	end 'started'
	var outcome = Outcome.none()
	for k in 0 upto run.graph.tasks[task].inputCount 'inputs'
		let input = run.graph.inputAt(task, k: k)
		if input >= run.outcomes.count() 'early'
			panic("driver: task {task} runs before its input {input}")
		end 'early'
		outcome.merge(run.outcomes[input])
	end 'inputs'
	return outcome
end 'outcomeBefore'

// runTask runs one task, whose inputs gave it outcome, which a task of a module adds its product to.
function runTask(mutates run Run, mutates p ast.Project, task Count, mutates outcome Outcome, memory project.SourceFiles, mutates timing TaskTiming, ready frozen with backend.UnitList, mutates errs diag.ErrorList)
	let stage = run.graph.tasks[task].stage
	let m = run.graph.tasks[task].module
	if isModuleStage(stage) 'ofModule'
		let slot = run.compile.slotOf(m)
		outcome.known[slot] = moduleTask(run.compile, work: run.work[slot], stage: stage, m: m, known: outcome.known, memory: memory, timing: timing, errs: errs)
		return
	end 'ofModule'
	match stage 's'
		scan then panic("driver: the scan is a stage of a module")
		parse then panic("driver: the parse is a stage of a module")
		parsed then writeIndexWhenMissing(run.compile, known: outcome.known)
		resolve then panic("driver: the resolve is a stage of a module")
		order then orderModules(run, known: outcome.known, errs: errs)
		aliases then panic("driver: the aliases are a stage of a module")
		declare then panic("driver: the declare is a stage of a module")
		entry then check.projectEntry(run.entryPlan, errs: errs)
		constantOrder then panic("driver: the order of constants is a stage of a module")
		constants then panic("driver: the constants are a stage of a module")
		bodies then panic("driver: the bodies are a stage of a module")
		verify then panic("driver: the verify is a stage of a module")
		endCheck then run.generates = true
		lower then panic("driver: the lower is a stage of a module")
		inline then panic("driver: the inline is a stage of a module")
		program then programTask(run, p: p, known: outcome.known, errs: errs)
		emit then panic("driver: the emit is a stage of a module")
		link then linkTask(run, p: p, known: outcome.known, ready: ready)
	end 's'
end 'runTask'

// orderModules orders the modules (orderTask) and, unless a cycle stopped the compile, starts each module's check as the
// order decided and adds the tasks of the check and of what the goal makes after it.
function orderModules(mutates run Run, known Known, mutates errs diag.ErrorList)
	match consumes orderTask(run.compile, known: known, errs: errs) 'ordered'
		some(ordered) then startChecks(run, ordered: ordered)
		none then return
	end 'ordered'
end 'orderModules'

function startChecks(mutates run Run, consumes ordered Ordered)
	var held = ordered
	run.entryPlan = held.plan.clone()
	for slot in 0 upto run.work.count() 'modules'
		let start = exchange(held.starts[slot], value: CheckStart.make(ast.SlotList.create(0), role: check.EntryRole.none, reach: Reach.whole))
		run.work[slot].startCheck(start)
	end 'modules'
	run.checksStarted = true
	addCheckTasks(run.graph, c: run.compile, ordered: held)
end 'startChecks'

// programTask is holdProgram on the project, which holds the modules' homes while it runs.
function programTask(mutates run Run, mutates p ast.Project, known Known, mutates errs diag.ErrorList)
	putHomes(run, p: p)
	run.irText = holdProgram(run.compile, p: p, known: known, errs: errs)
	if run.compile.goal != Goal.instances 'emits'
		takeHomes(run, p: p)
	end 'emits'
end 'programTask'

// linkTask is linkUnits on the project, which holds the modules' homes from then on, with each module's unit; a compile whose
// goal is the units keeps them instead (made).
function linkTask(mutates run Run, mutates p ast.Project, known Known, ready frozen with backend.UnitList)
	putHomes(run, p: p)
	var units = backend.UnitList.create(0)
	for slot in 0 upto run.work.count() 'modules'
		units.push(exchange(run.work[slot].unit, value: backend.CodeUnit.new()))
	end 'modules'
	if run.compile.goal == Goal.units 'units'
		run.made = units
		return
	end 'units'
	run.scheduled = linkUnits(run.compile, p: p, units: units, ready: ready, entry: entryOf(known), tests: testsOf(known))
end 'linkTask'

// endCheck takes in, in module order, what each module's check made, which the generate stage reads.
function endCheck(mutates run Run)
	run.checked = check.Checked.none()
	for _ in 0 upto run.compile.first 'earlier'
		run.checked.add(check.ModuleChecked.none())
	end 'earlier'
	for slot in 0 upto run.work.count() 'modules'
		run.checked.add(exchange(run.work[slot].checked, value: check.ModuleChecked.none()))
	end 'modules'
end 'endCheck'

// endUnchecked ends the check of each module whose verify did not run, when an error stopped the compile, so that the project,
// which holds the modules' homes again, holds the typing of every module.
function endUnchecked(mutates run Run, mutates p ast.Project)
	if not run.checksStarted 'none'
		return
	end 'none'
	for slot in 0 upto run.work.count() 'modules'
		if not run.work[slot].checkEnded 'unended'
			let typing = run.work[slot].endCheck(p, keepsTests: run.compile.options.runsTests)
			p.typings[run.compile.moduleOf(slot)] = freeze(typing)
		end 'unended'
	end 'modules'
end 'endUnchecked'
