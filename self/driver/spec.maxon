// The spec runner: `test` over maxon's spec files (specs/), in the format of maxon's docs/SPECS.md. A test is a
// `<!-- test: name -->` line, directive comments, a ```maxon block and the blocks that say what it does. Each test is
// compiled in this process, on the runtime that the whole run shares, and run once.

let specExtension = ".md"

let testsHeading = "## Tests"

let headingPrefix = "## "

let testMarkerPrefix = "<!-- test:"

let commentPrefix = "<!-- "

let commentSuffix = "-->"

let skipKey = "skip"

let positionsKey = "positions"

let positionsMoved = "moved"

let fenceMark = "```"

let sourceFence = "maxon"

let exitFence = "exitcode"

let stdoutFence = "stdout"

let stderrFence = "stderr"

let compilerErrorFence = "maxoncstderr"

// A listed error of a maxoncstderr block starts with "error " and its code, as CompileError.format writes it.
let errorLinePrefix = "error "

// The length of a diagnostic code such as E3102.
let diagnosticCodeWidth = 5 as Count

let proseFences = "text"

let traceFences = "-trace"

// A fence qualified for a target is written name:target, as Stdout:x64-windows.
let targetSeparator = ":"

// What a fragment is called in diagnostics, and the line that maxon puts above a fragment's source, which the positions of
// the expectations count.
let fragmentToken = "<fragment>"

let fragmentHeader = "// Test: "

// fragmentExtension is the extension of the file that maxon's runner writes a fragment to, which a panic names.
let fragmentExtension = ".test"

let backtraceHeader = "Stack trace:"

let backtraceFrame = "  in "

let fileSectionPrefix = "// --- file:"

let overlaySectionPrefix = "// --- stdlib-overlay:"

let runtimeSectionPrefix = "// --- runtime-file:"

let directiveSeparator = ":"

let targetsDirective = "unsupported-targets"

let verboseFlag = "--verbose"

let recordPassedFlag = "--record-passed"

let skipPassedFlag = "--skip-passed"

let requirePassedFlag = "--require-passed"

// The flag that has each spec test run under the interpreter as well, which fails it for an access left unchecked whose check fails (interpretedViolations).
let interpretFlag = "--interpret"

// The flags that keep the result of every test in a file, and that replay such a file instead of running the tests.
let saveResultsFlag = "--save-results="

let replayResultsFlag = "--replay-results="

// The list of the tests that pass, in the specs directory: one `file.md: test name` per line, written only by the run that
// records it.
let passedListName = "passed.txt"

let passedBeforeReason = "passed before (specs/passed.txt)"

let newPrefix = "NEW"

// lostPrefix starts the line of a listed test that a run requiring the list found failing or skipped.
let lostPrefix = "LOST"

// droppedPrefix starts the line of a listed test that a recording run leaves out of the list, because the conversion now
// skips it.
let droppedPrefix = "DROPPED"

// The value that a member of a set has in the map that holds the set.
let setMember = 1 as Count

let backtickByte = 96 as Byte

let hashByte = 35 as Byte

let angleByte = 60 as Byte

let colonByte = 58 as Byte

let upperA = 65 as Byte

let upperZ = 90 as Byte

let letterCase = 32 as Byte

// How many skip reasons the summary lists before it counts the rest together.
let listedSkipReasons = 20

// The longest a failure's line is, in bytes of its detail.
let detailLimit = 220

// A line of a failure, as many as the detail shows of the first line that differs.
let shownLineLimit = 100

typealias CountList = Array with Count

typealias ReasonIndex = table.StringMap with Count

typealias TestSet = table.StringMap with Count

// SpecOptions are the flags of a run over spec files: whether it renews the list of the tests that pass, whether it
// leaves out the tests that the list has, and whether it fails when one of them does not pass. A run that does none of them
// is a full run that reads and writes nothing. A run may also keep the result of each test in the file at resultsPath, or
// take the results from it in place of running the tests: the results are of every test, so it leaves none out.
type SpecOptions
	var verbose as bool
	var record as bool
	var skipPassed as bool
	var requirePassed as bool
	var results as ResultsMode
	var resultsPath as String

	// new is a run that does what a bare `test specs` does.
	static function new() returns SpecOptions
		return SpecOptions{verbose: false, record: false, skipPassed: false, requirePassed: false, results: ResultsMode.resultsOff, resultsPath: ""}
	end 'new'

	// needsList is whether the run reads the list of the tests that passed.
	function needsList() returns bool
		return record or skipPassed or requirePassed
	end 'needsList'

	// reportsNew is whether the run says which tests pass that the list does not have.
	function reportsNew() returns bool
		return skipPassed or requirePassed
	end 'reportsNew'
end 'SpecOptions'

// SpecFence is a fenced block of a test that is not its source: what the block is called, and where its text is in the file.
type SpecFence
	var name as String
	var start as Count
	var finish as Count

	static function make(consumes name String, start Count, finish Count) returns SpecFence
		return SpecFence{name: name, start: start, finish: finish}
	end 'make'
end 'SpecFence'

typealias SpecFenceList = Array with SpecFence

// SpecTest is one test of a spec file. The source and the fences are ranges of the file's text, which is cut only for a
// test that runs.
type SpecTest
	var name as String
	// markerEnd is where the line after the test's marker starts.
	var markerEnd as Count
	// skips are the kinds of skip line that the conversion wrote, and directives the other comment lines.
	var skips as ast.StringList
	var directives as ast.StringList
	var positionsMoved as bool
	var hasSource as bool
	var sourceStart as Count
	var sourceFinish as Count
	var fences as SpecFenceList

	static function make(consumes name String) returns SpecTest
		return SpecTest{name: name, markerEnd: 0, skips: ast.StringList.create(0), directives: ast.StringList.create(0), positionsMoved: false, hasSource: false, sourceStart: 0, sourceFinish: 0, fences: SpecFenceList.create(0)}
	end 'make'
end 'SpecTest'

typealias SpecTests = Array with SpecTest

// offsetBy is the position that lies by bytes after at.
function offsetBy(at Count, by Count) returns Count
	return try at + by otherwise panic("test: a text longer than memory")
end 'offsetBy'

function isTrailingSpace(c Byte) returns bool
	return c == spaceByte or c == tabByte or c == carriageReturnByte
end 'isTrailingSpace'

// lowerText is text with its ASCII capitals made small.
function lowerText(text String) returns String
	var out = ByteArray.create(0)
	for i in 0 upto text.byteLength() 'bytes'
		let c = text.byteAt(i)
		if c >= upperA and c <= upperZ 'capital'
			out.push(c + letterCase)
		end 'capital' else 'plain'
			out.push(c)
		end 'plain'
	end 'bytes'
	return String.from(out)
end 'lowerText'

// parseSpec is the tests of a spec file. Only what follows the `## Tests` heading holds tests; a bare or text fence is
// prose, so a marker quoted in one starts nothing.
function parseSpec(text String) returns SpecTests
	var tests = SpecTests.create(0)
	var current = SpecTest.make("")
	var reading = false
	var inTests = false
	var inFence = false
	var fenceName = ""
	var bodyStart = 0 as Count
	let n = text.byteLength()
	var lineStart = 0 as Count
	while lineStart <= n 'lines'
		var lineEnd = lineStart
		while lineEnd < n and text.byteAt(lineEnd) != newlineByte 'scan'
			lineEnd = offsetBy(lineEnd, by: 1)
		end 'scan'
		var contentEnd = lineEnd
		while contentEnd > lineStart and isTrailingSpace(text.byteAt(contentEnd - 1)) 'trim'
			contentEnd = contentEnd - 1
		end 'trim'
		let isEmpty = contentEnd == lineStart
		var first = 0 as Byte
		if not isEmpty 'firstByte'
			first = text.byteAt(lineStart)
		end 'firstByte'
		if inFence 'fence'
			if contentEnd == offsetBy(lineStart, by: fenceMark.byteLength()) and matchesAt(text, at: lineStart, needle: fenceMark) 'close'
				inFence = false
				if inTests and reading 'keep'
					var bodyFinish = bodyStart
					if lineStart > bodyStart 'body'
						bodyFinish = lineStart - 1
					end 'body'
					addFence(current, name: fenceName, start: bodyStart, finish: bodyFinish)
				end 'keep'
			end 'close'
		end 'fence' else if first == backtickByte and matchesAt(text, at: lineStart, needle: fenceMark) 'open'
			inFence = true
			fenceName = trimSpace(text.sliceBytes(offsetBy(lineStart, by: fenceMark.byteLength()), endPos: contentEnd)).clone()
			bodyStart = offsetBy(lineEnd, by: 1)
		end 'open' else if first == hashByte and matchesAt(text, at: lineStart, needle: headingPrefix) 'heading'
			if reading 'ends'
				tests.push(exchange(current, value: SpecTest.make("")))
				reading = false
			end 'ends'
			if text.sliceBytes(lineStart, endPos: contentEnd) == testsHeading 'tests'
				inTests = true
			end 'tests'
		end 'heading' else if inTests and first == angleByte and matchesAt(text, at: lineStart, needle: commentPrefix) 'comment'
			if matchesAt(text, at: lineStart, needle: testMarkerPrefix) 'marker'
				if reading 'previous'
					tests.push(exchange(current, value: SpecTest.make("")))
				end 'previous'
				current = SpecTest.make(commentText(text.sliceBytes(offsetBy(lineStart, by: testMarkerPrefix.byteLength()), endPos: contentEnd)))
				current.markerEnd = minCount(offsetBy(lineEnd, by: 1), b: n)
				reading = true
			end 'marker' else if reading 'directive'
				addComment(current, line: text.sliceBytes(offsetBy(lineStart, by: commentPrefix.byteLength()), endPos: contentEnd))
			end 'directive'
		end 'comment'
		lineStart = offsetBy(lineEnd, by: 1)
	end 'lines'
	if reading 'last'
		tests.push(current)
	end 'last'
	return tests
end 'parseSpec'

// commentText is what a comment line holds after its key: the text up to the closing `-->`, trimmed.
function commentText(rest String) returns String
	var finish = rest.byteLength()
	let suffix = commentSuffix.byteLength()
	if finish >= suffix and rest.sliceBytes(finish - suffix, endPos: finish) == commentSuffix 'closed'
		finish = finish - suffix
	end 'closed'
	return trimSpace(rest.sliceBytes(0, endPos: finish)).clone()
end 'commentText'

// addFence adds a fenced block that follows a test marker. The source is the one block called maxon; prose fences hold
// nothing of the test.
function addFence(mutates test SpecTest, name String, start Count, finish Count)
	if name == sourceFence 'source'
		test.hasSource = true
		test.sourceStart = start
		test.sourceFinish = finish
	end 'source' else if name != "" and name != proseFences 'result'
		test.fences.push(SpecFence.make(name.clone(), start: start, finish: finish))
	end 'result'
end 'addFence'

// addComment adds a comment line between a test marker and its blocks: a skip of the conversion, the mark that the
// positions of its expectation moved, or a directive.
function addComment(mutates test SpecTest, line String)
	let text = commentText(line)
	let split = findText(text, needle: directiveSeparator)
	if not split.isSome() 'bare'
		test.directives.push(text)
		return
	end 'bare'
	let at = split.unwrap()
	let key = trimSpace(text.sliceBytes(0, endPos: at)).clone()
	let value = trimSpace(text.sliceBytes(offsetBy(at, by: 1), endPos: text.byteLength())).clone()
	if key == skipKey 'skip'
		test.skips.push(value)
	end 'skip' else if key == positionsKey and value == positionsMoved 'positions'
		test.positionsMoved = true
	end 'positions' else 'directive'
		test.directives.push(text)
	end 'directive'
end 'addComment'

// directiveKey is the name a directive comment starts with.
function directiveKey(directive String) returns String
	let split = findText(directive, needle: directiveSeparator)
	if not split.isSome() 'bare'
		return directive.clone()
	end 'bare'
	return trimSpace(directive.sliceBytes(0, endPos: split.unwrap())).clone()
end 'directiveKey'

function directiveValue(directive String) returns String
	let split = findText(directive, needle: directiveSeparator)
	if not split.isSome() 'bare'
		return ""
	end 'bare'
	return trimSpace(directive.sliceBytes(offsetBy(split.unwrap(), by: 1), endPos: directive.byteLength())).clone()
end 'directiveValue'

// listsTarget is whether a comma separated list of targets names target.
function listsTarget(list String, target String) returns bool
	var start = 0 as Count
	let n = list.byteLength()
	for i in 0 upto offsetBy(n, by: 1) 'scan'
		if i == n or list.byteAt(i) == commaByte 'cut'
			if trimSpace(list.sliceBytes(start, endPos: i)) == target 'found'
				return true
			end 'found'
			start = i + 1
		end 'cut'
	end 'scan'
	return false
end 'listsTarget'

let commaByte = 44 as Byte

// tierDirective names the tier a case is compiled in, and libraryTier the tier of the library's root, which a program staged in
// it is compiled in (Options.stagesInLibrary).
let tierDirective = "tier"

let libraryTier = "stdlib"

// stagedInLibrary is whether a case is compiled in the library tier.
function stagedInLibrary(test SpecTest) returns bool
	for i in 0 upto test.directives.count() 'directives'
		if directiveKey(test.directives[i]) == tierDirective and directiveValue(test.directives[i]) == libraryTier 'tier'
			return true
		end 'tier'
	end 'directives'
	return false
end 'stagedInLibrary'

// debugInfoDirective has the runner build the test with --debug-info and walk its sidecar before the run, as maxon's does
// (sidecarWalkFault).
let debugInfoDirective = "DebugInfo"

// buildsDebugInfo is whether the test carries the debugInfoDirective.
function buildsDebugInfo(test SpecTest) returns bool
	for i in 0 upto test.directives.count() 'directives'
		if directiveKey(test.directives[i]) == debugInfoDirective 'named'
			return true
		end 'named'
	end 'directives'
	return false
end 'buildsDebugInfo'

// discardSidecar deletes the sidecar beside exe, which the runner has walked.
function discardSidecar(exe String)
	let path = try FilePath.from(backend.sidecarPathOf(exe)) otherwise return
	try File.delete(path) otherwise ignore
end 'discardSidecar'

// directiveSkip is why a directive keeps this runner from running the test, or nothing when the runner can honour it. Each
// names a feature of maxon's runtime or of its runner that this compiler does not have yet.
function directiveSkip(directive String) returns table.Option with String
	let key = directiveKey(directive)
	if key == targetsDirective 'targets'
		return table.Option.none
	end 'targets'
	if key == tierDirective 'tier'
		if directiveValue(directive) == libraryTier 'library'
			return table.Option.none
		end 'library'
		return table.Option.some("stages the program in a module of the library (tier)")
	end 'tier'
	if key == "procs" or key == "preempt" or key == "runs" or key == "process" 'scheduler'
		return table.Option.some("needs maxon's scheduler or process isolation ({key})")
	end 'scheduler'
	if key == "network" or key == "stdin" or key == "Args" or key == "env" 'environment'
		return table.Option.some("needs a runner feature that is not written yet ({key})")
	end 'environment'
	if key == "MmTrace" or key == "LogTrace" or key == "AsyncTrace" 'trace'
		return table.Option.some("needs maxon's memory trace ({key})")
	end 'trace'
	if key == debugInfoDirective 'debugInfo'
		return table.Option.none
	end 'debugInfo'
	return table.Option.some("unknown directive {key}")
end 'directiveSkip'

// fenceBase is the name of a result fence without its target, in small letters; fenceTarget is the target or nothing.
function fenceBase(name String) returns String
	let split = findText(name, needle: targetSeparator)
	if not split.isSome() 'plain'
		return lowerText(name)
	end 'plain'
	return lowerText(name.sliceBytes(0, endPos: split.unwrap()))
end 'fenceBase'

function fenceTarget(name String) returns borrowed String
	let split = findText(name, needle: targetSeparator)
	if not split.isSome() 'plain'
		return name.sliceBytes(0, endPos: 0)
	end 'plain'
	return name.sliceBytes(offsetBy(split.unwrap(), by: 1), endPos: name.byteLength())
end 'fenceTarget'

function isKnownFence(base String) returns bool
	return base == exitFence or base == stdoutFence or base == stderrFence or base == compilerErrorFence
end 'isKnownFence'

// fenceSkip is why a block of the test keeps this runner from running it, or nothing.
function fenceSkip(fence SpecFence) returns table.Option with String
	let base = fenceBase(fence.name)
	if endsWith(base, suffix: traceFences) 'trace'
		return table.Option.some("needs maxon's memory trace ({base})")
	end 'trace'
	if not isKnownFence(base) 'unknown'
		return table.Option.some("unknown result block {fence.name}")
	end 'unknown'
	return table.Option.none
end 'fenceSkip'

// hostSkip is why the test does not run on the system the compiler runs on, though it may on another (targetSkip). A test of
// the list skipped so was recorded on another system, and is kept in the list rather than lost.
function hostSkip(test SpecTest) returns table.Option with String
	return targetSkip(test, target: hostTarget())
end 'hostSkip'

// targetSkip is why the test does not run for a target: its directive excludes the target, or it has a result block for
// another target.
function targetSkip(test SpecTest, target ast.Target) returns table.Option with String
	let name = target.name()
	for i in 0 upto test.directives.count() 'directives'
		if directiveKey(test.directives[i]) == targetsDirective and listsTarget(directiveValue(test.directives[i]), target: name) 'excluded'
			return table.Option.some("unsupported on {name}")
		end 'excluded'
	end 'directives'
	for i in 0 upto test.fences.count() 'fences'
		let fenced = fenceTarget(test.fences[i].name)
		if fenced != "" and fenced != name 'other'
			return table.Option.some("a result block for the target {fenced}")
		end 'other'
	end 'fences'
	return table.Option.none
end 'targetSkip'

// runTargets are the targets the test runs for, in the order of the compiler's targets; the first of them when none is
// left, as for a test with result blocks for two targets, which runs nowhere.
function runTargets(test SpecTest) returns ast.TargetList
	let known = ast.knownTargets()
	var runs = ast.TargetList.create(0)
	for i in 0 upto known.count() 'known'
		if not targetSkip(test, target: known[i]).isSome() 'runs'
			runs.push(known[i].clone())
		end 'runs'
	end 'known'
	if runs.count() == 0 'nowhere'
		runs.push(known[0].clone())
	end 'nowhere'
	return runs
end 'runTargets'

// skipReason is why the runner does not run a test, or nothing when it runs it: the conversion's skip, a directive or a
// block that needs more than this compiler has yet, or a source that stages maxon's own library.
function skipReason(test SpecTest, text String) returns table.Option with String
	return skipReasonFor(test, text: text, target: hostTarget())
end 'skipReason'

// skipReasonFor is skipReason for a run of the test's program for a target.
function skipReasonFor(test SpecTest, text String, target ast.Target) returns table.Option with String
	if test.skips.count() > 0 'converted'
		return table.Option.some(test.skips[0].clone())
	end 'converted'
	let onTarget = targetSkip(test, target: target)
	if onTarget.isSome() 'target'
		return onTarget
	end 'target'
	for i in 0 upto test.directives.count() 'directives'
		let reason = directiveSkip(test.directives[i])
		if reason.isSome() 'skipped'
			return reason
		end 'skipped'
	end 'directives'
	for i in 0 upto test.fences.count() 'fences'
		let reason = fenceSkip(test.fences[i])
		if reason.isSome() 'skipped'
			return reason
		end 'skipped'
	end 'fences'
	if test.hasSource and sourceHasOverlay(text.sliceBytes(test.sourceStart, endPos: test.sourceFinish)) 'overlay'
		return table.Option.some("stages a stdlib or runtime overlay")
	end 'overlay'
	return table.Option.none
end 'skipReasonFor'

// sourceHasOverlay is whether a block has a line that stages a private copy of maxon's stdlib or runtime.
function sourceHasOverlay(source String) returns bool
	var at = 0 as Count
	let n = source.byteLength()
	while at < n 'lines'
		if matchesAt(source, at: at, needle: overlaySectionPrefix) or matchesAt(source, at: at, needle: runtimeSectionPrefix) 'overlay'
			return true
		end 'overlay'
		while at < n and source.byteAt(at) != newlineByte 'skip'
			at = offsetBy(at, by: 1)
		end 'skip'
		at = offsetBy(at, by: 1)
	end 'lines'
	return false
end 'sourceHasOverlay'

// resultFence is the block of the test with that name, the one qualified for this target when there is one and the
// unqualified one otherwise.
function resultFence(test SpecTest, base String) returns table.Option with SpecFence
	var best = 0 as Count
	var found = false
	for i in 0 upto test.fences.count() 'fences'
		if fenceBase(test.fences[i].name) == base 'named'
			if fenceTarget(test.fences[i].name) == hostTarget().name() 'qualified'
				return table.Option.some(test.fences[i].clone())
			end 'qualified'
			if not found 'first'
				best = i
				found = true
			end 'first'
		end 'named'
	end 'fences'
	if not found 'none'
		return table.Option.none
	end 'none'
	return table.Option.some(test.fences[best].clone())
end 'resultFence'

// fenceText is the text of the test's result block with that name, or nothing when it has none.
function fenceText(test SpecTest, text String, base String) returns table.Option with String
	let fence = resultFence(test, base: base)
	if not fence.isSome() 'none'
		return table.Option.none
	end 'none'
	let found = fence.unwrap()
	return table.Option.some(text.sliceBytes(found.start, endPos: found.finish).clone())
end 'fenceText'

// SourceSection is one file of a multi-file block: its name, its text, where the text is in the block, and the number that
// its lines are counted from in the merged block that the expectations were written against.
type SourceSection
	var name as String
	var text as String
	var start as Count
	var lineOffset as Count

	static function make(consumes name String, consumes text String, start Count, lineOffset Count) returns SourceSection
		return SourceSection{name: name, text: text, start: start, lineOffset: lineOffset}
	end 'make'
end 'SourceSection'

// sectionOf is the section of the block that is the text from start until finish, trimmed.
function sectionOf(name String, source String, start Count, finish Count, lineOffset Count) returns SourceSection
	let raw = source.sliceBytes(start, endPos: finish)
	let leading = try raw.byteLength() - trimLeft(raw).byteLength() otherwise 0 as Count
	return SourceSection.make(name.clone(), text: trimSpace(raw).clone(), start: offsetBy(start, by: leading), lineOffset: lineOffset)
end 'sectionOf'

typealias SourceSections = Array with SourceSection

// splitSections is the files of a block that has `// --- file:` lines; it has none for a block of one file. The text above
// the first marker belongs to no file, and a section is trimmed. The offset of a file is the line of its marker, counted from
// 1, and the line of the header that maxon's fragment has.
function splitSections(source String) returns SourceSections
	var sections = SourceSections.create(0)
	var haveMarker = false
	var name = ""
	var bodyStart = 0 as Count
	var offset = 0 as Count
	var line = 0 as Count
	var at = 0 as Count
	let n = source.byteLength()
	while at <= n 'lines'
		var lineEnd = at
		while lineEnd < n and source.byteAt(lineEnd) != newlineByte 'scan'
			lineEnd = offsetBy(lineEnd, by: 1)
		end 'scan'
		if matchesAt(source, at: at, needle: fileSectionPrefix) 'marker'
			if haveMarker 'flush'
				sections.push(sectionOf(name, source: source, start: bodyStart, finish: at, lineOffset: offset))
			end 'flush'
			haveMarker = true
			name = trimSpace(source.sliceBytes(offsetBy(at, by: fileSectionPrefix.byteLength()), endPos: lineEnd)).clone()
			bodyStart = offsetBy(lineEnd, by: 1)
			offset = offsetBy(line, by: 2)
		end 'marker'
		line = offsetBy(line, by: 1)
		at = offsetBy(lineEnd, by: 1)
	end 'lines'
	if haveMarker 'last'
		sections.push(sectionOf(name, source: source, start: minCount(bodyStart, b: n), finish: n, lineOffset: offset))
	end 'last'
	return sections
end 'splitSections'

// sectionFiles is the files of a multi-file test as the compiler loads them from memory, at the paths they would have in a
// directory called projectRoot.
function sectionFiles(sections SourceSections) returns project.SourceFiles
	var files = project.SourceFiles.create(0)
	for i in 0 upto sections.count() 'files'
		files.push(project.SourceFile.make(project.joinPath(projectRoot, name: nativePath(sections[i].name)), text: "{sections[i].text}\n"))
	end 'files'
	return files
end 'sectionFiles'

// projectRoot is the directory that the files of a multi-file test are in, which is no directory of the system.
let projectRoot = "<project>"

// nativePath is a path of a section, which the corpus writes with portableSeparator, with the separators of the system.
function nativePath(name String) returns String
	return replaceText(name, needle: portableSeparator, replacement: ast.hostSeparator())
end 'nativePath'

// diagnosticText is the line of a diagnostic as the expectations write it: the file becomes `<fragment>` behind its
// directory in the block, and a line of a file of a multi-file test becomes the line of the merged block.
function diagnosticText(e diag.CompileError, sections SourceSections) returns String
	if not e.located or sections.count() == 0 'unchanged'
		return e.format()
	end 'unchanged'
	let prefix = projectPrefix()
	if not hasPrefix(e.file, prefix: prefix) 'outside'
		return e.format()
	end 'outside'
	let relative = portablePath(e.file.sliceBytes(prefix.byteLength(), endPos: e.file.byteLength()))
	for i in 0 upto sections.count() 'sections'
		if sections[i].name == relative 'found'
			let directory = relative.sliceBytes(0, endPos: directoryEnd(relative))
			return "error {e.code}: {directory}{fragmentToken}:{offsetBy(e.line, by: sections[i].lineOffset)}:{e.col}: {withoutProject(e.message)}"
		end 'found'
	end 'sections'
	return e.format()
end 'diagnosticText'

// withoutProject is a message with the directory of the files of the test taken out of the paths it names.
function withoutProject(message String) returns String
	return replaceText(message, needle: projectPrefix(), replacement: "")
end 'withoutProject'

// projectPrefix begins the path of each file of a multi-file test.
function projectPrefix() returns String
	return "{projectRoot}{ast.hostSeparator()}"
end 'projectPrefix'

// portableSeparator is the separator of the paths that the corpus writes, whatever the system.
let portableSeparator = "/"

// portablePath is a path with the separators that the corpus writes.
function portablePath(path String) returns String
	return replaceText(path, needle: ast.hostSeparator(), replacement: portableSeparator)
end 'portablePath'

// directoryEnd is where the directory part of a portable path ends, past its last separator.
function directoryEnd(path String) returns Count
	var at = path.byteLength()
	while at > 0 and path.byteAt(at - 1) != slashByte 'back'
		at = at - 1
	end 'back'
	return at
end 'directoryEnd'

// replaceText is text with each place that needle stands replaced by replacement.
function replaceText(text String, needle String, replacement String) returns String
	var out = ByteArray.create(0)
	var at = 0 as Count
	let n = text.byteLength()
	while at < n 'scan'
		if matchesAt(text, at: at, needle: needle) 'found'
			out.append(replacement.toByteArray())
			at = offsetBy(at, by: needle.byteLength())
		end 'found' else 'kept'
			out.push(text.byteAt(at))
			at = offsetBy(at, by: 1)
		end 'kept'
	end 'scan'
	return String.from(out)
end 'replaceText'

// withoutPositions is the diagnostics with the line and column taken out of each `<fragment>:line:column:`, for a test whose
// expectation counts lines that the conversion moved.
function withoutPositions(text String) returns String
	var out = ByteArray.create(0)
	let token = "{fragmentToken}:"
	var at = 0 as Count
	let n = text.byteLength()
	while at < n 'scan'
		if matchesAt(text, at: at, needle: token) 'token'
			let lineAt = offsetBy(at, by: token.byteLength())
			let lineEnd = digitsEnd(text, start: lineAt)
			if lineEnd > lineAt and lineEnd < n and text.byteAt(lineEnd) == colonByte 'column'
				let columnAt = offsetBy(lineEnd, by: 1)
				let columnEnd = digitsEnd(text, start: columnAt)
				if columnEnd > columnAt and columnEnd < n and text.byteAt(columnEnd) == colonByte 'positioned'
					out.append(fragmentToken.toByteArray())
					at = columnEnd
					continue 'scan'
				end 'positioned'
			end 'column'
		end 'token'
		out.push(text.byteAt(at))
		at = offsetBy(at, by: 1)
	end 'scan'
	return String.from(out)
end 'withoutPositions'

// diagnosticPlaces is the diagnostics as the runner compares them: each error's code and the place in the fragment that it
// names, one line each, without its message, its notes or the lines that continue it. minimaxon words its diagnostics
// differently from maxon (README, "Where it differs from Maxon"), so only what the program decides, which error and where,
// is maxon's. An error that names no place in the fragment is its code alone.
function diagnosticPlaces(text String) returns String
	let lines = splitLines(text)
	var out = ast.StringList.create(0)
	for i in 0 upto lines.count() 'lines'
		let line = lines[i].clone()
		let codeEnd = offsetBy(errorLinePrefix.byteLength(), by: diagnosticCodeWidth)
		if not hasPrefix(line, prefix: errorLinePrefix) or line.byteLength() < codeEnd 'notError'
			continue 'lines'
		end 'notError'
		let head = line.sliceBytes(0, endPos: codeEnd)
		let placeStart = offsetBy(codeEnd, by: placeEnd.byteLength())
		if not matchesAt(line, at: codeEnd, needle: placeEnd) 'unplaced'
			out.push(head.clone())
			continue 'lines'
		end 'unplaced'
		var at = placeStart
		while at < line.byteLength() and not matchesAt(line, at: at, needle: placeEnd) 'place'
			at = offsetBy(at, by: 1)
		end 'place'
		let place = line.sliceBytes(placeStart, endPos: at)
		if place.contains(fragmentToken) 'placed'
			out.push("{head}{placeEnd}{place}")
		end 'placed' else 'elsewhere'
			out.push(head.clone())
		end 'elsewhere'
	end 'lines'
	return joinLines(out)
end 'diagnosticPlaces'

// placeEnd ends the place of a diagnostic, before its message.
let placeEnd = ": "

// digitsEnd is where the run of decimal digits that starts at start ends.
function digitsEnd(text String, start Count) returns Count
	var at = start
	while at < text.byteLength() and text.byteAt(at) >= zeroByte and text.byteAt(at) <= nineByte 'digits'
		at = offsetBy(at, by: 1)
	end 'digits'
	return at
end 'digitsEnd'

// isContinuationByte is whether c continues a character of UTF-8, so that a cut before it would split the character.
function isContinuationByte(c Byte) returns bool
	return c >= continuationFirst and c <= continuationLast
end 'isContinuationByte'

let continuationFirst = 128 as Byte

let continuationLast = 191 as Byte

// oneLine is text on one line, cut to the longest a failure shows, at a character.
function oneLine(text String, limit Count) returns String
	var out = ByteArray.create(0)
	for i in 0 upto text.byteLength() 'bytes'
		let c = text.byteAt(i)
		if out.count() >= limit and not isContinuationByte(c) 'cut'
			out.append("...".toByteArray())
			break 'bytes'
		end 'cut'
		if c == newlineByte 'newline'
			out.append("\\n".toByteArray())
		end 'newline' else if c != carriageReturnByte 'kept'
			out.push(c)
		end 'kept'
	end 'bytes'
	return String.from(out)
end 'oneLine'

// firstDifference says in a line where two texts first differ, by their lines.
function firstDifference(expected String, actual String) returns String
	let wanted = splitLines(expected)
	let got = splitLines(actual)
	let shared = minCount(wanted.count(), b: got.count())
	for i in 0 upto shared 'lines'
		if wanted[i] != got[i] 'differs'
			return "line {i + 1}: expected `{oneLine(wanted[i], limit: shownLineLimit)}`, got `{oneLine(got[i], limit: shownLineLimit)}`"
		end 'differs'
	end 'lines'
	if wanted.count() > got.count() 'missing'
		return "expected more: `{oneLine(wanted[got.count()], limit: shownLineLimit)}` is missing"
	end 'missing'
	return "unexpected extra: `{oneLine(got[wanted.count()], limit: shownLineLimit)}`"
end 'firstDifference'

function minCount(a Count, b Count) returns Count
	if a < b 'less'
		return a
	end 'less'
	return b
end 'minCount'

// SpecRun is the tally of a run over spec files, and what it knows of the list of the tests that passed before.
type SpecRun
	var options as SpecOptions
	var passed as Count
	var failed as Count
	var skipped as Count
	var reasons as ast.StringList
	var counts as CountList
	var indexes as ReasonIndex
	// listed is the keys of the list that was read.
	var listed as TestSet
	// keptKeys are the tests that the next list holds: those that passed, and those of the list that the run did not find
	// passing for any reason but the conversion's skip.
	var keptKeys as ast.StringList
	// lost counts the tests of the list that a run requiring it found failing or skipped.
	var lost as Count
	// listPath is where the list is, which a run that renews it writes.
	var listPath as String
	// saved is the line of results of each test taken in, which a run that saves them writes at the end.
	var saved as ast.StringList

	static function make(consumes options SpecOptions, before ast.StringList, consumes listPath String) returns SpecRun
		var listed = TestSet.new()
		for i in 0 upto before.count() 'keys'
			listed.insert(before[i].clone(), value: setMember)
		end 'keys'
		return SpecRun{options: options, passed: 0, failed: 0, skipped: 0, reasons: ast.StringList.create(0), counts: CountList.create(0), indexes: ReasonIndex.new(), listed: listed, keptKeys: ast.StringList.create(0), lost: 0, listPath: listPath, saved: ast.StringList.create(0)}
	end 'make'

	// countSkip counts a skipped test under its reason.
	function countSkip(mutates self, reason String)
		skipped = offsetBy(skipped, by: 1)
		match consumes indexes.get(reason) 'known'
			some(at) then counts[at] = offsetBy(counts[at], by: 1)
			none then self.addReason(reason)
		end 'known'
	end 'countSkip'

	function addReason(mutates self, reason String)
		indexes.insert(reason.clone(), value: reasons.count())
		reasons.push(reason.clone())
		counts.push(1)
	end 'addReason'

	// skipsPassed is whether the test with this key is left out because it passed before.
	function skipsPassed(key String) returns bool
		return options.skipPassed and listed.has(key)
	end 'skipsPassed'

	// notePass counts a test that passed, and says so when a run that reports new passes finds one that is not listed.
	function notePass(mutates self, key String)
		passed = offsetBy(passed, by: 1)
		keptKeys.push(key.clone())
		if options.reportsNew() and not listed.has(key) 'fresh'
			print("{newPrefix} {key}\n")
		end 'fresh'
		if options.verbose 'say'
			print("PASS {key}\n")
		end 'say'
	end 'notePass'

	// noteLost counts a test of the list that did not pass, which a run that requires the list reports.
	function noteLost(mutates self, key String, what String)
		lost = offsetBy(lost, by: 1)
		print("{lostPrefix} {key}: {what}\n")
	end 'noteLost'

	// take counts the result of the test of job and prints what the run says of it. A test of the list stays in it unless
	// the conversion now skips it, which is a change of the language or of the conversion, never a regression.
	function take(mutates self, job SpecJob, result TestResult)
		if options.results == ResultsMode.resultsSave 'save'
			saved.push(resultLine(job.key, result: result))
		end 'save'
		let inList = listed.has(job.key)
		if job.listed 'known'
			self.countSkip(passedBeforeReason)
			keptKeys.push(job.key.clone())
		end 'known' else if result.outcome == TestOutcome.testFailed 'failed'
			failed = offsetBy(failed, by: 1)
			if inList and options.requirePassed 'lost'
				self.noteLost(job.key, what: result.detail)
			end 'lost' else 'new'
				print("FAIL {job.key}: {result.detail}\n")
			end 'new'
			if inList 'kept'
				keptKeys.push(job.key.clone())
			end 'kept'
		end 'failed' else if result.outcome == TestOutcome.testUnsupported 'unsupported'
			self.countSkip(result.detail)
			if options.verbose 'say'
				print("SKIP {job.key}: {result.detail}\n")
			end 'say'
			if inList and job.test.skips.count() > 0 'converted'
				if options.record 'dropped'
					print("{droppedPrefix} {job.key}: {result.detail}\n")
				end 'dropped' else if options.requirePassed 'lost'
					self.noteLost(job.key, what: "skipped: {result.detail}")
				end 'lost'
			end 'converted' else if inList 'kept'
				keptKeys.push(job.key.clone())
				if options.requirePassed and not hostSkip(job.test).isSome() 'lost'
					self.noteLost(job.key, what: "skipped: {result.detail}")
				end 'lost'
			end 'kept'
		end 'unsupported' else 'passed'
			self.notePass(job.key)
		end 'passed'
	end 'take'
end 'SpecRun'

// finishSpecs prints the counts of a run over spec files, writes the list of the tests that passed when the run renews it,
// and gives the code the run exits with: a run that requires the list fails when a test of it did not pass, and any other
// that does not record fails when a test failed.
function finishSpecs(tally SpecRun) returns ExitCode
	removeTree(specRunDirectory(project.parentDir(tally.listPath)))
	print("\n")
	printSummary(tally)
	if tally.options.record 'record'
		writePassedList(tally.listPath, tally: tally)
	end 'record'
	if tally.options.results == ResultsMode.resultsSave 'save'
		writeResults(tally.options.resultsPath, lines: tally.saved)
	end 'save'
	if tally.options.requirePassed 'required'
		if tally.lost > 0 'lost'
			print("{tally.lost} tests of {passedListName} did not pass\n")
			return diagnosticsExitCode
		end 'lost'
		return 0
	end 'required'
	if tally.failed == 0 or tally.options.record 'clean'
		return 0
	end 'clean'
	return diagnosticsExitCode
end 'finishSpecs'

// specRunDirectory is the directory every program of a run of the spec tests at root runs in, as maxon's runner runs them:
// .spec-run-<pid> in the directory that holds the specs directory, the checkout's root, since the tests' relative paths are
// written against that depth (`../stdlib` is the checkout's library), whether the run is of the directory or of one file
// of it. It is the run's own, named for its process, so two runs never share one, and it is made empty at the start of the
// run and removed at its end.
function specRunDirectory(root String) returns String
	let specs = root.clone() if project.isDirectoryPath(root) else project.parentDir(root)
	return project.joinPath(project.parentDir(specs), name: "{specRunPrefix}{Process.id()}")
end 'specRunDirectory'

let specRunPrefix = ".spec-run-"

// specCacheDirectory is the build cache of the run's compiles: a directory in the run's own, so that it starts empty and goes
// with it, and the stdlib's modules, which every test names and which are the most of each compile, are compiled once for each
// variant of the library and options the tests have rather than once for each test. It is nothing when MINIMAXON_CACHE turns
// the cache off.
function specCacheDirectory(runDirectory String) returns String
	if (try Process.environmentVariable(cacheVariable) otherwise "") == cacheOff 'off'
		return ""
	end 'off'
	let dir = project.joinPath(runDirectory, name: specCacheName)
	if not makeDirectories(dir) 'unmade'
		return ""
	end 'unmade'
	return dir
end 'specCacheDirectory'

let specCacheName = ".build-cache"

// removeTree deletes the directory at path and everything in it, when it is there.
function removeTree(path String)
	let at = try FilePath.from(path) otherwise return
	if not Directory.isDirectory(at) 'none'
		return
	end 'none'
	let entries = try Directory.list(at) otherwise panic("test: cannot list {path} to remove it")
	for i in 0 upto entries.count() 'entries'
		if Directory.isDirectory(entries[i]) 'directory'
			removeTree(entries[i].toString())
		end 'directory' else 'file'
			try File.delete(entries[i]) otherwise panic("test: cannot delete {entries[i].toString()}")
		end 'file'
	end 'entries'
	try Directory.delete(at) otherwise panic("test: cannot remove {path}")
end 'removeTree'

// passedKeysOf is the tests that the text of a list names, one for each line.
function passedKeysOf(text String) returns ast.StringList
	var keys = ast.StringList.create(0)
	let lines = splitLines(withoutCarriageReturns(text, loneToo: false))
	for i in 0 upto lines.count() 'lines'
		if lines[i] != "" 'named'
			keys.push(lines[i].clone())
		end 'named'
	end 'lines'
	return keys
end 'passedKeysOf'

// writePassedList writes the list of the next run, sorted: the tests this run found passing, and the listed ones that it
// keeps.
function writePassedList(path String, tally SpecRun)
	var keys = tally.keptKeys.clone()
	project.sortStrings(keys)
	let text = "{joinLines(keys)}\n"
	try File.writeText(try FilePath.from(path) otherwise panic("test: {path} is not a path"), content: text) otherwise panic("test: cannot write {path}")
end 'writePassedList'

// printSummary prints the counts, and the skipped tests by reason, the most first; the reasons past the first ones are
// counted together unless the run is verbose.
function printSummary(tally SpecRun)
	print("{tally.passed} passed, {tally.failed} failed, {tally.skipped} skipped\n")
	if tally.skipped == 0 'none'
		return
	end 'none'
	var order = CountList.create(0)
	for i in 0 upto tally.reasons.count() 'each'
		var at = order.count()
		order.push(i)
		while at > 0 'sift'
			let before = at - 1
			if not skipsBefore(tally, a: order[at], b: order[before]) 'ordered'
				break 'sift'
			end 'ordered'
			let moved = order[at]
			order[at] = order[before]
			order[before] = moved
			at = before
		end 'sift'
	end 'each'
	print("skipped by reason:\n")
	var rest = 0 as Count
	var restReasons = 0 as Count
	for i in 0 upto order.count() 'reasons'
		if i < listedSkipReasons or tally.options.verbose 'listed'
			print("{tally.counts[order[i]]}  {tally.reasons[order[i]]}\n")
		end 'listed' else 'rest'
			rest = offsetBy(rest, by: tally.counts[order[i]])
			restReasons = restReasons + 1
		end 'rest'
	end 'reasons'
	if restReasons > 0 'others'
		print("{rest}  {restReasons} other reasons (--verbose lists them)\n")
	end 'others'
end 'printSummary'

// skipsBefore is whether the reason a stands before the reason b: it has more tests, or as many and the lesser name.
function skipsBefore(tally SpecRun, a Count, b Count) returns bool
	if tally.counts[a] != tally.counts[b] 'counts'
		return tally.counts[a] > tally.counts[b]
	end 'counts'
	return diag.stringLess(tally.reasons[a], b: tally.reasons[b])
end 'skipsBefore'

// isSpecPath is whether a path given to test names spec files: one file of the format, or a directory of them. A directory
// that holds source too is a project whose README is a document, as the runtime's is.
function isSpecPath(path String) returns bool
	if project.isDirectoryPath(path) 'directory'
		let listed = try Directory.list(try FilePath.from(path) otherwise return false) otherwise return false
		var holdsSpec = false
		for i in 0 upto listed.count() 'entries'
			if endsWith(listed[i].toString(), suffix: sourceExtension) 'source'
				return false
			end 'source'
			if endsWith(listed[i].toString(), suffix: specExtension) 'spec'
				holdsSpec = true
			end 'spec'
		end 'entries'
		return holdsSpec
	end 'directory'
	return endsWith(path, suffix: specExtension)
end 'isSpecPath'

function endsWith(text String, suffix String) returns bool
	let n = text.byteLength()
	return n >= suffix.byteLength() and text.sliceBytes(try n - suffix.byteLength() otherwise 0, endPos: n) == suffix
end 'endsWith'

// specFiles is the spec files at path in order: the file, or the .md files of the directory.
function specFiles(path String) returns ast.StringList
	var files = ast.StringList.create(0)
	if not project.isDirectoryPath(path) 'file'
		files.push(path.clone())
		return files
	end 'file'
	let listed = try Directory.list(try FilePath.from(path) otherwise panic("test: {path} is not a path")) otherwise panic("test: cannot read {path}")
	for i in 0 upto listed.count() 'entries'
		let name = project.lastComponent(listed[i].toString()).clone()
		if endsWith(name, suffix: specExtension) 'spec'
			files.push(project.joinPath(path, name: name))
		end 'spec'
	end 'entries'
	project.sortStrings(files)
	return files
end 'specFiles'

// runSpecs runs the tests of the spec files at path as behaviours (startTests), which report the failures in the order of
// the tests as they go and the counts at the end, and set the code the process exits with. A run that skips the passed tests
// leaves out those the list has; one that requires them fails when one of them does not pass; one that records writes the
// list again, with the tests that passed in this run, and starts it when there is none. compiling says the target the tests
// are compiled for and whether they are only compiled; a run that runs them is for the host.
function runSpecs(path String, options SpecOptions, compiling CorpusOptions, width RunWidth) returns ExitCode
	let root = project.absolutePath(path)
	let listPath = project.joinPath(root, name: passedListName)
	var before = ast.StringList.create(0)
	if options.needsList() 'list'
		if not project.isDirectoryPath(root) 'file'
			printError("test: {recordPassedFlag}, {skipPassedFlag} and {requirePassedFlag} take the directory of the specs, which holds {passedListName}\n")
			return usageExitCode
		end 'file'
		if options.skipPassed and options.requirePassed 'both'
			printError("test: {skipPassedFlag} leaves out the tests that {requirePassedFlag} requires to pass: give one of them\n")
			return usageExitCode
		end 'both'
		let text = project.readTextFile(listPath)
		if text.isSome() 'read'
			before = passedKeysOf(text.unwrap())
		end 'read' else if not options.record 'missing'
			printError("test: {listPath} does not exist: run `test {path} {recordPassedFlag}` to write it\n")
			return diagnosticsExitCode
		end 'missing'
	end 'list'
	let tally = SpecRun.make(options.clone(), before: before, listPath: listPath)
	var files = SpecFiles.create(0)
	var jobs = Jobs.create(0)
	let paths = specFiles(root)
	for f in 0 upto paths.count() 'files'
		addSpecJobs(paths[f], file: f, tally: tally, jobs: jobs, files: files)
	end 'files'
	if options.results == ResultsMode.resultsReplay 'replay'
		return replaySpecs(tally, jobs: jobs, path: options.resultsPath)
	end 'replay'
	let directory = specRunDirectory(root)
	let made = try FilePath.from(directory) otherwise panic("test: the run's directory {directory} is not a path")
	removeTree(directory)
	if not Directory.create(made) 'unmade'
		printError("test: cannot make the run's directory {directory}\n")
		return diagnosticsExitCode
	end 'unmade'
	var corpus = compiling.clone()
	corpus.workingDirectory = directory.clone()
	let cacheDir = specCacheDirectory(directory)
	var host = SharedRuntime.none()
	if corpus.target.name() != hostTarget().name() 'foreign'
		host = prepareCachedRuntime(hostTarget(), cacheDir: cacheDir)
	end 'foreign'
	let target = corpus.target.clone()
	startTests(prepareCachedRuntime(target, cacheDir: cacheDir), host: host, jobs: jobs, files: files, corpus: corpus, verbose: options.verbose, scratch: Scratch.make("spec", suffix: executableExtension(target)), width: width, tally: Tally.spec(tally))
	return compiledByBehaviours
end 'runSpecs'

// replaySpecs takes the result of each test from the file of results at path, in place of running the tests, and counts and
// prints them as a run of the tests does. The file must be of these very tests, in this order: it says so by their keys, and
// when it does not the run is refused, so that nothing is replayed that was not run.
function replaySpecs(consumes tally SpecRun, jobs Jobs, path String) returns ExitCode
	return match consumes readReplayedResults(path) 'read'
		unreadable(reason) gives refusedReplay(reason)
		read(kept) gives replayedSpecs(tally, jobs: jobs, kept: kept)
	end 'read'
end 'replaySpecs'

function refusedReplay(reason String) returns ExitCode
	printError("test: {replayResultsFlag}: {reason}\n")
	return replayRefusedExitCode
end 'refusedReplay'

function replayedSpecs(consumes tally SpecRun, jobs Jobs, kept ReplayedResults) returns ExitCode
	var held = tally
	if kept.keys.count() != jobs.count() 'count'
		return refusedReplay("the results are of {kept.keys.count()} tests and the run has {jobs.count()}")
	end 'count'
	for i in 0 upto jobs.count() 'each'
		let key = specJobKey(jobs[i])
		if kept.keys[i] != key 'key'
			return refusedReplay("the results hold {kept.keys[i]} where the run has {key}")
		end 'key'
		held = takenBySpecs(held, job: jobs[i], result: kept.results[i].clone())
	end 'each'
	return finishSpecs(held)
end 'replayedSpecs'

// specJobKey is the key of a test of the spec files.
function specJobKey(job Job) returns String
	return match job 'job'
		corpus(_) panic("test: a program of the corpus in a run of the spec files")
		spec(value) gives value.key.clone()
	end 'job'
end 'specJobKey'

// addSpecJobs reads the spec file at path, which is the run's file numbered file, and adds it to files and its tests to jobs.
function addSpecJobs(path String, file Count, tally SpecRun, mutates jobs Jobs, mutates files SpecFiles)
	let text = readText(path)
	let display = project.lastComponent(path)
	let tests = parseSpec(text)
	for i in 0 upto tests.count() 'tests'
		let key = "{display}: {tests[i].name}"
		let listed = tally.skipsPassed(key)
		jobs.push(Job.spec(SpecJob.make(file, key: key, test: tests[i].clone(), listed: listed)))
	end 'tests'
	files.push(SpecFile.make(text, stem: fileStem(path)))
end 'addSpecJobs'

function readText(file String) returns String
	let path = try FilePath.from(file) otherwise panic("test: {file} is not a path")
	return try File.readText(path) otherwise panic("test: cannot read {file}")
end 'readText'

// fileStem is the name of a file without its directory and its extension.
function fileStem(file String) returns String
	let name = project.lastComponent(file)
	if endsWith(name, suffix: specExtension) 'extension'
		return name.sliceBytes(0, endPos: try name.byteLength() - specExtension.byteLength() otherwise 0).clone()
	end 'extension'
	return name.clone()
end 'fileStem'

// stageSpecTest stages the test of job, test index of the run, of the spec file file: it is skipped for a reason of the runner,
// or compiled to the executable at exe and checked against its result blocks as far as it can be before the executable runs.
// A run that only compiles stops there (compiledOnly).
function stageSpecTest(shared SharedRuntime, host SharedRuntime, job SpecJob, file SpecFile, index Count, exe String, options CorpusOptions) returns Staged
	let reason = skipReasonFor(job.test, text: file.text, target: options.target)
	if reason.isSome() 'skipped'
		return Staged.done(Finished.make(TestResult.unsupported(reason.unwrap())))
	end 'skipped'
	if not job.test.hasSource 'noSource'
		return Staged.done(Finished.make(TestResult.failed("the test has no maxon block")))
	end 'noSource'
	let source = file.text.sliceBytes(job.test.sourceStart, endPos: job.test.sourceFinish)
	let sections = splitSections(source)
	var errs = diag.ErrorList.create(0)
	let compiled = compileSpecSource(shared, exe: exe, test: job.test, source: source, sections: sections, verifies: options.verifiesIr, keepsLowered: options.interprets, errs: errs)
	let checked = checkSpecTest(job.test, text: file.text, stem: file.stem, errs: errs, sections: sections)
	if options.compilesOnly 'compiledOnly'
		if buildsDebugInfo(job.test) and errs.count() == 0 'sidecar'
			discardSidecar(exe)
		end 'sidecar'
		let built = errs.count() == 0
		if not checked.isSome() 'compiled'
			return doneBuilt(TestResult.passed(), exe: exe, built: built)
		end 'compiled'
		let result = checked.unwrap()
		if result.outcome == TestOutcome.testFailed 'failed'
			return compiledOnlyFailure(host, test: job.test, file: file, exe: exe, built: built, source: source, sections: sections, failure: result, options: options)
		end 'failed'
		return doneBuilt(result, exe: exe, built: built)
	end 'compiledOnly'
	if checked.isSome() 'checked'
		return doneBuilt(checked.unwrap(), exe: exe, built: errs.count() == 0)
	end 'checked'
	if buildsDebugInfo(job.test) 'sidecar'
		let fault = sidecarWalkFault(exe)
		discardSidecar(exe)
		if fault.isSome() 'unwalkable'
			return doneBuilt(TestResult.failed(fault.unwrap()), exe: exe, built: true)
		end 'unwalkable'
	end 'sidecar'
	return Staged.needsRun(PendingRun.spec(SpecPending.make(index, exe: exe.clone(), test: job.test.clone(), file: job.file, compiled: compiled, interprets: options.interprets)))
end 'stageSpecTest'

// compiledOnlyFailure is what a spec test that a compile-only run compiled for another target than the host, and that did not
// compile as its blocks say (failure), comes to: a failure when the host's compile of it does compile as they say, since a
// compile for another target may not fail where the host's does not, and else a skip, as the host fails it too. A run for
// the host has no other compile to hold the test to, so there the failure is the host's. The executable is at exe, which
// the compile for the target made when built, as the host's may.
function compiledOnlyFailure(host SharedRuntime, test SpecTest, file SpecFile, exe String, built bool, source String, sections SourceSections, failure TestResult, options CorpusOptions) returns Staged
	if options.target.name() == hostTarget().name() 'host'
		return doneBuilt(TestResult.unsupported(hostFailsReason), exe: exe, built: built)
	end 'host'
	var errs = diag.ErrorList.create(0)
	_ = compileSpecSource(host, exe: exe, test: test, source: source, sections: sections, verifies: false, keepsLowered: false, errs: errs)
	let hostBuilt = errs.count() == 0
	if buildsDebugInfo(test) and hostBuilt 'sidecar'
		discardSidecar(exe)
	end 'sidecar'
	let checked = checkSpecTest(test, text: file.text, stem: file.stem, errs: errs, sections: sections)
	if checked.isSome() and checked.unwrap().outcome == TestOutcome.testFailed 'hostFails'
		return doneBuilt(TestResult.unsupported(hostFailsReason), exe: exe, built: built or hostBuilt)
	end 'hostFails'
	return doneBuilt(TestResult.failed("compiles as expected for {hostTarget().name()} and not for {options.target.name()}: {failure.detail}"), exe: exe, built: built or hostBuilt)
end 'compiledOnlyFailure'

// hostFailsReason is the skip of a spec test that a compile-only run found compiling as its blocks say for no target.
let hostFailsReason = "does not compile as its blocks say for the host either"

// compileSpecSource compiles the maxon block of a test, split into sections, as the runner does: a fragment under maxon's
// header line, or the files of a multi-file block. An executable is made at exe when there is no error; verifies checks
// the IR and the allocation of every function (--verify-ir).
function compileSpecSource(shared SharedRuntime, exe String, test SpecTest, source String, sections SourceSections, verifies bool, keepsLowered bool, mutates errs diag.ErrorList) returns CompiledProgram
	var options = testOptions()
	options.verifyIr = verifies
	options.stagesInLibrary = stagedInLibrary(test)
	options.debugInfo = buildsDebugInfo(test)
	options.keepsLowered = keepsLowered
	// The cache holds a library module as code, and the interpreter runs the IR of every module the program reaches.
	if not options.debugInfo and not keepsLowered 'cached'
		options.cacheDir = shared.cacheDir.clone()
		options.compiler = shared.compiler.clone()
		options.speculates = shared.cacheDir != ""
	end 'cached'
	var compiled as CompiledProgram
	if sections.count() == 0 'single'
		let fragment = "{fragmentHeader}{test.name}\n{source}\n"
		compiled = compileSourceWith(shared, path: fragmentToken, text: fragment, output: exe, options: options, errs: errs)
	end 'single' else 'project'
		compiled = compileFilesWith(shared, path: projectRoot, files: sectionFiles(sections), output: exe, options: options, errs: errs)
	end 'project'
	if not keepsLowered 'dropped'
		return CompiledProgram.nothing()
	end 'dropped'
	return compiled
end 'compileSpecSource'

// expectedFirstCode is the code of the first error that the test's maxoncstderr block lists, or nothing when the test
// expects no compile error.
function expectedFirstCode(test SpecTest, text String) returns table.Option with String
	let expected = fenceText(test, text: text, base: compilerErrorFence)
	if not expected.isSome() 'none'
		return table.Option.none
	end 'none'
	let block = trimSpace(expected.unwrap()).clone()
	let start = errorLinePrefix.byteLength()
	let finish = try start + diagnosticCodeWidth otherwise return table.Option.none
	if not hasPrefix(block, prefix: errorLinePrefix) or block.byteLength() < finish 'unlisted'
		return table.Option.none
	end 'unlisted'
	return table.Option.some(block.sliceBytes(start, endPos: finish).clone())
end 'expectedFirstCode'

// checkSpecTest is whether a compile that gave errs is what the result blocks of the test say, or nothing when the compile
// made an executable that is to say it (checkSpecRun).
function checkSpecTest(test SpecTest, text String, stem String, errs diag.ErrorList, sections SourceSections) returns table.Option with TestResult
	let expected = fenceText(test, text: text, base: compilerErrorFence)
	if expected.isSome() 'expectsError'
		return table.Option.some(checkSpecError(test, expected: expected.unwrap(), stem: stem, errs: errs, sections: sections))
	end 'expectsError'
	if errs.count() > 0 'failed'
		return table.Option.some(TestResult.failed("unexpected compile error: {oneLine(errs[0].code, limit: detailLimit)} {oneLine(errs[0].message, limit: detailLimit)}"))
	end 'failed'
	return table.Option.none
end 'checkSpecTest'

// checkSpecError is whether the diagnostics are what the maxoncstderr block says, by code and place (diagnosticPlaces),
// with the positions left out when the conversion moved them.
function checkSpecError(test SpecTest, expected String, stem String, errs diag.ErrorList, sections SourceSections) returns TestResult
	if errs.count() == 0 'compiled'
		return TestResult.failed("compiled, but expected {oneLine(trimSpace(expected), limit: detailLimit)}")
	end 'compiled'
	var lines = ast.StringList.create(0)
	for i in 0 upto errs.count() 'errors'
		lines.push(diagnosticText(errs[i], sections: sections))
	end 'errors'
	var actual = trimSpace(joinLines(lines)).clone()
	var wanted = trimSpace(replaceText(expected, needle: "specs/{stem}/{test.name}.maxon", replacement: fragmentToken)).clone()
	if test.positionsMoved 'moved'
		actual = withoutPositions(actual)
		wanted = withoutPositions(wanted)
	end 'moved'
	actual = diagnosticPlaces(actual)
	wanted = diagnosticPlaces(wanted)
	if placesAgree(wanted, actual: actual) 'same'
		return TestResult.passed()
	end 'same'
	return TestResult.failed("wrong compile error: {firstDifference(wanted, actual: actual)}")
end 'checkSpecError'

// placesAgree is whether the diagnostics, as diagnosticPlaces gives them, are the ones expected, one for one: the same
// code at the same place, or at any place where maxon named none.
function placesAgree(wanted String, actual String) returns bool
	let want = splitLines(wanted)
	let got = splitLines(actual)
	if want.count() != got.count() 'count'
		return false
	end 'count'
	for i in 0 upto want.count() 'each'
		if want[i] != got[i] and not hasPrefix(got[i], prefix: "{want[i]}{placeEnd}") 'differs'
			return false
		end 'differs'
	end 'each'
	return true
end 'placesAgree'

function joinLines(lines ast.StringList) returns String
	var out = ByteArray.create(0)
	for i in 0 upto lines.count() 'each'
		if i > 0 'separator'
			out.push(newlineByte)
		end 'separator'
		out.append(lines[i].toByteArray())
	end 'each'
	return String.from(out)
end 'joinLines'

// checkSpecRun runs the compiled program in directory, the run's (specRunDirectory), and checks its exit code, when the test
// gives one, and its output, which must be what the blocks say or else nothing.
function checkSpecRun(test SpecTest, text String, exe String, directory String) returns TestResult
	match consumes runExecutable(exe, runner: TargetRunner.native, directory: directory, workers: 0, envRunner: "", input: "") 'run'
		ran(out) then return checkSpecOutput(test, text: text, out: out)
		cannotStart(reason) then return TestResult.failed("cannot run the executable: {reason}")
		timedOut then return TestResult.failed("timed out")
	end 'run'
end 'checkSpecRun'

function checkSpecOutput(test SpecTest, text String, out CollectedOutput) returns TestResult
	let code = out.exitCode()
	let exitText = fenceText(test, text: text, base: exitFence)
	if exitText.isSome() 'pinned'
		let parsed = parseCount(trimSpace(exitText.unwrap()))
		if not parsed.isSome() 'malformed'
			return TestResult.failed("the exitcode block is not a number")
		end 'malformed'
		let want = parsed.unwrap()
		if want != (code as Count) 'differs'
			if code >= signBit 'crash'
				return TestResult.failed("crash: exit {exitCodeText(code)}, expected {want}; stderr: {oneLine(trimSpace(out.stderr), limit: detailLimit)}")
			end 'crash'
			return TestResult.failed("wrong exit code: {exitCodeText(code)}, expected {want}; stderr: {oneLine(trimSpace(out.stderr), limit: detailLimit)}")
		end 'differs'
	end 'pinned'
	let stdoutResult = checkStream(test, text: text, base: stdoutFence, actual: withoutCarriageReturns(out.stdout, loneToo: false))
	if stdoutResult.outcome == TestOutcome.testFailed 'stdout'
		return stdoutResult
	end 'stdout'
	return checkStderr(test, text: text, actual: withoutCarriageReturns(out.stderr, loneToo: false))
end 'checkSpecOutput'

// checkStderr is checkStream for standard error, whose block maxon wrote with its runner's name for the file of a fragment,
// which is `<fragment>` here, and with the backtrace that maxon's panic prints and minimaxon's does not.
function checkStderr(test SpecTest, text String, actual String) returns TestResult
	let block = fenceText(test, text: text, base: stderrFence)
	var wanted = ""
	if block.isSome() 'pinned'
		wanted = trimSpace(withoutBacktrace(replaceText(block.unwrap(), needle: "{test.name}{fragmentExtension}:", replacement: "{fragmentToken}:"))).clone()
	end 'pinned'
	return compareStream(stderrFence, wanted: wanted, actual: actual)
end 'checkStderr'

// withoutBacktrace is text without the lines of a backtrace: a `Stack trace:` line and the `  in` lines after it.
function withoutBacktrace(text String) returns String
	var out = ByteArray.create(0)
	var inTrace = false
	var at = 0 as Count
	let n = text.byteLength()
	while at < n 'lines'
		var lineEnd = at
		while lineEnd < n and text.byteAt(lineEnd) != newlineByte 'scan'
			lineEnd = offsetBy(lineEnd, by: 1)
		end 'scan'
		let next = minCount(offsetBy(lineEnd, by: 1), b: n)
		if matchesAt(text, at: at, needle: backtraceHeader) 'header'
			inTrace = true
		end 'header' else if not (inTrace and matchesAt(text, at: at, needle: backtraceFrame)) 'kept'
			inTrace = false
			out.append(text.sliceBytes(at, endPos: next).toByteArray())
		end 'kept'
		at = next
	end 'lines'
	return String.from(out)
end 'withoutBacktrace'

// checkStream is whether the output of a run is the text of the block with that name, trimmed on both sides, or empty when
// the test has no such block.
function checkStream(test SpecTest, text String, base String, actual String) returns TestResult
	let block = fenceText(test, text: text, base: base)
	var wanted = ""
	if block.isSome() 'pinned'
		wanted = trimSpace(block.unwrap()).clone()
	end 'pinned'
	return compareStream(base, wanted: wanted, actual: actual)
end 'checkStream'

function compareStream(base String, wanted String, actual String) returns TestResult
	let got = trimSpace(actual)
	if got == wanted 'same'
		return TestResult.passed()
	end 'same'
	return TestResult.failed("wrong {base}: {firstDifference(wanted, actual: got)}")
end 'compareStream'
