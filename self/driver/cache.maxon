// The build cache: a module's code unit, kept on disk under a key that holds everything the unit is made from, so that a
// compile whose module has the same key links the kept unit and runs none of the module's stages after its constants.
//
// key(M)     = digest(base, M's path, M's source: every file's name and bytes, and the summary of each module M names)
// summary(M) = digest(M's public text, the IR of M's leaves, and the summary of each module M names)
//
// base is the compiler (its build ID, or the digest of its executable), the target, the options that change what a module compiles to and,
// for a program, the runtime's source. A module's public text is its source with the body of each function that no other
// module copies left out (publicDigest): what another module reads of M is its declarations, its constants, its generics'
// and extensions' bodies and the IR of its leaves, which a caller inlines, so an edit of any other body changes M's key and
// no summary, and the modules that name M keep their keys. A module whose stages found an error never gets an entry.

// cacheVariable names the environment variable that names the cache's directory, or turns the cache off.
let cacheVariable = "MINIMAXON_CACHE"

let cacheOff = "off"

// defaultCacheFolder is where the cache is under the user's local application data when cacheVariable names none: one
// cache for every project, as its keys name what made each entry.
let defaultCacheFolder = "minimaxon\\cache"

let localDataVariable = "LOCALAPPDATA"

// entryMagic and entryFormat begin every entry, so that a file of another kind or of an earlier layout is no entry.
let entryMagic = "minimaxon build cache entry"

let entryFormat = 2 as Count

let entryExtension = ".entry"

let temporaryExtension = ".tmp"

// An entry's time on the file system says when a compile last used it: a compile that uses an entry whose time is older
// than usedRefreshSeconds writes it again, so that a use costs no write most of the time, and the end of a compile, at most
// once in trimIntervalSeconds, deletes every file of the cache unused for trimLimitSeconds (Go's rules for its build cache:
// an hour, a day and five days). Every time is the file system's, so no clock of the machine is set against a file's.
let usedRefreshSeconds = 3600 as Count

let trimIntervalSeconds = 86400 as Count

let trimLimitSeconds = 432000 as Count

// trimStampName is the file whose time is when the cache was last trimmed, and clockName the one each compile writes to read
// the file system's time now.
let trimStampName = "trim.txt"

let clockName = "clock"

// cacheDirectory is the directory of the build cache, made if it is not there, or nothing when the environment turns the
// cache off.
function cacheDirectory() returns String
	let named = try Process.environmentVariable(cacheVariable) otherwise ""
	if named == cacheOff 'off'
		return ""
	end 'off'
	var dir = named.clone()
	if dir == "" 'default'
		let local = try Process.environmentVariable(localDataVariable) otherwise ""
		if local == "" 'nowhere'
			return ""
		end 'nowhere'
		dir = project.joinPath(local, name: defaultCacheFolder)
	end 'default'
	if not makeDirectories(dir) 'unmade'
		return ""
	end 'unmade'
	return dir
end 'cacheDirectory'

// makeDirectories makes dir and the directories above it that are not there, and is whether dir is there then.
function makeDirectories(dir String) returns bool
	if project.isDirectoryPath(dir) 'there'
		return true
	end 'there'
	let above = project.parentDir(dir)
	if above != dir and above != "." and not makeDirectories(above) 'aboveUnmade'
		return false
	end 'aboveUnmade'
	let path = try FilePath.from(dir) otherwise return false
	_ = Directory.create(path)
	return project.isDirectoryPath(dir)
end 'makeDirectories'

// compilerIdentity is the digest of the compiler's own executable, which every key holds, so that a compiler never reads what
// another made: its build ID, which the link that made it wrote into buildIdField (backend.stampBuildId), or, for a compiler
// whose link wrote none, as the seeds', the digest of its executable, hashed whole.
function compilerIdentity() returns table.Digest
	match builtId() 'stamped'
		some(id) then return id.clone()
		none then _ = 0
	end 'stamped'
	let exe = try Process.executablePath() otherwise panic("driver: the compiler's own path is unavailable")
	let bytes = try File.readText(exe) otherwise panic("driver: the compiler cannot read its own executable")
	var h = table.Hasher.new()
	h.addText(bytes)
	return h.digest()
end 'compilerIdentity'

// buildIdField is the compiler's build ID's field: the link of the compiler's executable writes the hexadecimal digest of the
// image in place of the zeros (backend.stampBuildId).
let buildIdField = "minimaxon build id 00000000000000000000000000000000"

// builtId is the build ID the link wrote into buildIdField, or none where the zeros are still there.
function builtId() returns table.Option with table.Digest
	let field = buildIdField
	let start = backend.buildIdPrefix.byteLength()
	var hi = 0 as table.Word64
	var lo = 0 as table.Word64
	var any = false
	for i in 0 upto backend.buildIdDigits 'digits'
		let c = field.byteAt(try start + i otherwise return table.Option.none)
		var v = 0 as table.Word64
		if c >= 48 and c <= 57 'decimal'
			v = (c - 48) as table.Word64
		end 'decimal' else if c >= 97 and c <= 102 'letter'
			v = (c - 87) as table.Word64
		end 'letter' else 'other'
			return table.Option.none
		end 'other'
		if c != 48 'nonzero'
			any = true
		end 'nonzero'
		if i < 16 'high'
			hi = (hi shl 4) or v
		end 'high' else 'low'
			lo = (lo shl 4) or v
		end 'low'
	end 'digits'
	if not any 'zeros'
		return table.Option.none
	end 'zeros'
	return table.Option.some(table.Digest.make(hi, lo: lo))
end 'builtId'

// CacheSetup is how a compile uses the cache: its directory (none when the compile uses no cache), the digest of what every
// key of the compile holds, and whether the compile compiles every module and holds what it makes to the entries it finds
// (--verify-cache), rather than linking them.
type CacheSetup
	var dir as String
	var base as table.Digest
	var verifies as bool
	// speculates takes the summary that a module whose source changed made the last time its shown text and the summaries of
	// the modules it names were what they are (speculationKey) for the one it will make, so that the modules that name it find
	// their entries before it is lowered; a compile whose module then makes another is done again without (finishCompile).
	var speculates as bool
	// now is the file system's time when the compile began, which an entry's time is held to, or none where it cannot be read.
	var now as table.Option with Count

	static function off() returns CacheSetup
		return CacheSetup{dir: "", base: table.Digest.none(), verifies: false, speculates: false, now: table.Option.none}
	end 'off'

	static function make(consumes dir String, consumes base table.Digest, verifies bool, speculates bool, consumes now table.Option with Count) returns CacheSetup
		return CacheSetup{dir: dir, base: base, verifies: verifies, speculates: speculates, now: now}
	end 'make'

	function enabled() returns bool
		return dir != ""
	end 'enabled'
end 'CacheSetup'

// cacheSetupOf is how a compile of the modules of p from first on, with options, uses the cache. A compile that writes the IR or
// verifies it needs every module's, so it uses none.
function cacheSetupOf(p ast.Project, first Count, options Options) returns CacheSetup
	if options.cacheDir == "" or options.emitIr or options.verifyIr 'off'
		return CacheSetup.off()
	end 'off'
	var h = table.Hasher.new()
	h.addText(entryMagic)
	h.addCount(entryFormat)
	h.addDigest(options.compiler)
	h.addText(p.target.os())
	h.addText(p.target.archText())
	h.addBool(options.countAllocations)
	if first > 0 and p.modules[0].isRuntime 'program'
		h.addDigest(sourceDigest(p.modules[0].path, text: p.modules[0].tree.text, files: p.modules[0].files))
	end 'program'
	return CacheSetup.make(options.cacheDir.clone(), base: h.digest(), verifies: options.verifiesCache, speculates: options.speculates and not options.verifiesCache, now: fileSystemNow(options.cacheDir))
end 'cacheSetupOf'

// ModuleDigests are what a module's key and summary are made from: its source and its public text, which its parse makes, and
// its summary, which its lower makes or the entry it was compiled from holds.
type ModuleDigests
	var source as table.Digest
	var shown as table.Digest
	var summary as table.Digest

	static function none() returns ModuleDigests
		return ModuleDigests{source: table.Digest.none(), shown: table.Digest.none(), summary: table.Digest.none()}
	end 'none'
end 'ModuleDigests'

// sourceDigest is the digest of a module's source: its path, and each file's name and bytes, in order.
function sourceDigest(path String, text String, files ast.FileSpanList) returns table.Digest
	var h = table.Hasher.new()
	h.addText(path)
	for i in 0 upto files.count() 'files'
		h.addText(project.lastComponent(files[i].path))
		h.addRange(text, begin: files[i].start as Count, finish: files[i].endOff as Count)
	end 'files'
	return h.digest()
end 'sourceDigest'

// publicDigest is the digest of a module's public text: its source without its comment lines and without the body of each
// function, method or test that another module never copies: one that uses no type parameter and stands in no type that does,
// in no interface and in no extension. The layout is part of the language, so a function's header is one line and its body the
// lines below it up to the `end` at the header's indentation.
function publicDigest(path String, text String, files ast.FileSpanList) returns table.Digest
	var h = table.Hasher.new()
	h.addText(path)
	for i in 0 upto files.count() 'files'
		h.addText(project.lastComponent(files[i].path))
		addPublicText(h, text: text, begin: files[i].start as Count, finish: files[i].endOff as Count)
	end 'files'
	return h.digest()
end 'publicDigest'

// Indents are the indentations of the types, interfaces and extensions a line stands in.
typealias Indents = Array with Count

function addPublicText(mutates h table.Hasher, text String, begin Count, finish Count)
	var scopes = Indents.create(0)
	var copied = Placed.create(0)
	var at = begin
	while at < finish 'lines'
		let lineEnd = endOfLine(text, at: at, finish: finish)
		let tabs = indentOf(text, at: at, lineEnd: lineEnd)
		let start = try at + tabs otherwise panic("driver: a line past memory")
		var next = lineEnd
		next = try lineEnd + 1 otherwise panic("driver: a line past memory")
		if start < lineEnd and not startsWith(text, at: start, prefix: "//") 'code'
			h.addRange(text, begin: at, finish: lineEnd)
			let content = afterModifiers(text, at: start, lineEnd: lineEnd)
			if scopes.count() > 0 and tabs == scopes[ir.pred(scopes.count())] and startsWith(text, at: start, prefix: "end '") 'close'
				_ = table.popLast(scopes)
				_ = try copied.pop() otherwise panic("driver: no scope to close")
			end 'close' else if opensScope(text, at: content) 'open'
				scopes.push(tabs)
				copied.push(startsWith(text, at: content, prefix: "interface ") or startsWith(text, at: content, prefix: "extension ") or usesTypeParameters(text, at: content, lineEnd: lineEnd))
			end 'open' else if isFunctionHeader(text, at: content) and not inCopiedScope(copied) and not usesTypeParameters(text, at: content, lineEnd: lineEnd) 'function'
				next = bodyEnd(text, after: next, finish: finish, tabs: tabs)
			end 'function'
		end 'code'
		at = next
	end 'lines'
end 'addPublicText'

function inCopiedScope(copied Placed) returns bool
	for i in 0 upto copied.count() 'scopes'
		if copied[i] 'copied'
			return true
		end 'copied'
	end 'scopes'
	return false
end 'inCopiedScope'

// bodyEnd is where the line of the end of a function whose header is indented tabs and whose body starts at after begins: the
// first line below it that is indented no deeper. A header with no lines below it deeper has no body, and nothing is left out.
function bodyEnd(text String, after Count, finish Count, tabs Count) returns Count
	var at = after
	while at < finish 'lines'
		let lineEnd = endOfLine(text, at: at, finish: finish)
		let indent = indentOf(text, at: at, lineEnd: lineEnd)
		let start = try at + indent otherwise panic("driver: a line past memory")
		if start < lineEnd and not startsWith(text, at: start, prefix: "//") and indent <= tabs 'shallow'
			if indent == tabs and startsWith(text, at: start, prefix: "end '") and at > after 'end'
				return at
			end 'end'
			return after
		end 'shallow'
		at = try lineEnd + 1 otherwise panic("driver: a line past memory")
	end 'lines'
	return after
end 'bodyEnd'

function endOfLine(text String, at Count, finish Count) returns Count
	var i = at
	while i < finish and text.byteAt(i) != newlineByte 'scan'
		i = i + 1
	end 'scan'
	return i
end 'endOfLine'

function indentOf(text String, at Count, lineEnd Count) returns Count
	var i = at
	while i < lineEnd and text.byteAt(i) == tabByte 'tabs'
		i = i + 1
	end 'tabs'
	return try i - at otherwise panic("driver: a line that ends before it starts")
end 'indentOf'

function startsWith(text String, at Count, prefix String) returns bool
	let n = prefix.byteLength()
	let left = try text.byteLength() - at otherwise 0
	if left < n 'short'
		return false
	end 'short'
	for i in 0 upto n 'bytes'
		if text.byteAt(try at + i otherwise panic("driver: a line past memory")) != prefix.byteAt(i) 'differs'
			return false
		end 'differs'
	end 'bytes'
	return true
end 'startsWith'

// afterModifiers is where a declaration's keyword starts on a line that starts at at: after `export`, `public` and `static`.
function afterModifiers(text String, at Count, lineEnd Count) returns Count
	var i = at
	var more = true
	while more 'modifiers'
		more = false
		if startsWith(text, at: i, prefix: "export ") 'export'
			i = try i + 7 otherwise panic("driver: a line past memory")
			more = true
		end 'export' else if startsWith(text, at: i, prefix: "public ") 'public'
			i = try i + 7 otherwise panic("driver: a line past memory")
			more = true
		end 'public' else if startsWith(text, at: i, prefix: "static ") 'static'
			i = try i + 7 otherwise panic("driver: a line past memory")
			more = true
		end 'static'
	end 'modifiers'
	return i
end 'afterModifiers'

function opensScope(text String, at Count) returns bool
	return startsWith(text, at: at, prefix: "type ") or startsWith(text, at: at, prefix: "union ") or startsWith(text, at: at, prefix: "enum ") or startsWith(text, at: at, prefix: "interface ") or startsWith(text, at: at, prefix: "extension ")
end 'opensScope'

function isFunctionHeader(text String, at Count) returns bool
	return startsWith(text, at: at, prefix: "function ") or startsWith(text, at: at, prefix: "test '")
end 'isFunctionHeader'

// usesTypeParameters is whether the declaration on the line from at to lineEnd declares type parameters.
function usesTypeParameters(text String, at Count, lineEnd Count) returns bool
	var i = at
	while i < lineEnd 'scan'
		if startsWith(text, at: i, prefix: " uses ") 'uses'
			return true
		end 'uses'
		i = i + 1
	end 'scan'
	return false
end 'usesTypeParameters'

// leafDigest is the digest of the IR of the leaves among fns, a module's functions as its lower ended, which a module that
// names it copies into its own code: the IR's text names functions and types by their link names, never by a handle.
function leafDigest(p ast.Project, ms ast.ModuleState, fns ir.IrFunctionList, leaves opt.Leaves) returns table.Digest
	var h = table.Hasher.new()
	for i in 0 upto fns.count() 'functions'
		if leaves.holds(fns[i].decl) 'leaf'
			h.addText(ir.irText(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: fns[i]))
		end 'leaf'
	end 'functions'
	return h.digest()
end 'leafDigest'

// Summaries are the summaries of the modules a compile compiles, by their place among them.
typealias Summaries = Array with table.Digest

// summariesOf are the summaries that known holds.
function summariesOf(known Known) returns Summaries
	var summaries = Summaries.create(0)
	for k in 0 upto known.count() 'modules'
		summaries.push(known[k].digests.summary.clone())
	end 'modules'
	return summaries
end 'summariesOf'

// summaryOf is the summary of module m of p, whose digests are own, from its leaves' digest and the summaries of the modules it
// names that the compile compiles.
function summaryOf(c Compile, p ast.Project, m Count, own ModuleDigests, leaves table.Digest, summaries Summaries) returns table.Digest
	var h = table.Hasher.new()
	h.addText("summary")
	h.addDigest(own.shown)
	h.addDigest(leaves)
	addNamedSummaries(h, c: c, p: p, m: m, summaries: summaries)
	return h.digest()
end 'summaryOf'

// keyOf is the key of module m of p, whose digests are own, from the summaries of the modules it names.
function keyOf(c Compile, p ast.Project, m Count, own ModuleDigests, summaries Summaries) returns table.Digest
	var h = table.Hasher.new()
	h.addDigest(c.cache.base)
	h.addText(p.modules[m].path)
	h.addDigest(own.source)
	addNamedSummaries(h, c: c, p: p, m: m, summaries: summaries)
	return h.digest()
end 'keyOf'

function addNamedSummaries(mutates h table.Hasher, c Compile, p ast.Project, m Count, summaries Summaries)
	for j in 0 upto p.resolutions[m].deps.count() 'deps'
		let d = ast.modIndex(p.resolutions[m].deps[j].module)
		if d >= c.first and d != m 'compiled'
			h.addText(p.modules[d].path)
			h.addDigest(summaries[c.slotOf(d)])
		end 'compiled'
	end 'deps'
end 'addNamedSummaries'

// CachedEntry is an entry of the cache as a compile found it: the summary of the module it was made for and its unit's bytes,
// with their digest.
// FoundEntry is the entry found under a module's key, or none.
typealias FoundEntry = table.Option with CachedEntry

type CachedEntry
	var summary as table.Digest
	var check as table.Digest
	var payload as String

	static function make(consumes summary table.Digest, consumes check table.Digest, consumes payload String) returns CachedEntry
		return CachedEntry{summary: summary, check: check, payload: payload}
	end 'make'
end 'CachedEntry'

function entryPath(dir String, key table.Digest) returns String
	return project.joinPath(dir, name: "{key.hex()}{entryExtension}")
end 'entryPath'

// readEntry is the entry of the cache at dir under key, or nothing when there is none, or a file there that is no whole entry
// of this layout under that key, which is then no entry.
function readEntry(setup CacheSetup, key table.Digest) returns table.Option with CachedEntry
	let dir = setup.dir.clone()
	let path = try FilePath.from(entryPath(dir, key: key)) otherwise return table.Option.none
	let text = try File.readText(path) otherwise return table.Option.none
	markUsed(setup, path: entryPath(dir, key: key), bytes: text)
	var r = table.ByteReader.of(text)
	let magic = r.text()
	let format = r.count()
	let found = r.digest()
	let summary = r.digest()
	let check = r.digest()
	let payload = r.text()
	if r.broken or not r.atEnd() or magic != entryMagic or format != entryFormat or not found.equals(key) 'none'
		return table.Option.none
	end 'none'
	return table.Option.some(CachedEntry.make(summary, check: check, payload: payload))
end 'readEntry'

// writeEntry keeps unit, of a module whose summary is summary, in the cache at dir under key: written whole to a file of its
// own and renamed over the entry's name, so that no reader meets half of it. An entry that another compile wrote first is
// the same bytes, and is kept.
function writeEntry(dir String, key table.Digest, summary table.Digest, unit backend.CodeUnit)
	var body = table.ByteWriter.new()
	backend.writeUnit(unit, w: body)
	var check = table.Hasher.new()
	check.addBytes(body.bytes)
	var w = table.ByteWriter.new()
	w.text(entryMagic)
	w.count(entryFormat)
	w.digest(key)
	w.digest(summary)
	w.digest(check.digest())
	w.run(body.bytes)
	writeWhole(entryPath(dir, key: key), bytes: w.bytes)
end 'writeEntry'

// unitOf is the unit that the entry found under key holds.
function unitOf(found table.Option with CachedEntry, dir String, key table.Digest) returns backend.CodeUnit
	return match found 'f'
		some(entry) gives unitIn(entry, dir: dir, key: key)
		none panic("driver: the unit of an entry that was not found")
	end 'f'
end 'unitOf'

// unitIn is the unit that entry, found under key, holds; an entry whose bytes are not those it was written with is damage of
// the cache that no compile can go on from, as the module's stages that would make its unit did not run.
function unitIn(entry CachedEntry, dir String, key table.Digest) returns backend.CodeUnit
	var check = table.Hasher.new()
	check.addText(entry.payload)
	var r = table.ByteReader.of(entry.payload.clone())
	let unit = backend.readUnit(r)
	if not check.digest().equals(entry.check) or r.broken or not r.atEnd() 'damaged'
		panic("driver: the build cache's entry {entryPath(dir, key: key)} is damaged; delete it")
	end 'damaged'
	return unit
end 'unitIn'

// holdToEntry holds unit, which the emit of the module at path made where the compile verifies the cache, to the unit of the
// entry found under its key: a difference is a fault of the key, which leaves out something the unit is made from.
function holdToEntry(found table.Option with CachedEntry, unit backend.CodeUnit, path String)
	var body = table.ByteWriter.new()
	backend.writeUnit(unit, w: body)
	let made = String.from(body.bytes)
	let kept = match found 'f'
		some(entry) gives entry.payload.clone()
		none panic("driver: a unit is held to an entry that was not found")
	end 'f'
	if made != kept 'differs'
		panic("driver: module {path} compiles to another unit than the build cache's entry under its key, so its key leaves out something its unit is made from")
	end 'differs'
end 'holdToEntry'

// CachePlan is what the order decides for one module from the cache: its key and the entry under it, where it could know
// them, and how far its stages run.
type CachePlan
	var key as table.Digest
	var found as table.Option with CachedEntry
	var reach as Reach
	// speculated is the summary the module is taken to make, where its key finds no entry and speculationKey a summary.
	var speculated as bool
	var summary as table.Digest
	// checkedKey is the key of the module's checked state, where its key is known, and checked the state found under it for a
	// module that is restored.
	var checkedKey as table.Digest
	var checked as table.Option with CheckedEntry

	static function make(reach Reach) returns CachePlan
		return CachePlan{key: table.Digest.none(), found: FoundEntry.none, reach: reach, speculated: false, summary: table.Digest.none(), checkedKey: table.Digest.none(), checked: FoundChecked.none}
	end 'make'
end 'CachePlan'

// planModules is, by place among the modules the compile compiles, what the order decides from the cache, in order, the
// modules of p sorted each after the modules it names, of which reached are compiled past their resolve. A module is settled
// when every module it names is and the cache holds an entry under its key, whose summary it then has. A module that is not
// settled, and every module it names, directly or not, read what one another's check and lower made, since it may
// instantiate a generic or inline a leaf of any of them: a settled one among them whose checked state the cache holds loads
// it (Reach.restored), and the others are checked and lowered. A settled module that none of them reaches runs nothing after
// its constants, and its emit links the entry's unit (Reach.loaded). A compile that verifies the cache checks and lowers
// every module.
function planModules(c Compile, p ast.Project, order check.ModuleOrder, known Known, reached Placed) returns Array with CachePlan
	var plans as Array with CachePlan
	plans = Array.create(0)
	for slot in 0 upto c.modules 'modules'
		var reach = Reach.whole
		if not reached[c.moduleOf(slot)] 'unreached'
			reach = Reach.resolved
		end 'unreached'
		plans.push(CachePlan.make(reach))
	end 'modules'
	if not c.cache.enabled() 'off'
		return plans
	end 'off'
	var summaries = Summaries.create(0)
	var settled = Placed.create(0)
	for _ in 0 upto c.modules 'none'
		summaries.push(table.Digest.none())
		settled.push(false)
	end 'none'
	for i in 0 upto order.count() 'probe'
		let m = ast.modIndex(order[i])
		let slot = c.slotOf(m)
		if reached[m] and namedSettled(c, p: p, m: m, settled: settled, plans: plans) 'named'
			let key = keyOf(c, p: p, m: m, own: known[slot].digests, summaries: summaries)
			plans[slot].key = key.clone()
			plans[slot].checkedKey = checkedKey(c, p: p, m: m, key: key)
			plans[slot].found = readEntry(c.cache, key: key)
			if plans[slot].found.isSome() 'hit'
				settled[slot] = true
				summaries[slot] = foundSummary(plans[slot].found)
			end 'hit' else if c.cache.speculates 'speculate'
				match readSpeculation(c.cache, key: speculationKey(c, p: p, m: m, own: known[slot].digests, summaries: summaries)) 'last'
					some(summary) then speculate(plans[slot], summaries: summaries, slot: slot, summary: summary)
					none then _ = 0
				end 'last'
			end 'speculate'
		end 'named'
	end 'probe'
	var checked = Placed.create(0)
	var pending = TaskIDs.create(0)
	for slot in 0 upto c.modules 'unsettled'
		let unsettled = reached[c.moduleOf(slot)] and not settled[slot]
		checked.push(unsettled or c.cache.verifies)
		if unsettled 'pending'
			pending.push(c.moduleOf(slot))
		end 'pending'
	end 'unsettled'
	markNamedClosure(c, p: p, marked: checked, pending: pending)
	for slot in 0 upto c.modules 'loaded'
		if settled[slot] and not checked[slot] 'ready'
			plans[slot].reach = Reach.loaded
		end 'ready' else if settled[slot] and not c.cache.verifies 'restored'
			plans[slot].checked = readChecked(c.cache, key: plans[slot].checkedKey)
			if plans[slot].checked.isSome() 'found'
				plans[slot].reach = Reach.restored
			end 'found'
		end 'restored'
	end 'loaded'
	return plans
end 'planModules'

// markNamedClosure marks in marked, by place among the modules the compile compiles, every one of them that the modules in
// pending name, directly or through others, and spends pending. It reads only what each module's resolve recorded, so it
// marks modules that the compile already reached and never one it did not: it is how a module that is not settled finds the
// modules whose check and lower it reads, and how the inline of a module finds the modules whose leaves it may copy, the
// same set.
function markNamedClosure(c Compile, p ast.Project, mutates marked Placed, mutates pending TaskIDs)
	while pending.count() > 0 'closure'
		let m = table.popLast(pending)
		for j in 0 upto p.resolutions[m].deps.count() 'deps'
			let d = ast.modIndex(p.resolutions[m].deps[j].module)
			if d >= c.first and not marked[c.slotOf(d)] 'new'
				marked[c.slotOf(d)] = true
				pending.push(d)
			end 'new'
		end 'deps'
	end 'closure'
end 'markNamedClosure'

// namedSettled is whether every module that module m of p names, and the compile compiles, is settled, or is taken to make the
// summary it made the last time.
function namedSettled(c Compile, p ast.Project, m Count, settled Placed, plans Array with CachePlan) returns bool
	for j in 0 upto p.resolutions[m].deps.count() 'deps'
		let d = ast.modIndex(p.resolutions[m].deps[j].module)
		if d >= c.first and d != m and not settled[c.slotOf(d)] and not plans[c.slotOf(d)].speculated 'open'
			return false
		end 'open'
	end 'deps'
	return true
end 'namedSettled'

// withCache is options with the build cache that the environment names, unless the command line turned it off or the compile
// writes or verifies the IR, which needs every module's, or writes debug info, whose lines a cached unit does not keep.
function withCache(options Options) returns Options
	var cached = options.clone()
	if not options.usesCache or options.emitIr or options.verifyIr or options.debugInfo 'off'
		return cached
	end 'off'
	cached.cacheDir = cacheDirectory()
	if cached.cacheDir != "" 'on'
		cached.compiler = compilerIdentity()
		cached.speculates = true
	end 'on'
	return cached
end 'withCache'

// speculate takes summary, which a module made the last time its shown text and the summaries of the modules it names were what
// they are, for the summary the module at slot will make.
function speculate(mutates plan CachePlan, mutates summaries Summaries, slot Count, summary table.Digest)
	plan.speculated = true
	plan.summary = summary.clone()
	summaries[slot] = summary.clone()
end 'speculate'

// speculationKey is what names the summary that module m of p, whose digests are own, made the last time its shown text and the
// summaries of the modules it names were what they are: its summary differs from it only where the IR of a leaf did.
function speculationKey(c Compile, p ast.Project, m Count, own ModuleDigests, summaries Summaries) returns table.Digest
	var h = table.Hasher.new()
	h.addDigest(c.cache.base)
	h.addText("speculation")
	h.addText(p.modules[m].path)
	h.addDigest(own.shown)
	addNamedSummaries(h, c: c, p: p, m: m, summaries: summaries)
	return h.digest()
end 'speculationKey'

let speculationExtension = ".summary"

function speculationPath(dir String, key table.Digest) returns String
	return project.joinPath(dir, name: "{key.hex()}{speculationExtension}")
end 'speculationPath'

// readSpeculation is the summary kept under key, or nothing.
function readSpeculation(setup CacheSetup, key table.Digest) returns table.Option with table.Digest
	let dir = setup.dir.clone()
	let path = try FilePath.from(speculationPath(dir, key: key)) otherwise return table.Option.none
	let text = try File.readText(path) otherwise return table.Option.none
	markUsed(setup, path: speculationPath(dir, key: key), bytes: text)
	var r = table.ByteReader.of(text)
	let magic = r.text()
	let found = r.digest()
	let summary = r.digest()
	if r.broken or not r.atEnd() or magic != entryMagic or not found.equals(key) 'none'
		return table.Option.none
	end 'none'
	return table.Option.some(summary)
end 'readSpeculation'

// writeSpeculation keeps the summary a module made under key, written whole and renamed over its name.
function writeSpeculation(dir String, key table.Digest, summary table.Digest)
	var w = table.ByteWriter.new()
	w.text(entryMagic)
	w.digest(key)
	w.digest(summary)
	writeWhole(speculationPath(dir, key: key), bytes: w.bytes)
end 'writeSpeculation'

// writeWhole writes bytes to a file of its own beside path and renames it over path, so that no reader meets half of it; a
// file that another compile wrote there first holds the same bytes, and is kept.
function writeWhole(path String, bytes ByteArray)
	let temporary = "{path}{temporarySuffix()}"
	let temporaryPath = try FilePath.from(temporary) otherwise return
	let finalPath = try FilePath.from(path) otherwise return
	try File.writeBinary(temporaryPath.clone(), content: bytes) otherwise return
	try File.rename(temporaryPath.clone(), to: finalPath) otherwise ignore
	try File.delete(temporaryPath) otherwise ignore
end 'writeWhole'

// temporarySuffix ends the name of a file that one write makes and renames or deletes: the process's id and the clock's
// nanoseconds, so that two writes share one only when they are of one process and start within one tick of its clock, as two
// compiles of one process at once, the workers of a run of tests, otherwise would every time. A write that met another in its
// tick could only lose its entry, which a read refuses when it is not whole and of its key.
function temporarySuffix() returns String
	return ".{Process.id()}-{Clock.nowNanos()}{temporaryExtension}"
end 'temporarySuffix'

// fileTime is the time the file at path was last written, in seconds on the file system's clock, or none where there is no
// such file or it cannot be read.
function fileTime(path String) returns table.Option with Count
	let at = try FilePath.from(path) otherwise return table.Option.none
	let info = try File.info(at) otherwise return table.Option.none
	return table.Option.some(info.modifiedTime)
end 'fileTime'

// fileSystemNow is the file system's time now, as the time of a file of the cache at dir that this process writes and
// deletes, or none where it cannot: each call names its own (temporarySuffix), so two compiles never write one.
function fileSystemNow(dir String) returns table.Option with Count
	if dir == "" 'off'
		return table.Option.none
	end 'off'
	let path = project.joinPath(dir, name: "{clockName}{temporarySuffix()}")
	let at = try FilePath.from(path) otherwise return table.Option.none
	try File.writeText(at.clone(), content: "") otherwise return table.Option.none
	let now = fileTime(path)
	try File.delete(at) otherwise ignore
	return now
end 'fileSystemNow'

// needsRefresh is whether a file of the cache last written at written is used at now so long after that its use is written
// down again (usedRefreshSeconds).
function needsRefresh(written Count, now Count) returns bool
	return now > written and now - written > usedRefreshSeconds
end 'needsRefresh'

// markUsed writes down that the file of the cache at path, which holds bytes, is used now: where its time is older than the
// refresh allows, it is written again whole, as any write of the cache is, so that a reader meets the old bytes or the same
// new ones. A write that fails leaves the use unrecorded, which can cost a trim that comes too early, so a miss, and never a
// wrong build.
function markUsed(setup CacheSetup, path String, bytes String)
	var now = 0 as Count
	match setup.now 'n'
		some(t) then now = t
		none then return
	end 'n'
	var written = 0 as Count
	match fileTime(path) 'w'
		some(t) then written = t
		none then return
	end 'w'
	if needsRefresh(written, now: now) 'refresh'
		writeWhole(path, bytes: bytes.toByteArray())
	end 'refresh'
end 'markUsed'

// trimDue is whether a trim that was last done at stamp, where there was one, is due at now (trimIntervalSeconds).
function trimDue(stamp table.Option with Count, now Count) returns bool
	return match stamp 's'
		some(t) gives now < t or now - t >= trimIntervalSeconds
		none gives true
	end 's'
end 'trimDue'

// CacheFile is a file of the cache's directory as a trim sees it: its path and the time it was last written.
type CacheFile
	var path as String
	var written as Count

	static function make(consumes path String, written Count) returns CacheFile
		return CacheFile{path: path, written: written}
	end 'make'
end 'CacheFile'

typealias CacheFiles = Array with CacheFile

// isCacheFile is whether a file of the cache's directory is one the cache wrote and a trim or a clear may delete: an entry, a
// checked state, a summary or a temporary file, never the stamp of the trims nor anything else that is there.
function isCacheFile(path String) returns bool
	return project.endsWithText(path, suffix: entryExtension) or project.endsWithText(path, suffix: checkedExtension) or project.endsWithText(path, suffix: speculationExtension) or project.endsWithText(path, suffix: temporaryExtension)
end 'isCacheFile'

// staleFiles are the paths of the files of the cache among files that were last written longer than limit seconds before now.
function staleFiles(files CacheFiles, now Count, limit Count) returns ast.StringList
	var stale = ast.StringList.create(0)
	for i in 0 upto files.count() 'files'
		let written = files[i].written
		if isCacheFile(files[i].path) and now > written and now - written > limit 'stale'
			stale.push(files[i].path.clone())
		end 'stale'
	end 'files'
	return stale
end 'staleFiles'

// cacheFiles are the files of the cache at dir with their times, in the order the directory lists them.
function cacheFiles(dir String) returns CacheFiles
	var files = CacheFiles.create(0)
	let at = try FilePath.from(dir) otherwise return files
	let listed = try Directory.list(at) otherwise return files
	for i in 0 upto listed.count() 'each'
		let path = listed[i].toString()
		if isCacheFile(path) 'cache'
			match fileTime(path) 'time'
				some(t) then files.push(CacheFile.make(path, written: t))
				none then continue 'each'
			end 'time'
		end 'cache'
	end 'each'
	return files
end 'cacheFiles'

// deleteAll deletes the files at paths, and gives how many it deleted. A file that another compile has open is left, and so
// is one another compile deleted first: a compile that looks for a deleted entry misses it and makes it again.
function deleteAll(paths ast.StringList) returns Count
	var deleted = 0 as Count
	for i in 0 upto paths.count() 'each'
		let at = try FilePath.from(paths[i]) otherwise continue 'each'
		try 'delete'
			File.delete(at)
			deleted = try deleted + 1 otherwise panic("driver: more files deleted than memory")
		end 'delete' otherwise 'kept'
			continue 'each'
		end 'kept'
	end 'each'
	return deleted
end 'deleteAll'

// trimWhenDue trims the cache at the end of a compile that used it, where the last trim is a day old: the stamp is written
// first, so that the compiles that end meanwhile find the trim done.
function trimWhenDue(setup CacheSetup)
	var now = 0 as Count
	match setup.now 'n'
		some(t) then now = t
		none then return
	end 'n'
	let stamp = project.joinPath(setup.dir, name: trimStampName)
	if not trimDue(fileTime(stamp), now: now) 'early'
		return
	end 'early'
	let at = try FilePath.from(stamp) otherwise return
	try File.writeText(at, content: "") otherwise return
	_ = deleteAll(staleFiles(cacheFiles(setup.dir), now: now, limit: trimLimitSeconds))
end 'trimWhenDue'

let cacheTrimVerb = "trim"

let cacheClearVerb = "clear"

// cacheCommand is `cache`: with no verb it says where the cache is and what it holds, `cache trim` deletes what a trim would
// whether one is due or not, and `cache clear` deletes every file the cache wrote.
function cacheCommand(rest CommandNames) returns ExitCode
	let dir = cacheDirectory()
	if dir == "" 'none'
		printError("cache: there is no build cache: {cacheVariable} is {cacheOff}, or {localDataVariable} is not set\n")
		return diagnosticsExitCode
	end 'none'
	let files = cacheFiles(dir)
	if rest.count() == 1 'report'
		var bytes = 0 as Count
		for i in 0 upto files.count() 'files'
			let at = try FilePath.from(files[i].path) otherwise continue 'files'
			let info = try File.info(at) otherwise continue 'files'
			bytes = try bytes + info.size otherwise panic("cache: more bytes than memory")
		end 'files'
		print("{dir}: {files.count()} files, {bytes} bytes\n")
		return 0
	end 'report'
	if rest.count() == 2 and rest[1] == cacheTrimVerb 'trim'
		var now = 0 as Count
		match fileSystemNow(dir) 'n'
			some(t) then now = t
			none then return failCacheCommand("cache: the file system's time cannot be read in {dir}")
		end 'n'
		print("{deleteAll(staleFiles(files, now: now, limit: trimLimitSeconds))} files deleted\n")
		return 0
	end 'trim'
	if rest.count() == 2 and rest[1] == cacheClearVerb 'clear'
		var paths = ast.StringList.create(0)
		for i in 0 upto files.count() 'files'
			paths.push(files[i].path.clone())
		end 'files'
		print("{deleteAll(paths)} files deleted\n")
		return 0
	end 'clear'
	printError(usage())
	return usageExitCode
end 'cacheCommand'

function failCacheCommand(message String) returns ExitCode
	printError("{message}\n")
	return diagnosticsExitCode
end 'failCacheCommand'

// The checked state of a module is kept beside its unit, under its key and the places of the modules whose handles it
// holds (checkedKey): a handle names a module by its place, so a state is read back only where every place it names is the
// same, and nothing in it is ever relocated.
let checkedExtension = ".checked"

let checkedMagic = "minimaxon build cache checked state"

let checkedFormat = 1 as Count

// checkedKey is the key of the checked state of module m of p, whose key is key: the places of the modules that come before
// the compiled ones and of m and every module it reaches, by their paths.
function checkedKey(c Compile, p ast.Project, m Count, key table.Digest) returns table.Digest
	var h = table.Hasher.new()
	h.addDigest(key)
	h.addText(checkedMagic)
	for a in 0 upto c.first 'earlier'
		h.addText(p.modules[a].path)
	end 'earlier'
	let reached = reachedFrom(p, m: m)
	for d in 0 upto reached.count() 'reached'
		if reached[d] 'named'
			h.addText(p.modules[d].path)
			h.addCount(d)
		end 'named'
	end 'reached'
	return h.digest()
end 'checkedKey'

// reachedFrom is, by module of p, whether module m reaches it: m itself, and the modules it names, directly or through others.
function reachedFrom(p ast.Project, m Count) returns Placed
	var reached = Placed.create(0)
	for _ in 0 upto p.modules.count() 'none'
		reached.push(false)
	end 'none'
	reached[m] = true
	var pending = TaskIDs.create(0)
	pending.push(m)
	while pending.count() > 0 'closure'
		let at = table.popLast(pending)
		for j in 0 upto p.resolutions[at].deps.count() 'deps'
			let d = ast.modIndex(p.resolutions[at].deps[j].module)
			if not reached[d] 'new'
				reached[d] = true
				pending.push(d)
			end 'new'
		end 'deps'
	end 'closure'
	return reached
end 'reachedFrom'

function checkedPath(dir String, key table.Digest) returns String
	return project.joinPath(dir, name: "{key.hex()}{checkedExtension}")
end 'checkedPath'

// CheckedEntry is the checked state of a module as a compile found it: its bytes and their digest, which its load holds them
// to. FoundChecked is the one found under a module's checked key, or none.
typealias FoundChecked = table.Option with CheckedEntry

type CheckedEntry
	var check as table.Digest
	var payload as String

	static function make(consumes check table.Digest, consumes payload String) returns CheckedEntry
		return CheckedEntry{check: check, payload: payload}
	end 'make'
end 'CheckedEntry'

// readChecked is the checked state that the cache holds under key, or none where it holds none, or a file there that is no
// whole entry of this layout under that key.
function readChecked(setup CacheSetup, key table.Digest) returns table.Option with CheckedEntry
	let dir = setup.dir.clone()
	let path = try FilePath.from(checkedPath(dir, key: key)) otherwise return table.Option.none
	let text = try File.readText(path) otherwise return table.Option.none
	markUsed(setup, path: checkedPath(dir, key: key), bytes: text)
	var r = table.ByteReader.of(text)
	let magic = r.text()
	let format = r.count()
	let found = r.digest()
	let check = r.digest()
	let payload = r.text()
	if r.broken or not r.atEnd() or magic != checkedMagic or format != checkedFormat or not found.equals(key) 'none'
		return table.Option.none
	end 'none'
	return table.Option.some(CheckedEntry.make(check, payload: payload))
end 'readChecked'

// writeChecked keeps the checked state payload under key, written whole and renamed over its name, as every entry is.
function writeChecked(dir String, key table.Digest, payload ByteArray)
	var check = table.Hasher.new()
	check.addBytes(payload)
	var w = table.ByteWriter.new()
	w.text(checkedMagic)
	w.count(checkedFormat)
	w.digest(key)
	w.digest(check.digest())
	w.run(payload)
	writeWhole(checkedPath(dir, key: key), bytes: w.bytes)
end 'writeChecked'

// checkedState is what the stages of the module of work after its constants made, as its lower left them: its home's parts,
// what its check ended with, and its leaves with their code; a function of its code that is no leaf is kept as the place it
// holds, since what reads the code of a module it names reads its leaves alone.
function checkedState(work ModuleWork) returns ByteArray
	var w = table.CacheWriter.new()
	work.home.storeChecked(w)
	check.storeModuleChecked(w, v: work.checked)
	opt.storeLeaves(w, v: work.leaves)
	w.word64(work.code.count() as table.Word64)
	for i in 0 upto work.code.count() 'functions'
		if work.leaves.holds(work.code[i].decl) 'leaf'
			w.flag(true)
			ir.storeIrFunction(w, v: work.code[i])
		end 'leaf' else 'other'
			w.flag(false)
			w.word64(work.code[i].decl as table.Word64)
		end 'other'
	end 'functions'
	return w.finish()
end 'checkedState'

// Restored is what the verify and the lower of a module whose checked state the cache holds give, once its bodies loaded it.
type Restored
	var checked as check.ModuleChecked
	var code as ir.IrFunctionList
	var leaves as opt.Leaves

	static function none() returns Restored
		return Restored{checked: check.ModuleChecked.none(), code: ir.IrFunctionList.create(0), leaves: opt.Leaves.empty()}
	end 'none'

	static function make(consumes checked check.ModuleChecked, consumes code ir.IrFunctionList, consumes leaves opt.Leaves) returns Restored
		return Restored{checked: checked, code: code, leaves: leaves}
	end 'make'
end 'Restored'

// restoreChecked makes the checked state that the entry the order found holds the module's: its home's parts at once, and
// what its verify and its lower give in work.restored. An entry whose bytes are not those it was written with is damage of
// the cache that no compile can go on from, as the stages that would make the state did not run.
function restoreChecked(mutates work ModuleWork, dir String)
	var found = exchange(work.checkedFound, value: FoundChecked.none)
	var entry = match consumes found 'f'
		some(e) gives e
		none panic("driver: the checked state of a module that the cache holds none of")
	end 'f'
	var digest = table.Hasher.new()
	digest.addText(entry.payload)
	let path = checkedPath(dir, key: work.checkedKey)
	if not digest.digest().equals(entry.check) 'damaged'
		panic("driver: the build cache's entry {path} is damaged; delete it")
	end 'damaged'
	var r = table.CacheReader.of(exchange(entry.payload, value: ""))
	work.home.loadChecked(r)
	let checked = check.ModuleChecked.cacheLoad(r)
	let leaves = opt.Leaves.cacheLoad(r)
	let n = r.items()
	var code = ir.IrFunctionList.create(0)
	for _ in 0 upto n 'functions'
		if r.flag() 'leaf'
			code.push(ir.IrFunction.cacheLoad(r))
		end 'leaf' else 'other'
			let decl = try (r.word64() as ast.FuncID) otherwise panic("driver: the build cache's entry {path} holds no function")
			code.push(ir.IrFunction.new(decl, name: "", paramCount: 0 as Count))
		end 'other'
	end 'functions'
	if r.broken or not r.atEnd() 'cut'
		panic("driver: the build cache's entry {path} is damaged; delete it")
	end 'cut'
	work.restored = Restored.make(checked, code: code, leaves: leaves)
end 'restoreChecked'

// keepChecked keeps the checked state that the lower of a settled module made (keepsChecked), under the checked key the order
// gave it, once the module's emit linked its unit, or made one without an error where the compile verifies the cache, which
// then holds the state to the entry found under that key: a difference is a fault of the key, which leaves out something the
// state is made from.
function keepChecked(c Compile, mutates work ModuleWork)
	if work.checkedState.count() == 0 'none'
		return
	end 'none'
	if c.cache.verifies 'verify'
		match readChecked(c.cache, key: work.checkedKey) 'found'
			some(entry) then holdToChecked(entry, state: work.checkedState, path: work.home.path())
			none then writeChecked(c.cache.dir, key: work.checkedKey, payload: work.checkedState)
		end 'found'
	end 'verify' else 'write'
		writeChecked(c.cache.dir, key: work.checkedKey, payload: work.checkedState)
	end 'write'
	work.checkedState = ByteArray.create(0)
end 'keepChecked'

function holdToChecked(entry CheckedEntry, state ByteArray, path String)
	if String.from(state.clone()) != entry.payload 'differs'
		panic("driver: module {path} makes another checked state than the build cache's entry under its key, so its key leaves out something its state is made from")
	end 'differs'
end 'holdToChecked'
