// compilePath compiles the project at path: with an output, to the executable there, and without one only as far as the
// diagnostics.
function compilePath(path String, output String, options Options) returns ExitCode
	var errs = diag.ErrorList.create(0)
	compileProject(path, output: output, options: options, errs: errs)
	return report(errs)
end 'compilePath'

// goalOf is the goal of a compile with an output, an executable, and of one without, the diagnostics of a check, for which
// it finds the instances and holds the runtime.
function goalOf(output String) returns Goal
	if output != "" 'makes'
		return Goal.executable
	end 'makes'
	return Goal.instances
end 'goalOf'

// buildPath is compilePath for the compiler's build and check commands, whose compile runs as behaviours (startCompile), on
// every core: the last of them prints the diagnostics and sets the code the process exits with, which replaces the one that
// buildPath gives, unless the compile ended before its tasks began.
function buildPath(path String, output String, options Options) returns ExitCode
	let trace = Trace.start(options.trace)
	var errs = diag.ErrorList.create(0)
	var p = projectFor(options)
	let ready = runtimeFor(p, path: path, output: output, options: options, errs: errs)
	if errs.count() > 0 'broken'
		return report(errs)
	end 'broken'
	let first = p.modules.count()
	match consumes project.discoverProjectInto(p, rootPath: path, errs: errs) 'found'
		some(memory) then return startDiscovered(p, memory: memory, first: first, output: output, options: options, ready: ready, errs: errs, trace: trace)
		none then return report(errs)
	end 'found'
end 'buildPath'

// startDiscovered starts the compile of the modules of p that buildPath discovered, from first on, as behaviours; a compile of
// tests first reads the files of tests of the modules it tests, and makes no program, whose main it does not look for.
function startDiscovered(consumes p ast.Project, consumes memory project.SourceFiles, first Count, output String, options Options, consumes ready frozen with backend.UnitList, consumes errs diag.ErrorList, consumes trace Trace) returns ExitCode
	var held = p
	if options.runsTests and project.addTestFiles(held, first: first, under: options.testsUnder) == 0 'noTests'
		printError("test: no module under {options.testsUnder} has a file of tests (.maxtest)\n")
		return diagnosticsExitCode
	end 'noTests'
	if options.checksTests 'checkTests'
		project.addEveryTestFile(held, first: first)
	end 'checkTests'
	var traced = trace
	traced.prepare()
	startCompile(held, memory: memory, first: first, goal: goalOf(output), makesProgram: output != "" and not options.runsTests, output: output, options: options, ready: ready, errs: errs, trace: traced)
	return compiledByBehaviours
end 'startDiscovered'

// compiledByBehaviours is the code a process whose compile runs as behaviours gives when main returns, which the last of them
// replaces.
let compiledByBehaviours = 0 as ExitCode

// compileProject is compilePath's compile, which leaves the diagnostics in errs for the caller to report.
function compileProject(path String, output String, options Options, mutates errs diag.ErrorList)
	var p = projectFor(options)
	let ready = runtimeFor(p, path: path, output: output, options: options, errs: errs)
	if errs.count() > 0 'broken'
		return
	end 'broken'
	let first = p.modules.count()
	match consumes project.discoverProjectInto(p, rootPath: path, errs: errs) 'found'
		some(memory) then _ = compileDiscovered(p, memory: memory, first: first, ready: ready, output: output, options: options, errs: errs)
		none then return
	end 'found'
end 'compileProject'

// runtimeFor puts the runtime in p and gives its code, checked and compiled, for a compile of the project at path that makes an
// executable at output; a compile that makes none, or that is of the runtime's own directory, has nothing to link with.
function runtimeFor(mutates p ast.Project, path String, output String, options Options, mutates errs diag.ErrorList) returns frozen with backend.UnitList
	if output != "" and not project.isRuntimeDirectory(path) 'runtime'
		return freeze(prepareRuntime(p, options: options, errs: errs))
	end 'runtime'
	return noReadyUnits()
end 'runtimeFor'

// noReadyUnits is what a compile that links with nothing made before is given to link with.
function noReadyUnits() returns frozen with backend.UnitList
	return freeze(backend.UnitList.create(0))
end 'noReadyUnits'

// SharedRuntime is the runtime of a run of many compiles: its project alone, checked, and its code, made once and frozen, so
// that compiles at once read them and none waits for another. Each compile adds its program to a copy of the project and
// links it with the code. The runtime module is in the project by its place and its flags only: its source and its check
// are what no program reads, and are the most of the project.
type SharedRuntime
	var p as frozen with ast.Project
	var ready as frozen with backend.UnitList
	// cacheDir and compiler are the build cache that the programs compiled on the runtime use, or none, and the digest of
	// the compiler that its keys hold, which the run reads once.
	var cacheDir as String
	var compiler as table.Digest

	static function prepare(options Options, mutates errs diag.ErrorList) returns SharedRuntime
		var p = projectFor(options)
		let ready = prepareRuntime(p, options: options, errs: errs)
		_ = ast.takeBody(p, module: runtimeModule)
		return SharedRuntime{p: freeze(p), ready: freeze(ready), cacheDir: options.cacheDir.clone(), compiler: options.compiler.clone()}
	end 'prepare'

	// none is the runtime of a run that compiles no executable: nothing is loaded or checked.
	static function none() returns SharedRuntime
		return SharedRuntime{p: freeze(ast.Project.new("")), ready: noReadyUnits(), cacheDir: "", compiler: table.Digest.none()}
	end 'none'

	// projectForProgram is a copy of the project for one program to be added to.
	function projectForProgram() returns ast.Project
		return copyOfProject(p)
	end 'projectForProgram'
end 'SharedRuntime'

// SharedLibrary is the standard library of a run of many checks of programs that no executable is made of: its project alone,
// checked once and frozen. Each check adds its program to a copy of the project, after the library's modules, which it reads
// as checked rather than parsing and checking them again. A compiler with no library beside it shares an empty project.
type SharedLibrary
	var p as frozen with ast.Project

	// prepare is the library checked for the options' target, or nothing when it has an error, which a check that shares it
	// would not report.
	static function prepare(options Options) returns table.Option with SharedLibrary
		var p = projectFor(options)
		var errs = diag.ErrorList.create(0)
		match consumes project.libraryDirectory() 'found'
			some(dir) then _ = compileLibrary(p, dir: dir, options: options, errs: errs)
			none then _ = 0
		end 'found'
		if errs.count() > 0 'broken'
			return table.Option.none
		end 'broken'
		return table.Option.some(SharedLibrary{p: freeze(p)})
	end 'prepare'

	// projectForProgram is a copy of the project for one program to be added to.
	function projectForProgram() returns ast.Project
		return copyOfProject(p)
	end 'projectForProgram'
end 'SharedLibrary'

// compileLibrary checks the library's source at dir as the project p, which is empty, as far as a check without an output
// goes.
function compileLibrary(mutates p ast.Project, dir String, options Options, mutates errs diag.ErrorList) returns Generated
	match consumes project.discoverProjectInto(p, rootPath: dir, errs: errs) 'found'
		some(memory) then return compileDiscovered(p, memory: memory, first: 0, ready: noReadyUnits(), output: "", options: options, errs: errs)
		none then return Generated.nothing()
	end 'found'
end 'compileLibrary'

// projectFor is a new project of the options' target, which no module is in yet. A build that counts its allocations checks
// the ASCII bit of each owned String it drops or copies too, and one that writes debug info keeps the spans of its code.
function projectFor(options Options) returns ast.Project
	var p = ast.Project.new("")
	p.target = options.target.clone()
	p.checksStrings = options.countAllocations
	p.keepsSpans = options.debugInfo
	return p
end 'projectFor'

// copyOfProject is a copy of p, which a frozen project's contents are copied by.
function copyOfProject(p ast.Project) returns ast.Project
	return p.clone()
end 'copyOfProject'

// runtimeModule is the module of the runtime in a project that prepareRuntime made: the first.
let runtimeModule = 0 as diag.ModuleID

// Generated is what the generate stage lowered, which a compile that makes an executable links and which the interpreter runs
// as it is: the modules' functions, in the order the check visited the modules, and main; and whether the executable that
// the compile linked runs the scheduler.
type Generated
	var entry as ast.FuncID
	var modules as backend.FunctionLists
	var scheduled as bool

	static function make(entry ast.FuncID, consumes modules backend.FunctionLists, scheduled bool) returns Generated
		return Generated{entry: entry, modules: modules, scheduled: scheduled}
	end 'make'

	static function nothing() returns Generated
		return Generated{entry: ast.noFunc, modules: backend.FunctionLists.create(0), scheduled: false}
	end 'nothing'
end 'Generated'

// CompiledProgram is a program compiled on the shared runtime: its project, which the interpreter needs to name what it runs,
// and what was lowered.
type CompiledProgram
	var p as ast.Project
	var generated as Generated

	static function make(consumes p ast.Project, consumes generated Generated) returns CompiledProgram
		return CompiledProgram{p: p, generated: generated}
	end 'make'
end 'CompiledProgram'

// compileProjectWith is compileProject for a compile that makes an executable of the project at path, on the runtime that
// the run shares, and keeps what it lowered.
function compileProjectWith(shared SharedRuntime, path String, output String, options Options, mutates errs diag.ErrorList) returns CompiledProgram
	var p = shared.projectForProgram()
	p.keepsSpans = options.debugInfo
	let first = p.modules.count()
	var generated = Generated.nothing()
	match consumes project.discoverProjectInto(p, rootPath: path, errs: errs) 'found'
		some(memory) then generated = compileDiscovered(p, memory: memory, first: first, ready: shared.ready, output: output, options: options, errs: errs)
		none then generated = Generated.nothing()
	end 'found'
	return CompiledProgram.make(p, generated: generated)
end 'compileProjectWith'

// compileFilesWith is compileProjectWith for a project whose files are held in memory, as the directory at path holds them.
function compileFilesWith(shared SharedRuntime, path String, files project.SourceFiles, output String, options Options, mutates errs diag.ErrorList)
	var p = shared.projectForProgram()
	p.keepsSpans = options.debugInfo
	let first = p.modules.count()
	project.discoverFilesInto(p, rootPath: path, files: files, errs: errs)
	_ = compileDiscovered(p, memory: files, first: first, ready: shared.ready, output: output, options: options, errs: errs)
end 'compileFilesWith'

// compileSourceWith is compileProjectWith for a program that is the one file text, named path in the diagnostics.
function compileSourceWith(shared SharedRuntime, path String, text String, output String, options Options, mutates errs diag.ErrorList)
	var p = shared.projectForProgram()
	p.keepsSpans = options.debugInfo
	let first = p.modules.count()
	let memory = project.discoverSourceInto(p, path: path, text: text, errs: errs)
	_ = compileDiscovered(p, memory: memory, first: first, ready: shared.ready, output: output, options: options, errs: errs)
end 'compileSourceWith'

// compileRuntimeTest compiles a test of the runtime: the file is compiled as one more file of the runtime's module,
// whose main it holds, so that it may call the runtime's functions and the __Raw intrinsics, as a program may not.
function compileRuntimeTest(file String, output String, options Options, mutates errs diag.ErrorList) returns CompiledProgram
	var p = projectFor(options)
	project.discoverRuntime(p)
	p.modules[ast.modIndex(p.rootModule)].filePaths.push(file.clone())
	let generated = compileDiscovered(p, memory: project.SourceFiles.create(0), first: 0, ready: noReadyUnits(), output: output, options: options, errs: errs)
	return CompiledProgram.make(p, generated: generated)
end 'compileRuntimeTest'

// prepareRuntime makes p the project of the runtime alone, checked, and gives the runtime's code, so that a program is
// compiled by adding it to a copy of p and linking it with that code, which is the same for every program: the runtime's own
// source is then loaded, checked and lowered once however many programs are compiled.
function prepareRuntime(mutates p ast.Project, options Options, mutates errs diag.ErrorList) returns backend.UnitList
	if options.cacheDir != "" and not options.emitIr and not options.verifyIr and not options.debugInfo and not options.verifiesCache 'skim'
		var trial = copyOfProject(p)
		var trialErrs = diag.ErrorList.create(0)
		var skimming = options.clone()
		skimming.skimsBodies = true
		var units = runtimeUnits(trial, options: skimming, errs: trialErrs)
		if trialErrs.count() == 0 'kept'
			p = exchange(trial, value: ast.Project.new(""))
			return exchange(units, value: backend.UnitList.create(0))
		end 'kept'
	end 'skim'
	return runtimeUnits(p, options: options, errs: errs)
end 'prepareRuntime'

// runtimeUnits is prepareRuntime's compile of the runtime, its bodies skimmed where options say so.
function runtimeUnits(mutates p ast.Project, options Options, mutates errs diag.ErrorList) returns backend.UnitList
	let first = p.modules.count()
	project.discoverRuntime(p)
	var runtimeOptions = Options.new()
	runtimeOptions.timings = options.timings
	runtimeOptions.cacheDir = options.cacheDir.clone()
	runtimeOptions.compiler = options.compiler.clone()
	runtimeOptions.verifiesCache = options.verifiesCache
	runtimeOptions.target = options.target.clone()
	runtimeOptions.countAllocations = options.countAllocations
	runtimeOptions.debugInfo = options.debugInfo
	runtimeOptions.skimsBodies = options.skimsBodies
	var run = runStages(p, from: Stage.parse, memory: project.SourceFiles.create(0), first: first, goal: Goal.units, makesProgram: false, output: "", options: runtimeOptions, ready: noReadyUnits(), errs: errs)
	if errs.count() > 0 'failed'
		ast.locateAllErrors(p.modules, errs: errs)
	end 'failed'
	return exchange(run.made, value: backend.UnitList.create(0))
end 'runtimeUnits'

// compileDiscovered compiles the modules of p from the one at index first on, which a project discovered after the modules
// that p started with, from their parse, and gives back what the generate stage lowered. memory holds the files that the
// parse reads from memory rather than disk; ready are the units the program is linked with.
function compileDiscovered(mutates p ast.Project, memory project.SourceFiles, first Count, ready frozen with backend.UnitList, output String, options Options, mutates errs diag.ErrorList) returns Generated
	return compileFrom(p, from: Stage.parse, memory: memory, first: first, ready: ready, output: output, options: options, errs: errs)
end 'compileDiscovered'

// stageInLibrary puts the program's modules from first on in the library tier.
function stageInLibrary(mutates p ast.Project, first Count)
	for m in first upto p.modules.count() 'modules'
		p.modules[m].stagedInLibrary = not p.modules[m].isLibrary
	end 'modules'
end 'stageInLibrary'

// compileLoaded is compileDiscovered for modules that are parsed already.
function compileLoaded(mutates p ast.Project, first Count, ready frozen with backend.UnitList, output String, options Options, mutates errs diag.ErrorList)
	_ = compileFrom(p, from: Stage.resolve, memory: project.SourceFiles.create(0), first: first, ready: ready, output: output, options: options, errs: errs)
end 'compileLoaded'

// compileFrom is the compile of compileDiscovered and compileLoaded: with an output, to the executable there, and without one
// as far as the diagnostics, which it locates. With options.stagesInLibrary the program's modules are in the library tier.
function compileFrom(mutates p ast.Project, from Stage, memory project.SourceFiles, first Count, ready frozen with backend.UnitList, output String, options Options, mutates errs diag.ErrorList) returns Generated
	if options.stagesInLibrary 'staged'
		stageInLibrary(p, first: first)
	end 'staged'
	var run = runStages(p, from: from, memory: memory, first: first, goal: goalOf(output), makesProgram: output != "", output: output, options: options, ready: ready, errs: errs)
	let generated = run.generated()
	ast.locateAllErrors(p.modules, errs: errs)
	return generated
end 'compileFrom'

// frontEnd checks the modules of p, which are parsed: the errors are those of the first stage that has any. makesProgram says
// that the compile makes an executable, whose root needs a main even when it is the runtime's own project.
export function frontEnd(mutates p ast.Project, makesProgram bool, mutates errs diag.ErrorList) returns check.Checked
	return checkLoaded(p, goal: Goal.checked, makesProgram: makesProgram, errs: errs)
end 'frontEnd'

// declareFront is frontEnd as far as the constants.
export function declareFront(mutates p ast.Project, mutates errs diag.ErrorList) returns check.Checked
	return checkLoaded(p, goal: Goal.declared, makesProgram: false, errs: errs)
end 'declareFront'

function checkLoaded(mutates p ast.Project, goal Goal, makesProgram bool, mutates errs diag.ErrorList) returns check.Checked
	var run = runStages(p, from: Stage.resolve, memory: project.SourceFiles.create(0), first: 0, goal: goal, makesProgram: makesProgram, output: "", options: Options.new(), ready: noReadyUnits(), errs: errs)
	return exchange(run.checked, value: check.Checked.none())
end 'checkLoaded'

// lowerLoaded checks the modules of p, which are parsed, and lowers their functions, which is nothing when an error stopped
// the check.
function lowerLoaded(mutates p ast.Project, mutates errs diag.ErrorList) returns Generated
	var run = runStages(p, from: Stage.resolve, memory: project.SourceFiles.create(0), first: 0, goal: Goal.lowered, makesProgram: true, output: "", options: Options.new(), ready: noReadyUnits(), errs: errs)
	return run.generated()
end 'lowerLoaded'

function appendErrors(mutates errs diag.ErrorList, found diag.ErrorList)
	for i in 0 upto found.count() 'each'
		errs.push(found[i].clone())
	end 'each'
end 'appendErrors'

// verifyIr stops the compile at the first function whose IR breaks a rule of the verifier, which is a fault of the compiler.
function verifyIr(p ast.Project, lowered opt.LoweredLists)
	let ms = ast.ModuleState.ofProject()
	for m in 0 upto lowered.count() 'modules'
		verifyFunctions(p, ms: ms, fns: lowered[m])
	end 'modules'
end 'verifyIr'

// verifyFunctions is verifyIr for the functions of one module, which a task that holds ms reads in p.
function verifyFunctions(p ast.Project, ms ast.ModuleState, fns ir.IrFunctionList)
	for i in 0 upto fns.count() 'functions'
		let problems = ir.verifyIr(p, tt: ms.types, reads: p.types, ft: ms.funcs, funcReads: p.funcs, f: fns[i])
		if problems.count() > 0 'broken'
			var text = ByteArray.create(0)
			for k in 0 upto problems.count() 'each'
				text.append("\n  {problems[k]}".toByteArray())
			end 'each'
			panic("driver: the IR breaks the verifier's rules:{String.from(text)}")
		end 'broken'
	end 'functions'
end 'verifyFunctions'

// writeIr writes the IR of every module's functions, in module order, as --emit-ir asks.
function writeIr(p ast.Project, lowered opt.LoweredLists, path String)
	var text = ByteArray.create(0)
	for m in 0 upto lowered.count() 'modules'
		text.append(ir.moduleIrText(p, tt: ast.TypeSlot.none(), reads: p.types, ft: ast.FuncSlot.none(), funcReads: p.funcs, functions: lowered[m]).toByteArray())
	end 'modules'
	let file = try FilePath.from(path) otherwise panic("driver: {path} is not a path")
	try File.writeText(file, content: String.from(text)) otherwise panic("driver: cannot write {path}")
end 'writeIr'

// refusals are the places in the modules' functions where a program needs something the backend cannot run yet, such as
// a map, a list or a pool, which only the interpreter runs. One is reported for each function, at its first, and an
// instance that several modules lowered is reported once.
function refusals(p ast.Project, lowered opt.LoweredLists, mutates errs diag.ErrorList)
	var seen = ir.RefusalList.create(0)
	for m in 0 upto lowered.count() 'modules'
		for f in 0 upto lowered[m].count() 'functions'
			if lowered[m][f].refusals.count() > 0 'refused'
				let r = lowered[m][f].refusals[0].clone()
				if not containsRefusal(seen, r: r) 'new'
					diag.pushSiteError(errs, code: r.code.clone(), message: r.message.clone(), module: r.module, offset: r.offset)
					seen.push(r)
				end 'new'
			end 'refused'
		end 'functions'
	end 'modules'
end 'refusals'

function containsRefusal(seen ir.RefusalList, r ir.Refusal) returns bool
	for i in 0 upto seen.count() 'each'
		if seen[i].module == r.module and seen[i].offset == r.offset and seen[i].code == r.code and seen[i].message == r.message 'same'
			return true
		end 'same'
	end 'each'
	return false
end 'containsRefusal'
