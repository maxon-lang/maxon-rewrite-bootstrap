// The qualify command writes, in each project, the module path before every name that is written without one and that names
// a declaration of another module, which a program must qualify. A name is taken to mean what Maxon's bare lookup finds: the
// root module's declaration, else the one exported declaration of that name in the project. It reports the names it cannot
// place and leaves them alone, and leaves a project that does not parse alone.

// Qualification is a bare name of another module's declaration in a file, and the module path to write before it.
type Qualification
	var offset as Count
	var qualifier as String

	static function make(offset Count, consumes qualifier String) returns Qualification
		return Qualification{offset: offset, qualifier: qualifier}
	end 'make'
end 'Qualification'

typealias Qualifications = Array with Qualification

typealias QualificationLists = Array with Qualifications

// ProjectQualifications are the qualifications of a project's files, by file, and how many names it could not place.
type ProjectQualifications
	var files as ast.StringList
	var found as QualificationLists
	var index as table.StringMap with Count
	var missed as Count

	static function new() returns ProjectQualifications
		return ProjectQualifications{files: ast.StringList.create(0), found: QualificationLists.create(0), index: table.StringMap.new(), missed: 0 as Count}
	end 'new'

	function add(mutates self, file String, offset Count, qualifier String)
		var at = files.count()
		if index.has(file) 'known'
			at = match consumes index.get(file) 'slot'
				some(slot) gives slot
				none panic("qualify: a file that is known and has no slot")
			end 'slot'
		end 'known' else 'fresh'
			files.push(file.clone())
			found.push(Qualifications.create(0))
			index.insert(file.clone(), value: at)
		end 'fresh'
		found[at].push(Qualification.make(offset, qualifier: qualifier.clone()))
	end 'add'
end 'ProjectQualifications'

// projectQualifications finds the qualifications of the project's files, by file. It leaves the errors that kept it from
// finding them in errs.
function projectQualifications(dir String, mutates errs diag.ErrorList) returns ProjectQualifications
	var result = ProjectQualifications.new()
	var p = ast.Project.new("")
	if not project.loadProjectInto(p, rootPath: dir, errs: errs) 'loaded'
		ast.locateAllErrors(p.modules, errs: errs)
		return result
	end 'loaded'
	if errs.count() > 0 'broken'
		ast.locateAllErrors(p.modules, errs: errs)
		return result
	end 'broken'
	var ignored = diag.ErrorList.create(0)
	resolve.resolveFrom(p, first: 0, errs: ignored)
	let ofLibrary = p.modules[ast.modIndex(p.rootModule)].isLibrary
	for m in 0 upto p.modules.count() 'modules'
		if p.modules[m].isLibrary and not ofLibrary 'library'
			continue 'modules'
		end 'library'
		for i in 0 upto p.resolutions[m].unbound.count() 'names'
			let name = p.resolutions[m].unbound[i].name.clone()
			let offset = p.resolutions[m].unbound[i].offset
			let owner = ast.owningModule(p.modules, m: p.modules[m].id, name: name)
			if not owner.declared 'ours'
				continue 'names'
			end 'ours'
			if owner.qualifier == "" 'ambiguous'
				let place = ast.locateModuleOffset(p.modules[m], offset: offset)
				print("unplaced {place.file}:{place.line}:{place.col}: '{name}' is declared by more than one module\n")
				result.missed = increment(result.missed)
				continue 'names'
			end 'ambiguous'
			let file = ast.findFileIndex(p.modules[m].files, offset: offset)
			let start = p.modules[m].files[file].start as Count
			result.add(p.modules[m].files[file].path, offset: try (offset as Count) - start otherwise panic("qualify: a name before its file"), qualifier: owner.qualifier)
		end 'names'
	end 'modules'
	return result
end 'projectQualifications'

// orderedByOffset is the qualifications in the order of their offsets, which keeps the order of those at one offset.
function orderedByOffset(items Qualifications) returns Qualifications
	var sorted = Qualifications.create(0)
	for i in 0 upto items.count() 'each'
		sorted.push(items[i].clone())
		var j = i
		while j > 0 'shift'
			let prev = j - 1
			if sorted[j].offset < sorted[prev].offset 'swap'
				let current = sorted[j].clone()
				sorted[j] = sorted[prev].clone()
				sorted[prev] = current
				j = prev
			end 'swap' else 'done'
				break 'shift'
			end 'done'
		end 'shift'
	end 'each'
	return sorted
end 'orderedByOffset'

// applyQualifications writes each qualifier and a dot before the name at its offset, once for each offset.
function applyQualifications(file String, items Qualifications) returns bool
	let path = try FilePath.from(file) otherwise return false
	let text = try File.readText(path) otherwise return false
	let sorted = orderedByOffset(items)
	var out = ByteArray.create(0)
	var at = 0 as Count
	for i in 0 upto sorted.count() 'each'
		if i > 0 and sorted[i - 1].offset == sorted[i].offset 'same'
			continue 'each'
		end 'same'
		out.append(text.sliceBytes(at, endPos: sorted[i].offset).toByteArray())
		out.append("{sorted[i].qualifier}.".toByteArray())
		at = sorted[i].offset
	end 'each'
	out.append(text.sliceBytes(at, endPos: text.byteLength()).toByteArray())
	try File.writeText(path, content: String.from(out)) otherwise return false
	return true
end 'applyQualifications'

// qualifyCommand is the qualify command: rest holds its name and the projects.
function qualifyCommand(rest CommandNames) returns ExitCode
	if rest.count() < 2 'usage'
		printError(usage())
		return usageExitCode
	end 'usage'
	var qualified = 0 as Count
	var files = 0 as Count
	var unplaced = 0 as Count
	for d in 1 upto rest.count() 'projects'
		var errs = diag.ErrorList.create(0)
		let found = projectQualifications(rest[d], errs: errs)
		if errs.count() > 0 'skipped'
			print("skipped  {rest[d]}: {errs[0].format()}\n")
			continue 'projects'
		end 'skipped'
		unplaced = try unplaced + found.missed otherwise panic("qualify: more names than memory")
		var names = found.files.clone()
		project.sortStrings(names)
		for f in 0 upto names.count() 'files'
			let at = match consumes found.index.get(names[f]) 'slot'
				some(slot) gives slot
				none panic("qualify: a file without qualifications")
			end 'slot'
			if not applyQualifications(names[f], items: found.found[at]) 'failed'
				printError("cannot write {names[f]}\n")
				return diagnosticsExitCode
			end 'failed'
			qualified = try qualified + found.found[at].count() otherwise panic("qualify: more names than memory")
			files = increment(files)
		end 'files'
	end 'projects'
	print("qualified {qualified} names in {files} files; {unplaced} names could not be placed\n")
	return 0
end 'qualifyCommand'
