// The fix command applies the change that each diagnostic's message names, which the check records with the diagnostic,
// and checks again, until the program is clean or what is left names no change. It works on a .maxon file, a project's
// directory, or the tests of spec files, and for a spec test only on its maxon block.

// trapSkipLine is what a spec test gets in place of the fix of its arithmetic when what it expects is the run-time trap
// that maxon raises there: the fix turns the trap into the panic of a try, and the test would test nothing of its own.
let trapSkipLine = "<!-- skip: language difference: arithmetic that can fail needs a proof or a try, so maxon's run-time trap is a compile error here -->\n"

let panicWord = "panic"

// positionsMovedLine tells the runner to compare the diagnostics of a fixed test without their positions, which the fixes moved.
let positionsMovedLine = "<!-- positions: moved -->\n"

// CodeSkipKind is what a row of the skip table matches a test by.
enum CodeSkipKind
	// pair is the first code that maxon expects and the first code that minimaxon reports for the same program.
	pair
	// expectedOnly is the first code that maxon expects, whatever minimaxon reports.
	expectedOnly
	// refusedRun is the first code left that minimaxon refuses a program with that maxon runs.
	refusedRun
	// reportedFirst is the first code left, after the fixes, of a program whose fixes do not make the code maxon expects the first.
	reportedFirst
	// namedTest is one test, by its spec file and its name, whose program runs to another answer by a language change.
	namedTest
	// byCause is the cause of the first diagnostic left after the fixes, where its code covers several.
	byCause
end 'CodeSkipKind'

// CodeSkip is a row of the skip table: the codes of a test that minimaxon refuses or reports for a known reason, as its kind
// matches them, or the spec file and the name of a test it names (what the kind does not match by is empty), and the skip
// line the test gets. codeSkipTable (skips_gen.maxon, from skips.tsv) lists them.
type CodeSkip
	var kind as CodeSkipKind
	var expected as String
	var reported as String
	var file as String
	var test as String
	var cause as diag.ErrorCause
	var line as String

	static function make(consumes expected String, consumes reported String, consumes line String) returns CodeSkip
		return CodeSkip{kind: CodeSkipKind.pair, expected: expected, reported: reported, file: "", test: "", cause: diag.ErrorCause.none, line: line}
	end 'make'

	static function expecting(consumes expected String, consumes line String) returns CodeSkip
		return CodeSkip{kind: CodeSkipKind.expectedOnly, expected: expected, reported: "", file: "", test: "", cause: diag.ErrorCause.none, line: line}
	end 'expecting'

	static function refusing(consumes reported String, consumes line String) returns CodeSkip
		return CodeSkip{kind: CodeSkipKind.refusedRun, expected: "", reported: reported, file: "", test: "", cause: diag.ErrorCause.none, line: line}
	end 'refusing'

	static function reportingFirst(consumes reported String, consumes line String) returns CodeSkip
		return CodeSkip{kind: CodeSkipKind.reportedFirst, expected: "", reported: reported, file: "", test: "", cause: diag.ErrorCause.none, line: line}
	end 'reportingFirst'

	static function naming(consumes file String, consumes test String, consumes line String) returns CodeSkip
		return CodeSkip{kind: CodeSkipKind.namedTest, expected: "", reported: "", file: file, test: test, cause: diag.ErrorCause.none, line: line}
	end 'naming'

	static function causing(cause diag.ErrorCause, consumes line String) returns CodeSkip
		return CodeSkip{kind: CodeSkipKind.byCause, expected: "", reported: "", file: "", test: "", cause: cause, line: line}
	end 'causing'
end 'CodeSkip'

typealias CodeSkips = Array with CodeSkip

// codeSkipLine is the skip line of the pair that a test's first expected and first reported codes make, or nothing when the
// pair is not in the table.
function codeSkipLine(skips CodeSkips, expected String, reported String) returns table.Option with String
	for i in 0 upto skips.count() 'pairs'
		if skips[i].kind == CodeSkipKind.pair and skips[i].expected == expected and skips[i].reported == reported 'found'
			return table.Option.some(skips[i].line.clone())
		end 'found'
	end 'pairs'
	return table.Option.none
end 'codeSkipLine'

// expectedSkipLine is the skip line of a test whose first expected code the table skips whatever minimaxon reports, or
// nothing.
function expectedSkipLine(skips CodeSkips, expected String) returns table.Option with String
	for i in 0 upto skips.count() 'rows'
		if skips[i].kind == CodeSkipKind.expectedOnly and skips[i].expected == expected 'found'
			return table.Option.some(skips[i].line.clone())
		end 'found'
	end 'rows'
	return table.Option.none
end 'expectedSkipLine'

// refusedRunSkipLine is the skip line of a test that runs a program which minimaxon refuses with the code left, when the
// table skips it, or nothing.
function refusedRunSkipLine(skips CodeSkips, left String) returns table.Option with String
	for i in 0 upto skips.count() 'rows'
		if skips[i].kind == CodeSkipKind.refusedRun and skips[i].reported == left 'found'
			return table.Option.some(skips[i].line.clone())
		end 'found'
	end 'rows'
	return table.Option.none
end 'refusedRunSkipLine'

// unreachedSkipLine is the skip line of a test that expects the compile error expected and whose fixes do not make it the
// first: the pair it makes with left, the first code after the fixes, or else the row of left; nothing when the table has
// neither. A program that checks clean after the fixes has no left, so a code it expects that minimaxon never reports is
// never skipped as a difference of a rule.
function unreachedSkipLine(skips CodeSkips, expected table.Option with String, left String) returns table.Option with String
	if left == "" 'clean'
		return table.Option.none
	end 'clean'
	let pair = pairAfterFixes(skips, expected: expected, left: left)
	if pair.isSome() 'paired'
		return pair
	end 'paired'
	for i in 0 upto skips.count() 'rows'
		if skips[i].kind == CodeSkipKind.reportedFirst and skips[i].reported == left 'found'
			return table.Option.some(skips[i].line.clone())
		end 'found'
	end 'rows'
	return table.Option.none
end 'unreachedSkipLine'

// haltCodes is the codes that make a pair of the table with the code expected: a test whose fixes leave one of them first is
// skipped for it, so fixing stops there instead of changing the program to reach another diagnostic.
function haltCodes(skips CodeSkips, expected table.Option with String) returns ast.StringList
	var codes = ast.StringList.create(0)
	if not expected.isSome() 'none'
		return codes
	end 'none'
	let code = expected.clone().unwrap()
	for i in 0 upto skips.count() 'rows'
		if skips[i].kind == CodeSkipKind.pair and skips[i].expected == code 'paired'
			codes.push(skips[i].reported.clone())
		end 'paired'
	end 'rows'
	return codes
end 'haltCodes'

// pairAfterFixes is the skip line of the pair that the code a test expects makes with left, the first code after its fixes.
function pairAfterFixes(skips CodeSkips, expected table.Option with String, left String) returns table.Option with String
	return match expected 'expects'
		some(code) gives codeSkipLine(skips, expected: code, reported: left)
		none gives table.Option.none
	end 'expects'
end 'pairAfterFixes'

// namedSkipLine is the skip line of the test of the spec file named file that the table names, or nothing.
function namedSkipLine(skips CodeSkips, file String, test String) returns table.Option with String
	for i in 0 upto skips.count() 'rows'
		if skips[i].kind == CodeSkipKind.namedTest and skips[i].file == file and skips[i].test == test 'found'
			return table.Option.some(skips[i].line.clone())
		end 'found'
	end 'rows'
	return table.Option.none
end 'namedSkipLine'

// causeSkipLine is the skip line of a test whose first diagnostic left after the fixes has a cause that the table skips, or
// nothing.
function causeSkipLine(skips CodeSkips, cause diag.ErrorCause) returns table.Option with String
	if cause == diag.ErrorCause.none 'none'
		return table.Option.none
	end 'none'
	for i in 0 upto skips.count() 'rows'
		if skips[i].kind == CodeSkipKind.byCause and skips[i].cause == cause 'found'
			return table.Option.some(skips[i].line.clone())
		end 'found'
	end 'rows'
	return table.Option.none
end 'causeSkipLine'

typealias Flags = Array with bool

// Kept is what fix leaves alone in a test that expects a compile error and that minimaxon refuses with the code it expects:
// the errors the test expects, as diagnosticPlaces writes them, and every diagnostic but a missing try. The check reports
// every missing try of a function, so where maxon's test has one that it is about and a later operation that maxon checks
// at run time, both are reported, and only the second gets its try. A diagnostic is an expected one when it names the
// expected place, or only its line where the test's positions are moved, whose columns are not minimaxon's; an expectation
// that names no place keeps every error of its code.
type Kept
	var places as ast.StringList
	var moved as bool
	var sections as SourceSections

	static function none() returns Kept
		return Kept{places: ast.StringList.create(0), moved: false, sections: SourceSections.create(0)}
	end 'none'

	// of is what a test whose maxoncstderr block is expected keeps, display naming its spec file.
	static function of(test SpecTest, expected String, display String, sections SourceSections) returns Kept
		let wanted = trimSpace(replaceText(expected, needle: "specs/{fileStem(display)}/{test.name}.maxon", replacement: fragmentToken)).clone()
		return Kept{places: splitLines(diagnosticPlaces(wanted)), moved: test.positionsMoved, sections: sections.clone()}
	end 'of'

	// isActive is whether the program is a test's that keeps its expected errors.
	function isActive() returns bool
		return places.count() > 0
	end 'isActive'

	// leaves is whether fix leaves the diagnostic alone: it is no missing try, or it is one the test expects.
	function leaves(e diag.CompileError) returns bool
		if e.code != diag.errUncheckedFailure 'other'
			return true
		end 'other'
		let got = diagnosticPlaces(diagnosticText(e, sections: sections))
		for want in places 'places'
			if got == want or hasPrefix(got, prefix: "{want}{placeEnd}") 'same'
				return true
			end 'same'
			if moved and withoutColumn(got) == withoutColumn(want) 'sameLine'
				return true
			end 'sameLine'
		end 'places'
		return false
	end 'leaves'
end 'Kept'

// withoutColumn is a place `<fragment>:line:column` without its column, and any other place as it is.
function withoutColumn(place String) returns String
	var at = place.byteLength()
	while at > 0 and place.byteAt(try at - 1 otherwise 0) != colonByte 'colon'
		at = try at - 1 otherwise 0
	end 'colon'
	if at == 0 or not place.contains(fragmentToken) 'unplaced'
		return place.clone()
	end 'unplaced'
	return place.sliceBytes(0, endPos: try at - 1 otherwise 0).clone()
end 'withoutColumn'

// FixProgram is a program being fixed, in memory: one file, or the files of a project's directory at root.
type FixProgram
	var root as String
	// name is what a message calls the program.
	var name as String
	var single as bool
	var files as project.SourceFiles
	// inLibrary is whether the program is checked in the library tier, as the runner compiles a spec test marked so.
	var inLibrary as bool
	// targets are the targets the program is checked for (fixTargets).
	var targets as ast.TargetList
	// kept is the errors that a test expects, which fix leaves alone (Kept).
	var kept as Kept

	static function make(consumes root String, consumes name String, single bool, consumes files project.SourceFiles, candidates ast.TargetList) returns FixProgram
		let targets = fixTargets(candidates, files: files)
		return FixProgram{root: root, name: name, single: single, files: files, inLibrary: false, targets: targets, kept: Kept.none()}
	end 'make'

	function fileIndex(path String) returns table.Option with Count
		for i in 0 upto files.count() 'files'
			if files[i].path == path 'found'
				return table.Option.some(i)
			end 'found'
		end 'files'
		return table.Option.none
	end 'fileIndex'
end 'FixProgram'

// FixOutcome is what fixing a program came to: its files, which files changed, the kinds of fix it applied, each once, the
// code and the cause of the first diagnostic that is left, or nothing when it checks clean, what it says of a round it undid,
// and the first watched code that was the first diagnostic of a round, where fixing that halts at those codes would have
// stopped.
type FixOutcome
	var files as project.SourceFiles
	var changed as Flags
	var kinds as ast.StringList
	var left as String
	var leftCause as diag.ErrorCause
	var broken as bool
	var said as String
	var watched as table.Option with String
	// rounds are the rounds that made a fix.
	var rounds as Count

	static function make(consumes files project.SourceFiles, consumes changed Flags, consumes kinds ast.StringList, consumes left String, leftCause diag.ErrorCause, broken bool, consumes said String, consumes watched table.Option with String, rounds Count) returns FixOutcome
		return FixOutcome{files: files, changed: changed, kinds: kinds, left: left, leftCause: leftCause, broken: broken, said: said, watched: watched, rounds: rounds}
	end 'make'

	// haltedLeft is the code left by fixing that halts at the watched codes: the first of them that was the first diagnostic of a
	// round, or else what is left, since such fixing goes through the very same rounds.
	function haltedLeft() returns String
		return match watched 'watched'
			some(code) gives code.clone()
			none gives left.clone()
		end 'watched'
	end 'haltedLeft'

	function anyChanged() returns bool
		for i in 0 upto changed.count() 'each'
			if changed[i] 'one'
				return true
			end 'one'
		end 'each'
		return false
	end 'anyChanged'
end 'FixOutcome'

// fixTargets are the targets fix checks a program for, of the candidates it may run on: each of them when a file holds a
// conditional, whose branches differ by target, so that every branch is fixed whatever system fix runs on, and otherwise
// the first, since the program then checks the same for each.
function fixTargets(candidates ast.TargetList, files project.SourceFiles) returns ast.TargetList
	for i in 0 upto files.count() 'files'
		if holdsText(files[i].text, needle: conditionalMark) 'conditional'
			return candidates.clone()
		end 'conditional'
	end 'files'
	var first = ast.TargetList.create(0)
	first.push(candidates[0].clone())
	return first
end 'fixTargets'

// conditionalMark begins a conditional of the source (`#if os(...)`).
let conditionalMark = "#if"

// SharedLibraryOption is the library checked once for a target, or nothing when each check checks it again.
typealias SharedLibraryOption = table.Option with SharedLibrary

// FixLibraries are the libraries that the checks of a run of fix share, by the place of their target among the compiler's
// (ast.knownTargets), or none, where every check checks the library itself: a run that fixes one program checks it once for
// a round, and preparing the library is worth it only for many programs.
typealias FixLibraries = Array with SharedLibraryOption

function noFixLibraries() returns FixLibraries
	return FixLibraries.create(0)
end 'noFixLibraries'

// prepareFixLibraries prepares the library for each of the compiler's targets that needed says a check is for.
function prepareFixLibraries(needed Flags) returns FixLibraries
	let known = ast.knownTargets()
	var libraries = FixLibraries.create(0)
	for i in 0 upto known.count() 'targets'
		if needed[i] 'needed'
			var options = Options.new()
			options.target = known[i].clone()
			libraries.push(SharedLibrary.prepare(options))
		end 'needed' else 'unneeded'
			libraries.push(table.Option.none)
		end 'unneeded'
	end 'targets'
	return libraries
end 'prepareFixLibraries'

// knownTargetIndex is the place of a target among the compiler's.
function knownTargetIndex(target ast.Target) returns Count
	let known = ast.knownTargets()
	for i in 0 upto known.count() 'targets'
		if known[i].name() == target.name() 'found'
			return i
		end 'found'
	end 'targets'
	panic("fix: {target.name()} is no target of the compiler")
end 'knownTargetIndex'

// checkFixing is the diagnostics of the program for each of its targets, located in its files, each once and in order.
function checkFixing(prog FixProgram, libraries FixLibraries) returns diag.ErrorList
	var all = diag.ErrorList.create(0)
	for t in 0 upto prog.targets.count() 'targets'
		let errs = checkFixingFor(prog, libraries: libraries, target: prog.targets[t])
		for i in 0 upto errs.count() 'errors'
			if not holdsError(all, e: errs[i]) 'new'
				all.push(errs[i].clone())
			end 'new'
		end 'errors'
	end 'targets'
	diag.sortErrors(all)
	return all
end 'checkFixing'

// holdsError is whether the list has an error of the same code, place and message, which another target's check found.
function holdsError(errs diag.ErrorList, e diag.CompileError) returns bool
	for i in 0 upto errs.count() 'errors'
		if errs[i].code == e.code and errs[i].file == e.file and errs[i].line == e.line and errs[i].col == e.col and errs[i].message == e.message 'same'
			return true
		end 'same'
	end 'errors'
	return false
end 'holdsError'

// checkFixingFor is the diagnostics of the program compiled for a target, located in its files, on the library the run shares
// for the target when there is one and the program gets the library.
function checkFixingFor(prog FixProgram, libraries FixLibraries, target ast.Target) returns diag.ErrorList
	var errs = diag.ErrorList.create(0)
	var options = Options.new()
	options.target = target.clone()
	options.stagesInLibrary = prog.inLibrary
	var p = projectFor(options)
	if libraries.count() > 0 and project.getsLibrary(prog.root) 'shared'
		match libraries[knownTargetIndex(target)] 'library'
			some(library) then p = library.projectForProgram()
			none then _ = 0
		end 'library'
	end 'shared'
	let first = p.modules.count()
	if prog.single 'single'
		project.loadSourceInto(p, path: prog.files[0].path, text: prog.files[0].text, errs: errs)
	end 'single' else 'project'
		project.loadFilesInto(p, rootPath: prog.root, files: prog.files, errs: errs)
	end 'project'
	compileLoaded(p, first: first, ready: noReadyUnits(), output: "", options: options, errs: errs)
	diag.sortErrors(errs)
	return errs
end 'checkFixingFor'

// editsMeet is whether two edits of one file cannot both be made: they replace text in common, or one inserts inside the
// text the other replaces, or both insert at one place, which leaves their order open.
function editsMeet(a diag.FixEdit, b diag.FixEdit) returns bool
	if a.file != b.file 'files'
		return false
	end 'files'
	let aInserts = a.fileBegin == a.fileUntil
	let bInserts = b.fileBegin == b.fileUntil
	if aInserts and bInserts 'inserts'
		return a.fileBegin == b.fileBegin
	end 'inserts'
	if aInserts 'aInside'
		return b.fileBegin < a.fileBegin and a.fileBegin < b.fileUntil
	end 'aInside'
	if bInserts 'bInside'
		return a.fileBegin < b.fileBegin and b.fileBegin < a.fileUntil
	end 'bInside'
	return a.fileBegin < b.fileUntil and b.fileBegin < a.fileUntil
end 'editsMeet'

function sameEdit(a diag.FixEdit, b diag.FixEdit) returns bool
	return a.file == b.file and a.fileBegin == b.fileBegin and a.fileUntil == b.fileUntil and a.text == b.text
end 'sameEdit'

// Choice is the edits of one round, from the fixes that can be made together, and their kinds.
type Choice
	var edits as diag.FixEdits
	var kinds as ast.StringList

	static function new() returns Choice
		return Choice{edits: diag.FixEdits.create(0), kinds: ast.StringList.create(0)}
	end 'new'

	// fits is whether every edit of fix is in a file of the program and meets none chosen. A fix whose edits are all chosen
	// already is the same change asked for twice, and adds nothing.
	function fits(prog FixProgram, fix diag.Fix) returns bool
		var repeated = 0 as Count
		for i in 0 upto fix.edits.count() 'edits'
			if not prog.fileIndex(fix.edits[i].file).isSome() 'outside'
				return false
			end 'outside'
			for j in 0 upto edits.count() 'chosen'
				if sameEdit(fix.edits[i], b: edits[j]) 'same'
					repeated = increment(repeated)
					continue 'edits'
				end 'same'
				if editsMeet(fix.edits[i], b: edits[j]) 'meets'
					return false
				end 'meets'
			end 'chosen'
		end 'edits'
		return repeated == 0
	end 'fits'

	function add(mutates self, fix diag.Fix)
		for i in 0 upto fix.edits.count() 'edits'
			edits.push(fix.edits[i].clone())
		end 'edits'
		addKind(kinds, kind: fix.kind)
	end 'add'
end 'Choice'

function addKind(mutates kinds ast.StringList, kind String)
	for i in 0 upto kinds.count() 'known'
		if kinds[i] == kind 'same'
			return
		end 'same'
	end 'known'
	kinds.push(kind.clone())
end 'addKind'

// chooseFixes is the fixes of the diagnostics, in their order, that can be made together. A diagnostic whose code is the
// expected one gets none: what a test expects is what it is about, whatever fix its message names. Nor does one that the
// program keeps (Kept). The ending of a value that an exit would drop (check.fixKindEnding) waits for a round with no other
// fix: another fix may end the value itself, as a parameter declared consumes ends what is passed to it, and an ending
// written before it would end the value twice.
function chooseFixes(prog FixProgram, errs diag.ErrorList, expected table.Option with String) returns Choice
	var choice = Choice.new()
	addFixes(choice, prog: prog, errs: errs, expected: expected, endings: false)
	if choice.edits.count() == 0 'settled'
		addFixes(choice, prog: prog, errs: errs, expected: expected, endings: true)
	end 'settled'
	return choice
end 'chooseFixes'

// addFixes adds to choice the fixes of the diagnostics that fit, the endings or the others.
function addFixes(mutates choice Choice, prog FixProgram, errs diag.ErrorList, expected table.Option with String, endings bool)
	for e in errs 'errors'
		if isExpectedCode(e.code, expected: expected) or (prog.kept.isActive() and prog.kept.leaves(e)) 'about'
			continue 'errors'
		end 'about'
		if (e.fix.kind == check.fixKindEnding) != endings 'later'
			continue 'errors'
		end 'later'
		if e.fix.isSome() and choice.fits(prog, fix: e.fix) 'fits'
			choice.add(e.fix)
		end 'fits'
	end 'errors'
end 'addFixes'

// isExpectedCode is whether code is the first code that a test expects, when it expects a compile error.
function isExpectedCode(code String, expected table.Option with String) returns bool
	return match expected 'expected'
		some(wanted) gives code == wanted
		none gives false
	end 'expected'
end 'isExpectedCode'

// editsOfFile is the chosen edits of one file in text order, which keeps the order of the edits at one place.
function editsOfFile(edits diag.FixEdits, file String) returns syntax.Edits
	var out = syntax.Edits.create(0)
	for i in 0 upto edits.count() 'each'
		if edits[i].file != file 'other'
			continue 'each'
		end 'other'
		out.push(syntax.Edit.make(edits[i].fileBegin, until: edits[i].fileUntil, replacement: edits[i].text.clone()))
		var j = 0 as Count
		j = try out.count() - 1 otherwise panic("fix: no edit after a push")
		while j > 0 'shift'
			let prev = try j - 1 otherwise panic("fix: no edit before the first")
			if out[j].begin >= out[prev].begin 'ordered'
				break 'shift'
			end 'ordered'
			let moved = out[j].clone()
			out[j] = out[prev].clone()
			out[prev] = moved
			j = prev
		end 'shift'
	end 'each'
	return out
end 'editsOfFile'

// applyChoice makes the chosen edits in the program's files and puts each file they change in the one layout. A round that
// leaves a file unparsable is a fix that is wrong: it is undone, said, and false.
function applyChoice(mutates prog FixProgram, choice Choice, mutates changed Flags, mutates said String) returns bool
	var files = prog.files.clone()
	for i in 0 upto files.count() 'files'
		let edits = editsOfFile(choice.edits, file: files[i].path)
		if edits.count() == 0 'untouched'
			continue 'files'
		end 'untouched'
		let edited = syntax.applyEdits(files[i].text, edits: edits)
		var refusal = diag.ErrorList.create(0)
		match syntax.formatSource(files[i].path, text: edited) 'layout'
			formatted(text) then files[i].text = text.clone()
			refused(errors) then refusal = errors.clone()
		end 'layout'
		if refusal.count() > 0 'broken'
			said = "broken  a fix left {prog.name} unparsable, so its round is undone: {refusal[0].format()}\n"
			return false
		end 'broken'
		changed[i] = true
	end 'files'
	prog.files = files
	return true
end 'applyChoice'

// fixRoundsOf bounds the rounds of fixing a program: a round for each byte of its files. Each round applies at least one fix,
// and each fix covers a failure of its own, at least a byte of the program, so fixing that has not ended in that many rounds
// is going round in a circle. Most programs take a round or two, since the check reports every missing try of a function at
// once; the bound is what holds whatever the diagnostics of a round leave for the next.
function fixRoundsOf(prog FixProgram) returns Count
	var bytes = 0 as Count
	for file in prog.files 'files'
		bytes = offsetBy(bytes, by: file.text.byteLength())
	end 'files'
	return bytes
end 'fixRoundsOf'

// fixProgram applies the fixes of the program's diagnostics, round by round, until it checks clean, no diagnostic left has
// a fix that can be made, or the rounds run out (fixRoundsOf), when the fixing goes round in a circle and the program is left
// as it was, which the outcome says: a half-made fix is no fixpoint. A round that leaves a file unparsable is undone, and the
// outcome says so. For
// a test that expects a compile error it stops as soon as the first diagnostic has the expected code, or has no fix, and leaves the
// diagnostics of that code alone. The first of the watched codes to be a round's first diagnostic is kept (FixOutcome.watched).
function fixProgram(consumes prog FixProgram, libraries FixLibraries, expected table.Option with String, watches ast.StringList) returns FixOutcome
	let original = prog.files.clone()
	var current = prog
	var changed = Flags.create(0)
	for i in 0 upto current.files.count() 'unchanged'
		changed.push(false)
	end 'unchanged'
	let unchanged = changed.clone()
	var kinds = ast.StringList.create(0)
	var left = ""
	var leftCause = diag.ErrorCause.none
	var broken = false
	var said = ""
	var watched = table.Option.none as table.Option with String
	let rounds = fixRoundsOf(current)
	var applied = 0 as Count
	for round in 0 upto increment(rounds) 'rounds'
		let errs = checkFixing(current, libraries: libraries)
		if errs.count() == 0 'clean'
			left = ""
			leftCause = diag.ErrorCause.none
			break 'rounds'
		end 'clean'
		left = errs[0].code.clone()
		leftCause = errs[0].cause
		if isExpectedCode(left, expected: expected) 'reached'
			break 'rounds'
		end 'reached'
		if not watched.isSome() and holdsKind(watches, kind: left) 'watched'
			watched = table.Option.some(left.clone())
		end 'watched'
		if expected.isSome() and not errs[0].fix.isSome() 'unfixable'
			break 'rounds'
		end 'unfixable'
		if round == rounds 'last'
			said = "{said}unended  fixing {current.name} did not end in {rounds} rounds, so it is left as it was\n"
			return FixOutcome.make(original, changed: unchanged, kinds: ast.StringList.create(0), left: left, leftCause: leftCause, broken: broken, said: said, watched: watched, rounds: applied)
		end 'last'
		let choice = chooseFixes(current, errs: errs, expected: expected)
		if choice.edits.count() == 0 'stuck'
			break 'rounds'
		end 'stuck'
		var roundChanged = changed.clone()
		if not applyChoice(current, choice: choice, changed: roundChanged, said: said) 'undone'
			broken = true
			break 'rounds'
		end 'undone'
		changed = roundChanged
		applied = increment(applied)
		for k in 0 upto choice.kinds.count() 'kinds'
			addKind(kinds, kind: choice.kinds[k])
		end 'kinds'
	end 'rounds'
	return FixOutcome.make(current.files, changed: changed, kinds: kinds, left: left, leftCause: leftCause, broken: broken, said: said, watched: watched, rounds: applied)
end 'fixProgram'

// FixTally counts what a run of fix did: the programs or tests it changed, by kind of fix, the spec tests it skipped for a
// trap or for a code or a cause that the skip table names, and those left with a diagnostic, by its code.
type FixTally
	var changed as Count
	var trapSkips as Count
	var codeSkips as Count
	var broken as Count
	var kinds as ast.StringList
	var kindCounts as CountList
	var codes as ast.StringList
	var codeCounts as CountList
	// rounds are the most rounds that made a fix of one program or test.
	var rounds as Count

	static function new() returns FixTally
		return FixTally{changed: 0, trapSkips: 0, codeSkips: 0, broken: 0, kinds: ast.StringList.create(0), kindCounts: CountList.create(0), codes: ast.StringList.create(0), codeCounts: CountList.create(0), rounds: 0}
	end 'new'

	function count(mutates self, outcome FixOutcome)
		rounds = maxCount(rounds, b: outcome.rounds)
		if outcome.broken 'broken'
			broken = increment(broken)
		end 'broken'
		if outcome.left != "" 'left'
			countIn(codes, counts: codeCounts, key: outcome.left, by: 1)
		end 'left'
	end 'count'

	function countChange(mutates self, outcome FixOutcome)
		changed = increment(changed)
		for i in 0 upto outcome.kinds.count() 'kinds'
			countIn(kinds, counts: kindCounts, key: outcome.kinds[i], by: 1)
		end 'kinds'
	end 'countChange'

	// add counts what another tally counted.
	function add(mutates self, other FixTally)
		changed = offsetBy(changed, by: other.changed)
		trapSkips = offsetBy(trapSkips, by: other.trapSkips)
		codeSkips = offsetBy(codeSkips, by: other.codeSkips)
		broken = offsetBy(broken, by: other.broken)
		rounds = maxCount(rounds, b: other.rounds)
		for i in 0 upto other.kinds.count() 'kinds'
			countIn(kinds, counts: kindCounts, key: other.kinds[i], by: other.kindCounts[i])
		end 'kinds'
		for i in 0 upto other.codes.count() 'codes'
			countIn(codes, counts: codeCounts, key: other.codes[i], by: other.codeCounts[i])
		end 'codes'
	end 'add'
end 'FixTally'

function countIn(mutates keys ast.StringList, mutates counts CountList, key String, by Count)
	for i in 0 upto keys.count() 'known'
		if keys[i] == key 'same'
			counts[i] = offsetBy(counts[i], by: by)
			return
		end 'same'
	end 'known'
	keys.push(key.clone())
	counts.push(by)
end 'countIn'

// countsText is the keys with their counts, the most first and then by key.
function countsText(keys ast.StringList, counts CountList) returns String
	var order = CountList.create(0)
	for i in 0 upto keys.count() 'each'
		order.push(i)
		var at = i
		while at > 0 'sift'
			let before = try at - 1 otherwise 0
			let a = order[at]
			let b = order[before]
			if counts[a] < counts[b] or (counts[a] == counts[b] and not diag.stringLess(keys[a], b: keys[b])) 'ordered'
				break 'sift'
			end 'ordered'
			order[at] = b
			order[before] = a
			at = before
		end 'sift'
	end 'each'
	var out = ByteArray.create(0)
	for i in 0 upto order.count() 'join'
		if i > 0 'separator'
			out.append(", ".toByteArray())
		end 'separator'
		out.append("{keys[order[i]]} {counts[order[i]]}".toByteArray())
	end 'join'
	if order.count() == 0 'none'
		return "none"
	end 'none'
	return String.from(out)
end 'countsText'

function printFixSummary(tally FixTally, checkOnly bool, unit String)
	var verb = "fixed"
	if checkOnly 'checking'
		verb = "would fix"
	end 'checking'
	print("{verb} {tally.changed} {unit}, by kind of fix: {countsText(tally.kinds, counts: tally.kindCounts)}, in at most {tally.rounds} rounds of fixes\n")
	if tally.trapSkips > 0 'traps'
		print("skipped {tally.trapSkips} tests that expect maxon's run-time trap where a fix would add a try\n")
	end 'traps'
	if tally.codeSkips > 0 'codes'
		print("skipped {tally.codeSkips} tests whose codes or causes the skip table names: an expected error that minimaxon reports otherwise, or a program that it refuses, for a known reason\n")
	end 'codes'
	if tally.broken > 0 'broken'
		print("{tally.broken} {unit} had a round undone because a fix left them unparsable\n")
	end 'broken'
	print("left with a diagnostic that has no fix, by the code of the first: {countsText(tally.codes, counts: tally.codeCounts)}\n")
end 'printFixSummary'

// fixCommand is `fix [--check] <path>...`: rest holds the command's name, then the paths and the flag in any order.
function fixCommand(rest CommandNames) returns ExitCode
	var checkOnly = false
	var paths = ast.StringList.create(0)
	for i in 1 upto rest.count() 'args'
		if rest[i] == checkFlag 'check'
			checkOnly = true
		end 'check' else 'path'
			paths.push(rest[i].clone())
		end 'path'
	end 'args'
	if paths.count() == 0 'none'
		printError(usage())
		return usageExitCode
	end 'none'
	for i in 0 upto paths.count() 'readable'
		if not isReadable(paths[i]) 'unreadable'
			printError("cannot read {paths[i]}\n")
			return diagnosticsExitCode
		end 'unreadable'
	end 'readable'
	for i in 0 upto paths.count() 'specs'
		if isSpecPath(paths[i]) 'spec'
			startFixes(paths, checkOnly: checkOnly)
			return compiledByBehaviours
		end 'spec'
	end 'specs'
	var tally = FixTally.new()
	for i in 0 upto paths.count() 'paths'
		takeFixResult(tally, result: fixProgramAt(paths[i], libraries: noFixLibraries(), checkOnly: checkOnly))
	end 'paths'
	printFixSummary(tally, checkOnly: checkOnly, unit: "programs")
	return fixExitCode(tally, checkOnly: checkOnly)
end 'fixCommand'

// fixExitCode is the code a run of fix exits with: with check, whether it would change anything.
function fixExitCode(tally FixTally, checkOnly bool) returns ExitCode
	if checkOnly and tally.changed > 0 'differs'
		return diagnosticsExitCode
	end 'differs'
	return 0
end 'fixExitCode'

// FixResult is what fixing one program or one spec test came to: what it prints, the files of a program it writes, the edits
// of a spec test's file, what it adds to the tally, and its executable when the system kept it from being deleted.
type FixResult
	var out as String
	var writes as project.SourceFiles
	var edits as syntax.Edits
	var tally as FixTally
	var left as LeftExecutable

	static function new() returns FixResult
		return FixResult{out: "", writes: project.SourceFiles.create(0), edits: syntax.Edits.create(0), tally: FixTally.new(), left: table.Option.none}
	end 'new'

	function say(mutates self, text String)
		if text != "" 'said'
			out = "{out}{text}"
		end 'said'
	end 'say'
end 'FixResult'

// takeFixResult prints what a fix said, writes the files it fixed, and counts it, as each fix is taken in, in the order of the
// programs and the tests.
function takeFixResult(mutates tally FixTally, result FixResult)
	print(result.out)
	for i in 0 upto result.writes.count() 'writes'
		writeFixed(result.writes[i].path, text: result.writes[i].text)
	end 'writes'
	tally.add(result.tally)
end 'takeFixResult'

function writeFixed(file String, text String)
	ast.writeOutputText(file, content: text)
end 'writeFixed'

// programAt is the program at path, a .maxon file or a project's directory, as its files read.
function programAt(path String) returns FixProgram
	var files = project.SourceFiles.create(0)
	if project.isDirectoryPath(path) 'project'
		var names = ast.StringList.create(0)
		collectSourceFiles(path, files: names)
		project.sortStrings(names)
		for i in 0 upto names.count() 'files'
			if endsWithText(names[i], suffix: sourceExtension) 'source'
				files.push(project.SourceFile.make(names[i].clone(), text: readText(names[i])))
			end 'source'
		end 'files'
		return FixProgram.make(path.clone(), name: path.clone(), single: false, files: files, candidates: ast.knownTargets())
	end 'project'
	files.push(project.SourceFile.make(path.clone(), text: readText(path)))
	return FixProgram.make(path.clone(), name: path.clone(), single: true, files: files, candidates: ast.knownTargets())
end 'programAt'

// fixProgramAt fixes the program at path: the files it changed are to be written, or with check named.
function fixProgramAt(path String, libraries FixLibraries, checkOnly bool) returns FixResult
	var result = FixResult.new()
	let outcome = fixProgram(programAt(path), libraries: libraries, expected: table.Option.none, watches: ast.StringList.create(0))
	result.say(outcome.said)
	result.tally.count(outcome)
	if not outcome.anyChanged() 'unchanged'
		return result
	end 'unchanged'
	result.tally.countChange(outcome)
	for i in 0 upto outcome.files.count() 'files'
		if not outcome.changed[i] 'untouched'
			continue 'files'
		end 'untouched'
		let file = outcome.files[i].path.clone()
		if checkOnly 'listed'
			result.say("would fix  {file}\n")
			continue 'files'
		end 'listed'
		result.writes.push(project.SourceFile.make(file.clone(), text: outcome.files[i].text.clone()))
		result.say("fixed  {file}\n")
	end 'files'
	return result
end 'fixProgramAt'

// fixSource is the text that fix makes of one program file, path naming it in the diagnostics, and what fixing it came to.
function fixSource(path String, text String) returns FixOutcome
	var files = project.SourceFiles.create(0)
	files.push(project.SourceFile.make(path.clone(), text: text.clone()))
	return fixProgram(FixProgram.make(path.clone(), name: path.clone(), single: true, files: files, candidates: ast.knownTargets()), libraries: noFixLibraries(), expected: table.Option.none, watches: ast.StringList.create(0))
end 'fixSource'

// isFixable is whether fix may change a spec test: one that the conversion did not skip, that runs a program rather than
// being about a diagnostic, and whose block is the program alone.
function isFixable(test SpecTest, text String) returns bool
	return isFixableBlock(test, text: text) and not resultFence(test, base: compilerErrorFence).isSome()
end 'isFixable'

// isFixableBlock is whether fix may change the block of a spec test: one that the conversion did not skip, and whose block
// is the program alone.
function isFixableBlock(test SpecTest, text String) returns bool
	if test.skips.count() > 0 or not test.hasSource or test.sourceStart >= test.sourceFinish 'skipped'
		return false
	end 'skipped'
	return not sourceHasOverlay(text.sliceBytes(test.sourceStart, endPos: test.sourceFinish))
end 'isFixableBlock'

// expectsTrap is whether what the test expects on stderr is a panic, which a trap of maxon's prints.
function expectsTrap(test SpecTest, text String) returns bool
	let stderr = fenceText(test, text: text, base: stderrFence)
	return stderr.isSome() and holdsText(stderr.unwrap(), needle: panicWord)
end 'expectsTrap'

// withoutFinalNewline is a file's text as a block of a spec holds it, which ends before the newline that ends the file.
function withoutFinalNewline(text String) returns borrowed String
	var finish = text.byteLength()
	while finish > 0 and text.byteAt(try finish - 1 otherwise 0) == newlineByte 'trim'
		finish = try finish - 1 otherwise 0
	end 'trim'
	return text.sliceBytes(0, endPos: finish)
end 'withoutFinalNewline'

// fixedBlock is the maxon block of a test after fixing: the file, which is checked under the header line that the runner puts
// above it, or each section of a multi-file block in its place.
function fixedBlock(source String, sections SourceSections, outcome FixOutcome) returns String
	if sections.count() == 0 'single'
		let text = outcome.files[0].text.clone()
		var at = 0 as Count
		while at < text.byteLength() and text.byteAt(at) != newlineByte 'header'
			at = offsetBy(at, by: 1)
		end 'header'
		return withoutFinalNewline(text.sliceBytes(minCount(offsetBy(at, by: 1), b: text.byteLength()), endPos: text.byteLength())).clone()
	end 'single'
	var edits = syntax.Edits.create(0)
	for i in 0 upto sections.count() 'sections'
		if outcome.changed[i] 'changed'
			let finish = offsetBy(sections[i].start, by: sections[i].text.byteLength())
			edits.push(syntax.Edit.make(sections[i].start, until: finish, replacement: withoutFinalNewline(outcome.files[i].text).clone()))
		end 'changed'
	end 'sections'
	return syntax.applyEdits(source, edits: edits)
end 'fixedBlock'

// CodeMismatch is a test that expects a compile error and that minimaxon refuses under another first code: the code that
// maxon expects and the one that minimaxon reports.
type CodeMismatch
	var expected as String
	var reported as String

	static function make(consumes expected String, consumes reported String) returns CodeMismatch
		return CodeMismatch{expected: expected, reported: reported}
	end 'make'
end 'CodeMismatch'

// SharedRuntimes are the runtime prepared for each of the compiler's targets, in their order (ast.knownTargets).
typealias SharedRuntimes = Array with SharedRuntime

// prepareSharedRuntimes prepares the runtime of each of the compiler's targets that needed says a test compiles for, and none
// for the others.
function prepareSharedRuntimes(needed Flags) returns SharedRuntimes
	let known = ast.knownTargets()
	var shared = SharedRuntimes.create(0)
	for i in 0 upto known.count() 'targets'
		if needed[i] 'needed'
			shared.push(prepareSharedRuntime(known[i]))
		end 'needed' else 'unneeded'
			shared.push(SharedRuntime.none())
		end 'unneeded'
	end 'targets'
	return shared
end 'prepareSharedRuntimes'

// fixTargetOf is the target fix compiles a spec test for when it asks what the test's program reports: the first the test
// runs for (runTargets), by its place among the compiler's targets, so that the answer is the same on every system.
function fixTargetOf(test SpecTest) returns Count
	let target = runTargets(test)[0].name()
	let known = ast.knownTargets()
	for i in 0 upto known.count() 'targets'
		if known[i].name() == target 'found'
			return i
		end 'found'
	end 'targets'
	panic("fix: {target} is no target of the compiler")
end 'fixTargetOf'

// gateSetsEnvironment is that the runner the gate runs sets the environment a test's directives ask for, so a test that has one
// is run, and fixed.
let gateSetsEnvironment = true

// codeMismatchOf is the mismatch of a test that the runner would run, that expects a compile error, and whose first error
// minimaxon reports under another code, compiled for the test's fix target to the executable at exe; nothing for any other
// test. left is that executable when the system kept it from being deleted.
function codeMismatchOf(shared SharedRuntimes, exe String, test SpecTest, text String, mutates left LeftExecutable) returns table.Option with CodeMismatch
	let at = fixTargetOf(test)
	if not test.hasSource or skipReasonFor(test, text: text, target: ast.knownTargets()[at], setsEnvironment: gateSetsEnvironment).isSome() 'unrun'
		return table.Option.none
	end 'unrun'
	let expected = expectedFirstCode(test, text: text)
	if not expected.isSome() 'noError'
		return table.Option.none
	end 'noError'
	let source = text.sliceBytes(test.sourceStart, endPos: test.sourceFinish)
	var errs = diag.ErrorList.create(0)
	compileSpecSource(shared[at], exe: exe, test: test, source: source, sections: splitSections(source), verifies: false, errs: errs)
	if errs.count() == 0 'compiled'
		left = discarded(exe)
		return table.Option.none
	end 'compiled'
	if isExpectedCode(errs[0].code, expected: expected) 'agrees'
		return table.Option.none
	end 'agrees'
	return table.Option.some(CodeMismatch.make(expected.unwrap(), reported: errs[0].code.clone()))
end 'codeMismatchOf'

// expectedRuleSkip is the skip line of a test that the runner would run and that the skip table names, or whose first
// expected code it skips whatever minimaxon reports; nothing for any other test. file is the name of the test's spec file.
function expectedRuleSkip(skips CodeSkips, file String, test SpecTest, text String) returns table.Option with String
	if not test.hasSource or skipReasonFor(test, text: text, target: ast.knownTargets()[fixTargetOf(test)], setsEnvironment: gateSetsEnvironment).isSome() 'unrun'
		return table.Option.none
	end 'unrun'
	let named = namedSkipLine(skips, file: file, test: test.name)
	if named.isSome() 'named'
		return named
	end 'named'
	let expected = expectedFirstCode(test, text: text)
	if not expected.isSome() 'noError'
		return table.Option.none
	end 'noError'
	return expectedSkipLine(skips, expected: expected.unwrap())
end 'expectedRuleSkip'

// fixSpecTestAt is what fixing one test of a spec file comes to, display naming the file and text its text: the edits of the
// file, which with check are only counted and named. exe is where a compile of the test may make its executable.
function fixSpecTestAt(shared SharedRuntimes, libraries FixLibraries, exe String, skips CodeSkips, display String, text String, test SpecTest, checkOnly bool) returns FixResult
	var result = FixResult.new()
	let expectSkip = expectedRuleSkip(skips, file: display, test: test, text: text)
	if expectSkip.isSome() 'ruleSkipped'
		skipSpecTest(result, test: test, line: expectSkip.unwrap())
		return result
	end 'ruleSkipped'
	let mismatch = codeMismatchOf(shared, exe: exe, test: test, text: text, left: result.left)
	if mismatch.isSome() 'mismatched'
		// A code that the table pairs with the expected one skips the test only where fixing does not get past it
		// (unreachedSkipLine): a fix of an earlier diagnostic that reaches the expected error is the test's to run.
		let pair = mismatch.unwrap()
		fixSpecTest(libraries, test: test, text: text, display: display, skips: skips, expected: table.Option.some(pair.expected.clone()), checkOnly: checkOnly, result: result)
		return result
	end 'mismatched'
	if isFixable(test, text: text) 'runs'
		fixSpecTest(libraries, test: test, text: text, display: display, skips: skips, expected: table.Option.none, checkOnly: checkOnly, result: result)
	end 'runs' else if isFixableBlock(test, text: text) 'refused'
		fixAroundExpected(libraries, test: test, text: text, display: display, checkOnly: checkOnly, result: result)
	end 'refused'
	return result
end 'fixSpecTestAt'

// fixAroundExpected adds to edits the missing tries of a test that expects a compile error and that minimaxon refuses with
// the code it expects, but for the errors the test expects (Kept). The test is changed only when what is left is what it
// expects, as the runner compares it, so a try that would cover an expected error as well leaves the test as it was.
function fixAroundExpected(libraries FixLibraries, test SpecTest, text String, display String, checkOnly bool, mutates result FixResult)
	let fence = fenceText(test, text: text, base: compilerErrorFence)
	if not fence.isSome() 'unexpected'
		return
	end 'unexpected'
	let expected = fence.unwrap().clone()
	let source = text.sliceBytes(test.sourceStart, endPos: test.sourceFinish)
	let sections = splitSections(source)
	var prog = specProgram(test, display: display, source: source, sections: sections)
	prog.kept = Kept.of(test, expected: expected, display: display, sections: sections)
	let outcome = fixProgram(prog, libraries: libraries, expected: table.Option.none, watches: ast.StringList.create(0))
	result.say(outcome.said)
	if not outcome.anyChanged() 'unchanged'
		return
	end 'unchanged'
	let fixed = fixedBlock(source, sections: sections, outcome: outcome)
	let fixedSections = splitSections(fixed)
	let errs = checkFixing(specProgram(test, display: display, source: fixed, sections: fixedSections), libraries: libraries)
	if checkSpecError(test, expected: expected, stem: fileStem(display), errs: errs, sections: fixedSections).outcome != TestOutcome.testPassed 'disagrees'
		return
	end 'disagrees'
	result.tally.countChange(outcome)
	if checkOnly 'listed'
		result.say("would fix  {display}: {test.name}\n")
	end 'listed'
	result.edits.push(syntax.Edit.make(test.sourceStart, until: test.sourceFinish, replacement: fixed))
end 'fixAroundExpected'

// skipSpecTest skips a test for a code or a cause that the skip table names, with the table's line after its marker.
function skipSpecTest(mutates result FixResult, test SpecTest, line String)
	result.tally.codeSkips = increment(result.tally.codeSkips)
	result.edits.push(syntax.Edit.make(test.markerEnd, until: test.markerEnd, replacement: line.clone()))
end 'skipSpecTest'

// specProgram is the program of a spec test's source: the fragment, or the files of its sections.
function specProgram(test SpecTest, display String, source String, sections SourceSections) returns FixProgram
	if sections.count() == 0 'single'
		var files = project.SourceFiles.create(0)
		files.push(project.SourceFile.make(fragmentToken, text: "{fragmentHeader}{test.name}\n{source}\n"))
		var prog = FixProgram.make(fragmentToken, name: "{display}: {test.name}", single: true, files: files, candidates: runTargets(test))
		prog.inLibrary = stagedInLibrary(test)
		return prog
	end 'single'
	var prog = FixProgram.make(projectRoot, name: "{display}: {test.name}", single: false, files: sectionFiles(sections), candidates: runTargets(test))
	prog.inLibrary = stagedInLibrary(test)
	return prog
end 'specProgram'

// fixSpecTest adds to edits what fixing one test comes to. A test that expects a compile error is changed only when its fixes
// make the first error the expected one or leave the program clean, and then its positions are marked as moved, which the
// fixes did; otherwise it is skipped when the table names why for the first code the fixes leave (unreachedSkipLine), the
// fixes stopping at a code that makes a pair of the table with the expected one. A program that is clean after the fixes is
// changed so that the test fails for the one thing missing: the diagnostic.
function fixSpecTest(libraries FixLibraries, test SpecTest, text String, display String, skips CodeSkips, expected table.Option with String, checkOnly bool, mutates result FixResult)
	let source = text.sliceBytes(test.sourceStart, endPos: test.sourceFinish)
	let sections = splitSections(source)
	let outcome = fixProgram(specProgram(test, display: display, source: source, sections: sections), libraries: libraries, expected: expected, watches: haltCodes(skips, expected: expected))
	result.say(outcome.said)
	result.tally.count(outcome)
	let caused = causeSkipLine(skips, cause: outcome.leftCause)
	if caused.isSome() and not isExpectedCode(outcome.left, expected: expected) 'caused'
		skipSpecTest(result, test: test, line: caused.unwrap())
		return
	end 'caused'
	if not expected.isSome() 'runs'
		let refused = refusedRunSkipLine(skips, left: outcome.left)
		if refused.isSome() 'refused'
			skipSpecTest(result, test: test, line: refused.unwrap())
			return
		end 'refused'
	end 'runs'
	if expected.isSome() and not isExpectedCode(outcome.left, expected: expected) 'unreached'
		// Fixing that halts at the codes paired with the expected one goes through the same rounds, and says again what it
		// undid when no such code stopped it first.
		if not outcome.watched.isSome() 'sameRounds'
			result.say(outcome.said)
		end 'sameRounds'
		let unreached = unreachedSkipLine(skips, expected: expected, left: outcome.haltedLeft())
		if unreached.isSome() 'skipped'
			skipSpecTest(result, test: test, line: unreached.unwrap())
			return
		end 'skipped'
		if outcome.left != "" 'refused'
			return
		end 'refused'
	end 'unreached'
	if not outcome.anyChanged() 'unchanged'
		return
	end 'unchanged'
	if holdsKind(outcome.kinds, kind: check.fixKindTry) and expectsTrap(test, text: text) 'trap'
		result.tally.trapSkips = increment(result.tally.trapSkips)
		result.edits.push(syntax.Edit.make(test.markerEnd, until: test.markerEnd, replacement: trapSkipLine))
		return
	end 'trap'
	result.tally.countChange(outcome)
	if checkOnly 'listed'
		result.say("would fix  {display}: {test.name}\n")
	end 'listed'
	if expected.isSome() and not test.positionsMoved 'moved'
		result.edits.push(syntax.Edit.make(test.markerEnd, until: test.markerEnd, replacement: positionsMovedLine))
	end 'moved'
	result.edits.push(syntax.Edit.make(test.sourceStart, until: test.sourceFinish, replacement: fixedBlock(source, sections: sections, outcome: outcome)))
end 'fixSpecTest'

function holdsKind(kinds ast.StringList, kind String) returns bool
	for i in 0 upto kinds.count() 'each'
		if kinds[i] == kind 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'holdsKind'
