// The library's names index: for each module of the standard library, the words by which a program can reach it, which are
// the names it declares at the top level and the names of the members that its extensions of other types export (see
// libscan.maxon), and the library modules its own source may name. All of it is read
// from the text of the module's files by a scan of project.scanModule, which lexes and parses nothing: the scan stage of
// each library module, which runs beside the program's parses, gives the module's words and what it names to the parse of
// every library module. A program's compile parses a module of the library only when the program reaches it: each word that
// the program's code writes (its parse's names, which leave out its comments and the text of its strings but not their
// interpolations) reaches the modules it is a word of, closed over what those name, and the core is reached always
// (reachedLibrary). That is a superset of what the program's resolves name, so a module
// the scan leaves out is one no resolve would have named, which is never resolved (resolvesModule) and is never parsed
// either: a file of it with an error is no error of a program that does not reach it. Go's compiler reads a package's export
// data instead of its source in the same way.
//
// The index is what the scans of the library's modules made, kept in the build cache under the digest of the compiler and of
// every file of the library, its path, size and time of last write, so it is the library's as it is on disk: a compile that
// finds it there takes each module's words and names from it, where it would read the module's files, and one that read them
// all writes it, so the next compile has it. It is a cache of the scan, and no second rule of what reaches what.
//
// A compile asks the file system for each file's size and time (a directory's record of it, with no open) where it would read
// and hash 575 KB, as Go's build cache trusts a stat before it reads a file, and a time has the seconds of the file system's
// own resolution, so a file may change at the second its scan read it with its size and time as they were. The index therefore
// holds the file system's time when the compile that wrote it began, before it read any file (stamp), and a compile takes it
// only when every file was last written at least indexMarginSeconds before that time: a write after the stamp is at a time
// not before the stamp less the coarsest resolution of a file system (two seconds, FAT's), so it is no write the key's time
// holds, and the file that it wrote is read again, by a scan that writes the index again under a later stamp. What the key
// cannot see is a file replaced by another of its size whose time is older than the stamp, as by an archive that keeps times.

let indexMagic = "minimaxon library names index"

let indexFormat = 3 as Count

// indexMarginSeconds is the longest that a file system's time of last write may lag a write, which it rounds down by.
let indexMarginSeconds = 2 as Count

let indexExtension = ".names"

// IndexedModule is what the index holds of one module of the library, which its place among the library's modules in the
// project's order names (libraryOrdinal): the words that reach it, and the places of the library modules it may name.
type IndexedModule
	var words as ast.StringList
	var named as project.CountList

	static function make(consumes words ast.StringList, consumes named project.CountList) returns IndexedModule
		return IndexedModule{words: words, named: named}
	end 'make'
end 'IndexedModule'

typealias IndexedModules = Array with IndexedModule

// LibraryIndex is the index as a compile reads it: the modules it holds, and whether it holds any (a compile with no index
// scans the modules' files).
type LibraryIndex
	var modules as IndexedModules
	var present as bool

	static function absent() returns LibraryIndex
		return LibraryIndex{modules: IndexedModules.create(0), present: false}
	end 'absent'

	static function of(consumes modules IndexedModules) returns LibraryIndex
		return LibraryIndex{modules: modules, present: true}
	end 'of'
end 'LibraryIndex'

// IndexSetup is how a compile reads and writes the index: the cache's directory, or none, the key the index is kept under, the
// file system's time when the compile began (stamp), which an index that it writes holds, and the latest time of last write
// of the library's files (newest), which an index that it reads is held to.
type IndexSetup
	var dir as String
	var key as table.Digest
	var stamp as Count
	var newest as Count

	static function off() returns IndexSetup
		return IndexSetup{dir: "", key: table.Digest.none(), stamp: 0, newest: 0}
	end 'off'

	static function make(consumes dir String, consumes key table.Digest, stamp Count, newest Count) returns IndexSetup
		return IndexSetup{dir: dir, key: key, stamp: stamp, newest: newest}
	end 'make'

	function enabled() returns bool
		return dir != ""
	end 'enabled'
end 'IndexSetup'

// indexSetupOf is the index's setup for a compile of the modules of p from first on: off unless the compile is a program's
// whose library resolves after it (libraryLater) and uses the build cache; otherwise keyed by the compiler and the path, size
// and time of last write of every file of the library, as the file system gives them, and off where it gives none or the
// cache has no time of the file system's now (cache.now) to hold the files' times to.
function indexSetupOf(p ast.Project, libraryLater Placed, first Count, options Options, cache CacheSetup) returns IndexSetup
	if options.cacheDir == "" or options.emitIr or options.verifyIr 'off'
		return IndexSetup.off()
	end 'off'
	var stamp = 0 as Count
	match cache.now 'now'
		some(t) then stamp = t
		none then return IndexSetup.off()
	end 'now'
	var any = false
	for i in 0 upto libraryLater.count() 'later'
		if libraryLater[i] 'library'
			any = true
		end 'library'
	end 'later'
	if not any 'program'
		return IndexSetup.off()
	end 'program'
	var h = table.Hasher.new()
	h.addText(indexMagic)
	h.addCount(indexFormat)
	h.addDigest(options.compiler)
	var newest = 0 as Count
	var m = 0 as Count
	for module in p.modules 'modules'
		if m >= first and module.isLibrary 'library'
			h.addCount(m)
			h.addCount(module.filePaths.count())
			for file in module.filePaths 'files'
				let path = try FilePath.from(file) otherwise return IndexSetup.off()
				let info = try File.info(path) otherwise return IndexSetup.off()
				let written = info.modifiedTime as Count
				h.addText(file)
				h.addCount(info.size as Count)
				h.addCount(written)
				if written > newest 'later'
					newest = written
				end 'later'
			end 'files'
		end 'library'
		m = after(m)
	end 'modules'
	return IndexSetup.make(options.cacheDir.clone(), key: h.digest(), stamp: stamp, newest: newest)
end 'indexSetupOf'

// indexSettled is whether the files of the library, the latest of which was last written at newest, were all written at least
// indexMarginSeconds before an index that was begun at stamp, so that none of them could have been written after it, which
// its key would not show.
function indexSettled(newest Count, stamp Count) returns bool
	return stamp > indexMarginSeconds and newest <= stamp - indexMarginSeconds
end 'indexSettled'

function indexPath(setup IndexSetup) returns String
	return project.joinPath(setup.dir, name: "{setup.key.hex()}{indexExtension}")
end 'indexPath'

// readIndex is the index the cache holds under the setup's key, or an absent one when it holds none, or a file there that is
// not a whole index of this layout under that key.
function readIndex(setup IndexSetup) returns LibraryIndex
	if not setup.enabled() 'off'
		return LibraryIndex.absent()
	end 'off'
	let path = try FilePath.from(indexPath(setup)) otherwise return LibraryIndex.absent()
	let text = try File.readText(path) otherwise return LibraryIndex.absent()
	var r = table.ByteReader.of(text)
	let magic = r.text()
	let format = r.count()
	let key = r.digest()
	let stamp = r.count()
	if r.broken or magic != indexMagic or format != indexFormat or not key.equals(setup.key) 'foreign'
		return LibraryIndex.absent()
	end 'foreign'
	if not indexSettled(setup.newest, stamp: stamp) 'unsettled'
		return LibraryIndex.absent()
	end 'unsettled'
	var modules = IndexedModules.create(0)
	let count = r.items()
	for _ in 0 upto count 'modules'
		var words = ast.StringList.create(0)
		let wordCount = r.items()
		for _ in 0 upto wordCount 'words'
			words.push(r.text())
		end 'words'
		var named = project.CountList.create(0)
		let namedCount = r.items()
		for _ in 0 upto namedCount 'named'
			let ordinal = r.count()
			if ordinal >= count 'past'
				return LibraryIndex.absent()
			end 'past'
			named.push(ordinal)
		end 'named'
		modules.push(IndexedModule.make(words, named: named))
	end 'modules'
	if r.broken or not r.atEnd() 'broken'
		return LibraryIndex.absent()
	end 'broken'
	return LibraryIndex.of(modules)
end 'readIndex'

// writeIndex keeps the index of the library modules in the cache under the setup's key, written whole and renamed over its
// name.
function writeIndex(setup IndexSetup, modules IndexedModules)
	var w = table.ByteWriter.new()
	w.text(indexMagic)
	w.count(indexFormat)
	w.digest(setup.key)
	w.count(setup.stamp)
	w.count(modules.count())
	for module in modules 'modules'
		w.count(module.words.count())
		for word in module.words 'words'
			w.text(word)
		end 'words'
		w.count(module.named.count())
		for ordinal in module.named 'named'
			w.count(ordinal)
		end 'named'
	end 'modules'
	writeWhole(indexPath(setup), bytes: w.bytes)
end 'writeIndex'

// writeIndexWhenMissing writes the library's names index once a compile that has none scanned every module of the library:
// the words of each and the library modules it may name, as its scan found them. A module whose files could not be read
// leaves the index unwritten.
function writeIndexWhenMissing(c Compile, known Known)
	if not c.indexSetup.enabled() or c.index.present 'kept'
		return
	end 'kept'
	var modules = IndexedModules.create(0)
	var slot = 0 as Count
	for product in known 'slots'
		if c.laterAt(slot) 'library'
			if not product.namesRead 'unread'
				return
			end 'unread'
			var named = project.CountList.create(0)
			for m in product.named 'named'
				named.push(libraryOrdinal(c, m: m))
			end 'named'
			modules.push(IndexedModule.make(product.words.clone(), named: named))
		end 'library'
		slot = after(slot)
	end 'slots'
	writeIndex(c.indexSetup, modules: modules)
end 'writeIndexWhenMissing'

// loadIndexed gives the module's work the words and the names that the index holds of library module m, in place of the scan
// of its files.
function loadIndexed(c Compile, mutates work ModuleWork, m Count)
	let ordinal = libraryOrdinal(c, m: m)
	var place = 0 as Count
	for module in c.index.modules 'modules'
		if place == ordinal 'found'
			work.words = module.words.clone()
			var named = project.CountList.create(0)
			for n in module.named 'named'
				named.push(libraryModuleAt(c, ordinal: n))
			end 'named'
			work.named = named
			work.namesRead = true
		end 'found'
		place = after(place)
	end 'modules'
end 'loadIndexed'

// programWords are the words of the library that a module of the program writes, each once, which parsed is the parse of: the
// names its code writes (ast.ParsedModule.nameUses), the name of the type that a map literal or a range value makes
// (addLiteralWords), and the marks of a call of a handle's post and of a spawn (postsMark, spawnsMark), which together reach
// PostedMessage, the type a post gives (postedWritten).
function programWords(parsed ast.ParsedModule, library WordSet) returns ast.StringList
	var words = ast.StringList.create(0)
	var seen = WordSet.new()
	var posts = false
	for named in parsed.nameUses 'names'
		let word = parsed.tree.text.sliceBytes(named.start as Count, endPos: named.endOffset())
		if library.has(word) and not seen.has(word) 'new'
			seen.insert(word.clone(), value: 1)
			words.push(word.clone())
		end 'new'
		if word == ast.postMethodName 'post'
			posts = true
		end 'post'
	end 'names'
	if posts 'posts'
		words.push(postsMark.clone())
	end 'posts'
	addLiteralWords(words, tree: parsed.tree)
	return words
end 'programWords'

// postsMark and spawnsMark are the words a module of the program gives where it writes a call of post and where it spawns a
// service, neither of which a module of the library declares. A handle's post needs a handle, which only a spawn of the
// program makes, as the library spawns no service, so a program reaches PostedMessage only where it writes both, in the same
// module or in two, and a program with no service never does, though it write post (postedWritten).
let postsMark = ".post"

let spawnsMark = "spawn"

// postedWritten adds PostedMessage to the words written of a program that writes both marks (postsMark, spawnsMark).
function postedWritten(mutates written WordSet)
	if written.has(postsMark) and written.has(spawnsMark) and not written.has(ast.libraryPostedName) 'posts'
		written.insert(ast.libraryPostedName.clone(), value: 1)
	end 'posts'
end 'postedWritten'

// addLiteralWords adds to the words of a program the names of the library types that its literals make, which it never writes
// and so would never reach the module of: a map literal makes the Map and a range value the Range or the OpenRange
// (ast.libraryMapName, ast.rangeTypeName), and the mark of a spawn (spawnsMark).
function addLiteralWords(mutates words ast.StringList, tree ast.Tree)
	var makesMap = false
	var makesRange = false
	var makesOpenRange = false
	var spawns = false
	for n in 1 upto tree.records.count() 'nodes'
		let id = try n as ast.NodeID otherwise panic("driver: more nodes than a node id holds")
		let kind = tree.kindOf(id)
		if kind == ast.NodeKind.collectionLitExpr and tree.listLen(ast.collectionLitExprValuesRef(tree, id: id)) > 0 'map'
			makesMap = true
		end 'map' else if kind == ast.NodeKind.rangeExpr 'range'
			if ast.rangeExprInclusive(tree, id: id) 'inclusive'
				makesRange = true
			end 'inclusive' else 'open'
				makesOpenRange = true
			end 'open'
		end 'range' else if kind == ast.NodeKind.spawnExpr 'spawn'
			spawns = true
		end 'spawn'
	end 'nodes'
	if makesMap 'map'
		words.push(ast.libraryMapName.clone())
	end 'map'
	if makesRange 'range'
		words.push(ast.rangeTypeName(true))
	end 'range'
	if makesOpenRange 'openRange'
		words.push(ast.rangeTypeName(false))
	end 'openRange'
	if spawns 'spawns'
		words.push(spawnsMark.clone())
	end 'spawns'
end 'addLiteralWords'

typealias WordSet = table.StringMap with Count

// after is the place after at: a library has few modules, so it never overflows.
function after(at Count) returns Count
	return try at + 1 otherwise panic("driver: a place past memory")
end 'after'

// libraryWords are the words of every module of the library, as the scans that known holds found them: the words a program's
// names are read for (programWords).
function libraryWords(c Compile, known Known) returns WordSet
	var all = WordSet.new()
	var slot = 0 as Count
	for product in known 'modules'
		if c.laterAt(slot) 'library'
			for word in product.words 'words'
				if not all.has(word) 'new'
					all.insert(word.clone(), value: 1)
				end 'new'
			end 'words'
		end 'library'
		slot = after(slot)
	end 'modules'
	return all
end 'libraryWords'
