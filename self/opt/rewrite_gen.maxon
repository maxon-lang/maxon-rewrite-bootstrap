// mayRaise is whether a rule of pressure.rules, which may raise register pressure, could match x: x has the operation
// and the case of one.
export function mayRaise(x ir.Instr) returns bool
	if x.op == ir.Opcode.opBin and ir.binOp(x) == ir.BinOp.binDiv 'case1'
		return true
	end 'case1'
	if x.op == ir.Opcode.opBin and ir.binOp(x) == ir.BinOp.binMod 'case2'
		return true
	end 'case2'
	return false
end 'mayRaise'

// generic.rules:24: (bin.add x (const [0])) => x
function rule24(mutates fn ir.IrFunction, at Count, defs ir.Defs, mutates out Rewrite) returns bool
	if ir.binOp(fn.instrs[at]) != ir.BinOp.binAdd 'm1'
		return false
	end 'm1'
	let vX = ir.binLeft(fn.instrs[at])
	let reg1 = ir.binRight(fn.instrs[at])
	if not definedBy(fn, defs: defs, r: reg1, op: ir.Opcode.opConst) 'm2'
		return false
	end 'm2'
	let def2 = defOf(defs, r: reg1)
	if ir.constValue(fn.instrs[def2]) != 0 'm3'
		return false
	end 'm3'
	out.pre.clear()
	out.kind = RewriteKind.rewriteToReg
	out.reg = vX
	return true
end 'rule24'

