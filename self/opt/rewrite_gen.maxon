	let reg1 = ir.binRight(fn.instrs[at])
	if not definedBy(fn, defs: defs, r: reg1, op: ir.Opcode.opConst) 'm2'
		return false
	end 'm2'
	let def2 = defOf(defs, r: reg1)
	if ir.constValue(fn.instrs[def2]) != 0 'm3'
		return false
	end 'm3'
	out.pre.clear()
	out.kind = RewriteKind.rewriteToReg
	out.reg = vX
	return true
end 'rule22'

