function rule61(mutates fn ir.IrFunction, at Count, defs ir.Defs, mutates out Rewrite) returns bool
	if ir.binOp(fn.instrs[at]) != ir.BinOp.binMul 'm1'
		return false
	end 'm1'
	if ir.binHasFail(fn.instrs[at]) 'm2'
		return false
	end 'm2'
	let vX = ir.binLeft(fn.instrs[at])
	let reg1 = ir.binRight(fn.instrs[at])
	if not definedBy(fn, defs: defs, r: reg1, op: ir.Opcode.opConst) 'm3'
		return false
	end 'm3'
	let def2 = defOf(defs, r: reg1)
	let vC = ir.constValue(fn.instrs[def2])
	if not (isPowerOfTwo(vC)) 'm4'
		return false
	end 'm4'
	out.pre.clear()
	let dst = fn.instrs[at].dst
	let new3 = fn.newReg(ir.IrKind.kindScalar)
	out.pre.push(ir.newConst(new3, value: log2(vC)))
	out.instr = ir.newBin(dst, op: ir.BinOp.binShl, left: vX, right: new3, unsigned: false, fail: ir.noBlock)
	out.kind = RewriteKind.rewriteToInstr
	return true
end 'rule61'

