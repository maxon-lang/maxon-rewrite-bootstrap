// The expansion of the primitives, maxon's inlineManagedPrimitives: a call of a runtime entry that reads the length of an
// array, a byte array or a string, or one of their elements, becomes the operations its common case is (README, "The
// primitives in the IR"), so the optimizer, instruction selection and the register allocator see loads and no call. A
// read of an element is the length, a bounds check of the index against it, and the read. The check fails to a block of
// its own after the function's, which makes the call that was there and traps: called there, the entry traps with its own
// message, as it always did. A proven call, whose index the checker or a check before it proved in range, is the read
// alone. The address of an element that only a loadat right after it reads is the element read itself.
// Every other entry, and the call a trap block makes, stays a call.
//
// It runs on the IR the interpreter runs, as lowered, and on the IR a native build compiles, after the fold and before leaf
// inlining, so the two run one form. Its operations hold no call, so a loop the call let compile may need more registers
// than the target has once it is expanded: the backend then tests the function's source form, the IR it had before
// (opt.sourceOf), and spills the expanded loop where the source form's fits (inline.maxon).

// Expander is the state of the expansion, kept from one function to the next so that its arrays keep their capacity: how
// many times each register is read, the operands of one operation, an empty list with the room of the last function's
// instructions, which the next function's are written into, and the call each trap block makes.
export type Expander
	var reads as Array with Count
	var operands as ir.RegList
	var held as ir.InstrList
	var traps as ir.InstrList
	// The spans of f's instructions and of traps, of a function that keeps them: what an instruction expands to has its span.
	var spans as ir.SpanList
	var trapSpans as ir.SpanList
	// pending is whether the address of an element waits for the instruction after it in its block, which may read it
	// (expandOne): the address that the old instruction pendingAt, a call of the entry pendingSymbol whose arguments start
	// at pendingArgs, gives to pendingDst.
	var pending as bool
	var pendingAt as Count
	var pendingSymbol as ir.Rt
	var pendingArgs as Count
	var pendingDst as ir.Reg

	export static function new() returns Expander
		return Expander{reads: Array.create(0), operands: ir.RegList.create(0), held: ir.InstrList.create(0), traps: ir.InstrList.create(0), spans: ir.SpanList.create(0), trapSpans: ir.SpanList.create(0), pending: false, pendingAt: 0, pendingSymbol: ir.Rt.rtArrayElem, pendingArgs: 0, pendingDst: ir.noReg}
	end 'new'

	// expandFunction expands the calls of f and of the bodies of its closures and behaviours, and says whether there was one.
	export function expandFunction(mutates self, mutates f ir.IrFunction) returns bool
		var changed = false
		for i in 0 upto f.bodies.count() 'bodies'
			if self.expandFunction(f.bodies[i]) 'body'
				changed = true
			end 'body'
		end 'bodies'
		if not hasExpandable(f) 'none'
			return changed
		end 'none'
		self.countReads(f)
		// The instructions are moved out of f and drained, each written anew into the room of the list held, and nothing
		// between can fail, so f is never left without its instructions.
		var old = exchange(f.instrs, value: exchange(held, value: ir.InstrList.create(0)))
		f.instrs.reserve(old.count())
		traps.clear()
		spans.clear()
		trapSpans.clear()
		let own = f.blocks.count()
		var walk = ir.BlockWalk.start(f)
		var k = 0 as Count
		for x in old.drain() 'instrs'
			if walk.endsAt(f, k: k) 'blockEnds'
				self.flush(f)
			end 'blockEnds'
			walk.reach(f, k: k, written: f.instrs.count())
			if self.expandOne(f, x: x, k: k, last: walk.endsAt(f, k: plusOne(k)), own: own) 'kept'
				f.instrs.push(x)
				self.spanned(f, k: k)
			end 'kept'
			k = plusOne(k)
		end 'instrs'
		self.flush(f)
		walk.finish(f, k: k, written: f.instrs.count())
		held = old
		for t in 0 upto traps.count() 'traps'
			let first = f.instrs.count()
			f.instrs.push(traps[t].clone())
			if f.keepsSpans 'span'
				spans.push(trapSpans[t])
			end 'span'
			f.blocks.push(ir.Block.make(first, endAt: f.instrs.count(), params: f.blockParams.count(), paramCount: 0, term: ir.newTrap()))
		end 'traps'
		ir.takeSpans(f, laid: spans)
		return true
	end 'expandFunction'

	// spanned gives what instruction k of f expanded to, and the trap it made, the span of k, when f keeps spans.
	function spanned(mutates self, f ir.IrFunction, k Count)
		if not f.keepsSpans 'none'
			return
		end 'none'
		while spans.count() < f.instrs.count() 'out'
			spans.push(f.spans[k])
		end 'out'
		while trapSpans.count() < traps.count() 'traps'
			trapSpans.push(f.spans[k])
		end 'traps'
	end 'spanned'

	// expandOne writes x, the old instruction k, expanded where it is a call the expansion replaces, and says whether x is
	// to be written as it is, which the caller does, moving it, since a value held in place that a call consumes is a copy.
	// The address of an element that only the instruction after it may read waits for that instruction (pending), unless x
	// is the last of its block: a load of the address right after it is the element read itself. own is how many blocks f
	// has before the trap blocks.
	function expandOne(mutates self, mutates f ir.IrFunction, x ir.Instr, k Count, last bool, own Count) returns bool
		if pending 'waiting'
			let at = pendingAt
			let read = self.fuse(f, next: x)
			self.spanned(f, k: at)
			if read 'fused'
				return false
			end 'fused'
		end 'waiting'
		if not expandable(x) 'kept'
			return true
		end 'kept'
		let symbol = ir.callRuntimeSymbol(x)
		let start = ir.callRuntimeArgsStart(x)
		let src = f.args[start]
		let of = collectionOf(symbol)
		if readsLength(symbol) 'length'
			f.instrs.push(ir.newLength(x.dst, src: src, of: of))
			self.spanned(f, k: k)
			return false
		end 'length'
		let index = f.args[plusOne(start)]
		if not ir.callRuntimeProven(x) 'check'
			let length = f.newReg(ir.IrKind.kindScalar)
			f.instrs.push(ir.newLength(length, src: src, of: of))
			let fail = ir.blockOf(try own + traps.count() otherwise panic("opt: a function with more blocks than memory"))
			traps.push(ir.newCallRuntime(ir.noReg, symbol: symbol, argsStart: x.a, argsCount: x.b, routine: ir.noRoutine, proven: false))
			f.instrs.push(ir.newBounds(index, length: length, fail: fail))
		end 'check'
		if symbol != ir.Rt.rtArrayElem and symbol != ir.Rt.rtStrsElem and symbol != ir.Rt.rtBytesElem 'byte'
			f.instrs.push(ir.newLoadByte(x.dst, src: src, index: index, of: of))
			self.spanned(f, k: k)
			return false
		end 'byte'
		self.spanned(f, k: k)
		if not last and reads[regIndex(x.dst)] == 1 'wait'
			pending = true
			pendingAt = k
			pendingSymbol = symbol
			pendingArgs = start
			pendingDst = x.dst
			return false
		end 'wait'
		f.instrs.push(elementAddress(f, symbol: symbol, start: start, dst: x.dst))
		self.spanned(f, k: k)
		return false
	end 'expandOne'

	// fuse writes the address of an element that waits, read by next where next is the load of it, and says whether it was.
	function fuse(mutates self, mutates f ir.IrFunction, next ir.Instr) returns bool
		pending = false
		let symbol = pendingSymbol
		let src = f.args[pendingArgs]
		let index = f.args[plusOne(pendingArgs)]
		if symbol == ir.Rt.rtBytesElem and next.op == ir.Opcode.opLoadByteAt and ir.loadByteAtAddr(next) == pendingDst 'readByte'
			f.instrs.push(ir.newLoadByte(next.dst, src: src, index: index, of: collectionOf(symbol)))
			return true
		end 'readByte'
		if symbol != ir.Rt.rtBytesElem and next.op == ir.Opcode.opLoadAt and ir.loadAtAddr(next) == pendingDst 'read'
			f.instrs.push(ir.newElemLoad(next.dst, arr: src, index: index, shift: elementShift(symbol), filled: ir.loadAtFilled(next)))
			return true
		end 'read'
		f.instrs.push(elementAddress(f, symbol: symbol, start: pendingArgs, dst: pendingDst))
		return false
	end 'fuse'

	// flush writes the address of an element that waits for an instruction its block does not have.
	function flush(mutates self, mutates f ir.IrFunction)
		if not pending 'none'
			return
		end 'none'
		pending = false
		f.instrs.push(elementAddress(f, symbol: pendingSymbol, start: pendingArgs, dst: pendingDst))
		let at = pendingAt
		self.spanned(f, k: at)
	end 'flush'

	// countReads counts how many times each register of f is read, by its instructions and its terminators.
	function countReads(mutates self, f ir.IrFunction)
		reads.clear()
		for _ in 0 upto f.regs.count() 'regs'
			reads.push(0)
		end 'regs'
		for b in 0 upto f.blocks.count() 'blocks'
			for k in f.blocks[b].first upto f.blocks[b].endAt 'instrs'
				operands.clear()
				ir.instrReads(f, x: f.instrs[k], out: operands)
				self.countOperands()
			end 'instrs'
			operands.clear()
			ir.termReads(f, t: f.blocks[b].term, out: operands)
			self.countOperands()
		end 'blocks'
	end 'countReads'

	function countOperands(mutates self)
		for i in 0 upto operands.count() 'operands'
			let r = regIndex(operands[i])
			reads[r] = plusOne(reads[r])
		end 'operands'
	end 'countOperands'
end 'Expander'

// elementAddress is the address of the element that a call of the entry symbol, whose arguments start at start, reads into
// dst.
function elementAddress(f ir.IrFunction, symbol ir.Rt, start Count, dst ir.Reg) returns ir.Instr
	return ir.newElemAddr(dst, arr: f.args[start], index: f.args[plusOne(start)], shift: elementShift(symbol))
end 'elementAddress'

// expandModule expands the functions of a module that the interpreter runs as they were lowered.
export function expandModule(mutates fns ir.IrFunctionList)
	var expander = Expander.new()
	for i in 0 upto fns.count() 'functions'
		_ = expander.expandFunction(fns[i])
	end 'functions'
end 'expandModule'

// hasExpandable is whether f has a call that the expansion replaces, not counting the bodies it holds.
function hasExpandable(f ir.IrFunction) returns bool
	for k in 0 upto f.instrs.count() 'instrs'
		if expandable(f.instrs[k]) 'found'
			return true
		end 'found'
	end 'instrs'
	return false
end 'hasExpandable'

// expandable is whether x is a call that the expansion replaces: of an entry that reads a length, or an element whose value
// the call gives. A call whose value nothing reads, as a trap block's, stays.
function expandable(x ir.Instr) returns bool
	if x.op != ir.Opcode.opCallRuntime or x.dst == ir.noReg 'other'
		return false
	end 'other'
	let symbol = ir.callRuntimeSymbol(x)
	return readsLength(symbol) or readsElement(symbol)
end 'expandable'

function readsLength(symbol ir.Rt) returns bool
	return symbol == ir.Rt.rtArrayLen or symbol == ir.Rt.rtBytesLen or symbol == ir.Rt.rtStrLen
end 'readsLength'

function readsElement(symbol ir.Rt) returns bool
	return symbol == ir.Rt.rtArrayElem or symbol == ir.Rt.rtStrsElem or symbol == ir.Rt.rtBytesElem or symbol == ir.Rt.rtBytesGet or symbol == ir.Rt.rtStrByteAt
end 'readsElement'

// elementShift is how far the index of an element that an entry addresses is shifted to its offset in the buffer.
function elementShift(symbol ir.Rt) returns Count
	if symbol == ir.Rt.rtArrayElem 'word'
		return ir.wordElementShift
	end 'word'
	if symbol == ir.Rt.rtStrsElem 'string'
		return ir.stringElementShift
	end 'string'
	if symbol == ir.Rt.rtBytesElem 'byte'
		return ir.byteElementShift
	end 'byte'
	panic("opt: {ir.rtSymbol(symbol)} addresses no element the expansion knows")
end 'elementShift'

// collectionOf is the box an entry that the expansion replaces reads: an array's or a byte array's, or a string's.
function collectionOf(symbol ir.Rt) returns ir.Collection
	if symbol == ir.Rt.rtArrayLen or symbol == ir.Rt.rtBytesLen or symbol == ir.Rt.rtArrayElem or symbol == ir.Rt.rtStrsElem or symbol == ir.Rt.rtBytesElem or symbol == ir.Rt.rtBytesGet 'array'
		return ir.Collection.collectionArray
	end 'array'
	if symbol == ir.Rt.rtStrLen or symbol == ir.Rt.rtStrByteAt 'string'
		return ir.Collection.collectionString
	end 'string'
	panic("opt: {ir.rtSymbol(symbol)} reads no collection the expansion knows")
end 'collectionOf'
