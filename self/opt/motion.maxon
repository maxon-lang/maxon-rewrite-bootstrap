// What the passes that merge and move instructions (cse.maxon, licm.maxon, rotate.maxon) may do with each operation of the
// IR, decided in one place, motionOf, which names every operation so that a new one fails the build here until it is
// classified. The IR table's effects say what an operation touches; this says what follows from that for moving it.
//
// Memory, and what can change it under a read. A read is merged with an earlier one, or moved out of a loop, only where
// nothing between can have written what it reads. The IR keeps no types and no calling conventions, so the rule is about
// operations, not about which box a register holds:
//
// - A store, a move out of a place, a drop of a place (dropslot, dropat), an atomic operation and a frame box write
//   memory, and any of them may write what a read reads: an address can point into any box or slot.
// - A call of any kind (a function, a closure, a witness, an import, a runtime entry) may write through every address it
//   is given and every box its arguments reach. A `mutates` or `sets` argument is the address of the caller's place, a
//   push, an insert or a remove is a runtime call that changes the length and may move the buffer of the array it is
//   given, and the IR does not say which argument is which. So every call ends every read: a push to one array ends the
//   reads of every other array too, since two registers may hold one box (two reads of one borrowed place give the same
//   box, and a `let` parameter may be the box that a `mutates` parameter's place holds). A call of a runtime entry that
//   only reads (ir.onlyReads), such as the comparison of two strings, is quiet instead.
// - A drop of a register, an allocation, a copy, a box, a closure and a function value write only boxes that no other
//   live register reaches: unique ownership gives a dropped value's boxes to the value alone (a borrow of it has ended
//   before it is dropped), and a new box is new. They end no read.
// - A read of what another thread may write (a global of the runtime, a raw word, the thread's context) is never merged
//   or moved, since a loop that waits on such a word would then wait forever.
//
// One write is narrower: a store through the address of an element (storesElement) writes inside an array's buffer,
// where a bounds check proved the index, and an element is a word or a String. So it changes no word outside the elements
// of arrays, and a read that reads none (readsBeyondElements) keeps its value across it: the length and the buffer of an
// array, which are words of its box, a slot, and a word at an address that is no element's. Such an address is a slot's,
// or a value the function was given or read from memory, which is a box (a buffer's address is a word of its array's box
// that only Buffer reads), or a place a `mutates` or `sets` parameter lends. That place may be an element of the caller's
// array, but no argument may overlap it (E3186), so no element the function writes is it: an array that holds it is
// reached only through the place's own owner. So in `a[i] = a[i] + x` the array's box, length and buffer are read once,
// and a loop that writes only elements keeps the reads of its arrays' boxes, lengths and buffers out of it.
//
// Faults. An operation that goes to a failure block (a guard, a bounds check, checked arithmetic) or that the hardware
// stops on (an unchecked division or remainder, which a guard before it makes safe) runs only where it ran: it is merged
// with an earlier identical one, which already passed, and moved only to a point where it ran first anyway.

// Motion is what may be done with an operation.
export enum Motion
	// constant gives a value from what it names alone (a number, a string, a datum, an address the link or the frame
	// places). It is never merged or moved: writing it again costs less than a register held across a loop, and the backend
	// reads a constant operand as an immediate. A reader that leaves a loop takes a copy of it along.
	constant
	// pure gives a value from its operands alone, and cannot fail or fault.
	pure
	// divides is pure but faults on a divisor of 0, which a guard before it rules out.
	divides
	// check goes to its failure block on its operands alone, and may give a value.
	check
	// read gives what memory holds, which only the function's own stores and calls change.
	read
	// sharedRead gives what memory holds that another thread may write.
	sharedRead
	// quiet has an effect, but changes nothing that a read of the function sees.
	quiet
	// clobber may change what any read sees.
	clobber
end 'Motion'

// motionOf is what may be done with the instruction x.
export function motionOf(x ir.Instr) returns Motion
	return match x.op 'op'
		opNone gives panic("opt: an instruction with no operation")
		opConst or
		opStr or
		opDatum or
		opSlotAddr or
		opGlobalAddr or
		opCodeAddress gives Motion.constant
		opBodyAddress gives Motion.constant
		opLoadParam or
		opFieldAddr or
		opCmp or
		opFBin or
		opFCmp or
		opFUnary or
		opIntToFloat or
		opFloatToInt or
		opNot or
		opStrPtr or
		opStrBytes or
		opStrWord or
		opStrMake or
		opElemAddrAt or
		opTrailingZeros or
		opVecZero or
		opVecFromWords or
		opVecWord or
		opVecBin or
		opVecShift or
		opVecShuffleDwords or
		opVecAlignBytes or
		opVecBlendWords or
		opVecAes or
		opVecAesInvMix or
		opVecAesArm or
		opVecAesMix or
		opVecClmul or
		opVecSha or
		opCpuid gives Motion.pure
		opBin gives binMotion(x)
		opLength gives lengthMotion(x)
		opNeg gives Motion.check if ir.instrCanFail(x) else Motion.pure
		opGuard or
		opBounds gives Motion.check
		opLoadSlot or
		opLoadField or
		opLoadAt or
		opLoadByteAt or
		opElemAddr or
		opElemLoad or
		opLoadByte or
		opLoadWord or
		opVecLoad or
		opBuffer or
		opElemAt or
		opByteAt gives Motion.read
		opLoadGlobal or
		opLoadRaw or
		opThreadContext gives Motion.sharedRead
		opAlloc or
		opClosure or
		opFuncValue or
		opBox or
		opIsType or
		opDrop or
		opCopy gives Motion.quiet
		opCallRuntime gives Motion.quiet if ir.onlyReads(ir.callRuntimeSymbol(x)) else Motion.clobber
		opStoreSlot or
		opStoreField or
		opStoreAt or
		opStoreByteAt or
		opStoreRaw or
		opVecStore or
		opLoadAcquire or
		opStoreRelease or
		opCallImport or
		opSyscall or
		opAtomicAdd or
		opAtomicExchange or
		opCompareExchange or
		opSpinPause or
		opCallCode or
		opCallHost or
		opCall or
		opWhen or
		opAsync or
		opCallValue or
		opFrameBox or
		opFrameArea or
		opCallWitness or
		opDropSlot or
		opDropAt or
		opMoveSlot or
		opMoveAt gives Motion.clobber
	end 'op'
end 'motionOf'

// lengthMotion is a read for an array's length, which a push changes, and pure for a String's, which its word holds.
function lengthMotion(x ir.Instr) returns Motion
	return match ir.lengthOf(x) 'of'
		collectionArray gives Motion.read
		collectionString gives Motion.pure
	end 'of'
end 'lengthMotion'

function binMotion(x ir.Instr) returns Motion
	if ir.instrCanFail(x) 'checked'
		return Motion.check
	end 'checked'
	let op = ir.binOp(x)
	if op == ir.BinOp.binDiv or op == ir.BinOp.binMod 'faults'
		return Motion.divides
	end 'faults'
	return Motion.pure
end 'binMotion'

// storesElement is whether x, a clobber of f, writes only an element of an array: a store through the address of an
// element. defs is where f defines each register.
export function storesElement(f ir.IrFunction, defs ir.Defs, x ir.Instr) returns bool
	var addr = ir.noReg
	if x.op == ir.Opcode.opStoreAt 'word'
		addr = ir.storeAtAddr(x)
	end 'word' else if x.op == ir.Opcode.opStoreByteAt 'byte'
		addr = ir.storeByteAtAddr(x)
	end 'byte' else 'other'
		return false
	end 'other'
	let op = definingOp(f, defs: defs, r: addr)
	return op == ir.Opcode.opElemAddr or op == ir.Opcode.opElemAddrAt
end 'storesElement'

// readsBeyondElements is whether x, a read of f, reads no element of an array, so that no store of an element changes
// what it gives (see the top of this file). defs is where f defines each register.
export function readsBeyondElements(f ir.IrFunction, defs ir.Defs, x ir.Instr) returns bool
	let op = x.op
	if op == ir.Opcode.opLength or op == ir.Opcode.opBuffer or op == ir.Opcode.opElemAddr or op == ir.Opcode.opLoadSlot 'box'
		return true
	end 'box'
	if op == ir.Opcode.opLoadAt 'at'
		return outsideElements(f, defs: defs, r: ir.loadAtAddr(x))
	end 'at'
	if op == ir.Opcode.opLoadField 'field'
		return outsideElements(f, defs: defs, r: ir.loadFieldObj(x))
	end 'field'
	// A vector is loaded from any address the runtime's source computes, an array's buffer among them.
	if op == ir.Opcode.opElemLoad or op == ir.Opcode.opElemAt or op == ir.Opcode.opLoadByte or op == ir.Opcode.opLoadWord or op == ir.Opcode.opByteAt or op == ir.Opcode.opLoadByteAt or op == ir.Opcode.opVecLoad 'element'
		return false
	end 'element'
	panic("opt: readsBeyondElements of {ir.opcodeName(op)}, which is no read")
end 'readsBeyondElements'

// outsideElements is whether the address r of f is never inside the elements of an array that f writes: a slot's, a
// parameter (a box, or a place that no other argument overlaps), or a value read from memory, which is a box.
function outsideElements(f ir.IrFunction, defs ir.Defs, r ir.Reg) returns bool
	let op = definingOp(f, defs: defs, r: r)
	return op == ir.Opcode.opLoadParam or op == ir.Opcode.opSlotAddr or op == ir.Opcode.opLoadSlot or op == ir.Opcode.opLoadAt or op == ir.Opcode.opLoadField or op == ir.Opcode.opElemLoad or op == ir.Opcode.opElemAt or op == ir.Opcode.opAlloc
end 'outsideElements'

// definingOp is the operation of the instruction of f that defines r, or opNone for a block parameter.
function definingOp(f ir.IrFunction, defs ir.Defs, r ir.Reg) returns ir.Opcode
	let at = defs.instr[regIndex(r)]
	if at == ir.noDef 'param'
		return ir.Opcode.opNone
	end 'param'
	return f.instrs[at as Count].op
end 'definingOp'

// keyed is whether an instruction of the motion m is merged with an earlier identical one: what it gives, or whether it
// passes, depends on its operands alone, and on memory for a read.
export function keyed(m Motion) returns bool
	return m == Motion.pure or m == Motion.divides or m == Motion.check or m == Motion.read
end 'keyed'
