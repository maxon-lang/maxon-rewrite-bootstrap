function block(index Count) returns ir.BlockID
	return try index as ir.BlockID otherwise panic("too many blocks")
end 'block'

typealias ConvList = Array with ast.Convention

function interpFunction(mutates p ast.Project, name String, convs ConvList) returns ast.FuncID
	var tree = thaw(p.modules[0].tree)
	let node = tree.alloc(ast.NodeKind.funcDecl, start: 0 as diag.U32)
	p.modules[0].tree = freeze(tree)
	var entry = ast.FuncEntry.make(name.clone(), visibility: "export", module: 0 as diag.ModuleID, nodeID: node)
	for i in 0 upto convs.count() 'params'
		entry.params.push(ast.ParamSpec.make("p{i}", ty: p.builtins.countTy, conv: convs[i]))
		entry.paramTypes.push(p.builtins.countTy)
	end 'params'
	return ast.makeFunc(p, module: 0 as diag.ModuleID, f: entry)
end 'interpFunction'

function convs0() returns ConvList
	return ConvList.create(0)
end 'convs0'

// irProject is a project of one module that has a function with a body of one statement's worth of nodes, which the
// functions of the tests are declared in.
function irProject() returns ast.Project
	var p = ast.Project.new("")
	_ = ast.addModule(p, m: ast.Module.new(0 as diag.ModuleID, path: "", text: "", files: ast.FileSpanList.create(0)))
	p.rootModule = 0 as diag.ModuleID
	return p
end 'irProject'

// BpFn builds the function main of a project with ir.Builder.
type BpFn
	var b as ir.Builder
	var decl as ast.FuncID

	static function new(mutates p ast.Project) returns BpFn
		let decl = interpFunction(p, name: "main", convs: convs0())
		var b = ir.Builder.new()
		b.start(decl, name: "", paramCount: 0 as Count)
		return BpFn{b: b, decl: decl}
	end 'new'

	function block(mutates self) returns ir.BlockID
		return b.newBlock()
	end 'block'

	function param(mutates self, block ir.BlockID) returns ir.Reg
		return b.blockParam(block, kind: ir.IrKind.kindScalar)
	end 'param'

	function konst(mutates self, block ir.BlockID, value ir.Word) returns ir.Reg
		let r = b.f.newReg(ir.IrKind.kindScalar)
		b.emit(block, i: ir.newConst(r, value: value))
		return r
	end 'konst'

	function bin(mutates self, block ir.BlockID, op ir.BinOp, left ir.Reg, right ir.Reg, fail ir.BlockID) returns ir.Reg
		let r = b.f.newReg(ir.IrKind.kindScalar)
		b.emit(block, i: ir.newBin(r, op: op, left: left, right: right, unsigned: false, fail: fail))
		return r
	end 'bin'

	function cmp(mutates self, block ir.BlockID, op ir.CmpOp, left ir.Reg, right ir.Reg) returns ir.Reg
		let r = b.f.newReg(ir.IrKind.kindScalar)
		b.emit(block, i: ir.newCmp(r, op: op, left: left, right: right, unsigned: false))
		return r
	end 'cmp'
end 'BpFn'
