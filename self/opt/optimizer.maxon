// The optimizer's passes in the order a native build runs them, in two parts on either side of the fallback of a function
// that may loop (fallbackOf), the IR it has between them, which the backend compiles where it refuses a hot loop of the
// optimized IR (E5001). A pass before the fallback never makes an instruction hold more values at once than the code it
// replaces, so the fallback needs no more registers than the program as written; a pass after it may, so a loop that
// would compile without it always compiles.
//
// Before the fallback, on each function (optimizeFunction): SSA construction, then the fold pass with the rules of
// generic.rules.
// After it, on the module (inline.maxon): the expansion of the primitives (expand.maxon), whose operations hold no call
// that values were in memory across; the fold again with the rules of pressure.rules, on each function that holds an
// instruction they rewrite (a division by a constant, whose multiply holds x beside the high word); leaf inlining, which
// folds again each function that got a copy; then on each function loop rotation (rotate.maxon), loop-invariant code
// motion (licm.maxon), which finds a preheader on the guard that rotation leaves, and common subexpression elimination
// (cse.maxon), which merges what moved out of a loop with what was computed before it.

// Optimizer is the state of the passes, kept from one function to the next.
export type Optimizer
	export var ssa as Ssa
	export var fold as Fold
	export var expander as Expander
	export var inliner as Inliner
	export var rotator as Rotator
	export var licm as Licm
	export var cse as Cse
	// The analyses the passes after inlining share: each pass that changes a function has them found again.
	var analysis as Analysis
	var facts as LoopFacts

	export static function new() returns Optimizer
		return Optimizer{ssa: Ssa.new(), fold: Fold.new(), expander: Expander.new(), inliner: Inliner.new(), rotator: Rotator.new(), licm: Licm.new(), cse: Cse.new(), analysis: Analysis.new(), facts: LoopFacts.new()}
	end 'new'
end 'Optimizer'

// optimizeModule runs the optimizer on the functions of a module that the backend compiles.
export function optimizeModule(mutates o Optimizer, mutates fns ir.IrFunctionList)
	for i in 0 upto fns.count() 'each'
		optimizeFunction(o, f: fns[i])
	end 'each'
end 'optimizeModule'

// optimizeFunction runs the passes before the fallback on f.
function optimizeFunction(mutates o Optimizer, mutates f ir.IrFunction)
	o.ssa.construct(f)
	o.fold.foldFunction(f, raises: false)
end 'optimizeFunction'

// fallbackOf is the fallback of the function at place at of fns, a module's functions as lowerModule lowered them and the
// optimizer then changed: the function lowered again from its declaration and taken through the passes before the
// fallback, which give the same IR each time, so no function keeps a copy that its emit may never ask for. A function that
// may hold no loop has none, and has no hot loop to refuse.
export function fallbackOf(p ast.Project, mutates ms ast.ModuleState, fns ir.IrFunctionList, at Count) returns table.Option with ir.IrFunction
	var instances = ir.instancesOf(p, ms: ms, fns: fns)
	var f = ir.lowerFunction(p, ms: ms, fn: fns[at].decl, instances: instances)
	var o = Optimizer.new()
	optimizeFunction(o, f: f)
	if not mayLoop(f) 'straight'
		return table.Option.none
	end 'straight'
	return table.Option.some(f)
end 'fallbackOf'

// refine runs the passes that come after leaf inlining on f and the bodies of its closures and behaviours. A function
// with a refusal is never compiled, so it is left as it is.
function refine(mutates o Optimizer, mutates f ir.IrFunction)
	if f.refusals.count() > 0 'refused'
		return
	end 'refused'
	for i in 0 upto f.bodies.count() 'bodies'
		refine(o, f: f.bodies[i])
	end 'bodies'
	if f.blocks.count() == 0 'empty'
		return
	end 'empty'
	o.analysis.dominators(f)
	o.facts.find(f, flow: o.analysis.flow)
	if o.analysis.flow.retreatFrom.count() > 0 'loops'
		if o.rotator.rotate(f, analysis: o.analysis, facts: o.facts) 'rotated'
			o.analysis.dominators(f)
			o.facts.find(f, flow: o.analysis.flow)
		end 'rotated'
		if o.licm.hoist(f, analysis: o.analysis, facts: o.facts) 'hoisted'
			o.analysis.dominators(f)
			o.facts.find(f, flow: o.analysis.flow)
		end 'hoisted'
	end 'loops'
	o.cse.eliminate(f, analysis: o.analysis, facts: o.facts)
end 'refine'
