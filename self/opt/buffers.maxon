// The split of a native build's element accesses: an element read, the address of an element and a byte of a byte array
// each read the address of the array's elements from its box before they reach the element, and each becomes that read
// (Buffer) and the access at the index of the address it gives (ElemAt, ElemAddrAt, ByteAt, and a word's LoadRaw at the\n// address plus the index). The address is then a value
// as any read gives: common subexpression elimination reads it once for the accesses of the array that no write outside
// the elements of arrays separates (motion.maxon), as in `a[i] = a[i] + x`, and loop-invariant code motion moves it out
// of a loop that changes no array's box. The interpreter runs the accesses whole, as the expansion makes them.
//
// The cost is one pass over the instructions of a function that accesses an element, each moved once.

export type BufferSplit
	// held is, between functions, an empty list that keeps the room of the instructions of the last function split, which
	// the next function's are written into, so that no list grows anew. spans are the spans of a function that keeps them.
	var held as ir.InstrList
	var spans as ir.SpanList

	export static function new() returns BufferSplit
		return BufferSplit{held: ir.InstrList.create(0), spans: ir.SpanList.create(0)}
	end 'new'

	// split splits the element accesses of f, and says whether it had one. Its instructions are held while the walk writes
	// f's anew, and nothing between can fail or read f's instructions, so f is never left without them.
	export function split(mutates self, mutates f ir.IrFunction) returns bool
		if not accessesElement(f) 'none'
			return false
		end 'none'
		var old = exchange(f.instrs, value: exchange(held, value: ir.InstrList.create(0)))
		f.instrs.reserve(old.count())
		spans.clear()
		var walk = ir.BlockWalk.start(f)
		var k = 0 as Count
		for x in old.drain() 'instrs'
			walk.reach(f, k: k, written: f.instrs.count())
			if not splitInto(f, x: x) 'kept'
				f.instrs.push(x)
			end 'kept'
			if f.keepsSpans 'spans'
				while spans.count() < f.instrs.count() 'span'
					spans.push(f.spans[k])
				end 'span'
			end 'spans'
			k = try k + 1 otherwise panic("opt: more instructions than a count holds")
		end 'instrs'
		walk.finish(f, k: k, written: f.instrs.count())
		held = old
		ir.takeSpans(f, laid: spans)
		return true
	end 'split'
end 'BufferSplit'

// splitInto writes the instruction x after f's instructions, split, where it is an element access, and says whether it
// was; the caller writes any other instruction as it is, moved there, since a value held in place that a call consumes is
// a copy.
function splitInto(mutates f ir.IrFunction, x ir.Instr) returns bool
	let op = x.op
	let dst = x.dst
	let src = x.a
	let index = x.b
	if op == ir.Opcode.opElemLoad 'read'
		let shift = ir.elemLoadShift(x)
		let data = buffer(f, src: src)
		f.instrs.push(ir.newElemAt(dst, data: data, index: index, shift: shift))
	end 'read' else if op == ir.Opcode.opElemAddr 'address'
		let shift = ir.elemAddrShift(x)
		let data = buffer(f, src: src)
		f.instrs.push(ir.newElemAddrAt(dst, data: data, index: index, shift: shift))
	end 'address' else if splitsByte(x) 'byte'
		let data = buffer(f, src: src)
		f.instrs.push(ir.newByteAt(dst, data: data, index: index))
	end 'byte' else if op == ir.Opcode.opLoadWord 'word'
		let data = buffer(f, src: src)
		let at = f.newReg(ir.IrKind.kindScalar)
		f.instrs.push(ir.newBin(at, op: ir.BinOp.binAdd, left: data, right: index, unsigned: true, fail: ir.noBlock))
		f.instrs.push(ir.newLoadRaw(dst, addr: at, width: ir.loadWordWidth(x)))
	end 'word' else if splitsStringByte(x) 'string'
		let data = f.newReg(ir.IrKind.kindScalar)
		let box = f.newFrameBox()
		f.instrs.push(ir.newStrBytes(data, src: src, box: box))
		f.instrs.push(ir.newByteAt(dst, data: data, index: index))
	end 'string' else 'other'
		return false
	end 'other'
	return true
end 'splitInto'

// buffer writes the read of the buffer of the array src after f's instructions and gives the register it reads into.
function buffer(mutates f ir.IrFunction, src ir.Reg) returns ir.Reg
	let data = f.newReg(ir.IrKind.kindScalar)
	f.instrs.push(ir.newBuffer(data, src: src))
	return data
end 'buffer'

// accessesElement is whether f has an element access that the split splits.
function accessesElement(f ir.IrFunction) returns bool
	for k in 0 upto f.instrs.count() 'instrs'
		let op = f.instrs[k].op
		if op == ir.Opcode.opElemLoad or op == ir.Opcode.opElemAddr or op == ir.Opcode.opLoadWord or splitsByte(f.instrs[k]) or splitsStringByte(f.instrs[k]) 'found'
			return true
		end 'found'
	end 'instrs'
	return false
end 'accessesElement'

// splitsStringByte is whether x reads a byte of a String. It becomes the address of the String's bytes (strbytes: its
// first word, or a frame box its words are written to where it holds its bytes in them) and the byte at the index of it,
// so that the test of which a String is, and the address, are a pure value that leaves a loop that holds the String: the
// loop then reads a byte at an address, as it does of a byte array.
function splitsStringByte(x ir.Instr) returns bool
	return x.op == ir.Opcode.opLoadByte and ir.loadByteOf(x) == ir.Collection.collectionString
end 'splitsStringByte'

// splitsByte is whether x reads a byte of a byte array, whose buffer is a word of its box.
function splitsByte(x ir.Instr) returns bool
	return x.op == ir.Opcode.opLoadByte and ir.loadByteOf(x) == ir.Collection.collectionArray
end 'splitsByte'
