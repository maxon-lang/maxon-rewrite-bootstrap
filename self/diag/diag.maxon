export typealias ModuleID = int(-1 to 2147483647)

export typealias U32 = int(0 to 4294967295)

export let stdlibID = -1 as ModuleID

export type Site
	export var module as ModuleID
	export var offset as U32

	export static function make(module ModuleID, offset U32) returns Site
		return Site{module: module, offset: offset}
	end 'make'
end 'Site'

// FixEdit is one edit of a fix: the text of a module from begin until until becomes text, an insertion when the two are
// equal. Locating the error places it in its file too, which is what a tool that applies it edits.
export type FixEdit
	export var module as ModuleID
	export var begin as U32
	export var until as U32
	export var text as String
	export var file as String
	export var fileBegin as Count
	export var fileUntil as Count

	export static function make(module ModuleID, begin U32, until U32, consumes text String) returns FixEdit
		return FixEdit{module: module, begin: begin, until: until, text: text, file: "", fileBegin: 0 as Count, fileUntil: 0 as Count}
	end 'make'

	export static function insert(module ModuleID, at U32, consumes text String) returns FixEdit
		return FixEdit{module: module, begin: at, until: at, text: text, file: "", fileBegin: 0 as Count, fileUntil: 0 as Count}
	end 'insert'
end 'FixEdit'

export typealias FixEdits = Array with FixEdit

// Fix is the change that a diagnostic's message names, as edits of the source that are made together, and the kind of
// change it is, which a summary counts by. A diagnostic whose message names no single change has none.
export type Fix
	export var kind as String
	export var edits as FixEdits

	export static function none() returns Fix
		return Fix{kind: "", edits: FixEdits.create(0)}
	end 'none'

	export static function make(consumes kind String, consumes edits FixEdits) returns Fix
		return Fix{kind: kind, edits: edits}
	end 'make'

	export function isSome() returns bool
		return edits.count() > 0
	end 'isSome'
end 'Fix'

// ErrorCause is the reason of an error that a tool acts on, where its code covers several: a code alone is not enough to tell them apart.
export enum ErrorCause
	none
	loopHoldsCollection
end 'ErrorCause'

export type CompileError
	export var code as String
	export var message as String
	export var file as String
	export var line as Count
	export var col as Count
	export var site as Site
	export var located as bool
	// placed is whether the message has a place in the source: an error about the program as a whole, that it has no 'main', has none.
	export var placed as bool
	// consequence is an error that only follows from another one, such as the use of a name whose declaration was refused: it stops the
	// stage that met it, as an error does, and is never shown.
	export var consequence as bool
	// unqualified is a bare name that the error did not find, when the message goes on to name the other modules that declare it.
	export var unqualified as String
	// unqualifiedAt is where that name is written, which the error's site may not be: the site of a cast's unknown type is its 'as'.
	export var unqualifiedAt as U32
	export var fix as Fix
	export var cause as ErrorCause

	export static function at(consumes code String, consumes message String, consumes file String, line Count, col Count) returns CompileError
		return CompileError{code: code, message: message, file: file, line: line, col: col, site: Site.make(0 as ModuleID, offset: 0 as U32), located: true, placed: true, consequence: false, unqualified: "", unqualifiedAt: 0 as U32, fix: Fix.none(), cause: ErrorCause.none}
	end 'at'

	export static function atSite(consumes code String, consumes message String, consumes site Site) returns CompileError
		return CompileError{code: code, message: message, file: "", line: 0 as Count, col: 0 as Count, site: site, located: false, placed: true, consequence: false, unqualified: "", unqualifiedAt: 0 as U32, fix: Fix.none(), cause: ErrorCause.none}
	end 'atSite'

	export static function unplaced(consumes code String, consumes message String) returns CompileError
		return CompileError{code: code, message: message, file: "", line: 0 as Count, col: 0 as Count, site: Site.make(0 as ModuleID, offset: 0 as U32), located: true, placed: false, consequence: false, unqualified: "", unqualifiedAt: 0 as U32, fix: Fix.none(), cause: ErrorCause.none}
	end 'unplaced'

	export function format() returns String
		if not placed 'unplaced'
			return "error {code}: {message}"
		end 'unplaced'
		if located 'loc'
			return "error {code}: {file}:{line}:{col}: {message}"
		end 'loc'
		return "error {code}: module {site.module} offset {site.offset}: {message}"
	end 'format'
end 'CompileError'

export typealias ErrorList = Array with CompileError

export function stringLess(a String, b String) returns bool
	let an = a.byteLength()
	let bn = b.byteLength()
	var lim = an
	if bn < lim 'bmin'
		lim = bn
	end 'bmin'
	for i in 0 upto lim 'cmp'
		let ca = a.byteAt(i)
		let cb = b.byteAt(i)
		if ca != cb 'diff'
			return ca < cb
		end 'diff'
	end 'cmp'
	return an < bn
end 'stringLess'

export function pushSiteError(mutates errs ErrorList, consumes code String, consumes message String, module ModuleID, offset U32)
	errs.push(CompileError.atSite(code, message: message, site: Site.make(module, offset: offset)))
end 'pushSiteError'

// pushUnqualifiedError reports a name that was not found, which another module may declare.
export function pushUnqualifiedError(mutates errs ErrorList, consumes code String, consumes message String, module ModuleID, offset U32, consumes name String)
	var e = CompileError.atSite(code, message: message, site: Site.make(module, offset: offset))
	e.unqualified = name
	e.unqualifiedAt = offset
	errs.push(e)
end 'pushUnqualifiedError'

// pushFixedError is pushSiteError for an error whose message names a change that fixes it.
export function pushFixedError(mutates errs ErrorList, consumes code String, consumes message String, module ModuleID, offset U32, consumes fix Fix)
	var e = CompileError.atSite(code, message: message, site: Site.make(module, offset: offset))
	e.fix = fix
	errs.push(e)
end 'pushFixedError'

export function pushConsequence(mutates errs ErrorList, consumes code String, consumes message String, module ModuleID, offset U32)
	var e = CompileError.atSite(code, message: message, site: Site.make(module, offset: offset))
	e.consequence = true
	errs.push(e)
end 'pushConsequence'

export function pushUnplacedError(mutates errs ErrorList, consumes code String, consumes message String)
	errs.push(CompileError.unplaced(code, message: message))
end 'pushUnplacedError'

export function pushLocatedError(mutates errs ErrorList, consumes code String, consumes message String, consumes file String, line Count, col Count)
	errs.push(CompileError.at(code, message: message, file: file, line: line, col: col))
end 'pushLocatedError'

function errorBefore(a CompileError, b CompileError) returns bool
	if a.located and b.located 'bothLoc'
		if a.file != b.file 'fileCmp'
			return stringLess(a.file, b: b.file)
		end 'fileCmp'
		if a.line != b.line 'lineCmp'
			return a.line < b.line
		end 'lineCmp'
		if a.col != b.col 'colCmp'
			return a.col < b.col
		end 'colCmp'
	end 'bothLoc' else if a.located != b.located 'oneLoc'
		return a.located
	end 'oneLoc' else 'siteCmp'
		if a.site.module != b.site.module 'modCmp'
			return a.site.module < b.site.module
		end 'modCmp'
		if a.site.offset != b.site.offset 'offCmp'
			return a.site.offset < b.site.offset
		end 'offCmp'
	end 'siteCmp'
	if a.code != b.code 'codeCmp'
		return stringLess(a.code, b: b.code)
	end 'codeCmp'
	return stringLess(a.message, b: b.message)
end 'errorBefore'

export function sortErrors(mutates errs ErrorList)
	let n = errs.count()
	for i in 1 upto n 'ins'
		var j = i
		while j > 0 'shift'
			let prev = try j - 1 otherwise 0 as Count
			if errorBefore(errs[j], b: errs[prev]) 'swap'
				let cur = errs[j].clone()
				errs[j] = errs[prev].clone()
				errs[prev] = cur
				j = prev
			end 'swap' else 'done'
				break 'shift'
			end 'done'
		end 'shift'
	end 'ins'
end 'sortErrors'
