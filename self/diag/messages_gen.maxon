// The text of errUnexpectedToken for: Unknown annotation '@{got}' (expected '@heap')
export function unknownAnnotation(got String) returns String
	return "Unknown annotation '@{got}' (expected '@heap')"
end 'unknownAnnotation'

// The text of errUnexpectedToken for: @heap must be followed by 'var' or 'let'
export function heapAnnotationWithoutBinding() returns String
	return "@heap must be followed by 'var' or 'let'"
