	return "the initializer of '{name}' calls '{callee}': a module-level or static `let` initializer calls nothing, so write a literal, or build the value where it is used"
end 'moduleLetCallsFunction'

// The text of errAssignToImmutable for: '{name}' is a let field and cannot be reassigned
export function letFieldReassigned(name String) returns String
	return "'{name}' is a let field and cannot be reassigned"
end 'letFieldReassigned'

// The text of errConformance for: Partial interface implementation: type '{typeName}' is missing {count} method(s):
export function missingMethods(typeName String, count String) returns String
	return "Partial interface implementation: type '{typeName}' is missing {count} method(s):"
end 'missingMethods'

// The text of errConformance for: Partial interface implementation: type '{typeName}' has {count} method(s) with wrong signature:
export function wrongSignatureMethods(typeName String, count String) returns String
	return "Partial interface implementation: type '{typeName}' has {count} method(s) with wrong signature:"
end 'wrongSignatureMethods'

// The text of errBoundBindingDisagrees for: '{baseName}' constrains type parameter '{param}' to '{claimed}', but '{argName}' binds '{interfaceName}'s associated type '{associated}' to '{supplied}' — a `where` constraint's binding is what types every dispatch through that parameter inside the shared body, which is compiled ONCE, so a conformer binding it otherwise would have its bits read as the claimed type. Bind the constraint to what the conformer declares, or supply an argument whose conformance binds what the constraint states
export function boundBindingDisagrees(baseName String, param String, claimed String, argName String, interfaceName String, associated String, supplied String) returns String
	return "'{baseName}' constrains type parameter '{param}' to '{claimed}', but '{argName}' binds '{interfaceName}'s associated type '{associated}' to '{supplied}' — a `where` constraint's binding is what types every dispatch through that parameter inside the shared body, which is compiled ONCE, so a conformer binding it otherwise would have its bits read as the claimed type. Bind the constraint to what the conformer declares, or supply an argument whose conformance binds what the constraint states"
end 'boundBindingDisagrees'

// The text of errResolutionCycle for: typealias '{aliasName}' forms a type cycle: the alias it implements refers back to '{aliasName}'
export function aliasCycle(aliasName String) returns String
	return "typealias '{aliasName}' forms a type cycle: the alias it implements refers back to '{aliasName}'"
end 'aliasCycle'

// The text of errExpectedType for: '{parentName}' is not a ranged typealias: a typealias implements one declared over `int(low to high)` or `float(low to high)`
export function notARangedAlias(parentName String) returns String
	return "'{parentName}' is not a ranged typealias: a typealias implements one declared over `int(low to high)` or `float(low to high)`"
end 'notARangedAlias'

// The text of errAliasRangeDoesNotFit for: typealias '{aliasName}' does not fit the alias it implements: its range is not inside the range of '{parentName}'
export function implementsRangeDoesNotFit(aliasName String, parentName String) returns String
	return "typealias '{aliasName}' does not fit the alias it implements: its range is not inside the range of '{parentName}'"
end 'implementsRangeDoesNotFit'

// The text of errAliasRangeDoesNotFit for: typealias '{aliasName}' does not fit the alias it implements: it is {own} and '{parentName}' is {parents}
export function implementsPrimitiveDiffers(aliasName String, own String, parentName String, parents String) returns String
	return "typealias '{aliasName}' does not fit the alias it implements: it is {own} and '{parentName}' is {parents}"
end 'implementsPrimitiveDiffers'

// The text of errStaticRequirementNotDispatchable for: '{requirement}' is a `static` requirement, and a `static` member has no receiver to dispatch on — so {reacher} cannot reach it. Call a `static` member on a concrete type
export function staticRequirementNotDispatchable(requirement String, reacher String) returns String
	return "'{requirement}' is a `static` requirement, and a `static` member has no receiver to dispatch on — so {reacher} cannot reach it. Call a `static` member on a concrete type"
end 'staticRequirementNotDispatchable'

// The text of errMethodAsFunctionValue for: '{requirement}' is a requirement of '{interfaceName}', and a requirement is not a function value: it is reached on a concrete type that implements '{interfaceName}'
export function requirementAsFunctionValue(requirement String, interfaceName String) returns String
	return "'{requirement}' is a requirement of '{interfaceName}', and a requirement is not a function value: it is reached on a concrete type that implements '{interfaceName}'"
end 'requirementAsFunctionValue'

// The text of errConformance for: Type '{typeName}' does not define required associated type '{associated}' from interface '{interfaceName}'
export function unboundAssociatedType(typeName String, associated String, interfaceName String) returns String
	return "Type '{typeName}' does not define required associated type '{associated}' from interface '{interfaceName}'"
end 'unboundAssociatedType'

// The text of errUnknownFunction for: call to undefined function '{name}': the '__' prefix names a compiler intrinsic, and no intrinsic of that name exists
export function undefinedReservedFunction(name String) returns String
	return "call to undefined function '{name}': the '__' prefix names a compiler intrinsic, and no intrinsic of that name exists"
end 'undefinedReservedFunction'

// The text of errTypeMismatch for: Type '{typeName}' does not conform to {interfaceName}
export function typeDoesNotConform(typeName String, interfaceName String) returns String
	return "Type '{typeName}' does not conform to {interfaceName}"
end 'typeDoesNotConform'

// The text of errFunctionValueThrows for: Cannot use throwing function '{name}' as a value: it throws '{errorType}', and a function type cannot express 'throws'. Wrap the call in a non-throwing function that handles the error with 'try'.
export function throwingFunctionAsValue(name String, errorType String) returns String
	return "Cannot use throwing function '{name}' as a value: it throws '{errorType}', and a function type cannot express 'throws'. Wrap the call in a non-throwing function that handles the error with 'try'."
end 'throwingFunctionAsValue'

// The text of errUnsupportedFeature for: Unsupported: a destructuring binding of {names} names against a tuple of {elements} elements (every element must be named)
export function destructureArity(names String, elements String) returns String
	return "Unsupported: a destructuring binding of {names} names against a tuple of {elements} elements (every element must be named)"
end 'destructureArity'

// The text of errUnsupportedFeature for: Unsupported: a destructuring binding of a '{valueType}' initializer (only a TUPLE can be destructured — `let (x, y) = …` needs a right-hand side that is a tuple)
export function destructureNonTuple(valueType String) returns String
	return "Unsupported: a destructuring binding of a '{valueType}' initializer (only a TUPLE can be destructured — `let (x, y) = …` needs a right-hand side that is a tuple)"
end 'destructureNonTuple'

// The text of errTypeMismatch for: Tuple has {elements} elements but destructuring has {names} bindings
export function tupleAssignArity(elements String, names String) returns String
	return "Tuple has {elements} elements but destructuring has {names} bindings"
end 'tupleAssignArity'

