// The text of errMethodAsFunctionValue for: '{spelled}' is a method, and a method is not a function value: wrap the call in a closure, such as 'function(...) gives {spelled}(...)'
export function methodAsFunctionValue(spelled String) returns String
	return "'{spelled}' is a method, and a method is not a function value: wrap the call in a closure, such as 'function(...) gives {spelled}(...)'"
end 'methodAsFunctionValue'

// The text of errMethodAsFunctionValue for: '{spelled}' is an instance method, and a method is not a function value: call it on a value, or wrap that call in a closure, such as 'function(value) gives value.{method}(...)'
export function instanceMethodAsFunctionValue(spelled String, method String) returns String
	return "'{spelled}' is an instance method, and a method is not a function value: call it on a value, or wrap that call in a closure, such as 'function(value) gives value.{method}(...)'"
end 'instanceMethodAsFunctionValue'

// The text of errDuplicateTypeAlias for: Duplicate typealias '{name}'
export function duplicateAlias(name String) returns String
	return "Duplicate typealias '{name}'"
end 'duplicateAlias'

// The text of errTypeMismatch for: a generic body is compiled ONCE, against the declaration view, so a type parameter is an opaque machine word here and nothing has fixed what it points at — this is refused even where every 'with' in the program binds it to that very type. Declare the place at the type parameter too, or make the call from a concrete instantiation, where the type argument is known
export function opaqueTypeParameterReason() returns String
	return "a generic body is compiled ONCE, against the declaration view, so a type parameter is an opaque machine word here and nothing has fixed what it points at — this is refused even where every 'with' in the program binds it to that very type. Declare the place at the type parameter too, or make the call from a concrete instantiation, where the type argument is known"
end 'opaqueTypeParameterReason'

// The text of errTypeMismatch for: argument type mismatch for {label}: expected '{expected}', got 'type parameter': {reason}
export function argTypeMismatchOpaque(label String, expected String, reason String) returns String
	return "argument type mismatch for {label}: expected '{expected}', got 'type parameter': {reason}"
end 'argTypeMismatchOpaque'

// The text of errMatchTypeMismatch for: pattern type '{pattern}' does not match scrutinee type '{scrutinee}'
export function patternTypeMismatch(pattern String, scrutinee String) returns String
	return "pattern type '{pattern}' does not match scrutinee type '{scrutinee}'"
end 'patternTypeMismatch'

// The text of errNonConstantInitializer for: Function calls are not allowed in global variable initializers; '{callee}()' is not a constant expression
export function constantCallNotConstant(callee String) returns String
	return "Function calls are not allowed in global variable initializers; '{callee}()' is not a constant expression"
