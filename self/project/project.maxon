typealias BoolStrMap = table.StringMap with bool

typealias DiscDirList = Array with DiscoveredDir

type DiscoveredDir
	export var modPath as String
	export var dir as String
	export var filePaths as ast.StringList
	// projectFiles are the project files the directory holds, which mark it as the root of a project.
	export var projectFiles as ast.StringList
	export var subNames as ast.StringList
	export var children as CountList

	static function make(consumes modPath String, consumes dir String) returns DiscoveredDir
		return DiscoveredDir{modPath: modPath, dir: dir, filePaths: ast.StringList.create(0), projectFiles: ast.StringList.create(0), subNames: ast.StringList.create(0), children: CountList.create(0)}
	end 'make'
end 'DiscoveredDir'

export function endsWithMaxon(name String) returns bool
	let sn = 6 as Count
	let n = name.byteLength()
	if n <= sn 'short'
		return false
	end 'short'
	let start = n - sn
	return name.sliceBytes(start, endPos: n) == ".maxon"
end 'endsWithMaxon'

// endsWithText is whether text ends with suffix.
export function endsWithText(text String, suffix String) returns bool
	let length = text.byteLength()
	let tail = suffix.byteLength()
	return length >= tail and text.sliceBytes(try length - tail otherwise 0 as Count, endPos: length) == suffix
end 'endsWithText'

// endsWithMaxtest is whether a file name ends in `.maxtest`, the extension of the files that hold tests.
export function endsWithMaxtest(name String) returns bool
	return endsWithText(name, suffix: ".maxtest")
end 'endsWithMaxtest'

export function sortStrings(mutates xs ast.StringList)
	let n = xs.count()
	for i in 1 upto n 'ins'
		var j = i
		while j > 0 'shift'
			let prev = try j - 1 otherwise 0 as Count
			if diag.stringLess(xs[j], b: xs[prev]) 'swap'
				let cur = xs[j].clone()
				xs[j] = xs[prev].clone()
				xs[prev] = cur
				j = prev
			end 'swap' else 'done'
				break 'shift'
			end 'done'
		end 'shift'
	end 'ins'
end 'sortStrings'

function trimTrailingSlash(p String) returns String
	var endPos = p.byteLength()
	while endPos > 0 'trim'
		let lastIdx = try endPos - 1 otherwise 0 as Count
		let ch = p.byteAt(lastIdx)
		if ch != 47 and ch != 92 'stop'
			break 'trim'
		end 'stop'
		if endPos == 3 and p.byteAt(1 as Count) == 58 'driveRoot'
			break 'trim'
		end 'driveRoot'
		endPos = lastIdx
	end 'trim'
	return p.sliceBytes(0 as Count, endPos: endPos)
end 'trimTrailingSlash'

export function joinPath(dir String, name String) returns String
	let clean = trimTrailingSlash(dir)
	if clean == "" or clean == "." 'cur'
		if clean == "." 'dot'
			return ".\\{name}"
		end 'dot'
		return name.clone()
	end 'cur'
	let cn = clean.byteLength()
	if cn > 0 'chkLast'
		let last = clean.byteAt(try cn - 1 otherwise 0 as Count)
		if last == 47 or last == 92 'hasSep'
			return "{clean}{name}"
		end 'hasSep'
	end 'chkLast'
	return "{clean}\\{name}"
end 'joinPath'

function parentDir(path String) returns String
	var i = path.byteLength()
	while i > 0 'back'
		let prev = try i - 1 otherwise 0 as Count
		let ch = path.byteAt(prev)
		if ch == 47 or ch == 92 'sep'
			if prev == 0 'rootSlash'
				return path.sliceBytes(0 as Count, endPos: 1 as Count)
			end 'rootSlash'
			return path.sliceBytes(0 as Count, endPos: prev)
		end 'sep'
		i = prev
	end 'back'
	return "."
end 'parentDir'

function isQualifier(name String) returns bool
	if name == "" or ast.isReserved(name) 'res'
		return false
	end 'res'
	let n = name.byteLength()
	for i in 0 upto n 'ch'
		let c = name.byteAt(i)
		let isAlpha = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
		let isDigit = c >= 48 and c <= 57
		if not isAlpha and not (i > 0 and isDigit) 'bad'
			return false
		end 'bad'
	end 'ch'
	return true
end 'isQualifier'

function isReservedTopLevel(name String) returns bool
	return name == ast.rootQualifier or name == ast.stdlibQualifier or name == ast.runtimeQualifier or name == "scriptlib"
end 'isReservedTopLevel'

// projectFileExtension ends the name of the file that marks the root of a project, as maxon's does.
let projectFileExtension = ".maxproj"

// ignoreMarkerName is the name of the file that keeps a directory, and what is below it, out of the program that discovers it.
let ignoreMarkerName = ".maxonignore"

// runtimeDirName is the directory of the runtime's source (README, "The runtime").
let runtimeDirName = "runtime"

let slashByte = 47 as Byte

let backslashByte = 92 as Byte

let colonByte = 58 as Byte

let dotByte = 46 as Byte

// runtimeDirectory is the runtime's source as maxon finds its library tiers: the runtime directory of the nearest
// directory, from the compiler's executable's upward, that has one. A compiler built in a checkout finds the checkout's, and
// an installed one the one installed beside it.
export function runtimeDirectory() returns table.Option with String
	return nearestDirectory(runtimeDirName)
end 'runtimeDirectory'

// nearestDirectory is the directory called name of the nearest directory, from the compiler's executable's upward, that has
// one.
export function nearestDirectory(name String) returns table.Option with String
	let exe = try Process.executablePath() otherwise return table.Option.none
	var dir = parentDir(exe.toString())
	while true 'up'
		let candidate = joinPath(dir, name: name)
		if isDirectoryPath(candidate) 'found'
			return table.Option.some(candidate)
		end 'found'
		let parent = parentDir(dir)
		if parent == dir or parent == "." 'top'
			return table.Option.none
		end 'top'
		dir = parent
	end 'up'
	return table.Option.none
end 'nearestDirectory'

// isRuntimeDirectory is whether a project's directory is the runtime's source, which is then checked as the runtime: it
// may call the __Raw intrinsics, and it is a library with no main.
export function isRuntimeDirectory(path String) returns bool
	return match consumes runtimeDirectory() 'found'
		some(dir) gives sameText(absolutePath(path), b: absolutePath(dir))
		none gives false
	end 'found'
end 'isRuntimeDirectory'

function isSeparator(c Byte) returns bool
	return c == slashByte or c == backslashByte
end 'isSeparator'

// isAbsolutePath is whether a path names its drive or starts at a root, so that it does not depend on the working
// directory.
function isAbsolutePath(path String) returns bool
	let n = path.byteLength()
	if n >= 2 and path.byteAt(1) == colonByte 'drive'
		return true
	end 'drive'
	return n >= 1 and isSeparator(path.byteAt(0))
end 'isAbsolutePath'

// absolutePath is a path from the working directory's, with the native separator, without '.' and '..' and without a
// trailing separator, as Go's filepath.Abs gives it.
export function absolutePath(path String) returns String
	var full = path.clone()
	if not isAbsolutePath(path) 'relative'
		full = joinPath(Directory.currentPath().toString(), name: path)
	end 'relative'
	var parts = ast.StringList.create(0)
	var start = 0 as Count
	let n = full.byteLength()
	for i in 0 upto n 'scan'
		if isSeparator(full.byteAt(i)) 'cut'
			addPathPart(parts, part: full.sliceBytes(start, endPos: i))
			start = i + 1
		end 'cut'
	end 'scan'
	addPathPart(parts, part: full.sliceBytes(start, endPos: n))
	var out = ByteArray.create(0)
	for i in 0 upto parts.count() 'join'
		if i > 0 'separator'
			out.push(backslashByte)
		end 'separator'
		out.append(parts[i].toByteArray())
	end 'join'
	return String.from(out)
end 'absolutePath'

// addPathPart adds what lies between two separators to the parts of a path: '..' goes back one, below the drive only, and
// '.' and an empty part go nowhere, except the empty one before the first separator of a path that starts at a root.
function addPathPart(mutates parts ast.StringList, consumes part String)
	if part == ".." 'back'
		if parts.count() > 1 'below'
			_ = try parts.pop() otherwise ""
		end 'below'
		return
	end 'back'
	if part != "." and (part != "" or parts.count() == 0) 'keep'
		parts.push(part)
	end 'keep'
end 'addPathPart'

// sameText is whether two paths are the same with ASCII letters compared without their case, as Windows compares them.
function sameText(a String, b String) returns bool
	if a.byteLength() != b.byteLength() 'length'
		return false
	end 'length'
	for i in 0 upto a.byteLength() 'each'
		if foldCase(a.byteAt(i)) != foldCase(b.byteAt(i)) 'differs'
			return false
		end 'differs'
	end 'each'
	return true
end 'sameText'

let upperA = 65 as Byte

let upperZ = 90 as Byte

let caseOffset = 32 as Byte

function foldCase(c Byte) returns Byte
	if c >= upperA and c <= upperZ 'upper'
		return try c + caseOffset otherwise c
	end 'upper'
	return c
end 'foldCase'

typealias FilePathList = Array with FilePath

// isDirectoryPath is whether text names a directory; a text that is no path names none.
export function isDirectoryPath(text String) returns bool
	let path = try FilePath.from(text) otherwise return false
	return Directory.isDirectory(path)
end 'isDirectoryPath'

// readTextFile is the text of the file that text names, or none when it names no file that can be read.
export function readTextFile(text String) returns table.Option with String
	let path = try FilePath.from(text) otherwise return table.Option.none
	let content = try File.readText(path) otherwise return table.Option.none
	return table.Option.some(content)
end 'readTextFile'

// lastComponent is what follows the last separator of a path that Directory.list gave: the entry's name.
export function lastComponent(path String) returns String
	var at = path.byteLength()
	while at > 0 'back'
		let before = try at - 1 otherwise 0
		if path.byteAt(before) == 92 'separator'
			break 'back'
		end 'separator'
		at = before
	end 'back'
	return path.sliceBytes(at, endPos: path.byteLength())
end 'lastComponent'

// listDirectory sorts what a directory holds into the paths of its source files, the paths of its project files and the names
// of the directories that may be modules, each in order. It is whether the directory holds an ignore marker.
function listDirectory(dir String, memory SourceFiles, mutates files ast.StringList, mutates projectFiles ast.StringList, mutates dirs ast.StringList) returns bool
	if memory.count() > 0 'inMemory'
		return listMemory(dir, memory: memory, files: files, dirs: dirs)
	end 'inMemory'
	var ignored = false
	let dirPath = try FilePath.from(dir) otherwise return false
	let listed = try Directory.list(dirPath) otherwise FilePathList.create(0)
	for i in 0 upto listed.count() 'split'
		let name = lastComponent(listed[i].toString())
		let full = joinPath(dir, name: name)
		if isDirectoryPath(full) 'd'
			let startsDot = name.byteLength() > 0 and name.byteAt(0 as Count) == dotByte
			if not startsDot and name != "bin" and name != "obj" 'keepDir'
				dirs.push(name)
			end 'keepDir'
		end 'd' else if endsWithMaxon(name) 'f'
			files.push(full)
		end 'f' else if endsWithText(name, suffix: projectFileExtension) 'p'
			projectFiles.push(full)
		end 'p' else if name == ignoreMarkerName 'i'
			ignored = true
		end 'i'
	end 'split'
	sortStrings(files)
	sortStrings(projectFiles)
	sortStrings(dirs)
	return ignored
end 'listDirectory'

// SourceFile is a file of a program that is held in memory, named by the path it would have.
export type SourceFile
	export var path as String
	export var text as String

	export static function make(consumes path String, consumes text String) returns SourceFile
		return SourceFile{path: path, text: text}
	end 'make'
end 'SourceFile'

export typealias SourceFiles = Array with SourceFile

// belowDirectory is whether a path begins with a directory's path and a separator, so that it is below the directory.
function belowDirectory(path String, dir String) returns bool
	let n = dir.byteLength()
	if path.byteLength() <= n or path.byteAt(n) != backslashByte 'short'
		return false
	end 'short'
	return path.sliceBytes(0, endPos: n) == dir
end 'belowDirectory'

// listMemory is listDirectory for the files that are held in memory, which a program names itself, and so a file of
// tests too: the paths of the source files in dir, and the names of
// the directories below it that hold a file, each in order. It is whether dir holds an ignore marker. A project held in
// memory is the one project, so it has no project files.
function listMemory(dir String, memory SourceFiles, mutates files ast.StringList, mutates dirs ast.StringList) returns bool
	var ignored = false
	for i in 0 upto memory.count() 'each'
		let path = memory[i].path.clone()
		if parentDir(path) == dir 'file'
			if endsWithMaxon(path) or endsWithMaxtest(path) 'source'
				files.push(path)
			end 'source' else if lastComponent(path) == ignoreMarkerName 'marker'
				ignored = true
			end 'marker'
		end 'file' else if belowDirectory(path, dir: dir) 'below'
			let rest = path.sliceBytes(try dir.byteLength() + 1 otherwise panic("project: a path longer than memory"), endPos: path.byteLength())
			var cut = 0 as Count
			while rest.byteAt(cut) != backslashByte 'name'
				cut = try cut + 1 otherwise panic("project: a path longer than memory")
			end 'name'
			let name = rest.sliceBytes(0, endPos: cut)
			if not containsString(dirs, text: name) 'new'
				dirs.push(name)
			end 'new'
		end 'below'
	end 'each'
	sortStrings(files)
	sortStrings(dirs)
	return ignored
end 'listMemory'

function containsString(list ast.StringList, text String) returns bool
	for i in 0 upto list.count() 'each'
		if list[i] == text 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'containsString'

// memoryText is the text of the file at path when it is held in memory.
function memoryText(memory SourceFiles, path String) returns table.Option with String
	for i in 0 upto memory.count() 'each'
		if memory[i].path == path 'found'
			return table.Option.some(memory[i].text.clone())
		end 'found'
	end 'each'
	return table.Option.none
end 'memoryText'

function scanDirectory(mutates nodes DiscDirList, consumes dir String, consumes modPath String, isRoot bool, memory SourceFiles, mutates errs diag.ErrorList) returns table.Option with Count
	if memory.count() == 0 and not isDirectoryPath(dir) 'missing'
		return table.Option.none
	end 'missing'
	var rawFiles = ast.StringList.create(0)
	var rawProjects = ast.StringList.create(0)
	var rawDirs = ast.StringList.create(0)
	let ignored = listDirectory(dir, memory: memory, files: rawFiles, projectFiles: rawProjects, dirs: rawDirs)
	if ignored and not isRoot 'ignored'
		return table.Option.none
	end 'ignored'
	let myIdx = nodes.count()
	nodes.push(DiscoveredDir.make(modPath.clone(), dir: dir.clone()))
	nodes[myIdx].filePaths = rawFiles
	nodes[myIdx].projectFiles = rawProjects
	var childNames = ast.StringList.create(0)
	var childIdxs = CountList.create(0)
	for i in 0 upto rawDirs.count() 'eachSub'
		let subName = rawDirs[i].clone()
		var childModPath = subName.clone()
		if modPath != "" 'sub'
			childModPath = "{modPath}.{subName}"
		end 'sub'
		let childDir = joinPath(dir, name: subName)
		match scanDirectory(nodes, dir: childDir.clone(), modPath: childModPath, isRoot: false, memory: memory, errs: errs) 'res'
			some(childIdx) then checkChildQualifier(isRoot, subName: subName, childDir: childDir, childIdx: childIdx, childNames: childNames, childIdxs: childIdxs, errs: errs)
			none then _ = 0
		end 'res'
	end 'eachSub'
	let emptyMod = (not isRoot) and nodes[myIdx].filePaths.count() == 0 and childIdxs.count() == 0
	nodes[myIdx].subNames = childNames
	nodes[myIdx].children = childIdxs
	if emptyMod 'skip'
		return table.Option.none
	end 'skip'
	return table.Option.some(myIdx)
end 'scanDirectory'

function checkChildQualifier(isRoot bool, consumes subName String, consumes childDir String, childIdx Count, mutates childNames ast.StringList, mutates childIdxs CountList, mutates errs diag.ErrorList)
	if (not isQualifier(subName)) or (isRoot and isReservedTopLevel(subName)) 'bad'
		diag.pushLocatedError(errs, code: diag.errBadModuleName, message: "the directory '{subName}' cannot be written as a qualifier; rename it to an identifier that is not reserved", file: childDir, line: 1 as Count, col: 1 as Count)
		return
	end 'bad'
	childNames.push(subName)
	childIdxs.push(childIdx)
end 'checkChildQualifier'

// projectFileIn is the project file that the directory holds, the first by name when it holds several, or none.
function projectFileIn(dir String) returns table.Option with String
	let dirPath = try FilePath.from(dir) otherwise return table.Option.none
	let listed = try Directory.list(dirPath) otherwise return table.Option.none
	var found = false
	var first = ""
	for i in 0 upto listed.count() 'each'
		let name = lastComponent(listed[i].toString())
		let full = joinPath(dir, name: name)
		if endsWithText(name, suffix: projectFileExtension) and not isDirectoryPath(full) and (not found or diag.stringLess(full, b: first)) 'earlier'
			first = full
			found = true
		end 'earlier'
	end 'each'
	if found 'some'
		return table.Option.some(first)
	end 'some'
	return table.Option.none
end 'projectFileIn'

// enclosingDirectory is the directory that holds the absolute path dir, or none for the root of a drive.
function enclosingDirectory(dir String) returns table.Option with String
	var parent = parentDir(dir)
	if isDriveName(parent) 'drive'
		parent = "{parent}\\"
	end 'drive'
	if parent == "." or parent == dir 'top'
		return table.Option.none
	end 'top'
	return table.Option.some(parent)
end 'enclosingDirectory'

// isDriveName is whether a path is a drive's name alone, without the separator that makes it the drive's root.
function isDriveName(path String) returns bool
	return path.byteLength() == 2 and path.byteAt(1 as Count) == colonByte
end 'isDriveName'

// nearestProjectFile is the project file of the nearest directory, from the absolute path dir upward, that holds one.
function nearestProjectFile(dir String) returns table.Option with String
	var at = dir.clone()
	while true 'up'
		match consumes projectFileIn(at) 'here'
			some(file) then return table.Option.some(file)
			none then _ = 0
		end 'here'
		match consumes enclosingDirectory(at) 'above'
			some(parent) then at = parent.clone()
			none then return table.Option.none
		end 'above'
	end 'up'
	return table.Option.none
end 'nearestProjectFile'

// pushNestedProject reports the project file nested, which lies below the project of the project file outer.
function pushNestedProject(mutates errs diag.ErrorList, consumes nested String, outer String)
	diag.pushLocatedError(errs, code: diag.errNestedProjectFile, message: diag.nestedProjectFile(lastComponent(nested), outer: outer), file: nested, line: 1 as Count, col: 1 as Count)
end 'pushNestedProject'

// reportEnclosed reports the project file nested when the directory above, or one above it, holds another project file.
function reportEnclosed(nested String, above String, mutates errs diag.ErrorList) returns bool
	match consumes nearestProjectFile(above) 'outer'
		some(outer) then pushNestedProject(errs, nested: nested.clone(), outer: outer)
		none then return false
	end 'outer'
	return true
end 'reportEnclosed'

// reportNestedBelow reports the project file nested when the directory above the one that holds it, or one above that, holds
// another project file.
function reportNestedBelow(nested String, dir String, mutates errs diag.ErrorList) returns bool
	match consumes enclosingDirectory(absolutePath(dir)) 'above'
		some(above) then return reportEnclosed(nested, above: above, errs: errs)
		none then return false
	end 'above'
end 'reportNestedBelow'

// reportNestedProject reports the first directory of the walk, in order and the root first, that holds a project file below
// the project of another project file: projects do not nest, whichever of the two is built.
function reportNestedProject(nodes DiscDirList, mutates errs diag.ErrorList)
	for i in 0 upto nodes.count() 'each'
		if nodes[i].projectFiles.count() > 0 and reportNestedBelow(nodes[i].projectFiles[0], dir: nodes[i].dir, errs: errs) 'reported'
			return
		end 'reported'
	end 'each'
end 'reportNestedProject'

function collectModuleTree(nodes DiscDirList, nodeIdx Count, mutates p ast.Project) returns diag.ModuleID
	var m = ast.Module.new(0 as diag.ModuleID, path: nodes[nodeIdx].modPath.clone(), text: "", files: ast.FileSpanList.create(0))
	m.dir = nodes[nodeIdx].dir.clone()
	for i in 0 upto nodes[nodeIdx].filePaths.count() 'fp'
		m.filePaths.push(nodes[nodeIdx].filePaths[i].clone())
	end 'fp'
	let mid = ast.addModule(p, m: m)
	for i in 0 upto nodes[nodeIdx].children.count() 'ch'
		let subIdx = nodes[nodeIdx].children[i]
		let subName = nodes[nodeIdx].subNames[i].clone()
		let childMid = collectModuleTree(nodes, nodeIdx: subIdx, p: p)
		let mIdx = ast.modIndex(mid)
		p.modules[mIdx].childNames.push(subName)
		p.modules[mIdx].childIDs.push(childMid)
	end 'ch'
	return mid
end 'collectModuleTree'

function allocShellTypeParams(mutates p ast.Project, modID diag.ModuleID, tid ast.TypeID, tps ast.TypeParamList, mutates errs diag.ErrorList)
	var seen = BoolStrMap.new()
	let mIdx = ast.modIndex(modID)
	for i in 0 upto tps.count() 'each'
		let tpName = tps[i].name.clone()
		let tpNode = tps[i].id
		if seen.has(tpName) 'dup'
			let off = p.modules[mIdx].tree.records[tpNode as Count].start
			diag.pushSiteError(errs, code: diag.errDuplicateDefinition, message: "'{tpName}' is already declared as a type parameter", module: modID, offset: off)
			continue 'each'
		end 'dup'
		seen.insert(tpName.clone(), value: true)
		let tpEntry = ast.TypeEntry.make(ast.TypeKind.typeParam, name: tpName)
		let tpTid = ast.allocType(p.types, e: tpEntry)
		p.types.entries[tid as Count].typeParams.push(tpTid)
	end 'each'
end 'allocShellTypeParams'

function createShellType(mutates p ast.Project, modID diag.ModuleID, ord ast.DeclOrdinal, mutates errs diag.ErrorList)
	let ref = ast.DeclRef.make(modID, ordinal: ord)
	let d = ast.moduleDecl(p, ref: ref)
	match d 'k'
		typeDecl(td) then allocRecordShell(p, ref: ref, td: td, errs: errs)
		enumDecl(ed) then allocEnumShell(p, ref: ref, ed: ed)
		unionDecl(ud) then allocUnionShell(p, ref: ref, ud: ud, errs: errs)
		interfaceDecl(ifd) then allocIfaceShell(p, ref: ref, ifd: ifd, errs: errs)
		extensionDecl(_) then _ = 0
		aliasDecl(ad) then ast.declareRangeAlias(p, ref: ref, ad: ad, errs: errs)
		funcDecl(_) then _ = 0
		constDecl(_) then _ = 0
	end 'k'
end 'createShellType'

function allocRecordShell(mutates p ast.Project, ref ast.DeclRef, td ast.TypeDecl, mutates errs diag.ErrorList)
	var e = ast.TypeEntry.make(ast.TypeKind.record, name: td.name.clone())
	e.hasDecl = true
	e.decl = ref.clone()
	e.isNoncopyable = td.isNoncopyable
	let tid = ast.allocType(p.types, e: e)
	allocShellTypeParams(p, modID: ref.module, tid: tid, tps: td.typeParams, errs: errs)
	p.declTypes.insert(ast.declKey(ref), value: tid)
end 'allocRecordShell'

function allocEnumShell(mutates p ast.Project, ref ast.DeclRef, ed ast.EnumDecl)
	var e = ast.TypeEntry.make(ast.TypeKind.enumTy, name: ed.name.clone())
	e.hasDecl = true
	e.decl = ref.clone()
	let tid = ast.allocType(p.types, e: e)
	p.declTypes.insert(ast.declKey(ref), value: tid)
end 'allocEnumShell'

function allocUnionShell(mutates p ast.Project, ref ast.DeclRef, ud ast.UnionDecl, mutates errs diag.ErrorList)
	var e = ast.TypeEntry.make(ast.TypeKind.unionTy, name: ud.name.clone())
	e.hasDecl = true
	e.decl = ref.clone()
	e.isNoncopyable = ud.isNoncopyable
	let tid = ast.allocType(p.types, e: e)
	allocShellTypeParams(p, modID: ref.module, tid: tid, tps: ud.typeParams, errs: errs)
	p.declTypes.insert(ast.declKey(ref), value: tid)
end 'allocUnionShell'

function allocIfaceShell(mutates p ast.Project, ref ast.DeclRef, ifd ast.InterfaceDecl, mutates errs diag.ErrorList)
	var e = ast.TypeEntry.make(ast.TypeKind.interfaceTy, name: ifd.name.clone())
	e.hasDecl = true
	e.decl = ref.clone()
	let tid = ast.allocType(p.types, e: e)
	allocShellTypeParams(p, modID: ref.module, tid: tid, tps: ifd.typeParams, errs: errs)
	p.declTypes.insert(ast.declKey(ref), value: tid)
end 'allocIfaceShell'

function buildModuleTable(mutates p ast.Project, modID diag.ModuleID, mutates errs diag.ErrorList)
	let mIdx = ast.modIndex(modID)
	let count = p.modules[mIdx].decls.count()
	for i in 0 upto count 'each'
		let ord = try i as ast.DeclOrdinal otherwise panic("too many decls")
		createShellType(p, modID: modID, ord: ord, errs: errs)
		let dName = p.modules[mIdx].decls[i].name()
		let dOff = p.modules[mIdx].decls[i].offset(p.modules[mIdx].tree)
		match p.modules[mIdx].indexDecl(ord) 'dup'
			some(prevOrd) then pushDuplicateDecl(p.modules[mIdx], dName: dName, dOff: dOff, ord: ord, prevOrd: prevOrd, modID: modID, errs: errs)
			none then _ = 0
		end 'dup'
	end 'each'
end 'buildModuleTable'

function pushDuplicateDecl(m ast.Module, consumes dName String, dOff diag.U32, ord ast.DeclOrdinal, prevOrd ast.DeclOrdinal, modID diag.ModuleID, mutates errs diag.ErrorList)
	let testName = m.decls[ord as Count].testName()
	if testName != "" 'tests'
		// Two tests that compile to one symbol are two names that differ only where a character is no letter, digit or underscore.
		let at = try ((dOff as Count) + ast.testKeywordLength) as diag.U32 otherwise dOff
		diag.pushSiteError(errs, code: diag.errDuplicateTestName, message: diag.duplicateTestName(m.decls[prevOrd as Count].testName(), second: testName, symbol: dName), module: modID, offset: at)
		return
	end 'tests'
	if ast.isNestedAlias(dName) 'nested'
		pushDuplicateNestedAlias(dName, dOff: dOff, modID: modID, errs: errs)
		return
	end 'nested'
	let aliasKeyword = "typealias"
	if m.decls[ord as Count].keyword() == aliasKeyword and m.decls[prevOrd as Count].keyword() == aliasKeyword 'aliases'
		diag.pushSiteError(errs, code: diag.errDuplicateTypeAlias, message: diag.duplicateAlias(dName), module: modID, offset: dOff)
		return
	end 'aliases'
	diag.pushSiteError(errs, code: diag.errDuplicateDefinition, message: diag.duplicateDefinition(dName, keyword: m.decls[prevOrd as Count].keyword()), module: modID, offset: dOff)
end 'pushDuplicateDecl'

// pushDuplicateNestedAlias reports a typealias that the body of its type declares a second time, at its name.
function pushDuplicateNestedAlias(dName String, dOff diag.U32, modID diag.ModuleID, mutates errs diag.ErrorList)
	match consumes ast.nestedAliasOwner(dName) 'owner'
		some(owner) then diag.pushSiteError(errs, code: diag.errDuplicateTypeAlias, message: diag.duplicateTypeAlias(ast.nestedAliasMember(dName), qualified: dName, declaredBy: "earlier in the body of `{owner}`"), module: modID, offset: dOff)
		none then panic("'{dName}' is not a nested typealias")
	end 'owner'
end 'pushDuplicateNestedAlias'

function parseSingleModule(mutates p ast.Project, modIdx Count, memory SourceFiles, mutates errs diag.ErrorList)
	let mPath = p.modules[modIdx].path.clone()
	var fPaths = ast.StringList.create(0)
	var fTexts = ast.StringList.create(0)
	for i in 0 upto p.modules[modIdx].filePaths.count() 'readF'
		let fp = p.modules[modIdx].filePaths[i].clone()
		fPaths.push(fp.clone())
		readFileText(fp, memory: memory, fTexts: fTexts, errs: errs)
	end 'readF'
	if fTexts.count() != fPaths.count() 'ioFail'
		return
	end 'ioFail'
	let modID = p.modules[modIdx].id
	let res = syntax.parseModuleFiles(modID, path: mPath, filePaths: fPaths, fileTexts: fTexts, target: p.target)
	match consumes res 'pr'
		ok(parsedMod) then copyParsedIntoModule(p, modIdx: modIdx, parsedMod: parsedMod)
		err(found) then appendErrors(errs, found: found)
	end 'pr'
end 'parseSingleModule'

function appendErrors(mutates errs diag.ErrorList, found diag.ErrorList)
	for i in 0 upto found.count() 'each'
		errs.push(found[i].clone())
	end 'each'
end 'appendErrors'

function appendCopyStr(mutates fTexts ast.StringList, s String)
	fTexts.push(s.clone())
end 'appendCopyStr'

// readFileText adds the text of the file at fp, from memory when the file is held there and from disk otherwise.
function readFileText(fp String, memory SourceFiles, mutates fTexts ast.StringList, mutates errs diag.ErrorList)
	match consumes memoryText(memory, path: fp) 'held'
		some(txt) then fTexts.push(txt)
		none then readOneFile(fp, fTexts: fTexts, errs: errs)
	end 'held'
end 'readFileText'

function readOneFile(fp String, mutates fTexts ast.StringList, mutates errs diag.ErrorList)
	match consumes readTextFile(fp) 'rf'
		some(txt) then fTexts.push(txt)
		none then diag.pushLocatedError(errs, code: diag.errUnexpectedToken, message: "cannot read '{fp}'", file: fp.clone(), line: 1 as Count, col: 1 as Count)
	end 'rf'
end 'readOneFile'

function copyParsedIntoModule(mutates p ast.Project, modIdx Count, consumes parsedMod ast.Module)
	var pm = parsedMod
	p.modules[modIdx].files = pm.files
	p.modules[modIdx].tree = pm.tree
	p.modules[modIdx].decls = pm.decls
	p.modules[modIdx].names = pm.names
end 'copyParsedIntoModule'

// sourceFiles are the paths of the source files of the project at dir, directory by directory in the order of the walk, as the
// project loads them.
export function sourceFiles(dir String) returns ast.StringList
	var nodes = DiscDirList.create(0)
	var errs = diag.ErrorList.create(0)
	_ = scanDirectory(nodes, dir: dir.clone(), modPath: "", isRoot: true, memory: SourceFiles.create(0), errs: errs)
	var files = ast.StringList.create(0)
	for i in 0 upto nodes.count() 'directories'
		for f in 0 upto nodes[i].filePaths.count() 'files'
			files.push(nodes[i].filePaths[f].clone())
		end 'files'
	end 'directories'
	return files
end 'sourceFiles'

// loadProject is the project at rootPath: a directory of modules, or a single source file.
export function loadProject(rootPath String, mutates errs diag.ErrorList) returns table.Option with ast.Project
	var p = ast.Project.new(rootPath.clone())
	if not loadProjectInto(p, rootPath: rootPath, errs: errs) 'missing'
		return table.Option.none
	end 'missing'
	return table.Option.some(p)
end 'loadProject'

// loadProjectInto adds the project at rootPath to p, whose modules stay as they are: the new modules come after them, so
// that p can start as what many programs share, such as the runtime already checked. The root of the project becomes the
// root module of p. It is false when the path names no file or directory.
export function loadProjectInto(mutates p ast.Project, rootPath String, mutates errs diag.ErrorList) returns bool
	p.root = rootPath.clone()
	let first = p.modules.count()
	if isDirectoryPath(rootPath) 'dir'
		loadDirectory(p, rootPath: rootPath, memory: SourceFiles.create(0), errs: errs)
	end 'dir' else 'single'
		match consumes readTextFile(rootPath) 'rf'
			some(text) then addSingleFile(p, path: rootPath, text: text, errs: errs)
			none then return failMissingInput(rootPath, errs: errs)
		end 'rf'
	end 'single'
	buildModuleTables(p, first: first, errs: errs)
	return true
end 'loadProjectInto'

// loadFilesInto is loadProjectInto for a project whose files are held in memory, as a directory rootPath that holds them
// at the paths they name.
export function loadFilesInto(mutates p ast.Project, rootPath String, files SourceFiles, mutates errs diag.ErrorList)
	p.root = rootPath.clone()
	let first = p.modules.count()
	loadDirectory(p, rootPath: rootPath, memory: files, errs: errs)
	buildModuleTables(p, first: first, errs: errs)
end 'loadFilesInto'

// loadDirectory adds the modules of the directory at rootPath, the files of which are the ones in memory when there are any.
function loadDirectory(mutates p ast.Project, rootPath String, memory SourceFiles, mutates errs diag.ErrorList)
	let first = p.modules.count()
	var nodes = DiscDirList.create(0)
	_ = scanDirectory(nodes, dir: rootPath.clone(), modPath: "", isRoot: true, memory: memory, errs: errs)
	if memory.count() == 0 'onDisk'
		reportNestedProject(nodes, errs: errs)
	end 'onDisk'
	if nodes.count() > 0 'collect'
		let rootMid = collectModuleTree(nodes, nodeIdx: 0 as Count, p: p)
		p.rootModule = rootMid
		p.modules[ast.modIndex(rootMid)].isRuntime = isRuntimeDirectory(rootPath)
	end 'collect'
	for i in first upto p.modules.count() 'parseEach'
		parseSingleModule(p, modIdx: i, memory: memory, errs: errs)
	end 'parseEach'
end 'loadDirectory'

// loadSourceInto adds a program that is the one file text, named path in diagnostics, to p, as loadProjectInto adds a
// project. It is how a test of the corpus compiles a program it holds in memory.
export function loadSourceInto(mutates p ast.Project, path String, text String, mutates errs diag.ErrorList)
	p.root = path.clone()
	let first = p.modules.count()
	addSingleFile(p, path: path, text: text, errs: errs)
	buildModuleTables(p, first: first, errs: errs)
end 'loadSourceInto'

// addSingleFile adds a module that is the one file at path, whose text is given, and makes it the root.
function addSingleFile(mutates p ast.Project, path String, text String, mutates errs diag.ErrorList)
	var m = ast.Module.new(0 as diag.ModuleID, path: "", text: "", files: ast.FileSpanList.create(0))
	m.dir = parentDir(path)
	m.filePaths.push(path.clone())
	let rootMid = ast.addModule(p, m: m)
	p.rootModule = rootMid
	var memory = SourceFiles.create(0)
	memory.push(SourceFile.make(path.clone(), text: text.clone()))
	parseSingleModule(p, modIdx: ast.modIndex(rootMid), memory: memory, errs: errs)
end 'addSingleFile'

function buildModuleTables(mutates p ast.Project, first Count, mutates errs diag.ErrorList)
	for i in first upto p.modules.count() 'buildTbl'
		let mid = p.modules[i].id
		buildModuleTable(p, modID: mid, errs: errs)
	end 'buildTbl'
end 'buildModuleTables'

// addRuntime loads the runtime's source as a module of p, so that it is checked, lowered and linked with the programs
// compiled after it.
export function addRuntime(mutates p ast.Project, mutates errs diag.ErrorList)
	let dir = match consumes runtimeDirectory() 'found'
		some(found) gives found
		none panic("there is no runtime directory in the compiler's directory or above it")
	end 'found'
	var m = ast.Module.new(0 as diag.ModuleID, path: ast.runtimeQualifier, text: "", files: ast.FileSpanList.create(0))
	m.dir = dir.clone()
	m.isRuntime = true
	var subdirectories = ast.StringList.create(0)
	var projectFiles = ast.StringList.create(0)
	_ = listDirectory(dir, memory: SourceFiles.create(0), files: m.filePaths, projectFiles: projectFiles, dirs: subdirectories)
	let mid = ast.addModule(p, m: m)
	p.rootModule = mid
	parseSingleModule(p, modIdx: ast.modIndex(mid), memory: SourceFiles.create(0), errs: errs)
	buildModuleTable(p, modID: mid, errs: errs)
end 'addRuntime'

function failMissingInput(rootPath String, mutates errs diag.ErrorList) returns bool
	diag.pushLocatedError(errs, code: diag.errUnexpectedToken, message: "no such file or directory", file: rootPath.clone(), line: 1 as Count, col: 1 as Count)
	return false
end 'failMissingInput'
