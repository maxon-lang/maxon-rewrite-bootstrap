// libraryHeads is a library of two modules, the core and `chained`.
function libraryHeads() returns LibraryHeads
	var heads = ast.StringList.create(0)
	heads.push("core")
	heads.push("chained")
	var modules = CountList.create(0)
	modules.push(10)
	modules.push(11)
	return LibraryHeads.make(modules, heads: heads, core: table.Option.some(0 as Count))
end 'libraryHeads'

function wordsText(words ast.StringList) returns String
	var text = ""
	for word in words 'words'
		text = "{text}{word} "
	end 'words'
	return text
end 'wordsText'

// scannedText is a file of a library module that declares a function, a type with two methods, only one of which is exported,
// an extension of the type, with the clause that the extension gives, and a constant that names `chained`.
function scannedText(clause String) returns String
	var text = "public function util() returns int\n\treturn 1\nend 'util'\n\n"
	text = "{text}type Box\n\texport var n as int\n\n\texport function size() returns int\n\t\treturn n\n\tend 'size'\n\n"
	text = "{text}\tfunction hidden() returns int\n\t\treturn 0\n\tend 'hidden'\nend 'Box'\n\n"
	text = "{text}// reads other.thing\nextension Box{clause}\n\texport function area() returns int\n\t\treturn 2\n\tend 'area'\n\n"
	text = "{text}\tstatic function internal() returns int\n\t\treturn 3\n\tend 'internal'\n\n\tpublic static let unit = 1\n\n"
	text = "{text}\t#if os(Windows)\n\t\texport function branch() returns int\n\t\t\treturn 4\n\t\tend 'branch'\n\t#endif\nend 'Box'\n\n"
	text = "{text}#if os(Windows)\n\tlet leftOut = 1\n#endif\n\nlet value = chained.reach()\n"
	return text
end 'scannedText'

function scanOfText(text String) returns LibraryScan
	let heads = libraryHeads()
	var scan = LibraryScan.of(heads)
	scan.addText("<test>", text: text.clone(), heads: heads)
	return scan
end 'scanOfText'

test 'a scan of a library file reads the names it declares and the members it exports, in every branch of a directive'
	let scan = scanOfText(scannedText(" implements Sized"))
	table.assertEqStr(wordsText(scan.words()), expected: "util Box leftOut value area unit branch size ", label: "the words of a module whose extension gives a conformance")
	let named = scan.namedModules(libraryHeads())
	if named.count() != 2 or not named.contains(10 as Count) or not named.contains(11 as Count) 'named'
		panic("a file that writes chained.reach names {named.count()} modules, not the core and chained")
	end 'named'
end 'a scan of a library file reads the names it declares and the members it exports, in every branch of a directive'

test 'a scan of a library file whose extensions give no conformance leaves out the members of its types'
	table.assertEqStr(wordsText(scanOfText(scannedText("")).words()), expected: "util Box leftOut value area unit branch ", label: "the words of a module whose extension gives none")
	table.assertEqStr(wordsText(scanOfText(scannedText(" where Box implements Sized")).words()), expected: "util Box leftOut value area unit branch ", label: "the words of a module whose extension has a where")
	let scan = scanOfText("export function plain() returns int\n\treturn 1\nend 'plain'\n")
	let named = scan.namedModules(libraryHeads())
	if named.count() != 1 or not named.contains(10 as Count) 'core'
		panic("a file that writes no qualifier names {named.count()} modules, not only the core")
	end 'core'
end 'a scan of a library file whose extensions give no conformance leaves out the members of its types'

test 'a scan of a library file with a syntax error reads its declarations all the same'
	let scan = scanOfText("public function stray() returns int\n\treturn 2\nend 'stray'\n\nexport let = 6\n")
	table.assertEqStr(wordsText(scan.words()), expected: "stray ", label: "the words of a file with an error")
end 'a scan of a library file with a syntax error reads its declarations all the same'
